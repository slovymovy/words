{
    "word_family": [
        "garbler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "729499bc-e3b9-3317-9930-59dcbe59a2b3",
                    "sense_definition": "To corrupt or distort a message or sound, making it confusing, unreadable, or unintelligible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "distort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A bad connection can easily <w>garble</w> the audio during an important phone conference."
                        },
                        {
                            "text": "The computer error threatened to <w>garble</w> the text files beyond recognition."
                        }
                    ],
                    "synonyms": [
                        "scramble",
                        "muddle",
                        "distort"
                    ],
                    "antonyms": [
                        "clarify"
                    ],
                    "common_phrases": [
                        "garble the transmission",
                        "garble the message"
                    ]
                },
                {
                    "sense_id": "79a53c56-b33c-32b2-9929-10e10579c652",
                    "sense_definition": "To intentionally alter or misquote a text, report, or statement so as to mislead or misrepresent the author's meaning.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician accused the media of attempting to <w>garble</w> his statements to create controversy."
                        },
                        {
                            "text": "Dishonest reviewers often <w>garble</w> quotations to support an inaccurate narrative."
                        }
                    ],
                    "synonyms": [
                        "misrepresent",
                        "pervert",
                        "twist"
                    ],
                    "common_phrases": [
                        "garble a quotation",
                        "garble the facts"
                    ]
                },
                {
                    "sense_id": "5f3085cc-359a-343f-9ee2-bc2da96c7972",
                    "sense_definition": "To make false or inaccurate by altering, mutilating, or adding erroneous details.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "distort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor began to <w>garble</w> the story until it barely resembled the truth."
                        },
                        {
                            "text": "Unverified rumors will inevitably <w>garble</w> the original witness reports."
                        }
                    ],
                    "synonyms": [
                        "falsify",
                        "tamper"
                    ],
                    "common_phrases": [
                        "garble the story"
                    ]
                },
                {
                    "sense_id": "63dfcd48-1579-3c75-8e42-3e42ef776dbf",
                    "sense_definition": "To sift or separate valuable parts from coarse residue, refuse, or dirt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Merchants used to carefully <w>garble</w> spices to remove any dust or dirt."
                        },
                        {
                            "text": "Workers had to <w>garble</w> the raw harvest before packing it for shipment."
                        }
                    ],
                    "synonyms": [
                        "sift",
                        "winnow"
                    ],
                    "common_phrases": [
                        "garble spices"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically of sifting spices or herbs."
                        }
                    ]
                }
            ]
        },
        {
