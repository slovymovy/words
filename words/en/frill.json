{
    "word_family": [
        "frilly",
        "frilliness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e4432d3f-9420-3128-90f0-642614e4e745",
                    "sense_definition": "A strip of pleated fabric or paper used as decoration or trim.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vintage dress was decorated with a delicate lace <w>frill</w> around the collar.",
                            "target_lang_translations": {
                                "ru": "Винтажное платье было украшено изящной кружевной <w>оборкой</w> вокруг воротника."
                            }
                        },
                        {
                            "text": "She added a paper <w>frill</w> to the cake to make it look more festive.",
                            "target_lang_translations": {
                                "ru": "Она добавила бумажную <w>оборку</w> на торт, чтобы он выглядел более празднично."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruffle",
                        "flounce",
                        "furbelow"
                    ],
                    "common_phrases": [
                        "lace frill"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоска ткани или бумаги, собранная в складки, используемая для украшения или отделки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обо́рка",
                                "target_lang_sense_clarification": "полоска материи, собранная складками для отделки одежды"
                            },
                            {
                                "target_lang_word": "жабо́",
                                "target_lang_sense_clarification": "пышная отделка воротника из кружев или ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9db135a9-2679-3c9b-9f07-20509eef0fb1",
                    "sense_definition": "Something extraneous or not essential; something purely for show or effect; a luxury.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "non-essential",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The basic model of the car is affordable, but all the extra <w>frills</w> make it very expensive.",
                            "target_lang_translations": {
                                "ru": "Базовая модель автомобиля доступна по цене, но все дополнительные <w>излишества</w> делают её очень дорогой."
                            }
                        },
                        {
                            "text": "We want a simple wedding without any unnecessary <w>frills</w> or expensive decorations.",
                            "target_lang_translations": {
                                "ru": "Мы хотим простую свадьбу без всяких ненужных <w>излишеств</w> или дорогих украшений."
                            }
                        }
                    ],
                    "common_phrases": [
                        "no frills"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то лишнее или несущественное; излишество, предмет роскоши."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изли́шество",
                                "target_lang_sense_clarification": "что-то лишнее, необязательное"
                            },
                            {
                                "target_lang_word": "ро́скошь",
                                "target_lang_sense_clarification": "дополнительные удобства, не являющиеся необходимыми"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a37a7a84-7920-313e-9c11-f003a656039d",
                    "sense_definition": "A substance or material on the edge of something, resembling a strip of fabric.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waves left a white <w>frill</w> of foam along the sandy beach.",
                            "target_lang_translations": {
                                "ru": "Волны оставили белую <w>кайму</w> из пены вдоль песчаного пляжа."
                            }
                        },
                        {
                            "text": "A thin <w>frill</w> of frost covered the edges of the winter leaves.",
                            "target_lang_translations": {
                                "ru": "Тонкая <w>оторочка</w> инея покрывала края зимних листьев."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или материал на краю чего-либо, напоминающий полоску ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кайма́",
                                "target_lang_sense_clarification": "полоса по краю чего-либо"
                            },
                            {
                                "target_lang_word": "оторо́чка",
                                "target_lang_sense_clarification": "полоса по краю, напоминающая отделку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f24855-6cf9-36ea-94b4-0a88c5791bf7",
                    "sense_definition": "The extensive margin on the back of the heads of certain reptiles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lizard expanded its colorful neck <w>frill</w> to intimidate the approaching predator.",
                            "target_lang_translations": {
                                "ru": "Ящерица раздула свой яркий шейный <w>воротник</w>, чтобы напугать приближающегося хищника."
                            }
                        },
                        {
                            "text": "Scientists studied the bony <w>frill</w> on the back of the dinosaur's skull.",
                            "target_lang_translations": {
                                "ru": "Учёные изучали костный <w>гребень</w> на затылке черепа динозавра."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Широкий кожный или костный вырост на затылке у некоторых рептилий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "воротни́к",
                                "target_lang_sense_clarification": "кожный вырост вокруг шеи у ящериц"
                            },
                            {
                                "target_lang_word": "гре́бень",
                                "target_lang_sense_clarification": "костный вырост на черепе динозавра"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c5b9449c-ba29-3506-b727-eaf4c81e6afe",
                    "sense_definition": "To provide or decorate with a frill or frills.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decoration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>frill</w> the edges of the curtains to match the pillows.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>украсить оборками</w> края штор, чтобы они сочетались с подушками."
                            }
                        },
                        {
                            "text": "The tailor will <w>frill</w> the sleeves of the dress with matching silk.",
                            "target_lang_translations": {
                                "ru": "Портной <w>украсит оборками</w> рукава платья подходящим по цвету шёлком."
                            }
                        }
                    ],
                    "synonyms": [
                        "ruffle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Украшать оборками или складками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украша́ть обо́рками",
                                "target_lang_sense_clarification": "пришивать оборки для декора"
                            },
                            {
                                "target_lang_word": "оборча́ть",
                                "target_lang_sense_clarification": "делать оборки (редко)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6c081e5-5f9b-378e-9350-f5d14abfe1d2",
                    "sense_definition": "To become wrinkled.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wrinkle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The edges of the old paper began to <w>frill</w> after years of exposure to humidity.",
                            "target_lang_translations": {
                                "ru": "Края старой бумаги начали <w>морщиться</w> после многих лет воздействия влажности."
                            }
                        },
                        {
                            "text": "The fabric will <w>frill</w> if it is not ironed properly after washing.",
                            "target_lang_translations": {
                                "ru": "Ткань будет <w>сборить</w>, если её не прогладить должным образом после стирки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться морщинистым или сборенным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "морщи́ться",
                                "target_lang_sense_clarification": "покрываться складками"
                            },
                            {
                                "target_lang_word": "сбори́ться",
                                "target_lang_sense_clarification": "образовывать мелкие складки"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}