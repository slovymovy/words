{
    "word_family": [
        "mood",
        "moodily",
        "moodiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cadfdebd-e3ad-316a-bdde-4197519ebdd6",
                    "sense_definition": "Feeling or showing a state of sadness, sulkiness, or depression.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat in a <w>moody</w> silence after losing the game.",
                            "target_lang_translations": {
                                "ru": "Она сидела в <w>мрачном</w> молчании после проигрыша в игре.",
                                "zh": "她输了比赛后，<w>闷闷不乐</w>地坐着，一声不吭。"
                            }
                        },
                        {
                            "text": "Don't be so <w>moody</w> just because you didn't get your way.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>угрюмым</w> только из-за того, что всё вышло не по-твоему.",
                                "zh": "别因为没如愿就这么<w>闷闷不乐</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sulky",
                        "sullen",
                        "glum",
                        "morose",
                        "depressed",
                        "miserable",
                        "down",
                        "unhappy",
                        "gloomy"
                    ],
                    "antonyms": [
                        "cheerful",
                        "happy",
                        "joyful"
                    ],
                    "common_phrases": [
                        "moody silence",
                        "moody look",
                        "moody expression"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувствующий или выражающий грусть, угрюмость или подавленность.",
                        "zh": "感到或表现出悲伤、闷闷不乐或消沉的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угрюмый",
                                "target_lang_sense_clarification": "о человеке или выражении лица"
                            },
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "о настроении или виде"
                            },
                            {
                                "target_lang_word": "не в духе",
                                "target_lang_sense_clarification": "в плохом настроении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闷闷不乐的",
                                "target_lang_sense_clarification": "形容人、表情或气氛显得消沉低落"
                            },
                            {
                                "target_lang_word": "忧郁的",
                                "target_lang_sense_clarification": "带有忧伤、低沉的情绪"
                            },
                            {
                                "target_lang_word": "阴郁的",
                                "target_lang_sense_clarification": "阴沉、不爱说话的样子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "08f63006-2afc-302e-8795-607215c4b8c7",
                    "sense_definition": "Given to sudden or frequent changes of mind or mood; temperamental.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>moody</w> teenager refused to come out of his room all day.",
                            "target_lang_translations": {
                                "ru": "<w>Капризный</w> подросток отказывался выходить из своей комнаты весь день.",
                                "zh": "那个<w>喜怒无常</w>的少年一整天都不肯走出房间。"
                            }
                        },
                        {
                            "text": "He is a <w>moody</w> player who performs brilliantly one day and poorly the next.",
                            "target_lang_translations": {
                                "ru": "Он <w>нестабильный</w> игрок, который один день выступает блестяще, а на следующий — плохо.",
                                "zh": "他是个<w>情绪化</w>的选手，今天发挥出色，明天却表现很差。"
                            }
                        }
                    ],
                    "synonyms": [
                        "temperamental",
                        "capricious",
                        "fickle",
                        "volatile",
                        "unpredictable",
                        "unstable"
                    ],
                    "antonyms": [
                        "stable",
                        "steady",
                        "even-tempered"
                    ],
                    "common_phrases": [
                        "moody teenager",
                        "moody behavior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный к внезапным или частым переменам настроения; темпераментный.",
                        "zh": "情绪或想法容易突然或频繁变化的；性情多变的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капризный",
                                "target_lang_sense_clarification": "своенравный, часто меняющий желания"
                            },
                            {
                                "target_lang_word": "человек настроения",
                                "target_lang_sense_clarification": "тот, чье поведение зависит от текущего настроения"
                            },
                            {
                                "target_lang_word": "с переменчивым настроением",
                                "target_lang_sense_clarification": "неустойчивый эмоционально"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "喜怒无常的",
                                "target_lang_sense_clarification": "情绪变化快，难以捉摸"
                            },
                            {
                                "target_lang_word": "情绪多变的",
                                "target_lang_sense_clarification": "情绪不稳定，经常变化"
                            },
                            {
                                "target_lang_word": "情绪化的",
                                "target_lang_sense_clarification": "容易受心情影响，表现忽好忽坏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efb4f82f-6d8c-3717-91b1-cd8d37b4fd06",
                    "sense_definition": "Evoking a feeling of gloom, mystery, or melancholy, especially in art, weather, or landscapes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "atmosphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dark clouds gathered over the ocean, creating a <w>moody</w> sky.",
                            "target_lang_translations": {
                                "ru": "Тёмные тучи сгустились над океаном, создавая <w>мрачное</w> небо.",
                                "zh": "乌云在海面上空聚集，形成了<w>阴郁</w>的天空。"
                            }
                        },
                        {
                            "text": "The photographer is famous for his <w>moody</w> black-and-white portraits.",
                            "target_lang_translations": {
                                "ru": "Фотограф известен своими <w>атмосферными</w> черно-белыми портретами.",
                                "zh": "这位摄影师以拍摄<w>氛围感强</w>的黑白肖像而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gloomy",
                        "sombre",
                        "bleak",
                        "atmospheric",
                        "dismal"
                    ],
                    "antonyms": [
                        "bright",
                        "cheerful",
                        "sunny"
                    ],
                    "common_phrases": [
                        "moody sky",
                        "moody lighting",
                        "moody atmosphere"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий чувство мрачности, таинственности или меланхолии (об искусстве, погоде или пейзажах).",
                        "zh": "营造出阴沉、神秘或忧伤感觉的，尤指艺术、天气或风景。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мрачный",
                                "target_lang_sense_clarification": "темный, наводящий тоску"
                            },
                            {
                                "target_lang_word": "меланхоличный",
                                "target_lang_sense_clarification": "грустный, задумчивый"
                            },
                            {
                                "target_lang_word": "атмосферный",
                                "target_lang_sense_clarification": "создающий особое, часто таинственное настроение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴郁的",
                                "target_lang_sense_clarification": "色调、气氛或景象偏暗沉压抑"
                            },
                            {
                                "target_lang_word": "忧郁的",
                                "target_lang_sense_clarification": "带有忧伤、感伤气息"
                            },
                            {
                                "target_lang_word": "氛围感强的",
                                "target_lang_sense_clarification": "营造出强烈而略带神秘的氛围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58263e96-50f3-3e99-83f8-289ad125421b",
                    "sense_definition": "Of dubious origin; counterfeit or stolen.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "illicit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police arrested a man selling <w>moody</w> watches on the street corner.",
                            "target_lang_translations": {
                                "ru": "Полиция арестовала мужчину, продававшего <w>палёные</w> часы на углу улицы.",
                                "zh": "警方逮捕了一名在街角卖<w>来路不明</w>手表的男子。"
                            }
                        },
                        {
                            "text": "I wouldn't buy that phone if I were you; it looks a bit <w>moody</w>.",
                            "target_lang_translations": {
                                "ru": "Я бы не покупал этот телефон на твоем месте; он выглядит немного <w>подозрительным</w>.",
                                "zh": "如果我是你，我就不会买那部手机；它看起来有点<w>来路不明</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dodgy"
                    ],
                    "antonyms": [
                        "genuine",
                        "authentic",
                        "legal"
                    ],
                    "common_phrases": [
                        "moody goods",
                        "moody gear"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "primarily British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сомнительного происхождения; поддельный или краденый.",
                        "zh": "来源可疑的；假冒的或偷来的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палёный",
                                "target_lang_sense_clarification": "сленг: поддельный или некачественный"
                            },
                            {
                                "target_lang_word": "левый",
                                "target_lang_sense_clarification": "сленг: незаконный или сомнительный"
                            },
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий сомнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "来路不明的",
                                "target_lang_sense_clarification": "英式俚语，指来源可疑"
                            },
                            {
                                "target_lang_word": "假冒的",
                                "target_lang_sense_clarification": "指不是正品的"
                            },
                            {
                                "target_lang_word": "偷来的",
                                "target_lang_sense_clarification": "指非法得来的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7c180faa-5f31-390f-bbd9-99f3548aff90",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Moody</w> called to schedule an appointment for next week.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Муди</w> позвонил, чтобы назначить встречу на следующую неделю.",
                                "zh": "<w>穆迪</w>先生打来电话，想预约下周的时间。"
                            }
                        },
                        {
                            "text": "We researched the history of the <w>Moody</w> family in the local archives.",
                            "target_lang_translations": {
                                "ru": "Мы изучали историю семьи <w>Муди</w> в местных архивах.",
                                "zh": "我们在当地档案馆研究了<w>穆迪</w>家族的历史。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Муди",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穆迪",
                                "target_lang_sense_clarification": "英语姓氏的音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f36b8a7-827b-3483-b2a9-b56321131d12",
                    "sense_definition": "A place name used for various locations in the United States and Australia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small town of <w>Moody</w> on their road trip.",
                            "target_lang_translations": {
                                "ru": "Они проехали через маленький городок <w>Муди</w> во время своего автопутешествия.",
                                "zh": "他们自驾旅行时开车经过了<w>穆迪</w>这个小镇。"
                            }
                        },
                        {
                            "text": "The population of <w>Moody</w> has grown slightly over the last decade.",
                            "target_lang_translations": {
                                "ru": "Население <w>Муди</w> немного выросло за последнее десятилетие.",
                                "zh": "过去十年里，<w>穆迪</w>的人口略有增长。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название населенного пункта.",
                        "zh": "地名，用于美国和澳大利亚的多个地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Муди",
                                "target_lang_sense_clarification": "транслитерация названия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "穆迪",
                                "target_lang_sense_clarification": "地名音译，用于美国和澳大利亚的多个地方"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}