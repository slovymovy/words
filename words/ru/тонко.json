    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8f105ffa-61d0-355b-99ec-9161ce00939e",
                    "sense_definition": "С незначительной толщиной; так, что образуется тонкий слой или предмет.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "физическая толщина",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для этого рецепта нужно очень <w>тонко</w> нарезать сыр и ветчину.",
                            "target_lang_translations": {
                                "en": "For this recipe, you need to slice the cheese and ham very <w>thinly</w>."
                            }
                        },
                        {
                            "text": "Мастер <w>тонко</w> нарезал хлеб, чтобы сделать изысканные закуски для гостей.",
                            "target_lang_translations": {
                                "en": "The master sliced the bread <w>thin</w> to make exquisite appetizers for the guests."
                            }
                        }
                    ],
                    "synonyms": [
                        "мелко"
                    ],
                    "antonyms": [
                        "толсто"
                    ],
                    "common_phrases": [
                        "тонко нарезать",
                        "тонко намазать"
                    ],
                    "target_lang_definitions": {
                        "en": "With little thickness; in a way that creates a thin layer or object."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "thinly",
                                "target_lang_sense_clarification": "referring to physical thickness or layers"
                            },
                            {
                                "target_lang_word": "thin",
                                "target_lang_sense_clarification": "used as an adverb in cooking contexts"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c067b0a-895b-3e16-b949-48258e394076",
                    "sense_definition": "Изысканно, изящно или едва заметно; требуя чуткости в восприятии.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "качество исполнения",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Автор очень <w>тонко</w> подметил изменения в настроении своего героя.",
                            "target_lang_translations": {
                                "en": "The author <w>subtly</w> noted the changes in his character's mood."
                            }
                        },
                        {
                            "text": "Эта шутка была <w>тонко</w> подмечена, и все в комнате сразу рассмеялись.",
                            "target_lang_translations": {
                                "en": "This joke was <w>cleverly</w> observed, and everyone in the room laughed immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "изысканно",
                        "изящно",
                        "деликатно"
                    ],
                    "antonyms": [
                        "толсто"
                    ],
                    "common_phrases": [
                        "тонко подметить",
                        "тонко пошутить"
                    ],
                    "target_lang_definitions": {
                        "en": "Exquisitely, gracefully, or barely noticeably; requiring sensitivity in perception."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "subtly",
                                "target_lang_sense_clarification": "in a clever or indirect way"
                            },
                            {
                                "target_lang_word": "delicately",
                                "target_lang_sense_clarification": "with grace or fine detail"
                            },
                            {
                                "target_lang_word": "finely",
                                "target_lang_sense_clarification": "with great precision or elegance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f810db15-fec9-3845-aabb-a8e3a7e84016",
                    "sense_definition": "С глубоким пониманием скрытых деталей; проницательно и умно.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "интеллект",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Прокуратор, как всегда, <w>тонко</w> понимает вопрос и видит суть проблемы.",
                            "target_lang_translations": {
                                "en": "The procurator, as always, <w>keenly</w> understands the question and sees the heart of the problem."
                            }
                        },
                        {
                            "text": "Он <w>тонко</w> чувствует ситуацию и всегда знает, когда нужно промолчать.",
                            "target_lang_translations": {
                                "en": "He <w>perceptively</w> senses the situation and always knows when to stay silent."
                            }
                        }
                    ],
                    "synonyms": [
                        "проницательно",
                        "чутко"
                    ],
                    "common_phrases": [
                        "тонко чувствовать",
                        "тонко понимать"
                    ],
                    "target_lang_definitions": {
                        "en": "With a deep understanding of hidden details; insightfully and intelligently."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "perceptively",
                                "target_lang_sense_clarification": "showing deep insight"
                            },
                            {
                                "target_lang_word": "keenly",
                                "target_lang_sense_clarification": "with sharp intellectual awareness"
                            },
                            {
                                "target_lang_word": "insightfully",
                                "target_lang_sense_clarification": "understanding the true nature of things"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff90ae34-0032-3e7c-8876-607009198889",
                    "sense_definition": "С большой высотой звучания; пронзительно или высоко (о голосе).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "звук",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скрипка зазвучала очень <w>тонко</w>, выводя грустную мелодию в пустом зале.",
                            "target_lang_translations": {
                                "en": "The violin began to sound very <w>thinly</w>, playing a sad melody in the empty hall."
                            }
                        },
                        {
                            "text": "Мальчик <w>тонко</w> закричал от испуга, когда увидел в траве змею.",
                            "target_lang_translations": {
                                "en": "The boy gave a <w>shrill</w> cry of fright when he saw a snake in the grass."
                            }
                        }
                    ],
                    "synonyms": [
                        "высоко",
                        "пронзительно"
                    ],
                    "common_phrases": [
                        "тонко запеть",
                        "тонко вскрикнуть"
                    ],
                    "target_lang_definitions": {
                        "en": "With a high pitch; piercingly or high-pitched (referring to a voice or sound)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shrilly",
                                "target_lang_sense_clarification": "in a high-pitched and piercing manner"
                            },
                            {
                                "target_lang_word": "thinly",
                                "target_lang_sense_clarification": "referring to a weak or high-pitched sound"
                            },
                            {
                                "target_lang_word": "high",
                                "target_lang_sense_clarification": "referring to musical pitch"
                            }
                        ]
                    }
                }
            ]
        },
