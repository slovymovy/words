                "entry_id": "2e10a364-f7c6-38ce-9cc6-8bf14dfef432",
                "word": "AlUla",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "273ea166-8591-386e-b63d-b2c0e5b05b65",
                        "entry_id": "2e10a364-f7c6-38ce-9cc6-8bf14dfef432",
                        "glosses": [
                            "Oasis de la province de Médine, au nord-ouest de l’Arabie saoudite."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77d08b6f-5862-49f9-929e-8a5386e9520f",
                                "sense_id": "273ea166-8591-386e-b63d-b2c0e5b05b65",
                                "text": "Pour poursuivre le romantisme et l’inattendu, visitez l’un des lacs du désert ou baladez-vous dans une oasis de dattiers jusqu’à la vieille ville d’AlUla."
                            },
                            {
                                "example_id": "83f0224b-f11e-4b05-a491-faf7e008b5d6",
                                "sense_id": "273ea166-8591-386e-b63d-b2c0e5b05b65",
                                "text": "Offrant un mélange unique de sites historiques et d’art contemporain, AlUla est une destination incontournable pour s’immerger dans la culture saoudienne."
                            },
                            {
                                "example_id": "c5b2a011-2b96-4bbd-a3f9-072f5fcdecd0",
                                "sense_id": "273ea166-8591-386e-b63d-b2c0e5b05b65",
                                "text": "AlUla, merveille d’Arabie, la prochaine exposition-événement de l’Institut du monde arabe, ouvre ses portes en octobre 2019."
                            }
                        ]
                    }
                ],
