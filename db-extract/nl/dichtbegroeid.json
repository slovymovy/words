                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2223cd6e-1044-42d8-8b36-b911a9a11f30",
                                "sense_id": "8029a666-e655-33c6-9593-ae61e2b297ba",
                                "text": "Een tiny forest is een dichtbegroeid inheems bos, ter grootte van een tennisbaan. Struiken en bomen worden dicht op elkaar geplant. Het minibos zorgt voor verkoeling op warme dagen, meer biodiversiteit en waterberging bij zware regenval."
                            },
                            {
                                "example_id": "50b74f62-b6d3-41b0-ba53-b0d2730d395f",
                                "sense_id": "8029a666-e655-33c6-9593-ae61e2b297ba",
                                "text": "Met onze wandelstokken baanden we ons een weg door de dichtbegroeide struiken. Er was duidelijk een hele tijd niemand door deze ongerepte natuur heen gelopen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ba0ea27-1473-37d0-b7b2-a08d96caa351",
                        "entry_id": "a72ffa95-c762-367f-b217-11af67446349",
                        "glosses": [
                            "met teveel spullen volgepropt"
