        "fr-extract.jsonl": [
            {
                "entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                "word": "nostalgique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a2eecec-1ada-435e-bb6d-9d0a9fceffbd",
                        "entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "nostalgiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e6b81a0-bfde-3e3f-9dd9-17bb428cf654",
                        "entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                        "glosses": [
                            "Relatif à la nostalgie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dde9f1c-8d34-4904-8d32-9244d246a1d3",
                                "sense_id": "1e6b81a0-bfde-3e3f-9dd9-17bb428cf654",
                                "text": "État nostalgique : État dépressif causé par l’éloignement du pays natal."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1519ef8-5dc9-3ccb-afe4-7cfd37f69bec",
                        "entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                        "glosses": [
                            "Envahi par un sentiment de nostalgie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a90a84b2-5028-4a0a-bc04-e7d54c1569ae",
                                "sense_id": "f1519ef8-5dc9-3ccb-afe4-7cfd37f69bec",
                                "text": "La musique nostalgique des Cosaques aidant à son illusion, il abolissait le restaurant de nuit, les murs historiés d’armes circassiennes et les danseuses en jupe rouge, accroupies pour danser une Kazatchok."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0146458-2e45-3589-a8fe-0eb3b780306c",
                        "entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                        "glosses": [
                            "Qui souffre, qui est atteint de nostalgie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e112bd84-af29-4ad8-86aa-40516f5ec4f0",
                                "sense_id": "d0146458-2e45-3589-a8fe-0eb3b780306c",
                                "text": "Il s’est couché. Il ne s’est plus relevé. Il était nostalgique, et il avait le cœur malade."
                            }
                        ]
                    },
                    {
                        "sense_id": "524285c5-7535-32ff-9ecf-66bfd635b4c8",
                        "entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                        "glosses": [
                            "Qui regrette le passé, passéiste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3984263e-1445-4a0c-8f84-b44e40247b67",
                                "sense_id": "524285c5-7535-32ff-9ecf-66bfd635b4c8",
                                "text": "Le Balzar m’attirait; je me rappelais que mon grand-père —mort depuis— m’y avait amené quelquefois, en 1913 : nous nous asseyions côte à côte sur la banquette, tout le monde nous regardait d’un air de connivence, il commandait un bock et, pour moi, un galopin de bière, je me sentais aimé. Donc, quinquagénaire et nostalgique, je poussais la porte de la brasserie et je me faisais servir un galopin."
                            },
                            {
                                "example_id": "f20c82b8-584b-4ebd-87c6-743f417b3843",
                                "sense_id": "524285c5-7535-32ff-9ecf-66bfd635b4c8",
                                "text": "Écrasée par un conducteur néonazi, une manifestante a pourtant payé de sa vie son opposition à la parade de Charlottesville, qui rassemblait, le week-end dernier, suprémacistes blancs, sudistes nostalgiques de l’esclavage et du général Lee, militants de l’« alt-right » (extrême droite) et autres humanistes du Ku Klux Klan, tous unis, bras tendu, batte de base-ball en main, slogans antisémites et anti-« nègres » aux lèvres, pour hurler leur « fierté d’être blancs »."
                            }
                        ]
                    },
                    {
                        "sense_id": "8b935144-7bdd-3935-a2aa-fa1f285bf320",
                        "entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                        "glosses": [
                            "Mélancolique, triste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad29aaa3-d495-4321-9954-ab773d3b4b61",
                                "sense_id": "8b935144-7bdd-3935-a2aa-fa1f285bf320",
                                "text": "Le vent secouait les arbres perdus, devant mes vitres. Ces pauvres arbres qui avaient l’air de vagabonds nostalgiques, englués par la racine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee42795e-8d03-4909-85f5-13fac0baf1b0",
                        "source_entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                        "source_sense_description": "relatif à la nostalgie",
                        "target_lang_word": "nostalgisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nostalgisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "67c3e1bc-7902-39c7-b053-d4776745bee3",
                                        "entry_id": "564dbe2b-37ef-3bce-907b-fa6965dd590a",
                                        "glosses": [
                                            "der Vergangenheit sentimental/wehmütig zugewandt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03ab3c25-8036-4213-86c1-692fdf0cf999",
                                                "sense_id": "67c3e1bc-7902-39c7-b053-d4776745bee3",
                                                "text": "„Die andere mögliche Variante besteht wie jetzt in der Verwendung nostalgischer Namen, die um 1940 als chic galten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f062d40-46ca-490f-93f1-6787a3a761e2",
                        "source_entry_id": "87813d4e-5b51-3877-91f2-fb56d2e0c919",
                        "source_sense_description": "relatif à la nostalgie",
                        "target_lang_word": "nostalgic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nostalgic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2bdb40-f83d-3e0c-9f0b-1c0e2241c3ca",
                                        "entry_id": "914624ba-f387-3000-8003-4bc9d81e6c7b",
                                        "glosses": [
                                            "Of, having, or relating to nostalgia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a5b70f6-d7af-446c-8a2b-39b7f4e1ccdd",
                                                "sense_id": "bb2bdb40-f83d-3e0c-9f0b-1c0e2241c3ca",
                                                "text": "And here, as I write, the faint, scarcely perceptible, ghost-like suspicion of a scent—a mere nostalgic fancy, compound, generic, synthetic and all-embracing—an abstract olfactory symbol of the \"Tout Paris\" of fifty years ago, comes back to me out of the past; and fain would I inhale it in all its pristine fulness and vigour."
                                            },
                                            {
                                                "example_id": "5ea5a486-8b5f-4fa1-9151-500fe606227b",
                                                "sense_id": "bb2bdb40-f83d-3e0c-9f0b-1c0e2241c3ca",
                                                "text": "And it was their voices which affected Gudrun almost to swooning. They aroused a strange, nostalgic ache of desire, something almost demoniacal, never to be fulfilled."
                                            },
                                            {
                                                "example_id": "a0df00a0-dc9f-46f2-bb6b-66c4bf3fe79b",
                                                "sense_id": "bb2bdb40-f83d-3e0c-9f0b-1c0e2241c3ca",
                                                "text": "Misery and a nameless nostalgic distress possessed him. He was twenty-three, and oh! so agonizingly conscious of the fact."
                                            },
                                            {
                                                "example_id": "059e27c7-a10d-4e98-b3a1-981346ed7728",
                                                "sense_id": "bb2bdb40-f83d-3e0c-9f0b-1c0e2241c3ca",
                                                "text": "An opening sequence, featuring a de-aged Ford playing a younger Indy, is a bold and nostalgic gambit, offering a glimpse of what you've missed."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "nostalgic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e5817ae9-d2c4-362c-a611-a90971618a26",
                                        "entry_id": "9c25e3b2-79d5-3589-b051-5f5fce2fa1e5",
                                        "glosses": [
                                            "A person who displays nostalgia for something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed136954-36ec-4399-a575-650c70f4d40c",
                                                "sense_id": "e5817ae9-d2c4-362c-a611-a90971618a26",
                                                "text": "But of course every well-brought-up person to-day knows that the Victorians were sentimentalists, nostalgics, escapists, self-deceivers."
                                            },
                                            {
                                                "example_id": "eb02604e-22ef-4e51-ade6-91a3d77a3d80",
                                                "sense_id": "e5817ae9-d2c4-362c-a611-a90971618a26",
                                                "text": "In Bow Street court next morning, the slapper proved to be a paid agent of a group of nostalgics who call themselves The League of Empire Loyalists."
                                            },
                                            {
                                                "example_id": "68ccac4c-f70b-4faa-ba65-37829402515e",
                                                "sense_id": "e5817ae9-d2c4-362c-a611-a90971618a26",
                                                "text": "FA Cup Centenary 1872-1972. One for the football nostalgics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
