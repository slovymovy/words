                        "entry_id": "41a71ce5-3cc3-343f-9c09-2eb095898f04",
                        "glosses": [
                            "przestrzeń obejmująca glebę w zasięgu korzeni roślin wraz z zasiedlającymi ją organizmami"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8374be36-7f77-4593-919e-630c02834e99",
                                "sense_id": "c7f6354d-767f-38c6-8891-73b50d9af5a3",
                                "text": "Czynnikiem wabiącym mogą być gradientowo występujące zmiany w ryzosferze, powstałe wskutek czynności życiowych korzeni."
                            }
                        ],
