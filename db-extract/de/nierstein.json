                    {
                        "sense_id": "e749df39-e9f8-37b7-b96b-d55d4f3135a4",
                        "entry_id": "c11e5b60-324f-3be4-9a33-267f090a59ae",
                        "glosses": [
                            "eine Ortsgemeinde im Landkreis Mainz-Bingen in Rheinland-Pfalz, zwischen Mainz und Worms am Rhein gelegen"
                        ],
                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "45e7f871-ab35-4fdb-b151-6b141742d3f9",
                                "sense_id": "e749df39-e9f8-37b7-b96b-d55d4f3135a4",
                                "text": "„Um Nierstein treten Abschnitte des Perm (Rotliegend-Zeit) zu Tage, in denen 290 Millionen Jahre alte Tierfährten erkennbar sind.“"
                            },
                            {
                                "example_id": "48d2154b-c3db-4a1c-bfa9-c05ecf77a298",
                                "sense_id": "e749df39-e9f8-37b7-b96b-d55d4f3135a4",
                                "text": "„Vor 2000 Jahren befand sich an der Stelle des heutigen Nierstein eine römische Siedlung“"
                            }
                        ],
