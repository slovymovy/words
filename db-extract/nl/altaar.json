                    }
                ],
                "senses": [
                    {
                        "sense_id": "835e4626-ba2c-3ce7-a949-73af26bc1837",
                        "entry_id": "540d90a8-9e74-3737-a914-0b511eb85584",
                        "glosses": [
                            "offertafel voor godsdienstige plechtigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc141b2-f591-4b1b-93c8-6c5d05967439",
                                "sense_id": "835e4626-ba2c-3ce7-a949-73af26bc1837",
                                "text": "De priester las de mis aan het altaar."
                            },
                            {
                                "example_id": "8e7536fe-3759-46f6-9fde-5787816d1020",
                                "sense_id": "835e4626-ba2c-3ce7-a949-73af26bc1837",
                                "text": "Ze knielde neer voor haar koffer als een pelgrim voor een altaar en liet haar vingers over de tubes ze verstopt had onder ze ze oppakte, voelde band, alsof haar hart viel, een ogenblik om verf glijden die haar jurken."
                            },
                            {
                                "example_id": "6a7a157e-f4e9-48f7-9058-ea4e2215adc0",
                                "sense_id": "835e4626-ba2c-3ce7-a949-73af26bc1837",
                                "text": "Zo kan het interieur van een houten kerkje in de Alpen, met zijn kromme banken en scheve muren en een naïeve voorstelling van de Heilige Maagd boven het altaar, voor een christen het idee van nederigheid of lijdzaamheid tastbaarder maken, beter tot leven wekken dan wanneer dit slechts in een boek wordt uitgelegd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a090e11-ed99-4d23-b942-6366a21c4d05",
                        "source_entry_id": "540d90a8-9e74-3737-a914-0b511eb85584",
                        "source_sense_id": "835e4626-ba2c-3ce7-a949-73af26bc1837",
                        "source_sense_description": "offertafel voor godsdienstige plechtigheden",
                        "target_lang_word": "Altar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                        "entry_id": "4a66df12-f978-3ffb-9ff1-fc4218655b0a",
                                        "glosses": [
                                            "tischähnliche Einrichtung (zum Beispiel in einer Kirche) zur Feier eines Gottesdienstes, zur kultischen Verehrung oder für das Abhalten von Ritualen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8ec55b-2778-49c8-9baf-3c96c4a0a84c",
                                                "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                                "text": "Viele Gaben waren am Altar vorbereitet."
                                            },
                                            {
                                                "example_id": "2d4a6e2c-7629-4b80-a7ee-3eddc121904f",
                                                "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                                "text": "„Anmutig zum Klang von Panflöten tanzend, brachte er vor dem Altar Opfer dar.“"
                                            },
                                            {
                                                "example_id": "9153eb8e-3148-49ee-8317-e59a23ae6e0d",
                                                "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                                "text": "„Neben dem Altar ist eine Replik des Bischofsstabs ausgestellt.“"
                                            },
                                            {
                                                "example_id": "57ab8671-2ad6-4a0a-a475-805fa9a5e354",
                                                "sense_id": "8b4a7324-b660-3d17-a111-60e372a2a690",
                                                "text": "„Kurator und Senat der Universität empfingen den Trauerzug am Kircheneingang; der Sarg wurde auf einem Katafalk vor dem Altar aufgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fe96494-28f4-452a-bd7e-ec010378acbd",
                        "source_entry_id": "540d90a8-9e74-3737-a914-0b511eb85584",
                        "source_sense_id": "835e4626-ba2c-3ce7-a949-73af26bc1837",
                        "source_sense_description": "offertafel voor godsdienstige plechtigheden",
                        "target_lang_word": "altar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be4d6886-9cf6-3379-a7bf-f500ec1e206c",
                                        "entry_id": "96367733-c243-3602-b162-49711ca2b7e1",
                                        "glosses": [
                                            "A table or similar flat-topped structure used for religious rites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6987d35-b598-4133-a4c4-d30a702078e4",
                                                "sense_id": "be4d6886-9cf6-3379-a7bf-f500ec1e206c",
                                                "text": "To hawke, or els to hunt\nFrom the auter to the funt,\nWyth cry unreverent,\nBefore the sacrament,\nWythin the holy church bowndis,\nThat of our fayth the grownd is."
                                            },
                                            {
                                                "example_id": "0628b922-aac3-4f5c-bbcc-128b9058480b",
                                                "sense_id": "be4d6886-9cf6-3379-a7bf-f500ec1e206c",
                                                "text": "Wax models of the pudenda of both sexes were regularly placed before the altar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73fef163-0e44-3d07-a5a5-b51222ec540f",
                                        "entry_id": "96367733-c243-3602-b162-49711ca2b7e1",
                                        "glosses": [
                                            "A raised area around an altar in a church; the sanctuary."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9adf4a1a-09a8-3610-bd59-a003b8c71702",
                                        "entry_id": "96367733-c243-3602-b162-49711ca2b7e1",
                                        "glosses": [
                                            "Any (real or notional) place where something is worshipped or sacrificed to."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b000cddc-3780-4b18-9761-0b085caf2772",
                                                "sense_id": "9adf4a1a-09a8-3610-bd59-a003b8c71702",
                                                "text": "[…]now marking the end of ascetic rationalism, the monadology no longer implied a sacrifice of individuality on the altar of rationality."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6cf77db9-abf2-4a09-a2a7-430579c054ba",
                        "source_entry_id": "540d90a8-9e74-3737-a914-0b511eb85584",
                        "source_sense_id": "835e4626-ba2c-3ce7-a949-73af26bc1837",
                        "source_sense_description": "offertafel voor godsdienstige plechtigheden",
                        "target_lang_word": "autel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "autel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3d80ccf-981e-3d68-a751-3da6b3460b22",
                                        "entry_id": "454050d7-3f04-3f61-95fd-1227dce146a0",
                                        "glosses": [
                                            "Table ou monument, en bois ou en pierre, à l’usage des sacrifices."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796d547c-6542-45fd-8116-2b153fdc3c94",
                                                "sense_id": "b3d80ccf-981e-3d68-a751-3da6b3460b22",
                                                "text": "On trouvait dans le Latium une fontaine du soleil, auprès de laquelle étaient élevés deux autels, sur lesquels Énée arrivant en Italie sacrifia."
                                            },
                                            {
                                                "example_id": "f1b52a64-4960-4ca5-ae5c-b21724fad1f8",
                                                "sense_id": "b3d80ccf-981e-3d68-a751-3da6b3460b22",
                                                "text": "Non seulement il invita ses concitoyens à déposer leurs ressentiments et leurs griefs sur l’autel de la patrie, mais il demanda encore que le bienfait de cette pacification fût étendu aux autres peuples, et que la France, introduisant parmi les nations une nouvelle diplomatie, jetât les fondements d'une alliance universelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8ccc067-a347-33c2-9501-8929dd075cb5",
                                        "entry_id": "454050d7-3f04-3f61-95fd-1227dce146a0",
                                        "glosses": [
                                            "Table où l’on célèbre la messe, chez les chrétiens."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e593ba5-a9fe-4b9f-9a89-2a61c5fb7fa6",
                                                "sense_id": "c8ccc067-a347-33c2-9501-8929dd075cb5",
                                                "text": "C'était, comme je l’ai dit, une ancienne chapelle ; […]. Je cherchai des yeux s’il restait à la muraille, ou sur ce qui avait été l’autel, quelque signe de culte ; la muraille était nue, l’autel était ras."
                                            },
                                            {
                                                "example_id": "7896ad54-a505-4cd2-bcd4-6bfc82ebfe98",
                                                "sense_id": "c8ccc067-a347-33c2-9501-8929dd075cb5",
                                                "text": "Quand je la menai à l’autel, j’étais bien convaincu que ma femme l’emportait en beauté sur toutes les femmes belles de la terre, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bee5c4c-860f-39db-a253-80eabec6d2a2",
                                        "entry_id": "454050d7-3f04-3f61-95fd-1227dce146a0",
                                        "glosses": [
                                            "Droit de jouir des oblations et des revenus casuels d'une église."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe9baa60-80e0-4310-aa0b-7a20a6e40984",
                                                "sense_id": "7bee5c4c-860f-39db-a253-80eabec6d2a2",
                                                "text": "Voici enfin le premier document officiel constatant l'existence de notre village : c'est la charte d'Albéric de Humbert, archevêque de Reims (1207-1219), donnant à l'église de Reims les autels de Bar-les-Buzancy, Chennery et Landres : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a433cc61-5918-3e92-b908-c5c49de90a73",
                                        "entry_id": "454050d7-3f04-3f61-95fd-1227dce146a0",
                                        "glosses": [
                                            "Religion, culte religieux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3074c738-d6c5-4e97-a578-6314ba795a56",
                                                "sense_id": "a433cc61-5918-3e92-b908-c5c49de90a73",
                                                "text": "Enfin la Camarilla et le parti monastique tout entier, se sont empressés à l’envi de prédire qu’une ville si suspecte ne pouvait manquer d’être bientôt un foyer de libéralisme et de philosophie ; […] ; que c’était appeler une révolution nouvelle, et livrer l’autel et le trône à des mains impies."
                                            },
                                            {
                                                "example_id": "1d1ca2e7-6553-493c-991b-33dc41c0c8f9",
                                                "sense_id": "a433cc61-5918-3e92-b908-c5c49de90a73",
                                                "text": "Si dans le salon de l’hôtel de la Mole, quelque imprudent oubliait le lieu où il était et se permettait l’allusion la plus éloignée à une plaisanterie contre les intérêts vrais ou supposés du trône ou de l’autel, Mathilde devenait à l’instant d’un sérieux de glace."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
