                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "aec28c28-7062-4c4d-999a-8a9c845e5b79",
                        "entry_id": "b9e8b4e1-bb29-30d2-a3dd-c8e8c723ce0a",
                        "tags": [
