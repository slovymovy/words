                ],
                "senses": [
                    {
                        "sense_id": "0b4d681f-fafb-3ea8-bd4d-98e06dba170f",
                        "entry_id": "886a9ad3-c5eb-39f0-a669-82462410ada7",
                        "glosses": [
                            "Nommer pape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d3768d3-262e-4d3b-9dcf-3e4f71905e03",
                                "sense_id": "0b4d681f-fafb-3ea8-bd4d-98e06dba170f",
                                "text": "Cardinaux papifiants, cardinaux qui assistent au conclave et qui, n'ayant pas de prétention pour eux-mêmes, nomment le pape. On les oppose aux cardinaux papables."
                            },
                            {
                                "example_id": "b6747916-9418-4e8f-9410-58bd42286884",
                                "sense_id": "0b4d681f-fafb-3ea8-bd4d-98e06dba170f",
                                "text": "Mais c'était le seul à pouvoir être papifié."
                            },
                            {
                                "example_id": "01dee783-b4a4-4a3c-b92d-34d5701976ef",
                                "sense_id": "0b4d681f-fafb-3ea8-bd4d-98e06dba170f",
                                "text": "Mais ça augmentait peut-être ses chances d'être « papifié »."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b182fcd-0f29-3044-8be6-60f1a2b7f176",
                        "entry_id": "886a9ad3-c5eb-39f0-a669-82462410ada7",
                        "glosses": [
                            "Exercer la fonction de pape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6edc9a05-bc88-48e4-8dbf-2e6d5ca2efd9",
                                "sense_id": "2b182fcd-0f29-3044-8be6-60f1a2b7f176",
                                "text": "Le pape Sixte IV. mourut aussi l'année suivante le 11 du mois d'Août 1484, ayant papifié treize ans ou environ, & à la place fut élu & élevé au Siege Pontifical Jean-Baptiste Cyba, Gennois, Prêtre Cardinal de S. Laurent en Lucine, qui se fit nommer Innocent VIII."
                            }
                        ]
                    }
                ],
