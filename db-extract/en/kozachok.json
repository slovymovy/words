                    {
                        "translation_id": "4b85a12b-51c6-4450-9aa6-a447922501dc",
                        "source_entry_id": "9d81be16-be40-32b8-b999-f3f4b1b2e037",
                        "source_sense_id": "09c84beb-149a-343d-8030-53d4791e61cd",
                        "source_sense_description": "Ukrainian and Russian couple-dance",
                        "target_lang_word": "kazatchok",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kazatchok",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9bc6a941-2d40-35b3-a4eb-d97c8d376254",
                                        "entry_id": "98e3dc42-db6e-3980-a219-bd054e5a9607",
                                        "glosses": [
                                            "Danse traditionnelle originaire d’Ukraine pratiquée jadis par les Cosaques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf6cd9bb-734d-4e97-96e4-ccc29a8f8bf6",
                                                "sense_id": "9bc6a941-2d40-35b3-a4eb-d97c8d376254",
                                                "text": "Colombe a supposé que c’était ainsi que se dansait le kazatchok."
                                            },
                                            {
                                                "example_id": "a81a2fb3-de3e-461f-b02d-0510e51a2bea",
                                                "sense_id": "9bc6a941-2d40-35b3-a4eb-d97c8d376254",
                                                "text": "Je te ferai grâce du kazatchok pour cette fois, plaisanta Dimitri."
                                            },
                                            {
                                                "example_id": "0204f94c-0881-46be-848f-772384771beb",
                                                "sense_id": "9bc6a941-2d40-35b3-a4eb-d97c8d376254",
                                                "text": "La musique nostalgique des Cosaques aidant à son illusion, il abolissait le restaurant de nuit, les murs historiés d’armes circassiennes et les danseuses en jupe rouge, accroupies pour danser une Kazatchok."
                                            },
                                            {
                                                "example_id": "4c02a9e4-6f83-451b-bbbe-f1d97d1c76a5",
                                                "sense_id": "9bc6a941-2d40-35b3-a4eb-d97c8d376254",
                                                "text": "Des caprices de pin-up, des croqueuses de diamants qui se déhanchent pour le milliardaire du jour, des vedettes américaines en villégiature à Cinecittà qui veulent en montrer aux jeunes Romains, des gigolos qui se lancent dans des kazatchoks pour impressionner la cliente, oui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2115e0c3-5d48-4ff2-97ed-cf4489a5f221",
                        "source_entry_id": "9d81be16-be40-32b8-b999-f3f4b1b2e037",
