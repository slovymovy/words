                        "ru": "форма первого лица единственного числа настоящего времени глагола 'отвечать'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "answer",
                                "target_lang_sense_clarification": "I answer"
                            },
                            {
                                "target_lang_word": "reply",
                                "target_lang_sense_clarification": "I reply"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отвечаю",
