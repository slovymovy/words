                "senses": [
                    {
                        "sense_id": "37b8770d-5d6a-3bad-87f0-a05e47b23094",
                        "entry_id": "71113b97-bc48-3442-ade9-bffc72a90484",
                        "glosses": [
                            "das Be- und Entlüften von Küchenräumen; Lufterneuerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63b1d9cf-cab9-42aa-a9d4-247e1a33527a",
                                "sense_id": "37b8770d-5d6a-3bad-87f0-a05e47b23094",
                                "text": "Die Küchenlüftung wird im privaten Bereich durch ein offenes Fenster und/oder eine Dunstabzugshaube realisiert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b92d6c71-43ff-3b29-955e-aa44cccace09",
                        "entry_id": "71113b97-bc48-3442-ade9-bffc72a90484",
                        "glosses": [
                            "technische Komponenten und Einrichtungen zu [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ab84b6d-2e66-4553-bda9-95f5a337938b",
                                "sense_id": "b92d6c71-43ff-3b29-955e-aa44cccace09",
                                "text": "„ Bezogen auf die Küche sind insbesondere bei der Küchenlüftung / Dunstabzughaube spezielle Anforderungen zu beachten“"
                            },
                            {
                                "example_id": "a8c69cb9-cb48-4555-9b2d-90e4cd7ca112",
                                "sense_id": "b92d6c71-43ff-3b29-955e-aa44cccace09",
                                "text": "„Die Aufgabe einer Küchenlüftung ist es, die möglichen negativen Auswirkungen aller Störfaktoren auf Küchenpersonal, Gebäude und vor allem Hygiene zu verhindern.“"
                            },
                            {
                                "example_id": "57e14a0b-2baa-404d-97b2-af1949c72e76",
                                "sense_id": "b92d6c71-43ff-3b29-955e-aa44cccace09",
                                "text": "„Bei normalen Küchenlüftungen können einstufige, mehrstufige oder variabel einstellbare Abluftventilatoren verwendet werden.“"
                            },
                            {
                                "example_id": "65125d48-1a10-47f8-9034-655614581744",
                                "sense_id": "b92d6c71-43ff-3b29-955e-aa44cccace09",
                                "text": "„Doch in Zeiten luftdichter Bauwerksabdichtungen müssen Hausherren beim Thema Küchenlüftung grundlegend umdenken“"
                            },
                            {
                                "example_id": "dc95b4e3-b714-4635-afce-6fcb1fbe0a19",
                                "sense_id": "b92d6c71-43ff-3b29-955e-aa44cccace09",
                                "text": "„Die Aufgabe der Küchenlüftung ist zunächst einmal die Abfuhr von Lasten (Wärme, Feuchtigkeit und Aerosole), die bei Koch- und Spülvorgängen emittiert werden, um erträgliche Arbeitsbedingungen für das Küchenpersonal zu realisieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
