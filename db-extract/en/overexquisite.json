                        "glosses": [
                            "Excessively exquisite; too exact or careful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b7ff01a-5199-4680-8ecc-da99fc180d36",
                                "sense_id": "0c07d283-f6f9-3a2d-b2bc-ed4a8b2de3e8",
                                "text": "‘Be not overexquisite/To cast the fashion of uncertain evils.'\""
                            },
                            {
                                "example_id": "1782862e-720a-4515-b6bd-1975289455ed",
                                "sense_id": "0c07d283-f6f9-3a2d-b2bc-ed4a8b2de3e8",
                                "text": "Nevertheless, in times like these it does not do to be overexquisite in emphasizing defects of system or crudities of theology."
                            },
                            {
                                "example_id": "c74b47ba-0600-453d-8363-d3b4f7f50de6",
                                "sense_id": "0c07d283-f6f9-3a2d-b2bc-ed4a8b2de3e8",
                                "text": "If his humour does not often compel to Olympian laughter, it is, on the other hand, never studied nor overexquisite, nor strained for effect."
                            }
                        ]
                    }
                ],
