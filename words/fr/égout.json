                },
                {
                    "sense_id": "74271a61-c27a-3db1-876e-68cc6601f410",
                    "sense_definition": "Chute ou écoulement naturel ou aménagé des eaux provenant d'un lieu particulier.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le propriétaire a soigneusement aménagé l'<w>égout</w> des eaux de ruissellement pour protéger ses cultures en terrasse."
                        },
                        {
                            "text": "Un fossé profond recueille l'<w>égout</w> de plusieurs sources afin d'alimenter le bassin du village."
