                "senses": [
                    {
                        "sense_id": "cc959730-23b8-3900-8128-41d33f269f4f",
                        "entry_id": "c2d23288-ad30-3bcb-9522-1fde5107b251",
                        "glosses": [
                            "To impose Jewish beliefs or customs on someone; to convert to Judaism; to make Jewish."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6db3de31-f688-4c5f-8246-6dd1a836eee0",
                                "sense_id": "cc959730-23b8-3900-8128-41d33f269f4f",
                                "text": "The heretical Theodotion, the Judaized Symmachus."
                            },
                            {
                                "example_id": "f165794b-1826-494b-802e-4b7727787dab",
                                "sense_id": "cc959730-23b8-3900-8128-41d33f269f4f",
                                "text": "They were Judaizing doctors, who taught the observation of the Mosaic law."
                            },
                            {
                                "example_id": "10129632-c920-4d7d-8225-86b3be0423cd",
                                "sense_id": "cc959730-23b8-3900-8128-41d33f269f4f",
                                "text": "[…] allowing “Israel” to exploit such situation to expropriate further Palestinian lands and to Judaize their sanctities and holy sites."
                            }
                        ]
                    },
                    {
                        "sense_id": "96c09370-b195-364f-b3ce-00c42bc6acd7",
                        "entry_id": "c2d23288-ad30-3bcb-9522-1fde5107b251",
                        "glosses": [
                            "To be engaged in activity that imposes Jewish beliefs or customs on someone or something."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "587bf68d-5487-4d31-92c2-d63c2773a09f",
                                "sense_id": "96c09370-b195-364f-b3ce-00c42bc6acd7",
                                "text": "Later polemicists employ anti-Muslim rhetoric, especially allegations that Muslims themselves judaize, in similar fashion."
                            }
                        ]
                    }
                ],
