    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a3263c82-4eaa-389b-aa80-b99b6d97e4b0",
                    "sense_definition": "Recouvrir entièrement d'eau, faire disparaître sous les flots.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les vagues géantes ont fini par <w>submerger</w> la jetée pendant la tempête nocturne."
                        },
                        {
                            "text": "Si le niveau de la mer monte, l'eau va rapidement <w>submerger</w> cette petite île côtière."
                        }
                    ],
                    "synonyms": [
                        "inonder",
                        "engloutir"
                    ],
                    "common_phrases": [
                        "submerger les côtes",
                        "être submergé par les eaux"
                    ]
                },
                {
                    "sense_id": "e0a6467f-6a17-32c1-8d09-3756612259ff",
                    "sense_definition": "Déborder ou accabler quelqu'un sous une accumulation de tâches, de travail ou de demandes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'approche des fêtes, le service client est complètement <w>submergé</w> d'appels et de courriels."
                        },
                        {
                            "text": "Je ne pourrai pas venir ce soir car je suis <w>submergé</w> de travail au bureau."
                        }
                    ],
                    "synonyms": [
                        "accabler"
                    ],
                    "common_phrases": [
                        "submergé de travail",
                        "être submergé d'appels"
                    ]
                },
                {
                    "sense_id": "b1f729f2-9ae7-3f46-8097-99a9159147af",
                    "sense_definition": "Envahir brusquement et intensément, en parlant d'un sentiment ou d'une émotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En montant sur scène pour recevoir son prix, l'actrice s'est sentie <w>submergée</w> par l'émotion."
                        },
                        {
                            "text": "Il a essayé de rester calme pour ne pas se laisser <w>submerger</w> par la panique."
                        }
                    ],
                    "synonyms": [
                        "envahir"
                    ],
                    "common_phrases": [
                        "submergé par l'émotion",
                        "se laisser submerger"
                    ]
                }
            ]
        }
    ]
