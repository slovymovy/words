                "senses": [
                    {
                        "sense_id": "84be1305-0c80-38a7-8ac4-2135761b935c",
                        "entry_id": "787e2f5f-17fc-31db-b292-fb2911a184d7",
                        "glosses": [
                            "Manger avidement et avec excès."
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "3eddff25-6517-4e11-96ff-3c97d4f044cc",
                                "sense_id": "84be1305-0c80-38a7-8ac4-2135761b935c",
                                "text": "Mais la rue s’accroupit et se mit à brailler: « Allons bâffrer ! »"
                            },
                            {
                                "example_id": "8de7fd4b-682a-451a-8c10-c34cb832a660",
                                "sense_id": "84be1305-0c80-38a7-8ac4-2135761b935c",
                                "text": "Un mec qui sait bâffrer sait vivre, et un homme qui sait vivre enchetibe les autres, ceux qui sont au Vittel et aux carottes vichy."
                            }
                        ]
                    },
