                "senses": [
                    {
                        "sense_id": "0058997b-8592-3cb6-afe5-612231aad525",
                        "entry_id": "72a44c8e-21fb-351e-bb3e-e51b97cd938f",
                        "glosses": [
                            "Person, die in einer Behörde oder einem Betrieb eine Unterorganisation, eine Abteilung, führt"
                        ],
                        "tags": [
                            "Betriebswirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "54f6af0f-6aa6-4bd6-a3f6-7262d62e22b9",
                                "sense_id": "0058997b-8592-3cb6-afe5-612231aad525",
                                "text": "In einem größeren Betrieb gibt es mehrere Abteilungsleiter."
                            },
                            {
                                "example_id": "19825bc9-9383-477b-bc24-9520baea63f9",
                                "sense_id": "0058997b-8592-3cb6-afe5-612231aad525",
                                "text": "„Zwar seien die Einsätze teuer, die dabei verwendete Wärmebildkamera erziele aber so gute Erfolge, dass die Hubschrauber einfach öfter angefordert würden, erklärt Werner Senn, Abteilungsleiter der Flugpolizei im Innenministerium.“"
                            },
                            {
                                "example_id": "4258055b-c531-402a-916b-da4d6cf686b6",
                                "sense_id": "0058997b-8592-3cb6-afe5-612231aad525",
                                "text": "„Der Abteilungsleiter schnaubte verächtlich.“"
                            },
                            {
                                "example_id": "0780d820-80cd-4bd3-ac7d-fb4049aae628",
                                "sense_id": "0058997b-8592-3cb6-afe5-612231aad525",
                                "text": "„In den letzten Jahren war er Abteilungsleiter im Öl- und Energieministerium gewesen, hatte Ola erzählt, mittlerweile war er im Ruhestand, aber offenbar erst seit Kurzem.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ca620876-ef1a-4a7f-b7ec-9dd1f3184a8b",
                        "source_entry_id": "72a44c8e-21fb-351e-bb3e-e51b97cd938f",
                        "source_sense_id": "0058997b-8592-3cb6-afe5-612231aad525",
                        "source_sense_description": "Person, die in einer Behörde oder einem Betrieb eine Abteilung führt",
                        "target_lang_word": "department head",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "bed96f22-612d-47f4-ab3a-ba821f8cc307",
                        "source_entry_id": "72a44c8e-21fb-351e-bb3e-e51b97cd938f",
                        "source_sense_id": "0058997b-8592-3cb6-afe5-612231aad525",
                        "source_sense_description": "Person, die in einer Behörde oder einem Betrieb eine Abteilung führt",
                        "target_lang_word": "chef de service",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chef de service",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                        "entry_id": "436064c7-3a6e-321e-9869-ed5993f0215a",
                                        "glosses": [
                                            "Personne chargée de la direction d’un service au sein d’une entreprise ou d’une administration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bdc821c-d20d-4540-92dc-2b3b63f32d86",
                                                "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                                "text": "Non, tu ne saurais concevoir ce que la veuve d’un modeste fonctionnaire, chef de service à la Préfecture, peut donner de soins à un fils qui est tout ce qui lui reste au monde."
                                            },
                                            {
                                                "example_id": "4364101f-6f78-44d2-af76-c8ddfdb9c77c",
                                                "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                                "text": "Cependant, soit par goût, soit parce qu’il avait trois enfants, il entra dans les bureaux de la Ville de Paris : il y fit une longue carrière, qu’il termina chef de service et décoré."
                                            },
                                            {
                                                "example_id": "08e0736c-5a93-4eb3-beec-79660ef6e08a",
                                                "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                                "text": "Pour finir, la chef de service rappelle qu’il faut savoir prendre en compte les moyens dont on dispose dans une négociation."
                                            },
                                            {
                                                "example_id": "fd0de55b-7466-4fc1-91f1-3d6f9e355c19",
                                                "sense_id": "e2375959-6693-3d25-b15e-d453d677d18e",
                                                "text": "Le décret nᵒ 2012-32 du 9 janvier 2012 définit le statut d’emploi des emplois de chef de service et de sous-directeur des administrations de l’Etat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9cad7cf2-26dc-4ad6-91a8-1e187a5fbd8a",
                        "source_entry_id": "72a44c8e-21fb-351e-bb3e-e51b97cd938f",
                        "source_sense_id": "0058997b-8592-3cb6-afe5-612231aad525",
                        "source_sense_description": "Person, die in einer Behörde oder einem Betrieb eine Abteilung führt",
                        "target_lang_word": "chef de rayon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chef de rayon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "985cf1bc-fe1f-3c65-922f-7b73ea34f79a",
                                        "entry_id": "8a9210ca-1fd6-3992-a895-0d2e9e1d7e92",
                                        "glosses": [
                                            "Celui ou celle qui a la direction d'un groupe d’articles de même espèce, dans un même magasin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a9cbd1-eb04-4aa5-a051-4c17b0af5d0b",
                                                "sense_id": "985cf1bc-fe1f-3c65-922f-7b73ea34f79a",
                                                "text": "Maurice Bouchor se penchait sur l’enfance avec la sollicitude universelle qu'ont les chefs de rayon pour les clientes des grands magasins ; cela me flattait."
                                            },
                                            {
                                                "example_id": "8c88e199-a8c8-4850-bb4b-999499a29fc5",
                                                "sense_id": "985cf1bc-fe1f-3c65-922f-7b73ea34f79a",
                                                "text": "Quand M. Dumoulin prendra sa retraite, je serai chef de rayon. CHEF DE RAYON. Mais nous n’en sommes pas là. J’ai des espérances. Je vis d’espérance."
                                            }
                                        ]
                                    }
                                ]
                            }
