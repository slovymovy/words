                "senses": [
                    {
                        "sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                        "entry_id": "e3435dd2-15d6-3014-80fe-4bb77395cca8",
                        "glosses": [
                            "Gegenstand, der von jemandem vererbt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29443062-60b3-46c0-bc19-613158ca96b4",
                                "sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                                "text": "Dieser Tisch ist ein besonders schönes Erbstück."
                            },
                            {
                                "example_id": "0da5c773-174a-4633-96b1-9a8f43fd9778",
                                "sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                                "text": "„Außer einem verlegenen Lächeln zeigte er keinerlei Wirkung angesichts der kostbaren Erbstücke.“"
                            },
                            {
                                "example_id": "477cb637-8891-4d8b-ac9a-a208b0f1cf2d",
                                "sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                                "text": "„Elf Personen, zählte ich, saßen um den ovalen Tisch herum, ein schönes Möbel, sicher ein Erbstück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "667d33fe-df29-4c31-adee-4ebc750a23a1",
                        "source_entry_id": "e3435dd2-15d6-3014-80fe-4bb77395cca8",
                        "source_sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                        "source_sense_description": "Gegenstand, der Bestandteil eines Erbes ist/war",
                        "target_lang_word": "heirloom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heirloom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a158133-43b2-3800-9ed0-de227f61bb93",
                                        "entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
                                        "glosses": [
                                            "A valued possession that has been passed down through the generations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f067837c-aede-41eb-b06b-a385123e0422",
                                                "sense_id": "5a158133-43b2-3800-9ed0-de227f61bb93",
                                                "text": "Morning rehearsal starts at eleven. Wheeler takes a taxi from the hotel to the venue, bringing his tuxedo and his violin with him. His violin is an heirloom, more than a hundred years old, and while he's touring it never leaves his sight. (His tuxedo is just a tuxedo.)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                                        "entry_id": "65c112b2-e789-3def-b567-a10ebbeb4686",
                                        "glosses": [
                                            "An old crop variety that has been passed down through generations of farmers by seed saving and cultivation, in contrast to modern cultivars used in large-scale agriculture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33a5b844-81a7-4690-8127-32ff86ab9e43",
                                                "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                                                "text": "My last trip to the market barely yielded enough unmealy heirlooms for a couple of salads."
                                            },
                                            {
                                                "example_id": "548d4ebb-68ca-43e6-82d6-1c3969e33a97",
                                                "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                                                "text": "At Hortus Bulborum you will find heirloom narcissi that date back at least to the 15th century and famous old tulips like 'Duc van Tol' (1595) and its sports."
                                            },
                                            {
                                                "example_id": "86a3cd61-8cc6-4bf1-b8cf-06ee6f2a239e",
                                                "sense_id": "b0482590-fc50-3d03-b7fe-01671039bae9",
                                                "text": "In a paper published Thursday in the journal Science, a team of researchers say they analyzed the genetic code of nearly 400 varieties of tomatoes ― from the common red supermarket types to the funky heirlooms found in farmers markets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93ce549a-c524-4c79-8f81-3f485af1d3bd",
                        "source_entry_id": "e3435dd2-15d6-3014-80fe-4bb77395cca8",
                        "source_sense_id": "9edb4078-d76d-3935-8212-209ae0704e39",
                        "source_sense_description": "Gegenstand, der Bestandteil eines Erbes ist/war",
                        "target_lang_word": "héritage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "héritage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2d44a454-d560-3898-a625-53ce2c1f293e",
                                        "entry_id": "11e896d7-390c-3105-936e-9732f64456e8",
                                        "glosses": [
                                            "Ce qui vient par voie de succession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a686255-19f1-40a9-ae93-8c8ba074082c",
                                                "sense_id": "2d44a454-d560-3898-a625-53ce2c1f293e",
                                                "text": "…le droit à l’héritage, par primogéniture préférablement, parut d’un avantage si manifeste que l’ancien ordre social tendit toujours à généraliser cette institution."
                                            },
                                            {
                                                "example_id": "a938ff45-a8b8-4f87-b371-dc7044560b80",
                                                "sense_id": "2d44a454-d560-3898-a625-53ce2c1f293e",
                                                "text": "C’était un fauteuil que cet homme de bien tenait d’héritage et dans lequel il s’asseyait du matin au soir."
                                            },
                                            {
                                                "example_id": "f1f6ffdf-3f34-4270-926d-c467b782ca05",
                                                "sense_id": "2d44a454-d560-3898-a625-53ce2c1f293e",
                                                "text": "Au mot « héritage », presque tout le monde pitait mieux qu'une bande de poissons affamés. Et de fait: […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "469e4ec5-85f7-35b3-8958-6c463bcb4f6d",
                                        "entry_id": "11e896d7-390c-3105-936e-9732f64456e8",
                                        "glosses": [
                                            "L’ensemble des immeubles réels, comme terres, maisons, acquis ou non par succession."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57eabc88-93c2-44ec-b28b-be1c87159cc9",
                                                "sense_id": "469e4ec5-85f7-35b3-8958-6c463bcb4f6d",
                                                "text": "Le droit de clore et de déclore ses héritages, résulte essentiellement de celui de propriété, et ne peut être contesté à aucun propriétaire."
                                            },
                                            {
                                                "example_id": "4cbe30dd-0440-4954-8be2-0031cd9573a5",
                                                "sense_id": "469e4ec5-85f7-35b3-8958-6c463bcb4f6d",
                                                "text": "Il vaut mieux laisser comme héritage un jardin prospère qu’un monceau de ruines."
                                            },
                                            {
                                                "example_id": "cfa446d0-3fca-4cc9-8e24-85753fac58f4",
                                                "sense_id": "469e4ec5-85f7-35b3-8958-6c463bcb4f6d",
                                                "text": "Dans ce département où la propriété est si morcelée qu’il ne contient peut-être pas vingt domaines de 10 hectares, est-ce le désir de ne pas diviser les héritages qui pousse de plus en plus les ménages au malthusianisme?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f04acf0c-92f4-3221-8cd3-3fa110426b26",
                                        "entry_id": "11e896d7-390c-3105-936e-9732f64456e8",
                                        "glosses": [
                                            "Ce qui se transmet d’une génération à l’autre, matériellement ou symboliquement (valeurs, culture, traditions)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c80b9343-ae85-4481-ade6-51fbfd884bf0",
                                                "sense_id": "f04acf0c-92f4-3221-8cd3-3fa110426b26",
                                                "text": "Les formes, voilà le seul héritage que conservent les nobles."
                                            },
                                            {
                                                "example_id": "f4658612-d8f6-41f0-a2f8-aa64dc326a9c",
                                                "sense_id": "f04acf0c-92f4-3221-8cd3-3fa110426b26",
                                                "text": "Toutefois, en raison d’un héritage marqué par quatre siècles de scribalité et d’imprimerie, ces contenus de foi semblent souvent sans emprise apparente sur le vécu des jeunes générations et tombent à plat."
                                            },
                                            {
                                                "example_id": "02af0df2-b64e-453e-924e-6d6b35eba83e",
                                                "sense_id": "f04acf0c-92f4-3221-8cd3-3fa110426b26",
                                                "text": "On retrouve chez Abramow un héritage lisible de Guy Bourdin (1928-1991), immense photographe des années 1970, dont les cadrages acrobatiques, et les couleurs éclatantes, rendaient les mannequins à la fois ultrasexys et parfaitement puissantes."
                                            },
                                            {
                                                "example_id": "dbd50809-0029-49fe-bb70-a62f4eb0c9ba",
                                                "sense_id": "f04acf0c-92f4-3221-8cd3-3fa110426b26",
                                                "text": "Je m’en vais. Je vous laisse ma liberté en héritage, le bien le plus précieux de l’être humain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b8e0302-7faf-3fed-94d4-ff9f31519610",
                                        "entry_id": "11e896d7-390c-3105-936e-9732f64456e8",
                                        "glosses": [
                                            "Mécanisme par lequel une classe transmet ses attributs et méthodes à une autre."
                                        ],
                                        "tags": [
                                            "Programmation orientée objet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ae49293-450f-489e-adc7-ddb4c6cd12cf",
                                                "sense_id": "2b8e0302-7faf-3fed-94d4-ff9f31519610",
                                                "text": "Un lien d’héritage entre deux classes établit une relation de spécialisation - généralisation entre chaque objet de la première classe, dit objet spécialisé, et un objet de la deuxième classe, dit objet généralisé."
                                            },
                                            {
                                                "example_id": "e7813a01-90fc-45d8-922a-5a55deb9c079",
                                                "sense_id": "2b8e0302-7faf-3fed-94d4-ff9f31519610",
                                                "text": "L’héritage est un des mécanismes de la programmation moderne les moins bien compris. Il tente d’établir le postulat selon lequel « l’héritage modélise une relation est-un », mais ce n’est qu’une illusion sémantique. Conceptuellement, il existe deux types d’héritage : l’implémentation et l’interface."
                                            },
                                            {
                                                "example_id": "c6de2801-eaf4-4382-8179-a13072fc8d5d",
                                                "sense_id": "2b8e0302-7faf-3fed-94d4-ff9f31519610",
                                                "text": "Depuis leur création, les langages orientés objet utilisent le paradigme de l’héritage. C++ autorise l’héritage multiple alors que Java ne permet d’hériter que d’une seule classe. En programmation orientée objet les développeurs réutilisent souvent le code en héritant des attributs et des comportements des classes existantes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e14e6bb-8121-36f2-b3bf-2985de42389a",
                                        "entry_id": "11e896d7-390c-3105-936e-9732f64456e8",
                                        "glosses": [
                                            "Obtention de propriétés à partir de la roche-mère."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a587c3-4a86-4253-8730-2760dc3227fa",
                                                "sense_id": "0e14e6bb-8121-36f2-b3bf-2985de42389a",
                                                "text": "Le seul héritage suffit à expliquer l’existence des lithovertisols. Souvent, cependant, l’héritage n’est que partiel, mais il suffit à déclencher à la fois les phénomènes physiques et les dynamismes géochimiques propres au développement des topovertisols."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
