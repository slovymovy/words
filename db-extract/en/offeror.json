                        "glosses": [
                            "One who makes an offer to another; someone who presents something to another for acceptance or rejection."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca95ad2-8467-4020-868e-d7a4a7d4a42d",
                                "sense_id": "8c3cc9dc-a889-36a7-ab35-03ac593b670c",
                                "text": "A unilateral contract consists of a promise on the part of the offeror and performance of the requisite terms by the offeree."
                            },
                            {
                                "example_id": "cee41787-d6c5-4e10-ad0c-882fe12321b9",
                                "sense_id": "8c3cc9dc-a889-36a7-ab35-03ac593b670c",
                                "text": "Acceptance of the offer terminates the power of revocation that the offeror ordinarily has."
                            }
                        ]
                    }
