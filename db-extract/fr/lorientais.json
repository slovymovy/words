                                "example_id": "4fa39088-9003-4e9b-8f2d-c3f832192bdd",
                                "sense_id": "a12ef220-f47b-3f87-bfcb-ee2212f2f868",
                                "text": "Déjà président des pêcheurs morbihannais depuis 2012, le Lorientais Olivier Le Nézet vient d’être élu, jeudi, président du Comité national des pêches, le premier Breton à accéder à ce poste."
                            },
                            {
                                "example_id": "e66072c9-94af-4488-a376-f182c643683a",
                                "sense_id": "a12ef220-f47b-3f87-bfcb-ee2212f2f868",
                                "text": "Porte-parole des pêcheurs, le Lorientais David Le Quintrec ne croit pas que le soufflé va retomber de sitôt."
                            }
                        ]
                    }
