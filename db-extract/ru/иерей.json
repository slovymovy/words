                "translations": [
                    {
                        "translation_id": "2ae8820f-adec-4ab9-bd12-a0ae9321361f",
                        "source_entry_id": "db80b89f-7a77-3326-aa77-7ef37f9b76b4",
                        "source_sense_id": "9518cefd-40f1-3327-94a4-2f2eef694858",
                        "target_lang_word": "priest",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "priest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                        "entry_id": "a8c44922-8cb0-384e-9064-cdd173d1c253",
                                        "glosses": [
                                            "A religious clergyman (clergywoman, clergyperson) who is trained to perform services or sacrifices at a church or temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93341e8a-44f3-4f95-b7cc-a1d10280d18d",
                                                "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                                "text": "The priest at the Catholic church heard his confession."
                                            },
                                            {
                                                "example_id": "669057ab-b4ae-462d-9903-79d834fb901a",
                                                "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                                "text": "The Shinto priest burnt incense for his ancestors."
                                            },
                                            {
                                                "example_id": "b8b8f450-b8cd-41cd-b982-d4a60ab2d3d9",
                                                "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                                "text": "The Israelite priests were descended from Moses' brother Aaron."
                                            },
                                            {
                                                "example_id": "e028db96-9316-4e65-ac3a-f1ead79ee4d4",
                                                "sense_id": "efce5a83-a303-3068-98d2-2d80f713cf5c",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "305009a5-9fb5-3872-8562-1192a993aab2",
                                        "entry_id": "a8c44922-8cb0-384e-9064-cdd173d1c253",
                                        "glosses": [
                                            "A blunt tool, used for quickly stunning and killing fish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3e86ebe-f013-4a4e-922e-48663c4f685e",
                                                "sense_id": "305009a5-9fb5-3872-8562-1192a993aab2",
                                                "text": "They flop and struggle, but she unhooks them swiftly, stunning them with a small brass priest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4404b956-4504-39d4-a420-912536e15feb",
                                        "entry_id": "a8c44922-8cb0-384e-9064-cdd173d1c253",
                                        "glosses": [
                                            "The highest office in the Aaronic priesthood."
                                        ],
                                        "tags": [
                                            "Mormonism"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "priest",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d4a2c7ad-87b7-3157-8c7c-381b1306f840",
                                        "entry_id": "13dda2c7-93fa-3574-99f4-7ce47856907e",
                                        "glosses": [
                                            "To ordain as a priest."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6856fbf2-3168-4d39-b963-642e4cd1aa5f",
                                                "sense_id": "d4a2c7ad-87b7-3157-8c7c-381b1306f840",
                                                "text": "If there bee any lasie fellow, any that cannot away with worke, any that would wallow in pleasures, hee is hastie to be priested. And when hee is made one, and has gotten a benefice, he consorts with his neighbour priests, who are altogether given to pleasures; and then both hee, and they, live, not like Christians, but like epicures; drinking, eating, feasting, and revelling, till the cow come home, as the saying is."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a6918da-72fb-4ba9-9c02-5e29fbacdd1a",
                        "source_entry_id": "db80b89f-7a77-3326-aa77-7ef37f9b76b4",
                        "source_sense_id": "9518cefd-40f1-3327-94a4-2f2eef694858",
