                ],
                "translations": [
                    {
                        "translation_id": "3858ebd5-24d1-4134-90c4-814fba78c467",
                        "source_entry_id": "8b097915-c336-333b-bbb5-f4c2534a2e0c",
                        "source_sense_id": "7eec19dc-1d7e-35ee-9ad5-fae8881d0523",
                        "target_lang_word": "Carib",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Carib",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1a7aa956-076f-34e7-9fe7-3cecebcec424",
                                        "entry_id": "be057d2d-ba6e-3a55-afd6-08e6158b547f",
                                        "glosses": [
                                            "A member of one of a number of Amerindian peoples who inhabit the coast of Central and South America and the Lesser Antilles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b38609b-fe74-4d8d-849e-a5976c36af1f",
                                                "sense_id": "1a7aa956-076f-34e7-9fe7-3cecebcec424",
                                                "text": "Mr. Dougherty had intended to make the outing with his unwonted wife an inconspicuous one. Uxoriousness was a weakness that the precepts of the Caribs did not countenance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5cc4d18-bec1-3177-a98b-2645e77cddf7",
                                        "entry_id": "be057d2d-ba6e-3a55-afd6-08e6158b547f",
                                        "glosses": [
                                            "A member of one of a number of Amerindian peoples who inhabit the coast of Central and South America and the Lesser Antilles.",
                                            "A member of the mainland or ‘proper’ Caribs (Kari'na), a Cariban people who inhabit the north coast of South America, in parts of Venezuela, Guyana, Suriname, and French Guiana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1c07ff9-85a1-4c17-8289-c5f69844198b",
                                                "sense_id": "d5cc4d18-bec1-3177-a98b-2645e77cddf7",
                                                "text": "Another people, the Surinen, lived near the coast. Like the Arawaks and the Caribs, they had migrated northward into Suriname. The Arawak and Carib peoples greatly outnumbered the Surinen. The Surinen were disappearing by the late 1400s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88d3cd63-f078-3449-bce3-8b054573a085",
                                        "entry_id": "be057d2d-ba6e-3a55-afd6-08e6158b547f",
                                        "glosses": [
                                            "A member of one of a number of Amerindian peoples who inhabit the coast of Central and South America and the Lesser Antilles.",
                                            "A member of the Kalinago people of the Lesser Antilles, an Arawakan people who took heavy cultural influence from the mainland Caribs and so were formerly known as Island Caribs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c351cf09-236b-3016-a238-c6995f7016e3",
                                        "entry_id": "be057d2d-ba6e-3a55-afd6-08e6158b547f",
                                        "glosses": [
                                            "A member of one of a number of Amerindian peoples who inhabit the coast of Central and South America and the Lesser Antilles.",
                                            "A member of the Garifuna people of Honduras, historically known as Black Caribs, descendants of mixed Kalinago people and Africans who were deported to the Central American mainland in the 18th century."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
