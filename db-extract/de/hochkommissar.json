                        "glosses": [
                            "mit wichtigen Aufgaben betrauter, oft diplomatischer Beamter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "339e0413-20bf-4cf0-85de-14c50bac1eb3",
                                "sense_id": "fb3cfdde-98a8-3103-9500-a16ea056d6d0",
                                "text": "„Hochkommissar Arthur Wauchope verglich sich selbst einmal mit einem Zirkusartisten, der versucht, auf zwei Pferden gleichzeitig zu reiten, von denen das eine nicht schnell und das andere nicht langsam laufen kann.“"
                            },
                            {
                                "example_id": "8dc9d59a-f2a0-4019-b1bf-4ed70d416ebb",
                                "sense_id": "fb3cfdde-98a8-3103-9500-a16ea056d6d0",
                                "text": "„Es brachte ihm einen Empfehlungsbrief ein, der an keinen Geringeren als den Hochkommissar in Kapstadt, Sir Alfred Milner, adressiert war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
