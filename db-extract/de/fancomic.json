                "senses": [
                    {
                        "sense_id": "669552f8-b426-3704-98db-c381adb2d02a",
                        "entry_id": "114e79df-93c2-3a8a-b1c8-e15b4f6f850c",
                        "glosses": [
                            "fancomic"
                        ],
                        "tags": [
                            "masculine",
                            "slang",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "c4232320-2043-41cf-b570-a394e17b7d2b",
                                "sense_id": "669552f8-b426-3704-98db-c381adb2d02a",
                                "text": "Sammelbaende werden 'tankoubon' genannt. Fancomics, die sehr weit verbreitet sind, heissen 'doujinshi'. In den tankoubons findet man auch einige wenige farbig gedruckte Seiten, obwohl Mangas eigentlich schwarzweiss (und telefonbuchdick :)) sind."
                            },
                            {
                                "example_id": "12e9209f-a09e-4c5c-b873-28935cd5cef0",
                                "sense_id": "669552f8-b426-3704-98db-c381adb2d02a",
                                "text": "Ich wollte nur darauf hinweisen, dass die dritte Folge des Fancomics \"Scheren aus Stahl\" online gegangen ist."
                            },
                            {
                                "example_id": "582a8c0c-f3d5-43c5-acbf-ed21bf5e00ea",
                                "sense_id": "669552f8-b426-3704-98db-c381adb2d02a",
                                "text": "Ich suche die o.g. Ausgabe des Fancomics.\nLeider ist das besagte Heft nicht mehr zu bestellen."
                            },
                            {
                                "example_id": "ee2ed534-64ac-402a-8154-0aabcbee60c9",
                                "sense_id": "669552f8-b426-3704-98db-c381adb2d02a",
                                "text": "Das ist ein Fancomic. Vampires Dawn gehört Marlex!",
                                "translation": "This is a fancomic. Vampires Dawn belongs to Marlex!",
                                "english": "This is a fancomic. Vampires Dawn belongs to Marlex!"
                            },
                            {
                                "example_id": "42b8a07f-2301-4cb3-8a1c-8cd577a188ad",
                                "sense_id": "669552f8-b426-3704-98db-c381adb2d02a",
                                "text": "Friedrich II. wird in der Erfinder-Serie des Mosaik von Hannes Hegen erwähnt und erscheint in Form seines Reiterstandbilds in der Weltreise-Serie des Mosaik ab 1976 und auf dem Titelbild eines Fanzines. Außerdem wird er in einem Kooperations-Comic, sowie in einem Werbecomic erwähnt und tritt in einem Fancomic richtig auf."
                            }
                        ]
                    }
