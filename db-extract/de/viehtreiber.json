                ],
                "senses": [
                    {
                        "sense_id": "dc0a0f4f-afa1-3e70-9ef1-6f28ba50a77b",
                        "entry_id": "56ea5cf2-b4a8-38ee-9ca7-94af775a7842",
                        "glosses": [
                            "Person, die meist beruflich das Vieh auf die Weide oder zum Markt treibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f39a3949-2459-4072-9c22-97e57c29c7e0",
                                "sense_id": "dc0a0f4f-afa1-3e70-9ef1-6f28ba50a77b",
                                "text": "Auf dem Weg begegnete uns ein Viehtreiber."
                            },
                            {
                                "example_id": "e54efac1-6793-4a32-9926-722817c8aec6",
                                "sense_id": "dc0a0f4f-afa1-3e70-9ef1-6f28ba50a77b",
                                "text": "„Die Männer in der Stadt, so sie nicht in den Krieg müssen, sind Viehtreiber und Rancharbeiter, sie tragen Stiefel und Baumwollhemden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98d28303-39ae-40c6-85a6-37c3c74f09e9",
                        "source_entry_id": "56ea5cf2-b4a8-38ee-9ca7-94af775a7842",
                        "source_sense_id": "dc0a0f4f-afa1-3e70-9ef1-6f28ba50a77b",
                        "source_sense_description": "Person, die meist beruflich das Vieh auf die Weide oder zum Markt treibt",
                        "target_lang_word": "drover",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drover",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "282776dc-cfe4-3caf-931f-a6ad93710a00",
                                        "entry_id": "c9dd79ea-3c35-37ad-8eff-fbcac27eb66e",
                                        "glosses": [
                                            "A person who drives animals (which are on foot or on the hoof, walking to some destination), especially cattle or sheep, and especially over long distances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee38e056-ee8f-423d-9970-1271f8142c1b",
                                                "sense_id": "282776dc-cfe4-3caf-931f-a6ad93710a00",
                                                "text": "In the present day, we take it for granted that livestock are transported by truck or rail, but in past centuries, they were driven by drovers, and a herd might be met on any street, road, or highway."
                                            },
                                            {
                                                "example_id": "ca90ce13-5172-4395-ab95-58e765727063",
                                                "sense_id": "282776dc-cfe4-3caf-931f-a6ad93710a00",
                                                "text": "Why, that's spoken like an honest drovier: so they sell bullocks."
                                            },
                                            {
                                                "example_id": "2aceca8f-6223-4b2a-a563-763f9878ecd6",
                                                "sense_id": "282776dc-cfe4-3caf-931f-a6ad93710a00",
                                                "text": "Daily driven / (Wife as drover) / Ill you've thriven-- / Ne'er in clover."
                                            },
                                            {
                                                "example_id": "c7ca30ed-068b-48e5-a7a4-b84e21c03a80",
                                                "sense_id": "282776dc-cfe4-3caf-931f-a6ad93710a00",
                                                "text": "Little is the modern-day Buchanon. In 2013 he oversaw the Brinkworth drive, taking 20,000 cattle owned by South Australian pastoralist Tom Brinkworth from western Queensland to southern NSW, separating them into smaller mobs and employing contract drovers to assist."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
