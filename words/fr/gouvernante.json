    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d1df326-71bf-32c2-b651-e94d93864670",
                    "sense_definition": "Femme engagée dans une famille pour s'occuper de l'éducation et des soins d'un ou plusieurs enfants.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "education_domestique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette famille bourgeoise a engagé une <w>gouvernante</w> pour enseigner le piano et le français aux enfants."
                        },
                        {
                            "text": "Les enfants aimaient beaucoup leur <w>gouvernante</w> qui leur racontait de belles histoires le soir."
                        }
                    ],
                    "synonyms": [
                        "préceptrice"
                    ],
                    "common_phrases": [
                        "engager une gouvernante",
                        "ancienne gouvernante"
                    ]
                },
                {
                    "sense_id": "5f2c6286-16f2-30e0-9f98-604299c9a981",
                    "sense_definition": "Femme chargée de la direction des affaires domestiques et de l'entretien de la maison chez un particulier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gestion_domestique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fidèle <w>gouvernante</w> préparait les repas et veillait sur la maison depuis plus de vingt ans."
                        },
                        {
                            "text": "Ce vieux monsieur laissait sa <w>gouvernante</w> gérer toutes les dépenses du foyer."
                        }
                    ],
                    "synonyms": [
                        "femme de charge"
                    ],
                    "common_phrases": [
                        "gouvernante de maison"
                    ]
                },
                {
                    "sense_id": "abc6f9ea-3ea0-3515-890b-c761cae3dc8f",
                    "sense_definition": "Responsable de l'entretien des chambres et de l'encadrement du personnel d'étage dans un établissement hôtelier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "hotellerie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La <w>gouvernante</w> vérifie la propreté irréprochable de chaque suite avant l'arrivée des clients."
                        },
                        {
                            "text": "Après plusieurs années dans cet hôtel, elle a été promue <w>gouvernante</w> générale."
                        }
                    ],
                    "common_phrases": [
                        "gouvernante générale",
                        "gouvernante d'étage"
                    ]
                },
                {
                    "sense_id": "a53bbf35-6b42-3150-afd0-040f8b5f75f7",
                    "sense_definition": "Femme placée à la tête d'une province, d'un État ou d'un grand territoire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La princesse Marguerite a exercé ses fonctions de <w>gouvernante</w> des Pays-Bas avec beaucoup d'autorité."
                        },
                        {
                            "text": "Le roi nomma sa sœur comme <w>gouvernante</w> de la région pour maintenir la paix."
                        }
                    ],
                    "synonyms": [
                        "gouverneure",
                        "gouvernatrice"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "souvent remplacé par gouverneure dans l'usage contemporain"
                        }
                    ]
                }
            ]
        },
