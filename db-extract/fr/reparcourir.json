                ],
                "senses": [
                    {
                        "sense_id": "290f1ed3-49ab-3308-944f-7e3f3a50013e",
                        "entry_id": "0381c0ca-fe12-37ba-9dc7-cfee4eb9523f",
                        "glosses": [
                            "Parcourir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d53f6cc-e4bc-400e-895c-d76cb3986c5d",
                                "sense_id": "290f1ed3-49ab-3308-944f-7e3f3a50013e",
                                "text": "Mais il monte moins qu’autrefois ; peut-être l’équitation est-elle liée pour lui au souvenir de trop de disparues ; peut-être est-il las d’avoir parcouru et reparcouru ces mêmes allées forestières."
                            },
                            {
                                "example_id": "7df7955f-56bc-404c-9df2-79c67a9d6c37",
                                "sense_id": "290f1ed3-49ab-3308-944f-7e3f3a50013e",
                                "text": "Reparcourir le chemin déjà parcouru, voilà l'essence de la méthode et du processus scientifique."
                            },
                            {
                                "example_id": "c71bec3e-58b6-4da4-b512-c4eccb779ea0",
                                "sense_id": "290f1ed3-49ab-3308-944f-7e3f3a50013e",
                                "text": "C'est céder au besoin de ressaisir le vécu entier, d'en éprouver le poids et la grâce ; c'est le reparcourir du regard et du cœur."
                            }
                        ]
                    },
                    {
                        "sense_id": "f1ef2c87-3cc1-3fb7-8416-126edcbaf3de",
                        "entry_id": "0381c0ca-fe12-37ba-9dc7-cfee4eb9523f",
                        "glosses": [
                            "Relire rapidement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "141c21b4-bbca-468b-995b-609f732f812e",
                                "sense_id": "f1ef2c87-3cc1-3fb7-8416-126edcbaf3de",
                                "text": "Depuis quelque temps, je voulais relire (reparcourir tout au moins) les Paroles d’un croyant, un des livres avertisseurs de ma jeunesse."
                            }
                        ]
                    }
                ],
