                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55e49c14-061b-4df9-b4dd-22c37b9cf92f",
                                "sense_id": "666f4e70-50d3-3007-8ded-f59b305e536c",
                                "text": "En 1872, les ouvriers cloutiers, qui se divisent en chevaliers, en piéciers et en boulonniers, étaient environ 1,000 à Paris. Ils essayèrent, sans résultat, plusieurs organisations corporatives, entre autres celle d'une chambre syndicale."
                            },
                            {
                                "example_id": "1229c3f7-c93a-4969-b402-22f96082ced0",
                                "sense_id": "666f4e70-50d3-3007-8ded-f59b305e536c",
                                "text": "Puis viennent les piéciers, payés suivant le travail effectivement exécuté, et non plus selon leur temps de présence."
                            }
                        ]
                    }
