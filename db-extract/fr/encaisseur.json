                    {
                        "sense_id": "6ee866ab-7511-3def-b244-c60dc44aecca",
                        "entry_id": "39edda68-e00f-3d73-ae64-7cf34e6c8a83",
                        "glosses": [
                            "Employé de banque ou de commerce qui va à domicile percevoir des sommes, recouvrer des effets, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34e5cb1e-27df-4aa9-863d-9c1d304165b1",
                                "sense_id": "6ee866ab-7511-3def-b244-c60dc44aecca",
                                "text": "Nous tombâmes sur une bande d’enfants qui jouaient aux gangsters. Cinq ou six gosses aux mâchoires contractées se jetaient sur l’un d’eux qui feignait de marcher tranquillement.\n« Où est sa sacoche ? hurlait celui qui semblait être leur chef.\nIls attaquaient sans doute un encaisseur de la Banque de France."
                            }
                        ]
                    }
                ],
