        "fr-extract.jsonl": [
            {
                "entry_id": "aed97510-5263-3d6e-8359-08d88030317d",
                "word": "Rhénanie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "178dd3fd-7cc0-3af9-9020-f55e51dac526",
                        "entry_id": "aed97510-5263-3d6e-8359-08d88030317d",
                        "glosses": [
                            "Région d’Allemagne voisine du cours du Rhin."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "5d3b43a2-25b2-4569-b3ae-0dbaaf08cd41",
                                "sense_id": "178dd3fd-7cc0-3af9-9020-f55e51dac526",
                                "text": "M. Litvinoff dénonce au Conseil le péril hitlérien : « L'Allemagne, comme le montre Mein Kampf, vise à dominer le continent. » Le soir, nouvelle réunion des Locarniens divisés, tandis qu'à Cologne, le général Gœring affirme que l'armée allemande n'évacuera jamais la Rhénanie."
                            },
                            {
                                "example_id": "8bc6df1e-0a0d-4195-a655-0f7898cada87",
                                "sense_id": "178dd3fd-7cc0-3af9-9020-f55e51dac526",
                                "text": "Les problèmes qui les agitaient — le redressement du franc, l’évacuation de la Rhénanie, les utopies de la S.D.N. — me paraissaient du même ordre que les affaires de famille et les ennuis d’argent ; ils ne me concernaient pas."
                            },
                            {
                                "example_id": "932faaa5-4cc1-484e-a8dd-dc1e7b0a9c91",
                                "sense_id": "178dd3fd-7cc0-3af9-9020-f55e51dac526",
                                "text": "Depuis des mois on savait parfaitement à Paris que la dénonciation par Hitler des accords de Locarno et la remilitarisation de la Rhénanie pouvaient survenir d'un moment à l'autre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bef31611-f233-481f-9c20-239cb82bd158",
                        "source_entry_id": "aed97510-5263-3d6e-8359-08d88030317d",
                        "source_sense_id": "178dd3fd-7cc0-3af9-9020-f55e51dac526",
                        "target_lang_word": "Rheinland",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rheinland",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8baeff5-2a84-3bf5-87ac-04c7232388bc",
                                        "entry_id": "d79bb2b6-0060-31ae-82e9-ce22b9b73063",
                                        "glosses": [
                                            "Landschaft, die hauptsächlich dem Gebiet der ehemaligen preußischen Rheinprovinz entspricht und sich auf Teilgebiete von Nordrhein-Westfalen und von Rheinland-Pfalz erstreckt"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "693da181-1e2a-4021-a209-d80f3c65f2ac",
                                                "sense_id": "e8baeff5-2a84-3bf5-87ac-04c7232388bc",
                                                "text": "Ich stamme aus dem Rheinland."
                                            },
                                            {
                                                "example_id": "6c839fc9-822a-43b2-bc4a-19a342f29c02",
                                                "sense_id": "e8baeff5-2a84-3bf5-87ac-04c7232388bc",
                                                "text": "„Für die vier kurzen Jahre zwischen Luises Hochzeit und Thronbesteigung läßt sich eine nennenswerte Beziehung zum Rheinland nicht nachweisen.“"
                                            },
                                            {
                                                "example_id": "7ad7b3b0-da66-4e32-94e0-d1a3618a3609",
                                                "sense_id": "e8baeff5-2a84-3bf5-87ac-04c7232388bc",
                                                "text": "„Wie kommt es also, dass den Menschen im Rheinland zwar der Mischcharakter ihrer Alltagssprache bewusst ist, die jiddische Komponente dabei aber ausgeklammert bleibt?“"
                                            },
                                            {
                                                "example_id": "9c54b497-d89e-4fbe-b745-32c42adaad56",
                                                "sense_id": "e8baeff5-2a84-3bf5-87ac-04c7232388bc",
                                                "text": "„Außerdem zeigte Annette sich noch von einer weiteren Besonderheit des Rheinlands fasziniert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
