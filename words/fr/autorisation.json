    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f6777d2-5bcf-3a26-bd36-e737a2699af2",
                    "sense_definition": "Action d'autoriser quelqu'un à faire quelque chose ; permission accordée par une autorité ou une personne responsable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a quitté la réunion plus tôt avec l'<w>autorisation</w> de son supérieur direct."
                        },
                        {
                            "text": "Les enfants ne peuvent pas sortir de l'école sans l'<w>autorisation</w> de leurs parents."
                        }
                    ],
                    "synonyms": [
                        "permission",
                        "accord",
                        "consentement"
                    ],
                    "antonyms": [
                        "interdiction",
                        "refus"
                    ],
                    "common_phrases": [
                        "demander une autorisation",
                        "donner une autorisation",
                        "sans autorisation"
                    ]
                },
                {
                    "sense_id": "ddd9f0e2-c3c2-349a-9197-a654ce588019",
                    "sense_definition": "Document écrit ou certificat qui atteste qu'une personne a le droit d'accomplir un acte déterminé.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour participer à cette sortie scolaire, vous devez signer une <w>autorisation</w> parentale."
                        },
                        {
                            "text": "Le garde a vérifié son <w>autorisation</w> avant de lui permettre d'entrer dans le bâtiment."
                        }
                    ],
                    "synonyms": [
                        "permis",
                        "laissez-passer",
                        "licence"
                    ],
                    "common_phrases": [
                        "autorisation parentale",
                        "autorisation de séjour",
                        "signer une autorisation"
                    ]
                },
                {
                    "sense_id": "21026f5e-e749-34bf-a9ce-c3f00c18cdf2",
                    "sense_definition": "Accord formel délivré par le contrôle aérien à un pilote pour effectuer une manœuvre ou une phase de vol.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aviation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avion a dû attendre sur la piste avant de recevoir l'<w>autorisation</w> de décollage."
                        },
                        {
                            "text": "Le pilote a sollicité une <w>autorisation</w> d'atterrissage d'urgence auprès de la tour de contrôle."
                        }
                    ],
                    "synonyms": [
                        "clairance"
                    ],
                    "common_phrases": [
                        "autorisation de décollage",
                        "autorisation d'atterrissage"
                    ]
                }
            ]
        }
    ]
