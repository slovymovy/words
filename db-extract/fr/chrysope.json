                        "sense_id": "76677746-000f-37ec-95a9-2cd2f1afbc5a",
                        "entry_id": "8364bd9a-c163-362c-ab31-847d004c801c",
                        "glosses": [
                            "Insecte appartenant à l’un des 85 genres de la famille des chrysopidés, ayant en commun un long corps frêle, des ailes nervurées, de larges yeux, et des larves dotées de fortes mandibules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa96beee-a133-4c07-9ff5-a5aa1b217186",
                                "sense_id": "76677746-000f-37ec-95a9-2cd2f1afbc5a",
                                "text": "Les larves de chrysopes sont entomophages; elles se nourrissent de pucerons, de thrips, de jeunes chenilles, d’acariens, des larves de cochenilles etc… Bref elles ne sont pas difficiles !"
                            },
                            {
                                "example_id": "6fc8d229-f7d9-4971-8b80-ca37a478607d",
                                "sense_id": "76677746-000f-37ec-95a9-2cd2f1afbc5a",
                                "text": "La chrysope est un insecte superbe et élégant avec de gros yeux dorés. C’est aussi l’insecte le plus utile au jardin."
                            }
                        ]
                    }
                ],
