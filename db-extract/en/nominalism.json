                                "target_senses": [
                                    {
                                        "sense_id": "9ad6a96a-ebe6-3b51-be2e-82b9754fec25",
                                        "entry_id": "166b84a1-c56c-318d-961e-a9c63ac0a171",
                                        "glosses": [
                                            "doutrina segundo a qual os universais (como espécie, gênero, virtude) não possuem existência real, sendo apenas nomes ou convenções linguísticas criadas pelo espírito humano"
                                        ],
                                        "tags": [
                                            "filosofia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "998bf13f-3494-4a3d-9ff3-d1da80143f85",
                                                "sense_id": "9ad6a96a-ebe6-3b51-be2e-82b9754fec25",
                                                "text": "O nominalismo medieval, defendido por Roscelino e Guilherme de Ockham, negava a existência real dos universais"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb0ee26-de0e-3a3e-a9fd-a678a08413b3",
                                        "entry_id": "166b84a1-c56c-318d-961e-a9c63ac0a171",
                                        "glosses": [
                                            "tendência a reduzir conceitos abstratos a meras designações verbais, sem admitir-lhes realidade independente"
                                        ],
                                        "tags": [
                                            "geral"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0a2ccf3-0f45-4cbc-9a8d-1a328d7ec3cb",
                                                "sense_id": "0cb0ee26-de0e-3a3e-a9fd-a678a08413b3",
                                                "text": "Para o nominalismo, a ideia de “justiça” não é uma entidade real, mas apenas um termo usado para agrupar situações semelhantes"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
