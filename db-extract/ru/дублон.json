                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dublone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9d07bc48-ab36-3872-bd3e-e9e9eb91d343",
                                        "entry_id": "62db9d09-8f43-386a-9f59-3b468668fbe3",
                                        "glosses": [
                                            "spanische Goldmünze des 16. bis 19. Jahrhunderts"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c11f355-c0ef-48a7-985c-0fa66216abcb",
                                                "sense_id": "9d07bc48-ab36-3872-bd3e-e9e9eb91d343",
                                                "text": "„Die Spanier schmolzen das Gold und Silber ein, das sie erbeutet hatten, und machten daraus Geldstücke. Die Geldstücke aus Gold hießen Dublonen."
                                            },
                                            {
                                                "example_id": "608d4952-a404-4a8f-91bc-36a301eade45",
                                                "sense_id": "9d07bc48-ab36-3872-bd3e-e9e9eb91d343",
                                                "text": "„Damit habe sie ihm Mut gemacht, sich mir zu eröffnen und mich zu bitten, ihm hundert Dublonen zu leihen, mit denen er in der Lage wäre, sie noch vor Ende des Karnevals zu heiraten.“"
                                            },
                                            {
                                                "example_id": "7bcce255-3aa8-48ba-91ba-d0cfd548664f",
                                                "sense_id": "9d07bc48-ab36-3872-bd3e-e9e9eb91d343",
                                                "text": "Für zwei Escudos bekam man eine Dublone."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99d28d16-92f8-3335-ae92-7b5ae7c72a3e",
                                        "entry_id": "62db9d09-8f43-386a-9f59-3b468668fbe3",
                                        "glosses": [
                                            "nach [1] Vorbild in der Schweiz geprägte Goldmünze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
