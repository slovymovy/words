                "senses": [
                    {
                        "sense_id": "34fb02ed-3fec-3c6f-a0b3-feec384c2619",
                        "entry_id": "8359c9fb-fa9b-3a02-954e-b349b5357756",
                        "glosses": [
                            "Verzögerung in der Entwicklung; dies kann körperlich oder geistig sein oder andere Entwicklungsprozesse betreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a46ea95a-4a41-4f64-a823-76c59302a814",
                                "sense_id": "34fb02ed-3fec-3c6f-a0b3-feec384c2619",
                                "text": "„Damit im Zusammenhang steht ein gegenläufiges Phänomen, die sogenannte Retardation, die Wachstumshemmung.“"
                            },
                            {
                                "example_id": "bafe0066-86e1-49bd-bf51-284b75bed749",
                                "sense_id": "34fb02ed-3fec-3c6f-a0b3-feec384c2619",
                                "text": "„Schwerere Formen (der Retardation) sind in der Hilfsschule (heute mehr in der Schule für geistig Behinderte) vertreten.“ (1967)"
                            },
                            {
                                "example_id": "0942e882-fbc9-41d5-b4d0-9577cbb199d1",
                                "sense_id": "34fb02ed-3fec-3c6f-a0b3-feec384c2619",
                                "text": "„Das Leben wird zu einem Leben in Retardation: Die Protagonisten sind sowohl geistig als auch physisch unfähig zu handeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
