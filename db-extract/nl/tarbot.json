                                                "example_id": "d8d546c2-bb16-4c4c-8856-165b9575909b",
                                                "sense_id": "cfd28575-c578-3f0e-a72e-a1c5010ff8ee",
                                                "text": "The Greeks also used an instrument called a rhombus, or witches' wheel. As the wheel spun round, it was thought that influence was gained over certain people or circumstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18b4a4d1-5758-3ed9-9434-9f6053c94f4c",
                                        "entry_id": "ae43f5d9-82c3-3618-a3ff-a817bf8a2385",
                                        "glosses": [
                                            "Any of several flatfishes, including the brill and turbot, once considered part of the genus Rhombus, now in Scophthalmus."
                                        ],
