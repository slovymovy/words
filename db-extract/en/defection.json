                                        "sense_id": "9ee4349b-734c-3561-8f6a-599556d8970c",
                                        "entry_id": "5bec8812-d1c7-3d80-8d24-9b826345fbe0",
                                        "glosses": [
                                            "tot boven de rand van een vat of dijk gevuld raken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af72c42e-65fc-45b6-a591-7a5664086efd",
                                                "sense_id": "9ee4349b-734c-3561-8f6a-599556d8970c",
                                                "text": "Het bad was overgelopen."
                                            },
                                            {
                                                "example_id": "77e96b6a-48dd-4169-92c0-91cf60b5eb91",
                                                "sense_id": "9ee4349b-734c-3561-8f6a-599556d8970c",
                                                "text": "Het kwam er vooral op aan dat hij niet zou overlopen, anders zou mijn slaapzak nog natter worden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c185aa72-296d-3a5d-bf87-17b308c49f42",
                                        "entry_id": "5bec8812-d1c7-3d80-8d24-9b826345fbe0",
                                        "glosses": [
                                            "in de strijd van zijde wisselen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87fbdf0-2726-4fdc-b159-154116235021",
                                                "sense_id": "c185aa72-296d-3a5d-bf87-17b308c49f42",
                                                "text": "De slecht betaalde huurlingen liepen op het kritieke moment over naar de vijand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3395a3ba-d1fa-3c4c-9f8e-e814664ab8b7",
                                        "entry_id": "5bec8812-d1c7-3d80-8d24-9b826345fbe0",
                                        "glosses": [
                                            "in elkaar overlopen: verdwijnen van grenzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74dc548d-d6cc-4adf-9a23-04f697157ae4",
                                                "sense_id": "3395a3ba-d1fa-3c4c-9f8e-e814664ab8b7",
                                                "text": "Maar zo was het nu eenmaal in Zweden, het was niet eens veel vreemder geweest om te onderhandelen met de sociaaldemocratische partij, het liep allemaal in elkaar over."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overlopen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "50d2371f-d89b-353c-a774-607bdcd5b3e7",
                                        "entry_id": "2b8c0ea3-2fe9-3089-ad3e-090870be17c0",
                                        "glosses": [
                                            "door een onverwacht aantal mensen bezocht worden."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d02b0bd-8d58-447f-ac08-a370ecf5f32d",
                                                "sense_id": "50d2371f-d89b-353c-a774-607bdcd5b3e7",
                                                "text": "De Keukenhof werd overlopen met bezoekers met dit prachtige weer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "overlopen",
