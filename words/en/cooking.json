    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d606ca22-f670-3634-a11f-f4c1663dfa51",
                    "sense_definition": "The process or activity of preparing food by using heat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really enjoy <w>cooking</w> for my friends and family on the weekends.",
                            "target_lang_translations": {
                                "ru": "Мне очень нравится <w>готовить</w> для друзей и семьи по выходным.",
                                "zh": "周末我真的很喜欢为朋友和家人<w>做饭</w>。"
                            }
                        },
                        {
                            "text": "The <w>cooking</w> time for this pasta is approximately ten minutes.",
                            "target_lang_translations": {
                                "ru": "Время <w>приготовления</w> этой пасты составляет примерно десять минут.",
                                "zh": "这种意大利面的<w>烹饪</w>时间大约是十分钟。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cooking time",
                        "home cooking",
                        "slow cooking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или деятельность по приготовлению пищи с использованием тепла.",
                        "zh": "准备食物的过程或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готовка",
                                "target_lang_sense_clarification": "разговорное обозначение процесса"
                            },
                            {
                                "target_lang_word": "приготовление пищи",
                                "target_lang_sense_clarification": "официальное или общее название процесса"
                            },
                            {
                                "target_lang_word": "кулинария",
                                "target_lang_sense_clarification": "как искусство или область деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烹饪",
                                "target_lang_sense_clarification": "正式或通用的过程名称"
                            },
                            {
                                "target_lang_word": "做饭",
                                "target_lang_sense_clarification": "日常口语表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a81eb8fb-7385-3640-90a2-97d47603c47b",
                    "sense_definition": "A person's ability to prepare food or the food prepared by someone.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My mother's <w>cooking</w> is much better than anything you can find in a restaurant.",
                            "target_lang_translations": {
                                "ru": "Мамина <w>готовка</w> намного лучше всего, что можно найти в ресторане.",
                                "zh": "我妈妈<w>做的饭</w>比你在餐馆里能吃到的任何东西都要好。"
                            }
                        },
                        {
                            "text": "He is famous for his excellent <w>cooking</w> and hospitality.",
                            "target_lang_translations": {
                                "ru": "Он знаменит своим великолепным <w>кулинарным мастерством</w> и гостеприимством.",
                                "zh": "他以精湛的<w>厨艺</w>和好客而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "excellent cooking",
                        "mothers cooking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность человека готовить еду или сама еда, приготовленная кем-то.",
                        "zh": "某人的烹饪能力或其制作的食物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "готовка",
                                "target_lang_sense_clarification": "умение готовить или результат"
                            },
                            {
                                "target_lang_word": "стряпня",
                                "target_lang_sense_clarification": "разговорное, часто о домашней еде"
                            },
                            {
                                "target_lang_word": "кухня",
                                "target_lang_sense_clarification": "в значении чьих-то кулинарных навыков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "厨艺",
                                "target_lang_sense_clarification": "指烹饪的水平或技巧"
                            },
                            {
                                "target_lang_word": "做的饭",
                                "target_lang_sense_clarification": "指某人制作的成品食物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3fcfc81e-48ca-3aeb-8bcd-a74c9435a696",
                    "sense_definition": "A particular style or genre of food preparation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traditional Italian <w>cooking</w> relies heavily on fresh tomatoes and olive oil.",
                            "target_lang_translations": {
                                "ru": "Традиционная итальянская <w>кухня</w> во многом опирается на свежие помидоры и оливковое масло.",
                                "zh": "传统的意大利<w>菜系</w>非常依赖新鲜番茄和橄榄油。"
                            }
                        },
                        {
                            "text": "She is taking a class to learn the secrets of French <w>cooking</w>.",
                            "target_lang_translations": {
                                "ru": "Она ходит на курсы, чтобы узнать секреты французской <w>кулинарии</w>.",
                                "zh": "她正在上课学习法国<w>烹饪</w>的秘诀。"
                            }
                        }
                    ],
                    "synonyms": [
                        "culinary art"
                    ],
                    "common_phrases": [
                        "french cooking",
                        "chinese cooking",
                        "style of cooking"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенный стиль или жанр приготовления пищи.",
                        "zh": "一种特定的烹饪风格或流派。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кухня",
                                "target_lang_sense_clarification": "национальные или региональные особенности"
                            },
                            {
                                "target_lang_word": "кулинария",
                                "target_lang_sense_clarification": "кулинарное искусство определенного стиля"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "菜系",
                                "target_lang_sense_clarification": "指特定地区或风格的烹饪"
                            },
                            {
                                "target_lang_word": "烹饪风格",
                                "target_lang_sense_clarification": "指烹饪的方法论或流派"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45338e1a-f37d-3adb-900d-fd2dd0aafbbf",
                    "sense_definition": "A single instance or occasion of preparing food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "food preparation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe requires three separate <w>cookings</w> to achieve the right texture.",
                            "target_lang_translations": {
                                "ru": "Рецепт требует трех отдельных <w>этапов варки</w> для достижения нужной текстуры.",
                                "zh": "这个食谱需要三次单独的<w>烹制</w>才能达到理想的口感。"
                            }
                        },
                        {
                            "text": "After several <w>cookings</w> in the same pot, the flavors began to blend together.",
                            "target_lang_translations": {
                                "ru": "После нескольких <w>приготовлений</w> в одной и той же кастрюле вкусы начали смешиваться.",
                                "zh": "在同一个锅里经过几次<w>烹制</w>后，各种味道开始融合在一起。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Единичный случай или этап термической обработки пищи.",
                        "zh": "单次烹饪的过程或阶段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "варка",
                                "target_lang_sense_clarification": "один цикл термической обработки"
                            },
                            {
                                "target_lang_word": "приготовление",
                                "target_lang_sense_clarification": "отдельный акт готовки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烹制",
                                "target_lang_sense_clarification": "指一次具体的烹饪行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcf5902d-ad1a-3d61-8bbf-c0d53c809950",
                    "sense_definition": "The cheapest beer available in a pub, such as a basic bitter or lager.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beverages",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He didn't have much money, so he just ordered a pint of <w>cooking</w>.",
                            "target_lang_translations": {
                                "ru": "У него было мало денег, поэтому он просто заказал пинту <w>дешевого пива</w>.",
                                "zh": "他没多少钱，所以只点了一品脱<w>廉价啤酒</w>。"
                            }
                        },
                        {
                            "text": "The landlord served a cheap <w>cooking</w> lager to the rowdy crowd.",
                            "target_lang_translations": {
                                "ru": "Хозяин подал шумной толпе дешевый <w>низкосортный</w> лагер.",
                                "zh": "店主给那群吵闹的人端上了廉价的<w>烹饪用</w>拉格啤酒。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pint of cooking"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used in British English to refer to cheap beer"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Primarily British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Самое дешевое пиво, доступное в пабе (британский сленг).",
                        "zh": "酒吧里最便宜的啤酒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дешевое пиво",
                                "target_lang_sense_clarification": "простое низкосортное пиво"
                            },
                            {
                                "target_lang_word": "пойло",
                                "target_lang_sense_clarification": "пренебрежительное о дешевом напитке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "廉价啤酒",
                                "target_lang_sense_clarification": "指低档次的酒水"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ca13241-625d-30b4-9199-2be1f23592a0",
                    "sense_definition": "Intended or suitable for use in the kitchen or for preparing food.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "utility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to buy a new <w>cooking</w> pot for the soup.",
                            "target_lang_translations": {
                                "ru": "Нам нужно купить новую <w>кастрюлю</w> для супа.",
                                "zh": "我们需要买一个新的煮汤用的<w>锅</w>。"
                            }
                        },
                        {
                            "text": "These <w>cooking</w> apples are too sour to eat raw.",
                            "target_lang_translations": {
                                "ru": "Эти <w>кулинарные</w> яблоки слишком кислые, чтобы есть их сырыми.",
                                "zh": "这些<w>烹饪用</w>苹果太酸了，不能生吃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cooking pot",
                        "cooking oil",
                        "cooking apples",
                        "cooking utensils"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предназначенный или подходящий для использования на кухне или для приготовления пищи.",
                        "zh": "用于厨房或烹饪的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кухонный",
                                "target_lang_sense_clarification": "относящийся к утвари"
                            },
                            {
                                "target_lang_word": "кулинарный",
                                "target_lang_sense_clarification": "предназначенный для готовки"
                            },
                            {
                                "target_lang_word": "для готовки",
                                "target_lang_sense_clarification": "о продуктах или предметах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烹饪用的",
                                "target_lang_sense_clarification": "指用途"
                            },
                            {
                                "target_lang_word": "厨房",
                                "target_lang_sense_clarification": "指所属空间"
                            }
                        ]
                    }
