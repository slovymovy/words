                "senses": [
                    {
                        "sense_id": "ed725163-a290-3056-aa24-c7a88d3faa71",
                        "entry_id": "bf5b7d98-0d35-33b4-b29c-260c29faa881",
                        "glosses": [
                            "Relatif aux États-Unis d’Amérique."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "59e977ba-cf46-43df-be6d-f20ad34c8fbc",
                                "sense_id": "ed725163-a290-3056-aa24-c7a88d3faa71",
                                "text": "Et ils s'approchent du véhicule : un gros machin ricain de couleur vert bouteille."
                            },
                            {
                                "example_id": "aa67fe35-4614-4aef-b730-1df8d443a489",
                                "sense_id": "ed725163-a290-3056-aa24-c7a88d3faa71",
                                "text": "Je regarde les feuilletons ricains ouah, ça assure bien\n Les documentaires les jeux les JT, ouah ça le fait bien\n Je me branche sur Arte mais ouah la la, j’y comprends rien\n C’est bien mieux les histoires de TF1 !"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "240bf096-ad3a-4da2-9d0e-745250d9958f",
                        "source_entry_id": "bf5b7d98-0d35-33b4-b29c-260c29faa881",
                        "source_sense_id": "ed725163-a290-3056-aa24-c7a88d3faa71",
                        "target_lang_word": "Ami",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "31485ae5-a9e4-34a2-9089-f64a63b10c7d",
                                        "entry_id": "3f5bd417-a40b-3632-831f-a7483109a887",
                                        "glosses": [
                                            "Soldat der Streitkräfte der Vereinigten Staaten von Amerika (besonders in Bezug auf den Zweiten Weltkrieg und, als Besatzungssoldat, in Bezug auf die Nachkriegsjahre und den Kalten Krieg)"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4b097cc-58d4-4e77-a74d-9b7de7b390e2",
                                                "sense_id": "31485ae5-a9e4-34a2-9089-f64a63b10c7d",
                                                "text": "„Die Amis stehen nach unserem letzten Bericht vor Marburg und Wetzlar.“"
                                            },
                                            {
                                                "example_id": "8d43575b-a21e-4d49-92c2-1d3427edac48",
                                                "sense_id": "31485ae5-a9e4-34a2-9089-f64a63b10c7d",
                                                "text": "Die Amis sind doch alle gleich."
                                            },
                                            {
                                                "example_id": "cd681daf-8061-4c58-90e7-816ec62f81f2",
                                                "sense_id": "31485ae5-a9e4-34a2-9089-f64a63b10c7d",
                                                "text": "„Wir fordern: Schluß mit dem verbrecherischen Krieg der USA gegen das vietnamesische Volk! Amis, ’raus aus Vietnam!“"
                                            },
                                            {
                                                "example_id": "f354b858-ab14-4f78-938f-937aad32bc93",
                                                "sense_id": "31485ae5-a9e4-34a2-9089-f64a63b10c7d",
                                                "text": "„Besser Sorgen beim Ami als die Sicherheit beim Iwan. Das sind doch Frauenschänder und Lumpen.“"
                                            },
                                            {
                                                "example_id": "776fbe01-3210-4113-b515-e395d91005e3",
                                                "sense_id": "31485ae5-a9e4-34a2-9089-f64a63b10c7d",
                                                "text": "„Yue, der unverbesserliche Unternehmer, machte da weiter, wo er als Schwarzhändler und treuer Ehemann aufgehört hatte, und ich wandte mich wieder meinem neuen Hobby zu, nämlich nach lukrativen Geschäften mit Amis Ausschau zu halten.“"
                                            },
                                            {
                                                "example_id": "b5498131-a270-4921-b7b3-5fddf803a5b8",
                                                "sense_id": "31485ae5-a9e4-34a2-9089-f64a63b10c7d",
                                                "text": "„Als die Amis kamen, entfernten sie alle Hakenkreuze, aber die schmiedeeisernen Fenstergitter an den Oberlichtern des Kellers haben sie vergessen.“"
                                            },
                                            {
                                                "example_id": "ceddc3c7-9f7d-4fbe-8dae-1e7914cce710",
                                                "sense_id": "31485ae5-a9e4-34a2-9089-f64a63b10c7d",
                                                "text": "„Nun waren die Amis am Zug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "58fa4545-fcc3-3301-832a-0919f59fe7e3",
                                        "entry_id": "3f5bd417-a40b-3632-831f-a7483109a887",
                                        "glosses": [
                                            "Staatsbürger der Vereinigten Staaten von Amerika"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "73da308a-b2ec-4328-9acf-5bc1d213afe0",
                                                "sense_id": "58fa4545-fcc3-3301-832a-0919f59fe7e3",
                                                "text": "„Nicht nur weil sie breiter sprechen, beim Sprechen oftmals sogar beinah singen, sind die Amis selbst für Briten nicht leicht zu verstehen.“"
                                            },
                                            {
                                                "example_id": "32d527c3-206d-4624-b77d-4f137de20a97",
                                                "sense_id": "58fa4545-fcc3-3301-832a-0919f59fe7e3",
                                                "text": "„‚Ich finde es lustig‘, sagt die Ehefrau des Schweizer Botschafters, Shawne Fielding-Borer, dazu. ‚Denn normalerweise denken die Europäer doch immer, dass die Amis verklemmt sind.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57b428c0-036f-3cbb-b6c1-8bf9d03e0506",
                                        "entry_id": "a65b83af-523c-3089-864f-b447a7c41c7b",
                                        "glosses": [
                                            "Zigarette einer US-amerikanischen Marke, aus US-amerikanischer Produktion"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d6f7beb-2043-4687-8156-3fa651bf7986",
                                                "sense_id": "57b428c0-036f-3cbb-b6c1-8bf9d03e0506",
                                                "text": "„Dazu guten Bohnenkaffee zu 10 Mark die Tasse, und der Ober hatte auch immer eine Packung ‚Amis‘ in der Tasche.“"
                                            },
                                            {
                                                "example_id": "ff317ee7-7f81-411d-9409-4c9b6281028f",
                                                "sense_id": "57b428c0-036f-3cbb-b6c1-8bf9d03e0506",
                                                "text": "„Als das Kaltgetränk mit Schuß serviert wurde, erstand ich beim Kellner zehn Amis, bot Schwester Gertrud eine an, eine dem Kellner, der sie sich hinters Ohr steckte, und nahm, nachdem ich meiner Dame Feuer gegeben hatte, Oskars Bernsteinspitze hervor, um eine Camel bis knapp zur Hälfte zu rauchen.“"
                                            },
                                            {
                                                "example_id": "2b756848-3d5a-4a99-8e45-63f53b945cb6",
                                                "sense_id": "57b428c0-036f-3cbb-b6c1-8bf9d03e0506",
                                                "text": "„Erst Anfang der siebziger Jahre gelang es dem Haus Neuerburg und seinem US-Management, mit der ‚Camel‘-Zigarette wieder Marktanteile zurückzugewinnen. Diese Marke war den Deutschen noch aus der Nachkriegszeit vertraut, aus den Jahren der Zigarettenwährung, als für eine ‚Stange Amis‘ noch fast alles zu haben war.“"
                                            },
                                            {
                                                "example_id": "8b7275e5-b958-4a7a-be39-09a949fce54a",
                                                "sense_id": "57b428c0-036f-3cbb-b6c1-8bf9d03e0506",
                                                "text": "„Zwischendurch wieder ein hastiger Zug aus der Ami, in kurzen Abständen die Befunde, etwa ‚Sie haben ein Geschwür im Zwölffingerdarm‘ oder ‚an diesem Gelenk haben Sie Arthritis‘.“"
                                            },
                                            {
                                                "example_id": "87b115b8-107b-49e8-91ae-902c1966617b",
                                                "sense_id": "57b428c0-036f-3cbb-b6c1-8bf9d03e0506",
                                                "text": "„Eine Currywurst und eine Tasse echte Bohne, das warn, je nach Tageskurs, drei oder vier Amis.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "897e03bc-514b-3012-bf56-30ae1930cee2",
                                        "entry_id": "078c5d1a-691b-33e8-9aa7-155e3516c2d1",
                                        "glosses": [
                                            "männliche Person, mit der man freundschaftlich verbunden ist, die einem nahesteht, die man schätzt und liebt"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b7e6286-3ea7-45fb-8d12-426cdc656db6",
                                                "sense_id": "897e03bc-514b-3012-bf56-30ae1930cee2",
                                                "text": "„Alſo iſt er ſchon da? Mein Freund! Mein alter Ami! …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77409454-7269-31fe-8cfc-bc29bec51840",
                                        "entry_id": "078c5d1a-691b-33e8-9aa7-155e3516c2d1",
                                        "glosses": [
                                            "jemanden, den man als falsch, unsympathisch, moralisch verächtlich wahrnimmt; widerwärtiger Mensch"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67a106ed-1a6f-418a-b826-89b2c339e5f0",
                                                "sense_id": "77409454-7269-31fe-8cfc-bc29bec51840",
                                                "text": "mittelfränkisch: „Dat is ene fiese Ami.“"
                                            },
                                            {
                                                "example_id": "dcd8ac06-8fd2-45a5-b40f-82a135387dcb",
                                                "sense_id": "77409454-7269-31fe-8cfc-bc29bec51840",
                                                "text": "mittelfränkisch (ripuarisch: Kölsch): „Su ne fiesen Ami!“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "066286c5-bf19-3709-98e4-bc1e25d5a996",
                                        "entry_id": "eb33d052-07c3-3224-98f8-31453a79bcdc",
                                        "glosses": [
                                            "Kosewort für die Mutter des Vaters oder der Mutter"
                                        ],
                                        "tags": [
                                            "familiär",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fe648d65-3606-4e8c-b7cc-f045f6acf0ae",
                                                "sense_id": "066286c5-bf19-3709-98e4-bc1e25d5a996",
                                                "text": "„‚Weißt du, was meine Ami jetzt sagen würde?‘ Carolin trat kräftig in die Pedale. ‚Was würde deine weise und komplett verrückte Großmutter denn wohl sagen?‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2b27aa20-6e72-3ac6-857a-d1b4e6f86d07",
                                        "entry_id": "023e7828-48ac-360b-b083-ac77ac2927dc",
                                        "glosses": [
                                            "individueller Tiername für (kleine) Hunde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c161fb8c-0a07-4c67-aa6c-5e0714760224",
                                                "sense_id": "2b27aa20-6e72-3ac6-857a-d1b4e6f86d07",
                                                "text": "„Waͤhrend ich dieſes ſchreibe, ſteht hinter mir mein kleiner Mops und bellt — Schweig nur, Ami, dich hab’ ich nicht gemeint, denn du liebſt mich und begleiteſt deinen Herrn in Noth und Gefahr und wuͤrdeſt ſterben auf ſeinem Grabe, eben ſo treu wie mancher andere deutſche Hund, der in die Fremde verſtoßen, vor den Thoren Deutſchlands liegt und hungert und wimmert — […]“"
                                            },
                                            {
                                                "example_id": "07e61ad9-5f2a-4bdf-8e43-3977400543b9",
                                                "sense_id": "2b27aa20-6e72-3ac6-857a-d1b4e6f86d07",
                                                "text": "„Puffi kennt Ami ſchon ſeit längerer Zeit und er hat ſich ſchon recht befreundet mit mit dem lieben Pintſcherl der Frau Hofräthin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Ami",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe2c6575-8876-3651-9ec6-fc5a0e5ae895",
                                        "entry_id": "726cc0c3-f97f-32bf-b0e6-7283304ead75",
                                        "glosses": [
