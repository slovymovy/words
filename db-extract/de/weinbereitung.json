                "senses": [
                    {
                        "sense_id": "e167a7eb-a232-3e9c-b539-d03386bd3dbc",
                        "entry_id": "655925e2-9fd5-3bb7-8cf3-65d81c9c4560",
                        "glosses": [
                            "die Gesamtheit aller Arbeitsgänge bei der Herstellung von Wein von der Lese über das Maischen, das Pressen, der Gärung in Fässern, das Abstechen (Trennen des jungen Weins von der Hefe), das Schönen (das Niederschlagen der Trübung durch Kolloidstoffe), das Schwefeln, und das Reifen während der Lagerung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75848fec-c701-4f79-aa4e-5ac7b95c7195",
                                "sense_id": "e167a7eb-a232-3e9c-b539-d03386bd3dbc",
                                "text": "„Die Weinbereitung beginnt mit der Weinlese im allgemeinen bei vollreifen Trauben zu Qualitätsweinen bei überreifen“ zu Auslesen „oder halbvertockneten“ zu Trockenbeerenauslesen.“"
                            },
                            {
                                "example_id": "5baaacdf-7002-40a8-8c00-5b046c58a87c",
                                "sense_id": "e167a7eb-a232-3e9c-b539-d03386bd3dbc",
                                "text": "Die Weinbereitung ist ein sehr arbeitsintensiver Prozess."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
