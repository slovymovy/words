{
    "word_family": [
        "repress",
        "repressible",
        "repression",
        "repressive",
        "irrepressibility",
        "irrepressibly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e1471bed-dc56-3b36-84ec-599a328eeab3",
                    "sense_definition": "Full of energy, enthusiasm, or determination that is impossible to stop or discourage.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uncontrollable_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Despite the many challenges she faced, her <w>irrepressible</w> spirit kept the entire team motivated.",
                            "target_lang_translations": {
                                "ru": "Несмотря на многочисленные трудности, с которыми она столкнулась, её <w>неукротимый</w> дух поддерживал мотивацию всей команды."
                            }
                        },
                        {
                            "text": "The <w>irrepressible</w> child continued to run around the garden even after his parents told him to sit down.",
                            "target_lang_translations": {
                                "ru": "Этот <w>неуёмный</w> ребёнок продолжал бегать по саду даже после того, как родители велели ему сесть."
                            }
                        }
                    ],
                    "synonyms": [
                        "ebullient",
                        "unquenchable",
                        "unstoppable",
                        "vivacious"
                    ],
                    "antonyms": [
                        "depressed",
                        "spiritless",
                        "subdued"
                    ],
                    "common_phrases": [
                        "irrepressible spirit",
                        "irrepressible energy",
                        "irrepressible optimism"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полный энергии, энтузиазма или решимости, которые невозможно остановить или подавить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неуёмный",
                                "target_lang_sense_clarification": "о человеке, его энергии или характере"
                            },
                            {
                                "target_lang_word": "неукротимый",
                                "target_lang_sense_clarification": "о духе, воле или энергии"
                            },
                            {
                                "target_lang_word": "неиссякаемый",
                                "target_lang_sense_clarification": "об оптимизме или энергии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97779874-ae8d-31b8-8ba4-2482b1bc78da",
                    "sense_definition": "Impossible to hold back, restrain, or control.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uncontrollable_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the comedian told the joke, the audience burst into <w>irrepressible</w> laughter that lasted for minutes.",
                            "target_lang_translations": {
                                "ru": "Когда комик рассказал шутку, аудитория разразилась <w>неудержимым</w> смехом, который длился несколько минут."
                            }
                        },
                        {
                            "text": "He felt an <w>irrepressible</w> urge to tell the truth, even though he knew it might cause trouble.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал <w>непреодолимое</w> желание сказать правду, хотя и знал, что это может вызвать проблемы."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncontrollable",
                        "unrestrainable",
                        "ungovernable"
                    ],
                    "antonyms": [
                        "repressible",
                        "controllable",
                        "restrainable"
                    ],
                    "common_phrases": [
                        "irrepressible laughter",
                        "irrepressible urge",
                        "irrepressible desire"
                    ],
                    "target_lang_definitions": {
                        "ru": "Такой, который невозможно сдержать, подавить или контролировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неудержимый",
                                "target_lang_sense_clarification": "о смехе, желании или порыве"
                            },
                            {
                                "target_lang_word": "непреодолимый",
                                "target_lang_sense_clarification": "о желании или влечении"
                            },
                            {
                                "target_lang_word": "неукротимый",
                                "target_lang_sense_clarification": "о сильных чувствах или стихии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}