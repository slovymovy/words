        "fr-extract.jsonl": [
            {
                "entry_id": "e813e2e2-af2b-3d87-bf49-1a14977cf6eb",
                "word": "panacée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a29062c2-0696-4751-9dbf-c5b6a1b9d8b6",
                        "entry_id": "e813e2e2-af2b-3d87-bf49-1a14977cf6eb",
                        "tags": [
                            "plural"
                        ],
                        "form": "panacées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "226e9049-de92-3903-9bfe-3b9fccd1cc33",
                        "entry_id": "e813e2e2-af2b-3d87-bf49-1a14977cf6eb",
                        "glosses": [
                            "Remède universel capable de guérir tous les maux aussi bien corporels que mentaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63fa4ee4-8fcc-4f67-b444-18e19f59cb82",
                                "sense_id": "226e9049-de92-3903-9bfe-3b9fccd1cc33",
                                "text": "Invinciblement, ils lui apparaissaient, ainsi qu’au moyen âge, cultivant des simples, chauffant des cornues, résumant dans des alambics de souveraines panacées, d’incontestables magistères."
                            }
                        ]
                    },
                    {
                        "sense_id": "261ee8ea-01fe-3420-b898-a5215903c458",
                        "entry_id": "e813e2e2-af2b-3d87-bf49-1a14977cf6eb",
                        "glosses": [
                            "Solution miracle à un problème."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "5ddb4fd4-d4e7-4ab2-be95-0b7b9146bea5",
                                "sense_id": "261ee8ea-01fe-3420-b898-a5215903c458",
                                "text": "Raisonnant à côté de la logique, on a considéré le pur sang anglais comme une panacée, et on a voulu s’en servir pour porter remède à tous les maux et faire avec lui des chevaux de tout acabit."
                            },
                            {
                                "example_id": "90da6987-c4de-402f-9c93-3235fcb9c836",
                                "sense_id": "261ee8ea-01fe-3420-b898-a5215903c458",
                                "text": "Même si les vaccins demeurent la meilleure arme pour venir à bout de la pandémie, ils ne sont pas une panacée et plusieurs facettes de leur action restent à documenter, soulignent les experts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10a0d0d8-3a2e-4bd9-b4f0-7d7fbbd85dda",
                        "source_entry_id": "e813e2e2-af2b-3d87-bf49-1a14977cf6eb",
                        "target_lang_word": "Allheilmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Allheilmittel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "245493aa-2439-30b6-8d25-eb32aba5f4a4",
                                        "entry_id": "7b7dacd5-40e3-358d-b286-63860cfbd82c",
                                        "glosses": [
                                            "(nicht existierendes) Medikament zur Behandlung aller möglichen Krankheiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85bfd491-3f8e-40d4-9fdd-10cd79aafa88",
                                                "sense_id": "245493aa-2439-30b6-8d25-eb32aba5f4a4",
                                                "text": "VIPERN Noch bis ins 18. Jahrhundert Hauptingredienz für Theriak, ein mittelalterliches Allheilmittel"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                        "entry_id": "7b7dacd5-40e3-358d-b286-63860cfbd82c",
                                        "glosses": [
                                            "Universalmittel zur Lösung aller Probleme"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7ea13bc-96ae-4b0f-8431-d06f8bba75c1",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "Das, sagte er, ist die wahre Panacea Coelestis (himmlisches Allheilmittel) gegen alle Hexerey."
                                            },
                                            {
                                                "example_id": "e80bb977-2b99-471d-a044-c9702f5bceec",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "Für den Mystizismus sehe ich zu scharf, für den Materialismus fehlt mir der Leichtsinn, und dieses neueste Allheilmittel des religiösen Empirismus ist mir lächerlich."
                                            },
                                            {
                                                "example_id": "3ba5d48b-0b84-4833-930b-e3168f655b2d",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "Sein Allheilmittel wendete er an, das ihm bisher noch immer die Grillen verscheucht: er nahm eine Zigarette."
                                            },
                                            {
                                                "example_id": "760bc4a5-994e-4f4c-8a28-72f5cfdb15c3",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "»Sprich nicht solchen Unsinn! Es fehlt nur noch, daß du als letztes Allheilmittel an eine Kugel denkst –«"
                                            },
                                            {
                                                "example_id": "92ad4ea6-e843-4a10-a2f6-20563fcf57ba",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "Ihm ist der Staat nicht Selbstzweck, und ebensowenig glaubt er die Anweisung auf Allheilmittel in der Tasche zu haben."
                                            },
                                            {
                                                "example_id": "87b8f738-82d9-4ccf-b1b8-f22e0f3f19c1",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "»Übrigens habt Ihr wohl nun in der Ehe das Allheilmittel und den helfenden Zauber für alle schlimmen Dinge gefunden,« lächelte er."
                                            },
                                            {
                                                "example_id": "2188a540-9867-4cae-929c-22ae81e78322",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "Da haben wir wieder diesen fatalistischen Glauben an das Allheilmittel der Majorität."
                                            },
                                            {
                                                "example_id": "d4915ff8-f9d3-47a5-8954-d73f030fced7",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "Der Tod eines geliebten Sohnes festigte in seinem trostbedürftigen Herzen die Ueberzeugung von der göttlichen Wahrheit des Christentums; und nachdem ihn der Glaube siegreich über den Jammer dieses Verlustes emporgehoben, brannte er nun von einer wahrhaft verzehrenden Glut, diesem Allheilmittel zum endgültigen Triumph über die Irrlehren des römischen Staats zu verhelfen."
                                            },
                                            {
                                                "example_id": "e09b037d-3853-42f8-ba30-17bc8c9d933b",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "Als er Hugo mit seinen listigen, etwas blutunterlaufnen Augen aber ansah, kam ihm doch ein Zweifel, ob Punsch hier Allheilmittel sei, und er ging sogar hinaus und rief die noch im Gespräch mit der Landrätin auf der Bank sitzende Thilde."
                                            },
                                            {
                                                "example_id": "76726e88-21c0-42f3-a877-2cc4e40cf2f1",
                                                "sense_id": "869b0276-59cb-39b1-a964-a1823150af14",
                                                "text": "»Weinen Sie, Kindchen, weinen Sie«, bat Frau von Hillich, die selbst tränenüberströmt war und das salzige Naß als Allheilmittel für alle Schmerzen des Leibes und der Seele betrachtete."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b21eb83a-3e86-4aa6-b4e1-b5192b6afe3a",
                        "source_entry_id": "e813e2e2-af2b-3d87-bf49-1a14977cf6eb",
                        "target_lang_word": "panacea",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panacea",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5cb6e9-61c8-317e-aef8-9ed56ef3786a",
                                        "entry_id": "5b8c5716-bbd6-34f8-bef0-bed8a769f998",
                                        "glosses": [
                                            "A remedy believed to cure all disease and prolong life that was originally sought by alchemists; a cure-all."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80e0d1c1-ef4e-3bb1-9e32-8228d92c376a",
                                        "entry_id": "5b8c5716-bbd6-34f8-bef0-bed8a769f998",
                                        "glosses": [
                                            "A solution to all problems."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15adf3f9-5946-409d-b897-749d7d9cf4f6",
                                                "sense_id": "80e0d1c1-ef4e-3bb1-9e32-8228d92c376a",
                                                "text": "A monorail will be a panacea for our traffic woes."
                                            },
                                            {
                                                "example_id": "11567b9f-044f-49d6-b2a1-945594988cc9",
                                                "sense_id": "80e0d1c1-ef4e-3bb1-9e32-8228d92c376a",
                                                "text": "When busy he was better, and appeared to think perpetual motion a panacea for his unnamed and un-nameable complaint; and so much were they hurried from place to place, after their arrival at Genoa, that both sisters were thankful when they embarked again, as the sea appeared a resting-place..."
                                            },
                                            {
                                                "example_id": "7a6feb63-4223-4460-9d4c-ee49fc8604ff",
                                                "sense_id": "80e0d1c1-ef4e-3bb1-9e32-8228d92c376a",
                                                "text": "Podson was seated on the bed, going through such turf forecasts as he could find in the papers; his panacea for correcting the mistakes of fortune."
                                            },
                                            {
                                                "example_id": "c9dad276-8484-48b7-ae49-b77c9dc8e246",
                                                "sense_id": "80e0d1c1-ef4e-3bb1-9e32-8228d92c376a",
                                                "text": "Hydrogen is not a panacea for reaching the zero net emissions target by 2050, but it can grow to become \"a big niche\" fuel in particular sectors and applications, claims a new report."
                                            },
                                            {
                                                "example_id": "1054763f-2e8a-4119-b2be-8ec73c2e26d2",
                                                "sense_id": "80e0d1c1-ef4e-3bb1-9e32-8228d92c376a",
                                                "text": "But dollarization is not a panacea for Argentina’s crisis-stricken economy, analysts say."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f20dd469-0371-31fa-84d8-010d906ceb69",
                                        "entry_id": "5b8c5716-bbd6-34f8-bef0-bed8a769f998",
                                        "glosses": [
                                            "The plant allheal (Valeriana officinalis), believed to cure all ills."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac911e7d-6014-4d16-9147-2e8aac18d79d",
                                                "sense_id": "f20dd469-0371-31fa-84d8-010d906ceb69",
                                                "text": "There, whether it diuine Tobacco were, / Or Panachæa, or Polygony, / She found, and brought it to her patient deare […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a631f3ab-998c-481b-b93e-76381a39c6aa",
                        "source_entry_id": "e813e2e2-af2b-3d87-bf49-1a14977cf6eb",
                        "target_lang_word": "silver bullet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silver bullet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e329c15-146c-3154-86fa-20d17f58efde",
                                        "entry_id": "f3fb918d-8314-306e-bf37-773e0e083e68",
                                        "glosses": [
                                            "A bullet made of silver, usually with reference to the folkloric belief that such bullets are the only weapons which can kill a werewolf, vampire, or other monster."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d723ab3-8f13-357f-a738-13aa2395629f",
                                        "entry_id": "f3fb918d-8314-306e-bf37-773e0e083e68",
                                        "glosses": [
                                            "Any straightforward solution perceived to have great effectiveness or bring miraculous results."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79cb4099-8dec-4134-bd8b-6d5313f8c506",
                                                "sense_id": "5d723ab3-8f13-357f-a738-13aa2395629f",
                                                "text": "There is no silver bullet for this problem. It will take hard work and long hours to fix."
                                            },
                                            {
                                                "example_id": "870a6579-22c2-47cf-b213-6c2459d8542e",
                                                "sense_id": "5d723ab3-8f13-357f-a738-13aa2395629f",
                                                "text": "Colin H. Kahl, the under secretary of defense for policy, acknowledged last week that “no one capability is a silver bullet,” but said the cluster munitions would allow Ukraine “to sustain the artillery fight for the foreseeable future.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43fc8e30-ed53-38f3-9038-7d30f9dc85cc",
                                        "entry_id": "f3fb918d-8314-306e-bf37-773e0e083e68",
                                        "glosses": [
                                            "A classic dry martini cocktail."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "923d3194-53b5-4604-933f-862ccd06b293",
                                                "sense_id": "43fc8e30-ed53-38f3-9038-7d30f9dc85cc",
                                                "text": "The Martini is nicknamed “the silver bullet” because of its supposedly lethal properties."
                                            },
                                            {
                                                "example_id": "23c91aae-f65f-4d63-8d44-e2500836caef",
                                                "sense_id": "43fc8e30-ed53-38f3-9038-7d30f9dc85cc",
                                                "text": "For a classic silver bullet martini, you simply need to choose your poison—gin or vodka—and add dry vermouth and olives. For the more complex concoctions, you'll want to stock up on flavored vodkas, juices, garnishes, and liqueurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2d5f87b-9509-32a0-8f08-d9147245c74c",
                                        "entry_id": "f3fb918d-8314-306e-bf37-773e0e083e68",
                                        "glosses": [
                                            "A thermometer, especially one used for rectal temperature readings."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7982ea5-763a-4268-9b61-4b6055ab8d37",
                                                "sense_id": "c2d5f87b-9509-32a0-8f08-d9147245c74c",
                                                "text": "[…] \"the silver bullet\"—a rectal thermometer, to ensure that their body core isn't dangerously overheated from the run."
                                            },
                                            {
                                                "example_id": "6b75db84-48ec-40d9-a9ed-f4dac8ae2612",
                                                "sense_id": "c2d5f87b-9509-32a0-8f08-d9147245c74c",
                                                "text": "Of course, there is the infamous “Silver Bullet,” which is a rectal thermometer that measures the body's core temperature in the event of a heat case. No one wanted to get it up the butt with the Silver Bullet, […]"
                                            },
                                            {
                                                "example_id": "30c36c93-98ec-499e-9381-cdcd42529e48",
                                                "sense_id": "c2d5f87b-9509-32a0-8f08-d9147245c74c",
                                                "text": "A Corpsman was yanking my pants down in order to administer a “silver bullet” (rectal thermometer). I squirmed away and shoved the Corpsman off me before he could insert it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
