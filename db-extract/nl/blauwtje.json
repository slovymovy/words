                    {
                        "sense_id": "87966476-853e-3a47-a08e-9b6c01bd0bfe",
                        "entry_id": "3c2791fd-2cca-3037-8139-a55c81ae6d6d",
                        "glosses": [
                            "bepaald soort kopie"
