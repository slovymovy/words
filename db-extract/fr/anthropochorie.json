                "senses": [
                    {
                        "sense_id": "05d9672d-9950-39a6-ba77-6260bf17cba8",
                        "entry_id": "c2ab00e7-7d39-31b0-98f6-1c712e1d3d9b",
                        "glosses": [
                            "Mode de dispersion des graines, du pollen, des spores, etc. par un homme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b686eec-fb8d-41a9-a46f-04299796f489",
                                "sense_id": "05d9672d-9950-39a6-ba77-6260bf17cba8",
                                "text": "Il ne faut pas oublier les plantes transportées volontairement ou non par les hommes (anthropochorie). Ces derniers sont utilisés de la même façon que le sont les animaux mais avec en plus les immenses possibilités de transport et de déplacement des personnes, denrées, matériaux et troupeaux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a9d70d91-e3f8-43b4-8775-aeb978674e84",
                        "source_entry_id": "c2ab00e7-7d39-31b0-98f6-1c712e1d3d9b",
                        "source_sense_id": "05d9672d-9950-39a6-ba77-6260bf17cba8",
                        "target_lang_word": "anthropochory",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anthropochory",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27c4b801-1855-327f-9d2a-45aef714e122",
                                        "entry_id": "627fbc9a-04a8-3d34-a274-7ecbb3a545ce",
                                        "glosses": [
                                            "The (typically inadvertent) dispersal of seeds, spores, or other reproductive botanical material, or of reproductively capable animals, by humans as a routine means of reproductive dispersal of that species."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9f2933ba-5d35-3582-99ef-81ca1abd47d9",
                                        "entry_id": "627fbc9a-04a8-3d34-a274-7ecbb3a545ce",
                                        "glosses": [
                                            "The (typically inadvertent and sporadic) dispersal by humans, of seeds, spores, or other reproductive botanical material, or of reproductively capable animals, into a region where they do not natively occur, resulting in adventitious anthropochorous establishment of an alien population if successful."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "395adbb4-478a-4846-b92e-6b612d5536b7",
                                                "sense_id": "9f2933ba-5d35-3582-99ef-81ca1abd47d9",
                                                "text": "Stephenson stressed the importance of anthropochory in earthworm dispersal. Human introductions, either intentional or unconscious, play a key role in earthworm invasions, as is well demonstrated by the presence of European Lumbricidae in North America, Asia, New Zealand"
                                            }
                                        ]
                                    }
                                ]
