                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "78d9ebc8-461b-3f00-ac4d-793656ea3d21",
                        "entry_id": "9965d488-a1b4-3a49-b68d-390db70e24d8",
                        "glosses": [
                            "zmuszenie do opuszczenia dotychczasowego miejsca pobytu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c1aff4a-af6b-42ad-bfaa-e25af772d28d",
                                "sense_id": "78d9ebc8-461b-3f00-ac4d-793656ea3d21",
                                "text": "Adam i Ewa zostali skazani na wygnanie z raju."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "66d2b1c9-2820-3b64-96b9-f5284319ff07",
                        "entry_id": "9965d488-a1b4-3a49-b68d-390db70e24d8",
                        "glosses": [
                            "przymusowy pobyt poza krajem, zwykle bez możliwości powrotu do ojczyzny"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1116f071-4a77-4b05-ba2a-bf7302cd12b5",
                                "sense_id": "66d2b1c9-2820-3b64-96b9-f5284319ff07",
                                "text": "A potem wybucha rok 1830. I znowu nowe mogiły, wygnania, ofiary i syzyfowa praca od początku."
                            },
                            {
                                "example_id": "fc4d8581-6215-44a1-ab17-00d94ad826f4",
                                "sense_id": "66d2b1c9-2820-3b64-96b9-f5284319ff07",
                                "text": "Można tę pracę uznać za jeden z powodów wygnania Owidiusza z Rzymu."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "704e0fe8-09b0-4eb2-9246-bf335110ef45",
                        "source_entry_id": "9965d488-a1b4-3a49-b68d-390db70e24d8",
                        "source_sense_id": "78d9ebc8-461b-3f00-ac4d-793656ea3d21",
