                ],
                "senses": [
                    {
                        "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                        "entry_id": "83f943c3-b62f-3ea9-b890-28eeeb515330",
                        "glosses": [
                            "jemand, der einer Anforderung nicht gerecht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6195ad4-f342-4101-abb3-08df55e2e350",
                                "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                                "text": "„Denn die Abgaben der Nichterfüller werden im Umlageverfahren an die Unternehmen verteilt, die Behinderte einstellen.“"
                            },
                            {
                                "example_id": "a6c839bb-e269-4526-992c-5f2783bf86f5",
                                "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                                "text": "„Die Bausparkasse, die auf Wachstum versessen ist, mag Hypotheken an potentielle Nichterfüller geben, eine nach Profit strebende Bank mag moralisch dubiose Unternehmen finanzieren; die technologisch orientierte Versicherungsgesellschaft mag den menschlichen Faktor vernachlässigen.“"
                            },
                            {
                                "example_id": "673b1aab-6889-4753-a71f-4868eb3ebe5b",
                                "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                                "text": "„Kleist ist das Gegenteil eines Genießers, er ist der Erleider, der Gequälte seiner Leidenschaft, der Nichtverwirklicher, der Nichterfüller seiner heißen Träume: […]“"
                            },
                            {
                                "example_id": "cd95f901-a921-4872-a9aa-74991d3de133",
                                "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                                "text": "„Jeden Morgen beim Appell wurden die Nichterfüller vor die Front gerufen und regelrecht zur Sau gemacht.“"
                            },
                            {
                                "example_id": "564e48f6-aee6-47cc-bfc6-e443c7fd7946",
                                "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                                "text": "„Eigentlich alles kein Umschmiss, wäre es nicht üblich gewesen, den Rückmarsch für Nichterfüller zu erschweren, indem sie neben der Straße laufen mussten.“"
                            },
                            {
                                "example_id": "9e619d1e-9399-4880-923d-5f13a3077da6",
                                "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                                "text": "„Deshalb sei man jetzt auch an sogenannten Nichterfüllern interessiert, also Pädagogen, die nicht sämtliche Bedingungen für die Verbeamtung erfüllen und bislang abgelehnt wurden.“"
                            },
                            {
                                "example_id": "7e915734-5c66-4b15-9aa0-bba9b50feda6",
                                "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                                "text": "„Es ist höchst bedenklich, wenn zur Behebung des hausgemachten und lange absehbaren Lehrermangels neuerdings ‚Quereinsteiger‘ (sog. ‚Nichterfüller‘) ohne pädagogische Qualifikation und ohne Zweites Staatsexamen, das aber in modifizierter Form nachgeholt werden muß, angeworben werden.“"
                            },
                            {
                                "example_id": "56a77a3e-78c7-4abb-9383-1a3ca938caf5",
                                "sense_id": "9babc0a4-408d-38a6-9437-1cba4413d8ed",
                                "text": "„Die Nichterfüller müssen in die Entgeltgruppe aufsteigen können, die bei vollständiger Qualifikation bezahlt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
