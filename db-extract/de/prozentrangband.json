                "senses": [
                    {
                        "sense_id": "61059e07-6bb0-3dfe-ac64-07ffb85e8787",
                        "entry_id": "7b6af469-e792-3768-a87a-e6f6646057c7",
                        "glosses": [
                            "Wertebereich, der sich aus dem Prozentrang und dem Messfehler ergibt und in dem sich ein Proband mit hoher Wahrscheinlich tatsächlich befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9742255-c57c-4822-8a38-e89fdd08f700",
                                "sense_id": "61059e07-6bb0-3dfe-ac64-07ffb85e8787",
                                "text": "„Hier kann ein Lehrer beispielweise sehen, dass ein Schüler bzw. eine Schülerin mit einem Testrohwert von 75 Punkten im Prozentrangband 73-89 liegt.“"
                            },
                            {
                                "example_id": "25fd83f3-7a1d-42fa-9e48-f65afb55b6eb",
                                "sense_id": "61059e07-6bb0-3dfe-ac64-07ffb85e8787",
                                "text": "„Ein Prozentrangband gibt die Bandbreite aller Prozentränge, in denen sich der/die Schüler/in befindet, an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
