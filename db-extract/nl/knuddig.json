                                        ],
                                        "examples": [
                                            {
                                                "example_id": "112d6312-cde7-46d4-8ed1-9c225ca0ade5",
                                                "sense_id": "b8186ca4-13da-3a7a-aa4a-d426be7b21f0",
                                                "text": "„Als Eva hort des segens wort, // da loff sie fort, // holt ire kinder iegliches von seinem ort // und stellet sie alle für got // ein gstrobelt unlustig grindig und lausige rot, // schwarz und verschmort, // fast den zigeunern gleich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4cf5be02-af23-3f84-ba12-f87b8b1f4686",
                                        "entry_id": "2b3a5fdb-c5bc-3c6b-a292-4a321f02a452",
                                        "glosses": [
                                            "äußerst bedeutungslos seiend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd770ebc-111c-474a-9c88-670c78cfb6fe",
                                                "sense_id": "4cf5be02-af23-3f84-ba12-f87b8b1f4686",
                                                "text": "Reg dich nicht auf wegen der lausigen paar Münzen."
                                            }
                                        ],
                                        "sense_index_json": "\"2a\""
                                    },
                                    {
                                        "sense_id": "16fb025f-9a43-306f-bc8b-d2076828979f",
                                        "entry_id": "2b3a5fdb-c5bc-3c6b-a292-4a321f02a452",
                                        "glosses": [
                                            "äußerst schlecht seiend"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e19a36f0-d732-44e9-ac3e-be426f177eea",
                                                "sense_id": "16fb025f-9a43-306f-bc8b-d2076828979f",
                                                "text": "Wie sich herausstellte war er ein lausiger Spieler."
                                            }
                                        ],
                                        "sense_index_json": "\"2b\""
                                    },
                                    {
                                        "sense_id": "5dafc6b6-476f-36f6-8034-2387fb0d15ad",
