                                    {
                                        "sense_id": "0db33af0-8b79-3701-b160-cce51a6ce52e",
                                        "entry_id": "2782b271-e718-3d19-af7d-d800141dc3e0",
                                        "glosses": [
                                            "Commune et ville portuaire d’Espagne, chef-lieu de la province du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca28f09-ce3a-4b79-b88c-e63326ed5bb9",
                                                "sense_id": "0db33af0-8b79-3701-b160-cce51a6ce52e",
                                                "text": "Voici la généalogie vraie de notre lionne rousse : il y avait, à Malaga, un riche marchand de beurre, de sardines et de sucre ; il se nommait Kirpatrick ; il était père de quatre filles ; l’une d’elles se distinguait par sa grâce et le besoin de se désensardiner."
                                            },
                                            {
                                                "example_id": "31e6707a-1cea-4fbc-8450-b5fda8d35b36",
                                                "sense_id": "0db33af0-8b79-3701-b160-cce51a6ce52e",
                                                "text": "Sa mère s’était procuré un petit fût d’excellent vin de Malaga ; et riant à l’idée d’être grise, elle en buvait deux doigts, pas davantage."
                                            },
                                            {
                                                "example_id": "ebca0599-6619-4387-8b30-457022955e84",
                                                "sense_id": "0db33af0-8b79-3701-b160-cce51a6ce52e",
                                                "text": "Garde le Sud, puis l’Est-Nord-Est, t’approche pas de Malaga, mets droit sur le cap Sacratif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "679b5c28-361e-304a-880c-7ce63ee8355b",
                                        "entry_id": "2782b271-e718-3d19-af7d-d800141dc3e0",
                                        "glosses": [
                                            "Province d’Espagne située dans la communauté autonome d’Andalousie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
