                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Transformation"
                    },
                    {
                        "form_id": "19e3c277-1ae2-4ba7-b63e-7cf9bb105edf",
                        "entry_id": "682209d1-1b5d-3929-8e48-74d0fead825c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Transformationen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ec4333e-3461-3782-9d61-d02e6e1b3684",
                        "entry_id": "682209d1-1b5d-3929-8e48-74d0fead825c",
                        "glosses": [
                            "eine deutliche Veränderung einer grundlegenden Eigenschaft, zum Beispiel der Form"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cfba64e-4527-480d-aa1b-aa12dafeb309",
                                "sense_id": "4ec4333e-3461-3782-9d61-d02e6e1b3684",
                                "text": "Die Transformation ist hier ein schrittweiser Übergangsprozess, der innerhalb einer bestimmten Zeitperiode abläuft."
                            },
                            {
                                "example_id": "1bc7a922-bbc5-48b0-8e91-c441ab950594",
                                "sense_id": "4ec4333e-3461-3782-9d61-d02e6e1b3684",
                                "text": "„Eine einschneidende Transformation der globalen Energieversorgung lassen diese Zahlen also nicht erkennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1eaa9ee9-49ed-3b4b-9e41-642ce790ec9d",
                        "entry_id": "682209d1-1b5d-3929-8e48-74d0fead825c",
                        "glosses": [
                            "Umformung, die an Sprachstrukturen oder auch an Syntagmen vorgenommen wird; zentraler Begriff der strukturalistischen und der generativen Grammatik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55a3a100-b448-452c-970d-00f21f399ea9",
                                "sense_id": "1eaa9ee9-49ed-3b4b-9e41-642ce790ec9d",
                                "text": "Der Begriff der Transformation stammt aus dem amerikanischen Strukturalismus der Mitte des 20. Jahrhunderts und entspricht ungefähr dem Konzept der (grammatischen) Proben, die in der traditionellen Grammatik verwendet werden, z.B. bei der Analyse von Satzgliedern."
                            },
                            {
                                "example_id": "4e01ef4e-2a1f-4b01-93bc-02fe3a1364da",
                                "sense_id": "1eaa9ee9-49ed-3b4b-9e41-642ce790ec9d",
                                "text": "„Absicht und Leistung der generativen Transformationsgrammatik bestehen darin, komplexe sprachliche Sachverhalte auf möglichst einfache und übersichtliche Strukturen zurückzuführen und die Komplexität aus Transformationen dieser sogenannten Tiefenstrukturen zu interpretieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b595a6a9-c17b-4aef-9d56-7fd14f7fb481",
                        "source_entry_id": "682209d1-1b5d-3929-8e48-74d0fead825c",
                        "source_sense_id": "4ec4333e-3461-3782-9d61-d02e6e1b3684",
                        "source_sense_description": "eine deutliche Veränderung einer grundlegenden Eigenschaft, zum Beispiel der Form",
                        "target_lang_word": "transformation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transformation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3751b370-4c5b-3dfc-a732-8d327428f277",
                                        "entry_id": "b31c0b1c-99cb-3206-a5bc-b5b87368e11f",
                                        "glosses": [
                                            "The act of transforming or the state of being transformed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a207944-9e40-4909-b060-a01aa6fb26f2",
                                                "sense_id": "3751b370-4c5b-3dfc-a732-8d327428f277",
                                                "text": "undergo a radical transformation"
                                            },
                                            {
                                                "example_id": "737e1a8b-ecf3-40cc-a851-cd6afb77aceb",
                                                "sense_id": "3751b370-4c5b-3dfc-a732-8d327428f277",
                                                "text": "Over the past two centuries, the railway has become a force of economic and social transformation connecting towns and cities, carrying ideas and ambitions. One place to experience this change was Swindon. With the arrival of Brunel's Great Western Railway, Swindon began a remarkable transformation as what had been a modest market town quickly became a centre of industrial activity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f244b969-d19f-3dba-9ae6-287b6e37d718",
                                        "entry_id": "b31c0b1c-99cb-3206-a5bc-b5b87368e11f",
                                        "glosses": [
                                            "A marked change in appearance or character, especially one for the better."
                                        ],
