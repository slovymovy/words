                "senses": [
                    {
                        "sense_id": "a06a4117-e39d-37cf-92d0-c202acabeed4",
                        "entry_id": "bcbdc189-9938-3a11-a2ce-afee9bb844c6",
                        "glosses": [
                            "noble, nobleman, aristocrat"
                        ],
                        "tags": [
                            "feminine",
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "0dbf325b-876c-473f-962e-e968e4fa6c87",
                                "sense_id": "a06a4117-e39d-37cf-92d0-c202acabeed4",
                                "text": "De edele verdedigde de koning tegen zijn vijanden.",
                                "translation": "The noble defended the king against his enemies.",
                                "english": "The noble defended the king against his enemies."
                            },
                            {
                                "example_id": "5762d7c0-875c-4a4f-b010-436027ff2a39",
                                "sense_id": "a06a4117-e39d-37cf-92d0-c202acabeed4",
                                "text": "In de middeleeuwen hadden edelen veel land en invloed.",
                                "translation": "In the medieval times, nobles had vast lands and influence.",
                                "english": "In the medieval times, nobles had vast lands and influence."
                            },
                            {
                                "example_id": "77515e71-8003-43ea-9165-c7b642897d3c",
                                "sense_id": "a06a4117-e39d-37cf-92d0-c202acabeed4",
                                "text": "De edele vrouw werd gerespecteerd voor haar wijsheid en moed.",
                                "translation": "The noblewoman was revered for her wisdom and courage.",
                                "english": "The noblewoman was revered for her wisdom and courage."
                            }
                        ]
                    }
                ],
