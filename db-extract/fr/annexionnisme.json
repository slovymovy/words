                        "glosses": [
                            "Théorie politique qui préconise l’annexion d’autres territoires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af1a08c-c789-4f2a-9158-72bee2c22660",
                                "sense_id": "e583d7c3-9eaa-3afa-b0c5-fd5026106fa1",
                                "text": "L’annexionnisme constitua une sorte de voie intermédiaire, surtout à partir de 1846, qui alliait à la fois anti-colonialisme et volonté du maintien de l’esclavage."
                            },
                            {
                                "example_id": "9fa42adc-b8ac-48cf-a651-a6d0c400b4ac",
                                "sense_id": "e583d7c3-9eaa-3afa-b0c5-fd5026106fa1",
                                "text": "L’annexionnisme est à rejeter par principe et par bon sens pratique."
                            }
                        ]
                    }
