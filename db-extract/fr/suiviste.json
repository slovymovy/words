                                            {
                                                "example_id": "c98ab56e-d5a2-46e2-9ef5-7d3d400fe151",
                                                "sense_id": "ba8ec7f7-26ec-3ecb-b4d9-3bd863fb6e6a",
                                                "text": "Following the meeting, we all had a chat."
