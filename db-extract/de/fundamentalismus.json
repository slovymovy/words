                    {
                        "translation_id": "9e0cdcca-4ae3-42f5-b4c3-876658df4eb7",
                        "source_entry_id": "368cd8d6-2966-31ec-9caa-b7aa70fe9053",
                        "source_sense_id": "7aac9290-fc05-3456-bbef-c5eda1943abd",
                        "source_sense_description": "entschlossenes Festhalten an den Grundlagen einer Vorstellung (Gedanken, Einfall) oder eines Glaubens",
                        "target_lang_word": "fundamentalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fundamentalism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "daa8de14-9b7e-336a-9738-4fdf4541760b",
                                        "entry_id": "1c77f196-80ad-3d0f-a997-c729d118c78c",
                                        "glosses": [
                                            "The tendency to reduce a religion to its most fundamental tenets, based on strict interpretation of core texts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64ddfafa-e488-3076-8b10-9255b48f4199",
                                        "entry_id": "1c77f196-80ad-3d0f-a997-c729d118c78c",
                                        "glosses": [
                                            "A rigid conformity to any set of basic tenets."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8eb664f-cccd-4e10-a72f-5daea04b6fc2",
                                                "sense_id": "64ddfafa-e488-3076-8b10-9255b48f4199",
                                                "text": "Recent books by philosopher Roger Scruton (1999, 2000) and music educator Robert Walker (2007) may be interpreted as a last desperate gasp of this form of musical fundamentalism or neoconservativism—the kind that tells the masses what is \"good for them\" on the grounds that they lack adequate bases for judgments on their own […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2127ef7a-dfab-389f-9249-dac35c82599d",
                                        "entry_id": "1c77f196-80ad-3d0f-a997-c729d118c78c",
                                        "glosses": [
                                            "The belief that fundamental financial quantities are the best predictor of the price of a financial instrument."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e629e275-c5d2-323f-a1a2-575b540f33c8",
                                        "entry_id": "1c77f196-80ad-3d0f-a997-c729d118c78c",
                                        "glosses": [
                                            "A Christian movement that started in the late 19th and early 20th centuries among British and American Protestants, which emphasizes literal interpretation of the Bible, and came up as a reaction to liberal theology and cultural modernism"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e09c45fb-9845-4d5b-ad3b-bc920e48a6ef",
                        "source_entry_id": "368cd8d6-2966-31ec-9caa-b7aa70fe9053",
                        "source_sense_id": "7aac9290-fc05-3456-bbef-c5eda1943abd",
                        "source_sense_description": "entschlossenes Festhalten an den Grundlagen einer Vorstellung (Gedanken, Einfall) oder eines Glaubens",
                        "target_lang_word": "fondamentalisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fondamentalisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "605a7efd-1db1-3d47-88c5-c06ae8ebd411",
                                        "entry_id": "6adce48a-985c-3592-8270-22376a1d12b6",
                                        "glosses": [
                                            "Doctrine suivie par certains théologiens protestants prônant le retour aux fondements de la foi religieuse en s'inspirant du sens littéral des Écritures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37e844ac-57e4-4a10-aa30-5d40cf8bf096",
                                                "sense_id": "605a7efd-1db1-3d47-88c5-c06ae8ebd411",
                                                "text": "Le fondamentalisme est né aux États-Unis, dans le contexte du protestantisme. En 1919, des pasteurs presbytériens, baptistes et méthodistes fondent la World's Christian Fundamentals Association, pour défendre les points de la foi qui leur paraissent fondamentaux. Ils soutiennent en particulier une interprétation littérale de la Bible. Prenant à la lettre le récit de la création du monde en six jours dans la Genèse, ils rejettent les théories de Darwin sur les origines de l'homme et sur l'évolution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d51c03df-e2ea-364b-9e98-9d6665385f4c",
                                        "entry_id": "6adce48a-985c-3592-8270-22376a1d12b6",
                                        "glosses": [
                                            "Interprétation littérale de tous textes, par exemple juridiques ou religieux."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "98811f40-f5b3-4c56-8d0d-8d9e71370925",
                                                "sense_id": "d51c03df-e2ea-364b-9e98-9d6665385f4c",
                                                "text": "Le fondamentalisme juridique."
                                            },
                                            {
                                                "example_id": "4d7e7fc9-7af2-4301-9f4b-f2ca9e50b1c0",
                                                "sense_id": "d51c03df-e2ea-364b-9e98-9d6665385f4c",
                                                "text": "… le fondamentalisme est opposé à la séparation des ordres religieux et politiques et il entend subordonner le politique au religieux. C'est un principe ancien qui est particulièrement virulent dans l'islam aujourd'hui, mais qui a prévalu aussi dans d'autres religions dans le passé ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
