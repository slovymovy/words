            "senses": [
                {
                    "sense_id": "076b45ac-999d-3b48-9363-5137162957a1",
                    "sense_definition": "zmniejszyć obszar zajmowany przez coś rozpostartego lub długość czegoś",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zwijanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Zwinął</w> kartkę i schował ją do kieszeni.",
                            "target_lang_translations": {
                                "ru": "Он <w>свернул</w> листок и спрятал его в карман."
                            }
                        },
                        {
                            "text": "Musisz <w>zwinąć</w> ten dywan przed odkurzaniem.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>свернуть</w> этот ковер перед уборкой пылесосом."
                            }
                        }
                    ],
                    "synonyms": [
                        "zrolować"
                    ],
                    "antonyms": [
                        "rozwinąć"
                    ],
                    "common_phrases": [
                        "zwinąć dywan",
                        "zwinąć żagle"
                    ],
                    "target_lang_definitions": {
                        "ru": "уменьшить площадь, занимаемую чем-то развернутым, или длину чего-то"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свернуть",
                                "target_lang_sense_clarification": "сделать рулон или компактную форму из чего-то плоского"
                            },
                            {
                                "target_lang_word": "скатать",
                                "target_lang_sense_clarification": "свернуть в плотный рулон"
                            }
                        ]
