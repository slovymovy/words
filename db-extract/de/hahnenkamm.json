                                        "entry_id": "5f22a312-988a-3584-a4f4-726f8bf2b6e7",
                                        "glosses": [
                                            "An annual garden plant (Celosia argentea var. cristata, syn. Celosia cristata), having showy red clusters of flowers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64b152d6-180a-4516-835c-251babebed3f",
                                                "sense_id": "99f61228-1cd9-3061-960b-8ad1c613ce73",
                                                "text": "She saw a square picture framed in the window, two whitewashed cottages each with a little winding path, a bed of red and yellow cockscomb, a sloping field, a row of gum-trees, a child in a blue sunbonnet carrying a basket."
                                            }
                                        ]
