                ],
                "senses": [
                    {
                        "sense_id": "7d1c3142-c5f5-34ab-9956-ff28cf4091f7",
                        "entry_id": "3e60a3dc-86c7-3977-b5d4-02ae632044cf",
                        "glosses": [
                            "großer (Leiter-)Wagen zum Transportieren von zuvor Geerntetem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61533019-329f-4581-a2be-da2a7eda1640",
                                "sense_id": "7d1c3142-c5f5-34ab-9956-ff28cf4091f7",
                                "text": "„Hochbeladen schwankten die Erntewagen bis zum Einbruch der Dunkelheit über die staubigen Landwege. Tag für Tag schien die Sonne. Die Scheunen füllten sich. Es war ein reiches Erntejahr.“"
                            },
                            {
                                "example_id": "93a87f2e-b941-4e3e-a921-5bfe61c8943a",
                                "sense_id": "7d1c3142-c5f5-34ab-9956-ff28cf4091f7",
                                "text": "„Was die Erntewagen anlangt, ſo können dieſelben nur zweckmäßig genannt werden, wenn ſie ſich ohne Zeitverſäumniß ſchnell laden laſſen, viel Frucht faſſen, ohne daß die Ladung auf dem Wagen auseinanderfährt, die geladene Frucht feſt liegt und die wenigſten Körner verloren gehen.“ [1861]"
                            },
                            {
                                "example_id": "02db07cb-b25c-4bd5-bf9d-c670ce6a1817",
                                "sense_id": "7d1c3142-c5f5-34ab-9956-ff28cf4091f7",
                                "text": "„Doch unter dem Tor hatten sich Vertiefungen gebildet, wohl vom jahrelangen Ein- und Ausfahren der Erntewagen.“"
                            },
                            {
                                "example_id": "bd20187b-5692-4e19-8dae-a2613776bbfc",
                                "sense_id": "7d1c3142-c5f5-34ab-9956-ff28cf4091f7",
                                "text": "„Er sah Mareike mit weißem Kopftuch und grauer Schürze auf einem Erntewagen, wie sie Garben legte, während Heukähne den Strom hinabfuhren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
