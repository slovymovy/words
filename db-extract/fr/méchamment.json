        "fr-extract.jsonl": [
            {
                "entry_id": "ca611117-c395-3b27-bbb5-d648c3f52e37",
                "word": "méchamment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                        "entry_id": "ca611117-c395-3b27-bbb5-d648c3f52e37",
                        "glosses": [
                            "Avec méchanceté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b855eb5-b659-4bba-94b8-d18bf2d7e9c3",
                                "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                "text": "Quelqu’un d’autre gratifia méchamment Bert de plusieurs solides coups de pied."
                            },
                            {
                                "example_id": "b10dc51d-b7e4-4161-8ff8-c2f64bc4d4fb",
                                "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                "text": "Jimmy le faisait méchamment trébucher, en le happant du crochet de sa grosse canne blanche."
                            },
                            {
                                "example_id": "de41749e-ce3b-445b-9ddb-c3f65668d849",
                                "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                "text": "Combien les lunettes nous ont-elles découvert d’êtres qui n'étaient point pour nos philosophes d’auparavant ! on entreprenait méchamment l’Écriture sainte sur le grand nombre des étoiles, en disant : il n'y en a que mille vingt-deux, nous le savons."
                            },
                            {
                                "example_id": "e6afad3a-8f0c-41b0-ae34-090fce85f1b8",
                                "sense_id": "8b1741cc-e389-3230-9ac5-ac22e44a4eb5",
                                "text": "Mais pour un lourd frelon, méchamment imbécile,\nQui vit du mal qu’il fait et nuit sans être utile,\nOn écrase à plaisir cet insecte orgueilleux."
                            }
                        ]
                    },
                    {
                        "sense_id": "42c35b09-dc8a-3592-a68a-d35cfe44529f",
                        "entry_id": "ca611117-c395-3b27-bbb5-d648c3f52e37",
                        "glosses": [
                            "Gravement."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "78353e68-b8c1-401a-b861-41bffd19ff40",
                                "sense_id": "42c35b09-dc8a-3592-a68a-d35cfe44529f",
                                "text": "C'était la terreur. Un sacré tord-boyaux de frousse tellement on avait peur qu'un des deux se viandât méchamment cinq mètres plus bas."
                            }
                        ]
                    },
                    {
                        "sense_id": "ec5dd7b0-4c9a-3646-aec4-1fafcf81e2b2",
                        "entry_id": "ca611117-c395-3b27-bbb5-d648c3f52e37",
                        "glosses": [
                            "Très, extrêmement."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3ffd0463-bcf8-4add-9d04-82b8fa860ec9",
                                "sense_id": "ec5dd7b0-4c9a-3646-aec4-1fafcf81e2b2",
                                "text": "Sur les murs tout en beau bois sombre, c’était couvert de photos de bécanes, de posters avec des espèces de slogans marrants, et il y avait deux vieilles brêles méchamment splendides exposées sur des piédestaux au fond de la salle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78cf6ee6-d73a-43cd-b4f6-3f3982a6aca1",
                        "source_entry_id": "ca611117-c395-3b27-bbb5-d648c3f52e37",
                        "target_lang_word": "unkindly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unkindly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "04b83e2e-e556-3597-b0c6-1f0dfd0aaf11",
                                        "entry_id": "ed8c13d6-d463-3511-8f94-51fcba97a7ed",
                                        "glosses": [
                                            "Not kindly.",
                                            "Not kind, lacking in friendliness, warm-heartedness or sympathy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6221835e-5be2-41d6-925c-0715e228347a",
                                                "sense_id": "04b83e2e-e556-3597-b0c6-1f0dfd0aaf11",
                                                "text": "Preceded by the beadle, and attended by an irregular procession of stern-browed men and unkindly visaged women, Hester Prynne set forth towards the place appointed for her punishment."
                                            },
                                            {
                                                "example_id": "ebf42300-cde8-4527-b2d4-33aab512c1ea",
                                                "sense_id": "04b83e2e-e556-3597-b0c6-1f0dfd0aaf11",
                                                "text": "[…] she had seen a not unkindly wink pass between the two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ff0d0cc-b66b-3439-a8aa-7371b1d03e13",
                                        "entry_id": "ed8c13d6-d463-3511-8f94-51fcba97a7ed",
                                        "glosses": [
                                            "Not kindly.",
                                            "Rough, unfavourable, bad."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e782c62f-416c-4adb-90e2-515f9cdfd6e9",
                                                "sense_id": "9ff0d0cc-b66b-3439-a8aa-7371b1d03e13",
                                                "text": "From this superfluous pulp in unkindely, and wet years, may arise that multiplicity of little insects, which infest the Roots and Sprouts of tender Graines and pulses."
                                            },
                                            {
                                                "example_id": "339a1990-a6e7-47dd-b31b-9ef596529bd7",
                                                "sense_id": "9ff0d0cc-b66b-3439-a8aa-7371b1d03e13",
                                                "text": "Unkindly cold and tempest shrill / In life’s morn oft the traveller chill,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a51adf-3142-3e41-87af-73714945997b",
                                        "entry_id": "ed8c13d6-d463-3511-8f94-51fcba97a7ed",
                                        "glosses": [
                                            "Not kindly.",
                                            "Unnatural, contrary to the natural or proper order of things."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb8c1557-9f1e-4d8d-a01a-3d8599d53e2b",
                                                "sense_id": "88a51adf-3142-3e41-87af-73714945997b",
                                                "text": "That detestable sight him much amazde, / To see th’vnkindly Impes of heauen accurst, / Deuoure their dam;"
                                            },
                                            {
                                                "example_id": "44d18551-d7d5-48cf-a40b-466cfd48c3bd",
                                                "sense_id": "88a51adf-3142-3e41-87af-73714945997b",
                                                "text": "1678, Robert Sanderson, Nine Cases of Conscience Occasionally Determined, London: H. Brome et al., p. 128,\n[…] the want of mercy in a Father, is more unkindly, more unseemly, more unnatural than in another man […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unkindly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd9cbeab-2d0a-34d4-8b09-b9bdb84132b6",
                                        "entry_id": "5dba84c3-9b1c-353d-9792-af41a28930de",
                                        "glosses": [
                                            "In an unkind manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcead763-b860-4def-b6d5-2438b09094d4",
                                                "sense_id": "dd9cbeab-2d0a-34d4-8b09-b9bdb84132b6",
                                                "text": "Good master, take it not unkindly, pray, / That I have been thus pleasant [i.e. joking] with you both."
                                            },
                                            {
                                                "example_id": "ac4493e7-3fd6-4999-af39-de8ae92e5141",
                                                "sense_id": "dd9cbeab-2d0a-34d4-8b09-b9bdb84132b6",
                                                "text": "[…] I had over-heard them ſeveral times talking very Unkindly about me; […]"
                                            },
                                            {
                                                "example_id": "49775d1f-9d0e-4a74-bfc0-9c1d5d7e892e",
                                                "sense_id": "dd9cbeab-2d0a-34d4-8b09-b9bdb84132b6",
                                                "text": "If she and John love one another, they can wait, and test the love by doing so. She is conscientious, and I have no fear of her treating him unkindly."
                                            },
                                            {
                                                "example_id": "0120cc4a-42bf-4d24-b1e9-2405e73ae439",
                                                "sense_id": "dd9cbeab-2d0a-34d4-8b09-b9bdb84132b6",
                                                "text": "Chester and Prideaux were dragged firmly but not unkindly down the stairs and out through the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c29e5945-623a-3b76-a915-4e194a7404cd",
                                        "entry_id": "5dba84c3-9b1c-353d-9792-af41a28930de",
                                        "glosses": [
                                            "In an unnatural manner."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f48356fb-5286-40eb-b955-d62471b01f70",
                                                "sense_id": "c29e5945-623a-3b76-a915-4e194a7404cd",
                                                "text": "All th’ unaccomplisht works of Natures hand, / Abortive, monstrous, or unkindly mixt, / Dissolvd on earth, fleet hither, and in vain, / Till final dissolution, wander here,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
