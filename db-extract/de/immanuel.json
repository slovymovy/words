                        "glosses": [
                            "männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ae61c4e-225b-40d1-8ab7-856c304647a7",
                                "sense_id": "1969295b-62f5-3ece-a61b-7fc8776ee8f5",
                                "text": "Es ist immer wieder eine Freude, bei Immanuel eingeladen zu sein."
                            }
