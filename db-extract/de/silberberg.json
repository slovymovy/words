                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9022425-5272-44bd-88f5-d9554a9c86df",
                                "sense_id": "b12398e1-c517-3d57-8cb8-47942f3134fb",
                                "text": "„Zwischen 1545 und 1825 starben schätzungsweise acht Millionen indigener Bolivianer im Silberberg [Cerro Rico].“"
                            },
                            {
                                "example_id": "35ce25b3-1a2d-4961-b79d-56b2d06aca02",
                                "sense_id": "b12398e1-c517-3d57-8cb8-47942f3134fb",
                                "text": "„Ein Silberberg, 1000 Fuß hoch und von 1000 Fuß Weite, ſoll kürzlich in New-Mexico entdeckt worden ſein.“ [1870]"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "aa5847ec-db18-3b81-8087-97cde63dcb5e",
                        "entry_id": "c8416c1e-bb0e-3868-ab53-b120540e2a30",
                        "glosses": [
                            "(zu einem Berg) aufgehäufte Wertsachen aus Silber, zum Beispiel Münzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad9a0e2-a97d-467c-8db6-92562a241fae",
                                "sense_id": "aa5847ec-db18-3b81-8087-97cde63dcb5e",
                                "text": "„Auch kam hinzu, daß der Silberberg in Lorens’ Geldkiste sichtlich abgenommen hatte […].“"
                            }
                        ],
