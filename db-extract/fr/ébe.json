                                        "sense_id": "d2bb3c4a-1b35-3a30-830a-fb251d810891",
                                        "entry_id": "d697059b-a602-36af-9949-8128f74ac040",
                                        "glosses": [
                                            "To cause to flow back."
                                        ],
