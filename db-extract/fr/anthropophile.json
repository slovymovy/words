                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e4524786-07fc-4abf-a77f-d629b08b84c6",
                        "entry_id": "d0a8f0ac-99ef-3183-9d6d-035eac4ebe35",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "anthropophiles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "50014e3d-e63c-3199-b7b6-147fbc009ee4",
                        "entry_id": "d0a8f0ac-99ef-3183-9d6d-035eac4ebe35",
                        "glosses": [
                            "Qui aime les humains, en parlant d’êtres autres que les humains."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "cb054f10-0fc1-4316-842d-07e9caa78619",
                                "sense_id": "50014e3d-e63c-3199-b7b6-147fbc009ee4",
                                "text": "Au fil des générations, les individus anthropophiles qui ont été domestiqués sont ceux qui étaient le mieux adaptés, génétiquement parlant, à un régime riche en amidon."
                            }
                        ]
                    },
                    {
                        "sense_id": "12f078b8-1d26-3504-98fa-9964dda2161d",
                        "entry_id": "d0a8f0ac-99ef-3183-9d6d-035eac4ebe35",
                        "glosses": [
                            "Se dit d’une espèce que l’on rencontre dans les lieux habités par les humains."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ded0a3d-b872-4ebc-a1c3-1cb3b58bbef5",
                                "sense_id": "12f078b8-1d26-3504-98fa-9964dda2161d",
                                "text": "Une espèce anthropophile est dans une sorte d’entre-deux entre une espèce domestique, qui est utile aux humains qui l’utilisent pour se nourrir, se distraire ou travailler et qui contrôlent sa reproduction, et une espèce sauvage, qui échappe au contrôle des humains."
                            }
                        ]
                    },
                    {
                        "sense_id": "cae33017-33cc-33bd-823a-bea5635f93b0",
                        "entry_id": "d0a8f0ac-99ef-3183-9d6d-035eac4ebe35",
                        "glosses": [
                            "Se dit d’un parasite préférant parasiter un humain plutôt qu’un autre animal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39bef253-899c-4b9b-b992-f4b6a56ed28a",
                                "sense_id": "cae33017-33cc-33bd-823a-bea5635f93b0",
                                "text": "Causées par des espèces anthropophiles, les teignes à « M. audouinii » sont très contagieuses et nécessitent donc un diagnostic rapide."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bc45485-787a-4f8a-85b0-81c9d945de0d",
                        "source_entry_id": "d0a8f0ac-99ef-3183-9d6d-035eac4ebe35",
