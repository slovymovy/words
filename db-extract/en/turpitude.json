        "de-extract.jsonl": [
            {
                "entry_id": "43b1ed87-d6e1-3909-9987-a3aa558634e8",
                "word": "turpitude",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3dccf70c-ba00-39b4-aee2-0b0ace9f1858",
                        "entry_id": "43b1ed87-d6e1-3909-9987-a3aa558634e8",
                        "glosses": [
                            "Schandtat, Verworfenheit"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29dce60b-980b-4b1a-bbfe-be53f3256d7a",
                        "source_entry_id": "43b1ed87-d6e1-3909-9987-a3aa558634e8",
                        "source_sense_id": "3dccf70c-ba00-39b4-aee2-0b0ace9f1858",
                        "source_sense_description": "Schandtat, Verworfenheit",
                        "target_lang_word": "Schandtat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schandtat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                        "entry_id": "5419e003-417c-39e5-94de-2cc6d1b391dd",
                                        "glosses": [
                                            "grauenvolle Tat, abscheuliches Verbrechen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "443b2ba1-f89c-4602-9b38-3e0a7d8c82ff",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Hohe Vertreter französischer Muslime und Juden sind sich einig: Die Schandtat eines Einzelnen dürfe die Beziehung zwischen den Religionen nicht belasten.“"
                                            },
                                            {
                                                "example_id": "bf0d09a2-86ce-458f-8d96-0370a630aff5",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Bressac verübt seine Schandtaten nicht mehr an der Tante, sondern an der Mutter.“"
                                            },
                                            {
                                                "example_id": "d14d2ea3-c78a-47db-aeb7-7428158fec03",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„Ich habe nicht die Schwäche, zwischen meiner Schandtat und diesem Unglück einen Zusammenhang, wie etwa Ursache und Wirkung, suchen zu wollen.“"
                                            },
                                            {
                                                "example_id": "5d4c10ec-1592-4d23-8e26-4cc465494dc0",
                                                "sense_id": "999e9e80-5c10-3416-9025-0ea4e9cba508",
                                                "text": "„In London schrieben Schriftsteller mit Wurzeln in den früheren Kolonien über die Schandtaten des Empires.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                        "entry_id": "5419e003-417c-39e5-94de-2cc6d1b391dd",
                                        "glosses": [
                                            "kleineres Vergehen, unvernünftige Aktion"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd59a8e7-3e96-4ecf-aa40-49f8e52f7b5c",
                                                "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                                "text": "Jedes Jahr las der Nikolaus meine Schandtaten aus einem goldenen Buch vor und ich gelobte Besserung für das nächste Jahr."
                                            },
                                            {
                                                "example_id": "87ca19bd-360d-497c-92d8-dbdd334aaf0c",
                                                "sense_id": "951b2db4-e7b8-3780-aeaa-4c28b2356630",
                                                "text": "„Wenn ich – und diese Möglichkeit hätte bestanden – acht Tage früher angekommen wäre, hätte mir die zärtliche Lucia alles gebeichtet, und ich hätte diese Schandtat verhindert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aecc81e2-b1f5-4df8-bf1c-f700725f252d",
                        "source_entry_id": "43b1ed87-d6e1-3909-9987-a3aa558634e8",
                        "source_sense_id": "3dccf70c-ba00-39b4-aee2-0b0ace9f1858",
                        "source_sense_description": "Schandtat, Verworfenheit",
                        "target_lang_word": "Verworfenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verworfenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cdeec68c-fffa-3965-a223-82346b0087ca",
                                        "entry_id": "ff89154c-c268-332e-8cde-86a173bbbdf5",
                                        "glosses": [
                                            "Eigenschaft, verkommen/verworfen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481be68e-7f9c-4d67-8fe0-9fd6f51bbd00",
                                                "sense_id": "cdeec68c-fffa-3965-a223-82346b0087ca",
                                                "text": "„Sie bekreuzte sich, sie verneigte sich, und wenn sie den Worten der Liturgie nicht folgen konnte, so bat sie, ganz erschrocken über ihre Verworfenheit, Gott möge ihr alles, alles verzeihen und sich ihrer erbarmen.“"
                                            },
                                            {
                                                "example_id": "36589eb6-d7f8-4e3f-84ec-022297b6a851",
                                                "sense_id": "cdeec68c-fffa-3965-a223-82346b0087ca",
                                                "text": "„Hilf- und willenlos war das Geschöpf seiner Bestimmung ausgeliefert, der Erwählung oder der Verworfenheit, dem Aufstieg ins ewige Leben am Tag des Jüngsten Gerichts oder dem Absturz in die Hölle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
