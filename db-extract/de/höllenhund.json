                        ],
                        "form": "den Höllenhund"
                    },
                    {
                        "form_id": "6e56ce5c-35c8-4ad0-b452-57d9124533dd",
                        "entry_id": "2e64fb50-de8b-3e84-a13a-2f0b08f3727d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Höllenhunde"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                        "entry_id": "2e64fb50-de8b-3e84-a13a-2f0b08f3727d",
                        "glosses": [
                            "bösartiger, höllischer Hund"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e1bbc76-af9a-496e-b642-567bda7a01a2",
                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                "text": "„Unter meiner Obhut verwandelte sich der Höllenhund, der er vorher war, in einen kleinen Welpen.“"
                            },
                            {
                                "example_id": "e27641bd-d8c8-4d4d-aca2-25aab4dba8ef",
                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                "text": "„Sie kletterten abwärts; der runzlige Hexenmeister, der Höllenhund und der Mann Gottes stiegen in die Schwärze des Lochs hinab.“"
                            },
                            {
                                "example_id": "5cc70fd9-a270-481d-9495-7239ce7cbcad",
                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                "text": "„›Und Madison wusste, wenn sie ihre teuflische Mission totaler Verdammnis nicht konsequent zum Abschluss brächte, würden Satans Höllenhunde demnächst ihr hilfloses Kätzchen aufspüren und an seiner Haut Verträglichkeitstests für ein neues Damenhygienespray vornehmen!‹“"
                            },
                            {
                                "example_id": "6d9e6a0a-174d-4a98-b9b4-d006dd91e012",
                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                "text": "„Aber die Höllenhunde passen auch durch das Öhr eines Rings.“"
                            },
                            {
                                "example_id": "66ff04d0-45ac-44bc-96fd-8c3cfd2e9d23",
                                "sense_id": "28e8c79b-4a96-3006-bef2-61383a2e1e3f",
                                "text": "„Sie sehen wie echte Höllenhunde aus, die niemand streicheln will.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13060bf8-ee10-4c64-ae33-d1b5b556e2e5",
