{
    "word_family": [
        "scorcher"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "20bf8e71-2cd2-3c2b-ac0b-52baf8784698",
                    "sense_definition": "To burn the surface of something slightly, altering its color or texture.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hot iron managed to <w>scorch</w> the collar of his new cotton shirt.",
                            "target_lang_translations": {
                                "es": "La plancha caliente llegó a <w>chamuscar</w> el cuello de su camisa nueva de algodón."
                            }
                        },
                        {
                            "text": "Be careful not to <w>scorch</w> the soup while reheating it over high heat.",
                            "target_lang_translations": {
                                "es": "Ten cuidado de no <w>quemar</w> la sopa al recalentarla a fuego alto."
                            }
                        }
                    ],
                    "synonyms": [
                        "singe"
                    ],
                    "common_phrases": [
                        "scorch the surface"
                    ],
                    "target_lang_definitions": {
                        "es": "Quemar superficialmente algo, alterando su color o textura."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "chamuscar",
                                "target_lang_sense_clarification": "quemar superficialmente"
                            },
                            {
                                "target_lang_word": "quemar",
                                "target_lang_sense_clarification": "dañar con calor superficialmente"
                            },
                            {
                                "target_lang_word": "socarrar",
                                "target_lang_sense_clarification": "tostar o quemar por fuera"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2abdf34b-74d7-394b-8413-049ffacf3eb4",
                    "sense_definition": "To dry out, wither, or parch something with intense heat.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "burn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The relentless summer sun began to <w>scorch</w> the crops across the entire valley.",
                            "target_lang_translations": {
                                "es": "El implacable sol de verano empezó a <w>abrasar</w> los cultivos de todo el valle."
                            }
                        },
                        {
                            "text": "Weeks of drought threatened to <w>scorch</w> the grasslands and spark wildfires.",
                            "target_lang_translations": {
                                "es": "Semanas de sequía amenazaban con <w>achicharrar</w> los pastizales y desatar incendios forestales."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Secar, marchitar o abrasar algo mediante un calor intenso."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "abrasar",
                                "target_lang_sense_clarification": "resecar con calor extremo"
                            },
                            {
                                "target_lang_word": "achicharrar",
                                "target_lang_sense_clarification": "quemar o resecar por el sol o calor"
                            },
                            {
                                "target_lang_word": "agostar",
                                "target_lang_sense_clarification": "secar o marchitar la vegetación por el calor"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b0f460a-8dbc-3f55-be4e-9eae926d6ee4",
                    "sense_definition": "To move or travel at great speed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sports car managed to <w>scorch</w> down the highway before police could react.",
                            "target_lang_translations": {
                                "es": "El coche deportivo logró <w>ir a toda pastilla</w> por la autopista antes de que la policía pudiera reaccionar."
                            }
                        },
                        {
                            "text": "He watched the winger <w>scorch</w> past defenders to score an incredible winning try.",
                            "target_lang_translations": {
                                "es": "Vio cómo el extremo <w>volaba</w> al dejar atrás a los defensas para anotar un increíble ensayo de la victoria."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally or figuratively to denote extreme speed"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Desplazarse o avanzar a gran velocidad."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "ir a toda velocidad",
                                "target_lang_sense_clarification": "moverse con gran rapidez"
                            },
                            {
                                "target_lang_word": "volar",
                                "target_lang_sense_clarification": "avanzar a toda prisa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ade7e30e-27ec-3e1d-9dfe-a068a518665b",
                    "sense_definition": "A slight burn or mark of discoloration on a surface caused by heat.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She noticed an accidental <w>scorch</w> on the tablecloth from the hot pan.",
                            "target_lang_translations": {
                                "es": "Notó una <w>quemadura</w> accidental en el mantel dejada por la sartén caliente."
                            }
                        },
                        {
                            "text": "The fallen embers left a dark <w>scorch</w> across the wooden floorboards.",
                            "target_lang_translations": {
                                "es": "Las brasas caídas dejaron una <w>chamusquina</w> oscura sobre las tablas del suelo de madera."
                            }
                        }
                    ],
                    "synonyms": [
                        "singe"
                    ],
                    "target_lang_definitions": {
                        "es": "Quemadura leve o marca de decoloración en una superficie provocada por el calor."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "chamusquina",
                                "target_lang_sense_clarification": "marca de quemadura superficial"
                            },
                            {
                                "target_lang_word": "quemadura",
                                "target_lang_sense_clarification": "marca superficial producida por el calor"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}