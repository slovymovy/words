                            {
                                "example_id": "f77f48e5-8a47-4677-ba15-dcd023d069e8",
                                "sense_id": "7fb22d82-cd2c-3bbb-b370-4ac975dfe920",
                                "text": "„Als der Morgen dämmert, schaue ich durch ein gezacktes Loch in der Seitenwand, durch Sehschlitze, schließlich aus der Turmluke vorsichtig hinaus.“"
                            },
                            {
                                "example_id": "224ad293-9bd9-4e34-a7e4-c9592d524bc6",
                                "sense_id": "7fb22d82-cd2c-3bbb-b370-4ac975dfe920",
                                "text": "„Als ich meinen Kopf aus der Turmluke steckte, sah ich die Sonne im Westen untergehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
