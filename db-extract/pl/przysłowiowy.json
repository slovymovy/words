        "pl-extract.jsonl": [
            {
                "entry_id": "a14e7acf-6754-389b-9b43-fd052a28445e",
                "word": "przysłowiowy",
                "pos": "adj",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "110e3ca7-ce69-34a7-a5a4-eba568bce51d",
                        "entry_id": "a14e7acf-6754-389b-9b43-fd052a28445e",
                        "glosses": [
                            "dotyczący przysłowia, popularnego frazeologizmu, wskazuje że treść należy rozumieć przenośnie a nie dosłownie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cf1b2f6-2dfb-4dff-a1a4-5380fac6d41f",
                                "sense_id": "110e3ca7-ce69-34a7-a5a4-eba568bce51d",
                                "text": "Zgniotę cię jak przysłowiową pluskwę."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a6c149c4-5dc8-3143-acb1-4a174735b2ef",
                        "entry_id": "a14e7acf-6754-389b-9b43-fd052a28445e",
                        "glosses": [
                            "powszechnie znany"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "879c2387-20b3-42b5-82b1-1b225b4bee55",
                        "source_entry_id": "a14e7acf-6754-389b-9b43-fd052a28445e",
                        "source_sense_id": "110e3ca7-ce69-34a7-a5a4-eba568bce51d",
                        "target_lang_word": "proverbial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proverbial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0454cf9d-24a8-30d1-9e36-60ce78bebc8e",
                                        "entry_id": "ad5a015b-9096-3f3a-8fcc-a94995761172",
                                        "glosses": [
                                            "Of, resembling, or expressed as a proverb, cliché, fable, or fairy tale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fed951a-931a-437a-897b-af7d35484931",
                                                "sense_id": "0454cf9d-24a8-30d1-9e36-60ce78bebc8e",
                                                "text": "The busyness of a beaver is proverbial."
                                            },
                                            {
                                                "example_id": "52425a17-eb01-4584-9eaf-0020c32a7e40",
                                                "sense_id": "0454cf9d-24a8-30d1-9e36-60ce78bebc8e",
                                                "text": "The beaver in this instance upheld the reputation of the proverbial one: her output was prodigious."
                                            },
                                            {
                                                "example_id": "74633683-f1c9-40a5-9c3f-63bb3dd937de",
                                                "sense_id": "0454cf9d-24a8-30d1-9e36-60ce78bebc8e",
                                                "text": "Doris: You're making me feel like the proverbial stepmother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                        "entry_id": "ad5a015b-9096-3f3a-8fcc-a94995761172",
                                        "glosses": [
                                            "Optionally placed before an element of a well-known proverb or metaphor to emphasize that the element is not being used in a literal sense (see Usage notes below)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44ac4928-f6de-4d5c-b14a-48df6aee009b",
                                                "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                                "text": "the proverbial smoking gun"
                                            },
                                            {
                                                "example_id": "be7af78b-78f0-4574-8ab2-0ba65d8737ab",
                                                "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                                "text": "the proverbial spilled milk"
                                            },
                                            {
                                                "example_id": "1d10cfe1-ff2b-44b4-a5a7-f86bd487d0ea",
                                                "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                                "text": "The visit was a warning shot across our proverbial bow"
                                            },
                                            {
                                                "example_id": "49723e52-d1d1-4619-8bbe-6b9c9b701e68",
                                                "sense_id": "8d9b58bf-3acd-30c4-a5ab-4f52d8dafa19",
                                                "text": "“We don’t like it, it’s the proverbial ‘crap sandwich’ that they talk about but what’s the best move from here and we think it’s the way to go,” said Rep. Mark Walker, chairman of the large group of fiscal conservatives known as the Republican Study Committee. […] “I think there is a growing consensus, whether it’s February or sometime, that we don’t want to be on this proverbial hamster wheel,” he said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a2158d-575b-3115-a5ac-abead6dc843e",
                                        "entry_id": "ad5a015b-9096-3f3a-8fcc-a94995761172",
                                        "glosses": [
                                            "Widely known; famous; stereotypical."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dd3c75b-a2dc-4a15-a914-a44f4a5b6601",
                                                "sense_id": "63a2158d-575b-3115-a5ac-abead6dc843e",
                                                "text": "I grew up in a prefab house on Main Street in 1950s suburbia, the second and last child of a proverbial nuclear family."
                                            },
                                            {
                                                "example_id": "68aeca7a-0bdb-4caf-9d33-14b3458141af",
                                                "sense_id": "63a2158d-575b-3115-a5ac-abead6dc843e",
                                                "text": "Mr. Obama has presented himself as a fresh face, unsteeped in Washington and the proverbial “politics as usual.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "proverbial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53137e6d-bad6-300f-95fb-767f4e661d1f",
                                        "entry_id": "a7bbc6ac-a5e7-3651-aa5a-9eafda10a3bb",
                                        "glosses": [
                                            "Used to replace a word that might be considered unacceptable in a particular situation, when using a well-known phrase."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd1671dc-d3b2-49a0-a0e2-8867a51b4c6c",
                                                "sense_id": "53137e6d-bad6-300f-95fb-767f4e661d1f",
                                                "text": "I think we should be prepared in case the proverbial hits the fan."
                                            },
                                            {
                                                "example_id": "be2da191-bb3c-4048-8658-ca798265fbc1",
                                                "sense_id": "53137e6d-bad6-300f-95fb-767f4e661d1f",
                                                "text": "Are you taking the proverbial?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49457137-affa-3449-a1f8-83515c1b5998",
                                        "entry_id": "a7bbc6ac-a5e7-3651-aa5a-9eafda10a3bb",
                                        "glosses": [
                                            "The groin or the testicles."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "387fbfb0-57f0-4914-a6c1-94ceaf584c6f",
                                                "sense_id": "49457137-affa-3449-a1f8-83515c1b5998",
                                                "text": "You'll find they've got you by the proverbials."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
