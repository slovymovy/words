                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "379b7a2c-386d-4ad9-8ddf-0ad6abbc5a8a",
                        "entry_id": "b21b28f0-47b9-3ff7-acb9-977afabdb033",
                        "tags": [
                            "plural"
                        ],
                        "form": "intercessors"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "795d6a55-282f-3d0d-99c1-f75050d3e991",
                        "entry_id": "b21b28f0-47b9-3ff7-acb9-977afabdb033",
                        "glosses": [
                            "A person who intercedes; a mediator; one who reconciles enemies, or pleads for another."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fe0f28c4-6f14-3776-a377-bfaefda2469f",
                        "entry_id": "b21b28f0-47b9-3ff7-acb9-977afabdb033",
                        "glosses": [
                            "A person who intercedes; a mediator; one who reconciles enemies, or pleads for another.",
                            "Especially: a heavenly saint who intercedes (with God) on behalf of a mere mortal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dc80acb-3c4f-438f-bc7d-de8544345077",
                                "sense_id": "fe0f28c4-6f14-3776-a377-bfaefda2469f",
                                "text": "St Mary the Intercessor;   St Mary as intercessor"
                            }
                        ]
                    },
                    {
                        "sense_id": "c0782898-880b-3ae9-ab05-40e635d93356",
                        "entry_id": "b21b28f0-47b9-3ff7-acb9-977afabdb033",
                        "glosses": [
                            "A middleman, intermediary"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99bd561f-83e1-4c02-917e-af71312022e9",
                                "sense_id": "c0782898-880b-3ae9-ab05-40e635d93356",
                                "text": "Kings were revered, in many cases not merely as priests, that is, as intercessors between man and god, but as themselves gods"
                            }
                        ]
                    },
                    {
                        "sense_id": "d1910cc7-c9b6-307f-98cc-e5b97bcd07a6",
                        "entry_id": "b21b28f0-47b9-3ff7-acb9-977afabdb033",
                        "glosses": [
                            "A bishop who acts during a vacancy in a see."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6875bbb0-96fe-449c-84cb-9c8f382e0017",
                        "source_entry_id": "b21b28f0-47b9-3ff7-acb9-977afabdb033",
                        "source_sense_description": "one who intercedes",
                        "target_lang_word": "intercesseur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intercesseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
                                        "entry_id": "fa869e2e-daf0-3536-8720-972d8d567ed9",
                                        "glosses": [
                                            "Celui qui intercède."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c41da0e-d76d-43d5-b3f5-3f46f5e67592",
                                                "sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
                                                "text": "Selon lui, il n’y avait qu’un seul intercesseur pour renouer le contact avec Roger Fu-Seng : l’ambassade de Chine populaire à Paris."
                                            },
                                            {
                                                "example_id": "d3b50153-e53a-4cc1-91e4-b5a2b438e84e",
                                                "sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
                                                "text": "Une sorte de préalable nécessaire, bénéfique à l'écriture, de geste propitiatoire — le premier d'une série qui me fera plus tard retourner dans divers endroits — ou de prière, comme si le lieu pouvait être un obscur intercesseur entre la réalité passée et l'écriture."
                                            },
                                            {
                                                "example_id": "b2163a59-03b8-4e0f-b31c-1587e2b4985a",
                                                "sense_id": "760f04f2-cc98-3870-9c24-6238e4ded4e6",
                                                "text": "Il lui semblait s’offrir, comme aux intercesseurs d’un dieu inconnu, à ces paquebots énormes, hérissés, chargés de destinées, indifférents à lui jusqu’à la haine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intercesseur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20767dbc-29a5-3f81-9437-fac6e9b8950f",
                                        "entry_id": "67f04a9b-97dc-3b13-aeae-48f46a8ff04d",
                                        "glosses": [
                                            "Qui concerne l’intercession."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92eef939-bea3-42c1-be6e-3ea0f614f0b8",
                                                "sense_id": "20767dbc-29a5-3f81-9437-fac6e9b8950f",
                                                "text": "Quelques textes nous parlent d’un ange intercesseur qui vient au secours de l’homme pour le défendre devant le tribunal de Dieu et le soutenir contre les attaques de l'Adversaire […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "634aee75-2054-4186-a7fc-eb33cfd17ba1",
                        "source_entry_id": "b21b28f0-47b9-3ff7-acb9-977afabdb033",
                        "source_sense_description": "one who intercedes",
                        "target_lang_word": "intercessrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intercessrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9261da89-0b2c-3c2c-80a0-18e56826ea9e",
                                        "entry_id": "4c9d5ae7-d714-3e87-9ed2-7070be9e0c4a",
                                        "glosses": [
                                            "Femme qui intercède."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5f10f10-8dd6-4714-bdd9-b5211ee6505c",
                                                "sense_id": "9261da89-0b2c-3c2c-80a0-18e56826ea9e",
                                                "text": "Si ma santé est toujours meilleure, je ne doute point que je n’en sois redevable à vos vœux, et à ceux de M.ˡˡᵉ de Kerderf que je regarde comme mon intercessrice auprès du bon Dieu."
                                            },
                                            {
                                                "example_id": "5df4fd5e-2409-4331-ada3-4979b44ba903",
                                                "sense_id": "9261da89-0b2c-3c2c-80a0-18e56826ea9e",
                                                "text": "Comme on voyait sans cesse surgir le diable, on voyait sans cesse les anges descendre du ciel, pour secourir le chrétien aux abois ; et à la tête de ces légions célestes, l’intercessrice suprême : la Vierge."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "intercessrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9697d731-12b4-30d8-a659-ba016153d959",
                                        "entry_id": "8fa2330d-15ac-3067-9b2b-c58e95ebf5c5",
                                        "glosses": [
                                            "Féminin singulier de intercesseur."
                                        ],
                                        "tags": [
                                            "form-of",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "002e2bb9-c815-4abc-858e-5396e87793fc",
                                                "sense_id": "9697d731-12b4-30d8-a659-ba016153d959",
                                                "text": "La composition de celui-ci est aussi trop simple ; il y a trois plans sans intermédiaire, et la sainte intercessrice est à genoux sur une muraille qui ressemble assez à la margelle d’un puits."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "236be87f-e5e1-4c19-aa60-717c9cacaf55",
                        "source_entry_id": "b21b28f0-47b9-3ff7-acb9-977afabdb033",
