            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f450bc02-5d37-32f1-a417-c34420e22eb2",
                    "sense_definition": "Oiseau rapace diurne au vol rapide, aux ailes pointues et à la vue perçante, parfois dressé pour la chasse.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "oiseau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>faucon</w> survole la falaise avant de fondre rapidement sur sa proie."
                        },
                        {
                            "text": "Nous avons pu observer un <w>faucon</w> perché sur la branche d'un chêne."
                        }
                    ],
                    "common_phrases": [
                        "faucon pèlerin",
                        "chasse au faucon"
                    ]
                },
                {
                    "sense_id": "5c56e99a-fe44-3aa5-8dc4-8ad0d93bf110",
                    "sense_definition": "Partisan d'une ligne dure, belliqueuse ou intransigeante en matière de politique ou d'économie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les <w>faucons</w> du parti refusent tout compromis lors des négociations de paix."
                        },
                        {
                            "text": "En période de crise économique, les <w>faucons</w> réclament une rigueur budgétaire accrue."
                        }
                    ],
                    "antonyms": [
                        "colombe"
                    ]
                },
                {
                    "sense_id": "763797a6-680e-364d-885e-752ba3ccddbb",
                    "sense_definition": "Ancienne petite pièce d'artillerie légère en usage au Moyen Âge et à la Renaissance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "arme",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La muraille du château était défendue par un vieux <w>faucon</w> en fonte."
                        },
                        {
                            "text": "Les artilleurs chargeaient soigneusement chaque <w>faucon</w> avant l'assaut."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
