                        ],
                        "examples": [
                            {
                                "example_id": "de5334a7-1c14-4fed-b84b-37f0b80bc4bd",
                                "sense_id": "3f114a01-5ac4-3af9-87f8-aae2a172b7bd",
                                "text": "It was he who sparkplugged last year's Biennal of Modern Art, which was planned and carried out in less than nine months."
                            },
                            {
                                "example_id": "77038159-328a-41b4-afb8-ad837cd989b1",
                                "sense_id": "3f114a01-5ac4-3af9-87f8-aae2a172b7bd",
                                "text": "We are especially indebted to Jimmie Mackie for his interest and the organizational skill he displayed in sparkplugging the building of the Council houses, naming them Tyrie Gardens and planning the elaborate dedicatory program."
                            }
                        ]
