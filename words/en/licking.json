{
    "word_family": [
        "lick"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a08fd017-6fb5-3234-a067-77dadb460e7c",
                    "sense_definition": "The act of passing the tongue over a surface.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog gave the ice cream a quick <w>licking</w> before it melted.",
                            "target_lang_translations": {
                                "zh": "冰淇淋融化前，狗快速地<w>舔</w>了一下。"
                            }
                        },
                        {
                            "text": "A gentle <w>licking</w> from the mother cat calmed the newborn kitten.",
                            "target_lang_translations": {
                                "zh": "猫妈妈温柔的<w>舔</w>舐让刚出生的小猫安静了下来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "quick licking"
                    ],
                    "target_lang_definitions": {
                        "zh": "用舌头舔的动作"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "舔",
                                "target_lang_sense_clarification": "指用舌头接触物体表面的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "141a1e41-e2da-3bfc-a67f-2a1c793eff5e",
                    "sense_definition": "A severe physical beating or punishment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bully threatened him with a sound <w>licking</w> after school.",
                            "target_lang_translations": {
                                "zh": "那个恶霸威胁说放学后要<w>痛打</w>他一顿。"
                            }
                        },
                        {
                            "text": "He barely survived the <w>licking</w> he received from the gang.",
                            "target_lang_translations": {
                                "zh": "他差点没挺过那帮人对他的<w>痛打</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "beating",
                        "thrashing"
                    ],
                    "common_phrases": [
                        "sound licking"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "严厉的殴打或惩罚"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "痛打",
                                "target_lang_sense_clarification": "指严重的身体惩罚或殴打"
                            },
                            {
                                "target_lang_word": "教训",
                                "target_lang_sense_clarification": "指通过暴力手段给予的惩戒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cee1ca80-d6db-3496-89c1-5385cb3c58fd",
                    "sense_definition": "A crushing or significant defeat in a competition or game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "defeat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our football team took a <w>licking</w> last night against the league leaders.",
                            "target_lang_translations": {
                                "zh": "昨晚我们的足球队在对阵联赛领头羊时<w>惨败</w>。"
                            }
                        },
                        {
                            "text": "They suffered a terrible <w>licking</w> in the final match of the tournament.",
                            "target_lang_translations": {
                                "zh": "他们在锦标赛决赛中遭遇了<w>惨败</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defeat",
                        "thrashing"
                    ],
                    "antonyms": [
                        "victory"
                    ],
                    "common_phrases": [
                        "take a licking"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in sports reporting."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "在比赛或竞争中惨败"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "惨败",
                                "target_lang_sense_clarification": "指在比赛中遭受重大失败"
                            },
                            {
                                "target_lang_word": "大败",
                                "target_lang_sense_clarification": "指彻底的失败"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c77b279-937d-31e8-abad-3697c2e46b61",
                    "sense_definition": "Present participle and gerund of <w>lick</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The puppy is <w>licking</w> my hand because it is happy to see me.",
                            "target_lang_translations": {
                                "zh": "小狗因为见到我很高兴，正在<w>舔</w>我的手。"
                            }
                        },
                        {
                            "text": "She was <w>licking</w> the spoon after finishing the delicious chocolate cake.",
                            "target_lang_translations": {
                                "zh": "吃完美味的巧克力蛋糕后，她正在<w>舔</w>勺子。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb lick."
                        }
                    ],
                    "target_lang_definitions": {
