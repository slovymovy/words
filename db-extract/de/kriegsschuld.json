                ],
                "senses": [
                    {
                        "sense_id": "c05d22fb-acf5-387e-b3bc-b72a28c224a9",
                        "entry_id": "e38e1fdf-1556-31d9-a28b-cd07b0521258",
                        "glosses": [
                            "Schuld an einem Krieg, Verursachung eines Krieges"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58ff5cef-4272-4da0-a131-53d33674b560",
                                "sense_id": "c05d22fb-acf5-387e-b3bc-b72a28c224a9",
                                "text": "„Für heutige Leser ist das Bemerkenswerte an den Aufzeichnungen der »Anonyma« aber womöglich weniger die Schonungslosigkeit ihrer Schilderungen als ihr Unwille, die Täter angesichts der Kriegsschuld der Deutschen zu verurteilen.“"
                            },
                            {
                                "example_id": "68218c94-f5f5-48a6-9faf-c6db6d403b24",
                                "sense_id": "c05d22fb-acf5-387e-b3bc-b72a28c224a9",
                                "text": "„Die Frage der Kriegsschuld ist nicht nur eine Frage der Kriegsschuldigen, die Herrschenden sind verstrickt in das feinmaschige Netz der Interessen, Ehrbegriffe, Moralwerte der Gesellschaft.“"
                            },
                            {
                                "example_id": "dc10004a-7f41-4a12-8be2-cb4bad2c9cbb",
                                "sense_id": "c05d22fb-acf5-387e-b3bc-b72a28c224a9",
                                "text": "„Mit dem Versailler Vertrag nahm Deutschland die Kriegsschuld und hohe Reparationszahlungen auf sich und verzichtete auf alle Kolonien sowie umstrittene Territorien der Nachbarländer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
