                    {
                        "sense_id": "bed046be-6a16-3e42-8fa7-6349583f82af",
                        "entry_id": "5927159f-4bb1-386f-afbb-6df535998af3",
                        "glosses": [
                            "Gesamtheit miteinander verbundener Höhlen in einem bestimmten Gebiet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0b2fa0-2bb7-424b-92d8-1b43527ae49a",
                                "sense_id": "bed046be-6a16-3e42-8fa7-6349583f82af",
                                "text": "„›Die Beobachtungen aus dem Orbit haben gezeigt, dass die gesamte Region geologisch stabil ist. Kein Vulkanismus, keine Verwerfungslinien, keine Berge, kein weiches Gestein. Nichts weist auf ein ausgedehntes Höhlensystem hin.‹“"
                            },
                            {
                                "example_id": "523846d9-f5f5-4c55-bd28-92d1d809f46c",
                                "sense_id": "bed046be-6a16-3e42-8fa7-6349583f82af",
                                "text": "„Man hatte das Feuer eingestellt und war jetzt bestimmt schon dabei, die vom Steinschlag verschütteten Höhlensysteme zu versiegeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
