                "senses": [
                    {
                        "sense_id": "6c575e5a-7f51-3d82-a23e-fe569a9e2aca",
                        "entry_id": "d654be14-5207-3ffb-8b58-09abcf14fa28",
                        "glosses": [
                            "Kirchdiener"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b26560ce-70d5-4d79-b17b-251b970dd746",
                                "sense_id": "6c575e5a-7f51-3d82-a23e-fe569a9e2aca",
                                "text": "„Der Beklagte war zehn Jahre lang Mesner in der Pfarre Ober St. Veit und ging am 31. 12. 1979 in Pension.“"
                            },
                            {
                                "example_id": "9701a06f-aa14-43f3-a9ac-e2d1fcc1f8d5",
                                "sense_id": "6c575e5a-7f51-3d82-a23e-fe569a9e2aca",
                                "text": "„Als die Stelle des Mesners in der Pfarrei St. Vitus in Au ausgeschrieben wurde, ließ sich erst über einen längerer Zeitraum kein passender Bewerber finden - bis Melanie Geppert sich meldete.“"
                            },
                            {
                                "example_id": "a2b9a5e5-f224-4de4-bcc7-aaff4333ca95",
                                "sense_id": "6c575e5a-7f51-3d82-a23e-fe569a9e2aca",
                                "text": "„Dank einem beherzten Organisten, Mesner und Lehrer aus Elbach wurde die Barockkrippe 1803, als der damalige bayrische Innenminister Graf Montgelas in Bayern alle Krippen in Kirchen verbot, gerettet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a3bf024-e748-4368-a693-f8ca1f293fe3",
                        "source_entry_id": "d654be14-5207-3ffb-8b58-09abcf14fa28",
                        "source_sense_id": "6c575e5a-7f51-3d82-a23e-fe569a9e2aca",
                        "source_sense_description": "Kirchdiener",
                        "target_lang_word": "sacristan",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sacristan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                        "entry_id": "e130134f-83ea-3a2f-94b6-aaad8e741b46",
                                        "glosses": [
                                            "The person who maintains the sacristy and the sacred objects it contains."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba3b748-f30d-4314-8543-b571936bdd5c",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "And hence the custom and law began\nThat still at dawn the sacristan,\nWho duly pulls the heavy bell,\nFive and forty beads must tell\nBetween each stroke"
                                            },
                                            {
                                                "example_id": "ee79d4c1-e753-4ebb-ab50-872274645435",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "[…] every evening as the temple was closed for the night the sacristan paused: \"Pindar to supper with the god!\" he cried."
                                            },
                                            {
                                                "example_id": "63c00b8f-1559-43f4-8031-d2fa1aecfb87",
                                                "sense_id": "67435c05-7a38-3b92-9738-de0671f93e37",
                                                "text": "The church was looked after by an old sacristan who lived in a cottage on the shore of the lake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e070fb6-f15a-45de-a489-c478805039d3",
                        "source_entry_id": "d654be14-5207-3ffb-8b58-09abcf14fa28",
                        "source_sense_id": "6c575e5a-7f51-3d82-a23e-fe569a9e2aca",
                        "source_sense_description": "Kirchdiener",
                        "target_lang_word": "sexton",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexton",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "edee7dc4-406f-3bd8-9e03-90aee60ef572",
                                        "entry_id": "a07e299a-fae0-3d71-b8e5-97c82ff46ba4",
                                        "glosses": [
                                            "A church official who looks after a church building and its graveyard and may act as a gravedigger and bell ringer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b76fd5-baef-43a4-9f88-06e4b4581395",
                                                "sense_id": "edee7dc4-406f-3bd8-9e03-90aee60ef572",
                                                "text": "on that same night, Mr Haredale, having strongly bound his prisoner, with the assistance of the sexton, and forced him to mount his horse, conducted him to Chigwell"
                                            },
                                            {
                                                "example_id": "8bb2f64c-97ba-4492-a95c-506049c9df53",
                                                "sense_id": "edee7dc4-406f-3bd8-9e03-90aee60ef572",
                                                "text": "We stopped in the road and watched the sexton shovelling in the new earth. A peasant with a black beard and high leather boots stood beside the grave. The sexton stopped shovelling and straightened his back. The peasant in the high boots took the spade from the sexton and went on filling in the grave"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eadbdb5-61b9-3a39-9ed8-089e04ad9fb8",
                                        "entry_id": "a07e299a-fae0-3d71-b8e5-97c82ff46ba4",
                                        "glosses": [
                                            "A sexton beetle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ab3f641-7b92-429f-9c1b-5653ae737dc8",
                        "source_entry_id": "d654be14-5207-3ffb-8b58-09abcf14fa28",
                        "source_sense_id": "6c575e5a-7f51-3d82-a23e-fe569a9e2aca",
                        "source_sense_description": "Kirchdiener",
                        "target_lang_word": "verger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3deb8d5-460a-37a5-a772-4fa59a0be5e9",
                                        "entry_id": "869cc824-32c9-3b41-8121-0659cc838979",
                                        "glosses": [
                                            "One who carries a verge, or emblem of office."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "79e21410-dd9d-3f03-b51f-c2cb790822d5",
                                        "entry_id": "869cc824-32c9-3b41-8121-0659cc838979",
                                        "glosses": [
                                            "A lay person who takes care of the interior of a church and acts as an attendant during services, where he or she carries the verge (or virge). In the United States, the office is generally combined with that of sexton."
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd148c34-3afa-4315-ab8b-6b377c7e4609",
                                                "sense_id": "79e21410-dd9d-3f03-b51f-c2cb790822d5",
                                                "text": "\"We have often seen each other,\" said Little Dorrit, recognising the sexton, or the beadle, or the verger, or whatever he was, \"when I have been at church here.\""
                                            },
                                            {
                                                "example_id": "c4371c8f-8a0b-4e04-8b5f-0b94179176f7",
                                                "sense_id": "79e21410-dd9d-3f03-b51f-c2cb790822d5",
                                                "text": "As soon as we were all in the night the verger rolled shut the doors and blotted out the chandeliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1837e9e-2d65-3afe-8854-700de9990b2c",
                                        "entry_id": "869cc824-32c9-3b41-8121-0659cc838979",
                                        "glosses": [
                                            "An usher; also, in major ecclesiastical landmarks, a tour guide."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "813e8217-0197-3bff-ab00-e79c98f4fe88",
                                        "entry_id": "869cc824-32c9-3b41-8121-0659cc838979",
                                        "glosses": [
                                            "An attendant upon a dignitary, such as a bishop or dean, a justice, etc."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9e3aeb-2eaf-44f4-8c61-04a599c82a47",
                                                "sense_id": "813e8217-0197-3bff-ab00-e79c98f4fe88",
                                                "text": "When she came to her place she opened the book, and perused it, and saw the pictures, but frowned and blushed; and then shut it, (of which several took notice,) and calling the verger, bade him bring her the old book, wherein she was formerly wont to read."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
