                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "implicate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ea50a88b-50d5-3ffd-a38d-2d8ccec1e415",
                                        "entry_id": "6bf101fd-3f79-34df-8579-8335deb3405f",
                                        "glosses": [
                                            "To show to be connected or involved in an unfavorable or criminal way."
                                        ],
                                        "tags": [
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584d7eff-89f0-4015-9007-505269ae100f",
                                                "sense_id": "ea50a88b-50d5-3ffd-a38d-2d8ccec1e415",
                                                "text": "The evidence implicates involvement of top management in the scheme."
                                            },
                                            {
                                                "example_id": "e9d8e753-333e-4fcf-bd82-73d5b65b0ef8",
                                                "sense_id": "ea50a88b-50d5-3ffd-a38d-2d8ccec1e415",
                                                "text": "But it is of no use talking now; the servants will soon be stirring, and it would be rather awkward to be found here.\" \"For you, perhaps, madam,\" sneered Sir George. \"Rather for yourself,\" replied she, with the greatest composure; \"you might be implicated in the charge of murder.\""
                                            },
                                            {
                                                "example_id": "e2734886-5533-49b1-9dae-8ff06529e4c1",
                                                "sense_id": "ea50a88b-50d5-3ffd-a38d-2d8ccec1e415",
                                                "text": "I shall cancel, without further provocation, the next lecture engagement that is implicated with a peep o' day train."
                                            },
                                            {
                                                "example_id": "e74095b8-9dcc-4c90-afab-9558abe1375b",
                                                "sense_id": "ea50a88b-50d5-3ffd-a38d-2d8ccec1e415",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00a40039-8a77-3c31-8bbf-76abfa7d1bdb",
                                        "entry_id": "6bf101fd-3f79-34df-8579-8335deb3405f",
                                        "glosses": [
                                            "To imply, to have as a necessary consequence or accompaniment."
                                        ],
                                        "tags": [
                                            "nonstandard",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07351b45-aa25-4644-adaa-1ef20beaa367",
                                                "sense_id": "00a40039-8a77-3c31-8bbf-76abfa7d1bdb",
                                                "text": "What did Nixon's visit to China implicate for Russia?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6405836-cb36-3665-b12a-f32604f0e955",
                                        "entry_id": "6bf101fd-3f79-34df-8579-8335deb3405f",
