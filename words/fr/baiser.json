                {
                    "sense_id": "29e976d8-6c19-3586-9ace-d780d7f300bd",
                    "sense_definition": "Poser ses lèvres sur quelqu'un ou quelque chose en signe d'affection ou de respect ; ce sens n'est plus guère utilisé que dans quelques expressions comme « baiser la main ».",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "baiser (geste d'affection)",
                    "name_type": "no",
                    "examples": [
