    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "fff7bc38-2e82-37be-babe-0fa48eef4597",
                    "sense_definition": "Submerger un terrain ou un lieu par une crue ou un débordement d'eau.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La rivière en crue a fini par <w>inonder</w> toutes les caves du quartier."
                        },
                        {
                            "text": "Les fortes pluies d'hier risquent d'<w>inonder</w> la route principale ce matin."
                        }
                    ],
                    "synonyms": [
                        "noyer"
                    ],
                    "common_phrases": [
                        "inonder la ville",
                        "inonder les caves"
                    ]
                },
                {
                    "sense_id": "7e3be179-055a-3219-9b31-d93fad6db3e7",
                    "sense_definition": "Remplir complètement un espace ou pénétrer intensément, en parlant de la lumière ou d'un sentiment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil du matin <w>inonde</w> la chambre d'une douce clarté dorée."
                        },
                        {
                            "text": "Elle s'est sentie soudainement <w>inondée</w> de joie en apprenant la bonne nouvelle."
                        }
                    ],
                    "common_phrases": [
                        "inonder de lumière",
                        "inondé de joie"
                    ]
                },
                {
                    "sense_id": "dfe739f0-9635-3fb2-8206-23b56e1d88b8",
                    "sense_definition": "Apparaître ou être diffusé avec une abondance extrême jusqu'à tout saturer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise cherche à <w>inonder</w> le marché de produits à bas coût."
                        },
                        {
                            "text": "De faux messages <w>inondent</w> les boîtes de réception depuis plusieurs jours."
                        }
                    ],
                    "common_phrases": [
                        "inonder le marché",
                        "inonder les réseaux"
                    ]
                },
                {
                    "sense_id": "39951158-9313-3715-90af-a61ef5be6006",
                    "sense_definition": "Mouiller très abondamment en couvrant d'un liquide, de larmes ou de sueur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "D'épaisses larmes <w>inondaient</w> son visage pendant qu'il racontait son histoire."
                        },
                        {
                            "text": "L'orage soudain est venu <w>inonder</w> nos tentes installées au bord du lac."
                        }
                    ],
                    "common_phrases": [
                        "inonder de larmes",
                        "inonder de sueur"
                    ]
                },
                {
                    "sense_id": "6f65be04-96f9-312b-81ac-6a64dd8ee584",
                    "sense_definition": "Occuper un lieu en très grand nombre, en parlant d'une multitude ou de troupes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "diffusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des milliers de touristes <w>inondent</w> les rues historiques de la capitale chaque été."
                        },
                        {
                            "text": "Une foule enthousiaste est venue <w>inonder</w> la place après le coup de sifflet final."
                        }
                    ],
                    "common_phrases": [
                        "inonder les rues"
                    ]
                },
                {
                    "sense_id": "542c426a-cbd3-3d39-b511-6183559589b5",
                    "sense_definition": "Mettre volontairement sous les eaux un terrain, en particulier à des fins agricoles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "eau",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les agriculteurs <w>inondent</w> les rizières peu après la plantation des jeunes pousses."
                        },
                        {
                            "text": "Il faut régulièrement <w>inonder</w> ces parcelles pour favoriser le développement des cultures."
                        }
                    ],
                    "synonyms": [
                        "ennoyer"
                    ],
                    "common_phrases": [
                        "inonder les rizières"
                    ]
                }
            ]
        }
    ]
}