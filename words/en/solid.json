                {
                    "sense_id": "83afd246-ed21-3db8-bcc3-5cb847d16c89",
                    "sense_definition": "Continuous and not broken by gaps, dots, or dashes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "visual_line",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not cross the <w>solid</w> line on the highway.",
                            "target_lang_translations": {
                                "ru": "Не следует пересекать <w>сплошную</w> линию на шоссе.",
                                "tr": "Otoyoldaki <w>düz</w> çizgiyi geçmemelisiniz."
                            }
                        },
                        {
                            "text": "The graph shows a <w>solid</w> line for actual sales and a dotted line for projections.",
                            "target_lang_translations": {
                                "ru": "На графике <w>сплошная</w> линия обозначает фактические продажи, а пунктирная — прогнозы.",
                                "tr": "Grafik, gerçekleşen satışlar için <w>düz</w> bir çizgi, tahminler için ise noktalı bir çizgi gösteriyor."
                            }
