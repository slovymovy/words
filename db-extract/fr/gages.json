                                                "sense_id": "c079f61d-478a-3ccc-a5bd-d273fd17e6f2",
                                                "text": "Und was war der Lohn für all seine Mühe?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
