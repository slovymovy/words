                ],
                "senses": [
                    {
                        "sense_id": "d2c86e52-be28-335a-9fc4-15cb7f20f62f",
                        "entry_id": "0ef12067-1736-3de6-8581-02ec25b50723",
                        "glosses": [
                            "bestimmte Zeit im Jahr, in der sich die Aussaat am meisten lohnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68a416fb-9482-4664-b1c2-a2f6a6cc7e23",
                                "sense_id": "d2c86e52-be28-335a-9fc4-15cb7f20f62f",
                                "text": "„Die in einer vierjährigen Versuchszeit gewonnenen Resultate beweisen, dass bei etwas verspäteter Saatzeit die Körner reicher an Stickstoff werden.“"
                            },
                            {
                                "example_id": "f0614697-a642-41f9-8909-01b907ebbd44",
                                "sense_id": "d2c86e52-be28-335a-9fc4-15cb7f20f62f",
                                "text": "„Es ist nicht genügend, den Acker rechtzeitig vorzubereiten, sondern die Saatzeit muß auch die rechte sein.“"
                            },
                            {
                                "example_id": "e700b60c-7ece-4453-89f0-19074fbe5847",
                                "sense_id": "d2c86e52-be28-335a-9fc4-15cb7f20f62f",
                                "text": "„Wir unterscheiden in der Landwirtschaft zwei Saatzeiten, und zwar für die Frühjahrssaat und Herbstsaat.“"
                            },
                            {
                                "example_id": "f27aeff5-1369-400a-b243-837922b1857f",
                                "sense_id": "d2c86e52-be28-335a-9fc4-15cb7f20f62f",
                                "text": "„Die Productionsfähigkeit der Rübenpflanze ist in außerordentlichem Grade von der Saatzeit abhängig.“"
                            },
                            {
                                "example_id": "7d768a59-e20d-4794-b504-9acb81eed8b6",
                                "sense_id": "d2c86e52-be28-335a-9fc4-15cb7f20f62f",
                                "text": "„Aber die Saatzeit kam, sie mussten pflanzen, obwohl auf den Feldern salziges Meerwasser stand.“"
                            },
                            {
                                "example_id": "b3bfb063-469f-4a0c-b837-ed7d8fef3ca4",
                                "sense_id": "d2c86e52-be28-335a-9fc4-15cb7f20f62f",
                                "text": "„Wenn auch die Erträge der Sorten in den zwei ersten Saatzeiten verhältnismäßig nah zueinander liegen, so bewirken die späteren Aussaaten schon einen erheblichen Leistungsabfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
