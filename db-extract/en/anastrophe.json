                                        "sense_id": "c4956df1-4395-33d9-a116-2580cb6044b2",
                                        "entry_id": "2ac645c4-9a34-3f77-bea7-5f12830069a9",
                                        "glosses": [
                                            "Umkehr, Umkehrung einer Sache"
