                            {
                                "example_id": "e8c28e6c-c621-4f85-9e12-0ad03cf1932c",
                                "sense_id": "56a22ad6-e463-39fe-8204-b1c2a6f2bed3",
                                "text": "„Dosenhockey ist so ähnlich wie normales Hockey, nur dass eine plattgedrückte Bierdose als Puck dient, man statt des Hockeyschlägers die Beine benutzt und Kreidemarkierungen auf der Straße als Tor dienen.“"
                            },
                            {
                                "example_id": "b41585e8-1bc1-4529-a80b-b8537a06f7ce",
                                "sense_id": "56a22ad6-e463-39fe-8204-b1c2a6f2bed3",
                                "text": "„Der Regen wischt die Kreidemarkierung zwar irgendwann weg. Dafür braucht es aber schon mehr als nur einen einzigen Schauer.“"
                            }
                        ],
