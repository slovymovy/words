                                        "sense_id": "0d0bf9c6-342f-3719-911d-764fc0f9ec3a",
                                        "entry_id": "8b3d1ac9-6a58-3d1c-9b8f-264ef341ae96",
                                        "glosses": [
                                            "vlastnost slovních jednotek, které mají více než jeden význam"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a535cf74-1e0e-40ea-aaf5-440a93994f77",
                                                "sense_id": "0d0bf9c6-342f-3719-911d-764fc0f9ec3a",
                                                "text": "Jako příklad polysémie v češtině můžeme uvést slova - vlna, raketa, koruna."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
