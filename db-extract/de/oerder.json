                ],
                "senses": [
                    {
                        "sense_id": "f599e5b9-7f67-3881-b21c-b0097cf74a7b",
                        "entry_id": "ba25731d-f97d-3b1c-8352-da7fbde8da88",
                        "glosses": [
                            "westfälischer Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c75b7d-6039-45c9-ae1d-8ef9c48247d9",
                                "sense_id": "f599e5b9-7f67-3881-b21c-b0097cf74a7b",
                                "text": "Frau Oerder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a23de305-bf97-4dfe-974b-38718c5bdbf9",
                                "sense_id": "f599e5b9-7f67-3881-b21c-b0097cf74a7b",
                                "text": "Herr Oerder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "069edd49-3f5c-44c1-9fc0-ec943913bb31",
                                "sense_id": "f599e5b9-7f67-3881-b21c-b0097cf74a7b",
                                "text": "Die Oerders kommen heute aus dem Rheinland."
                            },
                            {
                                "example_id": "7b19d202-184f-45cb-bf17-1a6b5cb55648",
                                "sense_id": "f599e5b9-7f67-3881-b21c-b0097cf74a7b",
                                "text": "Der Oerder trägt nie die Schals, die die Oerder ihm strickt."
                            },
                            {
                                "example_id": "60c02471-91a3-4f72-b3f8-b51a6507c73a",
                                "sense_id": "f599e5b9-7f67-3881-b21c-b0097cf74a7b",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Oerder kommt, geht der Herr Oerder.“"
                            },
                            {
                                "example_id": "22de3d7d-d834-447f-b1d0-11d8a02c48ce",
                                "sense_id": "f599e5b9-7f67-3881-b21c-b0097cf74a7b",
                                "text": "Oerder kommt und geht."
                            },
                            {
                                "example_id": "3b7bcd46-da20-4768-bfef-ef9118e33454",
                                "sense_id": "f599e5b9-7f67-3881-b21c-b0097cf74a7b",
                                "text": "Oerders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
