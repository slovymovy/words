                                    {
                                        "sense_id": "9db44260-1019-3b9e-b790-98e3d1ba0790",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To cover or coat something with plaster; to render."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12e3ef6c-0105-4e7f-bfa2-6c6f5d837b23",
                                                "sense_id": "9db44260-1019-3b9e-b790-98e3d1ba0790",
                                                "text": "to plaster a wall"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e561d5-0a96-3bb0-865e-724f9ad11b66",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To apply a plaster to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f5b07d2-eaba-407f-bb81-77736c334fcf",
                                                "sense_id": "27e561d5-0a96-3bb0-865e-724f9ad11b66",
                                                "text": "to plaster a wound"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c837875-36ee-3ac8-9998-1ac436c4cc0d",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To smear with some viscous or liquid substance."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3da1f06-6274-4c42-9ffe-b0d73f751103",
                                                "sense_id": "7c837875-36ee-3ac8-9998-1ac436c4cc0d",
                                                "text": "Her face was plastered with mud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To hide or cover up, as if with plaster; to cover thickly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a252be6-f015-40af-8377-a62bdf63e8cf",
                                                "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                                                "text": "The radio station plastered the buses and trains with its advertisement."
                                            },
                                            {
                                                "example_id": "e37beb15-6bd4-4be6-a772-94f65377c1cc",
                                                "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                                                "text": "If Euston is not typically English, St. Pancras is. Its façade is a nightmare of improbable Gothic. It is fairly plastered with the aesthetic ideals of 1868, and the only beautiful thing about it is Barlow's roof. It is haunted by the stuffier kind of ghost. Yet there is something about the ordered whole of St. Pancras that would make demolition a terrible pity."
                                            },
                                            {
                                                "example_id": "0f2440b4-0991-4cfe-b4a4-e843a89f36a8",
                                                "sense_id": "ed2b5eba-cf47-35d1-87ae-f6de7755307b",
                                                "text": "Lillian walked the halls wearing a shirt plastered with what she assured everyone was a memetic stun agent; it looked just like the kill agent gating access to the SCP-001 database file, but as she patiently explained to McInnis, in art, context is everything."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d1d99cc-40f8-3ea6-9042-365360f5ff5c",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To bombard heavily or overwhelmingly; to overwhelm (with weapons fire)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfed0820-73a8-4418-b195-cd116a110347",
                                                "sense_id": "2d1d99cc-40f8-3ea6-9042-365360f5ff5c",
                                                "text": "Yeah, if you think that was bad... having, obviously, here, being people in the modern day and knowing something about the historical tactics used at the Battle of Samar, we did have, at one point, the American battleline sailing itself into a rain squall, staying in the rain squall, using large numbers of destroyers (with, obviously, all their smoke generators) to increase the cover in the rain squall and maintain it when the wet squall seemed to start dying off, and, through that, they just went \"Right, activate radar, hello everybody, we can see you, you can't see us\", and plastered everything in 14-and-16-inch gunfire until everything was broken, burning, and not able to fire back, and then they popped out for the coup de grâce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b79b83a-f531-35de-82a7-ca6e4e56b838",
                                        "entry_id": "a2d934ff-0178-36aa-b202-df5cce591573",
                                        "glosses": [
                                            "To smooth over."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
