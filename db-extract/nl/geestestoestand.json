                "senses": [
                    {
                        "sense_id": "f3fa829e-8cc1-3c78-bb8d-f5f97ca15484",
                        "entry_id": "b445b431-fd7d-37cc-b8e3-4488a25bf348",
                        "glosses": [
                            "psychische situatie van een persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac07eabd-6f4e-41a0-a911-a91f784b4b5e",
                                "sense_id": "f3fa829e-8cc1-3c78-bb8d-f5f97ca15484",
                                "text": "Toch is Kwaadschiks een heel ander boek dan Joyce’s meesterwerk, waarin zo ongeveer de hele Europese cultuur wordt samengevat. Van der Heijden presenteert veeleer het gedetailleerde portret van een ‘psychopaat’ (zoals Dorlas door sommigen wordt genoemd). Ook ontbreken de formele experimenten die van Ulysses zoiets unieks maken. Het enige formele experiment waaraan Van der Heijden zich waagt betreft het in extenso weergeven van alle wisselingen en modulaties in de door wodka, cocaïne en zelfs aftershave benevelde geestestoestand van zijn hoofdpersoon, terwijl deze zich uit het veilige ‘binnen’ in het gevaarlijke ‘buiten’ waagt waar zijn onbesuisde daden onherstelbare gevolgen hebben. De roman is een minutieuze casestudy van destructie en zelfdestructie."
                            },
                            {
                                "example_id": "3403ea1a-ff31-40ee-a6a6-a1c6c44725d1",
                                "sense_id": "f3fa829e-8cc1-3c78-bb8d-f5f97ca15484",
                                "text": "In oktober 2019 had de Brusselse strafuitvoeringsrechtbank (SURB) op vraag van Dutrouxs advocaat drie expert-psychiaters aangesteld om zijn geestestoestand te beoordelen in de aanloop naar een eventuele vraag tot voorwaardelijke vrijlating. Ook het parket was voorstander van een psychiatrisch onderzoek."
                            },
                            {
                                "example_id": "dc3b20e9-9a72-45c6-9a74-6efc31ad402d",
                                "sense_id": "f3fa829e-8cc1-3c78-bb8d-f5f97ca15484",
                                "text": "Geestelijke aftakeling, mentale verwarring, dementie, het wemelt ervan in de literatuur. Niet verwonderlijk. Waar de geestestoestand vertroebeld raakt, krijgt de verbeelding de vrije teugel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bad76b5a-d0b6-4111-a14b-b29716d0691b",
                        "source_entry_id": "b445b431-fd7d-37cc-b8e3-4488a25bf348",
                        "source_sense_id": "f3fa829e-8cc1-3c78-bb8d-f5f97ca15484",
                        "source_sense_description": "de aard van de psyche van iemand",
                        "target_lang_word": "state of mind",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "state of mind",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d88b7d05-9987-35cc-a3af-e6cbc2aaa1db",
                                        "entry_id": "a21c5658-8121-3e3f-b26b-8bce6477fedf",
                                        "glosses": [
                                            "The psychological state of someone's cognitive processes at a certain time; the condition or character of a person's thoughts or feelings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e8494d-fc7f-47e0-8a1c-99a903a90891",
                                                "sense_id": "d88b7d05-9987-35cc-a3af-e6cbc2aaa1db",
                                                "text": "Near-synonym: headspace"
                                            },
                                            {
                                                "example_id": "ecd105b5-6a09-4430-92cc-b02da0e4e461",
                                                "sense_id": "d88b7d05-9987-35cc-a3af-e6cbc2aaa1db",
                                                "text": "I know what I'm needing / And I don't want to waste more time / I'm in a New York state of mind"
                                            },
                                            {
                                                "example_id": "0339c59f-6169-4b6a-b0c9-27b37be31d9a",
                                                "sense_id": "d88b7d05-9987-35cc-a3af-e6cbc2aaa1db",
                                                "text": "Well, I've committed a funky crime / against a state of mind"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dee5437-5403-48ec-a23b-c0693867e57d",
                        "source_entry_id": "b445b431-fd7d-37cc-b8e3-4488a25bf348",
                        "source_sense_id": "f3fa829e-8cc1-3c78-bb8d-f5f97ca15484",
                        "source_sense_description": "de aard van de psyche van iemand",
                        "target_lang_word": "mood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "36bf8745-b73a-357a-9b69-d08ba7c1e133",
                                        "entry_id": "4e7129cd-03fb-3262-ba62-18df935ff172",
                                        "glosses": [
                                            "A mental or emotional state, composure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "829790cf-c705-41e7-8256-76d6d337b0cb",
                                                "sense_id": "36bf8745-b73a-357a-9b69-d08ba7c1e133",
                                                "text": "I've been in a bad mood since I was dumped by my ex-boyfriend."
                                            },
                                            {
                                                "example_id": "3088b951-fbcc-4924-80ac-72b2f7560060",
                                                "sense_id": "36bf8745-b73a-357a-9b69-d08ba7c1e133",
                                                "text": "I envy not in any moods\n⁠The captive void of noble rage,\n⁠The linnet born within the cage,\nThat never knew the summer woods: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "770e2e42-2d28-320e-ac17-9cd66163ad40",
                                        "entry_id": "4e7129cd-03fb-3262-ba62-18df935ff172",
                                        "glosses": [
                                            "Emotional character (of a work of music, literature, or other art)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b00a52-acd1-494a-a2de-efe28ad11a20",
                                                "sense_id": "770e2e42-2d28-320e-ac17-9cd66163ad40",
                                                "text": "Whatever the mood of her music, funky or romantic, upbeat or blue, sophisticated or simple, her fans get the message. And as long as the word comes from Natalie, they adore it, turning every one of her albums to gold or platinum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8b448d6-23e0-321e-99cc-6d40e8e2d7d5",
                                        "entry_id": "4e7129cd-03fb-3262-ba62-18df935ff172",
                                        "glosses": [
                                            "A sullen, gloomy or angry mental state; a bad mood."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a008271-b3e6-4266-82ee-9422edb248ef",
                                                "sense_id": "b8b448d6-23e0-321e-99cc-6d40e8e2d7d5",
                                                "text": "He's in a mood with me today."
                                            },
                                            {
                                                "example_id": "63cf409a-7ef3-4a64-ac6b-80941e02ff84",
                                                "sense_id": "b8b448d6-23e0-321e-99cc-6d40e8e2d7d5",
                                                "text": "Rath was clearly in a mood, and only Jay could fix that. They found Carver first. Rath was even less amused to see Carver in the drill room than he had been to find Duster. He grabbed Carver with his free hand, and dragged him out."
                                            },
                                            {
                                                "example_id": "3fa2986d-6fbc-4c88-babe-5032630f87c5",
                                                "sense_id": "b8b448d6-23e0-321e-99cc-6d40e8e2d7d5",
                                                "text": "Joel was obviously in a mood, and if he was going to start yelling, Alex would rather be alone. “What did I do this time?” “It's more what you didn't do, idiot.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebe2bdab-ea39-3060-9594-120e301945c1",
                                        "entry_id": "4e7129cd-03fb-3262-ba62-18df935ff172",
                                        "glosses": [
                                            "A disposition to do something, a state of mind receptive or disposed to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "151f5c29-0e08-4d4a-85b3-266a7440fe3c",
                                                "sense_id": "ebe2bdab-ea39-3060-9594-120e301945c1",
                                                "text": "I'm not in the mood for running today."
                                            },
                                            {
                                                "example_id": "6ff18835-07fd-4ed9-99fa-cd548f419859",
                                                "sense_id": "ebe2bdab-ea39-3060-9594-120e301945c1",
                                                "text": "Paul: Shield practice? Gurney, we had shield practice this morning. I'm not in the mood.\nGurney: Not in the mood? Mood's a thing for cattle and loveplay, not fighting."
                                            },
                                            {
                                                "example_id": "d4fa9f3d-11e0-4f52-8e37-b40e3979990d",
                                                "sense_id": "ebe2bdab-ea39-3060-9594-120e301945c1",
                                                "text": "\"The Placer SPCA brings by some kittens and puppies, and I do my best to get everyone tipsy and in a donating mood.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "654834cd-af70-3af8-ad38-853af1d76372",
                                        "entry_id": "4e7129cd-03fb-3262-ba62-18df935ff172",
                                        "glosses": [
                                            "A prevalent atmosphere, attitude, or feeling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d48e5ef-e0ea-4110-aa8c-929e5764c4d1",
                                                "sense_id": "654834cd-af70-3af8-ad38-853af1d76372",
                                                "text": "A good politician senses the mood of the crowd."
                                            },
                                            {
                                                "example_id": "c329b241-5654-4da4-80fe-5f988a60575e",
                                                "sense_id": "654834cd-af70-3af8-ad38-853af1d76372",
                                                "text": "This was the mood that led him to deny to Mainstream, the successor to the New Masses , permission to reprint “Reading, Writing, and the Rackets.” This was the mood that, when he was invited to a meeting to draft a letter of protest […]"
                                            },
                                            {
                                                "example_id": "2329807a-1f4e-4b33-a50d-1fceb90a9842",
                                                "sense_id": "654834cd-af70-3af8-ad38-853af1d76372",
                                                "text": "By the early 1970s, more than 50,000 American deaths and the accompanying failed foreign-policy objectives had changed the country's mood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ef6e9bc-666c-3283-be2a-e3f1458deac2",
                                        "entry_id": "4e7129cd-03fb-3262-ba62-18df935ff172",
                                        "glosses": [
                                            "A familiar, relatable feeling, experience, or thing."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa605d5f-4a29-439c-859f-350ff599bf13",
                                                "sense_id": "7ef6e9bc-666c-3283-be2a-e3f1458deac2",
                                                "text": "“I'm only here for a night. I'm road tripping with a friend and he decided we needed a queer bar, stat.” “Oh, that's a whole mood.”"
                                            },
                                            {
                                                "example_id": "97eda3f5-e522-4a8d-acc6-fce39b4a0126",
                                                "sense_id": "7ef6e9bc-666c-3283-be2a-e3f1458deac2",
                                                "text": "To borrow an idiom from the extremely online, late Godard is a mood."
                                            },
                                            {
                                                "example_id": "d6d1aa41-e135-4669-bc40-67dddd580865",
                                                "sense_id": "7ef6e9bc-666c-3283-be2a-e3f1458deac2",
                                                "text": "[…] For academics, not being familiar with new phrases that your students cofindently wield is a whole mood. […]"
                                            },
                                            {
                                                "example_id": "79125ee2-e2ec-458f-87dc-8b554b27feea",
                                                "sense_id": "7ef6e9bc-666c-3283-be2a-e3f1458deac2",
                                                "text": "He'd drawn a variety of designs on the white rubber toes. “Nice shoes,” I said. “Likewise,” he said, glancing down at my rockabilly-red peep toe pumps. “Those kicks are a whole-ass mood.” Whether Steven liked them on me or might like to […]"
                                            },
                                            {
                                                "example_id": "4dff1204-6399-4355-a0b0-0431dafe6650",
                                                "sense_id": "7ef6e9bc-666c-3283-be2a-e3f1458deac2",
                                                "text": "I think I can speak for us all when I say this tee is a MOOD. So yeah, anyways, I'm gonna need 10 of these—TYVM."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f70df70b-a860-383b-bfb1-f37ab3a05944",
                                        "entry_id": "b3fe74b9-362a-343a-81fc-4a288578b8b6",
                                        "glosses": [
                                            "Used to express that the speaker finds something very relatable."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b96feadb-cf21-4047-832f-f33fcaa43827",
                                                "sense_id": "f70df70b-a860-383b-bfb1-f37ab3a05944",
                                                "text": "⁠—I am feeling very exhausted today. ⁠—Mood."
                                            },
                                            {
                                                "example_id": "2fb07fab-6a28-45cf-ba6c-8869d8226845",
                                                "sense_id": "f70df70b-a860-383b-bfb1-f37ab3a05944",
                                                "text": "I mean, mood. Courteney Cox showing Kimmel her completely empty pantry over Zoom while explaining that her family is snacking more than usual is relatable content."
                                            },
                                            {
                                                "example_id": "a2201037-6f2d-4324-9f30-e6c9ac518896",
                                                "sense_id": "f70df70b-a860-383b-bfb1-f37ab3a05944",
                                                "text": "Joon posted a video with a stray cat with the caption 'V's tweet was like #mood'."
                                            },
                                            {
                                                "example_id": "6ada85f1-4d8e-4ce0-9968-a67640072549",
                                                "sense_id": "f70df70b-a860-383b-bfb1-f37ab3a05944",
                                                "text": "You can't just say Mood and post random unrelated shit!"
                                            },
                                            {
                                                "example_id": "8733563a-6947-45b6-883c-8909b2c42d83",
                                                "sense_id": "f70df70b-a860-383b-bfb1-f37ab3a05944",
                                                "text": "I mean…MOOD!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b593abdb-d3e6-3b9d-8cf4-553df05ee842",
                                        "entry_id": "ad9060e8-4dd2-3db3-9fb3-e4d9469103e0",
                                        "glosses": [
                                            "A verb form that depends on how its containing clause relates to the speaker’s or writer’s wish, intent, or assertion about reality."
                                        ],
                                        "tags": [],
