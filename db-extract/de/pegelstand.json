                "translations": [
                    {
                        "translation_id": "480f73cd-c17f-4fdd-a1b6-d36870817c53",
                        "source_entry_id": "918b72c7-baa2-3f91-b8e4-3e4e7bc27bb4",
                        "source_sense_id": "3545353f-c7af-3790-8064-2ada9a5471b3",
