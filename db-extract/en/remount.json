                        "entry_id": "1ac0aad3-1691-36be-9c44-768b348c74c1",
                        "glosses": [
                            "The opportunity of, or things necessary for, remounting; specifically, a fresh horse, with its equipment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1682b54-6845-4d6c-9bb3-f712ec9672bb",
                                "sense_id": "e38fc053-5b2e-36d5-b7f9-cf82acf341c9",
                                "text": "to give somebody a remount"
                            }
                        ]
                    },
                    {
                        "sense_id": "a9c1cba6-a7b1-31da-91aa-858a3e6f2737",
                        "entry_id": "1ac0aad3-1691-36be-9c44-768b348c74c1",
                        "glosses": [
                            "The process of mounting a drive or volume again."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "248cf382-30cd-3ead-bdc2-ddc7f468bfec",
                        "entry_id": "1ac0aad3-1691-36be-9c44-768b348c74c1",
                        "glosses": [
                            "The restaging of a play or film."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f5a2041-6d2b-45ce-981c-ea4e746ce851",
                                "sense_id": "248cf382-30cd-3ead-bdc2-ddc7f468bfec",
                                "text": "Sometimes I tell people she is auditioning for a remount of the musical “Hair”."
                            },
                            {
                                "example_id": "dfe48428-6816-409f-b84e-30ec90ee7150",
                                "sense_id": "248cf382-30cd-3ead-bdc2-ddc7f468bfec",
                                "text": "By mid-January they announced a remount of the television classic Peter Pan."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
