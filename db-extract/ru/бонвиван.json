                        "cross_references": [
                            {
                                "target_word": "calavera",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "07c580dc-12b0-3db9-b344-aa0b7d3275f9",
                                        "entry_id": "f504d228-6cde-34a0-9c85-63fa24b150ca",
                                        "glosses": [
                                            "Armazón de los huesos de la cabeza, despojada de carne y pellejo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0334b082-a300-49df-b91f-93038b6edbc3",
                                                "sense_id": "07c580dc-12b0-3db9-b344-aa0b7d3275f9",
                                                "text": "«Terminó el cigarro. Con el machete ayudó a las hormigas rapando la calavera, y metió los huesos en un costal»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f24acb4e-95f6-3cf9-a1b6-d28f3358771a",
