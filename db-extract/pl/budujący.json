                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc9edf41-483e-33a5-82ce-0fc7b62b0afa",
                        "entry_id": "f1aaa136-6cd4-38a9-9729-0e4137058272",
                        "glosses": [
                            "będący składnikiem, częścią czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "763376df-6f4a-4956-a117-bf3a642a1c19",
                                "sense_id": "fc9edf41-483e-33a5-82ce-0fc7b62b0afa",
                                "text": "Materiałem budującym Tatry jest głównie granit."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3448ac01-3fe0-341a-a3aa-ef0cf195955e",
                        "entry_id": "f1aaa136-6cd4-38a9-9729-0e4137058272",
                        "glosses": [
                            "pozytywny, cieszący"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f1c3cf2-a4aa-4089-b4f4-72aaf6395b59",
                                "sense_id": "3448ac01-3fe0-341a-a3aa-ef0cf195955e",
                                "text": "To bardzo budujące, że również młodzi ludzie przyłączyli się do zbiórki na pomoc ofiarom katastrofy."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66d85221-5a97-419e-bc9f-cdc358bedd2e",
                        "source_entry_id": "f1aaa136-6cd4-38a9-9729-0e4137058272",
                        "source_sense_id": "3448ac01-3fe0-341a-a3aa-ef0cf195955e",
                        "target_lang_word": "uplifting",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uplifting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24066296-afc0-38ea-96b6-ed614fd63313",
                                        "entry_id": "cc763e74-44cb-3303-a9e1-a01a738cac9b",
                                        "glosses": [
                                            "Improving the mood; causing cheerfulness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4af0aab-3ca8-4469-81fa-4ed164b11c49",
                                                "sense_id": "24066296-afc0-38ea-96b6-ed614fd63313",
                                                "text": "Listening to whalesong can be very uplifting."
                                            },
                                            {
                                                "example_id": "8594ad6d-0565-4cfd-968c-dcf8d24c418b",
                                                "sense_id": "24066296-afc0-38ea-96b6-ed614fd63313",
                                                "text": "It would be uplifting to think that the ziggurat was the first expression of Near Eastern civilization, for then one could speak about humanity's fascination with the heavens, of the human quest for communion with the infinite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uplifting",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c8ab0c1-7122-31d8-b459-987c6c71c58c",
                                        "entry_id": "7b1367e2-dca3-3296-a936-3b3ebb8135d6",
                                        "glosses": [
                                            "The act of something being lifted upward."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa76bb67-b5d9-48e9-b647-c16921bc1c6e",
                                                "sense_id": "1c8ab0c1-7122-31d8-b459-987c6c71c58c",
                                                "text": "Whereby, with prodigious long upliftings of their legs, those old astronomers were wont to mount to the apex."
                                            },
                                            {
                                                "example_id": "c8ebcadb-b242-487d-aea0-0a7e85fca500",
                                                "sense_id": "1c8ab0c1-7122-31d8-b459-987c6c71c58c",
                                                "text": "The borders of large subsiding areas sooner or later experiencing deep fissurings and extensive upliftings through the tension or horizontal force of the subsiding crust[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8071462f-b84a-4a7b-a0df-b903e66bb7e1",
                        "source_entry_id": "f1aaa136-6cd4-38a9-9729-0e4137058272",
                        "source_sense_id": "3448ac01-3fe0-341a-a3aa-ef0cf195955e",
                        "target_lang_word": "erbaulich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erbaulich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "066aa373-33ce-3294-a187-7b4998301121",
                                        "entry_id": "b1e09464-d8c7-3be9-b714-0e63f2a19ebe",
                                        "glosses": [
                                            "von erfreulichem Einfluss auf die Gemütslage"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
