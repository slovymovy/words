                        "sense_id": "cf250ea1-76e4-31af-89e7-5612301c1da6",
                        "entry_id": "2d1bcd9c-d6cd-3864-9043-9ac16eae0227",
                        "glosses": [
                            "Boiter un peu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e2e533-b7ce-4ee2-a6ff-6cd7404b816e",
                                "sense_id": "cf250ea1-76e4-31af-89e7-5612301c1da6",
                                "text": "Quant à moi, je deviens une vraie patraque, l’estomac n’est pas sublime, et j’ai dans un talon une douleur sans doute rhumatismale qui me fait boitailler."
                            },
                            {
                                "example_id": "05247fce-f7bc-4e55-b583-2f1bab49032a",
                                "sense_id": "cf250ea1-76e4-31af-89e7-5612301c1da6",
                                "text": "Après tout, l’impair qui le fait « boitailler » où les autres marchent droit était déjà préféré par Verlaine dans son Art poétique ?"
                            }
                        ]
                    }
