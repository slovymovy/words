                                        "entry_id": "02be8cca-f05b-3628-90fb-4167425d7d5a",
                                        "glosses": [
                                            "Any of the silica group of the silicate minerals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8423ad03-8382-43fa-9806-4f453dcd327b",
                                                "sense_id": "cedfc3e0-dc63-33e1-871a-87ae9a1c1bf0",
                                                "text": "Its Blair County property was sited at the foot of ganister-covered Dunnings Mountain to compete with the Mount Union plants making silica bricks for the steel industry."
                                            }
                                        ]
