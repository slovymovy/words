                },
                {
                    "sense_id": "e6e4e062-f3f1-36f0-bd70-869f7bcdb547",
                    "sense_definition": "To officially and formally rebuke someone, typically in a legislative or professional setting.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "criticism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The parliament decided to <w>censure</w> the minister for his failure to disclose the conflict of interest."
                        },
                        {
                            "text": "The professional body chose to <w>censure</w> the doctor for violating the code of ethics."
                        }
                    ],
                    "synonyms": [
                        "reprimand",
                        "admonish"
                    ]
                }
            ]
        }
    ]
