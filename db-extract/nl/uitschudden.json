                "senses": [
                    {
                        "sense_id": "a83bfa03-c4f9-3adf-8409-c0edf2e4cb8d",
                        "entry_id": "cfd93e1c-d2aa-3692-97ba-adb00989145c",
                        "glosses": [
                            "to shake out (to shake something in order to empty it)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "27bae0af-d3af-4d34-8a04-0cd5ce01c53a",
                                "sense_id": "a83bfa03-c4f9-3adf-8409-c0edf2e4cb8d",
                                "text": "Je moet die zak even goed uitschudden, misschien zit er nog iets in.",
                                "translation": "You have to shake out that bag well, maybe there's still something left inside.",
                                "english": "You have to shake out that bag well, maybe there's still something left inside."
                            }
                        ]
                    },
                    {
                        "sense_id": "cb9340ed-f0df-3ae7-9bca-a470545554da",
                        "entry_id": "cfd93e1c-d2aa-3692-97ba-adb00989145c",
                        "glosses": [
                            "to shake out (to remove something by shaking it)"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "37236fab-5ac3-4439-9b18-537caffa3e0f",
                                "sense_id": "cb9340ed-f0df-3ae7-9bca-a470545554da",
                                "text": "Hij schudde de inhoud uit de doos.",
                                "translation": "He shook the contents out of the box.",
                                "english": "He shook the contents out of the box."
                            }
                        ]
                    }
