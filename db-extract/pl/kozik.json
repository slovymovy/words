                ],
                "senses": [
                    {
                        "sense_id": "c8c019d4-75e5-341f-b74a-766e39775a3d",
                        "entry_id": "6bf60348-1c16-3459-8614-9d06f7301261",
                        "glosses": [
                            "mały nóż ze składanym, spiczastym ostrzem i drewnianym trzonkiem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11b6694e-8628-4173-bd53-703fa62ebbb2",
                                "sense_id": "c8c019d4-75e5-341f-b74a-766e39775a3d",
                                "text": "Chuligan wyrył kozikiem na drewnianej ławce plugawy napis."
                            },
                            {
                                "example_id": "3ffee1c6-3e25-494e-84a3-ea3bcf27f5ec",
                                "sense_id": "c8c019d4-75e5-341f-b74a-766e39775a3d",
                                "text": "Do dziesiątego roku życia zepsuł ze cztery koziki, ale też strugał nimi dziwne rzeczy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41eb6cce-4b0a-42c0-8bc1-7378a566d206",
                        "source_entry_id": "6bf60348-1c16-3459-8614-9d06f7301261",
                        "source_sense_id": "c8c019d4-75e5-341f-b74a-766e39775a3d",
                        "target_lang_word": "clasp-knife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clasp-knife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "72b0b0a9-a51e-3578-a2d0-cb8e291134c4",
                                        "entry_id": "45e3b308-bda4-3a32-9d7e-f48a55a9bbae",
                                        "glosses": [
                                            "A knife with a hinged blade or blades that, for safety when not in use, can be folded into a slot in the handle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67c8874f-bd46-416a-a4fa-0835997584c3",
                                                "sense_id": "72b0b0a9-a51e-3578-a2d0-cb8e291134c4",
                                                "text": "...there is yet ample evidence of the existence of clasp-knives ages before the production of the Canterbury Tales. Among Etruscan antiquities in the Bronze Room of the British Museum are several clasp-knives, some of them with bone, others with bronze hafts, their blades being of iron — a metal employed for cutting implements by the Tyrrhenian tribes, at a far remote era.\nA scalprum or penknife has been found in Rome, the blade shutting into a bone haft, which is carved to represent the upper half of a human body; and clasp-knives, with iconic handles of the Roman era, have been discovered both in France and this country."
                                            },
                                            {
                                                "example_id": "65f810fa-b398-4a6b-a2ef-45dfa2f50be9",
                                                "sense_id": "72b0b0a9-a51e-3578-a2d0-cb8e291134c4",
                                                "text": "“Well, this knife is called a clasp-knife, because it shuts and opens, as you see, and it has three blades — a big one for cuttin’ up your victuals with, as you see me doin’; and two little ones for parin’ your nails and pickin’ your teeth, an’ mendin’ pens an’ pencils — though of course you don’t know what that means.”"
                                            },
                                            {
                                                "example_id": "f18d6a4f-b447-4973-bdff-507932c87ece",
                                                "sense_id": "72b0b0a9-a51e-3578-a2d0-cb8e291134c4",
                                                "text": "Blake picked his teeth reflectively with the point of a clasp knife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cabc9c2-11fd-4ec3-bbd2-19455d3fd63b",
                        "source_entry_id": "6bf60348-1c16-3459-8614-9d06f7301261",
                        "source_sense_id": "c8c019d4-75e5-341f-b74a-766e39775a3d",
                        "target_lang_word": "penknife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penknife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ede2c6b3-9963-327e-8ce9-871619ca9479",
                                        "entry_id": "5ce42abe-6ee1-3b80-bda1-ae9ce499b229",
                                        "glosses": [
                                            "A small pocketknife; (loosely) any pocketknife."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d93c7f31-0eeb-4d6d-9821-01b12d57e657",
                                                "sense_id": "ede2c6b3-9963-327e-8ce9-871619ca9479",
                                                "text": "The logical distinction between genus and species can, of course, apply to any objects whatsoever. Thus, for example, the genus knife may be divided into several species, such as penknife, table knife, bread knife, razor, etc. We might define the penknife as a knife small enough to be carried in the pocket, with foldable, sheathable elements, characterized by the feature that one blade at least is always suitable for sharpening pencils and erasing ink spots. We are quite sure in which features all the members of a certain species agree, notwithstanding possible individual characteristics, say a monogram on one penknife, or a corkscrew in another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14f6039e-10a9-3301-83d0-b01dc901f2b1",
                                        "entry_id": "5ce42abe-6ee1-3b80-bda1-ae9ce499b229",
                                        "glosses": [
                                            "A small knife designed for safe and convenient storage, typically in the form of a miniature clasp-knife, or with blade retractable into the handle."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06ff8355-fa17-4f67-b27c-18089fa8bee3",
                                                "sense_id": "14f6039e-10a9-3301-83d0-b01dc901f2b1",
                                                "text": "Presently the man took a reed pen from his satchel, and trimmed it with a little ivory knife, carved in the semblance of a fish.\n\"Oh, what a beauty!\" cried Dan.\n \"’Ware fingers! That blade is perilous sharp. I made it myself of the best Low Country crossbow steel. And so, too, this fish. When his back-fin travels to his tail — so — he swallows up the blade, even as the whale swallowed Gaffer Jonah.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e5e8e2-30e0-3471-af44-d02aeeaa1940",
                                        "entry_id": "5ce42abe-6ee1-3b80-bda1-ae9ce499b229",
                                        "glosses": [
                                            "A small knife for cutting the points of quill feathers or reeds into nibs to provide or repair writing implements, early versions were commonly small sheath knives."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d00eab5a-9930-446b-b08d-77ece116cc8d",
                                                "sense_id": "56e5e8e2-30e0-3471-af44-d02aeeaa1940",
                                                "text": "Every sin is damning without Christ. \"The wages of sin is death\". It is no great difference, if a man be killed, whether it be by a sword or a penknife. The least sin violates the whole law. He that offendeth in one point, is guilty of all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "penknife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2d53aa3c-86d1-32f0-b21d-bdcd8e86204e",
                                        "entry_id": "5aa6d366-9b04-3ab2-b2f9-8b4f4a64846e",
                                        "glosses": [
                                            "To cut or carve with a penknife."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
