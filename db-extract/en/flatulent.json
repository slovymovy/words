                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flatulent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "249de3a1-4647-3702-8ec4-5d21589f7641",
                                        "entry_id": "db581d74-e284-3642-b1ab-9321d62c09bc",
                                        "glosses": [
                                            "Blähungen habend"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27339419-33de-4cb9-8c24-0b856b6078e4",
                                                "sense_id": "249de3a1-4647-3702-8ec4-5d21589f7641",
                                                "text": "„Die Besserung hielt an, und den Tag darauf sagt mein Notizbuch «Puls 84, keine unwillkürlichen Stühle mehr; erwachender Appetit; noch stark flatulent, Winde nach unten abgehend; noch empfindlich im rechten Schooss, Schneiden beim Harnen, und Brennen entlang der Harnröhre. Lochien gut.»“"
                                            },
                                            {
                                                "example_id": "0ddb49a9-866e-4ea8-a776-a6416f600a98",
                                                "sense_id": "249de3a1-4647-3702-8ec4-5d21589f7641",
                                                "text": "„Ihre Stuhlausleerungen waren in den letzten 3 Wochen pechartig, der Unterleib war oft flatulent, die untern Extremitäten sehr schwach, über Krampf in den Schenkeln hatte sie schon die letzten Monate dann u. wann zu klagen gehabt.“"
                                            },
                                            {
                                                "example_id": "0bdc2e66-4dfe-40ec-b825-546046159471",
                                                "sense_id": "249de3a1-4647-3702-8ec4-5d21589f7641",
                                                "text": "„Am 6. Dec. waren 6 Stühle unter heftigen Schmerzen erfolgt, der Unterleib war flatulent aufgetrieben und sehr schmerzhaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
