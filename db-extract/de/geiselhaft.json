                    {
                        "translation_id": "8a8cbb62-d077-4fe2-a730-c97d6b4f9882",
                        "source_entry_id": "e404a3bf-a1ab-3a69-9296-75febc6520d1",
                        "source_sense_id": "da16ce72-2f9a-3b5f-9b72-aac115fbff3e",
                        "target_lang_word": "captivité comme otage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d73ace03-fb78-4e42-973b-9deee78d0f98",
                        "source_entry_id": "e404a3bf-a1ab-3a69-9296-75febc6520d1",
                        "source_sense_id": "da16ce72-2f9a-3b5f-9b72-aac115fbff3e",
                        "target_lang_word": "détention comme otage",
