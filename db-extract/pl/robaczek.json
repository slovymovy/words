                ],
                "senses": [
                    {
                        "sense_id": "4fccf0c4-792f-389b-bba1-34b9fd2d1e70",
                        "entry_id": "4acd8616-b6a4-3820-b4b1-ca4138dc2eeb",
                        "glosses": [
                            "od: robak"
                        ],
                        "tags": [
                            "diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "67657572-30b5-44bd-8237-73e6019e7dc0",
                                "sense_id": "4fccf0c4-792f-389b-bba1-34b9fd2d1e70",
                                "text": "Ale z nastaniem brzasku dnia następnego Bóg zesłał robaczka, aby uszkodził krzew, tak iż usechł"
                            },
                            {
                                "example_id": "bc705fae-1aca-4301-8c2b-590c5dbef998",
                                "sense_id": "4fccf0c4-792f-389b-bba1-34b9fd2d1e70",
                                "text": "Piaszczystą dróżką w promieniach słonka poszły na spacer małe stworzonka – tłusty pędraczek, czarny robaczek, czerwona mrówka, żółty cytrynek, biały bielinek i boża krówka, zielona żabka i żabki babka, włochata liszka, mała biedronka, pasiasta stonka i polna myszka"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0b9dfe0-0496-434b-9113-840451f9efbe",
                        "source_entry_id": "4acd8616-b6a4-3820-b4b1-ca4138dc2eeb",
                        "source_sense_id": "4fccf0c4-792f-389b-bba1-34b9fd2d1e70",
                        "target_lang_word": "gusanito",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gusanito",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "6b6a3bf3-05d7-3dbb-85fa-bf868aadd7aa",
                                        "entry_id": "194aa624-7bb8-34e5-b87a-9e9d399733c0",
                                        "glosses": [
                                            "Diminutivo de gusano."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "296738b3-67d4-3100-8006-1a7e1e54fb46",
                                        "entry_id": "194aa624-7bb8-34e5-b87a-9e9d399733c0",
                                        "glosses": [
                                            "Aperitivo ligero y crujiente, de forma alargada y más o menos curvada, hecho a base de maíz o patata y habitualmente rebozado con algún tipo de saborizante de queso."
                                        ],
                                        "tags": [
                                            "Spain"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7fac3bd-1bb7-4841-a1f9-680f97241805",
                                                "sense_id": "296738b3-67d4-3100-8006-1a7e1e54fb46",
                                                "text": "¿Te gustan las cosas saladas? ¿Disfrutas de las patatas fritas, los gusanitos o con cualquier bolsa de snacks para picar?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d7cc0fac-ba99-49f9-aa6e-bd5bd33b202d",
                        "source_entry_id": "4acd8616-b6a4-3820-b4b1-ca4138dc2eeb",
                        "source_sense_id": "4fccf0c4-792f-389b-bba1-34b9fd2d1e70",
                        "target_lang_word": "Würmchen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0fbeb804-ccb4-49aa-8ecc-1aa77b710889",
                        "source_entry_id": "4acd8616-b6a4-3820-b4b1-ca4138dc2eeb",
                        "source_sense_id": "4fccf0c4-792f-389b-bba1-34b9fd2d1e70",
                        "target_lang_word": "букашка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "букашка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "cea5f660-d82b-30ae-9bc1-101a7fd3c9dc",
                                        "entry_id": "f50eaaca-1755-376e-b8a5-32a7788f49ec",
                                        "glosses": [
                                            "небольшое насекомое, маленький жучок"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9c6ff99-9c13-432f-834a-75b9918859b3",
                                                "sense_id": "cea5f660-d82b-30ae-9bc1-101a7fd3c9dc",
                                                "text": "В Киев он всегда возвращался с порядочно набитой портфелью местной флоры и несколькими ящиками мотыльков и разных букашек."
                                            },
                                            {
                                                "example_id": "b429e088-6532-47fc-b383-c7a991365626",
                                                "sense_id": "cea5f660-d82b-30ae-9bc1-101a7fd3c9dc",
                                                "text": "Хлопотливая серенькая лесная букашка проползла по его лицу, остро защекотала ему нос длинными усиками."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d810f330-8761-3bb7-a2e5-7edf4370acf1",
                                        "entry_id": "f50eaaca-1755-376e-b8a5-32a7788f49ec",
                                        "glosses": [
                                            "перен., разг., уничиж. незаметный, маленький, ничтожный человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ca9ee24-5c63-4f24-ba79-585cf8ff5939",
                                                "sense_id": "d810f330-8761-3bb7-a2e5-7edf4370acf1",
                                                "text": "Ближе всех стоял к нему какой-то офицер, высокий и красивый малый, пред которым господин Голядкин почувствовал себя настоящей букашкой."
                                            },
                                            {
                                                "example_id": "9f84ee8a-298d-423a-b817-eb3a47b9bf24",
                                                "sense_id": "d810f330-8761-3bb7-a2e5-7edf4370acf1",
                                                "text": "Вы ― букашка, вы в жизни жалкий статист, и ваши полосатые панталоны переживут ваше ничтожное имя."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
