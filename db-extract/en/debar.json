                                "target_senses": [
                                    {
                                        "sense_id": "56c3f45a-5e76-33cd-961f-96c815d64c5b",
                                        "entry_id": "2486680d-a545-344c-8c84-9887087994a2",
                                        "glosses": [
                                            "jemanden durch Schließen von Eingängen zum Draußenbleiben zwingen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d53c0874-ee15-4427-bac2-7f95c9719693",
                                                "sense_id": "56c3f45a-5e76-33cd-961f-96c815d64c5b",
                                                "text": "Ich habe den Hund jetzt ausgeschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "737c7bfd-24ac-31f0-ac81-08a81cb6c37d",
                                        "entry_id": "2486680d-a545-344c-8c84-9887087994a2",
                                        "glosses": [
                                            "sich versehentlich die Möglichkeit nehmen, wieder ins Innere zu gelangen, zum Beispiel, weil man seinen Schlüssel vergessen hat"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50aad188-83c0-4d9a-ba33-242b09252efc",
                                                "sense_id": "737c7bfd-24ac-31f0-ac81-08a81cb6c37d",
                                                "text": "Sie hatte sich ausgeschlossen und musste die Nacht im Gartenhaus verbringen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0202920f-cedf-379d-9fda-152af488ccd9",
                                        "entry_id": "2486680d-a545-344c-8c84-9887087994a2",
                                        "glosses": [
                                            "jemanden aus einer Gruppe oder von einem Ereignis fernhalten; dafür sorgen, dass jemand nicht dabei ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f70ce384-6ee7-4b39-a68f-fd267438fd48",
                                                "sense_id": "0202920f-cedf-379d-9fda-152af488ccd9",
                                                "text": "Die Aufdeckung ihrer kriminellen Machenschaften führte dazu, dass man sie aus der Partei ausschloss."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "57953516-5e96-343e-8265-ee9fdf957a39",
                                        "entry_id": "2486680d-a545-344c-8c84-9887087994a2",
                                        "glosses": [
                                            "einen Sachverhalt für unmöglich ansehen; für möglich erachten, dass ein genannter Sachverhalt vorliegen könnte"
                                        ],
                                        "tags": [
                                            "abstract"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa0e60a-4477-4672-95ae-eb1a910506b4",
                                                "sense_id": "57953516-5e96-343e-8265-ee9fdf957a39",
                                                "text": "Einen Krieg zwischen Nord- und Südkorea schließe ich aus."
                                            },
                                            {
                                                "example_id": "7649b2f5-ca77-4bb3-9dd0-5b60d26a9767",
                                                "sense_id": "57953516-5e96-343e-8265-ee9fdf957a39",
                                                "text": "Es ist nicht ausgeschlossen, dass hier ein Zusammenhang existiert."
                                            },
                                            {
                                                "example_id": "053a5aa1-4093-4b24-97cb-f5152120365e",
                                                "sense_id": "57953516-5e96-343e-8265-ee9fdf957a39",
                                                "text": "„Der Autokonzern schließt nicht mehr aus, dass Standorte in Deutschland komplett wegfallen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
