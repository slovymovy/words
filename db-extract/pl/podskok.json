        "pl-extract.jsonl": [
            {
                "entry_id": "3cd0364f-3a2b-3522-adea-551de3be891f",
                "word": "podskok",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "98ced411-399f-3377-bf4c-a0813b7f979c",
                        "entry_id": "3cd0364f-3a2b-3522-adea-551de3be891f",
                        "glosses": [
                            "wybicie się w górę, w miejscu, na niewielką wysokość"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85a02a90-99a2-49ea-83ae-47ffac91b834",
                                "sense_id": "98ced411-399f-3377-bf4c-a0813b7f979c",
                                "text": "Wtem się coś z lekka potrąci • Śród kryształowej przezroczy, • Woda się z lekka zamąci, • Rybka nad wodę podskoczy; • I jak skałka płaskim bokiem • Gdy z lekkich rąk chłopca pierzchnie, • Tak nasza rybka podskokiem • Mokre całuje powierzchnie."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f2da219-33e1-4936-a4a6-021d27afe308",
                        "source_entry_id": "3cd0364f-3a2b-3522-adea-551de3be891f",
                        "source_sense_id": "98ced411-399f-3377-bf4c-a0813b7f979c",
                        "target_lang_word": "подскок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "подскок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "41605b6b-bec8-3af9-bd55-2df8239718cb",
                                        "entry_id": "83c547da-b088-3250-963e-6be2598ccd33",
                                        "glosses": [
                                            "действие по значению гл. подскочить; небольшой скачок вверх"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77d797d4-3c80-4154-a47a-0ad4d93563c5",
                                                "sense_id": "41605b6b-bec8-3af9-bd55-2df8239718cb",
                                                "text": "Анисим тоже сел с подскоком и подбоченился, так как считал себя красивым."
                                            },
                                            {
                                                "example_id": "98719c3f-dd44-4070-835a-b6adf88c6b2a",
                                                "sense_id": "41605b6b-bec8-3af9-bd55-2df8239718cb",
                                                "text": "Этим летчиком оказался Стефановский. Он начал с того же, что и его предшественник: с пробежек, подскоков, подлётов."
                                            },
                                            {
                                                "example_id": "599207e2-2cb7-4ad2-81c7-d68c3cdb6c14",
                                                "sense_id": "41605b6b-bec8-3af9-bd55-2df8239718cb",
                                                "text": "Я подготавливаю таблетку на случай подскока давления; нитроглицерин, конечно, тоже."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b01faaa4-834b-4044-815d-584dcaa50f44",
                        "source_entry_id": "3cd0364f-3a2b-3522-adea-551de3be891f",
                        "source_sense_id": "98ced411-399f-3377-bf4c-a0813b7f979c",
                        "target_lang_word": "прыжок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "прыжок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c4992283-4ed0-3ce7-83f4-936dd00e426c",
                                        "entry_id": "7fb9fb23-3438-37f0-b089-d14326cc135a",
                                        "glosses": [
                                            "перемещение тела человека или животного в результате отталкивания его от опоры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abe62c34-5d50-4b81-8233-dda8a2322033",
                                                "sense_id": "c4992283-4ed0-3ce7-83f4-936dd00e426c",
                                                "text": "В одном месте наткнулись на ту же семейку носорогов, которая промчалась через их стоянку; папаша и мамаша, задрав головы, объедали молодые побеги в кустах, помахивая от удовольствия хвостиками, а детёныш то пощипывал траву, то резвился, делая неуклюжие прыжки, на которые нельзя было смотреть без смеха; казалось, что это прыгает порядочная бочка, к которой ради шутки прилеплены четыре толстых столбика."
                                            },
                                            {
                                                "example_id": "3f0dce0a-4c3c-4ef5-9f85-0866f5002b04",
                                                "sense_id": "c4992283-4ed0-3ce7-83f4-936dd00e426c",
                                                "text": "Терзая стартер, я увидел, как дверь избы распахнулась, из прихожей вылетел чёрный козёл и гигантскими прыжками помчался прочь куда-то за угол."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1dea2a4-3052-3382-aaad-b25796928554",
                                        "entry_id": "7fb9fb23-3438-37f0-b089-d14326cc135a",
                                        "glosses": [
                                            "спорт. вид спорта, включающий упражнения с использованием такого перемещения"
                                        ],
                                        "tags": [
                                            "мн.ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eab3da2-f229-4adb-b8fe-992c028783f1",
                                                "sense_id": "b1dea2a4-3052-3382-aaad-b25796928554",
                                                "text": "Прыжки с шестом."
                                            },
                                            {
                                                "example_id": "18c1064d-d934-4b97-9ae6-bd94f9cd8488",
                                                "sense_id": "b1dea2a4-3052-3382-aaad-b25796928554",
                                                "text": "Прыжки в длину."
                                            },
                                            {
                                                "example_id": "d3961b9a-e083-42e0-a853-febdd49af4bc",
                                                "sense_id": "b1dea2a4-3052-3382-aaad-b25796928554",
                                                "text": "Прыжки в высоту."
                                            },
                                            {
                                                "example_id": "1901aa3b-7e8c-4174-bcb5-ff60538c1f73",
                                                "sense_id": "b1dea2a4-3052-3382-aaad-b25796928554",
                                                "text": "Прыжок с вышки."
                                            },
                                            {
                                                "example_id": "9e5a3c98-518e-403c-9f45-2ae7d6ae486c",
                                                "sense_id": "b1dea2a4-3052-3382-aaad-b25796928554",
                                                "text": "Прыжки на батуте."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
