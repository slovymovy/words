                        "examples": [
                            {
                                "example_id": "c3eb6724-9470-4d0e-a9ee-16acccede552",
                                "sense_id": "aed2ef9f-afe7-36cc-bf9b-296c9eb8f362",
                                "text": "Oh ! notre petite bellote sera chez elle, répondit Mme Marneffe en sonnant Reine pour faire demander Mme Olivier."
                            }
                        ]
                    }
