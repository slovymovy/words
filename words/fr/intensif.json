    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fcc25573-a8af-3fb8-8f36-2d96e6d9a782",
                    "sense_definition": "Qui se caractérise par une forte intensité, une grande concentration d'efforts ou d'énergie, dépassant la mesure ordinaire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "degre_fort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il suit un cours <w>intensif</w> de français pour progresser rapidement avant son départ."
                        },
                        {
                            "text": "Le patient a été transporté au service des soins <w>intensifs</w> après son opération."
                        }
                    ],
                    "antonyms": [
                        "extensif"
                    ],
                    "common_phrases": [
                        "soins intensifs",
                        "cours intensif",
                        "agriculture intensive"
                    ]
                },
                {
                    "sense_id": "d921a222-9b4e-316e-aa59-ccd93f01fd04",
                    "sense_definition": "Se dit d'une grandeur physique dont la valeur ne dépend pas de la quantité de matière du système.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La température et la pression sont des grandeurs <w>intensives</w> d'un système thermodynamique."
                        },
                        {
                            "text": "Contrairement à la masse, la masse volumique est une propriété <w>intensive</w> de la matière."
                        }
                    ],
                    "antonyms": [
                        "extensif"
                    ],
                    "common_phrases": [
                        "grandeur intensive"
                    ]
                },
                {
                    "sense_id": "06949602-4340-3d37-a89a-a65d5b9092d9",
                    "sense_definition": "Qui possède la plénitude de l'être ou de la réalité dans son ordre propre.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "philosophie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe analysait la dimension <w>intensive</w> de la conscience humaine."
                        },
                        {
                            "text": "Cette doctrine accorde une réalité purement <w>intensive</w> aux principes métaphysiques."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca496460-cd98-3d70-8225-f0e01118372c",
                    "sense_definition": "Mot ou morphème qui modifie et renforce le degré d'un adjectif ou d'un adverbe.",
