                ],
                "senses": [
                    {
                        "sense_id": "78609dd5-0302-3266-b9a5-4ef0d13f4283",
                        "entry_id": "02bf4231-a287-3ed9-bd22-35c7d2a0f5d1",
                        "glosses": [
                            "Aneignung von fremdem Land; Besetzung eines Landes"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8775a9bc-4f9d-4039-ad91-78cbc2ad84b3",
                                "sense_id": "78609dd5-0302-3266-b9a5-4ef0d13f4283",
                                "text": "„Doch das geschah nicht durch einen einzigen mächtigen Schlachtzug, sondern glich vielmehr einer schrittweisen Landeinnahme.“"
                            },
                            {
                                "example_id": "3201577a-6f9e-4a07-8a26-0dcb62877f16",
                                "sense_id": "78609dd5-0302-3266-b9a5-4ef0d13f4283",
                                "text": "„Das Anwachsen der urbanen Bevölkerung wurde noch prozentual übertroffen durch die Landeinnahme der Städte.“"
                            },
                            {
                                "example_id": "49c0df6b-fcbc-417e-9e2c-fc144f9375d8",
                                "sense_id": "78609dd5-0302-3266-b9a5-4ef0d13f4283",
                                "text": "„Auch diese Landeinnahme soll nach dem Plan Gottes von Zeichen und Wundern begleitet sein.“"
                            },
                            {
                                "example_id": "5c7e80f6-2e7b-4a9c-98b6-3808cdfc040e",
                                "sense_id": "78609dd5-0302-3266-b9a5-4ef0d13f4283",
                                "text": "„Es ist die Zeit der Landeinnahme und -verteilung unter die zwölf Stämme Israels.“"
                            },
                            {
                                "example_id": "a9fc9eaf-0c36-4f4a-805b-7eefc8706081",
                                "sense_id": "78609dd5-0302-3266-b9a5-4ef0d13f4283",
                                "text": "„Oft bemüht wurde natürlich die amerikanische Geschichte mit ihrer Landeinnahme unter Verdrängung der Indianer, die nicht gefragt wurden und mit denen man nachträglich Verträge stark zu ihren Ungunsten gemacht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
