                    }
                ],
                "translations": [
                    {
                        "translation_id": "64145d89-3647-48e4-b109-60de840902a7",
                        "source_entry_id": "62931ea4-8387-3499-814b-55b617dbfb98",
                        "source_sense_description": "переставать гореть",
                        "target_lang_word": "diminish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diminish",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1f1effa0-9cda-3787-97ed-1a6e7454cd1f",
                                        "entry_id": "ee51eeb7-515e-3fc6-bdd7-a78c3aea3a50",
                                        "glosses": [
                                            "To make smaller."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "146db865-cb2a-4ea2-8304-c413906934c1",
                                                "sense_id": "1f1effa0-9cda-3787-97ed-1a6e7454cd1f",
                                                "text": "The threat of terrorism to the British lies in the overreaction to it of British governments. Each one in turn clicks up the ratchet of surveillance, intrusion and security. Each one diminishes liberty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d5c7bb0e-20fe-30dc-bf12-2249bd58f5ae",
                                        "entry_id": "ee51eeb7-515e-3fc6-bdd7-a78c3aea3a50",
                                        "glosses": [
                                            "To become less or smaller."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3fcd5e5-b7a2-4c1c-a66a-70cf2078b322",
                                                "sense_id": "d5c7bb0e-20fe-30dc-bf12-2249bd58f5ae",
                                                "text": "Whether modern, industrial man is less or more warlike than his hunter-gatherer ancestors is impossible to determine.[…]One thing that is true, though, is that murder rates have fallen over the centuries, as policing has spread and the routine carrying of weapons has diminished. Modern society may not have done anything about war. But peace is a lot more peaceful."
                                            },
                                            {
                                                "example_id": "1c5a65b6-3151-4e2c-9eab-4d1815a996ed",
                                                "sense_id": "d5c7bb0e-20fe-30dc-bf12-2249bd58f5ae",
                                                "text": "In the latter years of its existence, BR was rationalising its estate by pulling down station buildings which were too large for its modern operational needs, or by shutting off parts of them when demolition was not an option. Kilmarnock station falls into this latter category. It dominates the townscape, but its operational importance has seriously diminished since electrification of the West Coast Main Line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6977e722-b757-37a1-86b9-cce958400eb3",
                                        "entry_id": "ee51eeb7-515e-3fc6-bdd7-a78c3aea3a50",
                                        "glosses": [
                                            "To make appear smaller than in reality; to dismiss as unimportant."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cbdbd9e-a82c-4f7e-9e80-80d3a1f6f091",
                                                "sense_id": "6977e722-b757-37a1-86b9-cce958400eb3",
                                                "text": "Although British involvement in the slave trade prior to 1807 cannot be denied, or its effects diminished, it is also a fact that the Royal Navy was pretty much the only force in the world in the 19th century with the numbers, drive, willingness, firepower, and capability to curtail the global slave trade, and that, without these efforts, many more would no doubt have been taken to slave plantations and other such destinations during the 19th, and possibly even into the 20th, centuries, as it must be remembered that a great many European powers would only begrudgingly commit to ending the slave trade when the other option was continuous war with the British Empire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29c907eb-1f0a-39e8-aea1-e8a852c667ea",
                                        "entry_id": "ee51eeb7-515e-3fc6-bdd7-a78c3aea3a50",
                                        "glosses": [
                                            "To lessen the authority or dignity of; to put down; to degrade; to abase; to weaken; to nerf (in gaming)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8de38b40-5309-486d-a075-3e80eb77a549",
                                                "sense_id": "29c907eb-1f0a-39e8-aea1-e8a852c667ea",
                                                "text": "It shall be the basest of the kingdoms; neither shall it exalt itself any more above the nations: for I will diminish them, that they shall no more rule over the nations."
                                            },
                                            {
                                                "example_id": "929f0322-5450-44fd-be38-c44dfb98a526",
                                                "sense_id": "29c907eb-1f0a-39e8-aea1-e8a852c667ea",
                                                "text": "1639, Ralph Robinson (translator), Utopia by Thomas More, London, Book 2, “Of their journying or travelling abroad,” p. 197,\n[…] this doth nothing diminish their opinion."
                                            },
                                            {
                                                "example_id": "280c0085-0a51-4d28-90f3-6a146c839478",
                                                "sense_id": "29c907eb-1f0a-39e8-aea1-e8a852c667ea",
                                                "text": "O thou, that, with surpassing glory crowned,\nLookest from thy sole dominion like the God\nOf this new world; at whose sight all the stars\nHide their diminished heads; to thee I call,"
                                            },
                                            {
                                                "example_id": "cc8eca59-546a-48fa-8ad5-f5f84e409d96",
                                                "sense_id": "29c907eb-1f0a-39e8-aea1-e8a852c667ea",
                                                "text": "In Seth’s presence Mr Biswas felt diminished. Everything about Seth was overpowering: his calm manner, his smooth grey hair, his ivory holder, his hard swollen forearms […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "921490ae-0162-3543-81f0-d700997898c0",
                                        "entry_id": "ee51eeb7-515e-3fc6-bdd7-a78c3aea3a50",
                                        "glosses": [
                                            "To taper."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0f42f98-4f33-4137-8de8-6e4f3701629e",
                                                "sense_id": "921490ae-0162-3543-81f0-d700997898c0",
                                                "text": "The chair and table legs diminished as they neared the ground, and were straight and square in all their corners."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f84629c-027e-3d4b-9337-1a47ce97364c",
                                        "entry_id": "ee51eeb7-515e-3fc6-bdd7-a78c3aea3a50",
                                        "glosses": [
                                            "To disappear gradually."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70e2df2a-45e2-45db-833e-546fd77d83bc",
                                                "sense_id": "1f84629c-027e-3d4b-9337-1a47ce97364c",
                                                "text": "‘Good evening, good evening,’ Father Rank called. His stride lengthened and he caught a foot in his soutane and stumbled as he went by. ‘A storm’s coming up,’ he said. ‘Got to hurry,’ and his ‘ho, ho, ho’ diminished mournfully along the railway track, bringing no comfort to anyone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6582687-2c17-376a-b244-81d8a2acd1aa",
                                        "entry_id": "ee51eeb7-515e-3fc6-bdd7-a78c3aea3a50",
                                        "glosses": [
                                            "To take away; to subtract."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5b60a77-59c2-45eb-9d54-ae7633230187",
                                                "sense_id": "f6582687-2c17-376a-b244-81d8a2acd1aa",
                                                "text": "Ye shall not add unto the word which I command you, neither shall ye diminish ought from it, that ye may keep the commandments of the Lord your God which I command you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
