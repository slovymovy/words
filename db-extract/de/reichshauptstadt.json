                    {
                        "form_id": "65e07783-f44a-41aa-97ec-91088b65ff7c",
                        "entry_id": "603dcc6f-51a0-306c-a900-c83f678251d4",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Reichshauptstädte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "74bfa02c-3143-3554-9164-3fe5c2fe6ddf",
                        "entry_id": "603dcc6f-51a0-306c-a900-c83f678251d4",
                        "glosses": [
                            "Hauptstadt eines Reiches"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "bff9c907-5ef2-4f5d-9ef1-5efb7aeabcfd",
                                "sense_id": "74bfa02c-3143-3554-9164-3fe5c2fe6ddf",
                                "text": "Der neue Herrscher ließ die Stadt zu einer Reichshauptstadt ausbauen und verhalf ihr zu nie dagewesenem Ruhm."
                            },
                            {
                                "example_id": "eb85e77d-64de-4c75-be75-643e3c2cbf0f",
                                "sense_id": "74bfa02c-3143-3554-9164-3fe5c2fe6ddf",
                                "text": "Die zaristische Reichshauptstadt wurde nicht umsonst als „Venedig des Nordens“ verklärt."
                            },
                            {
                                "example_id": "6b0a422c-5c0c-4c4b-be3d-10959a1fde1c",
                                "sense_id": "74bfa02c-3143-3554-9164-3fe5c2fe6ddf",
                                "text": "„Rom wurde als größte Stadt der alten Welt Reichshauptstadt des alten Römischen Reichs.“"
                            },
                            {
                                "example_id": "7213c805-5170-403f-a4a3-c592f0bfac08",
                                "sense_id": "74bfa02c-3143-3554-9164-3fe5c2fe6ddf",
                                "text": "„Dann sandte er die Boten nach der Reichshauptstadt.“"
                            },
                            {
                                "example_id": "cbc359fe-e16c-41f3-9593-eec3c74d36e9",
                                "sense_id": "74bfa02c-3143-3554-9164-3fe5c2fe6ddf",
                                "text": "„Zur Feier des Tages war auch die Teilung Bengalens revidiert worden, allerdings zahlten die Bengalen dafür den Preis, dass die Reichshauptstadt von Kalkutta nach Delhi verlegt wurde, wo in der Folgezeit eine prächtige imperiale Hauptstadt gebaut werden sollte, freilich zu einer Zeit, als die Tage des Kaiserreichs bereits gezählt waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a67ad1a3-a553-3279-9fc1-12fc481eb5a9",
                        "entry_id": "603dcc6f-51a0-306c-a900-c83f678251d4",
                        "glosses": [
                            "Berlin als Hauptstadt des Deutschen Kaiserreiches und Dritten Reiches (1871–1945)"
                        ],
                        "tags": [
                            "historical",
                            "no-plural",
                            "special"
                        ],
                        "examples": [
                            {
                                "example_id": "7032eb1f-2cea-46f5-9422-98f16d8dbedd",
                                "sense_id": "a67ad1a3-a553-3279-9fc1-12fc481eb5a9",
                                "text": "„Kaum zu glauben: Sechs Tage vor der Ernennung Hitlers zum Reichskanzler wurde in der Reichshauptstadt das erste jüdische Museum der Moderne eröffnet.“"
                            },
                            {
                                "example_id": "b4e89525-5ff6-4b70-8f68-18000507c456",
                                "sense_id": "a67ad1a3-a553-3279-9fc1-12fc481eb5a9",
                                "text": "„Sein Ziel ist es jetzt, zwischen den zerstrittenen europäischen Mächten den ehrlichen Makler zu spielen und dabei die Reichshauptstadt ins Zentrum des Weltgeschehens zu rücken.“"
                            },
                            {
                                "example_id": "7b8dd052-f0ea-4ce0-a56a-0550858851ed",
                                "sense_id": "a67ad1a3-a553-3279-9fc1-12fc481eb5a9",
                                "text": "„In der Umgebung der Reichshauptstadt strömte Jung und Alt bei Temperaturen jenseits von 30 Grad zum Wasser; die Strandbäder am Wannsee, Müggelsee und Tegeler See waren überfüllt.“"
                            },
                            {
                                "example_id": "e6482fa7-888c-420a-bc7c-e0f3e5cfc7bf",
                                "sense_id": "a67ad1a3-a553-3279-9fc1-12fc481eb5a9",
                                "text": "„Nach einem neuen und besonders schweren Angriff auf die Reichshauptstadt ist auch Jobst überzeugt, daß ich abreisen sollte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
