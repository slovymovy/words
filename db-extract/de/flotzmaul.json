                "senses": [
                    {
                        "sense_id": "57427d52-385b-358a-937d-9c90c5f4a4fb",
                        "entry_id": "5cd605aa-8927-3863-86e3-b988d517f6a8",
                        "glosses": [
                            "feuchter, haarloser Bereich aus Oberlippe und Nasenspiegel bei Rindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da3ac8f4-2e8a-4916-8981-e9693ac041e9",
                                "sense_id": "57427d52-385b-358a-937d-9c90c5f4a4fb",
                                "text": "Das Flotzmaul ist neben der Zunge der wichtigste verzehrbare Bestandteil des Rinderkopfes."
                            },
                            {
                                "example_id": "c42f07f6-ddf4-4564-8d1b-d6360385b8ca",
                                "sense_id": "57427d52-385b-358a-937d-9c90c5f4a4fb",
                                "text": "„Beim natürlichen Saugtrinken der Rinder wird das Flotzmaul 3 bis 4 cm mit schräggestelltem Kopf (etwa 60 Grad zur Waagrechten) in die Wasseroberfläche eingetaucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
