                    {
                        "sense_id": "983d5a25-2039-3c14-90c4-b57f81da22c4",
                        "entry_id": "4e66b7a3-6340-30fc-b444-74daf0f78e3c",
                        "glosses": [
                            "Having a normal body temperature."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8c8f6bc4-96a2-4afa-b327-1b756d986786",
                                "sense_id": "983d5a25-2039-3c14-90c4-b57f81da22c4",
                                "text": "Perhaps a compromise between near normothermic temperatures and the typical 4°C perfusion would be best for clinical use. Here the warmer temperatures at midthermia (15–20°C) may promote metabolic repair but remain cool enough to suppress metabolism and slow reactions and flow rates so that machine automation can be practical for clinical use."
                            },
                            {
                                "example_id": "dca22c08-8e5c-41d0-a61f-5af7d0485e67",
                                "sense_id": "983d5a25-2039-3c14-90c4-b57f81da22c4",
                                "text": "In contrast to cold preservation, the concept of normothermic preservation is to maintain the cellular metabolism."
                            }
                        ]
                    }
                ],
