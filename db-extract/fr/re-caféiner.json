                ],
                "senses": [
                    {
                        "sense_id": "9a6f4d7a-29b1-3637-8449-8ce5818380ee",
                        "entry_id": "7a6dc170-e316-3788-afb9-010e319b44fc",
                        "glosses": [
                            "Additionner à nouveau de caféine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e01ea95-0d7e-4bd1-89eb-b2111c61c280",
                                "sense_id": "9a6f4d7a-29b1-3637-8449-8ce5818380ee",
                                "text": "Parfois les cafés décaféinés sont re-caféinés!"
                            },
                            {
                                "example_id": "77cecb76-880e-4453-aa7c-06b6a74d5747",
                                "sense_id": "9a6f4d7a-29b1-3637-8449-8ce5818380ee",
                                "text": "Si j’étais capable de boucler un doctorat en quatre ans et de re-caféiner tout seul un décaféiné naturel de chez Safeway, je n’avais besoin de personne."
                            }
                        ]
                    },
                    {
                        "sense_id": "4439943e-4289-3684-905e-037b4fb0186b",
                        "entry_id": "7a6dc170-e316-3788-afb9-010e319b44fc",
                        "glosses": [
                            "Exciter à nouveau en utilisant de la caféine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85743162-9fe2-4d35-a855-3186751388e2",
                                "sense_id": "4439943e-4289-3684-905e-037b4fb0186b",
                                "text": "Il arrive au niveau de la voiture-restaurant qui se fait ravitailler afin de pouvoir re-caféiner les voyageurs matinaux croisés sur le quai, car ils n'ont pas tous l'air bien réveillés."
                            },
                            {
                                "example_id": "77faf5a1-5533-4cd1-9684-5b1d3c39f2b7",
                                "sense_id": "4439943e-4289-3684-905e-037b4fb0186b",
                                "text": "Me suis depuis beaucoup trop re-caféinée."
                            }
                        ]
                    }
