                            {
                                "example_id": "7277e093-a21e-4959-ada2-02aa01801d2b",
                                "sense_id": "0c6cf2af-9fee-3a51-8f8d-fa25cbbf5808",
                                "text": "Kanalizacja odprowadza wodę poza budynek."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ac537be1-4291-3636-b00e-0efc8eb64cdb",
                        "entry_id": "007f3788-62da-3a7d-ac1e-4c592912a4ef",
                        "glosses": [
                            "zespół urządzeń do oczyszczania ścieków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc32e898-bf50-4b97-a85f-f40963581bf3",
                                "sense_id": "ac537be1-4291-3636-b00e-0efc8eb64cdb",
                                "text": "Ścieki są odprowadzane i oczyszczane w kanalizacji."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d10165dc-3272-4a16-9da3-c0a6236bd802",
                        "source_entry_id": "007f3788-62da-3a7d-ac1e-4c592912a4ef",
                        "source_sense_id": "0c6cf2af-9fee-3a51-8f8d-fa25cbbf5808",
                        "target_lang_word": "sewer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c6d864b4-a068-36c5-85f3-e439f753db15",
                                        "entry_id": "22dca22f-7086-3665-886f-2f79f856aa82",
                                        "glosses": [
                                            "A pipe or channel, or system of pipes or channels, used to remove human waste and to provide drainage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "118e8a8d-156e-472c-8449-d0a7f91e912b",
                                                "sense_id": "c6d864b4-a068-36c5-85f3-e439f753db15",
                                                "text": "He first learned about sewers last year in science class."
                                            },
                                            {
                                                "example_id": "869ba5aa-ad09-4c22-b937-e0a78ab13bd7",
                                                "sense_id": "c6d864b4-a068-36c5-85f3-e439f753db15",
                                                "text": "One of the hidden glories of Victorian engineering is proper drains. Isolating a city’s effluent and shipping it away in underground sewers has probably saved more lives than any medical procedure except vaccination."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "084d4f14-581a-3361-8e57-b56509684d20",
                                        "entry_id": "98b833ae-6706-3b93-ba6c-fcf834492408",
                                        "glosses": [
                                            "To provide (a place) with a system of sewers."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "057c8974-0fb0-3bb4-bedb-5cd88cd080ed",
                                        "entry_id": "15052b04-7e8c-3ed9-98a7-6ce134d67ee7",
                                        "glosses": [
                                            "An official in charge of a princely household, also responsible for the ceremonial task of attending at dinners, seating the guests and serving dishes."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec10901-bd6e-48ae-ae49-3f77cc28a622",
                                                "sense_id": "057c8974-0fb0-3bb4-bedb-5cd88cd080ed",
                                                "text": "While the Saxon was plunged in these painful reflections, the door of their prison opened, and gave entrance to a sewer, holding his white rod of office."
                                            },
                                            {
                                                "example_id": "7c9c4f01-91d2-4adf-a208-3f295bc1f542",
                                                "sense_id": "057c8974-0fb0-3bb4-bedb-5cd88cd080ed",
                                                "text": "His nephew Charles, meanwhile, had grown up in the royal household, working as a sewer, or waiter."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sewer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "988c53f1-a60e-3ca1-8c24-99bd01f86993",
                                        "entry_id": "6cc41764-6864-3ade-b5e3-066373af4aaf",
                                        "glosses": [
                                            "One who sews."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2934ad4a-e7b5-450f-b468-9899d948bf22",
                                                "sense_id": "988c53f1-a60e-3ca1-8c24-99bd01f86993",
                                                "text": "Up under the roof three men are making boys’ jackets at twenty cents a piece, of which the sewer takes eight, the ironer three, the finisher five cents, and the buttonhole-maker two and a quarter, leaving a cent and three-quarters to pay for the drumming up, the fetching and bringing back of the goods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fc6bb96-3c2d-3be2-84f9-cfe92e709c61",
                                        "entry_id": "6cc41764-6864-3ade-b5e3-066373af4aaf",
                                        "glosses": [
                                            "A small tortricid moth, the larva of which sews together the edges of a leaf using silk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aeea2daa-fa35-4416-b94b-1f1ef7a76afb",
                                                "sense_id": "6fc6bb96-3c2d-3be2-84f9-cfe92e709c61",
                                                "text": "the apple-leaf sewer, Ancylis nubeculana"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9117297c-a4de-4cbc-99e6-b1e4823289dd",
                        "source_entry_id": "007f3788-62da-3a7d-ac1e-4c592912a4ef",
                        "source_sense_id": "0c6cf2af-9fee-3a51-8f8d-fa25cbbf5808",
                        "target_lang_word": "égout",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "égout",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74271a61-c27a-3db1-876e-68cc6601f410",
                                        "entry_id": "ddbe2f23-ae42-3fc6-a4b3-9c3cad1b6771",
                                        "glosses": [
                                            "Chute et écoulement des eaux qui viennent de quelque endroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c3981c-9c50-47e1-9285-b9e048429724",
                                                "sense_id": "74271a61-c27a-3db1-876e-68cc6601f410",
                                                "text": "On voit encore, en dehors de cette partie de l’enceinte extérieure, […], les orifices de l’égout que le roi avait fait construire à travers la muraille élevée par son ordre, pour rejeter au dehors les eaux de l’évêché, […]."
                                            },
                                            {
                                                "example_id": "116c8cff-befb-4262-b100-9052bc5a4737",
                                                "sense_id": "74271a61-c27a-3db1-876e-68cc6601f410",
                                                "text": "Il a recueilli l’égout de plusieurs sources et en a fait de belles fontaines."
                                            },
                                            {
                                                "example_id": "bee92526-4188-4864-848c-a2f0105ccf11",
                                                "sense_id": "74271a61-c27a-3db1-876e-68cc6601f410",
                                                "text": "Il a l’égout des eaux de cette terre, et il les a conduites dans son jardin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d30e5948-b7de-30d9-9a4b-c9fea0f217b0",
                                        "entry_id": "ddbe2f23-ae42-3fc6-a4b3-9c3cad1b6771",
                                        "glosses": [
                                            "Chute et écoulement des eaux de pluie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d56fde70-710a-40ad-a1d0-25e9a74a3cb9",
                                                "sense_id": "d30e5948-b7de-30d9-9a4b-c9fea0f217b0",
                                                "text": "Il n’est pas permis de laisser tomber l’égout de ses eaux chez son voisin."
                                            },
                                            {
                                                "example_id": "3c2e9837-9eb9-49a6-91da-9bb9034a8b74",
                                                "sense_id": "d30e5948-b7de-30d9-9a4b-c9fea0f217b0",
                                                "text": "On fait des canaux de plomb pour recevoir l’égout des eaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a4c2514-8b9d-3017-b3ee-f850a3422b9e",
                                        "entry_id": "ddbe2f23-ae42-3fc6-a4b3-9c3cad1b6771",
                                        "glosses": [
                                            "Conduit par où s’écoulent les eaux et les immondices d’une ville."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3408bc72-3ed9-4f20-a40a-b3b85cbc5218",
                                                "sense_id": "1a4c2514-8b9d-3017-b3ee-f850a3422b9e",
                                                "text": "Ces chiffres comparés avec le nombre de pieds cubes d'eau que les aqueducs de la ville fournissent en 24 heures, démontreraient, […], que les deux tiers environ de l’eau potable qui arrive à Lausanne se répandent dans les égouts , sans avoir été préalablement utilisés."
                                            },
                                            {
                                                "example_id": "c1e64a9d-eb62-4ef8-b270-bcffebab5154",
                                                "sense_id": "1a4c2514-8b9d-3017-b3ee-f850a3422b9e",
                                                "text": "En 1980, l’Italie est d'ailleurs déjà celui des pays du Marché commun qui a les plus graves problèmes d'environnement : des égouts de Naples aux pollutions chimiques de la plaine du Pô, la péninsule exprime son incivisme glorieux. Dans une civilisation industrielle avancée, le chacun pour sa peau se paye au prix fort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1361c94-d83b-34d1-a66c-8ba2103c9c8b",
                                        "entry_id": "ddbe2f23-ae42-3fc6-a4b3-9c3cad1b6771",
                                        "glosses": [
                                            "Partie inférieure du versant d’un toit."
                                        ],
                                        "tags": [
                                            "Couvertures"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "493dff8d-c5f1-4ff7-af47-5460547bd92f",
                                                "sense_id": "b1361c94-d83b-34d1-a66c-8ba2103c9c8b",
                                                "text": "égout retroussé."
                                            },
                                            {
                                                "example_id": "69e4ab4d-70e7-475f-873b-c7cbac4cf216",
                                                "sense_id": "b1361c94-d83b-34d1-a66c-8ba2103c9c8b",
                                                "text": "égout de brisis."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
