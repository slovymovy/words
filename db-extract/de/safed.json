                    {
                        "sense_id": "5f0aebe5-4260-3900-b740-9aa1a8aada09",
                        "entry_id": "459947e1-3d49-38ad-a24b-f9522813fb84",
                        "glosses": [
                            "kleinere Stadt im Nordosten Israels"
