                        "form": "den Vogelgesang"
                    },
                    {
                        "form_id": "0673378f-bd0d-43b5-b4a5-165bb25dcc23",
                        "entry_id": "aae3dd8e-2b27-3f6c-99ce-9d86a591fc2c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Vogelgesänge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                        "entry_id": "aae3dd8e-2b27-3f6c-99ce-9d86a591fc2c",
                        "glosses": [
                            "Zwitschern, Piepen, Trällern von Vögeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71468087-7031-4a5c-b3eb-b28c5261ff14",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„Die ersten Vogelgesänge, die im ausgehenden Winter zu hören sind, sind die der Amsel. Und wie sie singt!“"
                            },
                            {
                                "example_id": "6d7f8f55-5dec-4e9d-a68b-8baa51faef67",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "[…] „Geben Amseln frühmorgens laut und ausdauernd alles, ist das für einige Menschen kein melodiöser Vogelgesang, sondern nerviges Gezwitscher.“"
                            },
                            {
                                "example_id": "d74ce646-af2a-405d-b2d9-3a9c5865ca16",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "[Schlagzeile:] „Wie der Vogelgesang sich in den letzten Jahren verändert hat“"
                            },
                            {
                                "example_id": "5b780b49-cc85-4bfc-af16-5e9202413fe1",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„Beim ersten Vogelgesang in der Früh und am Abend ist das Rotkehlchen ganz vorne mit dabei. Hier umgarnen die Weibchen die Männchen.“"
                            },
                            {
                                "example_id": "99675160-20a8-45a7-8ede-d59729643aed",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„Vogelgesang gilt als einer der grundlegenden Momente, in denen der Mensch mit der Natur in Kontakt kommt. Weniger Vogelgesang bedeutet ihm zufolge [Anmerkung: dem Studienhauptautor Dr. Simon Butler] Abstriche von Wohlbefinden und Gesundheit für Menschen.“"
                            },
                            {
                                "example_id": "51fbaabd-62ee-4b03-8ead-1456299c4a72",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„»Es gibt wissenschaftliche Untersuchungen, dass sich Vogelbeobachtungen sehr positiv auf das Wohlbefinden auswirken«, so Münchberger. Vogelgesang reduziere beispielsweise psychischen Stress.“"
                            },
                            {
                                "example_id": "be03e83a-226d-4c88-9f83-55e6db080eae",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„Zumindest bei gesunden Menschen können Ängstlichkeit und Paranoia abnehmen, wenn sie Vogelgesang hören.“"
                            },
                            {
                                "example_id": "5d008787-c00a-486f-8fd1-5a1b92281317",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„Der Frühling wird stummer - Vogelgesänge werden leiser und eintöniger.“"
                            },
                            {
                                "example_id": "c848b57c-054a-449f-870b-7bc3cd681b73",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "[Die Vogelerkennungs-App] „spuckt nach wenigen Sekunden aufgenommenen Vogelgesangs die Wahrheit aus: Es war die Lerche und nicht die Nachtigall.“"
                            },
                            {
                                "example_id": "ffe31140-f99c-49ef-af17-487fde610fd9",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„Wir müssen das Mikrophon unseres Telefons in Richtung Vogelgesang halten und 10 Sekunden möglichst ruhig bleiben. Der «Zwitsch-o-mat» analysiert das Gehörte und zeigt uns dann den Vogel, der gesungen hat.“"
                            },
                            {
                                "example_id": "8784d289-edc1-467c-82bd-1da032ada0b6",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "[Laienforscher] „hatten Aufnahmen der Vogelgesänge zu dem 20-jährigen Forschungsprojekt beigesteuert und damit die entscheidende Vorarbeit für die nun veröffentlichte Studie geleistet.“"
                            },
                            {
                                "example_id": "391f3dff-e1f5-4998-892e-608b68981a1e",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„Das Gezwitscher fasziniert Menschen seit jeher und seit Jahrhunderten sind Vogelgesänge Teil musikalischer Werke. Egal ob in Händels „sweet bird“, Saint-Saens „Karneval der Tiere“, Vivaldis „Vier Jahreszeiten“, Mozarts „Zauberflöte“ oder Strawinskys „Feuervogel“ – sie alle haben sich vom Gesang der Vögel inspirieren lassen.“"
                            },
                            {
                                "example_id": "4bae9e45-8b93-42b2-b0ac-1731e18f2cdf",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„In der Musik schriftloser Kulturen finden sich Anklänge an den Vogelgesang mit seinen Ton- und Tongruppenwiederholungen, Tonreihen und Motiven.“"
                            },
                            {
                                "example_id": "1f4e4e20-4b09-4752-b5c3-7de8ccfa1230",
                                "sense_id": "ce3d0797-33b7-3e28-be55-5bef342a6f50",
                                "text": "„Berühmt sind Jacob van Eycks virtuose Variationen über das Lied Engels Nachtegaeltje („Englische Nachtigall“) für Blockflöte, in denen stellenweise auch bereits Imitationen des Vogelgesangs anklingen (veröffentlicht 1644–1656 im Fluyten Lust-hof).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
