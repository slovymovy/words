                {
                    "sense_id": "282a3963-0e8e-3579-92cf-bb2ae4aba36f",
                    "sense_definition": "A line defining the side boundary of a playing field.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sports_boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player stepped on the <w>sideline</w> and the referee blew the whistle."
                        },
                        {
                            "text": "The ball rolled across the <w>sideline</w> during the intense match."
                        }
                    ],
                    "synonyms": [
                        "touchline"
                    ],
                    "common_phrases": [
