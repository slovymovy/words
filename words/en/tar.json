                },
                {
                    "sense_id": "1545ae78-d98c-368e-baad-022258707335",
                    "sense_definition": "A computer program used to archive multiple files into one.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Use the <w>tar</w> command to combine these files into a single archive.",
                            "target_lang_translations": {
                                "ru": "Используйте команду <w>tar</w>, чтобы объединить эти файлы в единый архив."
                            }
                        },
                        {
                            "text": "The system administrator used <w>tar</w> to back up the server data.",
                            "target_lang_translations": {
                                "ru": "Системный администратор использовал <w>tar</w> для резервного копирования данных сервера."
                            }
