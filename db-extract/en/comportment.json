    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e85b48d6-a127-3b29-9249-ebfb6e29281f",
                "word": "comportment",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "079f721c-e0b6-470a-b1b3-d0239e49ccb9",
                        "entry_id": "e85b48d6-a127-3b29-9249-ebfb6e29281f",
                        "tags": [
                            "plural"
                        ],
                        "form": "comportments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb8f8cea-8175-391e-91cb-7ec6ddb0eca6",
                        "entry_id": "e85b48d6-a127-3b29-9249-ebfb6e29281f",
                        "glosses": [
                            "The manner in which one behaves or conducts oneself."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "82c1fef4-2f76-34d5-827b-416732c61e4d",
                        "entry_id": "e85b48d6-a127-3b29-9249-ebfb6e29281f",
                        "glosses": [
                            "Deportment, bearing."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b66acbb6-9e5b-4201-95a0-31cc0e5330bb",
                        "source_entry_id": "e85b48d6-a127-3b29-9249-ebfb6e29281f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "comportement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comportement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b19a6187-8429-3efb-8467-fadf39f385a5",
                                        "entry_id": "51154b7f-5d20-3712-b5cc-5264bb727873",
                                        "glosses": [
                                            "Manière de se comporter ; attitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "650d6260-f11f-4684-a479-0677af68b780",
                                                "sense_id": "b19a6187-8429-3efb-8467-fadf39f385a5",
                                                "text": "Sa générosité n’est pas faiblesse ; son obligeance ne dépasse pas les obligations normales et naturelles ; aucune arrière-pensée en son comportement."
                                            },
                                            {
                                                "example_id": "452c5e40-70ae-4731-a0d4-0d328c89eb85",
                                                "sense_id": "b19a6187-8429-3efb-8467-fadf39f385a5",
                                                "text": "Ces principales causes nous rappellent que le comportement humain est à l’origine d’une majorité des collisions mortelles et avec blessés graves."
                                            },
                                            {
                                                "example_id": "bb5bce87-371b-4e05-af34-ba04df87b03b",
                                                "sense_id": "b19a6187-8429-3efb-8467-fadf39f385a5",
                                                "text": "Semblable à beaucoup de ces entrepreneurs dopés à l’hyper-croissance, Cyborg génère par atavisme, mimétisme cupide, conviction idiote ou crainte pleutre, un comportement déviant auprès de ses plus proches cadres."
                                            },
                                            {
                                                "example_id": "627b5ab5-4fb7-4498-b548-24de7c57d125",
                                                "sense_id": "b19a6187-8429-3efb-8467-fadf39f385a5",
                                                "text": "Négligés par les béhavioristes, l'instinct, la pensée, la perception, la complexité des motivations réinterfèrent dans l'étude des comportements et de l'apprentissage qui en dépend."
                                            },
                                            {
                                                "example_id": "80ab8b21-d6bd-4ac6-b7ec-e43247e4b9b6",
                                                "sense_id": "b19a6187-8429-3efb-8467-fadf39f385a5",
                                                "text": "Débusquer les bases biologiques d’un comportement n’enlève rien à l’humanisme du geste ni au libre arbitre : nous demeurons toujours libres de choisir entre un geste altruiste ou égoïste."
                                            },
                                            {
                                                "example_id": "4126f1d5-18f3-4f73-ae2d-034fad784fd7",
                                                "sense_id": "b19a6187-8429-3efb-8467-fadf39f385a5",
                                                "text": "Au delà de 10⁷ Hz, la masse des électrons est elle-même trop importante pour que ceux-ci puissent suivre l’excitation, et le matériau a alors un comportement diélectrique semblable à celui du vide."
                                            },
                                            {
                                                "example_id": "dc98680b-2fc5-423e-b850-4a7e71e647ee",
                                                "sense_id": "b19a6187-8429-3efb-8467-fadf39f385a5",
                                                "text": "Les joueurs de football professionnels sont assistés par des diététiciens, des psychologues, etc., mais aucune attention n'est accordée à leur comportement dans la circulation"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa85d4e9-5c80-4b4e-a588-e12eecaee263",
                        "source_entry_id": "e85b48d6-a127-3b29-9249-ebfb6e29281f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "Verhältnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verhältnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3f1627cb-6dfb-3df5-bb12-97e8edc34e21",
                                        "entry_id": "c9c861ed-7a60-395c-b293-783c746bfbdf",
                                        "glosses": [
                                            "eine Beziehung, bei der zwei Dinge oder zwei Sachverhalte miteinander verglichen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "887fb5c4-9c10-47bc-a765-ced67800f557",
                                                "sense_id": "3f1627cb-6dfb-3df5-bb12-97e8edc34e21",
                                                "text": "Diese beiden Größen stehen in einem umgekehrt proportionalen Verhältnis zueinander."
                                            },
                                            {
                                                "example_id": "bb6d0dfa-ded9-466f-8fad-10f4a373cf49",
                                                "sense_id": "3f1627cb-6dfb-3df5-bb12-97e8edc34e21",
                                                "text": "Im Verhältnis zwischen zweien ist das Verhältnis das Dritte als negative Einheit, und die zwei verhalten sich zum Verhältnis und im Verhältnis zum Verhältnis; so ist unter der Bestimmung Seele das Verhältnis zwischen Seele und Leib ein Verhältnis."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3b1c213-67d8-3e14-a82b-aa786b40b8f8",
                                        "entry_id": "c9c861ed-7a60-395c-b293-783c746bfbdf",
                                        "glosses": [
                                            "persönliche Beziehung zweier Menschen oder Gruppen von Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7d276c8-d0f9-4fed-8d2b-63eccaf94485",
                                                "sense_id": "c3b1c213-67d8-3e14-a82b-aa786b40b8f8",
                                                "text": "Ihr Verhältnis zueinander war von großem Vertrauen geprägt."
                                            },
                                            {
                                                "example_id": "ce354af7-8a60-4514-92b5-8a1ae35e630f",
                                                "sense_id": "c3b1c213-67d8-3e14-a82b-aa786b40b8f8",
                                                "text": "„Was diesen Entschluß erleichterte, war das schlechte Verhältnis zu Bruder Adolf und seiner Frau Johanne.“"
                                            },
                                            {
                                                "example_id": "e0be41e5-2678-40ee-8683-615f354315e9",
                                                "sense_id": "c3b1c213-67d8-3e14-a82b-aa786b40b8f8",
                                                "text": "„Doch obwohl viele Fans das innige Verhältnis der Hauptfiguren liebten, zeigte eine Psychologin nun auf, dass die abgebildete Beziehung in Wahrheit eine ernstzunehmende Persönlichkeitsstörung ist.“"
                                            },
                                            {
                                                "example_id": "c96183bb-d5c8-4c97-a337-092bd09f885b",
                                                "sense_id": "c3b1c213-67d8-3e14-a82b-aa786b40b8f8",
                                                "text": "„Falladas Verhältnis zu ihm ist kollegial, aber nicht herzlich.“"
                                            },
                                            {
                                                "example_id": "e83f4927-51ac-4ceb-8bc4-d7740b4bf91b",
                                                "sense_id": "c3b1c213-67d8-3e14-a82b-aa786b40b8f8",
                                                "text": "„Vergessen haben die Iren das Verhalten der Engländer während der Kartoffelpest nie. Das schon vorher angespannte Verhältnis zwischen Iren und Engländern schlug nach der Hungersnot in offenen Hass gegen alles Englische um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8a20bac4-445f-3cd7-8b6e-a9298946a149",
                                        "entry_id": "c9c861ed-7a60-395c-b293-783c746bfbdf",
                                        "glosses": [
                                            "intime Beziehung zwischen zwei Menschen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0971fa63-d052-4199-a548-a3ada9babc5d",
                                                "sense_id": "8a20bac4-445f-3cd7-8b6e-a9298946a149",
                                                "text": "Wusstest du nicht, dass die beiden ein Verhältnis miteinander haben?"
                                            },
                                            {
                                                "example_id": "9a9b7447-e7f8-49b9-a27d-535c273f3d91",
                                                "sense_id": "8a20bac4-445f-3cd7-8b6e-a9298946a149",
                                                "text": "\"Warum soll eine Frau kein Verhältnis haben? (Chanson gesungen von Marlene Dietrich)"
                                            },
                                            {
                                                "example_id": "fed15392-2a12-4626-9a64-9c36b15afb03",
                                                "sense_id": "8a20bac4-445f-3cd7-8b6e-a9298946a149",
                                                "text": "„Evas Verhältnis ist nach Brüssel, da kann sie die Mietze zu sich einladen und ihr alles zeigen, wie es bei ganz feinen Leuten ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d55ff84f-5108-34cf-bd7f-d96fc9ecc1d4",
                                        "entry_id": "c9c861ed-7a60-395c-b293-783c746bfbdf",
                                        "glosses": [
                                            "Umschreibung einer bestimmten sozialen Lage oder bestimmter sozialer Lebensumstände"
                                        ],
                                        "tags": [
                                            "plural",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b1dd1e2-a006-4160-9b9d-4a825d078cb9",
                                                "sense_id": "d55ff84f-5108-34cf-bd7f-d96fc9ecc1d4",
                                                "text": "Die Verhältnisse ließen keine bessere Schulbildung der Kinder zu."
                                            },
                                            {
                                                "example_id": "a2f7e4a5-7bb7-4ea0-aee9-94a9378d1cf7",
                                                "sense_id": "d55ff84f-5108-34cf-bd7f-d96fc9ecc1d4",
                                                "text": "„Wegen der Erfahrungen mit galoppierender Inflation ist der Leitzins in Brasilien traditionell hoch und liegt nun bei acht Prozent, was für brasilianische Verhältnisse ein Rekordtief ist.“"
                                            },
                                            {
                                                "example_id": "c4ede8a2-6677-43c0-88bf-9f79bc1d1f42",
                                                "sense_id": "d55ff84f-5108-34cf-bd7f-d96fc9ecc1d4",
                                                "text": "Gut 20 Prozent aller Kinder in Deutschland leben laut einer Studie länger als fünf Jahre in armen Verhältnissen."
                                            },
                                            {
                                                "example_id": "061c0c77-ed64-4c1c-92cd-32a7ae6dd80d",
                                                "sense_id": "d55ff84f-5108-34cf-bd7f-d96fc9ecc1d4",
                                                "text": "„Auf alle Vorstellungen Denissows, er solle dableiben, antwortete Petja nur, er sei ebenso wie Dolochow an klare Verhältnisse und Gründlichkeit gewöhnt und tue nichts blindlings, und die Gefahr mache ihm nichts aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "06d7d912-c93b-42ff-acbc-344bad6e413f",
