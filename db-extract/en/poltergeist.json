            {
                "entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                "word": "poltergeist",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "976e5402-185a-4205-8305-63e40e52d516",
                        "entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "tags": [
                            "plural"
                        ],
                        "form": "poltergeists"
                    },
                    {
                        "form_id": "48f00533-db88-4a63-9c0e-e8f3b0e836e4",
                        "entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "tags": [
                            "plural"
                        ],
                        "form": "poltergeister"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                        "entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "glosses": [
                            "An unseen ghost which makes noises and causes disruption, especially by causing physical objects to move or fly about."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aaf2f9a9-de95-46e1-8e99-10de3add0121",
                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                "text": "A poltergeist haunts the house by moving objects around, making chain-rattling noises and throwing things."
                            },
                            {
                                "example_id": "95eb6569-fe22-4b2f-b0ba-83c9430ed796",
                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                "text": "The chapel is haunted by a demonic poltergeist."
                            },
                            {
                                "example_id": "1944fb72-fc56-4420-bbdf-afa838ad11f9",
                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                "text": "\"Perhaps even a small poltergeist might come your way. Any trifle would be welcome.\" His bull's bellow of laughter followed them into the lift."
                            },
                            {
                                "example_id": "57f40f4a-afee-43fe-b0d6-e118610aa773",
                                "sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                                "text": "I risk becoming nothing more than a common poltergeist wallowing in regrets and introspection and other terrible things."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "234defd1-a253-40b4-8960-43a5d504baac",
                        "source_entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "source_sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                        "source_sense_description": "disruptive ghost",
                        "target_lang_word": "poltergeist",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "caaf8309-985e-4660-a067-beae9c43a6c0",
                        "source_entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "source_sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                        "source_sense_description": "disruptive ghost",
                        "target_lang_word": "klopgeest",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "klopgeest",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b87a35b9-787d-35a2-9ef2-55cd428c2bdd",
                                        "entry_id": "6c768d1c-8ff3-356d-a529-a6f23cf13a42",
                                        "glosses": [
                                            "een geest die zich kenbaar zou maken door te kloppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31ff90fa-1c5c-401a-aecc-204244ae1a6f",
                                                "sense_id": "b87a35b9-787d-35a2-9ef2-55cd428c2bdd",
                                                "text": "Het klopgeestspektakel is waargebeurd, aldus Britse tabloids en Wan, die zijn filmset met wijwater liet zegenen. Maar de demon doet wat hij altijd doet: verstoppertje spelen, dan kinderen bang maken, dan gezinsleden overnemen en dan het halve huis slopen. Het kitchen sink-decor is nieuw; verder toont Wan vooral dat hij horror goed kan doseren, bereiden en serveren, ook zonder verse ingrediënten."
                                            },
                                            {
                                                "example_id": "a83f2303-bbd9-4c6e-b9b1-0321a7cc470f",
                                                "sense_id": "b87a35b9-787d-35a2-9ef2-55cd428c2bdd",
                                                "text": "'Ook de 'slachtoffers' van paranormale verschijnselen reageren vaak vijandig, zegt French. 'Het lijkt mij helemaal niet zo leuk om een klopgeest in je huis te hebben of door ufo's ontvoerd te zijn. Toch willen mensen helemaal niet horen dat er misschien een andere verklaring is voor hun verhaal. Ze voelen zich immers bijzonder door hun paranormale ervaring."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fbdc7a24-04df-45bf-b6f5-4e2d9547fc3f",
                        "source_entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "source_sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                        "source_sense_description": "disruptive ghost",
                        "target_lang_word": "poltergeest",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "37b2cb86-cf75-452c-b633-a36e7f366b16",
                        "source_entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "source_sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                        "source_sense_description": "disruptive ghost",
                        "target_lang_word": "esprit frappeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esprit frappeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7231fbb-21e1-3d5f-96d0-3353c53380b1",
                                        "entry_id": "f0c03586-e146-38a7-b109-773b4c06d1da",
                                        "glosses": [
                                            "Fantôme ou revenant invisibles qui se révèlent par des coups, qui répondent en frappant un certain nombre de coups."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5246326-5041-4507-9d9c-eb99b4384cd6",
                                                "sense_id": "c7231fbb-21e1-3d5f-96d0-3353c53380b1",
                                                "text": "Pinglet sort de la cheminée, la figure toute noire.\nPaillardin. — Ah ! un ramoneur ! (Pinglet lui envoie un coup de poing sur l’œil.) Oh !… (Pinglet lui allonge un coup de pied qui l’envoie sur le palier.) Oh ! Les esprits frappeurs ! C’est les esprits frappeurs !…"
                                            },
                                            {
                                                "example_id": "fd7e7112-741c-4a7c-bc9d-9909b858dfeb",
                                                "sense_id": "c7231fbb-21e1-3d5f-96d0-3353c53380b1",
                                                "text": "Les expériences menées dans certains laboratoires ne nous en ont pas assez appris sur la psychokinésie pour décider si oui ou non elle a un rapport quelconque avec les phénomènes des esprits frappeurs."
                                            },
                                            {
                                                "example_id": "f1399073-59d5-4983-8dbb-d1742ea9efdd",
                                                "sense_id": "c7231fbb-21e1-3d5f-96d0-3353c53380b1",
                                                "text": "Certaines nuits, donc, les murs de la villa de M. et Mᵐᵉ Bourdon se mirent à résonner sous les coups terrifiants d’un esprit frappeur si malin que personne ne put le localiser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a835c26-6ae4-3183-a26a-856dcbfee763",
                                        "entry_id": "f0c03586-e146-38a7-b109-773b4c06d1da",
                                        "glosses": [
                                            "Personne qui agit dans le dos des autres en provoquant un événement visible par tous."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44b59bd3-7ae6-4fe4-a66d-e30c026aba9f",
                                                "sense_id": "6a835c26-6ae4-3183-a26a-856dcbfee763",
                                                "text": "Les révélations de cet esprit frappeur provoquent de grands remous au sein de la communauté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f85ce0fa-f2ab-4b15-ab17-59557a54626c",
                        "source_entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "source_sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                        "source_sense_description": "disruptive ghost",
                        "target_lang_word": "poltergeist",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poltergeist",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "458de310-7c57-35b6-8d6b-096a0e5bfbdf",
                                        "entry_id": "edda3fcb-6a8e-392a-8bc3-90ca013657ad",
                                        "glosses": [
                                            "Fantôme bruyant, phénomène paranormal consistant en des bruits inexpliqués."
                                        ],
                                        "tags": [
                                            "Fantastique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42f7a235-8ff5-4760-b482-4a7a19ecbf2a",
                                                "sense_id": "458de310-7c57-35b6-8d6b-096a0e5bfbdf",
                                                "text": "Encore appelé Rumpelgeist, le poltergeist est essentiellement un « diable » , un « spectre » ou un revenant dans les écrits du XVIᵉ siècle, puis un lutin."
                                            },
                                            {
                                                "example_id": "44e0aa9d-879e-4092-922a-f701f001f226",
                                                "sense_id": "458de310-7c57-35b6-8d6b-096a0e5bfbdf",
                                                "text": "En Europe, le christianisme a contribué à distinguer le revenant de toutes les autres apparitions que l’on rencontre dans de nombreuses sociétés : spectres, fantômes, ombres, esprits, poltergeists, dames blanches, etc."
                                            },
                                            {
                                                "example_id": "cda18ab0-1f3a-4b03-b6ed-48578b8ca16d",
                                                "sense_id": "458de310-7c57-35b6-8d6b-096a0e5bfbdf",
                                                "text": "Il y était question, comme assez souvent dans ce type de magazines, de phénomènes paranormaux, conversations avec les morts, tables tournantes et poltergeists en tout genre, avec l’habituelle caution littéraire, le père Hugo en personne, appelé à la rescousse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96a49102-f273-4129-a8c5-9022e960f498",
                        "source_entry_id": "de9fd66a-7329-3171-b014-265d3d1c8704",
                        "source_sense_id": "b645550e-41f4-337e-aa45-3cc9df4849c5",
                        "source_sense_description": "disruptive ghost",
                        "target_lang_word": "Poltergeist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Poltergeist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e439f7e5-572e-336c-9181-033626f0185d",
                                        "entry_id": "b6247f46-d110-3ddb-ab49-43f28682b967",
                                        "glosses": [
                                            "ein fiktives Wesen, Geist, der in Häusern und Schlössern wohnt, dort — naturwissenschaftlich derzeit nicht erklärbar — herumpoltert, andere Geräusche erzeugt, elektrische Störungen hervorruft und Gegenstände bewegt"
                                        ],
                                        "tags": [
                                            "Parapsychologie",
                                            "Parawissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "710b402d-8ea2-4932-90af-bb16a3da8728",
                                                "sense_id": "e439f7e5-572e-336c-9181-033626f0185d",
                                                "text": "Der Poltergeist geht wieder um."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "480ea312-eb6a-3cac-9d88-7d3d86d41558",
                                        "entry_id": "b6247f46-d110-3ddb-ab49-43f28682b967",
                                        "glosses": [
                                            "Person oder Tier, das unerwünschten Lärm verursacht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7d0dc23-de2a-4b4d-82a5-5e148bc68e2c",
                                                "sense_id": "480ea312-eb6a-3cac-9d88-7d3d86d41558",
                                                "text": "Du bist heute ja wieder ein richtiger Poltergeist."
                                            },
                                            {
                                                "example_id": "7db6f9ea-70c3-4efc-9d53-6dbb34b928f5",
                                                "sense_id": "480ea312-eb6a-3cac-9d88-7d3d86d41558",
                                                "text": "Bei uns treibt ein Poltergeist unterm Dach sein Unwesen: ein Marder."
                                            },
                                            {
                                                "example_id": "3aec4c2d-eb0b-4195-a4a8-7a2570391873",
                                                "sense_id": "480ea312-eb6a-3cac-9d88-7d3d86d41558",
                                                "text": "„Draußen regen sich die Poltergeister.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4b7ac92b-9911-3f3f-ab8b-ac812860cc42",
                                        "entry_id": "b6247f46-d110-3ddb-ab49-43f28682b967",
                                        "glosses": [
                                            "Person mit ruppigem Auftreten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "256f6f07-dc92-4775-b5dd-77e98b3cdbf9",
                                                "sense_id": "4b7ac92b-9911-3f3f-ab8b-ac812860cc42",
                                                "text": "In der Versammlung produzierte er sich wieder als Poltergeist."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
