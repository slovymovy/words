                "senses": [
                    {
                        "sense_id": "5505f452-455d-375d-9a72-02ed230ad5fa",
                        "entry_id": "7173a495-04c7-3495-9765-400b65346e44",
                        "glosses": [
                            "Betriebsart des Waldes, bei der eine Kombination von aus Samen gewachsenem Hochwald und durch Stockausschlag verjüngtem Niederwald praktiziert wird"
                        ],
                        "tags": [
                            "Forstwirtschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "963a0c6d-b8c6-4a5a-a5c6-34b8ae6b0c60",
                                "sense_id": "5505f452-455d-375d-9a72-02ed230ad5fa",
                                "text": "„Der Mittelwald sei neben dem Nieder- und Hütewald eine sehr alte Waldbewirtschaftungsform, sagt Merten.“"
                            },
                            {
                                "example_id": "dc7430e1-353f-45af-b3d3-e7bcd3e9f5a8",
                                "sense_id": "5505f452-455d-375d-9a72-02ed230ad5fa",
                                "text": "„Im Mittelwald blieben die Hochstämme als Überhälter stehen, während die größeren Bäume im Niederwald fehlten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
