                "senses": [
                    {
                        "sense_id": "a6a1d5a6-c044-32bc-9ff1-13b169214efd",
                        "entry_id": "73f41737-cc6c-31c3-8449-3d86a3419f54",
                        "glosses": [
                            "Ort (meist Hafenanlage), an dem die Seestreitkräfte der Vereinigten Staaten Station bezogen haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322004f5-2945-40fd-8f2f-384b3dd0b2cb",
                                "sense_id": "a6a1d5a6-c044-32bc-9ff1-13b169214efd",
                                "text": "„Bei einer Schießerei auf der US-Marinebasis Norfolk sind zwei Menschen ums Leben gekommen.“"
                            },
                            {
                                "example_id": "be9c9b17-a054-4cd1-b686-80ff90c0f7b6",
                                "sense_id": "a6a1d5a6-c044-32bc-9ff1-13b169214efd",
                                "text": "„Durch ihre Lage auf halbem Weg nach Ostasien sind die Hawaii-Inseln der wichtigste pazifische Stützpunkt der USA; Honolulu ist Zwischenlandeplatz des interkontinentalen Luftverkehrs und Haupthafen (Kriegshafen Pearl Harbor, US-Marinebasis seit 1887).“"
                            },
                            {
                                "example_id": "b9ab792d-42b7-4f05-a1d0-71778ab939dc",
                                "sense_id": "a6a1d5a6-c044-32bc-9ff1-13b169214efd",
                                "text": "„Kaum einer begreift die Kritik, die sich in Europa an der Unterbringung der 158 Gefangenen in der US-Marinebasis Guantanamo Bay zusammenbraut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
