                "senses": [
                    {
                        "sense_id": "dd1091e3-b2b3-3a77-9542-ee11eaa560a6",
                        "entry_id": "be8e12b2-6c9f-3ab5-b53b-2e3dafb12708",
                        "glosses": [
                            "Sorte de chausson constitué d'une fine crêpe de pâte filo repliée ; ce chausson peut-être empli de divers aliments, généralement salés avec ou sans viande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7911ca8a-597e-4ca6-9b7d-e08e6e667380",
                                "sense_id": "dd1091e3-b2b3-3a77-9542-ee11eaa560a6",
                                "text": "La brick est une proposition intéressante qui peut se décliner selon les envies . Une enveloppe croustillante avec des fines couches de feuilles et une garniture avec une farce qui peut être coulante , épicée , crémeuse, …"
                            },
                            {
                                "example_id": "296c6a1e-34ae-445c-851f-36834d683208",
                                "sense_id": "dd1091e3-b2b3-3a77-9542-ee11eaa560a6",
                                "text": "Repliez la pâte sur les épinards en diagonal vers la droite, basculez le brick sur haut et sur la gauche, vers le haut et sur la droite, et ainsi de suite jusqu'au bout de la bande."
                            },
                            {
                                "example_id": "8d952ad9-650e-42ac-9408-71788e04c602",
                                "sense_id": "dd1091e3-b2b3-3a77-9542-ee11eaa560a6",
                                "text": "Retourner la brick pour faire dorer l'autre face. Laisser encore trente secondes."
                            }
                        ]
                    }
                ],
