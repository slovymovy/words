                "senses": [
                    {
                        "sense_id": "d44f5402-7152-324a-bfbb-5c59e230b2d8",
                        "entry_id": "44d78502-2b19-3f96-9932-d62708e4062a",
                        "glosses": [
                            "vom Arbeitgeber ausgestellte Urkunde für den Arbeitnehmer, die Informationen über das Arbeitsverhältnis enthält. Diese Urkunde wird meist bei der Kündigung des Arbeitsverhältnisses erstellt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87cd50b7-fe0c-4889-a9c2-729647a27aed",
                                "sense_id": "d44f5402-7152-324a-bfbb-5c59e230b2d8",
                                "text": "„Die Verwendung von Anführungszeichen, Fragezeichen und Ausrufezeichen in einem Arbeitszeugnis sind grundsätzlich geregelt.“"
                            },
                            {
                                "example_id": "a8a63091-08e2-4de9-98c5-19101fe607ed",
                                "sense_id": "d44f5402-7152-324a-bfbb-5c59e230b2d8",
                                "text": "„Das Letzte, das ich hineingelegt habe, war ein Arbeitszeugnis meines Vaters gewesen, ausgestellt vom Universitätsklinikum Hamburg-Eppendorf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
