                                                "sense_id": "e98fd913-918e-3d05-bd74-dad2bc538698",
                                                "text": "Schnell! Hol den Feuerlöscher, denn es brennt!"
                                            },
                                            {
                                                "example_id": "aec5624e-7ee7-4112-b5cf-401fa8694903",
                                                "sense_id": "e98fd913-918e-3d05-bd74-dad2bc538698",
                                                "text": "„Ein Mann stieg aus, der mit uns schimpfte, und mit einem Feuerlöscher Schaum auf das Feuer spritzte, bis es ausging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
