                "forms": [
                    {
                        "form_id": "5b71e00d-3fad-4fd5-a1a9-df78a3d8c71a",
                        "entry_id": "63788f31-7874-3447-add4-3db168e8b411",
                        "tags": [
                            "plural"
                        ],
                        "form": "percepts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8a05a8f-eacb-3a09-bd95-c1dac780d6f1",
                        "entry_id": "63788f31-7874-3447-add4-3db168e8b411",
                        "glosses": [
                            "Something perceived; the object of perception."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "de413199-36d5-41bb-b22d-969db070e3e5",
                                "sense_id": "e8a05a8f-eacb-3a09-bd95-c1dac780d6f1",
                                "text": "Whether it might not, in like manner, be proper to introduce the term percept for the object of perception, I shall not at present inquire."
                            }
                        ]
                    },
                    {
                        "sense_id": "82b815db-1745-3c83-848d-ed0ea518714e",
                        "entry_id": "63788f31-7874-3447-add4-3db168e8b411",
                        "glosses": [
                            "A perceived object as it exists in the mind of someone perceiving it; the mental impression that is the result of perceiving something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3984a920-9675-47f5-b84c-5ab72cf482e7",
                                "sense_id": "82b815db-1745-3c83-848d-ed0ea518714e",
                                "text": "I see an inkstand on the table: that is a percept. Moving my head, I get a different percept of the inkstand."
                            },
                            {
                                "example_id": "04772d37-08f7-4865-9c45-f3cf75cbaddf",
                                "sense_id": "82b815db-1745-3c83-848d-ed0ea518714e",
                                "text": "So far as in that world it is a stable feature, holds ink, marks paper and obeys the guidance of a hand, it is a physical pen. [...] So far as it is instable, on the contrary, coming and going with the movements of my eyes, altering with what I call my fancy, continuous with subsequent experiences of its ‘having been’ (in the past tense), it is the percept of a pen in my mind."
                            },
                            {
                                "example_id": "71a94da8-9fdd-4c4c-91be-310caac79240",
                                "sense_id": "82b815db-1745-3c83-848d-ed0ea518714e",
                                "text": "Socrates remarks that when he is well he finds wine sweet, but when ill, sour. Here it is a change in the percipient that causes the change in the percept."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
