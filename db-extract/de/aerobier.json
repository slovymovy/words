                                        "glosses": [
                                            "Qui a besoin d’air pour vivre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93f3f8c1-a4cd-4a33-ad5b-e73764910a7b",
                                                "sense_id": "cd6c7168-cd6c-368e-87cb-35f0d06551d7",
                                                "text": "Microbe aérobie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14ed1b0e-a7ec-3feb-844b-0e552121db3d",
                                        "entry_id": "b873901f-edcf-3b8e-9648-c1801b36350d",
                                        "glosses": [
                                            "Relatif à une activité biologique qui demande de l'oxygène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4ed497e-c6c6-4124-924a-f23167e71a50",
                                                "sense_id": "14ed1b0e-a7ec-3feb-844b-0e552121db3d",
                                                "text": "Fermentation aérobie."
                                            },
                                            {
                                                "example_id": "7d49170e-c314-4e47-99ff-12be4530fde0",
                                                "sense_id": "14ed1b0e-a7ec-3feb-844b-0e552121db3d",
                                                "text": "L’inertie du métabolisme aérobie joue un rôle important dans la mesure où sa vitesse d'adaptation favorise la récupération."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aérobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e243518-780a-382f-ab74-fc5ba31dd824",
                                        "entry_id": "dda69810-11da-3813-8b9e-0b82442b1cd4",
                                        "glosses": [
                                            "Individu appartenant à la catégorie des microbes aérobies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d09ab20-da35-481e-978f-007ed10e6a21",
                                                "sense_id": "0e243518-780a-382f-ab74-fc5ba31dd824",
                                                "text": "Les ferments de la caséine sont de deux espèces :\n1. Les aérobies qui ont besoin d’air pour se développer.\n2. Les anaérobies qui peuvent vivre […] sans air."
                                            },
                                            {
                                                "example_id": "7f3a77a5-2dd5-4bd3-999b-6106793c7d4e",
                                                "sense_id": "0e243518-780a-382f-ab74-fc5ba31dd824",
                                                "text": "Le bacille du charbon a besoin d'oxygène pour se développer ; c’est un aérobie strict."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
