                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The preschool teacher greeted every little <w>munchkin</w> at the front door."
                        },
                        {
                            "text": "Picture this: your child begins his first day of childcare, and he is suddenly surrounded by other <w>munchkins</w> his age."
                        }
                    ],
                    "synonyms": [
