                    {
                        "sense_id": "32a48f11-ec78-3eab-a62a-46819dd13339",
                        "entry_id": "5f398df9-6238-3aab-aeca-9d2d78cdc01b",
                        "glosses": [
                            "To disarm; to soften."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d9e1b609-925d-4acc-8eee-1f23e98345f2",
                                "sense_id": "32a48f11-ec78-3eab-a62a-46819dd13339",
                                "text": "Thou hast his conqu’ring Sword unsteel’d,\nHis Valour turn’d to shameful Flight."
                            },
                            {
                                "example_id": "4e3687ca-d9dc-43e8-ad60-c43607050f83",
                                "sense_id": "32a48f11-ec78-3eab-a62a-46819dd13339",
                                "text": "Why then should this enervating pity unsteel my foolish heart?"
                            },
                            {
                                "example_id": "803dbb41-c54b-4dd3-be32-8c19cad38b39",
                                "sense_id": "32a48f11-ec78-3eab-a62a-46819dd13339",
                                "text": "The more we drown the disabled in tea and lip gratitude the more we unsteel his soul, and the harder we make it for him to win through, when, in the years to come, the wells of our tea and gratitude have dried up."
                            }
                        ]
                    }
                ],
