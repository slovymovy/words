                    },
                    {
                        "translation_id": "a5b3c435-87a3-40ae-b2fd-eec036729908",
                        "source_entry_id": "bfb062aa-fbb1-3398-a510-42d7aaaaef2b",
                        "source_sense_description": "место, помещение, где зимуют люди",
                        "target_lang_word": "Winterlager",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Winterlager",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6e32809-9e0c-3a89-a1d7-fc473547f92b",
                                        "entry_id": "fdfb8610-8895-39d1-8920-da17aa926a58",
                                        "glosses": [
                                            "provisorisch errichtete Unterkunft für den Winter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a702da-0867-49d9-810d-5f7c7f24ec0c",
                                                "sense_id": "b6e32809-9e0c-3a89-a1d7-fc473547f92b",
                                                "text": "„Kapitän Crozier ließ niemanden im Stich; er hielt das Winterlager und zwang die Männer durch strengen Befehl, den eklen Seetang zu kauen, auch wenn der Magen sich umkehrte.“"
                                            },
                                            {
                                                "example_id": "eb38acb8-b09c-470e-9d09-46219ca45180",
                                                "sense_id": "b6e32809-9e0c-3a89-a1d7-fc473547f92b",
                                                "text": "„Waren die nicht viel zu spät dran mit dem Auspolstern ihrer Winterlager, fragte ich mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d47afe57-7a3c-44a3-8d03-022180b67515",
                        "source_entry_id": "bfb062aa-fbb1-3398-a510-42d7aaaaef2b",
                        "source_sense_description": "место, помещение, где зимуют люди",
                        "target_lang_word": "Winterhütte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "8b8d0c00-cb77-49de-8050-5aa6f95d7591",
                        "source_entry_id": "bfb062aa-fbb1-3398-a510-42d7aaaaef2b",
                        "source_sense_description": "место, помещение, где зимуют люди",
                        "target_lang_word": "lieu d'hivernage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7c2b1eea-ec00-42dd-8635-df00e3a9bffb",
                        "source_entry_id": "bfb062aa-fbb1-3398-a510-42d7aaaaef2b",
                        "source_sense_description": "место зимовки животных, рыб",
                        "target_lang_word": "winter quarters",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "winter quarters",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ef87173-580f-3197-8dac-70ae70ed0862",
                                        "entry_id": "7ec54142-f350-3c56-8898-fa9ca04a51b0",
                                        "glosses": [
                                            "A place where a wild animal goes to live or hibernate in the winter; hibernacle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fa9511d-c0cf-46cd-8d34-80110a1ada77",
                                                "sense_id": "1ef87173-580f-3197-8dac-70ae70ed0862",
                                                "text": "In the fall, when the weather begins to get cool, the boll weevils leave the fields and go into winter quarters."
                                            },
                                            {
                                                "example_id": "fa5fb293-d0e7-4359-8aec-296cc6a8d483",
                                                "sense_id": "1ef87173-580f-3197-8dac-70ae70ed0862",
                                                "text": "The present one shows a lot more interest in paved streets and granite skyscrapers than in the dry leaves and rocks and underbrush where foxes, wolves and weasels once had winter quarters."
                                            },
                                            {
                                                "example_id": "ced481cc-8eb1-4880-b082-6ca6b9c2c1b4",
                                                "sense_id": "1ef87173-580f-3197-8dac-70ae70ed0862",
                                                "text": "In winter, evening bats depart for winter quarters and probably hibernate, although Lowery (1974) obtained records of active individuals in Louisiana in every month except February and December."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "94cb227b-7de2-3fdb-88ef-687a7ea17927",
                                        "entry_id": "7ec54142-f350-3c56-8898-fa9ca04a51b0",
                                        "glosses": [
                                            "A place where a farmer, beekeeper, nurseryman, etc. moves their charges in the winter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c577d16f-63e1-4319-bff5-c8bc444acdf6",
                                                "sense_id": "94cb227b-7de2-3fdb-88ef-687a7ea17927",
                                                "text": "It is usually a month later than this, and sometimes two months later before we put them into winter quarters. Supposing some of our best bee-keepers place a few colonies in winter quarters now and just about the last couple of favorable days before they put the rest into winter quarters, place part of them out on their summer stands and give them a fly, leaving the remainder in, and see how they winter. We are pretty well convinced that we have been in the habit of setting bees into winter quarters too late."
                                            },
                                            {
                                                "example_id": "35bcd669-f29b-4b59-8719-e87974afa105",
                                                "sense_id": "94cb227b-7de2-3fdb-88ef-687a7ea17927",
                                                "text": "The pullets should be carefully selected and placed in their winter quarters early in October."
                                            },
                                            {
                                                "example_id": "985d5290-2cd8-4cca-a109-310c63087972",
                                                "sense_id": "94cb227b-7de2-3fdb-88ef-687a7ea17927",
                                                "text": "Whenever possible, during the fall and winter, the cows with calves by their side and yearlings were cut out of the main herd and placed in winter quarters where they have been fed daily."
                                            },
                                            {
                                                "example_id": "3aa2faf5-e8fa-4049-8004-aa4492f44ca9",
                                                "sense_id": "94cb227b-7de2-3fdb-88ef-687a7ea17927",
                                                "text": "The shorter the stay in their winter quarters which rarely offer optimal conditions – the less the plants will be weakened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "450d78ea-e9d1-3789-a8c3-62b9cfccf5a8",
                                        "entry_id": "7ec54142-f350-3c56-8898-fa9ca04a51b0",
                                        "glosses": [
                                            "A more permanent location where a group that normally moves around, such as an army, circus, group of explorers, etc., takes time off to shelter for the winter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6d9df63-65f9-4162-9c81-a28097ed9fcc",
                                                "sense_id": "450d78ea-e9d1-3789-a8c3-62b9cfccf5a8",
                                                "text": "to go into winter quarters"
                                            },
                                            {
                                                "example_id": "d90cae7b-6e8b-4916-90ce-d8e23380cda5",
                                                "sense_id": "450d78ea-e9d1-3789-a8c3-62b9cfccf5a8",
                                                "text": "On the 8th we changed our camp again into the woods near Brandy Station and Mountain Run, where we expected to go into winter quarters."
                                            },
                                            {
                                                "example_id": "9df93781-8f5f-4e36-8aa0-481063acb978",
                                                "sense_id": "450d78ea-e9d1-3789-a8c3-62b9cfccf5a8",
                                                "text": "The regiment made camp at Tennallytown, and in October was ordered to Langley, Virginia, where it went into winter quarters."
                                            },
                                            {
                                                "example_id": "7263a35f-8d98-437f-9dc8-46b5cd8c1b62",
                                                "sense_id": "450d78ea-e9d1-3789-a8c3-62b9cfccf5a8",
                                                "text": "Moving northwest into present Mississippi, the explorer set up winter quarters."
                                            },
                                            {
                                                "example_id": "f7e0111f-c900-4595-8166-0e42a0ca7294",
                                                "sense_id": "450d78ea-e9d1-3789-a8c3-62b9cfccf5a8",
                                                "text": "While searching for winter quarters, a group of gypsies celebrates the birth of a new chief and discovers why a former chief disappeared."
                                            },
                                            {
                                                "example_id": "b35ebfc7-01a0-4d18-b5cb-a9c32e14bcea",
                                                "sense_id": "450d78ea-e9d1-3789-a8c3-62b9cfccf5a8",
                                                "text": "Bridgeport, Connecticut, winter quarters of the Barnum & Bailey Circus, became its second home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d4b1951-e4c3-37db-a465-48b3e4769c45",
                                        "entry_id": "7ec54142-f350-3c56-8898-fa9ca04a51b0",
                                        "glosses": [
                                            "A place where someone spends one or more winters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cd8c7a6-9590-4e0d-9394-c44fe7084696",
                                                "sense_id": "6d4b1951-e4c3-37db-a465-48b3e4769c45",
                                                "text": "But the attempt which has often been made to prove that summer is as favourable a season as winter, and that invalids are extremely foolish to leave their winter quarters at the approach of spring, seems to us most injudicious."
                                            },
                                            {
                                                "example_id": "cd051354-218e-43ea-a87e-02965e588c48",
                                                "sense_id": "6d4b1951-e4c3-37db-a465-48b3e4769c45",
                                                "text": "Finally, and of greatest importance, are those groups of population which live a nomadic life and move from their winter quarters to summer quarters and back again regularly each year."
                                            },
                                            {
                                                "example_id": "71471d01-a3ab-4b1e-a90f-cc9754b5c335",
                                                "sense_id": "6d4b1951-e4c3-37db-a465-48b3e4769c45",
                                                "text": "Conversely, winter residence away from the village may have involved only the occupation of winter quarters, without the period of mobile hunting which preceded it."
                                            },
                                            {
                                                "example_id": "24bffd24-2928-42e4-81fa-64f7abfcbdc9",
                                                "sense_id": "6d4b1951-e4c3-37db-a465-48b3e4769c45",
                                                "text": "But since this project, to which my attention was called by that now universal source of information, advertisements, has been alluded to, do you mind telling me why you called our delightful sojourn in a Tuscan villa overlooking Florence my winter-quarters rather than the Poet's winter-quarters, or Veronica's, or, for that matter, even yours?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
