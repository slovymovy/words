                "senses": [
                    {
                        "sense_id": "bcd9ac76-e20f-36d1-9fee-c747266a484c",
                        "entry_id": "404786db-92a1-3cfb-8e81-bc0e04ac27d3",
                        "glosses": [
                            "Sportler, der den Eiskunstlauf ausübt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa5baf38-bef0-4b9e-b465-00535490e85e",
                                "sense_id": "bcd9ac76-e20f-36d1-9fee-c747266a484c",
                                "text": "Der Eiskunstläufer beeindruckte das Publikum mit seinen Pirouetten."
                            },
                            {
                                "example_id": "0b62bd66-429e-46f0-98d2-635a6469bffe",
                                "sense_id": "bcd9ac76-e20f-36d1-9fee-c747266a484c",
                                "text": "„Bei Zirkusakrobaten, Kunstturnern, Eiskunstläufern, Kunstfliegern werden Vertigoerlebnisse Teil einer künstlerischen Gesamtleistung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21f4e989-8743-4b95-8043-471e1deff732",
                        "source_entry_id": "404786db-92a1-3cfb-8e81-bc0e04ac27d3",
                        "source_sense_id": "bcd9ac76-e20f-36d1-9fee-c747266a484c",
                        "source_sense_description": "Sportler, der den Eiskunstlauf ausübt",
                        "target_lang_word": "фигурист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фигурист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0d25fd1d-0711-3319-b341-4cddaa9b6ab1",
                                        "entry_id": "7f2b49cd-9fba-3474-b7e3-4a57b2839280",
                                        "glosses": [
                                            "спортсмен, занимающийся фигурным катанием на коньках"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f096de-4e92-4417-86e4-5223ebec5962",
                                                "sense_id": "0d25fd1d-0711-3319-b341-4cddaa9b6ab1",
                                                "text": "Мы беседовали во Дворце ЦСКА, где в этот момент уже тренировались фигуристы, и время от времени кто-нибудь из них, подъезжая близко к нам, махал Третьяку рукой, приветствуя его, и мчался дальше, но он лишь один раз отвлекся от разговора и ответил на приветствие."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
