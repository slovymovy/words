        "fr-extract.jsonl": [
            {
                "entry_id": "6e6b689a-c215-384f-bb9a-54b74248c2c6",
                "word": "faction",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ad896f3e-c032-4fb2-b43a-1a6e1c52272c",
                        "entry_id": "6e6b689a-c215-384f-bb9a-54b74248c2c6",
                        "tags": [
                            "plural"
                        ],
                        "form": "factions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03ec378d-ec26-307f-8e2e-68ae0734314e",
                        "entry_id": "6e6b689a-c215-384f-bb9a-54b74248c2c6",
                        "glosses": [
                            "Action ou tâche quelconque qu'un soldat est en charge de faire."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "91e69d6b-ad6f-4642-986e-4ddb24cf7780",
                                "sense_id": "03ec378d-ec26-307f-8e2e-68ae0734314e",
                                "text": "Il a été chargé d'une faction de garde."
                            }
                        ]
                    },
                    {
                        "sense_id": "f16a0f5f-60e1-3411-a05c-38f3bdea7414",
                        "entry_id": "6e6b689a-c215-384f-bb9a-54b74248c2c6",
                        "glosses": [
                            "Guet que font successivement les soldats d’un poste."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "28d12d89-cf05-4406-aa77-780797e36466",
                                "sense_id": "f16a0f5f-60e1-3411-a05c-38f3bdea7414",
                                "text": "Être en faction, de faction."
                            },
                            {
                                "example_id": "8a8bc825-60ea-409e-aa20-35c829eade9f",
                                "sense_id": "f16a0f5f-60e1-3411-a05c-38f3bdea7414",
                                "text": "C’est mon tour de faction."
                            },
                            {
                                "example_id": "c0c1ae01-7efe-462f-a296-f5596bcfb8d3",
                                "sense_id": "f16a0f5f-60e1-3411-a05c-38f3bdea7414",
                                "text": "Arnoux sauta par terre ; et, le vin blanc étant pris, voulut monter la faction de Frédéric."
                            },
                            {
                                "example_id": "9c10568d-d987-4d65-8997-3925e0e756df",
                                "sense_id": "f16a0f5f-60e1-3411-a05c-38f3bdea7414",
                                "text": "Vraiment, sans le drapeau qui flotte à la crête du toit, sans les deux soldats en faction devant la grille, jamais on ne se croirait au quartier général."
                            },
                            {
                                "example_id": "bf143614-ed52-4711-a3c8-d45bea9a066e",
                                "sense_id": "f16a0f5f-60e1-3411-a05c-38f3bdea7414",
                                "text": "Tu veilleras en faction devant la porte des bals où tes officiers vendent aux enchères leurs grâces d’étalons, où ces hommes entretenus, débattent le tarif de leurs charmes à travers les musiques langoureuses et les tièdes parfums."
                            }
                        ]
                    },
                    {
                        "sense_id": "cec5712c-3b46-3ef7-9bdd-735c2d2bfa7f",
                        "entry_id": "6e6b689a-c215-384f-bb9a-54b74248c2c6",
                        "glosses": [
                            "Action de se tenir dans un endroit pour guetter ou attendre quelqu’un ou quelque chose, à propos de toute personne."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "6bfd10a1-daf6-4493-928b-6f711ef94d21",
                                "sense_id": "cec5712c-3b46-3ef7-9bdd-735c2d2bfa7f",
                                "text": "Je me suis mis en faction devant sa porte."
                            },
                            {
                                "example_id": "b6aef5a6-395d-4982-8a48-790dd7e1988d",
                                "sense_id": "cec5712c-3b46-3ef7-9bdd-735c2d2bfa7f",
                                "text": "Seulement, pour adoucir l’ennui de la faction, Athos lui permit d’emporter un pain, deux côtelettes et une bouteille de vin."
                            }
                        ]
                    },
                    {
                        "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                        "entry_id": "6e6b689a-c215-384f-bb9a-54b74248c2c6",
                        "glosses": [
                            "Parti politique ou civil qui cherche à provoquer des troubles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7e7eff3-2ddf-4f35-9dd6-6d659ce791fd",
                                "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                                "text": "Une faction puissante conspire avec les tyrans de l’Europe pour nous donner un roi, avec une espèce de constitution aristocratique."
                            },
                            {
                                "example_id": "0eb9c28b-181d-4bc7-93e7-9d09048daebd",
                                "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                                "text": "— Elle se jetait bravement dans les disputes de ses oncles, prenait parti dans les factions, prêtait un intérêt extrême à tout ce qui concernait la tribu Aupetit."
                            },
                            {
                                "example_id": "e657d9ab-8794-4406-bb5a-d636e974ddec",
                                "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                                "text": "Sous le couvert d’une blessure ressentie, certaines factions de la société québécoise voudraient faire taire la majorité dans l’expression de ses valeurs."
                            },
                            {
                                "example_id": "08cc62bb-d576-4c2c-8452-7f11a34ac278",
                                "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                                "text": "Ils sont divisés, partagés en plusieurs factions."
                            },
                            {
                                "example_id": "eca35c8d-cbfa-4747-b6db-dc6713fa7f95",
                                "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                                "text": "La faction qui lui était opposée."
                            },
                            {
                                "example_id": "ddf27d6b-7008-4027-8f07-982b8cc83e2a",
                                "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                                "text": "Se mettre à la tête d’une faction."
                            },
                            {
                                "example_id": "41930e1d-794f-40b2-964a-cd1abe963845",
                                "sense_id": "895a9c36-573d-3cdb-836a-463d3cd33105",
                                "text": "Un état déchiré par les factions."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fb14e93-9fdd-3ba1-865b-457de2cf132c",
                        "entry_id": "6e6b689a-c215-384f-bb9a-54b74248c2c6",
                        "glosses": [
                            "Groupement dans une assemblée."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "94c394a0-dc84-4106-8efe-698e7f98c682",
                                "sense_id": "6fb14e93-9fdd-3ba1-865b-457de2cf132c",
                                "text": "Au Conclave, la faction de la France prévalut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "399dd4ab-5dc2-4ee1-879e-aa80236ef7e4",
                        "source_entry_id": "6e6b689a-c215-384f-bb9a-54b74248c2c6",
                        "source_sense_description": "parti politique, groupe",
                        "target_lang_word": "faction",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cf79eed-9a8d-31ee-a1ab-5b306d14dc4d",
                                        "entry_id": "d14bc415-b0ff-3ae5-baf3-8c108e50559a",
                                        "glosses": [
                                            "A group of people, especially within a political organization, which expresses a shared belief or opinion different from people who are not part of the group."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf3c4cf0-e568-4795-a5ea-4168daa08d59",
                                                "sense_id": "5cf79eed-9a8d-31ee-a1ab-5b306d14dc4d",
                                                "text": "Real factions may be divided into those from interest, from principle, and from affection"
                                            },
                                            {
                                                "example_id": "712183ea-8efa-43f5-807c-93c14d6bc1b2",
                                                "sense_id": "5cf79eed-9a8d-31ee-a1ab-5b306d14dc4d",
                                                "text": "Prejudice has bred a counterprejudice so that now neither faction can nor will see without distortion."
                                            },
                                            {
                                                "example_id": "ea585313-f37f-4ed6-845d-0de6278f9afa",
                                                "sense_id": "5cf79eed-9a8d-31ee-a1ab-5b306d14dc4d",
                                                "text": "The Chinese Communist army in Kiangsi province has split into two factions struggling against each other following the purge of the \"gang of four\" led by Chiang Ching, according to an intelligence report from the Chinese mainland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6941886-3e6f-37a9-9c4b-c04e003a4535",
                                        "entry_id": "d14bc415-b0ff-3ae5-baf3-8c108e50559a",
                                        "glosses": [
                                            "Strife; discord."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6a0f34-26a9-4037-b24f-b3edb0820576",
                                                "sense_id": "f6941886-3e6f-37a9-9c4b-c04e003a4535",
                                                "text": "Publick [sic] affairs soon fell into the utmost confusion, and in this state of faction and perplexity, the island continued, until its re-capture by the French in 1779."
                                            },
                                            {
                                                "example_id": "af86e353-8294-42ac-b014-ce5a5c019251",
                                                "sense_id": "f6941886-3e6f-37a9-9c4b-c04e003a4535",
                                                "text": "He asks the audience if they believe that they will be more loved by the gods if the city is in a state of faction than if they govern the city with good order and concord."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "faction",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d7a16fd6-b7e6-3312-b445-195b0bd39a44",
                                        "entry_id": "30c4bd1c-2952-39bf-93b6-37f4e4fc2bf4",
                                        "glosses": [
                                            "A form of literature, film etc., that treats real people or events as if they were fiction; a mix of fact and fiction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36cb462e-a956-4932-9f84-d1b1b4cf68b6",
                                                "sense_id": "d7a16fd6-b7e6-3312-b445-195b0bd39a44",
                                                "text": "Near-synonym: fictionalization"
                                            },
                                            {
                                                "example_id": "390b6247-5918-4995-8315-b154d34deff8",
                                                "sense_id": "d7a16fd6-b7e6-3312-b445-195b0bd39a44",
                                                "text": "Blind genius of faction / Obituary of Jorge Luis Borges, Argentine writer [title]"
                                            },
                                            {
                                                "example_id": "5b66b814-6205-4a33-b896-1fb42b41b6f2",
                                                "sense_id": "d7a16fd6-b7e6-3312-b445-195b0bd39a44",
                                                "text": "Contemporary reviewers offered different labels in attempts to describe the genre of Schindler's List. Lorna Sage, D.J. Enright and Robert Taubman called it a ‘documentary novel’; Paul Bailey and Gay Firth ‘faction’; […]"
                                            },
                                            {
                                                "example_id": "4c99bbad-8d88-484e-849c-e18fcaaa5e82",
                                                "sense_id": "d7a16fd6-b7e6-3312-b445-195b0bd39a44",
                                                "text": "[Norman Mailer] was, though, absolutely the daddy of faction, his novels or journalism reporting every conflict from 1939 to Iraq and biographising Americans including John F Kennedy, Marilyn Monroe, Muhammad Ali and Neil Armstrong."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b28b8b76-764d-3cf5-9017-d7bddcb34548",
                                        "entry_id": "30c4bd1c-2952-39bf-93b6-37f4e4fc2bf4",
                                        "glosses": [
                                            "The facts found in fiction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
