                                    {
                                        "sense_id": "7b189d47-0751-3a63-8c19-2c3e73f7cbb8",
                                        "entry_id": "7ee21655-973a-36d1-aab2-22c5cef19ddd",
                                        "glosses": [
                                            "Relatif à la trinité des chrétiens ou des hindous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "426d68f1-746d-437b-9373-ef07e50043e0",
                                                "sense_id": "7b189d47-0751-3a63-8c19-2c3e73f7cbb8",
                                                "text": "Réciproquement, la même distinction permettait de réfuter les objections contre le dogme trinitaire des trois Personnes en un seul Dieu."
                                            },
                                            {
                                                "example_id": "3f28b705-8fbe-4a8c-a8df-3733aeda3a5f",
                                                "sense_id": "7b189d47-0751-3a63-8c19-2c3e73f7cbb8",
                                                "text": "Cependant, perçu par une pensée pure, Dieu est trinitaire dans chaque expression de l’univers. Telles sont les religions trinitaires comme l’hindouisme, (Brahman, Vishnou, Shiva) et telle est la Trinité du christianisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67985d05-d760-3c61-836c-6e3b13e93204",
                                        "entry_id": "7ee21655-973a-36d1-aab2-22c5cef19ddd",
                                        "glosses": [
                                            "Relatif à La Trinité, commune des Alpes-Maritimes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
