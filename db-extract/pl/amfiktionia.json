                "senses": [
                    {
                        "sense_id": "313bcd9a-7954-3849-b90e-c52f1db574f9",
                        "entry_id": "7887e023-7b5e-3da8-8d25-d7ada328d815",
                        "glosses": [
                            "starożytna liga plemienna lub związek miast-państw w Grecji, utworzony w celu wspólnej ochrony świątyń, organizowania obrzędów religijnych oraz podejmowania decyzji politycznych w sprawach regionalnych"
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "cdd088bc-c365-4661-a176-4e62edb5fabb",
                                "sense_id": "313bcd9a-7954-3849-b90e-c52f1db574f9",
                                "text": "Do najsłynniejszych amfiktionii należała liga delfijska opiekująca się świątynią Apollina w Delfach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "233a86b2-b094-430e-85c7-eda63dab5963",
