                        "glosses": [
                            "Person, die in der Marsch lebt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be30c082-69e5-4532-94c4-acc81dd6e8f9",
                                "sense_id": "7d98832f-f782-3b0e-91ed-2136d5895f39",
                                "text": "„Für die Zeit um Christi Geburt liefert die Siedlungsarchäologie die wichtigsten Befunde zum Küstenverlauf und zu den Meeresspiegelbewegungen sowie zur Siedlungs- und Alltagsgeschichte der Marschbewohner.“"
                            },
                            {
                                "example_id": "51d67d46-6205-432f-b0e6-3e65eac1d4fe",
                                "sense_id": "7d98832f-f782-3b0e-91ed-2136d5895f39",
                                "text": "„An diesem Zustand hat sich erst dann etwas verändert, als die Marschbewohner seit etwa der Mitte des 19. Jahrh. begonnen haben, zunehmend und energisch ihren Grund und Boden der Marsch stärker und besser zu entwässern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
