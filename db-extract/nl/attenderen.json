                "senses": [
                    {
                        "sense_id": "9bb61ef9-9bef-363b-9d28-6e53a67c1595",
                        "entry_id": "c137f43a-5472-3b0e-a389-e8413837b0aa",
                        "glosses": [
                            "opmerkzaam maken, wijzen op, attent maken op"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "971b02b6-22f9-412f-92bc-049ee4634cb8",
                                "sense_id": "9bb61ef9-9bef-363b-9d28-6e53a67c1595",
                                "text": "Terwijl ze verder las, attendeerde een duivels stemmetje fijntjes op haar zwakheden."
                            },
                            {
                                "example_id": "11c374f3-5e5b-450e-8b8d-f27406f66c9f",
                                "sense_id": "9bb61ef9-9bef-363b-9d28-6e53a67c1595",
                                "text": "Tibetanen die het Westen komen laten zien hoe rijk hun cultuur is, en ze doen dat om de Europeanen te attenderen op hun treurige lot: al bijna veertig jaar worden ze gesard door de Chinezen."
                            }
                        ]
                    }
                ],
