        "fr-extract.jsonl": [
            {
                "entry_id": "ac458051-0338-369d-9784-93ae56a2e1f1",
                "word": "incinération",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "60567066-6fe0-4c0e-aa2a-dde4cc16dba0",
                        "entry_id": "ac458051-0338-369d-9784-93ae56a2e1f1",
                        "tags": [
                            "plural"
                        ],
                        "form": "incinérations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5280da6a-14fa-3fac-89b8-01576f1d0d56",
                        "entry_id": "ac458051-0338-369d-9784-93ae56a2e1f1",
                        "glosses": [
                            "Action de réduire en cendres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f0035d-8be5-45cd-bbf9-d9af0e10dfc4",
                                "sense_id": "5280da6a-14fa-3fac-89b8-01576f1d0d56",
                                "text": "Pour les installations d'incinération de déchets non dangereux de capacité supérieure à 3 tonnes par heure et les installations d'incinération de déchets dangereux de capacité supérieure à 10 tonnes par jour, les exploitants déclarent les rejets annuels dans l'atmosphère des polluants suivants : …"
                            },
                            {
                                "example_id": "b8fb3b93-045c-4bf4-843d-6419f214e61e",
                                "sense_id": "5280da6a-14fa-3fac-89b8-01576f1d0d56",
                                "text": "L'acier peut également être obtenu par déferraillage des cendres d’incinération, mais avec une perte liée à l'oxydation pendant la combustion. La production d’acier à partir de ces ferrailles récupérées nécessite deux fois moins d’énergie que la fabrication à partir de minerai […]."
                            },
                            {
                                "example_id": "99350146-c595-4482-a0bf-cf132718da17",
                                "sense_id": "5280da6a-14fa-3fac-89b8-01576f1d0d56",
                                "text": "Par exemple, le verre des bouteilles et des bocaux se recycle pratiquement à l'infini. Au-delà de 2% d'indésirables (bouchons, couvercles, bouteilles en faïence), le lot est non conforme et déclassé. Les déchets refusés –les refus de tri– partent alors en centres d' incinération."
                            }
                        ]
                    },
                    {
                        "sense_id": "3aa24779-5f6e-3805-955f-64ffb92b534c",
                        "entry_id": "ac458051-0338-369d-9784-93ae56a2e1f1",
                        "glosses": [
                            "Action de brûler les morts pour les réduire en cendres."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "cf805379-3fc6-4fa7-b238-f6a646fa38f2",
                                "sense_id": "3aa24779-5f6e-3805-955f-64ffb92b534c",
                                "text": "L’incinération des morts était en usage dans l’antiquité."
                            },
                            {
                                "example_id": "d16199c1-bcea-4fde-aed6-c60e35b02084",
                                "sense_id": "3aa24779-5f6e-3805-955f-64ffb92b534c",
                                "text": "Plusieurs fois à Paris, il avait assisté à des incinérations ; la dernière était celle d’un camarade des Beaux-arts, qui avait été tué dans un accident d’avion lors de ses vacances à Lombok ; il avait été choqué que certains des assistants n’aient pas éteint leur portable au moment de la crémation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e1f7d0c-894d-44c5-95bb-6219a42c1e6a",
                        "source_entry_id": "ac458051-0338-369d-9784-93ae56a2e1f1",
                        "target_lang_word": "Feuerbestattung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feuerbestattung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6b91fabd-3cdc-3a71-ad12-3fe9eaf4ed93",
                                        "entry_id": "8b06dcce-dbac-3952-abcc-6e4237ac88e6",
                                        "glosses": [
                                            "Veraschung einer Leiche, mit anschließender Beisetzung der Asche in einer Urne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f8ade4b-8e86-464f-bb01-5637a15ffe96",
                                                "sense_id": "6b91fabd-3cdc-3a71-ad12-3fe9eaf4ed93",
                                                "text": "Nicht jeder ist mit einer Feuerbestattung einverstanden."
                                            },
                                            {
                                                "example_id": "2e55540c-534b-48a8-abb2-2eb2751a2631",
                                                "sense_id": "6b91fabd-3cdc-3a71-ad12-3fe9eaf4ed93",
                                                "text": "Feuerbestattungen waren früher auf der Basis eines Kirchengebotes untersagt."
                                            },
                                            {
                                                "example_id": "9c66f694-f55e-466f-95f2-3ac645179b59",
                                                "sense_id": "6b91fabd-3cdc-3a71-ad12-3fe9eaf4ed93",
                                                "text": "„Neben der Feuerbestattung kannten die Kelten auch die Körperbestattung.“"
                                            },
                                            {
                                                "example_id": "8fcc9641-92e4-468c-8211-94b198aea837",
                                                "sense_id": "6b91fabd-3cdc-3a71-ad12-3fe9eaf4ed93",
                                                "text": "„Bundesminister Dr. Richard Schmitz hatte Reumann am 16. Dezember 1922 davon in Kenntnis gesetzt, dass er die Feuerbestattung in Österreich verbiete.“"
                                            },
                                            {
                                                "example_id": "a4f63937-49b3-4b0b-a3d7-0299fa8514f8",
                                                "sense_id": "6b91fabd-3cdc-3a71-ad12-3fe9eaf4ed93",
                                                "text": "„Als Jude darf meine Leiche eigentlich nicht eingeäschert werden, aber ich bin Reformjude und möchte eine Feuerbestattung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
