                "translations": [
                    {
                        "translation_id": "69d34367-31db-48e2-b6ce-b55998e35713",
                        "source_entry_id": "6785d0a2-225c-31d9-b4a3-91aba1808805",
                        "source_sense_id": "61192637-8196-3006-9e77-fa7210ba3574",
                        "source_sense_description": "weich und/oder glatt wie Samt; samtig, samtweich",
                        "target_lang_word": "samtig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "samtig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d362be73-a27c-3c4e-93a9-a100b68f1c2f",
                                        "entry_id": "1b4a1629-543a-3f43-bff4-ff4f0eaa2a0d",
                                        "glosses": [
                                            "weich und zart wie Samt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b78dc7f0-b39b-42e4-8e32-b9e989f42093",
                                                "sense_id": "d362be73-a27c-3c4e-93a9-a100b68f1c2f",
                                                "text": "Samtige Roben mit Trompetenärmeln wehen im Rhythmus von Schwinghammers Anweisungen über das zerkratzte Parkett."
                                            },
                                            {
                                                "example_id": "a7105957-737f-4433-a5f4-ac8967f41bcd",
                                                "sense_id": "d362be73-a27c-3c4e-93a9-a100b68f1c2f",
                                                "text": "Das Liftangebot wird seit der Erschließung stetig verbessert und erweitert und bietet heute von der knackigen FIS-Abfahrt über die familienfreundliche Pistenautobahn bis zur samtig weichen Gletscherpiste für jeden Anspruch das passende Gelände."
                                            },
                                            {
                                                "example_id": "d1518c58-8a01-4c68-bccd-d080b2c4f00f",
                                                "sense_id": "d362be73-a27c-3c4e-93a9-a100b68f1c2f",
                                                "text": "Auch ob diese herrliche Pflanze mit den helllindgrünen, samtigen und mit großer Eleganz an den Rändern gezackten Blättern tatsächlich zur Familie Plectranthus, den Harfensträuchern, gehört, weiß ich ehrlich gestanden nicht genau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "26191dc0-b7fc-3d83-b7d5-59091bb2134f",
                                        "entry_id": "1b4a1629-543a-3f43-bff4-ff4f0eaa2a0d",
                                        "glosses": [
                                            "weich, dunkel tönend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "facd02d1-95d7-4933-ae75-e1f9cc892618",
                                                "sense_id": "26191dc0-b7fc-3d83-b7d5-59091bb2134f",
                                                "text": "Ihre Stimme ist samtig, sexy und irgendwie nach wie vor jugendlich."
                                            },
                                            {
                                                "example_id": "a62630ae-3581-495b-80e6-671bd7c6bd49",
                                                "sense_id": "26191dc0-b7fc-3d83-b7d5-59091bb2134f",
                                                "text": "Auch das namenlose Mädchen (Julia Uttendorfer), das ihn mit samtig-weicher Stimme für sich gewinnen will, scheitert an Beckmanns Erinnerungen und Schuldgefühlen."
                                            },
                                            {
                                                "example_id": "bc1a96d2-15e8-4810-803e-a86233e7cf75",
                                                "sense_id": "26191dc0-b7fc-3d83-b7d5-59091bb2134f",
                                                "text": "Überhaupt ist bei aller grundsätzlichen Leichtigkeit des Nackten und Reduzierten, sowohl bei den Bildern als auch den Möbeln, ein Hang zu schwerer, samtiger Theatralik bemerkbar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6801709a-9401-4aae-8f7b-c769d49dd277",
                        "source_entry_id": "6785d0a2-225c-31d9-b4a3-91aba1808805",
