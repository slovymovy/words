                                "target_senses": [
                                    {
                                        "sense_id": "60f316fe-78b5-3c9c-b831-d37a83795859",
                                        "entry_id": "4cb9acd0-7323-3aa7-adf5-58970f501ab1",
                                        "glosses": [
                                            "Verzeichnis, in dem alle Flurstücke nach ihrer Lage, Nutzung, Größe und so weiter verzeichnet und kartographisch dargestellt sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bf36141-6e30-4b52-8258-17ea014e3f9a",
                                                "sense_id": "60f316fe-78b5-3c9c-b831-d37a83795859",
                                                "text": "Die dauernde Festlegung und Dokumentation der Grundstücksgrenze geschieht im Kataster."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9688f2e-e4ce-344d-adfb-759cb6937f0f",
                                        "entry_id": "4cb9acd0-7323-3aa7-adf5-58970f501ab1",
                                        "glosses": [
                                            "andere Verzeichnisse, in denen Stoffe, Objekte oder Lebewesen erfasst und kategorisiert werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e433916-8a52-4a65-9aa6-628b6b4f49b3",
                                                "sense_id": "d9688f2e-e4ce-344d-adfb-759cb6937f0f",
                                                "text": "Auch jede andere systematische Erfassung und Aufstellung kann als Kataster bezeichnet werden, etwa ein Baumkataster oder Weinkataster."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af0d16fd-d883-4e5c-b053-d653e31b55b1",
                        "source_entry_id": "c5248238-84b5-3c89-8438-7da9f6571af8",
