                        "glosses": [
                            "Cépage blanc, originaire de la région de l'Hermitage (côtes du Rhône)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b06a94a7-b935-4d07-966f-c56fd7c26555",
                                "sense_id": "746a7a11-6b1b-3fe6-a2ed-d079621bd352",
                                "text": "Comme les autres cépages de la région, la marsanne fait partie de la famille des serines."
                            },
                            {
                                "example_id": "66ba0fc2-cdec-4533-bc32-227b9b0240ab",
                                "sense_id": "746a7a11-6b1b-3fe6-a2ed-d079621bd352",
                                "text": "Le Méal (rouge et blanc) provient d’un illustre coteau orienté plein sud, avec des limons éoliens sur le haut du coteau, des galets roulés et des sédiments dans le bas. Les syrahs y sont opulentes, suaves ; les marsannes puissantes en alcool et miellées."
                            }
                        ]
