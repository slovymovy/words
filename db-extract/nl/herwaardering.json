                        "examples": [
                            {
                                "example_id": "b0965fd4-60f5-40ee-a8e3-0082485a0876",
                                "sense_id": "5591070d-e839-3a3b-af40-b73f14d4383a",
                                "text": "Een terugblik op wat er toen, jaren terug, aan verschrikkelijks gebeurd is. Een herwaardering van het verdriet, zoals het achteraf wordt ervaren."
                            },
                            {
                                "example_id": "b10f0c6f-19ed-4d00-a6b3-286e9d7ebc6b",
                                "sense_id": "5591070d-e839-3a3b-af40-b73f14d4383a",
                                "text": "Er moet meer aandacht komen voor buitengebieden, vinden de architecten. De 'herwaardering van het platteland' is volgens Koolhaas belangrijker dan ooit. Dit is bovendien het moment om met een visie te komen, vindt hij, want die is er nu niet."
                            }
