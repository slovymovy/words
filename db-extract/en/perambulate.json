                    },
                    {
                        "form_id": "86410b92-8c02-4527-8ba4-6bdb5fd39e12",
                        "entry_id": "b4286662-76ca-3fe2-b980-e5d6465c8b96",
                        "tags": [
                            "past"
                        ],
                        "form": "perambulated"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d262bb8-76b7-31e3-9c1b-c384027a600c",
                        "entry_id": "b4286662-76ca-3fe2-b980-e5d6465c8b96",
                        "glosses": [
                            "To walk about, roam or stroll; to ambulate."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "90cbcd93-8066-44ee-bdaa-bcbd2a5faab7",
                                "sense_id": "4d262bb8-76b7-31e3-9c1b-c384027a600c",
                                "text": "Take, for instance, one of the most wretched classes of the community, the poor fellows who perambulate the streets as Sandwich Men. These are farmed out by certain firms."
                            },
                            {
                                "example_id": "d9f3759f-0f5e-49d5-87ec-29e89196ba99",
                                "sense_id": "4d262bb8-76b7-31e3-9c1b-c384027a600c",
                                "text": "They dragged themselves from the swamp singly, and in twos and threes, more dead than alive, mere perambulating skeletons, until at last there were thirty of us."
                            }
                        ]
                    },
                    {
                        "sense_id": "fac91471-0c40-38e3-a362-8fa8dcc41c5a",
                        "entry_id": "b4286662-76ca-3fe2-b980-e5d6465c8b96",
                        "glosses": [
                            "To inspect (an area) on foot."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d21891b5-7cb1-48e4-83eb-e0d98022c12a",
                                "sense_id": "fac91471-0c40-38e3-a362-8fa8dcc41c5a",
                                "text": "The officials, in their gowns of grey, with a white St. Andrew’s cross on back and breast, and a white cloth carried before them on a staff, perambulated the city, adding the terror of man’s justice to the fear of God’s visitation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a6e3ed9-90ef-4030-8fef-f3c820d195c4",
                        "source_entry_id": "b4286662-76ca-3fe2-b980-e5d6465c8b96",
                        "source_sense_description": "roam, stroll",
                        "target_lang_word": "durchreisen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durchreisen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "000483f2-31dd-318f-b7b8-b81b3d5bd80b",
                                        "entry_id": "fb39ea39-6790-3258-8f68-d89c56aaf897",
                                        "glosses": [
                                            "ein Land, ein Gebiet oder einen Ort reisend durchqueren"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7938001a-2c46-44bc-95a5-9bbaa2d14a7f",
                                                "sense_id": "000483f2-31dd-318f-b7b8-b81b3d5bd80b",
                                                "text": "„Sie durchreisten zwei Jahre das Land und gründeten sich als reformierte Band unter dem Namen Ifang Bondi erneut.“"
                                            },
                                            {
                                                "example_id": "b4ad0a4d-ee26-45a5-847d-cf26e99bfec2",
                                                "sense_id": "000483f2-31dd-318f-b7b8-b81b3d5bd80b",
                                                "text": "„Welche Stadt oder welches Land er auch durchreist, Marco Polo legt eine systematische Karteikarte an, auf der er mit größter Sorgfalt sämtliche wissenschaftlichen Daten festhält, um all jenen zu Hilfe zu kommen, die sich eines Tages auf seine Spuren begeben wollen.“"
                                            },
                                            {
                                                "example_id": "9554df6b-c55b-44b8-bb96-a744df60ce11",
                                                "sense_id": "000483f2-31dd-318f-b7b8-b81b3d5bd80b",
                                                "text": "„Er war der beispielhafte Reporter seiner Zeit, der die Welt durchreiste und alles beschrieb, was er sah, hörte, roch, schmeckte.“"
                                            },
                                            {
                                                "example_id": "6430cd25-a40b-45db-bb2e-e5a6dc3bcde5",
                                                "sense_id": "000483f2-31dd-318f-b7b8-b81b3d5bd80b",
                                                "text": "„Sie durchreisten das Land, und nahmen die Zahl des Volkes auf.“"
                                            },
                                            {
                                                "example_id": "bb476f03-da49-47e0-9d5e-523917e3ecba",
                                                "sense_id": "000483f2-31dd-318f-b7b8-b81b3d5bd80b",
                                                "text": "„Er durchreiste auf diese Art Peru und Mexiko, und unterwarf der Krone, ohne Soldaten, eine große Landschaft, die darnach Vera Paz benant wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "durchreisen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c4e96fb2-4647-3868-8079-c5764ea4f15b",
                                        "entry_id": "7334a56f-6544-30f6-b92a-c59ae701fa06",
                                        "glosses": [
                                            "durch einen Ort oder ein Gebiet ohne (längere) Unterbrechung reisen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0590f932-4ae5-4634-be65-4ae7ecee56a7",
                                                "sense_id": "c4e96fb2-4647-3868-8079-c5764ea4f15b",
                                                "text": "„Ob er dort tatsächlich Aufenthalt fand oder nur durchreiste, ob er einen Asylantrag gestellt hat oder nicht, ob ein solcher Antrag anerkannt oder abgelehnt wurde – es ist ohne Belang.“"
                                            },
                                            {
                                                "example_id": "792ef6cb-14e7-4953-9214-20441339590a",
                                                "sense_id": "c4e96fb2-4647-3868-8079-c5764ea4f15b",
                                                "text": "„Er reiste durch ganz Mittelamerika, immer auf der Suche nach dem großen Abenteuer, bis er endlich nach Kuba kam.“"
                                            },
                                            {
                                                "example_id": "aa4183cc-0e67-4158-9124-feecb29a1789",
                                                "sense_id": "c4e96fb2-4647-3868-8079-c5764ea4f15b",
                                                "text": "„Von Haag kehrten sie nach Paris zurück, reisten durch Lyon und die Schweiz nach Teutschland, und kamen im November 1766, nach einer Abwesenheit von mehr als drei Jahren, wieder in Salzburg an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "814cf821-cd08-4f67-9e39-d52f3871f30f",
                        "source_entry_id": "b4286662-76ca-3fe2-b980-e5d6465c8b96",
                        "source_sense_description": "roam, stroll",
                        "target_lang_word": "przechadzać się",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "przechadzać się",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "bdeb0ce4-6705-3ed4-89af-03e226648602",
                                        "entry_id": "3c5f816b-13c4-3b46-bf0b-8294fa9894f3",
                                        "glosses": [
                                            "odbywać przechadzkę"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe8a8191-2410-4775-83e1-f88d69aa5db2",
                                                "sense_id": "bdeb0ce4-6705-3ed4-89af-03e226648602",
                                                "text": "Gdy zaś mężczyzna i jego żona usłyszeli kroki Pana Boga przechadzającego się po ogrodzie, w porze kiedy był powiew wiatru, skryli się przed Panem Bogiem wśród drzew ogrodu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f0c1817b-6d21-434c-aa43-ab048a905a9f",
                        "source_entry_id": "b4286662-76ca-3fe2-b980-e5d6465c8b96",
                        "source_sense_description": "roam, stroll",
                        "target_lang_word": "бродить",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бродить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "17d7d363-a1b4-3362-b92c-0effd153260f",
                                        "entry_id": "b2437007-cded-3b07-8f54-e1bd1d286517",
                                        "glosses": [
                                            "медленно ходить, не придерживаясь определённого направления (о движении, совершаемом неоднократно или не в определённом направлении, в отличие от сходного по смыслу гл. брести)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fb0a650-dd35-48b0-a9da-6fdba1898261",
                                                "sense_id": "17d7d363-a1b4-3362-b92c-0effd153260f",
                                                "text": "Он снова принялся бродить по квартире, полосатой дорожкой прошёл к запертой на два замка, обитой дерматином двери, повернул назад."
                                            },
                                            {
                                                "example_id": "4e663475-1128-47ca-9a9d-35b76d2e320b",
                                                "sense_id": "17d7d363-a1b4-3362-b92c-0effd153260f",
                                                "text": "Я люблю в такую погоду бродить по лесу, особенно когда впереди есть тёплый уголок, где можно обсушиться и обогреться."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2929cde-feb5-3b74-bd42-18dd4a4db56f",
                                        "entry_id": "b2437007-cded-3b07-8f54-e1bd1d286517",
                                        "glosses": [
                                            "перен., разг. распространяться случайным образом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b15c075-3bcd-4702-b8de-f2c71356d29f",
                                                "sense_id": "c2929cde-feb5-3b74-bd42-18dd4a4db56f",
                                                "text": "Когда начался «перестроечный процесс», стали бродить идеи всевозможных объединений во имя выживания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c399a424-78bd-33a5-a822-1ebd7aef2444",
                                        "entry_id": "b2437007-cded-3b07-8f54-e1bd1d286517",
                                        "glosses": [
                                            "перен. вести кочевой или бродячий образ жизни"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95057f0d-d4c9-4ea9-8d08-742c3660cd91",
                                                "sense_id": "c399a424-78bd-33a5-a822-1ebd7aef2444",
                                                "text": "Ушёл бродить по свету."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "167b8402-2520-3edc-944c-72ba1942be24",
                                        "entry_id": "b2437007-cded-3b07-8f54-e1bd1d286517",
                                        "glosses": [
                                            "перен. книжн. скользить, тихо передвигаться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ddb090-58a3-4349-94e1-c07790c79adc",
                                                "sense_id": "167b8402-2520-3edc-944c-72ba1942be24",
                                                "text": "По лицу ее бродила улыбка."
                                            },
                                            {
                                                "example_id": "7d20fdf9-4e7e-4b00-a42e-adbf90a10fe8",
                                                "sense_id": "167b8402-2520-3edc-944c-72ba1942be24",
                                                "text": "Туман бродил по ущелью."
                                            },
                                            {
                                                "example_id": "872bc4cf-45a0-4aea-a87a-f4c637078cc5",
                                                "sense_id": "167b8402-2520-3edc-944c-72ba1942be24",
                                                "text": "Неверная, кто смеет / Пылающей рукой / Бродить по груди страстной…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "бродить",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6f8e6fc3-d4ae-3005-baeb-c69c80cf4900",
                                        "entry_id": "71b5cabe-e0e7-31ad-a031-04727a864aaf",
                                        "glosses": [
                                            "находиться в состоянии брожения, ферментироваться, закисать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9289db9b-e378-4806-ac22-1b32704ac090",
                                                "sense_id": "6f8e6fc3-d4ae-3005-baeb-c69c80cf4900",
                                                "text": "Теперь сок будет бродить в бутыли."
                                            },
                                            {
                                                "example_id": "6735acf0-816a-465b-a18f-52c1bb0f238b",
                                                "sense_id": "6f8e6fc3-d4ae-3005-baeb-c69c80cf4900",
                                                "text": "Оказывается, рис сначала варят до полуготовности, потом его жуют и выплёвывают в бочку, где всё это должно бродить."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
