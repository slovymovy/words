                "senses": [
                    {
                        "sense_id": "041f6751-42ff-3b40-be60-86226f0bf0d0",
                        "entry_id": "f4c47bfa-89bd-3ada-ad57-2b764f87b11a",
                        "glosses": [
                            "Herbe des prés où sont mis les animaux pour les engraisser."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9859f505-3c4d-3e66-9a7f-de14a7eb9318",
                        "entry_id": "f4c47bfa-89bd-3ada-ad57-2b764f87b11a",
                        "glosses": [
                            "Prairie naturelle ou artificielle, permanente ou temporaire, pâturée par le bétail, servant à l'engraissement."
                        ],
                        "tags": [
                            "Agronomie"
                        ],
                        "examples": [
                            {
                                "example_id": "154c74c0-d0b0-4bef-a597-cb811f6e1bfe",
                                "sense_id": "9859f505-3c4d-3e66-9a7f-de14a7eb9318",
                                "text": "Au lieu d’améliorer les cultures, on s’y obstine encore aux herbages."
                            },
                            {
                                "example_id": "f7136faa-8eb9-4d45-b50c-d28bdf225401",
                                "sense_id": "9859f505-3c4d-3e66-9a7f-de14a7eb9318",
                                "text": "Une plaine s’étendait à droite ; à gauche un herbage allait doucement rejoindre une colline, où l’on apercevait des vignobles, des noyers, un moulin dans la verdure, […]."
                            },
                            {
                                "example_id": "bebccdbd-91ca-4deb-a7c1-662d1ac1b2ca",
                                "sense_id": "9859f505-3c4d-3e66-9a7f-de14a7eb9318",
                                "text": "Portés, au galop d'abord, puis au trot par Eponine et Sultan, ils ont gagné le plateau et les herbages de Saint-Marc-Jaumegarde où ils ont rencontré, à la sortie du village et dans son domaine, le sieur Aurélien Fontenac éleveur de chevaux, cavalier émérite et maître de manège : « […] »."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c4366b7-04cb-34ab-b361-c2fd9563bfa2",
                        "entry_id": "f4c47bfa-89bd-3ada-ad57-2b764f87b11a",
                        "glosses": [
                            "Toutes sortes d’herbes bonnes à cueillir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "635feb85-e035-49ca-b536-fc2a19508441",
                                "sense_id": "0c4366b7-04cb-34ab-b361-c2fd9563bfa2",
                                "text": "Vivre d’herbages."
                            }
                        ]
                    }
