                        "examples": [
                            {
                                "example_id": "5498c6d4-7249-41f3-9114-eb66a3c34fbe",
                                "sense_id": "2e46815a-0d48-3a0a-9a85-5eaffac65e4a",
                                "text": "De mannen stierven tussen 1608 en 1610, een tijd waarin ze te maken kregen met voedselschaarste, ziekten en gevechten met indianen. Dat bleek na onderzoek van de botten en het met behulp van 3D-techniek virtueel in elkaar zetten van de skeletten."
                            },
                            {
                                "example_id": "c244c45f-c3e6-41e9-8cff-2f15108d277d",
                                "sense_id": "2e46815a-0d48-3a0a-9a85-5eaffac65e4a",
                                "text": "Door de oorlog balanceert Jemen op de rand van een hongersnood, zegt de VN. Voedselimporten en hulpkonvooien kunnen de Jemenieten niet bereiken door de strijd. Er is sprake van voedselschaarste en ondervoeding, vooral onder kinderen, zegt Ertharin Cousin, hoofd van het VN-Wereld Voedselprogramma."
                            }
                        ]
                    }
