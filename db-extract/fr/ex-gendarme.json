                        "examples": [
                            {
                                "example_id": "f4a4a2e3-c990-449f-972b-0c3d25abdb44",
                                "sense_id": "7de64bae-225e-3736-87b8-19fca1eb67ac",
                                "text": "Eh bien ! mon compère, dit l’ex-gendarme en se servant de ce mot selon sa primitive acception, Annette est-elle malade pour que vous nous accordiez votre présence pendant une soirée ?…"
                            },
                            {
                                "example_id": "b67297f8-3450-4ae9-9818-57196af41314",
                                "sense_id": "7de64bae-225e-3736-87b8-19fca1eb67ac",
                                "text": "Quoi de nouveau, père Gaudois ? dis-je, un soir, en rentant à la caserne, au portier, un ex-gendarme en retraite, et le meilleur homme du monde."
                            },
                            {
                                "example_id": "679e441c-1551-4fbb-86fe-6413194e9aa7",
                                "sense_id": "7de64bae-225e-3736-87b8-19fca1eb67ac",
                                "text": "Je ne connais pas d’accord entre le SGR et la gendarmerie pour laisser le soin à la gendarmerie de s’occuper des ex-gendarmes."
                            }
                        ]
                    }
