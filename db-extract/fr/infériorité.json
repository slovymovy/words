                        "examples": [
                            {
                                "example_id": "063e0104-641c-41d8-8d60-8dd06648c720",
                                "sense_id": "3c698ae5-ca92-334f-b76d-0fb9c2059933",
                                "text": "Une infériorité de niveau."
                            }
                        ]
                    },
                    {
                        "sense_id": "78769ae4-2259-380f-9008-4b4fcfe3e54f",
                        "entry_id": "20c484a6-a0dd-3b38-9150-136df8fde9ce",
                        "glosses": [
                            "Désavantage, inégalité en ce qui concerne la valeur, le pouvoir, le rang, la force, le mérite, etc."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bab7c3f5-49ef-4dfc-bee6-e4308b02a0e1",
                                "sense_id": "78769ae4-2259-380f-9008-4b4fcfe3e54f",
                                "text": "La notaresse était furieuse de ne pas être aussi belle que madame César, car toute femme sait toujours en elle-même à quoi s’en tenir sur la supériorité ou l’infériorité d’une rivale."
                            },
                            {
                                "example_id": "9c1e1478-638e-46c0-89dd-7fb916808820",
                                "sense_id": "78769ae4-2259-380f-9008-4b4fcfe3e54f",
                                "text": "Son infériorité devrait le rendre plus modeste."
                            },
                            {
                                "example_id": "da7ce6fe-fade-47e3-988f-eb24ac71079f",
                                "sense_id": "78769ae4-2259-380f-9008-4b4fcfe3e54f",
                                "text": "Infériorité de talent, d’adresse."
                            },
                            {
                                "example_id": "22489bd3-8931-4471-bc4b-38e468795326",
                                "sense_id": "78769ae4-2259-380f-9008-4b4fcfe3e54f",
                                "text": "Il fit l’aveu de son infériorité."
                            },
                            {
                                "example_id": "0b647134-b598-4ef8-a758-07e9973688f6",
                                "sense_id": "78769ae4-2259-380f-9008-4b4fcfe3e54f",
                                "text": "L’infériorité des forces."
                            },
                            {
                                "example_id": "13dcce75-c337-433c-8e9f-ccaf35d22213",
                                "sense_id": "78769ae4-2259-380f-9008-4b4fcfe3e54f",
                                "text": "L’infériorité du nombre."
                            }
                        ]
                    },
