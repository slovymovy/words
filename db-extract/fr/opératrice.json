                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3cafd2ea-5d08-38e3-9aa2-3bafa37f64fc",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A kind of expression that enters into an a-bar movement dependency and is said to bind a variable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00a816e6-d84c-46df-9910-fa24a6c2b802",
                                                "sense_id": "3cafd2ea-5d08-38e3-9aa2-3bafa37f64fc",
                                                "text": "In the sentence \"What did Bill say he wants to buy?\", \"what\" is an operator, binding a phonetically empty variable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9037a4c8-06e6-3d57-b0aa-62be8682a5cb",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A bus driver."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39b51020-0203-3352-8ed8-35b69e1216ff",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "The company that operates a mine; often the same one that owns the mine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "24a14393-a5a0-3e4d-86da-41dc14d06d81",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A thief or charlatan."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "299cd4d8-9466-4df0-ae37-94ddacd42b58",
                                                "sense_id": "24a14393-a5a0-3e4d-86da-41dc14d06d81",
                                                "text": "Sir Ol. Sirrah! I got many a round Sum by it, when my Father wou'd not give me a Groat—Then, Sir, I was in with all the Top Gameſters, and when there was a fat Squire to be fleec'd; I had my Office among them too, and tho' I ſay it, was one of the neateſt Operators about Town."
                                            },
                                            {
                                                "example_id": "813bb06a-5271-4104-9bb9-6980f3274c0c",
                                                "sense_id": "24a14393-a5a0-3e4d-86da-41dc14d06d81",
                                                "text": "Hank was saying, \"Lyssa showed me the screenshots of Nate's accounts, so we know he's helping himself to Nate's money every month. The guy's a real operator.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b07564d-fe90-3a77-9e92-4c98f1f991f2",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "A major criminal."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc530beb-690f-47a0-9180-47894ac2b8ce",
                                                "sense_id": "1b07564d-fe90-3a77-9e92-4c98f1f991f2",
                                                "text": "He started bleating to me this morning aboot being stretched on this hippy stalk. A fuckin waste of time. Big operators flooding the city with smack and three-quarters of the cunts we bang up are daft schemies or students with a wee bit of hash or a few pills for their pals."
                                            },
                                            {
                                                "example_id": "2846ea56-2ac0-4d13-b66a-49ecc0e22a17",
                                                "sense_id": "1b07564d-fe90-3a77-9e92-4c98f1f991f2",
                                                "text": "The second thing is that smart operators like Cocky are only in it for the (huge amounts of) money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d4537b5-284e-3095-be92-faf775bcb5d1",
                                        "entry_id": "3b2e7c6c-81bb-3b05-9f6d-1c81a4de643d",
                                        "glosses": [
                                            "Someone who is successful at pursuing women; a player."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fc1129b-0ceb-4122-afa6-da3112f644ea",
                                                "sense_id": "0d4537b5-284e-3095-be92-faf775bcb5d1",
                                                "text": "I give credit to men who are great operators, as we once called them, with the girls. Once I was interviewing one of the most beautiful girls in the world in her suite at the Hotel Plaza. While she was busily denying to me that there was anything serious in her relationship with Warren Beatty, who should be barging into the next room of the suite with a lot of clothes being removed from another suite, but Warren Beatty?"
                                            },
                                            {
                                                "example_id": "c0b23353-b047-4338-9bbe-90da1a80e4fc",
                                                "sense_id": "0d4537b5-284e-3095-be92-faf775bcb5d1",
                                                "text": "\"Of course you're right, but the Baron is unfortunately a bit of an operator, if you know what I mean. He likes the ladies,\" said Salvatore with a wicked grin. \"So he never gets in until two, sometimes even three in the morning, and that's because he goes dancing at the Mela; he's quite a playboy.\""
                                            },
                                            {
                                                "example_id": "12e79c97-f6ec-4bf7-81ff-7f57aad97cad",
                                                "sense_id": "0d4537b5-284e-3095-be92-faf775bcb5d1",
                                                "text": "Anyway, there's gonna be plenty of girls. Plenty of girls for an operator like you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bba6c1e1-bfba-4c1b-a4b2-7f34117d6c2d",
