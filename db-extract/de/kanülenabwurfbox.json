                        "glosses": [
                            "Behältnis zur Entsorgung von (medizinischen) Abfällen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc7cd16-35ff-463e-91bb-67b62257e5b7",
                                "sense_id": "89cbd506-e59c-3c2a-a2a9-0bed2c0d55c8",
                                "text": "„Benutzte oder mit dem Produkt kontaminierte Kanülen und Spritzen sind in eine Kanülenabwurfbox zu entsorgen.“"
                            },
                            {
                                "example_id": "40b32fe4-43ca-4834-b48c-8c5104935bd2",
                                "sense_id": "89cbd506-e59c-3c2a-a2a9-0bed2c0d55c8",
                                "text": "„Nicht selten erleiden Reinigungskräfte Kanülenstichverletzungen beim Abtransport von Abfallsäcken, in denen Kanülenabwurfboxen entsorgt wurden. Diese sind z. T. überfüllt oder/und nicht korrekt verschlossen.“"
                            }
                        ],
