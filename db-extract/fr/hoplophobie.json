                                    {
                                        "sense_id": "92e9554b-73e4-32be-9696-e1cc9d133381",
                                        "entry_id": "eb379e4f-c00f-3e71-a120-09ea7fda5b9e",
                                        "glosses": [
                                            "The irrational fear of guns."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3a52e07-7673-4df9-b3d5-35ceca806190",
                                                "sense_id": "92e9554b-73e4-32be-9696-e1cc9d133381",
                                                "text": "Gun control laws are proposed to control three basic areas: Crime, accidental shootings, and to calm those suffering from hoplophobia — these people generally align themselves with the first two so I won’t even consider that category."
                                            },
                                            {
                                                "example_id": "32b74f1a-455c-4313-9eee-53420743a4a2",
                                                "sense_id": "92e9554b-73e4-32be-9696-e1cc9d133381",
                                                "text": "You'll be happy to learn that \"hoplophobia\" (irrational fear of weapons) has been recognized as an illness by the AMA, is treatable, and is now covered by most HMOs. Get thee to a psychiatrist!"
                                            },
                                            {
                                                "example_id": "b91aa731-3f75-421d-9bd4-e1a8f4483d4e",
                                                "sense_id": "92e9554b-73e4-32be-9696-e1cc9d133381",
                                                "text": "2015: James Taranto, in \"Best of the Web: The Left Loses Control,\" The Wall Street Journal\nThat the [New York] Times's gun-control crusade is motivated by hoplophobia, rather than a sincere concern about crime and terrorism, can be demonstrated by a comparison with other Times editorials that do not focus on guns."
                                            }
                                        ]
