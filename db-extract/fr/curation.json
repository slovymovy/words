                                        "sense_id": "4e355c09-98a0-3b06-ab35-04ad1a14dbe9",
                                        "entry_id": "57265492-ac00-3545-be97-68b946c51f5f",
                                        "glosses": [
                                            "The selective assembly and presentation of information."
                                        ],
