{
    "word_family": [
        "inspanning",
        "ontspannen",
        "spanning",
        "spannen"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9e38ef75-4fba-3e42-86a3-dbb576f8779d",
                    "sense_definition": "zich <w>inspannen</w>: veel moeite doen of krachten gebruiken om een doel te bereiken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "moeite doen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>spande</w> zich enorm <w>in</w> om zijn studie op tijd af te maken.",
                            "target_lang_translations": {
                                "en": "He <w>exerted</w> himself enormously to finish his studies on time."
                            }
                        },
                        {
                            "text": "Je moet je meer <w>inspannen</w> als je deze moeilijke wedstrijd wilt winnen.",
                            "target_lang_translations": {
                                "en": "You have to <w>make more of an effort</w> if you want to win this difficult match."
                            }
                        }
                    ],
                    "synonyms": [
                        "pogen",
                        "trachten",
                        "zwoegen"
                    ],
                    "antonyms": [
                        "ontspannen",
                        "rusten"
                    ],
                    "common_phrases": [
                        "zich maximaal inspannen",
                        "zich fysiek inspannen"
                    ],
                    "target_lang_definitions": {
                        "en": "to exert oneself; to make a great effort or use strength to achieve a goal"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exert oneself",
                                "target_lang_sense_clarification": "to put in vigorous physical or mental effort"
                            },
                            {
                                "target_lang_word": "make an effort",
                                "target_lang_sense_clarification": "to try hard to do something"
                            },
                            {
                                "target_lang_word": "strain",
                                "target_lang_sense_clarification": "to make an intense or forced effort"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a8fbbf9-66bf-387e-9ee8-a2e2b65bcb2c",
                    "sense_definition": "een trekdier zoals een paard of os voor een voertuig of ploeg vastmaken",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "voertuigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer <w>spande</w> de paarden <w>in</w> voor de zware kar.",
                            "target_lang_translations": {
                                "en": "The farmer <w>harnessed</w> the horses to the heavy cart."
                            }
                        },
                        {
                            "text": "Voordat we vertrokken, moesten we eerst de ezels <w>inspannen</w> voor de wagen.",
                            "target_lang_translations": {
                                "en": "Before we left, we first had to <w>hitch up</w> the donkeys to the wagon."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanspannen"
                    ],
                    "antonyms": [
                        "uitspannen"
                    ],
                    "common_phrases": [
                        "paarden inspannen"
                    ],
                    "target_lang_definitions": {
                        "en": "to harness a draft animal such as a horse or ox to a vehicle or plow"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "harness",
                                "target_lang_sense_clarification": "to attach an animal to a cart or plow"
                            },
                            {
                                "target_lang_word": "hitch up",
                                "target_lang_sense_clarification": "to connect an animal to a vehicle"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}