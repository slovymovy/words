                                "example_id": "91bc4fcd-c549-4290-ba72-de2caea3fb4b",
                                "sense_id": "a25faa3b-0179-3038-883f-558d6861409b",
                                "text": "Elle voulait faire du cinéma, c’était son rêve le plus cher, tu comprends Derek, son rêve, son seul rêve, le cinéma, gnagnagna."
                            },
                            {
                                "example_id": "f7b62823-fa6f-4fce-b80e-654787469c30",
                                "sense_id": "a25faa3b-0179-3038-883f-558d6861409b",
                                "text": "Alors, on pourrait penser à des banalités du genre esprit d’équipe, respect des règles, des arbitres et des adversaires, et gnagnagna."
                            },
                            {
                                "example_id": "555a77d7-9fa4-4be9-bcd6-f8a1c9a63cde",
                                "sense_id": "a25faa3b-0179-3038-883f-558d6861409b",
                                "text": "Veuillez agréer, monsieur, l’expression de nos salutations gnagnagna…"
                            },
                            {
                                "example_id": "a30a8c12-e17f-42cb-b4a8-0e4e3f3e013e",
                                "sense_id": "a25faa3b-0179-3038-883f-558d6861409b",
                                "text": "Hélène fait gnagnagna à part elle."
