                ],
                "senses": [
                    {
                        "sense_id": "60c28f66-9b83-3ba6-9a6f-cc3ed756e00f",
                        "entry_id": "596a050d-fddb-3238-a445-700f07d5272b",
                        "glosses": [
                            "gegen die Sowjetunion gerichtet, die Sowjetunion ablehnend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0527949-54b0-400e-8633-c24978e49e60",
                                "sense_id": "60c28f66-9b83-3ba6-9a6f-cc3ed756e00f",
                                "text": "„Wenn wir es geschickt anstellen, können wir den Russen vorgaukeln, dass wir zwischen Baku und Taschkent ein hocheffizientes antisowjetisches Untergrundnetz betreiben.“"
                            },
                            {
                                "example_id": "8805627a-28d3-40e6-9d07-3ecc8ed93ea9",
                                "sense_id": "60c28f66-9b83-3ba6-9a6f-cc3ed756e00f",
                                "text": "„Die antisowjetischen Zeitschriften stürzten sich hingegen auf meine ihrer Behauptung nach positive Darstellung der russischen Soldaten, um damit den Beweis zu erbringen, dass der Roman den Versuch unternahm, die sowjetische Präsenz in Osteuropa zu rechtfertigen.“"
                            },
                            {
                                "example_id": "1b986804-bd77-467f-8898-dcb457ea21ae",
                                "sense_id": "60c28f66-9b83-3ba6-9a6f-cc3ed756e00f",
                                "text": "„Die afghanischen Mudschaheddin sollten die von den USA unterstützten antisowjetischen Truppen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
