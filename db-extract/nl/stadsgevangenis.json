                        "examples": [
                            {
                                "example_id": "79b8602b-cdb6-4e05-abba-11f6066411df",
                                "sense_id": "65c02036-d245-33f8-8d94-54a86a8f0f6b",
                                "text": "'s Revenge missie stuurt spelers terug naar Arkham City om hun laatste uitdaging aan te gaan door afwisselend als Batman of Robin te spelen. Door gebruik te maken van de vecht- en onderzoekstechnieken van elk personage kunnen spelers de wraakzuchtige plannen van Harley dwarsbomen en de poorten van de stadsgevangenis voorgoed sluiten."
                            },
                            {
                                "example_id": "dd3a536b-af40-490a-affa-928f562e2a30",
                                "sense_id": "65c02036-d245-33f8-8d94-54a86a8f0f6b",
                                "text": "In de Boliviaanse hoofdstad La Paz kunnen toeristen tegen betaling een rondleiding krijgen van criminelen in de stadsgevangenis."
                            },
                            {
                                "example_id": "499a0c35-51e7-47af-95a9-15e9c8cee08e",
                                "sense_id": "65c02036-d245-33f8-8d94-54a86a8f0f6b",
                                "text": "Vlak bij Muurhuizen ligt de oude stadsboerderij, die altijd haar groene karakter behouden heeft, en iets verderop staat de zogenaamde Dieventoren, de voormalige stadsgevangenis, nu in gebruik als woning."
                            },
                            {
                                "example_id": "fde912e2-1a91-429e-a639-14b207592562",
                                "sense_id": "65c02036-d245-33f8-8d94-54a86a8f0f6b",
                                "text": "De gevangenis in Hoogvliet, voorheen de stadsgevangenis Rotterdam, vormt samen met de locatie De Schie de Penitentiaire Inrichting Rotterdam. De locatie in Hoogvliet herbergt onder meer een gevangenis, een Huis van Bewaring en een Inrichting Stelselmatige Daders (ISD)."
                            }
                        ]
