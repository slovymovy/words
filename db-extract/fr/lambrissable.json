                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ac1583-f0dc-40de-80da-c82c059bd66d",
                                "sense_id": "01750eda-d369-3331-b04a-01060c25f072",
                                "text": "Mais ce n’est pas tout, le dispositif est lambrissable. En d’autres termes, il est parfaitement possible d’avoir une décoration intérieure différente de la finition extérieure."
                            },
                            {
