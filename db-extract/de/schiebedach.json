                "senses": [
                    {
                        "sense_id": "5a5108f4-2bdd-3553-8f8b-6713aa505e07",
                        "entry_id": "53cd3370-348f-3f31-9d7c-4854049e3029",
                        "glosses": [
                            "Teil des Verdecks eines Fahrzeugs, der geöffnet werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "933458ca-3716-4c8f-a9a3-804d089e6037",
                                "sense_id": "5a5108f4-2bdd-3553-8f8b-6713aa505e07",
                                "text": "„Die Sonne scheint senkrecht durch das Schiebedach, legt sich auf ihre Schultern und kitzelt ihr Dekolleté.“"
                            },
                            {
                                "example_id": "224ed7f9-2056-4ef6-a1a1-af318f73ff4d",
                                "sense_id": "5a5108f4-2bdd-3553-8f8b-6713aa505e07",
                                "text": "„Papa hatte einen grünen Peugeot 404 gekauft, mit Schiebedach und vier Türen und viel mehr Platz auf der Hinterbank als im Käfer.“"
                            },
                            {
                                "example_id": "ef441bba-ca37-4f05-9df2-5ae4d8267d38",
                                "sense_id": "5a5108f4-2bdd-3553-8f8b-6713aa505e07",
                                "text": "„Durch das Schiebedach brennt uns die heiße Augustsonne auf den Pelz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
