            "pos": "noun",
            "senses": [
                {
                    "sense_id": "126ba159-6a0c-3b49-b6ec-f52ff29dbe51",
                    "sense_definition": "Ensemble d'ondes électromagnétiques ou de particules qui se propagent dans une même direction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rayonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le phare de la voiture projetait un large <w>faisceau</w> lumineux dans la nuit."
                        },
                        {
                            "text": "Ce laboratoire utilise un puissant <w>faisceau</w> de particules pour ses expériences."
                        }
                    ],
                    "synonyms": [
                        "rayon",
                        "pinceau"
                    ],
                    "common_phrases": [
                        "faisceau lumineux",
                        "faisceau de lumière",
                        "faisceau laser"
                    ]
                },
                {
                    "sense_id": "ab1b7d87-f6db-3647-a591-cddc16f618d1",
                    "sense_definition": "Assemblage d'éléments allongés de même nature réunis ou attachés ensemble.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "assemblage_materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a examiné avec attention le <w>faisceau</w> musculaire blessé lors de la chute."
                        },
                        {
                            "text": "Le technicien remplace un <w>faisceau</w> de câbles électriques défectueux sous le capot."
                        }
                    ],
                    "synonyms": [
                        "botte",
                        "gerbe"
                    ],
                    "common_phrases": [
                        "faisceau musculaire",
                        "faisceau de fibres"
                    ]
                },
                {
                    "sense_id": "3a1f1d54-04bb-321c-93ca-ec587bd00e6b",
                    "sense_definition": "Ensemble d'éléments abstraits convergents qui appuient une même conclusion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concordance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enquêteurs disposent désormais d'un <w>faisceau</w> d'indices suffisant pour arrêter le suspect."
                        },
                        {
                            "text": "Ce <w>faisceau</w> de présomptions renforce l'hypothèse d'une erreur humaine."
                        }
                    ],
                    "synonyms": [
                        "concordance",
                        "ensemble"
                    ],
                    "common_phrases": [
