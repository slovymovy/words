                ],
                "senses": [
                    {
                        "sense_id": "5f29f85f-c476-37c4-b184-a257b21c2b86",
                        "entry_id": "cb1958ac-b547-312b-bfd7-376a15d96300",
                        "glosses": [
                            "Réaliste : partisane du réalisme, orientée sur la réalité concrète."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63ed50c8-18ca-49dd-bc75-6fefe7d1ccc8",
                                "sense_id": "5f29f85f-c476-37c4-b184-a257b21c2b86",
                                "text": "Wir brauchen eine Realistin wie sie, um konkret mit unseren Projekten voranzukommen.",
                                "translation": "Nous avons besoin d’une réaliste comme elle pour avancer concrètement dans nos projets."
                            },
                            {
                                "example_id": "5c0221f0-fc16-4ade-8684-d4cd51f45b60",
                                "sense_id": "5f29f85f-c476-37c4-b184-a257b21c2b86",
                                "text": "Sie selbst bezeichnet sich als „Klima-Realistin“ und behauptet, der Einfluss der Menschen auf das Klima sei marginal.",
                                "translation": "Elle-même se désigne comme une climato-réaliste et prétend que l’influence des gens sur le climat est marginale."
                            }
                        ]
                    },
                    {
                        "sense_id": "15a255cc-4259-353d-93f3-57ca8dbd638f",
                        "entry_id": "cb1958ac-b547-312b-bfd7-376a15d96300",
                        "glosses": [
                            "Réaliste : adepte du réalisme, mouvement artistique."
                        ],
                        "tags": [
                            "Peinture"
                        ],
                        "examples": [
                            {
                                "example_id": "baa207ed-24a7-466f-951f-449013d71807",
                                "sense_id": "15a255cc-4259-353d-93f3-57ca8dbd638f",
                                "text": "Im Gefolge der Kunsthistorikerin Ulrike Gauss, die ihren Porträts „realistische Stilsicherheit“ attestierte, charakterisierte man Lotte Lesehr als „Realistin des psychologischen Porträts“..",
                                "translation": "Suivant l’opinion de l’historienne de l’art Ulrike Gauss, qui attesta à ses portraits une « maîtrise réaliste du style », on considéra Lotte Lesehr comme une « réaliste du portrait psychologique »."
                            }
                        ]
                    }
                ],
