                {
                    "sense_id": "b23a605b-2e61-3577-aa21-52d6d2339dec",
                    "sense_definition": "Retourner dans un lieu que l'on avait quitté ou où l'on doit se trouver.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "revenir_lieu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après les vacances, les élèves doivent <w>réintégrer</w> leur établissement scolaire dès lundi matin."
                        },
                        {
                            "text": "Le malade a pu <w>réintégrer</w> sa chambre après plusieurs examens médicaux rassurants."
                        }
                    ],
                    "synonyms": [
                        "regagner",
                        "rentrer",
                        "revenir"
                    ],
                    "antonyms": [
                        "quitter"
                    ],
                    "common_phrases": [
                        "réintégrer son domicile",
                        "réintégrer sa chambre",
                        "réintégrer les rangs"
                    ]
                },
                {
                    "sense_id": "6edc40ac-91ef-3115-9706-c9ebd0ef17f6",
                    "sense_definition": "Rétablir une personne dans ses fonctions, son emploi ou son statut antérieur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "retablir_fonction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le tribunal a ordonné à l'entreprise de <w>réintégrer</w> immédiatement le salarié injustement licencié."
                        },
                        {
                            "text": "Après une longue suspension, le professeur espère que le rectorat le <w>réintégrera</w> à la rentrée."
                        }
                    ],
                    "synonyms": [
                        "rétablir",
                        "réhabiliter"
                    ],
                    "antonyms": [
                        "destituer",
                        "licencier",
                        "renvoyer"
                    ],
                    "common_phrases": [
                        "réintégrer son poste",
                        "réintégrer ses fonctions",
                        "réintégrer le personnel"
                    ]
                },
                {
                    "sense_id": "aaa3976b-3016-3495-b9e1-b57ec4c27313",
                    "sense_definition": "Rétablir quelqu'un dans la possession d'un bien ou la jouissance d'un droit dont il avait été privé.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "retablir_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La cour de justice a décidé de le <w>réintégrer</w> dans tous ses droits civiques."
                        },
                        {
                            "text": "L'héritier légitime a enfin été <w>réintégré</w> dans la possession des biens familiaux confisqués."
                        }
                    ],
                    "synonyms": [
                        "restituer",
                        "rétablir"
                    ],
                    "antonyms": [
                        "déposséder",
                        "priver"
                    ],
                    "common_phrases": [
                        "réintégrer dans ses droits",
                        "réintégrer dans ses biens"
                    ]
                }
            ]
        }
