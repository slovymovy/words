                    {
                        "translation_id": "0758c6fe-d7b9-4e02-9105-79dd646043e0",
                        "source_entry_id": "c0721932-4716-3652-999d-07628a3f3a17",
                        "target_lang_word": "generative",
                        "target_lang_code": "en",
