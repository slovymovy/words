                        "source_sense_id": "9c8c9028-8e77-3569-9a87-331b63c3b745",
                        "target_lang_word": "timid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e84e262-205b-3ed0-a835-3f7f7ab9d416",
                                        "entry_id": "43a244c7-41e2-34de-900f-fdd0102e8b7a",
                                        "glosses": [
                                            "Lacking in courage or confidence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "430431ea-64f0-4b2c-ba74-8058e855e0ba",
                                                "sense_id": "5e84e262-205b-3ed0-a835-3f7f7ab9d416",
                                                "text": "John's a very timid person. I doubt he'll be brave enough to face his brother."
                                            },
                                            {
                                                "example_id": "552e5aa5-d40b-419d-86fc-8938da9a87c8",
                                                "sense_id": "5e84e262-205b-3ed0-a835-3f7f7ab9d416",
                                                "text": "When Timothy and Julia hurried up the staircase to the bedroom floor, where a considerable commotion was taking place, Tim took Barry Leach with him.[…]. The captive made no resistance and came not only quietly but in a series of eager little rushes like a timid dog on a choke chain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6815e8ad-095f-4b1e-82a3-ae700ccef6b2",
                        "source_entry_id": "203bd1bd-b8e0-337a-bbf1-c179d0db436a",
                        "source_sense_id": "9c8c9028-8e77-3569-9a87-331b63c3b745",
                        "target_lang_word": "tímido",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tímido",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "38e648e4-b9e0-3e85-a7b3-7a756ba82144",
                                        "entry_id": "ee9ba3d0-27e6-3b7c-8d65-ef11fda9861f",
                                        "glosses": [
                                            "Que reacciona de forma insegura y con vergüenza ante el contacto o la presencia de otros, que siente timidez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "191634cf-bc88-4b16-998e-8e7144bdbb81",
                                                "sense_id": "38e648e4-b9e0-3e85-a7b3-7a756ba82144",
                                                "text": "Como era tímido, cuando se le hablaba no encontraba respuesta y permanecía silencioso o respondía mal."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ef32e1a-7023-34cc-8b47-955db95691b0",
                                        "entry_id": "ee9ba3d0-27e6-3b7c-8d65-ef11fda9861f",
                                        "glosses": [
                                            "Relativo a la timidez o propio de ella."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c31f240a-0263-4d75-b59d-f9e1be5ef518",
                                                "sense_id": "6ef32e1a-7023-34cc-8b47-955db95691b0",
                                                "text": "Tener un carácter tímido."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "df3b05f0-4acd-3f81-a4a5-34ed87d2bf3a",
                                        "entry_id": "ee9ba3d0-27e6-3b7c-8d65-ef11fda9861f",
                                        "glosses": [
                                            "Se dice del fenómeno que se manifiesta débilmente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff4c6b6c-a1fd-46b9-a36a-cc011f427de8",
                                                "sense_id": "df3b05f0-4acd-3f81-a4a5-34ed87d2bf3a",
                                                "text": "Un tímido sol se asomó entre las nubes."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
