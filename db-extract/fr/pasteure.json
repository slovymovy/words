                    },
                    {
                        "form_id": "8549e1de-8723-4147-af84-f081b104f209",
                        "entry_id": "1fd10da2-a821-3036-86c9-d1dca36a62b4",
                        "tags": [
                            "masculine"
                        ],
                        "form": "pasteur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34d8df6e-ac5f-3e55-a28f-3ccc6f0cea9e",
                        "entry_id": "1fd10da2-a821-3036-86c9-d1dca36a62b4",
                        "glosses": [
                            "Femme qui a la fonction de ministre du culte dans la religion protestante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ef31d8-6b3d-4e74-bf98-47fa2b0379ac",
                                "sense_id": "34d8df6e-ac5f-3e55-a28f-3ccc6f0cea9e",
                                "text": "Le dialogue entre la jeune femme et la pasteure avait porté sur des thèmes religieux et était par conséquent sans intérêt pour l’enquête."
                            },
                            {
                                "example_id": "5c043031-7a84-42d0-9705-5c10bad3bcbe",
                                "sense_id": "34d8df6e-ac5f-3e55-a28f-3ccc6f0cea9e",
                                "text": "Pasteure en milieu hospitalier, l’auteur s’est trouvée, toute jeune aumônière, face à ce qu’elle appelle la « plainte »."
                            },
                            {
                                "example_id": "422ec58e-46fc-41f8-9324-ba2a0acf07cc",
                                "sense_id": "34d8df6e-ac5f-3e55-a28f-3ccc6f0cea9e",
                                "text": "La Suisse est le seul pays à accepter ce modèle de formation, l’Église Réformée de Neuchâtel ayant adopté pasteure comme féminin de pasteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f54a86b-ab0e-4bfb-aa5b-b62e0e0b54be",
                        "source_entry_id": "1fd10da2-a821-3036-86c9-d1dca36a62b4",
                        "source_sense_id": "34d8df6e-ac5f-3e55-a28f-3ccc6f0cea9e",
                        "target_lang_word": "Pastorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pastorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f294146-e702-3bc8-8078-5bdd86399f83",
                                        "entry_id": "2f5c8436-26f5-3602-8c23-69fc75fc80a9",
                                        "glosses": [
                                            "weibliche Person, die Geistliche einer Kirche ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d3dec83-de84-4290-a627-6380b211b599",
                                                "sense_id": "2f294146-e702-3bc8-8078-5bdd86399f83",
                                                "text": "„Er meldete sie als vermisst. Und bestellte gleichzeitig eine Pastorin aus Hamburg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                                        "entry_id": "2f5c8436-26f5-3602-8c23-69fc75fc80a9",
                                        "glosses": [
                                            "Gattin eines evangelischen Geistlichen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0c2a6c1-f16c-4fb5-84c3-11909e83afe6",
                                                "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                                                "text": "„Unserer Nebel ältere Schwester ist die aus Goethe’s Dichtung und Wahrheit bekannte Frau Pastorin Griesbach […].“ (Gattin des Predigers und Theologen Johann Jakob Griesbach ^(→ WP))"
                                            },
                                            {
                                                "example_id": "5a2dc2ed-9cef-43e8-bc57-782f667717ce",
                                                "sense_id": "c3b3f333-ea67-3add-a7fc-425165dc53a4",
                                                "text": "„Die Herren vertieften sich in ein eifriges Gespräch über die politische Lage des Landes. Interessiert folgte die Pastorin ihren Auseinandersetzungen und warf hier und da ein verständnisvolles Wort dazwischen.“ (Novelle: Gattin von Pastor Berger)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eeaf370e-0f9d-45b0-a43e-a51714977588",
                        "source_entry_id": "1fd10da2-a821-3036-86c9-d1dca36a62b4",
                        "source_sense_id": "34d8df6e-ac5f-3e55-a28f-3ccc6f0cea9e",
                        "target_lang_word": "Pfarrerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pfarrerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ffa6ae2b-b090-345f-8018-61e3994c795d",
                                        "entry_id": "161de1ef-cff7-3510-a66a-711bc4700f00",
                                        "glosses": [
                                            "eine weibliche Person, die mit der Leitung von Gottesdiensten, der seelsorglichen Betreuung und in der Regel auch der Leitung einer Gemeinde betraut ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63357654-f03c-4aaf-bcdb-a8e5cc16c241",
                                                "sense_id": "ffa6ae2b-b090-345f-8018-61e3994c795d",
                                                "text": "Marianne arbeitet als Pfarrerin."
                                            },
                                            {
                                                "example_id": "3ea59379-0e2f-48e0-aa1b-e4458e2788e1",
                                                "sense_id": "ffa6ae2b-b090-345f-8018-61e3994c795d",
                                                "text": "„Die Pfarrerin hatte aber nur Bier und Wein hinter dem Kirchentresen, Schnaps war anscheinend doch nicht salonfähig genug.“"
                                            },
                                            {
                                                "example_id": "70b3620a-c858-4190-9712-358e7bdb54e7",
                                                "sense_id": "ffa6ae2b-b090-345f-8018-61e3994c795d",
                                                "text": "„Adam, Nina, Pfarrer und Pfarrerin saßen also weiter geduldig im Dunkeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
