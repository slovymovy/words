                "senses": [
                    {
                        "sense_id": "8ae446fd-1325-3d47-91d9-21b8e62fc60f",
                        "entry_id": "8fffb049-4753-3468-844f-f3a4732d3b23",
                        "glosses": [
                            "Spielform, bei der ein Charakter oder ein Ereignis vor Publikum schauspielerisch präsentiert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "533a1f10-ad0c-4319-bb7a-d839991cad04",
                                "sense_id": "8ae446fd-1325-3d47-91d9-21b8e62fc60f",
                                "text": "„Es gibt soziale Darstellungsspiele, die in ihrem Ablauf so streng geregelt sind, dass jede kleinste Abweichung von der Norm das Spiel bereits verdirbt.“"
                            },
                            {
                                "example_id": "888637a2-e564-4d4a-a674-91716b94b49e",
                                "sense_id": "8ae446fd-1325-3d47-91d9-21b8e62fc60f",
                                "text": "„Eine andere Möglichkeit, die Jüngeren in das gemeinsame Spielen einzubinden, besteht darin, Spiele zu bevorzugen, in denen sie ihre schauspielerischen Fähigkeiten anwenden können, z. B. Darstellungsspiele.“"
                            },
                            {
                                "example_id": "66091d7c-d45a-4588-9a2c-403d18f36397",
                                "sense_id": "8ae446fd-1325-3d47-91d9-21b8e62fc60f",
                                "text": "„Es ging um höfische Kommunikation, um ein kompliziertes System der Statuszuweisung und der Geltungsränge, wann immer die nobilitierten Menschen des 16. und frühen 17. Jahrhunderts sich in Maskenfesten gefielen und Darstellungsspiele probten.“"
                            },
                            {
                                "example_id": "41b7a6ea-82c4-4a55-afa9-20e5e5a8c43f",
                                "sense_id": "8ae446fd-1325-3d47-91d9-21b8e62fc60f",
                                "text": "„Die Bedeutung der Darstellungsspiele im Herz- und Alterssport liegt in dem breiten Spektrum personaler Anforderungen, die hier gestellt werden.“"
                            },
                            {
                                "example_id": "d5ed2ba9-d8ac-427b-ad5c-4e946735a5ff",
                                "sense_id": "8ae446fd-1325-3d47-91d9-21b8e62fc60f",
                                "text": "„Die grundlegende Eigenschaft der Darstellungsspiele ist das Als-Ob.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
