                                        "glosses": [
                                            "ekstatisch-orgiastische Frau im Kult des griechischen Weingottes Dionysos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f033ff38-50ea-4550-a652-dcfce31b3256",
                                                "sense_id": "a41b63be-92f1-39f5-a42d-73927a348fdb",
                                                "text": "Die Mänade trägt Reh- oder Leopardenfelle an ihrem Körper."
                                            }
