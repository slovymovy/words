                "entry_id": "6db168c6-eea2-3f3d-ada3-7a1ae9a7ddaa",
                "word": "misguided",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a0c5b337-0c6f-4124-9143-81c0dff28537",
                        "entry_id": "6db168c6-eea2-3f3d-ada3-7a1ae9a7ddaa",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more misguided"
                    },
                    {
                        "form_id": "0bdac18d-dee8-48cc-965b-8d7daddd1ea2",
                        "entry_id": "6db168c6-eea2-3f3d-ada3-7a1ae9a7ddaa",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most misguided"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7e02d9a2-589c-30a5-826b-7e42748e5976",
                        "entry_id": "6db168c6-eea2-3f3d-ada3-7a1ae9a7ddaa",
                        "glosses": [
                            "Ill-conceived or not thought through."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058e2cf0-6cbb-433f-ab13-d28dda8f02ed",
                                "sense_id": "7e02d9a2-589c-30a5-826b-7e42748e5976",
                                "text": "I believe in freedom of movement and view the current government’s restrictive attitude as both socially and economically misguided. Yet I fear that a special London policy will only exacerbate existing divisions."
                            }
                        ]
                    },
                    {
                        "sense_id": "5098b2c9-f606-381a-bdb6-eb7daf67469c",
                        "entry_id": "6db168c6-eea2-3f3d-ada3-7a1ae9a7ddaa",
                        "glosses": [
                            "Misled or mistaken."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "46f6077e-287b-3e4a-9473-1a1022eb4d7d",
                        "entry_id": "6db168c6-eea2-3f3d-ada3-7a1ae9a7ddaa",
                        "glosses": [
                            "Lacking proper guidance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c4b0389-916c-4900-9b4b-8ff9582650ca",
                                "sense_id": "46f6077e-287b-3e4a-9473-1a1022eb4d7d",
                                "text": "You're just a poor misguided fool\nWho thinks they know what I should do\nA line for me and a line for you\nI lose my right to a point of view."
                            },
                            {
                                "example_id": "e13226fd-8f15-44e8-8ddd-6f44aacdc95e",
                                "sense_id": "46f6077e-287b-3e4a-9473-1a1022eb4d7d",
                                "text": "Martin Luther King Jr's 1964 Nobel Peace Prize acceptance speech on the need for moral intervention should be taped to every tech CEO's wall: “When scientific power outruns moral power, we end up with guided missiles and misguided men.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3143625a-9385-4514-a5e5-b2db464bb120",
                        "source_entry_id": "6db168c6-eea2-3f3d-ada3-7a1ae9a7ddaa",
                        "source_sense_description": "lacking proper guidance",
                        "target_lang_word": "errant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "errant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2ff94017-cf19-3ae2-a16d-2f69e36a7fad",
                                        "entry_id": "a98d53af-55fc-3850-960b-c6d15ceadec7",
                                        "glosses": [
                                            "Qui ne cesse de voyager ; vagabond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad2f0503-4c5b-45d0-81d5-3c283e24536f",
                                                "sense_id": "2ff94017-cf19-3ae2-a16d-2f69e36a7fad",
                                                "text": "Quelques chiffres donneront l'idée des prises que la police peut faire sur les chiens errants des grandes villes et montreront combien son action peut être efficace à diminuer, par une chasse régulière, le nombre des chiens errants qui peuvent devenir les propagateurs de la rage."
                                            },
                                            {
                                                "example_id": "1fe42970-8beb-4d58-ac77-7f84312025ee",
                                                "sense_id": "2ff94017-cf19-3ae2-a16d-2f69e36a7fad",
                                                "text": "Ils retraçaient la vie glorieuse des anciens chevaliers errants toujours au service du faible contre le fort ."
                                            },
                                            {
                                                "example_id": "7e704cc5-1928-4c91-b286-1f5b887f1464",
                                                "sense_id": "2ff94017-cf19-3ae2-a16d-2f69e36a7fad",
                                                "text": "Après y avoir étudié quelque temps, il trouva que la réputation du lieu était usurpée et que l'art pugilistique n'y offrait rien de remarquable. Il quitta donc Chao-lin -sseu et mena une vie errante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8e84352-a786-3a65-b40a-f34d4a63777f",
                                        "entry_id": "a98d53af-55fc-3850-960b-c6d15ceadec7",
                                        "glosses": [
                                            "Qualifie une imagination vagabonde, sans frein, qui se porte rapidement sur un grand nombre d’objets."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f0d1a1d-ad34-484c-8f4e-b8e84cea3f68",
                                                "sense_id": "c8e84352-a786-3a65-b40a-f34d4a63777f",
                                                "text": "Combien de fois ai-je tenté vainement de rassembler tes pensées errantes, dispersées !"
                                            },
                                            {
                                                "example_id": "58133826-1888-433e-b232-cae67d105308",
                                                "sense_id": "c8e84352-a786-3a65-b40a-f34d4a63777f",
                                                "text": "Autrefois mon imagination errante et vagabonde se portait à toutes les choses étrangères; aujourd'hui mon esprit se ramène au corps , et s'y réunit davantage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "errant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bf013235-0397-3383-b8ce-8964a1db3fa1",
                                        "entry_id": "75c83e0e-ab5a-3fd4-a461-809c48894d84",
                                        "glosses": [
                                            "Personnage qui erre, qui déambule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b479f9dd-3e0d-4edb-870f-ed6b7619a8ca",
                                                "sense_id": "bf013235-0397-3383-b8ce-8964a1db3fa1",
                                                "text": "La rue promène un flot d’errants sur ses trottoirs, les éparpille, les laisse aller… Pourquoi sortir ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64555076-2201-35c9-9b61-dd10f6557da8",
                                        "entry_id": "75c83e0e-ab5a-3fd4-a461-809c48894d84",
                                        "glosses": [
                                            "Celui qui erre dans la foi."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0568b726-7800-431a-b68f-f3731ed22bf5",
                                                "sense_id": "64555076-2201-35c9-9b61-dd10f6557da8",
                                                "text": "Redresser, ramener les errants."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "errant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "12c7421f-df7e-3baf-a495-856fdfd24134",
                                        "entry_id": "94bff44d-0256-3a41-9f0d-4995542887ae",
                                        "glosses": [
                                            "Participe présent de errer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "181eee43-89bc-4d27-b6c1-d129cd2a8c76",
                                                "sense_id": "12c7421f-df7e-3baf-a495-856fdfd24134",
                                                "text": "Mais, devenue célèbre, Katherine Mansfield ne jouissait guère de sa gloire; elle luttait contre la tuberculose, errant de Montana-sur-Sièvres à Menton, travaillant, rêvant et se soignant, et cherchant elle ne sait où ce secret qui permettrait d’exprimer toute sa vue à la fois, en surface et en profondeur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
