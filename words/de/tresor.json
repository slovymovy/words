                {
                    "sense_id": "e27ff993-556e-3858-bc34-4601a8678d8c",
                    "sense_definition": "Schwerer, abschließbarer und gepanzerter Schrank zur sicheren Aufbewahrung von Wertsachen und Geld.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "behaeltnis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er bewahrt seine wichtigen Dokumente und den teuren Schmuck in einem stabilen <w>Tresor</w> auf."
                        },
                        {
                            "text": "Die Einbrecher versuchten vergeblich, den alten <w>Tresor</w> im Büro zu knacken."
                        }
                    ],
                    "synonyms": [
                        "Panzerschrank",
                        "Safe"
                    ],
                    "common_phrases": [
                        "im Tresor aufbewahren",
                        "einen Tresor knacken"
                    ]
                },
                {
                    "sense_id": "bb9afd5d-1ccc-3fb3-a4aa-90a52ccc50b7",
                    "sense_definition": "Speziell gesicherter Raum, meist in einer Bank, zum Schutz größerer Mengen an Geld oder Wertsachen.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "raum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Angestellten brachten das gesamte Bargeld vor Feierabend in den unterirdischen <w>Tresor</w> der Bank."
                        },
                        {
                            "text": "Nur autorisierte Personen haben Zutritt zu dem besonders bewachten <w>Tresor</w> im Kellergeschoss."
                        }
                    ],
                    "synonyms": [
