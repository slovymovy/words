                                "target_senses": [
                                    {
                                        "sense_id": "ce037b68-a9e3-3c26-b79d-3b12ad3065d6",
                                        "entry_id": "3360c18e-d689-38fd-8456-9e090584733d",
                                        "glosses": [
                                            "Morceler, diviser, en parlant d'un territoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c708a920-6cb4-4464-9d76-cb5051a6ba2f",
                                                "sense_id": "ce037b68-a9e3-3c26-b79d-3b12ad3065d6",
                                                "text": "Tailler, rogner dans l’Europe Centrale, la balkaniser, créer de nouveau États de droite ou de gauche, les autoriser, même les engager, à instituer des lignes de douane coupant les gisements miniers des industries que, avant 1914, ceux-ci approvisionnaient, telle fut l’œuvre accomplie."
                                            },
                                            {
                                                "example_id": "32f7f8e7-c2e2-4c3a-b2e2-e259494546c7",
                                                "sense_id": "ce037b68-a9e3-3c26-b79d-3b12ad3065d6",
                                                "text": "Face à une scène politique balkanisée en France, Emmanuel Macron file en Serbie"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82c2c44d-9a01-3aa5-9ced-852ef7e2b27d",
                                        "entry_id": "3360c18e-d689-38fd-8456-9e090584733d",
                                        "glosses": [
                                            "Se morceler, se diviser."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05bf3b25-6884-4cd2-93ce-59c4a404e81d",
                                                "sense_id": "82c2c44d-9a01-3aa5-9ced-852ef7e2b27d",
                                                "text": "Le groupe de musique se balkanise."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12b4f3ef-a546-4ce8-b7d9-c3c187eec710",
                        "source_entry_id": "97a91173-8bcc-316e-9c66-ff77ce3945ce",
                        "source_sense_id": "9f07e284-4b9f-31f3-9163-994bbe512f25",
                        "source_sense_description": "to break up",
                        "target_lang_word": "zersplittern",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zersplittern",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e29bdbf-af20-3ac7-b4b1-3318eb8daa69",
                                        "entry_id": "ebea2468-b0b2-3c43-b4e0-0ffc3db39ed4",
                                        "glosses": [
                                            "in viele kleine Teile zerfallen"
                                        ],
                                        "tags": [
                                            "auxiliary verb",
                                            "figurative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9851fcc8-dc95-4816-ad54-d41219f5964d",
                                                "sense_id": "7e29bdbf-af20-3ac7-b4b1-3318eb8daa69",
                                                "text": "Das von Kugeln durchlöcherte Fenster zersplitterte in tausend zackige Risse, und eine Zehntelsekunde lang hing sie im Leeren wie im Flug gebannt, von strahlenförmig nach außen schießenden Linien umgeben wie ein Buntglasengel."
                                            },
                                            {
                                                "example_id": "0b1f0ab3-9e20-4734-be8b-f5b2530fc1ec",
                                                "sense_id": "7e29bdbf-af20-3ac7-b4b1-3318eb8daa69",
                                                "text": "Am häufigsten gelangen Bakterien auf direktem Weg von außen in den Knochen, zum Beispiel bei einem offenen Knochenbruch. Hier ist der Knochen so zersplittert, dass Knochenteile durch die Haut nach außen ragen."
                                            },
                                            {
                                                "example_id": "bdfad700-da48-4352-b20e-8f57828168bc",
                                                "sense_id": "7e29bdbf-af20-3ac7-b4b1-3318eb8daa69",
                                                "text": "Florenz, Rom, Neapel waren zwar Abnehmer des Carrara-Marmors in Italien, aber der Absatz in Italien war relativ gering. England, Frankreich, Spanien wurden die Hauptabnehmer. Italien war, wie Deutschland auch, in Kleinstaaten zersplittert und die Zölle waren immens."
                                            },
                                            {
                                                "example_id": "6c9c1744-d943-4c51-97d4-a56b4f99c27c",
                                                "sense_id": "7e29bdbf-af20-3ac7-b4b1-3318eb8daa69",
                                                "text": "Seine Fehler sind daher, wenn er spröde ist und sich nicht wohl bearbeiten laßt, sondern zersplittert wie der schwarze Marmor von Namur."
                                            },
                                            {
                                                "example_id": "7fb51c4e-b379-48bb-b6c1-f029998c97a8",
                                                "sense_id": "7e29bdbf-af20-3ac7-b4b1-3318eb8daa69",
                                                "text": "Die Wählervereinigung der Kreisstadt hatte sich im internen Streit um das Antreten bei Landtagswahlen zersplittert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5ef0dd4f-465d-35a7-b36e-1adac4e86b9b",
                                        "entry_id": "ebea2468-b0b2-3c43-b4e0-0ffc3db39ed4",
                                        "glosses": [
                                            "in Splitter zerschlagen"
                                        ],
                                        "tags": [
                                            "auxiliary",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08a78945-54d6-4d87-a3ab-5fbf7d66ddfe",
                                                "sense_id": "5ef0dd4f-465d-35a7-b36e-1adac4e86b9b",
                                                "text": "Diese Fähigkeit, Knochen zu zersplittern, wird den Küken ins Nest gelegt."
                                            },
                                            {
                                                "example_id": "e6f4769a-eef6-41ad-be34-b819e9f46f17",
                                                "sense_id": "5ef0dd4f-465d-35a7-b36e-1adac4e86b9b",
                                                "text": "Der Angreifer ließ ihm keine Zeit; sein nächster Schlag zersplitterte den Holzschild, der nächste Hieb fällte den Taumelnden."
                                            },
                                            {
                                                "example_id": "b6efe235-d594-438d-ba12-81bdf0464b48",
                                                "sense_id": "5ef0dd4f-465d-35a7-b36e-1adac4e86b9b",
                                                "text": "Vor Ort bot sich den Einsatzkräften ein Bild der Zerstörung: Der rund 40 Meter hohe Mammutbaum war durch die Wucht des Einschlags auf halber Höhe zersplittert worden."
                                            },
                                            {
                                                "example_id": "823964cf-f938-4bab-8821-54549e3ffe1a",
                                                "sense_id": "5ef0dd4f-465d-35a7-b36e-1adac4e86b9b",
                                                "text": "Die Explosion zersplitterte die Fenster und setzte das Fahrzeug in Brand, das noch hundert Meter langsam weiterrollte, bis es am Bordstein zum Stehen kam."
                                            },
                                            {
                                                "example_id": "b59c5e47-236b-486c-ae82-3ae83f433ded",
                                                "sense_id": "5ef0dd4f-465d-35a7-b36e-1adac4e86b9b",
                                                "text": "Eine Gruppe in Falkensee aus 200 Neonazis, die es offenbar nicht zur Demo geschafft hat, hält dort eine Spontandemo ab, mit einem Stein zersplittern sie das Fenster des Büros der Grünen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5be248f-45a5-4a96-9de3-8a94cadca521",
                        "source_entry_id": "97a91173-8bcc-316e-9c66-ff77ce3945ce",
