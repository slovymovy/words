{
    "word_family": [
        "ostentatious",
        "ostentatiously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4fef2fcd-3847-30d5-923c-648df29a266a",
                    "sense_definition": "An ambitious or vain display intended to impress others and attract attention.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The billionaire's <w>ostentation</w> was evident in the gold-plated fixtures throughout his massive mansion.",
                            "target_lang_translations": {
                                "ru": "<w>Показная роскошь</w> миллиардера проявлялась в позолоченной сантехнике по всему его огромному особняку."
                            }
                        },
                        {
                            "text": "He lived a life of quiet modesty, avoiding the <w>ostentation</w> that often accompanies great wealth.",
                            "target_lang_translations": {
                                "ru": "Он вёл скромную и тихую жизнь, избегая <w>хвастовства</w>, которое часто сопутствует огромному богатству."
                            }
                        }
                    ],
                    "synonyms": [
                        "showiness",
                        "pomp",
                        "pompousness"
                    ],
                    "common_phrases": [
                        "avoid ostentation",
                        "pure ostentation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тщеславная или чрезмерная демонстрация богатства, роскоши или успеха с целью произвести впечатление на окружающих."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвастовство",
                                "target_lang_sense_clarification": "желание пустить пыль в глаза"
                            },
                            {
                                "target_lang_word": "выставление напоказ",
                                "target_lang_sense_clarification": "нарочитая демонстрация чего-либо"
                            },
                            {
                                "target_lang_word": "показная роскошь",
                                "target_lang_sense_clarification": "кричащая пышность ради впечатления"
                            },
                            {
                                "target_lang_word": "помпа",
                                "target_lang_sense_clarification": "показная торжественность и пышность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d128dae-3247-35b1-bbd7-7ba31cb4fbac",
                    "sense_definition": "A public show or spectacle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "display",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The funeral was held with great <w>ostentation</w> to honor the fallen leader.",
                            "target_lang_translations": {
                                "ru": "Похороны прошли с огромной <w>помпой</w>, чтобы почтить память погибшего лидера."
                            }
                        },
                        {
                            "text": "They organized a grand <w>ostentation</w> to celebrate the opening of the new theater.",
                            "target_lang_translations": {
                                "ru": "Они устроили грандиозное <w>зрелище</w>, чтобы отпраздновать открытие нового театра."
                            }
                        }
                    ],
                    "synonyms": [
                        "parade",
                        "pageantry",
                        "show"
                    ],
                    "common_phrases": [
                        "mourning ostentation"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is primarily found in older literature."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Публичное представление, пышное зрелище или масштабная демонстрация."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "демонстрация",
                                "target_lang_sense_clarification": "публичный показ или манифестация"
                            },
                            {
                                "target_lang_word": "пышное зрелище",
                                "target_lang_sense_clarification": "торжественный спектакль, смотр"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}