                ],
                "senses": [
                    {
                        "sense_id": "53053d49-7012-3227-b200-d70efc04e437",
                        "entry_id": "69900e95-5382-3bbc-b162-9b93122b89d9",
                        "glosses": [
                            "поместиться, уместиться внутри чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dde841be-671f-4228-8f8d-930e529a5531",
                                "sense_id": "53053d49-7012-3227-b200-d70efc04e437",
                                "text": "Только камень невесомо твердел в груди; даже не камень, а камешек, что вложился б в кулак."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d5b8d80-815c-3256-9c00-f25cc673f89d",
                        "entry_id": "69900e95-5382-3bbc-b162-9b93122b89d9",
                        "glosses": [
                            "внести свой вклад в общее дело; посвятить себя чему-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ace5334c-28de-4516-9ea1-d440d83dbfc1",
                                "sense_id": "0d5b8d80-815c-3256-9c00-f25cc673f89d",
                                "text": "Мы решили всеми силами и знаниями вложиться в текущую государственную деятельность народного представительства."
                            },
                            {
                                "example_id": "086c8cbf-55bb-4980-8f85-411a242c8fbf",
                                "sense_id": "0d5b8d80-815c-3256-9c00-f25cc673f89d",
                                "text": "Государству нужно сделать стратегически важный шаг и вложиться в кино, с тем чтобы оно могло конкурировать с этой системой."
                            }
                        ]
                    }
                ],
