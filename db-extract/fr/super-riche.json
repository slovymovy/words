                        "examples": [
                            {
                                "example_id": "3e412547-87bc-4b32-ab01-bb20b56a9abe",
                                "sense_id": "07db6e94-b18c-34ca-985d-9950ece77433",
                                "text": "Ces gens-là, ils sont super-riches, ils s’en fichent si on touche à leurs trucs."
                            },
                            {
                                "example_id": "5a389378-99be-431e-bad0-3f4e966f9e78",
                                "sense_id": "07db6e94-b18c-34ca-985d-9950ece77433",
                                "text": "Les graines de lin sont super-riches en fibres et en oméga 3."
                            },
                            {
                                "example_id": "723ad626-2b64-44b6-aed0-4111e990cf7f",
                                "sense_id": "07db6e94-b18c-34ca-985d-9950ece77433",
                                "text": "Au cours des différents repas de la journée, je favorisais des assiettes équilibrées, variées et très colorées, avec un penchant pour les légumes verts qui sont super-riches en fibres, en vitamines, en fer…"
                            }
                        ]
                    }
                ],
