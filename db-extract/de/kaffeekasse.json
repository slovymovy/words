                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26ffbc4e-1e85-3630-bfd0-0c2d871b8125",
                                        "entry_id": "2dfe262d-dbf6-3d7d-9459-78221b207ca8",
                                        "glosses": [
                                            "In full kitty-wren: synonym of wren (“any bird of the family Troglodytidae; specifically the Eurasian wren (Troglodytes troglodytes)”)."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dialectal"
                                        ],
                                        "examples": [
