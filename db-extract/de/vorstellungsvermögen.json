                                "example_id": "5bf433a9-8aa7-4bf3-87a1-9d6592053907",
                                "sense_id": "8b4de3cb-c855-3c47-88fb-614fb59c5103",
                                "text": "„Die Tschernobyl-Katastrophe im Frühling 1986 sprengte jedes menschliche Vorstellungsvermögen.“"
                            },
                            {
                                "example_id": "07802776-ce25-47c6-a58b-95aa18496014",
                                "sense_id": "8b4de3cb-c855-3c47-88fb-614fb59c5103",
                                "text": "„Imagination – das menschliche Vorstellungsvermögen oder die Einbildungskraft – beeinflusst unser Leben und Erfahren in vielfältiger Weise, zumeist ohne dass uns dies bewusst ist.“"
                            }
                        ],
