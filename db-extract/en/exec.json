                        "entry_id": "2d32a6d1-3c16-3a6c-ac1f-a57a6b601d96",
                        "glosses": [
                            "An executive; a person employed at the executive level."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "49b7722c-f50f-48f4-87f2-43d2e72b89a8",
                                "sense_id": "70169ea5-1b9f-3150-83db-9ac70c8f2844",
                                "text": "An upcoming problem to be thrashed out at a meeting of diskery reps and execs of the American Federation of Radio Artists (AFRA), is the degree of AFRA's jurisdictional claim over singers on records."
                            },
                            {
                                "example_id": "dfad53ac-47dc-444b-83f0-84dc05d2e82d",
                                "sense_id": "70169ea5-1b9f-3150-83db-9ac70c8f2844",
                                "text": "Tony Stark makes you feel\nHe’s a cool exec with a heart of steel.\nAs Iron Man, all jets ablaze,\nHe’s fighting and smiting with repulsor rays!\nAmazing armor! That’s Iron Man!\nA blazing power! That’s Iron Man!"
                            },
                            {
                                "example_id": "8bfb77dd-6c66-4faf-b559-5e0b815acfcc",
                                "sense_id": "70169ea5-1b9f-3150-83db-9ac70c8f2844",
                                "text": "“All right,” he said, turning to the first sheet of paper inside. “We’re not playing Good Cop/Bad Cop here. Do you know that game?” “Yes, sir. Some captains delegate all the unpopular orders to their exec so he can take the heat.” “Right. Well, I don’t believe in that. If an unpopular order has to be given, the captain should take responsibility for it himself.[…]”"
                            }
                        ]
                    },
                    {
                        "sense_id": "94b8611a-6096-398d-9f77-6d7bbc8a75f6",
                        "entry_id": "2d32a6d1-3c16-3a6c-ac1f-a57a6b601d96",
                        "glosses": [
                            "An executive officer, i.e. the chief assistant to the commanding officer."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "be129bcc-24ea-4b8c-9844-174d41a4ed5a",
                                "sense_id": "94b8611a-6096-398d-9f77-6d7bbc8a75f6",
                                "text": "“'Okay. Report to the exec's office right after inspection tomorrow, Mister Keith. Best of luck.”"
                            }
                        ]
                    }
