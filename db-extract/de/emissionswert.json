                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "00114a51-d56d-4776-ad56-4beb6736e6cc",
                                "sense_id": "9981aa33-ca94-3d29-984a-e0b398c760c3",
                                "text": "„Ab 2013 sollen mindestens zehn Prozent der neu angeschafften oder neu angemieteten Fahrzeuge einen Emissionswert von weniger als 50 Gramm Kohlendioxid (CO2) einhalten.“"
