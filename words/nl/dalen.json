            "senses": [
                {
                    "sense_id": "8d104920-114a-34ea-9aaa-fd50df20efa7",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>dal</w>",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tussen de hoge bergen liggen diepe, groene <w>dalen</w> met kleine beekjes.",
                            "target_lang_translations": {
                                "en": "Between the high mountains lie deep, green <w>valleys</w> with small streams.",
                                "ru": "Между высокими горами лежат глубокие зеленые <w>долины</w> с маленькими ручьями."
                            }
                        },
                        {
                            "text": "Op hun tocht langs diepe <w>dalen</w> werden zij door camera's gefilmd.",
                            "target_lang_translations": {
                                "en": "During their journey through deep <w>valleys</w>, they were filmed by cameras.",
                                "ru": "Во время их путешествия по глубоким <w>долинам</w> их снимали на камеры."
                            }
                        }
                    ],
                    "common_phrases": [
