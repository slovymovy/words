                                    },
                                    {
                                        "sense_id": "156e0a66-067b-3c8d-9b05-7af63bac1770",
                                        "entry_id": "31f07dc4-ad28-3eea-b41b-594662a379a1",
                                        "glosses": [
                                            "The part between the beginning and the end."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7ae415c-7a3a-4234-a982-df4c6fe673d6",
                                                "sense_id": "156e0a66-067b-3c8d-9b05-7af63bac1770",
                                                "text": "I woke up in the middle of the night."
                                            },
                                            {
                                                "example_id": "cf35eb67-05d7-4d87-9953-8e3837ace7ee",
                                                "sense_id": "156e0a66-067b-3c8d-9b05-7af63bac1770",
                                                "text": "In the middle of the marathon, David collapsed from fatigue."
                                            },
                                            {
                                                "example_id": "1390ecc2-71b1-4275-a8e1-e2b352f015e9",
                                                "sense_id": "156e0a66-067b-3c8d-9b05-7af63bac1770",
                                                "text": "Then there came a reg'lar terror of a sou'wester same as you don't get one summer in a thousand, and blowed the shanty flat and ripped about half of the weir poles out of the sand. We spent consider'ble money getting 'em reset, and then a swordfish got into the pound and tore the nets all to slathers, right in the middle of the squiteague season."
                                            }
                                        ]
                                    },
