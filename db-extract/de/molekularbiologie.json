                        "entry_id": "3b40d36c-8fe0-3651-b038-ccd2c64525e0",
                        "glosses": [
                            "Zweig der Biologie, der sich mit biologischen Problemen auf molekularer Ebene beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae819e6d-5fd2-424d-b3ab-f99754e37598",
                                "sense_id": "bf5897a0-f0bf-34a1-aa9d-52dca75c40a6",
                                "text": "Für die Molekularbiologie gibt es keinen qualitativen Unterschied zwischen einer lebenden und einer toten Zelle."
                            },
                            {
                                "example_id": "13a9f522-6b69-4a2a-8354-781685d85223",
                                "sense_id": "bf5897a0-f0bf-34a1-aa9d-52dca75c40a6",
                                "text": "„Da er über die jüngsten Fortschritte der Molekularbiologie nicht orientiert war, konnte er nicht wissen, dass ein solcher Eingriff (den er herbeiwünschte, aber ganz sicher für unmöglich hielt) jetzt bald realisierbar sein wird, binnen recht kurzer Zeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
