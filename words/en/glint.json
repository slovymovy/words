    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6838f927-6057-3c47-b0f2-ef5df90be5e7",
                    "sense_definition": "A short flash of light, usually when reflected off a shiny surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I saw the <w>glint</w> of metal as he raised the gun."
                        },
                        {
                            "text": "The <w>glint</w> of sunlight on the water was beautiful."
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "gleam",
                        "sparkle"
                    ],
                    "common_phrases": [
                        "glint of light",
                        "metallic glint"
                    ]
                },
                {
                    "sense_id": "b17ad670-6a7d-31ef-bf2e-0d2047f526e1",
                    "sense_definition": "A brief look; a glance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He gave a quick <w>glint</w> at the clock before leaving the room."
                        },
                        {
                            "text": "She cast a <w>glint</w> at the stranger to see if he was watching."
                        }
                    ],
                    "synonyms": [
                        "glance",
                        "look"
                    ],
                    "common_phrases": [
                        "cast a glint"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is archaic or dialectal in modern English."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "732feef7-af87-3fd8-ab99-607a0e47110d",
                    "sense_definition": "To flash or gleam briefly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A wedding ring <w>glinted</w> on her finger."
                        },
                        {
                            "text": "The stars <w>glinted</w> in the dark night sky."
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "gleam",
                        "sparkle"
                    ],
                    "common_phrases": [
                        "glint in the sun"
