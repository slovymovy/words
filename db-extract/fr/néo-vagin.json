                                            {
                                                "example_id": "bc104913-acbc-4bf1-9ac4-aecfb057eee9",
                                                "sense_id": "8b43246f-4865-3331-b35f-b374a0a4b9eb",
                                                "text": "Patients with a neovagina are more likely to engage in sexual activity, and as many as 50 percent of them report a capacity for orgasm."
                                            },
