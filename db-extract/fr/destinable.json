                        "glosses": [
                            "Que l’on peut destiner à quelque chose."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "39dfbc29-6f8c-4a93-a040-2266d3e452dc",
                                "sense_id": "940207b6-7f24-361c-ac95-4c0db6a5bfed",
                                "text": "La création est dès lors définie comme le rapport d'un sujet, l'auteur, à un objet, l'œuvre, considérée comme une chose destinable et destinée aux dispositifs contractuels."
                            },
                            {
                                "example_id": "9a6834e6-a1d0-41d6-9cc8-eff3ce996b27",
                                "sense_id": "940207b6-7f24-361c-ac95-4c0db6a5bfed",
                                "text": "En aval du manuscrit destiné ou destinable à la fabrication, il y a donc des facteurs qui agissent sur la forme ou le contenu du texte."
                            },
                            {
                                "example_id": "45c9c51c-a0ea-44e0-8e8a-de4ce497780e",
                                "sense_id": "940207b6-7f24-361c-ac95-4c0db6a5bfed",
                                "text": "Or l'ironie, elle, n'est pas une parenthèse ni une enclave détachable dans ce contexte général du vécu qu'on appelle le Sérieux et qui est aussi notre totalité destinable..."
                            }
                        ]
                    }
