                    {
                        "sense_id": "6f9996cf-2451-39f2-804c-dfb06d60020a",
                        "entry_id": "b6784e0c-fe9c-39ea-ab1e-91aa2918889f",
                        "glosses": [
                            "Sorte d'amorce pour pêcher les requins et quelques autres poissons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3536038f-73a9-4c40-98bf-17cbbc75f65d",
                                "sense_id": "6f9996cf-2451-39f2-804c-dfb06d60020a",
                                "text": "On emporte un seau de cette strouille, ou stronck, comme on l'appelle suivant les régions des côtes Atlantique; cela sent très mauvais et attire les mouches, mais c'est d'une constante efficacité."
                            },
                            {
                                "example_id": "88e63afc-cc52-4cf4-a9e8-2a2ebf98ea00",
                                "sense_id": "6f9996cf-2451-39f2-804c-dfb06d60020a",
                                "text": "Loin des eaux estuariennes mais en haute mer, la grande pêche sportive se rallie parfois à cette situation quand s'ancrant, on recherche thons et bonites au broumé ou requins à la strouille."
                            },
                            {
                                "example_id": "ac6724b7-3eab-4291-a91e-1020db5587b4",
                                "sense_id": "6f9996cf-2451-39f2-804c-dfb06d60020a",
                                "text": "L'amorçage pour le thon n'a rien à voir avec la strouille à requins, qui consiste essentiellement en une traînée de graisse et de sang."
                            }
                        ]
                    }
                ],
