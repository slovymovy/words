                        "source_sense_id": "58c48370-428b-38a8-abe6-3938b236a77c",
                        "source_sense_description": "dubbelzijdig uitgevoerde achterwielophanging van een motorfiets",
                        "target_lang_word": "bras oscillant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
