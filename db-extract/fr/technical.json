                                "target_senses": [
                                    {
                                        "sense_id": "b7afdf05-37d5-3b07-a59a-45ccf37b9cfa",
                                        "entry_id": "165e4e47-1630-3149-a4f0-514c26269867",
                                        "glosses": [
                                            "Specifically related to a particular discipline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c3dd5ef-1d70-4d44-a16f-2465859c792a",
                                                "sense_id": "b7afdf05-37d5-3b07-a59a-45ccf37b9cfa",
                                                "text": "Particle physics uses the word spin in a technical sense."
                                            },
                                            {
                                                "example_id": "f4592cb1-0577-4587-bda2-d9533613429a",
                                                "sense_id": "b7afdf05-37d5-3b07-a59a-45ccf37b9cfa",
                                                "text": "One example of the blurring of boundaries is the growing interdependence of social and technical skills. The sales engineers and the clients' engineers are all knowledge workers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cf04b0c-b486-3b8f-98fb-e91e8a22ffbc",
                                        "entry_id": "165e4e47-1630-3149-a4f0-514c26269867",
                                        "glosses": [
                                            "Specifically related to a particular discipline.",
                                            "difficult to understand for those not specialized in this discipline."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21bda827-c051-4f0a-be45-2d05cffb37e0",
                                                "sense_id": "1cf04b0c-b486-3b8f-98fb-e91e8a22ffbc",
                                                "text": "This part of the article is going to be quite technical but I cannot avoid it. It's a very complex topic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99892388-f6a6-30b3-a5f5-14dd2877db82",
                                        "entry_id": "165e4e47-1630-3149-a4f0-514c26269867",
                                        "glosses": [
                                            "Of or related to technology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed8b2a9-ac15-4c1c-b7c0-59a0555cc353",
                                                "sense_id": "99892388-f6a6-30b3-a5f5-14dd2877db82",
                                                "text": "Since the 1940s there had been many technical advancements, and a Mach 3 interceptor was no longer a mere pipe dream."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d79b8a8a-eb48-30d7-93e1-f2a8769a91a1",
                                        "entry_id": "165e4e47-1630-3149-a4f0-514c26269867",
                                        "glosses": [
                                            "Technically minded; adept with science and technology."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eceadc48-6c81-4802-a5c3-e5b7c492ee0b",
                                                "sense_id": "d79b8a8a-eb48-30d7-93e1-f2a8769a91a1",
                                                "text": "Kayla can probably get the printer working. She's technical like that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98641366-2e58-384b-9e03-677ea278fb08",
                                        "entry_id": "165e4e47-1630-3149-a4f0-514c26269867",
                                        "glosses": [
                                            "Relating to, or requiring, technique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac13fd22-5d9b-4f98-ad18-186fde25051e",
                                                "sense_id": "98641366-2e58-384b-9e03-677ea278fb08",
                                                "text": "The performance showed technical virtuosity, but lacked inspiration."
                                            },
                                            {
                                                "example_id": "0a1bb983-4951-4037-9ce2-4bdc01d3dc90",
                                                "sense_id": "98641366-2e58-384b-9e03-677ea278fb08",
                                                "text": "Its design apparently made for interesting racing, with a challenging climb, technical bends and a finishing straight long enough to produce exciting sprints."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "516aab3a-ae1a-3396-8c0b-f7298d6efd1a",
                                        "entry_id": "165e4e47-1630-3149-a4f0-514c26269867",
                                        "glosses": [
                                            "Relating to, or requiring, technique.",
                                            "Requiring advanced techniques for successful completion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "628526ae-4313-440c-8fe6-9e7e8dd159ab",
                                                "sense_id": "516aab3a-ae1a-3396-8c0b-f7298d6efd1a",
                                                "text": "technical climbing"
                                            },
                                            {
                                                "example_id": "ec010045-2613-458f-9e34-bd61886b87c6",
                                                "sense_id": "516aab3a-ae1a-3396-8c0b-f7298d6efd1a",
                                                "text": "It was a technical ascent involving ropework, belays, and protection, and the exposure was great, but there were abundant hand and footholds, and the rock was sound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "640b0596-4ed8-32c3-be31-974b0d67c7f2",
                                        "entry_id": "165e4e47-1630-3149-a4f0-514c26269867",
                                        "glosses": [
                                            "Relating to the internal mechanics of a market rather than more basic factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83b8446-330d-4b6a-90f5-e13b3b1cb8dc",
                                                "sense_id": "640b0596-4ed8-32c3-be31-974b0d67c7f2",
                                                "text": "The market had a technical rally, due to an oversold condition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8709a50-a854-3bd3-b31f-da80c33e20aa",
                                        "entry_id": "165e4e47-1630-3149-a4f0-514c26269867",
                                        "glosses": [
                                            "In the strictest sense, but not practically or meaningfully."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43916fa7-323f-4b8b-91ac-1ae0b6cfea99",
                                                "sense_id": "b8709a50-a854-3bd3-b31f-da80c33e20aa",
                                                "text": "Crossing the front lawn of that house to get to the mailbox was a technical trespass."
                                            }
                                        ]
                                    }
                                ]
                            },
