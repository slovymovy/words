                        "examples": [
                            {
                                "example_id": "40ac8829-f874-4d26-bc49-5a6b75e45230",
                                "sense_id": "8ed062e3-ddfe-3a76-9f22-eddd3557881c",
                                "text": "Bouvard, le coude sur la table, poussait sa petite susurration, et, comme toutes les douleurs se tiennent, les anciens projets agricoles lui revinrent à la mémoire, particulièrement la féculerie et un nouveau genre de fromages."
                            },
                            {
                                "example_id": "a8469951-2e53-4b3d-9d7c-f4076c57ba7c",
                                "sense_id": "8ed062e3-ddfe-3a76-9f22-eddd3557881c",
                                "text": "Le même groupement, mais sans Fontinalis, s’observe en aval du village à hauteur de la féculerie."
                            }
                        ]
                    }
