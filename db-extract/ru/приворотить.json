                                "target_senses": [
                                    {
                                        "sense_id": "27e0589d-953f-3dec-883b-f7f0a961e472",
                                        "entry_id": "12bf8d28-41e2-3757-af78-eb2947f5bd0a",
                                        "glosses": [
                                            "Piquer, déchirer, brûler en effigie une personne en prononçant certaines paroles ou en faisant certaines cérémonies, dans la persuasion qu’elle souffrira les mêmes maux."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26965a55-121f-3448-bdd9-7a8b06248808",
                                        "entry_id": "12bf8d28-41e2-3757-af78-eb2947f5bd0a",
                                        "glosses": [
                                            "Charmer, séduire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c5d10b-fb70-4faf-a73b-a1794bab855b",
                                                "sense_id": "26965a55-121f-3448-bdd9-7a8b06248808",
                                                "text": "Née en 1889, ma mère ne tarda pas à envoûter les reporters par sa beauté qui d'emblée faisait d'elle la reine des bals des débutantes. Elle avait de quoi les séduire, ainsi costumée en sultane, un petit fez rouge sur la tête, ou en duchesse emperruquée, toute de blanc vêtue […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
