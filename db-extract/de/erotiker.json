                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5e93109-05ad-46cc-9a56-60e2b53b9d8d",
                                "sense_id": "0aca9629-cc36-3257-be24-0415237488ad",
                                "text": "Ein bekannter Erotiker ist der amerikanische Autor Henry Miller."
                            },
                            {
                                "example_id": "805ccd3a-ae27-4ede-b8cb-71a2ff0afb5a",
                                "sense_id": "0aca9629-cc36-3257-be24-0415237488ad",
                                "text": "„So wundern sich die einen, dass der Erotiker eine gemäß den Erwartungen viel zu biedere Ehefrau hat (oder überhaupt eine!), und über die vielen Kinder, und dass sie ihm auf dem Schoß herumklettern.“"
                            }
                        ],
