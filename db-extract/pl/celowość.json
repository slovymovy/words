                    {
                        "translation_id": "a0749f59-1f38-46e1-8aa8-7c727b8061bb",
                        "source_entry_id": "e07d6d7a-4e79-33f7-b976-6fe777283d62",
                        "source_sense_id": "f1d22611-5f3d-3e42-9c1f-21ed9d19f17d",
                        "target_lang_word": "Zweckmäßigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zweckmäßigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                                        "entry_id": "b91301aa-450d-3d30-9355-811e0a322032",
                                        "glosses": [
                                            "Zustand und/oder Eigenschaft, für seinen Zweck dienlich, angemessen zu sein; Nützlichkeit; Nutzen von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045ed5a8-7db0-4d7c-8a09-cd40169359fb",
                                                "sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                                                "text": "„Er stellt nun die Wirksamkeit und Zweckmäßigkeit von Impfungen ganz allgemein in Frage.“"
                                            },
                                            {
                                                "example_id": "41765971-7859-4c0e-af71-9763b6ea8586",
                                                "sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                                                "text": "„Das Gericht hat nicht über die Zweckmäßigkeit und Sinnhaftigkeit des Rettungspaketes entschieden, sagte Gerichtspräsident Voßkuhle.“"
                                            },
                                            {
                                                "example_id": "b48d8023-cbc3-42a5-a0e2-7096c8caa3c2",
                                                "sense_id": "f1b1c393-528f-3b06-a222-94e348913a4c",
                                                "text": "„Unser moderner Sprachgebrauch wird durch Grundsätze wie Knappheit und Genauigkeit, Sachlichkeit und Zweckmäßigkeit bestimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
