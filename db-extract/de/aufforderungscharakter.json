                "senses": [
                    {
                        "sense_id": "e87422be-6ca5-30c6-beff-276a7844afec",
                        "entry_id": "74991bf2-264a-368c-ac30-cca80f05fb5a",
                        "glosses": [
                            "Reiz, der von einer Sache oder einem Ereignis ausgeht und zu einer bestimmten Verhaltensweise oder Reaktion aufruft, verleitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57315694-f28a-402f-9499-56cb7b1ac0e2",
                                "sense_id": "e87422be-6ca5-30c6-beff-276a7844afec",
                                "text": "„Für manche fehlt aktuell ein Lernumfeld mit Aufforderungscharakter: Also etwa die Lehrkraft, die Aufgaben kontrolliert, oder die Sitznachbarn in der Unibibliothek, die konzentriert vor sich hinarbeiten.“"
                            },
                            {
                                "example_id": "f4bfb0f5-617f-4955-8197-8640ebcac75f",
                                "sense_id": "e87422be-6ca5-30c6-beff-276a7844afec",
                                "text": "„Zum andern haben Dinge einen ‚Aufforderungscharakter‘, wie in der Philosophie die Phänomenologen sagen.“"
                            },
                            {
                                "example_id": "531a77f9-a5a0-4b49-8348-c7c350bdf239",
                                "sense_id": "e87422be-6ca5-30c6-beff-276a7844afec",
                                "text": "„Grelles und Buntes hat einen hohen Aufforderungscharakter, klar, deshalb laufen Kinder auch auf das Grelle zu.“"
                            },
                            {
                                "example_id": "ca6487f6-f4de-466d-84cf-f6f63f839153",
                                "sense_id": "e87422be-6ca5-30c6-beff-276a7844afec",
                                "text": "„Werbung dürfe keinen ‚Aufforderungscharakter‘ haben und müsse sich auf ‚Information und Aufklärung‘ beschränken, heißt es in Paragraph fünf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
