                {
                    "sense_id": "5d70a9a0-9ab2-35a1-b0df-f430ad9a08cd",
                    "sense_definition": "Een liefhebberij of bezigheid ter ontspanning voor in de vrije tijd.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mijn <w>hobby</w> is het maken van websites en computerprogramma's.",
                            "target_lang_translations": {
                                "en": "My <w>hobby</w> is making websites and computer programs.",
                                "ru": "Мое <w>хобби</w> — создание веб-сайтов и компьютерных программ.",
                                "zh": "我的<w>爱好</w>是制作网站和计算机程序。",
                                "pl": "Moim <w>hobby</w> jest tworzenie stron internetowych i programów komputerowych."
                            }
                        },
                        {
                            "text": "Zij heeft een dure <w>hobby</w> waar ze veel tijd aan besteedt.",
                            "target_lang_translations": {
                                "en": "She has an expensive <w>hobby</w> on which she spends a lot of time.",
                                "ru": "У нее дорогое <w>хобби</w>, которому она уделяет много времени.",
                                "zh": "她有一个很花时间的昂贵<w>爱好</w>。",
                                "pl": "Ma drogie <w>hobby</w>, któremu poświęca dużo czasu."
                            }
                        }
                    ],
                    "synonyms": [
                        "liefhebberij"
                    ],
                    "common_phrases": [
                        "uit de hand gelopen hobby",
                        "dure hobby"
                    ],
                    "target_lang_definitions": {
