                                "example_id": "de32dc03-7ac5-48cd-9876-353567ecf39d",
                                "sense_id": "e86da5f3-b7cd-31b2-8094-f707cb515c69",
                                "text": "Les vertus farouches n’aiment pas les demi-périls."
