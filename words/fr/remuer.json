    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3bc7b4a8-1106-35c1-87f9-a4ad950230c7",
                    "sense_definition": "Faire un mouvement, ne pas rester immobile.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a du mal à rester assis et ne cesse de <w>remuer</w> sur sa chaise."
                        },
                        {
                            "text": "Reste bien tranquille pendant la photo et ne <w>remue</w> pas."
                        }
                    ],
                    "synonyms": [
                        "bouger"
                    ],
                    "antonyms": [
                        "s'immobiliser"
                    ]
                },
                {
                    "sense_id": "ca1317a1-c94f-3c5a-aee7-dc2fd1e26909",
                    "sense_definition": "Mettre en mouvement une partie du corps ou déplacer un objet.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chien commence à <w>remuer</w> joyeusement la queue en voyant son maître arriver."
                        },
                        {
                            "text": "Après son accident, le patient a enfin réussi à <w>remuer</w> les orteils."
                        }
                    ],
                    "synonyms": [
                        "mouvoir",
                        "déplacer",
                        "agiter"
                    ],
                    "antonyms": [
                        "immobiliser"
                    ],
                    "common_phrases": [
                        "remuer la queue",
                        "remuer la tête",
                        "remuer les doigts"
                    ]
                },
                {
                    "sense_id": "dae19191-275c-3de5-a53d-52c50d03924b",
                    "sense_definition": "Agiter un liquide, des aliments ou une matière pour les mélanger ou les aérer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "melange",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à <w>remuer</w> la sauce avec une cuillère pour éviter qu'elle n'attache au fond."
                        },
                        {
                            "text": "Il a passé tout le week-end à <w>remuer</w> la terre dans son potager."
                        }
                    ],
                    "synonyms": [
                        "mélanger",
                        "touiller",
                        "brasser"
                    ],
                    "common_phrases": [
                        "remuer la sauce",
                        "remuer la terre",
                        "remuer la salade"
                    ]
                },
                {
                    "sense_id": "d8aeffec-aa8a-399f-a851-9a90a3e430a4",
                    "sense_definition": "Toucher profondément, susciter une vive émotion chez quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette triste nouvelle a profondément <w>remué</w> tous les habitants du quartier."
                        },
                        {
                            "text": "Son discours sincère a réussi à <w>remuer</w> l'assemblée tout entière."
                        }
                    ],
                    "synonyms": [
                        "émouvoir",
                        "bouleverser",
                        "toucher"
                    ],
                    "antonyms": [
                        "laisser indifférent"
                    ],
                    "common_phrases": [
                        "remuer le cœur",
                        "remuer l'âme"
                    ]
                },
                {
                    "sense_id": "46cdd260-e57d-3a76-96d2-26b83fdc2457",
                    "sense_definition": "Réveiller ou évoquer à nouveau des faits, des affaires ou des souvenirs pénibles.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "memoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne sert à rien de <w>remuer</w> le passé quand on veut avancer dans la vie."
                        },
                        {
                            "text": "Évite d'aborder ce sujet douloureux pour ne pas <w>remuer</w> de mauvais souvenirs."
                        }
                    ],
                    "synonyms": [
                        "raviver",
                        "ressasser"
                    ],
                    "antonyms": [
                        "oublier"
                    ],
                    "common_phrases": [
                        "remuer le passé",
                        "remuer des souvenirs",
                        "remuer le couteau dans la plaie"
                    ]
                },
                {
                    "sense_id": "a7091e0c-c261-34b1-b8f8-7b23f49b8393",
                    "sense_definition": "Exciter des personnes, inciter un groupe ou une foule à l'action ou à la révolte.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "incitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'orateur cherchait à <w>remuer</w> les esprits pour encourager la grève générale."
                        },
                        {
                            "text": "Par ses discours enflammés, le leader a fini par <w>remuer</w> la foule mécontente."
                        }
                    ],
                    "synonyms": [
                        "agiter",
                        "soulever",
                        "exciter"
                    ],
                    "antonyms": [
                        "apaiser",
                        "calmer"
                    ],
                    "common_phrases": [
                        "remuer les esprits",
                        "remuer les foules"
                    ]
                }
            ]
        }
    ]
