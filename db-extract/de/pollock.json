                "senses": [
                    {
                        "sense_id": "af7cebda-b31e-3ed5-8195-90e2869d4811",
                        "entry_id": "0c065593-60d6-3e76-acd4-a262d0b3621a",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc53d691-1451-436e-9f7e-aec178701af0",
                                "sense_id": "af7cebda-b31e-3ed5-8195-90e2869d4811",
                                "text": "Frau Pollock ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f03ec072-b32a-4440-96d7-84cde0363f66",
                                "sense_id": "af7cebda-b31e-3ed5-8195-90e2869d4811",
                                "text": "Herr Pollock wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "e073d06a-84b7-403b-84fe-0858c63782a5",
                                "sense_id": "af7cebda-b31e-3ed5-8195-90e2869d4811",
                                "text": "Die Pollocks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "23ed7644-27b6-48b0-9d1c-5b148bda858b",
                                "sense_id": "af7cebda-b31e-3ed5-8195-90e2869d4811",
                                "text": "Der Pollock trägt nie die Schals, die die Pollock ihm strickt."
                            },
                            {
                                "example_id": "79f8d05f-4ae6-4601-8ec5-5e0e71a72b9c",
                                "sense_id": "af7cebda-b31e-3ed5-8195-90e2869d4811",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pollock kommt, geht der Herr Pollock.“"
                            },
                            {
                                "example_id": "80df3477-fcec-4314-b0e8-736cade677d1",
                                "sense_id": "af7cebda-b31e-3ed5-8195-90e2869d4811",
                                "text": "Pollock kommt und geht."
                            },
                            {
                                "example_id": "e70cba9e-2bb6-456f-8977-43189d5aa680",
                                "sense_id": "af7cebda-b31e-3ed5-8195-90e2869d4811",
                                "text": "Pollocks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
