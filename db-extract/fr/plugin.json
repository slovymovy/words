                                    },
                                    {
                                        "sense_id": "47fefe7f-c3a1-3a69-93a5-df31cf0c6150",
                                        "entry_id": "3ca77458-1e99-3cdb-80f8-8d89c9ef9d32",
                                        "glosses": [
                                            "A module or device that interacts with another to add a specific feature or function."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4b9a2a21-1e60-3a63-889d-92f14e9c2043",
                                        "entry_id": "3ca77458-1e99-3cdb-80f8-8d89c9ef9d32",
                                        "glosses": [
                                            "An electric vehicle that can be recharged from an external power source."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5022a7ab-2c46-3982-b7da-e2055f4975f3",
                                        "entry_id": "3ca77458-1e99-3cdb-80f8-8d89c9ef9d32",
                                        "glosses": [
                                            "An air freshener that can be charged by connecting it to the mains power supply."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb81cc41-350e-4119-906a-bb46d7d4492c",
                                                "sense_id": "5022a7ab-2c46-3982-b7da-e2055f4975f3",
                                                "text": "They take your best bottle of Châteauneuf-du-Pape and boil it up with Satsuma peel and bits of stick, resulting in a hot sour wine and every room of the house smelling like a festive Airwick Plug-in has exploded, with the added bonus that all your best pans are now ruined. Cheers!"
                                            },
                                            {
                                                "example_id": "c0669799-6a02-46da-b0d6-05e865e39e12",
                                                "sense_id": "5022a7ab-2c46-3982-b7da-e2055f4975f3",
                                                "text": "But unlike other Glade products with the aroma being released simply by spraying it or by opening the container, this new product the \"Glade Plug-In\" required that the product actually be plugged into an electrical socket in order for the aroma and fragrance to get released into the air, with the slogan for its product being \"Plug it in, plug it in\"."
                                            },
                                            {
                                                "example_id": "89477544-7f2b-4681-81dc-0158ba48bed2",
                                                "sense_id": "5022a7ab-2c46-3982-b7da-e2055f4975f3",
                                                "text": "Plus, I expect a Febreze plug-in would smell like heaven to me right now."
                                            },
                                            {
                                                "example_id": "9260a87f-0292-4027-ad7e-ba023d7f6087",
                                                "sense_id": "5022a7ab-2c46-3982-b7da-e2055f4975f3",
                                                "text": "I quickly picked up the dirty laundry that was scattered all around, opened the window, sprayed the room down with Febreze, changed the plug-in, and called it good."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4917533c-b6d2-4b04-a56d-6a57d62d7c41",
                        "source_entry_id": "3495d7e1-4868-32d8-86a6-073025d1216a",
                        "source_sense_id": "eece9295-945e-352e-ab29-4dbe38391ded",
