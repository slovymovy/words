        "fr-extract.jsonl": [
            {
                "entry_id": "9936e919-d07c-31e1-8e59-dcd4f8d9d030",
                "word": "concentrateur",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4d0e3e72-fa7d-4d1f-9c7e-4dc8ce3de8bc",
                        "entry_id": "9936e919-d07c-31e1-8e59-dcd4f8d9d030",
                        "tags": [
                            "plural"
                        ],
                        "form": "concentrateurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "96105b36-3b77-3810-b263-6ecdb36893b4",
                        "entry_id": "9936e919-d07c-31e1-8e59-dcd4f8d9d030",
                        "glosses": [
                            "Dispositif qui sert à concentrer quelque chose."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a855951b-717f-3365-8c10-7682f6da78ae",
                        "entry_id": "9936e919-d07c-31e1-8e59-dcd4f8d9d030",
                        "glosses": [
                            "Dispositif informatique placé au nœud d’un réseau en étoile, qui concentre et distribue les communications de données."
                        ],
                        "tags": [
                            "Réseaux informatiques"
                        ],
                        "examples": [
                            {
                                "example_id": "9cdf76c8-4e9f-4e4b-b062-a765ae90678c",
                                "sense_id": "a855951b-717f-3365-8c10-7682f6da78ae",
                                "text": "Si bien que le commutateur permet d’allier les propriétés du pont en matière de filtrage, et du concentrateur en matière de connectivité."
                            },
                            {
                                "example_id": "db90df73-28a5-4c1e-a3e4-a57f2ad95ff8",
                                "sense_id": "a855951b-717f-3365-8c10-7682f6da78ae",
                                "text": "Linky envoie des informations à un concentrateur (situé en dehors de votre domicile) par les fils du secteur électrique quelques dixièmes de seconde par jour, et moins d'une minute la nuit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e584f63-2adb-4d4b-8b54-b1a7f8b171a5",
                        "source_entry_id": "9936e919-d07c-31e1-8e59-dcd4f8d9d030",
                        "target_lang_word": "hub",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hub",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7367f45-5976-365d-ae83-d22d0b4de335",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "The central part, usually cylindrical, of a wheel; the nave."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e801a296-3ef9-4883-9937-250450d57f1e",
                                                "sense_id": "b7367f45-5976-365d-ae83-d22d0b4de335",
                                                "text": "If you need to reload film, the cassette can be rewound slightly by turning the hub located on one end of its spool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2cb5fa2-78ac-36af-8f62-ed5d3294e3e2",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A point where many routes meet and traffic is distributed, dispensed, or diverted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a55a88c1-cd15-4ca1-83fa-bb51e9c96252",
                                                "sense_id": "a2cb5fa2-78ac-36af-8f62-ed5d3294e3e2",
                                                "text": "Hong Kong International Airport is one of the most important air traffic hubs in Asia."
                                            },
                                            {
                                                "example_id": "8ea1f5b7-e066-49f7-802a-c9f56c3692c8",
                                                "sense_id": "a2cb5fa2-78ac-36af-8f62-ed5d3294e3e2",
                                                "text": "From the ground, Colombo's port does not look like much.[…] But viewed from high up in one of the growing number of skyscrapers in Sri Lanka's capital, it is clear that something extraordinary is happening: China is creating a shipping hub just 200 miles from India's southern tip."
                                            },
                                            {
                                                "example_id": "e90ad575-9772-484d-8768-0835c79e81fa",
                                                "sense_id": "a2cb5fa2-78ac-36af-8f62-ed5d3294e3e2",
                                                "text": "Doncaster is a rail hub in every sense. Passenger lines radiate in six directions, there are freight lines that bypass the station, extensive freight yards, a major works, and a rolling stock depot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2fe770b-3123-3ef7-b7d7-619bda6025e4",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A central facility providing a range of related services, such as a medical hub or an educational hub."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2206c85-85b3-3a61-838b-7d98e37c197d",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A computer networking device connecting several Ethernet ports. See switch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea54190b-aa13-3f2e-a64a-da5c800307c7",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A stake with a nail in it, used to mark a temporary point."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8aedd248-8228-3b66-9c8e-24533bebca15",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A male weasel; a buck; a dog; a jack."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db130989-cc30-327b-b12c-33c7891ee83e",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "A rough protuberance or projecting obstruction."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36c2f0b2-4bc5-4fc6-a8e6-db3b5d084f56",
                                                "sense_id": "db130989-cc30-327b-b12c-33c7891ee83e",
                                                "text": "a hub in the road"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a91684f5-7f17-31ee-ad1d-d52cfa96dddf",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
                                            "An area in a video game from which individual levels are accessed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f32d58c3-4fe9-467e-af87-5f2d467fd333",
                                                "sense_id": "a91684f5-7f17-31ee-ad1d-d52cfa96dddf",
                                                "text": "In a break with tradition, these levels are tackled in any order, with the next act chosen from a semi-random selection machine located in the game's hub area."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cdd04143-d706-3f38-a877-f867f471f53f",
                                        "entry_id": "406647be-df7c-3377-8489-0aa6101fbad5",
                                        "glosses": [
