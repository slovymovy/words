            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e6c782d3-243b-3f9b-bc19-73a38becb0c4",
                    "sense_definition": "dostrzec kogoś lub coś za pomocą wzroku albo innych zmysłów",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "postrzeganie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dopiero po chwili <w>zauważyłem</w> klucze leżące na stole w kuchni.",
                            "target_lang_translations": {
                                "ru": "Только через некоторое время я <w>заметил</w> ключи, лежащие на столе в кухне."
                            }
                        },
                        {
                            "text": "Czy <w>zauważyłeś</w> zmianę w jej zachowaniu podczas wczorajszego spotkania?",
                            "target_lang_translations": {
                                "ru": "Ты <w>заметил</w> перемену в её поведении во время вчерашней встречи?"
                            }
                        }
                    ],
                    "synonyms": [
                        "spostrzec"
                    ],
                    "antonyms": [
                        "przeoczyć"
                    ],
                    "common_phrases": [
                        "zauważyć różnicę",
                        "zauważyć błąd",
                        "dać się zauważyć",
                        "trudno nie zauważyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "увидеть, обнаружить кого-либо или что-либо зрением или другими чувствами"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметить",
                                "target_lang_sense_clarification": "обнаружить взглядом или чувствами"
                            },
                            {
                                "target_lang_word": "увидеть",
                                "target_lang_sense_clarification": "зрительно обнаружить"
                            },
                            {
                                "target_lang_word": "приметить",
                                "target_lang_sense_clarification": "обратить внимание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "57951918-02b9-3173-add0-58c0f16485b8",
                    "sense_definition": "zrobić uwagę, wypowiedzieć spostrzeżenie na jakiś temat",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "wypowiedź",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jak słusznie <w>zauważył</w> mój przedmówca, ten problem wymaga natychmiastowego rozwiązania.",
                            "target_lang_translations": {
                                "ru": "Как правильно <w>заметил</w> мой предшественник, эта проблема требует немедленного решения."
                            }
                        },
                        {
                            "text": "Profesor <w>zauważyła</w> w swoim wykładzie, że te dane są niekompletne.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>отметила</w> в своей лекции, что эти данные неполные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "słusznie zauważyć",
                        "warto zauważyć"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать замечание, высказать наблюдение или соображение по какому-либо поводу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметить",
                                "target_lang_sense_clarification": "сделать замечание, высказать мысль"
                            },
                            {
                                "target_lang_word": "отметить",
                                "target_lang_sense_clarification": "обратить внимание словами, подчеркнуть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0efd5051-7d57-3830-b6f1-ab7c8bfdda1d",
                    "sense_definition": "w odniesieniu do grupy osób lub dwóch stron: nawzajem dostrzec swoją obecność",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "postrzeganie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kiedy wreszcie się <w>zauważyli</w> w tłumie na dworcu, pomachali do siebie z radością.",
                            "target_lang_translations": {
                                "ru": "Когда они наконец <w>заметили друг друга</w> в толпе на вокзале, они радостно помахали руками."
                            }
                        },
                        {
                            "text": "Przechodzili obok siebie codziennie, ale dopiero dzisiaj tak naprawdę się <w>zauważyli</w>.",
                            "target_lang_translations": {
                                "ru": "Они проходили мимо друг друга каждый день, но только сегодня по-настоящему <w>заметили друг друга</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "взаимно увидеть, обнаружить присутствие друг друга"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заметить друг друга",
                                "target_lang_sense_clarification": "взаимно увидеть"
                            },
                            {
                                "target_lang_word": "увидеть друг друга",
                                "target_lang_sense_clarification": "встретиться взглядом, обнаружить присутствие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
