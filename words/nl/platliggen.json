{
    "word_family": [
        "liggen",
        "plat",
        "platligger"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7f84ed61-8d0c-3a4b-a14a-ca3129ae007f",
                    "sense_definition": "In een horizontale of vlakke houding rusten, vaak wegens ziekte of rust.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De patiënt moet na de operatie minstens drie dagen <w>platliggen</w>.",
                            "target_lang_translations": {
                                "en": "The patient must <w>lie flat</w> for at least three days after the operation."
                            }
                        },
                        {
                            "text": "Zes weken in het ziekenhuis <w>platliggen</w> gaf hem veel tijd om na te denken.",
                            "target_lang_translations": {
                                "en": "Being <w>laid up</w> in the hospital for six weeks gave him a lot of time to think."
                            }
                        }
                    ],
                    "synonyms": [
                        "liggen",
                        "neerliggen"
                    ],
                    "antonyms": [
                        "staan",
                        "opstaan"
                    ],
                    "common_phrases": [
                        "in bed platliggen",
                        "platliggen in het ziekenhuis"
                    ],
                    "target_lang_definitions": {
                        "en": "To rest in a horizontal or flat position, often due to illness or the need for rest."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be bedridden",
                                "target_lang_sense_clarification": "due to illness"
                            },
                            {
                                "target_lang_word": "to lie flat",
                                "target_lang_sense_clarification": "physical position"
                            },
                            {
                                "target_lang_word": "to be laid up",
                                "target_lang_sense_clarification": "unable to move due to injury or sickness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0c252682-b918-3178-866a-372f7b206665",
                    "sense_definition": "Buiten werking zijn of stil liggen als gevolg van een staking, aanval of technisch defect.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "stilvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de grote computerstoring <w>ligt</w> het hele netwerk <w>plat</w>.",
                            "target_lang_translations": {
                                "en": "Due to the major computer glitch, the entire network <w>is down</w>."
                            }
                        },
                        {
                            "text": "Het treinverkeer zal door de staking in meerdere regio's tegelijk <w>platliggen</w>.",
                            "target_lang_translations": {
                                "en": "Train traffic will <w>be at a standstill</w> in several regions at once due to the strike."
                            }
                        }
                    ],
                    "synonyms": [
                        "stilstaan",
                        "uitvallen"
                    ],
                    "antonyms": [
                        "draaien",
                        "functioneren"
                    ],
                    "common_phrases": [
                        "het verkeer ligt plat",
                        "het systeem ligt plat"
                    ],
                    "target_lang_definitions": {
                        "en": "To be out of operation or at a standstill as a result of a strike, attack, or technical defect."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to be down",
                                "target_lang_sense_clarification": "systems or networks"
                            },
                            {
                                "target_lang_word": "to be at a standstill",
                                "target_lang_sense_clarification": "traffic or processes"
                            },
                            {
                                "target_lang_word": "to be paralyzed",
                                "target_lang_sense_clarification": "total lack of activity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "857da8a3-63b4-34a4-b4c8-0dbb77112834",
                    "sense_definition": "Iets vlak of plat maken door er langdurig op te rusten of te drukken.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fysieke houding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het hoge gras zagen we overal <w>platgelegen</w> plekken waar herten hadden geslapen.",
                            "target_lang_translations": {
                                "en": "In the tall grass, we saw <w>flattened</w> spots everywhere where deer had slept."
                            }
                        },
                        {
                            "text": "De wandelaars hadden het koren op het veld volledig <w>platgelegen</w>.",
                            "target_lang_translations": {
                                "en": "The hikers had completely <w>trampled down</w> the corn in the field."
                            }
                        }
                    ],
                    "synonyms": [
                        "platdrukken"
                    ],
                    "common_phrases": [
                        "het gras platliggen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make something flat or level by resting or pressing on it for a long time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to flatten",
                                "target_lang_sense_clarification": "by lying on something"
                            },
                            {
                                "target_lang_word": "to trample down",
                                "target_lang_sense_clarification": "grass or crops"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}