                                "target_lang_sense_clarification": "о звуке петуха"
                            },
                            {
                                "target_lang_word": "ликование",
                                "target_lang_sense_clarification": "хвастовство, торжество"
                            },
                            {
                                "target_lang_word": "кукарекающий",
                                "target_lang_sense_clarification": "в роли причастия"
                            },
