        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7a46c291-0a92-32bb-a7e6-5327026c5f13",
                "word": "balancing",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "4a8e4a69-739e-49bd-aa6e-de4b1443c33f",
                        "entry_id": "7a46c291-0a92-32bb-a7e6-5327026c5f13",
                        "tags": [
                            "plural"
                        ],
                        "form": "balancings"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c60af507-61de-37fc-a743-e56c6ce22dd3",
                        "entry_id": "7a46c291-0a92-32bb-a7e6-5327026c5f13",
                        "glosses": [
                            "An action wherein someone balances or something is balanced"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aecbda56-5415-4577-bfd8-bc934309268a",
                                "sense_id": "c60af507-61de-37fc-a743-e56c6ce22dd3",
                                "text": "In other places of the holy writings the Almighty is described as weighing the mountains in scales, making the weight for the winds, knowing the balancings of the clouds; and, in others, as weighing the actions of men, and laying their calamities together in a balance."
                            },
                            {
                                "example_id": "31076b41-dd56-4550-93de-505500b2875a",
                                "sense_id": "c60af507-61de-37fc-a743-e56c6ce22dd3",
                                "text": "And he locked her up all day in her room doing her balancings, the boomerang on the front wheel, the standstill on the back-wheel, or the bike upside down, with Lily standing on the pedals, like a convict on the tread-mill."
                            },
                            {
                                "example_id": "3afdeb8e-171b-4130-8265-dcf8a0c0c530",
                                "sense_id": "c60af507-61de-37fc-a743-e56c6ce22dd3",
                                "text": "But she had been reading deeply of the Alps, and in all the histories of mountain exploits which she had read, of climbs up vertical cracks in sheer walls of rocks, balancings upon ridges sharp as a knife edge, crawlings over smooth slabs with nowhere to rest the feet or hands, it was the ice-slope which had most kindled her imagination."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5c6c2a6-7ef7-443e-a5db-f41137395404",
                        "source_entry_id": "7a46c291-0a92-32bb-a7e6-5327026c5f13",
                        "source_sense_id": "c60af507-61de-37fc-a743-e56c6ce22dd3",
