                "senses": [
                    {
                        "sense_id": "2f870225-f532-302d-b052-c8e943350b0b",
                        "entry_id": "1940ff96-d181-36a8-8ec5-33e8605e152a",
                        "glosses": [
                            "сгибаясь, завернуться или искривиться в сторону, вверх или вниз"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b636664d-7688-3bb2-ab70-49bf6d75c7dd",
                        "entry_id": "1940ff96-d181-36a8-8ec5-33e8605e152a",
                        "glosses": [
                            "перен., прост., груб. то же, что умереть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e34f336-7bbc-4a68-981f-bc67c64d810e",
                                "sense_id": "b636664d-7688-3bb2-ab70-49bf6d75c7dd",
                                "text": "Конечно, не сладко, конечно, жалко людей, но вот он, например, выжил! Теперь задача не загнуться от голода. Жрать охота до безумия."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5fb389a-ddc7-458d-9ef4-ce0a21dedd79",
                        "source_entry_id": "1940ff96-d181-36a8-8ec5-33e8605e152a",
                        "target_lang_word": "kick the bucket",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kick the bucket",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "91df72bb-330b-398f-9d1c-fa7ef11a6d5f",
                                        "entry_id": "2099ce51-2980-3c4f-9411-8d7f3610c280",
                                        "glosses": [
                                            "To die."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "euphemistic",
                                            "humorous",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2fdd7ace-3f33-4624-b2d4-b674b6919f50",
                                                "sense_id": "91df72bb-330b-398f-9d1c-fa7ef11a6d5f",
                                                "text": "The old horse finally kicked the bucket."
                                            },
                                            {
                                                "example_id": "dacd0855-dc24-4247-aef0-8dc513cb1301",
                                                "sense_id": "91df72bb-330b-398f-9d1c-fa7ef11a6d5f",
                                                "text": "My posthumous book Allegorizings, which will go to press in London and New York the minute I kick the bucket, is loosely governed by my growing conviction that almost nothing in life is only what it seems. It contains nothing revelatory at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1a9870b-3df1-3622-8707-b3cd89c19331",
                                        "entry_id": "2099ce51-2980-3c4f-9411-8d7f3610c280",
                                        "glosses": [
                                            "To break down such that it cannot be repaired."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31219e08-10e2-4b4b-8d18-d03b0b97cc34",
                                                "sense_id": "b1a9870b-3df1-3622-8707-b3cd89c19331",
                                                "text": "I think my sewing machine has kicked the bucket."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
