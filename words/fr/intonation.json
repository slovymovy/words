                        "intonation descendante"
                    ]
                },
                {
                    "sense_id": "0b1ef309-d7ea-3284-913f-d6dc554ae813",
                    "sense_definition": "Exactitude et justesse de la hauteur des sons émis par la voix ou par un instrument.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "musique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur de chant exige une <w>intonation</w> parfaite sur chaque note tenue."
                        },
                        {
                            "text": "Ce jeune violoniste doit encore travailler son <w>intonation</w> pour jouer juste."
