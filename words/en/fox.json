{
    "word_family": [
        "foxy",
        "outfox",
        "foxhole",
        "foxhound",
        "foxglove",
        "vixen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "74dade88-79a2-3e74-b705-9016f8708d43",
                    "sense_definition": "A wild mammal belonging to the dog family, typically having a pointed muzzle, upright ears, and a bushy tail.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quick brown <w>fox</w> jumps over the lazy dog.",
                            "target_lang_translations": {
                                "ru": "Шустрая бурая <w>лиса</w> перепрыгивает через ленивую собаку.",
                                "zh": "那只敏捷的棕色<w>狐狸</w>跳过了那只懒狗。"
                            }
                        },
                        {
                            "text": "We saw a red <w>fox</w> running across the snowy field yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера мы видели рыжую <w>лису</w>, бегущую по заснеженному полю.",
                                "zh": "昨天我们看到一只红<w>狐狸</w>跑过雪地。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "red fox",
                        "sly as a fox",
                        "crazy like a fox",
                        "quick brown fox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дикое млекопитающее семейства псовых, обычно с острой мордой, стоячими ушами и пушистым хвостом.",
                        "zh": "一种属于犬科的野生哺乳动物，通常有尖尖的口鼻部、竖立的耳朵和蓬松的尾巴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лиса",
                                "target_lang_sense_clarification": "животное"
                            },
                            {
                                "target_lang_word": "лисица",
                                "target_lang_sense_clarification": "животное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狐狸",
                                "target_lang_sense_clarification": "动物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb19201a-7869-397d-ad8d-320f160d31f9",
                    "sense_definition": "The fur of a fox, often used to make clothing or accessories.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a coat made of expensive <w>fox</w> to the winter gala.",
                            "target_lang_translations": {
                                "ru": "Она надела шубу из дорогой <w>лисы</w> на зимний гала-концерт.",
                                "zh": "她穿着一件昂贵的<w>狐皮</w>大衣参加了冬季晚宴。"
                            }
                        },
                        {
                            "text": "The collar of the jacket was trimmed with soft white <w>fox</w>.",
                            "target_lang_translations": {
                                "ru": "Воротник куртки был оторочен мягким белым <w>лисьим мехом</w>.",
                                "zh": "夹克的领子是用柔软的白色<w>狐狸毛</w>装饰的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "fox fur",
                        "silver fox"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мех лисицы, часто используемый для изготовления одежды или аксессуаров.",
                        "zh": "狐狸的皮毛，常用于制作服装或配饰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лиса",
                                "target_lang_sense_clarification": "мех"
                            },
                            {
                                "target_lang_word": "лисий мех",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "狐狸毛",
                                "target_lang_sense_clarification": "材料"
                            },
                            {
                                "target_lang_word": "狐皮",
                                "target_lang_sense_clarification": "材料"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45d2595f-e0d9-3e67-b517-e246b5cadbe4",
                    "sense_definition": "A person who is clever, cunning, and often deceptive.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't trust him with your business plans; he is a sly <w>fox</w>.",
                            "target_lang_translations": {
                                "ru": "Не доверяй ему свои бизнес-планы; он хитрый <w>лис</w>.",
                                "zh": "别把你的商业计划告诉他，他是个狡猾的<w>老狐狸</w>。"
                            }
                        },
                        {
                            "text": "The old <w>fox</w> managed to outsmart all his competitors in the deal.",
                            "target_lang_translations": {
                                "ru": "Старый <w>лис</w> сумел перехитрить всех своих конкурентов в этой сделке.",
                                "zh": "这只<w>老狐狸</w>在交易中成功胜过了他所有的竞争对手。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trickster",
                        "schemer"
                    ],
                    "common_phrases": [
                        "sly fox",
                        "old fox"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used metaphorically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который умен, хитер и часто склонен к обману.",
                        "zh": "指代聪明、狡猾且常有欺骗行为的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрец",
                                "target_lang_sense_clarification": "человек"
                            },
                            {
                                "target_lang_word": "лис",
                                "target_lang_sense_clarification": "метафора"
                            },
                            {
                                "target_lang_word": "плут",
                                "target_lang_sense_clarification": "обманщик"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "老狐狸",
                                "target_lang_sense_clarification": "比喻狡猾的人"
                            },
                            {
                                "target_lang_word": "狡猾的人",
                                "target_lang_sense_clarification": "性格描述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "692b9f49-5d90-303c-9159-88d156eaebcb",
                    "sense_definition": "A physically attractive person, typically a woman.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He thinks the new girl in our class is a total <w>fox</w>.",
                            "target_lang_translations": {
                                "ru": "Он считает, что новенькая в нашем классе — настоящая <w>красотка</w>.",
                                "zh": "他觉得我们班新来的那个女生是个大<w>美女</w>。"
                            }
                        },
                        {
                            "text": "Back in the day, she was considered a real <w>fox</w> by everyone in town.",
                            "target_lang_translations": {
                                "ru": "В свое время все в городе считали ее настоящей <w>красавицей</w>.",
                                "zh": "在过去，镇上的每个人都认为她是个真正的<w>尤物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "babe",
                        "stunner",
                        "knockout",
                        "hottie",
                        "looker"
                    ],
                    "common_phrases": [
                        "stone cold fox"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "common in late 20th century"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически привлекательный человек, обычно женщина.",
                        "zh": "指外表非常有吸引力的人，通常指女性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "красотка",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "красавица",
                                "target_lang_sense_clarification": "внешность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美女",
                                "target_lang_sense_clarification": "外貌"
                            },
                            {
                                "target_lang_word": "尤物",
                                "target_lang_sense_clarification": "极具吸引力的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "058748f7-ad3b-3b0e-a38c-ae87b0fa76b8",
                    "sense_definition": "A common surname or male given name.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "person_name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Fox</w> will be available to meet with you in five minutes.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Фокс</w> сможет встретиться с вами через пять минут.",
                                "zh": "<w>福克斯</w>先生五分钟后可以见你。"
                            }
                        },
                        {
                            "text": "My neighbor's last name is <w>Fox</w>, and he is very friendly.",
                            "target_lang_translations": {
                                "ru": "Фамилия моего соседа — <w>Фокс</w>, и он очень дружелюбен.",
                                "zh": "我邻居姓<w>福克斯</w>，他非常友好。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распространенная фамилия или мужское имя.",
                        "zh": "常见的姓氏或男性名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фокс",
                                "target_lang_sense_clarification": "имя/фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "福克斯",
                                "target_lang_sense_clarification": "人名/姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40053c9c-9a85-3152-ad24-bb809b715cab",
                    "sense_definition": "A major television network and media company.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "We watched the breaking news report on <w>Fox</w> last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером мы смотрели экстренный выпуск новостей на канале <w>Фокс</w>.",
                                "zh": "昨晚我们看了<w>福克斯</w>电视台的突发新闻报道。"
                            }
                        },
                        {
                            "text": "The popular television show airs exclusively on the <w>Fox</w> channel.",
                            "target_lang_translations": {
                                "ru": "Это популярное телешоу выходит эксклюзивно на канале <w>Фокс</w>.",
                                "zh": "这个热门电视节目只在<w>福克斯</w>频道播出。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Fox News",
                        "Fox Sports"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупная телевизионная сеть и медиакомпания.",
                        "zh": "一家大型电视网络和媒体公司。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Фокс",
                                "target_lang_sense_clarification": "название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "福克斯",
                                "target_lang_sense_clarification": "媒体机构"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79b76ea9-3bf6-3855-b34b-3c8d50ff3d9d",
                    "sense_definition": "To confuse, baffle, or deceive someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cognition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult math problem completely <w>foxed</w> the students during the exam.",
                            "target_lang_translations": {
                                "ru": "Сложная математическая задача совершенно <w>сбила с толку</w> студентов во время экзамена.",
                                "zh": "那道难题在考试中彻底把学生们<w>难倒</w>了。"
                            }
                        },
                        {
                            "text": "I was <w>foxed</w> by the strange instructions printed on the box.",
                            "target_lang_translations": {
                                "ru": "Я был <w>озадачен</w> странными инструкциями, напечатанными на коробке.",
                                "zh": "我被盒子上印的奇怪说明书<w>迷惑</w>住了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "baffle",
                        "confuse",
                        "outwit",
                        "trick"
                    ],
                    "common_phrases": [
                        "completely foxed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сбить с толку, озадачить или обмануть кого-то.",
                        "zh": "使某人困惑、不知所措或欺骗某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сбить с толку",
                                "target_lang_sense_clarification": "фразеологизм"
                            },
                            {
                                "target_lang_word": "озадачить",
                                "target_lang_sense_clarification": "глагол"
                            },
                            {
                                "target_lang_word": "запутать",
                                "target_lang_sense_clarification": "глагол"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "难倒",
                                "target_lang_sense_clarification": "使困惑"
                            },
                            {
                                "target_lang_word": "迷惑",
                                "target_lang_sense_clarification": "使困惑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c59821f-55db-3018-b954-68378a0d0d43",
                    "sense_definition": "To become discolored with brown spots, typically said of old paper or books.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deterioration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pages of the antique manuscript had started to <w>fox</w> due to humidity.",
                            "target_lang_translations": {
                                "ru": "Страницы старинной рукописи начали <w>покрываться пятнами</w> из-за влажности.",
                                "zh": "由于潮湿，那份古老手稿的页面已经开始<w>生霉斑</w>了。"
                            }
                        },
                        {
                            "text": "If you do not store the prints correctly, the paper will eventually <w>fox</w>.",
                            "target_lang_translations": {
                                "ru": "Если не хранить гравюры правильно, бумага со временем <w>пожелтеет</w>.",
                                "zh": "如果你不妥善保存这些印刷品，纸张最终会<w>发黄</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "discolor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрываться бурыми пятнами (обычно о старой бумаге или книгах).",
                        "zh": "指纸张或书籍因受潮而出现褐色斑点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покрываться пятнами",
                                "target_lang_sense_clarification": "о бумаге"
                            },
                            {
                                "target_lang_word": "желтеть",
                                "target_lang_sense_clarification": "о бумаге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "生霉斑",
                                "target_lang_sense_clarification": "纸张老化"
                            },
                            {
                                "target_lang_word": "发黄",
                                "target_lang_sense_clarification": "纸张老化"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}