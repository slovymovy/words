                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eucalypte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "64fc26ba-6685-3135-b63b-0316c3549deb",
                                        "entry_id": "7e5d6f8a-622f-374b-b460-e56b2f435adf",
                                        "glosses": [
                                            "Eucalyptus."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f17d8a44-7f7b-42c3-8fbe-99d0cbd36c7c",
                                                "sense_id": "64fc26ba-6685-3135-b63b-0316c3549deb",
                                                "text": "La dimension des arbres est très-variée ; tandis que certains d’entre eux, placés sous ce rapport à la limite inférieure, se rapprochent des arbrisseaux et ne dépassent guère cinq à six mètres, il en est, tels que les eucalyptes, qui atteignent jusqu’à cent cinquante mètres."
                                            },
                                            {
                                                "example_id": "a5dda620-4694-4417-8935-d3d74fd06cec",
                                                "sense_id": "64fc26ba-6685-3135-b63b-0316c3549deb",
                                                "text": "Les rues et les jardins brillent de tout l’éclat d’une végétation tropicale, où l’on rencontre l’eucalypte, le poivrier, l’olivier, l’oranger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b3d7065-ef95-4cca-b85e-0c258fee928f",
