    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1405f0a7-10c2-31b1-b896-819659cbd72e",
                    "sense_definition": "zitmeubel waarvan de zitting om een verticale as kan draaien, vaak gebruikt op een kantoor",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meubel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij kocht een comfortabele <w>draaistoel</w> voor zijn nieuwe werkplek op kantoor.",
                            "target_lang_translations": {
                                "en": "He bought a comfortable <w>swivel chair</w> for his new workspace at the office."
                            }
                        },
                        {
                            "text": "Zij draaide zich op haar <w>draaistoel</w> om naar haar collega te luisteren.",
                            "target_lang_translations": {
                                "en": "She turned around in her <w>swivel chair</w> to listen to her colleague."
                            }
                        }
                    ],
                    "synonyms": [
                        "bureaustoel"
                    ],
                    "common_phrases": [
                        "comfortabele draaistoel",
                        "op een draaistoel zitten"
                    ],
                    "target_lang_definitions": {
                        "en": "a piece of furniture designed for sitting whose seat can rotate around a vertical axis, commonly used in an office"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "swivel chair",
                                "target_lang_sense_clarification": "rotating seat"
                            },
                            {
                                "target_lang_word": "office chair",
                                "target_lang_sense_clarification": "desk chair, typically swiveling"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b691c900-2503-37c9-8081-59b72ec74b4c",
                    "sense_definition": "kleine draaibank die gebruikt wordt in de fijnmechanica, bijvoorbeeld door horlogemakers",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gereedschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De horlogemaker bewerkte het kleine radertje uiterst precies op zijn <w>draaistoel</w>.",
                            "target_lang_translations": {
                                "en": "The watchmaker machined the small gear wheel with extreme precision on his <w>watchmaker's lathe</w>."
                            }
                        },
                        {
                            "text": "In het oude atelier stond een antieke <w>draaistoel</w> voor fijnmechanisch precisiewerk.",
                            "target_lang_translations": {
                                "en": "In the old workshop stood an antique <w>watchmaker's lathe</w> for precision mechanical work."
                            }
                        }
                    ],
                    "synonyms": [
                        "horlogemakersdraaibank"
                    ],
                    "target_lang_definitions": {
                        "en": "a small lathe used in precision mechanics, for example by watchmakers"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watchmaker's lathe",
                                "target_lang_sense_clarification": "small precision lathe"
                            },
                            {
                                "target_lang_word": "turns",
                                "target_lang_sense_clarification": "historical horological tool"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}