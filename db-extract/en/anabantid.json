                        "glosses": [
                            "Any member of the family Anabantidae of climbing perches."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13a07a2e-5ee8-408a-9eef-2f05aa9311b7",
                                "sense_id": "010d3d4f-9bb3-3ddb-a114-ae0bda0dab09",
                                "text": "Again, the emotions of jealousy and rivalry are manifested to such an extent by the anabantid betta pugnax of Siam, that the species has been cultivated by the inhabitants of the country for the sport they furnish, which for them vies in interest with the cock-fights and bull-fights of the Spanish peoples."
                            },
                            {
                                "example_id": "87af9ec9-b0d5-4efd-92ad-7317eea377ca",
                                "sense_id": "010d3d4f-9bb3-3ddb-a114-ae0bda0dab09",
                                "text": "Anabantids are a very popular group of fish from Asia and Africa, most of which are known as gouramis."
                            },
                            {
                                "example_id": "e6b9132b-d07c-4a9e-a1c0-07cb9892b697",
                                "sense_id": "010d3d4f-9bb3-3ddb-a114-ae0bda0dab09",
                                "text": "Toxotid and anabantid fish from Southeast Asia project spouts of water toward prey above the surface of the water ."
                            }
                        ]
                    }
