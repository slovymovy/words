            {
                "entry_id": "20279986-c433-34b3-9ec2-22db5c4938ec",
                "word": "milord",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8fc051a9-c3b8-4b3a-9d11-edb23c11c944",
                        "entry_id": "20279986-c433-34b3-9ec2-22db5c4938ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "milords"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a800d769-d98b-3e76-9719-4a251d40ff49",
                        "entry_id": "20279986-c433-34b3-9ec2-22db5c4938ec",
                        "glosses": [
                            "An English nobleman, especially one traveling Europe in grand style; a wealthy British gentleman."
                        ],
                        "tags": [
                            "British",
                            "humorous",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "65372d62-77b1-4678-a51a-bb66c4aef588",
                                "sense_id": "a800d769-d98b-3e76-9719-4a251d40ff49",
                                "text": "Not since the year 17—, when milord Castlebrilliant's curricle was whirled to sea with her ladyship within, had there been such vehement weather."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cdb47c17-3c5d-4cfb-9f88-5ee6dc1efabf",
                        "source_entry_id": "20279986-c433-34b3-9ec2-22db5c4938ec",
                        "source_sense_id": "a800d769-d98b-3e76-9719-4a251d40ff49",
                        "source_sense_description": "Traveling English nobleman",
                        "target_lang_word": "milord",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "milord",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8ff80062-bb34-3096-a731-92ad7d1c5ccc",
                                        "entry_id": "5016c45e-b7db-38a4-ace0-1e30d1a8a5a2",
                                        "glosses": [
                                            "Terme anglais par lequel on s’adresse à un lord."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1f2e6b1-363a-48cc-81e4-7a07d4671d30",
                                                "sense_id": "8ff80062-bb34-3096-a731-92ad7d1c5ccc",
                                                "text": "Il est sûr, milord, dit le marquis en riant, qu'un Anglais pouvait seul me faire une proposition si bizarre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c06c273-831c-36b5-a629-04b7f804a599",
                                        "entry_id": "5016c45e-b7db-38a4-ace0-1e30d1a8a5a2",
                                        "glosses": [
                                            "Homme riche."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f2573cd-410c-4504-880e-4335bd478629",
                                                "sense_id": "1c06c273-831c-36b5-a629-04b7f804a599",
                                                "text": "Il a des breloques, il impose aux gens de menu, passe pour un milord dans les villages."
                                            },
                                            {
                                                "example_id": "839a3d5c-38c6-4415-9a94-a2a6e8c1e80a",
                                                "sense_id": "1c06c273-831c-36b5-a629-04b7f804a599",
                                                "text": "« Voilà notre milord ivre mort, disait le lancier. Eh bien, on a beau dire, moi je bois tout mon argent, mais jamais on ne m’a vu comme milord »."
                                            },
                                            {
                                                "example_id": "45936ca3-b60b-4758-b913-07fe7d0a45f6",
                                                "sense_id": "1c06c273-831c-36b5-a629-04b7f804a599",
                                                "text": "Ils firent une courte halte chez Larouche, à Sherbrooke, le temps que lui aussi se sape façon milord pour aller se taper la cloche \"Chez Bouchard-Taylor\"."
                                            },
                                            {
                                                "example_id": "6df8e220-35b4-48c5-a652-1fe9d4868dba",
                                                "sense_id": "1c06c273-831c-36b5-a629-04b7f804a599",
                                                "text": "Francis Claude ambitionnait d'attirer chez lui les intellectuels et la bourgeoisie de la rive gauche, désireux de « s'encanailler ». Aurait-il pu choisir un autre nom que celui de l'homme qui se conduisait comme un milord avec les arsouilles et comme une arsouille avec les milords."
                                            },
                                            {
                                                "example_id": "ebda1e32-9727-449e-939e-235497ff3c67",
                                                "sense_id": "1c06c273-831c-36b5-a629-04b7f804a599",
                                                "text": "Comme chaque fois que je nippais en milord, costume en cashmere, les pieds campés dans des Richelieu, j'avais une pensée pour le beau-père de mon ami P., un voyou de la vieille école, que je n'avais vu que trois fois dans ma vie, mais dont la ganache m'avait imposé le respect pour toujours."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ec3833c-2734-350f-9b2d-ae1088335014",
                                        "entry_id": "5016c45e-b7db-38a4-ace0-1e30d1a8a5a2",
                                        "glosses": [
                                            "Voiture à cheval où le cocher est assis sur un siège surélevé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee7c987-2069-4946-9712-9b4c789ac312",
                                                "sense_id": "4ec3833c-2734-350f-9b2d-ae1088335014",
                                                "text": "Vers le milieu du mois de juillet de l’année 1838, une de ces voitures nouvellement mises en circulation sur les places de Paris et nommées des milords, cheminait, rue de l’Université, portant un gros homme de taille moyenne, en uniforme de capitaine de la garde nationale."
                                            },
                                            {
                                                "example_id": "336813f5-c2a0-43ae-9a61-6912d0bdc9cd",
                                                "sense_id": "4ec3833c-2734-350f-9b2d-ae1088335014",
                                                "text": "Tant de bogheis, de phaétons, de milords n’étaient pas inutiles à un agité, qui du matin au soir, parcourait Paris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b99865e-6938-4adc-abf6-7e42fc76a875",
