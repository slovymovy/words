                                "target_senses": [
                                    {
                                        "sense_id": "555782b3-517c-3152-80d9-51dfc57d840e",
                                        "entry_id": "f5fe21c9-c541-3522-ae7c-5df1553ee8e5",
                                        "glosses": [
                                            "in Human- und Tiermedizin eingesetztes Anästhetikum mit dissoziativer Wirkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dc2907a-0995-400e-88fa-db6fcb221f84",
                                                "sense_id": "555782b3-517c-3152-80d9-51dfc57d840e",
                                                "text": "„Irgend'ne Arschgeige hat ihr tonnenweise Ketamin gegeben und versucht, sie zu vergewaltigen.“"
                                            },
                                            {
                                                "example_id": "bebddb54-2586-457c-aba9-dc5ff6597386",
                                                "sense_id": "555782b3-517c-3152-80d9-51dfc57d840e",
                                                "text": "„Er beschreibt die außerkörperlichen Erfahrungen nach der Einnahme eines Narkotikums, Ketamin, was der Gegenkulturheld Timothy Leary als ›Experimente mit freiwilligem Tod‹ beschrieben hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7d7d40c-6187-4988-991c-73326f73cac1",
                        "source_entry_id": "1f26c12c-78a9-324b-86e6-757c0db12930",
                        "source_sense_id": "c146e0cb-d078-3257-ba98-ea7bfd7e6f2c",
                        "target_lang_word": "ketamine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ketamine",
