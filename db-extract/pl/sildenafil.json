                                "sense_id": "c4a64105-11ae-3ad2-8565-afc6aed8925f",
                                "text": "Jeśli ktoś przyjął nitroglicerynę, zakazane jest wzięcie sildenafilu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
