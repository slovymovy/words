                        "sense_id": "35bc2aeb-c8b4-3548-8975-d00f24e64e6e",
                        "entry_id": "134e033b-f1b3-3239-81ef-70a92a2ba715",
                        "glosses": [
                            "früherer Name (bis 1975) des Landes Benin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5bf89217-2cd4-4657-be8c-b9c897c24d10",
                                "sense_id": "35bc2aeb-c8b4-3548-8975-d00f24e64e6e",
                                "text": "In Dahome, dem heutigen Benin, wurden über 50 verschiedene Sprachen gesprochen."
                            },
                            {
                                "example_id": "09a61fdd-a055-48f2-a132-53d64182bea3",
                                "sense_id": "35bc2aeb-c8b4-3548-8975-d00f24e64e6e",
                                "text": "„Dahome leidet an wirtschaftlicher Auszehrung, seit Frankreich seine Kolonie 1960 in die Unabhängigkeit entließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
