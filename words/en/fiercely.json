{
    "word_family": [
        "fierce",
        "fierceness"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "73c02c7a-6dbb-34f5-a88e-62337ec04bb0",
                    "sense_definition": "In a violent, aggressive, or intense manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wind blew <w>fiercely</w> against the windows during the storm.",
                            "target_lang_translations": {
                                "pl": "Podczas burzy wiatr <w>ostro</w> uderzał w okna."
                            }
                        },
                        {
                            "text": "The two animals fought <w>fiercely</w> over the piece of food.",
                            "target_lang_translations": {
                                "pl": "Dwa zwierzęta <w>zawzięcie</w> walczyły o kawałek jedzenia."
                            }
                        }
                    ],
                    "synonyms": [
                        "violently",
                        "aggressively",
                        "savagely"
                    ],
                    "antonyms": [
                        "gently",
                        "mildly"
                    ],
                    "common_phrases": [
                        "fought fiercely",
                        "blew fiercely"
                    ],
                    "target_lang_definitions": {
                        "pl": "W sposób gwałtowny, agresywny lub bardzo intensywny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "gwałtownie",
                                "target_lang_sense_clarification": "w sposób nagły lub bardzo intensywny"
                            },
                            {
                                "target_lang_word": "zawzięcie",
                                "target_lang_sense_clarification": "z dużą determinacją i uporem"
                            },
                            {
                                "target_lang_word": "ostro",
                                "target_lang_sense_clarification": "dotkliwie lub przenikliwie (np. o pogodzie)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6fd8f984-bdd0-3da5-b94b-b598364ecaa3",
                    "sense_definition": "To a very high or extreme degree.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>fiercely</w> independent and prefers to live alone.",
                            "target_lang_translations": {
                                "pl": "Jest <w>niezwykle</w> niezależna i woli mieszkać sama."
                            }
                        },
                        {
                            "text": "The company is <w>fiercely</w> competitive in the global market.",
                            "target_lang_translations": {
                                "pl": "Firma jest <w>skrajnie</w> konkurencyjna na rynku globalnym."
                            }
                        }
                    ],
                    "synonyms": [
                        "intensely",
                        "extremely",
                        "strongly"
                    ],
                    "common_phrases": [
                        "fiercely competitive",
                        "fiercely independent",
                        "fiercely loyal"
                    ],
                    "target_lang_definitions": {
                        "pl": "W bardzo wysokim lub ekstremalnym stopniu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niezwykle",
                                "target_lang_sense_clarification": "w bardzo wysokim stopniu"
                            },
                            {
                                "target_lang_word": "bardzo",
                                "target_lang_sense_clarification": "w znacznym stopniu"
                            },
                            {
                                "target_lang_word": "skrajnie",
                                "target_lang_sense_clarification": "w sposób ekstremalny"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}