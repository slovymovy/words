                                "example_id": "6d94565e-1315-470b-8a48-1cf58e0b46d1",
                                "sense_id": "77c29316-437e-3efa-b0f5-cbc7a43dfdb7",
                                "text": "Nazajutrz wstaję z rana, / Napełniam watermana, / Chcę pisać. Zapał twórczy / Po prostu we mnie furczy"
                            },
                            {
                                "example_id": "f5f51ca9-62c7-4934-a96d-198acbf8806c",
                                "sense_id": "77c29316-437e-3efa-b0f5-cbc7a43dfdb7",
                                "text": "Czy możesz mi kupić dwie paczki nabojów do watermana? Najlepiej czarnych."
                            }
                        ],
