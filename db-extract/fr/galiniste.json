                        "entry_id": "4694b22c-d244-38ea-90ea-f710d66959c2",
                        "glosses": [
                            "Personne se réclamant du galinisme en matière d’éducation musicale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a223bc0b-efb6-4926-bc1d-f71be8881277",
                                "sense_id": "1e847634-ff23-3f13-8696-1c727434f843",
                                "text": "Un excellent musicien de mes amis, un Galiniste, me racontait un jour comment l’idée lui vint d’aller à Paris pour se livrer à la propagande de la méthode Galin."
                            },
                            {
                                "example_id": "3e430cf1-e4cd-4362-a212-2bac7d02b566",
                                "sense_id": "1e847634-ff23-3f13-8696-1c727434f843",
                                "text": "La lutte entre galinistes et antigalinistes est ardente, passionnée ; elle prend parfois un caractère d’une violence regrettable : les adversaires en présence ne reculent pas devant l’injure, lorsqu'ils sont à bout d’arguments."
                            }
                        ]
                    }
