                "senses": [
                    {
                        "sense_id": "1349cf86-293e-3920-820a-aa74de04656e",
                        "entry_id": "a1c3067b-2186-3330-aee0-40462ebae4d7",
                        "glosses": [
                            "Geschäft, welches gegen Annahme von Wertgegenständen Darlehen vergibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04bc369a-b95d-4896-8d49-0f968b0358f6",
                                "sense_id": "1349cf86-293e-3920-820a-aa74de04656e",
                                "text": "„Noch vor einem Jahr hätte ein Mann wie Wolfgang Z. ausgeschlossen, jemals ein Pfandhaus zu betreten.“"
                            },
                            {
                                "example_id": "6a190f55-78d3-4213-8180-cb410ab1a1a1",
                                "sense_id": "1349cf86-293e-3920-820a-aa74de04656e",
                                "text": "„Da ich den Ring beim Pfandhaus einlösen mußte und nicht selbst hingehen wollte, schrieb ich dem Pfarrer, er möge zu einer bestimmten Stunde in Treviso sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0ee3809-d0ba-4eb3-a274-23185b0acc1b",
                        "source_entry_id": "a1c3067b-2186-3330-aee0-40462ebae4d7",
