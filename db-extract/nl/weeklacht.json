            {
                "entry_id": "e5c843f6-4965-3d21-bdd6-508d0bee65fe",
                "word": "weeklacht",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a2142602-9ccf-4736-b065-8fdb54a836df",
