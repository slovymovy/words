                "senses": [
                    {
                        "sense_id": "30464f06-2361-3735-9ba4-3ac13b696e9d",
                        "entry_id": "a63d183b-207c-3693-b3b6-ae466fb7626c",
                        "glosses": [
                            "Stoß mit dem Knie in den unteren Bereich des Oberschenkels, der dazu führt, dass dem Gestoßenen die Muskeln versagen und er zu Boden geht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d2a07934-4a81-48c3-8a15-b91c0655ce64",
                                "sense_id": "30464f06-2361-3735-9ba4-3ac13b696e9d",
                                "text": "Obwohl ihm ein Tschekabuff sogar erspart geblieben war, kehrte Jonas nach der Rauferei sehr lädiert nach Hause zurück."
                            },
                            {
                                "example_id": "dfebc7ee-81eb-4f4a-bc29-88955a8340d1",
                                "sense_id": "30464f06-2361-3735-9ba4-3ac13b696e9d",
                                "text": "Da hoffe ich doch noch nachträglich, dass meinen p.t. Lesern in der Schulzeit die Tschekabuffs erspart geblieben sein mögen."
                            },
                            {
                                "example_id": "5ac2aa10-ab5c-4a67-a2dd-f59c60e21f38",
                                "sense_id": "30464f06-2361-3735-9ba4-3ac13b696e9d",
                                "text": "„Ein Tschekabuff ist ziemlich präzise das, was man sich beim Klang des Wortes ausmalen kann: Stellen Sie sich vor, ihr Kontrahent rammt Ihnen sein Knie mit voller Wucht in die äußere Seite Ihres Oberschenkels (vorzugsweise in den Bereich des unteren Drittels).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
