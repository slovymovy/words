{
    "word_family": [
        "gesticulation",
        "gesticulative",
        "gesticulator",
        "gesticulatory",
        "gesture"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d529b48a-026d-3b06-831b-cc10bc942401",
                    "sense_definition": "To make gestures or expressive motions with the hands and arms, especially while speaking.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "gesturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>gesticulate</w> wildly as he described the dramatic accident to his friends.",
                            "target_lang_translations": {
                                "zh": "当他向朋友们描述那起惊心动魄的事故时，开始情绪激动地<w>指手画脚</w>起来。"
                            }
                        },
                        {
                            "text": "The speaker tended to <w>gesticulate</w> with her hands whenever she felt passionate about a topic.",
                            "target_lang_translations": {
                                "zh": "每当对某个话题充满激情时，演讲者往往会用双手不停地<w>做手势</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gesture",
                        "motion",
                        "wave"
                    ],
                    "common_phrases": [
                        "gesticulate wildly",
                        "gesticulate with hands",
                        "gesticulate excitedly",
                        "gesticulate animatedly"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指讲话时）用手势或动作示意；指手画脚"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "指手画脚",
                                "target_lang_sense_clarification": "动作激烈或动作幅度大"
                            },
                            {
                                "target_lang_word": "做手势",
                                "target_lang_sense_clarification": "说话时配合使用手势"
                            },
                            {
                                "target_lang_word": "打手势",
                                "target_lang_sense_clarification": "借助手部动作表达"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0058262-6cb7-38b6-9ea4-7d59a0ee2e73",
                    "sense_definition": "To express, convey, or emphasize something using gestures instead of or alongside words.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "gesturing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unable to speak over the roaring music, she <w>gesticulated</w> her request for a drink.",
                            "target_lang_translations": {
                                "zh": "由于音乐声太嘈杂无法说话，她<w>打手势表示</w>想喝一杯饮料。"
                            }
                        },
                        {
                            "text": "The guide <w>gesticulated</w> directions to the tourists across the crowded square.",
                            "target_lang_translations": {
                                "zh": "导游穿过拥挤的广场，向游客们<w>比画</w>着指引方向。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gesture",
                        "signal",
                        "indicate"
                    ],
                    "target_lang_definitions": {
                        "zh": "用手势表达、示意或强调某事物"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "打手势表示",
                                "target_lang_sense_clarification": "通过手势表达意图或需求"
                            },
                            {
                                "target_lang_word": "比画",
                                "target_lang_sense_clarification": "用动作示意某事"
                            },
                            {
                                "target_lang_word": "示意",
                                "target_lang_sense_clarification": "动作表示或指示"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}