                        "sense_id": "a440a4e0-814c-3cb6-8852-d94783f2916f",
                        "entry_id": "d7647aa1-a48b-38e4-9567-62aa7060ff1a",
                        "glosses": [
                            "A corner, niche, or nook."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "dd0bf973-b992-4ff0-b4ab-557ec8ac58d4",
                                "sense_id": "a440a4e0-814c-3cb6-8852-d94783f2916f",
                                "text": "Walden Common is, we think, well situated, because it is not a nooking in some particular road, but it is the way,—the royal highway,—to various places."
                            },
                            {
                                "example_id": "fd999380-ab3c-4561-815c-75056480456f",
                                "sense_id": "a440a4e0-814c-3cb6-8852-d94783f2916f",
                                "text": "If the villagers were too poor to purchase these books, new modes were adopted to satisfy their mental cravings, and the Book Clubs and Artisans' Libraries reared their heads in those obscure nookings, where, hitherto, the smithy, the village green, the \"road ends,\" and the ale bench, had been the rural seats of learning; and that mighty engine, the press, aided by the steam of science, superseded the ancient traditions of those village news-rooms."
                            },
                            {
                                "example_id": "7dcaa978-0b6c-4ab7-abb2-8129b4e751b0",
                                "sense_id": "a440a4e0-814c-3cb6-8852-d94783f2916f",
                                "text": "My great want was books; I was too poor to purchase expensive ones, and the 'cheap literature' was not then, as now, to be found in every out-o'-the-way nooking."
                            }
                        ]
                    }
