                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dyad",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb2cee70-cd6a-376d-b3b7-b3d54029d681",
                                        "entry_id": "9dddae84-4ee1-3186-a83a-c754bcdf8f5a",
                                        "glosses": [
                                            "A set of two elements treated as one; a pair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24fb480a-55fe-4301-af6e-e75bf86587dc",
                                                "sense_id": "fb2cee70-cd6a-376d-b3b7-b3d54029d681",
                                                "text": "[…] positing a dyad and constructing the infinite out of great and small, instead of treating the infinite as one, is peculiar to him; […]"
                                            },
                                            {
                                                "example_id": "c873674f-90b6-4d08-8df1-f29d1d5e023f",
                                                "sense_id": "fb2cee70-cd6a-376d-b3b7-b3d54029d681",
                                                "text": "McNamee describes their grip on the company as “the most centralized decision-making structure I have ever encountered in a large company.” Their power dyad is possible only because Facebook’s “core platform,” as McNamee puts it, is relatively simple: It “consists of a product and a monetization scheme.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50f0fcf2-cdaa-3f58-9821-d9ffec749597",
                                        "entry_id": "9dddae84-4ee1-3186-a83a-c754bcdf8f5a",
                                        "glosses": [
                                            "Two persons in an ongoing relationship; a dyadic relationship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "042051f6-6be7-4785-b6fb-82de54d3fce4",
                                                "sense_id": "50f0fcf2-cdaa-3f58-9821-d9ffec749597",
                                                "text": "For each individual in a specific dyad (i.e., mother-offspring, offspring-father, sibling-sibling), […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2e6ff7b-93b3-3625-8a3d-0cf81ca9b43d",
                                        "entry_id": "9dddae84-4ee1-3186-a83a-c754bcdf8f5a",
                                        "glosses": [
                                            "The relationship or interaction itself in reference to a couple."
                                        ],
