                "senses": [
                    {
                        "sense_id": "f27d6eec-957e-3d5d-9a18-b9de91766283",
                        "entry_id": "87753017-6ea6-3804-825b-b2d2db4b4ff8",
                        "glosses": [
                            "Faux documentaire, canular sous la forme d’un film documentaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a5cc246-e27e-4869-9ce4-2dd4ced4f2f0",
                                "sense_id": "f27d6eec-957e-3d5d-9a18-b9de91766283",
                                "text": "Le fauxcumentaire (ou documenteur – en anglais mockumentary) reprend les codes du documentaire pour faire passer un message fictif."
                            },
                            {
                                "example_id": "b5c5cf69-b55a-48c7-b532-8fa0c07dcd8b",
                                "sense_id": "f27d6eec-957e-3d5d-9a18-b9de91766283",
                                "text": "L’histoire veut que Avery, au lendemain du 11/9, a voulu réaliser un fauxcumentaire, histoire de réaliser un pastiche des documentaires qui n’allaient pas manquer de déferler sur la Toile et dans les médias."
                            },
                            {
                                "example_id": "5cc1d0ae-d495-4af1-962a-897efa3fd598",
                                "sense_id": "f27d6eec-957e-3d5d-9a18-b9de91766283",
                                "text": "L’histoire est un peu ancienne, mais ce n’est que récemment que j’ai regardé les deux fauxcumentaires controversés sur les sirènes d’Animal Planet, une chaîne de Discovery : Mermaids: The Body Found et Mermaids: The New Evidence. Diffusés respectivement en 2012 et 2013, ces « documentaires » ont semé la controverse lorsque nombre d’auditeurs ont pris ces parodies pour une révélation officielle de l’existence des sirènes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60654fe1-6976-4076-a4ff-4afff6763fc5",
                        "source_entry_id": "87753017-6ea6-3804-825b-b2d2db4b4ff8",
                        "source_sense_id": "f27d6eec-957e-3d5d-9a18-b9de91766283",
                        "target_lang_word": "mockumentary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mockumentary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05da5668-8605-3753-9d05-d81c216c27ee",
                                        "entry_id": "c1ba1a02-c215-388e-acb6-9f92f534e591",
                                        "glosses": [
                                            "A film or television programme presented as if it were a documentary but that is not factual and often a parody or satire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ce79aef-1040-43c3-af50-e93af8aed966",
                                                "sense_id": "05da5668-8605-3753-9d05-d81c216c27ee",
                                                "text": "“This Is Spinal Tap” is one of the most famous mockumentaries."
                                            },
                                            {
                                                "example_id": "96da3819-2588-40b9-96c0-cd92f42cd043",
                                                "sense_id": "05da5668-8605-3753-9d05-d81c216c27ee",
                                                "text": "Perlman devised a format inspired by the seminal mockumentary Spinal Tap, where the spot started with an ESPN announcer speaking to camera in a serious, straight voice, framing the story as “real” documentary."
                                            },
                                            {
                                                "example_id": "a3e84b2e-36fd-4a44-a7cf-57c486b06b49",
                                                "sense_id": "05da5668-8605-3753-9d05-d81c216c27ee",
                                                "text": "The resonances between This is Spinal Tap and other documentary and mockumentary texts is pervasive, […]"
                                            },
                                            {
                                                "example_id": "90046b35-51fb-45af-93ad-757e1e6278ed",
                                                "sense_id": "05da5668-8605-3753-9d05-d81c216c27ee",
                                                "text": "In the 2004 film A Day Without a Mexican, Sergio Arau imagines, in mockumentary style, what would happen to California if its entire Mexican-immigrant population vanished. With so many housekeepers and farmworkers, teachers and gardeners, line cooks and police gone, the state seizes up."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
