                ],
                "senses": [
                    {
                        "sense_id": "10ddb5e8-b510-363f-98d8-965b25b8c027",
                        "entry_id": "3fb39c22-2101-3743-a628-0a1f9511ea67",
                        "glosses": [
                            "vorüberlegte und schriftlich fixierte Wirkprinzipbeschreibung von Steuerungstechnik in einem Gebäude bei einem plötzlichen Brandereignis"
                        ],
                        "tags": [
                            "Stochastik",
                            "Logik"
                        ],
                        "examples": [
                            {
                                "example_id": "3726ef5f-f3c7-4db2-a291-57fa05535752",
                                "sense_id": "10ddb5e8-b510-363f-98d8-965b25b8c027",
                                "text": "„Die Brandfallsteuermatrix hilft bei der sinnvollen Verknüpfung der unterschiedlichen Brandschutzmaßnahmen.“"
                            },
                            {
                                "example_id": "242c61d4-d99f-49ad-b9a7-b81f72588f31",
                                "sense_id": "10ddb5e8-b510-363f-98d8-965b25b8c027",
                                "text": "„Die Brandfallsteuermatrix koordiniert, regelt und steuert die Funktionalität der brandschutztechnischen Sicherheitsanlagen aller Gewerke auf Basis eines Brandschutzkonzepts.“"
                            },
                            {
                                "example_id": "4c067dea-2c29-4cd8-8cd1-64208584271a",
                                "sense_id": "10ddb5e8-b510-363f-98d8-965b25b8c027",
                                "text": "„Um diese Fragestellung einfacher beantworten zu können, fungiert die Brandfallsteuermatrix als roter Faden in den verschiedenen Entwicklungs- und Lebensphasen eines Gebäudes.“"
                            },
                            {
                                "example_id": "065152dd-6976-46ba-88ba-bdbb30c77b89",
                                "sense_id": "10ddb5e8-b510-363f-98d8-965b25b8c027",
                                "text": "„Das sicherheitstechnische Steuerungskonzept (sSK) und die Brandfallsteuermatrix sind die wesentlichen Grundlagen und Dokumente, die das Zusammenwirken der sicherheitstechnischen Anlagen beschreiben und damit auch die Prüfgrundlage für die Wirkprinzipprüfung darstellen.“"
                            },
                            {
                                "example_id": "ffbb3cb0-a154-4e42-bc67-080b125d2f19",
                                "sense_id": "10ddb5e8-b510-363f-98d8-965b25b8c027",
                                "text": "„Die Brandfallsteuermatrix koordiniert, regelt und steuert die Funktionalität der brandschutztechnischen Sicherheitsanlagen aller Gewerke auf Basis eines Brandschutzkonzeptes.“"
                            }
                        ],
