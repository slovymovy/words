                "senses": [
                    {
                        "sense_id": "cea80326-a37a-3435-a70e-46cf162ca4e3",
                        "entry_id": "2630df71-0d83-3049-9176-430fbc192759",
                        "glosses": [
                            "eine der zwei Personen, die miteinander verheiratet sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d76dec3f-c9bc-41fe-8b6c-a74e14761d22",
                                "sense_id": "cea80326-a37a-3435-a70e-46cf162ca4e3",
                                "text": "Die beiden sind nicht nur miteinander befreundet, sie sind Ehepartner."
                            },
                            {
                                "example_id": "d3deac74-af2e-49f0-aa74-af3e0306ea0e",
                                "sense_id": "cea80326-a37a-3435-a70e-46cf162ca4e3",
                                "text": "„Andere Freunde mit arabischen Ehepartnern haben auch aufgegeben, sie sind nun in Kanada.“"
                            },
                            {
                                "example_id": "0fcef982-d57c-4ed3-943f-3ed42c7dfc9e",
                                "sense_id": "cea80326-a37a-3435-a70e-46cf162ca4e3",
                                "text": "„Ab 1. Juli fließt die Hälfte von all dem, was der Gatte während der Ehe erwirbt, automatisch dem Ehepartner in die Handtasche.“"
                            },
                            {
                                "example_id": "c5b0d8d3-8ab0-4a6c-8ff3-d0014c6d0389",
                                "sense_id": "cea80326-a37a-3435-a70e-46cf162ca4e3",
                                "text": "„Wenn die Ehepartner sich einig sind, reicht meist in einfacher Gang zum Bezirksamtmann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1598b720-48a5-41bc-ad45-d46708573490",
                        "source_entry_id": "2630df71-0d83-3049-9176-430fbc192759",
