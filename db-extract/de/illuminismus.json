                                    {
                                        "sense_id": "8f57a3f3-5f46-30cb-a973-c514432ed67a",
                                        "entry_id": "1d6b1a7f-8c22-3ccd-80f4-6c88f101ef6a",
                                        "glosses": [
                                            "Opinions chimériques des illuminés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09fae736-d1fe-4532-b6e1-e1ecde6f052d",
                                                "sense_id": "8f57a3f3-5f46-30cb-a973-c514432ed67a",
                                                "text": "L’illuminisme a fait beaucoup de ravages dans ce pays."
                                            },
                                            {
                                                "example_id": "46bb40ac-4b42-404a-8e35-19a5b116e783",
                                                "sense_id": "8f57a3f3-5f46-30cb-a973-c514432ed67a",
                                                "text": "Et, dans cette foi très sincère, dans son illuminisme de rédempteur, entrait aussi l’orgueil du martyre, la joie d’être un des saints rayonnants et adorés de la naissante Église révolutionnaire."
                                            },
                                            {
                                                "example_id": "ab114b76-3ef7-4061-8ca1-a33f19142e1d",
                                                "sense_id": "8f57a3f3-5f46-30cb-a973-c514432ed67a",
                                                "text": "Or, ce serait ne pas tenir compte du « secret », interrogation boutangienne par excellence, qui est aussi, en de certaines variations, au cœur de l’illuminisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
