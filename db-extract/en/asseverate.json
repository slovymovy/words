                                                "sense_id": "af8b9953-43cb-3179-8a1d-627495e653f0",
                                                "text": "Hij betuigde zijn medeleven met de familie van de overledene."
                                            },
                                            {
                                                "example_id": "3d31f1c5-9287-44bb-a0a2-9966d241087c",
                                                "sense_id": "af8b9953-43cb-3179-8a1d-627495e653f0",
                                                "text": "Tijdens hun afscheid in het café in Amersfoort had hij haar op de valreep nog wat anekdotes verteld over ondernemers die hun steun aan zijn site betuigden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
