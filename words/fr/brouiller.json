                {
                    "sense_id": "a0c53697-f8f2-3c58-9630-822a81360b09",
                    "sense_definition": "Mélanger et battre des œufs pendant la cuisson.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>brouiller</w> les œufs à feu très doux pour préserver leur texture onctueuse.",
                            "target_lang_translations": {
                                "en": "The eggs should be <w>scrambled</w> over very low heat to preserve their creamy texture.",
                                "ru": "Яйца нужно <w>взбивать</w> на очень слабом огне, чтобы сохранить их нежную текстуру.",
                                "de": "Man muss die Eier bei sehr schwacher Hitze zu <w>Rührei</w> <w>machen</w>, damit sie ihre cremige Textur bewahren.",
                                "es": "Hay que <w>revolver</w> los huevos a fuego muy lento para conservar su textura cremosa.",
                                "zh": "鸡蛋要用小火慢慢<w>炒</w>，才能保持口感嫩滑。"
                            }
                        },
                        {
                            "text": "Pour préparer le petit-déjeuner, elle commence par <w>brouiller</w> trois œufs avec du beurre.",
                            "target_lang_translations": {
                                "en": "To make breakfast, she starts by <w>scrambling</w> three eggs with some butter.",
                                "ru": "Чтобы приготовить завтрак, она начинает с того, что <w>взбивает</w> три яйца со сливочным маслом.",
                                "de": "Zum Frühstück <w>macht</w> sie zuerst drei Eier mit etwas Butter zu <w>Rührei</w>.",
                                "es": "Para preparar el desayuno, empieza por <w>revolver</w> tres huevos con un poco de mantequilla.",
                                "zh": "为了准备早餐，她先加点黄油，把三个鸡蛋<w>炒</w>一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "brouiller des œufs"
                    ],
                    "target_lang_definitions": {
                        "en": "To beat eggs and cook them while stirring until soft and loose.",
                        "ru": "Взбивать яйца и жарить их, помешивая, до мягкой консистенции.",
                        "de": "Eier verrühren und in der Pfanne unter Rühren stocken lassen.",
                        "es": "Batir huevos y cocinarlos removiéndolos hasta que queden blandos.",
                        "zh": "将鸡蛋打散后边搅边炒，直至炒成松软的状态。"
                    },
