                        "entry_id": "17f68eb9-59a5-3bd8-b971-009518787425",
                        "glosses": [
                            "Bezeichnung für ein bestimmtes Tier, auf das jemand wütend ist"
                        ],
                        "tags": [
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "4f99bba2-9da1-4e60-bf42-e5ea9beff480",
                                "sense_id": "432db87b-3702-3c68-8b2a-6f2ea39a1788",
                                "text": "Dieses Mistvieh von einem Kater hat schon wieder auf den teuren Teppich gekotzt."
                            },
                            {
                                "example_id": "b5ed5fcc-c573-40cf-8cb5-df02f647aafc",
                                "sense_id": "432db87b-3702-3c68-8b2a-6f2ea39a1788",
                                "text": "„Vor ein paar Jahren hat mich mal so ein Mistvieh gebissen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a7313614-add1-3686-bf05-96937598e089",
                        "entry_id": "17f68eb9-59a5-3bd8-b971-009518787425",
                        "glosses": [
                            "Bezeichnung für einen Menschen, der gemein ist oder sich durch irgendein Verhalten den Unmut eines anderen zugezogen hat"
                        ],
                        "tags": [
                            "impolite"
                        ],
                        "examples": [
                            {
