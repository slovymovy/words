                                        "entry_id": "9992116b-54f0-3d9d-ac37-955b49590abe",
                                        "glosses": [
                                            "A medicine, or all the medicines regularly taken by a patient."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cc320e8-f619-47fe-aa9c-6f6c4633d3ee",
                                                "sense_id": "817e7048-4620-339e-b78e-f3a63a33b513",
                                                "text": "Have you been taking your medication? [uncountable]"
                                            },
                                            {
                                                "example_id": "89bb555c-c276-4089-b5e7-06894ed73a76",
                                                "sense_id": "817e7048-4620-339e-b78e-f3a63a33b513",
                                                "text": "Have you been taking your medications? [countable]"
                                            },
                                            {
                                                "example_id": "94215946-164e-4247-975f-be042ec12623",
                                                "sense_id": "817e7048-4620-339e-b78e-f3a63a33b513",
                                                "text": "Are you going to be be like this all day? It’s like I’ve not took^([sic – meaning taken]) my medication."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3baa5829-bee7-38b9-bb0b-eb48bb96a8de",
                                        "entry_id": "9992116b-54f0-3d9d-ac37-955b49590abe",
                                        "glosses": [
                                            "The administration of medicine."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa7a1d5a-1c2f-4729-9618-1dbaa893e0a5",
                                                "sense_id": "3baa5829-bee7-38b9-bb0b-eb48bb96a8de",
                                                "text": "Such behavior, if it doesn't abate, will necessitate medication and supervision."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8dc7b8cf-34a0-4027-92c6-3f45c856d6a4",
                        "source_entry_id": "fcba6b03-4a3a-384e-96a3-67e50c9626cc",
                        "source_sense_id": "bcfa1c6d-1959-3356-b3a0-c624fdd49d5a",
