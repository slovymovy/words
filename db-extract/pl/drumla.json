                    {
                        "translation_id": "34a70397-b0b2-4a98-97c2-b6ab1bdce347",
                        "source_entry_id": "4360a4c3-4988-34ea-8799-b21310e11e1f",
                        "source_sense_id": "53e1645f-271e-3d40-a961-39ef23059a8c",
                        "target_lang_word": "варган",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "варган",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0769d648-a943-312d-acef-1a0585bb63ba",
                                        "entry_id": "0a3fd41e-7589-39a4-aebf-ec9cf3c9953e",
                                        "glosses": [
                                            "муз. самозвучащий щипковый музыкальный инструмент в виде подковы (или пластинки) с прикрепленным к ней металлическим язычком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8de832b-c3e1-4353-97f4-c6ad951760d9",
                                                "sense_id": "0769d648-a943-312d-acef-1a0585bb63ba",
                                                "text": "Он держал необыкновенно далеко выпяченными свои огромные губы и на них, как на варгане, играл пальцем и издавал при этом какие-то дикие звуки ртом."
                                            },
                                            {
                                                "example_id": "a821413c-52f1-4b42-9cb9-69286b399963",
                                                "sense_id": "0769d648-a943-312d-acef-1a0585bb63ba",
                                                "text": "Взрослые мужчины толпились перед питейным домом, где заседали старики, а юноши с балалайками и варганами расхаживали перед окнами, из которых выглядывали иногда миленькие женские личики."
                                            },
                                            {
                                                "example_id": "1dd0b2fd-3d2d-41c9-9783-00c68e9c78ee",
                                                "sense_id": "0769d648-a943-312d-acef-1a0585bb63ba",
                                                "text": "До появления в человеческой культуре металла варганы делали из кости и дерева, но они были достаточно хрупкими."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
