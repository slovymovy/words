                                "target_lang_word": "кусо́к мя́са",
                                "target_lang_sense_clarification": "часть туши"
                            },
                            {
                                "target_lang_word": "о́труб",
                                "target_lang_sense_clarification": "кулинарный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大块肉",
                                "target_lang_sense_clarification": "烹饪用语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e32c2df-ddbe-3226-a75e-e54c32f8bf54",
                    "sense_definition": "A prison.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent ten years in the <w>joint</w> for a crime he didn't commit.",
                            "target_lang_translations": {
                                "ru": "Он провел десять лет в <w>тюряге</w> за преступление, которого не совершал.",
                                "zh": "他因为一项没犯过的罪在<w>监狱</w>里待了十年。"
                            }
                        },
                        {
                            "text": "Life is very difficult for people when they first get out of the <w>joint</w>.",
                            "target_lang_translations": {
                                "ru": "Жизнь очень трудна для людей, когда они только выходят из <w>тюряги</w>.",
                                "zh": "人们刚出<w>监狱</w>时生活非常艰难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jail",
                        "slammer"
                    ],
                    "common_phrases": [
                        "in the joint",
                        "out of the joint"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "criminal argot"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тюрьма.",
                        "zh": "监狱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюря́га",
                                "target_lang_sense_clarification": "сленг"
                            },
                            {
                                "target_lang_word": "катала́жка",
                                "target_lang_sense_clarification": "пренебрежительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "监狱",
                                "target_lang_sense_clarification": "正式用语"
                            },
                            {
                                "target_lang_word": "号子",
                                "target_lang_sense_clarification": "俚语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e25477bd-715d-36ce-96e8-0df5d80401ef",
                    "sense_definition": "Done by or involving two or more people or organizations working together.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "shared",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was a <w>joint</w> effort between the marketing and sales departments.",
                            "target_lang_translations": {
                                "ru": "Этот проект был <w>совместным</w> усилием отделов маркетинга и продаж.",
                                "zh": "这个项目是市场部和销售部<w>联合</w>完成的。"
                            }
                        },
                        {
                            "text": "They decided to open a <w>joint</w> bank account after they got married.",
                            "target_lang_translations": {
                                "ru": "Они решили открыть <w>совместный</w> банковский счет после свадьбы.",
                                "zh": "他们结婚后决定开一个<w>共同</w>银行账户。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shared",
                        "collective",
                        "mutual",
                        "united",
                        "common"
                    ],
                    "antonyms": [
                        "separate",
                        "sole"
                    ],
                    "common_phrases": [
                        "joint venture",
                        "joint effort",
                        "joint account",
                        "joint decision",
                        "joint statement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный или осуществляемый двумя или более людьми или организациями совместно.",
                        "zh": "由两个或更多人或组织共同参与或完成的。"
                    },
                    "translations": {
