    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2a886fae-e823-314a-a899-5199610165f5",
                "word": "buckram",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e02c2ba7-706f-430d-8bf5-c9b1683eda34",
                        "entry_id": "2a886fae-e823-314a-a899-5199610165f5",
                        "tags": [
                            "plural"
                        ],
                        "form": "buckrams"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d52d05c3-dca3-3d3b-8d67-f116f0c568d8",
                        "entry_id": "2a886fae-e823-314a-a899-5199610165f5",
                        "glosses": [
                            "A coarse cloth of cotton, linen or hemp, stiffened with size or glue, used in bookbinding to cover and protect the books, in garments to keep them in the form intended, and for wrappers to cover merchandise."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d2a1dbc1-f9ef-465a-8143-5ef7e0da4a3d",
                                "sense_id": "d52d05c3-dca3-3d3b-8d67-f116f0c568d8",
                                "text": "Four rogues in buckram let drive at me—"
                            },
                            {
                                "example_id": "24015aff-85d7-49ba-b537-446bd0cb87a9",
                                "sense_id": "d52d05c3-dca3-3d3b-8d67-f116f0c568d8",
                                "text": "Buckram was probably from the first a stiffened material employed for lining, often dyed."
                            }
                        ]
                    },
                    {
                        "sense_id": "6de6d929-8d12-3ca2-9bb2-8c4a0fbfb624",
                        "entry_id": "2a886fae-e823-314a-a899-5199610165f5",
                        "glosses": [
                            "A crab that has just molted; a papershell."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74ffe01e-bddc-4bda-b4b7-5f02e5f8bcf9",
                        "source_entry_id": "2a886fae-e823-314a-a899-5199610165f5",
                        "source_sense_description": "cloth",
                        "target_lang_word": "bougran",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bougran",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40737def-1bb0-3144-afd4-640686c25b1a",
                                        "entry_id": "45736396-2782-34a9-ab06-c39ca5416b3b",
                                        "glosses": [
                                            "Sorte de toile forte et gommée utilisé par les relieurs, les chapeliers et les tailleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83a2b385-602e-4360-9be4-bd614b839c5a",
                                                "sense_id": "40737def-1bb0-3144-afd4-640686c25b1a",
                                                "text": "En revanche, le col de sa chemise, droit et empesé, lui montait jusqu'au milieu des oreilles ; et le collet de son habit, ample, lourd et doublé de bougran, lui montait jusqu'à l'occiput."
                                            },
                                            {
                                                "example_id": "35357c22-34cd-4f89-b296-1af1b964bb49",
                                                "sense_id": "40737def-1bb0-3144-afd4-640686c25b1a",
                                                "text": "Puis il taille la doublure dans le bougran un peu plus large et éventuellement une triplure, sorte de toile très lâche qui se place entre le bougran et la soierie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f93c63de-394a-4bb6-8e39-1bc8545ed52d",
                        "source_entry_id": "2a886fae-e823-314a-a899-5199610165f5",
                        "source_sense_description": "cloth",
                        "target_lang_word": "коленко́р",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коленко́р",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d037c69b-cb07-3eb5-a894-48de8e9120ec",
                                        "entry_id": "d0f5cba5-959a-3d56-8f09-bd77d1607602",
                                        "glosses": [
                                            "текст. лёгкая, но жёсткая гладкокрашеная или отбелённая хлопчатобумажная ткань, сотканная подобно холсту простым переплётом, в которой основная пряжа на 20 % тоньше уточной"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84defd90-bf50-4dd8-a3e6-2203b9e0ef9f",
                                                "sense_id": "d037c69b-cb07-3eb5-a894-48de8e9120ec",
                                                "text": "Кому мимоходом не бросались в глаза занавески на окошках из розового или голубого коленкора?"
                                            },
                                            {
                                                "example_id": "95891c9e-35eb-4149-b87b-09cd59ee1cfc",
                                                "sense_id": "d037c69b-cb07-3eb5-a894-48de8e9120ec",
                                                "text": "За месяц до своей смерти она достала из своего сундука белого коленкору, белой кисеи и розовых лент; с помощью своей девушки сшила себе белое платье, чепчик и до малейших подробностей распорядилась всем, что нужно было для её похорон."
                                            },
                                            {
                                                "example_id": "06d99f18-6062-4138-910f-a84a2d3221db",
                                                "sense_id": "d037c69b-cb07-3eb5-a894-48de8e9120ec",
                                                "text": "В галантерейных лавках заморские сукна: зибер, зефир, клер. Платки фуляровые, газовые вуали, муслин, коленкор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edcdc22f-af9e-37a1-8dd8-44f07dfd8e14",
                                        "entry_id": "d0f5cba5-959a-3d56-8f09-bd77d1607602",
                                        "glosses": [
                                            "спец. покровный переплётный материал из хлопчатобумажной ткани с крахмально каолиновым покрытием"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53d082ff-2c38-4c2a-b7e3-ab71d5a4f2b5",
                                                "sense_id": "edcdc22f-af9e-37a1-8dd8-44f07dfd8e14",
                                                "text": "Корешок порван и подклеен, а коленкор так прохудился по углам, что виднеется расслоившееся ржавое бумажное нутро переплёта."
                                            },
                                            {
                                                "example_id": "f173de44-e317-44fe-ac11-85508c54303c",
                                                "sense_id": "edcdc22f-af9e-37a1-8dd8-44f07dfd8e14",
                                                "text": "Иван Павлыч бережно принёс огромный лист, наклеенный на коленкор."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e2360f7-bd04-3585-aaeb-b3b299a1065e",
                                        "entry_id": "d0f5cba5-959a-3d56-8f09-bd77d1607602",
                                        "glosses": [
                                            "разг., шутл. то же, что дело"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff73aea-35f8-4c65-a1a0-73382d5cb494",
                                                "sense_id": "4e2360f7-bd04-3585-aaeb-b3b299a1065e",
                                                "text": "И потом, посуди сам: одно дело — женишься запоздало на матери своего ребенка, и совсем другой коленкор, когда берёшь за себя мать-одиночку с чужим произведением на руках."
                                            },
                                            {
                                                "example_id": "be29b5b2-ab2c-415e-96bf-5037735bd677",
                                                "sense_id": "4e2360f7-bd04-3585-aaeb-b3b299a1065e",
                                                "text": "Взять для примера пиво: тёмное чешское — один коленкор, или баварское, что не одно с жигулёвским, равно как бочковое, но обязательно с солью!"
                                            },
                                            {
                                                "example_id": "1f4b3f57-8a7c-4cbe-a828-8d7d31a9c2f6",
                                                "sense_id": "4e2360f7-bd04-3585-aaeb-b3b299a1065e",
                                                "text": "Если ты для дела спрашиваешь — это один коленкор. А если просто в словаре прочитал про эти самые аллегории и меня посрамить хочешь, то данный факт задания вопроса могу принять как попытку унижения достоинства моего интеллекта."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
