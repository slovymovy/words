            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e53c7b10-f204-30ce-a023-5a029961afb7",
                    "sense_definition": "Personne qui aime faire la morale aux autres et qui donne des leçons à tout propos.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral_critique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se comporte comme un <w>moralisateur</w> agaçant chaque fois que quelqu'un exprime un avis différent."
                        },
                        {
                            "text": "Personne n'aime écouter les conseils d'une <w>moralisatrice</w> qui ne respecte pas ses propres règles."
                        }
                    ],
                    "synonyms": [
                        "donneur de leçons",
                        "censeur"
                    ],
                    "common_phrases": [
                        "jouer les moralisateurs"
                    ]
                },
                {
                    "sense_id": "480650f3-86fb-3371-b7de-85729c73b556",
                    "sense_definition": "Personne qui s'attache à défendre des principes moraux ou à réformer les mœurs de la société.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "moral_education",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet auteur est considéré comme un grand <w>moralisateur</w> de son siècle par ses écrits satiriques."
                        },
                        {
                            "text": "Le rôle du <w>moralisateur</w> consiste à éclairer les consciences et à proposer des règles de vie."
                        }
                    ],
                    "synonyms": [
                        "moraliste",
                        "réformateur"
                    ]
                }
            ]
        }
