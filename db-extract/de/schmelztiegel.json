                                "target_senses": [
                                    {
                                        "sense_id": "279be0b6-43eb-3f86-be05-64bc9867c982",
                                        "entry_id": "2ecdacb4-c5da-3cfc-a68c-3d47ec88fb2c",
                                        "glosses": [
                                            "Creuset culturel et sociologique, métaphore utilisée pour désigner un phénomène d’assimilation et d’intégration de populations immigrées de diverses origines en une société homogène."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "747082e2-fcba-46a8-b9e2-13b2258f23f8",
                                                "sense_id": "279be0b6-43eb-3f86-be05-64bc9867c982",
                                                "text": "Limites démographiques de l’idée de melting pot aux États-Unis d’après les données établies par le Bureau du recensement des États-Unis."
                                            },
                                            {
                                                "example_id": "550d8974-cec9-4f3b-a6ce-42b400cf0818",
                                                "sense_id": "279be0b6-43eb-3f86-be05-64bc9867c982",
                                                "text": "L’Amérique a du mal à admettre l’existence du jazz autrement qu’en le digérant, en le phagocytant, et en le dépossédant de ses origines. Vieille arnaque du melting-pot."
                                            },
                                            {
                                                "example_id": "34cc51af-41b9-4d68-a487-97bf35a4eaae",
                                                "sense_id": "279be0b6-43eb-3f86-be05-64bc9867c982",
                                                "text": "Un melting-pot nouveau pour Chokri. Dans la ville communiste, des maghrébins, mais aussi des khels, des turcs, des cambodgiens mais si peu de français de souche."
                                            },
                                            {
                                                "example_id": "6ec9bb59-e566-4533-8b98-399c70529fb8",
                                                "sense_id": "279be0b6-43eb-3f86-be05-64bc9867c982",
                                                "text": "Car c’est ce refus obstiné du melting pot qui distinguait au départ et continue de distinguer aujourd’hui le projet canadien du rêve américain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
