                        ],
                        "examples": [
                            {
                                "example_id": "807c9cd5-90a5-45e4-b45c-85154b5cdd13",
                                "sense_id": "b12ee82b-9939-34f1-a27e-1fa9130f024b",
                                "text": "Гайка отвертелась."
                            },
                            {
                                "example_id": "fd712bec-c7c1-4265-a265-2f81e2ea695d",
                                "sense_id": "b12ee82b-9939-34f1-a27e-1fa9130f024b",
                                "text": "Винты отвертелись с трудом."
