                "senses": [
                    {
                        "sense_id": "4da3106e-6bbc-36b0-b584-ec6fadfaab61",
                        "entry_id": "cf4e0f10-aaee-3294-ad83-9a15f8940357",
                        "glosses": [
                            "jemand, der sich freiwillig zum Militärdienst meldet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f53b222-f5d7-4bd9-a2e9-d71b186f5cc2",
                                "sense_id": "4da3106e-6bbc-36b0-b584-ec6fadfaab61",
                                "text": "„Der Kriegsfreiwillige war ein feiner Junge, mit dunklem Haar und schwarzen, ängstlichen Augen.“"
                            },
                            {
                                "example_id": "145ddd7c-e7e4-4867-846d-db4d1a9b79d7",
                                "sense_id": "4da3106e-6bbc-36b0-b584-ec6fadfaab61",
                                "text": "„An die Stelle der Begeisterung vor allem bürgerlicher Kriegsfreiwilliger wie noch Ende Juli und Anfang August war schon jetzt Entschlossenheit getreten, nun bei den meisten Deutschen.“"
                            },
                            {
                                "example_id": "20e0f54a-d55a-460e-96fb-07e4d5726ea3",
                                "sense_id": "4da3106e-6bbc-36b0-b584-ec6fadfaab61",
                                "text": "„In Lübeck hat er Schriftsetzer gelernt, nahm als Kriegsfreiwilliger an den Befreiungskriegen gegen Napoleon teil und kam um 1814 nach Frankfurt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
