            {
                "entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                "word": "rattan",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ce10ae1f-22ec-492a-af53-87f8dd0a68d5",
                        "entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                        "tags": [
                            "plural"
                        ],
                        "form": "rattans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "afd80822-b13a-37de-8b15-a1665a2a2550",
                        "entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                        "glosses": [
                            "Any of several species of climbing palm of the genus Calamus."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a734596e-7e84-38e8-a7b9-13e46ecf5bcd",
                        "entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                        "glosses": [
                            "The plant used as a material for making furniture, baskets etc."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c476bcf9-ebb2-412a-bc89-0734b6fb9841",
                                "sense_id": "a734596e-7e84-38e8-a7b9-13e46ecf5bcd",
                                "text": "It took Elwood an hour to find Mr. Gladwell, who sat in a big rattan chair at the edge of the sweet potato fields."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb4908b3-f71d-36f7-991c-cbdddbb70dd2",
                        "entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                        "glosses": [
                            "A cane made from this material."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6cb55925-54ab-4995-99e7-1ad7839ce2ff",
                                "sense_id": "eb4908b3-f71d-36f7-991c-cbdddbb70dd2",
                                "text": "He who first acts as striker asks the other how many blows of the rattan he will bear on his forearm without crying out."
                            },
                            {
                                "example_id": "0f86d199-12c8-4524-bd61-af87f3774c8f",
                                "sense_id": "eb4908b3-f71d-36f7-991c-cbdddbb70dd2",
                                "text": "“My Continental prominence is improving,” I commented dryly. ¶ Von Lindowe cut at a furze bush with his silver-mounted rattan. ¶ “Quite so,” he said as dryly, his hand at his mustache. “I may say if your intentions were known your life would not be worth a curse.”"
                            },
                            {
                                "example_id": "2bb03be6-7d9e-4a8a-8cfb-0a64bb41b41b",
                                "sense_id": "eb4908b3-f71d-36f7-991c-cbdddbb70dd2",
                                "text": "[…]the rattan is still a valued instrument of discipline[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10a5eb65-0350-4372-a10f-98157ed7eb45",
                        "source_entry_id": "44926149-19cb-324d-a838-8bdf5f98c983",
                        "source_sense_description": "climbing palm",
                        "target_lang_word": "rotan",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
