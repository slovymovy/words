                                    {
                                        "sense_id": "490454d6-da6d-31b6-80c5-f9298c62966a",
                                        "entry_id": "90db47fa-78a9-3f93-bf7a-d1021f9c8e37",
                                        "glosses": [
                                            "A primal undifferentiated cell from which a variety of other cells can develop through the process of cellular differentiation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9271f3bf-4015-49c2-b699-9e6a1b8e03e2",
                                                "sense_id": "490454d6-da6d-31b6-80c5-f9298c62966a",
                                                "text": "Stem cells are characterized by their ability to self-renew and to produce numerous differentiated cell types, and are directly responsible for generating and maintaining tissues and organs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
