                "senses": [
                    {
                        "sense_id": "5f3d29b3-285e-3fdf-b7f3-938a6b3da945",
                        "entry_id": "054f3cbd-a1f2-32b8-bef6-db98eb0c4b69",
                        "glosses": [
                            "an ein Horn erinnernd, wie ein Horn aussehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d31f8d19-fbd1-46b1-99b3-dd2c5415cd16",
                                "sense_id": "5f3d29b3-285e-3fdf-b7f3-938a6b3da945",
                                "text": "„Sie schleudert eine Spielzeugeisenbahn auf den Boden, dann stürmt sie vor und bohrt ihre hornartigen Auswüchse in die Wand.“"
                            },
                            {
                                "example_id": "ac427b29-d06d-471f-91f8-c7468b523c54",
                                "sense_id": "5f3d29b3-285e-3fdf-b7f3-938a6b3da945",
                                "text": "„Die Füße waren menschlich, abgesehen von langen, hornartigen Spornen, die aus ihren Fersen ragten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
