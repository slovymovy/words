                "senses": [
                    {
                        "sense_id": "50350887-59eb-30b0-b789-8d540f8bfd1e",
                        "entry_id": "ca175f62-445a-3d16-b5ea-d1b1cdf2650e",
                        "glosses": [
                            "Qualifie une plante qui donne des stolons ou un organe de ces plantes qui en porte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d00129ac-c95e-4ccf-a5f6-9eb868a908fd",
                                "sense_id": "50350887-59eb-30b0-b789-8d540f8bfd1e",
                                "text": "Herbe pérenne, stolonifère, mais non rhizomateuse, gazonnante."
                            },
                            {
                                "example_id": "238e07b3-d2cc-4971-8cf9-c22350b655a0",
                                "sense_id": "50350887-59eb-30b0-b789-8d540f8bfd1e",
                                "text": "Bractées scarieuses, blanches, aphylles ; épis femelles ne renfermant que 3 à 5 fl.; souche stolonifère."
                            },
                            {
                                "example_id": "0a31a83c-7508-46dc-8cdd-d765e1c4b596",
                                "sense_id": "50350887-59eb-30b0-b789-8d540f8bfd1e",
                                "text": "Toutes les espèces offrent une tige cylindrique, horizontale, rampante, rameuse et souvent stolonifère."
                            }
                        ]
                    }
                ],
