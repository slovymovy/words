                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e79a0b9-a201-4ab4-9301-78ce9d31a44f",
                                "sense_id": "ddc74d9b-25a6-3408-ad2d-d63a7a1c3da1",
                                "text": "„Im Jahre 1342 starb Karl, beweint besonders von den Visegrádern, die ihm ihren Wohlstand und die Wichtigkeit ihrer Stadt zu verdanken hatten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f88803f8-4853-39f6-8bbf-d9a1b4729fcc",
                        "entry_id": "189d798f-b1dc-385d-9f3d-1bdeb3a891b1",
                        "glosses": [
                            "Angehöriger der Visegrád-Gruppe (Polen, Tschechien, Slowakei, Ungarn)"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "2ce0cdaa-b992-4a42-8c45-df362991d059",
                                "sense_id": "f88803f8-4853-39f6-8bbf-d9a1b4729fcc",
                                "text": "„Die Visegráder bekämen also schon deswegen weniger, weil ihr BSP schneller als der EU-Durchschnitt gewachsen ist.“"
                            },
                            {
                                "example_id": "1ba3141d-5d72-43c0-a8b1-c1631e6b0c28",
                                "sense_id": "f88803f8-4853-39f6-8bbf-d9a1b4729fcc",
                                "text": "„Die Visegráder halten den demokratischen Nationalstaat für das höchste Gut in der Politik.“"
                            }
                        ],
