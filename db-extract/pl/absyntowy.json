                                                "example_id": "4082130d-9260-434c-8042-3d944617593b",
                                                "sense_id": "fe6262e7-3481-3315-b294-22c8de377e47",
                                                "text": "The dim cavernous light depressed him, and the fish gaping and staring sluggishly in the tanks of absinthian green […]"
                                            },
