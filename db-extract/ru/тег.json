                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88cefc46-4f5c-42a7-a5a4-f10fad11eb35",
                                                "sense_id": "8aa53e4a-75d2-3356-9bc7-4fef5e1d48a9",
                                                "text": "What’s your tag?"
