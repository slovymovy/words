                },
                {
                    "sense_id": "e96f4916-edd5-382c-a932-838d9902b5a0",
                    "sense_definition": "Extremely or remarkably; used to emphasize an adjective or description.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The view from the top of the mountain was <w>positively</w> breathtaking.",
                            "target_lang_translations": {
                                "ru": "Вид с вершины горы был <w>поистине</w> захватывающим.",
                                "zh": "山顶的景色<w>简直</w>美得令人窒息。",
                                "es": "La vista desde la cima de la montaña era <w>verdaderamente</w> impresionante.",
                                "tr": "Dağın tepesinden manzara <w>gerçekten</w> nefes kesiciydi.",
                                "de": "Die Aussicht vom Gipfel des Berges war <w>wirklich</w> atemberaubend."
                            }
                        },
                        {
                            "text": "I had a <w>positively</w> wonderful time at the party yesterday.",
                            "target_lang_translations": {
                                "ru": "Я <w>просто</w> чудесно провел время на вчерашней вечеринке.",
                                "zh": "昨天聚会上我过得<w>非常</w>愉快。",
                                "es": "Pasé un tiempo <w>sumamente</w> maravilloso en la fiesta de ayer.",
                                "tr": "Dünkü partide <w>olağanüstü</w> harika vakit geçirdim.",
                                "de": "Ich hatte eine <w>wirklich</w> wunderbare Zeit auf der Party gestern."
                            }
                        }
                    ],
                    "synonyms": [
                        "extremely",
                        "incredibly",
                        "really",
                        "highly"
                    ],
                    "common_phrases": [
                        "positively wonderful",
                        "positively brilliant",
                        "positively ancient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно или замечательно; используется для усиления прилагательного или описания.",
                        "zh": "极其或非常；用于加强形容词或描述的语气。",
                        "es": "Extremadamente o notablemente; se usa para enfatizar un adjetivo o descripción.",
                        "tr": "Son derece veya dikkat çekici bir şekilde; bir sıfatı veya tanımı vurgulamak için kullanılır.",
                        "de": "Außerordentlich oder bemerkenswert; wird zur Verstärkung eines Adjektivs oder einer Beschreibung verwendet."
                    },
