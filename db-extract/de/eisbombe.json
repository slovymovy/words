                    {
                        "sense_id": "6cb6d0bd-1060-3ff2-aee4-19ab69eff9f8",
                        "entry_id": "1d1a7aa9-d1c0-33c8-be77-73c4fe8b736c",
                        "glosses": [
                            "(oft kugelförmige) Süßspeise aus/mit Eis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29f8ef86-2cd4-4d73-8c39-5db893d64125",
                                "sense_id": "6cb6d0bd-1060-3ff2-aee4-19ab69eff9f8",
                                "text": "„Das Dessert bestand aus einer dreistöckigen Hochzeitstorte und einer Eisbombe - aus meiner Sicht eine angemessene Entschädigung für den verhassten kratzenden Anzug.“"
                            },
                            {
                                "example_id": "ff96ecf4-5da4-4487-9eb4-c08db3b91858",
                                "sense_id": "6cb6d0bd-1060-3ff2-aee4-19ab69eff9f8",
                                "text": "„Das Stück Eisbombe zerfließt sofort, es läuft über den Tellerrand fort, der ganze Teller quillt über.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
