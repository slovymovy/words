                                "target_senses": [
                                    {
                                        "sense_id": "aa998cc5-0e13-3da7-a47d-f75e88d3d5eb",
                                        "entry_id": "7a2a9cd2-50be-3a0d-b36c-7ee7339dfd01",
                                        "glosses": [
                                            "A sensation of burning, prickling, itching, or tingling of the skin, with no obvious cause."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b803c5c-fa75-4101-813d-e9d874c20d2c",
                                                "sense_id": "aa998cc5-0e13-3da7-a47d-f75e88d3d5eb",
                                                "text": "Paresthesia occurs when a body part 'falls asleep'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "011abacc-92e0-44f5-b763-323b25a4f28e",
                        "source_entry_id": "5d6ce4f0-8141-3675-b487-977e8c813ad8",
                        "source_sense_id": "72689940-3120-34a6-bcbb-f146c74b803a",
