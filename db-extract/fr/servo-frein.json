                "senses": [
                    {
                        "sense_id": "4bdd8f77-46b1-34ba-9d29-c9651a089f65",
                        "entry_id": "e9de73ab-6b83-338b-b919-8c9e31fa1cf4",
                        "glosses": [
                            "Système de freinage dans lequel l’énergie pour freiner est donnée par une source extérieure à celui qui manipule le frein."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a97eb57f-8d5a-470f-94ff-e8cb4b2e7f7d",
                                "sense_id": "4bdd8f77-46b1-34ba-9d29-c9651a089f65",
                                "text": "Brevet de quinze ans, 14 octobre 1893; Picou, représenté par Mosenthal, à Paris, rue La Bruyère, 3 bis. — Frein électrique asservi, appareil de sûreté automatique, applicable à tous les organes commandés électriquement, dit Servo-frein électrique."
                            },
                            {
                                "example_id": "ed54cf5f-1212-4f44-b22d-007c3672789c",
                                "sense_id": "4bdd8f77-46b1-34ba-9d29-c9651a089f65",
                                "text": "Dans la classe des servo-freins mécaniques, nous trouvons les modèles Louis Renault, Hallot et Birkigt. Le servo-frein Louis Renault comporte un organe d'entraînement formé par un embrayage à deux disques."
                            },
                            {
                                "example_id": "1df26535-4112-493a-8f01-907610092e8f",
                                "sense_id": "4bdd8f77-46b1-34ba-9d29-c9651a089f65",
                                "text": "Le servo-frein ou assistance au freinage est nécessaire sur les grosses voitures rapides car la mise en œuvre d’un frein non assisté « dépasse souvent les forces de l’homme et à fortiori celles de la femme »."
                            }
                        ]
                    }
