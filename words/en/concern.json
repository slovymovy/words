{
    "word_family": [
        "concerned",
        "unconcerned",
        "concerning"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1da40202-9ed7-3fe0-9265-86cdbcce49c5",
                    "sense_definition": "That which affects one’s welfare or happiness; a matter of interest or importance to someone.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concern_relate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The safety of the children is of great <w>concern</w> to the parents.",
                            "target_lang_translations": {
                                "ru": "Безопасность детей вызывает у родителей огромное <w>беспокойство</w>.",
                                "pl": "Bezpieczeństwo dzieci jest powodem wielkiej <w>troski</w> dla rodziców."
                            }
                        },
                        {
                            "text": "Pollution has become a major <w>concern</w> for the city council.",
                            "target_lang_translations": {
                                "ru": "Загрязнение окружающей среды стало главной <w>проблемой</w> для городского совета.",
                                "pl": "Zanieczyszczenie stało się głównym <w>problemem</w> dla rady miasta."
                            }
                        }
                    ],
                    "synonyms": [
                        "interest",
                        "issue",
                        "priority"
                    ],
                    "common_phrases": [
                        "of great concern",
                        "matter of concern",
                        "primary concern"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что затрагивает чье-то благополучие; дело, представляющее интерес или важность.",
                        "pl": "To, co wpływa na czyjś dobrostan lub szczęście; sprawa będąca przedmiotem zainteresowania lub mająca znaczenie dla kogoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "забота",
                                "target_lang_sense_clarification": "то, что требует внимания или ухода"
                            },
                            {
                                "target_lang_word": "дело",
                                "target_lang_sense_clarification": "вопрос, представляющий интерес или важность"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "sprawa",
                                "target_lang_sense_clarification": "kwestia o dużym znaczeniu"
                            },
                            {
                                "target_lang_word": "troska",
                                "target_lang_sense_clarification": "przedmiot dbałości"
                            },
                            {
                                "target_lang_word": "kwestia",
                                "target_lang_sense_clarification": "zagadnienie do rozważenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f13f94f-40c8-31f4-8fa4-434a645a0797",
                    "sense_definition": "A specific worry or problem; a sense that something may be wrong.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concern_worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please contact the support team if you have any questions or <w>concerns</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, свяжитесь со службой поддержки, если у вас возникнут вопросы или <w>опасения</w>.",
                                "pl": "Prosimy o kontakt z zespołem wsparcia w przypadku jakichkolwiek pytań lub <w>obaw</w>."
                            }
                        },
                        {
                            "text": "She voiced her <w>concerns</w> about the new policy during the meeting.",
                            "target_lang_translations": {
                                "ru": "Она выразила свои <w>опасения</w> по поводу новой политики во время собрания.",
                                "pl": "Podczas spotkania wyraziła swoje <w>zastrzeżenia</w> dotyczące nowej polityki."
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble",
                        "worry"
                    ],
                    "common_phrases": [
                        "questions or concerns",
                        "cause for concern",
                        "raise concerns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретное волнение или проблема; чувство, что что-то может быть не так.",
                        "pl": "Konkretne zmartwienie lub problem; poczucie, że coś może być nie tak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокойство",
                                "target_lang_sense_clarification": "чувство тревоги"
                            },
                            {
                                "target_lang_word": "опасение",
                                "target_lang_sense_clarification": "предчувствие чего-то плохого"
                            },
                            {
                                "target_lang_word": "проблема",
                                "target_lang_sense_clarification": "сложный вопрос, требующий решения"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "obawa",
                                "target_lang_sense_clarification": "poczucie niepokoju o coś"
                            },
                            {
                                "target_lang_word": "niepokój",
                                "target_lang_sense_clarification": "stan zdenerwowania lub troski"
                            },
                            {
                                "target_lang_word": "zastrzeżenie",
                                "target_lang_sense_clarification": "wątpliwość co do czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78609c54-02cf-3b6f-88bb-dcf5450f1ef0",
                    "sense_definition": "The expression of solicitude, anxiety, or compassion toward a thing or person.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "concern_worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Judy's eyes filled with <w>concern</w> as she listened to the news report.",
                            "target_lang_translations": {
                                "ru": "Глаза Джуди наполнились <w>тревогой</w>, когда она слушала репортаж новостей.",
                                "pl": "Oczy Judy wypełniły się <w>niepokojem</w>, gdy słuchała wiadomości."
                            }
                        },
                        {
                            "text": "The doctor looked at the patient with deep <w>concern</w>.",
                            "target_lang_translations": {
                                "ru": "Врач посмотрел на пациента с глубоким <w>участием</w>.",
                                "pl": "Lekarz spojrzał na pacjenta z głęboką <w>troską</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "care"
                    ],
                    "antonyms": [
                        "unconcern"
                    ],
                    "common_phrases": [
                        "with concern",
                        "deep concern",
                        "out of concern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражение участия, тревоги или сострадания по отношению к кому-либо или чему-либо.",
                        "pl": "Wyraz troski, niepokoju lub współczucia wobec kogoś lub czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участие",
                                "target_lang_sense_clarification": "сочувственное отношение"
                            },
                            {
                                "target_lang_word": "забота",
                                "target_lang_sense_clarification": "внимательное отношение"
                            },
                            {
                                "target_lang_word": "озабоченность",
                                "target_lang_sense_clarification": "выражение тревоги"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "troska",
                                "target_lang_sense_clarification": "dbałość i współczucie"
                            },
                            {
                                "target_lang_word": "przejęcie",
                                "target_lang_sense_clarification": "silne emocjonalne zaangażowanie"
                            },
                            {
                                "target_lang_word": "zaniepokojenie",
                                "target_lang_sense_clarification": "widoczna obawa o kogoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad7a09c5-b437-3526-94b4-0dd8b064d28c",
                    "sense_definition": "A business, firm, or enterprise; a company.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concern_business",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They sold the shop as a going <w>concern</w> to a local investor.",
                            "target_lang_translations": {
                                "ru": "Они продали магазин местному инвестору как действующее <w>предприятие</w>.",
                                "pl": "Sprzedali sklep jako działające <w>przedsiębiorstwo</w> lokalnemu inwestorowi."
                            }
                        },
                        {
                            "text": "The manufacturing <w>concern</w> has been operating in this region for fifty years.",
                            "target_lang_translations": {
                                "ru": "Этот производственный <w>концерн</w> работает в этом регионе уже пятьдесят лет.",
                                "pl": "Ten <w>koncern</w> produkcyjny działa w tym regionie od pięćdziesięciu lat."
                            }
                        }
                    ],
                    "common_phrases": [
                        "going concern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бизнес, фирма или предприятие; компания.",
                        "pl": "Biznes, firma lub przedsięwzięcie; przedsiębiorstwo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предприятие",
                                "target_lang_sense_clarification": "коммерческая организация"
                            },
                            {
                                "target_lang_word": "концерн",
                                "target_lang_sense_clarification": "крупное объединение предприятий"
                            },
                            {
                                "target_lang_word": "фирма",
                                "target_lang_sense_clarification": "торговое или промышленное предприятие"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "koncern",
                                "target_lang_sense_clarification": "duże przedsiębiorstwo lub grupa"
                            },
                            {
                                "target_lang_word": "przedsiębiorstwo",
                                "target_lang_sense_clarification": "jednostka gospodarcza"
                            },
                            {
                                "target_lang_word": "firma",
                                "target_lang_sense_clarification": "działalność handlowa lub usługowa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e1b82a39-a258-34a8-8a45-d0e193893d86",
                    "sense_definition": "Any set of information that affects the code of a computer program.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "concern_tech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Separation of <w>concerns</w> is a fundamental principle in software engineering.",
                            "target_lang_translations": {
                                "ru": "Разделение <w>ответственности</w> — фундаментальный принцип в разработке программного обеспечения.",
                                "pl": "Rozdzielenie <w>aspektów</w> to fundamentalna zasada w inżynierii oprogramowania."
                            }
                        },
                        {
                            "text": "The security <w>concern</w> was addressed by updating the encryption module.",
                            "target_lang_translations": {
                                "ru": "<w>Проблема</w> безопасности была решена путем обновления модуля шифрования.",
                                "pl": "<w>Kwestia</w> bezpieczeństwa została rozwiązana poprzez aktualizację modułu szyfrującego."
                            }
                        }
                    ],
                    "common_phrases": [
                        "separation of concerns"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор информации, влияющий на код компьютерной программы (в программировании).",
                        "pl": "Zbiór informacji wpływający na kod programu komputerowego; aspekt funkcjonalny."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аспект",
                                "target_lang_sense_clarification": "часть функционала программы"
                            },
                            {
                                "target_lang_word": "задача",
                                "target_lang_sense_clarification": "область ответственности в коде"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "aspekt",
                                "target_lang_sense_clarification": "oddzielna część logiki programu"
                            },
                            {
                                "target_lang_word": "odpowiedzialność",
                                "target_lang_sense_clarification": "zakres zadań modułu w kodzie"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f14d95fc-a9c6-32e3-8209-3709c72a09cf",
                    "sense_definition": "To relate or belong to; to have reference to or connection with.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concern_relate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new regulations <w>concern</w> all employees working in the factory.",
                            "target_lang_translations": {
                                "ru": "Новые правила <w>касаются</w> всех сотрудников, работающих на фабрике.",
                                "pl": "Nowe przepisy <w>dotyczą</w> wszystkich pracowników zatrudnionych w fabryce."
                            }
                        },
                        {
                            "text": "As far as I am <w>concerned</w>, you can take the day off tomorrow.",
                            "target_lang_translations": {
                                "ru": "Что <w>касается</w> меня, ты можешь взять завтра выходной.",
                                "pl": "Jeśli o mnie <w>chodzi</w>, możesz wziąć jutro wolne."
                            }
                        }
                    ],
                    "common_phrases": [
                        "as far as I am concerned",
                        "to whom it may concern"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь отношение к чему-либо; затрагивать.",
                        "pl": "Dotyczyć czegoś lub odnosić się do czegoś; mieć związek z czymś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "касаться",
                                "target_lang_sense_clarification": "иметь отношение"
                            },
                            {
                                "target_lang_word": "относиться",
                                "target_lang_sense_clarification": "принадлежать или быть связанным"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "dotyczyć",
                                "target_lang_sense_clarification": "mieć związek z czymś"
                            },
                            {
                                "target_lang_word": "tyczyć się",
                                "target_lang_sense_clarification": "odnosić się do kogoś/czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "122c9201-4fa9-3813-9989-9246c04e4fb5",
                    "sense_definition": "To make somebody worried or anxious.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concern_worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud noise from the engine began to <w>concern</w> the driver.",
                            "target_lang_translations": {
                                "ru": "Громкий шум двигателя начал <w>беспокоить</w> водителя.",
                                "pl": "Głośny hałas z silnika zaczął <w>niepokoić</w> kierowcę."
                            }
                        },
                        {
                            "text": "Her poor health continues to <w>concern</w> her family and friends.",
                            "target_lang_translations": {
                                "ru": "Её слабое здоровье продолжает <w>волновать</w> её семью и друзей.",
                                "pl": "Jej słaby stan zdrowia wciąż <w>martwi</w> jej rodzinę i przyjaciół."
                            }
                        }
                    ],
                    "synonyms": [
                        "trouble",
                        "worry",
                        "disturb"
                    ],
                    "common_phrases": [
                        "concern someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставлять кого-то волноваться или тревожиться.",
                        "pl": "Sprawiać, że ktoś czuje się zmartwiony lub zaniepokojony."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспокоить",
                                "target_lang_sense_clarification": "лишать покоя, доставлять хлопоты"
                            },
                            {
                                "target_lang_word": "волновать",
                                "target_lang_sense_clarification": "вызывать переживания"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepokoić",
                                "target_lang_sense_clarification": "budzić obawy"
                            },
                            {
                                "target_lang_word": "martwić",
                                "target_lang_sense_clarification": "powodować smutek lub troskę"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "966aa75a-182e-3f8b-baaf-c47ac914f3cd",
                    "sense_definition": "To engage by feeling or sentiment; to interest.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concern_engage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He did not <w>concern</w> himself with the minor details of the project.",
                            "target_lang_translations": {
                                "ru": "Он не <w>обременял</w> себя мелкими деталями проекта.",
                                "pl": "Nie <w>zajmował się</w> drobnymi szczegółami projektu."
                            }
                        },
                        {
                            "text": "A good leader <w>concerns</w> herself with the well-being of her team.",
                            "target_lang_translations": {
                                "ru": "Хороший лидер <w>заботится</w> о благополучии своей команды.",
                                "pl": "Dobry lider <w>troszczy się</w> o dobrostan swojego zespołu."
                            }
                        }
                    ],
                    "synonyms": [
                        "interest"
                    ],
                    "common_phrases": [
                        "concern oneself with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Затрагивать чувства; вызывать интерес.",
                        "pl": "Angażować się poprzez uczucia; interesować się czymś lub zajmować się czymś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "интересовать",
                                "target_lang_sense_clarification": "вызывать интерес"
                            },
                            {
                                "target_lang_word": "занимать",
                                "target_lang_sense_clarification": "привлекать внимание"
                            },
                            {
                                "target_lang_word": "заботить",
                                "target_lang_sense_clarification": "быть важным для кого-то"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zajmować się",
                                "target_lang_sense_clarification": "poświęcać uwagę danej kwestii"
                            },
                            {
                                "target_lang_word": "troszczyć się",
                                "target_lang_sense_clarification": "dbać o coś z zaangażowaniem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}