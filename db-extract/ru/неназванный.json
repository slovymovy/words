                                            {
                                                "example_id": "68b2d0d0-7175-49bf-b597-807a216d7956",
                                                "sense_id": "6b19956f-6bf2-37d6-9a4d-be9229a7f22f",
                                                "text": "an unnamed military project"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6f9adce-5d7f-3a77-853d-ac70ac117ea5",
                                        "entry_id": "a56e8f69-73d4-30f6-815a-6a16c01fd7c7",
                                        "glosses": [
                                            "Not named or specified."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d3488ec-9e4d-4895-920c-a058649ec1f4",
                                                "sense_id": "b6f9adce-5d7f-3a77-853d-ac70ac117ea5",
                                                "text": "an unnamed day in the future"
                                            },
                                            {
                                                "example_id": "f0a010ff-77d8-483b-8daa-780fa400f6cb",
                                                "sense_id": "b6f9adce-5d7f-3a77-853d-ac70ac117ea5",
                                                "text": "The unnamed driver appeared before the South East Traffic Commissioner in late November, to receive a six-month HGV driving ban. It followed an earlier court appearance when he was fined a means-tested £715 and given six points on his driving licence for driving without due care and attention."
                                            },
                                            {
                                                "example_id": "0b16bb24-3d07-4152-8c0e-8d73cf055b3e",
                                                "sense_id": "b6f9adce-5d7f-3a77-853d-ac70ac117ea5",
                                                "text": "In a draft of their paper, the unnamed researchers describe how they not only used AI to generate responses, but attempted to personalize its replies based on information gleaned from the original poster’s prior Reddit history."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "158f316f-9c8f-4213-a713-a8a000bcf2ca",
                        "source_entry_id": "68211213-6724-315b-8b9c-3fb6214c3637",
                        "source_sense_id": "aa7ab346-105e-3aae-90df-0dd6d92c4c9b",
