                    {
                        "form_id": "c82d5c14-5a96-4313-97ea-72a2ce9c6edc",
                        "entry_id": "c4671c4e-5d6c-30d4-85cf-ba38c4f9cb16",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Emporkömmling"
                    },
                    {
                        "form_id": "fe555198-a4a8-4cd1-b207-375e0c6ab479",
                        "entry_id": "c4671c4e-5d6c-30d4-85cf-ba38c4f9cb16",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Emporkömmlinge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                        "entry_id": "c4671c4e-5d6c-30d4-85cf-ba38c4f9cb16",
                        "glosses": [
                            "jemand, der irgendwie in kurzer Zeit zu Geld und Einfluss gekommen ist, ohne bereits als dazugehörig akzeptiert zu werden"
                        ],
                        "tags": [
                            "mit negativer Konnotation"
                        ],
                        "examples": [
                            {
                                "example_id": "ee04f577-28cf-466a-8806-bafb63cbd863",
                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                "text": "Er ist ein kleiner Emporkömmling, der meint, er müsse seinen Reichtum jedem auf die Nase binden."
                            },
                            {
                                "example_id": "86eb52f6-dd39-408f-8e8e-bd4010e42d6c",
                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                "text": "„Ein Spottname, den der Präsident, von der Höhe seines Amtes herab, den Emporkömmlingen aus der Sechs-Parteien-Allianz »Georgischer Traum« verpasst.“"
                            },
                            {
                                "example_id": "de35c183-0437-416a-87ca-99e53602abce",
                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                "text": "„Der Emporkömmling musste am weiteren Aufstieg gehindert werden, und so ordnete der Stadtrat Pater Pintos Verhaftung an und ermächtigte seinen Gegenspieler Andrade, zu den Waffen zu greifen.“"
                            },
                            {
                                "example_id": "822d8d10-2d34-4c6f-8f2e-50c5eb97ad37",
                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                "text": "„Es liegt auf der Hand, ein Emporkömmling muß man nicht erst werden, man kann bereits als Emporkömmling zur Welt kommen.“"
                            },
                            {
                                "example_id": "d99bd79d-bb96-43f6-b978-785b857f0ee2",
                                "sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                                "text": "„Die Kerle, die in den verschiedenen Kerkern folterten, waren kleine Emporkömmlinge, die man hier und da in einem der zahlreichen Befreiungskriege aufgelesen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11d82968-c8a5-4fb8-9ca1-b8573a17d5f8",
                        "source_entry_id": "c4671c4e-5d6c-30d4-85cf-ba38c4f9cb16",
                        "source_sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                        "source_sense_description": "jemand, der in kurzer Zeit zu Geld und Einfluss gekommen ist, ohne als dazugehörig akzeptiert zu werden",
                        "target_lang_word": "upstart",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "upstart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a68f16d-4adf-3887-8019-60069c45710e",
                                        "entry_id": "032827ae-bad1-3154-85a6-37ee2077a1f2",
                                        "glosses": [
                                            "One who has suddenly gained wealth, power, or other prominence, but either has not received social acceptance or has become arrogant or presumptuous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83117ff9-d0ea-4179-8a0c-f4ad649b7b6a",
                                                "sense_id": "6a68f16d-4adf-3887-8019-60069c45710e",
                                                "text": "upstarts […]they call in reproach mushrooms"
                                            },
                                            {
                                                "example_id": "d8ab1ccd-15ad-4acf-a23e-3eacb4ebe5eb",
                                                "sense_id": "6a68f16d-4adf-3887-8019-60069c45710e",
                                                "text": "[S]he has no fair pretence of family or blood. She was nobody when he married her, barely the daughter of a gentleman; but ever since her being turned into a Churchill she has out-Churchill’d them all in high and mighty claims: but in herself, I assure you, she is an upstart.”"
                                            },
                                            {
                                                "example_id": "5fc6c6f3-fd38-494b-a4a1-d8b6eeef47d6",
                                                "sense_id": "6a68f16d-4adf-3887-8019-60069c45710e",
                                                "text": "But electric vehicles and the batteries that made them run became ensnared in corporate scandals, fraud, and monopolistic corruption that shook the confidence of the nation and inspired automotive upstarts."
                                            },
                                            {
                                                "example_id": "4b58ccf9-1816-4b9f-8e63-4ab54e6a57d7",
                                                "sense_id": "6a68f16d-4adf-3887-8019-60069c45710e",
                                                "text": "Where the Czech upstart [Lukáš] Rosol, ranked 100 in the world, all but blew [Rafael] Nadal's head off with his blunderbuss in a fifth set of unrivalled intensity on Thursday night, [Julien] Benneteau, a more artful citizen, used a rapier to hurt his vaunted foe before falling just short of a kill. In the end, it was he who staggered from the scene of the fight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2f0855b-930c-3866-811e-963f8b83cc64",
                                        "entry_id": "032827ae-bad1-3154-85a6-37ee2077a1f2",
                                        "glosses": [
                                            "The meadow saffron."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "upstart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f14b1182-e071-3a42-b2f9-e4a7a116e300",
                                        "entry_id": "ca50c2c0-959e-3d38-bbab-607c1f672737",
                                        "glosses": [
                                            "Acting like a parvenu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2975b28-7f57-333f-87ea-7d21595e3f79",
                                        "entry_id": "ca50c2c0-959e-3d38-bbab-607c1f672737",
                                        "glosses": [
                                            "Self-important and presumptuous."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "upstart",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a697ff5-7e05-3e5a-a546-fc7fe571f3dd",
                                        "entry_id": "1b0f4111-81a4-3132-85f8-3f711d274afa",
                                        "glosses": [
                                            "To rise suddenly, to spring"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4941b58-fc86-4666-b7f0-ffda97f5cfdf",
                                                "sense_id": "8a697ff5-7e05-3e5a-a546-fc7fe571f3dd",
                                                "text": "Th' Elfe therewith astownd,\nUpstarted lightly from his looser make,\nAnd his unready weapons gan in hand to take."
                                            },
                                            {
                                                "example_id": "aa76f3bd-93ea-4f07-bbb6-5083ed13f438",
                                                "sense_id": "8a697ff5-7e05-3e5a-a546-fc7fe571f3dd",
                                                "text": "the beauteous beast\nScared by the noise upstarted at our feet"
                                            },
                                            {
                                                "example_id": "aae8dd90-db9d-4557-9ef6-59c9dc48b2f7",
                                                "sense_id": "8a697ff5-7e05-3e5a-a546-fc7fe571f3dd",
                                                "text": "\"Be that word our sign of parting, bird or fiend!\" I shrieked, upstarting—"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f13ca7e-b3d9-42cf-b90f-a863109e0a51",
                        "source_entry_id": "c4671c4e-5d6c-30d4-85cf-ba38c4f9cb16",
                        "source_sense_id": "bf32a230-c620-31f0-981a-2ff6f6d327ae",
                        "source_sense_description": "jemand, der in kurzer Zeit zu Geld und Einfluss gekommen ist, ohne als dazugehörig akzeptiert zu werden",
                        "target_lang_word": "parvenu",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parvenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba39693b-d23b-39b8-b145-8a15540379f3",
                                        "entry_id": "4f8d29c7-2efe-3a21-a7f8-311c314bef8f",
                                        "glosses": [
                                            "Qui s'est élevé à une condition sociale importante, souvent fortunée, en conservant des usages, des codes, des manières ou une culture assimilés à une classe sociale jugée comme étant inférieure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f47e85ab-68c2-4b99-b881-d41ec2ca7410",
                                                "sense_id": "ba39693b-d23b-39b8-b145-8a15540379f3",
                                                "text": "Un commerçant parvenu."
                                            },
                                            {
                                                "example_id": "b7f39fc3-37ad-46c4-9485-4f897f0a3540",
                                                "sense_id": "ba39693b-d23b-39b8-b145-8a15540379f3",
                                                "text": "Le peuple élève au ciel ta valeur, ta vertu\nMais tu n'es pour ces grands qu'un soldat parvenu."
                                            },
                                            {
                                                "example_id": "cebd59c4-8b79-4a2a-b81e-b766851ff95e",
                                                "sense_id": "ba39693b-d23b-39b8-b145-8a15540379f3",
                                                "text": "Je suis vieux et vous êtes jeune ; je suis un bourgeois parvenu et vous êtes née dans un monde dont je ne connais ni les usages ni les plaisirs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parvenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfedb01b-c03a-3f1e-b884-2a5e927a0cef",
                                        "entry_id": "8dbbb458-ef97-32cf-9845-3d6ed9dba668",
                                        "glosses": [
                                            "Personne qui s’est élevée rapidement au-dessus de sa condition première sans avoir acquis les manières, le ton et le savoir-vivre qui conviennent à son nouveau milieu."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37a53779-3fee-478e-a41e-a3f2d77ee775",
                                                "sense_id": "cfedb01b-c03a-3f1e-b884-2a5e927a0cef",
                                                "text": "Le mot de parvenu fut alors prononcé :\nMot banal, et des cours injure favorite\nLorsqu'auprès des grands noms s'élève un grand mérite."
                                            },
                                            {
                                                "example_id": "dc2a071b-7dc0-4d85-a6a0-149c978f48b8",
                                                "sense_id": "cfedb01b-c03a-3f1e-b884-2a5e927a0cef",
                                                "text": "Ce millionnaire - qui ne l'avait pas toujours été - payait de mine et personne ne l'aurait pris pour un parvenu."
                                            },
                                            {
                                                "example_id": "f5e54350-b5ff-4684-9478-6793b3ece445",
                                                "sense_id": "cfedb01b-c03a-3f1e-b884-2a5e927a0cef",
                                                "text": "Je suis une enfant de parvenu, ou de conquérant, c’est la même chose."
                                            },
                                            {
                                                "example_id": "6c6c8b72-c513-429c-acc1-6ebd65788bcb",
                                                "sense_id": "cfedb01b-c03a-3f1e-b884-2a5e927a0cef",
                                                "text": "Les parvenus doivent, dans le monde, avoir mille ménagements pour que leur fortune ne soit pas trop humiliante pour autrui."
                                            },
                                            {
                                                "example_id": "78ac4f8f-3fbe-49a2-b25f-3cce3ed20868",
                                                "sense_id": "cfedb01b-c03a-3f1e-b884-2a5e927a0cef",
                                                "text": "Il est arrivé qu’une révolution, faite par des millions de pauvres gens dans un esprit égalitaire, avec une idéologie socialiste, ayant remporté une victoire complète, s’est trouvée confisquée par les parvenus qu’elle avait installés dans tous les rouages de l’État, et d’abord dans ceux du parti révolutionnaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parvenu",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "808851f5-2077-3beb-9ba2-7d82f188b82c",
                                        "entry_id": "806f4ac5-b97e-31c7-92c1-d35b8dd5ae09",
                                        "glosses": [
                                            "Participe passé masculin singulier de parvenir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1e2fd87-de04-4c43-af3a-318bef4287d3",
                                                "sense_id": "808851f5-2077-3beb-9ba2-7d82f188b82c",
                                                "text": "Là où elle pouvait s’incarner, il était parvenu à se décorporiser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
