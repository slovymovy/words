                    }
                ],
                "senses": [
                    {
                        "sense_id": "846ff9b3-925a-330e-912c-a13562c454e8",
                        "entry_id": "afde48df-6031-32e4-ac50-f4c244c0e79b",
                        "glosses": [
                            "Abschluss eines Kleidungsstückes am Hals oder Ärmel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45e6d4a0-da7f-4d9b-84ff-0c3307a8c15e",
                                "sense_id": "846ff9b3-925a-330e-912c-a13562c454e8",
                                "text": "„Das Bündchen wird in Bayern und Österreich auch Stiezerl bzw. Stitzerl genannt.“"
                            },
                            {
                                "example_id": "77f40c82-30fc-4f19-8242-622e4c705938",
                                "sense_id": "846ff9b3-925a-330e-912c-a13562c454e8",
                                "text": "„Das Bündchen ist die einfachste Methode, ein offenes Stoffende schön abzuschließen.“"
                            },
                            {
                                "example_id": "388fc647-82c7-48e1-9e9a-0a39ef06da9b",
                                "sense_id": "846ff9b3-925a-330e-912c-a13562c454e8",
                                "text": "„Aber auch ohne den Rest können Sie zusammen mit der aufgetrennten Wolle eines Bündchens und einer oder mehreren anderen Farben das Bündchen in Ringeln verlängern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
