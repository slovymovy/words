                        "glosses": [
                            "Lunette monoculaire tenue par un manche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdada651-7b00-4775-9a20-1c7e7937c408",
                                "sense_id": "84ed56a5-f2b1-300a-a152-6ca5b46cb9bf",
                                "text": "Par contre les premiers binocles à main ne datent que de l'époque du directoire, et il faisaient partie du maintien affecté des Incroyables, tandis que le monocle à long manche ou « lancetier » existait déjà sous Louis XV."
                            },
                            {
                                "example_id": "8535635d-5190-48b6-8f82-d1576646156b",
                                "sense_id": "84ed56a5-f2b1-300a-a152-6ca5b46cb9bf",
                                "text": "Les binocles, faces-à-main, lancetiers et autres lorgnettes tenus à la main de la fin du XVIIIe siècle jusqu'au début du XXe siècle sont davantage des gadgets complétant la mode vestimentaire que de véritables outils de travail."
                            }
                        ]
                    }
