                        "sense_id": "34fac6bd-dbb9-3ec9-aefa-4cf7edd2d0a8",
                        "entry_id": "f51ea4fb-3b25-3ac7-b743-65b7d2ab2067",
                        "glosses": [
                            "A white immigrant, especially one moving to or from the United States."
                        ],
                        "tags": [
                            "countable",
                            "humorous",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a274656b-0ebe-4151-bb97-21d1c6f848ce",
                                "sense_id": "34fac6bd-dbb9-3ec9-aefa-4cf7edd2d0a8",
                                "text": "With only a head full of figures and a pocket full of indigestion tablets, a \"whiteback\" CPA emerges from the Rio Grande hoping for a better life in Mexico."
                            },
                            {
                                "example_id": "4d64e94b-cbb8-4e2f-9468-ac5f0df2e854",
                                "sense_id": "34fac6bd-dbb9-3ec9-aefa-4cf7edd2d0a8",
                                "text": "The \" whiteback\" joke is from Charlie Hill's appearance on The Tonight Show and is republished in Kenneth Lincoln's book Indian Humor as follows: \" the first English immigrants were illegal aliens —' Whitebacks, we call 'em.'"
                            },
                            {
                                "example_id": "b079527b-c4e6-4426-be8a-020649bb851e",
                                "sense_id": "34fac6bd-dbb9-3ec9-aefa-4cf7edd2d0a8",
                                "text": "Canadians are a friendly, open people. Therefore, their first instinct is to welcome the \"whitebacks” from south of the border."
                            }
                        ]
                    }
