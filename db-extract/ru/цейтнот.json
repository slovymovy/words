                    }
                ],
                "senses": [
                    {
                        "sense_id": "8bd7ca63-fb6f-3e6c-b31e-6b265163eba5",
                        "entry_id": "7a613efb-2791-38ab-b9d0-e702d9ba27f1",
                        "glosses": [
                            "шахм. в шахматах, шашках — положение, когда игроку не хватает времени, отведённого для обдумывания ходов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3d070cf-a60b-4d34-bc08-0753ff34f9a8",
                                "sense_id": "8bd7ca63-fb6f-3e6c-b31e-6b265163eba5",
                                "text": "Крамник в игре с Грищуком получил заметный перевес, загнал противника в цейтнот и в какой-то момент мог форсировать победу."
                            }
                        ]
                    },
                    {
                        "sense_id": "afabb24a-6a6f-353c-b4ae-1ec6dc888637",
                        "entry_id": "7a613efb-2791-38ab-b9d0-e702d9ba27f1",
                        "glosses": [
                            "перен., разг. острый недостаток времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54e29ed5-fb9a-44b4-bb55-286ab61007ba",
                                "sense_id": "afabb24a-6a6f-353c-b4ae-1ec6dc888637",
                                "text": "Мы вкалывали днем и ночью, цейтнот был страшный."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a2d5973-0a8d-47f9-a865-e12a54691537",
                        "source_entry_id": "7a613efb-2791-38ab-b9d0-e702d9ba27f1",
                        "target_lang_word": "Zeitnot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeitnot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8bc0fdd-b2ff-3a09-9ff2-52805a55cf64",
                                        "entry_id": "878490ee-4003-3be9-b8bc-66d9781bdc8d",
                                        "glosses": [
                                            "bedrängte Lage aufgrund nicht ausreichend zur Verfügung stehender Zeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd98237c-e0dd-449c-89ef-a103ef4adaea",
                                                "sense_id": "d8bc0fdd-b2ff-3a09-9ff2-52805a55cf64",
                                                "text": "Wir sollten rechtzeitig mit den Arbeiten beginnen, damit wir nicht in Zeitnot geraten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e0bf6af-8dba-3c7c-9630-78195066d01a",
                                        "entry_id": "878490ee-4003-3be9-b8bc-66d9781bdc8d",
                                        "glosses": [
                                            "bedrängte Lage aufgrund nicht ausreichend zur Verfügung stehender Zeit",
                                            "Spielphase, in der ein Spieler nur noch über wenig Bedenkzeit verfügt, um seine Züge ausführen zu können"
                                        ],
                                        "tags": [
                                            "Schach"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9bfa2f7e-c423-4288-9f04-8bb1e3f2ac16",
                                                "sense_id": "9e0bf6af-8dba-3c7c-9630-78195066d01a",
                                                "text": "Er stand auf Gewinn, hat die Partie aber leider in Zeitnot verloren."
                                            },
                                            {
                                                "example_id": "4449b23e-28e1-4ac2-9275-422dd7416614",
                                                "sense_id": "9e0bf6af-8dba-3c7c-9630-78195066d01a",
                                                "text": "Ein Schachspieler, der sich in Zeitnot befindet, muss nach den FIDE-Regeln seine Züge nicht mehr aufschreiben (übliche Festlegung: fünf Minuten bis zur Zeitkontrolle)."
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b971faa-c5cb-400b-8823-47f281bb15e0",
                        "source_entry_id": "7a613efb-2791-38ab-b9d0-e702d9ba27f1",
                        "target_lang_word": "niedoczas",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "niedoczas",
