                                    {
                                        "sense_id": "934ff624-81b3-3a41-826c-da51f8c7e808",
                                        "entry_id": "e6c4c672-e87f-3c2c-b50e-3cc578c5e5ea",
                                        "glosses": [
                                            "A figure of speech that uses the name of a part of something to represent the whole, or the whole to represent a part, or a specific kind or instance to represent the general category, or the general category to represent a specific kind or instance, or the constituent material to represent the thing made from it."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rhetoric",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1865062-33b8-4ace-b59d-9d78ff839e6c",
                                                "sense_id": "934ff624-81b3-3a41-826c-da51f8c7e808",
                                                "text": "Synecdoche the whole for part will take,\nOr part for whole, just for the metre's sake."
                                            },
                                            {
                                                "example_id": "547b0355-cce1-42ca-8d53-7d07b63ecd0c",
                                                "sense_id": "934ff624-81b3-3a41-826c-da51f8c7e808",
                                                "text": "\"Holocaust\" can become a tired synecdoche for war crimes in general."
                                            },
                                            {
                                                "example_id": "5ae1d023-c06b-46b4-8250-638086145767",
                                                "sense_id": "934ff624-81b3-3a41-826c-da51f8c7e808",
                                                "text": "Perhaps being in a touring band was, to Yorke, a synecdoche for the modern condition: disorientation, alienation, rootlessness, exhaustion, lack of control, occasional derangement, constant motion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab096ce6-9102-3784-93a7-b07217d81a56",
                                        "entry_id": "e6c4c672-e87f-3c2c-b50e-3cc578c5e5ea",
                                        "glosses": [
                                            "The use of this figure of speech."
                                        ],
