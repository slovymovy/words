                                    {
                                        "sense_id": "046b34b3-1a72-38a1-aab5-476a94925792",
                                        "entry_id": "9d5013ae-323a-3cc2-ab9b-bfffe4a3ae93",
                                        "glosses": [
                                            "modalità cognitiva e dialettica espressa in modo strutturato, lineare, e costituita da elementi sottili della sapienza a cui è possibile correlare differenti temi ogni volta in differenti situazioni"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "487ddea3-0a16-4cbc-8280-e403a71f8042",
                                                "sense_id": "046b34b3-1a72-38a1-aab5-476a94925792",
                                                "text": "per il processo atto attraverso una generalizzazione è possibile addurre differenti prospettive del conoscere"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd08320b-1177-3681-93bc-44b8fb93996a",
