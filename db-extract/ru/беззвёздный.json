                "senses": [
                    {
                        "sense_id": "5993c0bb-db15-31cf-9b07-a9e7ec0170c9",
                        "entry_id": "e3c3cd70-9a94-3929-9419-76ba069c16f6",
                        "glosses": [
                            "starless (without visible stars)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ab746aa-f50b-4719-bf1b-98fafa9a1460",
                                "sense_id": "5993c0bb-db15-31cf-9b07-a9e7ec0170c9",
                                "text": "Я не могу́ засну́ть, и так быва́ет всегда́,\nКогда́ восхо́дит твоя́ одино́кая звезда́,\nКатя́щаяся вдаль на спи́цах луче́й,\nДалёкое свети́ло беззвёздных ноче́й",
                                "translation": "Nautilus Pompilius",
                                "english": "Nautilus Pompilius"
                            }
                        ]
                    }
                ],
