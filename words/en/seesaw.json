{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1095d87-be1c-3ffd-8a79-a2322c3ffa80",
                    "sense_definition": "A playground structure with a plank balanced in the middle where one person goes up as the other goes down.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children played on the <w>seesaw</w> all afternoon.",
                            "target_lang_translations": {
                                "pl": "Dzieci bawiły się na <w>huśtawce</w> przez całe popołudnie."
                            }
                        },
                        {
                            "text": "She sat on one end of the <w>seesaw</w> while her brother sat on the other.",
                            "target_lang_translations": {
                                "pl": "Usiadła na jednym końcu <w>huśtawki</w>, podczas gdy jej brat usiadł na drugim."
                            }
                        }
                    ],
                    "synonyms": [
                        "teeter-totter"
                    ],
                    "common_phrases": [
                        "ride a seesaw"
                    ],
                    "target_lang_definitions": {
                        "pl": "Urządzenie na placu zabaw w formie deski wyważonej pośrodku, gdzie jedna osoba idzie w górę, gdy druga schodzi w dół."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "huśtawka wagowa",
                                "target_lang_sense_clarification": "precyzyjne określenie urządzenia na placu zabaw"
                            },
                            {
                                "target_lang_word": "huśtawka",
                                "target_lang_sense_clarification": "potoczne określenie urządzenia na placu zabaw"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e666fca1-c8a5-302d-8ef5-076fe4656e0e",
                    "sense_definition": "A series of up-and-down movements.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boat's gentle <w>seesaw</w> on the waves made him feel sick.",
                            "target_lang_translations": {
                                "pl": "Delikatne <w>kołysanie</w> łodzi na falach przyprawiło go o mdłości."
                            }
                        },
                        {
                            "text": "The steady <w>seesaw</w> of the rocking chair slowly put the baby to sleep.",
                            "target_lang_translations": {
                                "pl": "Miarowe <w>kołysanie</w> fotela bujanego powoli uśpiło dziecko."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Seria ruchów w górę i w dół."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kołysanie",
                                "target_lang_sense_clarification": "ruch w górę i w dół"
                            },
                            {
                                "target_lang_word": "bujanie",
                                "target_lang_sense_clarification": "rytmiczny ruch wahadłowy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c74c9135-7a78-38f6-b230-9b25477d3492",
                    "sense_definition": "A series of alternating changes in feelings or situations.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The match was a real <w>seesaw</w>, with the lead changing hands five times.",
                            "target_lang_translations": {
                                "pl": "Mecz był prawdziwą <w>huśtawką</w> – prowadzenie zmieniało się pięć razy."
                            }
                        },
                        {
                            "text": "Their relationship was a <w>seesaw</w> of emotions.",
                            "target_lang_translations": {
                                "pl": "Ich związek był <w>huśtawką</w> emocji."
                            }
                        }
                    ],
                    "common_phrases": [
                        "seesaw battle"
                    ],
                    "target_lang_definitions": {
                        "pl": "Seria naprzemiennych zmian w uczuciach lub sytuacjach."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wahania",
                                "target_lang_sense_clarification": "niestabilność nastrojów lub sytuacji"
                            },
                            {
                                "target_lang_word": "zmienność",
                                "target_lang_sense_clarification": "stan ciągłych zmian"
                            },
                            {
                                "target_lang_word": "huśtawka",
                                "target_lang_sense_clarification": "przenośnie: huśtawka nastrojów, emocji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79bdf17d-20ab-3fb8-928f-008bcf5f33a3",
                    "sense_definition": "An abnormal breathing pattern with paradoxical chest and abdominal movement.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient exhibited a <w>seesaw</w> breathing pattern indicating severe airway obstruction.",
                            "target_lang_translations": {
                                "pl": "Pacjent wykazywał <w>paradoksalny wzorzec oddychania</w>, wskazujący na poważną niedrożność dróg oddechowych."
                            }
                        },
                        {
                            "text": "Doctors monitored the infant for signs of <w>seesaw</w> respiration.",
                            "target_lang_translations": {
                                "pl": "Lekarze monitorowali niemowlę pod kątem oznak <w>oddychania paradoksalnego</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Nieprawidłowy wzorzec oddychania z paradoksalnym ruchem klatki piersiowej i brzucha."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "oddychanie paradoksalne",
                                "target_lang_sense_clarification": "termin medyczny określający ten typ oddechu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2106f380-f20a-3313-9d07-65aa2b00890e",
                    "sense_definition": "To change frequently between two states or opinions.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Public opinion continues to <w>seesaw</w> on this controversial issue.",
                            "target_lang_translations": {
                                "pl": "Opinia publiczna w tej kontrowersyjnej sprawie wciąż się <w>waha</w>."
                            }
                        },
                        {
                            "text": "Stock prices <w>seesaw</w> throughout the day due to market uncertainty.",
                            "target_lang_translations": {
                                "pl": "Ceny akcji <w>skaczą</w> w ciągu dnia z powodu niepewności na rynku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Częste zmienianie zdania lub stanu między dwiema opcjami."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wahać się",
                                "target_lang_sense_clarification": "nie móc się zdecydować"
                            },
                            {
                                "target_lang_word": "skakać",
                                "target_lang_sense_clarification": "o gwałtownych zmianach cen lub opinii"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69c3b5c7-a522-3928-bc46-b15ad98bd6ea",
                    "sense_definition": "To play on a seesaw.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children love to <w>seesaw</w> in the park.",
                            "target_lang_translations": {
                                "pl": "Dzieci uwielbiają <w>huśtać się</w> w parku."
                            }
                        },
                        {
                            "text": "They <w>seesawed</w> together for hours in the playground.",
                            "target_lang_translations": {
                                "pl": "Godzinami <w>huśtali się</w> razem na placu zabaw."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Bawić się na huśtawce."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "huśtać się",
                                "target_lang_sense_clarification": "używać huśtawki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d1c9c73-940c-3cf7-8551-517ecf79a4b3",
                    "sense_definition": "To cause something to move backward and forward.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began to <w>seesaw</w> the heavy box to loosen it from the floor.",
                            "target_lang_translations": {
                                "pl": "Zaczął <w>kołysać</w> ciężkim pudłem, aby poluzować je z podłogi."
                            }
                        },
                        {
                            "text": "The worker had to <w>seesaw</w> the plank to fit it into the frame.",
                            "target_lang_translations": {
                                "pl": "Robotnik musiał <w>poruszać</w> deską, aby dopasować ją do ramy."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Powodować, że coś porusza się w przód i w tył lub w górę i w dół."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "kołysać",
                                "target_lang_sense_clarification": "wprawiać w ruch wahadłowy"
                            },
                            {
                                "target_lang_word": "poruszać",
                                "target_lang_sense_clarification": "wprawiać w ruch"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6f48e63f-0482-38c0-a667-2d31a1f2907b",
                    "sense_definition": "Characterized by frequent changes or fluctuations.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team had a <w>seesaw</w> performance throughout the entire season.",
                            "target_lang_translations": {
                                "pl": "Drużyna miała <w>zmienne</w> wyniki przez cały sezon."
                            }
                        },
                        {
                            "text": "They experienced a <w>seesaw</w> economy with rapid growth followed by sudden decline.",
                            "target_lang_translations": {
                                "pl": "Doświadczyli <w>chwiejnej</w> gospodarki z szybkim wzrostem, po którym nastąpił nagły spadek."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Charakteryzujący się częstymi zmianami lub wahaniami."
