                    },
                    {
                        "translation_id": "91ad78a9-42ce-4c85-99ae-3a096bc12986",
                        "source_entry_id": "d6b19133-0d9b-385d-9c0d-2c683148b383",
                        "source_sense_id": "33c99346-f7d8-329f-8e4f-c82db4136d73",
                        "source_sense_description": "zeer slecht",
                        "target_lang_word": "mies",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mies",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2783b4bd-af85-3cb6-8239-369396d0e885",
                                        "entry_id": "e9595f73-d348-33ee-858f-3098ca713add",
                                        "glosses": [
                                            "auf verdrießlicher, ärgerlicher, ablehnender Art und Weise schlecht; wertlos, elend, übel"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "575fde8f-1da0-42be-ad0b-66f083ec3c1b",
                                                "sense_id": "2783b4bd-af85-3cb6-8239-369396d0e885",
                                                "text": "Es sieht damit mies aus."
                                            },
                                            {
                                                "example_id": "480577b7-cadd-44f0-95dc-737a6c84c427",
                                                "sense_id": "2783b4bd-af85-3cb6-8239-369396d0e885",
                                                "text": "Das ist der mieseste Laden, den ich seit langem gesehen habe."
                                            },
                                            {
                                                "example_id": "99959d20-13e1-4895-b33d-1765082ae82a",
                                                "sense_id": "2783b4bd-af85-3cb6-8239-369396d0e885",
                                                "text": "Das ist eine miese Sache."
                                            },
                                            {
                                                "example_id": "5598290f-713b-470e-b611-a0632438d641",
                                                "sense_id": "2783b4bd-af85-3cb6-8239-369396d0e885",
                                                "text": "„Die Bewohner der Oschlowskistraße leben unter miesen Bedingungen, sie sind derb, gierig und vulgär.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "5f84b9e7-fe25-3f98-adfe-963749558fca",
                                        "entry_id": "e9595f73-d348-33ee-858f-3098ca713add",
                                        "glosses": [
                                            "unter dem zu erwartenden Niveau"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6a386ed-a13c-4d17-9a79-15dd20cb8262",
                                                "sense_id": "5f84b9e7-fe25-3f98-adfe-963749558fca",
                                                "text": "Nachmittags ist das Fernsehprogramm echt mies."
                                            },
                                            {
                                                "example_id": "5757f387-ace7-4f06-a90c-b30cd41afb69",
                                                "sense_id": "5f84b9e7-fe25-3f98-adfe-963749558fca",
                                                "text": "Das nenne ich eine mies bezahlte Arbeit."
                                            },
                                            {
                                                "example_id": "47bdaf6a-54c8-486f-9faa-344cb1bbc5f1",
                                                "sense_id": "5f84b9e7-fe25-3f98-adfe-963749558fca",
                                                "text": "Die Aussichten sind mies."
                                            },
                                            {
                                                "example_id": "eb73de14-5417-4f94-ac9c-1a30e37793e1",
                                                "sense_id": "5f84b9e7-fe25-3f98-adfe-963749558fca",
                                                "text": "„Die miese Wahlbeteiligung im Land Bremen war der Politik ein Dorn im Auge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "74df6764-9d6b-3d9c-8484-bf66a3d8ffb3",
                                        "entry_id": "e9595f73-d348-33ee-858f-3098ca713add",
                                        "glosses": [
                                            "von niederer Gesinnung; gemein, niederträchtig, hinterhältig"
                                        ],
                                        "tags": [
                                            "casual",
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0703c19-6ea0-42c2-8e29-9bba0cebcc65",
                                                "sense_id": "74df6764-9d6b-3d9c-8484-bf66a3d8ffb3",
                                                "text": "Du bist ein mieser Wurm."
                                            },
                                            {
                                                "example_id": "baec625e-74ae-4e4f-a6d3-8cec396fd6cd",
                                                "sense_id": "74df6764-9d6b-3d9c-8484-bf66a3d8ffb3",
                                                "text": "Du hast einen miesen Charakter."
                                            },
                                            {
                                                "example_id": "c1a22239-b331-4027-ba80-0ba6d3454efe",
                                                "sense_id": "74df6764-9d6b-3d9c-8484-bf66a3d8ffb3",
                                                "text": "Er ist ein mieser Heuchler."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "18403abe-9368-3bc7-a97d-50e8b5c81283",
                                        "entry_id": "e9595f73-d348-33ee-858f-3098ca713add",
                                        "glosses": [
                                            "unwohl, übel, elend"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7f8b3a1-d285-4eb0-b839-915c722b3885",
                                                "sense_id": "18403abe-9368-3bc7-a97d-50e8b5c81283",
                                                "text": "Mir geht es mies."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7126806b-298d-4930-8360-ed7943172719",
                        "source_entry_id": "d6b19133-0d9b-385d-9c0d-2c683148b383",
                        "source_sense_id": "33c99346-f7d8-329f-8e4f-c82db4136d73",
