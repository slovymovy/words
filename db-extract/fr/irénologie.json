                "senses": [
                    {
                        "sense_id": "15caf511-34c1-3cec-b16d-658a46212d8e",
                        "entry_id": "739cd1cd-ff76-348c-a225-d38514cd7737",
                        "glosses": [
                            "Science de la paix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c87bb2-fe78-40b6-9a8c-efe5bb7ac92a",
                                "sense_id": "15caf511-34c1-3cec-b16d-658a46212d8e",
                                "text": "Ne peut-on pas envisager pour la forêt des indicateurs du type de celui imaginé de façon malicieuse par l’économiste norvégien Johan Galtung, le fondateur de la science de la paix joliment appelée irénologie ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eecd89da-814c-4827-93bc-bb88658c25c2",
                        "source_entry_id": "739cd1cd-ff76-348c-a225-d38514cd7737",
                        "source_sense_id": "15caf511-34c1-3cec-b16d-658a46212d8e",
                        "target_lang_word": "Friedensforschung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Friedensforschung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14179a60-ded9-353e-b714-f4199fc4e24e",
                                        "entry_id": "683ecb13-438c-369b-8406-4b1b49b7e744",
                                        "glosses": [
                                            "wissenschaftliche Erforschung der Bedingungen und Grundlagen für dauerhaften Frieden zwischen Staaten, Völkern und Menschen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8508e9f1-ed09-4a94-86fb-013448fd8f74",
                                                "sense_id": "14179a60-ded9-353e-b714-f4199fc4e24e",
                                                "text": "„Friedensforschung muß wissenschaftlich betrieben werden.“"
                                            },
                                            {
                                                "example_id": "d929202e-0b3c-4de6-a432-3d133ce8f473",
                                                "sense_id": "14179a60-ded9-353e-b714-f4199fc4e24e",
                                                "text": "„Weizsäcker leitete Friedensforschungen und untersuchte die Möglichkeiten, dem Hunger weltweit ein Ende zu bereiten.“"
                                            },
                                            {
                                                "example_id": "3387b952-89a8-44b0-9839-53eb1bb6f05d",
                                                "sense_id": "14179a60-ded9-353e-b714-f4199fc4e24e",
                                                "text": "„Trotz Friedensforschungen, Friedensaktivisten, Friedensmärschen und Demonstrationen sei der Bazillus Krieg noch nicht ausgerottet.“"
                                            },
                                            {
                                                "example_id": "7b7819d4-d797-4e72-b186-d206636bec77",
                                                "sense_id": "14179a60-ded9-353e-b714-f4199fc4e24e",
                                                "text": "„Die Friedens- und Konfliktforscherin Mechthild Exo sieht eine insgesamt bedenkliche Entwicklung: ‚Während die Militarisierung an den Universitäten vorangetrieben wird, blutet die klassische Friedensforschung aus‘, sagte sie am Samstag in der Humboldt-Universität auf einem Kongress zum Afghanistankonflikt.“"
                                            },
                                            {
                                                "example_id": "e619d1f2-bc8c-407c-ab1b-ee3d75da3032",
                                                "sense_id": "14179a60-ded9-353e-b714-f4199fc4e24e",
                                                "text": "„Das Zentrum für Friedensforschung und Friedenspädagogik der Universität Klagenfurt will fortan gemeinsam mit drei außeruniversitären Einrichtungen als ‚Friedenscluster‘ verstärkt zusammenarbeiten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9b2bd43-fb99-4f98-8f5a-757ec7db519b",
                        "source_entry_id": "739cd1cd-ff76-348c-a225-d38514cd7737",
                        "source_sense_id": "15caf511-34c1-3cec-b16d-658a46212d8e",
                        "target_lang_word": "irenology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irenology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0df6b59e-3b98-392d-8fd6-54646274e52b",
                                        "entry_id": "876f2d70-5a8a-3664-8ce0-b61027f999c1",
                                        "glosses": [
                                            "The study of peace."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f57910ef-5738-4a98-a7c4-aae2da7c3db1",
                                                "sense_id": "0df6b59e-3b98-392d-8fd6-54646274e52b",
                                                "text": "Up to now, the irenological perspective has only been dealt with in passing. Just as for polemology, irenology must be systematically pursued as a necessary complement to what has so far been the exclusively polemological orientation of research. Peace itself, and different forms of peaceful coexistence, must be subjected to a greater degree of systematic documentation and analysis."
                                            },
                                            {
                                                "example_id": "e23f9cca-355d-4eef-bcbb-98cec85654e3",
                                                "sense_id": "0df6b59e-3b98-392d-8fd6-54646274e52b",
                                                "text": "As one of China's most important non-official think tanks on diplomacy and international relations, the Charhar Institute has been focusing on public diplomacy and irenology since its establishment in October 2009."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
