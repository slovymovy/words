                "senses": [
                    {
                        "sense_id": "fd05caed-e1ad-3c78-9f59-c734de149007",
                        "entry_id": "8ee0ced7-91ea-3f93-ac8a-ca890360d373",
                        "glosses": [
                            "1961 errichtetes Gericht mit Sitz in München, das dafür zuständig ist, über Beschwerden gegen Beschlüsse des Patentamts, über Klagen auf Nichtigkeit oder Zurücknahme von Patenten und über die Erteilung von Zwangslizenzen zu entscheiden"
                        ],
                        "tags": [
                            "in Deutschland"
                        ],
                        "examples": [
                            {
                                "example_id": "f8214524-fe3a-421b-84f3-89834bbe8767",
                                "sense_id": "fd05caed-e1ad-3c78-9f59-c734de149007",
                                "text": "„Raimund Lutz wird Nachfolger des scheidenden Präsidenten des Bundespatentgerichts Dr. Georg Landfermann.“"
                            },
                            {
                                "example_id": "7d5f63d7-6cec-487d-8b20-d4fc58cda8ad",
                                "sense_id": "fd05caed-e1ad-3c78-9f59-c734de149007",
                                "text": "„Herr Tödte hat dem Bundespatentgericht insgesamt 8 Jahre angehört, davon 5 Jahre als dessen Vizepräsident.“"
                            },
                            {
                                "example_id": "52305b2b-2048-470b-aed7-5858499fc82a",
                                "sense_id": "fd05caed-e1ad-3c78-9f59-c734de149007",
                                "text": "„Jetzt, drei Jahre nach der Beschwerde, verhandelt am Montag das Bundespatentgericht in München, was eine ‚echte‘ Weißwurst ist und was nicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
