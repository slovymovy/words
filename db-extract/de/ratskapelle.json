                "senses": [
                    {
                        "sense_id": "071c01d0-9fcd-333e-a1af-26f1356caa2a",
                        "entry_id": "dc62ef74-3772-3e1f-ab70-7dfeecad4690",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus, das nicht für regelmäßige Gottesdienste einer Gemeinde bestimmt ist, sondern den Stadtpatronen vorbehalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ead394-c96f-4999-a00d-45e6b68ab149",
                                "sense_id": "071c01d0-9fcd-333e-a1af-26f1356caa2a",
                                "text": "„Der von dem Kölner Maler Stefan Lochner ( 1451) für die Ratskapelle der Stadt Köln um 1442 gemalte Flügelaltar ist das bedeutendste Werk der spätgotischen Kölner Malerschule.“"
                            },
                            {
                                "example_id": "86567cf6-064d-47af-b5b7-9b159188c956",
                                "sense_id": "071c01d0-9fcd-333e-a1af-26f1356caa2a",
                                "text": "„Dr. Helmut Fußbroich, Kunsthistoriker und Geschäftsführer unserer Gesellschaft, schildert, was Köln verloren hat mit der prächtigen Synagoge in der Glockengasse und warum die Ratskapelle bei ihrer Weihe 1426 den Namen \"Maria in Jerusalem\" erhielt.“"
                            },
                            {
                                "example_id": "d1e5a07d-6b9d-4044-b5a0-605583175088",
                                "sense_id": "071c01d0-9fcd-333e-a1af-26f1356caa2a",
                                "text": "„In seiner Heimatstadt ist er als Stifter der Ratskapelle, des Marienaltars und des Gnadenstuhls unvergessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "84832155-7590-35f1-96f6-d5932b7b5125",
                        "entry_id": "dc62ef74-3772-3e1f-ab70-7dfeecad4690",
                        "glosses": [
                            "abgeteilter Raum in einem Gebäude, der für Gottesdienste, Taufen, Hochzeiten und dergleichen genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aae51536-e3d3-4c6b-9a9b-9530ee1dbe82",
                                "sense_id": "84832155-7590-35f1-96f6-d5932b7b5125",
                                "text": "„Am Fuße des Granusturmes waren auch die ehemalige Ratskapelle (in der die Repliken der Reichsinsignien aufbewahrt werden) und die Traditionsgaststätte „Postwagen“ beschädigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "baad7f28-b107-3eff-9d6f-45691889c107",
                        "entry_id": "dc62ef74-3772-3e1f-ab70-7dfeecad4690",
                        "glosses": [
                            "kleines Musiker-Ensemble, das insbesondere Tanz- und Unterhaltungsmusik spielt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "0f7aae37-2b47-44ff-ba23-adfccb778042",
                                "sense_id": "baad7f28-b107-3eff-9d6f-45691889c107",
                                "text": "„Mit insgesamt 150 Auftritten während ihrer aktiven Zeit in der Ratskapelle ist Victoria derzeit Rekordhalterin.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "c20a90cf-675a-3f9a-bd2f-860472cc9931",
                        "entry_id": "dc62ef74-3772-3e1f-ab70-7dfeecad4690",
                        "glosses": [
                            "logenähnliche Räumlichkeiten in Kirchen, die bestimmten Stadtpatronen zur Nutzung überlassen wurde"
                        ],
