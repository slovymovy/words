                "senses": [
                    {
                        "sense_id": "28c6f385-e8d3-31bd-bf91-4589a54851dd",
                        "entry_id": "ddfbd3a4-79a1-3e2f-8ea7-65f3a2bc33ab",
                        "glosses": [
                            "Konzept, dem zufolge Menschen ein angeborenes Bedürfnis haben, enge Beziehungen mit tiefen Gefühlen zu anderen Menschen aufzubauen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "134c7383-3dba-4756-8779-e66516f77844",
                                "sense_id": "28c6f385-e8d3-31bd-bf91-4589a54851dd",
                                "text": "„Die Bindungstheorie basiert auf einer emotionalen Sichtweise der frühen Mutter-Kind-Beziehung.“"
                            },
                            {
                                "example_id": "6810cdd4-8d70-417a-b448-e49b36845a89",
                                "sense_id": "28c6f385-e8d3-31bd-bf91-4589a54851dd",
                                "text": "„Der englische Kinderpsychiater und Psychoanalytiker John Bowlby begründete in den 1950er Jahren die Bindungstheorie“."
                            },
                            {
                                "example_id": "c5dbd2f8-b24e-43ab-876e-2da647c214be",
                                "sense_id": "28c6f385-e8d3-31bd-bf91-4589a54851dd",
                                "text": "„Da die Verinnerlichung der Gefühlsstruktur als Erwachsener von frühkindlichen Bindungserlebnisse gesteuert wird, folgen als zentrales Thema der Bindungstheorie die Bedingungen, die zu Unterschieden in der Organisation der Gefühle führen, sowie ihre Auswirkungen im Lebenslauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
