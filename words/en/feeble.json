{
    "word_family": [
        "enfeeble",
        "feebleness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e571a880-ffd0-3138-9efb-1490a9ea3c0c",
                    "sense_definition": "Deficient in physical strength.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Though she appeared old and <w>feeble</w>, she could still throw a ball.",
                            "target_lang_translations": {
                                "es": "Aunque parecía anciana y <w>débil</w>, todavía podía lanzar una pelota."
                            }
                        },
                        {
                            "text": "The <w>feeble</w> patient struggled to walk across the room without assistance.",
                            "target_lang_translations": {
                                "es": "El <w>endeble</w> paciente apenas podía cruzar la habitación sin ayuda."
                            }
                        }
                    ],
                    "synonyms": [
                        "weak",
                        "infirm",
                        "debilitated",
                        "frail"
                    ],
                    "antonyms": [
                        "strong"
                    ],
                    "target_lang_definitions": {
                        "es": "Que carece de fuerza física o vigor; débil o enfermizo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "débil",
                                "target_lang_sense_clarification": "falto de fuerza física"
                            },
                            {
                                "target_lang_word": "endeble",
                                "target_lang_sense_clarification": "de poca resistencia o contextura frágil"
                            },
                            {
                                "target_lang_word": "débil",
                                "target_lang_sense_clarification": "enfermizo o decaído"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d931d768-1026-350c-80d7-017e8561131d",
                    "sense_definition": "Lacking force, vigor, or effectiveness in action or expression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That was a <w>feeble</w> excuse for being late to the meeting.",
                            "target_lang_translations": {
                                "es": "Esa fue una excusa muy <w>endeble</w> por llegar tarde a la reunión."
                            }
                        },
                        {
                            "text": "The politician made a <w>feeble</w> attempt to defend his controversial policy.",
                            "target_lang_translations": {
                                "es": "El político hizo un intento <w>débil</w> por defender su controvertida política."
                            }
                        }
                    ],
                    "synonyms": [
                        "faint"
                    ],
                    "target_lang_definitions": {
                        "es": "Que carece de fuerza, contundencia o eficacia en sus acciones o expresiones."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "endeble",
                                "target_lang_sense_clarification": "poco convincente o sin solidez"
                            },
                            {
                                "target_lang_word": "pobre",
                                "target_lang_sense_clarification": "escaso de mérito o contundencia"
                            },
                            {
                                "target_lang_word": "débil",
                                "target_lang_sense_clarification": "poco enérgico o convincente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87956b14-f174-3b2c-80e1-2f1e94ff89d8",
                    "sense_definition": "To make someone or something weak.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long illness continued to <w>feeble</w> his once strong body.",
                            "target_lang_translations": {
                                "es": "La larga enfermedad continuó <w>debilitando</w> su cuerpo, antaño fuerte."
                            }
                        },
                        {
                            "text": "Lack of exercise will <w>feeble</w> your muscles over time.",
                            "target_lang_translations": {
                                "es": "La falta de ejercicio <w>debilitará</w> tus músculos con el tiempo."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Hacer que alguien o algo pierda la fuerza o se vuelva débil."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "debilitar",
                                "target_lang_sense_clarification": "quitar fuerza física o resistencia"
                            },
                            {
                                "target_lang_word": "extenuar",
                                "target_lang_sense_clarification": "agotar físicamente"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}