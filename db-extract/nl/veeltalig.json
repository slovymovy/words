                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multilingual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "93ef204e-8a85-359d-911f-041a965eccc6",
                                        "entry_id": "3e5cd360-7a31-3863-b0d3-b13020b292e4",
                                        "glosses": [
                                            "Of, relating to, or involving multiple languages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53066aa1-12e4-4649-9542-44b4c6ae0385",
                                                "sense_id": "93ef204e-8a85-359d-911f-041a965eccc6",
                                                "text": "In reality, the multidimensionality of language contact in multilingual environments ensures no such neat compartmentalisation."
                                            },
                                            {
                                                "example_id": "74e9c358-1fee-4466-b24b-3ec0e68f13de",
                                                "sense_id": "93ef204e-8a85-359d-911f-041a965eccc6",
                                                "text": "Wikipedia is the most ambitious multilingual project after the Bible: There are editions in over 340 languages, and a further 400 even more obscure ones are being developed and tested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "148e3b56-2c68-3ea6-8e80-a12a514bb6e5",
                                        "entry_id": "3e5cd360-7a31-3863-b0d3-b13020b292e4",
                                        "glosses": [
                                            "Able to communicate in a number of languages."
                                        ],
                                        "tags": [
                                            "of a person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23072856-c28e-4d1f-b0ef-4c969e10f4a1",
                                                "sense_id": "148e3b56-2c68-3ea6-8e80-a12a514bb6e5",
                                                "text": "So being multilingual can make you more appealing, more successful and more compassionate. And it’s also good for your health."
                                            },
                                            {
                                                "example_id": "dfeb2178-cba3-45a0-b6d0-ebcdba9f9731",
                                                "sense_id": "148e3b56-2c68-3ea6-8e80-a12a514bb6e5",
                                                "text": "Describing us as multilingual emphasizes our achievements and that learning English adds to the richness of our identity."
                                            }
                                        ]
                                    }
                                ]
                            },
