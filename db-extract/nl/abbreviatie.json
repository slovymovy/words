                                                "example_id": "140cae62-e139-454a-a9ab-5dfa98e8c542",
                                                "sense_id": "24f0f2d1-bd58-3063-998c-fb30edc1c34d",
                                                "text": "Jeszcze tylko trzeba się modlić o to, żeby skrótu do trasy gdańskiej i do tego nowego mostu nam nie puścili przez środek osiedla"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
