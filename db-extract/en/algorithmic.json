                        "glosses": [
                            "Of, relating to, or being an algorithm."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2330a1ee-481b-4338-9ef1-d7ab4579d6a9",
                                "sense_id": "f238623f-f4ae-3f20-b2ed-bff7db743eb3",
                                "text": "In an age when the charts have become an algorithmic spaghetti of streaming plays, radio and downloads, the purest way of measuring who is up and who is down in pop might be the Billboard Social 50, a sub-chart that measures reach across social networks."
                            }
                        ]
                    }
