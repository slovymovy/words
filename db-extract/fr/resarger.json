                        "glosses": [
                            "Redraguer, sarger à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd20a2d-b973-4836-93ca-9f8b977db31e",
                                "sense_id": "e0cc82eb-9e7b-3b8f-a0b4-81acb7a6f42e",
                                "text": "Au plaisir de resarger avec toi cher confrère"
                            },
                            {
                                "example_id": "7bdcfd7f-068e-43ed-a3c9-451ba7cacf44",
                                "sense_id": "e0cc82eb-9e7b-3b8f-a0b4-81acb7a6f42e",
                                "text": "Décoder ses signaux subtils, ça par contre, il n'y a aucun secret... sarger, sarger et resarger !"
                            },
                            {
                                "example_id": "2c023d17-555d-4947-be05-9361ddf934be",
                                "sense_id": "e0cc82eb-9e7b-3b8f-a0b4-81acb7a6f42e",
                                "text": "Tu aura un esprit plus positif, tu reprendra une certaine confiance dans les clubs et tu pourra ainsi resarger les meufs."
                            }
                        ]
                    }
