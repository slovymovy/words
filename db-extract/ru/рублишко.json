                ],
                "senses": [
                    {
                        "sense_id": "33d6b86a-b8cd-3a1f-b4e7-d12f430410d9",
                        "entry_id": "a8362419-381c-3d47-8d34-376a33deb5a8",
                        "glosses": [
                            "к сущ. рубль"
                        ],
                        "tags": [
                            "разг., уничиж., тж. пренебр."
                        ],
                        "examples": [
                            {
                                "example_id": "c9b62523-b79b-4caa-a5ba-c20f92477723",
                                "sense_id": "33d6b86a-b8cd-3a1f-b4e7-d12f430410d9",
                                "text": "У меня ещё рублишка с два осталось."
                            },
                            {
                                "example_id": "d39471e6-9ee6-4763-a3ad-9b7ebc6c37b4",
                                "sense_id": "33d6b86a-b8cd-3a1f-b4e7-d12f430410d9",
                                "text": "— Ведь не станем же мы из-за двадцати каких-нибудь паршивых рублишек лгать вам!"
                            },
                            {
                                "example_id": "f9a721b1-1263-4483-a121-45294d461549",
                                "sense_id": "33d6b86a-b8cd-3a1f-b4e7-d12f430410d9",
                                "text": "Когда, случалось, рублишко пришлёт, а то и два."
                            },
                            {
                                "example_id": "042c648d-eeed-440c-92b7-db88d490fb40",
                                "sense_id": "33d6b86a-b8cd-3a1f-b4e7-d12f430410d9",
                                "text": "— Мужицкого рублишка не хули́: он по́том нашим пахнет!"
                            }
                        ]
                    }
                ],
