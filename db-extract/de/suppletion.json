                "senses": [
                    {
                        "sense_id": "15cad12f-c727-380e-b5b9-3f438a5d02fb",
                        "entry_id": "0bb8a9bf-c81a-312f-87c9-e9d04e898182",
                        "glosses": [
                            "Von Suppletion spricht man, wenn Flexionsformen eines Wortes von verschiedenen Wortstämmen gebildet werden. Auf diese Weise kommen Suppletivparadigmen zustande."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0934efac-99a4-410a-8a10-ab713663242d",
                                "sense_id": "15cad12f-c727-380e-b5b9-3f438a5d02fb",
                                "text": "Beim Hilfsverb „sein“ mit den Formen „bin, bist, ist, sind, seid, sind“ liegt Suppletion vor."
                            },
                            {
                                "example_id": "6b528870-d5da-4cca-a6ab-706b5727b481",
                                "sense_id": "15cad12f-c727-380e-b5b9-3f438a5d02fb",
                                "text": "Auch in der Komparation gibt es Suppletion, z.B. bei „gut“ - „bess-er“."
                            },
                            {
                                "example_id": "3375744b-2f79-48a4-9e5b-bd345603ffd4",
                                "sense_id": "15cad12f-c727-380e-b5b9-3f438a5d02fb",
                                "text": "„Die angesichts ihres paradigmatischen Charakters auffälligen Irregularitäten der Flexionsmorphologie sind paradigmatische Defektivität und Suppletion.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
