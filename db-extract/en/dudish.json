                        "sense_id": "ea44efa7-58b5-34bb-b3a0-62683bc4d99a",
                        "entry_id": "eaf1d3b1-c58f-3a8c-a062-1766ef4147c4",
                        "glosses": [
                            "Like a dude or dandy; foppish; fastidious about personal appearance."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "8b1379a9-2ca7-4ce2-bc1b-0e382a9a6b4e",
                                "sense_id": "ea44efa7-58b5-34bb-b3a0-62683bc4d99a",
                                "text": "He was a stiff-collar, high-headed fellow, of good intellect and had rather a dudish appearance. He went gentlemanly dressed in East Virginia style, wore a high-top silk hat, as had lawyer Park, and sported a gold headed walking cane."
                            },
                            {
                                "example_id": "800d39b2-e9ff-4b8c-a4c2-91ec8e64b340",
                                "sense_id": "ea44efa7-58b5-34bb-b3a0-62683bc4d99a",
                                "text": "Women go dudish with pique trim, starched or flowered bosoms"
                            }
                        ]
                    }
                ],
