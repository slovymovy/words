                "senses": [
                    {
                        "sense_id": "f969a0bb-b0ec-3cf3-9930-49f14bdd7af1",
                        "entry_id": "78edc8ad-2f27-3a12-95d2-4400cef5e009",
                        "glosses": [
                            "Passereau africain de la famille des Sturnidés se nourrissant des ectoparasites qui vivent sur la peau des bœufs et autres ongulés."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8af6b6d-6496-49ac-b263-75ac425eb8b8",
                                "sense_id": "f969a0bb-b0ec-3cf3-9930-49f14bdd7af1",
                                "text": "Le pique-bœuf à bec jaune (Buphagus africanus) est fréquent au Mali, au Sénégal, etc.."
                            },
                            {
                                "example_id": "54ac809a-6239-49dd-be6a-0cde0df6c39c",
                                "sense_id": "f969a0bb-b0ec-3cf3-9930-49f14bdd7af1",
                                "text": "Dès qu'il le pouvait, ce faux-jeton lui collait aux basques en lui balançant des « Monsieur Kowalski » par-ci, des « Chef » par là …. Un pique-bœuf sur le dos d'un buffle."
                            },
                            {
                                "example_id": "6fbe252d-8414-43bb-baae-49abaf26f3fa",
                                "sense_id": "f969a0bb-b0ec-3cf3-9930-49f14bdd7af1",
                                "text": "En emmenant leurs populations là où elles brûlaient d’envie d’aller, à savoir au « royaume politique » qu’allait leur ouvrir le départ des colons, les pères des indépendances avaient autant d’emprise sur les masses qu’un « pique-bœuf sur le dos d’un rhinocéros »."
                            }
                        ]
                    }
                ],
                "translations": [
