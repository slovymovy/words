                        "glosses": [
                            "Raisonner à la manière d’Aristote."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2fccd75e-ee2a-3541-9727-0821f45e7967",
                        "entry_id": "0e312806-8fca-37c4-80c3-471ae63f5a0a",
                        "glosses": [
                            "Rendre aristotélicien."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed5260fe-e5c6-4a08-83f6-e8b818b56378",
                                "sense_id": "2fccd75e-ee2a-3541-9727-0821f45e7967",
                                "text": "C'est un projet intellectuel cohérent, même s'il nous déconcerte : aristotéliser le Liber de causis, pour trouver le vrai sens - théologique - du péripatétisme ;"
                            },
                            {
                                "example_id": "9ce169fd-948b-4f61-b04e-cd115e50b46b",
                                "sense_id": "2fccd75e-ee2a-3541-9727-0821f45e7967",
                                "text": "On voit ainsi comment Schiller n'est pas parvenu à \"aristotéliser\" Kant sans temporaliser l'idée de liberté."
                            }
                        ]
                    }
