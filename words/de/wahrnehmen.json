                {
                    "sense_id": "a12ae962-2733-3b28-8d57-35b41806467b",
                    "sense_definition": "etwas mit den Sinnesorganen erfassen, bemerken oder spüren",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er war so in das Buch vertieft, dass er seine Umgebung kaum <w>wahrnahm</w>."
                        },
                        {
                            "text": "Hunde können leise Geräusche über eine weite Entfernung sehr genau <w>wahrnehmen</w>."
                        }
                    ],
                    "synonyms": [
                        "merken",
                        "spüren",
                        "erkennen"
                    ],
                    "common_phrases": [
