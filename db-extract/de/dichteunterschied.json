                        "examples": [
                            {
                                "example_id": "0afa2539-613a-4f85-8865-382f825fc9c9",
                                "sense_id": "6cc7b8a9-562e-341b-bdf9-9189cb0d530e",
                                "text": "„Dabei werden umso mehr Schallwellen reflektiert, je größer der Dichteunterschied zwischen den Geweben ist.“"
                            },
                            {
                                "example_id": "d5b57bbf-a3eb-4ce9-b443-d30c5bc5e1a8",
                                "sense_id": "6cc7b8a9-562e-341b-bdf9-9189cb0d530e",
                                "text": "„Dabei ist zu berücksichtigen, dass das Geschoss in der Regel durch den Dichteunterschied zum Zielmaterial im Zielmaterial seine Flugrichtung ändert.“"
                            },
                            {
                                "example_id": "24855d5b-0232-4a39-aab3-28886e686e0b",
                                "sense_id": "6cc7b8a9-562e-341b-bdf9-9189cb0d530e",
                                "text": "„Der Nachteil von Titandioxid als Tracer-Material ist der große Dichteunterschied zum eingesetzten Speichermaterial.“"
                            }
                        ],
