                        "form": "sie sind fußend"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                        "entry_id": "b6dd493d-6489-30d7-818c-57dbeb6a75e9",
                        "glosses": [
                            "sich auf etwas stützend, auf etwas basierend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2dd34a7-2eab-448b-9a50-f4ec06878a30",
                                "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                                "text": "„Technische Aspekte, die heute mit nur wenig Phantasie vorstellbar sind, und darauf fußende Anwendungen seien nachfolgend erwähnt.“"
                            },
                            {
                                "example_id": "15f5d953-6a17-4c24-966b-4a63f77e926c",
                                "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                                "text": "„Eine auf Werten und Normen fußende Weltordnung durchzusetzen, übersteigt die Fähigkeiten des Westens.“"
                            },
                            {
                                "example_id": "39d9dd13-5e3d-4ba3-b85f-4d3fdcda7ee3",
                                "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                                "text": "„Werden sie eingehalten, gilt der darauf fußende Bot als sicher.“"
                            },
                            {
                                "example_id": "c5eb46be-4fb3-460d-95ee-b13c3da8dd20",
                                "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                                "text": "„Eine rein auf erneuerbare Energien fußende Energieversorgung ist schlichtweg unmöglich, wenn nicht massive Einschnitte in die Leben der Bürger und dem Wohlstand des Landes hingenommen werden sollen.“"
                            },
                            {
                                "example_id": "e16f559d-5725-4256-baf3-75a8dcb3d13c",
                                "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                                "text": "„Die Staatsanwaltschaft Berlin hatte am 7. Juli einen auf dieser Anschuldigung fußenden Strafbefehl beantragt.“"
                            },
                            {
                                "example_id": "3695259d-a23a-49ad-9983-0a898690e7ad",
                                "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                                "text": "„Schließlich wurden die auf unserer Recherche fußenden Ermittlungen wegen Betrugs gegen eine Zahlung in Höhe von 1,2 Millionen Euro eingestellt.“"
                            },
                            {
                                "example_id": "9ef36259-9ec1-4456-b925-3d98de5fc95e",
                                "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                                "text": "„Einige Hersteller anderer auf Chromium fußender Browser haben bereits reagiert.“"
                            },
                            {
                                "example_id": "71baeecb-28fa-4201-91b8-3554e3321cac",
                                "sense_id": "3965c57c-252d-349b-834b-8f9e29546851",
                                "text": "„Ein hierauf fußender Herausgabeanspruch gemäß § 985 BGB weist aber selbst bei weiter Auslegung den für § 273 BGB erforderlichen Zusammenhang mit den Pachtzinsforderungen nicht auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
