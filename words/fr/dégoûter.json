    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cdd2cfe2-d81f-30b8-8cf2-5fcd0eb0d866",
                    "sense_definition": "Provoquer une vive répugnance physique ou morale chez quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "repugnance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'odeur de cette viande avariée suffit à me <w>dégoûter</w> complètement."
                        },
                        {
                            "text": "Ce spectacle violent risque de <w>dégoûter</w> les spectateurs les plus sensibles."
                        }
                    ],
                    "synonyms": [
                        "écœurer",
                        "débecter"
                    ]
                },
                {
                    "sense_id": "0fba1d72-df8c-33af-bca8-5e9e7266cced",
                    "sense_definition": "Faire perdre l'envie, l'intérêt ou la motivation pour une activité ou une personne.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lassitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces échecs successifs ont fini par le <w>dégoûter</w> de son travail."
                        },
                        {
                            "text": "Son attitude autoritaire a réussi à <w>dégoûter</w> ses collègues de ce projet."
                        }
                    ],
                    "common_phrases": [
                        "dégoûter du travail",
                        "dégoûter de la vie"
                    ]
                },
                {
                    "sense_id": "2c8d5ea8-8181-3c72-93d2-ec21c33b6659",
                    "sense_definition": "Couper l'appétit de quelqu'un par un excès de nourriture ou une sensation de trop-plein.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Manger autant de sucreries avant le repas va te <w>dégoûter</w> du dîner."
                        },
                        {
                            "text": "Ce plat beaucoup trop gras a fini par me <w>dégoûter</w> après quelques bouchées."
                        }
                    ]
                },
                {
                    "sense_id": "4844a5cd-5ef3-36e2-a30d-37d0aa847a3c",
                    "sense_definition": "Inspirer de l'aversion durable pour un aliment particulier.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nourriture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mauvaise expérience a suffi pour le <w>dégoûter</w> des huîtres à jamais."
                        },
                        {
                            "text": "Le goût amer de ce remède peut facilement <w>dégoûter</w> un jeune enfant."
                        }
                    ]
                }
            ]
