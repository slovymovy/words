                        "sense_id": "01337a0d-a0f8-37cf-b970-63b9f928bf48",
                        "entry_id": "f809377f-a0e6-3e05-a604-8a7d6c2243c2",
                        "glosses": [
                            "hanger, meestal om de hals gedragen, die drager bovennatuurlijke bescherming biedt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1729a0ec-6cdd-4fd1-ac2c-65065072afef",
                                "sense_id": "01337a0d-a0f8-37cf-b970-63b9f928bf48",
                                "text": "Ze begon hem over De verzamelaar en de waternimf te vertellen, maar toen ze merkte dat ze zich een paar belangrijke details over de plot niet meer kon herinneren, besloot ze het boek, dat ze als een amulet in haar tas had gestopt, aan hem voor te lezen."
                            },
                            {
                                "example_id": "369d6436-5582-4dab-8996-f293ba1f05ac",
                                "sense_id": "01337a0d-a0f8-37cf-b970-63b9f928bf48",
                                "text": "Een paar jaar geleden heeft hij in het park van Trecorn Manor - zo heet dat landgoed in Cornwall - een soort amulet gevonden."
                            }
                        ]
                    }
