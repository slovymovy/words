                ],
                "senses": [
                    {
                        "sense_id": "25b9fb70-4023-33c7-b9a5-b341071880ae",
                        "entry_id": "119bca53-15a4-3214-99e1-dde7fb11638e",
                        "glosses": [
                            "mit Gewalt ausgetragener Konflikt zwischen Banden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1e657d-7f8a-4f37-8d78-e7aba1a0b61b",
                                "sense_id": "25b9fb70-4023-33c7-b9a5-b341071880ae",
                                "text": "Die Polizei beendete den Bandenkrieg."
                            },
                            {
                                "example_id": "94ac3398-36c0-45fd-8e9d-a1e8c8fd3f32",
                                "sense_id": "25b9fb70-4023-33c7-b9a5-b341071880ae",
                                "text": "„Brasilianische Medien berichten, dass in den Bandkriegen von Rio de Janeiro und anderen Drogenhochburgen jährlich Hunderte, womöglich Tausende ums Leben kommen.“"
                            },
                            {
                                "example_id": "bd4e48c7-679c-4ad0-b7d2-62c1eb83062b",
                                "sense_id": "25b9fb70-4023-33c7-b9a5-b341071880ae",
                                "text": "„Das Wort «Terrorist/en» bildete fortan einen festen Topos im öffentlichen Diskurs, und die Differenzierung zwischen ethnisch motivierten Ausschreitungen, sektiererischer Gewalt und kriminellen Bandenkriegen verschwamm zusehends.“"
                            },
                            {
                                "example_id": "2790f9cd-96b3-4121-86e6-1269b6d78101",
                                "sense_id": "25b9fb70-4023-33c7-b9a5-b341071880ae",
                                "text": "„Zur Zeit dieses Bandenkrieges war die Kokusui-kai die drittgrößte kriminelle Gruppe in Saitama, nach der Sumiyoshi-kai und der Inagawa-kai.“"
                            },
                            {
                                "example_id": "2773d6bb-8f69-4ec5-ba9f-ff65082df0e6",
                                "sense_id": "25b9fb70-4023-33c7-b9a5-b341071880ae",
                                "text": "„Der Herbst kam, und der Bandenkrieg tobte weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
