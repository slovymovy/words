        "fr-extract.jsonl": [
            {
                "entry_id": "c9a40200-5b34-3a21-a081-6b930d69830e",
                "word": "invocation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5ebdf2c6-a0b8-447c-91fc-f66330b2bdbd",
                        "entry_id": "c9a40200-5b34-3a21-a081-6b930d69830e",
                        "tags": [
                            "plural"
                        ],
                        "form": "invocations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "18f06d50-c272-3e2e-a674-a768b52969ad",
                        "entry_id": "c9a40200-5b34-3a21-a081-6b930d69830e",
                        "glosses": [
                            "Action d’invoquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07eae678-268d-4d0b-93ef-2d4c7bdc632e",
                                "sense_id": "18f06d50-c272-3e2e-a674-a768b52969ad",
                                "text": "On voit par le statut ici reproduit que les maréchaux, les férons, les serruriers et les taillandiers formaient, à Abbeville, une seule corporation industrielle et une même confrérie religieuse sous l’invocation de saint Eloy; […]."
                            },
                            {
                                "example_id": "c486f127-4851-4a30-8ae2-41930e9185cd",
                                "sense_id": "18f06d50-c272-3e2e-a674-a768b52969ad",
                                "text": "Hervé de Scaër n'employait pas souvent les grands mots et s'il se servait d'une formule d’invocation presque solennelle, c'est que la situation l'y avait poussé."
                            },
                            {
                                "example_id": "4c4d70ec-71f8-4be1-bb98-8aec0f961eab",
                                "sense_id": "18f06d50-c272-3e2e-a674-a768b52969ad",
                                "text": "Le christianisme est tombé dans l’idolâtrie avec la théorie de la Trinité, l’invocation des saints, la mariolâtrie, et surtout la démonophobie."
                            },
                            {
                                "example_id": "f7e431cf-8d98-4316-b796-f4c69b82b365",
                                "sense_id": "18f06d50-c272-3e2e-a674-a768b52969ad",
                                "text": "À tour de rôle, elles s’imposent de répondre à leurs oraisons réciproques. Après quoi elles déroulent une suite interminable de litanies :\n— Vous devez désirer faire une invocation particulière, dit Telcide à Arlette. Faites-la… Nous la ferons avec vous.\nSans qu’un muscle de son visage ne trahisse l’ironie de sa pensée, Arlette répond :\n— Notre-Dame de la Délivrance, priez pour moi…\nLes quatre demoiselles et leur bonne aussitôt de répéter :\n— Notre-Dame de la Délivrance, priez pour elle…"
                            },
                            {
                                "example_id": "3d6b39b2-0bdd-4e03-95e2-5b547b727b92",
                                "sense_id": "18f06d50-c272-3e2e-a674-a768b52969ad",
                                "text": "Certains poètes ont placé en tête de leurs œuvres une invocation à la Muse."
                            }
                        ]
                    },
                    {
                        "sense_id": "41fb2b3a-6d49-3b35-94e1-4c88349da729",
                        "entry_id": "c9a40200-5b34-3a21-a081-6b930d69830e",
                        "glosses": [
                            "Prière que le poète adresse à une muse, à un génie, à une divinité, pour lui demander son secours."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9df75cba-7bb6-312d-b36c-9c17504e1fcb",
                        "entry_id": "c9a40200-5b34-3a21-a081-6b930d69830e",
                        "glosses": [
                            "Action d'invoquer une fonction : appel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "577654f6-4445-4413-8ffb-1b75a36149c0",
                                "sense_id": "9df75cba-7bb6-312d-b36c-9c17504e1fcb",
                                "text": "Comme promis, nous allons étudier maintenant la règle qui autorise l’omission de l’esperluète dans un appel de sous-programme. Si le compilateur rencontre la définition de la fonction avant l’invocation, ou si Perl peut savoir d'après la syntaxe qu'il s'agit d'un appel de fonction, celle-ci peut être appelée sans esperluète, comme une fonction intégrée quelconque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d45898c9-7d44-478a-bffa-2f11541f7d14",
                        "source_entry_id": "c9a40200-5b34-3a21-a081-6b930d69830e",
                        "source_sense_id": "18f06d50-c272-3e2e-a674-a768b52969ad",
                        "source_sense_description": "Action d’invoquer.",
                        "target_lang_word": "Ruf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ruf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3399e4eb-65f7-397e-bfca-3843775a828d",
                                        "entry_id": "308e5e89-990a-34d9-8794-252f60dc56bf",
                                        "glosses": [
                                            "ein Laut, der an jemanden adressiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de727445-15f9-479e-89f3-acb37c35f892",
                                                "sense_id": "3399e4eb-65f7-397e-bfca-3843775a828d",
                                                "text": "Der Ruf „Feuer!“ hallte durch das Haus."
                                            },
                                            {
                                                "example_id": "de28b105-4b56-4125-a955-53d7bddc665a",
                                                "sense_id": "3399e4eb-65f7-397e-bfca-3843775a828d",
                                                "text": "„Die üppigen Ansprüche vieler Konzernchefs heizen den allgemeinen Unmut und die Rufe nach staatlicher Deckelung weiter an.“"
                                            },
                                            {
                                                "example_id": "43ac3858-c429-427b-8745-e02e5b170e69",
                                                "sense_id": "3399e4eb-65f7-397e-bfca-3843775a828d",
                                                "text": "„Die Donau belebte sich jetzt, eine Menge Barkassen und Kaiks manövrierten dort, begleitet von vielstimmigen Rufen, vom Knarren der Taue und Winden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                        "entry_id": "308e5e89-990a-34d9-8794-252f60dc56bf",
                                        "glosses": [
                                            "das Ansehen, das jemand bei anderen hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dc4c67d-d33b-4eca-8631-4f46e1f1fc37",
                                                "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                                "text": "Weil er gerade hier versagte, litt sein Ruf erheblich."
                                            },
                                            {
                                                "example_id": "106423c1-bc6b-45a8-ae40-8e766abd2653",
                                                "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                                "text": "„Die europäische Politik ist besser als ihr Ruf. Viele Bürger ahnen das. Selbst in Großbritannien ist die Zustimmung zur EU zuletzt gewachsen.“"
                                            },
                                            {
                                                "example_id": "133378cb-d8e2-4afc-b241-d477decaded3",
                                                "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                                "text": "„Gerade Romney, derzeit Gouverneur von Massachusetts, hat sich im Olympiabusiness als Krisenmanager einen ausgezeichneten Ruf erworben.“"
                                            },
                                            {
                                                "example_id": "be751a21-503c-4a74-b04f-9eb1a89d2f5f",
                                                "sense_id": "24e3a376-785c-390b-96dd-09e38c574dc8",
                                                "text": "„In Privatgesprächen erwog man die Rückkehr Einsteins nach Zürich, diesmal an die Eidgenössische Technische Hochschule, die einen besseren wissenschaftlichen Ruf genoß als die Universität.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "fde1218b-d9a3-3787-a4aa-3ca3104fd7b5",
                                        "entry_id": "308e5e89-990a-34d9-8794-252f60dc56bf",
                                        "glosses": [
                                            "eine Aufforderung, beispielsweise einen Platz oder eine Position (an einer Universität) einzunehmen oder etwas zu tun"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a967f05-2a5b-4285-8e7f-6db029099f8f",
                                                "sense_id": "fde1218b-d9a3-3787-a4aa-3ca3104fd7b5",
                                                "text": "Er erhielt einen Ruf auf den Lehrstuhl für xy an der Universität Bonn."
                                            },
                                            {
                                                "example_id": "debf1a66-9195-44a6-bc7c-ca0e078ddeb2",
                                                "sense_id": "fde1218b-d9a3-3787-a4aa-3ca3104fd7b5",
                                                "text": "„1911 erhält der Vater einen Ruf auf einen für ihn eingerichteten Lehrstuhl an der Universität Berlin.“"
                                            },
                                            {
                                                "example_id": "0183cfed-8357-460e-97c4-9d8c717ed7ee",
                                                "sense_id": "fde1218b-d9a3-3787-a4aa-3ca3104fd7b5",
                                                "text": "„Am Ende stand der Ruf an die Universität von Erfurt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c118777-f043-4701-a92f-84b5c3a670ce",
                        "source_entry_id": "c9a40200-5b34-3a21-a081-6b930d69830e",
                        "source_sense_id": "18f06d50-c272-3e2e-a674-a768b52969ad",
                        "source_sense_description": "Action d’invoquer.",
                        "target_lang_word": "Gebet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gebet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                        "entry_id": "d1bb51c8-4933-31de-8103-be8fae841650",
                                        "glosses": [
                                            "an einen Gott gerichtete Bitte, Gespräch mit einem Gott"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a115103-0009-43f2-a543-ad8bb95e7896",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "Ich werde euch in mein Gebet mit einschließen."
                                            },
                                            {
                                                "example_id": "7ef4e064-f9ac-4c86-a96b-d45c9a5250e6",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "Der Mensch, der sich vielen Glückes und seiner Schwäche bewußt ist, wird abergläubisch, flüchtet zum Gebete. (Georg Christoph Lichtenberg)"
                                            },
                                            {
                                                "example_id": "aad5a573-a6d5-4cd9-b613-f6ad84d171bc",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "Als sie das Zimmer betrat, war ihr Vater noch ganz im Gebet versunken."
                                            },
                                            {
                                                "example_id": "5817d55e-cf17-4b56-af00-23944a6704e4",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "Ich hoffe, dass eure Gebete erhört werden."
                                            },
                                            {
                                                "example_id": "3fe58803-fa0b-46d0-9228-27e11b232956",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "„Meine Gebete lagen mir tot auf der Zunge.“"
                                            },
                                            {
                                                "example_id": "b2bf0ebb-7130-47b5-93d8-e39cc1725f05",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "„Nach dem Gebet aßen sie schweigend.“"
                                            },
                                            {
                                                "example_id": "ecb49c59-786a-4c94-861e-55159cda0bfd",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "„Beim Gebet für die Krieger dachte sie an ihren Bruder und an Denissow.“"
                                            },
                                            {
                                                "example_id": "2e83118e-7e0c-46a0-82be-4d806203daee",
                                                "sense_id": "5afbf9f2-19b4-3444-ac49-aa13cbcbf766",
                                                "text": "„Es war die Bischöfin, die mit gottesfürchtiger Stimme, gebeugten Hauptes, die Augen geschlossen und die Hände gefaltet, diese Worte in das Gebet einschob.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                        "entry_id": "d1bb51c8-4933-31de-8103-be8fae841650",
                                        "glosses": [
                                            "meist festgelegte Worte, die an eine Gottheit gerichtet sind, um sie zu bitten, ihr zu danken oder sie zu verehren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ff698ea-1208-4315-ba2b-b9c72d46a568",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "Die Gemeinde sprach ein Gebet."
                                            },
                                            {
                                                "example_id": "3064a099-8003-4d5e-9aeb-75c52a536b77",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "Sie kniete vor dem Altar nieder und murmelte ein Gebet."
                                            },
                                            {
                                                "example_id": "82ecbd3e-9280-4126-8959-c6ab67351d25",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "Seine Mutter ermahnte ihn, dass er das Gebet nicht bloß herunterleiern solle."
                                            },
                                            {
                                                "example_id": "86b7764b-513d-4cb8-a325-acca876b0bc6",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "Er übersetzt jüdische Gebete aus dem Hebräischen ins Deutsche."
                                            },
                                            {
                                                "example_id": "185f541c-e005-4401-9830-7ffacc608512",
                                                "sense_id": "02e0382a-3bd9-36ae-ba1a-3f13b84140bb",
                                                "text": "„Er sagte auch nichts, als Sloan das Gebet beendet hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b63ba9e5-ccce-4ef4-94ae-7a583ab4ee68",
                        "source_entry_id": "c9a40200-5b34-3a21-a081-6b930d69830e",
