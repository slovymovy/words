                        "glosses": [
                            "Petite histoire drôle racontée en langue picarde et mettant en scène le personnage éponyme."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "8eb3e372-405d-41e9-a7ac-9fc42a51e718",
                                "sense_id": "c1aab0a0-9b5b-3984-9b99-6895e4e3fe6a",
                                "text": "[…], Cafougnette, en tenue ouvrière de toile bleue, « in loques ed'fosse », parade à l'ombre du beffroi béthunois. Il appartient au folklore régional et devient la vedette de toutes ces histoires pour rire qui circulent, devenues « des cafougnettes » qui sont le fruit de l'imagination populaire et traduisent la bonne humeur des Gens du Nord."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd5577c5-1432-3538-ad27-ebf46ffb7637",
                        "entry_id": "826f165f-2f7f-371d-92ce-1ff35dd55de5",
                        "glosses": [
                            "Petite histoire drôle."
                        ],
                        "tags": [
