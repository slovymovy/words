                        "glosses": [
                            "leichter (See-)Wind, der am Abend weht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb54bfba-3f70-4c0a-9b10-1fbf35717777",
                                "sense_id": "f30613c8-2ba9-3aa8-bf10-c6816466f303",
                                "text": "„Die Abendbrise hatte ein sanftes Muster von halbmeterhohen Wellen in die Mitte des Sees gezeichnet, und der Pilot jenes Bootes schoss quer darüber, ohne sich um die raue Fahrt zu kümmern, die ihm dies bereiten musste.“"
                            },
                            {
                                "example_id": "ffc0b0b1-2285-403f-a37d-ca0b043d96cb",
                                "sense_id": "f30613c8-2ba9-3aa8-bf10-c6816466f303",
                                "text": "„Court richtete den Blick auf die Gräser, die in der Abendbrise wehten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
