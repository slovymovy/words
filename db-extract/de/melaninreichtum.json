                ],
                "senses": [
                    {
                        "sense_id": "ca813397-b64b-3187-a0e6-201699cb7619",
                        "entry_id": "b36c5ad1-b1b1-3a5b-90ae-ba99ba770a27",
                        "glosses": [
                            "Eigenschaft, viel Melanin zu enthalten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa2395de-c32b-4cb9-a35b-25134ab2f33a",
                                "sense_id": "ca813397-b64b-3187-a0e6-201699cb7619",
                                "text": "„Die intermediären Zellen sind reich an Melanin; die funktionelle Bedeutung dieses Melaninreichtums konnte bisher nicht eindeutig geklärt werden.“"
                            },
                            {
                                "example_id": "1add2b4a-cef0-46bb-9b75-72088b2f0a6a",
                                "sense_id": "ca813397-b64b-3187-a0e6-201699cb7619",
                                "text": "„Daß der Kupfergehalt von Mäusemelanomen weitgehend durch den Melaninreichtum dieser Geschwülste bedingt ist, wurde oben bereits erörtert.“"
                            },
                            {
                                "example_id": "6e36ecea-bcd4-4330-81e7-a5f03946c08b",
                                "sense_id": "ca813397-b64b-3187-a0e6-201699cb7619",
                                "text": "„Beim Erwachsenen ist aus dem äußeren Blatt des Augenbechers eine dünne Schicht geworden, die wegen ihres Melaninreichtums als Pigmentepithel bezeichnet wird.“"
                            },
                            {
                                "example_id": "15da026b-4f94-4ca7-8630-fcef198d122b",
                                "sense_id": "ca813397-b64b-3187-a0e6-201699cb7619",
                                "text": "„Wenn bei diesen Krankheitsbildern der Melaninreichtum des Auges eine solche große Rolle spielt, dann ist es doch auffällig, daß die meisten Chloroquinretinopathien bei Weißen beschrieben worden sind […].“"
                            },
                            {
                                "example_id": "a2a2520e-de93-4d47-a5dc-9a4d2bb66a10",
                                "sense_id": "ca813397-b64b-3187-a0e6-201699cb7619",
                                "text": "„Ebenso ist dasjenige der Weibchen durch Melaninreichtum charakterisiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
