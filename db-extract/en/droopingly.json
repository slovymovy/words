                            {
                                "example_id": "1d3c53f9-d2e6-49c3-8413-92c676c507ef",
                                "sense_id": "48c87b92-724f-3050-949c-4448e5ed8079",
                                "text": "The wilted flowers emerged droopingly from their vase."
                            },
                            {
                                "example_id": "4437e97b-2e03-4c15-906a-96ded27ddd12",
                                "sense_id": "48c87b92-724f-3050-949c-4448e5ed8079",
                                "text": "When Hope, the eagle that tower’d, could see\nNo cliff beyond him in the sky,\nHis pinions were bent droopingly —\nAnd homeward turn’d his soften’d eye."
                            }
                        ]
