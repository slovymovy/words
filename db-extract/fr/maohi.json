                "senses": [
                    {
                        "sense_id": "5681481a-1d77-396a-ba8d-c849441e3d51",
                        "entry_id": "aef1c28d-0291-34ad-ad5b-4fa6bcdc2da5",
                        "glosses": [
                            "Relatif aux Polynésiens, aussi appelés Maohis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e3c3b71-c361-4d65-911d-1cbf08782a8a",
                                "sense_id": "5681481a-1d77-396a-ba8d-c849441e3d51",
                                "text": "Mais Oscar Temaru ne désire pas n’importe quelle indépendance. Il veut une « indépendance maohie »."
                            },
                            {
                                "example_id": "bab613b2-d426-497c-9a32-9c536c2a0803",
                                "sense_id": "5681481a-1d77-396a-ba8d-c849441e3d51",
                                "text": "La conception maohi de la territorialité situe la terre émergée dans un processus d’expansion par la multiplication de l’insularité et prolifération à l’infini du nombre d’îles."
                            },
                            {
                                "example_id": "9aadb087-330b-4030-81fa-8e0b608ddd59",
                                "sense_id": "5681481a-1d77-396a-ba8d-c849441e3d51",
                                "text": "Ces indigènes maohis, que l’on devait nommer Paumotus de même que l’archipel au début du XIXᵉ siècle, sont régulièrement décrits comme des sauvages, allant nus ou presque, brandissant des lances de bois hérissées de dents de requin et jetant des cailloux pour repousser les navigateurs."
                            }
                        ]
                    }
