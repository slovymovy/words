            "pos": "verb",
            "senses": [
                {
                    "sense_id": "de4cb8a9-7c72-3811-bc40-88239c685b03",
                    "sense_definition": "iemand voor een korte tijd bezoeken, vaak informeel of zonder afspraak",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bezoek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je mag altijd even <w>langskomen</w> voor een kopje koffie als je in de buurt bent.",
                            "target_lang_translations": {
                                "en": "You can always <w>come over</w> for a cup of coffee if you are in the neighborhood.",
                                "ru": "Ты всегда можешь <w>зайти</w> на чашечку кофе, если будешь поблизости."
                            }
                        },
                        {
                            "text": "Jan <w>kwam</w> gisteren even <w>langs</w> en bracht ons wat aardbeien uit zijn tuin.",
                            "target_lang_translations": {
                                "en": "Jan <w>dropped by</w> yesterday and brought us some strawberries from his garden.",
                                "ru": "Ян вчера <w>заглянул</w> к нам и принес немного клубники из своего сада."
                            }
                        }
                    ],
                    "synonyms": [
                        "langsgaan",
                        "opzoeken",
                        "aanwippen",
                        "bezoeken",
                        "binnenwippen"
                    ],
                    "antonyms": [
                        "vertrekken",
                        "weggaan"
                    ],
                    "common_phrases": [
                        "even langskomen",
                        "op de koffie langskomen",
                        "bij iemand langskomen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt voor informele bezoeken"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To visit someone for a short time, often informally or without an appointment.",
                        "ru": "Навестить кого-либо на короткое время, часто неформально или без предварительной договоренности."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come over",
                                "target_lang_sense_clarification": "to visit someone's home"
                            },
                            {
                                "target_lang_word": "come round",
                                "target_lang_sense_clarification": "to visit someone's house"
                            },
                            {
                                "target_lang_word": "drop by",
                                "target_lang_sense_clarification": "to visit briefly and informally"
                            },
                            {
                                "target_lang_word": "stop by",
                                "target_lang_sense_clarification": "to visit briefly while on the way somewhere"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "зайти",
                                "target_lang_sense_clarification": "ненадолго навестить кого-то"
                            },
                            {
                                "target_lang_word": "заглянуть",
                                "target_lang_sense_clarification": "быстро и неформально навестить"
                            },
                            {
                                "target_lang_word": "заскочить",
                                "target_lang_sense_clarification": "очень короткий, спонтанный визит"
                            },
                            {
                                "target_lang_word": "наведаться",
                                "target_lang_sense_clarification": "прийти с визитом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "50ab6464-7ed0-3522-9ebf-923f9285230e",
                    "sense_definition": "iemand of iets passeren terwijl men zich voortbeweegt",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "beweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sinds ik hier zit zijn er welgeteld drie auto's <w>langsgekomen</w>.",
                            "target_lang_translations": {
                                "en": "Since I've been sitting here, exactly three cars have <w>passed by</w>.",
                                "ru": "С тех пор как я здесь сижу, мимо <w>проехало</w> ровно три машины."
                            }
                        },
                        {
                            "text": "Ik zag de optocht <w>langskomen</w> terwijl ik voor het raam stond te wachten.",
                            "target_lang_translations": {
                                "en": "I saw the parade <w>go past</w> while I was waiting at the window.",
                                "ru": "Я видел, как <w>проходит</w> шествие, пока ждал у окна."
                            }
                        }
                    ],
                    "synonyms": [
                        "voorbijgaan",
                        "passeren",
                        "voorbijkomen"
                    ],
                    "antonyms": [
                        "stoppen",
                        "stilstaan"
                    ],
                    "common_phrases": [
                        "iemand zien langskomen",
                        "snel langskomen"
                    ],
                    "target_lang_definitions": {
