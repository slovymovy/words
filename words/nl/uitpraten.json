    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9cad0e42-8e1a-36b0-902a-f9598f4f96b6",
                    "sense_definition": "zonder onderbreking zeggen wat men wil zeggen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "laten_uitpraten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je me alsjeblieft even laten <w>uitpraten</w>?",
                            "target_lang_translations": {
                                "en": "Could you please let me <w>finish speaking</w>?"
                            }
                        },
                        {
                            "text": "Laat me <w>uitpraten</w> voordat je reageert.",
                            "target_lang_translations": {
                                "en": "Let me <w>finish what I'm saying</w> before you respond."
                            }
                        }
                    ],
                    "common_phrases": [
                        "laten uitpraten",
                        "iemand laten uitpraten"
                    ],
                    "target_lang_definitions": {
                        "en": "to say what one wants to say without interruption"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finish speaking",
                                "target_lang_sense_clarification": "without being interrupted"
                            },
                            {
                                "target_lang_word": "finish what one is saying",
                                "target_lang_sense_clarification": "completing one's thought"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25db894a-a88b-3f7f-a5e6-15aa0442383e",
                    "sense_definition": "een probleem of ruzie door overleg oplossen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ruzie_uitpraten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten dit misverstand samen <w>uitpraten</w>.",
                            "target_lang_translations": {
                                "en": "We need to <w>talk out</w> this misunderstanding together."
                            }
                        },
                        {
                            "text": "Zij hebben hun ruzie <w>uitgepraat</w> en zijn weer vrienden.",
                            "target_lang_translations": {
                                "en": "They <w>talked over</w> their quarrel and are friends again."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijleggen"
                    ],
                    "common_phrases": [
                        "een ruzie uitpraten",
                        "het probleem uitpraten"
                    ],
                    "target_lang_definitions": {
                        "en": "to resolve a problem or quarrel through discussion"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "talk out",
                                "target_lang_sense_clarification": "a conflict or issue"
                            },
                            {
                                "target_lang_word": "talk over",
                                "target_lang_sense_clarification": "to resolve by talking"
                            },
                            {
                                "target_lang_word": "clear the air",
                                "target_lang_sense_clarification": "resolve misunderstandings"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8378cb05-7740-327a-a994-cf8ccefc847a",
                    "sense_definition": "niets meer te zeggen hebben of klaar zijn met spreken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitgepraat_raken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na uren praten waren we nog steeds niet <w>uitgepraat</w>.",
                            "target_lang_translations": {
                                "en": "After hours of talking, we still <w>hadn't said everything</w>."
                            }
                        },
                        {
                            "text": "Hij geraakte niet <w>uitgepraat</w> over zijn nieuwe hobby.",
                            "target_lang_translations": {
                                "en": "He couldn't <w>stop talking</w> about his new hobby."
                            }
                        }
                    ],
                    "common_phrases": [
                        "niet uitgepraat raken"
                    ],
                    "target_lang_definitions": {
                        "en": "to have nothing left to say or to be done talking"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "have said everything",
                                "target_lang_sense_clarification": "run out of things to talk about"
                            },
                            {
                                "target_lang_word": "be done talking",
                                "target_lang_sense_clarification": "finished speaking on a topic"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}