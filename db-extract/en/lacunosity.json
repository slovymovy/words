                        "glosses": [
                            "The quality of being lacunose."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "079e9ca7-fa7b-4581-91c5-6045a3ba873c",
                                "sense_id": "a928cf7d-906f-33f1-b5c3-73a96c1b9584",
                                "text": "The variegated, inconsistent picture it presents is no trick played by its lacunosity, but a function of its diverse origins and uses; thus in a text like Idyll, it is not simply a question for us to unravel syncretistic matter from some essential Adonia."
                            },
                            {
                                "example_id": "97662d72-84b6-4e95-a1a0-3e9d601d9f33",
                                "sense_id": "a928cf7d-906f-33f1-b5c3-73a96c1b9584",
                                "text": "Though I shall develop my argument using archaeological and textual data, I want to stress the lacunosity of the various types of evidence for the construction of real temporal sequences, whether they be historical or archaeological."
                            },
                            {
                                "example_id": "db88255e-975e-415a-b51f-a515975508db",
                                "sense_id": "a928cf7d-906f-33f1-b5c3-73a96c1b9584",
                                "text": "One strength of the approach has been the ease with which the physical conditions of connectedness and lacunosity arise as necessary for correctness."
                            }
                        ]
                    }
