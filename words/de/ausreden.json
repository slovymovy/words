            "pos": "verb",
            "senses": [
                {
                    "sense_id": "760995af-28ed-3dc5-916f-49a050346595",
                    "sense_definition": "einen Satz oder Gedanken zu Ende sprechen, ohne unterbrochen zu werden",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sprechen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Bitte unterbrich mich nicht ständig und lass mich endlich <w>ausreden</w>!"
                        },
                        {
                            "text": "Er wartete geduldig, bis seine Kollegin ganz in Ruhe <w>ausgeredet</w> hatte."
                        }
                    ],
                    "synonyms": [
                        "aussprechen"
                    ],
                    "antonyms": [
                        "unterbrechen"
                    ],
                    "common_phrases": [
                        "jemanden ausreden lassen"
                    ]
                },
                {
                    "sense_id": "b982b72a-3cd0-3489-86f4-756b9013e48e",
                    "sense_definition": "jemanden durch überzeugende Worte davon abbringen, ein bestimmtes Vorhaben umzusetzen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "überzeugen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich habe vergeblich versucht, ihm diese riskante Reise <w>auszureden</w>."
                        },
                        {
                            "text": "Sie wollte sofort kündigen, aber ihre Freunde <w>redeten</w> es ihr <w>aus</w>."
                        }
                    ],
                    "synonyms": [
                        "abraten",
                        "abbringen"
                    ],
                    "antonyms": [
                        "einreden"
                    ],
                    "common_phrases": [
                        "jemandem etwas ausreden"
                    ]
                },
                {
                    "sense_id": "30ed8754-af5f-333a-99da-3a9d94bbfb2e",
                    "sense_definition": "sich mit Ausflüchten rechtfertigen oder sich aus einer unangenehmen Lage herauswinden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "rechtfertigen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>redete</w> sich mit einer angeblichen Verspätung des Zuges geschickt <w>aus</w>."
                        },
                        {
                            "text": "Es hilft dir nicht weiter, dich ständig auf andere Umstände <w>auszureden</w>."
                        }
                    ],
                    "synonyms": [
                        "herausreden"
                    ],
                    "common_phrases": [
                        "sich mit etwas ausreden"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "besonders in Österreich"
                        }
                    ]
                }
            ]
        },
