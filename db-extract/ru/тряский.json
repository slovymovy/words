        "ru-extract.jsonl": [
            {
                "entry_id": "c886c2c0-17bf-355f-ad2c-a600c8b2e69c",
                "word": "тряский",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "8b3d85d6-1e83-35b2-9c7d-c515671d0b6f",
                        "entry_id": "c886c2c0-17bf-355f-ad2c-a600c8b2e69c",
                        "glosses": [
                            "такой, что трясется, легко подвергается тряске"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c228e4c9-8ed0-4ac8-adf2-309523f7b8f2",
                                "sense_id": "8b3d85d6-1e83-35b2-9c7d-c515671d0b6f",
                                "text": "В тряской телеге два путника пыльные скачут."
                            }
                        ]
                    },
                    {
                        "sense_id": "b0561668-fcad-3475-a4e6-e32178fe0b79",
                        "entry_id": "c886c2c0-17bf-355f-ad2c-a600c8b2e69c",
                        "glosses": [
                            "такой, что трясет, причиняет тряску."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f079fe1e-2990-421c-9268-830b637769df",
                                "sense_id": "b0561668-fcad-3475-a4e6-e32178fe0b79",
                                "text": "Тряская дорога, мостовая."
                            },
                            {
                                "example_id": "01ff3ac7-b990-475b-83f2-2d55cb96412c",
                                "sense_id": "b0561668-fcad-3475-a4e6-e32178fe0b79",
                                "text": "Всё кажется мне, будто в тряском беге по мерзлой пашне мчусь я на телеге."
                            }
                        ]
                    },
                    {
                        "sense_id": "065a4e0a-c3e9-3993-9dd5-7a7b03018fc1",
                        "entry_id": "c886c2c0-17bf-355f-ad2c-a600c8b2e69c",
                        "glosses": [
                            "рег. трясущийся, зыбкий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74ff1aaa-35d9-40a9-b63c-815341dedee9",
                                "sense_id": "065a4e0a-c3e9-3993-9dd5-7a7b03018fc1",
                                "text": "Тряская почва."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c916a58f-2a6e-42d2-9591-f770847dde77",
