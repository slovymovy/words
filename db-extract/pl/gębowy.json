                                "example_id": "7ae65830-fe07-4903-8918-840a8192f3ba",
                                "sense_id": "52313fba-a4f5-3693-9f3f-e5836a6028c0",
                                "text": "Częściowo strawiony pokarm powraca z żołądka przeżuwacza do jamy gębowej, by być przeżutym jeszcze raz."
                            }
