                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ich komme <w>sofort</w>, warte bitte einen kleinen Moment auf mich.",
                            "target_lang_translations": {
                                "en": "I'm coming <w>right away</w>, please wait a short moment for me.",
                                "ru": "Я <w>сейчас же</w> приду, подожди меня, пожалуйста, одну минутку.",
                                "nl": "Ik kom er <w>meteen</w> aan, wacht alsjeblieft een kort moment op me.",
                                "pl": "<w>Zaraz</w> przyjdę, poczekaj na mnie małą chwilę.",
                                "fr": "J'arrive <w>tout de suite</w>, attends-moi un court instant s'il te plaît.",
                                "it": "Arrivo <w>subito</w>, per favore aspettami un attimo.",
