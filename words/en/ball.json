                    "frequency": "High",
                    "semantic_group_id": "spherical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She rolled the dough into a small <w>ball</w> before putting it in the oven.",
                            "target_lang_translations": {
                                "ru": "Она скатала тесто в небольшой <w>шарик</w>, прежде чем положить его в духовку."
                            }
