                ],
                "senses": [
                    {
                        "sense_id": "7d086edc-4762-3fdd-952c-6dc22ce65a67",
                        "entry_id": "3811df66-bc5b-3577-9a82-e8bc75a5196c",
                        "glosses": [
                            "das Züchten von jungen Schweinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3cafea7-0249-4d13-97a7-0b6c6b33caf5",
                                "sense_id": "7d086edc-4762-3fdd-952c-6dc22ce65a67",
                                "text": "„Er nutzt es aber nicht als reines Weideland, sondern hat dort wegen der abgelegenen Lage einen Schweinestall gebaut und betreibt eine kleine Ferkelzucht, wo die Schweine teilweise im Freien herumlaufen können.“"
                            },
                            {
                                "example_id": "f0cdeff1-2596-4703-b544-f11313239aaf",
                                "sense_id": "7d086edc-4762-3fdd-952c-6dc22ce65a67",
                                "text": "„Ihr wisst, die Pferdezucht und die Ferkelzucht bringen viel Arbeit mit sich, da wäre eine Arbeitseinteilung beim gemeinsamen Mahl doch nur von Vorteil.“"
                            },
                            {
                                "example_id": "eb114fd8-2221-43b9-90f2-775192b80dbb",
                                "sense_id": "7d086edc-4762-3fdd-952c-6dc22ce65a67",
                                "text": "„Die Ferkelzucht ist zeitintensiv (beim Hausschwein beträgt allein die Tragzeit etwa vier Monate).“"
                            },
                            {
                                "example_id": "b95ae0af-6d6e-493e-b7d2-e0f65dd956eb",
                                "sense_id": "7d086edc-4762-3fdd-952c-6dc22ce65a67",
                                "text": "„Infolge der nach wie vor bestehenden Mängel und der damit verbundenen schlechten Aufzuchtergebnisse haben jedoch viele Betriebe die Zucht, insbesondere die Ferkelzucht aufgegeben.“"
                            },
                            {
                                "example_id": "1f039842-f172-4f6d-ae63-0c5c5d552b1b",
                                "sense_id": "7d086edc-4762-3fdd-952c-6dc22ce65a67",
                                "text": "„Dagegen hat die Ferkelzucht keine lohnenden Erträge abgeworfen, weil sie sowohl, wie auch Faselschweine, während des Sommers 1874 erheblich im Preise sanken.“"
                            },
                            {
                                "example_id": "4784cd28-9a3a-4bc5-a518-31e4e8c8e143",
                                "sense_id": "7d086edc-4762-3fdd-952c-6dc22ce65a67",
                                "text": "„In größeren Ferkelzuchten hat man auch eigene Futterpläße für die Ferkel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
