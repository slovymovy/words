                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61e7ab14-28da-4693-af79-4d8078088ce3",
                                                "sense_id": "83a71d89-056d-3aaa-b775-327058116c04",
                                                "text": "\"...ma è uno scherzo del destino!?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62b2e178-d8f9-3007-83ea-a561addd2034",
                                        "entry_id": "bcbd51a7-d1d3-3444-8866-c831ea1db832",
                                        "glosses": [
