                                                "sense_id": "de34c9aa-eabf-303f-83b7-2f550c3abaf0",
                                                "text": "Call your mother now and then and let her know you care."
                                            },
                                            {
                                                "example_id": "c7c0ae12-cb2f-44b5-bb27-6f2e86db6e0a",
                                                "sense_id": "de34c9aa-eabf-303f-83b7-2f550c3abaf0",
                                                "text": "Turn around, bright eyes / Every now and then, I fall apart"
                                            },
                                            {
                                                "example_id": "27872817-5f0b-4a4f-9ab0-4ea451b68fa9",
                                                "sense_id": "de34c9aa-eabf-303f-83b7-2f550c3abaf0",
                                                "text": "I'm a writer first, but I do have my HGV licence, and I use it every now and then."
                                            }
                                        ]
