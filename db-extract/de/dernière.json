                ],
                "senses": [
                    {
                        "sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                        "entry_id": "a30efb2b-41b0-3f85-9fa0-4285a9837caf",
                        "glosses": [
                            "die letzte Aufführung, Vorstellung einer Inszenierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbf7808a-bf1d-4a18-a310-16779af05d18",
                                "sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                                "text": "„Da heute die Dernière ist, ist es unsere letzte Möglichkeit die Inszenierung zu sehen.“"
                            },
                            {
                                "example_id": "6e55b5ab-c36d-4f7c-8fc9-0d4b43376fed",
                                "sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                                "text": "„Die erste Vorstellung einer Inszenierung wird Premiere genannt, die letzte Dernière.“"
                            },
                            {
                                "example_id": "23cc5115-48a3-475c-8475-e9633c40b338",
                                "sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                                "text": "„Sie betreibt den ältesten Frisiersalon in Oberammergau und legte nach der Dernière, der Schlussvorstellung, für Jesus und seine Jünger Sonderschichten ein.“"
                            },
                            {
                                "example_id": "a9203c73-ae17-4a78-8f87-504b849f0c46",
                                "sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                                "text": "„›Ich weiß, Mama, das war nach der Dernière des Rosenkavaliers zweiundsiebzig bei den Salzburger Festspielen.‹“"
                            },
                            {
                                "example_id": "ace64032-fc23-4c3b-9513-f36720f4ff3b",
                                "sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                                "text": "„Nein, in meinem Fall ist die Premiere auch die Dernière.“"
                            },
                            {
                                "example_id": "6a4ac334-ba7d-4dc7-a567-0ff373efeb5d",
                                "sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                                "text": "„Wir spielten die Premiere dieses Musikstücks, sehr wahrscheinlich auch die Dernière.“"
                            },
                            {
                                "example_id": "d25f36e3-f5d5-462c-ae64-b666e025853d",
                                "sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                                "text": "„Zum 26. März 2006 allerdings wurde die Dernière angekündigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2bcc6836-fc0f-4a91-900e-733c085e19d2",
                        "source_entry_id": "a30efb2b-41b0-3f85-9fa0-4285a9837caf",
                        "source_sense_id": "b4b036da-92a5-3976-9162-77501385b0d5",
                        "source_sense_description": "die letzte Aufführung, Vorstellung einer Inszenierung",
                        "target_lang_word": "dernière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dernière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56fbd266-6158-31af-90b1-e66490e9fe37",
                                        "entry_id": "559eff51-f0f2-3960-998d-cc3c49d0a2df",
                                        "glosses": [
                                            "Femme qui arrive après tous les autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91096f42-eb9d-4178-8174-d26430af719a",
                                                "sense_id": "56fbd266-6158-31af-90b1-e66490e9fe37",
                                                "text": "C’est la dernière."
                                            },
                                            {
                                                "example_id": "1e055d4e-ac39-46d5-8802-2c14d53acd3e",
                                                "sense_id": "56fbd266-6158-31af-90b1-e66490e9fe37",
                                                "text": "Elle fut honteuse à cause de son passé, le revit d’un seul coup avec éblouissement et pensa : Je suis la dernière des dernières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "772eca55-acce-34bf-8053-b0afd613a8da",
                                        "entry_id": "559eff51-f0f2-3960-998d-cc3c49d0a2df",
                                        "glosses": [
                                            "(Précédé de cette) Celle dont on a parlé juste avant, par opposition au sujet ou le premier des deux du même type dans la phrase précédente."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e89bd98-dc30-4f86-92dd-ecc582b976a3",
                                                "sense_id": "772eca55-acce-34bf-8053-b0afd613a8da",
                                                "text": "Lorsque la quantité de soie voulue a passé sur la machine, l’ouvrière arrête cette dernière, […]."
                                            },
                                            {
                                                "example_id": "d84de864-4987-4a99-b95a-973da3b1493c",
                                                "sense_id": "772eca55-acce-34bf-8053-b0afd613a8da",
                                                "text": "Trois croix voisinaient avec celle qui marquait la tombe d’un matelot autrichien. Un ours blanc avait essayé de violer cette dernière que nous avons réparée […]."
                                            },
                                            {
                                                "example_id": "e496ec44-da99-4f06-b72f-b9fc5584beae",
                                                "sense_id": "772eca55-acce-34bf-8053-b0afd613a8da",
                                                "text": "Il ne rendait visite qu’à sa mère et encore, cette dernière, entourée de vieilles personnes ridicules et sujette elle-même à des radotages, lui agaçait les nerfs […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dernière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d9c4db1-89c5-3d98-b3de-17ab5a2df4d5",
                                        "entry_id": "560cfef8-ca51-39c1-baca-8046d656e226",
                                        "glosses": [
                                            "Féminin singulier de dernier."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1baf4550-0bf1-47d7-8cbf-c6762c7ec46c",
                                                "sense_id": "1d9c4db1-89c5-3d98-b3de-17ab5a2df4d5",
                                                "text": "Une dernière inscription se voit gravée sur une tombe enrichie de quelques sculptures d’un travail estimable."
                                            },
                                            {
                                                "example_id": "16a46b39-c891-47cc-b885-2044f4fac521",
                                                "sense_id": "1d9c4db1-89c5-3d98-b3de-17ab5a2df4d5",
                                                "text": "C’est de l’avion de ravitaillement : en plus des largages habituels, il \"dropera\" aussi l’équipe de sauveteurs français annoncés la semaine dernière…"
                                            },
                                            {
                                                "example_id": "beae48dd-c95e-4382-925d-33677b9cd832",
                                                "sense_id": "1d9c4db1-89c5-3d98-b3de-17ab5a2df4d5",
                                                "text": "La dernière venue, une blonde en domino blanc, ne lui avait rien dit encore, mais elle n’avait pas quitté la place, pendant qu’il se demandait, en examinant le troubadour mélancolique : […] ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7589e777-9ad3-497b-afc9-76d3d4f431ea",
                        "source_entry_id": "a30efb2b-41b0-3f85-9fa0-4285a9837caf",
