                        "entry_id": "68ab1339-265f-3b75-95f8-bd4d62119b51",
                        "glosses": [
                            "sprinkles of aniseed covered with sugar"
                        ],
                        "tags": [
                            "in-plural",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "cfe50d1c-23b5-4a8e-b121-70d903d30fe7",
                                "sense_id": "e419e167-679a-3383-9b05-5af7450be471",
                                "text": "Wil je een boterham met muisjes?",
                                "translation": "Do you want a slice of bread sprinkled with aniseed covered with sugar?",
                                "english": "Do you want a slice of bread sprinkled with aniseed covered with sugar?"
                            },
                            {
                                "example_id": "e7d3de81-f2b1-426d-88be-f794f723ba3d",
                                "sense_id": "e419e167-679a-3383-9b05-5af7450be471",
                                "text": "Jan trakteert op beschuit met muisjes, zowel roze als blauwe! Dus hij heeft een tweeling gekregen, een jongen en een meisje.",
                                "translation": "Jan treats us to zwieback with muisjes, pink as well as blue ones! So he has got twins, a boy and a girl.",
                                "english": "Jan treats us to zwieback with muisjes, pink as well as blue ones! So he has got twins, a boy and a girl."
                            },
                            {
                                "example_id": "21dd89f4-793a-46a0-831c-0f05ee107ec2",
                                "sense_id": "e419e167-679a-3383-9b05-5af7450be471",
                                "text": "Ik hou meer van gestampte muisjes dan van gewone muisjes.",
                                "translation": "I prefer anise-flavoured sugar powder [literally ground little mice] to aniseed covered in sugar [normal little mice].",
                                "english": "I prefer anise-flavoured sugar powder [literally ground little mice] to aniseed covered in sugar [normal little mice]."
                            }
                        ]
                    }
