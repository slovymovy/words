                ],
                "senses": [
                    {
                        "sense_id": "f979de72-d016-3f07-8ad5-0f589b4df1e6",
                        "entry_id": "a496346b-a9e6-32d5-b59c-b34cce3e91c5",
                        "glosses": [
                            "grupa wiernych w pochodzie, często ze śpiewem eksponująca przedmioty kultu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8985a67f-c10a-4cf2-9fe9-86c4b162f980",
                                "sense_id": "f979de72-d016-3f07-8ad5-0f589b4df1e6",
                                "text": "Procesja zatoczyła koło wokół rynku i skierowała się w stronę kościoła."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "4e1767cf-4d17-3824-b95e-4cb763415fa1",
                        "entry_id": "a496346b-a9e6-32d5-b59c-b34cce3e91c5",
                        "glosses": [
                            "tłum lub kawalkada pojazdów wolno przemieszczająca się w jednym kierunku"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24b3dd46-eef4-4662-a86f-551adae63fc4",
                        "source_entry_id": "a496346b-a9e6-32d5-b59c-b34cce3e91c5",
                        "source_sense_id": "f979de72-d016-3f07-8ad5-0f589b4df1e6",
                        "target_lang_word": "procession",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "procession",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29301c65-d814-38e1-8942-63602f8faf64",
                                        "entry_id": "6c9dcd74-cd20-33aa-99c6-a38f46c9bc00",
                                        "glosses": [
                                            "The act of progressing or proceeding."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "130b1b90-9af6-41fa-a972-94a740f97955",
                                                "sense_id": "29301c65-d814-38e1-8942-63602f8faf64",
                                                "text": "From whence it came to pass in the primitive times , that the Latin fathers taught expressly the procession of the Spirit from the Father and the Son"
                                            },
                                            {
                                                "example_id": "f085d6fe-8d4c-4e0b-9e2e-3577e5a92528",
                                                "sense_id": "29301c65-d814-38e1-8942-63602f8faf64",
                                                "text": "Yet proof is here of men's unquenched desire / That the procession of their life might be / More equable majestic pure and free; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "706890e4-b1d9-3de1-b263-a75cc884cc0e",
                                        "entry_id": "6c9dcd74-cd20-33aa-99c6-a38f46c9bc00",
                                        "glosses": [
                                            "A group of people or things moving along in an orderly, stately, or solemn manner; a train of persons advancing in order; a retinue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53611ac1-d37b-4427-a245-c68ac0a7c1d3",
                                                "sense_id": "706890e4-b1d9-3de1-b263-a75cc884cc0e",
                                                "text": "a procession of mourners"
                                            },
                                            {
                                                "example_id": "42ba5afd-7d24-465b-8514-7fd5c44f9d8c",
                                                "sense_id": "706890e4-b1d9-3de1-b263-a75cc884cc0e",
                                                "text": "the Lord Mayor's procession"
                                            },
                                            {
                                                "example_id": "6d3f1cbd-11a8-4163-8104-862842a25f01",
                                                "sense_id": "706890e4-b1d9-3de1-b263-a75cc884cc0e",
                                                "text": "Here comes the towneſ-men, on Proceſſion, / To preſent your Highneſſe with the man."
                                            },
                                            {
                                                "example_id": "26c1523e-49d2-4bee-bfe3-d044afe63386",
                                                "sense_id": "706890e4-b1d9-3de1-b263-a75cc884cc0e",
                                                "text": "By reason of these things, then, the whaling voyage was welcome; the great flood-gates of the wonder-world swung open, and in the wild conceits that swayed me to my purpose, two and two there floated into my inmost soul, endless processions of the whale, and, mid most of them all, one grand hooded phantom, like a snow hill in the air."
                                            },
                                            {
                                                "example_id": "951e1228-873c-4000-8dd3-60eb4e2367c5",
                                                "sense_id": "706890e4-b1d9-3de1-b263-a75cc884cc0e",
                                                "text": "The final fifty miles of the race was a procession with little change in the relative positions of the cars […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f1d0b56-4fa3-33da-b895-341d99cdeca8",
                                        "entry_id": "6c9dcd74-cd20-33aa-99c6-a38f46c9bc00",
                                        "glosses": [
                                            "A number of things happening in sequence (in space or in time)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a006a518-773c-31a2-b5d2-502d5d6f2705",
                                        "entry_id": "6c9dcd74-cd20-33aa-99c6-a38f46c9bc00",
                                        "glosses": [
                                            "Litanies said in procession and not kneeling."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2108ef5b-a46f-42ef-8646-d6f406a1f0c5",
                                                "sense_id": "a006a518-773c-31a2-b5d2-502d5d6f2705",
                                                "text": "In many a form I see thee oft\nIn myriad manners are thy praises told\nIn old processions carved on Grecian urns"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3f6ecdd-6ba4-35b7-9dc4-08acd1b26d50",
                                        "entry_id": "6c9dcd74-cd20-33aa-99c6-a38f46c9bc00",
                                        "glosses": [
                                            "The rapid dismissal of a series of batsmen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32b78dda-5928-4a12-b389-c7f605c0b761",
                                                "sense_id": "a3f6ecdd-6ba4-35b7-9dc4-08acd1b26d50",
                                                "text": "Before he closed and opened his eyes, the bails on the wicket behind Johnny Masih were shattered. That was the beginning of a procession. The second ball clean bowled the batsman. The third ball was a catch for the wicketkeeper."
                                            },
                                            {
                                                "example_id": "ddbfda29-d1cf-452c-bf8b-409ccb4be84b",
                                                "sense_id": "a3f6ecdd-6ba4-35b7-9dc4-08acd1b26d50",
                                                "text": "Scotland moved nicely to 45 without loss before I took the first wicket and then it became a procession."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "procession",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "573257f0-0ba2-3f06-b236-d1e3422aaac8",
                                        "entry_id": "4dda571e-a4a1-3f35-b0b1-33d72ea00651",
                                        "glosses": [
                                            "To take part in a procession."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26e5925e-0de0-3ef8-b0e6-249376c3f294",
                                        "entry_id": "4dda571e-a4a1-3f35-b0b1-33d72ea00651",
                                        "glosses": [
                                            "To honour with a procession."
                                        ],
                                        "tags": [
                                            "dated",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "76f7f334-271f-3dc4-9eb6-5506925a3b9e",
                                        "entry_id": "4dda571e-a4a1-3f35-b0b1-33d72ea00651",
                                        "glosses": [
                                            "To ascertain, mark, and establish the boundary lines of (lands)."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d518edbe-1383-4b46-9852-c42e23c41954",
                                                "sense_id": "76f7f334-271f-3dc4-9eb6-5506925a3b9e",
                                                "text": "To procession the lands of such persons as desire it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d23a1a7b-f67e-4e5b-b9e9-ad5514ff59aa",
                        "source_entry_id": "a496346b-a9e6-32d5-b59c-b34cce3e91c5",
                        "source_sense_id": "f979de72-d016-3f07-8ad5-0f589b4df1e6",
