                "translations": [
                    {
                        "translation_id": "d2db9776-9215-4f70-9ea7-830af06040fa",
                        "source_entry_id": "18348af4-02a1-38c9-8dce-47e1d90b6d91",
                        "source_sense_description": "psychische stoornis, ontstaan door een schokkende ervaring",
                        "target_lang_word": "Trauma",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trauma",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8363600c-de3d-3c73-81b1-58be73357ff7",
                                        "entry_id": "cd4376a2-b34e-3d7b-9ead-4f996bf4840c",
                                        "glosses": [
                                            "starke seelische Erschütterung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc2b8e78-3476-4a08-9530-a8f76c907a4b",
                                                "sense_id": "8363600c-de3d-3c73-81b1-58be73357ff7",
                                                "text": "„Das Trauma kann psychisch auch deshalb nicht verarbeitet werden, weil die dabei erlebten Gefühle und Sinneseindrücke auf einer ‚primitiven‘ Ebene, nämlich in der Mandelkernregion (Amygdala) des Gehirns abgespeichert werden.“"
                                            },
                                            {
                                                "example_id": "ea6f7719-6114-48a5-9f55-51526b108f24",
                                                "sense_id": "8363600c-de3d-3c73-81b1-58be73357ff7",
                                                "text": "„In der ersten Phase war das Fernsehen vor allem dazu da, das Trauma des Zweiten Weltkrieges aufzuarbeiten.“"
                                            },
                                            {
                                                "example_id": "37810db2-deed-4fb1-b4d5-ef639e0ba7f5",
                                                "sense_id": "8363600c-de3d-3c73-81b1-58be73357ff7",
                                                "text": "„Grundsätzlich gilt: Halten nach einem Trauma die Beschwerden an, wird von einer posttraumatischen Belastungsstörung (PTBS) gesprochen.“"
                                            },
                                            {
                                                "example_id": "2c1a404a-a67b-42e4-91bf-986a2f50e0f7",
                                                "sense_id": "8363600c-de3d-3c73-81b1-58be73357ff7",
                                                "text": "„Während der Projektarbeit gab es unzählige kurze, aber auch schwerwiegende Situationen, die die Traumata auf unterschiedliche Art offenbaren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6b173ed2-4b09-3795-90f5-d5d75a81a2cd",
                                        "entry_id": "cd4376a2-b34e-3d7b-9ead-4f996bf4840c",
                                        "glosses": [
                                            "körperliche Verletzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e372951b-873b-4466-97b8-a2776e10421f",
                                                "sense_id": "6b173ed2-4b09-3795-90f5-d5d75a81a2cd",
                                                "text": "„Die Rö-Aufnahme des Schädels nach Trauma ist selten hilfreich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "644cf279-7513-4d4b-835c-7593bc023327",
                        "source_entry_id": "18348af4-02a1-38c9-8dce-47e1d90b6d91",
                        "source_sense_description": "psychische stoornis, ontstaan door een schokkende ervaring",
                        "target_lang_word": "trauma",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trauma",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d0e824b-8319-3084-a5c5-c3905a531f8e",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "Any serious injury to the body, often resulting from violence or an accident."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bff17aa2-d0b8-4c3e-a291-ef58d0390d8c",
                                                "sense_id": "9d0e824b-8319-3084-a5c5-c3905a531f8e",
                                                "text": "Repeated trauma or shaking to the brain can be even worse, leading to chronic traumatic encephalopathy, or CTE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "An emotional wound leading to psychological injury."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a38e053-0fdc-47c8-9406-0d81113336dd",
                                                "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                                "text": "Jailing her on Wednesday, magistrate Liz Clyne told Robins: \"You have shown little remorse either for the death of the kitten or the trauma to your former friend Sarah Knutton.\" She was also banned from keeping animals for 10 years."
                                            },
                                            {
                                                "example_id": "a7ae946b-cb5a-49ee-ac41-6c1d3cc13e37",
                                                "sense_id": "e9b60dd1-97e0-3ca5-a88a-26895db00c30",
                                                "text": "And although it doesn’t mean acting like an infant again, it does require recognizing that many of the thoughts and behaviors you’d like to change come from lingering feelings of childhood traumas or your inner child, said Dr. Avigail Lev, a licensed clinical psychologist at the Bay Area CBT Center in San Francisco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430edc1e-4d14-321f-a4a3-aed0542f87b6",
                                        "entry_id": "caaf7b68-7384-38b6-b163-fcea65f0316a",
                                        "glosses": [
                                            "An event that causes great distress."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51f09284-d275-4368-9840-8f255ea66ed4",
                        "source_entry_id": "18348af4-02a1-38c9-8dce-47e1d90b6d91",
                        "source_sense_description": "psychische stoornis, ontstaan door een schokkende ervaring",
                        "target_lang_word": "trauma",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trauma",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e2036a2-7711-38b5-96f5-47e2b4f9830d",
                                        "entry_id": "16e05763-f8e1-37de-9896-575b60a6b6d7",
                                        "glosses": [
                                            "Lésion causée par une action extérieure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "419c7f20-c89e-36a9-a7bd-11df7c0c9a53",
                                        "entry_id": "16e05763-f8e1-37de-9896-575b60a6b6d7",
                                        "glosses": [
                                            "Dommage causé à la psyché après un événement psychologiquement violent ; psychotrauma ou psychotraumatisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d4c17b3-0066-463e-96b7-78220df55ff1",
                                                "sense_id": "419c7f20-c89e-36a9-a7bd-11df7c0c9a53",
                                                "text": "Si celles-ci ne font pas l’objet de la plus grande attention, les conséquences de leur trauma risquent d’entraîner ce que les psychiatres ont appelé le « syndrome du survivant »."
                                            },
                                            {
                                                "example_id": "60a690c8-1f89-4fd7-afc1-9b7320b32fd8",
                                                "sense_id": "419c7f20-c89e-36a9-a7bd-11df7c0c9a53",
                                                "text": "Les syndromes chroniques et complexes que l’on voit plus communément après un trauma multiple, de longue durée ou complexe, dans des groupes tels que les réfugiés survivants de torture, les victimes d’inceste ou les vétérans de combats, requièrent des traitements globaux (Silove, 1992)."
                                            },
                                            {
                                                "example_id": "812b0690-9865-4e25-a96f-50e195433171",
                                                "sense_id": "419c7f20-c89e-36a9-a7bd-11df7c0c9a53",
                                                "text": "Les théoriciens du trauma reprochent à ceux du conflit d’ignorer la réalité extérieure et en particulier violence et destructivité dans les relations humaines et leur importance dans la genèse des maladies psychiques, et de déplacer toute faute sur l’individu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "trauma",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8603e9d8-70e3-3047-8d5b-04be7a4aa1e6",
                                        "entry_id": "4f8549cf-6509-32b0-953b-ff2420e5be2d",
                                        "glosses": [
