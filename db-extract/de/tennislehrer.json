                "senses": [
                    {
                        "sense_id": "a982e5bd-d85a-3c30-932e-d99bfba21b0d",
                        "entry_id": "510f7f10-2a29-38c0-a47b-cff36cf740df",
                        "glosses": [
                            "Moniteur de tennis, professeur de tennis, celui qui enseigne la pratique du tennis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6e43ee3-8004-48a5-a8e7-ec7316cc7e5d",
                                "sense_id": "a982e5bd-d85a-3c30-932e-d99bfba21b0d",
                                "text": "Der Campingplatz verfügt über einen Tennisplatz, der Tennislehrer kostet jedoch extra.",
                                "translation": "Le camping dispose d'un court de tennis, mais le professeur de tennis est en supplément."
                            },
                            {
                                "example_id": "3e3c6d89-a01a-4dde-ab12-7136f39bfaf4",
                                "sense_id": "a982e5bd-d85a-3c30-932e-d99bfba21b0d",
                                "text": "Ich glaube nicht, dass Sie Ihr Spiel verbessern können. Ich glaube nicht an Wunder, ich bin nicht Gott, ich bin Tennislehrer.",
                                "translation": "Je ne crois pas que vous puissiez améliorer votre jeu. Je ne crois pas aux miracles, je ne suis pas Dieu, je suis moniteur de tennis."
                            }
                        ]
                    }
                ],
