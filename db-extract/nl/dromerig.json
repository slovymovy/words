                "senses": [
                    {
                        "sense_id": "a7d8871c-7552-3386-9a51-00850ca74da1",
                        "entry_id": "3684fe5d-3c59-3602-8827-317a4cf5c20f",
                        "glosses": [
                            "geneigd tot dagdromen en mijmeren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f27780d8-be0b-4007-8f92-494e0455d5d8",
                                "sense_id": "a7d8871c-7552-3386-9a51-00850ca74da1",
                                "text": "Keest Bakels (uit Kees de jongen) en Woutertje Pieterse zijn typische voorbeeld van dromerige jongens."
                            },
                            {
                                "example_id": "8cd47dd8-6b66-48a3-a4c9-bec1386acb74",
                                "sense_id": "a7d8871c-7552-3386-9a51-00850ca74da1",
                                "text": "Tijdens zijn volgende verlof was Cécile er dromerig en betoverd met het puntje van haar wijsvinger overheen gegaan, wat Alberts stemming er niet beter op had gemaakt."
                            }
                        ]
                    }
