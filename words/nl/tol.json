                            "target_lang_translations": {
                                "en": "Mr. <w>Tol</w> has lived in this street for years.",
                                "ru": "Господин <w>Тол</w> живет на этой улице уже много лет."
                            }
                        },
                        {
                            "text": "Ik heb gisteren met de familie <w>Tol</w> gesproken.",
                            "target_lang_translations": {
                                "en": "I spoke with the <w>Tol</w> family yesterday.",
                                "ru": "Вчера я разговаривал с семьей <w>Тол</w>."
                            }
                        }
                    ],
                    "traits": [
