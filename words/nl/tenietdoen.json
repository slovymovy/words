                    "semantic_group_id": "ongedaan_maken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geboekte economische vooruitgang werd <w>tenietgedaan</w> door het ineenstorten van de aandelenmarkt.",
                            "target_lang_translations": {
                                "en": "The economic progress made was <w>undone</w> by the collapse of the stock market."
                            }
                        },
                        {
                            "text": "Al zijn harde werk van de afgelopen maanden werd in één klap <w>tenietgedaan</w>.",
                            "target_lang_translations": {
                                "en": "All his hard work of the past months was <w>wiped out</w> in one fell swoop."
                            }
                        }
                    ],
