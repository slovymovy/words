                ],
                "senses": [
                    {
                        "sense_id": "61af2b76-895c-31fb-829a-efa9e2023e14",
                        "entry_id": "30ced06f-d07a-3d4b-9813-da911f91c742",
                        "glosses": [
                            "Faire se tourner sur soi-même, se regarder le nombril."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a4c2e3-62b7-4ac7-b781-dd286e178b1e",
                                "sense_id": "61af2b76-895c-31fb-829a-efa9e2023e14",
                                "text": "Mobiliser le salariat signifie ici nombriliser les salariés, les isoler, les réduire au statut d'individus maximisateurs qui assimilent sans retenue les leçons du management."
                            },
                            {
                                "example_id": "a9510830-52ea-4de4-81d4-bc0ea6e240ab",
                                "sense_id": "61af2b76-895c-31fb-829a-efa9e2023e14",
                                "text": "Arrêter de se nombriliser pour se mettre à l'écoute et faire un travail de proximité libérateur et salvateur pour la condition féminine."
                            },
                            {
                                "example_id": "06db46e8-2946-4af7-b707-295f980b9211",
                                "sense_id": "61af2b76-895c-31fb-829a-efa9e2023e14",
                                "text": "Le fait qu'ils soient tournés vers l'Autre, vers leurs patients, les empêchent dans la plupart des cas de trop se « nombriliser » et les forcent à se dépasser et à éviter leur propre effondrement."
                            }
                        ]
                    }
                ],
