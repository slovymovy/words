                    }
                ],
                "senses": [
                    {
                        "sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                        "entry_id": "8815de8e-db5f-3fec-9de4-ef26ce86fe41",
                        "glosses": [
                            "состояние, когда клонит ко сну; сонное состояние; полусон"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dac71e3-4893-4a47-b9dc-0c5581fa18e7",
                                "sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                                "text": "После бессонной ночи и после лихой выпивки, их одолевала ещё сладкая утренняя дремота."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07940c3d-be9b-4509-938e-76cefd7986b1",
                        "source_entry_id": "8815de8e-db5f-3fec-9de4-ef26ce86fe41",
                        "source_sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                        "target_lang_word": "drowsiness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "drowsiness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ee0c17c-0755-3c16-8f79-ec04d380ba9f",
                                        "entry_id": "ce784192-b80b-38f0-be3f-2320b92cd441",
                                        "glosses": [
                                            "The state of being drowsy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "72e52b57-8a38-47c2-9d43-74e503e14351",
                                                "sense_id": "2ee0c17c-0755-3c16-8f79-ec04d380ba9f",
                                                "text": "And most neurologists are in the habit of prescribing antispasticity drugs like tizanidine and baclofen, which are oral and inexpensive, but which cause drowsiness and weaken every muscle in the body, not just the target ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6eac466e-4c46-4610-97ec-1e3aae205fb1",
                        "source_entry_id": "8815de8e-db5f-3fec-9de4-ef26ce86fe41",
                        "source_sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                        "target_lang_word": "somnolence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somnolence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bad8274-3116-3521-9dc0-985d963a12f4",
                                        "entry_id": "76232335-6e26-31b1-ab94-a4251a959631",
                                        "glosses": [
                                            "A state of drowsiness or sleepiness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "94666253-6554-44bf-818a-fd4e9b63a187",
                        "source_entry_id": "8815de8e-db5f-3fec-9de4-ef26ce86fe41",
                        "source_sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                        "target_lang_word": "Schlummer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlummer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8cc7fb45-1e53-3744-9bd4-763525039bd7",
                                        "entry_id": "e9cab39c-db18-38db-8b6c-ce494129e1b4",
                                        "glosses": [
                                            "leichter Schlaf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4af8de0d-7ee2-401d-9c16-d4e8b47b68fa",
                                                "sense_id": "8cc7fb45-1e53-3744-9bd4-763525039bd7",
                                                "text": "„Die Stunden vergingen, beide dösten vor sich hin, wurden bisweilen klar, fielen wieder in Schlaf und erwachten schließlich mit dem Gefühl der Übelkeit, das vom langen Schlummer in der Sonne stammt.“"
                                            },
                                            {
                                                "example_id": "9b3af0e3-1ad5-4e25-ab7b-e2a3c7722a00",
                                                "sense_id": "8cc7fb45-1e53-3744-9bd4-763525039bd7",
                                                "text": "„Endlich umfängt ihn der Schlummer.“"
                                            },
                                            {
                                                "example_id": "27fa9118-4a9d-4922-87a8-82ad19a912d5",
                                                "sense_id": "8cc7fb45-1e53-3744-9bd4-763525039bd7",
                                                "text": "„Selbst die Dachbalken über unseren Köpfen waren von großen feierlichen Vögeln besetzt, die träge ihr Gewicht von einem Bein aufs andere verlagerten, als unsere Stimmen ihren Schlummer störten.“"
                                            },
                                            {
                                                "example_id": "ec1f55ea-0520-4dcb-aac3-99b8b8fcf310",
                                                "sense_id": "8cc7fb45-1e53-3744-9bd4-763525039bd7",
                                                "text": "„Nachts war Mondschein, und er war längst hinunter in seine Stube gegangen, aber sie vermochte keinen Schlummer zu finden, wandte sich nur ruhelos in den Pfühlen hin und her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd58c7b7-7ae6-444e-ab09-faa39ba25039",
                        "source_entry_id": "8815de8e-db5f-3fec-9de4-ef26ce86fe41",
                        "source_sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                        "target_lang_word": "Schläfrigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schläfrigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "58946a0c-8bb8-32f6-bccf-1f675f6c8bb0",
                                        "entry_id": "701fa924-ca6f-3704-b96e-4e6679460594",
                                        "glosses": [
                                            "das Verspüren des Bedürfnisses nach Schlaf, die Neigung zum Einschlafen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39c3751d-9441-4340-b711-74a1a5fd17f9",
                                                "sense_id": "58946a0c-8bb8-32f6-bccf-1f675f6c8bb0",
                                                "text": "Als Gegenmittel sollten Autofahrer laut ACE bei ersten Anzeichen von Schläfrigkeit sofort \"Aktivpausen\" eingelegen."
                                            },
                                            {
                                                "example_id": "fd372e07-c761-4ebf-bb19-18dd8a6b2061",
                                                "sense_id": "58946a0c-8bb8-32f6-bccf-1f675f6c8bb0",
                                                "text": "„2.50 Uhr: Das helle Licht im Lesesaal oben trickst die innere Uhr der Studenten aus, um sie vor Schläfrigkeit zu bewahren.“"
                                            },
                                            {
                                                "example_id": "6ea9de02-a4b2-4f9f-afae-34b09800bd66",
                                                "sense_id": "58946a0c-8bb8-32f6-bccf-1f675f6c8bb0",
                                                "text": "„Neben Schläfrigkeit am Tage und Leistungsschwäche könne der dauernde Sauerstoffmangel auch Schäden an Herz und Lunge hervorrufen.“"
                                            },
                                            {
                                                "example_id": "5cc14996-bcc8-4c0a-8d8a-7e2a43e6e48e",
                                                "sense_id": "58946a0c-8bb8-32f6-bccf-1f675f6c8bb0",
                                                "text": "„Eine milde Schläfrigkeit hatte die Gesichter der Versammlung überzogen.“"
                                            },
                                            {
                                                "example_id": "6f8c1ec7-60a3-460e-94d4-ab29d697ca66",
                                                "sense_id": "58946a0c-8bb8-32f6-bccf-1f675f6c8bb0",
                                                "text": "„Vor allem im Westen sei eine \"gewisse Trägheit, ja Schläfrigkeit\" unübersehbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5f571600-47e6-397b-a8ce-d26593a3d016",
                                        "entry_id": "701fa924-ca6f-3704-b96e-4e6679460594",
                                        "glosses": [
                                            "den Eindruck vermitteln, schläfrig zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63baafce-f625-452f-8971-f5fa16db2d44",
                                                "sense_id": "5f571600-47e6-397b-a8ce-d26593a3d016",
                                                "text": "„Vor allem im Westen sei eine \"gewisse Trägheit, ja Schläfrigkeit\" unübersehbar.“"
                                            },
                                            {
                                                "example_id": "c30262d4-b2da-465a-83a5-6ea19f340576",
                                                "sense_id": "5f571600-47e6-397b-a8ce-d26593a3d016",
                                                "text": "Wenn ihr Gesicht nicht von so unendlicher Schläfrigkeit gekennzeichnet wäre, könnte man vermuten, es gäbe für sie nichts anderes auf der Welt als die Fische im Gemüsefach."
                                            },
                                            {
                                                "example_id": "14e174ca-dd30-49c4-a22e-6fb2554b9582",
                                                "sense_id": "5f571600-47e6-397b-a8ce-d26593a3d016",
                                                "text": "Die Schläfrigkeit stand ihr ins Gesicht geschrieben – hat sie vielleicht schlecht geschlafen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "158b2325-b33f-4d40-8204-408980a29520",
                        "source_entry_id": "8815de8e-db5f-3fec-9de4-ef26ce86fe41",
                        "source_sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                        "target_lang_word": "somnolence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somnolence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e4a15bf-4270-3b55-b326-743acc3586e5",
                                        "entry_id": "b639f9f6-bbca-3aa1-a7fb-9850209d4b44",
                                        "glosses": [
                                            "État d’inertie, de songe, ou de torpeur, lié à la fatigue, à la chaleur ou au froid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5f1742f-22d2-4db7-b3ff-8920cb0169db",
                                                "sense_id": "6e4a15bf-4270-3b55-b326-743acc3586e5",
                                                "text": "Il y eut encore entre ce moment de somnolence et le sommeil réel un intervalle pareil à celui du crépuscule, qui sépare le jour de la nuit, intervalle bizarre et indescriptible pendant lequel la réalité se confond avec le rêve, de manière qu’il n’y a ni rêve ni réalité."
                                            },
                                            {
                                                "example_id": "a1f8f56b-0431-4ad2-b0ea-134569a258a7",
                                                "sense_id": "6e4a15bf-4270-3b55-b326-743acc3586e5",
                                                "text": "Et puis, surtout, midi approche, avec sa lassitude, avec son invincible somnolence."
                                            },
                                            {
                                                "example_id": "ccdc58d0-f667-45ae-a6a1-29fc63caa423",
                                                "sense_id": "6e4a15bf-4270-3b55-b326-743acc3586e5",
                                                "text": "Un autre symptôme contre lequel le lieutenant Hobson engageait ses compagnons à réagir, c'était une somnolence opiniâtre, que quelques-uns ne parvenaient pas à vaincre."
                                            },
                                            {
                                                "example_id": "5eb66e6f-9fdd-4df5-aa08-40ec49c26884",
                                                "sense_id": "6e4a15bf-4270-3b55-b326-743acc3586e5",
                                                "text": "Je tombai cependant dans cette sorte de somnolence que provoquent les trépidations régulières d’un train en marche, […]."
                                            },
                                            {
                                                "example_id": "70dee01a-c61d-411f-8c61-816ebd401f2d",
                                                "sense_id": "6e4a15bf-4270-3b55-b326-743acc3586e5",
                                                "text": "Le père marchait, ivre de fatigue, gagné peu à peu par une demi-somnolence qui n’habitait que sa tête et laissait vivre le reste de son corps comme une mécanique un peu usée mais qui fonctionne par la force de l’habitude."
                                            },
                                            {
                                                "example_id": "4de3db95-5f5a-4955-bed2-1b6c3118a721",
                                                "sense_id": "6e4a15bf-4270-3b55-b326-743acc3586e5",
                                                "text": "— Car Montpellier, hors la session universitaire où la nuée virevoltante des étudiants envahissait et rendait vie et bruyance, rompant avec la somnolence habituelle de ma douce et égocentrique ville, restait figée dans un train-train « pépère »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f681cfbf-f0c6-46d1-ba5b-7c07074998e7",
                        "source_entry_id": "8815de8e-db5f-3fec-9de4-ef26ce86fe41",
                        "source_sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                        "target_lang_word": "torpeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torpeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bff7942a-4c2b-3cb7-b500-35959722ef1b",
                                        "entry_id": "c10e6f09-0e03-3c10-a787-ee5bb5d5b81f",
                                        "glosses": [
                                            "Engourdissement, somnolence, ralentissement des fonctions vitales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aef1a0d2-81e2-4ab3-b0d4-ed7ddd799f65",
                                                "sense_id": "bff7942a-4c2b-3cb7-b500-35959722ef1b",
                                                "text": "Ce malade est dans la torpeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                        "entry_id": "c10e6f09-0e03-3c10-a787-ee5bb5d5b81f",
                                        "glosses": [
                                            "Engourdissement des facultés de l’esprit."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd776fdb-f8bc-42e0-b3e6-de388f98af48",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Il voulait se reposer et se recueillir. A l'activité qui s'était emparée de lui tout à coup avait succédé une sorte de torpeur morale et physique. C'est un effet assez ordinaire du surmenage et des émotions répétées."
                                            },
                                            {
                                                "example_id": "f84315a6-e253-4c71-a3ae-175b94c4bf21",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Dans la tiède torpeur du réveil le père Jourgeot savoura ce délicieux engourdissement qui est comme la prise de conscience des bons sommeils réparateurs et des nuits tranquilles ; […]."
                                            },
                                            {
                                                "example_id": "8befd944-3c88-481f-8c7a-af33f2742537",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Un mois s’étant écoulé depuis le départ de Jacques, Yasmina vivait en une sorte de torpeur morne."
                                            },
                                            {
                                                "example_id": "4cda94bb-9a66-444e-9883-775b4881b9e7",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Tout le monde excepté la mère avait pris la torpeur de cette attente pour le calme de l’innocence."
                                            },
                                            {
                                                "example_id": "9388714d-0700-49d7-a337-42f839481180",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Et la rue retomba dans le demi-silence, la torpeur, la résignation qu’une descente de police laisse toujours derrière elle."
                                            },
                                            {
                                                "example_id": "0255f2d8-3595-486c-b8e2-0ebad695a7f0",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "La torpeur qui paralysait son cerveau lui procurait trop de bien-être pour qu’il tentât de la chasser."
                                            },
                                            {
                                                "example_id": "e2a5832a-1bb8-435a-9b8f-3545d9d3c5ab",
                                                "sense_id": "325b4558-70ad-362d-b2d1-e3a667efac8d",
                                                "text": "Les ouvrières ne se pressèrent pas, engourdies d’une torpeur de paresse, les bras abandonnés sur leurs jupes, tenant toujours d’une main leurs verres vides, où un peu de marc de café restait."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "394007bf-e821-4096-aaf4-d0e49dfb04b6",
                        "source_entry_id": "8815de8e-db5f-3fec-9de4-ef26ce86fe41",
                        "source_sense_id": "39825796-71ab-38f3-82e1-53850b98d784",
                        "target_lang_word": "assoupissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assoupissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "260265fc-6ca1-333d-91fa-8eadb8285806",
                                        "entry_id": "89705a72-c3c2-3d3f-aa03-a802c5d91a2f",
                                        "glosses": [
                                            "État d’une personne assoupie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b832f9c9-2b6a-472d-90c9-c0e6b1c59122",
                                                "sense_id": "260265fc-6ca1-333d-91fa-8eadb8285806",
                                                "text": "Pendant toute cette journée, le docteur ne voulut pas que le sommeil du malheureux fut interrompu; c’était un long assoupissement, entrecoupé de quelques murmures de souffrance qui ne laissaient pas d’inquiéter Fergusson."
                                            },
                                            {
                                                "example_id": "3593cd61-d83e-47d8-ab68-8d3df934624c",
                                                "sense_id": "260265fc-6ca1-333d-91fa-8eadb8285806",
                                                "text": "Deux soirs successifs, je fus visité, entre chien et loup, dans mon demi-assoupissement de fièvre, par des personnages différents qui me causèrent une extrême terreur."
                                            },
                                            {
                                                "example_id": "c1959a21-0d8b-4206-93c7-2bbc249e3fd9",
                                                "sense_id": "260265fc-6ca1-333d-91fa-8eadb8285806",
                                                "text": "Le calme et la monotonie, jamais ennuyeuse cependant, de cette existence au grand air provoquaient en moi une sorte d’assoupissement intellectuel et moral très doux, un apaisement bienfaisant."
                                            },
                                            {
                                                "example_id": "49b8d397-7642-4949-8dde-1479ec5a2773",
                                                "sense_id": "260265fc-6ca1-333d-91fa-8eadb8285806",
                                                "text": "Il avait la voix forte et juste et chantait à pleine gorge d’un air d’extase ; mais bientôt ses yeux se fermèrent et son menton retomba sur sa poitrine peu à peu. La voiture ne manquait jamais de l’endormir, et son cheval, devinant l’assoupissement habituel du maître, ralentit et finit par prendre le pas."
                                            },
                                            {
                                                "example_id": "e641360a-e12b-4284-bce7-caa586bb9603",
                                                "sense_id": "260265fc-6ca1-333d-91fa-8eadb8285806",
                                                "text": "Autrefois cette attente dans la nuit n’était qu’un demi-assoupissement, et elle ne cessait de souhaiter patiemment que la cuisson achevée lui permît le sommeil ; depuis que François Paradis avait passé, la longue veille hebdomadaire lui était plaisante et douce, parce qu’elle pouvait penser à lui et à elle-même sans que rien vînt interrompre le cours des choses heureuses qu’elle imaginait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb2c4384-4078-3903-be5c-00f67f498f34",
                                        "entry_id": "89705a72-c3c2-3d3f-aa03-a802c5d91a2f",
                                        "glosses": [
                                            "Engourdissement, mise en sommeil."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49dc5dfb-56eb-4ae7-a874-8f65d76abd01",
                                                "sense_id": "fb2c4384-4078-3903-be5c-00f67f498f34",
                                                "text": "Épuisée d’inanition et de tourment, elle était tombée dans cet assoupissement lucide et cruel des très vieilles gens qui vont mourir de douleur."
                                            },
                                            {
                                                "example_id": "92948ed2-5459-46b3-8ef2-d652dfab70dc",
                                                "sense_id": "fb2c4384-4078-3903-be5c-00f67f498f34",
                                                "text": "La lune éclatante, au milieu du ciel, versait sur les champs son assoupissement mystérieux."
                                            },
                                            {
                                                "example_id": "03200911-abe9-4182-9677-cbd02e726f68",
                                                "sense_id": "fb2c4384-4078-3903-be5c-00f67f498f34",
                                                "text": "Le père fixait tantôt le ciel, tantôt la terre luisante du jardin, et jamais encore il n’avait éprouvé à ce point jusqu’au fond de lui cet assoupissement de la vie qui marque l’approche de la saison morte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138e0366-c9f7-3468-bdce-0169dfe8fd84",
                                        "entry_id": "89705a72-c3c2-3d3f-aa03-a802c5d91a2f",
                                        "glosses": [
                                            "Grande nonchalance, grande négligence pour ses devoirs, pour ses intérêts."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfd8892d-1ad7-4faf-b1f9-340494d99659",
                                                "sense_id": "138e0366-c9f7-3468-bdce-0169dfe8fd84",
                                                "text": "Le peuple, des couches les plus misérables, réveillé de son assoupissement séculaire, quitta ses masures, étala ses haillons dans les rues principales des grandes villes et y apporta la psychose propre de la veille d'une révolution."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
