                        "glosses": [
                            "de bebouwde kant van een weg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "784e0ef3-60f3-43b7-992f-131902097c4d",
                                "sense_id": "4a2fbb83-5e13-3b69-b53f-f5bb3ac537ed",
                                "text": "Dragend de blinkende bril stapte Jaap in zijn smoeselig pakje, ten tweede maal de koepels langs, aan de huizenkant blijvend, de groote gevels en stallen langs waar klanten woonden van de baas."
                            },
                            {
                                "example_id": "5a6b6129-4e12-4ddb-92d1-936652d77098",
                                "sense_id": "4a2fbb83-5e13-3b69-b53f-f5bb3ac537ed",
                                "text": "Vrijwel over het midden van de Berflobeekweg loopt de ‘breuklijn’. Aan de huizenkant ligt de bestrating er keurig bij, richting beek hellen de klinkers flink over, ertussen een brede streep waar de bestrating van elkaar wijkt. Anderhalf jaar na de rigoureuze opknapbeurt van de Berflobeek en gelijknamige weg is het weer een rommeltje en niemand die er iets aan doet."
                            }
                        ]
                    }
