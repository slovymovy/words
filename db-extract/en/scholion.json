                        "glosses": [
                            "A scholium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28eba481-2e84-4fc6-9c74-b353ee8c1105",
                                "sense_id": "97d7d8fd-1d2a-3ee1-995d-8dccaf9e3d4d",
                                "text": "An ancient Scholion, recently discovered, names four poets who worked under that prince [Pisistratus]."
                            },
                            {
                                "example_id": "224e08b2-9766-4892-b813-33352cc4a764",
                                "sense_id": "97d7d8fd-1d2a-3ee1-995d-8dccaf9e3d4d",
                                "text": "Hereunto haue I added a certain Glosse, or scholion, for thexposition of old wordes."
                            },
                            {
                                "example_id": "4d5b4626-54e4-449b-883f-ee0c53fec209",
                                "sense_id": "97d7d8fd-1d2a-3ee1-995d-8dccaf9e3d4d",
                                "text": "A judgment which follows immediately from another, is sometimes called a Corollary or Consectary. One which does not belong to the science in which it appears, but is taken from another, is called a Lemma. One which illustrates in some way the science where it appears, but is not an integrant part of it, is a Scholion."
                            },
                            {
                                "example_id": "4116bed6-4d02-4852-a1f8-a700d10e149b",
                                "sense_id": "97d7d8fd-1d2a-3ee1-995d-8dccaf9e3d4d",
                                "text": "The opinion that the Lady is a Church is mentioned…by an ancient scholion."
                            }
                        ]
                    }
