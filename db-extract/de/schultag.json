                "senses": [
                    {
                        "sense_id": "08b0c8c0-479d-3763-ad04-ffe682e55cb6",
                        "entry_id": "12eebe32-1c1c-3799-805b-ab01ea116b41",
                        "glosses": [
                            "Tag, an dem man sich zeitweise in der Schule aufhält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36424e1a-6b56-4783-9934-916b8d5e6ef4",
                                "sense_id": "08b0c8c0-479d-3763-ad04-ffe682e55cb6",
                                "text": "„Dieser missratene erste Schultag sollte nicht ohne Folgen bleiben.“"
                            },
                            {
                                "example_id": "2085f487-40d0-4100-9aa2-86bafad7eb8f",
                                "sense_id": "08b0c8c0-479d-3763-ad04-ffe682e55cb6",
                                "text": "„Das war der erste Schultag.“"
                            },
                            {
                                "example_id": "53d4bb52-bde7-4e08-9855-ff91bdbdd193",
                                "sense_id": "08b0c8c0-479d-3763-ad04-ffe682e55cb6",
                                "text": "„Am zweiten Schultag sollte Volker mich zur Schule mitnehmen.“"
                            },
                            {
                                "example_id": "6c2f1f7a-9865-4fc2-aa9d-700eaf7d5db4",
                                "sense_id": "08b0c8c0-479d-3763-ad04-ffe682e55cb6",
                                "text": "„An diesem letzten Schultag herrschte eine gewisse Unsicherheit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
