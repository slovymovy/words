                        "sense_id": "78644b28-98d9-3829-8b65-d43022fe5c20",
                        "entry_id": "872c4ee2-25fb-3989-ba5a-2e45c3490ea2",
                        "glosses": [
                            "Tunique traditionnelle inuite généralement portée par les femmes, permettant de transporter un enfant dans une sorte de renfoncement situé dans le dos."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3257a976-38c6-4267-b336-7573db0bcc21",
                                "sense_id": "78644b28-98d9-3829-8b65-d43022fe5c20",
                                "text": "Cet amauti a été fabriqué par une couturière de la nation aivilingmiut, qui fait partie du groupe plus large des Iglulingmiut."
                            },
                            {
                                "example_id": "8221a66b-328f-4283-9edb-5b4799c51b65",
                                "sense_id": "78644b28-98d9-3829-8b65-d43022fe5c20",
                                "text": "Chez les Eskimos avataqs, le sac de portage traditionnel, l’amauti, est en général taillé dans une peau de caribou bien confortable et s’utilise jusqu’aux deux ans de l’enfant."
                            },
                            {
                                "example_id": "93447748-5156-4a97-ae83-100ec41c9a3f",
                                "sense_id": "78644b28-98d9-3829-8b65-d43022fe5c20",
                                "text": "Mais lui, il est comme le bébé dans l’amauti de sa mère. Paisible, sans peur."
                            }
                        ]
                    }
                ],
