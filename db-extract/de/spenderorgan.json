                            {
                                "example_id": "b6388239-7724-4d37-b2f0-a1e3827e1877",
                                "sense_id": "32f9b2de-017d-36fa-b0b3-4772d9fd892d",
                                "text": "Die Krankenhäuser klagen seit langem über einen Mangel an Spenderorganen."
                            },
                            {
                                "example_id": "f94d5539-f030-49ed-987a-ff183d5bc57e",
                                "sense_id": "32f9b2de-017d-36fa-b0b3-4772d9fd892d",
                                "text": "„Ivonette Balthazar lebt mit dem Spenderorgan eines deutschen Olympia-Trainers und lief nun ein Rennen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
