                                                "example_id": "94289e8c-aa06-40c9-b25a-491cf7ebc5df",
                                                "sense_id": "a8238bc0-e167-3413-a965-0487cd4d998a",
                                                "text": "Ich habe seit einigen Tagen ein Ganglion an meinem rechten Gelenk."
                                            }
