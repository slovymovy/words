                "senses": [
                    {
                        "sense_id": "5643bdb0-ed91-3b53-b3cd-ee16cbfefd0a",
                        "entry_id": "45500977-b199-3220-877a-a9945fd06edb",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053a384f-9160-4595-ac3a-db83b82c2a55",
                                "sense_id": "5643bdb0-ed91-3b53-b3cd-ee16cbfefd0a",
                                "text": "Frau Hägele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ba2a4c6e-d7a3-40d6-bb92-6d6d3ce295c9",
                                "sense_id": "5643bdb0-ed91-3b53-b3cd-ee16cbfefd0a",
                                "text": "Herr Hägele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7c88995b-2288-4084-b4a7-b79b7dda2edd",
                                "sense_id": "5643bdb0-ed91-3b53-b3cd-ee16cbfefd0a",
                                "text": "Die Hägeles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "451f1019-8bb7-42be-a041-6e123b1971fe",
                                "sense_id": "5643bdb0-ed91-3b53-b3cd-ee16cbfefd0a",
                                "text": "Der Hägele trägt nie die Pullover, die die Hägele ihm strickt."
                            },
                            {
                                "example_id": "b0dd19e2-021c-42e1-88e1-bf42d5d39372",
                                "sense_id": "5643bdb0-ed91-3b53-b3cd-ee16cbfefd0a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hägele kommt, geht der Herr Hägele.“"
                            },
                            {
                                "example_id": "4784d13b-b40f-4bc2-ac76-3354d766e327",
                                "sense_id": "5643bdb0-ed91-3b53-b3cd-ee16cbfefd0a",
                                "text": "Hägele kommt und geht."
                            },
                            {
                                "example_id": "716e2968-44bf-4ae7-a809-e0b9f447832b",
                                "sense_id": "5643bdb0-ed91-3b53-b3cd-ee16cbfefd0a",
                                "text": "Hägeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
