                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baab05e6-fc91-428c-94e1-bae014270fc1",
                                                "sense_id": "a52ab820-cf7e-31fb-8364-3ee1f31f3e37",
                                                "text": "Ein hauchfeiner Lidstrich in Grau rundet den Look ab."
                                            },
                                            {
                                                "example_id": "d7023798-1410-4d3b-9a5d-ad4799f00e0f",
