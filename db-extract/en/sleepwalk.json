                "senses": [
                    {
                        "sense_id": "ea163f38-4ed5-3ff2-8dae-eebaea8c7ab5",
                        "entry_id": "f633f83b-5051-3faf-a002-a03fa65973df",
                        "glosses": [
                            "To walk or perform other actions while sleeping; to somnambulate."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "4c058877-4a6d-4698-bdd8-49e379b9a769",
                                "sense_id": "ea163f38-4ed5-3ff2-8dae-eebaea8c7ab5",
                                "text": "Government... unions... industry... we have had enough. We - no, YOU - are sleepwalking the rest of us towards a less busy, less relevant industry with a smaller workforce, fewer passengers, fading importance, declining investment, poorly-paid jobs, and a truly shambolic reputation."
                            }
                        ]
                    },
                    {
                        "sense_id": "faad32a6-7e94-3ea3-b3cf-d5bdbb4b5920",
                        "entry_id": "f633f83b-5051-3faf-a002-a03fa65973df",
                        "glosses": [
                            "To perform actions without being aware of them; to do something that invites certain results without confronting that possibility."
                        ],
                        "tags": [
                            "figuratively",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f4aa594b-927c-4306-87fb-5fa03dc9f2a8",
                                "sense_id": "faad32a6-7e94-3ea3-b3cf-d5bdbb4b5920",
                                "text": "The government is sleepwalking into a crisis."
                            },
                            {
                                "example_id": "cbf37ecc-0aa6-4448-be33-2bd64774818e",
                                "sense_id": "faad32a6-7e94-3ea3-b3cf-d5bdbb4b5920",
                                "text": "They're trying to sleepwalk past their health problems."
                            }
                        ]
                    }
                ],
