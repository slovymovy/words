                        "glosses": [
                            "Oiseau marin du genre Fulmarus",
                            "Synonyme de fulmar boréal (sens étroit)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e836d51e-e432-4a44-b771-0e8a1d1aca1f",
                                "sense_id": "a3eeecfa-850c-31df-8142-31ac81325e38",
                                "text": "Jadis, le fulmar était exclusivement circumpolaire, mais il a récemment étendu son aire depuis le pack jusqu’au 40° N."
                            }
                        ]
                    }
                ],
                "translations": [
