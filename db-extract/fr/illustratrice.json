                        "tags": [
                            "plural"
                        ],
                        "form": "illustratrices"
                    },
                    {
                        "form_id": "7c11380a-2cca-407f-a93e-ff91899cce9f",
                        "entry_id": "e226a088-cec3-3ab2-85d6-6ef90b62a7ee",
                        "tags": [
                            "masculine"
                        ],
                        "form": "illustrateur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06c6d416-081f-3ec5-a46f-4d3b14af1b0b",
                        "entry_id": "e226a088-cec3-3ab2-85d6-6ef90b62a7ee",
                        "glosses": [
                            "Celle qui illustre, qui dessine, qui compose des illustrations pour les livres, les journaux, les revues."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "326e4f88-d852-4411-9a7e-1890f98d6f05",
                                "sense_id": "06c6d416-081f-3ec5-a46f-4d3b14af1b0b",
                                "text": "Il avait assisté à une table ronde sur la violence et les livres, à un débat sur les prix littéraires, à une rencontre avec une illustratrice tchèque."
                            },
                            {
                                "example_id": "ab0e1f09-7f45-4d00-994b-34990292a1fd",
                                "sense_id": "06c6d416-081f-3ec5-a46f-4d3b14af1b0b",
                                "text": "L’illustratrice nantaise Gwenaelle Dumont s’est portée volontaire et a déposé une annonce de stage sur le fameux site."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c161a123-44a0-4576-a73b-db2faf5db627",
                        "source_entry_id": "e226a088-cec3-3ab2-85d6-6ef90b62a7ee",
                        "source_sense_id": "06c6d416-081f-3ec5-a46f-4d3b14af1b0b",
                        "target_lang_word": "Illustratorin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Illustratorin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "23341184-5a7d-3f55-89fe-2a69675e1f5b",
                                        "entry_id": "77196078-977a-39b4-9331-4dcc9410bae2",
                                        "glosses": [
                                            "Künstlerin, die zu einer Vorlage, einem Druckwerk Bilder schafft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97487cea-3bc3-459b-b6b3-3d2f92d51d15",
                                                "sense_id": "23341184-5a7d-3f55-89fe-2a69675e1f5b",
                                                "text": "„Die Illustratorin Nina Dietrich hat deshalb anhand eines Artikels der letzten Wochenendausgabe des STANDARD eine Illustration erstellt, mit der die Querverbindungen auf einen Blick sichtbar werden.“"
                                            },
                                            {
                                                "example_id": "3e37ba7b-808a-4d79-9a77-8f2e0dd30bc2",
                                                "sense_id": "23341184-5a7d-3f55-89fe-2a69675e1f5b",
                                                "text": "„Dass sie, eine begabte Zeichnerin und Illustratorin seiner Bücher, nach einer Kinderlähmung gehbehindert ist und am Stock geht, erhöht das Flair des mondänen Paars.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85dae240-1e09-4a91-a186-d7ddc0cb035b",
                        "source_entry_id": "e226a088-cec3-3ab2-85d6-6ef90b62a7ee",
                        "source_sense_id": "06c6d416-081f-3ec5-a46f-4d3b14af1b0b",
                        "target_lang_word": "illustrator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illustrator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a92a3fe-e527-381b-95e4-6a665f26397e",
                                        "entry_id": "c7db5f48-b4e5-3b38-b26e-6abd3ef1552b",
                                        "glosses": [
                                            "a person who draws pictures (especially illustrations in books or magazines)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05217c93-6d7f-45ea-80be-70497208032f",
                                                "sense_id": "5a92a3fe-e527-381b-95e4-6a665f26397e",
                                                "text": "Mary is one of the best illustrators of children's books in the country."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "412e62d6-02ba-4723-b27d-f9c874edefee",
                        "source_entry_id": "e226a088-cec3-3ab2-85d6-6ef90b62a7ee",
                        "source_sense_id": "06c6d416-081f-3ec5-a46f-4d3b14af1b0b",
                        "target_lang_word": "illustratress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "illustratress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3662a75b-ce62-3273-9d1b-b1d1694000d4",
                                        "entry_id": "d69de7ec-14ce-386f-85fd-ceaa5ea03ac2",
                                        "glosses": [
                                            "A female illustrator."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b454dfdf-a17a-45d6-86f8-0a9f20c7d359",
                                                "sense_id": "3662a75b-ce62-3273-9d1b-b1d1694000d4",
                                                "text": "The specific epithet commemorates my botanical illustratress."
                                            },
                                            {
                                                "example_id": "c7176439-c4a3-40fe-9b0e-241307c27a8d",
                                                "sense_id": "3662a75b-ce62-3273-9d1b-b1d1694000d4",
                                                "text": "...a younger authoress whose blond stern good looks concealed a heart equally stern and who was said sternly to support a worthless husband whom she sternly adored; and an illustrator, or rather illustratress, for it was a lady, whose cover designs of babies in every sort of snarled discomfort were the delight of editors who went home and were cross to their own children."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
