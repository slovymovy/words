                    {
                        "translation_id": "a71c011f-9e45-4d94-b004-0280ca01ec2b",
                        "source_entry_id": "69b0b167-4dfa-3877-8947-cddf6ba92a1a",
                        "source_sense_id": "f4a02e6e-44bf-37d8-8e77-d4ff6d88e58e",
                        "target_lang_word": "sinologue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinologue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a5412471-460e-3d45-8687-8735fc4091de",
                                        "entry_id": "d19d507b-6b74-3c88-84db-777ae44c3e7f",
                                        "glosses": [
                                            "Spécialiste de la langue ou de la littérature chinoises."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68abc7ed-8c3e-48e2-b61e-559dcc71c80e",
                                                "sense_id": "a5412471-460e-3d45-8687-8735fc4091de",
                                                "text": "Comment un sinologue procède-til quand il déchiffre un texte chinois ancien?"
                                            },
                                            {
                                                "example_id": "36000598-b9f8-4e1b-8e7b-db0f14a0d420",
                                                "sense_id": "a5412471-460e-3d45-8687-8735fc4091de",
                                                "text": "La sinologue, professeure au Collège de France, travaille depuis quarante ans à faire connaître les trésors intellectuels de la Chine. Mais toujours avec la volonté de contrer la propagande du régime. Elle dirige un ouvrage collectif, « Penser en Chine »."
                                            },
                                            {
                                                "example_id": "f19f7450-26cb-4f8a-a83f-70dc07466dce",
                                                "sense_id": "a5412471-460e-3d45-8687-8735fc4091de",
                                                "text": "Pour le sinologue Emmanuel Lincot, professeur à l’Institut catholique de Paris qui a participé à la même séance préparatoire à l’Élysée, la marge de manœuvre est plus qu’étroite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c2b6a32-da3c-396b-804e-fe36986c5ca6",
                                        "entry_id": "d19d507b-6b74-3c88-84db-777ae44c3e7f",
                                        "glosses": [
                                            "Spécialiste de la politique intérieure et extérieure des gouvernements chinois."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46df7716-8277-4375-aaee-f635ec907a8e",
                                                "sense_id": "9c2b6a32-da3c-396b-804e-fe36986c5ca6",
                                                "text": "Mais derrière la rhétorique, la presse chinoise se concentre aussi sur les aspects positifs de la rencontre d’Anchorage, à savoir les points sur lesquels les deux puissances ont convenu de collaborer, comme le climat ou les vaccins, remarque la sinologue Bonnie Glaser, du Centre pour les études internationales et stratégiques (CSIS) à Washington."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
