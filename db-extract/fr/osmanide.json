                    {
                        "sense_id": "c467b516-130d-3451-a146-cf06f458b32c",
                        "entry_id": "71ebc5c2-2e1d-3121-95b2-c2ab3928cf86",
                        "glosses": [
                            "Osmanid, Ottoman"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07bc38a6-7172-4cbb-b8da-b6ed1f8e0bd4",
                                "sense_id": "c467b516-130d-3451-a146-cf06f458b32c",
                                "text": "[...] les monnaies de Baghdad de ce prince osmanide étaient, je crois, jusqu'ici restées inconnues."
                            },
                            {
                                "example_id": "1ca9c36b-78e0-44df-89a1-8c2f5ec171c4",
                                "sense_id": "c467b516-130d-3451-a146-cf06f458b32c",
                                "text": "Cette ville a été au commencement de la monarchie osmanide ou ottomane la capitale de leur empire [...]"
                            },
                            {
                                "example_id": "f8f35664-dc82-41fc-9255-8ef550c1dd53",
                                "sense_id": "c467b516-130d-3451-a146-cf06f458b32c",
                                "text": "[...] l’empire habsbourgeois et l’empire osmanide."
                            }
                        ]
                    }
                ],
