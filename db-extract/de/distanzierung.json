                    {
                        "translation_id": "35fc82cd-27f2-4174-91c5-bfc70b71dc43",
                        "source_entry_id": "dc355f68-d6f9-34dc-9c65-1b89b2664b67",
                        "source_sense_id": "56106af2-665f-3072-9a10-19e73cfafbc2",
