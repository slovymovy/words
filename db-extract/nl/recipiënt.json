                                        "sense_id": "416cc9d6-a752-3e33-b33f-2d4d54027b61",
                                        "entry_id": "05bd327f-edbf-3621-b5a5-a45be5b990f7",
                                        "glosses": [
                                            "Vase adapté à la cornue ou à l’alambic pour recevoir les produits d’une distillation ou de toute autre opération chimique."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc881360-a629-42fc-bcfd-3a85e57b2c1a",
                                                "sense_id": "416cc9d6-a752-3e33-b33f-2d4d54027b61",
                                                "text": "Un récipient de verre."
                                            },
                                            {
                                                "example_id": "0c93c005-89b3-4343-8d94-c7fb296bb57f",
                                                "sense_id": "416cc9d6-a752-3e33-b33f-2d4d54027b61",
                                                "text": "La cornue et le récipient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4002c4bc-0ad3-3d3a-a41b-f630d16d3bbd",
                                        "entry_id": "05bd327f-edbf-3621-b5a5-a45be5b990f7",
                                        "glosses": [
                                            "Cloche de verre qu’on place sur le plateau d’une machine pneumatique et où l’on renferme les corps que l’on veut mettre dans le vide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36004255-de88-4793-bc61-a41681f08269",
                                                "sense_id": "4002c4bc-0ad3-3d3a-a41b-f630d16d3bbd",
                                                "text": "Pomper l’air du récipient."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6451a42-3dac-3979-b1ba-022f11383535",
                                        "entry_id": "05bd327f-edbf-3621-b5a5-a45be5b990f7",
                                        "glosses": [
                                            "Toute sorte de vase, quels qu’en soient la matière, la forme et l’usage."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "90575fbc-3214-48ce-95e1-fc0ae58dbe28",
                                                "sense_id": "c6451a42-3dac-3979-b1ba-022f11383535",
                                                "text": "Les aliments détaillés en menus morceaux sont sautés très rapidement avec très peu de matière grasse dans un récipient hémisphérique placé sur un brûleur très puissant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c98f7c54-3503-4f56-9a83-2cff2ce469e6",
                        "source_entry_id": "dfbf6ffe-6a22-3ed2-b336-0f46793f264e",
                        "source_sense_id": "838ed664-9fe5-32c9-b588-78a914de63f7",
                        "source_sense_description": "de ontvanger van bloed, weefsel of een orgaan dat van een donor afkomstig is",
                        "target_lang_word": "receveur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "receveur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0c03e52-f276-3fa8-88f0-4142b80a4ec4",
                                        "entry_id": "6aa32722-01d4-367d-bbf3-003523f3b477",
                                        "glosses": [
                                            "Celui qui a charge de faire une recette, soit en argent, soit en nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1ed341a-5116-409e-b82c-e5bb6a467050",
                                                "sense_id": "e0c03e52-f276-3fa8-88f0-4142b80a4ec4",
                                                "text": "Il me nomma même trésorier des tributs que l'Arabie Pétrée payait au roi des rois. Je fis ma charge de receveur et point du tout celle de payeur."
                                            },
                                            {
                                                "example_id": "5b5fcded-806e-4b08-8c36-3039c78c974d",
                                                "sense_id": "e0c03e52-f276-3fa8-88f0-4142b80a4ec4",
                                                "text": "Une ordonnance de Charles IV, dit le Bel, de novembre 1323, concernant le Trésor, prescrit qu’aucun clerc ou receveur ne soit employé au Trésor s'il n'est pas Français."
                                            },
                                            {
                                                "example_id": "d3233ef4-03f2-4736-87c0-7a7584203743",
                                                "sense_id": "e0c03e52-f276-3fa8-88f0-4142b80a4ec4",
                                                "text": "Le sel était alors déchargé sous la surveillance d'un receveur et d'un « commis aux descentes » qui assistaient également à son mesurage et à son « empotassement » par masses séparées dans des salles situées à l'abri des inondations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0dd2021-4254-3704-a81d-50535bd775f9",
                                        "entry_id": "6aa32722-01d4-367d-bbf3-003523f3b477",
                                        "glosses": [
                                            "Joueur qui attrape la balle lancée par le lanceur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "62c70dbb-80a7-3dce-9c4a-c2c6248e531d",
                                        "entry_id": "6aa32722-01d4-367d-bbf3-003523f3b477",
                                        "glosses": [
                                            "Personne qui reçoit un organe transplanté ou une transfusion, par opposition au donneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "087ab86b-2228-40d8-a44a-683b4ac6a1ee",
                                                "sense_id": "62c70dbb-80a7-3dce-9c4a-c2c6248e531d",
                                                "text": "Une greffe rénale à donneur∙euse vivant∙e nécessite deux interventions (donneur et receveur) se déroulant en parallèle le même jour."
                                            },
                                            {
                                                "example_id": "ff8a6f96-b4f1-49c5-9075-3780b2294c0f",
                                                "sense_id": "62c70dbb-80a7-3dce-9c4a-c2c6248e531d",
                                                "text": "Le contrôle de la réaction immunitaire du receveur contre le greffon a fait de sérieux progrès, tant et si bien qu’à court terme, le risque de rejet est aujourd’hui maîtrisé."
                                            },
                                            {
                                                "example_id": "32bf18a8-b2f9-48f3-b1e9-ee75b50cc575",
                                                "sense_id": "62c70dbb-80a7-3dce-9c4a-c2c6248e531d",
                                                "text": "Il est possible de donner son sang de ses 18 ans à ses 70 ans révolus. Il faut peser plus de 50 kg. Un entretien médical sera nécessaire pour être sûr que le don ne présente aucun risque, ni pour le donneur ni pour le receveur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "582ffc36-7d10-3153-b0b4-5e9ca6eefb00",
                                        "entry_id": "6aa32722-01d4-367d-bbf3-003523f3b477",
                                        "glosses": [
                                            "Partie inférieure d’une douche, qui recueille et évacue l’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dcae9e7-5045-4814-853e-6cee6d1017ca",
                                                "sense_id": "582ffc36-7d10-3153-b0b4-5e9ca6eefb00",
                                                "text": "Si le plancher de votre salle de bain est en bois, vous pouvez intégrer le receveur dans son épaisseur et installer le siphon entre les lambourdes du plancher."
                                            },
                                            {
                                                "example_id": "3147a672-329b-4afb-8fb9-1eced800a015",
                                                "sense_id": "582ffc36-7d10-3153-b0b4-5e9ca6eefb00",
                                                "text": "Dorénavant, Gisèle peut enfin prendre une douche en toute sécurité, grâce à l’installation d’un receveur extra-plat, d’un siège de douche et d’une barre de maintien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ec0712f-2ad8-4789-b6ec-b694fd89049b",
                        "source_entry_id": "dfbf6ffe-6a22-3ed2-b336-0f46793f264e",
                        "source_sense_id": "838ed664-9fe5-32c9-b588-78a914de63f7",
                        "source_sense_description": "de ontvanger van bloed, weefsel of een orgaan dat van een donor afkomstig is",
                        "target_lang_word": "receveuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "receveuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99916a7a-83d2-35da-8d18-39ba1bfe105c",
                                        "entry_id": "cfbf6f13-25e6-30c7-8da7-2ca687587fcc",
                                        "glosses": [
                                            "Celle qui reçoit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9d685a4-2863-4039-94f2-7ad5411f52f0",
                                                "sense_id": "99916a7a-83d2-35da-8d18-39ba1bfe105c",
                                                "text": "Don du sang : “aujourd’hui, on revit tous”, raconte la mère d’une receveuse"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e81d706d-b530-35d4-8ed5-f053dde44941",
                                        "entry_id": "cfbf6f13-25e6-30c7-8da7-2ca687587fcc",
                                        "glosses": [
                                            "Celle qui a charge de faire une recette, soit en argent, soit en nature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "964946bc-55a3-496e-9a88-4fad348f8a26",
                                                "sense_id": "e81d706d-b530-35d4-8ed5-f053dde44941",
                                                "text": "Il y a des mots identiques à ceux pour lesquels Mᵐᵉ Gagneur réclame, qui ont déjà leur féminin : receveur, receveuse, acteur, actrice. Il y en a d’autres qui, quoique non encore classés, ont en quelque sorte droit de cité : docteur, doctoresse. Mais il y en a d’autres qui seraient horribles : auteur, autrice ou auteuse ; cela déchire absolument les oreilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1d4b43c-28f2-3335-98a9-0388e7131f5e",
                                        "entry_id": "cfbf6f13-25e6-30c7-8da7-2ca687587fcc",
                                        "glosses": [
                                            "Joueuse qui attrape la balle lancée par le lanceur ou la lanceuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e25125c3-1ca3-4d1e-950b-03ee549d8d74",
                                                "sense_id": "c1d4b43c-28f2-3335-98a9-0388e7131f5e",
                                                "text": "Mary Baker, originaire de Regina, a joué comme receveuse dans la All American Girls Professional Baseball League (AAGPBL) entre 1943 et 1952."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1811ec2-d2bf-3811-bfac-1c3c812f5f08",
                                        "entry_id": "cfbf6f13-25e6-30c7-8da7-2ca687587fcc",
                                        "glosses": [
                                            "Épouse d’un receveur."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d79c9d9-17bd-4074-bdc3-015a8b52c767",
                                                "sense_id": "e1811ec2-d2bf-3811-bfac-1c3c812f5f08",
                                                "text": "Les fonctions de receveur ne sont guère remplies que par des hommes ; quand elles le sont par une femme, on dit receveuse : receveuse des billets d’un théâtre. En parlant de la femme d’un receveur, on dit aussi, madame la receveuse, comme on doit pouvoir dire, madame la fournisseuse générale ; comme on a dit autrefois familièrement et par plaisanterie, madame la procureuse ; comme on dit encore parfaitement bien, madame la procureuse générale, madame la procureuse du roi, madame la maréchale, madame la générale, madame la préfète, madame la sous-préfète, madame la présidente, madame l’élue, etc."
                                            },
                                            {
                                                "example_id": "c7fd281a-0718-4984-be1e-d7d44027d5f5",
                                                "sense_id": "e1811ec2-d2bf-3811-bfac-1c3c812f5f08",
                                                "text": "La receveuse, Mˡˡᵉ Monod, était seule dans la confidence ; elle avait arrêté plusieurs lettres d’Anne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
