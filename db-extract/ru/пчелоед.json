                                        "glosses": [
                                            "Greifvogel aus der Gattung Buteo, der sich hauptsächlich von der Brut sozialer Faltenwespen ernährt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91988ac2-d41b-4452-8279-64bb1cf786a6",
                                                "sense_id": "aee62254-9baa-35cf-a556-3764d393b747",
