                "senses": [
                    {
                        "sense_id": "aa719341-66cd-3abb-b982-245629c57046",
                        "entry_id": "981abb3b-71ab-3994-8ef5-cbdd4eb1a2a1",
                        "glosses": [
                            "A number that is to be multiplied by another (the multiplier)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed848d1a-5545-468a-8275-b407125d5e7d",
                                "sense_id": "aa719341-66cd-3abb-b982-245629c57046",
                                "text": "In the expression 5 × 3, the \"3\" is the multiplicand."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc85d858-3c96-4534-9880-1921da0cd39c",
                        "source_entry_id": "981abb3b-71ab-3994-8ef5-cbdd4eb1a2a1",
                        "source_sense_id": "aa719341-66cd-3abb-b982-245629c57046",
                        "source_sense_description": "number that is to be multiplied by another",
                        "target_lang_word": "multiplicande",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "multiplicande",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "372eed70-c836-3bfc-bf19-32a6f55486e4",
                                        "entry_id": "04778d69-7043-3e0d-b0e5-df9eddff10ed",
                                        "glosses": [
                                            "L’un des deux opérandes de la multiplication."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "beff5569-2acd-471c-98c5-d2751ada588d",
                                                "sense_id": "372eed70-c836-3bfc-bf19-32a6f55486e4",
                                                "text": "Dans la multiplication de quatre par trois, quatre est le multiplicande, trois est le multiplicateur."
                                            },
                                            {
                                                "example_id": "e25a4878-d62d-485f-a78b-6812f7a0db79",
                                                "sense_id": "372eed70-c836-3bfc-bf19-32a6f55486e4",
                                                "text": "Soit +A à multiplier par +B. La valeur absolue du produit sera composée avec la valeur absolue A du multiplicande, comme la valeur absolue B du multiplicateur est composée avec l’unité ; c’est-à-dire que, d’après les notations admises, cette valeur absolue du produit sera AB. Quant au signe du produit, comme le multiplicateur +B a le même signe que l’unité positive, ce produit aura le même signe que le multiplicande, c’est-à-dire +.\nAinsi, le produit de +A par +B est +AB.\nSoit +A à multiplier par −B. La valeur absolue du produit sera, comme ci-dessus, AB. Mais le multiplicateur −B ayant un signe contraire à celui de l’unité positive, le produit aura un signe contraire à celui du multiplicande, c’est-à-dire −.\nAinsi le produit de +A par −B est −AB."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
