                                "target_senses": [
                                    {
                                        "sense_id": "3f689e4a-9e2b-37e8-99f9-711b078e7c43",
                                        "entry_id": "4ff8517b-b480-3f00-95da-b2d058b29aea",
                                        "glosses": [
                                            "(género Chrysanthemum) Planta perenne de la familia de las compuestas, con tallos anuales, casi leñosos, de 6 a 8 decímetros de alto, hojas alternas, aovadas, y flores abundantes, pedunculadas, solitarias, axilares y terminales, de colores variados. Procede de China y se cultiva en los jardines, donde florece a fines de otoño."
                                        ],
                                        "tags": [],
                                        "examples": [],
