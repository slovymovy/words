                        "examples": [
                            {
                                "example_id": "a7ef081a-31b4-4bac-bf4a-eff988b21ba6",
                                "sense_id": "0a590a3f-f598-3e76-bdf4-bf4abeac3041",
                                "text": "„Ein Bewerbungsanschreiben umfasst genau eine DIN A4 Seite.“"
                            },
                            {
                                "example_id": "8893680d-d789-41a2-beb6-603ae8878f00",
                                "sense_id": "0a590a3f-f598-3e76-bdf4-bf4abeac3041",
                                "text": "„Das Bewerbungsanschreiben wird lose auf die Bewerbungsmappe gelegt, denn dies möchte der Arbeitgeber zuerst durchlesen.“"
                            },
                            {
                                "example_id": "6302a559-73f2-414a-a51a-f8094cd59710",
                                "sense_id": "0a590a3f-f598-3e76-bdf4-bf4abeac3041",
                                "text": "„Bei einem fehlerhaften Bewerbungsanschreiben erhalten Sie keine zweite Chance.“"
                            },
                            {
                                "example_id": "f93c9969-6b71-4a98-9778-b232e5351019",
                                "sense_id": "0a590a3f-f598-3e76-bdf4-bf4abeac3041",
                                "text": "„Das Bewerbungsanschreiben ist ein Geschäftsbrief.“"
                            }
