                    "frequency": "High",
                    "semantic_group_id": "auteur_crime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police recherche activement ce dangereux <w>criminel</w> en fuite depuis hier soir."
                        },
                        {
