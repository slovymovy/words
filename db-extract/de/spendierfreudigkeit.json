                "senses": [
                    {
                        "sense_id": "bde221ce-969b-3274-94a8-7ae9277d82bd",
                        "entry_id": "32ccb1b7-379e-3af9-bb2a-7152e2e5a880",
                        "glosses": [
                            "Bereitschaft, freiwillig zu geben, zu schenken, Geld auszugeben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3147b899-141b-4cd7-b0bd-f59423a6622d",
                                "sense_id": "bde221ce-969b-3274-94a8-7ae9277d82bd",
                                "text": "„In den USA hängen die Kulturbetriebe in einem großen Maße von der Spendierfreudigkeit der Privaten ab.“"
                            },
                            {
                                "example_id": "c630dab7-b575-4de1-98c4-a21091b8a0d9",
                                "sense_id": "bde221ce-969b-3274-94a8-7ae9277d82bd",
                                "text": "„Meine Spendierfreudigkeit hatte nichts mit Nächstenliebe zu tun, sondern eher mit Berechnung.“"
                            },
                            {
                                "example_id": "d44b2741-9b6f-45b3-82da-63250819f58e",
                                "sense_id": "bde221ce-969b-3274-94a8-7ae9277d82bd",
                                "text": "„Sie hatte ihn vergöttert, und er hatte sie geliebt, aber geködert hatte er sie mit teuren Geschenken und seiner Spendierfreudigkeit.“"
                            },
                            {
                                "example_id": "c9abb328-c459-455a-8a13-7e787f48a5f9",
                                "sense_id": "bde221ce-969b-3274-94a8-7ae9277d82bd",
                                "text": "„Doch der Mann ist klein mit einem buschigen Bart und Knopfaugen, die uns schon auf unsere Spendierfreudigkeit hinsichtlich des Trinkgelds einzuschätzen versuchen, noch während er den Sangria-Krug abstellt.“"
                            },
                            {
                                "example_id": "d26bf9b5-3114-48b9-af65-6477f1699bdd",
                                "sense_id": "bde221ce-969b-3274-94a8-7ae9277d82bd",
                                "text": "„Die Politiker sind es, die sich mit ihrer Spendierfreudigkeit – sei es für soziale Zwecke oder für einflussreiche Interessensgruppen – Wählerstimmen kaufen und so ihre Wiederwahl sichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
