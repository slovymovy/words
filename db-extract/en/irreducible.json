{
    "word": "irreducible",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                "word": "irreducible",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "294b6e90-6ce3-3977-aa5a-db3b6fca6a84",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Not able to be reduced or lessened."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "8e4c9933-a478-486e-b8e1-74dea1dd1f32",
                                "sense_id": "294b6e90-6ce3-3977-aa5a-db3b6fca6a84",
                                "text": "With each reduction in the number of railways, there must come, eventually, a decline in interest, if only through reduction in variety; and when it comes to one nationalised railway only we have reached the irreducible minimum."
                            }
                        ]
                    },
                    {
                        "sense_id": "80eeede4-c727-31ef-8f5e-5fa817a44e92",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Not able to be brought to a simpler or reduced form."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "9ae86e6c-0199-3b9b-9652-38853c788ba4",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Unable to be factorized into polynomials of lower degree, as (x² + 1)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "eaebdae3-6826-3ae9-98f5-69c5da8ba646",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Whose numerator and denominator share no common factor greater than 1."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "09dadd86-ea24-3810-ad61-dae7f324c9a2",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Unable to be factored into smaller integers; prime."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b6d24675-8622-3fbc-8ef1-b62305066193",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Whose only divisors are units and associates."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "06f7110e-8d98-3fa2-8db5-c7bb1b16795e",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Inexpressible as the union of two proper algebraic subvarieties."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "743e98fe-84f9-3a0d-847d-39a7ef0a94e7",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Not containing a sphere of codimension 1 that is not the boundary of a ball."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0427e543-22d2-3d04-9d41-b39cf83f430b",
                        "entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "glosses": [
                            "Impossible to divide further into representations of lower dimension by means of any similarity transformation."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a5a1b75-1953-4030-8851-562de3e7921e",
                        "source_entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "source_sense_description": "not able to be reduced or lessened",
                        "target_lang_word": "onherleidbaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onherleidbaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "14c51b15-cd2c-3bf8-912a-2419d322edd7",
                                        "entry_id": "57576387-19f1-3c82-83c6-5d437612e52f",
                                        "glosses": [
                                            "niet terug te brengen naar de oorsprong"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ac362d5-bc82-4c9c-af6c-4cf6a52e736b",
                                                "sense_id": "14c51b15-cd2c-3bf8-912a-2419d322edd7",
                                                "text": "Elk benoembaar voorwerp bezat een rafelige omtrek, een onregelmatige kartelrand, waar de vorm in onherleidbaar poeder verdampte."
                                            },
                                            {
                                                "example_id": "6ce85ed4-ff1c-4e4c-aadd-31f00c49eaf0",
                                                "sense_id": "14c51b15-cd2c-3bf8-912a-2419d322edd7",
                                                "text": "Dat betekent dat de patiëntengegevens onherleidbaar moeten zijn. De versleuteling is volgens het CBP niet voldoende om dit te doen, het is \"slechts een beveiligingsmaatregel om privacyrisico’s te verkleinen\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4099ad1e-f59d-4c92-9499-3b6e16b392b6",
                        "source_entry_id": "78ec6c2f-bf0d-3d1a-98e6-950c8d66003a",
                        "source_sense_description": "not able to be reduced or lessened",
                        "target_lang_word": "irréductible",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irréductible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d555e435-26c8-3afe-9a1d-8be4f5ea0209",
                                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                                        "glosses": [
                                            "Se dit d’un oxyde métallique qu’on ne peut ramener à l’état de métal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2b9a3eae-9857-3cdf-8bab-cc7447213faf",
                                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                                        "glosses": [
                                            "Se dit des luxations, des fractures ou des hernies qui ne peuvent être réduites."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ab02b4c7-a304-386e-90ce-c6bfb2da610f",
                                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                                        "glosses": [
                                            "Qui ne peut pas être simplifiée, en parlant d’une fraction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8472eafd-2855-48ca-b605-fcf3cf40a6c3",
                                                "sense_id": "ab02b4c7-a304-386e-90ce-c6bfb2da610f",
                                                "text": "La fraction 4/6 n'est pas sous forme irréductible car 4 et 6 ont en plus de 1 le nombre 2 comme diviseur commun. Cette fraction est donc simplifiable et on a : 4/6 = 2×2/2×3 = 2/3 en simplifiant par 2 en haut et en bas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90fe9405-104d-3a45-b551-6b188b4cb967",
                                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                                        "glosses": [
                                            "Ce qui ne peut être réduit sous une autre forme plus simple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abbb670b-095a-4dbf-acff-8f2c1f55510d",
                                                "sense_id": "90fe9405-104d-3a45-b551-6b188b4cb967",
                                                "text": "Équation irréductible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd1257e-c9fa-333d-86b4-15ce668d21c8",
                                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                                        "glosses": [
                                            "Rente irréductible: dont on ne peut abaisser le taux d'intérêt."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0ffa8916-9996-3ed3-aef9-bf8e4cb7b3b2",
                                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                                        "glosses": [
                                            "Qu'on ne peut assimiler ou ramener l'un à l'autre en parlant de choses mises en relation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f852f2d-3c83-4623-b3aa-727d92c0a0e2",
                                                "sense_id": "0ffa8916-9996-3ed3-aef9-bf8e4cb7b3b2",
                                                "text": "Ce sont deux notions irréductibles l'une à l'autre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                                        "entry_id": "fb07198b-5d8d-3105-bf9d-4199b36303e3",
                                        "glosses": [
                                            "Qu’on ne peut vaincre ou faire fléchir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9cdf8a7-d336-429b-8325-ec2a53591a29",
                                                "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                                                "text": "Toutefois la pacification des villes ne va pas sans réactions parfois violentes et soudaines de fanatiques irréductibles."
                                            },
                                            {
                                                "example_id": "b36e6bc7-81a9-4846-bce9-cfee66218825",
                                                "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                                                "text": "Si une chose frappe particulièrement, ces années-ci, lorsqu’on voit se déployer la frange radicale de ceux qui se croient en insurrection contre un Système qu’ils peinent à définir mais qu’ils ne cessent de maudire, c’est la conviction profonde que l’Histoire mettrait en scène un affrontement irréductible entre des forces obscures, agissantes, maléfiques et, de l’autre côté, une résistance composée de guerriers héroïques, déchiffrant à travers l’actualité les signes invisibles aux autres de cette lutte sans merci."
                                            },
                                            {
                                                "example_id": "39c38503-e7ef-444c-816e-bd38f51bad92",
                                                "sense_id": "abbc7ebb-34e3-336c-93ec-b437cb43fbb2",
                                                "text": "Le village en Armorique des irréductibles Gaulois d’Astérix"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "irréductible",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "974db5c9-5d98-3623-915e-1d2e5d94dc26",
                                        "entry_id": "df2f516e-366c-36de-830a-42519246756d",
                                        "glosses": [
                                            "Personne qu’on ne peut vaincre ou faire fléchir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "042f1e19-09e3-4463-bb07-ff309c423791",
                                                "sense_id": "974db5c9-5d98-3623-915e-1d2e5d94dc26",
                                                "text": "Je vais te dire une chose, Sai Dje, en plus d’être un irréductible bourgeois tu es un vantard."
                                            },
                                            {
                                                "example_id": "34630a46-0b08-41ca-8d91-c413b9068225",
                                                "sense_id": "974db5c9-5d98-3623-915e-1d2e5d94dc26",
                                                "text": "Hier encore, alors que les démantèlements de camps de manifestants se poursuivaient aux quatre coins du pays, plusieurs centaines d’irréductibles s’employaient à réinvestir les points de blocages (autoroutes, péages, carrefours…) qui avaient été évacués."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
