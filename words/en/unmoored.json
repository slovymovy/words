{
    "word_family": [
        "moor",
        "mooring",
        "unmoor"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "198acf91-8574-3269-a80f-7d18535aa406",
                    "sense_definition": "Not attached or secured to an anchor or dock; floating freely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Left <w>unmoored</w>, the small boat gradually drifted out into the open sea.",
                            "target_lang_translations": {
                                "ru": "Оставшись <w>непривязанной</w>, лодочка постепенно уплыла в открытое море."
                            }
                        },
                        {
                            "text": "The storm snapped the lines, leaving several vessels <w>unmoored</w> in the harbor.",
                            "target_lang_translations": {
                                "ru": "Шторм оборвал канаты, оставив несколько судов в гавани <w>сорвавшимися со швартовых</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "adrift",
                        "unsecured"
                    ],
                    "antonyms": [
                        "moored",
                        "secured"
                    ],
                    "common_phrases": [
                        "left unmoored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не привязанный или не закрепленный на якоре или у причала; свободно дрейфующий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отшвартованный",
                                "target_lang_sense_clarification": "снятый со швартовых"
                            },
                            {
                                "target_lang_word": "непривязанный",
                                "target_lang_sense_clarification": "о лодке, судне"
                            },
                            {
                                "target_lang_word": "сорвавшийся со швартовых",
                                "target_lang_sense_clarification": "дрейфующий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6794d98-240a-3a95-b713-0ccadad84431",
                    "sense_definition": "Lacking stability, direction, or clear emotional connections; feeling detached or adrift.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After losing his long-term job, he felt completely <w>unmoored</w> and uncertain about the future.",
                            "target_lang_translations": {
                                "ru": "Потеряв постоянную работу, он почувствовал себя совершенно <w>потерянным</w> и неуверенным в будущем."
                            }
                        },
                        {
                            "text": "The characters in the novel are emotionally <w>unmoored</w> as they struggle to adapt to city life.",
                            "target_lang_translations": {
                                "ru": "Герои романа эмоционально <w>дезориентированы</w>, пытаясь приспособиться к городской жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "adrift",
                        "rootless",
                        "disoriented"
                    ],
                    "antonyms": [
                        "grounded",
                        "anchored",
                        "settled"
                    ],
                    "common_phrases": [
                        "feel unmoored",
                        "emotionally unmoored"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишенный стабильности, жизненных ориентиров или эмоциональной опоры; потерянный, выбитый из колеи."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потерянный",
                                "target_lang_sense_clarification": "утративший жизненные ориентиры"
                            },
                            {
                                "target_lang_word": "выбитый из колеи",
                                "target_lang_sense_clarification": "лишённый стабильности"
                            },
                            {
                                "target_lang_word": "оторванный от корней",
                                "target_lang_sense_clarification": "лишённый опоры или связей"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c86b38cd-2db4-389d-b2b1-b9b01ffd6fd0",
                    "sense_definition": "Simple past tense and past participle of <w>unmoor</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew quickly <w>unmoored</w> the ship before the harbor began to freeze.",
                            "target_lang_translations": {
                                "ru": "Экипаж быстро <w>отшвартовал</w> корабль, пока гавань не начала замерзать."
                            }
                        },
                        {
                            "text": "They had already <w>unmoored</w> the vessel when the captain gave the signal to depart.",
                            "target_lang_translations": {
                                "ru": "Они уже <w>отдали швартовы</w>, когда капитан подал сигнал к отплытию."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прошедшего времени и причастие прошедшего времени от глагола unmoor (отшвартовать, снять с якоря)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отшвартовал",
                                "target_lang_sense_clarification": "прошедшее время от unmoor"
                            },
                            {
                                "target_lang_word": "отдал швартовы",
                                "target_lang_sense_clarification": "отвязал судно"
                            },
                            {
                                "target_lang_word": "снял с якоря",
                                "target_lang_sense_clarification": "поднял якорь"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}