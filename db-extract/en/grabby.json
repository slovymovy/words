                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d0e5c1-2610-48c1-a49c-0c6f56d3dfd5",
                                "sense_id": "0df0c7c2-eb0f-3c67-b6aa-7c2c8dc8370b",
                                "text": "Nearly every bookstore contains a designated Colleen Hoover table, display case or section, stuffed with vague but grabby titles, like “All Your Perfects” and “Ugly Love.” I slorped down three of them in one week."
                            },
                            {
                                "example_id": "a71577b6-c984-44af-bb77-bc4aebbd6b27",
                                "sense_id": "0df0c7c2-eb0f-3c67-b6aa-7c2c8dc8370b",
                                "text": "By “this” he meant that the platform was filled with videos that have sensationalized titles, heavily edited content and grabby thumbnails, often featuring a person’s emotive face."
                            }
                        ]
                    }
