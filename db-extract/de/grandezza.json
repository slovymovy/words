                "senses": [
                    {
                        "sense_id": "08f3152f-2a67-3ae1-88f3-c960f892cc66",
                        "entry_id": "c778ef3f-a014-3cc3-affe-7c3e5a8014b2",
                        "glosses": [
                            "die Würde eines Granden, eben einer hochgestellten Persönlichkeit"
                        ],
                        "tags": [
                            "ursprünglich"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "da72e4af-5c95-3fbf-84d2-03bce8c0b1f8",
                        "entry_id": "c778ef3f-a014-3cc3-affe-7c3e5a8014b2",
                        "glosses": [
                            "das hoheitsvolle Benehmen, die steife Würde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a73ab34-3e6e-4a68-a251-7853339a50f0",
                                "sense_id": "da72e4af-5c95-3fbf-84d2-03bce8c0b1f8",
                                "text": "„Natürlich war der Pier eine strikt zivile Anlage für Vergnügungsdampfer und Personenfähren, aber für einen Augenblick zog Spicer in Erwägung, mit seinem Kriegsschiff kurz hinzufahren, anzulegen und die Ladies mit der gebotenen Grandezza an Bord zu nehmen.“"
                            },
                            {
                                "example_id": "b47a24ea-3f02-4079-999a-aaf6300e0ed3",
                                "sense_id": "da72e4af-5c95-3fbf-84d2-03bce8c0b1f8",
                                "text": "„Sie wandten sich mit der ganzen spanischen Grandezza uns zu, und der Gesandte machte mir ein Kompliment, das Doña Ignacia unendlich schmeichelte, obgleich sie tat, als habe sie es nicht gehört.“"
                            },
                            {
                                "example_id": "0a905c9e-e2e2-44db-8496-2b2293eaae8b",
                                "sense_id": "da72e4af-5c95-3fbf-84d2-03bce8c0b1f8",
                                "text": "„Mein Vater empfing Gäste, die nur zum Abendessen kamen, mit einer Grandezza, als würden sie die nächsten Wochen bei uns wohnen und gleich vom Hauspersonal in ihre Gemächer begleitet werden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
