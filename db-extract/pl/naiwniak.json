                                "target_senses": [
                                    {
                                        "sense_id": "838867a0-cc7e-3394-bc3c-d8372265b736",
                                        "entry_id": "c4227846-14d6-3f85-ad57-aed17a932e48",
                                        "glosses": [
                                            "To duplicate."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13fc6df3-5cb6-4fbb-99f6-44ef315f9519",
                                                "sense_id": "838867a0-cc7e-3394-bc3c-d8372265b736",
                                                "text": "Can you dupe this photo for me?"
                                            },
                                            {
                                                "example_id": "eb767e73-98b9-4d1a-a605-459ba30a20d1",
                                                "sense_id": "838867a0-cc7e-3394-bc3c-d8372265b736",
                                                "text": "That night, a shaken camera operator dupes the tape and leaks a copy to the press."
                                            }
