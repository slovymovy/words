    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9a1da166-4a0c-3792-a36f-bdf4daaec4ea",
                    "sense_definition": "Qui éprouve des difficultés à marcher en raison d'une lésion ou d'une infirmité à la jambe ou au pied.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux chien est devenu <w>boiteux</w> après s'être blessé à la patte."
                        },
                        {
                            "text": "Depuis son accident de ski, il a une démarche nettement <w>boiteuse</w>."
                        }
                    ]
                },
                {
                    "sense_id": "ad001b9d-8498-3536-bad7-1df97340ec8c",
                    "sense_definition": "Se dit d'un meuble dont l'un des pieds est plus court que les autres, ce qui le rend instable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette table <w>boiteuse</w> bouge chaque fois que j'essaie d'écrire dessus."
                        },
                        {
                            "text": "Il a calé la chaise <w>boiteuse</w> avec un morceau de carton plié."
                        }
                    ],
                    "synonyms": [
                        "bancal"
                    ],
                    "common_phrases": [
                        "table boiteuse"
                    ]
                },
                {
                    "sense_id": "c9e8bb7c-9750-3275-a573-8958a939c6c2",
                    "sense_definition": "Qui manque de solidité, de logique ou de cohérence ; mal assuré ou peu convaincant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstrait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a encore inventé une excuse <w>boiteuse</w> pour justifier son retard à la réunion."
                        },
                        {
                            "text": "Ce compromis <w>boiteux</w> risque de créer davantage de problèmes qu'il n'en résout."
                        }
                    ],
                    "synonyms": [
                        "bancal"
                    ],
                    "common_phrases": [
                        "excuse boiteuse",
                        "argument boiteux"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bde9241b-1579-3d15-974b-6ce5e39b12a3",
                    "sense_definition": "Personne qui a une démarche irrégulière ou qui boite.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "personne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin aide le jeune <w>boiteux</w> à remarcher sans béquille."
                        },
                        {
                            "text": "Dans ce conte d'autrefois, un vieux <w>boiteux</w> traverse le village sous la pluie."
