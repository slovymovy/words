                    },
                    {
                        "translation_id": "3dc14e68-92d0-4790-8bff-ce955f2682dc",
                        "source_entry_id": "7fb650c9-4ef9-388c-aa86-165b71cd9252",
                        "source_sense_id": "a7c37ccc-d397-346b-aeb2-d7401fd104b8",
                        "source_sense_description": "vorübergehendes Gefängnis oder Arbeitslager für gefangene gegnerische Soldaten im Krieg",
                        "target_lang_word": "krijgsgevangenenkamp",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krijgsgevangenenkamp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f40cb39a-bd40-31df-9158-be1d0f330f20",
                                        "entry_id": "d45a2e0a-4bea-3a42-8a24-23b63c1eba51",
                                        "glosses": [
                                            "kamp waar men gevangen soldaten van het vijandelijke leger gevangen houdt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f8ee941-a8dc-4800-8f28-3d4c4d0698d9",
                                                "sense_id": "f40cb39a-bd40-31df-9158-be1d0f330f20",
                                                "text": "Een groep van vijftig officieren van de Britse luchtmacht is te voet op weg van het voormalige krijgsgevangenenkamp Stalag Luft III in Polen naar een oorlogsbegraafplaats, ook in Polen. Daarmee herdenken zij het 70-jarige jubileum van The Great Escape en de vijftig geallieerden die tijdens die ontsnapping werden betrapt en geëxecuteerd."
                                            },
                                            {
                                                "example_id": "682c8504-2820-455e-a2d9-4b1f64e0d46f",
                                                "sense_id": "f40cb39a-bd40-31df-9158-be1d0f330f20",
                                                "text": "Bergen-Belsen, in Noord-Duitsland, werd in 1940 ingericht om dienst te doen als krijgsgevangenenkamp. Met name Russische krijgsgevangenen leefden hier onder erbarmelijke omstandigheden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1db82178-e5da-403e-a427-989c137dd3a1",
                        "source_entry_id": "7fb650c9-4ef9-388c-aa86-165b71cd9252",
                        "source_sense_id": "a7c37ccc-d397-346b-aeb2-d7401fd104b8",
                        "source_sense_description": "vorübergehendes Gefängnis oder Arbeitslager für gefangene gegnerische Soldaten im Krieg",
                        "target_lang_word": "krijgsgevangenkamp",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "krijgsgevangenkamp",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "503e0cae-4582-33ec-9e08-be2f825ff37b",
                                        "entry_id": "648f54e6-2e52-32a8-a83f-72e3bcd5b79f",
                                        "glosses": [
                                            "plaats waar een groep gevangen vijandelijke militairen tijdens een oorlog worden vastgehouden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c807b3ca-2529-41bd-99c0-d93305ba8830",
                                                "sense_id": "503e0cae-4582-33ec-9e08-be2f825ff37b",
                                                "text": "\"Ik kwam terecht in Tjimahi, een heel groot krijgsgevangenkamp\", vertelt Fokkens. \"De dag voor we arriveerden waren er twee jongens gefusilleerd. Die waren 's nachts over de omheining geklommen en gepakt. De volgende dag zijn ze doodgeschoten. Het was daar zwaar. Als je ooit bent getrapt en vernederd, dan vergeet je dat nooit meer. Niet dat het me dagelijks overkwam, maar ik ben wel eens aan de beurt geweest.\""
                                            },
                                            {
                                                "example_id": "b9544883-e1d8-4421-84aa-1bf18f6c61e9",
                                                "sense_id": "503e0cae-4582-33ec-9e08-be2f825ff37b",
                                                "text": "In het toestel zaten zes bemanningsleden. Gezagvoerder Vilem Bufka heeft als enige de crash overleefd. Hij kon zichzelf met een parachute in veiligheid brengen. Bufka werd door de Duitsers gevangengenomen en bleef tot het einde van de oorlog opgesloten in krijgsgevangenkamp Stalag Luft III. Hij overleed in 1967, kort nadat hij een boek over zijn geschiedenis had geschreven."
                                            }
