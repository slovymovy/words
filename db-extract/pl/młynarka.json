                                        "sense_id": "789dac71-73aa-3fe5-9fa0-b47fe96e56e4",
                                        "entry_id": "c379b2ef-a779-34bc-876b-5a7f0c99197a",
                                        "glosses": [
                                            "Femme dont la profession est de moudre de la farine de céréales ou de l’huile en utilisant un moulin ou une minoterie, qu’elle possède ou qu’elle exploite."
                                        ],
                                        "tags": [
                                            "Meunerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd182aa9-fdb9-4c0b-9937-4aff16f8ad34",
                                                "sense_id": "789dac71-73aa-3fe5-9fa0-b47fe96e56e4",
                                                "text": "Au Moulin de Marcy, au Molay-Littry (Calvados), les visiteurs sont souvent accueillis par Agnès Marie, agent du patrimoine, mais aussi meunière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "430999fb-20cd-363f-85e7-72f2b6e737cf",
                                        "entry_id": "c379b2ef-a779-34bc-876b-5a7f0c99197a",
                                        "glosses": [
                                            "Épouse d’un meunier."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc7aeb12-f797-3869-bf1b-a0dcaf23ef50",
                                        "entry_id": "c379b2ef-a779-34bc-876b-5a7f0c99197a",
                                        "glosses": [
                                            "Nom vernaculaire utilisé pour désigner la mésange bleue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33b1a482-b437-4e29-a98e-22161509aa7a",
                                                "sense_id": "dc7aeb12-f797-3869-bf1b-a0dcaf23ef50",
                                                "text": "Cette jolie Mésange doit sa dénomination de Meunière au bleu ou au bleuâtre de sa livrée, couleurs généralement adoptées par les meuniers de la Savoie dans leur parure, ainsi qu'à son habitude de se tenir fréquemment dans le voisinage des moulins, sur les arbres qui bordent l'eau qui les fait moudre."
                                            }
                                        ]
                                    }
                                ]
                            },
