                        "sense_id": "7d1e6d8e-84c4-338f-bf92-757be1d78535",
                        "entry_id": "a164e888-23f2-38ea-bee5-80d5a260d86b",
                        "glosses": [
                            "het zich verkleden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "793cd339-56d8-4cb1-b392-aba9aeba595b",
                                "sense_id": "7d1e6d8e-84c4-338f-bf92-757be1d78535",
                                "text": "Voor veel Japanners is Halloween een excuus voor een uitbundige verkleedpartij. Mooi zijn is populairder dan griezel en gruwel. Geen heksen, weinig monsters, relatief weinig bloed, maar wel veel Disney-prinsessen."
                            }
                        ]
