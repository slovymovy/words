                        "examples": [
                            {
                                "example_id": "2656f5bd-7a88-4693-86a0-6cf496644d59",
                                "sense_id": "94b3b0f2-efa3-3bc2-ba4a-02504b3b7fdd",
                                "text": "Buma/Stemra heeft drie hoofdcategorieën bepaald: achtergrondmuziek, internetradio en on-demand. Op de website van de auteursrechtenorganisatie (www.bumastemra.nl) is te zien hoeveel per categorie moet worden betaald voor muziek op internet. Het is echt op maat gemaakt, dus we kunnen niet makkelijk per hoofdcategorie aangeven hoeveel er moet worden betaald, aldus de zegsvrouw."
                            },
                            {
                                "example_id": "ecf008ed-77a7-4f92-9c17-f202d1634e3e",
                                "sense_id": "94b3b0f2-efa3-3bc2-ba4a-02504b3b7fdd",
                                "text": "De film over de vriendschap tussen een Waalse en een Vlaamse drinkebroer in de marge van de Belgische samenleving is genomineerd in de hoofdcategorie Competition for feature-length documentary."
                            },
                            {
                                "example_id": "5c1b2842-f319-4108-9092-3d5e360da37f",
                                "sense_id": "94b3b0f2-efa3-3bc2-ba4a-02504b3b7fdd",
                                "text": "Op dit moment moet namelijk op het declaratieformulier de hoofdcategorie staan; depressieve stoornissen, eetstoornissen, aan alcohol gebonden stoornissen, aandachtstekort- en gedragsstoornissen, aandachtstekort- of gedragsstoornissen."
                            }
                        ]
