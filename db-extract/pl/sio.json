                        "entry_id": "d5ea7e75-4882-3b39-9b77-de121cf1b296",
                        "glosses": [
                            "obiekt bardziej odległy w przestrzeni lub czasie niż ten, który jest bliżej (tu)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "edad62bb-c853-4067-9abf-91a80856751a",
                                "sense_id": "67a7e9c1-ce16-3387-96b7-22b3d79e7551",
                                "text": "Ni to ni sio."
                            },
                            {
                                "example_id": "ae072054-5834-4ef9-bdd5-5eec82816deb",
                                "sense_id": "67a7e9c1-ce16-3387-96b7-22b3d79e7551",
                                "text": "Nie było tej, siej ani owej, ale zastałem szefową."
                            },
                            {
                                "example_id": "bb597482-eb1a-428f-9ece-1c5a077a7457",
                                "sense_id": "67a7e9c1-ce16-3387-96b7-22b3d79e7551",
                                "text": "Fachowcy przyszli, ale nie było tego, siego i owego, więc sobie poszli."
                            },
                            {
                                "example_id": "e7d19cb1-a598-4c28-be20-a73410a7b65b",
                                "sense_id": "67a7e9c1-ce16-3387-96b7-22b3d79e7551",
                                "text": "Tego, siego i owego, i wszystkiego najlepszego!"
                            },
                            {
                                "example_id": "1d9e715d-5100-40b3-8c11-66954d22c03d",
                                "sense_id": "67a7e9c1-ce16-3387-96b7-22b3d79e7551",
                                "text": "Do Siego Roku!"
                            }
                        ],
