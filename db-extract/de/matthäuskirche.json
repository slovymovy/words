                "senses": [
                    {
                        "sense_id": "2e2dcda6-d3e8-3b92-b2f8-389585b35524",
                        "entry_id": "46248c88-8d05-360c-87de-9b89cda29242",
                        "glosses": [
                            "Gotteshaus zu Ehren des Evangelisten Matthäus ^(→ WP), das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70979ee5-1737-43f8-a6e5-f561331d8580",
                                "sense_id": "2e2dcda6-d3e8-3b92-b2f8-389585b35524",
                                "text": "„Die Beethoven-Oberschule wirkt mit Großem Chor, Oberstufenchor und Orchester an dem Weihnachtsmusizieren Steglitzer Schulen in der Matthäuskirche mit.“"
                            },
                            {
                                "example_id": "c0c8577a-1464-41e6-b36f-c5f886d0b006",
                                "sense_id": "2e2dcda6-d3e8-3b92-b2f8-389585b35524",
                                "text": "„Von welcher Matthäuskirche ist hier die Rede? Es gibt schließlich ungezählte Matthäuskirchen in Deutschland. Eine Ortsangabe wäre darum höchst willkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
