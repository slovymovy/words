                "senses": [
                    {
                        "sense_id": "c798b996-7f87-32ed-baf6-4cee10a79a80",
                        "entry_id": "5f85e0df-50a9-3167-8a07-c46a220f1bc1",
                        "glosses": [
                            "die jüngste Ära des Proterozoikums von 542 bis 1000 Millionen Jahren vor unserer Zeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "10775283-6e45-4cb8-bae1-25b67b37a9e0",
                                "sense_id": "c798b996-7f87-32ed-baf6-4cee10a79a80",
                                "text": "„Das Neoproterozoikum ist der jüngste Abschnitt des Proterozoikums.“"
                            },
                            {
                                "example_id": "efb18c73-0442-4fda-823e-d3730d943771",
                                "sense_id": "c798b996-7f87-32ed-baf6-4cee10a79a80",
                                "text": "„Im höheren Neoproterozoikum (Cryogenium) erfolgte eine rasche Abkühlung des Weltklimas, verbunden mit einer Vereisung, welcher zur Ausbreitung von Gletscherablagerungen bis weit in die Tropen führte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
