                        "glosses": [
                            "A female votary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d26db18-edf4-4448-9524-e1c9fb27657a",
                                "sense_id": "5605b896-64fd-3bc7-a261-9ed53e0338f0",
                                "text": "a votaress of the order"
                            },
                            {
                                "example_id": "003088b5-a994-4ed0-89bc-ad578f4393c6",
                                "sense_id": "5605b896-64fd-3bc7-a261-9ed53e0338f0",
                                "text": "His seeming rescue by a votaress of the high priestess of the sun had been but a part of the mimicry of their heathen ceremony—the sun looking down upon him through the opening at the top of the court had claimed him as his own, and the priestess had come from the inner temple to save him from the polluting hands of worldlings—to save him as a human offering to their flaming deity."
                            },
                            {
                                "example_id": "489410ce-f8e6-44cf-b35b-816414bddffe",
                                "sense_id": "5605b896-64fd-3bc7-a261-9ed53e0338f0",
                                "text": "Madness grew in the eyes of the capering votaress and was reflected in the eyes of the watchers."
                            },
                            {
                                "example_id": "941b292e-bd0f-4217-b58f-6396b8804ac3",
                                "sense_id": "5605b896-64fd-3bc7-a261-9ed53e0338f0",
                                "text": "Aminta, of course, falls in love with Sylvia at first sight, and she, chaste votaress of Diana, is outraged."
                            }
                        ]
                    }
                ],
