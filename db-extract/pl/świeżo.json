                        "examples": [
                            {
                                "example_id": "f6ca7151-2023-4cde-a676-96591d0e281e",
                                "sense_id": "26cf4130-d812-3aa6-adeb-8045f2bdadfd",
                                "text": "Tymczasem Ptyś czeka na kolejne świeżo wyklute pisklęta"
                            },
                            {
                                "example_id": "52d427a1-dcca-499d-aa7a-d17df818a056",
                                "sense_id": "26cf4130-d812-3aa6-adeb-8045f2bdadfd",
                                "text": "Ale o krwi tej, co się świeżo lała, / O łzach, któremi płynie Polska cała, / O sławie, która jeszcze nie przebrzmiała - / O nich pomyślić - nie mieliśmy duszy!…"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "cf45449b-6b7c-3a9a-8353-11fe35686456",
                        "entry_id": "0b8af005-e39a-3f81-8869-11e61a3f506e",
                        "glosses": [
                            "zdrowo, młodo"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ea8354c-39cd-4bc1-ab0a-d9af41b5bd8b",
                                "sense_id": "cf45449b-6b7c-3a9a-8353-11fe35686456",
                                "text": "Nasza szefowa, pani Magdalena, wciąż wygląda bardzo świeżo, mimo że ma prawie 60 lat i jest matką dwójki dorosłych dzieci."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "cada280f-d1e9-3ec0-a242-29c0450021a0",
                        "entry_id": "0b8af005-e39a-3f81-8869-11e61a3f506e",
                        "glosses": [
                            "czysto, schludnie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee6d8256-a5b6-419c-9fb2-5201613970c1",
                                "sense_id": "cada280f-d1e9-3ec0-a242-29c0450021a0",
                                "text": "Dlatego trzeba poświęcać jej coraz więcej uwagi. Nie tylko po to, by być piękną, ale przede wszystkim, by wyglądać świeżo i zdrowo"
                            },
                            {
                                "example_id": "801aa476-bf71-4549-94c5-2d076ef5b6a0",
                                "sense_id": "cada280f-d1e9-3ec0-a242-29c0450021a0",
                                "text": "Uwielbiamy mężczyzn wyglądających świeżo i czysto"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
