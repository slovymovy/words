                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звездный",
                                "target_lang_sense_clarification": "относящийся к звездам, космический"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39194e48-9e33-3859-a72f-0e2b5b3e856f",
                    "sense_definition": "mający kształt gwiazdy",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kształt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na suficie zamontowano <w>gwiazdowy</w> wzór z lampek.",
                            "target_lang_translations": {
                                "ru": "На потолке смонтировали <w>звездчатый</w> узор из лампочек."
                            }
