                "senses": [
                    {
                        "sense_id": "a812e04d-d7c9-3e0b-925f-d31ef4e04c15",
                        "entry_id": "9535152e-9a8f-3336-90dc-9d19e2d9bd2a",
                        "glosses": [
                            "Of eyes or people/animals: blinking repeatedly, prone to blink."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3cf29a4-5107-4936-af56-8bc76f9dbf85",
                                "sense_id": "a812e04d-d7c9-3e0b-925f-d31ef4e04c15",
                                "text": "She sat stuffed into a small chair and listened with an intense and very blinky sort of concentration."
                            },
                            {
                                "example_id": "6e85c31a-a4b5-4095-8aa5-07c2fd10d6ed",
                                "sense_id": "a812e04d-d7c9-3e0b-925f-d31ef4e04c15",
                                "text": "The door of the cabin creaked. Smith's blinky eye peeped out to see if he had dreamed us."
                            },
                            {
                                "example_id": "ced6cad9-a4a6-4fb1-b0ac-3ac8fb005121",
                                "sense_id": "a812e04d-d7c9-3e0b-925f-d31ef4e04c15",
                                "text": "He was a literature professor, neurotic and blinky behind his glasses […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "d8f11bb3-90e6-39db-a362-e1a8bc6d318e",
                        "entry_id": "9535152e-9a8f-3336-90dc-9d19e2d9bd2a",
                        "glosses": [
                            "flickery, prone to flicker or flash (of lights, shining objects)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e9688dc-a4cf-49b5-98b6-c82ccd7af676",
                                "sense_id": "d8f11bb3-90e6-39db-a362-e1a8bc6d318e",
                                "text": "She struck a match and relighted the candle and everyone looked at each other by its winky, blinky light."
                            },
                            {
                                "example_id": "5de3f9b0-b3f6-498d-b7cd-665a0ee539db",
                                "sense_id": "d8f11bb3-90e6-39db-a362-e1a8bc6d318e",
                                "text": "[…] the rosary beads that hung from her belt like a zoot-suiter's key chain were blinky bright […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "cf0bc277-13c0-3e8c-ac03-df47268e2ac3",
                        "entry_id": "9535152e-9a8f-3336-90dc-9d19e2d9bd2a",
                        "glosses": [
                            "Of milk: turned somewhat sour."
                        ],
                        "tags": [
                            "US",
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "0a06958b-df9f-4b89-a64b-1f32bdc4606f",
                                "sense_id": "cf0bc277-13c0-3e8c-ac03-df47268e2ac3",
                                "text": "No proper place for cooling milk in summer meant not only blinky milk unfit to drink, but no sweet cream for the cream jug that most of them had, and neither good butter nor buttermilk could come from milk not properly cooled."
                            },
                            {
                                "example_id": "d8777396-62c2-4a28-878d-05556145105f",
                                "sense_id": "cf0bc277-13c0-3e8c-ac03-df47268e2ac3",
                                "text": "She took a swallow of milk and made a face. \"This milk is blinky.\"\nMrs. Willet frowned. 'It shouldn't be. I just got it yesterday.\" She opened the top of the icebox and looked into the ice compartment. She groaned. \"The block of ice I got yesterday is almost melted.\""
                            },
                            {
                                "example_id": "f3f90a40-1b6e-4b97-bb9f-62fe6e48a749",
                                "sense_id": "cf0bc277-13c0-3e8c-ac03-df47268e2ac3",
                                "text": "I mean really, who needs a date stamped on the jug to tell you when milk has gone bad? It’s got a built-in warning system. First, you get that little whang in the taste. It’s gone blinky. Time to think about getting more."
                            }
                        ]
                    }
                ],
