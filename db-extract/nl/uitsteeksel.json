                                    {
                                        "sense_id": "95e7ddc2-4527-3b9f-a6fd-9148ad5c7d55",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "The preservation of the properties of lexical items while generating the phrase structure of a sentence. See Projection principle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c674de31-0a33-38de-b560-af0151420df8",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "A supposed mechanism for the transmutation of large quantities of base metals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e448495-1967-4ed7-b17b-9cf1a4c7b5df",
                                                "sense_id": "c674de31-0a33-38de-b560-af0151420df8",
                                                "text": "I speak not here of Projection, whereby one part of an Aurifick Powder is said to turn I know not how many 100 or 1000 parts of an ignobler metal into silver or gold […]"
                                            },
                                            {
                                                "example_id": "611750fc-2fdf-4a0d-9c4a-67dd0278d412",
                                                "sense_id": "c674de31-0a33-38de-b560-af0151420df8",
                                                "text": "But yet I would that every one should understand me aright, and not count me so simple, as if I did liken or compare my Aurum Potabile with that great Stone of the Philosophers, which transmutes vast quantities of imperfect metals into most pure Gold by projection […]"
                                            },
                                            {
                                                "example_id": "99bdcde1-1085-4e93-a6c8-b1c99ab2a81b",
                                                "sense_id": "c674de31-0a33-38de-b560-af0151420df8",
                                                "text": "[Helmont] says, on another occasion, that an adept, after a few days of acquaintance, presented him with half a grain of the powder of projection, with which he transmuted nine ounces of quicksilver into pure gold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25f479c9-1f25-31f0-acac-bf3b0cf09334",
                                        "entry_id": "c3eb775c-9223-335b-84ed-04a7188ae301",
                                        "glosses": [
                                            "The distance the scent of a perfume radiates off the skin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4062818b-fd96-4438-b561-4f31e81d93c5",
                                                "sense_id": "25f479c9-1f25-31f0-acac-bf3b0cf09334",
                                                "text": "SKIN SCENT¶ A fragrance with low projection. One which stays close to the skin because the materials used to make it are less volatile."
                                            }
                                        ]
                                    }
                                ]
                            }
