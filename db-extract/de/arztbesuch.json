                "senses": [
                    {
                        "sense_id": "6c7ed6ff-eca4-3cc1-b365-981da4cc0e39",
                        "entry_id": "0954e29a-9732-3327-b069-de3ebd0b568f",
                        "glosses": [
                            "das Aufsuchen eines Mediziners"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca93a984-375f-407e-baac-1124dffc65d3",
                                "sense_id": "6c7ed6ff-eca4-3cc1-b365-981da4cc0e39",
                                "text": "„Ziel der Einführung einer Praxisgebühr war die finanzielle Entlastung der Krankenkassen durch Stärkung der Eigenverantwortung und durch Reduzierung der Arztbesuche von Versicherten.“"
                            },
                            {
                                "example_id": "e6f8c981-5128-481d-85a3-c680ddc6661f",
                                "sense_id": "6c7ed6ff-eca4-3cc1-b365-981da4cc0e39",
                                "text": "„In vielen Fällen wird von den Betroffenen das pathologische Essverhalten beim Arztbesuch verheimlicht.“"
                            },
                            {
                                "example_id": "4b5539f0-ec82-4edc-b45c-8fff2e7313df",
                                "sense_id": "6c7ed6ff-eca4-3cc1-b365-981da4cc0e39",
                                "text": "„Ich erinnerte mich an einen Arztbesuch als Jugendlicher.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7a201dd0-3b87-31a6-bff1-e6969f010af5",
                        "entry_id": "0954e29a-9732-3327-b069-de3ebd0b568f",
                        "glosses": [
                            "das Vorbeischauen eines Mediziners bei jemandem zu Hause"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9f8871a0-c4f6-4e0c-8d9b-9e53877dab8c",
                                "sense_id": "7a201dd0-3b87-31a6-bff1-e6969f010af5",
                                "text": "In den abgelegenen Tälern ist der Arztbesuch des Hausarztes bei den älteren Menschen die einzige Möglichkeit bei gesundheitlichen Beschwerden, wenn sie nicht mehr mobil sind."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
