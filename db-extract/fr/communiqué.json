                    {
                        "translation_id": "ab594724-90ae-4c52-a4c2-7c0b02bd6ea0",
                        "source_entry_id": "9385a2ca-5c4d-3a68-b43c-35511d233ccd",
                        "target_lang_word": "Mitteilung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitteilung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73f35ea7-9df4-329a-9749-73e73f29f57b",
                                        "entry_id": "024a7cb7-06ef-3324-8031-0ca2a74d71ce",
                                        "glosses": [
                                            "Nachricht über etwas, Weitergabe einer Information"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3564c3bd-3be7-4362-9cb7-80d1588221af",
                                                "sense_id": "73f35ea7-9df4-329a-9749-73e73f29f57b",
                                                "text": "Die Mitteilung erhielt ich erst, nachdem ich die Tat vollbracht hatte."
                                            },
                                            {
                                                "example_id": "90867933-1987-4e0d-8796-d4b3b44680af",
                                                "sense_id": "73f35ea7-9df4-329a-9749-73e73f29f57b",
                                                "text": "Ich habe Ihnen eine unerfreuliche Mitteilung zu machen."
                                            },
                                            {
                                                "example_id": "6f13db22-e74f-4be7-9da1-4b2dc7fdb9f8",
                                                "sense_id": "73f35ea7-9df4-329a-9749-73e73f29f57b",
                                                "text": "Wichtige Mitteilung: Montag schließen wir schon um zwölf."
                                            },
                                            {
                                                "example_id": "5f91cb12-38db-442b-a035-3ba7f9459592",
                                                "sense_id": "73f35ea7-9df4-329a-9749-73e73f29f57b",
                                                "text": "Die Mitteilung an die GEMA muss vom Veranstalter ausgefüllt werden."
                                            },
                                            {
                                                "example_id": "fd8f5b6c-70b3-4d9a-bdde-0737c55d3e9f",
                                                "sense_id": "73f35ea7-9df4-329a-9749-73e73f29f57b",
                                                "text": "Über die Schwangerschaft müssen Sie dem Arbeitgeber eine Mitteilung machen."
                                            },
                                            {
                                                "example_id": "ce38cc1f-7534-4c4d-bcf9-7c8addaffe88",
                                                "sense_id": "73f35ea7-9df4-329a-9749-73e73f29f57b",
                                                "text": "„Die Prinzessin gab sich den Anschein, als könne sie in dieser Mitteilung ebenso wenig etwas Aussergewöhnliches erblicken, als wenn Pierre ihr erzählt hätte, er hätte Anna Semeonowna gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89805294-670c-484f-9ba4-fb5e46b61278",
                        "source_entry_id": "9385a2ca-5c4d-3a68-b43c-35511d233ccd",
                        "target_lang_word": "communiqué",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
