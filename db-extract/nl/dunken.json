                ],
                "senses": [
                    {
                        "sense_id": "b2c82d4c-4240-3324-9aab-fc9204387cd7",
                        "entry_id": "f86bc827-6a0f-3692-b39f-f3bbb21de77c",
                        "glosses": [
                            "voorkomen (het oordeel zijn van), als mening hebben"
                        ],
                        "tags": [
                            "copulative",
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "78bb1c00-7e5f-45ed-baa4-bff05039d9cf",
                                "sense_id": "b2c82d4c-4240-3324-9aab-fc9204387cd7",
                                "text": "Dat is, me dunkt, een hele klus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43bd0d30-e45c-4dd9-afd7-2a6d090235b3",
                        "source_entry_id": "f86bc827-6a0f-3692-b39f-f3bbb21de77c",
                        "source_sense_id": "b2c82d4c-4240-3324-9aab-fc9204387cd7",
                        "source_sense_description": "voorkomen",
                        "target_lang_word": "dünken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dünken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8dcb9b47-5055-3bf8-abab-fe2cf00971b9",
                                        "entry_id": "78b34260-aec0-3a2e-89da-0b4e0d430871",
                                        "glosses": [
                                            "von jemandem so wahrgenommen, empfunden werden"
                                        ],
                                        "tags": [
                                            "impersonal",
                                            "intransitive",
                                            "literary",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c1083a5-999b-4ff6-98fc-7b95db190955",
                                                "sense_id": "8dcb9b47-5055-3bf8-abab-fe2cf00971b9",
                                                "text": "„Mich dünkt, ich hör’ ein ganzes Chor / Von hundert tausend Narren sprechen.“"
                                            },
                                            {
                                                "example_id": "1d73443d-590b-4464-8f9e-b16261172c8f",
                                                "sense_id": "8dcb9b47-5055-3bf8-abab-fe2cf00971b9",
                                                "text": "„Mir dünkt das Leben süß.“"
                                            },
                                            {
                                                "example_id": "cd4883f1-54c9-4a82-b83a-161d3ebdb7bb",
                                                "sense_id": "8dcb9b47-5055-3bf8-abab-fe2cf00971b9",
                                                "text": "Mich deuchte, seine Majestät der Kaiser betrat den Raum."
                                            },
                                            {
                                                "example_id": "c6ef4298-ebd6-4da0-877b-0f23448d036d",
                                                "sense_id": "8dcb9b47-5055-3bf8-abab-fe2cf00971b9",
                                                "text": "„»Mir deuchte, die Toten stünden auf und sängen: Hosianna!«“"
                                            },
                                            {
                                                "example_id": "ace1ab06-4e9e-48fd-bf12-0d9526107d90",
                                                "sense_id": "8dcb9b47-5055-3bf8-abab-fe2cf00971b9",
                                                "text": "„Die gewöhnlichen Besuchsunterhaltungen dünkten ihr bald ganz unschmackhaft.“"
                                            },
                                            {
                                                "example_id": "04cc11a7-24c1-4987-ac10-d617dc3d3df5",
                                                "sense_id": "8dcb9b47-5055-3bf8-abab-fe2cf00971b9",
                                                "text": "„Also sagt mein Mann – das Andenken des Gerechten zum Segen – zu mir: »Glückelchen, was deucht dich, wenn wir den Jungen zu uns nehmen würden und ihn nach Danzig schicken? Ich seh ihn für einen klugen Jungen an.«“"
                                            },
                                            {
                                                "example_id": "31934edb-93d8-4a04-8e3e-f88217e6bdd5",
                                                "sense_id": "8dcb9b47-5055-3bf8-abab-fe2cf00971b9",
                                                "text": "„Dies wäre nun erledigt, dachte er mit einem Gefühl des Ärgers, das ihn selbst unverhältnismäßig dünkte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4fdf881c-8370-3b0e-a479-80b9536f5f33",
                                        "entry_id": "78b34260-aec0-3a2e-89da-0b4e0d430871",
                                        "glosses": [
                                            "hochmütig sein, überheblich sein; sich als jemand Besonderen betrachten"
                                        ],
                                        "tags": [
                                            "literary",
                                            "outdated",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "973091b8-a48f-4686-87ce-c6e7cef8a10c",
                                                "sense_id": "4fdf881c-8370-3b0e-a479-80b9536f5f33",
                                                "text": "„Wenn dich jemand will Weisheit lehren, so siehe in sein Angesicht. Dünket er sich noch, und sey er noch so gelehrt und noch so berühmt, laß ihn und gehe seiner Kundschaft müssig. Was einer nicht hat, das kann er auch nicht geben.“"
                                            },
                                            {
                                                "example_id": "0addb746-0a74-4e12-aa71-b5616d3a5d52",
                                                "sense_id": "4fdf881c-8370-3b0e-a479-80b9536f5f33",
                                                "text": "Er dünkt sich ein Held (ungebräuchlich: einen Helden)."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
