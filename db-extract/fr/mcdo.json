            {
                "entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                "word": "McDo",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e6c9aa41-c89f-4025-a911-f1776d426815",
                        "entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "McDos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e1cb368-413b-3683-9d77-edf9781b1b4e",
                        "entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                        "glosses": [
                            "McDonald’s, chaîne américaine de restaurants spécialisés dans les hamburgers."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3559f0e-16fb-43d4-bf94-d23909c5f191",
                                "sense_id": "1e1cb368-413b-3683-9d77-edf9781b1b4e",
                                "text": "« Ce sera le repas McDo le plus cher que ce passager ait jamais eu » de sa vie, a commenté le ministre australien de l’Agriculture, Murray Watt."
                            },
                            {
                                "example_id": "2da58a6a-aa6e-45a4-85a0-c121ed0383cf",
                                "sense_id": "1e1cb368-413b-3683-9d77-edf9781b1b4e",
                                "text": "Sauf que McDo, qui mise sur le poulet pour tailler des croupières à son concurrent KFC, s’inquiète pour l’avenir de ce bijou nutritionnel qu’est le nugget."
                            }
                        ]
                    },
                    {
                        "sense_id": "c253d275-c4bd-3447-9c5b-96845ddc3d1e",
                        "entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                        "glosses": [
                            "Restaurant de cette chaîne."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "821e90bc-b282-4e23-8b1c-c28d5a35eaf8",
                                "sense_id": "c253d275-c4bd-3447-9c5b-96845ddc3d1e",
                                "text": "La première fois, j’invite plutôt une fille au McDo ou au sushi, parce que le cadre est plus favorable. Question de déco, d’ambiance. Le grec, ça leur fait un peu peur. Mais une fois qu’on est ensemble, on peut y aller sans souci."
                            }
                        ]
                    },
                    {
                        "sense_id": "e5fdfa7d-7ade-324a-b8b0-ff11ac70bc35",
                        "entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                        "glosses": [
                            "Fast-food."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10754071-1ba9-4fe1-98d8-470b7afaa016",
                        "source_entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                        "source_sense_description": "McDonald’s (contraction)",
                        "target_lang_word": "Maccies",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maccies",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c2b7fbd-2ece-3fc3-a434-0e2c8d57d895",
                                        "entry_id": "fe04106d-47b5-3275-b99b-14b7c5ccae34",
                                        "glosses": [
                                            "McDonald's, or McDonald's food."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93cacc73-5e85-4ea0-94f5-b7e8ab37ec0b",
                                                "sense_id": "0c2b7fbd-2ece-3fc3-a434-0e2c8d57d895",
                                                "text": "She texted sayin' to put on my best trackies / Forget pot noodle ... time for Maccies!"
                                            },
                                            {
                                                "example_id": "2b9c84f1-ba5a-4054-94f0-2fd0cf8a7e92",
                                                "sense_id": "0c2b7fbd-2ece-3fc3-a434-0e2c8d57d895",
                                                "text": "We had five quid between us to get home and grab a Maccies or Wimpy at Lime Street on the way."
                                            },
                                            {
                                                "example_id": "bdcd1c2e-aac6-4eb7-aecb-d12bb6082dcd",
                                                "sense_id": "0c2b7fbd-2ece-3fc3-a434-0e2c8d57d895",
                                                "text": "He'd bring me a Maccies in the car, too, which was sweet of him, but it's also the reason I started piling on the weight."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "14fa81d0-67e5-4e2b-9e9b-068dbe5808f1",
                        "source_entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
                        "source_sense_description": "McDonald’s (contraction)",
                        "target_lang_word": "Maccy D's",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Maccy D's",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe7cbcf-702c-30e9-8764-5ae48bd622cd",
                                        "entry_id": "1b40022a-d8eb-3a6c-b96c-dd46874acde0",
                                        "glosses": [
                                            "McDonald's."
                                        ],
                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1515367-e233-4cc6-8310-c8e5a1d4d9f1",
                                                "sense_id": "1fe7cbcf-702c-30e9-8764-5ae48bd622cd",
                                                "text": "Mum would kill me if she saw me in Maccy D's for breakfast."
                                            },
                                            {
                                                "example_id": "1a52f74d-bfa9-48e3-a13c-5bc879ac3923",
                                                "sense_id": "1fe7cbcf-702c-30e9-8764-5ae48bd622cd",
                                                "text": "We sat in Maccy D's for a little while before she started work in the afternoon."
                                            },
                                            {
                                                "example_id": "87e22518-3028-431b-9c3c-6e6dfc71d29b",
                                                "sense_id": "1fe7cbcf-702c-30e9-8764-5ae48bd622cd",
                                                "text": "And anyway we went into the service station because he wanted a burger from Maccy D's and I wanted a Coke."
                                            },
                                            {
                                                "example_id": "9147c5fb-a02f-4651-9a5f-ccdc75132e8f",
                                                "sense_id": "1fe7cbcf-702c-30e9-8764-5ae48bd622cd",
                                                "text": "Tony H said: “Handy for something to eat simply .Great coffee. I like Macky Ds occasionally when I am out and about. It was clean and food was hot. So good!”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8cca8ba0-6070-4775-9e08-1794e24ceeda",
                        "source_entry_id": "46d04478-c992-353c-9f2a-d72cf38201b8",
