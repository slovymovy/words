                                "target_senses": [
                                    {
                                        "sense_id": "6a353506-bdc2-3fde-88f6-95a13ea4dd5f",
                                        "entry_id": "2a0a8aa0-9f53-3b67-84aa-ad4ad06daf85",
                                        "glosses": [
                                            "A horn used by hunters."
                                        ],
                                        "tags": [],
