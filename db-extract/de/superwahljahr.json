                "senses": [
                    {
                        "sense_id": "6b92cc34-09db-3d12-bd98-9efe45f47774",
                        "entry_id": "db969ec0-6452-338f-87c6-fe3c5d2265d8",
                        "glosses": [
                            "Jahr, in dem in einem Staat besonders viele Wahlen stattfinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81d11eba-09ae-40bb-9cb4-bbe56cc5aac2",
                                "sense_id": "6b92cc34-09db-3d12-bd98-9efe45f47774",
                                "text": "2009 gilt in Deutschland als ein Superwahljahr, denn es stehen Bundestagswahlen, fünf Landtagswahlen, acht Kommunalwahlen, Europawahlen und die Wahl zum Bundespräsidenten an."
                            },
                            {
                                "example_id": "406c300b-f92f-491f-b9cf-3422903dc31f",
                                "sense_id": "6b92cc34-09db-3d12-bd98-9efe45f47774",
                                "text": "„2024 ist mit 70 Wahlen weltweit ein Superwahljahr.“"
                            },
                            {
                                "example_id": "832a9bd6-175e-47f2-993f-49da06eb1ae6",
                                "sense_id": "6b92cc34-09db-3d12-bd98-9efe45f47774",
                                "text": "„Bei allen Unwägbarkeiten, die Wahlen mit sich bringen, eines steht für 2021 jetzt schon fest: Die Pandemie wird auch das Superwahljahr 2021 bestimmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
