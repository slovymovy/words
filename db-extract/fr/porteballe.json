                ],
                "senses": [
                    {
                        "sense_id": "0c00b87c-3f40-397a-9b5b-17aa04326063",
                        "entry_id": "e9a14fa7-2604-3d40-b947-cd7a7212df74",
                        "glosses": [
                            "Mercier ambulant qui portait sur son dos une balle où étaient ses marchandises."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "91d6abb6-1640-45f5-9b56-68dd489ebdb5",
                                "sense_id": "0c00b87c-3f40-397a-9b5b-17aa04326063",
                                "text": "Les porteballes vendaient de tout, chiffons, livres ou almanachs, potions en tout genre…"
                            },
                            {
                                "example_id": "0d270cdb-2c2d-41f0-b1c7-28827665f3f0",
                                "sense_id": "0c00b87c-3f40-397a-9b5b-17aa04326063",
                                "text": "Comme il approchait, au petit pas, du château, non… du lieu de leur dernière couchée, il passe à côté de lui un de ces merciers ambulants qu’on appelle porteballes, et qui lui crie: \"Monsieur le chevalier, jarretières, ceintures, cordons de montre, tabatières du dernier goût, vraies jaback, bagues, cachets de montre."
                            },
                            {
                                "example_id": "11ca4fbc-b429-4f38-a70a-1fa6f0c2f176",
                                "sense_id": "0c00b87c-3f40-397a-9b5b-17aa04326063",
                                "text": "On ignorait ce qu’il avait été jadis : porteballe, disaient les uns, banquier à Routot, selon les autres."
                            },
                            {
                                "example_id": "230c6b1d-a796-4dcd-bdbd-5dd2896369e7",
                                "sense_id": "0c00b87c-3f40-397a-9b5b-17aa04326063",
                                "text": "Ils vendent le temps sous toutes ses formes, celui qui s’écoule, celui qu’il fait, celui qu’il fera, comme d’autres porteballes vendent des paniers, des tricots ou des cotonnades."
                            }
                        ]
                    }
                ],
