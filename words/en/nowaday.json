    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9e588c5c-0795-337d-bf65-498ead575f0f",
                    "sense_definition": "Alternative form of <w>nowadays</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many young people <w>nowaday</w> prefer to work remotely from home.",
                            "target_lang_translations": {
                                "tr": "<w>Günümüzde</w> birçok genç evden uzaktan çalışmayı tercih ediyor."
                            }
                        },
                        {
                            "text": "People are starting to realize that lifestyle habits <w>nowaday</w> affect long-term health.",
                            "target_lang_translations": {
                                "tr": "İnsanlar <w>günümüzdeki</w> yaşam tarzı alışkanlıklarının uzun vadeli sağlığı etkilediğini anlamaya başlıyor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "alternative spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "\"Nowadays\" kelimesinin alternatif yazım şekli."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "günümüzde",
                                "target_lang_sense_clarification": "günümüz zaman diliminde"
                            },
                            {
                                "target_lang_word": "bugünlerde",
                                "target_lang_sense_clarification": "şu sıralar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2bc0ac78-806b-3b8d-9d43-925e093607b2",
                    "sense_definition": "Existing at the present time; current or contemporary.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These <w>nowaday</w> problems require modern solutions and innovative thinking.",
                            "target_lang_translations": {
                                "tr": "Bu <w>günümüz</w> sorunları modern çözümler ve yenilikçi düşünce gerektiriyor."
                            }
                        },
                        {
                            "text": "The author focuses on <w>nowaday</w> worries rather than historical events.",
                            "target_lang_translations": {
                                "tr": "Yazar, tarihi olaylardan ziyade <w>şimdiki</w> endişelere odaklanıyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "current",
                        "present"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rare or archaic usage as an adjective"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Şu anki zamanda var olan; mevcut veya çağdaş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "günümüz",
                                "target_lang_sense_clarification": "çağdaş, mevcut olan"
                            },
                            {
                                "target_lang_word": "şimdiki",
                                "target_lang_sense_clarification": "şu an var olan"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2be38fdf-28db-3adb-a497-3478241c27e4",
                    "sense_definition": "The present era or contemporary times.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He often contrasts the traditions of the long ago with the habits of the <w>nowaday</w>.",
                            "target_lang_translations": {
                                "tr": "Eski zamanların geleneklerini sıklıkla <w>günümüzün</w> alışkanlıklarıyla karşılaştırır."
                            }
                        },
                        {
                            "text": "The technology of the <w>nowaday</w> makes global communication almost instantaneous.",
                            "target_lang_translations": {
                                "tr": "<w>Günümüzün</w> teknolojisi, küresel iletişimi neredeyse anlık hale getiriyor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rare usage as a noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Mevcut çağ veya çağdaş zamanlar."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "günümüz",
                                "target_lang_sense_clarification": "çağımız, şimdiki zaman"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}