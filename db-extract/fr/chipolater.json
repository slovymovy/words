                "senses": [
                    {
                        "sense_id": "163495c4-722a-397e-a8d1-add2ff59ce80",
                        "entry_id": "cbedeefc-3b48-37c6-bb69-382ac588d92f",
                        "glosses": [
                            "Masturber (le pénis)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69eac787-5f53-4a54-b7d3-fa619eabcb90",
                                "sense_id": "163495c4-722a-397e-a8d1-add2ff59ce80",
                                "text": "Au plus fort de mon anéantissement, elle m’a chipolaté la membrane, portant icelle au point de dureté de l’iridium ; puis, jugeant ce panoche paré pour les entreprises les plus hardies, s’est désaboulée les régions lunaires pour une chevauchée en comparaison de laquelle, celles de John Wayne dans ses ouesternes de mes deux n’étaient que courses en fauteuil roulant d’hémiplégique."
                            },
                            {
                                "example_id": "b257d884-d5a2-4a0f-9298-fa46595c3174",
                                "sense_id": "163495c4-722a-397e-a8d1-add2ff59ce80",
                                "text": "Alors bon, elle va chipolater l’ancien ministre."
                            }
                        ]
                    }
