                        "form": "statismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6e0e7ec1-5609-3ca9-9f06-9703152999ea",
                        "entry_id": "c43fe9d2-429b-374c-a404-0b17da605985",
                        "glosses": [
                            "Caractère d'une œuvre littéraire ou audiovisuelle qui, par choix artistique, procédé, ou en raison de son sujet, est statique, c'est-à-dire qu'on y emploie pas l'action, le mouvement, la péripétie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fa8e24f-98af-4f8d-ad9c-a76f6c483dfe",
                                "sense_id": "6e0e7ec1-5609-3ca9-9f06-9703152999ea",
                                "text": "En 1923, L'inhumaine, prétentieuse architecture autour d'un scénario de Mac Orlan, fruit d'une collaboration de Mallet-Stevens, Cavalcanti et Fernand Léger, en revenait au statisme de L'assassinat du duc de Guise, mais apprêté à la sauce cubisto-modern-style."
                            },
                            {
                                "example_id": "22eac443-61b3-4608-b280-1e678dbde71f",
                                "sense_id": "6e0e7ec1-5609-3ca9-9f06-9703152999ea",
                                "text": "Pour des déclinaisons enfantines, des Mickey ou des Tintin, c’était presque pire, avec une sensation de lenteur et de statisme antinomiques de la bande dessinée, où l’on possède en fait toute la page."
                            }
                        ]
                    },
                    {
                        "sense_id": "25586cec-25ed-316a-a476-b918f8cc0e7a",
                        "entry_id": "c43fe9d2-429b-374c-a404-0b17da605985",
                        "glosses": [
                            "Rapport entre la marche à vide et à charge d'un moteur."
                        ],
                        "tags": [
                            "Automatique"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5652e02-6228-4c13-938d-cbd6ae160e60",
                        "source_entry_id": "c43fe9d2-429b-374c-a404-0b17da605985",
                        "target_lang_word": "stasis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stasis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aeae9453-261f-34d3-8400-a4e5ae62d467",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "A slackening or arrest of the blood current, due not to a lessening of the heart’s beat, but to some abnormal resistance of the capillary walls."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "Inactivity; a freezing, or state of motionlessness."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "deed2da5-323b-4a0e-bfef-3e6b71fecfa9",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "His company was sized for growth, not stasis."
                                            },
                                            {
                                                "example_id": "d2f83f2b-05aa-4168-a170-d0e2174209ca",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "Boredom is an instrument of social control. Power is the power to impose boredom, to command stasis, to combine this stasis with anguish."
                                            },
                                            {
                                                "example_id": "04d0915e-d89b-4741-9ace-1f640cc41124",
                                                "sense_id": "4363f69c-62ca-36f7-bbf3-0b3d21627f2a",
                                                "text": "Or will Americans remain hunkered forever—as confused and anxious and paralyzed as we were before 2020—descend into digital feudalism, and retreat back into our cocoons of nostalgia and cultural stasis, providing the illusion that nothing much is changing or ever can change?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7d4a1eb-ba53-3085-b0fd-f249da5d1465",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "A technology allowing something to be artificially frozen in time, so that it does not age or change."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "739ffee4-e248-4e73-b316-216baaa34cf4",
                                                "sense_id": "f7d4a1eb-ba53-3085-b0fd-f249da5d1465",
                                                "text": "I was in stasis for forty years before I woke up orbiting this poxy planet!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f88955c6-3104-3e15-ab32-21bcab8c7a4f",
                                        "entry_id": "d8cde244-5fc1-395e-9bcc-2f2fc17a63d7",
                                        "glosses": [
                                            "One of the sections of a cathisma or portion of the psalter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
