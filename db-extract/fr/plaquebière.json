                                                "sense_id": "f66d8b4a-e7d8-3531-b93b-faf5125230f9",
                                                "text": "Größter Nutzer von Moltebeeren ist Finnland."
                                            },
                                            {
                                                "example_id": "cd29701d-7920-4519-8743-bd56661b1cad",
                                                "sense_id": "f66d8b4a-e7d8-3531-b93b-faf5125230f9",
