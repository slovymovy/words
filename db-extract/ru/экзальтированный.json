                    },
                    {
                        "translation_id": "13113391-f9a5-4f32-9c9e-dea1e6297bd4",
                        "source_entry_id": "1f4de29a-89eb-3fd4-9dc9-08d6d9ab4b43",
                        "target_lang_word": "rapturous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapturous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3365735-d66a-3059-9102-a792332ca0c7",
                                        "entry_id": "c8de64bf-bc5e-3e68-ad14-891143d82b31",
                                        "glosses": [
                                            "Full of rapture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ee67ef9-d785-4c44-8b03-b284c14cd87c",
                                                "sense_id": "c3365735-d66a-3059-9102-a792332ca0c7",
                                                "text": "the rapturous applause"
                                            },
                                            {
                                                "example_id": "c680fa76-bea6-444e-9a63-5531566ed216",
                                                "sense_id": "c3365735-d66a-3059-9102-a792332ca0c7",
                                                "text": "the rapturous emotions on the pulpit"
                                            },
                                            {
                                                "example_id": "2b5740a6-2af8-4512-8d0c-9bde11b909d6",
                                                "sense_id": "c3365735-d66a-3059-9102-a792332ca0c7",
                                                "text": "Díaz told a rapturous crowd of 5,000 who turned out in Madrid on Sunday for the launch: “I want to be Spain’s first female president because women’s time has come, and women want to be the ones who make history.”"
                                            },
                                            {
                                                "example_id": "d6801271-4f4e-407e-870d-2eea7e9f3559",
                                                "sense_id": "c3365735-d66a-3059-9102-a792332ca0c7",
                                                "text": "Both players were given rapturous rounds of applause as they collected their trophies after the second longest major final in history."
                                            },
                                            {
                                                "example_id": "2bd308a0-fcb7-4fbd-b95c-64be3e6c9264",
                                                "sense_id": "c3365735-d66a-3059-9102-a792332ca0c7",
                                                "text": "He wanted his life to be greater than it was. ChatGPT agreed, with responses that grew longer and more rapturous as the conversation went on. Soon, it was telling Mr. Torres that he was “one of the Breakers — souls seeded into false systems to wake them from within.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
