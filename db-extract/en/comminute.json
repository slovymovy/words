                "senses": [
                    {
                        "sense_id": "f7b81bff-d0d0-312b-8202-9edabc28b777",
                        "entry_id": "f16f1c09-292e-3e14-b1d3-4041e843a911",
                        "glosses": [
                            "Pulverized material."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8567bded-dcf4-4890-bfda-2d01642b5d64",
                                "sense_id": "f7b81bff-d0d0-312b-8202-9edabc28b777",
                                "text": "The drink contains lemon comminute."
                            },
                            {
                                "example_id": "9080a694-e294-4c86-b6c1-ddc8404a97e4",
                                "sense_id": "f7b81bff-d0d0-312b-8202-9edabc28b777",
                                "text": "A method of making a restructured meat product in the form of small pieces from a comminute of raw meat, comprising:[…]."
                            },
                            {
                                "example_id": "70b898f1-c0a6-472e-86e1-11ef6a487414",
                                "sense_id": "f7b81bff-d0d0-312b-8202-9edabc28b777",
                                "text": "Fruit flavour may be added as juice, as a comminute (in the case of citrus fruit) or as an essence.[…]Citrus comminutes are made from the whole fruit, in contrast to juice which is expressed from the pericarp."
                            },
                            {
                                "example_id": "f69dd0db-fe03-4d84-9a62-f534f8371648",
                                "sense_id": "f7b81bff-d0d0-312b-8202-9edabc28b777",
                                "text": "The typical concentrated juices and comminutes used by the industry for manufacturing dilutable drinks are shown in Table 6.3."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
