                        ],
                        "form": "blurbed"
                    },
                    {
                        "form_id": "4cc539e3-01f2-4274-b32a-3ec32504673e",
                        "entry_id": "6ebe2955-9d3e-3ffa-b757-f95e119ae791",
                        "tags": [
                            "past"
                        ],
                        "form": "blurbed"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b1c17a30-37bf-3997-b846-0901fb5a8c94",
                        "entry_id": "6ebe2955-9d3e-3ffa-b757-f95e119ae791",
                        "glosses": [
                            "To write or quote in a blurb."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "07f5ad74-6c5f-4d87-a501-8bb905437bd1",
                                "sense_id": "b1c17a30-37bf-3997-b846-0901fb5a8c94",
                                "text": "When Rene Rodriguez of The Miami Herald blogged about having seen and loved “The Departed” in Toronto in a supposedly private screening last fall, Warner Brothers “scolded me very strongly,” he said, “but they still blurbed a line from my blog in their opening ad.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "5854c2f0-abde-3e9f-add5-413d0bba8bb4",
                        "entry_id": "6ebe2955-9d3e-3ffa-b757-f95e119ae791",
                        "glosses": [
                            "To supply with a blurb."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "875d3915-8b68-4216-95dd-e24b0a630118",
                                "sense_id": "5854c2f0-abde-3e9f-add5-413d0bba8bb4",
                                "text": "The unseemly business of book blurbing has been source of both humor and concern in the pages of The New Yorker."
                            },
                            {
                                "example_id": "7edaafd0-8b96-472d-b1f5-a478a68ec891",
                                "sense_id": "5854c2f0-abde-3e9f-add5-413d0bba8bb4",
                                "text": "Edward R. Murrow and other leading radio personalities blurbed the book, published in 1950 by Oxford University Press, and Siepmann thanked Paul Lazarsfeld and Herta Herzog in his acknowledgments."
                            }
                        ]
                    }
                ],
