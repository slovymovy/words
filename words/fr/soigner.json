    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6e2fa8f7-9faf-3c99-bf63-ca2f6bfcc5ce",
                    "sense_definition": "Donner des soins médicaux à un malade ou administrer un traitement contre une maladie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin <w>soigne</w> les malades avec beaucoup d'attention à l'hôpital."
                        },
                        {
                            "text": "Elle prend ce médicament pour <w>soigner</w> sa toux persistante."
                        }
                    ],
                    "common_phrases": [
                        "se faire soigner",
                        "soigner une maladie"
                    ]
                },
                {
                    "sense_id": "801e2778-de0d-34c7-8975-684b59ef43ca",
                    "sense_definition": "Prendre soin de quelqu'un, veiller à son bien-être ou à son confort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attention_personnes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mère attentive <w>soigne</w> ses enfants avec une infinie tendresse."
                        },
                        {
                            "text": "Nous devons bien <w>soigner</w> nos animaux domestiques chaque jour."
                        }
                    ],
                    "synonyms": [
                        "bichonner",
                        "chouchouter",
                        "choyer",
                        "dorloter"
                    ],
                    "common_phrases": [
                        "soigner ses invités"
                    ]
                },
                {
                    "sense_id": "11262f3d-8cb4-3058-9540-57f6d0a85652",
                    "sense_definition": "Apporter une attention particulière et minutieuse à la réalisation de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attention_travail",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet étudiant doit <w>soigner</w> sa présentation afin de réussir son examen."
                        },
                        {
                            "text": "L'artisan <w>soigne</w> chaque détail de ses meubles en chêne massif."
                        }
                    ],
                    "common_phrases": [
                        "soigner les détails",
                        "soigner sa présentation"
                    ]
                },
                {
                    "sense_id": "f8915757-2462-3c22-9a66-fd33385c4861",
                    "sense_definition": "Entourer quelqu'un d'égards ou de prévenances dans l'espoir d'obtenir un avantage.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "flatterie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il <w>soigne</w> particulièrement son supérieur dans l'espoir d'obtenir une promotion rapide."
                        },
                        {
                            "text": "Ce politicien cherche à <w>soigner</w> les journalistes avant l'annonce de sa candidature."
                        }
                    ],
                    "common_phrases": [
                        "soigner ses relations"
                    ]
                }
            ]
        }
    ]
