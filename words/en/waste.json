{
    "word_family": [
        "wastage",
        "wasteful",
        "wasteland",
        "waster",
        "wastrel"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "33f43750-fdd3-3abd-867b-b211fda6f374",
                    "sense_definition": "The act of using something in a way that is not effective or necessary; extravagant consumption.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inefficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Buying that expensive gadget you never use was a complete <w>waste</w> of money.",
                            "target_lang_translations": {
                                "ru": "Покупка того дорогого гаджета, которым ты никогда не пользуешься, была полной <w>тратой</w> денег.",
                                "tr": "Hiç kullanmadığın o pahalı cihazı almak tam bir para <w>israfıydı</w>."
                            }
                        },
                        {
                            "text": "It is a <w>waste</w> of time to wait for a bus that is not coming.",
                            "target_lang_translations": {
                                "ru": "Ждать автобус, который не придет — это пустая <w>трата</w> времени.",
                                "tr": "Gelmeyecek bir otobüsü beklemek zaman <w>kaybıdır</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waste of time",
                        "waste of money",
                        "waste of energy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт использования чего-либо неэффективным или ненужным образом; чрезмерное потребление.",
                        "tr": "Bir şeyi etkili veya gerekli olmayan bir şekilde kullanma eylemi; aşırı tüketim."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустая трата",
                                "target_lang_sense_clarification": "времени, денег или усилий"
                            },
                            {
                                "target_lang_word": "растрата",
                                "target_lang_sense_clarification": "неэффективное использование ресурсов"
                            },
                            {
                                "target_lang_word": "бесполезная трата",
                                "target_lang_sense_clarification": "чего-либо ценного"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "israf",
                                "target_lang_sense_clarification": "zaman, para veya emek kaybı"
                            },
                            {
                                "target_lang_word": "boşa harcama",
                                "target_lang_sense_clarification": "gereksiz tüketim"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf81aaf5-7dd3-3e6d-b2d7-fc90385b3e40",
                    "sense_definition": "Useless materials, substances, or parts that are left over after something has been made or used.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "refuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The factory must find a safer way to dispose of its chemical <w>waste</w>.",
                            "target_lang_translations": {
                                "ru": "Завод должен найти более безопасный способ утилизации своих химических <w>отходов</w>.",
                                "tr": "Fabrika, kimyasal <w>atıklarını</w> bertaraf etmek için daha güvenli bir yol bulmalı."
                            }
                        },
                        {
                            "text": "We should all try to reduce the amount of household <w>waste</w> we produce.",
                            "target_lang_translations": {
                                "ru": "Мы все должны стараться сократить количество бытовых <w>отходов</w>, которые мы производим.",
                                "tr": "Hepimiz ürettiğimiz evsel <w>atık</w> miktarını azaltmaya çalışmalıyız."
                            }
                        }
                    ],
                    "synonyms": [
                        "cack"
                    ],
                    "common_phrases": [
                        "hazardous waste",
                        "industrial waste",
                        "household waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бесполезные материалы, вещества или части, которые остаются после того, как что-то было сделано или использовано.",
                        "tr": "Bir şey üretildikten veya kullanıldıktan sonra geriye kalan kullanılamaz maddeler, malzemeler veya parçalar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отходы",
                                "target_lang_sense_clarification": "промышленные или бытовые остатки"
                            },
                            {
                                "target_lang_word": "отбросы",
                                "target_lang_sense_clarification": "негодные остатки, мусор"
                            },
                            {
                                "target_lang_word": "утиль",
                                "target_lang_sense_clarification": "вторичное сырье"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "atık",
                                "target_lang_sense_clarification": "sanayi veya evsel artıklar"
                            },
                            {
                                "target_lang_word": "çöp",
                                "target_lang_sense_clarification": "kullanılmaz malzeme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6adfda45-4a7c-3c59-a598-a0af085f467e",
                    "sense_definition": "A large area of land that is empty, uninhabited, or has been destroyed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "land",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers struggled to survive while crossing the frozen <w>wastes</w> of the Arctic.",
                            "target_lang_translations": {
                                "ru": "Исследователи изо всех сил пытались выжить, пересекая ледяные <w>пустоши</w> Арктики.",
                                "tr": "Kaşifler, Arktik'in buz tutmuş <w>çorak arazilerini</w> geçerken hayatta kalmak için mücadele ettiler."
                            }
                        },
                        {
                            "text": "After the fire, the once beautiful forest became a desolate <w>waste</w>.",
                            "target_lang_translations": {
                                "ru": "После пожара некогда прекрасный лес превратился в безлюдную <w>пустошь</w>.",
                                "tr": "Yangından sonra, bir zamanlar güzel olan orman ıssız bir <w>harabeye</w> dönüştü."
                            }
                        }
                    ],
                    "common_phrases": [
                        "frozen wastes",
                        "vast waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обширная территория земли, которая пуста, необитаема или была разрушена.",
                        "tr": "Boş, üzerinde yaşanmayan veya tahrip edilmiş geniş arazi parçası."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустошь",
                                "target_lang_sense_clarification": "невозделанный участок земли"
                            },
                            {
                                "target_lang_word": "пустыня",
                                "target_lang_sense_clarification": "в значении безлюдного пространства"
                            },
                            {
                                "target_lang_word": "просторы",
                                "target_lang_sense_clarification": "обычно о заснеженных или пустынных землях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çorak arazı",
                                "target_lang_sense_clarification": "boş ve verimsiz toprak"
                            },
                            {
                                "target_lang_word": "çöl",
                                "target_lang_sense_clarification": "ıssız alan"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c01b7c76-8955-396f-9f52-5be152961524",
                    "sense_definition": "Excrement or urine from humans or animals.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refuse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city built a new facility to process human <w>waste</w> more efficiently.",
                            "target_lang_translations": {
                                "ru": "Город построил новый объект для более эффективной переработки человеческих <w>отходов</w>.",
                                "tr": "Şehir, insan <w>atıklarını</w> daha verimli işlemek için yeni bir tesis inşa etti."
                            }
                        },
                        {
                            "text": "The cage was littered with animal <w>waste</w> and needed cleaning.",
                            "target_lang_translations": {
                                "ru": "Клетка была завалена <w>экскрементами</w> животных и нуждалась в чистке.",
                                "tr": "Kafes hayvan <w>dışkısı</w> ile doluydu ve temizlenmesi gerekiyordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "animal waste",
                        "human waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Экскременты или моча людей или животных.",
                        "tr": "İnsan veya hayvan dışkısı ve idrarı."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отходы жизнедеятельности",
                                "target_lang_sense_clarification": "формальный термин"
                            },
                            {
                                "target_lang_word": "экскременты",
                                "target_lang_sense_clarification": "биологические выделения"
                            },
                            {
                                "target_lang_word": "нечистоты",
                                "target_lang_sense_clarification": "канализационные отходы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "dışkı",
                                "target_lang_sense_clarification": "biyolojik atık"
                            },
                            {
                                "target_lang_word": "vücut atığı",
                                "target_lang_sense_clarification": "insan veya hayvan artıkları"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cc8bde8-1450-3848-8054-56e083e4da5b",
                    "sense_definition": "The process of the body becoming weaker or thinner due to disease or lack of food.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient suffered from a rapid <w>waste</w> of muscle tissue during his illness.",
                            "target_lang_translations": {
                                "ru": "Во время болезни пациент страдал от быстрой <w>атрофии</w> мышечной ткани.",
                                "tr": "Hasta, hastalığı sırasında kas dokusunun hızlı bir şekilde <w>erimesinden</w> muzdarip oldu."
                            }
                        },
                        {
                            "text": "Doctors were concerned about the visible <w>waste</w> caused by the infection.",
                            "target_lang_translations": {
                                "ru": "Врачи были обеспокоены видимым <w>истощением</w>, вызванным инфекцией.",
                                "tr": "Doktorlar, enfeksiyonun neden olduğu gözle görülür <w>zayıflamadan</w> endişe duyuyorlardı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "muscle waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс ослабления или истощения организма из-за болезни или нехватки пищи.",
                        "tr": "Hastalık veya besinsizlik nedeniyle vücudun zayıflaması veya erimesi süreci."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истощение",
                                "target_lang_sense_clarification": "потеря мышечной массы или сил"
                            },
                            {
                                "target_lang_word": "атрофия",
                                "target_lang_sense_clarification": "уменьшение органа или ткани в объеме"
                            },
                            {
                                "target_lang_word": "увядание",
                                "target_lang_sense_clarification": "постепенная потеря жизненных сил"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "erime",
                                "target_lang_sense_clarification": "kas veya doku kaybı"
                            },
                            {
                                "target_lang_word": "atrofi",
                                "target_lang_sense_clarification": "tıbbi anlamda doku kaybı"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b870481-49a6-359d-9790-41916aa5c2d8",
                    "sense_definition": "To use money, time, or resources in a way that is not useful or sensible.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inefficiency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't <w>waste</w> your breath trying to explain it to him; he won't listen.",
                            "target_lang_translations": {
                                "ru": "Не <w>трать</w> слова попусту, пытаясь объяснить ему это; он не станет слушать.",
                                "tr": "Ona açıklamaya çalışarak nefesini <w>tüketme</w>; dinlemeyecek."
                            }
                        },
                        {
                            "text": "We <w>wasted</w> a lot of money on a car that keeps breaking down.",
                            "target_lang_translations": {
                                "ru": "Мы <w>выбросили</w> много денег на машину, которая постоянно ломается.",
                                "tr": "Sürekli bozulan bir arabaya çok para <w>çarçur ettik</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waste your breath",
                        "waste time",
                        "waste money"
                    ],
                    "target_lang_definitions": {
                        "ru": "Использовать деньги, время или ресурсы нецелесообразным или неразумным образом.",
                        "tr": "Para, zaman veya kaynakları yararsız veya mantıksız bir şekilde kullanmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тратить впустую",
                                "target_lang_sense_clarification": "время или деньги"
                            },
                            {
                                "target_lang_word": "транжирить",
                                "target_lang_sense_clarification": "неразумно расходовать средства"
                            },
                            {
                                "target_lang_word": "расточать",
                                "target_lang_sense_clarification": "безрассудно тратить ресурсы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "boşa harcamak",
                                "target_lang_sense_clarification": "zaman veya para tüketmek"
                            },
                            {
                                "target_lang_word": "çarçur etmek",
                                "target_lang_sense_clarification": "savurganca harcamak"
                            },
                            {
                                "target_lang_word": "israf etmek",
                                "target_lang_sense_clarification": "gereksiz yere tüketmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "adb4f2f9-9cd9-3bbd-a1a0-eb526f0151bb",
                    "sense_definition": "To gradually become thinner and weaker, usually because of illness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without proper nutrition, the body will begin to <w>waste</w> away.",
                            "target_lang_translations": {
                                "ru": "Без правильного питания организм начнет <w>чахнуть</w>.",
                                "tr": "Doğru beslenme olmadan vücut <w>erimeye</w> başlayacaktır."
                            }
                        },
                        {
                            "text": "He looked pale and thin as the disease caused him to <w>waste</w>.",
                            "target_lang_translations": {
                                "ru": "Он выглядел бледным и худым, так как болезнь заставляла его <w>угасать</w>.",
                                "tr": "Hastalık onun <w>solup erimesine</w> neden olduğu için solgun ve zayıf görünüyordu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waste away"
                    ],
                    "target_lang_definitions": {
                        "ru": "Постепенно становиться худее и слабее, обычно из-за болезни.",
                        "tr": "Genellikle hastalık nedeniyle giderek zayıflamak ve güçsüzleşmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чахнуть",
                                "target_lang_sense_clarification": "слабеть от болезни"
                            },
                            {
                                "target_lang_word": "сохнуть",
                                "target_lang_sense_clarification": "сильно худеть и терять силы"
                            },
                            {
                                "target_lang_word": "изнывать",
                                "target_lang_sense_clarification": "терять силы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "mum gibi erimek",
                                "target_lang_sense_clarification": "hastalıktan zayıflamak"
                            },
                            {
                                "target_lang_word": "çökmek",
                                "target_lang_sense_clarification": "güçten düşmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "13e320bf-98d4-335c-b298-13be9a5699fe",
                    "sense_definition": "To destroy or devastate an area or place completely.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The invading army proceeded to <w>waste</w> the entire countryside.",
                            "target_lang_translations": {
                                "ru": "Армия захватчиков принялась <w>опустошать</w> всю сельскую местность.",
                                "tr": "İşgalci ordu tüm kırsalı <w>yerle bir etmeye</w> koyuldu."
                            }
                        },
                        {
                            "text": "The storm threatened to <w>waste</w> the coastal villages with its fury.",
                            "target_lang_translations": {
                                "ru": "Шторм грозил своей яростью <w>разрушить</w> прибрежные деревни.",
                                "tr": "Fırtına öfkesiyle kıyı köy ve kasabalarını <w>harap etmekle</w> tehdit etti."
                            }
                        }
                    ],
                    "common_phrases": [
                        "lay waste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью разрушить или опустошить территорию или место.",
                        "tr": "Bir bölgeyi veya yeri tamamen yok etmek, harap etmek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опустошать",
                                "target_lang_sense_clarification": "приводить в запустение"
                            },
                            {
                                "target_lang_word": "разорять",
                                "target_lang_sense_clarification": "разрушать и грабить"
                            },
                            {
                                "target_lang_word": "разрушать",
                                "target_lang_sense_clarification": "превращать в руины"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "yerle bir etmek",
                                "target_lang_sense_clarification": "tamamen yıkmak"
                            },
                            {
                                "target_lang_word": "harap etmek",
                                "target_lang_sense_clarification": "tahrip etmek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73342183-3298-33b3-ad24-32ed93a33ce8",
                    "sense_definition": "To kill or murder someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hitman was hired to <w>waste</w> the witness before the trial.",
                            "target_lang_translations": {
                                "ru": "Наемного убийцу наняли, чтобы <w>замочить</w> свидетеля до суда.",
                                "tr": "Kiralık katil, duruşmadan önce tanığı <w>harcamak</w> için tutulmuştu."
                            }
                        },
                        {
                            "text": "In the movie, the villain threatened to <w>waste</w> anyone who got in his way.",
                            "target_lang_translations": {
                                "ru": "В фильме злодей угрожал <w>прикончить</w> любого, кто встанет у него на пути.",
                                "tr": "Filmde kötü adam, yoluna çıkan herkesi <w>gebertmekle</w> tehdit etti."
                            }
                        }
                    ],
                    "synonyms": [
                        "cack",
                        "top",
                        "duppy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "often used in crime contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убить или совершить убийство человека.",
                        "tr": "Birini öldürmek veya cinayet işlemek."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "замочить",
                                "target_lang_sense_clarification": "криминальный жаргон"
                            },
                            {
                                "target_lang_word": "грохнуть",
                                "target_lang_sense_clarification": "сленг, убить"
                            },
                            {
                                "target_lang_word": "укокошить",
                                "target_lang_sense_clarification": "разговорное, лишить жизни"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "harcamak",
                                "target_lang_sense_clarification": "argo, öldürmek"
                            },
                            {
                                "target_lang_word": "gebertmek",
                                "target_lang_sense_clarification": "argo, yok etmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "087f57bc-fcbe-3bdb-8252-f8edcbbaa26a",
                    "sense_definition": "Describing something that is rejected as defective or produced in excess of what is needed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refuse",
                    "name_type": "no",
                    "examples": [
                        {
