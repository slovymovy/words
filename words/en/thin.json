                {
                    "sense_id": "d56e4417-1729-37de-81ba-453f68001b89",
                    "sense_definition": "Lacking body or volume; small; feeble; not full.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave a <w>thin</w> smile that didn't quite reach her eyes.",
                            "target_lang_translations": {
                                "ru": "Она выдавила <w>слабую</w> улыбку, которая не коснулась ее глаз.",
                                "nl": "Ze gaf een <w>flauwe</w> glimlach die haar ogen niet echt bereikte."
                            }
