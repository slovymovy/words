                        "entry_id": "9937f4eb-6436-3b9c-9eaa-2eae24cdeafe",
                        "glosses": [
                            "zaburzenie polegające na utrzymujących się wahaniach nastroju w postaci łagodnych epizodów subdepresji i hipomanii"
                        ],
                        "tags": [
                            "psychology"
                        ],
                        "examples": [
                            {
                                "example_id": "85ed9eb1-0157-4e0b-900f-cdbb99d159ab",
                                "sense_id": "4f4ecfdb-7a01-3aa8-947b-8555c71bca67",
                                "text": "Cyklotymia jest zasadniczo spokrewniona z zaburzeniami dwubiegunowymi, ponieważ również tutaj naprzemiennie występują fazy maniakalne i depresyjne. W cyklotymii jednak fazy te nie mają aż takiej intensywności i nie od razu rzucają się w oczy."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
