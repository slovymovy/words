                                    {
                                        "sense_id": "e8cb5240-dc3f-3bc7-a92d-63bec2fe2cdf",
                                        "entry_id": "9b6fe55f-d656-3fe0-a8db-763d83be16f1",
                                        "glosses": [
                                            "Défilé nocturne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23eb9672-c142-4cf7-9022-f12172df7f68",
                                                "sense_id": "e8cb5240-dc3f-3bc7-a92d-63bec2fe2cdf",
                                                "text": "En cortège, par rang d’âge, elles gravissent alors l’escalier lentement ; on croirait une retraite aux flambeaux, dans un opéra sans gaieté."
                                            },
                                            {
                                                "example_id": "44e7cfdd-4a6a-4c45-b16a-1985b28de17d",
                                                "sense_id": "e8cb5240-dc3f-3bc7-a92d-63bec2fe2cdf",
                                                "text": "La retraite aux flambeaux est un défilé de troupes accompagné par des musiques militaires. C’est un spectacle nocturne au cours duquel les participants tiennent à la main des torches ou des lanternes tricolores.."
                                            },
                                            {
                                                "example_id": "33b40d3e-9dab-42df-9ede-ee24d721fad7",
                                                "sense_id": "e8cb5240-dc3f-3bc7-a92d-63bec2fe2cdf",
                                                "text": "Retraite aux flambeaux par la fanfare et les pompiers."
                                            }
