                ],
                "senses": [
                    {
                        "sense_id": "f5079b66-3bf9-342f-ae44-f59865b35626",
                        "entry_id": "07c920a1-b0bf-3640-8988-3515b4571adb",
                        "glosses": [
                            "sehr/extrem hohe Summe Geldes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cacbeb9-7d08-4752-a056-fec8c70c514c",
                                "sense_id": "f5079b66-3bf9-342f-ae44-f59865b35626",
                                "text": "„Außerdem war ich neugierig auf meine neue Wohnung bei der Tintoretta, über die wegen eines Fürsten von Waldeck, der Unsummen für sie ausgab, viel geredet wurde.“"
                            },
                            {
                                "example_id": "3d9b9f65-b482-4fc3-9765-9bb740fcbc0f",
                                "sense_id": "f5079b66-3bf9-342f-ae44-f59865b35626",
                                "text": "„12 000 geladene Gäste nahmen daran teil, die Feier kostete Unsummen zu einer Zeit, als die Bevölkerung in Armut und Arbeitslosigkeit versank.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2e17800b-e674-3c6f-85c4-c23f911f344e",
                        "entry_id": "07c920a1-b0bf-3640-8988-3515b4571adb",
                        "glosses": [
                            "überaus große Menge von etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "37ac8470-f94b-436f-b84f-6f2ea93cc5d1",
                                "sense_id": "2e17800b-e674-3c6f-85c4-c23f911f344e",
                                "text": "In dieser kurzen Zeit ist schon eine Unsumme von Arbeit geleistet worden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
