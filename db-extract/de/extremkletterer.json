                "senses": [
                    {
                        "sense_id": "10870e8f-9eb3-3229-b617-c20103a36d2f",
                        "entry_id": "e5a8ed3b-1c5a-3196-ab2b-b073c8a7297b",
                        "glosses": [
                            "Sportler, der sich am Berg beziehungsweise an steilen Wänden im Bereich der höchsten Schwierigkeitsgrade bewegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a9bb29b-ad82-4596-a702-2598c61431da",
                                "sense_id": "10870e8f-9eb3-3229-b617-c20103a36d2f",
                                "text": "„Es ist eine Gegend, in die sich allenfalls Extremkletterer verirren und auch Hilfsorganisationen und Reporter nur unter Mühen vordringen.“"
                            },
                            {
                                "example_id": "08143b95-4562-4291-834b-33ecffd23c8b",
                                "sense_id": "10870e8f-9eb3-3229-b617-c20103a36d2f",
                                "text": "„Der Extremkletterer setzt sich nicht ‚todesmutig’ oder gar ‚blind’ einer ‚mörderischen Wand’ aus, sondern sichert sich mit Seil und Haken, vertraut seinen Eisen, seinem Können, seiner Sorgfalt, seiner Konzentrationsfähigkeit, seinem Selbsteinschätzungsvermögen, seinem Krisenmanagement, seiner Erfahrung.“"
                            },
                            {
                                "example_id": "66cb48c6-732a-4e3d-a246-f0adfc1742a2",
                                "sense_id": "10870e8f-9eb3-3229-b617-c20103a36d2f",
                                "text": "„Zudem wird ihn Extremkletterer Stefan Glowacz, kürzlich Gast beim Nationalteam, gewarnt haben.“"
                            },
                            {
                                "example_id": "6c9bf993-bbe8-4066-8347-0eaae02100e1",
                                "sense_id": "10870e8f-9eb3-3229-b617-c20103a36d2f",
                                "text": "„Gemeinsam mit dem ehemaligen Deutschland-Chef von McKinsey Herbert Henzler und dem Extremkletterer Alexander Huber geht es am 10. und 11. Juli in die Bergregion Wilder Kaiser in Tirol.“"
                            },
                            {
                                "example_id": "fed84268-896b-4627-94d4-5acee068cef7",
                                "sense_id": "10870e8f-9eb3-3229-b617-c20103a36d2f",
                                "text": "„Mit Bergen kennt sich der 51jährige Abenteurer und Extremkletterer aus wie kein Zweiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
