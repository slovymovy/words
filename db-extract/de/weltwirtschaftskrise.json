                ],
                "senses": [
                    {
                        "sense_id": "fea885ff-b0a1-38b4-b251-98ae058034fe",
                        "entry_id": "dec6edca-f5b1-3fe4-ba31-697d5f173a3e",
                        "glosses": [
                            "sehr starker Rückgang der Produktion und des Handels in nahezu allen Volkswirtschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f7943235-f9da-4aef-877d-cca27d9a4deb",
                                "sense_id": "fea885ff-b0a1-38b4-b251-98ae058034fe",
                                "text": "„Das größte spanischsprachige Land der Welt ächzt unter der Weltwirtschaftskrise und unter strukturellen Problemen zu Hause.“"
                            },
                            {
                                "example_id": "eb3d7c32-c979-4f50-88e1-dc845327c9ab",
                                "sense_id": "fea885ff-b0a1-38b4-b251-98ae058034fe",
                                "text": "„Der Antisemitismus, der seit der Weltwirtschaftskrise und dem Börsenkrach von 1873 wuchs, durchsäuerte beide Volksgruppen.“"
                            },
                            {
                                "example_id": "2b2319d8-c687-4da7-a747-77f14e9710bb",
                                "sense_id": "fea885ff-b0a1-38b4-b251-98ae058034fe",
                                "text": "„Als Retter hatten die Deutschen Hitler begrüßt, der sie aus den politischen Nöten und persönlichen Ängsten erlösen sollte, die der Versailler Friedensvertrag nach dem Ersten Weltkrieg, die Inflation der frühen zwanziger Jahre und die Weltwirtschaftskrise zu Beginn der Dreißiger heraufbeschworen hatte.“"
                            },
                            {
                                "example_id": "c0f58941-7e9f-435d-8179-296ad4e143a3",
                                "sense_id": "fea885ff-b0a1-38b4-b251-98ae058034fe",
                                "text": "„Im Zuge der Weltwirtschaftskrise geht es jedoch mit der Gießerei bergab, Heinrichs muss Konkurs anmelden, und der geschäftliche Niedergang zerstört die Familie.“"
                            },
                            {
                                "example_id": "0c84eeca-70b7-486b-9353-ab0c29bdfd6d",
                                "sense_id": "fea885ff-b0a1-38b4-b251-98ae058034fe",
                                "text": "„Gandhi hatte eine symbolische Revolution inszeniert. Sie blieb freilich auch symbolisch und hätte ihre Wirkung bald verloren, wenn nicht durch die Auswirkung der Weltwirtschaftskrise die nationale Agitation weiteren Auftrieb bekommen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
