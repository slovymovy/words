                "senses": [
                    {
                        "sense_id": "d2ebac02-cb12-3728-9e14-d98557093620",
                        "entry_id": "4205bb78-5d0b-3365-a579-8bf85de7b33c",
                        "glosses": [
                            "Faire perdre son caractère agité à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a902115-34af-487b-8552-385c7aecde54",
                                "sense_id": "d2ebac02-cb12-3728-9e14-d98557093620",
                                "text": "En classe, c’est l’apathie le matin (faut qu’il récupère), l’agitation fébrile le reste de la journée. Intelligence normale, mais à désagiter avant emploi."
                            },
                            {
                                "example_id": "c582e29b-3c4e-40dd-a23b-0bad750d2cd9",
                                "sense_id": "d2ebac02-cb12-3728-9e14-d98557093620",
                                "text": "Lorsqu’on dispose d’espace, une marche lente permet de se «désagiter», de se retrouver soi-même."
                            }
                        ]
                    }
