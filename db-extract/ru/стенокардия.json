                    },
                    {
                        "form_id": "fe0801ba-6384-47bb-89e2-38c6e38fc1cd",
                        "entry_id": "39f468d3-2715-308a-a07d-385833d93462",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "стенокарди́ях"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f53f183-2a9e-3377-85b0-9529086acf19",
                        "entry_id": "39f468d3-2715-308a-a07d-385833d93462",
                        "glosses": [
                            "мед. клинический синдром, одна из форм ишемической болезни сердца, проявляющийся приступами характерных (обычно сжимающих, давящих) болей в области сердца и за грудиной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643a6cad-2bec-4e74-9e75-253ba18cb27d",
                                "sense_id": "5f53f183-2a9e-3377-85b0-9529086acf19",
                                "text": "В дни магнитных бурь, сильно возрастает число вызовов скорой помощи по поводу гипертонических кризов, приступов стенокардии, нарушений сердечного ритма."
                            },
                            {
                                "example_id": "73656428-5b28-44e3-b033-451299bf1ec9",
                                "sense_id": "5f53f183-2a9e-3377-85b0-9529086acf19",
                                "text": "Вот тут и возникает стенокардия ― давящие боли за грудиной, которые отдают в левую руку или под лопатку."
                            },
                            {
                                "example_id": "a1b22c26-ac09-46cc-a1bc-9023b594f4ed",
                                "sense_id": "5f53f183-2a9e-3377-85b0-9529086acf19",
                                "text": "Врачи часто рекомендуют это простое и безвредное средство: и больным стенокардией, и при неврозах, и даже во время приступов морской и воздушной болезни."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65360750-bf27-4cf5-95e3-7b1f5efbca65",
                        "source_entry_id": "39f468d3-2715-308a-a07d-385833d93462",
