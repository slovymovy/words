                ],
                "senses": [
                    {
                        "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                        "entry_id": "164db3ff-188f-3402-9f8a-93708fc561d8",
                        "glosses": [
                            "von der Firma Glock GmbH hergestellte Waffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4973da76-1ec1-4d9a-899d-6cce7b0e849f",
                                "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                                "text": "„Und die Waffe dieses Mannes. Eine Glock – das neue Lieblingsspielzeug der Feds.“"
                            },
                            {
                                "example_id": "63c474f6-91ce-43ac-9654-1e8188000e79",
                                "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                                "text": "„Er öffnete ihn und nahm zwei Dinge heraus. Zunächst mal seine kompakte Glock, Kaliber 380, die er hinter einer Reihe McCormick-Gewürze versteckt hielt.“"
                            },
                            {
                                "example_id": "8305639a-f2a5-49d7-8051-4b9c52afb378",
                                "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                                "text": "„Ich öffne meinen Aktenkoffer. Nehme die Glock heraus.“"
                            },
                            {
                                "example_id": "5f177098-6532-4bd1-8057-2d75cfd5a0a7",
                                "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                                "text": "„Kolt Raynor hob die Glock, während er hinter Slapshot aus dem Cockpit stürmte.“"
                            },
                            {
                                "example_id": "db95c68b-190b-4032-8504-6028b78c89db",
                                "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                                "text": "„Dewey ließ Pazurs Glock auf das stählerne Deck poltern, holte das leere Magazin aus dem Colt, ließ es ebenfalls einfach zu Boden fallen, zog ein frisches aus der Tasche und ließ es einrasten, während Esco nach oben stürzte.“"
                            },
                            {
                                "example_id": "604b77fd-1a63-4d68-b4af-6ec0557ef21c",
                                "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                                "text": "„Sie ist überzeugt davon, die Glock auch mit einer Hand effektiv bedienen zu können.“"
                            },
                            {
                                "example_id": "0b9c7a61-3b78-4560-88cb-d6b46f5dc6a9",
                                "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                                "text": "„Detective Torres hielt weiterhin seine Glock mit beiden Händen vor sich ausgestreckt und beäugte Sarah misstrauisch, dann schob er seine Waffe in das Halfter unter seiner Sportjacke.“"
                            },
                            {
                                "example_id": "eb117927-3f90-4767-81b6-38f9ac86d000",
                                "sense_id": "b1c103ec-7e30-346b-8501-5520de32e337",
                                "text": "„Inländischen Waffen wollte ich mein Leben nicht anvertrauen, und Glocks konnte ich mir natürlich nicht leisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
