                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ab9e1d7-9436-4944-a43a-fa0a966dfdae",
                                "sense_id": "934dfd11-5a29-3785-bd90-c9880a652199",
                                "text": "Le romarin est indissociable de la Provence et ses paysages, sa cuisine, ses secrets de beauté.",
