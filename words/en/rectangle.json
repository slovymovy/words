{
    "word_family": [
        "rectangular",
        "rectilinearity",
        "rectilinear"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93bffba8-cfc3-3c65-8ce8-eb210c580d24",
                    "sense_definition": "A four-sided shape with four right angles and opposite sides that are parallel.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rectangle</w> has four sides and four corners.",
                            "target_lang_translations": {
                                "ru": "У <w>прямоугольника</w> четыре стороны и четыре угла."
                            }
                        },
                        {
                            "text": "Draw a large <w>rectangle</w> on the piece of paper.",
                            "target_lang_translations": {
                                "ru": "Нарисуйте большой <w>прямоугольник</w> на листе бумаги."
                            }
                        }
                    ],
                    "synonyms": [
                        "quadrilateral"
                    ],
                    "common_phrases": [
                        "draw a rectangle",
                        "area of rectangle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Четырёхугольник, у которого все четыре угла прямые, а противоположные стороны параллельны."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямоуго́льник",
                                "target_lang_sense_clarification": "геометрическая фигура с четырьмя прямыми углами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab064e0e-b329-3a8c-b2c7-f27c1b0dda63",
                    "sense_definition": "A four-sided shape with four right angles that is longer than it is wide, excluding a square.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The room was a long <w>rectangle</w> rather than a square.",
                            "target_lang_translations": {
                                "ru": "Комната была скорее длинным <w>прямоугольником</w>, чем квадратом."
                            }
                        },
                        {
                            "text": "He cut the wood into a perfect <w>rectangle</w> for the frame.",
                            "target_lang_translations": {
                                "ru": "Он вырезал дерево в форме идеального <w>прямоугольника</w> для рамки."
                            }
                        }
                    ],
                    "antonyms": [
                        "square"
                    ],
                    "common_phrases": [
                        "perfect rectangle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Четырёхугольник с прямыми углами, у которого длина больше ширины (не квадрат)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямоуго́льник",
                                "target_lang_sense_clarification": "в значении вытянутой прямоугольной формы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ad1b3bc-043e-3367-995b-b95f8cd99680",
                    "sense_definition": "A right angle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect measured the <w>rectangle</w> of the corner carefully.",
                            "target_lang_translations": {
                                "ru": "Архитектор тщательно измерил <w>прямой угол</w> в углу помещения."
                            }
                        },
                        {
                            "text": "Each <w>rectangle</w> in the structure must be exactly ninety degrees.",
                            "target_lang_translations": {
                                "ru": "Каждый <w>прямой угол</w> в конструкции должен быть ровно девяносто градусов."
                            }
                        }
                    ],
                    "synonyms": [
                        "right-angle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older mathematical or literary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямой угол (устаревшее математическое значение)."
                    },
                    "translations": {
                        "ru": []
                    }
                },
                {
                    "sense_id": "b4bbda37-53b9-3fee-83f7-7428dd5dabe7",
                    "sense_definition": "The mathematical product of two quantities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rectangle</w> of these two numbers is forty-eight.",
                            "target_lang_translations": {
                                "ru": "Результат <w>произведения</w> этих двух чисел равен сорока восьми."
                            }
                        },
                        {
                            "text": "In this formula, the <w>rectangle</w> represents the total area.",
                            "target_lang_translations": {
                                "ru": "В этой формуле <w>произведение</w> представляет общую площадь."
                            }
                        }
                    ],
                    "synonyms": [
                        "product"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical mathematical terminology."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическое произведение двух величин (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "произведе́ние",
                                "target_lang_sense_clarification": "результат умножения чисел"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2801a1e1-54e9-3cda-b50c-dd4c581229ea",
                    "sense_definition": "Having right angles.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The building features a <w>rectangle</w> design with sharp corners.",
                            "target_lang_translations": {
                                "ru": "Здание отличается <w>прямоугольным</w> дизайном с острыми углами."
                            }
                        },
                        {
                            "text": "They used a <w>rectangle</w> tool to ensure the edges were straight.",
                            "target_lang_translations": {
                                "ru": "Они использовали <w>прямоугольный</w> инструмент, чтобы убедиться, что края ровные."
                            }
                        }
                    ],
                    "synonyms": [
                        "right-angled"
                    ],
                    "common_phrases": [
                        "rectangle shape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий прямые углы."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямоуго́льный",
                                "target_lang_sense_clarification": "прилагательное, описывающее форму с прямыми углами"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}