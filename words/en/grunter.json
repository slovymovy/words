{
    "word_family": [
        "grunt"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f5e29ba7-ca8b-3beb-9ad2-3beb3c7b26bf",
                    "sense_definition": "A person or animal that grunts, especially an athlete who makes loud guttural sounds when exerting effort.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tennis player was known as a loud <w>grunter</w> whenever she struck the ball.",
                            "target_lang_translations": {
                                "de": "Die Tennisspielerin war dafür bekannt, eine laute <w>Stöhnerin</w> zu sein, wann immer sie den Ball schlug."
                            }
                        },
                        {
                            "text": "He proved to be a heavy <w>grunter</w> while lifting the heaviest weights in the gym.",
                            "target_lang_translations": {
                                "de": "Er erwies sich als lautstarker <w>Grunzer</w>, als er die schwersten Gewichte im Fitnessstudio hob."
                            }
                        }
                    ],
                    "common_phrases": [
                        "notorious grunter"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person oder ein Tier, das grunzt; insbesondere ein Sportler, der bei körperlicher Anstrengung laute, kehlige Laute von sich gibt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Stöhner",
                                "target_lang_sense_clarification": "im Sport bei Anstrengung"
                            },
                            {
                                "target_lang_word": "Grunzer",
                                "target_lang_sense_clarification": "allgemein, Mensch oder Tier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c7bd646-7aac-34fa-84af-40698f430700",
                    "sense_definition": "A pig or hog.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer walked across the mud to feed every noisy <w>grunter</w> in the pen.",
                            "target_lang_translations": {
                                "de": "Der Bauer stapfte durch den Schlamm, um jeden lautstarken <w>Grunzer</w> im Gehege zu füttern."
                            }
                        },
                        {
                            "text": "Old stories often referred to the farm pig simply as a <w>grunter</w>.",
                            "target_lang_translations": {
                                "de": "In alten Geschichten wurde das Hausschwein oft einfach als <w>Grunzer</w> bezeichnet."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "referring to a pig"
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Umgangssprachliche Bezeichnung für ein Schwein."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Grunzer",
                                "target_lang_sense_clarification": "umgangssprachlich für Schwein"
                            },
                            {
                                "target_lang_word": "Schwein",
                                "target_lang_sense_clarification": "Tier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4e665c6c-5225-3b83-a1ab-2f932543523b",
                    "sense_definition": "Any of various fish, especially of the family Terapontidae, that produce a grunting sound when caught.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He reeled in a small <w>grunter</w> from the estuary waters late that afternoon.",
                            "target_lang_translations": {
                                "de": "Spät an diesem Nachmittag holte er einen kleinen <w>Grunzer</w> aus den Gewässern der Mündung."
                            }
                        },
                        {
                            "text": "The fisherman recognized the distinctive sound of the striped <w>grunter</w> on the deck.",
                            "target_lang_translations": {
                                "de": "Der Fischer erkannte den unverwechselbaren Laut des Gestreiften <w>Grunzbarschs</w> an Deck."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiger perch"
                    ],
                    "common_phrases": [
                        "striped grunter"
                    ],
                    "target_lang_definitions": {
                        "de": "Verschiedene Fischarten (insbesondere der Familie Terapontidae oder Haemulidae), die beim Fang grunzende Laute von sich geben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Grunzer",
                                "target_lang_sense_clarification": "Fischart"
                            },
                            {
                                "target_lang_word": "Grunzbarsch",
                                "target_lang_sense_clarification": "Fischfamilie Terapontidae"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "092f98a8-b43c-3ef1-af99-818154d04700",
                    "sense_definition": "A specialized hook or tool used in a foundry for lifting a crucible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The foundry worker used a long <w>grunter</w> to lift the crucible safely.",
                            "target_lang_translations": {
                                "de": "Der Gießereiarbeiter benutzte einen langen <w>Tiegelhaken</w>, um den Schmelztiegel sicher anzuheben."
                            }
                        },
                        {
                            "text": "Ensure that the <w>grunter</w> is firmly hooked before moving the molten metal.",
                            "target_lang_translations": {
                                "de": "Stellen Sie sicher, dass der <w>Tiegelhaken</w> fest eingehakt ist, bevor Sie das geschmolzene Metall bewegen."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Ein spezieller Haken oder Werkzeug in einer Gießerei zum Heben eines Schmelztiegels."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Tiegelhaken",
                                "target_lang_sense_clarification": "Werkzeug in der Gießerei"
                            },
                            {
                                "target_lang_word": "Tiegelzange",
                                "target_lang_sense_clarification": "Werkzeug zum Fassen von Tiegeln"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}