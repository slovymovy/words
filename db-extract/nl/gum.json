                        "entry_id": "30b65411-10ca-3d03-b9c5-1e5247560ba9",
                        "glosses": [
                            "een object waarmee potloodtekeningen weer weggehaald kunnen worden"
                        ],
                        "tags": [
                            "teken- en schrijfmateriaal"
                        ],
                        "examples": [
                            {
                                "example_id": "701e9621-894d-4933-9faf-413501f495ba",
                                "sense_id": "8481aecd-0819-3966-805e-ff423c2b44b7",
                                "text": "Met de gum kon hij die foutieve lijn uitwissen."
                            }
                        ]
