                ],
                "senses": [
                    {
                        "sense_id": "d2f9ca70-d15b-3f36-87e3-0228dc4a3a15",
                        "entry_id": "9e9ac548-f324-3444-abff-b1280c9114c8",
                        "glosses": [
                            "Wohnbezirk, in dem Hazara leben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2921256d-a3da-42fd-a79e-074a5dbbf21c",
                                "sense_id": "d2f9ca70-d15b-3f36-87e3-0228dc4a3a15",
                                "text": "„Vor allem Da‘esh führte seit 2015 gezielt Attentate gegen Schiiten durch; bei einem Bombenattentat am 23. Juli 2016 in einem Hazara-Viertel Kabuls kamen über achtzig Menschen ums Leben.“"
                            },
                            {
                                "example_id": "3b31d4d8-905c-4b5c-b263-b3bc4c5a18fb",
                                "sense_id": "d2f9ca70-d15b-3f36-87e3-0228dc4a3a15",
                                "text": "So wurden am Montag im Hazara-Viertel der Stadt Quetta zwei Polizisten von Unbekannten auf offener Straße erschossen."
                            },
                            {
                                "example_id": "e44dfb7a-978f-40ea-be69-3cc39f48d345",
                                "sense_id": "d2f9ca70-d15b-3f36-87e3-0228dc4a3a15",
                                "text": "Bewaffnete Männer streifen durch die Flure einer Entbindungsstation und erschießen junge Mütter und Frauen in den Wehen im selben Hazara-Viertel."
                            },
                            {
                                "example_id": "c5782698-8561-4cd1-81f9-da396a1b6e7d",
                                "sense_id": "d2f9ca70-d15b-3f36-87e3-0228dc4a3a15",
                                "text": "In Kabul haben wir gezielt mehrere Familien im Hazara-Viertel gefragt, wie es ihnen geht."
                            },
                            {
                                "example_id": "516be4bd-2d80-424e-a110-7bfdf0b0d647",
                                "sense_id": "d2f9ca70-d15b-3f36-87e3-0228dc4a3a15",
                                "text": "Hohe Mauern, die die Bewohner vor Kämpfern schützen sollen, umgeben die Hazara-Viertel – eine stetige Erinnerung an die ständige Gefahr von Anschlägen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
