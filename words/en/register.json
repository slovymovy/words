{
    "word_family": [
        "registration",
        "registry",
        "registrar",
        "deregister",
        "preregister"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1bcd6967-9d71-3c03-be85-2973904c3d25",
                    "sense_definition": "To put a name or other information in an official list or record.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "record_list",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>register</w> for the conference before the deadline.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>зарегистрироваться</w> на конференцию до истечения срока.",
                                "zh": "你需要在截止日期前为这次会议<w>注册</w>。"
                            }
                        },
                        {
                            "text": "They went to the town hall to <w>register</w> the birth of their child.",
                            "target_lang_translations": {
                                "ru": "Они пошли в мэрию, чтобы <w>зарегистрировать</w> рождение своего ребенка.",
                                "zh": "他们去市政厅为孩子<w>登记</w>出生信息。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enroll",
                        "book",
                        "put down",
                        "sign up",
                        "record"
                    ],
                    "antonyms": [
                        "deregister",
                        "unregister"
                    ],
                    "common_phrases": [
                        "register for",
                        "register with",
                        "register to vote"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вносить имя или другую информацию в официальный список или запись.",
                        "zh": "将姓名或其他信息列入官方名单或记录中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регистрировать",
                                "target_lang_sense_clarification": "вносить в официальный список"
                            },
                            {
                                "target_lang_word": "записываться",
                                "target_lang_sense_clarification": "вносить свое имя в список участников"
                            },
                            {
                                "target_lang_word": "оформлять",
                                "target_lang_sense_clarification": "документально фиксировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注册",
                                "target_lang_sense_clarification": "正式登记"
                            },
                            {
                                "target_lang_word": "登记",
                                "target_lang_sense_clarification": "记录在案"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2029ff8-ad86-38b7-866d-046ed896a485",
                    "sense_definition": "To be noticed, understood, or realized by someone.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "perceive_show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The joke did not <w>register</w> with him until a few minutes later.",
                            "target_lang_translations": {
                                "ru": "Шутка <w>дошла</w> до него только через несколько минут.",
                                "zh": "几分钟后他才<w>领会</w>到那个笑话。"
                            }
                        },
                        {
                            "text": "It barely <w>registered</w> that she had walked into the wrong room.",
                            "target_lang_translations": {
                                "ru": "Она едва <w>осознала</w>, что вошла не в ту комнату.",
                                "zh": "她几乎没<w>意识到</w>自己走错了房间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "barely register",
                        "not register"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть замеченным, понятым или осознанным кем-то.",
                        "zh": "被某人注意到、理解或意识到。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доходить",
                                "target_lang_sense_clarification": "разг. становиться понятным"
                            },
                            {
                                "target_lang_word": "осознавать",
                                "target_lang_sense_clarification": "понимать, отдавать отчет"
                            },
                            {
                                "target_lang_word": "восприниматься",
                                "target_lang_sense_clarification": "быть замеченным сознанием"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "意识到",
                                "target_lang_sense_clarification": "察觉到"
                            },
                            {
                                "target_lang_word": "领会",
                                "target_lang_sense_clarification": "理解"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "318519c8-869f-3675-bf4a-1873deda9ee6",
                    "sense_definition": "To show or express a feeling or opinion, often on one's face.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "perceive_show",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her face did not <w>register</w> any surprise when she heard the news.",
                            "target_lang_translations": {
                                "ru": "Ее лицо не <w>выразило</w> никакого удивления, когда она услышала новости.",
                                "zh": "听到这个消息时，她的脸上没有<w>流露</w>出任何惊讶。"
                            }
                        },
                        {
                            "text": "He <w>registered</w> a complaint about the poor service at the hotel.",
                            "target_lang_translations": {
                                "ru": "Он <w>подал</w> жалобу на плохое обслуживание в отеле.",
                                "zh": "他针对酒店糟糕的服务<w>提出</w>了投诉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "register surprise",
                        "register a complaint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать или выражать чувство или мнение, часто мимикой.",
                        "zh": "表现或表达出某种感觉或意见，通常通过面部表情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выражать",
                                "target_lang_sense_clarification": "проявлять эмоции"
                            },
                            {
                                "target_lang_word": "подавать",
                                "target_lang_sense_clarification": "официально заявлять (напр. жалобу)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流露",
                                "target_lang_sense_clarification": "显露情感"
                            },
                            {
                                "target_lang_word": "提出",
                                "target_lang_sense_clarification": "正式申诉或投诉"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77dd27aa-53d4-365c-97d0-12b7483eeffb",
                    "sense_definition": "To record, measure, or achieve a specific result or amount.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "record_list",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thermometer began to <w>register</w> a temperature well above freezing.",
                            "target_lang_translations": {
                                "ru": "Термометр начал <w>показывать</w> температуру значительно выше нуля.",
                                "zh": "温度计开始<w>显示</w>出远高于冰点的温度。"
                            }
                        },
                        {
                            "text": "The team failed to <w>register</w> a single goal during the match.",
                            "target_lang_translations": {
                                "ru": "Команде не удалось <w>забить</w> ни одного гола за матч.",
                                "zh": "比赛中该队没能<w>记录</w>下一粒进球。"
                            }
                        }
                    ],
                    "synonyms": [
                        "catalogue"
                    ],
                    "common_phrases": [
                        "register a win",
                        "register a score"
                    ],
                    "target_lang_definitions": {
                        "ru": "Записывать, измерять или достигать определенного результата или количества.",
                        "zh": "记录、测量或达到特定的结果或数值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показывать",
                                "target_lang_sense_clarification": "об измерительных приборах"
                            },
                            {
                                "target_lang_word": "фиксировать",
                                "target_lang_sense_clarification": "отмечать результат"
                            },
                            {
                                "target_lang_word": "забивать",
                                "target_lang_sense_clarification": "спорт. о голах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显示",
                                "target_lang_sense_clarification": "仪表读数"
                            },
                            {
                                "target_lang_word": "记录",
                                "target_lang_sense_clarification": "记下数据或成绩"
                            }
                        ]
                    }
                }
            ]
        },
        {
