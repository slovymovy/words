                    {
                        "translation_id": "18629933-f963-4b00-b7d6-a40801fa6da5",
                        "source_entry_id": "11103b8a-b827-3060-bbab-f40a0f9a448c",
                        "source_sense_id": "6784607e-52a7-3992-b19c-0aeaa0d02434",
                        "source_sense_description": "implement for sprinkling holy water",
                        "target_lang_word": "goupillon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "goupillon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cfa5797-441f-3321-bf08-b07b521408a1",
                                        "entry_id": "18357dee-8636-37f9-9300-b6b8711ed163",
                                        "glosses": [
                                            "Petit bâton de bois ou de métal garni de poils rudes ou d’une boule percée de trous, qui sert à l’église pour prendre de l’eau bénite et pour la jeter sur les objets qu’on bénit, ou la présenter à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56e93b76-ee73-40ff-b924-818ca143fae8",
                                                "sense_id": "8cfa5797-441f-3321-bf08-b07b521408a1",
                                                "text": "Il aspergea d’eau bénite le corps et le cercueil sur lequel il traça la forme d’une croix avec son goupillon."
                                            },
                                            {
                                                "example_id": "39e09ab9-8a0a-4edb-b470-2fa454c8faa5",
                                                "sense_id": "8cfa5797-441f-3321-bf08-b07b521408a1",
                                                "text": "Les assistants s’approchèrent de la fosse et, se passant de main en main le goupillon, qui trempait dans l’urne de cuivre, ils faisaient le signe de la croix sur la fosse béante."
                                            },
                                            {
                                                "example_id": "45213e5a-dfd1-4a92-8902-133898622a53",
                                                "sense_id": "8cfa5797-441f-3321-bf08-b07b521408a1",
                                                "text": "C’était un petit enfant de chœur en soutane et surplis. À côté de lui, il y avait cette longue croix qu’on porte aux enterrements et le seau d’eau bénite avec le goupillon."
                                            },
                                            {
                                                "example_id": "4df0aec2-8efb-4964-9f8c-3941d1eb10d3",
                                                "sense_id": "8cfa5797-441f-3321-bf08-b07b521408a1",
                                                "text": "Ils attendirent ainsi que la caisse de bois fût mise en place sur les tréteaux et recouverte d’un drap noir portant une grande croix en fil d’argent. Ensuite, les hommes allumèrent deux cierges de chaque côté, et les gens qui étaient là donnèrent l’eau bénite avec un gros goupillon qui trempait dans un seau de métal."
                                            },
                                            {
                                                "example_id": "1bd090bf-711a-4669-8bc4-c158498d5387",
                                                "sense_id": "8cfa5797-441f-3321-bf08-b07b521408a1",
                                                "text": "Qu'est-ce que tu veux ? Les filles, pour être heureuses, il leur faut tous les goupillons. Il ne s'esclafferait probablement pas : sa génération, vite couchée, mais aussi vite touchée, verbalement prude, ne comprenant plus cette sorte de rire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7a40e2-4f65-3210-97e5-9b454c8eb279",
                                        "entry_id": "18357dee-8636-37f9-9300-b6b8711ed163",
                                        "glosses": [
                                            "Symbole de l'Église. → voir le sabre et le goupillon"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b757d22e-e440-30f9-a4fe-ea2b8013055c",
                                        "entry_id": "18357dee-8636-37f9-9300-b6b8711ed163",
                                        "glosses": [
                                            "Brosse qui sert à nettoyer les bouteilles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1f4297d-1406-318a-b186-65c4dfcae4cc",
                                        "entry_id": "18357dee-8636-37f9-9300-b6b8711ed163",
                                        "glosses": [
                                            "Bâton muni de poils dont les chapeliers se servent pour asperger la feutrière et le bassin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0aeb27dc-1a9f-3711-bb9e-3ed44bcd6878",
                                        "entry_id": "18357dee-8636-37f9-9300-b6b8711ed163",
                                        "glosses": [
                                            "Grosse brosse utilisée par les cordiers pour étaler la colle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "00ff5dbb-760c-39b5-9e96-283171901547",
                                        "entry_id": "18357dee-8636-37f9-9300-b6b8711ed163",
                                        "glosses": [
                                            "Synonyme de callistemon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e45ba303-a33d-37d3-aa3c-375af5869009",
                                        "entry_id": "18357dee-8636-37f9-9300-b6b8711ed163",
                                        "glosses": [
                                            "Arme médiévale proche du fléau d'armes, avec plusieurs chaînes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04112a82-0012-351f-ab66-4f942a0b85dc",
                                        "entry_id": "18357dee-8636-37f9-9300-b6b8711ed163",
                                        "glosses": [
                                            "Arme qu’on brandit."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46ae43d0-5682-468e-b470-f1313c2083ec",
                                                "sense_id": "04112a82-0012-351f-ab66-4f942a0b85dc",
                                                "text": "— Ma foi, je me moque bien de tous ces exorcistes, moi ! reprit le soldat ; je m’appelle Grand-Ferré, et il n’y en a pas beaucoup qui aient un goupillon comme le mien.\nEt, prenant la poignée de son sabre d’une main, il retroussa de l’autre sa moustache blonde et regarda autour de lui en fronçant le sourcil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
