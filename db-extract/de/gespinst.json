                        "form": "das Gespinst"
                    },
                    {
                        "form_id": "328f4824-66a1-4047-b5d2-d52e6c220f7c",
                        "entry_id": "77be4e0f-ca7c-3f83-8249-da5f85cbf461",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gespinste"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9ae36f7-1858-368c-a833-66e6cc966589",
                        "entry_id": "77be4e0f-ca7c-3f83-8249-da5f85cbf461",
                        "glosses": [
                            "etwas, das gesponnen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "198ae0b4-fab6-4230-8dc2-70cd132e09cc",
                                "sense_id": "b9ae36f7-1858-368c-a833-66e6cc966589",
                                "text": "„Das nach der Elementenspinntechnologie hergestellte Gespinst aus Viskosefasern weist gegenüber dem auf der Baumwollringmaschine gesponnenen Garn eine etwas geringere Festigkeit auf.“"
                            },
                            {
                                "example_id": "fa05a16e-dd2e-4ecc-b437-197ef4357a0d",
                                "sense_id": "b9ae36f7-1858-368c-a833-66e6cc966589",
                                "text": "„Ähnlich wie bei Sakespeare ist dieses Gespinst aus Lügen und Verstellungen so schreiend ernsthaft komisch, weil der Trieb siegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "64a2d9f3-30cf-3b9a-ba2b-74cd532ea1fd",
                        "entry_id": "77be4e0f-ca7c-3f83-8249-da5f85cbf461",
                        "glosses": [
                            "feines Gewebe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c57f4e9-136a-4e2f-92fb-53744562c317",
                                "sense_id": "64a2d9f3-30cf-3b9a-ba2b-74cd532ea1fd",
                                "text": "„Ganz hinten ein zartgeblümtes Gespinst auf der Schneiderpuppe, Kaffee steht schwarz bereit, Puderquasten, eine Wimpernzange auf dem Partiturblatt, …“"
                            },
                            {
                                "example_id": "7e579433-596f-41fa-8f64-f4fd34010bfc",
                                "sense_id": "64a2d9f3-30cf-3b9a-ba2b-74cd532ea1fd",
                                "text": "„In Gärten, Grünanlagen und an Waldrändern fallen alljährlich im Frühsommer Bäume und Sträucher ins Auge, die völlig von einem schleierartigen Gespinst überzogen sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
