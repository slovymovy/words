                ],
                "senses": [
                    {
                        "sense_id": "fb559146-afc7-3c5e-a02e-099ef3877efa",
                        "entry_id": "24d3ac53-473f-3483-ab2c-f206a23bb4aa",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20894f04-0ef9-4a0e-a357-812bbfbea85e",
                                "sense_id": "fb559146-afc7-3c5e-a02e-099ef3877efa",
                                "text": "Frau Kneußle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "b1845b74-9ed6-49d5-98a0-6e6162f77336",
                                "sense_id": "fb559146-afc7-3c5e-a02e-099ef3877efa",
                                "text": "Herr Kneußle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "73db89aa-f2b6-4e7b-bca6-bd8bed1f30fe",
                                "sense_id": "fb559146-afc7-3c5e-a02e-099ef3877efa",
                                "text": "Die Kneußles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d67a5d29-97d6-49ff-a669-7b872b8c9b5c",
                                "sense_id": "fb559146-afc7-3c5e-a02e-099ef3877efa",
                                "text": "Der Kneußle trägt nie die Schals, die die Kneußle ihm strickt."
                            },
                            {
                                "example_id": "f6c72d98-89e3-4e73-abf9-f42940b0acc3",
                                "sense_id": "fb559146-afc7-3c5e-a02e-099ef3877efa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kneußle kommt, geht der Herr Kneußle.“"
                            },
                            {
                                "example_id": "29590b43-8c30-406b-985c-f403c1b6e647",
                                "sense_id": "fb559146-afc7-3c5e-a02e-099ef3877efa",
                                "text": "Kneußle kommt und geht."
                            },
                            {
                                "example_id": "eb69d0f1-9631-4b12-9bd8-3e33a9f377c3",
                                "sense_id": "fb559146-afc7-3c5e-a02e-099ef3877efa",
                                "text": "Kneußles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
