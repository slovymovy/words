                    {
                        "sense_id": "0a3740e0-fb3c-31e3-8d6b-fccdc4c27156",
                        "entry_id": "71b2957e-2e44-304a-843e-ddd99f475a5d",
                        "glosses": [
                            "sehr langsam fahrende oder stehende Reihe von Autos bei einem Verkehrsstau"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2c0dab1-bef8-44b8-a10b-757d5de30fc3",
                                "sense_id": "0a3740e0-fb3c-31e3-8d6b-fccdc4c27156",
                                "text": "Die Autoschlange vor der Baustelle war mehrere Kilometer lang."
                            },
                            {
                                "example_id": "790e598b-7911-4f90-a921-3357a8dcb218",
                                "sense_id": "0a3740e0-fb3c-31e3-8d6b-fccdc4c27156",
                                "text": "„Endlose Autoschlangen blieben in endlosem Verkehrschaos stundenlang stecken.“"
                            },
                            {
                                "example_id": "2d8eda31-711f-4051-927f-2239cb2c8226",
                                "sense_id": "0a3740e0-fb3c-31e3-8d6b-fccdc4c27156",
                                "text": "„Am Ende der Autoschlange flimmerte die heiße Luft über dem glühenden Teerboden, und ich schmorte bei 45 Grad in der Sonne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
