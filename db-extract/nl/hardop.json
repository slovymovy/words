        "nl-extract.jsonl": [
            {
                "entry_id": "5c0e7098-fb34-3949-8a61-4ac8f8b9f765",
                "word": "hardop",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7423b4c-f3d9-379b-b72e-bcb14ba8b033",
                        "entry_id": "5c0e7098-fb34-3949-8a61-4ac8f8b9f765",
                        "glosses": [
                            "helder, duidelijk, goed verstaanbaar van de stem gebruik makend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c51484-2dea-4c6a-8790-f582b52418d0",
                                "sense_id": "a7423b4c-f3d9-379b-b72e-bcb14ba8b033",
                                "text": "Wil je dat even hardop voorlezen?"
                            },
                            {
                                "example_id": "f6715b9f-ef7e-4a66-b42b-efe20f68ade9",
                                "sense_id": "a7423b4c-f3d9-379b-b72e-bcb14ba8b033",
                                "text": "Aangezien ik niks kon zeggen pakte zij het boek De profeet van Kahlil Gibran uit haar rugzak en begon mij hardop voor te lezen."
                            },
                            {
                                "example_id": "93fc9dd6-e019-4d7b-ab41-314601edeea3",
                                "sense_id": "a7423b4c-f3d9-379b-b72e-bcb14ba8b033",
                                "text": "De graaf fronste en tuitte zijn lippen. Het is namelijk wel deftig om beledigingen te laten doorschemeren, maar niet om ze hardop uit te spreken."
                            },
                            {
                                "example_id": "ec4a83e8-1a73-4b00-bdf1-b2cdeec5b12d",
                                "sense_id": "a7423b4c-f3d9-379b-b72e-bcb14ba8b033",
                                "text": "Die gedachte durft ze nooit hardop uit te spreken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb89e5b0-29a8-4f15-aacf-f3adebad6009",
                        "source_entry_id": "5c0e7098-fb34-3949-8a61-4ac8f8b9f765",
                        "source_sense_id": "a7423b4c-f3d9-379b-b72e-bcb14ba8b033",
                        "target_lang_word": "aloud",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aloud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "caaea191-5d09-3551-b2ad-72c2b03b601a",
                                        "entry_id": "b45dd35f-8f3d-320b-9ee2-eb942433b68a",
                                        "glosses": [
                                            "With a loud voice, or great noise; loudly; audibly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "958c0f32-2c5b-4b0b-ab32-256d9035d8a6",
                                                "sense_id": "caaea191-5d09-3551-b2ad-72c2b03b601a",
                                                "text": "Try speaking aloud rather than whispering."
                                            },
                                            {
                                                "example_id": "a96a17f0-9fc7-4afd-94b8-d8feddd80c2a",
                                                "sense_id": "caaea191-5d09-3551-b2ad-72c2b03b601a",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c871284-71e8-3d0b-bb07-f7db92c8ac0c",
                                        "entry_id": "b45dd35f-8f3d-320b-9ee2-eb942433b68a",
                                        "glosses": [
                                            "Audibly, as opposed to silently/quietly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c6d92a9-9ff6-4aaa-8c3e-26e233c1c173",
                                                "sense_id": "7c871284-71e8-3d0b-bb07-f7db92c8ac0c",
                                                "text": "speaking aloud rather than thinking thoughts privately"
                                            },
                                            {
                                                "example_id": "75dfcff1-05e9-450d-8d2a-5f085c30d54c",
                                                "sense_id": "7c871284-71e8-3d0b-bb07-f7db92c8ac0c",
                                                "text": "He read the letter aloud. Sophia listened with the studied air of one for whom, even in these days, a title possessed some surreptitious allurement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aloud",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa70a2bb-d3fa-3a67-b3f7-673e1b11aeaa",
                                        "entry_id": "4bec1ea9-6a05-38c1-8091-e71c1fd09077",
                                        "glosses": [
                                            "Spoken out loud."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74133d9d-0b76-42be-b66f-a2484818510b",
                                                "sense_id": "fa70a2bb-d3fa-3a67-b3f7-673e1b11aeaa",
                                                "text": "When you are meditating with sound, it can be aloud or it can be silent"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7be656cc-225f-452e-8b33-feba8d832f13",
                        "source_entry_id": "5c0e7098-fb34-3949-8a61-4ac8f8b9f765",
                        "source_sense_id": "a7423b4c-f3d9-379b-b72e-bcb14ba8b033",
                        "target_lang_word": "loudly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loudly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d997cf6b-06b3-3b38-9a47-84dae46bfddf",
                                        "entry_id": "3a4578d1-f903-3848-bc50-778d99f9a945",
                                        "glosses": [
                                            "In a loud manner; at a high volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e8c23a6-7c93-4ade-9707-6a4ad5a2ff1e",
                                                "sense_id": "d997cf6b-06b3-3b38-9a47-84dae46bfddf",
                                                "text": "He spoke loudly so that his brother could hear him from across the street."
                                            },
                                            {
                                                "example_id": "65d4546d-e5e6-47aa-839a-76949362a94c",
                                                "sense_id": "d997cf6b-06b3-3b38-9a47-84dae46bfddf",
                                                "text": "And still when loudliest howls the storm, / And darkliest lowers his native sky, / The king's fierce soul is in that form, / The warrior's spirit threatens nigh!"
                                            },
                                            {
                                                "example_id": "7e4e3aac-a9a0-4689-bd7c-55adf7d0a3cf",
                                                "sense_id": "d997cf6b-06b3-3b38-9a47-84dae46bfddf",
                                                "text": "Instead of that his hot hand suddenly seized mine and his dull-shining eyes swept my face for a moment, whilst he cried out, much loudlier and distinctlier than he had as yet spoken anything: “Edith! Ah, Edith, this is you at last. Where have you been keeping yourself?”"
                                            },
                                            {
                                                "example_id": "42edee24-7425-4493-a6ed-79584f9aee6e",
                                                "sense_id": "d997cf6b-06b3-3b38-9a47-84dae46bfddf",
                                                "text": "\"Holy crap on a cracker! That paint job would cost three or four thousand dollars in the city,\" exclaimed John loudly."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c9fb31e-249e-40bd-88a5-932210c88240",
                        "source_entry_id": "5c0e7098-fb34-3949-8a61-4ac8f8b9f765",
                        "source_sense_id": "a7423b4c-f3d9-379b-b72e-bcb14ba8b033",
                        "target_lang_word": "laut",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3ccfb8d-fa48-3bd5-9b1f-3ac539af49c9",
                                        "entry_id": "c176a803-82f0-33a6-a869-a97631faaf10",
                                        "glosses": [
                                            "stark, intensiv; weit zu hören"
                                        ],
                                        "tags": [
                                            "von Tönen und Stimmen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cedb494-a896-4c0f-a6b6-12722d740eb2",
                                                "sense_id": "e3ccfb8d-fa48-3bd5-9b1f-3ac539af49c9",
                                                "text": "Dreh bitte mal das Radio lauter!"
                                            },
                                            {
                                                "example_id": "9c3c631f-70e8-4d63-a038-62359477a953",
                                                "sense_id": "e3ccfb8d-fa48-3bd5-9b1f-3ac539af49c9",
                                                "text": "Sie sprach sehr laut."
                                            },
                                            {
                                                "example_id": "5c275fb2-0148-4ae5-9f89-4de7b923cd6a",
                                                "sense_id": "e3ccfb8d-fa48-3bd5-9b1f-3ac539af49c9",
                                                "text": "Die Explosion erzeugte den lautesten Knall, den er jemals gehört hatte und ließ ihn taub zurück."
                                            },
                                            {
                                                "example_id": "2c2117c8-712d-4430-a3d9-300f7b66bfad",
                                                "sense_id": "e3ccfb8d-fa48-3bd5-9b1f-3ac539af49c9",
                                                "text": "Der laute Lüfter ihres Computers ging ihr gehörig auf die Nerven."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "56adcada-14a7-3759-9184-da3fc00b15ba",
                                        "entry_id": "c176a803-82f0-33a6-a869-a97631faaf10",
                                        "glosses": [
                                            "mit Lärm erfüllt; voller störender Geräusche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34f94d89-ba33-4b4f-98b3-494080112918",
                                                "sense_id": "56adcada-14a7-3759-9184-da3fc00b15ba",
                                                "text": "Hier ist es viel zu laut, um sich konzentrieren zu können."
                                            },
                                            {
                                                "example_id": "32ca80d2-f08e-44ec-8e74-93e9345b2cb9",
                                                "sense_id": "56adcada-14a7-3759-9184-da3fc00b15ba",
                                                "text": "Willst du wirklich in so eine laute Gegend umziehen?"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c678fa7c-2ede-38c7-bb79-0ca58b8a12f5",
                                        "entry_id": "c176a803-82f0-33a6-a869-a97631faaf10",
                                        "glosses": [
                                            "schnell"
                                        ],
                                        "tags": [
                                            "Erzgebirgisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31deab8e-00f4-402d-a31d-30e4a934a02c",
                                                "sense_id": "c678fa7c-2ede-38c7-bb79-0ca58b8a12f5",
                                                "text": "Mach laut, damitis schaffst!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "laut",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                        "entry_id": "2968c54a-6c8e-3517-ae4e-2eab888fb6fd",
                                        "glosses": [
                                            "besagter Quelle zufolge"
                                        ],
                                        "tags": [
                                            "genitive prepositional",
                                            "with-dative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a6fef88-d453-4391-9483-061628a65ec9",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "Laut DPA hat es bei dem Erdbeben 80 Tote gegeben."
                                            },
                                            {
                                                "example_id": "9a1f13e9-79ec-4d1b-9818-9e65982c9f8a",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "„Führen Gespräche mit Lehrern und Schulpsychologen jedoch zu nichts, können schulpflichtige Schüler laut Bayerischen Erziehungs- und Unterrichtsgesetzes (BayEug) für Absenzen belangt werden.“"
                                            },
                                            {
                                                "example_id": "7ba7837d-6fe8-4a16-bed3-df921134f060",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "„Vor 30 Jahren (1980) gewann Beat Spreiter laut «Vaterland» die Landesmeisterschaften im Deltafliegen vor Hansjörg Frommelt und Markus Erne.“"
                                            },
                                            {
                                                "example_id": "bff64f85-8450-4ba0-8d7d-c163b917257d",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "„Laut Aussage der Veranstalter liege die Bestmarke im Drachensteigen derzeit bei 674 Fluggeräten.“"
                                            },
                                            {
                                                "example_id": "85502fa2-b04a-4967-b358-21cd4183d7f3",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "[…] „In Deutschland verursachen Flüge laut Statistischem Bundesamt und Öko-Institut pro Jahr etwa 28 Millionen Tonnen CO2 – ungefähr 3 Prozent der Treibhausgase.“"
                                            },
                                            {
                                                "example_id": "912f7ccf-763f-42a8-b589-7317d319b9a3",
                                                "sense_id": "2903650d-0a0b-3af2-9022-72450026cd55",
                                                "text": "„Eine plötzliche Vertragskündigung durch Yahoo beendete laut dem Verein die Geschäftsbeziehung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
