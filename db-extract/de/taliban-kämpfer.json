                                "example_id": "7ba8ef6d-c609-4c5f-9d75-07d948072215",
                                "sense_id": "c666b8af-2d83-3b53-9b0a-1707c3a1303c",
                                "text": "„Kolt erkannte im Bruchteil einer Sekunde, dass er es mit einem Taliban-Kämpfer zu tun hatte.“"
                            },
