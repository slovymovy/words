                                            "alt-of",
                                            "clipping",
                                            "countable",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "dough",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4340e3b6-2d45-3ca2-b3ac-eeb9ec8c92df",
