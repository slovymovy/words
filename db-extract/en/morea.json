                "forms": [],
                "senses": [
                    {
                        "sense_id": "898ed191-9801-39c5-b444-a497e2f137e2",
                        "entry_id": "4baffd41-be9a-3757-b960-a9c0d7779f8c",
                        "glosses": [
                            "Synonym of Peloponnese, a peninsula in Greece, particularly under Turkish rule."
                        ],
                        "tags": [
                            "archaic",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "9c35e6ec-fd8f-4d66-82f8-a4b2854c43c1",
                                "sense_id": "898ed191-9801-39c5-b444-a497e2f137e2",
                                "text": "[...] and south to the towns of Pyrgos, from which a branch runs to Olympia, and Kyparissia, on the west coast of Morea."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce01d746-0c53-3322-8fab-399ab5bc0191",
                        "entry_id": "4baffd41-be9a-3757-b960-a9c0d7779f8c",
                        "glosses": [
                            "A former polity in Europe."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c0f60700-adad-39b7-81f7-9e66b14cca26",
                        "entry_id": "4baffd41-be9a-3757-b960-a9c0d7779f8c",
                        "glosses": [
                            "An eyalet in the Ottoman Empire."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48171415-d1c5-4d6c-9bd0-e6189fb946b7",
                        "source_entry_id": "4baffd41-be9a-3757-b960-a9c0d7779f8c",
                        "source_sense_description": "Ottoman-era Peloponnese",
                        "target_lang_word": "Morée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Morée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b8df3d2-75e0-3a6a-ba6f-42e750c1c1c1",
                                        "entry_id": "b40ae7c7-9afb-34e2-9920-a69feb823c18",
                                        "glosses": [
                                            "Péloponnèse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bca33615-b83f-4b18-bb79-b18b2773c0e2",
                                                "sense_id": "8b8df3d2-75e0-3a6a-ba6f-42e750c1c1c1",
                                                "text": "La Morée est assez fertile, excepté vers le milieu où sont les montagnes. Aussi l’Arcadie qui jadis occupoit ce milieu, avoit beaucoup d’habitans menant la vie pastorale. Le Brazzo di Maina est encore plus stérile que le reste ; aussi voyons-nous que ses anciens habitans, les Lacédémoniens, faisoient de nécessité vertu, & suppléoient, par leur frugalité, à ce qui leur manquoit du côté de l’abondance ; mais ce qui vaut cent fois mieux, ils étoient libres. Les Magnotes, leurs successeurs, le sont encore ; & les Turcs qui les environnent, n’ont pû les subjuguer entierement. Il y a dans la Morée beaucoup d’Albanois qui, ne sachant ni porter le joug du turc, ni le secouer, attirent souvent aux habitans de fâcheuses affaires. Le morabégi ou sangiac qui commande en Morée, a sa résidence à Modon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Morée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
