            {
                "entry_id": "f070f4e5-49c9-3280-b4ca-8de1e0480d58",
                "word": "Sye",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d8aada2c-2f0a-3020-a44a-19f689164ecf",
                        "entry_id": "f070f4e5-49c9-3280-b4ca-8de1e0480d58",
                        "glosses": [
                            "A male or female given name."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "450d1f64-655f-46b3-9f42-2acbfb09893a",
                                "sense_id": "d8aada2c-2f0a-3020-a44a-19f689164ecf",
                                "text": "I was gripping on to Sye's shirt so hard that my fingers had lost blood circulation and they cramped when I let go. I sat up and held on to Sye with an exploding mixture of emotions. I cried into his chest, and he embraced me ..."
                            },
                            {
                                "example_id": "6b9dbbae-aee8-49aa-a87e-de3ba127312c",
                                "sense_id": "d8aada2c-2f0a-3020-a44a-19f689164ecf",
                                "text": "Many things came to Sye's mind that wanted to be said, but his tongue refused to push them into reality. Struggling for a moment, Sye finally settled to whisper in a strained voice,"
                            },
                            {
                                "example_id": "a2cd72bd-9037-4bbb-a512-dc4eda0abe0b",
                                "sense_id": "d8aada2c-2f0a-3020-a44a-19f689164ecf",
                                "text": "Rae listened to Sye as she talked; the excitement was clearly read in Sye's face and felt in her words."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "02be174c-0dfb-316a-ac58-c0bbfe1211ce",
