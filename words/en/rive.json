                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "причаливать",
                                "target_lang_sense_clarification": "к берегу"
                            },
                            {
                                "target_lang_word": "приставать",
                                "target_lang_sense_clarification": "к берегу"
                            }
                        ]
                    }
                }
            ]
        },
        {
