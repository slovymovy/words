                "senses": [
                    {
                        "sense_id": "a183401c-15d0-3b61-83bc-64953c3d0351",
                        "entry_id": "6e20635b-7a61-3dda-a7b2-e848fb1c3983",
                        "glosses": [
                            "Manta birostris Walbaum, gatunek ryby chrzęstnoszkieletowej, największy przedstawiciel rodziny mantowatych"
                        ],
                        "tags": [
                            "syst."
                        ],
                        "examples": [
                            {
                                "example_id": "b9923dba-efc2-4053-a3eb-ca75ad2afda4",
                                "sense_id": "a183401c-15d0-3b61-83bc-64953c3d0351",
                                "text": "Czasem można spotkać manty na głębszych wodach."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "066b7c7a-598d-3149-9f2b-25370fb3b6b7",
