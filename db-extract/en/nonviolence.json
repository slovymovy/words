                    },
                    {
                        "translation_id": "1a774f70-b416-42e0-a3fd-abd0c0870e3e",
                        "source_entry_id": "8b0c9d2d-5615-3ea4-b1c5-c5bd11519c1d",
                        "source_sense_id": "c2ea711b-98af-31fb-b8c3-fb3eee967419",
                        "source_sense_description": "philosophy that rejects violence",
