                        "glosses": [
                            "Homme chargé de jalonner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c203fa4-e614-4547-8390-a3de7822287c",
                                "sense_id": "131eead9-38d8-3144-9999-26a822610670",
                                "text": "Les jalonneurs ont mal tracé cet alignement."
                            }
                        ]
                    },
                    {
                        "sense_id": "a90f2deb-18f7-37ce-999b-0a006fc7c684",
                        "entry_id": "e23ea8c2-004f-329b-a920-65a3ba660f1a",
                        "glosses": [
                            "Homme qu’on place, ou qui se place, en guise de jalon, pour déterminer d’avance une direction, un alignement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4845aa9-f00d-4f2d-8f34-61b03a096663",
                                "sense_id": "a90f2deb-18f7-37ce-999b-0a006fc7c684",
                                "text": "Établir, placer des jalonneurs. - Le premier, le second jalonneur."
                            },
                            {
                                "example_id": "6ce89eb9-e4ba-4d23-b949-cb21afc304f2",
                                "sense_id": "a90f2deb-18f7-37ce-999b-0a006fc7c684",
                                "text": "Quant aux jalonneurs, ils semblaient exténués. Assis au bord des trottoirs, ils n'agitaient plus leurs lampes électriques."
                            }
                        ]
                    }
                ],
