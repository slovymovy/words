                {
                    "sense_id": "46306f07-1e86-3ba0-84ed-2aa757c6bd93",
                    "sense_definition": "Bij iemand passen of door iemand leuk gevonden worden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_suit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat nieuwe werk <w>ligt</w> hem eigenlijk wel goed.",
                            "target_lang_translations": {
                                "ru": "Эта новая работа ему на самом деле <w>подходит</w>.",
                                "en": "That new job actually <w>suits</w> him quite well.",
                                "pl": "Ta nowa praca właściwie całkiem mu <w>leży</w>.",
                                "de": "Diese neue Arbeit <w>liegt</w> ihm eigentlich ganz gut.",
                                "fr": "Ce nouveau travail lui <w>convient</w> plutôt bien en fait.",
                                "it": "Quel nuovo lavoro in realtà gli <w>addice</w> piuttosto bene.",
                                "cs": "Ta nová práce mu vlastně docela <w>sedí</w>.",
                                "tr": "Bu yeni iş ona aslında oldukça iyi <w>uyuyor</w>.",
                                "es": "Ese nuevo trabajo en realidad se le <w>da</w> bastante bien."
                            }
                        },
