                "senses": [
                    {
                        "sense_id": "43fe8f7f-246e-341d-bd25-35526db7dc9d",
                        "entry_id": "c95790c7-221c-34ea-bedb-426d9bc79b50",
                        "glosses": [
                            "het aanhoudend snel op de benen voortbewegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e696f11a-068a-4c6a-91e8-044507c9194a",
                                "sense_id": "43fe8f7f-246e-341d-bd25-35526db7dc9d",
                                "text": "Dat Klopp sinds zijn komst in oktober weinig fout kan doen in Engeland, ligt niet alleen aan zijn gehol langs de lijn. Tegenover het journaille heeft de Duitser alles wat Louis van Gaal niet heeft. Charme, geduld, humor en met zijn Engels is niets mis."
                            },
                            {
                                "example_id": "345ee11d-5b2c-4699-8263-4aad3bce4f82",
                                "sense_id": "43fe8f7f-246e-341d-bd25-35526db7dc9d",
                                "text": "Gehol en geschreeuw van de jongens was tante niet gewend. Pas nu kan de familie het huis ongeremd verkennen. „Rennen, verstoppertje spelen... Ze raken hier niet uitgekeken. Vooral de toren is spannend. Vorige week hebben ze op de zolder met vriendjes echte zwaarden gevonden.”"
                            }
                        ]
                    }
                ],
