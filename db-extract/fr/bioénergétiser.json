                "senses": [
                    {
                        "sense_id": "d55c0a4a-e45b-3626-bd6f-3e903374c83d",
                        "entry_id": "72b04f49-551a-3950-bdac-49f483bcf529",
                        "glosses": [
                            "Donner un caractère bioénergétique à quelque chose."
                        ],
                        "tags": [
                            "Pseudo-sciences"
                        ],
                        "examples": [
                            {
                                "example_id": "dac9e001-2ac5-43fb-82d6-dc7153043c6b",
                                "sense_id": "d55c0a4a-e45b-3626-bd6f-3e903374c83d",
                                "text": "Ce sont de très puissants émetteusr ^([sic : émetteurs]) radioniques, parfaits, entre autres, pour purifier et bioénergétiser les eaux."
                            },
                            {
                                "example_id": "23d40d04-7392-4d1d-aba4-0437ecec3f65",
                                "sense_id": "d55c0a4a-e45b-3626-bd6f-3e903374c83d",
                                "text": "A ^([sic : À]) base d’eau déminéralisée vitalisée, Sel de la mer Morte … bioénergétisé."
                            },
                            {
                                "example_id": "3b608547-9379-4264-bb7a-09957ad3c0dc",
                                "sense_id": "d55c0a4a-e45b-3626-bd6f-3e903374c83d",
                                "text": "Pour comprendre les avantages d’une eau dynamisée, énergétisée, magnétisée, bioénergétisée, etc… ^([sic : etc.]) Il est nécessaire d’expliquer ce qu’est la dynamisation de l’eau et de toutes choses sur Terre et dans l’Univers."
                            }
                        ]
                    }
