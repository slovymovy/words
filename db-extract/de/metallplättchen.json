                    {
                        "sense_id": "e932ac77-9d35-3e35-95f5-43a060ed2e8c",
                        "entry_id": "36dcd3de-0f36-3709-b34f-b6b2c0330ee9",
                        "glosses": [
                            "kleine Scheibe aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8921baa-df8c-464b-af31-0fc2b027e15e",
                                "sense_id": "e932ac77-9d35-3e35-95f5-43a060ed2e8c",
                                "text": "„Es war so hell, dass er im Mondlicht die Metallplättchen an den Köpfen der Pferden ebenso deutlich blitzen sah wie die Augen der Tiere, die sich nach den Einsteigenden umwandten, ganz erschrocken über den Lärm, den diese im Dunkel unter dem Vordach des Portals machten.“"
                            },
                            {
                                "example_id": "57f94bdf-f3bb-4b81-9c54-c6a3df60345d",
                                "sense_id": "e932ac77-9d35-3e35-95f5-43a060ed2e8c",
                                "text": "„Frauen und Mädchen glitten behende auf ihre Schemel an der Schaltwand, der Maschinenmeister ergriff seinen langen Bakel und schob eifrig die Metallplättchen hin und her, Herr Wiedehuck trat einige Schritte zu dem Archivar zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
