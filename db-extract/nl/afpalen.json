                "senses": [
                    {
                        "sense_id": "783961f6-75f7-3a7e-8682-00d80c6981b7",
                        "entry_id": "4cabb1b4-0612-31c6-81f0-adb9e4314599",
                        "glosses": [
                            "duidelijk aangeven waar het ene eindigt en het andere begint"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ebe5d806-e2ae-41b9-867b-8638b58adaa8",
                                "sense_id": "783961f6-75f7-3a7e-8682-00d80c6981b7",
                                "text": "Een citeerzin legt die relatie juist expliciet: door het gebruik van zeggen, de dubbele punt en vooral de aanhalingstekens. Deze laatste geven te kennen dat ze een domein afpalen waarbinnen iemand anders voor de tekst verantwoordelijk is dan de journalist."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf26a327-b7d5-47b1-9768-5020ad0b5d2f",
                        "source_entry_id": "4cabb1b4-0612-31c6-81f0-adb9e4314599",
                        "source_sense_id": "783961f6-75f7-3a7e-8682-00d80c6981b7",
                        "source_sense_description": "duidelijk aangeven waar het ene eindigt en het andere begint",
                        "target_lang_word": "outline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56f44d40-43f1-379e-b2fd-4fce9340d963",
                                        "entry_id": "426ae695-d4a4-3fd8-82e1-05c06423d43a",
                                        "glosses": [
                                            "A line marking the boundary of an object figure."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92e663ea-bb03-3843-b3c7-f01b5afdaf28",
                                        "entry_id": "426ae695-d4a4-3fd8-82e1-05c06423d43a",
                                        "glosses": [
                                            "The outer shape of an object or figure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f56638e6-8b1e-4c84-a756-f6dd40528c4a",
                                                "sense_id": "92e663ea-bb03-3843-b3c7-f01b5afdaf28",
                                                "text": "From this point of vantage, we were able to gain an impression of the massive outlines of the main structure, and its intricate maze of girders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11b53189-a1a7-3834-b871-f339a0fd2869",
                                        "entry_id": "426ae695-d4a4-3fd8-82e1-05c06423d43a",
                                        "glosses": [
                                            "A sketch or drawing in which objects are delineated in contours without shading."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3074cfef-c250-4a82-ab58-bff158cd4f82",
                                                "sense_id": "11b53189-a1a7-3834-b871-f339a0fd2869",
                                                "text": "Painters, by their outlines, colours, lights, and shadows, represent the same in their pictures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e77d6327-ea05-3613-864f-ffc8bfcf87e3",
                                        "entry_id": "426ae695-d4a4-3fd8-82e1-05c06423d43a",
                                        "glosses": [
                                            "A general description of some subject."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "85689d8b-d476-31f7-8a42-6eeddfa15fd7",
                                        "entry_id": "426ae695-d4a4-3fd8-82e1-05c06423d43a",
                                        "glosses": [
                                            "A statement summarizing the important points of a text."
                                        ],
