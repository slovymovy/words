                        "glosses": [
                            "The condition of being inconsolable."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "7ac1fc5f-925d-4eee-90e9-1c9ba12ec5f4",
                                "sense_id": "16d70f9b-d0c3-3e71-b68c-a08242e66aa2",
                                "text": "Sometimes inconsolability may occur in newborns and infants. If your baby is crying so much that you are worried or despairing, call your pediatrician and ask for help."
                            },
                            {
                                "example_id": "4229728d-ec8f-4b22-be09-9c9540c7686e",
                                "sense_id": "16d70f9b-d0c3-3e71-b68c-a08242e66aa2",
                                "text": "Scenes of utter destruction and inconsolability remind us why war is a bad solution to life's problems. In many cases the (alleged) cure is worse than the disease."
                            }
                        ]
                    }
