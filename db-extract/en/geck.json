                ],
                "senses": [
                    {
                        "sense_id": "23d320d4-276c-339e-bf61-e2234c94f0b3",
                        "entry_id": "db015100-a28a-38d5-986c-d45878721efb",
                        "glosses": [
                            "Fool; idiot; imbecile."
                        ],
                        "tags": [
                            "archaic",
                            "countable",
                            "derogatory",
                            "poetic",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ace7bd05-659b-4381-b01a-eb7f8a25a9df",
                                "sense_id": "23d320d4-276c-339e-bf61-e2234c94f0b3",
                                "text": "To become the geck and scorn / O' the other's villainy."
                            },
                            {
                                "example_id": "7921e33b-61be-4683-afec-37283ab44a3e",
                                "sense_id": "23d320d4-276c-339e-bf61-e2234c94f0b3",
                                "text": "… for where’s the use of a woman having brains of her own if she’s tackled to a geck as everybody’s a-laughing at?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "6cb385a9-b98e-32a5-ad57-936a94810470",
