                    },
                    {
                        "form_id": "626f144b-2f2e-43cb-8244-a553e52e3abe",
                        "entry_id": "07def8ed-dbe0-3391-8fd6-766470ae80ef",
                        "tags": [
                            "masculine"
                        ],
                        "form": "aventurier"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "91f46ebf-d1dd-3501-818d-9c9e3d80d7a9",
                        "entry_id": "07def8ed-dbe0-3391-8fd6-766470ae80ef",
                        "glosses": [
                            "Celle qui aime les aventures extraordinaires, qui court le monde et s’engage volontiers dans les entreprises hasardeuses où elle peut espérer quelque avantage."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "09d93e43-2b5b-3f4c-bece-f302d9adf81c",
                        "entry_id": "07def8ed-dbe0-3391-8fd6-766470ae80ef",
                        "glosses": [
                            "Celle qui est sans état et sans fortune et qui vit d’expédients."
                        ],
                        "tags": [
                            "Plus courant"
                        ],
                        "examples": [
                            {
                                "example_id": "7d918ac0-15d7-470b-8e41-6f6628554e0a",
                                "sense_id": "09d93e43-2b5b-3f4c-bece-f302d9adf81c",
                                "text": "Cette dépravée, cette aventurière qui vient nous narguer et a le toupet de nous donner des leçons !"
                            },
                            {
                                "example_id": "a7dd4e13-63c4-40e5-bfa2-dcf4690cfc46",
                                "sense_id": "09d93e43-2b5b-3f4c-bece-f302d9adf81c",
                                "text": "— J'ai résisté longtemps, mais Édouard parlait de se détruire... j'ai consenti pour sauver ses jours, et je vous l'ai conservé frais et dispos. … — L'imbécile ! se tuer pour une aventurière !"
                            },
                            {
                                "example_id": "0f463109-d6a4-45c0-96fe-e05bf72248e0",
                                "sense_id": "09d93e43-2b5b-3f4c-bece-f302d9adf81c",
                                "text": "« Le dictionnaire définit “un aventurier” comme “une personne qui vit, qui apprécie ou qui recherche l’aventure”, mais “une aventurière” comme “une femme prête à tout pour acquérir de la richesse ou une position sociale” », relève Gloria Steinem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb794cde-7510-4a5e-8142-f0867c7c172a",
                        "source_entry_id": "07def8ed-dbe0-3391-8fd6-766470ae80ef",
                        "target_lang_word": "Abenteuerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abenteuerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7632a7b5-3b93-3c2a-8e63-eddbb2bab6c1",
                                        "entry_id": "0dbda06d-7d14-3c2b-985f-f976c453af3d",
                                        "glosses": [
                                            "eine weibliche Person, die Abenteuer sucht, erlebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c66a15a8-3f17-47f6-9fd8-65cfadd280c8",
                                                "sense_id": "7632a7b5-3b93-3c2a-8e63-eddbb2bab6c1",
                                                "text": "„Die Abenteuerin Ella Maillart (1903–1997) reiste nicht, um zu schreiben, sondern schrieb, um zu reisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "956d1e67-5707-49d6-9a07-4d62295cb096",
                        "source_entry_id": "07def8ed-dbe0-3391-8fd6-766470ae80ef",
                        "target_lang_word": "Abenteurerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abenteurerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a7348c37-9b40-3c05-b8c0-a0f84a17004c",
                                        "entry_id": "fda33ab1-c388-3c1d-b6b2-8e8d678d9a7f",
                                        "glosses": [
                                            "eine weibliche Person, die Abenteuer sucht, erlebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c76295e0-b83d-4e0f-aaac-f32558817151",
                                                "sense_id": "a7348c37-9b40-3c05-b8c0-a0f84a17004c",
                                                "text": "„Die Schweizer Abenteurerin Isabelle Eberhardt verkleidete sich im 19. Jh. als Berber, trat einer Sufi-Sekte bei, rauchte Haschisch, betätigte sich als Dreifachagentin, heiratete einen algerischen Dissidenten, wurde von den Franzosen aus Nordafrika ausgewiesen und schrieb ihre Memoiren ‚Die Vergessenssucher‘ – alles vor ihrem 30. Geburtstag“"
                                            },
                                            {
                                                "example_id": "274ec6ff-2224-49e5-a362-c3eba9d2e9cc",
                                                "sense_id": "a7348c37-9b40-3c05-b8c0-a0f84a17004c",
                                                "text": "„Heute hatte sie sich wieder so gefühlt wie die junge Abenteurerin, die vor zehn Jahren nach Paris gekommen war, A. Monnier getroffen und sich in eine Buchhandlung und ein Leben verliebt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "52335bb4-72e2-4e67-a477-7a25c8b0f72c",
                        "source_entry_id": "07def8ed-dbe0-3391-8fd6-766470ae80ef",
                        "target_lang_word": "adventuress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adventuress",
