    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89f2c0dc-6d60-30f8-bb0f-7b42a2f276bf",
                    "sense_definition": "Période de cent ans consécutifs, servant notamment de repère chronologique dans le calendrier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette magnifique cathédrale a été construite au douzième <w>siècle</w>."
                        },
                        {
                            "text": "Nous vivons aujourd'hui au début du vingt et unième <w>siècle</w>."
                        }
                    ],
                    "synonyms": [
                        "centenaire"
                    ],
                    "common_phrases": [
                        "au siècle dernier",
                        "fin de siècle",
                        "quart de siècle"
                    ]
                },
                {
                    "sense_id": "94cbdda0-aa85-3891-816a-51e991ae857b",
                    "sense_definition": "Très longue durée de temps, attente interminable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ça fait des <w>siècles</w> que je n'ai pas vu mon vieil ami Paul."
                        },
                        {
                            "text": "Le serveur a mis un <w>siècle</w> à nous apporter l'addition."
                        }
                    ],
                    "synonyms": [
                        "éternité"
                    ],
                    "antonyms": [
                        "instant",
                        "seconde"
                    ],
                    "common_phrases": [
                        "depuis des siècles",
                        "mettre un siècle"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Emploi hyperbolique courant dans la langue parlée"
                        }
                    ]
                },
                {
                    "sense_id": "1edf1c8c-4663-38be-b8ce-eb3f4bda901f",
                    "sense_definition": "Période historique remarquable caractérisée par un état de la civilisation, un mouvement culturel ou une figure illustre.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les idées des philosophes ont marqué le grand <w>siècle</w> des Lumières."
                        },
                        {
                            "text": "La littérature espagnole a connu un rayonnement extraordinaire pendant son <w>siècle</w> d'or."
                        }
                    ],
                    "synonyms": [
                        "époque",
                        "ère",
                        "âge"
                    ],
                    "common_phrases": [
                        "siècle des Lumières",
                        "siècle d'or"
                    ]
                },
                {
                    "sense_id": "126f8787-2c1a-3ef2-9801-b221e87d222a",
                    "sense_definition": "Vie laïque, civile et profane, par opposition à la vie consacrée à Dieu ou à la retraite religieuse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un profond drame personnel, il décida de quitter le <w>siècle</w> pour entrer au monastère."
                        },
                        {
                            "text": "Ce prêtre avait longtemps vécu dans le <w>siècle</w> avant d'entrer dans les ordres."
                        }
                    ],
                    "synonyms": [
                        "monde"
                    ],
                    "antonyms": [
                        "cloître"
                    ],
                    "common_phrases": [
                        "quitter le siècle",
                        "dans le siècle"
                    ]
                }
            ]
        }
    ]
