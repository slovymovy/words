                        "entry_id": "093f8925-ecdc-39ac-8a80-937a5a8455d1",
                        "glosses": [
                            "Branche de la zoologie consacrée à l’étude des poissons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528e3e98-a0dc-4ed6-bc68-2b571f3758f1",
                                "sense_id": "1ae9b2a7-bdf0-3d4c-9b2d-547071de7e58",
                                "text": "Cours d’ichtyologie."
                            },
                            {
                                "example_id": "ed22e414-a388-40ec-ab0e-3b8188c8c1b9",
                                "sense_id": "1ae9b2a7-bdf0-3d4c-9b2d-547071de7e58",
                                "text": "Ah ! ils avaient ri de nos poèmes, de nos misères, de nos ichtyologies sur le respect des droits du poisson et du citoyen, le devoir du langage de parler de l’amour du poisson, pardon de l’amour tout court."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dffe6ca6-6751-42ca-861f-8a5b8d3ca7d7",
                        "source_entry_id": "093f8925-ecdc-39ac-8a80-937a5a8455d1",
                        "source_sense_id": "1ae9b2a7-bdf0-3d4c-9b2d-547071de7e58",
                        "target_lang_word": "Ichthyologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ichthyologie",
