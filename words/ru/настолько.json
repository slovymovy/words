{
    "word_family": [
        "столько",
        "столь"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "87ba97a7-35ff-335c-8082-2fc3cceb26c6",
                    "sense_definition": "В такой большой степени, так сильно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не мог предположить, что он <w>настолько</w> глуп!",
                            "target_lang_translations": {
                                "en": "I could not imagine that he was <w>so</w> stupid!",
                                "zh": "我没想到他竟然<w>那么</w>蠢！"
                            }
                        },
                        {
                            "text": "Эта задача не <w>настолько</w> сложная, как кажется на первый взгляд.",
                            "target_lang_translations": {
                                "en": "This task is not <w>so</w> difficult as it seems at first glance.",
                                "zh": "这项任务并没有乍看之下<w>那么</w>难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "так",
                        "столь",
                        "до такой степени"
                    ],
                    "common_phrases": [
                        "не настолько",
                        "настолько же",
                        "настолько, что"
                    ],
                    "target_lang_definitions": {
                        "en": "To such a great extent; so strongly.",
                        "zh": "表示程度很高，达到某种地步。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "indicating a high degree"
                            },
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "used in comparisons"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "那么",
                                "target_lang_sense_clarification": "用于形容词前表示程度高"
                            },
                            {
                                "target_lang_word": "如此",
                                "target_lang_sense_clarification": "书面语，表示程度深"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a05b536-ad75-3912-80a6-932e8621509f",
                    "sense_definition": "Употребляется для присоединения придаточной части предложения, указывая на высокую степень проявления признака как причину или следствие.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он не мог сказать ни слова, <w>настолько</w> его поразила новость.",
                            "target_lang_translations": {
                                "en": "He could not say a word, the news shocked him <w>so much</w>.",
                                "zh": "他一句话也说不出来，这个消息让他震惊得<w>以至于</w>失语。"
                            }
                        },
                        {
                            "text": "В комнате было тихо, <w>настолько</w>, что слышно было дыхание.",
                            "target_lang_translations": {
                                "en": "It was quiet in the room, <w>so much so</w> that breathing could be heard.",
                                "zh": "房间里很安静，安静得<w>以至于</w>能听见呼吸声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "так",
                        "до такой степени"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to connect a clause indicating a high degree of something as a cause or consequence.",
                        "zh": "用于连接从句，表示程度高到产生某种结果或后果。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so",
                                "target_lang_sense_clarification": "used with 'that' to express result"
                            },
                            {
                                "target_lang_word": "so much",
                                "target_lang_sense_clarification": "to such an extent"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "以至于",
                                "target_lang_sense_clarification": "表示程度高到产生某种结果"
                            },
                            {
                                "target_lang_word": "到了……的地步",
                                "target_lang_sense_clarification": "强调程度之深"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}