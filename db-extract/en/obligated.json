                                                "sense_id": "f100890c-ff58-37ea-b19a-209eff1b5b99",
                                                "text": "Я вам должен три рубля."
                                            },
                                            {
                                                "example_id": "701e5000-cbf7-4a1d-b8b8-e69d47badddd",
                                                "sense_id": "f100890c-ff58-37ea-b19a-209eff1b5b99",
                                                "text": "Илья Ильич вам должен десять тысяч по заёмному письму?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a95480de-a8d6-3893-b1ac-67d0123b05e1",
                                        "entry_id": "230df5eb-914c-3775-b39f-00eb17927261",
                                        "glosses": [
                                            "обязан сделать что-либо"
                                        ],
                                        "tags": [
                                            "с инф."
                                        ],
                                        "examples": [
                                            {
