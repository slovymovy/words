                ],
                "senses": [
                    {
                        "sense_id": "374d91c4-d925-3eab-a90f-c0e95d86293f",
                        "entry_id": "a62f0e90-26c5-3d13-bb07-67257bab517a",
                        "glosses": [
                            "dwarf (unusually small)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "275a1b60-11da-4886-8052-f5b24ca6ca94",
                                "sense_id": "374d91c4-d925-3eab-a90f-c0e95d86293f",
                                "text": "Wśród drzew i krzewów dominuje brzoza i brzoza karłowata.",
                                "translation": "Among trees and shrubs, the birch and dwarf birch dominate.",
                                "english": "Among trees and shrubs, the birch and dwarf birch dominate."
                            },
                            {
                                "example_id": "690d82c8-7c34-4a17-8cdb-f3486967c7bc",
                                "sense_id": "374d91c4-d925-3eab-a90f-c0e95d86293f",
                                "text": "W przypadku rzodkiewnika, nasiona potrójnego mutanta gid1a gid1b gid1c w ogóle nie kiełkują, a fenotyp tej rośliny jest jeszcze bardziej karłowaty niż w przypadku mutanta szlaku biosyntezy GA gal-3.",
                                "translation": "In the case of Arabidopsis, the seeds of the triple mutant gid1a gid1b gid1c don't germinate at all, and the phenotype of this plant is even dwarfer than in the case of the mutant in the biosynthesis pathway GA gal-3.",
                                "english": "In the case of Arabidopsis, the seeds of the triple mutant gid1a gid1b gid1c don't germinate at all, and the phenotype of this plant is even dwarfer than in the case of the mutant in the biosynthesis pathway GA gal-3."
                            }
                        ]
                    }
