                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f2ebb97-4f65-4ae6-bc5f-66386f0bbc5c",
                                "sense_id": "1037efc6-f21a-3ac4-aca8-2ad5c4033846",
                                "text": "Er hatte seine Plempe dabei."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bd72653a-417a-322e-99e2-82e12f23edaf",
                        "entry_id": "f1a49f26-3b65-3980-b302-64fcd0774410",
                        "glosses": [
                            "ungeschliffener, plumper Säbel, Schleppsäbel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d9d9ee1-cb22-4d8e-a299-c62889d87ea5",
                                "sense_id": "bd72653a-417a-322e-99e2-82e12f23edaf",
                                "text": "Er zog seine Plempe und drohte dem frechen Angreifer."
                            },
                            {
                                "example_id": "fd143b1d-55a6-43fc-9e68-3a4aa59f24be",
                                "sense_id": "bd72653a-417a-322e-99e2-82e12f23edaf",
                                "text": "„Mit der flachen Plempe verteilen sie knallend Schläge an die Umstehenden, auf ihre Rücken, ihre Gesichter, ihre Hände.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "60e78c39-330a-32d2-818e-0bcd1bff2ba2",
                        "entry_id": "f1a49f26-3b65-3980-b302-64fcd0774410",
                        "glosses": [
                            "in Prag benutzte studentische Fechtwaffe"
                        ],
                        "tags": [],
                        "examples": [
                            {
