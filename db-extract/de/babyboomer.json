                "senses": [
                    {
                        "sense_id": "2ee3747a-25ee-37cd-98b3-08e09c843028",
                        "entry_id": "bacf39cd-7b7c-31aa-8e22-bba60be709cc",
                        "glosses": [
                            "(männliche^☆) Person, die in einem geburtenstarken Jahrgang geboren wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f677f65-f395-47d6-abaf-98af4d6a2f4c",
                                "sense_id": "2ee3747a-25ee-37cd-98b3-08e09c843028",
                                "text": "„Seit ihrer Geburt bestimmen die Babyboomer allein aufgrund ihrer Zahl die Geschicke der Gesellschaft.“"
                            },
                            {
                                "example_id": "b0253a51-d18a-4e68-95ef-2dadf56cd45a",
                                "sense_id": "2ee3747a-25ee-37cd-98b3-08e09c843028",
                                "text": "„Nein, ich bin kein Babyboomer, ich kam erst nach dem Pillenknick auf die Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d7adf3ea-aff3-476f-b157-f556b8b5e6df",
                        "source_entry_id": "bacf39cd-7b7c-31aa-8e22-bba60be709cc",
                        "source_sense_id": "2ee3747a-25ee-37cd-98b3-08e09c843028",
                        "source_sense_description": "in einem geburtenstarken Jahrgang Geborener",
                        "target_lang_word": "baby-boomer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baby-boomer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc9be76f-f3dc-3da0-ba61-eba1937cb047",
                                        "entry_id": "7a1c1c57-2a35-3610-acaa-b644f3b4acfd",
                                        "glosses": [
                                            "Population née pendant le baby-boom de l'après-guerre, après celle de la génération silencieuse et avant celle de la génération X, entre 1946 et 1964."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb95ecf-20c4-41bd-874d-61efdeb308dc",
                                                "sense_id": "dc9be76f-f3dc-3da0-ba61-eba1937cb047",
                                                "text": "Une autre étude publiée en janvier 2011 indiquait que la planification de la retraite constituait la première priorité financière des baby-boomers au cours d’une année."
                                            },
                                            {
                                                "example_id": "1336f9c3-2248-4444-91bc-9a3ecf19ea52",
                                                "sense_id": "dc9be76f-f3dc-3da0-ba61-eba1937cb047",
                                                "text": "Parallèlement, les baby-boomers se rapprochent massivement de l’âge de la retraite, période de la vie où les investisseurs deviennent averses au risque."
                                            },
                                            {
                                                "example_id": "61171d82-32c3-4fbe-83e2-522f4b9b1933",
                                                "sense_id": "dc9be76f-f3dc-3da0-ba61-eba1937cb047",
                                                "text": "Le climat représente le principal facteur qui incite les baby-boomers à déménager une fois à la retraite (57 % des répondants)."
                                            },
                                            {
                                                "example_id": "42609fc8-2d39-4b2d-bb67-c88d6d99fd37",
                                                "sense_id": "dc9be76f-f3dc-3da0-ba61-eba1937cb047",
                                                "text": "Les baby-boomers sont sans aucun doute aussi individualistes que leurs enfants."
                                            },
                                            {
                                                "example_id": "350c71ee-d9de-4702-a6f4-6d93ecd0bd5f",
                                                "sense_id": "dc9be76f-f3dc-3da0-ba61-eba1937cb047",
                                                "text": "[Certains] ont dénoncé […] toute la génération des baby-boomers, accusée d'avoir hypothéqué l'avenir de ses descendants en s'octroyant des avantages économiques et sociaux démesurés, pillant ainsi les coffres de l'État."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
