                "senses": [
                    {
                        "sense_id": "304e4f2f-8809-3b84-a979-918fea115780",
                        "entry_id": "8031b43d-73c1-3807-a15b-61f652751b32",
                        "glosses": [
                            "Behältnis zur Entsorgung von (medizinischen) Abfällen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0f1a784-421c-4a71-a3cc-1801433259a2",
                                "sense_id": "304e4f2f-8809-3b84-a979-918fea115780",
                                "text": "„Achten Sie darauf, dass die Abwurfbox nicht zu voll ist, um Nadelstichverletzungen beim Entsorgen der Nadel zu vermeiden!“"
                            },
                            {
                                "example_id": "82e87779-df92-44b1-b6df-736f40e98c32",
                                "sense_id": "304e4f2f-8809-3b84-a979-918fea115780",
                                "text": "„Auf einer anderen Pflegestation wurde die Bereitstellung eines Spritzentabletts mit Abwurfbox sowie ausreichendem Zubehör für Ärzte eingeführt und vereinbart, dass diese auch die Entsorgung benutzter Kanülen übernehmen.“"
                            },
                            {
                                "example_id": "1a444d13-532a-4f31-8d3f-afc961bc7a0f",
                                "sense_id": "304e4f2f-8809-3b84-a979-918fea115780",
                                "text": "„Im Rahmen der internen Fortbildung erhalten wir zweimal jährlich einen Auffrischungskurs zur Arbeitssicherheit und Hygiene: wie man mit Spritzen und Kanülen umgeht, Abwurfboxen werden vorgestellt, die gesetzlichen Grundlagen, die UVV'en werden aufgefrischt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
