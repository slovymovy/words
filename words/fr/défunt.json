                    "sense_definition": "Personne qui est morte.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toute la famille s'est réunie pour rendre un dernier hommage au <w>défunt</w>.",
                            "target_lang_translations": {
                                "en": "The whole family gathered to pay one last tribute to the <w>deceased</w>.",
                                "ru": "Вся семья собралась, чтобы в последний раз отдать дань памяти <w>покойного</w>.",
                                "de": "Die ganze Familie versammelte sich, um dem <w>Verstorbenen</w> ein letztes Mal Ehre zu erweisen.",
                                "es": "Toda la familia se reunió para rendir un último homenaje al <w>difunto</w>.",
                                "zh": "全家人聚在一起，向<w>逝者</w>致以最后的敬意。"
                            }
                        },
                        {
                            "text": "Le notaire a convoqué les héritiers pour lire le testament du <w>défunt</w>.",
                            "target_lang_translations": {
                                "en": "The notary summoned the heirs to read the will of the <w>deceased</w>.",
                                "ru": "Нотариус вызвал наследников, чтобы огласить завещание <w>покойного</w>.",
                                "de": "Der Notar lud die Erben ein, um das Testament des <w>Verstorbenen</w> zu verlesen.",
                                "es": "El notario convocó a los herederos para leer el testamento del <w>difunto</w>.",
                                "zh": "公证员召集继承人宣读<w>死者</w>的遗嘱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "décédé",
                        "disparu",
                        "mort"
                    ],
                    "common_phrases": [
                        "hommage au défunt",
                        "famille du défunt",
                        "mémoire du défunt"
                    ],
                    "target_lang_definitions": {
                        "en": "A person who has died.",
