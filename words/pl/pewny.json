{
    "word_family": [
        "pewność",
        "pewnik",
        "pewniak",
        "pewnie",
        "upewnić",
        "niepewność"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9905d4f8-1f4f-389e-a727-9d1efc6a69a2",
                    "sense_definition": "całkowicie przekonany o czymś, mający silne przeświadczenie",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "przekonanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jestem <w>pewny</w> swojej decyzji.",
                            "target_lang_translations": {
                                "ru": "Я <w>уверен</w> в своем решении."
                            }
                        },
                        {
                            "text": "On nie był <w>pewny</w> odpowiedzi na to pytanie.",
                            "target_lang_translations": {
                                "ru": "Он не был <w>уверен</w> в ответе на этот вопрос."
                            }
                        }
                    ],
                    "synonyms": [
                        "pewien"
                    ],
                    "antonyms": [
                        "niepewny"
                    ],
                    "common_phrases": [
                        "być pewnym siebie",
                        "pewny swego"
                    ],
                    "target_lang_definitions": {
                        "ru": "полностью убежденный в чем-либо, имеющий твердую уверенность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уверенный",
                                "target_lang_sense_clarification": "о человеке, который не сомневается в своих действиях или знаниях"
                            },
                            {
                                "target_lang_word": "убеждённый",
                                "target_lang_sense_clarification": "о человеке, который твердо верит в правильность чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44f96d4d-06be-34e7-ae91-af36c29c6250",
                    "sense_definition": "nieulegający wątpliwości, taki który niewątpliwie nastąpi",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "oczywistość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Porażka naszych wrogów jest <w>pewna</w>.",
                            "target_lang_translations": {
                                "ru": "Поражение наших врагов <w>неизбежно</w>."
                            }
                        },
                        {
                            "text": "To jest <w>pewny</w> sukces całego zespołu.",
                            "target_lang_translations": {
                                "ru": "Это <w>гарантированный</w> успех всей команды."
                            }
                        }
                    ],
                    "synonyms": [
                        "niewątpliwy",
                        "niechybny",
                        "murowany"
                    ],
                    "common_phrases": [
                        "pewna sprawa"
                    ],
                    "target_lang_definitions": {
                        "ru": "не вызывающий сомнений, такой, который обязательно произойдет"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неизбежный",
                                "target_lang_sense_clarification": "о событии, которое обязательно случится"
                            },
                            {
                                "target_lang_word": "гарантированный",
                                "target_lang_sense_clarification": "о результате, который обеспечен"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c269faae-1e05-37ef-95b2-f3141e7ead74",
                    "sense_definition": "godny zaufania, sprawdzony",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zaufanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta wiadomość pochodzi z <w>pewnego</w> źródła.",
                            "target_lang_translations": {
                                "ru": "Эта новость исходит из <w>достоверного</w> источника."
                            }
                        },
                        {
                            "text": "To jest bardzo <w>pewny</w> pracownik.",
                            "target_lang_translations": {
                                "ru": "Это очень <w>надёжный</w> сотрудник."
                            }
                        }
                    ],
                    "synonyms": [
                        "wiarygodny",
                        "niezawodny",
                        "wypróbowany"
                    ],
                    "target_lang_definitions": {
                        "ru": "заслуживающий доверия, проверенный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надёжный",
                                "target_lang_sense_clarification": "о человеке или источнике, на которого можно положиться"
                            },
                            {
                                "target_lang_word": "достоверный",
                                "target_lang_sense_clarification": "о информации или источнике, который можно считать правдивым"
                            }
                        ]
                    },
                    "common_phrases": [
                        "pewne źródło"
                    ]
                },
                {
                    "sense_id": "45dfd7b5-2ca6-379f-b7e8-314bc01f2edc",
                    "sense_definition": "gwarantujący bezpieczeństwo, bezpieczny",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bezpieczeństwo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ta kryjówka jest <w>pewna</w>.",
                            "target_lang_translations": {
                                "ru": "Это укрытие <w>надёжно</w>."
                            }
                        },
                        {
                            "text": "Musimy znaleźć <w>pewne</w> schronienie przed burzą.",
                            "target_lang_translations": {
                                "ru": "Мы должны найти <w>безопасное</w> укрытие от бури."
                            }
                        }
                    ],
                    "synonyms": [
                        "bezpieczny"
                    ],
                    "target_lang_definitions": {
                        "ru": "обеспечивающий безопасность, безопасный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надёжный",
                                "target_lang_sense_clarification": "о месте или защите, которая не подведет"
                            },
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "о месте, где нет угрозы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3078cbd0-2409-368a-90a4-2f6935391be3",
                    "sense_definition": "gwarantujący trwałość i stałość, zdecydowany, stanowczy, niezachwiany",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "stałość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miał bardzo <w>pewny</w> chwyt.",
                            "target_lang_translations": {
                                "ru": "У него был очень <w>твёрдый</w> хват."
                            }
                        },
                        {
                            "text": "Artysta wykonał <w>pewny</w> ruch pędzlem.",
                            "target_lang_translations": {
                                "ru": "Художник сделал <w>решительное</w> движение кистью."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "гарантирующий прочность и устойчивость, решительный, твердый"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "твёрдый",
                                "target_lang_sense_clarification": "о движении или хватке, которые не дрожат"
                            },
                            {
                                "target_lang_word": "решительный",
                                "target_lang_sense_clarification": "о действии, выполненном без колебаний"
                            }
                        ]
                    },
                    "synonyms": [
                        "zdecydowany",
                        "stanowczy"
                    ],
                    "common_phrases": [
                        "pewna ręka",
                        "pewny krok"
                    ]
                }
            ]
        }
    ]
}