                                    {
                                        "sense_id": "36e774cf-b7f3-366e-a6b8-dfb917952e74",
                                        "entry_id": "f3551c8b-b5e8-31e6-bbcc-114c7499d564",
                                        "glosses": [
                                            "auf einem Thron sitzen, als Monarch regieren"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0d9ca00-d2f1-4592-82fb-38cfa04775d9",
                                                "sense_id": "36e774cf-b7f3-366e-a6b8-dfb917952e74",
                                                "text": "Über ihnen thronte der preußische König, der nun zugleich auch deutscher Kaiser war."
                                            },
                                            {
                                                "example_id": "1897e42e-dde7-4797-88e6-872feb5920c2",
                                                "sense_id": "36e774cf-b7f3-366e-a6b8-dfb917952e74",
                                                "text": "Als wir in den Thronsaal geführt wurden, thronte die Kaiserin auf einer Empore unter einem Baldachin inmitten eines Arrangements von Kissen, die über eine Art Kanapee gehäuft waren; …"
                                            },
                                            {
                                                "example_id": "8a97feeb-b63d-4b8e-aebe-ddc28822ad7e",
                                                "sense_id": "36e774cf-b7f3-366e-a6b8-dfb917952e74",
                                                "text": "Sie thronte - ähnlich Kaiser Franz Joseph - über mehrere Generationen und verkörperte eine letzte mentale Rückversicherung angesichts epochaler Veränderungen, sei es bei Wahlrechtsreformen, während des Krimkriegs oder angesichts der Industrialisierung und deren Folgen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "235c2b10-ef31-3a9c-bc69-79eecb9d1454",
                                        "entry_id": "f3551c8b-b5e8-31e6-bbcc-114c7499d564",
                                        "glosses": [
                                            "erhöht sein, wie auf einem Thron sitzen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91147d99-bfcc-4757-a979-6acf28ecf875",
                                                "sense_id": "235c2b10-ef31-3a9c-bc69-79eecb9d1454",
                                                "text": "Wie eine Kathedrale thronen die riesigen Getreidesilos über den Hafenanlagen, von nahezu jedem Punkt im Ort sind sie zu sehen."
                                            },
                                            {
                                                "example_id": "647e4c8e-9d3a-492f-8a11-f18e4c6a2dbc",
                                                "sense_id": "235c2b10-ef31-3a9c-bc69-79eecb9d1454",
                                                "text": "Kleine Bankangestellte thronen auf viel zu hohen Hockern und verschwinden hinter den riesigen PCs, mit denen sie die Konten ihrer \"Mitbürger\" verwalten."
                                            },
                                            {
                                                "example_id": "f849b7c6-1434-4fad-9999-f7726ac25d89",
                                                "sense_id": "235c2b10-ef31-3a9c-bc69-79eecb9d1454",
                                                "text": "Ihr Schweigen verdroß ihn: »Aha, Sie thronen schon wieder.«"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
