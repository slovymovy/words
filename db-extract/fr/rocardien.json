                        "glosses": [
                            "Relatif au rocardisme, à la politique de Michel Rocard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6fe379d-934a-4fd0-b448-5d2186887657",
                                "sense_id": "0cd74530-c8b0-3140-93d7-ee6550997a25",
                                "text": "Ce faisant, Mitterrand met le doigt sur l’autre faiblesse de la stratégie rocardienne."
                            },
                            {
                                "example_id": "8227f09d-75d8-4136-bd67-806afbb40a3c",
                                "sense_id": "0cd74530-c8b0-3140-93d7-ee6550997a25",
                                "text": "Roland Ries continue de revendiquer son étiquette rocardienne, comme sa devancière, Catherine Trautmann."
                            },
                            {
                                "example_id": "f9ca24c6-c084-46db-ab86-6206c25d4826",
                                "sense_id": "0cd74530-c8b0-3140-93d7-ee6550997a25",
                                "text": "Je pense que si Strauss-Kahn avait adopté une espèce d'attitude rocardienne, c'est-à-dire bien ancrée à gauche mais moderne, il se serait trouvé très haut dans les sondages, et en bonne posture pour être finalement désigné par le PS."
                            }
                        ]
