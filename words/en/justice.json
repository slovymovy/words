{
    "word_family": [
        "just",
        "justify",
        "justification",
        "unjust",
        "injustice",
        "justly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ed21e469-24ba-3170-9d11-dd1f3872386f",
                    "sense_definition": "The quality of being fair, impartial, and reasonable.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fairness_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We must fight for peace and <w>justice</w> in our society.",
                            "target_lang_translations": {
                                "ru": "Мы должны бороться за мир и <w>справедливость</w> в нашем обществе.",
                                "zh": "我们必须为社会的和平与<w>正义</w>而奋斗。"
                            }
                        },
                        {
                            "text": "He has a strong sense of <w>justice</w> and always tries to do the right thing.",
                            "target_lang_translations": {
                                "ru": "У него обостренное чувство <w>справедливости</w>, и он всегда старается поступать правильно.",
                                "zh": "他有强烈的<w>正义</w>感，总是努力做正确的事。"
                            }
                        }
                    ],
                    "antonyms": [
                        "injustice"
                    ],
                    "common_phrases": [
                        "sense of justice",
                        "social justice",
                        "do justice",
                        "poetic justice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство быть справедливым, беспристрастным и разумным.",
                        "zh": "指公平、公正和合理的品质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "справедливость",
                                "target_lang_sense_clarification": "моральное качество, честность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正义",
                                "target_lang_sense_clarification": "道德上的公正"
                            },
                            {
                                "target_lang_word": "公正",
                                "target_lang_sense_clarification": "公平无私的品质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4a02079-4364-3554-a155-8cb20a5fc144",
                    "sense_definition": "The legal system or process of judging crimes and punishing criminals.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "legal_system",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The criminal was finally brought to <w>justice</w> after many years.",
                            "target_lang_translations": {
                                "ru": "Преступник был наконец предан <w>правосудию</w> спустя много лет.",
                                "zh": "多年后，罪犯终于被绳之以<w>法</w>。"
                            }
                        },
                        {
                            "text": "Many people believe the <w>justice</w> system needs significant reform.",
                            "target_lang_translations": {
                                "ru": "Многие считают, что система <w>правосудия</w> нуждается в значительной реформе.",
                                "zh": "许多人认为<w>司法</w>体系需要重大改革。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bring to justice",
                        "justice system",
                        "criminal justice",
                        "miscarriage of justice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Правовая система или процесс судебного разбирательства и наказания преступников.",
                        "zh": "指法律体系，或审判犯罪和惩罚罪犯的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правосудие",
                                "target_lang_sense_clarification": "судебная деятельность"
                            },
                            {
                                "target_lang_word": "юстиция",
                                "target_lang_sense_clarification": "система судебных учреждений"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "司法",
                                "target_lang_sense_clarification": "法律审判活动"
                            },
                            {
                                "target_lang_word": "法律",
                                "target_lang_sense_clarification": "指代法律制度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e20e1f61-b240-3dde-87d6-d50e4581db3a",
                    "sense_definition": "A judge in a court of law, especially in higher courts.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "official_title",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>justice</w> listened carefully to the arguments from both lawyers.",
                            "target_lang_translations": {
                                "ru": "<w>Судья</w> внимательно выслушал доводы обоих адвокатов.",
                                "zh": "<w>法官</w>仔细听取了双方律师的辩论。"
                            }
                        },
                        {
                            "text": "She was appointed as a <w>justice</w> of the Supreme Court last year.",
                            "target_lang_translations": {
                                "ru": "В прошлом году она была назначена <w>судьей</w> Верховного суда.",
                                "zh": "她去年被任命为最高法院的<w>法官</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "judge"
                    ],
                    "common_phrases": [
                        "chief justice",
                        "associate justice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Судья в суде, особенно в высших судебных инстанциях.",
                        "zh": "法庭上的法官，尤指高级法院的法官。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судья",
                                "target_lang_sense_clarification": "должностное лицо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "法官",
                                "target_lang_sense_clarification": "司法审判人员"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "95b69d49-b139-395b-8e2b-41d9f31d7f0d",
                    "sense_definition": "A male or female given name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My friend <w>Justice</w> is coming to the party tonight.",
                            "target_lang_translations": {
                                "ru": "Мой друг <w>Джастис</w> придет сегодня на вечеринку.",
                                "zh": "我的朋友<w>贾斯蒂斯</w>今晚要来参加聚会。"
                            }
                        },
                        {
                            "text": "They decided to name their daughter <w>Justice</w>.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать свою дочь <w>Джастис</w>.",
                                "zh": "他们决定给女儿取名为<w>贾斯蒂斯</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское или женское личное имя.",
                        "zh": "男性或女性的个人名字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джастис",
                                "target_lang_sense_clarification": "имя"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贾斯蒂斯",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1453e2a-caa4-337d-87cf-595ef4a7f859",
                    "sense_definition": "A surname originating as an occupation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Justice</w> has lived in this town for fifty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Джастис</w> живет в этом городе уже пятьдесят лет.",
                                "zh": "<w>贾斯蒂斯</w>先生在这个镇上已经住了五十年了。"
                            }
                        },
                        {
                            "text": "The <w>Justice</w> family owns the bakery on the corner.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Джастис</w> владеет пекарней на углу.",
                                "zh": "<w>贾斯蒂斯</w>一家经营着街角的面包店。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "originating as an occupation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия профессии.",
                        "zh": "源于职业名称的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джастис",
                                "target_lang_sense_clarification": "фамилия (от рода занятий)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贾斯蒂斯",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "73302d5e-1ddf-3454-a587-ee66ef20386f",
                    "sense_definition": "A place name used for several locations in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Justice</w> during their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они посетили небольшую деревню <w>Джастис</w>.",
                                "zh": "他们在公路旅行中参观了<w>贾斯蒂斯</w>这个小村庄。"
                            }
                        },
                        {
                            "text": "He was born in <w>Justice</w>, Illinois.",
                            "target_lang_translations": {
                                "ru": "Он родился в городе <w>Джастис</w>, штат Иллинойс.",
                                "zh": "他出生于伊利诺伊州的<w>贾斯蒂斯</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Географическое название, используемое для нескольких населенных пунктов в США.",
                        "zh": "美国多个地点的地名。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джастис",
                                "target_lang_sense_clarification": "топоним в США"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "贾斯蒂斯",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
