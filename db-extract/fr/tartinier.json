                        ],
                        "examples": [
                            {
                                "example_id": "6c478c27-23a9-41bb-b77c-4707635f51cc",
                                "sense_id": "fb72f035-6898-3ec7-9098-a116d308dec3",
                                "text": "Si j’avais connu les avantages que Montcornet vous accorde ici, j’aurais quitté mon état de tartinier pour devenir garde général, moi !"
                            },
                            {
                                "example_id": "66782e6c-f1ba-4469-b755-df775518494e",
                                "sense_id": "fb72f035-6898-3ec7-9098-a116d308dec3",
                                "text": "Dans l’argot journalistique du temps, le Premier Paris se nomme la tartine et son auteur le tartinier.' — (Marcel Vogne, La Presse périodique en Franche-Comté, 1977, page 340)"
                            },
                            {
                                "example_id": "e86e93ca-7fa3-4fe3-ace3-0b7c4411ddcb",
                                "sense_id": "fb72f035-6898-3ec7-9098-a116d308dec3",
                                "text": "Ce qu’il ne faut pas demander au tartinier, c’est le choix des mots et la propriété des termes.' — (Corinne Saminadayar-Perrin, Les discours du journal, 2022, page 195)"
                            }
                        ]
                    }
