                                "example_id": "66878217-4f96-4f68-8e53-80a30452f3ed",
                                "sense_id": "833f28e2-350a-34d5-904a-eccd81ed4543",
                                "text": "„Europas Autohersteller drängen auf eine neue Abgasvorschrift, die freie Werkstätten und Pannendienste ausbootet - gegen geltendes EU-Recht.“"
                            },
                            {
                                "example_id": "01cacfdf-edd2-43ce-9661-6c80ff198eb4",
                                "sense_id": "833f28e2-350a-34d5-904a-eccd81ed4543",
                                "text": "„Dank verschärfter Abgasvorschriften entwickelte die Automobilindustrie bessere Motoren, die weniger Sprit verbrauchen, und baute Abgasreinigungsanlagen in die Fahrzeuge ein.“"
                            }
