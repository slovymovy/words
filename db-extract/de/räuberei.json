                                        ]
                                    },
                                    {
                                        "sense_id": "947e734c-75b2-3feb-a402-4e7858a0aeed",
                                        "entry_id": "032513ee-4a73-3a98-bf3b-c819e7ff741b",
                                        "glosses": [
                                            "Crime organisé, criminalité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99a8b52c-cef0-48d8-b1db-de790414cd7a",
                                                "sense_id": "947e734c-75b2-3feb-a402-4e7858a0aeed",
                                                "text": "Les actes de banditismes en pleine expansion à Dago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0936bcb-1d20-3d1d-8e77-ec17820dc75e",
                                        "entry_id": "032513ee-4a73-3a98-bf3b-c819e7ff741b",
                                        "glosses": [
                                            "Comportement habituel d'un groupe social, assimilable à celui d'un bandit, ensemble d'abus d'un groupe, contraires à l'éthique de la société à laquelle il appartient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20408bad-ac2e-4d7b-89eb-6a985e46d3ca",
                                                "sense_id": "e0936bcb-1d20-3d1d-8e77-ec17820dc75e",
                                                "text": "L'impunité du banditisme soi-disant politique est notre danger public. L'ordre est désarmé. Et ce malheur se joint à tous ceux d'une situation extrêmement difficile. Quatre cents voyous peuvent faire chavirer notre barque."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc7fcba7-3d50-47e8-93ac-2b19ac2acae8",
                        "source_entry_id": "e0e5f73f-c2ee-3f27-9b15-7999cfa0638c",
                        "source_sense_id": "d908559b-0981-3897-b06c-34ab77d543ce",
                        "source_sense_description": "anhaltendes, wiederholtes Rauben",
                        "target_lang_word": "brigandage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brigandage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3cf3acc9-0caa-3b63-aefc-87bd5827033e",
                                        "entry_id": "9a5d284a-74a1-3083-a16b-eb435564580c",
                                        "glosses": [
                                            "Pillage, crime commis avec violence et à main armée, et le plus souvent par des malfaiteurs réunis en troupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f1199f9-429e-4d09-aa82-08524d23a847",
                                                "sense_id": "3cf3acc9-0caa-3b63-aefc-87bd5827033e",
                                                "text": "BRIGANDAGE, s. m. (Jurisprud.) est un vol fait à force ouverte, comme le vol sur les grands chemins, ou autre semblable. Il est opposé à filouterie ou larcin. C’est un crime capital."
                                            },
                                            {
                                                "example_id": "c4e0564c-6781-47a2-9d8e-811aebd5b110",
                                                "sense_id": "3cf3acc9-0caa-3b63-aefc-87bd5827033e",
                                                "text": "Loi relative à la répression du brigandage et des assassinats."
                                            },
                                            {
                                                "example_id": "8df95660-4bab-4845-b954-af295c50c4f3",
                                                "sense_id": "3cf3acc9-0caa-3b63-aefc-87bd5827033e",
                                                "text": "La guerre entre tribus et même les actes de brigandage étaient de véritables sports, au même titre que la chasse et la fantasia."
                                            },
                                            {
                                                "example_id": "ee7aadd8-2210-4d73-8f1f-328b911efa1f",
                                                "sense_id": "3cf3acc9-0caa-3b63-aefc-87bd5827033e",
                                                "text": "A coups de dénonciations anonymes et d’investigations techniques complexes, les policiers de l’office central de lutte contre le crime organisé, de la direction interrégionale de police judiciaire de Lyon, et leurs homologues helvètes estiment avoir démantelé l’équipe à l’origine de ce retentissant « brigandage », selon la terminologie lémanique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36af64b4-7012-31ee-a8a2-5aa018fba329",
                                        "entry_id": "9a5d284a-74a1-3083-a16b-eb435564580c",
                                        "glosses": [
                                            "Concussion, exaction, déprédation."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35e100ce-f37c-42d2-858b-ba1e8d793193",
                                                "sense_id": "36af64b4-7012-31ee-a8a2-5aa018fba329",
                                                "text": "De grands embarras financiers avaient conduit le gouvernement à signer avec des compagnies de chemin de fer des conventions que les radicaux avaient dénoncées comme étant des actes de brigandage."
                                            },
                                            {
                                                "example_id": "d3dfeb5f-82b9-4984-89f3-f65c2613c721",
                                                "sense_id": "36af64b4-7012-31ee-a8a2-5aa018fba329",
                                                "text": "Les traitants furent punis pour les brigandages qu’ils avaient exercés sur le peuple."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
