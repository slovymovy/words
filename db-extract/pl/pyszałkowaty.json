                "senses": [
                    {
                        "sense_id": "0ca50d1a-ee14-3fae-bf14-a22773e23b5f",
                        "entry_id": "42b4d4e9-9667-30ec-b594-6fc1875cd862",
                        "glosses": [
                            "właściwy pyszałkowi"
                        ],
                        "tags": [],
