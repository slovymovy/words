                "senses": [
                    {
                        "sense_id": "3a43efec-e1c9-3e3a-a62c-7b532bccd464",
                        "entry_id": "283300e2-a80f-33f6-a52f-d751c50d0ccf",
                        "glosses": [
                            "A female given name from Ancient Greek."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eefe0b3-a1d0-4dfb-bebc-41a7e4bb4a90",
                                "sense_id": "3a43efec-e1c9-3e3a-a62c-7b532bccd464",
                                "text": "Elaine the fair, Elaine the lovable,\nElaine, the lily maid of Astolat,\nHigh in her chamber up a tower to the east\nGuarded the sacred shield of Lancelot;"
                            },
                            {
                                "example_id": "a36d9eca-6879-4b6d-a608-a8a5f7f4d313",
                                "sense_id": "3a43efec-e1c9-3e3a-a62c-7b532bccd464",
                                "text": "My own mother named me after her best friend, as women did in those days. Elaine, which I once found too plaintive. I wanted something more definite, a monosyllable: Dot or Pat, like a foot set down. Nothing you could make a mistake about; nothing watery. But my name has solidified around me, with time. I think of it as tough but pliable now, like a well-worn glove."
                            }
                        ]
                    }
                ],
                "translations": [
