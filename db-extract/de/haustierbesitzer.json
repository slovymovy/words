                        "glosses": [
                            "jemand, der ein Haustier besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf1fd93f-70ef-4d4c-91c8-87d3ba2fcad6",
                                "sense_id": "e3e1feae-c2ae-3221-bf88-3bc7fdb47024",
                                "text": "„Eher auf kaufkräftige und ältere Kundschaft schielen dagegen Versicherungen, die die Masse der Haustierbesitzer ebenfalls als neue Kundenschicht ausgemacht haben.“"
                            },
                            {
                                "example_id": "fbde8d37-2275-4e96-8498-bf2a9b6ab49a",
                                "sense_id": "e3e1feae-c2ae-3221-bf88-3bc7fdb47024",
                                "text": "„Nicht nur, dass in fünfzig Prozent der amerikanischen Haushalte mindestens ein Haustier lebt; die Hälfte der Haustierbesitzer erlauben ihrem Liebling sogar, mit ins Bett zu kommen.“"
                            }
                        ],
