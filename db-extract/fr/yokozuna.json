                            "plural"
                        ],
                        "form": "yokozunas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "54dbe618-02cc-3c7e-8dbf-70b219a397c4",
                        "entry_id": "68c27fba-25f4-348f-b528-1560b51d1d7a",
                        "glosses": [
                            "Grade le plus élevé que peut atteindre un rikishi ou sumotori, un lutteur de sumo, au-dessus du grade d’ozeki."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ece3da2-2a18-40cf-9743-1088075fac1c",
                                "sense_id": "54dbe618-02cc-3c7e-8dbf-70b219a397c4",
                                "text": "Ce scandale «a ouvert un grand trou dans mon cœur», explique le yokozuna (le plus haut grade en sumo) lors de sa première conférence de presse depuis que l’affaire a éclaté la semaine dernière."
                            },
                            {
                                "example_id": "a46e7f7e-3b7f-456b-8f5c-0237cf9c9210",
                                "sense_id": "54dbe618-02cc-3c7e-8dbf-70b219a397c4",
                                "text": "À peine un ozeki sur 4 peut prétendre à devenir yokozuna dont le nombre varie entre 0 et 4."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6971168b-a5e8-4074-aff4-f72061c3793e",
                        "source_entry_id": "68c27fba-25f4-348f-b528-1560b51d1d7a",
                        "source_sense_id": "54dbe618-02cc-3c7e-8dbf-70b219a397c4",
                        "target_lang_word": "Yokozuna",
