                        "entry_id": "f2a99933-bb16-3669-8409-9750d553af02",
                        "glosses": [
                            "brother, bro, old fellow, dear friend (friendly or condescendingly, also as a form of address)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "0a1b085e-7bed-4bb5-be65-d2b365d048c9",
                                "sense_id": "c81c99d0-0f92-3895-8db2-b99d3a80f5a3",
                                "text": "Сторож, принеси-ка мне, братец, лимонаду и рюмку английской горькой!",
                                "translation": "Porter, bring me a lemonade and a glass of English bitter, there's a good fellow.",
                                "english": "Porter, bring me a lemonade and a glass of English bitter, there's a good fellow."
                            }
                        ]
                    }
