                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40760de7-c04a-4850-ba67-8715956a6877",
                                                "sense_id": "1be7b639-9bfd-381e-8abb-20cb03890d52",
                                                "text": "Er ist in unerledigten Akten ersoffen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
