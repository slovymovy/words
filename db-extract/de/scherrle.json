                "senses": [
                    {
                        "sense_id": "422bda4c-53cb-3030-86b1-787d860cc1d8",
                        "entry_id": "937fbfe9-8a35-31f3-a464-f157243a9080",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e23ab79d-2b64-4937-b34f-8a35d4dd234f",
                                "sense_id": "422bda4c-53cb-3030-86b1-787d860cc1d8",
                                "text": "Frau Scherrle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "f143894c-bfb6-4b7f-aedb-8543d449e6d1",
                                "sense_id": "422bda4c-53cb-3030-86b1-787d860cc1d8",
                                "text": "Herr Scherrle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c812e0f0-8c8c-4ec0-8119-bbe85129dcad",
                                "sense_id": "422bda4c-53cb-3030-86b1-787d860cc1d8",
                                "text": "Die Scherrles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "43cbfa3f-f023-442a-a18d-6c11998c2505",
                                "sense_id": "422bda4c-53cb-3030-86b1-787d860cc1d8",
                                "text": "Der Scherrle trägt nie die Schals, die die Scherrle ihm strickt."
                            },
                            {
                                "example_id": "9e74cb2b-5287-425d-a185-79c842b914d9",
                                "sense_id": "422bda4c-53cb-3030-86b1-787d860cc1d8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Scherrle kommt, geht der Herr Scherrle.“"
                            },
                            {
                                "example_id": "08277a4e-ce39-4e3e-8285-fc1614faf51e",
                                "sense_id": "422bda4c-53cb-3030-86b1-787d860cc1d8",
                                "text": "Scherrle kommt und geht."
                            },
                            {
                                "example_id": "ae63d885-b7b1-474a-b5e2-eff6e26a9ce3",
                                "sense_id": "422bda4c-53cb-3030-86b1-787d860cc1d8",
                                "text": "Scherrles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
