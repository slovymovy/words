                        "target_lang_word": "Wasserglas",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserglas",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4a4459ac-865b-3dc7-a203-783b6f34bbfe",
                                        "entry_id": "68610e91-e127-305f-9d8d-fd3d53855ee7",
                                        "glosses": [
                                            "ein Trinkgefäß, das zum Trinken von Wasser dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdeaf0e7-136b-4d57-9154-d1ff53d1241b",
                                                "sense_id": "4a4459ac-865b-3dc7-a203-783b6f34bbfe",
                                                "text": "Kannst Du mir mal das Wasserglas reichen?"
                                            },
                                            {
                                                "example_id": "1fb8dfce-7413-4494-96a0-0e1b6c6cc6ef",
                                                "sense_id": "4a4459ac-865b-3dc7-a203-783b6f34bbfe",
                                                "text": "„Die Frau goß sich ein Wasserglas voll von dem Fusel und trank es in zwei Zügen leer.“"
                                            },
                                            {
                                                "example_id": "98ec3a39-54ed-4a75-b32b-3d80ec3c2932",
                                                "sense_id": "4a4459ac-865b-3dc7-a203-783b6f34bbfe",
                                                "text": "„Tourky stellte eine Flasche mit klarem Obstschnaps auf den Tisch, und zwei hohe zylindrische Wassergläser, die er aus einem Schrank im Ärztezimmer mitgebracht hatte.“"
                                            },
                                            {
                                                "example_id": "5efb31bb-c7c7-4385-a666-953b7cdb2bfa",
                                                "sense_id": "4a4459ac-865b-3dc7-a203-783b6f34bbfe",
                                                "text": "„Im Hotel stehen noch die Tuberosen im Wasserglas, die er mir geschenkt hat.“"
                                            },
                                            {
                                                "example_id": "03b8c554-3098-4c3b-8f62-de6f2302894f",
                                                "sense_id": "4a4459ac-865b-3dc7-a203-783b6f34bbfe",
                                                "text": "„Fürst Andrej erhob sich und ging, das Wasserglas in der Hand, auf den Zehen zum Bettchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5168e489-2eae-340b-a315-a05be8e11ecc",
                                        "entry_id": "68610e91-e127-305f-9d8d-fd3d53855ee7",
                                        "glosses": [
                                            "ein Alkalisilikat; Natriumsilikat oder Kaliumsilikat;"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6595c097-f67b-41a7-a55e-654714fe3f9a",
                                                "sense_id": "5168e489-2eae-340b-a315-a05be8e11ecc",
                                                "text": "Wasserglas ist eine farblose Verbindung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
