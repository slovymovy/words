                    "sense_definition": "Nom de famille français, illustré par Eugène Poubelle qui a imposé l'usage des boîtes à ordures.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
