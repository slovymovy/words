                "senses": [
                    {
                        "sense_id": "e00020ec-a93a-3491-8fd8-568bd9829238",
                        "entry_id": "b0fbe4ae-3f94-3a83-a6da-bdaafe1f81b9",
                        "glosses": [
                            "Verlustpunkt beim Kartenspiel Schnapsen"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "fff8ca81-1764-4c50-9716-a87e6254b37a",
                                "sense_id": "e00020ec-a93a-3491-8fd8-568bd9829238",
                                "text": "„Ab 2. März eröffnet sich eine neue Möglichkeit für Asse, Damen und Könige im Internet - auf tipp3.at können dann nicht nur Sportwetten abgegeben, sondern auch seinem Gegner ein ‚Bummerl‘ bei einer Partie Schnapsen angehängt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dbc3ae8d-9a2b-321f-897c-3133aaa4d143",
                        "entry_id": "b0fbe4ae-3f94-3a83-a6da-bdaafe1f81b9",
                        "glosses": [
                            "Pech, Nachteil, Last"
                        ],
                        "tags": [
                            "Austrian German",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "c45c804f-2cde-48f5-ac51-4764c9c8dfeb",
                                "sense_id": "dbc3ae8d-9a2b-321f-897c-3133aaa4d143",
                                "text": "„[Abgeordnete Mag. Elisabeth Grossmann:] Das fällt natürlich jenen auf den Kopf, die sehr viel in die Lebensgemeinschaft investiert haben, sei es durch Familienarbeit oder Bestreitung der Haushaltskosten, und hier haben in den meisten Fällen die Frauen das Bummerl.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "09b7c38f-b80d-37ce-9fdd-2ca223295093",
                        "entry_id": "b0fbe4ae-3f94-3a83-a6da-bdaafe1f81b9",
                        "glosses": [
                            "Treffer beim Sport"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "ee1a0f49-e57d-40a8-a3d9-457841ac6e48",
                                "sense_id": "09b7c38f-b80d-37ce-9fdd-2ca223295093",
                                "text": "„Diego Costa hält nach seinem Bummerl gegen West Brom bei zwölf Saisontoren, damit ist der Spanier die Nummer eins der Liga.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "516c6291-6e55-3272-b049-5661b8d25279",
                        "entry_id": "b0fbe4ae-3f94-3a83-a6da-bdaafe1f81b9",
                        "glosses": [
                            "Punkt auf einer Liste"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "d1def3d6-dd2f-4276-a370-26225c1b9e8c",
                                "sense_id": "516c6291-6e55-3272-b049-5661b8d25279",
                                "text": "„Was haben Ewald Stadler, die Sopranistin Montserrat Caballe und meine Wenigkeit gemeinsam? Ein Bummerl auf der Liste des aserbaidschanischen Außenministeriums.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
