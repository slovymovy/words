                    "sense_definition": "De benadrukte vorm van het persoonlijk voornaamwoord 'ik' in de objectsvorm (lijdend of meewerkend voorwerp) of na een voorzetsel.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wil je dat boek alsjeblieft aan <w>mij</w> geven?",
                            "target_lang_translations": {
                                "ru": "Ты не мог бы дать эту книгу <w>мне</w>?",
                                "en": "Could you please give that book to <w>me</w>?",
                                "pl": "Czy możesz dać tę książkę <w>mnie</w>?",
                                "de": "Kannst du dieses Buch bitte <w>mir</w> geben?",
                                "fr": "S'il te plaît, peux-tu <w>me</w> donner ce livre ?",
                                "it": "Puoi dare quel libro a <w>me</w>, per favore?",
                                "cs": "Mohl bys <w>mně</w> prosím dát tu knihu?",
                                "tr": "Lütfen o kitabı <w>bana</w> verir misin?",
                                "es": "¿Podrías darme ese libro a <w>mí</w>, por favor?"
                            }
                        },
                        {
                            "text": "Volgens <w>mij</w> is dit de juiste weg naar het station.",
                            "target_lang_translations": {
                                "ru": "По-<w>моему</w>, это правильная дорога на вокзал.",
                                "en": "To <w>me</w>, this seems like the right way to the station.",
                                "pl": "Moim <w>zdaniem</w> to jest właściwa droga na stację.",
                                "de": "<w>Meiner</w> Meinung nach ist das der richtige Weg zum Bahnhof.",
                                "fr": "Selon <w>moi</w>, c'est le bon chemin pour aller à la gare.",
                                "it": "Secondo <w>me</w> questa è la strada giusta per la stazione.",
                                "cs": "Podle <w>mě</w> je toto správná cesta na nádraží.",
                                "tr": "<w>Bence</w> istasyona giden doğru yol burası.",
                                "es": "En <w>mi</w> opinión, este es el camino correcto a la estación."
                            }
                        },
                        {
                            "text": "Hij luistert nooit goed naar <w>mij</w> als ik praat.",
                            "target_lang_translations": {
                                "ru": "Он никогда не слушает <w>меня</w> внимательно, когда я говорю.",
                                "en": "He never listens carefully to <w>me</w> when I talk.",
                                "pl": "On nigdy dobrze <w>mnie</w> nie słucha, kiedy mówię.",
                                "de": "Er hört <w>mir</w> nie richtig zu, wenn ich rede.",
                                "fr": "Il ne <w>m'</w>écoute jamais attentivement quand je parle.",
                                "it": "Non ascolta mai attentamente <w>me</w> quando parlo.",
                                "cs": "Nikdy <w>mě</w> pořádně neposlouchá, když mluvím.",
                                "tr": "Ben konuşurken <w>beni</w> asla iyi dinlemez.",
                                "es": "Él nunca me escucha con atención a <w>mí</w> cuando hablo."
                            }
                        }
