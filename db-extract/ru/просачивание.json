                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f52aabda-8d52-4b43-a226-e6b95fb1ecad",
                                                "sense_id": "14da526a-706b-3907-aa9c-f28ed2f74861",
                                                "text": "A 12-acre field of good, deep land on the farm of Frenchlaw, in Berwickshire, was rendered swampy by springs and oozings of water from the surrounding rising ground being retained upon the clay subsoil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b5ceeca-f085-3f92-95cf-4a77a0a6d652",
                                        "entry_id": "5afeb6c2-19d8-3257-896d-8aa59c15e627",
                                        "glosses": [
                                            "Synonym of stringing (“defect in 3D printing”)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0c60f06-c3a3-45f4-afa6-26e7021c022d",
                                                "sense_id": "4b5ceeca-f085-3f92-95cf-4a77a0a6d652",
                                                "text": "One of the side effects of having the hot end set to the optimal temperature for extrusion is oozing."
                                            }
