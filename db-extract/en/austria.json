                    {
                        "translation_id": "6caeb327-a2c1-48d7-9a06-1336201ae6e5",
                        "source_entry_id": "458f6a4a-98b6-3c09-98a6-f096ad842c30",
                        "source_sense_id": "4d3ec149-e0a3-3606-9a35-a3b6bd43ead0",
