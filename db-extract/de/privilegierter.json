                "senses": [
                    {
                        "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                        "entry_id": "1da420da-5035-3bfd-9912-e892eaa37de5",
                        "glosses": [
                            "Person, die Vorteile (= Privilegien) hat; häufig mit negativer Konnotation wegen der Vermutung ungerechtfertigter Vorteile"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b1e8376-f08d-4886-9ec6-f131ca3a4e0b",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„'Die Unehelichen' von Gerhard Lamprecht [ist] ein Film, der die Unterschiede zwischen den Privilegierten und den Unterprivilegierten sehr deutlich zeigt […]“"
                            },
                            {
                                "example_id": "1fd903e6-5a5a-4eb0-830b-6b57fc06716a",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„[Die Arbeit des chilenischen Architekten Alejandro Aravena] verschafft den weniger Privilegierten wirtschaftliche Chancen […]“"
                            },
                            {
                                "example_id": "1e674d7c-7bae-4181-b908-88b0843ebaa5",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„[…] die ökonomisch weniger Privilegierten beteiligen sich überproportional nicht mehr an Wahlen.“"
                            },
                            {
                                "example_id": "7af8e708-ef80-4337-9270-8477da532c79",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„[wir] müssen in Indien erstmal die Qualität der Grundausbildung verbessern, und zwar nicht nur an den Eliteschulen für die wenigen Privilegierten, sondern überall an den staatlichen Schulen.“"
                            },
                            {
                                "example_id": "df1d97d6-ee3d-4466-a927-1f09a3879e25",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„Vor allem aber geben Helden wie Martin Luther King Hoffnung. Hoffnung, dass es sich lohnt, aufzustehen. […] Sie rütteln an den Wohlfühlzonen der Privilegierten, fordern sie auf, sich einzubringen.“"
                            },
                            {
                                "example_id": "d7598e84-bec3-4147-b1bf-ac3661b95e52",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„Die Privilegierten selbst finden fast immer, dass sie ihr Ansehen, ihr Geld, und ihren Einfluss allein ihrer persönlichen Leistungsfähigkeit verdanken. […] Die Privilegierten […] beherrschen den öffentlichen Raum, sie prägen die Debatten, geben einer Gesellschaft ihr Gesicht.“"
                            },
                            {
                                "example_id": "e25c1f7b-e0ba-4f38-b51c-1928d5da3a74",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„Privilegierte schreiben ihre Bildungserfolge der eigenen Begabung zu, nicht der „Pole Position“, die ihnen im Rennen durch die Institutionen vom Kindergarten bis zur Hochschule zuvorkommend eingeräumt oder von den Eltern erkämpft wird.“"
                            },
                            {
                                "example_id": "dabf0640-aa60-4552-b925-f7187a580ff9",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„[…] Erling Kagge gehört zu den Privilegierten. 1963 kam er in Oslo zur Welt, in einer Familie von Intellektuellen: sein Vater ist Jazzjournalist, die Mutter Verlagsdirektorin.“"
                            },
                            {
                                "example_id": "c0f7fba5-1d21-43d9-9e3b-c42c58157fe6",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„Zu den Privilegierten [im Konzentrationslager Buchenwald] zählen auch Vorarbeiter, Pfleger und Schreiber.“"
                            },
                            {
                                "example_id": "060f096a-76eb-484c-bd0d-e87b7285fcec",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„[…] der Wahlkampf der US-Politiker [richte sich] eher an Privilegierte, da arme Menschen kaum wählen gingen, kritisiert der Politikwissenschaftler [und Armutsforscher Christoph Butterwegge]“"
                            },
                            {
                                "example_id": "b399ec6e-5e68-4acb-bb42-2ce590f2802c",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„Nicht nur in den Städten Zürich, Bern und Genf wurde gestreikt, sondern auch bei den Angestellten der Eisenbahnen. Obwohl diese Arbeiter damals [1918] zu den Privilegierten gehörten.“"
                            },
                            {
                                "example_id": "5a38014d-e229-4fc6-bb36-b1fd210b02e0",
                                "sense_id": "eeca8a01-6005-3ce3-8e46-f902972a15ec",
                                "text": "„Nur Privilegierten standen [im Mittelalter] Reittiere, Reisewagen oder gar Sänften zur Verfügung, die meisten Menschen bewegten sich zu Fuß.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
