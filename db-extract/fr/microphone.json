        "fr-extract.jsonl": [
            {
                "entry_id": "e9776ab6-ac60-32a7-ba35-ca599e86b41f",
                "word": "microphone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "12bd1eb4-561b-4644-b738-b5818f5e8c87",
                        "entry_id": "e9776ab6-ac60-32a7-ba35-ca599e86b41f",
                        "tags": [
                            "plural"
                        ],
                        "form": "microphones"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8d50d5a-451e-382d-a79d-cbaa7137bec5",
                        "entry_id": "e9776ab6-ac60-32a7-ba35-ca599e86b41f",
                        "glosses": [
                            "Instrument qui transforme un son en un signal électrique, lequel peut ensuite être amplifié pour être enregistré, diffusé ou restitué par un haut-parleur."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "eb542bf7-b234-4d26-a1df-a4cdca48d068",
                                "sense_id": "c8d50d5a-451e-382d-a79d-cbaa7137bec5",
                                "text": "Le microphone du radioconcert diffère donc notablement sur ce point du microphone de la téléphonie ordinaire et l'entrepreneur de radioconcert éprouvera de grosses difficultés d'organisation de son studio s'il n'a pas d'abord traité le problème technique de la recherche d'un microphone spécial."
                            },
                            {
                                "example_id": "09f12bdf-2257-417c-9e9e-636cba914ca4",
                                "sense_id": "c8d50d5a-451e-382d-a79d-cbaa7137bec5",
                                "text": "En parlant à tour de rôle devant le microphone, nous aurions dû dire que notre victoire était celle de la technique aéronautique française et de la météorologie, beaucoup plus que le triomphe de deux hommes."
                            },
                            {
                                "example_id": "c42734b6-8a3c-41e8-9ce0-24a43aa3fd78",
                                "sense_id": "c8d50d5a-451e-382d-a79d-cbaa7137bec5",
                                "text": "La popularité de Bakatine s'effondre quand il remet aux Américains, en signe de bonne volonté, les plans relatifs au « microtage » de l’ambassade américaine de Moscou, un dossier qui empoisonne les relations entre les deux pays depuis 1985, année de la découverte de centaines de microphones dans les bâtiments."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c29c957-a7ef-4a0e-b52a-fe93f4c322ae",
                        "source_entry_id": "e9776ab6-ac60-32a7-ba35-ca599e86b41f",
                        "source_sense_id": "c8d50d5a-451e-382d-a79d-cbaa7137bec5",
                        "target_lang_word": "Mikrofon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mikrofon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8d7cb580-be99-3806-8b75-4bf6d92d3f0e",
                                        "entry_id": "3bb3605a-959a-3931-86b1-23cb26f61366",
                                        "glosses": [
                                            "ein technisches Gerät zur Aufnahme von Tönen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b717f196-bc14-47be-bb55-a14c032a1232",
                                                "sense_id": "8d7cb580-be99-3806-8b75-4bf6d92d3f0e",
                                                "text": "Nach der Premiere war der berühmte Regisseur sofort von unzähligen Kameras und Mikrofonen umringt."
                                            },
                                            {
                                                "example_id": "1dea6b54-90df-4b99-9c00-ec6c50da77c5",
                                                "sense_id": "8d7cb580-be99-3806-8b75-4bf6d92d3f0e",
                                                "text": "„In der fünften Klasse kam der Schuldirektor meiner sowjetischen Schule mitten im Unterricht mit einem großen Tonbandgerät und einem Mikrofon zu uns in die Klasse.“"
                                            },
                                            {
                                                "example_id": "55e574f3-8a18-46a0-bece-6a0b53cf747a",
                                                "sense_id": "8d7cb580-be99-3806-8b75-4bf6d92d3f0e",
                                                "text": "„Sichtlich nervös ist er, während links neben ihm am Mikrofon der junge König der Belgier spricht, das Oberhaupt der alten Kolonialmacht, eigens angereist aus seinem Heimatland.“"
                                            },
                                            {
                                                "example_id": "03d0f9b1-e71f-4525-b01d-62ba0d8bd3a7",
                                                "sense_id": "8d7cb580-be99-3806-8b75-4bf6d92d3f0e",
                                                "text": "„Donald Trump dagegen legt erst richtig los, wenn er ein Mikrofon sieht.“"
                                            },
                                            {
                                                "example_id": "de75f0f0-c69d-49b4-bfda-d32a1e40b6f6",
                                                "sense_id": "8d7cb580-be99-3806-8b75-4bf6d92d3f0e",
                                                "text": "„Nach der Hauptspeise ergriff sie dann das Mikrofon.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bbacf7e-da8c-45b5-bb21-595a78710f66",
                        "source_entry_id": "e9776ab6-ac60-32a7-ba35-ca599e86b41f",
                        "source_sense_id": "c8d50d5a-451e-382d-a79d-cbaa7137bec5",
                        "target_lang_word": "microphone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microphone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "180bfa0c-3a33-345e-a6f9-1d877b3dbf2d",
                                        "entry_id": "a7496a0d-9cec-3fec-b8ff-1102758e7bd9",
                                        "glosses": [
                                            "A device (transducer) used to convert sound waves into a varying electric current; normally fed into an amplifier and either recorded or transmitted over radio."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47f35bdd-7bcb-4f5a-9da1-34b314ff2add",
                                                "sense_id": "180bfa0c-3a33-345e-a6f9-1d877b3dbf2d",
                                                "text": "Behind the tangled garden of microphones that had sprouted on the lectern, Goldwater spoke softly and casually about his family."
                                            },
                                            {
                                                "example_id": "222fdb36-56fe-44d1-bbe5-7594e927460b",
                                                "sense_id": "180bfa0c-3a33-345e-a6f9-1d877b3dbf2d",
                                                "text": "It rained hard through most of Roosevelt's Second Inaugural. Audio tape recordings of the speech feature the tattoo of the rain on Roosevelt's microphone[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "microphone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4145af30-8459-3e0b-a5f9-f29561a43a02",
                                        "entry_id": "d94718c1-eb09-3e52-986a-4f79e8583c5a",
                                        "glosses": [
                                            "To put one or more microphones on or in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
