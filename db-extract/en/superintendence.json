                        ],
                        "examples": [
                            {
                                "example_id": "ceba3829-dcd0-4d25-ab0e-d6f31324d3c9",
                                "sense_id": "1363706f-80c5-3255-b19c-a2409901502f",
                                "text": "While the Supreme Being exercises a general superintendence over affairs, the real administration is in the hands of the ancestral spirits."
                            },
                            {
                                "example_id": "3d77bd65-0493-4bcd-bf64-3b9e89001b92",
                                "sense_id": "1363706f-80c5-3255-b19c-a2409901502f",
                                "text": "The Ashby Canal was built under the superintendence of Robert Whitworth, and the whole length was opened in May, 1805."
                            },
                            {
                                "example_id": "1bc06921-ebcb-4b1b-a708-81da51e7bdf1",
                                "sense_id": "1363706f-80c5-3255-b19c-a2409901502f",
                                "text": "[…] then the building began, under the superintendence of the pigs."
                            }
                        ]
                    }
