    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bceee7dd-5aed-3d9e-a776-8dbbc2cde8fe",
                    "sense_definition": "The amount of electrical power required to operate an appliance or device.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "electrical_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before plugging in the heater, check its <w>wattage</w> to avoid overloading the circuit.",
                            "target_lang_translations": {
                                "ru": "Перед включением обогревателя проверьте его <w>мощность</w>, чтобы избежать перегрузки сети."
                            }
                        },
                        {
                            "text": "The microwave operates at a higher <w>wattage</w> to cook food much faster.",
                            "target_lang_translations": {
                                "ru": "Микроволновка работает на более высокой <w>мощности</w>, чтобы готовить еду намного быстрее."
                            }
                        }
                    ],
                    "synonyms": [
                        "power consumption",
                        "power rating"
                    ],
                    "common_phrases": [
                        "higher wattage",
                        "lower wattage",
                        "maximum wattage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество электрической мощности, необходимое для работы прибора или устройства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощность",
                                "target_lang_sense_clarification": "потребляемая электрическая мощность устройства"
                            },
                            {
                                "target_lang_word": "потребляемая мощность",
                                "target_lang_sense_clarification": "электрическая характеристика прибора"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2388aaf-4d7b-35f4-97b3-bf9b6720334f",
                    "sense_definition": "An amount of power, especially electric, measured or expressed in watts.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "electrical_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The solar panel array generates sufficient <w>wattage</w> to power the entire building.",
                            "target_lang_translations": {
                                "ru": "Массив солнечных батарей вырабатывает достаточную <w>мощность</w> для электроснабжения всего здания."
                            }
                        },
                        {
                            "text": "Engineers measured the total <w>wattage</w> produced during the peak hours of sunlight.",
                            "target_lang_translations": {
                                "ru": "Инженеры измерили общую <w>мощность</w>, выработанную в часы пиковой солнечной активности."
                            }
                        }
                    ],
                    "synonyms": [
                        "electric power"
                    ],
                    "common_phrases": [
                        "total wattage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество энергии (особенно электрической), измеренное или выраженное в ваттах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мощность",
                                "target_lang_sense_clarification": "величина энергии в ваттах"
                            },
                            {
                                "target_lang_word": "мощность в ваттах",
                                "target_lang_sense_clarification": "значение мощности в единицах измерения"
                            }
                        ]
                    }
                }
            ]
        }
    ]
