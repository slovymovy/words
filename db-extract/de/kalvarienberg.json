                ],
                "senses": [
                    {
                        "sense_id": "ef6c3173-84e2-3432-a2f4-856c47ce7899",
                        "entry_id": "bb043376-b464-32a6-a2bf-944b1043088a",
                        "glosses": [
                            "Religion: Anhöhe, die an die Kreuzigung Jesu erinnert (auch im übertragenen Sinne)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0932c4f0-b224-4028-9bd1-220208071e9f",
                                "sense_id": "ef6c3173-84e2-3432-a2f4-856c47ce7899",
                                "text": "„\"Kalvarienberg\" bezeichnet zunächst die Hinrichtungsstätte Jesu Christi vor den Toren Jerusalems, im weiteren Sinne auch umfangreiche Nachbildungen der Kreuzigungsszene, die im Zuge der Gegenreformation entstanden und von Katholiken als sakrale Stätten genutzt werden.“"
                            },
                            {
                                "example_id": "b3a1ba0e-fd06-4dd1-8fe1-9cd5397c9926",
                                "sense_id": "ef6c3173-84e2-3432-a2f4-856c47ce7899",
                                "text": "„Ausschnitt aus dem Gemälde „Der Volkreiche Kalvarienberg“ des Geseker Malers Gert van Lon.“"
                            },
                            {
                                "example_id": "b7e47ed5-dd3b-4522-827a-91165b8abcfd",
                                "sense_id": "ef6c3173-84e2-3432-a2f4-856c47ce7899",
                                "text": "„Das lateinische Wort calvariae bedeutet wie das griechische Wort golgatha Schädelstätte und bezieht sich auf den Hinrichtungsort Christi vor den Toren Jerusalems. In katholischen Landstrichen, besonders in der Nähe von Wallfahrtsorten, wurden früher Kalvarienberge geschaffen, indem man den Weg auf einen Hügel mit sieben oder mit vierzehn Darstellungen der Kreuzigung Christi ausstattete.“"
                            },
                            {
                                "example_id": "870211ff-79f8-4fed-88ad-68ce87de5a7e",
                                "sense_id": "ef6c3173-84e2-3432-a2f4-856c47ce7899",
                                "text": "„Wie heute noch viele Füssener, so war auch König Ludwig II. gerne auf dem Stationsweg zum Kalvarienberg unterwegs – zum letzten Mal am Karfreitag in seinem Todesjahr 1886.“"
                            },
                            {
                                "example_id": "819d1179-9036-4cb8-915e-466bfcf69748",
                                "sense_id": "ef6c3173-84e2-3432-a2f4-856c47ce7899",
                                "text": "„Ein großes Kreuz markiert das Ende des Kreuzweges, der auf den Kalvarienberg in Gosheim führt.“"
                            },
                            {
                                "example_id": "01e396f7-ca68-45a8-abae-2ca45b91ecd6",
                                "sense_id": "ef6c3173-84e2-3432-a2f4-856c47ce7899",
                                "text": "„Vom Kalvarienberg aus bietet sich dem Besucher ein guter Blick auf den malerischen Kreuzweg mit den alten Linden, auf Gosheim, den inneren Kraterring und bei guter Sicht bis zum Ipf im Westries.“"
                            },
                            {
                                "example_id": "d9710b90-f57e-43bc-83b7-4ed718533f23",
                                "sense_id": "ef6c3173-84e2-3432-a2f4-856c47ce7899",
                                "text": "„Direkt von der Bergkapelle aus führt ein schmaler Pfad zum Fuß des Kalvarienbergs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
