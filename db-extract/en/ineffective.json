                                        "sense_id": "f1da25e3-1c86-3bab-a881-2e6b1de03e81",
                                        "entry_id": "2a8b6855-82e4-3b25-921d-5133cc1dc9cd",
                                        "glosses": [
                                            "keine Wirkung habend; eine Handlung, die nichts verändert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b43665-b548-4927-be52-983e1d52748f",
                                                "sense_id": "f1da25e3-1c86-3bab-a881-2e6b1de03e81",
                                                "text": "Die ganzen Demonstrationen und Proteste blieben wirkungslos."
                                            },
                                            {
                                                "example_id": "69522961-aa11-4178-b7f0-a4460d0eceff",
                                                "sense_id": "f1da25e3-1c86-3bab-a881-2e6b1de03e81",
                                                "text": "Immer mehr Antibiotika sind wirkungslos, […]"
                                            },
                                            {
                                                "example_id": "dc7aecea-4b63-4692-8295-e9cdda1e02ae",
                                                "sense_id": "f1da25e3-1c86-3bab-a881-2e6b1de03e81",
                                                "text": "Die aus Gaza abgeschossenen Raketen seien militärisch völlig wirkungslos, räumt Usama Antar ein."
                                            },
                                            {
                                                "example_id": "f635b569-53bc-4753-ae7f-ec692b594dcc",
                                                "sense_id": "f1da25e3-1c86-3bab-a881-2e6b1de03e81",
                                                "text": "Es gebe andere Situationen, in denen Päpste völlig wirkungslos sind aber auch solche, wo ein Papst scheinbar wirkungslos bleibt, sich am Ende aber doch durchsetze […]"
                                            },
                                            {
                                                "example_id": "81cb7533-1bd6-49aa-af6a-fee7cd3f8391",
                                                "sense_id": "f1da25e3-1c86-3bab-a881-2e6b1de03e81",
                                                "text": "„[Die] Friedensbewegung [hatte] ihre beste Zeit, als der Krieg weit weg war. Wirkungslos war sie deshalb nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
