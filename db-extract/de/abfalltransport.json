                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8364026-4a07-4e99-888d-7b055477eb0c",
                                "sense_id": "d14d12cf-8ffc-3881-8286-296db2045959",
                                "text": "„Auch für Bauabfälle gelten künftig die Mengengrenzen, die mit der neuen Verordnung für Abfalltransporte festgelegt sind.“"
                            },
                            {
                                "example_id": "da71464b-4026-4a3a-9d2e-b61aa71aa51a",
                                "sense_id": "d14d12cf-8ffc-3881-8286-296db2045959",
                                "text": "„Beamte der Verkehrsdirektion in Koblenz stoppten am Dienstagvormittag, 30.07.2013, auf dem Parkplatz Rastplatz Rübenacher Wald, BAB 61, Rtg. Norden, einen illegalen Abfalltransport.“"
                            }
                        ],
