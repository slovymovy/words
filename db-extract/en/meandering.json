                "senses": [
                    {
                        "sense_id": "16cb5883-e178-3128-8fe0-2c23a2b7ed3a",
                        "entry_id": "ee840782-3fcf-34ba-9e45-87d54707e028",
                        "glosses": [
                            "Winding or rambling."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b810919a-6eaa-44f5-9f48-1593dea09621",
                                "sense_id": "16cb5883-e178-3128-8fe0-2c23a2b7ed3a",
                                "text": "After petrol rationing ended in 1952, the BTC was aware that more swingeing cuts had to be made, and a sinister message was conveyed by the loss of the meandering 38-mile route from Blisworth to Stratford-upon-Avon in April 1952, and the 25-mile Abergavenny-Merthyr Heads of the Valleys line in January 1958."
                            },
                            {
                                "example_id": "2f93a87e-14ce-4006-8aaa-cecef28ee69d",
                                "sense_id": "16cb5883-e178-3128-8fe0-2c23a2b7ed3a",
                                "text": "“Billups, how much farther to the compound?” “At our meandering speed, 15 minutes?”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c7b0ac0-a2c4-4c22-813f-0c36f1fb2495",
                        "source_entry_id": "ee840782-3fcf-34ba-9e45-87d54707e028",
                        "source_sense_id": "16cb5883-e178-3128-8fe0-2c23a2b7ed3a",
                        "source_sense_description": "winding, rambling",
                        "target_lang_word": "méandreux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "méandreux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d879b4b0-c3ec-3a41-91a5-3e3d564627e4",
                                        "entry_id": "febc6500-fe33-3ec6-b504-456c5679b744",
                                        "glosses": [
                                            "Qui est sinueux, fait des méandres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4334a715-6361-43a0-9168-1efe5ec5ff2e",
                                                "sense_id": "d879b4b0-c3ec-3a41-91a5-3e3d564627e4",
                                                "text": "Pour le seconder, il trouverait sur place le dieu-fleuve Styx, fils d’Océan et de Théthys, dont les bras méandreux entouraient l’infernal domaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea6b9f94-1018-3484-8f6d-dfe475684ea1",
                                        "entry_id": "febc6500-fe33-3ec6-b504-456c5679b744",
                                        "glosses": [
                                            "Lent ; indirect ; compliqué."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25478f63-053b-492d-8f7c-067eef07ee1a",
                                                "sense_id": "ea6b9f94-1018-3484-8f6d-dfe475684ea1",
                                                "text": "Je veux refuser de suivre ces longs calculs sur leur trace méandreuse."
                                            },
                                            {
                                                "example_id": "16bf104f-5daa-45b5-ba82-43ae063761c6",
                                                "sense_id": "ea6b9f94-1018-3484-8f6d-dfe475684ea1",
                                                "text": "La fulgurance du crash tranche avec la lenteur de la réponse judiciaire. Depuis la mise en examen initiale d’Air France et d’Airbus – la compagnie et le constructeur de l’avion –, dix ans d’instruction méandreuse se sont écoulés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
