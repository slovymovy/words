                    {
                        "sense_id": "b5713890-8c15-3474-8bd1-58dc4d48084e",
                        "entry_id": "aabdeb6e-11a3-391c-9f44-ca7c9076c669",
                        "glosses": [
                            "een symbolische en grafische voorstelling van een aantal zaken en hun onderling verband"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cbc25281-a9ef-49c0-a84f-3bea47ce5a0a",
                                "sense_id": "b5713890-8c15-3474-8bd1-58dc4d48084e",
                                "text": "Zoals het diagram laat zien zijn er een aantal verschillende processen betrokken bij de stikstofkringloop op aarde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e86cd32e-6e71-42be-87d0-27dedd039449",
                        "source_entry_id": "aabdeb6e-11a3-391c-9f44-ca7c9076c669",
                        "source_sense_id": "b5713890-8c15-3474-8bd1-58dc4d48084e",
                        "source_sense_description": "een symbolische en grafische voorstelling van een aantal zaken en hun onderling verband",
                        "target_lang_word": "Diagramm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diagramm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c01197b5-0eae-3851-8787-fc2059f298d7",
                                        "entry_id": "cfa2a5bf-d320-3d02-b0dc-22a310ed020f",
                                        "glosses": [
                                            "grafische Darstellung eines Sachverhalts, der zahlenmäßig erfasst ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dab68e6-6035-4128-8dd2-c6b5e1fce446",
                                                "sense_id": "c01197b5-0eae-3851-8787-fc2059f298d7",
                                                "text": "Wenn man einen Sachverhalt als Diagramm darstellt, ist er oft leichter zu verstehen, als wenn man ihn nur verbal beschreibt."
                                            },
                                            {
                                                "example_id": "1f74b96f-8840-49c6-a1a1-a060e001d425",
                                                "sense_id": "c01197b5-0eae-3851-8787-fc2059f298d7",
                                                "text": "„Sprache und nur die Sprache schenkt dem Menschentier die Macht des exakten Erinnerns und stattet ihn mit dem Mittel aus, etwas einstweilen in seinem Gedächtnis zu speichern oder auf unbestimmte Zeit in Druckbuchstaben zu bewahren oder auf Film zu bannen oder in die Form von technischen, architektonischen und anderen Diagrammen zu kleiden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "559256d1-4bc0-3503-9964-f89a46d3fdfc",
                                        "entry_id": "cfa2a5bf-d320-3d02-b0dc-22a310ed020f",
                                        "glosses": [
                                            "Stellungsbild beim Schach"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6813521-dc69-47b6-b828-6f59e878b810",
                                                "sense_id": "559256d1-4bc0-3503-9964-f89a46d3fdfc",
                                                "text": "Eine Schachstellung wird in der Schachliteratur gerne durch ein Diagramm abgebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7788da31-438c-46af-9ec2-10717f6afbf2",
                        "source_entry_id": "aabdeb6e-11a3-391c-9f44-ca7c9076c669",
                        "source_sense_id": "b5713890-8c15-3474-8bd1-58dc4d48084e",
                        "source_sense_description": "een symbolische en grafische voorstelling van een aantal zaken en hun onderling verband",
                        "target_lang_word": "diagram",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diagram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb9fc7d0-8298-32fe-8513-11f6bc0b7f4e",
                                        "entry_id": "1ab389d6-e66e-325c-9ba7-c14aee1cd781",
                                        "glosses": [
                                            "A plan, drawing, sketch or outline to show how something works, or show the relationships between the parts of a whole."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54f932ea-2fff-439f-85dd-236db87df11e",
                                                "sense_id": "eb9fc7d0-8298-32fe-8513-11f6bc0b7f4e",
                                                "text": "Electrical diagrams show device interconnections."
                                            },
                                            {
                                                "example_id": "89df23bf-62d5-4207-80f8-10065705cd6d",
                                                "sense_id": "eb9fc7d0-8298-32fe-8513-11f6bc0b7f4e",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ac7f622-02fb-340b-930e-4ac1213bfc93",
                                        "entry_id": "1ab389d6-e66e-325c-9ba7-c14aee1cd781",
                                        "glosses": [
                                            "A graph or chart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1ba0ac5-334f-4c7b-9129-e891cd3dda2f",
                                                "sense_id": "3ac7f622-02fb-340b-930e-4ac1213bfc93",
                                                "text": "A common way to represent change in state over time is via a timing diagram."
                                            },
                                            {
                                                "example_id": "9b30e568-0877-42ad-a25f-71605398b06a",
                                                "sense_id": "3ac7f622-02fb-340b-930e-4ac1213bfc93",
                                                "text": "This particular diagram represents a dinosaur in the distant past and a person who is born in AD 2000. These objects stretch out horizontally in the graph because they last over time in reality, and time is the horizontal axis on the graph"
                                            },
                                            {
                                                "example_id": "90ed5e58-319f-446e-a786-144e827934ec",
                                                "sense_id": "3ac7f622-02fb-340b-930e-4ac1213bfc93",
                                                "text": "Various terms for this type of graph seem to be used interchangeably: 'scatter diagram', 'scatter graph' and 'scatter plot'."
                                            },
                                            {
                                                "example_id": "ac728cf0-dd9d-47a0-984f-caefe88785f3",
                                                "sense_id": "3ac7f622-02fb-340b-930e-4ac1213bfc93",
                                                "text": "This powerful visual tool, known as the sawtooth diagram, is used to analyze inventory behavior over time."
                                            },
                                            {
                                                "example_id": "cf4ddb68-e0d9-4517-86e0-31aae5c6ca5d",
                                                "sense_id": "3ac7f622-02fb-340b-930e-4ac1213bfc93",
                                                "text": "We can then chart them over time and it results in that kind of a diagram."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a9aec94-3ddf-3558-8df7-66a21dff4e23",
                                        "entry_id": "1ab389d6-e66e-325c-9ba7-c14aee1cd781",
                                        "glosses": [
                                            "A functor from an index category to another category. The objects and morphisms of the index category need not have any internal substance, but rather merely outline the connective structure of at least some part of the diagram's codomain. If the index category is J and the codomain is C, then the diagram is said to be \\\"of type J in C\\\"."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe11587e-4b24-350e-a858-cf51c5ee598d",
                                        "entry_id": "1ab389d6-e66e-325c-9ba7-c14aee1cd781",
                                        "glosses": [
                                            "A crossword grid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b0642c5-0b0c-42e6-9239-6fb19a2258e3",
                                                "sense_id": "fe11587e-4b24-350e-a858-cf51c5ee598d",
                                                "text": "Because you have fewer 10- to 15-letter entries in the diagram, you can make judgment calls more quickly by testing out the long ones at the outset."
                                            },
                                            {
                                                "example_id": "c62ad687-6fd2-4371-9099-75e6d280204d",
                                                "sense_id": "fe11587e-4b24-350e-a858-cf51c5ee598d",
                                                "text": "A crossword puzzle consists of a diagram that usually is rectangular and divided into blank (white) and cancelled (black, shaded, or crosshatched) squares."
                                            },
                                            {
                                                "example_id": "9a41dd1b-88ba-4b78-8b5b-89839cf6b135",
                                                "sense_id": "fe11587e-4b24-350e-a858-cf51c5ee598d",
                                                "text": "If you think of a completed crossword diagram as a house, short words with common letters are the necessary “mortar” that makes the longer, more interesting “brick” words in a puzzle possible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diagram",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b7ab669-911a-3e6e-9c62-182e46a34902",
                                        "entry_id": "57f83734-c653-3985-85ca-155beba3ed41",
                                        "glosses": [
                                            "To represent or indicate something using a diagram."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68e7113b-6fa7-3f21-9525-c9f2b71a7f2f",
                                        "entry_id": "57f83734-c653-3985-85ca-155beba3ed41",
                                        "glosses": [
                                            "To schedule the operations of a locomotive or train according to a diagram."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0ed5ca6-360a-4650-be49-8814f19a6c30",
                                                "sense_id": "68e7113b-6fa7-3f21-9525-c9f2b71a7f2f",
                                                "text": "The timing and diagramming staff, too, were on duty for up to 21 hours devising 80 engine, 60 guards' and 25 carriage working diagrams."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
