                "senses": [
                    {
                        "sense_id": "95b57bf9-8f90-3875-a7be-fce1d60c0403",
                        "entry_id": "bbf8874d-dd95-3139-bb1b-38bf9e281121",
                        "glosses": [
                            "Areal, das den Fluss Amazonas und seine Nebenflüsse umgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12ed427a-2241-4509-b126-b2cbb4aea416",
                                "sense_id": "95b57bf9-8f90-3875-a7be-fce1d60c0403",
                                "text": "„Gemeinsam mit Bates fasste er 1847 den abenteuerlichen Plan, nach Brasilien zu reisen und das Amazonasgebiet zu erforschen, wo sie viele unbekannte Insektenarten vermuteten.“"
                            },
                            {
                                "example_id": "f822b2eb-ded4-4d68-8975-50eefb77ce45",
                                "sense_id": "95b57bf9-8f90-3875-a7be-fce1d60c0403",
                                "text": "„Als vierte Hauptgruppe endlich sind die unter dem Namen Nu-Aruak oder Maipure zusammengefassten Stämme zu erwähnen, welche sich von der Nordgrenze Brasiliens bis zum 20° s. Br. und vom äussersten Westen bis an den Atlantischen Ocean hinziehen, jedoch vorzüglich im oberen Amazonasgebiete sitzen.“"
                            },
                            {
                                "example_id": "1901f6e6-f7e2-4320-a1a8-291c0891543a",
                                "sense_id": "95b57bf9-8f90-3875-a7be-fce1d60c0403",
                                "text": "„Präsident Alan Garcia will die in den Amazonasgebieten vermuteten Öl- und Gasvorkommen von ausländischen Firmen erschließen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
