                    {
                        "translation_id": "657b2481-2d36-4cfe-a09d-447a82814050",
                        "source_entry_id": "ed40b3ac-c953-3f01-a0b6-eca7c457a530",
                        "source_sense_description": "detoxification",
                        "target_lang_word": "ontwenningskuur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ontwenningskuur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ec37ef96-5326-3521-95ee-1274a83713b3",
                                        "entry_id": "68d9e8b2-0a31-3a9e-b7a3-a98a8bdde22e",
                                        "glosses": [
                                            "een behandeling die als doel heeft dat de patiënt niet meer verslaafd is aan een bepaald middel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54e68e48-7a85-4131-a5b3-b8e740254ebe",
                                                "sense_id": "ec37ef96-5326-3521-95ee-1274a83713b3",
                                                "text": "Zijn privéleven verkeerde al in zwaar weer. Acht jaar geleden hertrouwde Van C. Steevast bewierookte hij zijn herwonnen geluk. Zijn tweede vrouw stond aan zijn zijde toen hij in 2012 op bevel van Bart De Wever een peperdure ontwenningskuur boekte. Maar een jaar geleden ging het koppel uit elkaar. Van C. bokste twee jaar als therapie tegen het opspelende verlangen. Uiteindelijk sloeg de drank hem knock-out."
                                            },
                                            {
                                                "example_id": "e3bc5e9d-e3ae-4e7c-9107-d24e6f347c6a",
                                                "sense_id": "ec37ef96-5326-3521-95ee-1274a83713b3",
                                                "text": "We weten het, en veel van ons snakken naar een ontwenningskuur, en toch laten we ons nog steeds en vrij massaal in de Facebook-mal duwen. Ligt er misschien een nóg dieper menselijk verlangen ten grondslag aan de opmars van het geglobaliseerde gezichtenboek?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a063e612-5e2e-4fb6-b6bc-bd3508db75c3",
                        "source_entry_id": "ed40b3ac-c953-3f01-a0b6-eca7c457a530",
                        "source_sense_description": "detoxification",
                        "target_lang_word": "détox",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détox",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5261726c-bc8e-360f-afcb-17c7e2c016b0",
                                        "entry_id": "a9910f3d-fa8e-37f2-9bb7-240a51f4846d",
                                        "glosses": [
                                            "Désintoxication, élimination des toxines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "433a1700-4b7d-4098-ae20-bf7e18acce70",
                                                "sense_id": "5261726c-bc8e-360f-afcb-17c7e2c016b0",
                                                "text": "Côté gourmandise – parce que détox ne rime pas avec « fadeur » –, vous découvrirez de nombreuses recettes de légumes et jus ultra-vitaminés !"
                                            },
                                            {
                                                "example_id": "489bd2a2-c29b-418b-a178-e6ce6a083c7b",
                                                "sense_id": "5261726c-bc8e-360f-afcb-17c7e2c016b0",
                                                "text": "Envie de détox, de sport et de frugalité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7dee9ae2-d367-4834-99d2-acaeeb8f588d",
                        "source_entry_id": "ed40b3ac-c953-3f01-a0b6-eca7c457a530",
                        "source_sense_description": "detoxification",
                        "target_lang_word": "désintox",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désintox",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8d18e8a9-f9c8-3032-bf97-dd1c49153bf1",
                                        "entry_id": "07e806e0-334e-3a62-acf3-72cd07459c85",
                                        "glosses": [
                                            "Désintoxication, traitement contre la dépendance à la drogue ou à l’alcool."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc054469-ab13-4370-bd90-a26abda2b635",
                                                "sense_id": "8d18e8a9-f9c8-3032-bf97-dd1c49153bf1",
                                                "text": "Pour le public bourgeois, l’avant-garde « sérieuse » (l’avant-garde « drôle ») c’était le groupe diablotin Cocteau-Radiguet, avec ses performances, ses opiums, ses chapelles peintes, ses cures de désintox, ses saute-rétros et saute-rires (sic), ses bonnes facéties."
                                            },
                                            {
                                                "example_id": "329edf0e-c662-4efc-b187-bcc185cd2009",
                                                "sense_id": "8d18e8a9-f9c8-3032-bf97-dd1c49153bf1",
                                                "text": "J’ai donc dû ronger mon frein pendant sept longues journées passées en « thérapie » avec d'autres ados « difficiles ». Entre l’anorexique de 40 kg persuadée qu’elle est énorme, l’obèse qui voulait maigrir, le camé en cure de désintox et le flippé bourré de tocs, j’ai passé une semaine d’enfer."
                                            },
                                            {
                                                "example_id": "fd263a09-419f-4e98-a626-2d64e7893384",
                                                "sense_id": "8d18e8a9-f9c8-3032-bf97-dd1c49153bf1",
                                                "text": "Je suis le fils de Brad (décédé) et Kitty (en cure de désintox) Bolitar, et je cohabite actuellement avec mon oncle, Myron Bolitar (que je tolère)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91eb8ee0-2f56-3676-977d-3b89dab19e49",
                                        "entry_id": "07e806e0-334e-3a62-acf3-72cd07459c85",
                                        "glosses": [
                                            "Séjour en centre spécialisé pour y subir une cure de désintoxication."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0133832d-b9fb-4941-b2f6-78fc3448d39d",
                                                "sense_id": "91eb8ee0-2f56-3676-977d-3b89dab19e49",
                                                "text": "Je ne veux pas aller en désintox."
                                            },
                                            {
                                                "example_id": "a9427947-8cec-444c-9c61-d7e4d1ee6b40",
                                                "sense_id": "91eb8ee0-2f56-3676-977d-3b89dab19e49",
                                                "text": "Je suis sorti de désintox le mois dernier."
                                            },
                                            {
                                                "example_id": "258fc591-10ff-4f77-b2d0-aa255731b628",
                                                "sense_id": "91eb8ee0-2f56-3676-977d-3b89dab19e49",
                                                "text": "J'ai rencontré mon conjoint pendant ma désintox."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
