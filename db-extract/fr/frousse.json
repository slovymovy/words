        "fr-extract.jsonl": [
            {
                "entry_id": "dcf372f3-df96-3191-a3ca-e0fe7c6c62ae",
                "word": "frousse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0e198ca4-6698-4b33-b64b-e69c1e43bd11",
                        "entry_id": "dcf372f3-df96-3191-a3ca-e0fe7c6c62ae",
                        "tags": [
                            "plural"
                        ],
                        "form": "frousses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                        "entry_id": "dcf372f3-df96-3191-a3ca-e0fe7c6c62ae",
                        "glosses": [
                            "Peur."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f7b78342-10d7-4ef6-a974-04fa34b3a5d7",
                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                "text": "Je suis content que tu sois revenu. Tu nous a foutu une sacrée frousse."
                            },
                            {
                                "example_id": "d63cf499-3397-4d61-97bf-9c2ad08268dd",
                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                "text": "C’était pas permis de vous faire droguer ainsi, quand on avait une frousse pareille !"
                            },
                            {
                                "example_id": "a620c3b5-1513-4d40-a0b9-b9b1ff4fa447",
                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                "text": "Ne cède pas à la frousse, me réconforte Tacherot, c'est un mauvais moment à passer."
                            },
                            {
                                "example_id": "741f36bf-7fd6-49ba-83d5-60f7e5821adc",
                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                "text": "Je ne vis plus, j’ai tout le temps la frousse d’être pincée."
                            },
                            {
                                "example_id": "119be908-435f-4a0f-b646-291caa65e9a6",
                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                "text": "La poulaille n’est certainement pas en odeur de sainteté dans le coinstot. Non pas que les indigènes craignent une vulgaire peste aviaire, mais la frousse qu'un gallinacé au plumage bleu nuit engendre des émeutes incendiaires de guimbardes reste vivace."
                            },
                            {
                                "example_id": "a2172e3b-1bbc-41b0-9ba1-8ef0836979fd",
                                "sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                                "text": "C'était la terreur. Un sacré tord-boyaux de frousse tellement on avait peur qu'un des deux se viandât méchamment cinq mètres plus bas."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b61556bc-abdf-487b-b289-62a408c98cc3",
                        "source_entry_id": "dcf372f3-df96-3191-a3ca-e0fe7c6c62ae",
                        "source_sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                        "target_lang_word": "Bammel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bammel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                        "entry_id": "f65bc029-15f5-38f1-8ca4-1328beb50a89",
                                        "glosses": [
                                            "Angst, Furcht"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26a475b2-c903-4ff4-933a-46819b0b32c3",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "Vor der nächsten Prüfung habe ich einen richtigen Bammel."
                                            },
                                            {
                                                "example_id": "c864a69e-6970-4a04-a978-6e72052884eb",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "Ich habe ein bisschen Bammel davor, diese Rede zu halten."
                                            },
                                            {
                                                "example_id": "09141907-e20d-4d80-b74c-f33eb6e29173",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "„Einerseits freute ich mich, meine Verwandten wiederzusehen, andererseits hatte ich großen Bammel davor.“"
                                            },
                                            {
                                                "example_id": "74268ac5-a547-4565-b0ca-faf5d8303a3c",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "„»Am meisten Bammel habe ich vor meiner Note in Deutsch.«“"
                                            },
                                            {
                                                "example_id": "32cf87a3-c0f7-40de-99f1-ecc87dc3a181",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "„Er hatte Bammel vor dem Wiedersehen mit Reizl.“"
                                            },
                                            {
                                                "example_id": "5c36bd8c-796f-430d-bd70-ed98f992b92e",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "„Ein Blick auf die Plakette verrät: TÜV abgelaufen! Oha! Helge Albrecht hat Bammel vor dem Termin.“"
                                            },
                                            {
                                                "example_id": "551e3074-7c54-4d8c-94e8-8773095e56a2",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "„Manchmal hat Sarah noch ein wenig Bammel, dass das Holzblasinstrument [Anmerkung: eine Klarinette] beim Erwärmen über dem Bunsenbrenner Feuer fängt. »Da muss man ganz genau die Flamme unter die Klappe halten.«“"
                                            },
                                            {
                                                "example_id": "c8d9bba6-ea96-4b98-85a3-d8c12f9b9dfb",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "Vor einer Zuwanderung brauchen wir in der Bundesrepublik wirklich keinen Bammel zu haben. Denn ohne Zuwanderung wird unsere Bevölkerung jedes Jahr ca. 200.000 Personen kleiner."
                                            },
                                            {
                                                "example_id": "a6ed5291-26a4-42a7-bf96-102d9feee6c4",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "„»Die Herausforderungen sind selbstverständlich groß. Bammel davor habe ich keinen. Ich freue mich eher auf die Aufgabe.«“"
                                            },
                                            {
                                                "example_id": "22bc9acd-4683-45ac-a478-bed2eb8273e7",
                                                "sense_id": "f0ff70a4-8669-3dae-b752-0db610b7ee06",
                                                "text": "[Der jamaikanische Sprinter Usain] „Bolt selbst verspürt nach eigenem Bekunden keinen Bammel vor der Rente. »Es wird eine Freude sein, sich zurückzulehnen« und »sich zu erinnern«, sagte er.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25c3cfa1-b040-49c5-938f-7a7e7d7a610c",
                        "source_entry_id": "dcf372f3-df96-3191-a3ca-e0fe7c6c62ae",
                        "source_sense_id": "f55b6e4a-830a-3599-93cd-5e0964bab094",
                        "target_lang_word": "fright",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa1c803c-f91c-3789-b93f-6535abeed209",
                                        "entry_id": "a84ca046-772d-38a0-a762-c37ece529ce9",
                                        "glosses": [
                                            "A state of terror excited by the sudden appearance of danger; sudden and violent fear, usually of short duration; a sudden alarm."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef16aa35-6044-4572-a7aa-b062635474be",
                                                "sense_id": "fa1c803c-f91c-3789-b93f-6535abeed209",
                                                "text": "With a bolt of fright he remembered that there was no bathroom in the Hobhouse Room. He leapt along the corridor in a panic, stopping by the long-case clock at the end where he flattened himself against the wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73fb4912-def0-387b-adde-d059d2522868",
                                        "entry_id": "a84ca046-772d-38a0-a762-c37ece529ce9",
                                        "glosses": [
                                            "Someone strange, ugly or shocking, producing a feeling of alarm or aversion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c334c7c-289b-4277-979a-4343acc8282c",
                                                "sense_id": "73fb4912-def0-387b-adde-d059d2522868",
                                                "text": "Her maids were old, and if she took a new one,\nYou might be sure she was a perfect fright;\nShe did this during even her husband's life\nI recommend as much to every wife."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                                        "entry_id": "423868ba-6df9-395b-922d-2f4fdb35d3c5",
                                        "glosses": [
                                            "To frighten."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a051dd69-5112-4f27-9cd4-c80da5a0d716",
                                                "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                                                "text": "Are not you he […] That frights the maidens of the villagery […] ?"
                                            },
                                            {
                                                "example_id": "afad723d-68bf-4d70-a753-af5695c7594f",
                                                "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                                                "text": "Little Miss Muffet, She sat on a tuffet, Eating of curds and whey; There came a little spider, Who sat down beside her, And frighted Miss Muffet away."
                                            },
                                            {
                                                "example_id": "42bda33e-0960-4bf0-865d-65f2fdcc04bd",
                                                "sense_id": "d51db2ff-e5af-3c9d-a2e9-564b7d548c9b",
                                                "text": "A very fine situation was proposed to him, where he might have a noble view of the ocean; but he started back, with an attitude of terror Betterton might envy, when Hamlet meets his father's ghost, and cried out,—\"Oh, Christ! the sea looks so fierce that it frights me!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fright",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                                        "entry_id": "321144ad-81a9-3ff7-9612-0f002b6e1ee7",
                                        "glosses": [
                                            "frightened; afraid; affright"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aa86401-9323-4005-adb5-86f25c33efc8",
                                                "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                                                "text": "Don't be fright, it is not so impossible as it seems."
                                            },
                                            {
                                                "example_id": "44900002-994b-4527-b983-ad32e211ac92",
                                                "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                                                "text": "Don't be fright, I'm not going to hurt you."
                                            },
                                            {
                                                "example_id": "a323c9f3-64f8-44fb-a8cc-4d0be5668269",
                                                "sense_id": "c0460978-d32e-378e-afb4-edb2a6073be4",
                                                "text": "He had a great heavy jaw and shoulders like an ox and bore no resemblance to Maurice Leonard. 'Come along, lad,' the sergeant said. 'Come along. Don't be fright. It's what you're here for now, ain't it?'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
