        "nl-extract.jsonl": [
            {
                "entry_id": "a5ba2573-a83a-3c0b-ae74-6a8f6f646521",
                "word": "florerend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1c43323c-3c73-31cb-8ad7-2260e49e2569",
                        "entry_id": "a5ba2573-a83a-3c0b-ae74-6a8f6f646521",
                        "glosses": [
                            "van iets of iemand dat hij zich goed ontwikkeld, dat hij gezond is, dat het goed gaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733f532b-ea0e-4ef0-b397-e59c7e842db6",
                                "sense_id": "1c43323c-3c73-31cb-8ad7-2260e49e2569",
                                "text": "Brancheorganisatie BOVAG wijt de huidige stijging aan de florerende economie. ,,Een motor is voor veel mensen toch een luxe product. Bij hoogconjunctuur liggen de verkopen beduidend hoger’’, vertelt woordvoerder Tom Huyskens."
                            },
                            {
                                "example_id": "feaa96c2-1808-4622-a64d-e2dcd4a6f9e5",
                                "sense_id": "1c43323c-3c73-31cb-8ad7-2260e49e2569",
                                "text": "Een van de achterliggende oorzaken van de florerende theaterbusiness is het almaar toenemende toerisme in New York. Ongeveer 63 procent van de theaterbezoekers is toerist. Daarnaast was er op Broadway met 72 shows ontzettend veel keus voor de theaterliefhebber."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee817f36-da24-49bf-b283-f37d47436524",
                        "source_entry_id": "a5ba2573-a83a-3c0b-ae74-6a8f6f646521",
                        "source_sense_id": "1c43323c-3c73-31cb-8ad7-2260e49e2569",
                        "source_sense_description": "van iets of iemand dat hij zich goed ontwikkeld, dat hij gezond is, dat het goed gaat",
                        "target_lang_word": "wealthy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wealthy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d909c13-b30a-31ad-939a-48f4adf811b0",
                                        "entry_id": "e83c83c3-2b59-35a5-8ee1-2b6b9365513b",
                                        "glosses": [
                                            "Possessing financial wealth; rich."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63b91b82-ae94-418f-bfd3-71f6d2034e84",
                                                "sense_id": "8d909c13-b30a-31ad-939a-48f4adf811b0",
                                                "text": "As a result of these causes the grazier marks himself off fairly sharply from the rest of Australia. He has always spent a considerable proportion of the time in the capital cities, in each of which he has formed a club to which, besides the graziers, only a few of the wealthiest and most prominent of the city dwellers are admitted."
                                            },
                                            {
                                                "example_id": "8a875102-c59c-4fdf-bfd1-850d09f49daa",
                                                "sense_id": "8d909c13-b30a-31ad-939a-48f4adf811b0",
                                                "text": "As people stall feed through the years, or if they are wealthier to begin with, the money is used to build houses and buy metal roof sheets, or to buy bicycles, ox-carts and breeding cows."
                                            },
                                            {
                                                "example_id": "80b9e4e4-39b5-4a8c-aae5-6fcd527b35f9",
                                                "sense_id": "8d909c13-b30a-31ad-939a-48f4adf811b0",
                                                "text": "Gleefully and legally intruding upon the sanctum of the wealthy linksters, we walked the mitigation meadows."
                                            },
                                            {
                                                "example_id": "63091506-801c-46e8-a4a2-9ea5c6d16c65",
                                                "sense_id": "8d909c13-b30a-31ad-939a-48f4adf811b0",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. […] The public realm is privatised, the regulations restraining the ultra–wealthy and the companies they control are abandoned, and Edwardian levels of inequality are almost fetishised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "731475ca-e56e-3bb8-8c8e-131954073a1f",
                                        "entry_id": "e83c83c3-2b59-35a5-8ee1-2b6b9365513b",
                                        "glosses": [
                                            "Abundant in quality or quantity; profuse."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wealthy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc502bfd-049a-3948-935a-2b8af4f13435",
                                        "entry_id": "e43ebb1d-de0d-3ee2-b794-0fe4ba20ed74",
                                        "glosses": [
                                            "Synonym of rich: the wealthy people of a society or of the world collectively."
                                        ],
                                        "tags": [
                                            "countable",
                                            "plural",
                                            "plural-only",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6674c80-7175-45d2-8785-ccab90c773d7",
                                                "sense_id": "bc502bfd-049a-3948-935a-2b8af4f13435",
                                                "text": "... whether consumption patterns of the wealthy are more or less polluting than those of the poor depends on the contaminant in question."
                                            },
                                            {
                                                "example_id": "83b43025-1594-457d-b26f-5e45a276a936",
                                                "sense_id": "bc502bfd-049a-3948-935a-2b8af4f13435",
                                                "text": "The wealthy pay most of the taxes but the uberwealthy hardly pay any at all: they hold stock and property and live off debt borrowed against that collateral."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f5e5986-25f3-320a-bca3-c4ef8516c9c7",
                                        "entry_id": "e43ebb1d-de0d-3ee2-b794-0fe4ba20ed74",
                                        "glosses": [
                                            "A rich person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28239d9c-a452-4a69-a933-f8a862cfd2e8",
                                                "sense_id": "5f5e5986-25f3-320a-bca3-c4ef8516c9c7",
                                                "text": "F. Scott Fitzgerald never got over Ginevra King's dad reminding him he wasn't a wealthy and needed to aim lower."
                                            },
                                            {
                                                "example_id": "fafeaf58-82b7-4f35-be7b-97cf3cecac99",
                                                "sense_id": "5f5e5986-25f3-320a-bca3-c4ef8516c9c7",
                                                "text": "it was possible for a group like the Libertarians to hope that a couple of weakminded wealthies might donate the seed money to get a campaign rolling."
                                            },
                                            {
                                                "example_id": "e34495f0-cd1e-426e-b0d3-272fc964da0f",
                                                "sense_id": "5f5e5986-25f3-320a-bca3-c4ef8516c9c7",
                                                "text": "Bernice is a nice, sardonic tale of envy and young wealthies of the pre-flapper era, when a girl who bobbed her hair was thought loose by the flask-bearing blades who tried to get her tight."
                                            },
                                            {
                                                "example_id": "c46c8552-c186-4510-bdfd-1622a2fecfea",
                                                "sense_id": "5f5e5986-25f3-320a-bca3-c4ef8516c9c7",
                                                "text": "Ending tax cuts to wealthies would only increase tax revenues by $40 - $60 billion a year - about 20% of current deficit - so it's a waste of time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
