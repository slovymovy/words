                {
                    "sense_id": "d3b8f47c-abf4-3c4c-88a5-432f75ff045f",
                    "sense_definition": "A small electronic device that produces light when electricity passes through it; initialism of light-emitting diode.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The green <w>LED</w> on the charger indicates that the battery is full.",
