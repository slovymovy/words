                "senses": [
                    {
                        "sense_id": "d7a3c1b6-207a-3310-9680-e3f6b67d98f5",
                        "entry_id": "bcfa5611-139b-37e1-a4a5-2a00617acf48",
                        "glosses": [
                            "Person, die den Mörtel anrührt"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "7ea3ca37-bcd5-4840-ba3b-a228209925be",
                                "sense_id": "d7a3c1b6-207a-3310-9680-e3f6b67d98f5",
                                "text": "„Bei den Maurern arbeiteten neben dem Meister Gesellen, Mörtelrührer, Zuträger und Tagwerker.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a935a72f-4b9a-3576-9cfe-d36a45417ee7",
                        "entry_id": "bcfa5611-139b-37e1-a4a5-2a00617acf48",
                        "glosses": [
                            "Aufsatzgerät für eine Bohrmaschine, mit dem Mörtel angerührt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "294c4b90-5fc1-471e-906e-08b693a09fe5",
                                "sense_id": "a935a72f-4b9a-3576-9cfe-d36a45417ee7",
                                "text": "„Für die Herstellung des Mörtels wurde Sand mit einer Korngröße von weniger als 1 mm, Zement und das Zugabewasser in den entsprechenden Verhältnissen abgewogen und mit einem herkömmlichen Mörtelrührer vermischt.“"
                            },
                            {
                                "example_id": "fbff9c08-1fa0-4620-817b-3588e1074e03",
                                "sense_id": "a935a72f-4b9a-3576-9cfe-d36a45417ee7",
                                "text": "„Haben Sie schon einmal Mörtel mit der Hand angeführt? Dann wissen Sie auch wie kräftezehrend diese Arbeit ist. […] Und wenn Sie einmal nicht nur einen Eimer voll Baumaterial benötigen, sondern ein ganzes Speisfass, dann wird es fast unmöglich, dem Mörtel in überschaubarer Zeit gründlich durchzumischen. Deshalb ist sowohl dem Profi als auch dem Hobbyheimwerker ein Mörtelrührer zu empfehlen.“"
                            },
                            {
                                "example_id": "f7b2ef2d-0b73-447e-bd1f-2eec49e340b3",
                                "sense_id": "a935a72f-4b9a-3576-9cfe-d36a45417ee7",
                                "text": "Dieser Mörtelrührer ist „ideal für plastische und zähe Materialien wie Fertigmörtel, Putz, Estrich und Epoxyhharzmassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
