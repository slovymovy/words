                        "examples": [
                            {
                                "example_id": "ac1bcca0-60d7-4b70-87f7-1558913d51cc",
                                "sense_id": "97dc9751-09a7-3e24-b76a-09061c523301",
                                "text": "„Die Fini liebt die Natur und hat das Haus mit ledrigen, immergrünen Efeublättern zuwachsen lassen und am Eingang eine Glyzinie geflanzt, deren lange blauviolette Blütentrauben bis zur Dachrinne reichen.“"
                            },
                            {
                                "example_id": "da80d6f0-4231-4c85-9f79-9e1fd084509e",
                                "sense_id": "97dc9751-09a7-3e24-b76a-09061c523301",
                                "text": "„Aber nach ein paar Tagen hängen die Efeublätter welk und traurig herab.“"
                            }
                        ],
