                "senses": [
                    {
                        "sense_id": "f4db4b37-1c3b-3acb-a3e1-12a944633f66",
                        "entry_id": "20388b4d-662f-3a25-b4f6-894832dcf4fd",
                        "glosses": [
                            "meist mit Tragegriffen versehener Karton zum Transportieren von Sachen bei einem Wohnsitzwechsel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07f8f707-8939-4ab5-a4f7-a1b857c3f69d",
                                "sense_id": "f4db4b37-1c3b-3acb-a3e1-12a944633f66",
                                "text": "Reichen Ihnen 150 Umzugskartons, oder sollen es lieber ein paar mehr sein?"
                            },
                            {
                                "example_id": "0307dde1-fc1b-4a88-b914-c92a033fefcd",
                                "sense_id": "f4db4b37-1c3b-3acb-a3e1-12a944633f66",
                                "text": "„Sein gesamter Besitz passt in einen Umzugskarton.“"
                            },
                            {
                                "example_id": "dee2d00c-9f91-49f6-b3c4-b137b5abf5ff",
                                "sense_id": "f4db4b37-1c3b-3acb-a3e1-12a944633f66",
                                "text": "„Unter der Dachschräge befand sich ein langer Schrank, und der alte Parkettboden war von Umzugskartons übersät.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
