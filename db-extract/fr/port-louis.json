                            {
                                "example_id": "5d8c78f3-1556-4aa5-ac12-feb58dd213cc",
                                "sense_id": "3432c576-76cd-3dc9-8d25-59e32038ad1d",
                                "text": "Pendant que la mer présentait cet aspect, le clocher de Port-Louis sonna un carillon lent et grave auquel répondit sur le même ton la tour de Notre-Dame de Larmor, cône de granit terne et rugueux, semblable à un gigantesque coquillage."
                            },
                            {
                                "example_id": "be4db829-3e14-47b5-8062-83afd3044531",
                                "sense_id": "3432c576-76cd-3dc9-8d25-59e32038ad1d",
                                "text": "La zone de contrôle temporaire (ZCT) inclut les communes de Gâvres, Lanester, Larmor-Plage, Locmiquélic, Lorient, Ploemeur, Port-Louis et Riantec."
                            }
                        ]
