                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "согласная буква",
                                "target_lang_sense_clarification": "графический символ"
                            },
                            {
                                "target_lang_word": "согласная",
                                "target_lang_sense_clarification": "общеупотребительное название буквы"
                            }
                        ]
                    }
                }
            ]
