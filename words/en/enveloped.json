{
    "word_family": [
        "envelop",
        "envelope",
        "envelopment"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "312db6ff-2152-3150-a1cd-86043aea9dee",
                    "sense_definition": "simple past and past participle of <w>envelop</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "envelop_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Thick fog <w>enveloped</w> the entire city during the early morning hours.",
                            "target_lang_translations": {
                                "nl": "Dichte mist <w>hulde</w> de hele stad in de vroege ochtenduren."
                            }
                        },
                        {
                            "text": "The mountain peaks were <w>enveloped</w> in dark, heavy clouds.",
                            "target_lang_translations": {
                                "nl": "De bergtoppen waren <w>omhuld</w> door donkere, zware wolken."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enveloped in fog",
                        "enveloped in darkness"
                    ],
                    "target_lang_definitions": {
                        "nl": "Geheel omhullen of bedekken, vaak gebruikt voor mist, duisternis of rook."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omhullen",
                                "target_lang_sense_clarification": "Iets volledig bedekken of inpakken."
                            },
                            {
                                "target_lang_word": "bedekken",
                                "target_lang_sense_clarification": "Iets toedekken of aan het zicht onttrekken."
                            },
                            {
                                "target_lang_word": "omsluiten",
                                "target_lang_sense_clarification": "Iets aan alle kanten omringen."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6372f27e-9328-35ee-9e25-fec70cfb2d0b",
                    "sense_definition": "simple past and past participle of <w>envelope</w>",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "envelope_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist <w>enveloped</w> the sculpture in protective plastic for transport.",
                            "target_lang_translations": {
                                "nl": "De kunstenaar <w>pakte</w> het beeldhouwwerk <w>in</w> in beschermend plastic voor het transport."
                            }
                        },
                        {
                            "text": "She <w>enveloped</w> the fragile gift in layers of soft tissue paper.",
                            "target_lang_translations": {
                                "nl": "Ze <w>wikkelde</w> het breekbare cadeau <w>in</w> lagen zacht vloeipapier."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Iets fysiek inpakken of verpakken in een beschermende laag."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "inpakken",
                                "target_lang_sense_clarification": "Iets in materiaal wikkelen voor bescherming."
                            },
                            {
                                "target_lang_word": "verpakken",
                                "target_lang_sense_clarification": "Iets in een verpakking doen."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "848fe68b-a453-33ed-a169-cfdefaac7392",
                    "sense_definition": "Entwined or wrapped around something",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "entwined_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient statue featured vines <w>enveloped</w> around the stone pillars.",
                            "target_lang_translations": {
                                "nl": "Het oude standbeeld was versierd met wijnranken die zich <w>om</w> de stenen pilaren <w>hadden gewonden</w>."
                            }
                        },
                        {
                            "text": "The snake remained <w>enveloped</w> tightly around the thick tree branch.",
                            "target_lang_translations": {
                                "nl": "De slang bleef strak <w>om</w> de dikke boomtak <w>gewikkeld</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "enwrapped"
                    ],
                    "target_lang_definitions": {
                        "nl": "Strak om iets heen gewikkeld of verstrengeld."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "omstrengeld",
                                "target_lang_sense_clarification": "Strak om iets heen gewikkeld."
                            },
                            {
                                "target_lang_word": "omwikkeld",
                                "target_lang_sense_clarification": "Met iets eromheen gewikkeld."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}