                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f28d1bc1-f606-43de-8920-b67376a31ac4",
                                "sense_id": "ff9fb76b-2321-3da0-886b-fb52c1101fae",
                                "text": "Then \"G. A. R.\" did shoulder his burden and with much labor made footprints for a hostelry afar off, where he might put it in for safe keeping, while the venders of papers and the ragged blackers of boots followed in his train and pelted him […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "1c6a430f-741e-3614-a09b-9b19857fef4c",
                        "entry_id": "c96e51bd-bbc6-39fd-bf81-e3d1274fc4d7",
                        "glosses": [
                            "Someone who creates black MIDI music."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "836406d4-3357-48aa-b15a-ceecf417c7a8",
                                "sense_id": "1c6a430f-741e-3614-a09b-9b19857fef4c",
                                "text": "Blackers across the globe, many of them teens and preteens, are embroiled in a ferocious game of one-upsmanship, battling to see how many notes they can cram into a single composition. First it was 100K, then 500K, then a million—now upwards of five million notes are common."
                            }
                        ]
