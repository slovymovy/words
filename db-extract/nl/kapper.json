                                        "entry_id": "9b20b458-5aa5-3b34-8e54-6ac4289f5f88",
                                        "glosses": [
                                            "Fachmann für die Pflege des Kopfhaares und der Gestaltung der Frisur, ein Handwerksberuf des Haarschneiders"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf68838-c8a8-45f2-959d-a12b9c6ad713",
                                                "sense_id": "08b2f8dc-74d8-36ec-a7f2-937dd0352674",
                                                "text": "Gehst du auch immer zum selben Friseur?"
                                            },
                                            {
                                                "example_id": "3d846465-74d8-4036-81d6-32a3fabc044f",
                                                "sense_id": "08b2f8dc-74d8-36ec-a7f2-937dd0352674",
                                                "text": "„Der Friseur nickte, wickelte einen Draht um die Autobatterie zu seinen Füßen, und die Schermaschine begann aufgeregt zu schnattern.“"
                                            },
                                            {
                                                "example_id": "d8f43b9a-ad3c-4db7-bd1e-186294f4e7b8",
                                                "sense_id": "08b2f8dc-74d8-36ec-a7f2-937dd0352674",
                                                "text": "„Ich bin der einzige Friseur auf diesem Jammerkasten.“"
                                            },
                                            {
                                                "example_id": "88dc1a22-0378-4ab8-92bd-71a86eeb07d9",
                                                "sense_id": "08b2f8dc-74d8-36ec-a7f2-937dd0352674",
                                                "text": "„Als der Friseur hereinkam, verließ sie mich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4dd499ed-7dd5-3083-94b3-2b376fc2ec54",
                                        "entry_id": "9b20b458-5aa5-3b34-8e54-6ac4289f5f88",
                                        "glosses": [
                                            "Kurzform des Ortes, wo [1] seinen Beruf ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf13e6f1-cac5-4cb1-8302-6ac56be8f1da",
                                                "sense_id": "4dd499ed-7dd5-3083-94b3-2b376fc2ec54",
                                                "text": "Der neue Italiener hat gleich neben dem Friseur aufgemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
