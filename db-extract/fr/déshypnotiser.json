                "senses": [
                    {
                        "sense_id": "119d256c-a0c2-3e7f-8513-166845bcffd8",
                        "entry_id": "3c9b4078-0c30-3940-aa3d-a96b9d8a7b6f",
                        "glosses": [
                            "Faire en sorte que quelqu’un ne soit plus hypnotisé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "254db9ab-a7bb-4f15-82c2-516a7cabdcb5",
                                "sense_id": "119d256c-a0c2-3e7f-8513-166845bcffd8",
                                "text": "Induire l’hypnose ce serait, d’une manière qui n’est qu’apparemment paradoxale, aider la personne à s’arracher de son hypnose ordinaire, autohypnose négative ou simplement commune, l’aider à s’en déshypnotiser, pour au moins l’aider à se trouver une hypnose ordinaire plus satisfaisante."
                            },
                            {
                                "example_id": "f1d54e27-2606-462b-9b3a-76b0771b3287",
                                "sense_id": "119d256c-a0c2-3e7f-8513-166845bcffd8",
                                "text": "Il va donc falloir les « déshypnotiser » pour arriver à les convaincre."
                            }
                        ]
                    }
                ],
