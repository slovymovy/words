                                "target_senses": [
                                    {
                                        "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                        "entry_id": "bcd10c1b-511e-3d3a-968f-12fb6ab8ce0d",
                                        "glosses": [
                                            "The killing of a considerable number (usually limited to people) where little or no resistance can be made, with indiscriminate violence, without necessity, and/or contrary to civilized norms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ccc0302-f890-4dfc-87a0-2d920ba48493",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "St. Bartholomew's Day Massacre"
                                            },
                                            {
                                                "example_id": "6e7d3447-47a7-4984-8643-fd9329119e3a",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "St. Valentine's Day Massacre"
                                            },
                                            {
                                                "example_id": "71ee4e18-735d-40bc-bcfe-72d783232b73",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "Amritsar Massacre"
                                            },
                                            {
                                                "example_id": "15ce3c70-8431-49a2-9a27-aaf6ba2ef944",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "I'll find a day to massacre them all,\nAnd raze their faction and their family"
                                            },
                                            {
                                                "example_id": "cc6e15df-460e-4655-a46c-ae6803f0037c",
                                                "sense_id": "3f33bbbb-c357-3a07-b63e-7e8f1bb6c52a",
                                                "text": "The massacre that ripped apart 17 families in Parkland, Florida, five years ago on Valentine’s Day ignited a wave of student-led protests and bipartisan legislation to combat the plague of school shootings devastating the country."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b10d5bfc-a5ec-3631-bdcf-6291533596c4",
                                        "entry_id": "bcd10c1b-511e-3d3a-968f-12fb6ab8ce0d",
                                        "glosses": [
                                            "Murder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84c07aa6-1071-40ac-92ea-b5aca4aeac6c",
                                                "sense_id": "b10d5bfc-a5ec-3631-bdcf-6291533596c4",
                                                "text": "The tyrannous and bloody act is done,—\nThe most arch deed of piteous massacre\nThat ever yet this land was guilty of."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "163146b2-e9af-337b-a97e-7f6e41d55760",
                                        "entry_id": "bcd10c1b-511e-3d3a-968f-12fb6ab8ce0d",
                                        "glosses": [
                                            "Any overwhelming defeat, as in a game or sport."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "massacre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7403207-878c-3900-b3a9-a89c2de0f426",
                                        "entry_id": "c12b895f-1278-318e-8113-570be31a33fe",
                                        "glosses": [
                                            "To kill in considerable numbers where little or no resistance can be made, with indiscriminate violence, without necessity, and contrary to civilized norms. (Often limited to the killing of human beings.)"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f4ea70f-c66a-4639-8153-06dfecddf38a",
                                                "sense_id": "f7403207-878c-3900-b3a9-a89c2de0f426",
                                                "text": "If James should be pleased to massacre them all, as Maximilian had massacred the Theban legion"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4d4226c-1590-39bb-be7a-17965bb15649",
                                        "entry_id": "c12b895f-1278-318e-8113-570be31a33fe",
                                        "glosses": [
                                            "To win against (an opponent) very decisively."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9bd3a4ae-aad3-3f6a-93f7-a7326821cd56",
                                        "entry_id": "c12b895f-1278-318e-8113-570be31a33fe",
                                        "glosses": [
                                            "To perform (a work, such as a musical piece or a play) very poorly."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "078c0b72-293f-3282-a829-afb2ccff4450",
                                        "entry_id": "c12b895f-1278-318e-8113-570be31a33fe",
                                        "glosses": [
                                            "To kill with great force or brutality."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7324276-e9ca-4aba-9999-f6842ef3c757",
                                                "sense_id": "078c0b72-293f-3282-a829-afb2ccff4450",
                                                "text": "Look how they massacred my boy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
