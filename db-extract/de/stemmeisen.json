                ],
                "senses": [
                    {
                        "sense_id": "7cdad25c-14dd-3aca-bd9a-8f4f1fb952c0",
                        "entry_id": "4f06ad2b-90ac-3208-90c6-70a572b0b4e0",
                        "glosses": [
                            "zum Trennen oder Abbrechen von Werkstoff"
                        ],
                        "tags": [
                            "Handwerkszeug"
                        ],
                        "examples": [
                            {
                                "example_id": "57edf50e-7b72-4a03-9810-e6a4aaabd844",
                                "sense_id": "7cdad25c-14dd-3aca-bd9a-8f4f1fb952c0",
                                "text": "Mit einem Stemmeisen kann man gut arbeiten, wenn es scharf ist."
                            },
                            {
                                "example_id": "4c6feb7e-0497-4bc6-99d9-539cb773b1ef",
                                "sense_id": "7cdad25c-14dd-3aca-bd9a-8f4f1fb952c0",
                                "text": "„Er ließ das Stemmeisen nicht los, ich ließ die Hand nicht sinken.“"
                            },
                            {
                                "example_id": "23e05dcb-ff1c-4ad8-b96c-76b9f54a49c9",
                                "sense_id": "7cdad25c-14dd-3aca-bd9a-8f4f1fb952c0",
                                "text": "„Dann hämmerte er mit dem Stemmeisen dagegen.“"
                            },
                            {
                                "example_id": "368daced-e77a-4db1-b63e-8ab8380a46dd",
                                "sense_id": "7cdad25c-14dd-3aca-bd9a-8f4f1fb952c0",
                                "text": "„Der Zaun ist im Nu überstiegen, unter dem Hebeldruck des Stemmeisens springt die morsche Tür auf, die Hühner halten verschlafen still, rasch stopfe ich drei stattliche Exemplare in meinen Sack und verschwinde.“"
                            },
                            {
                                "example_id": "9ad40528-0f97-4fd6-a9b4-e991c7796e22",
                                "sense_id": "7cdad25c-14dd-3aca-bd9a-8f4f1fb952c0",
                                "text": "„Er schob die Feile in die Ritze und erweiterte sie zu einer Rinne von zwei Zoll Länge und feilte so lange, als die Rinne breit genug geworden war, um das Stemmeisen hineinzuschieben und anzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f03f13e-b03d-4139-a2bc-dc704ef10875",
                        "source_entry_id": "4f06ad2b-90ac-3208-90c6-70a572b0b4e0",
