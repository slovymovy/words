                                                "sense_id": "8e2126db-e6ea-392f-9cd6-fca81deaed01",
                                                "text": "Bei einfachen Glaubensfragen hilft oft ein Blick in den Katechismus."
                                            },
                                            {
                                                "example_id": "ae4088b9-1ae6-4b6c-b343-1ca0e4bb2a56",
                                                "sense_id": "8e2126db-e6ea-392f-9cd6-fca81deaed01",
                                                "text": "Der Heidelberger Katechismus (HK) ist der weltweit unter Protestanten am weitesten verbreitete Katechismus. In 40 Sprachen ist er übersetzt."
                                            },
                                            {
                                                "example_id": "f576203e-687c-474f-9416-1ff1f15d1ea9",
                                                "sense_id": "8e2126db-e6ea-392f-9cd6-fca81deaed01",
                                                "text": "„Zwar ging er jeden Sonntag in die Kirche und einmal im Jahr zur Kommunion, aber nach dem Katechismus reicht das nicht.“"
                                            },
                                            {
                                                "example_id": "ccd7d0ce-960f-4c42-a016-d0a48bbc2bef",
                                                "sense_id": "8e2126db-e6ea-392f-9cd6-fca81deaed01",
                                                "text": "„Es war ein Katechismus aus dem Religionsunterricht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
