                            {
                                "example_id": "2ab3a692-fe92-4a1b-9e89-804839b940fc",
                                "sense_id": "0072ed62-a340-3a4d-8f4d-6064883e431c",
                                "text": "All during the night the riding ponies had grazed in close proximity to the house, had stamped about it, and occasionally had put their noses to its cracks, sniffingly to satisfy either curiosity or a desire for human companionship."
                            }
                        ]
                    },
                    {
