                    "semantic_group_id": "legendary_person",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "According to ancient tradition, <w>Haig</w> led his people to freedom.",
                            "target_lang_translations": {
