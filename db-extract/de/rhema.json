                    {
                        "translation_id": "6904dd4f-f8b1-446c-b013-f80032e25b55",
                        "source_entry_id": "af991f19-d574-31d5-b254-2e8124b56628",
                        "source_sense_id": "0e97653e-1399-332b-8261-4c4c076e01bf",
                        "target_lang_word": "rhème",
                        "target_lang_code": "fr",
