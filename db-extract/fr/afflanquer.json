                "senses": [
                    {
                        "sense_id": "b4fa269f-527f-36e4-b125-141858284b9b",
                        "entry_id": "0147b4bf-9143-3e69-bd13-e0c4a010b27a",
                        "glosses": [
                            "Ranger le flanc d’un bateau parallèle au quai."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "675b3035-62c3-4413-9c9a-07d6400ef2f2",
                                "sense_id": "b4fa269f-527f-36e4-b125-141858284b9b",
                                "text": "[…] et cette bande de poissons dorés que le navire, sur le point d’afflanquer le quai, fit gicler et voler hors de l’eau ; et ce peuple de Mille et une Nuits qui s’empressait et se bousculait pour s’emparer de nos valises."
                            },
                            {
                                "example_id": "23dadc69-c95d-435a-b831-444139aa89d9",
                                "sense_id": "b4fa269f-527f-36e4-b125-141858284b9b",
                                "text": "Un autre corps à été découvert au large de la plage des Sables blancs ... Il est dans le bateau qui vient juste d’afflanquer !"
                            }
                        ]
                    }
                ],
