                                "example_id": "91b618dd-ca6e-417d-afc6-014bf69bcb08",
                                "sense_id": "32f0e51f-f61e-35a6-961f-d8fb6e173e42",
                                "text": "„Nach acht Kilometer gehen, laufen und sogar einem kleinen Sprint, zehn Mal der Kapitulation nahe, endlose Qualen im Körper, stechendes Schädelweh, setzte ich mich auf einer Bank nieder und keuchte durch.“"
                            },
                            {
                                "example_id": "d4462d67-87aa-40f3-ba2e-45104cebdeae",
                                "sense_id": "32f0e51f-f61e-35a6-961f-d8fb6e173e42",
                                "text": "„Die harten Schläge auf den Hinterkopf haben vermutlich auch zu meinem Schädelweh beigetragen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
