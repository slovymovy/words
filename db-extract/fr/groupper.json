                "senses": [
                    {
                        "sense_id": "0d91a934-bfaf-3828-8c45-1b9c3b5d46a6",
                        "entry_id": "9a48f17f-be71-3377-9e03-31a8aca519ad",
                        "glosses": [
                            "Orthographe désuète de grouper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44eb903f-b491-4232-ae57-1ab888850eec",
                                "sense_id": "0d91a934-bfaf-3828-8c45-1b9c3b5d46a6",
                                "text": "Groupper plusieurs objets, c'est les disposer de maniére qu'ils fassent un Grouppe."
                            },
                            {
                                "example_id": "a7a54b17-13f1-428e-bdea-fc501126ceb9",
                                "sense_id": "0d91a934-bfaf-3828-8c45-1b9c3b5d46a6",
                                "text": "Il met en garde les artistes contre une dangereuse prédilection pour les «grouppes» - contre «la fureur de groupper» - qui, si elle n'est pas freinée, risque de gâter l'œuvre au point d'en faire une composition théâtrale et décadente."
                            }
                        ]
                    }
