{
    "word_family": [
        "enter",
        "entry",
        "entrant",
        "entrancement",
        "entrancing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e06c94dd-0dae-3e14-92fe-6d6d89245e3d",
                    "sense_definition": "The physical place where one enters, such as a door, gate, or opening.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_entry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please wait for me at the main <w>entrance</w> of the building.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, подожди меня у главного <w>входа</w> в здание."
                            }
                        },
                        {
                            "text": "The <w>entrance</w> gate was locked when we arrived at the park.",
                            "target_lang_translations": {
                                "ru": "Въездные <w>ворота</w> были заперты, когда мы приехали в парк."
                            }
                        }
                    ],
                    "synonyms": [
                        "entryway"
                    ],
                    "antonyms": [
                        "exit"
                    ],
                    "common_phrases": [
                        "main entrance",
                        "entrance gate",
                        "front entrance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическое место, через которое входят, например, дверь, ворота или проем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вход",
                                "target_lang_sense_clarification": "общее обозначение места для входа"
                            },
                            {
                                "target_lang_word": "подъезд",
                                "target_lang_sense_clarification": "вход в жилое здание"
                            },
                            {
                                "target_lang_word": "въезд",
                                "target_lang_sense_clarification": "место для въезда транспорта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1a34772-04a8-34e4-84ed-00e8e03e8cc7",
                    "sense_definition": "The act or action of coming or going into a place.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "act_of_entering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The actor made a grand <w>entrance</w> onto the stage.",
                            "target_lang_translations": {
                                "ru": "Актер совершил эффектное <w>появление</w> на сцене."
                            }
                        },
                        {
                            "text": "Her sudden <w>entrance</w> into the room surprised everyone.",
                            "target_lang_translations": {
                                "ru": "Ее внезапный <w>вход</w> в комнату удивил всех."
                            }
                        }
                    ],
                    "common_phrases": [
                        "make an entrance",
                        "grand entrance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие или процесс вхождения в какое-либо место."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вход",
                                "target_lang_sense_clarification": "само действие вхождения"
                            },
                            {
                                "target_lang_word": "появление",
                                "target_lang_sense_clarification": "выход на сцену или появление в комнате"
                            },
                            {
                                "target_lang_word": "вхождение",
                                "target_lang_sense_clarification": "процесс вхождения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e052ccb3-cf8e-34fe-a39e-4b337dc49b43",
                    "sense_definition": "The right, permission, or opportunity to enter a place or join an organization.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "permission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must show your ticket to gain <w>entrance</w> to the concert hall.",
                            "target_lang_translations": {
                                "ru": "Вы должны показать билет, чтобы получить <w>право входа</w> в концертный зал."
                            }
                        },
                        {
                            "text": "The university has very strict requirements for <w>entrance</w> into the medical program.",
                            "target_lang_translations": {
                                "ru": "В университете очень строгие требования для <w>поступления</w> на медицинский факультет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gain entrance",
                        "entrance requirements",
                        "entrance exam"
                    ],
                    "target_lang_definitions": {
                        "ru": "Право, разрешение или возможность войти в место или вступить в организацию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вход",
                                "target_lang_sense_clarification": "право на посещение мероприятия"
                            },
                            {
                                "target_lang_word": "доступ",
                                "target_lang_sense_clarification": "возможность или разрешение войти"
                            },
                            {
                                "target_lang_word": "поступление",
                                "target_lang_sense_clarification": "зачисление в учебное заведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd95538e-8305-324a-a1d1-8bf11952cba1",
                    "sense_definition": "The point at which a musician or performer begins to play or sing in a piece of music.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conductor signaled the flute player for her next <w>entrance</w>.",
                            "target_lang_translations": {
                                "ru": "Дирижер подал знак флейтистке для ее следующего <w>вступления</w>."
                            }
                        },
                        {
                            "text": "He missed his <w>entrance</w> because he was not paying attention to the score.",
                            "target_lang_translations": {
                                "ru": "Он пропустил свое <w>вступление</w>, потому что не следил за партитурой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "miss an entrance"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Момент, когда музыкант или исполнитель начинает играть или петь в музыкальном произведении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вступление",
                                "target_lang_sense_clarification": "начало исполнения своей партии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d2fd801-5218-33dd-ac88-9022c74739c0",
                    "sense_definition": "The beginning or commencement of a process, career, or period of time.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beginning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young lawyer found his <w>entrance</w> into the legal profession quite challenging.",
                            "target_lang_translations": {
                                "ru": "Молодой юрист нашел свое <w>вхождение</w> в юридическую профессию довольно сложным."
                            }
                        },
                        {
                            "text": "The book describes the <w>entrance</w> of a new era in technology.",
                            "target_lang_translations": {
                                "ru": "В книге описывается <w>начало</w> новой эры в технологиях."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Начало процесса, карьеры или периода времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вступление",
                                "target_lang_sense_clarification": "начало деятельности или этапа"
                            },
                            {
                                "target_lang_word": "начало",
                                "target_lang_sense_clarification": "первая стадия процесса"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a1b868a-9760-3973-b2cb-b6ba11c30e08",
                    "sense_definition": "The formal act of taking possession of property or assuming a public office.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document confirmed the <w>entrance</w> of the heir upon his father's estate.",
                            "target_lang_translations": {
                                "ru": "Документ подтвердил <w>вступление</w> наследника во владение имуществом отца."
                            }
                        },
                        {
                            "text": "The magistrate's <w>entrance</w> into office was marked by a small ceremony.",
                            "target_lang_translations": {
                                "ru": "<w>Вступление</w> магистрата в должность было отмечено небольшой церемонией."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный акт вступления во владение собственностью или в государственную должность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вступление",
                                "target_lang_sense_clarification": "официальное принятие полномочий или прав"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55ce38d7-8f02-39b3-98df-26005c264b18",
                    "sense_definition": "The angle or part of a ship's bow that cuts through the water.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A ship with a fine <w>entrance</w> moves more efficiently through the waves.",
                            "target_lang_translations": {
                                "ru": "Судно с острым <w>носом</w> эффективнее движется сквозь волны."
                            }
                        },
                        {
                            "text": "The engineer measured the <w>entrance</w> angle at the load-water line.",
                            "target_lang_translations": {
                                "ru": "Инженер измерил <w>угол заострения</w> по грузовой ватерлинии."
                            }
                        }
                    ],
                    "common_phrases": [
                        "entrance angle"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical terminology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Угол или часть носа корабля, которая разрезает воду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вход",
                                "target_lang_sense_clarification": "носовая часть ватерлинии"
                            },
                            {
                                "target_lang_word": "заострение носа",
                                "target_lang_sense_clarification": "технический термин в судостроении"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f039749-b388-3424-95ec-522dd106eb79",
                    "sense_definition": "To fill someone with delight, wonder, or enchantment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "enchantment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The beautiful music seemed to <w>entrance</w> the entire audience.",
                            "target_lang_translations": {
                                "ru": "Прекрасная музыка, казалось, <w>очаровала</w> всех слушателей."
                            }
                        },
                        {
                            "text": "The children were <w>entranced</w> by the colorful display of fireworks.",
                            "target_lang_translations": {
                                "ru": "Дети были <w>заворожены</w> красочным фейерверком."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наполнять кого-либо восторгом, изумлением или очарованием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровывать",
                                "target_lang_sense_clarification": "приводить в восторг"
                            },
                            {
                                "target_lang_word": "восхищать",
                                "target_lang_sense_clarification": "вызывать сильное восхищение"
                            },
                            {
                                "target_lang_word": "завораживать",
                                "target_lang_sense_clarification": "пленять красотой или звуком"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "388ecc16-f6d8-38a7-b3e8-6d1cb1c14768",
                    "sense_definition": "To put someone into a trance-like state.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "enchantment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hypnotist attempted to <w>entrance</w> the volunteer on stage.",
                            "target_lang_translations": {
                                "ru": "Гипнотизер попытался <w>ввести в транс</w> добровольца на сцене."
                            }
                        },
                        {
                            "text": "The rhythmic chanting began to <w>entrance</w> the participants of the ritual.",
                            "target_lang_translations": {
                                "ru": "Ритмичные песнопения начали <w>вводить в транс</w> участников ритуала."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вводить кого-либо в состояние транса."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить в транс",
                                "target_lang_sense_clarification": "гипнотизировать"
                            },
                            {
                                "target_lang_word": "одурманивать",
                                "target_lang_sense_clarification": "лишать ясности сознания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}