    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ca4163c1-9de4-3f33-b8d4-7788acf856f9",
                    "sense_definition": "present participle and gerund of <w>toil</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmers spent hours <w>toiling</w> in the fields under the blazing sun.",
                            "target_lang_translations": {
                                "de": "Die Bauern verbrachten Stunden damit, unter der sengenden Sonne auf den Feldern zu <w>schuften</w>."
                            }
                        },
                        {
                            "text": "After years of <w>toiling</w> away in obscurity, she finally achieved literary success.",
                            "target_lang_translations": {
                                "de": "Nachdem sie sich jahrelang im Verborgenen <w>abgerackert</w> hatte, feierte sie schließlich literarische Erfolge."
                            }
                        }
                    ],
                    "synonyms": [
                        "laboring",
                        "working",
                        "drudging",
                        "striving"
                    ],
                    "antonyms": [
                        "resting",
                        "relaxing",
                        "idling"
                    ],
                    "common_phrases": [
                        "toiling away",
                        "toiling in the fields"
                    ],
                    "target_lang_definitions": {
                        "de": "Partizip Präsens und Gerundium von „toil“; schwer schuften, sich abrackern oder hart arbeiten."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "schuften",
                                "target_lang_sense_clarification": "körperlich oder geistig sehr hart arbeiten"
                            },
                            {
                                "target_lang_word": "sich abrackern",
                                "target_lang_sense_clarification": "sich mühsam anstrengen"
                            },
                            {
                                "target_lang_word": "hart arbeiten",
                                "target_lang_sense_clarification": "allgemeine harte Arbeit verrichten"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b595a342-c153-3c7a-a215-165e43565605",
                    "sense_definition": "Hard or exhausting physical work or effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He saw little reward for a lifetime of endless <w>toiling</w>.",
                            "target_lang_translations": {
                                "de": "Er sah wenig Lohn für ein Leben voller endloser <w>Plackerei</w>."
                            }
                        },
                        {
                            "text": "Can we perceive their achievements as the fruit of their own mortal <w>toilings</w>?",
                            "target_lang_translations": {
                                "de": "Können wir ihre Errungenschaften als die Frucht ihrer eigenen irdischen <w>Mühsal</w> betrachten?"
                            }
                        }
                    ],
                    "synonyms": [
                        "labor",
                        "toil",
                        "drudgery",
                        "exertion"
                    ],
                    "antonyms": [
                        "leisure",
                        "rest",
                        "idleness"
                    ],
                    "common_phrases": [
                        "endless toiling"
                    ],
                    "target_lang_definitions": {
                        "de": "Harte, anstrengende körperliche Arbeit oder Plackerei."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "die Plackerei",
                                "target_lang_sense_clarification": "anstrengende, mühsame Arbeit"
                            },
                            {
                                "target_lang_word": "die Schinderei",
                                "target_lang_sense_clarification": "quälend harte Arbeit"
                            },
                            {
                                "target_lang_word": "die Mühsal",
                                "target_lang_sense_clarification": "beschwerliche Anstrengung"
                            },
                            {
                                "target_lang_word": "das Schuften",
                                "target_lang_sense_clarification": "substantiviertes Verb für harte Arbeit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
