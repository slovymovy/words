                "senses": [
                    {
                        "sense_id": "68b75106-c670-39d6-8124-a5f8149cf178",
                        "entry_id": "8611a912-fffd-3b36-83fc-c1037756222b",
                        "glosses": [
                            "een vervelende journalist waar je last van hebt (omdat hij 'steekt' als een mug)"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "75705a6a-2dab-44d5-8729-1c26f9a2ca09",
                                "sense_id": "68b75106-c670-39d6-8124-a5f8149cf178",
                                "text": "De journalist voelde zich vereerd toen hij door de politicus een vervelende, brutale en irritante persmuskiet werd genoemd."
                            },
                            {
                                "example_id": "75d76cc2-7525-460f-abfa-06b79af77f37",
                                "sense_id": "68b75106-c670-39d6-8124-a5f8149cf178",
                                "text": "We hebben niet zo snel medelijden met miljonairskinderen. Maar wel als een meisje van zestien aan interviews wordt onderworpen met persmuskieten die vooral alles willen weten over haar ouders."
                            },
                            {
                                "example_id": "ef700e79-8f0d-4342-b7e1-68c7dfaf73e3",
                                "sense_id": "68b75106-c670-39d6-8124-a5f8149cf178",
                                "text": "In een statig pand, dat wordt geflankeerd door strafrechtadvocaten en de Protestant Truth Society, zaten Darryl Smith en Gavin Sherriff als laatste der Mohikanen tot afgelopen vrijdag stukjes te tikken voor de Schotse Sunday Post. Het duo heeft de laatste bezuinigingsronde niet overleefd en moet plaatsmaken voor de advertentieafdeling, zodat de drukke straat in het hart van Londen nu voor het eerst in ruim drie eeuwen is gevrijwaard van persmuskieten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "daeca5ec-40e0-4a5f-a6ab-f888a0cf48e9",
                        "source_entry_id": "8611a912-fffd-3b36-83fc-c1037756222b",
                        "source_sense_id": "68b75106-c670-39d6-8124-a5f8149cf178",
