                        ],
                        "examples": [
                            {
                                "example_id": "c910a1c7-ce79-4ccc-a4b3-dad06315e0e0",
                                "sense_id": "5edb61c2-a62f-3f0e-9384-d4d460a9c67f",
                                "text": "Lorsque vous arrivez aux Franco-Américains un habitant sur onze seulement est un voteur. Pourquoi? Parce qu'ils ne peuvent pas se qualifier comme voteurs."
                            }
                        ]
                    },
                    {
