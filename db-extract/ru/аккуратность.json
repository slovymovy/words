                    }
                ],
                "senses": [
                    {
                        "sense_id": "7ce508c4-8941-347f-9389-c1e5531159a2",
                        "entry_id": "ca733e97-f895-3219-8ecd-9f7c75460790",
                        "glosses": [
                            "свойство по значению прилагательного аккуратный; точность, упорядоченность и тщательность в исполнении чего-либо, движениях"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "93bd2172-dda2-3cc8-b6a2-a20cc8704b65",
                        "entry_id": "ca733e97-f895-3219-8ecd-9f7c75460790",
                        "glosses": [
                            "склонность к точности, порядку, опрятности и прилежанию"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a92078e-8a4a-4bd0-9069-5726c6f35e2a",
                                "sense_id": "93bd2172-dda2-3cc8-b6a2-a20cc8704b65",
                                "text": "Немецкая аккуратность."
                            },
                            {
                                "example_id": "5f7ecc72-6e72-4e67-adef-aa05b0f47a79",
                                "sense_id": "93bd2172-dda2-3cc8-b6a2-a20cc8704b65",
                                "text": "Умеренность и аккуратность (два таланта чиновника)."
                            },
                            {
                                "example_id": "aaabc577-1535-47a8-85cb-4114c5a03102",
                                "sense_id": "93bd2172-dda2-3cc8-b6a2-a20cc8704b65",
                                "text": "Больше всего его здесь удовлетворяла, как он выражался, аккуратность поэта, которую он видел в этих стихах…"
                            },
                            {
                                "example_id": "443b5f03-15bb-4afe-bce5-597b13a5f274",
                                "sense_id": "93bd2172-dda2-3cc8-b6a2-a20cc8704b65",
                                "text": "Порядок, аккуратность, правильность во всем — были его качествами, и он не выносил ни малейшего промаха в писании."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4ef9312-07c8-4054-9588-577e4d12b721",
                        "source_entry_id": "ca733e97-f895-3219-8ecd-9f7c75460790",
                        "target_lang_word": "accuracy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accuracy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                        "entry_id": "f4264e93-673a-3b4e-bb7b-d219aeb4967d",
                                        "glosses": [
                                            "The state of being accurate; being free from error; exactness; correctness"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61723ab6-6994-4fa0-ba85-6c926e519377",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "Its professed end [of logic], is to teach men to think, to judge, and to reason, with precision and accuracy."
                                            },
                                            {
                                                "example_id": "b5182719-27e8-46c5-8da7-022f608c285a",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "The efficiency of the instrument will also depend upon the accuracy with which the piston fits the bottom and sides of the barrel. When the piston is depressed to the bottom, it is considered in theory to be in absolute contact, so as to exclude every particle of air from the space between it and the bottom."
                                            },
                                            {
                                                "example_id": "cf9817f6-b9d1-48f0-a856-4115b42e1d16",
                                                "sense_id": "233385fe-1738-3de6-a05f-5acaa41db518",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b921362-6c4a-3de7-a632-fdfe2b4fdcd3",
                                        "entry_id": "f4264e93-673a-3b4e-bb7b-d219aeb4967d",
                                        "glosses": [
                                            "Exact conformity to truth, or to a rule or model; degree of conformity of a measure to a true or standard value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b336e89-43b9-46c0-a9a0-d5867d4adff8",
                                                "sense_id": "4b921362-6c4a-3de7-a632-fdfe2b4fdcd3",
                                                "text": "The jury doubted the accuracy of the witness' comments."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e16836fb-682a-48b8-8940-93a844707a3e",
                        "source_entry_id": "ca733e97-f895-3219-8ecd-9f7c75460790",
                        "target_lang_word": "exactness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exactness",
