        "fr-extract.jsonl": [
            {
                "entry_id": "8934d38d-08f0-3f9a-a204-e29825a8bed1",
                "word": "fouine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "acc2e820-9cdf-49d2-8d9e-4df3137a6a44",
                        "entry_id": "8934d38d-08f0-3f9a-a204-e29825a8bed1",
                        "tags": [
                            "plural"
                        ],
                        "form": "fouines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "06c66281-ebed-3974-bfef-50aecd7939a3",
                        "entry_id": "8934d38d-08f0-3f9a-a204-e29825a8bed1",
                        "glosses": [
                            "Espèce de mammifère carnassier, de la famille des mustélidés (cf. martre, furet, putois) au corps mince et au museau allongé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "336c9ae8-6c0f-4e58-b1d1-2c550cf48457",
                                "sense_id": "06c66281-ebed-3974-bfef-50aecd7939a3",
                                "text": "La fouine a la physionomie très fine, l’œil vif, le saut léger, les membres souples, le corps flexible, tous les mouvements très prestres."
                            },
                            {
                                "example_id": "f2143753-a0ff-49bd-880f-ab535fb4265f",
                                "sense_id": "06c66281-ebed-3974-bfef-50aecd7939a3",
                                "text": "La fouine saigne ses proies (volailles, petits rongeurs) et elle est chassée par l’homme pour sa fourrure assez appréciée."
                            },
                            {
                                "example_id": "62807596-dc7f-4a3a-a85e-e90567040c3f",
                                "sense_id": "06c66281-ebed-3974-bfef-50aecd7939a3",
                                "text": "Maigre, la gorge plate, les épaules pointues, le visage en museau de fouine, singulièrement fouillé et accentué, elle n’avait pas d’âge ; on lui eût donné quinze ans ou trente ans, bien qu’elle en eût en réalité dix-neuf, quatre de moins que son mari."
                            }
                        ]
                    },
                    {
                        "sense_id": "81c3dc06-afc2-3ee2-ab08-a5e1413fb6d5",
                        "entry_id": "8934d38d-08f0-3f9a-a204-e29825a8bed1",
                        "glosses": [
                            "Par rapprochement avec le comportement associé à l’animal, homme rusé, indiscret, malin, qui se mêle de ce qui ne le regarde pas et en profite."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "e5e98f8d-52db-4c4a-b655-c4a9a8e6352b",
                                "sense_id": "81c3dc06-afc2-3ee2-ab08-a5e1413fb6d5",
                                "text": "Les agents des compagnies fiscales corrompaient les gouverneurs, pour piller les provinces. Celui-là flairait partout, avec sa mâchoire de fouine et ses paupières clignotantes."
                            }
                        ]
                    },
                    {
                        "sense_id": "03150ea1-e46e-30b4-bc44-7b6c695af7d0",
                        "entry_id": "8934d38d-08f0-3f9a-a204-e29825a8bed1",
                        "glosses": [
                            "Boute-hache."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
