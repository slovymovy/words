                        "examples": [
                            {
                                "example_id": "fa4c22f7-858c-4dc6-bc61-6e017a544523",
                                "sense_id": "a7fbc2d8-0cd3-3ac7-a99b-b1510778c8c1",
                                "text": "Certes, une Parisienne enveloppée d’un Zaïmph tigré, une Sylphide coiffée d’une large toque en soie, de la teinte de ses bas translucides, ne pouvait passer inaperçue."
                            },
                            {
                                "example_id": "43971af3-c3c8-4c0a-a98b-d86a32ff5e7a",
                                "sense_id": "a7fbc2d8-0cd3-3ac7-a99b-b1510778c8c1",
                                "text": "Et tu iras, levant encor bien plus de dupes\nVers le Zaïmph de la Joconde, vers la Jupe !"
                            }
                        ]
                    }
                ],
