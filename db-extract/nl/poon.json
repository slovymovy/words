                                        "glosses": [
                                            "Rouget, poisson de la famille des Triglidae."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99366bb7-f061-422f-ac66-84bfd4796b9a",
                                                "sense_id": "fac1c612-5673-3731-a0f0-5f9d647c098f",
                                                "text": "Assis sur un rocher, il trempe patiemment un fil dans le remous des vagues pour tenter de capturer des trigles."
