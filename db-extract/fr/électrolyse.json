        "fr-extract.jsonl": [
            {
                "entry_id": "9d776e41-d3ae-3e72-8003-f97da798b358",
                "word": "électrolyse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0995e6ab-97d2-410c-a343-547c8dc3ddc1",
                        "entry_id": "9d776e41-d3ae-3e72-8003-f97da798b358",
                        "tags": [
                            "plural"
                        ],
                        "form": "électrolyses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2091253-d741-377b-a6cc-b658bde7beeb",
                        "entry_id": "9d776e41-d3ae-3e72-8003-f97da798b358",
                        "glosses": [
                            "Phénomène de décomposition chimique accompagnant le passage du courant électrique dans un liquide."
                        ],
                        "tags": [
                            "Électrochimie"
                        ],
                        "examples": [
                            {
                                "example_id": "fad9b07b-5d60-4d2f-bc46-fd5f63c514da",
                                "sense_id": "a2091253-d741-377b-a6cc-b658bde7beeb",
                                "text": "A cet effet, nous avons commencé par augmenter dans l’anolyte la concentration de l’acide persulfurique, puis nous avons procédé à l’électrolyse proprement dite, mais les rendements enregistrés n’ont pas été sensiblement différent."
                            },
                            {
                                "example_id": "4ed559b9-5cf0-4120-8108-eca8e7e82b6f",
                                "sense_id": "a2091253-d741-377b-a6cc-b658bde7beeb",
                                "text": "L’atout-clé du programme auxerrois de 8,5 millions d’euros, c’est que l’hydrogène sera produit par électrolyse (on le sépare de la molécule d’eau), à l’aide d’énergies renouvelables locales : éoliennes et barrages dans le Morvan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aa87549c-2fac-4ee6-947d-4994b143b2dc",
                        "source_entry_id": "9d776e41-d3ae-3e72-8003-f97da798b358",
                        "source_sense_id": "a2091253-d741-377b-a6cc-b658bde7beeb",
                        "target_lang_word": "Elektrolyse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elektrolyse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "42345d23-f4f7-3359-adc6-24bc3b7e9b08",
                                        "entry_id": "6f2e98f2-ebc8-3926-89d7-36a7e4e40594",
                                        "glosses": [
                                            "chemischer Vorgang, bei dem durch einen elektrischen Stromkreis mit Plus- und Minuspol chemische Bindungen gespalten werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95e8759-559c-4eff-a777-99d9341b3211",
                                                "sense_id": "42345d23-f4f7-3359-adc6-24bc3b7e9b08",
                                                "text": "Eine Kochsalz-Lösung kann durch Elektrolyse in Natriumionen und Chlorionen gespalten werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
