                            {
                                "target_lang_word": "мастерский",
                                "target_lang_sense_clarification": "выполненный с высоким профессионализмом"
                            },
                            {
                                "target_lang_word": "хитроумный",
                                "target_lang_sense_clarification": "изобретательно и сложно устроенный"
                            }
