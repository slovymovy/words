                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb80ccbd-a6dc-3cd9-a8a1-e352ce0acf19",
                        "entry_id": "edf62e6a-1484-35a4-8322-7334028b20cd",
                        "glosses": [
                            "высокий пронзительный звук, производимый движением воздуха через сжатые губы или узкую щель свистка, дудочки и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82216a27-9f6b-4e8c-8e97-f9c54cd770ba",
                                "sense_id": "cb80ccbd-a6dc-3cd9-a8a1-e352ce0acf19",
                                "text": "Воздух был наполнен тысячью разных птичьих свистов."
                            }
                        ]
                    },
                    {
                        "sense_id": "15f0b3d9-c5f6-3222-bdcc-7c8d8c00081c",
                        "entry_id": "edf62e6a-1484-35a4-8322-7334028b20cd",
                        "glosses": [
                            "такие звуки как выражение осуждения кого-либо, чего-либо, презрения к кому-либо, чему-либо"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a67d3c79-d169-3682-868f-8b460d34241a",
                        "entry_id": "edf62e6a-1484-35a4-8322-7334028b20cd",
                        "glosses": [
                            "сленг враньё или похвальба"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58734bfa-5430-4f3e-b340-c810df7f8a9f",
                                "sense_id": "a67d3c79-d169-3682-868f-8b460d34241a",
                                "text": "Мы задолбались уже твой свист слушать. Говори по делу!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2b7966d-98ea-44ec-894e-ffc2d045ce06",
                        "source_entry_id": "edf62e6a-1484-35a4-8322-7334028b20cd",
                        "source_sense_description": "высокий пронзительный звук, производимый движением воздуха через сжатые губы или узкую щель",
                        "target_lang_word": "sifflement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sifflement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "de24944b-fd21-320c-9385-7146ced7a86e",
                                        "entry_id": "06ff30db-e42a-3a77-81db-6489b08c833b",
                                        "glosses": [
                                            "Bruit que l’on fait en sifflant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a2afdb-3bb9-463b-823f-966c1090846b",
                                                "sense_id": "de24944b-fd21-320c-9385-7146ced7a86e",
                                                "text": "Il détaillait ma beauté, un cri d'extase pour mes yeux, un béement prolongé pour mes mains, un sifflement coquin pour mes jambes, un silence bien préparé pour ma poitrine."
                                            },
                                            {
                                                "example_id": "fd9d9c85-faf2-482b-b9e8-9c3aafe3c1a2",
                                                "sense_id": "de24944b-fd21-320c-9385-7146ced7a86e",
                                                "text": "Il nous étourdit par ses sifflements continuels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d11dbd98-fd83-310b-bd04-f794cb8b89e8",
                                        "entry_id": "06ff30db-e42a-3a77-81db-6489b08c833b",
                                        "glosses": [
                                            "Bruit que quelques animaux font en sifflant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad503602-4c0f-4922-8316-d0681fa151d0",
                                                "sense_id": "d11dbd98-fd83-310b-bd04-f794cb8b89e8",
                                                "text": "Le sifflement des serpents. Le sifflement des oies, du merle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                        "entry_id": "06ff30db-e42a-3a77-81db-6489b08c833b",
                                        "glosses": [
                                            "Bruit aigu que font diverses choses, comme le vent, une flèche, une balle de fusil, une pierre lancée avec force, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9db3ac0-5a4b-4fb7-b9a9-0b642df43947",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Les éventails qui se ferment et s’épanouissent produisent un petit sifflement qui, répété plus de mille fois par minute, jette sa note à travers la confuse rumeur qui flotte sur la promenade, et a quelque chose d’étrange pour une oreille française."
                                            },
                                            {
                                                "example_id": "9baf5601-1a4b-4530-822c-e4edb599f233",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Des sifflements aigus, passant entre les jointures des portes et des fenêtres, s’élevaient parfois jusqu’à la limite des sons perceptibles. Puis, un grand silence se faisait."
                                            },
                                            {
                                                "example_id": "28030a64-3ce5-4a9c-91ba-5bdbe39e91a3",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Bitche n’est plus qu’une vaste fournaise : le sifflement des obus, les craquements de l’incendie, l’effondrement des maisons, […] toutes les terreurs, tous les fracas emplissent l’air."
                                            },
                                            {
                                                "example_id": "1834d499-9c12-418f-883d-c52f93780910",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Et puis le silence , ce grand silence qui plane au-dessus des solitudes islandaises , et que trouble seul le sifflement du vent ou le cri des pluviers dorés."
                                            },
                                            {
                                                "example_id": "f9df0b07-cd9c-4e11-804f-37c7558717fc",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "À chaque coup de roulis ou de tangage le hurlement continu du vent s’amplifiait d’un sifflement sinistre […]"
                                            },
                                            {
                                                "example_id": "bd2faf20-6af8-41ce-8087-5e21a666d4a7",
                                                "sense_id": "cf6db72c-54ca-396d-95a9-cdeb1c5cb557",
                                                "text": "Il est bien clair qu’à ce balcon, avec un pare-balles à droite, et sans m’occuper beaucoup des sifflements et claque­ments, je ne pensais qu’à bien faire mon métier de guetteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7b0b5b9-b424-359e-9232-91d6cf34dc37",
                                        "entry_id": "06ff30db-e42a-3a77-81db-6489b08c833b",
                                        "glosses": [
                                            "Certain bruit aigu que l’homme et quelques animaux font lorsqu’ils respirent avec peine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae3396d6-c0ff-4483-bf97-52379707d230",
                                                "sense_id": "d7b0b5b9-b424-359e-9232-91d6cf34dc37",
                                                "text": "Il procédait à de profondes aspirations puis rejetait l’air en produisant une espèce de sifflement particulier […] Ce sifflement est, je crois, particulier aux plongeurs tuamotus et je peux lui concevoir d’autre utilité que d’aider à régulariser la respiration."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b10f17c3-9959-418c-9251-b1195b00ab3a",
                        "source_entry_id": "edf62e6a-1484-35a4-8322-7334028b20cd",
                        "source_sense_description": "выражение осуждения",
                        "target_lang_word": "sifflet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sifflet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e96c2ad-36ee-394f-af6d-cdb05d871554",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Petit instrument à vent, constitué d’un tube court dont l’embouchure est souvent biseautée et qui produit un son aigu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "246c5be0-f7cc-4303-be20-7e013a880d33",
                                                "sense_id": "1e96c2ad-36ee-394f-af6d-cdb05d871554",
                                                "text": "Sifflet de bois, d’argent, etc."
                                            },
                                            {
                                                "example_id": "3f30d884-7685-46ca-8034-3d9e12c91392",
                                                "sense_id": "1e96c2ad-36ee-394f-af6d-cdb05d871554",
                                                "text": "Porter un sifflet dans sa poche."
                                            },
                                            {
                                                "example_id": "c36b13d6-6c16-4247-acd0-6d7e41d2c1ec",
                                                "sense_id": "1e96c2ad-36ee-394f-af6d-cdb05d871554",
                                                "text": "Là-dessus, le directeur introduisit un sifflet d’étain entre les poils de sa barbe et, gonflant ses joues, siffla."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "570e043e-e893-396b-8a3e-9eff268af136",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Son aigu que rend le sifflement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a530165-e655-4925-87ff-d53ff008163d",
                                                "sense_id": "570e043e-e893-396b-8a3e-9eff268af136",
                                                "text": "Maintenant, c'est le glissement du vol plané, avec les haubans qui bruissent d'un sifflet plus ou moins aigu, selon la vitesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52d42807-dea9-3784-b8ea-6e4a926b8cc4",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Improbation manifestée par des coups de sifflet ou par quelque autre marque de mépris, ou au contraire manifestation d’approbation pratiquée par le public américain."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be36c6b2-19c4-4044-959d-7ac8522d26c3",
                                                "sense_id": "52d42807-dea9-3784-b8ea-6e4a926b8cc4",
                                                "text": "Puis un frémissement courut. L'ex-Roi des Rois, une cape noire sur sa tunique blanche, gagnait la tribune. A peine allait-il parler qu'une bordée de sifflets et de cris l'accueillit."
                                            },
                                            {
                                                "example_id": "01e70b75-59c8-4fab-b403-7fbecfd8b6e3",
                                                "sense_id": "52d42807-dea9-3784-b8ea-6e4a926b8cc4",
                                                "text": "Des sifflets permanents quand la Roja jouait à la baballe, un emballement à l’approche des buts d’Unai Simon et deux kops qui se répondaient en s’applaudissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83b0c5f3-a58c-3b9b-9d06-fae83fa3d68d",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Évidement pratiqué dans la corne du sabot."
                                        ],
                                        "tags": [
                                            "Médecine vétérinaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a18f8cbc-0f51-4419-8e05-fa6be871ccc0",
                                                "sense_id": "83b0c5f3-a58c-3b9b-9d06-fae83fa3d68d",
                                                "text": "Appliquer une ferrure appropriée à deux pinçons qui, de chaque côté de la fissure, maintiendront la paroi, en évitant, au moyen d’un sifflet dans la corne, l’appui de la paroi sur le fer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc2f1ad5-268c-3526-9986-f239f422f545",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Rétrécissement."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a3b6b8-3458-4cc5-856d-390e6df67e2c",
                                                "sense_id": "dc2f1ad5-268c-3526-9986-f239f422f545",
                                                "text": "La tranche forme un parallélogramme à angles très aigus. Il serait difficile aux piqueurs de se glisser dans ce sifflet, pour en retirer le charbon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed6da63c-ea69-3398-a5b3-6b868fd7e3f3",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Cri de certains oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b44eb9bd-cd94-4548-8135-c18c698aff3e",
                                                "sense_id": "ed6da63c-ea69-3398-a5b3-6b868fd7e3f3",
                                                "text": "Je vous enseignerai à pêcher les écrevisses, à distinguer le sifflet du bouvreuil de celui du pinson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c693670b-812d-3ea6-a63f-94bfbb08a65b",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Gorge, gosier."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f0d3f02-f481-4faa-b245-9f2b654520e3",
                                                "sense_id": "c693670b-812d-3ea6-a63f-94bfbb08a65b",
                                                "text": "Et lorsqu’on lui eut apporté [à Gervaise] un verre de vitriol, et que sa mâchoire se contracta, à la première gorgée, le zingueur reprit … : Hein! ça te rabote le sifflet !"
                                            },
                                            {
                                                "example_id": "95dc1469-0e27-459b-aae0-9c47cf1f2662",
                                                "sense_id": "c693670b-812d-3ea6-a63f-94bfbb08a65b",
                                                "text": "(Sens figuré) Couper le sifflet à quelqu’un : faire taire ou égorger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd80145f-c05c-36aa-8489-f84143d1f65d",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Habit noir à queue, dont la forme évoque un sifflet."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5159900e-1aaa-4f5e-9723-c2e507dba60f",
                                                "sense_id": "bd80145f-c05c-36aa-8489-f84143d1f65d",
                                                "text": "Ce bel habit noir, vulgo sifflet, alias queue-de-pie, avec lequel vous portez, si divinement, le deuil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2f867e1-9e46-31f1-befb-0b022bd3e0f8",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Flûte de pan, pipeau."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e852717-36d9-4150-a2f6-fc0d5b7cbf59",
                                                "sense_id": "c2f867e1-9e46-31f1-befb-0b022bd3e0f8",
                                                "text": "Haydn, cherchant à amuser la société du prince, alla acheter … un plein panier de sifflets, de petits violons, de coucous, de trompettes de bois et de tous les instruments qui font le bonheur des enfants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33bf4335-bbd5-30b5-83ea-0c66fa9cf5b5",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Bruit que produit le vent qui siffle."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5013f8f6-0f43-4f3f-910b-c5fd2933d21f",
                                                "sense_id": "33bf4335-bbd5-30b5-83ea-0c66fa9cf5b5",
                                                "text": "Il ne peut pas dormir. Mais, là, il n’entend plus son cœur, il entend à peine le petit sifflet du vent qui se fend sur le coin de la grange, et le bruit de tous les amandiers du plateau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81734ec4-6a8e-340c-bdec-e6f3839b321a",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Pénis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4ae78fd-207b-3629-8aaf-b62d92705019",
                                        "entry_id": "06a9bbbb-0283-36a4-8391-a48385efce59",
                                        "glosses": [
                                            "Homme de haute taille."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
