                                        "entry_id": "144e4d9e-e483-3839-add4-acbda8cd0171",
                                        "glosses": [
                                            "Bestimmung im Vorwege; Festlegung zukünftiger Ereignisse"
                                        ],
                                        "tags": [
                                            "theologisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c7667f2-1d96-4d25-8294-c87b9e8e8595",
                                                "sense_id": "5797e94b-c82e-32bd-a225-4b3009dfb91d",
                                                "text": "Die Vorherbestimmung des menschlichen Schicksals ist ganz offenbar."
                                            },
                                            {
                                                "example_id": "e8147dd5-afd9-48eb-9b45-a73fe2aa5678",
                                                "sense_id": "5797e94b-c82e-32bd-a225-4b3009dfb91d",
                                                "text": "Sie beugten sich den göttlichen Vorherbestimmungen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
