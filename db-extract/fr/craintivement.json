        "fr-extract.jsonl": [
            {
                "entry_id": "56d79e6b-b4c1-3441-bfce-015f0ac17cb0",
                "word": "craintivement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "78230f34-b9c5-3594-97ad-ba4d0d55346b",
                        "entry_id": "56d79e6b-b4c1-3441-bfce-015f0ac17cb0",
                        "glosses": [
                            "D’une manière craintive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1d7273e-57d6-4adb-8b7c-4da67c48653e",
                                "sense_id": "78230f34-b9c5-3594-97ad-ba4d0d55346b",
                                "text": "La fillette baissa d'abord la tête puis la releva craintivement et nous regarda."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "67f07446-6332-4faa-9104-274faedadf60",
                        "source_entry_id": "56d79e6b-b4c1-3441-bfce-015f0ac17cb0",
                        "source_sense_id": "78230f34-b9c5-3594-97ad-ba4d0d55346b",
                        "target_lang_word": "anxiously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anxiously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8830ceb2-da90-3084-b8b4-1ec3067aeaf2",
                                        "entry_id": "28ca4ed7-32df-3288-99d3-c22b47ffc9bd",
                                        "glosses": [
                                            "In an anxious manner; with painful uncertainty; solicitously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb79ecab-813d-402f-8ada-f56489caec7d",
                                                "sense_id": "8830ceb2-da90-3084-b8b4-1ec3067aeaf2",
                                                "text": "'Even in summer, Grannie?' Heidi persisted anxiously."
                                            },
                                            {
                                                "example_id": "8fade652-2376-4dc6-977d-12203edf0e41",
                                                "sense_id": "8830ceb2-da90-3084-b8b4-1ec3067aeaf2",
                                                "text": "He tried to persuade Cicely to stay away from the ball-room for a fourth dance.[…]But she said she must go back, and when they joined the crowd again[…]she found her mother standing up before the seat on which she had sat all the evening searching anxiously for her with her eyes, and her father by her side."
                                            },
                                            {
                                                "example_id": "5ba59b51-68de-41d5-bd1e-ebb5910eab28",
                                                "sense_id": "8830ceb2-da90-3084-b8b4-1ec3067aeaf2",
                                                "text": "He anxiously awaited the arrival of his child."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b579878-280b-4ca4-a902-bc11e728ef41",
                        "source_entry_id": "56d79e6b-b4c1-3441-bfce-015f0ac17cb0",
                        "source_sense_id": "78230f34-b9c5-3594-97ad-ba4d0d55346b",
                        "target_lang_word": "faint-heartedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faint-heartedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8900839-2ee7-3b4e-803b-a6e3f6ee0df8",
                                        "entry_id": "ff38c097-2859-3485-b664-489583c8f0e6",
                                        "glosses": [
                                            "Alternative spelling of faintheartedly."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62448325-fff4-4a85-a3ec-d023b2003548",
                                                "sense_id": "f8900839-2ee7-3b4e-803b-a6e3f6ee0df8",
                                                "text": "Then once more the crew came on with swords and axes, but faint-heartedly, and the end of it was that they lost some more men dead and wounded and fell back again."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c6f09cb-c95c-436a-9e6d-0d9751e5e574",
                        "source_entry_id": "56d79e6b-b4c1-3441-bfce-015f0ac17cb0",
                        "source_sense_id": "78230f34-b9c5-3594-97ad-ba4d0d55346b",
                        "target_lang_word": "faintly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faintly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f72f26a1-52ae-3191-ab7e-91631f0ea52d",
                                        "entry_id": "eb00748e-a811-3f68-b8a8-461fcd73a691",
                                        "glosses": [
                                            "In a faint manner; very quietly or lightly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ed7c33e-3865-4c50-99d3-f6eaf0a908d9",
                                                "sense_id": "f72f26a1-52ae-3191-ab7e-91631f0ea52d",
                                                "text": "So this was my future home, I thought![…]Backed by towering hills, the but faintly discernible purple line of the French boundary off to the southwest, a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "7e6750b3-7329-480a-81cc-eeaf0b65ed20",
                                                "sense_id": "f72f26a1-52ae-3191-ab7e-91631f0ea52d",
                                                "text": "Faintlier, faintlier came the footfalls to his ear, until of all the faint sounds that came, by the abandoned air, to his ear, not one was a footfall, as far as he could judge."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "033db208-9dd2-49f4-b5be-e5385a24b1d6",
                        "source_entry_id": "56d79e6b-b4c1-3441-bfce-015f0ac17cb0",
                        "source_sense_id": "78230f34-b9c5-3594-97ad-ba4d0d55346b",
                        "target_lang_word": "fearfully",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fearfully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47e1660c-b716-3138-a96c-5110c6db3d21",
                                        "entry_id": "3807ddba-92c9-3882-acb3-869f828b84cd",
                                        "glosses": [
                                            "In a fearful manner; characterized by fear."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2863584-dfa8-40cb-b814-d7873fd08965",
                                                "sense_id": "47e1660c-b716-3138-a96c-5110c6db3d21",
                                                "text": "I stepped fearfully into the pitch-dark cave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                        "entry_id": "3807ddba-92c9-3882-acb3-869f828b84cd",
                                        "glosses": [
                                            "very; very much."
                                        ],
                                        "tags": [
                                            "UK",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c278a20e-37ba-4bfb-b1f9-82013bc8ab26",
                                                "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                                "text": "He's a fearfully good striker."
                                            },
                                            {
                                                "example_id": "424a3e69-00dc-40fb-bb36-916fc9a50475",
                                                "sense_id": "87054a54-e75b-32bd-a60f-59d3d712cf9e",
                                                "text": "Remember, when a horse is on its side the kicking-strap is useless, and the breechen nearly so, to prevent the swing of its hind legs; your aim is to get it away from the steps or wheel-plate of the trap, which, in its struggles, may cut its legs fearfully."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98a1ed38-9df2-4b94-ac2b-9e116851f3b5",
                        "source_entry_id": "56d79e6b-b4c1-3441-bfce-015f0ac17cb0",
