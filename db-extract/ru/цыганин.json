                                        "sense_id": "4dc87aef-7350-3ef3-bd8b-399eaaf08c60",
                                        "entry_id": "2b9f6504-cd90-3079-836f-a6e4e1c598f0",
                                        "glosses": [
                                            "Alternative form of Gypsy (“member of the Romani people”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25eaa3b1-bb21-45cf-bdd0-d82b824c0538",
                                                "sense_id": "4dc87aef-7350-3ef3-bd8b-399eaaf08c60",
                                                "text": "He championed the music of the gypsies as he did the Muslim and Jewish roots of Spanish culture. […] All these and more were fused in the forge of the gypsy experience into a singular art form, unlike any of its sources, evoking its own worldview, its own existential stance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4101d70a-80bf-3341-a4ba-a68a6e59ece7",
                                        "entry_id": "2b9f6504-cd90-3079-836f-a6e4e1c598f0",
                                        "glosses": [
                                            "An itinerant person or any person, not necessarily Romani; a tinker, a traveller or a carny."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "35939927-cb0e-49e2-a0d0-e6c0918001ed",
                                                "sense_id": "4101d70a-80bf-3341-a4ba-a68a6e59ece7",
                                                "text": "Like a right gypsy, hath, at fast and loose, Beguiled me to the very heart of loss."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4427a2d1-1bc9-3a2c-a42e-f111c99943a9",
                                        "entry_id": "2b9f6504-cd90-3079-836f-a6e4e1c598f0",
                                        "glosses": [
                                            "A move in contra dancing in which two dancers walk in a circle around each other while maintaining eye contact (but not touching as in a swing). (Compare whole gyp, half gyp, and gypsy meltdown, in which this step precedes a swing.)"
                                        ],
                                        "tags": [
                                            "offensive",
                                            "sometimes"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7ffbcd0-d567-3a98-a196-2933fd101c6f",
                                        "entry_id": "2b9f6504-cd90-3079-836f-a6e4e1c598f0",
                                        "glosses": [
                                            "A member of a Broadway musical chorus line."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f87b74c-4918-37a9-a1cc-47e3d3126755",
                                        "entry_id": "2b9f6504-cd90-3079-836f-a6e4e1c598f0",
                                        "glosses": [
                                            "A person with a dark complexion."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
