                        "source_sense_description": "a spirit of familiarity and closeness",
                        "target_lang_word": "camaraderie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camaraderie",
