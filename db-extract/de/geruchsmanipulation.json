                        "glosses": [
                            "unerwünschte oder verbotene geruchliche Veränderung von etwas; Sinnestäuschung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46905627-8121-43f3-b2b6-6b54bcaa9c58",
                                "sense_id": "f406ceba-4cdb-3971-95ba-d464c07bf1a7",
                                "text": "„Es zeigte sich, dass die Geruchsmanipulation einen marginal signifikanten Einfluss auf die Bewertung der FG hatte.“ „Ihr stinkt!\""
                            },
                            {
                                "example_id": "4f6b0ed8-e210-4b78-9c48-78f3b9beac4c",
                                "sense_id": "f406ceba-4cdb-3971-95ba-d464c07bf1a7",
                                "text": "„Oder Supermärkte: Die EU hat inzwischen Gesetze erlassen, dass dort keine Geruchsmanipulation mehr mit Ventilatoren betrieben werden darf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f61f5ce-e127-3a27-a904-af01bce89aba",
                        "entry_id": "a068f209-6799-35ad-a585-2c594fd5369a",
                        "glosses": [
                            "Beeinflussung von Entscheidungen durch Geruchsstoffe, ohne dass der Entscheidende sich dessen bewusst ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be4520a1-7f91-4294-8456-a73fb3bc9614",
                                "sense_id": "4f61f5ce-e127-3a27-a904-af01bce89aba",
                                "text": "„Subliminale Geruchsmanipulation scheint im Bereich des Möglichen zu liegen.“"
                            },
                            {
                                "example_id": "eb92735d-9d14-4d8e-b7e1-27c01a2cc18a",
                                "sense_id": "4f61f5ce-e127-3a27-a904-af01bce89aba",
                                "text": "„Durch Geruchsmanipulation kann man Menschen Dinge tun lassen, die diese unter anderen Umständen niemals tun würden oder zumindest nicht in dem Ausmaß.“"
                            }
                        ],
