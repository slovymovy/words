            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f788cff0-9288-3247-aaec-8919e43feee5",
                    "sense_definition": "Qui n'est pas constitué de matière ; qui est d'ordre spirituel ou incorporel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "non_materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'âme humaine et la pensée relèvent d'un monde purement <w>immatériel</w>."
                        },
                        {
                            "text": "Certains philosophes considèrent que la conscience est une entité entièrement <w>immatérielle</w>."
                        }
                    ],
                    "synonyms": [
                        "impalpable",
                        "incorporel"
                    ],
                    "antonyms": [
                        "corporel",
                        "matériel"
                    ],
                    "common_phrases": [
                        "monde immatériel",
                        "patrimoine immatériel"
                    ]
                },
                {
                    "sense_id": "b2718db9-04ab-3619-bbfe-4101c8a5b67d",
                    "sense_definition": "Dont la réalité n'a pas de consistance physique, notamment en économie ou en informatique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "non_materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise technologique investit massivement dans les biens <w>immatériels</w> pour développer ses brevets."
                        },
                        {
                            "text": "Dans l'économie moderne, la valeur d'une marque constitue un actif principalement <w>immatériel</w>."
                        }
                    ],
                    "synonyms": [
                        "intangible"
                    ],
                    "antonyms": [
                        "matériel",
                        "palpable",
                        "tangible"
                    ],
                    "common_phrases": [
                        "biens immatériels",
                        "investissement immatériel"
                    ]
                },
                {
                    "sense_id": "cd372e7c-b692-338c-96d2-0a1faf727dfd",
                    "sense_definition": "Qui semble ne pas être composé de matière tangible, d'une apparence vaporeuse ou diaphane.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "À l'aube, une brume <w>immatérielle</w> flottait au-dessus de la vallée endormie."
                        },
                        {
                            "text": "Ses vêtements flottaient autour d'elle avec une grâce légère et presque <w>immatérielle</w>."
                        }
                    ],
                    "synonyms": [
                        "impalpable"
                    ],
                    "antonyms": [
                        "matériel"
                    ]
                }
            ]
        }
