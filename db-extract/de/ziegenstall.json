                "senses": [
                    {
                        "sense_id": "969c3780-a6e1-3136-bfbe-691ddb95960e",
                        "entry_id": "f8bd709e-dd12-3fc7-99d8-5b0003149d12",
                        "glosses": [
                            "Gebäude einer Farm, eines landwirtschaftlichen Betriebs, das zur Unterbringung von Ziegen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33f2c697-8ae6-4398-abb7-ee2bd97e08a7",
                                "sense_id": "969c3780-a6e1-3136-bfbe-691ddb95960e",
                                "text": "„Tatsächlich, gegenüber vom Ziegenstall steht ein Gebäude, aus dem es nach Hopfen duftet.“"
                            },
                            {
                                "example_id": "abe8ccea-7cdd-4376-8cf1-2efc596eb87e",
                                "sense_id": "969c3780-a6e1-3136-bfbe-691ddb95960e",
                                "text": "„Alle heiligen Zeiten passieren vom Regen durchnässte Wanderer das Grundstück. Ihnen bietet sie einen Platz im Ziegenstall und macht in der Mitte ein Feuer.“"
                            },
                            {
                                "example_id": "3f53b8ad-10fb-42ea-8e87-ba145fe15c0e",
                                "sense_id": "969c3780-a6e1-3136-bfbe-691ddb95960e",
                                "text": "„Sie selbst hatte keine konkrete Person vor Augen, als sie sich des hinteren Raumes des Üblacker-Häusls, der früher einmal ein Ziegenstall war, annahm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
