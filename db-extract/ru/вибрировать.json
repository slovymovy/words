                                                "example_id": "e3106d29-1cbf-49e6-a029-d612357afe3d",
                                                "sense_id": "ec47410a-2ad6-3320-a0c6-84dff8428d90",
                                                "text": "to vibrate a sword or a staff"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4015768-2f04-3fad-ac96-1ec1a6205dc4",
                                        "entry_id": "3582c2c1-9659-377f-af87-a5bda7976274",
                                        "glosses": [
                                            "To mark or measure by moving to and fro."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cdcf097-ed7b-4408-88be-5dafe9633aca",
                                                "sense_id": "a4015768-2f04-3fad-ac96-1ec1a6205dc4",
                                                "text": "a pendulum vibrating seconds"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4f004ed-8614-3fdb-bbc8-3b26bfda1a68",
                                        "entry_id": "3582c2c1-9659-377f-af87-a5bda7976274",
                                        "glosses": [
                                            "To affect with vibratory motion; to set in vibration."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bc01b5e-2d8b-4924-ab6c-14d533c575ee",
                                                "sense_id": "e4f004ed-8614-3fdb-bbc8-3b26bfda1a68",
                                                "text": "Breath vocalized, i.e., vibrated or undulated, may […] impress a swift, tremulous motion."
                                            },
                                            {
                                                "example_id": "846460ff-e8b8-4c7b-ab8b-70287d502f25",
                                                "sense_id": "e4f004ed-8614-3fdb-bbc8-3b26bfda1a68",
                                                "text": "Star to star vibrates light: may soul to soul / Strike thro' a finer element of her own?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd34c202-d461-38a1-8e5f-dec36b8bfdd1",
                                        "entry_id": "3582c2c1-9659-377f-af87-a5bda7976274",
                                        "glosses": [
                                            "To please or impress someone."
                                        ],
                                        "tags": [
                                            "dated",
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4efd9979-edc2-4f22-a7a1-e2addb424be6",
                                                "sense_id": "cd34c202-d461-38a1-8e5f-dec36b8bfdd1",
                                                "text": "And if he wants to give you high praise, he'll answer, \"That vibrates me\"; \"That has a large charge\"; or \"That's oogley.\""
                                            },
                                            {
                                                "example_id": "ba3e1659-7129-46e7-8060-e131a40039c1",
                                                "sense_id": "cd34c202-d461-38a1-8e5f-dec36b8bfdd1",
                                                "text": "[…] standing side by side under a Grecian column, tapping their feet in unison and saying such things as \"Hot-diggety,” “Razz-ma-tazz,\" “That vibrates me,\" and other expressions of praise current in their youth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d24669a2-ed5d-3196-9f28-4a34701315da",
                                        "entry_id": "3582c2c1-9659-377f-af87-a5bda7976274",
                                        "glosses": [
                                            "To use vibrato."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e519bedd-e387-3fa1-b30f-5ef10e940628",
                                        "entry_id": "3582c2c1-9659-377f-af87-a5bda7976274",
                                        "glosses": [
                                            "To pleasure someone using a vibrator."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "caaef381-29ee-4222-bc92-b00c4fd316a2",
                                                "sense_id": "e519bedd-e387-3fa1-b30f-5ef10e940628",
                                                "text": "Downstairs in the living-room Jill\nWas vibrating herself for a thrill."
                                            }
                                        ]
                                    }
                                ]
