                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27febedd-0a0d-4670-8095-2280fe57e240",
                        "source_entry_id": "d4bae6f1-0640-3bab-b755-0222b0dc9d9e",
                        "source_sense_id": "b0862df1-08b6-3c25-8446-8f060d24f6ef",
                        "source_sense_description": "rebellion; revolt; the state of being insurgent",
                        "target_lang_word": "бунт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бунт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9a299554-6d2b-364c-a9a6-666c06546467",
                                        "entry_id": "6f824d6d-c503-3c5d-b1eb-9ca2b359a95c",
                                        "glosses": [
                                            "стихийное восстание, мятеж"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0db404dc-5415-4b4d-b078-be254cf608df",
                                                "sense_id": "9a299554-6d2b-364c-a9a6-666c06546467",
                                                "text": "Московское войско принуждено было укрощать вспыхнувший бунт."
                                            },
                                            {
                                                "example_id": "4f594ee9-0a20-40da-9389-a049fa73fe76",
                                                "sense_id": "9a299554-6d2b-364c-a9a6-666c06546467",
                                                "text": "Этих стариков и судили как за бунт и присудили — у озера, на том самом месте, где драка была, кнутьями бить."
                                            },
                                            {
                                                "example_id": "f9540fdf-f8b7-4f0d-93b3-28a36875823f",
                                                "sense_id": "9a299554-6d2b-364c-a9a6-666c06546467",
                                                "text": "Не в деньгах, мол, счастье, мужик, мол, тоже человек, дальше — больше, оскорбительные стишки, а там и бунт."
                                            },
                                            {
                                                "example_id": "811028eb-5ca7-4851-b909-7a3bf8f0b970",
                                                "sense_id": "9a299554-6d2b-364c-a9a6-666c06546467",
                                                "text": "— В пятом году был — бунт, — сказал Михайлов внушительно и слышно пошевелился — наверное, поднял палец."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25be30d2-8fc9-30d2-8c50-a073a073f71c",
                                        "entry_id": "6f824d6d-c503-3c5d-b1eb-9ca2b359a95c",
                                        "glosses": [
                                            "разг. проявление неповиновения, непокорности, несогласия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48238b12-7258-43f4-b552-9e355bbc39e2",
                                                "sense_id": "25be30d2-8fc9-30d2-8c50-a073a073f71c",
                                                "text": "Макар взял рассыльную книгу, надел шапку, но в казначейство не пошел, а спрятался под лестницей: он знал, что бунт будет."
                                            },
                                            {
                                                "example_id": "78bc4637-4e71-4446-8c58-2f1cef15d4e7",
                                                "sense_id": "25be30d2-8fc9-30d2-8c50-a073a073f71c",
                                                "text": "Бунт кончился; невежество было подавлено, и на место его водворено просвещение."
                                            },
                                            {
                                                "example_id": "5b8e957c-2ec5-42c1-8ff5-8e3a36d41e64",
                                                "sense_id": "25be30d2-8fc9-30d2-8c50-a073a073f71c",
                                                "text": "На судне бунт, над нами чайки реют, // Вчера из-за дублонов золотых // Двух негодяев вздернули на рею, // Но — мало. Нужно было четверых."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "бунт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad535c6-f05d-361c-9ed7-4053801f477d",
                                        "entry_id": "7cb3bd65-9ea1-3653-8b83-c9b98ccf1e43",
                                        "glosses": [
                                            "связка, пачка, кипа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f51dfbea-717e-46f4-8787-010e2087d726",
                                                "sense_id": "3ad535c6-f05d-361c-9ed7-4053801f477d",
                                                "text": "Пенька, табак в бунтах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4e220c14-0a3d-39cb-956c-e353a27d7285",
                                        "entry_id": "7cb3bd65-9ea1-3653-8b83-c9b98ccf1e43",
                                        "glosses": [
                                            "сложенный в штабели товар в мешках, уложенный в ряд"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7a2b795-1acb-4b96-9977-dcaf849570d0",
                                                "sense_id": "4e220c14-0a3d-39cb-956c-e353a27d7285",
                                                "text": "Позадь лавок по широким дворам едва можно пройти — бунты с мылом и свечами, укрытые от дождей плотными циновками, навалены там в громадном количестве."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3641f2bd-ad7a-3ab6-9308-d13d29f7bbcf",
                                        "entry_id": "7cb3bd65-9ea1-3653-8b83-c9b98ccf1e43",
                                        "glosses": [
                                            "то же, что бурт, куча картошки, укрытая землёй, соломой и т. п."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d061d0e0-b32e-4076-abcc-7b5dd796df11",
                        "source_entry_id": "d4bae6f1-0640-3bab-b755-0222b0dc9d9e",
                        "source_sense_id": "b0862df1-08b6-3c25-8446-8f060d24f6ef",
