                        "examples": [
                            {
                                "example_id": "9e200377-c8d4-408b-bb34-8e934ef60873",
                                "sense_id": "5af0a11f-77c7-35cc-98e2-7aa80fa54170",
                                "text": "De aanleiding voor de ruzie lag volgens de aangehouden verdachte is het ruziezoekende gedrag van de ander."
                            },
                            {
                                "example_id": "776377a3-cce2-4a94-9e75-f1bc36901caa",
                                "sense_id": "5af0a11f-77c7-35cc-98e2-7aa80fa54170",
                                "text": "Dacht je dat de koninklijke familie een happy family was? Welnee. Beatrix gruwt van jengelende kinderen, drammende schoondochters, ruziezoekende zonen en kruiperig personeel. Ze is eenzaam, voelt zich onbegrepen en probeert wankelend houvast te vinden in haar plicht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
