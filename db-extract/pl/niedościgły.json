                                        "glosses": [
                                            "Without equal; unmatched."
                                        ],
                                        "tags": [
                                            "UK",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c6a491a-10fe-4292-a9f4-214baff07556",
                                                "sense_id": "2b6597b7-817f-3598-b0e9-50c4c40f5534",
                                                "text": "Coastal defences were breached at many places from the Humber right round to the outskirts of London, and the inundation of low-lying lands caused damage on a scale unequalled within living memory."
