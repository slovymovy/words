                        "sense_id": "ba7494db-6a29-3cf1-8171-a3e6fc690897",
                        "entry_id": "bf02abac-adbd-3d72-959b-0fcea46ab060",
                        "glosses": [
                            "Rendu moins prononcé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d526e9ca-32e6-4906-9212-212d4f2c6965",
                                "sense_id": "ba7494db-6a29-3cf1-8171-a3e6fc690897",
                                "text": "Ce sentiment de culpabilité semble atténué, chez certaines, lorsque le deuxième avortement est un «véritable accident», c’est-à-dire lorsque la grossesse survient alors que la femme pense avoir pris les précautions nécessaires en amont pour l’éviter."
                            }
                        ]
                    },
                    {
                        "sense_id": "487ed1ec-9012-3de9-9f3d-bc2cd8e5bbd3",
                        "entry_id": "bf02abac-adbd-3d72-959b-0fcea46ab060",
                        "glosses": [
                            "Qualifie une plante qui diminue de la base vers son sommet, ou inversement."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ac1a5197-d7b4-3bd8-9da4-c4228078815b",
