                "senses": [
                    {
                        "sense_id": "124cdcf5-7f8f-3844-8338-7d7de2c6cf1c",
                        "entry_id": "1b9b4b16-729d-36af-ba3d-0a6a3fbf3596",
                        "glosses": [
                            "de plantengroei onder de bomen van een bos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6fd7b469-47ef-463f-b859-afd9ff606556",
                                "sense_id": "124cdcf5-7f8f-3844-8338-7d7de2c6cf1c",
                                "text": "De gevreesde teek (voor liefhebbers: de 'schapenteek' Ixodes ricinus) verblijft bij voorkeur in gemengde loofbossen met een ondergroei van bosbessen of varens. Ook in dennenbossen komt de teek voor, met name als er hoge grassen onder de bomen staan, evenals in de duinen en in stadsparken."
                            },
                            {
                                "example_id": "070cb99f-cabf-4c2e-b499-5d41b8b7c2ed",
                                "sense_id": "124cdcf5-7f8f-3844-8338-7d7de2c6cf1c",
                                "text": "Brandweerlieden hebben maatregelen genomen om ze te beschermen, zoals ondergroei weghalen en sproeiers neerzetten om de omgeving van de bomen vochtiger te maken."
                            }
                        ]
                    }
                ],
