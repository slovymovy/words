                "senses": [
                    {
                        "sense_id": "5ee7aeac-45d0-3493-b31f-ec158f9d3fed",
                        "entry_id": "59ad4163-216b-3563-85e5-0a19dd784468",
                        "glosses": [
                            "erstmals 1916 veröffentlichter verbaler Intelligenztest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38b53ff7-a59f-497d-8b43-f669ac99d51e",
                                "sense_id": "5ee7aeac-45d0-3493-b31f-ec158f9d3fed",
                                "text": "„Wir machten den Stanford-Binet-Test, um das Alter meines Gehirns zu bestimmen.“"
                            },
                            {
                                "example_id": "7b2d0069-ff08-4600-9276-772db7f966d4",
                                "sense_id": "5ee7aeac-45d0-3493-b31f-ec158f9d3fed",
                                "text": "„Nach einer kurzen Dienstzeit in der Army lernte er 1948 eine junge Frau kennen, die er im gleichen Jahr heiratete, und im Einklang mit dem Glück der Varvesi-Männer stellte sie sich als Genie mit einem IQ von 173 nach dem Stanford-Binet-Test heraus.“"
                            },
                            {
                                "example_id": "4d331c6c-2a0c-4cdb-a977-f7375d2fffb0",
                                "sense_id": "5ee7aeac-45d0-3493-b31f-ec158f9d3fed",
                                "text": "„Einmal hat sie beim Stanford-Binet-Test acht Punkte gemacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
