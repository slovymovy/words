    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "081aeceb-5519-3910-a48b-f961e7a9cfab",
                "word": "Vandalic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bd737213-9f61-3d38-a200-42c10655976c",
                        "entry_id": "081aeceb-5519-3910-a48b-f961e7a9cfab",
                        "glosses": [
                            "Of or pertaining to the Vandals (the Germanic tribe)."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43d05424-7b03-4642-8c65-e8184de2358f",
                        "source_entry_id": "081aeceb-5519-3910-a48b-f961e7a9cfab",
                        "source_sense_id": "bd737213-9f61-3d38-a200-42c10655976c",
                        "source_sense_description": "of or pertaining to the Vandals",
                        "target_lang_word": "vandale",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vandale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "73228019-9499-38ea-be7a-71d02a1ada2c",
                                        "entry_id": "419aeb16-27e6-3e27-a554-736c586d061e",
                                        "glosses": [
                                            "Relatif aux Vandales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6565c438-b118-4bd1-bd5c-07da70b0f70e",
                                                "sense_id": "73228019-9499-38ea-be7a-71d02a1ada2c",
                                                "text": "Du fond de ses marais l’engeance féodale\nA vomi sous nos murs son python couronné.\nSi nous n’écrasons pas du pied l’hydre vandale,\nCivilisation, ton règne est terminé !"
                                            },
                                            {
                                                "example_id": "1b371d3b-94d0-42b8-80b0-d9996ffd2c00",
                                                "sense_id": "73228019-9499-38ea-be7a-71d02a1ada2c",
                                                "text": "Là, le sceptre vandale, ici la loi burgonde ;\nCléopâtre renaît pire dans Frédégonde."
                                            },
                                            {
                                                "example_id": "cc110ce9-8805-4876-9107-baeb7ea15602",
                                                "sense_id": "73228019-9499-38ea-be7a-71d02a1ada2c",
                                                "text": "Azemmour est une ville très ancienne. D'origine numide , elle passa successivement sous la domination romaine, vandale, byzantine et sarrasine. En 1518, les Portugais s'en emparèrent, […]."
                                            },
                                            {
                                                "example_id": "d303780a-f50f-46f7-a973-0db5030d31be",
                                                "sense_id": "73228019-9499-38ea-be7a-71d02a1ada2c",
                                                "text": "À la mi-décembre, les Byzantins marchent vers la seconde armée vandale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a1dc5f6-a5ab-3f13-add0-6a86800e6a58",
                                        "entry_id": "419aeb16-27e6-3e27-a554-736c586d061e",
                                        "glosses": [
                                            "Qui commet un acte de vandalisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0fb0380-153b-42b1-9c2a-d8225328c9c0",
                                                "sense_id": "7a1dc5f6-a5ab-3f13-add0-6a86800e6a58",
                                                "text": "Laisseras-tu voiler, par une main vandale,\nLes cicatrices de ton front ?"
                                            },
                                            {
                                                "example_id": "08eadc48-b3d1-487c-9bf2-230d7d70578e",
                                                "sense_id": "7a1dc5f6-a5ab-3f13-add0-6a86800e6a58",
                                                "text": "Et que dirait un sous-chantre du seizième siècle, en voyant le beau badigeonnage dont nos vandales archevêques ont barbouillé leur cathédrale ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vandale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "535101b6-222c-36c6-9006-fad511c64ba6",
                                        "entry_id": "ba7ff42c-d20e-36cc-8910-90cc8d5e7c69",
                                        "glosses": [
                                            "Personne qui, délibérément, par plaisir ou par méchanceté, abîme, détruit des œuvres d’art, des choses belles ou utiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96a833ea-3c37-429f-b878-9f6eaaeffe1f",
                                                "sense_id": "535101b6-222c-36c6-9006-fad511c64ba6",
                                                "text": "Une évaluation psychologique du vandale devrait avoir lieu avant son retour en cour lundi."
                                            },
                                            {
                                                "example_id": "203e6321-dedb-4244-8c1b-1e7b96c9d012",
                                                "sense_id": "535101b6-222c-36c6-9006-fad511c64ba6",
                                                "text": "C’est un vandale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890a921a-51c8-3cc0-b07d-67d41eeb8dab",
                                        "entry_id": "ba7ff42c-d20e-36cc-8910-90cc8d5e7c69",
                                        "glosses": [
                                            "Barbare, personne qui, par stupidité, ignorance ou manque de goût, défigure, endommage un site, un paysage, une œuvre d'art, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9cb971e-62ea-4626-997a-a2c62632eb23",
                                                "sense_id": "890a921a-51c8-3cc0-b07d-67d41eeb8dab",
                                                "text": "Ce vandale avait transformé le toit en terrasse, changé la grille, barbouillé la façade en rose vineux.",
                                                "translation": "Hervé Bazin, Lève-toi, 1952"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10d478af-0fc0-3f25-9ac6-617dd0b2f33c",
                                        "entry_id": "ba7ff42c-d20e-36cc-8910-90cc8d5e7c69",
                                        "glosses": [
                                            "Utilisateur qui détériore délibérément un ou plusieurs articles sur un wiki."
                                        ],
                                        "tags": [
                                            "Wikis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de2ce728-772e-4953-8bc0-8fa724a98751",
                                                "sense_id": "10d478af-0fc0-3f25-9ac6-617dd0b2f33c",
                                                "text": "Certains utilisateurs anonymes, pour assouvir leur soif d’agitation intérieure, n’hésitent pas à agir en vandale."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vandale",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c55d825-62f0-3dec-b8c5-b07fbb710725",
                                        "entry_id": "0c170aa3-1e8b-3691-ac4e-612d3ab8b6cc",
                                        "glosses": [
                                            "Langue germanique morte probablement liée au gotique, qui fut parlée par le peuple vandale."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
