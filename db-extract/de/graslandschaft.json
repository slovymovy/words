                "senses": [
                    {
                        "sense_id": "417ed0b6-539f-358e-8ab8-48a16ad091ef",
                        "entry_id": "690f9f02-abb4-35a3-bb1a-e6e2e19c3468",
                        "glosses": [
                            "Landschaft, die vorwiegend durch große Grasflächen geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7890062c-ae1e-43b0-a11e-e2b94a299b85",
                                "sense_id": "417ed0b6-539f-358e-8ab8-48a16ad091ef",
                                "text": "„Die einzigen ausgedehnten Graslandschaften der Welt, auf denen die ursprünglichen Bestände großer Weidetiere nahezu intakt erhalten geblieben sind, sind die Savannen des östlichen Afrikas.“"
                            },
                            {
                                "example_id": "9fea4e3d-35e7-4852-a588-9073a7e34ca1",
                                "sense_id": "417ed0b6-539f-358e-8ab8-48a16ad091ef",
                                "text": "„Sie eilten zurück zum Wasserfall, überquerten mehrere Felder und flogen anschließend tief über die verwunschene Graslandschaft hinweg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
