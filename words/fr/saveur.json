                    "frequency": "High",
                    "semantic_group_id": "gout",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette soupe traditionnelle possède une <w>saveur</w> délicate qui rappelle la cuisine de ma grand-mère."
                        },
                        {
                            "text": "Les épices ajoutent une nouvelle <w>saveur</w> à ce plat de légumes d'hiver."
                        }
                    ],
                    "synonyms": [
                        "goût",
                        "flaveur"
                    ],
                    "antonyms": [
