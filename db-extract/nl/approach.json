                    },
                    {
                        "sense_id": "3110e62e-80a7-3abb-9219-feebf4c14587",
                        "entry_id": "7d1892d0-f220-3822-8918-6e02fc2bb615",
                        "glosses": [
                            "nadering, met name van een vliegveld"
                        ],
                        "tags": [],
