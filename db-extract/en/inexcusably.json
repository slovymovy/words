                                "sense_id": "b2b2cb05-73d5-3236-99d8-988d1d6a5aa7",
                                "text": "We arrived at the wedding inexcusably late."
                            },
                            {
                                "example_id": "818b0177-ce8d-4ca8-89f2-68a0a777d314",
                                "sense_id": "b2b2cb05-73d5-3236-99d8-988d1d6a5aa7",
                                "text": "Of course there is more — much more — still to discover, and rediscover, in Sarton's work. Sarton has been inexcusably neglected by critics; World of Light will contribute to providing her with the recognition she deserves."
                            }
                        ]
                    }
