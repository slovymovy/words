                {
                    "sense_id": "5d8d76d4-b317-372b-a3ac-d0bfee69ff0a",
                    "sense_definition": "Ending without a definite winner or loser.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <drawn> match meant that both teams shared the points equally.",
                            "target_lang_translations": {
                                "ru": "Матч, <сыгранный вничью>, означал, что обе команды поровну поделили очки.",
                                "pl": "<Remisowy> mecz oznaczał, że obie drużyny podzieliły się punktami po równo.",
                                "es": "El partido <empatado> significó que ambos equipos compartieron los puntos por igual."
                            }
                        },
                        {
                            "text": "After a <drawn> game, the players prepared for a rematch next week.",
                            "target_lang_translations": {
                                "ru": "После <ничейной> игры игроки готовились к матчу-реваншу на следующей неделе.",
                                "pl": "Po <nierozstrzygniętej> grze zawodnicy przygotowywali się do rewanżu w przyszłym tygodniu.",
                                "es": "Después de un juego <empatado>, los jugadores se prepararon para una revancha la próxima semana."
                            }
                        }
