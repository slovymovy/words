            "senses": [
                {
                    "sense_id": "1dc5aaf8-ee1b-37fe-8f72-b92f9733efb6",
                    "sense_definition": "A title used before the personal name of a <w>queen</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "title",
                    "name_type": "title_or_honorific_name",
                    "examples": [
                        {
                            "text": "<w>Queen</w> Elizabeth II reigned for seventy years.",
                            "target_lang_translations": {
                                "ru": "<w>Королева</w> Елизавета II правила семьдесят лет.",
                                "zh": "<w>女王</w>伊丽莎白二世在位七十年。"
                            }
                        },
