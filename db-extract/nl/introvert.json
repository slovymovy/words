                                            {
                                                "example_id": "ecae385a-e528-48ca-9575-d578ce2150e2",
                                                "sense_id": "45d811ec-1301-3498-9a65-e50491b05cce",
                                                "text": "Peter ist ein ausgesprochen introvertierter Mensch."
                                            }
                                        ],
