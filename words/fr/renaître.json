{
    "word_family": [
        "naissance",
        "renaissance",
        "naissant",
        "renaissant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ea902826-d97a-3659-af22-db4d1aa7aac1",
                    "sense_definition": "Naître une seconde fois ou revenir à la vie après la mort ou une épreuve.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le phénix mythique est un oiseau capable de <w>renaître</w> de ses cendres."
                        },
                        {
                            "text": "Après cette longue période de convalescence, elle a enfin le sentiment de <w>renaître</w>."
                        }
                    ],
                    "synonyms": [
                        "ressusciter"
                    ],
                    "antonyms": [
                        "mourir",
                        "périr"
                    ],
                    "common_phrases": [
                        "renaître de ses cendres",
                        "renaître à la vie"
                    ]
                },
                {
                    "sense_id": "598ff1a3-12e5-3588-94da-8671153f287c",
                    "sense_definition": "Recommencer à pousser, en parlant de la végétation ou de la flore.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dès l'arrivée du printemps, toute la forêt commence à <w>renaître</w>."
                        },
                        {
                            "text": "Les fleurs coupées par l'hiver rigoureux finissent toujours par <w>renaître</w>."
                        }
                    ],
                    "synonyms": [
                        "repousser"
                    ],
                    "antonyms": [
                        "dépérir",
                        "sécher"
                    ]
                },
                {
                    "sense_id": "5d7cd3f4-dcd9-329c-8250-e4a1950025e6",
                    "sense_definition": "Se ranimer, reparaître dans l'esprit ou dans un groupe, en parlant d'un sentiment, d'une idée ou d'une activité.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette bonne nouvelle a aussitôt fait <w>renaître</w> l'espoir parmi les ouvriers."
                        },
                        {
                            "text": "Leur brève rencontre a permis de faire <w>renaître</w> une amitié oubliée."
                        }
                    ],
                    "synonyms": [
                        "revivre",
                        "resurgir"
                    ],
                    "antonyms": [
                        "s'éteindre",
                        "disparaître"
                    ],
                    "common_phrases": [
                        "faire renaître l'espoir",
                        "faire renaître la flamme"
                    ]
                },
                {
                    "sense_id": "d4524823-306d-3d3c-929a-82c88055dff7",
                    "sense_definition": "Reparaître au regard après avoir disparu, en parlant d'un cours d'eau souterrain ou de la clarté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La rivière souterraine s'enfonce sous la roche et <w>renaît</w> en aval de la vallée."
                        },
                        {
                            "text": "Après la tempête, le soleil perce les nuages et le jour <w>renaît</w> enfin."
                        }
                    ],
                    "synonyms": [
                        "reparaître"
                    ],
                    "antonyms": [
                        "disparaître"
                    ]
                }
            ]
        }
    ]
}