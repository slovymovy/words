                "senses": [
                    {
                        "sense_id": "12e6f813-5d76-3b1f-a215-227ff4c8b3c4",
                        "entry_id": "a754d700-530f-358d-b208-027c71b9736a",
                        "glosses": [
                            "die Sonne in der Art, wie sie im Frühling scheint"
                        ],
                        "tags": [
                            "Wetter"
                        ],
                        "examples": [
                            {
                                "example_id": "01938eac-03a9-48f0-9d07-e2beb604f6b9",
                                "sense_id": "12e6f813-5d76-3b1f-a215-227ff4c8b3c4",
                                "text": "„Selbst in der milden Frühlingssonne geht niemand unter den alten Bäumen spazieren.“"
                            },
                            {
                                "example_id": "4c383789-3579-4366-9b65-d1bdd5151484",
                                "sense_id": "12e6f813-5d76-3b1f-a215-227ff4c8b3c4",
                                "text": "„Vera und Thomas genießen die Frühlingssonne auf der Terrasse.“"
                            },
                            {
                                "example_id": "9fb842fc-191d-4f8d-ab4f-143f3e12eb3a",
                                "sense_id": "12e6f813-5d76-3b1f-a215-227ff4c8b3c4",
                                "text": "„Die Frühlingssonne schien auf die Rue St. Honoré, als ich die Kirchenstufen hinabeilte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
