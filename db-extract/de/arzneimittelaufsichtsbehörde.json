                        "sense_id": "9de83e61-2373-3048-ab36-b9205e0aa863",
                        "entry_id": "992a7949-f615-36ff-9802-f50f7f93eb17",
                        "glosses": [
                            "Aufsichtsbehörde, die die verkauften Arzneimitteln in einem Land kontrolliert"
