                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8d4f48-7bff-443e-aaef-4c0482134167",
                                "sense_id": "4bb572e3-c744-3768-8f16-76c8f03e130b",
                                "text": "Était-il piteux, ce pauvre navire que l'on venait d'encharbonner!"
                            },
                            {
                                "example_id": "d85adf6a-ece1-49f5-9d38-728c14e8d6ab",
                                "sense_id": "4bb572e3-c744-3768-8f16-76c8f03e130b",
                                "text": "à la saison sèche, ces incendies laissent sur les collines de vastes plaques et de longues traînées noires, où le voyageur s'encharbonne. et sur lesquelles plane la fade odeur de réglisse que dégage cette herbe brûlée."
                            }
                        ]
