                },
                {
                    "sense_id": "e3912499-4766-3aab-9304-2b8339a43ee7",
                    "sense_definition": "Relatif au mime ou aux pièces de théâtre fondées sur l'imitation muette.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "art_theatral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette troupe prépare une représentation <w>mimique</w> inspirée des traditions théâtrales antiques."
                        },
                        {
                            "text": "L'art <w>mimique</w> exige une maîtrise corporelle rigoureuse et une précision sans faille."
