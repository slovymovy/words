                        "entry_id": "c7914f34-b058-31a3-9991-3e05969c6433",
                        "glosses": [
                            "een electronisch apparaat of schakeling voor het opwekken van een wisselspanning van een bepaalde frequentie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "918453ea-6d37-4be6-8623-c420cd365e71",
                                "sense_id": "ef23c433-122f-39a4-a866-6d186163d021",
                                "text": "In menig elektronisch apparaat (radiozender, computer, tijdmeter enz.) is de functie van de oscillator onmisbaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd9dfd4b-9b8d-4548-85e5-67aa00add3ab",
