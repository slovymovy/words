                    {
                        "sense_id": "1a5fdc31-5331-3d81-a109-235b1e0f3d5f",
                        "entry_id": "192fc93c-8fa5-3451-87ef-1edb6b38acea",
                        "glosses": [
                            "Automat für die Auswahl und den Erwerb von Zigaretten"
