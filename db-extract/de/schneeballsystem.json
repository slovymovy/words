                "senses": [
                    {
                        "sense_id": "22a99749-adc8-3be8-8de4-87c4bb269b2e",
                        "entry_id": "7f8e57d2-07fa-3692-8b72-8af68b991716",
                        "glosses": [
                            "illegaler Verkaufstrick, bei dem Interessenten vorgegaukelt wird, es gäbe eine einfache Methode, um in kurzer Zeit viel Geld zu verdienen, die man ihnen gegen eine Geldzahlung im Voraus mitteilen werde; wobei diese Methode lediglich darin besteht, exakt denselben Verkaufstrick bei anderen Personen anzuwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ae61a9-87e3-45c2-9f4e-5b076263c857",
                                "sense_id": "22a99749-adc8-3be8-8de4-87c4bb269b2e",
                                "text": "„Wie in einem Schneeballsystem reihten sich die Sätze aus den Raubdrucken revolutionärer Koryphäen aneinander.“"
                            },
                            {
                                "example_id": "5651cc19-a176-49ee-b86e-feb50e932ea7",
                                "sense_id": "22a99749-adc8-3be8-8de4-87c4bb269b2e",
                                "text": "„Das effektive Schneeballsystem der E-Mail-Kommunikation macht neue Schöpfungen innerhalb kürzester Zeit weltweit verfügbar, wie wir dies aus der raschen Verbreitung von Disaster Jokes kennen.“"
                            },
                            {
                                "example_id": "4b1e8b70-1513-4774-80c8-fdb1b77ebd44",
                                "sense_id": "22a99749-adc8-3be8-8de4-87c4bb269b2e",
                                "text": "Die Zahl der an einem Schneeballsystem beteiligten Personen kann bedingt durch seine Funktionsweise exponentiell wachsen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77e6ea78-9107-3886-b573-f09ee9f9af52",
                        "entry_id": "7f8e57d2-07fa-3692-8b72-8af68b991716",
                        "glosses": [
                            "Vertriebsstruktur, bei der ein Mitarbeiter oder eine Filiale eines Unternehmens – neben einer Provision für eigene abgeschlossene Verkäufe – ebenfalls eine Provision für Verkäufe von von diesem angeworbenen anderen Mitarbeitern oder von dieser gegründeten weiteren Filialen erhält, womit ein selbstständiger Ausbau des Vertriebsnetzes gefördert und belohnt werden soll"
                        ],
                        "tags": [
                            "Marketing"
                        ],
                        "examples": [
                            {
