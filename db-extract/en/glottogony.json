                        ],
                        "examples": [
                            {
                                "example_id": "c70c52fe-a3a2-4e70-8673-156d471e458f",
                                "sense_id": "9c4d0edd-7123-3778-a6b5-6355069b4af5",
                                "text": "The origin of words is a question that now falls within the chapter of “glottogony”, resurrected after decades of inactivity. There are now quite a few glottogonic theories, some of which are also concerned with the origin of words as, for example, the one that argues that original words are connected with phonosymbolism, […]"
                            },
                            {
                                "example_id": "1df33233-4e74-4af7-9a84-87587d45f878",
                                "sense_id": "9c4d0edd-7123-3778-a6b5-6355069b4af5",
                                "text": "The topic of glottogony has long been a taboo in linguistics, for the very good reason that it attracts boundless speculation: when Darwinism was freshly en vogue in the 1860s, linguistic debate was inundated with such proposals to the point where, in 1866, the Linguistic Society of Paris banned the entire topic as a hopeless exercise […]"
                            }
                        ]
                    }
