                "senses": [
                    {
                        "sense_id": "5eec0b86-c48b-3336-b4b4-3d70f97e2c0f",
                        "entry_id": "06a0a0ac-230d-329f-a335-1d575f979a0a",
                        "glosses": [
                            "Vorgabe, nach der (bestimmte) Hunde in der Öffentlichkeit einen Maulkorb (Beißkorb) tragen müssen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7208d80c-a68b-4901-9a9f-f8766c92a6db",
                                "sense_id": "5eec0b86-c48b-3336-b4b4-3d70f97e2c0f",
                                "text": "„Das Land Tirol will die Leinen- und Maulkorbpflicht verschärfen.“"
                            },
                            {
                                "example_id": "4467180f-4b14-4c12-aeeb-fb84daf43ec5",
                                "sense_id": "5eec0b86-c48b-3336-b4b4-3d70f97e2c0f",
                                "text": "„Der 17-Jährige räumte vor Gericht ein, im Umgang mit den Hunden leichtsinnig und unerfahren gewesen zu sein. Von einer Maulkorbpflicht habe er nicht gewusst, die Aufforderung seines älteren Bruders - dem Hundehalter - die Tiere anzuleinen, habe er ignoriert.“"
                            },
                            {
                                "example_id": "5f39472e-96aa-46b3-bd6e-c528d4f6ca4c",
                                "sense_id": "5eec0b86-c48b-3336-b4b4-3d70f97e2c0f",
                                "text": "„Eine solche Maulkorbpflicht ist gesetzlich bereits vorgeschrieben, gilt aber nicht einfach im gesamten Stadtgebiet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
