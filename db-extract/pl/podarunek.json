                    {
                        "translation_id": "25009a60-1eb7-477f-9cce-1ef9da66467e",
                        "source_entry_id": "561c957f-feb5-3991-b80e-6c4969475dfc",
                        "source_sense_id": "8af314e5-c19d-395e-82fc-4606cefb9bc5",
