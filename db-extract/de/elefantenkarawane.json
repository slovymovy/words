                "senses": [
                    {
                        "sense_id": "151add8f-4760-35df-9c68-c085069cc041",
                        "entry_id": "9ed846a4-0770-3933-8f40-1758e824085d",
                        "glosses": [
                            "Karawane, die Elefanten als Lasttiere nutzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6745cf71-9a8e-4f33-8a21-7ae0d9019124",
                                "sense_id": "151add8f-4760-35df-9c68-c085069cc041",
                                "text": "„So konnten seine Galeeren den Fluss Oukranos nicht mehr aufwärtssegeln, vorbei an den goldenen Türmen von Thran, noch vermochten seine Elefantenkarawanen durch die parfümierten Dschungel Kleds zu ziehen, wo vergessene Paläste mit Säulen aus geädertem Elfenbein lieblich und unbeschadet unter dem Mond schlafen.“"
                            },
                            {
                                "example_id": "525dabad-bd29-4ede-9a9b-814accbdeb34",
                                "sense_id": "151add8f-4760-35df-9c68-c085069cc041",
                                "text": "„Elefantenkarawanen haben im Mondlicht von ferne einen Blick auf die Paläste erhascht, doch niemand wagt sich wegen der Wächter, denen sie ihre Unbeschadetheit verdanken, näher an sie heran.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
