                        "glosses": [
                            "hauptsächlich aus Baracken bestehende Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "605604ca-6b90-4c25-a247-0c8bc7754464",
                                "sense_id": "bd402327-7af5-3de9-9d18-2348671841e9",
                                "text": "„Es ging hinauf bis zum Kamm der Höhen, dann vorbei an drei geschlossenen jüdischen Siedlungen auf dem Stadtgebiet von Anata und der beduinischen Barackenstadt Khan al-Ahmar, welche sich über eine Parzelle aus dem Besitz von Abeds Großvater erstreckte.“"
                            },
                            {
                                "example_id": "8267cb44-d66b-43df-ad84-305f91b39b74",
                                "sense_id": "bd402327-7af5-3de9-9d18-2348671841e9",
                                "text": "„Sie passierten eine langgestreckte Barackenstadt am Rand eines Nebenarms, um Siedlung und Bach kein Gras und Pflanzenwuchs mehr, ein Gelände aus nacktem Lehm, bevölkert mit Abfall, Hühnern und struppigen Kötern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
