                ],
                "senses": [
                    {
                        "sense_id": "f373fe02-efb5-3bfc-9848-07ab59b5baea",
                        "entry_id": "9fd5580b-9530-34ff-acb2-20dc375b2cd4",
                        "glosses": [
                            "varken, zwijn; naam voor soorten uit het geslacht Sus"
                        ],
                        "tags": [
                            "Nederlands-Indië"
                        ],
                        "examples": [
                            {
                                "example_id": "32589a23-e54d-4a1a-9f28-608ba253e0e3",
                                "sense_id": "f373fe02-efb5-3bfc-9848-07ab59b5baea",
                                "text": "De fietser moest volgens \"damai\"-vonnis een biggetje van f 5 slachten en dit met de noodige rijst thuis bij den ouden man bezorgen en tegelijk vergiffenis vragen. De twee vechtlustigen moesten ook een babi slachten van dezelfde waarde."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8327a18-dd2e-390e-a6e6-1c2ffe3db5dc",
                        "entry_id": "9fd5580b-9530-34ff-acb2-20dc375b2cd4",
                        "glosses": [
                            "varkensvlees"
                        ],
                        "tags": [
                            "Indische keuken"
                        ],
                        "examples": [
                            {
                                "example_id": "91522643-24e4-463a-8b1e-8a8af34286ab",
                                "sense_id": "a8327a18-dd2e-390e-a6e6-1c2ffe3db5dc",
                                "text": "Soms brengen de Chinezen hun hele familie mee: moeder de vrouw, dik en welgedaan vanwege de ‘bami’ en de ‘babi’, in kabaja met kanten en veel gelang mas; en kleine kinderen met schuine muizenoogjes en opgesierd met onkinderlijke kettingen en slingers, waaraan medaillons en gouden munten."
                            }
                        ]
                    },
                    {
                        "sense_id": "4e267e17-a34e-3f86-96d9-59a2df2b1d22",
                        "entry_id": "9fd5580b-9530-34ff-acb2-20dc375b2cd4",
                        "glosses": [
                            "varken"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "5f2c46b6-858e-4006-803d-c4efdcee4608",
                                "sense_id": "4e267e17-a34e-3f86-96d9-59a2df2b1d22",
                                "text": "\"Hé Kampret! Babi loe!\" schreeuwde ik woedend, geen acht slaand op de biologische onmogelijkheid."
                            }
                        ]
                    }
                ],
