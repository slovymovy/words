                                        "glosses": [
                                            "Any organism (generally a bacterium, fungus or alga) that lives inside a plant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfdd1ade-9ac2-420e-a26c-88fddabdf5f1",
                                                "sense_id": "eb0fc75b-72ba-3c4f-bbdc-7a8c0eec2571",
                                                "text": "Take a grass from salty coastal soils, grow it without its fungal endophytes, and it won't be able to survive in its natural salty habitat."
                                            }
                                        ]
