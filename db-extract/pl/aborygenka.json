                "translations": [
                    {
                        "translation_id": "dc2980d0-e57a-4dfa-9f55-5e096c55ef08",
                        "source_entry_id": "d00848df-1689-335d-8941-599f5765581d",
                        "source_sense_id": "7719424e-13f0-3667-a522-52c7fdb08b3d",
                        "source_sense_description": "Ureinwohnerin Australiens; Aborigine",
                        "target_lang_word": "Aborigine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aborigine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4f9cd673-001b-3e49-b8a0-b22cbfcfb671",
                                        "entry_id": "0e379603-4aa7-32c6-81fa-78ab898f6871",
                                        "glosses": [
                                            "Ureinwohner Australiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06b5fa79-be56-46d0-a69b-59bba3654d7d",
                                                "sense_id": "4f9cd673-001b-3e49-b8a0-b22cbfcfb671",
                                                "text": "„Mount Kośćiuszko nennen heute die Australier ihren höchsten Gipfel – und glauben sicher bis heute, daß dieser Zungenbrecher von den Aborigines stammt.“"
                                            },
                                            {
                                                "example_id": "bfdae20f-a0c8-4ae7-817e-f810c9961a22",
                                                "sense_id": "4f9cd673-001b-3e49-b8a0-b22cbfcfb671",
                                                "text": "„Im Dezember 1788 war Sydney Cove eine britische Garnisonsstadt am Rande eines von Aborigines bewohnten Kontinents.“"
                                            },
                                            {
                                                "example_id": "be9e4879-5127-4484-9c42-0709b6888d51",
                                                "sense_id": "4f9cd673-001b-3e49-b8a0-b22cbfcfb671",
                                                "text": "„Heute ist diese Gegend schon beinahe im Zentrum, aber damals fühlten wir uns wie Aborigines – mit der Natur noch quasi vereint.“"
                                            },
                                            {
                                                "example_id": "74886f6b-f039-4a23-8c2e-491ba6ac679f",
                                                "sense_id": "4f9cd673-001b-3e49-b8a0-b22cbfcfb671",
                                                "text": "„Die Aborigines berichten von ihren Maden und den Sternen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Aborigine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9408aee-8c43-33f2-bd75-4f3987297d6e",
                                        "entry_id": "59c85dcb-6867-3339-8b40-41b7f4ae8ffd",
                                        "glosses": [
                                            "Ureinwohnerin Australiens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d71656c-5028-4262-b997-bc832d1cdf7c",
                                                "sense_id": "d9408aee-8c43-33f2-bd75-4f3987297d6e",
                                                "text": "In Australien habe ich eine Aborigine kennen gelernt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
