                                "target_senses": [
                                    {
                                        "sense_id": "efe7d286-5b37-30bc-a682-cc594f4defc1",
                                        "entry_id": "69496b2d-ac76-342d-b91b-b0671e8930ef",
                                        "glosses": [
                                            "To lie or sit in a comfortable, relaxed position, especially holding someone else."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de7eba8f-113d-4946-b802-612ce4d9ac19",
                                                "sense_id": "efe7d286-5b37-30bc-a682-cc594f4defc1",
                                                "text": "Cuddle up baby, move in tight. We'll go dancing tomorrow night."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
