                                "target_senses": [
                                    {
                                        "sense_id": "995209f3-23ed-3754-ad8e-86e3a5cabada",
                                        "entry_id": "dbf4c6e9-9964-3c88-a9e9-cc2595ccd1a3",
                                        "glosses": [
                                            "gar nichts, gar nicht"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11ccddcc-89cf-4172-b652-901ea6c7b9a9",
                                                "sense_id": "995209f3-23ed-3754-ad8e-86e3a5cabada",
                                                "text": "Der Dreck ist keinen Deut wert."
                                            },
                                            {
                                                "example_id": "92f79eeb-764f-4a5b-a4cf-867805cdc851",
                                                "sense_id": "995209f3-23ed-3754-ad8e-86e3a5cabada",
                                                "text": "Ich werde nicht einen Deut von meiner Meinung abweichen."
                                            },
                                            {
                                                "example_id": "59737856-2ca6-4796-8d0b-8983591c273d",
                                                "sense_id": "995209f3-23ed-3754-ad8e-86e3a5cabada",
                                                "text": "„Ich bin keinen Deut besser, denn ich bin so deutsch, dass sich meine türkischen Verwandten Sorgen machen, aber gleichzeitig so türkisch, dass ich für alles Türkische herhalten muss.“"
                                            },
                                            {
                                                "example_id": "5602d8e3-4953-4281-92cb-f9f2742dffa9",
                                                "sense_id": "995209f3-23ed-3754-ad8e-86e3a5cabada",
                                                "text": "„Er ist ein Dogmatiker und der Einzige, der auch hinterher keinen Deut schlauer ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
