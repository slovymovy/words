                        "entry_id": "1e9e8928-d482-3428-b81f-cc2ef9270bd3",
                        "glosses": [
                            "Fou, déluré, extravagant."
                        ],
                        "tags": [
                            "broadly",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "585f4822-e7f4-4ac9-b4ec-7a7bc44b119e",
                                "sense_id": "7f093d7f-c441-3876-b273-8980cfe4eed3",
                                "text": "Regarde-le-moi ! On est en cours et il ne trouve rien de mieux que de faire des avions en papier. Complètement ravagé, je te dis !"
                            }
                        ]
                    }
