                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "daad9119-90fd-4d53-bb19-bb182b2829e8",
                                "sense_id": "9561ef8e-76a0-3f09-9860-888f733e59d1",
                                "text": "Kool, zwavel en salpeter zijn de oorspronkelijke bestanddelen van buskruit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fcff3aae-801b-4e56-a6b8-7a6dc7962527",
                        "source_entry_id": "47ad3c51-8414-38be-bda4-9aa17bdbd6cf",
                        "source_sense_id": "9561ef8e-76a0-3f09-9860-888f733e59d1",
                        "source_sense_description": "een mineraal bestaande uit kaliumnitraat",
                        "target_lang_word": "Salpeter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Salpeter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                        "entry_id": "75b7a541-95da-3e4d-ad90-1004131c81ff",
                                        "glosses": [
                                            "Bezeichnung für verschiedene Salze der Salpetersäure"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46d58d2f-7704-4988-8921-f37ecd1e024e",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "Salpeter spielt als Dünger in der Landwirtschaft eine Rolle."
                                            },
                                            {
                                                "example_id": "c7541a84-1a7b-4dad-b1cb-abde79f9656c",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "„Zur Herstellung von Munition, aber auch von Düngemitteln für die Landwirtschaft bilden Stickstoffverbindungen (Nitrate), darunter insbesondere Salpeter (NaNO₃) und Salpetersäure (HNO₃), einen unentbehrlichen Grundbestandteil.“"
                                            },
                                            {
                                                "example_id": "0ff41ce9-55da-4dd7-9cd1-8cfd4fafbe08",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "„Im Lauf des 19. Jahrhunderts kamen weitere Nutzungsbereiche für Salpeter hinzu.“"
                                            },
                                            {
                                                "example_id": "42854f72-50a8-422b-8f29-eda166072048",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "„Die Hauptfracht bestand aus Baumwolle, Salpeter und Ebenholz, doch vom Opium hatten wir immer noch vierhundert Kisten.“"
                                            },
                                            {
                                                "example_id": "a8ad78d7-5696-42b6-80f0-bfa39044afd6",
                                                "sense_id": "f12f1db0-fb89-39db-9750-07aded5e849c",
                                                "text": "„Aus dem Salpeter wurde mit Hilfe der Schwefelsäure durch Zersetzung Salpetersäure destilliert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
