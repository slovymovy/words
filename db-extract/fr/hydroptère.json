                "senses": [
                    {
                        "sense_id": "67c368a3-e643-3f05-bb7f-b059f3d85bd8",
                        "entry_id": "ff166e01-89af-3927-ad7f-c11a061113da",
                        "glosses": [
                            "Navire rapide dont la coque est munie d’ailes à surface portante hydrodynamique lui permettant de se soulever au-dessus de l’eau, au-delà d’une certaine vitesse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1970dcca-aea1-40e3-8a90-ac0326634bde",
                                "sense_id": "67c368a3-e643-3f05-bb7f-b059f3d85bd8",
                                "text": "Dans quelle mesure l’hydroptère peut-il compléter ou concurrencer l’avion de ligne, sur les lignes courtes ?"
                            },
                            {
                                "example_id": "cccff3ae-ac5b-4610-aa1d-d4dfbcdbb7f8",
                                "sense_id": "67c368a3-e643-3f05-bb7f-b059f3d85bd8",
                                "text": "Présentation à la télévision de l’hydroptère, le voilier volant d’Éric Tabarly. Dressé sur ses béquilles, il atteint des vitesses supérieures à soixante-dix km/heure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "687727b3-b882-4634-b70c-3ac37b30eb14",
                        "source_entry_id": "ff166e01-89af-3927-ad7f-c11a061113da",
                        "source_sense_id": "67c368a3-e643-3f05-bb7f-b059f3d85bd8",
                        "target_lang_word": "Tragflügelboot",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tragflügelboot",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "051fca17-19c5-3fbc-a7a0-1c7cbc491bab",
                                        "entry_id": "aafe2a77-c0cf-367e-882d-91a4fc6fdc61",
                                        "glosses": [
                                            "Wasserfahrzeug, das bei ansteigender Geschwindigkeit mit Hilfe von unter Wasser liegenden Tragflügeln während der Fahrt angehoben wird, um den Reibungswiderstand und die Wasserverdrängung zu reduzieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28ec4f99-9a80-4285-a225-f86394c8196e",
                                                "sense_id": "051fca17-19c5-3fbc-a7a0-1c7cbc491bab",
                                                "text": "Tragflügelboote können Geschwindigkeiten von bis zu 90 km/h erreichen."
                                            },
                                            {
                                                "example_id": "831f606a-2529-47df-8978-18f53276d67a",
                                                "sense_id": "051fca17-19c5-3fbc-a7a0-1c7cbc491bab",
                                                "text": "„Über den See geht es wahlweise mit einer Fähre oder aber dem ultraschnellen Tragflügelboot, das für Seekrankheit anfällige Leute jedoch lieber meiden sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
