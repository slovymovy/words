                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51332487-d07d-4fb0-b984-d5a94066b67b",
                                "sense_id": "5504965c-745c-3c36-b521-aac437eb6a9e",
                                "text": "L’immigré mossi est-il aussi islamisé et « dioulisé », que le laisseraient supposer certains aspects de son comportement social et religieux ?"
                            },
                            {
                                "example_id": "4f6422c2-2a3e-4f28-8a41-08960e4498ac",
                                "sense_id": "5504965c-745c-3c36-b521-aac437eb6a9e",
                                "text": "Si tu reproches ce que tu viens d'écrire à V.K je te redis qu'il faudrait que de ton côté toi aussi tu cesses de \"diouliser\" tout ou de parler de rattrapage ethnique à tout bout de champs."
                            }
                        ]
                    }
