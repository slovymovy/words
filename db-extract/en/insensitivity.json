                "entry_id": "0f55e152-c70b-320c-9e9d-3995659a82bd",
                "word": "insensitivity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "bd123760-ab67-45ea-bef4-6604c29f329f",
                        "entry_id": "0f55e152-c70b-320c-9e9d-3995659a82bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "insensitivities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ff11d692-e8a2-3f65-9057-ca4578b85c4a",
                        "entry_id": "0f55e152-c70b-320c-9e9d-3995659a82bd",
                        "glosses": [
                            "The condition of being insensitive"
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "d7673fee-591c-4553-83a3-a4dc39a1a17b",
                                "sense_id": "ff11d692-e8a2-3f65-9057-ca4578b85c4a",
                                "text": "To make matters worse, you did not publish the news note until 5 days before the conference — even though we had submitted it enough in advance to have been included in the previous weeks' paper. This showed a great insensitivity to the fact that lesbians with children are often not very mobile or flexible...We need that kind of advance notice in order to plan an all-day conference on a Saturday!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83390133-8c7c-4694-b08d-e66ca8ade715",
                        "source_entry_id": "0f55e152-c70b-320c-9e9d-3995659a82bd",
                        "source_sense_id": "ff11d692-e8a2-3f65-9057-ca4578b85c4a",
                        "source_sense_description": "condition of being insensitive",
                        "target_lang_word": "insensibilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insensibilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                        "entry_id": "32a46d26-dae5-3ce0-8300-27dff9220d89",
                                        "glosses": [
                                            "Absence de sensibilité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9336e50-3fa0-4984-ab9e-1d9ae5c96b97",
                                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                                "text": "On a dit une grande vérité lorsqu’on a posé en principe que toute la science du jockey consistait à faire supporter tout son poids par la bouche de son cheval ; mais on n’a pas parlé de l’insensibilité des barres que l’on produisait par cette manœuvre, […]."
                                            },
                                            {
                                                "example_id": "4177c0cd-64ec-423d-b623-a292dad2885c",
                                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                                "text": "— Deux sortes de personnes contractent nécessairement beaucoup d’insensibilité : les chirurgiens, les prêtres. A voir toujours souffrir et mourir, on meurt peu à peu soi-même dans les facultés sympathiques."
                                            },
                                            {
                                                "example_id": "083e7a96-bb1b-46a1-acb6-54c99847616e",
                                                "sense_id": "34e7d422-395b-36ee-8216-6fc3b6435d1a",
                                                "text": "L’examen par ce praticien révéla sans tarder sur le corps de Thomas le signe d’un pacte infernal, ces fameuses plaques d’insensibilité tenues de nos jours pour pathologiques, où les opérateurs pouvaient à leur aise enfoncer des épingles sans obtenir de cri ou de soubresaut du patient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4beb991a-8f8d-4f91-9ca4-c95ddbf65c66",
                        "source_entry_id": "0f55e152-c70b-320c-9e9d-3995659a82bd",
