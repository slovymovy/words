                    {
                        "translation_id": "8cd066c5-b1db-413a-9dfd-64d37d291914",
                        "source_entry_id": "a7c9db4d-fd60-3c49-9622-7ec3be70941f",
                        "source_sense_id": "fea829c7-7b87-3f7c-b26b-2d4a373eaa39",
