                "senses": [
                    {
                        "sense_id": "58511873-f99d-3ca6-8d07-17824fef8a5f",
                        "entry_id": "1fa0696f-7dc6-31a3-9261-77f32ee8ca10",
                        "glosses": [
                            "действие по значению гл. выхолащивать; лишение живого содержания, исключение сути чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12e9f129-2f7b-4f26-8c10-1ed638d2e067",
                                "sense_id": "58511873-f99d-3ca6-8d07-17824fef8a5f",
                                "text": "По мере выхолащивания официальной идеологии общество все более сознает свою связь с мировым процессом, свою причастность к мировым идеям."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c216bdf1-2471-41fa-9410-c96dcec9cc3d",
                        "source_entry_id": "1fa0696f-7dc6-31a3-9261-77f32ee8ca10",
                        "source_sense_id": "58511873-f99d-3ca6-8d07-17824fef8a5f",
