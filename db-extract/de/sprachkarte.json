                "senses": [
                    {
                        "sense_id": "260745fd-f45c-31c7-ab0f-967e5d5541d4",
                        "entry_id": "a2bf44df-885d-3e1b-ae24-d0b30d03ef8a",
                        "glosses": [
                            "(geographische) Karte, die die Verteilung von Sprachen, Dialekten und dergleichen oder sprachlichen Merkmalen (Lauten, Wörtern) darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "822c04e2-a2ba-48b0-91a0-10f63440bc59",
                                "sense_id": "260745fd-f45c-31c7-ab0f-967e5d5541d4",
                                "text": "„Auch im Bereich der Alltagssprache erweist sich das deutsche Sprachgebiet als außerordentlich vielgestaltig, die Sprachkarten zeigen verschiedene Raumbilder, aber auch diese organisieren sich typischerweise gerade nicht entlang der Grenze zwischen der alten Bundesrepublik und der DDR, sondern folgen anderen, älteren Mustern.“"
                            },
                            {
                                "example_id": "93a15058-cdba-4db3-ba24-c52ddcf73c74",
                                "sense_id": "260745fd-f45c-31c7-ab0f-967e5d5541d4",
                                "text": "„Die leistungsfähigste strukturalistische Darstellungsform für dialektale Lexika ist nicht die Sprachkarte, sondern das Mundartwörterbuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
