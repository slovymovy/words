                ],
                "senses": [
                    {
                        "sense_id": "a024b995-5cc3-34ac-9620-125d126f32dd",
                        "entry_id": "11bfaf8f-c8e7-383e-8a76-45ef0b9dac4a",
                        "glosses": [
                            "Körper, dessen Innenraum hohl beziehungsweise nicht ausgefüllt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbb831f5-ba1f-4280-9491-e07d06cfd5ef",
                                "sense_id": "a024b995-5cc3-34ac-9620-125d126f32dd",
                                "text": "Diese grüne Trinkflasche hier ist zum Beispiel ein Hohlkörper."
                            },
                            {
                                "example_id": "98eca781-6559-47df-b479-e17d09790aa4",
                                "sense_id": "a024b995-5cc3-34ac-9620-125d126f32dd",
                                "text": "„Das menschliche Herz ist ein Hohlkörper, das aus Muskeln besteht und regelmäßig das Blut durch den Kreislauf pumpt.“"
                            },
                            {
                                "example_id": "775b791e-be00-42d2-b378-157373dc7959",
                                "sense_id": "a024b995-5cc3-34ac-9620-125d126f32dd",
                                "text": "„Das Flugzeug, ein Hohlkörper aus relativ dünnem Aluminium, wurde beim Aufprall durch den Gitterrost aus dicken Stahlstützen zerteilt wie ein weich gekochtes Ei durch einen Eierschneider.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
