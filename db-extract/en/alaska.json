                "senses": [
                    {
                        "sense_id": "06ed8512-7d75-327d-9be2-8a5db20e11be",
                        "entry_id": "ce80325d-404f-3598-b172-3572a882f163",
                        "glosses": [
                            "A state of the United States, formerly a territory. Capital: Juneau. Largest city: Anchorage. Postal code: AK."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43fbe710-2069-4d9c-9149-090849e21654",
                                "sense_id": "06ed8512-7d75-327d-9be2-8a5db20e11be",
                                "text": "We have no available sources of information concerning the vegetation northward of the peninsula of Alaska from Bristol Bay, in 58°, to the mouth of the Kwichpak, in latitude 63°."
                            },
                            {
                                "example_id": "69d8ef7b-dccb-425d-91b1-4d33496fccff",
                                "sense_id": "06ed8512-7d75-327d-9be2-8a5db20e11be",
                                "text": "Alaska was discovered about a century ago by Russian furhunters[.]"
                            },
                            {
                                "example_id": "35517981-1fae-443b-9ebb-6bda22360cde",
                                "sense_id": "06ed8512-7d75-327d-9be2-8a5db20e11be",
                                "text": "Alaska's earliest inhabitants were nomadic hunters traveling in small bands. They arrived in interior Alaska at least 13,000 years ago […]"
                            },
                            {
                                "example_id": "5682b770-c69b-45b5-ae76-0cd52584dade",
                                "sense_id": "06ed8512-7d75-327d-9be2-8a5db20e11be",
                                "text": "Not that violence against humans is essential for a region to become boycottworthy. On the ethical consumer website’s list of “progressive boycotts”, campaigners also argue for boycotts on Alaska (wolf-killing) and Canada (for seal-killing, seafood), on Japan (whales) and Mauritius for exporting live primates."
                            }
                        ]
                    },
