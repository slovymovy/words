            {
                "entry_id": "07c7d9ba-12c5-340f-a077-fb82554e8758",
                "word": "IM",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9f1f223a-2f47-4e3b-8791-3f520aca1b5a",
                        "entry_id": "07c7d9ba-12c5-340f-a077-fb82554e8758",
                        "tags": [
