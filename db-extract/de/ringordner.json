                "senses": [
                    {
                        "sense_id": "5e1d577e-6802-39f2-8057-312be6b0f405",
                        "entry_id": "c13d5816-11c1-31e9-93be-680459cc0de3",
                        "glosses": [
                            "großer, robuster Umschlag, in den Blätter (meist Dokumente) eingeheftet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b647c562-34fc-485d-8484-98200c375268",
                                "sense_id": "5e1d577e-6802-39f2-8057-312be6b0f405",
                                "text": "„‚Warten Sie‘, sagt Manfred Strunk und schlägt zackig die richtige Seite im Ringordner auf, „2960 Mark, gebucht beim Reisebüro der DDR.“"
                            },
                            {
                                "example_id": "0ea1103c-f5f1-4811-b2b2-438308758d86",
                                "sense_id": "5e1d577e-6802-39f2-8057-312be6b0f405",
                                "text": "„Uwe Zander nimmt drei lose Blätter aus einem Ringordner und legt sie auf den Tisch.“"
                            },
                            {
                                "example_id": "2b4956b1-b70f-4d51-aed9-e3bbdeb995db",
                                "sense_id": "5e1d577e-6802-39f2-8057-312be6b0f405",
                                "text": "„‚Ich hab‘ alles da‘, murmelt er in einen aufgeschlagenen Ringordner und blättert Klarsichthüllen mit vergilbten Seiten um.“"
                            },
                            {
                                "example_id": "f8fdd38c-4e60-46f8-b5eb-a23fd3c7d9a0",
                                "sense_id": "5e1d577e-6802-39f2-8057-312be6b0f405",
                                "text": "„Die Stichworte über einzelne Autoren sind in einem Ringordner zusammengefasst, was Ergänzungen und Erweiterungen möglich macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
