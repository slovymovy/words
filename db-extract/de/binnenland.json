                ],
                "senses": [
                    {
                        "sense_id": "af07d609-bac0-397a-8e32-088640a74332",
                        "entry_id": "e6f8ccbf-7be0-3cf9-874c-fb69aef69fe1",
                        "glosses": [
                            "Gebiet/Land, das keine eigene Küste hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3149e134-bed5-4c72-9415-3b0b5c4e2151",
                                "sense_id": "af07d609-bac0-397a-8e32-088640a74332",
                                "text": "„Die größten Probleme gab es zwischen den Provinzen im Binnenland und denen an der Küste.“"
                            },
                            {
                                "example_id": "dc523b97-4466-4a2c-a841-1c9df32fe4b9",
                                "sense_id": "af07d609-bac0-397a-8e32-088640a74332",
                                "text": "„Die meisten Kriegsgefangenen, die den Sowjets in die Hände gefallen waren, wurden ins russische Binnenland oder nach Sibirien verfrachtet.“"
                            },
                            {
                                "example_id": "14936eb4-0317-44ec-9cf0-0fd6cffdd8b3",
                                "sense_id": "af07d609-bac0-397a-8e32-088640a74332",
                                "text": "„Im einzigen Binnenland Hinterindiens herrscht tropisches Monsunklima.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
