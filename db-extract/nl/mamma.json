                    {
                        "sense_id": "aa9100bb-3e35-362f-bc4b-54ed0518b90c",
                        "entry_id": "c7498c04-f5e5-3351-a916-d34a384d789b",
                        "glosses": [
                            "benaming voor vrouwelijke ouder door haar kind"
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "0ad8c177-fc74-43dc-8b44-b390776bf558",
                                "sense_id": "aa9100bb-3e35-362f-bc4b-54ed0518b90c",
                                "text": "Gierend van het lachen gingen we naar beneden, om te ontbijten. Pappa en mamma zaten al aan tafel. Ze probeerden met vertrokken gezichten streng te kijken. ‘Wie heeft dat op zijn geweten?’ vroeg pappa, maar lachte door zijn frons heen."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c1f4277-9557-3bb5-9e15-2065e99767f0",
                        "entry_id": "c7498c04-f5e5-3351-a916-d34a384d789b",
                        "glosses": [
                            "borst van een vrouw met daarin de melkklieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e017788b-9c1a-4564-b5b0-c99e42e5161b",
                                "sense_id": "9c1f4277-9557-3bb5-9e15-2065e99767f0",
                                "text": "Op 5 maart 2008 werd klaagster door haar huisarts aangemeld bij de mammapoli in verband met verdichting in de linker mamma."
                            }
                        ]
                    }
