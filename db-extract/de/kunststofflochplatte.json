                ],
                "senses": [
                    {
                        "sense_id": "d9571cc7-1301-351f-b771-c88e42d8eefc",
                        "entry_id": "02fd36a7-df8d-35a6-abba-83b4c9484329",
                        "glosses": [
                            "Lochplatte aus Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97755b98-2613-4b57-93d6-c50ad8291cb2",
                                "sense_id": "d9571cc7-1301-351f-b771-c88e42d8eefc",
                                "text": "„Durch die zusätzlichen technischen Vorteile wie Schwalbenschwanzführung und Kunststofflochplatte bietet das Gehäuse einen enormen Zusatz-Nutzen für die Industrie.“"
                            },
                            {
                                "example_id": "8305b414-6736-45d9-ae56-8b5aa24b7ec7",
                                "sense_id": "d9571cc7-1301-351f-b771-c88e42d8eefc",
                                "text": "„Die dritte ist die kohlefaserverstärkte thermoplastische Kunststofflochplatte, die zusammen mit TORAY-Gruppe entwickelt wurde.“"
                            },
                            {
                                "example_id": "b246587b-730a-4a3c-a799-5f578cf54f04",
                                "sense_id": "d9571cc7-1301-351f-b771-c88e42d8eefc",
                                "text": "„Die Kunststofflochplatte ist stabil, leicht und sehr preiswert. Zusätzlich ist die Kunststofflochplatte korrosionsbeständig.“"
                            },
                            {
                                "example_id": "54c145e7-bac3-42d6-8414-1ed3483ed8ef",
                                "sense_id": "d9571cc7-1301-351f-b771-c88e42d8eefc",
                                "text": "„Der sehr flache, bewegliche Saugkeil ist wahlweise mit einer Kunststoffsinterplatte, hydrophil oder hydrophob, oder mit einer Kunststofflochplatte bestückt.“"
                            },
                            {
                                "example_id": "fbfa3884-f785-4857-8c8b-1d19d7b5cfe3",
                                "sense_id": "d9571cc7-1301-351f-b771-c88e42d8eefc",
                                "text": "„Der Feinstaubfilter besteht aus einer Öffnung für die Luftzufuhr, folgend von einem Sieb aus einem elektrisch leitfähigen Material, Kunststofflochplatten aus einem elektrisch nicht leitenden Material und wieder mehreren Sieben aus dem elektrisch leitfähigen Material.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
