                                "target_senses": [
                                    {
                                        "sense_id": "1d886b27-ebe6-320f-aeb8-748198a45eae",
                                        "entry_id": "0d90f419-9c95-3b5b-b5b1-5c8b265ce810",
                                        "glosses": [
                                            "žena"
                                        ],
                                        "tags": [
                                            "colloquially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b337da5-48f6-4792-a744-79ebae852582",
                                                "sense_id": "1d886b27-ebe6-320f-aeb8-748198a45eae",
                                                "text": "Ženské toho nakecají!"
                                            },
                                            {
                                                "example_id": "117582b7-fb2b-4329-a7f7-12933f6641b0",
                                                "sense_id": "1d886b27-ebe6-320f-aeb8-748198a45eae",
                                                "text": "Všichni mu říkají, že už by si měl konečně najít ženskou."
                                            },
                                            {
                                                "example_id": "72f70245-a7f4-450d-9657-6c38ab6c7aea",
                                                "sense_id": "1d886b27-ebe6-320f-aeb8-748198a45eae",
                                                "text": "Jak ženský přišly ke špatné pověsti, že nejsou moc chytrý a že brečej v neštěstí. Prej k hříchu od pradávna maj vlohy, prej slabý jsou jak mátohy.Dávno už co světem stojí svět, tak si muži myslej, že jsou všeho lidství květ, ale to se musí znovu promyslet, dyť ženský ty jsou fajnový."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3cb10a4a-c8a5-336c-8049-9f12ed2a944d",
                                        "entry_id": "0d90f419-9c95-3b5b-b5b1-5c8b265ce810",
                                        "glosses": [
                                            "žena"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
