                "forms": [
                    {
                        "form_id": "66d32d52-1256-41f4-90e3-1a3be7b4ab42",
                        "entry_id": "f2206891-42fc-3355-9589-6f19aecb7e71",
                        "tags": [
                            "plural"
                        ],
                        "form": "yeomen"
                    },
                    {
                        "form_id": "9e9f1f51-d65f-41fc-873b-93156662150f",
                        "entry_id": "f2206891-42fc-3355-9589-6f19aecb7e71",
                        "tags": [
                            "plural"
                        ],
                        "form": "yeomans"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c2d7e952-8a27-34be-af15-ccc7ea22bd07",
                        "entry_id": "f2206891-42fc-3355-9589-6f19aecb7e71",
                        "glosses": [
                            "Paysan propriétaire de la terre qu’il cultive dans l’Angleterre médiévale. Ils forment l’élite villageoise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef8655cc-4a6d-4d82-b5cf-95983330cf40",
                                "sense_id": "c2d7e952-8a27-34be-af15-ccc7ea22bd07",
                                "text": "[…] ; un d’entre eux, un yeoman, robuste et bien taillé, portant un costume de drap vert de Lincoln, […], se retourna brusquement ; […]."
                            },
                            {
                                "example_id": "aba9a835-76a4-454d-8f3c-2ea081918930",
                                "sense_id": "c2d7e952-8a27-34be-af15-ccc7ea22bd07",
                                "text": "En d’autres temps le yeoman eût résisté et se fût accroché à sa terre. Mais, outre les villes, les colonies l’attiraient."
                            },
                            {
                                "example_id": "fc1a2c09-26db-4ec7-841e-0db4f915c395",
                                "sense_id": "c2d7e952-8a27-34be-af15-ccc7ea22bd07",
                                "text": "Ce ne fut, dit Hallam, ni la noblesse d’Angleterre, ni ses vassaux qui gagnèrent les batailles de Crécy, de Poitiers et d’Azincourt : […] ; mais ce furent les yeomans qui tiraient l’arbalète d’un bras sûr et nerveux, […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "b3f02360-c23a-3e80-bc0c-13696058a3df",
                        "entry_id": "f2206891-42fc-3355-9589-6f19aecb7e71",
                        "glosses": [
                            "Tout roturier exerçant un office à la cour ou auprès d’un notable."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d0116916-9899-34e8-b92f-cc12b4c64dad",
                        "entry_id": "f2206891-42fc-3355-9589-6f19aecb7e71",
                        "glosses": [
                            "Gardes des souverains britanniques. Ce corps, créé en 1485 par Henry VII, est recruté par les anciens militaires et n’a plus que des fonctions d’apparat. Il a conservé le costume du XVIᵉ siècle. Il fournit les gardiens de la tour de Londres, populairement appelés beefeaters."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "310953b9-91fd-41a1-b8df-364935b04e32",
                        "source_entry_id": "f2206891-42fc-3355-9589-6f19aecb7e71",
                        "source_sense_id": "c2d7e952-8a27-34be-af15-ccc7ea22bd07",
                        "source_sense_description": "(Histoire) Paysan propriétaire de la terre qu’il cultive dans l’Angleterre médiévale",
                        "target_lang_word": "yeoman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
