{
    "word_family": [
        "walgen",
        "walglijk",
        "walgingwekkend"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ba6d4b3b-c988-3f48-a9f7-0a45ba5c2be0",
                    "sense_definition": "Een zeer sterke afkeer of weerzin die vaak ook fysiek gevoeld wordt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "afkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De geur van het bedorven vlees vervulde hem met een diepe <w>walging</w>.",
                            "target_lang_translations": {
                                "en": "The smell of the spoiled meat filled him with deep <w>disgust</w>."
                            }
                        },
                        {
                            "text": "Zij keek met <w>walging</w> naar de manier waarop de dieren werden behandeld.",
                            "target_lang_translations": {
                                "en": "She looked with <w>revulsion</w> at the way the animals were treated."
                            }
                        }
                    ],
                    "synonyms": [
                        "afkeer",
                        "aversie",
                        "weerzin"
                    ],
                    "common_phrases": [
                        "diepe walging",
                        "vervuld van walging"
                    ],
                    "target_lang_definitions": {
                        "en": "A very strong aversion or repulsion that is often also felt physically."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disgust",
                                "target_lang_sense_clarification": "intense dislike or loathing for something nasty"
                            },
                            {
                                "target_lang_word": "revulsion",
                                "target_lang_sense_clarification": "a sense of physical or emotional loathing"
                            },
                            {
                                "target_lang_word": "nausea",
                                "target_lang_sense_clarification": "physical feeling of sickness caused by aversion"
                            },
                            {
                                "target_lang_word": "loathing",
                                "target_lang_sense_clarification": "extreme hatred or disgust"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5f810fd7-237c-31b7-bbe9-3eec4083ef40",
                    "sense_definition": "Een gevoel van morele verontwaardiging of sterke afkeuring tegenover iemands gedrag of een situatie.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "afkeer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het feit dat de bankiers niet werden gestraft droeg bij tot een <w>walging</w> van de politiek.",
                            "target_lang_translations": {
                                "en": "The fact that the bankers were not punished contributed to a <w>disgust</w> with politics."
                            }
                        },
                        {
                            "text": "Er heerste een algemene <w>walging</w> over de corruptie binnen het bestuur.",
                            "target_lang_translations": {
                                "en": "There was a general sense of <w>repugnance</w> regarding the corruption within the administration."
                            }
                        }
                    ],
                    "synonyms": [
                        "afkeer",
                        "weerzin"
                    ],
                    "common_phrases": [
                        "walging van de politiek"
                    ],
                    "target_lang_definitions": {
                        "en": "A feeling of moral indignation or strong disapproval toward someone's behavior or a situation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disgust",
                                "target_lang_sense_clarification": "moral outrage or strong disapproval"
                            },
                            {
                                "target_lang_word": "repugnance",
                                "target_lang_sense_clarification": "strong distaste or contradiction to one's principles"
                            },
                            {
                                "target_lang_word": "abhorrence",
                                "target_lang_sense_clarification": "feeling of extreme moral opposition"
                            },
                            {
                                "target_lang_word": "distaste",
                                "target_lang_sense_clarification": "a mild but clear feeling of dislike or disapproval"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}