                    {
                        "sense_id": "003720b5-1712-3502-a2a2-02d13fa9081f",
                        "entry_id": "5f09a791-d044-30a8-9990-79a8fbb61c46",
                        "glosses": [
                            "Pièce de monnaie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c4bcc99-b660-46c4-8d2b-52b1804c6664",
                                "sense_id": "003720b5-1712-3502-a2a2-02d13fa9081f",
                                "text": "Car celui qui « n’a plus un picaillon » est vraiment dans la misère la plus noire, le picaillon étant une petite pièce de monnaie frappée en Savoie en 1635 qui a très vite perdu toute valeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "99be1a1c-97cc-30e7-b0e3-13e87da1152a",
                        "entry_id": "5f09a791-d044-30a8-9990-79a8fbb61c46",
                        "glosses": [
                            "Argent. → voir sou"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "cbca5bc4-2704-4e4d-ab59-70cd84825da3",
                                "sense_id": "99be1a1c-97cc-30e7-b0e3-13e87da1152a",
                                "text": "Des boîtes à chansons\nQue l’on nourrit d’oseille\nOu d’accordéons,\nEt puis le patron\nQui montre ses bouteilles\nPour des picaillons…\n— (Léo Ferré)"
                            },
                            {
                                "example_id": "dfa70d0f-dd20-46aa-918f-43e28d15512e",
                                "sense_id": "99be1a1c-97cc-30e7-b0e3-13e87da1152a",
                                "text": "J'avais à peine mis sac à terre que je traînais déjà dans les bars et les tavernes des Bank's Arcades, et mes picaillons de sauter !"
                            }
                        ]
                    }
