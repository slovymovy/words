            "senses": [
                {
                    "sense_id": "bd09b3d7-a765-3654-ba14-6949f60ac413",
                    "sense_definition": "podać środek wywołujący utratę czucia bólu przed zabiegiem medycznym",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "medycyna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Przed wyrwaniem zęba dentysta musi najpierw odpowiednio <w>znieczulić</w> dziąsło pacjenta.",
                            "target_lang_translations": {
                                "ru": "Перед удалением зуба стоматолог должен сначала как следует <w>обезболить</w> десну пациента."
                            }
                        },
                        {
                            "text": "Lekarz <w>znieczulił</w> pacjenta miejscowo, dzięki czemu zabieg odbył się bezboleśnie.",
                            "target_lang_translations": {
                                "ru": "Врач сделал пациенту местную <w>анестезию</w>, благодаря чему процедура прошла безболезненно."
                            }
                        }
                    ],
                    "synonyms": [
                        "uanestetycznić"
                    ],
                    "common_phrases": [
                        "znieczulić pacjenta",
                        "znieczulić miejscowo"
                    ],
                    "target_lang_definitions": {
                        "ru": "ввести обезболивающее средство, чтобы лишить чувствительности к боли перед медицинской процедурой"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обезболить",
                                "target_lang_sense_clarification": "лишить чувства боли, сделать анестезию"
                            },
                            {
                                "target_lang_word": "анестезировать",
                                "target_lang_sense_clarification": "провести медицинскую анестезию"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35c32e80-1e5e-32fe-afc7-68dcac3bd194",
                    "sense_definition": "uczynić kogoś niewrażliwym na ból, cierpienie lub krzywdę innych",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Codzienny kontakt z przemocą w mediach może <w>znieczulić</w> młodych ludzi na ludzkie cierpienie.",
                            "target_lang_translations": {
                                "ru": "Ежедневный контакт с насилием в медиа может <w>сделать</w> молодых людей <w>бесчувственными</w> к человеческим страданиям."
                            }
                        },
                        {
                            "text": "Trudne doświadczenia życiowe <w>znieczuliły</w> go na cudze problemy i troski.",
                            "target_lang_translations": {
                                "ru": "Трудный жизненный опыт <w>ожесточил</w> его к чужим проблемам и заботам."
                            }
                        }
                    ],
                    "synonyms": [
                        "otępić",
                        "uzbroić"
                    ],
                    "antonyms": [
                        "uwrażliwić"
                    ],
                    "common_phrases": [
                        "znieczulić na ból",
                        "znieczulić na krzywdę",
                        "znieczulić na cierpienie"
                    ],
                    "target_lang_definitions": {
                        "ru": "сделать кого-либо нечувствительным, равнодушным к чужой боли, страданиям или несправедливости"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ожесточить",
                                "target_lang_sense_clarification": "сделать чёрствым, безжалостным"
                            },
                            {
                                "target_lang_word": "притупить чувства",
                                "target_lang_sense_clarification": "сделать менее восприимчивым к переживаниям"
                            },
                            {
                                "target_lang_word": "сделать бесчувственным",
                                "target_lang_sense_clarification": "лишить душевной чуткости и сострадания"
                            }
                        ]
                    }
                }
            ]
        }
    ]
