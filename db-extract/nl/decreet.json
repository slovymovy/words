                "translations": [
                    {
                        "translation_id": "e3a281d2-5ca3-438f-9e8c-5d9c8bf5a8fd",
                        "source_entry_id": "7567e9d4-26a9-346c-852f-cb3448d973b2",
                        "source_sense_id": "0f83f957-a56f-3c75-9545-99b4ad27c09d",
                        "source_sense_description": "Dekret, Erlass",
                        "target_lang_word": "Dekret",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dekret",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "54771ac8-958a-348f-b4ff-2b53a0d389ef",
                                        "entry_id": "52e69ac3-46e2-38de-9e6b-36d56f488d79",
                                        "glosses": [
                                            "(behördliche/richterliche) Verfügung oder Verordnung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ba8600-2e8b-466a-bf2b-f9e77b728c71",
                                                "sense_id": "54771ac8-958a-348f-b4ff-2b53a0d389ef",
                                                "text": "„In denselben Morgenstunden des 26. [Oktober 1917], als der [Begriff, Rang] ›Volkskommissar‹ das Licht der Welt erblickte, nahmen auch die Dekrete Gestalt an, die zu allererst zu verabschieden waren: die Dekrete über Land und Frieden.“"
                                            },
                                            {
                                                "example_id": "f8b3d76b-76d1-4d95-a2ff-09e306590224",
                                                "sense_id": "54771ac8-958a-348f-b4ff-2b53a0d389ef",
                                                "text": "„Staatspräsidenten Bachelet erließ anlässlich der Jahrestagung der Internationalen Walfangkommission (IWC) in der chilenischen Hauptstadt Santiago ein Dekret, dem zufolge vor der langgezogenen Küste des südamerikanischen Landes nie mehr Meeressäuger gejagt werden dürfen.“"
                                            },
                                            {
                                                "example_id": "d6ea3835-5b45-472a-878c-97d92d105c40",
                                                "sense_id": "54771ac8-958a-348f-b4ff-2b53a0d389ef",
                                                "text": "„Aus Prag kamen immer neue Dekrete, die die Deutschen entrechteten, die so schnell gar nicht umzusetzen waren.“"
                                            },
                                            {
                                                "example_id": "a365d9b9-354a-48d9-8f44-166faf7ef675",
                                                "sense_id": "54771ac8-958a-348f-b4ff-2b53a0d389ef",
                                                "text": "„Gesetzestexte, die sich auf Vorgänge des modernen Wirtschafts-, Finanz- und Alltagslebens beziehen, werden von islamischen Rechtsgelehrten auf ihre Vereinbarkeit mit der Scharia geprüft, bevor sie durch königliches Dekret wirksam werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c566459-fac8-4a6f-b496-96f27a7b7cbb",
                        "source_entry_id": "7567e9d4-26a9-346c-852f-cb3448d973b2",
                        "source_sense_id": "0f83f957-a56f-3c75-9545-99b4ad27c09d",
                        "source_sense_description": "Dekret, Erlass",
                        "target_lang_word": "Erlass",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erlass",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1322ec52-2551-3f13-bdc6-a664ba4bc2dc",
                                        "entry_id": "f312ab4d-f2c4-3d9a-af82-7b9144ba3e33",
                                        "glosses": [
                                            "Anordnung, Anweisung mit amtlichem Charakter"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9505b8c-8e6a-4622-9b7a-15c35ba64cfa",
                                                "sense_id": "1322ec52-2551-3f13-bdc6-a664ba4bc2dc",
                                                "text": "Viele Dinge werden amtlich durch Erlass geregelt."
                                            },
                                            {
                                                "example_id": "0af81760-352f-442f-bf9b-ff4e4d17f8a1",
                                                "sense_id": "1322ec52-2551-3f13-bdc6-a664ba4bc2dc",
                                                "text": "Die Regierung verkündete einen Erlass, um das Problem zu beheben."
                                            },
                                            {
                                                "example_id": "00990387-2568-4a17-8bfe-9afd269c0e78",
                                                "sense_id": "1322ec52-2551-3f13-bdc6-a664ba4bc2dc",
                                                "text": "„Dann greift ein Erlass vom April 1940: »Mischlinge ersten Grades« und »jüdisch Versippte« sind aus der Wehrmacht auszuschließen.“"
                                            },
                                            {
                                                "example_id": "41a97e3d-bbd0-48aa-b454-e36f05b0d6a5",
                                                "sense_id": "1322ec52-2551-3f13-bdc6-a664ba4bc2dc",
                                                "text": "„Seine Erlasse übertreffen alles.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0489151a-2712-3f9d-8a9d-fa230325e286",
                                        "entry_id": "f312ab4d-f2c4-3d9a-af82-7b9144ba3e33",
                                        "glosses": [
                                            "Befreiung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c69df9cc-d710-48cf-86c7-f79a7a21dbcd",
                                                "sense_id": "0489151a-2712-3f9d-8a9d-fa230325e286",
                                                "text": "Man kam ihm durch Erlass eines Teils der Strafe entgegen."
                                            }
