                    "sense_definition": "als höfliche und formelle Aufforderung oder Bitte an eine Person gebraucht werden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "aufforderung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Wollen</w> Sie bitte kurz im Wartezimmer Platz nehmen?"
