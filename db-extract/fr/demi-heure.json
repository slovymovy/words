                                        "sense_id": "16ae2d45-0e96-31fc-a8ea-8fcae73b1324",
                                        "entry_id": "c1df5070-c6e8-3ff5-b9eb-407f36cdedf2",
                                        "glosses": [
                                            "A period of time equal to thirty minutes, half an hour."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2052ef1-b290-3596-8b0d-559b90eceabb",
                                        "entry_id": "c1df5070-c6e8-3ff5-b9eb-407f36cdedf2",
                                        "glosses": [
                                            "The time of thirty minutes past any particular hour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4d1b61c-3ddf-43ff-b20f-0344f2b1eec1",
                                                "sense_id": "b2052ef1-b290-3596-8b0d-559b90eceabb",
                                                "text": "The great clock of the castle sounded the half-hour—he had another half-hour to wait, ere the approach of Count Deckendorff; […]"
                                            },
                                            {
                                                "example_id": "c127bab9-3788-4081-8ac3-ba2bec5683ac",
                                                "sense_id": "b2052ef1-b290-3596-8b0d-559b90eceabb",
                                                "text": "India’s half-hour zone dates back to colonial rule of India and the era when ever-faster steamships and trains were shrinking the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38dcfeab-e456-4106-bb30-361756413b2a",
                        "source_entry_id": "cefb9282-f281-3702-9e46-6dec55fbc520",
                        "source_sense_id": "a2480dfa-5c74-3f0e-95e6-011572cd0fda",
                        "target_lang_word": "half an hour",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "half an hour",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e46355d-a7dc-3c9c-8328-3db9536cc8e4",
                                        "entry_id": "ecde957f-cb65-3240-93fd-a9322e5bef71",
                                        "glosses": [
                                            "Thirty minutes."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d593f282-28e3-4ae3-9c59-190b2c4e7692",
                                                "sense_id": "3e46355d-a7dc-3c9c-8328-3db9536cc8e4",
                                                "text": "I'll be there in half an hour."
                                            },
                                            {
                                                "example_id": "77323ae8-a133-4943-8ae5-66cd7ef97e90",
                                                "sense_id": "3e46355d-a7dc-3c9c-8328-3db9536cc8e4",
                                                "text": "And whẽ he had opened the ſeventhe ſeale / there was ſilence in heven aboute the ſpace of halfe an houre /"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bfc06d58-49ea-41a3-bdb5-e80e231c0f3c",
                        "source_entry_id": "cefb9282-f281-3702-9e46-6dec55fbc520",
                        "source_sense_id": "a2480dfa-5c74-3f0e-95e6-011572cd0fda",
