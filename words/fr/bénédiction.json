    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8bd12008-4503-34af-a045-ab6279b957de",
                    "sense_definition": "Grâce ou faveur divine, et par extension événement très heureux ou chance inespérée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bienfait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'arrivée de la pluie après plusieurs mois de sécheresse a été une véritable <w>bénédiction</w> pour la région."
                        },
                        {
                            "text": "Trouver ce travail près de chez lui a été une grande <w>bénédiction</w> pour sa vie de famille."
                        }
                    ],
                    "antonyms": [
                        "malédiction"
                    ],
                    "common_phrases": [
                        "véritable bénédiction",
                        "bénédiction du ciel"
                    ]
                },
                {
                    "sense_id": "da57ff63-d820-3d1e-a91b-0d5210c6051e",
                    "sense_definition": "Geste rituel ou parole par lesquels un ministre du culte appelle la protection divine sur une personne ou un objet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le prêtre a levé la main droite pour donner sa <w>bénédiction</w> à l'assemblée recueillie."
                        },
                        {
                            "text": "Les jeunes mariés se sont agenouillés devant l'autel afin de recevoir la <w>bénédiction</w> nuptiale."
                        }
                    ],
                    "antonyms": [
                        "malédiction"
                    ],
                    "common_phrases": [
                        "donner la bénédiction",
                        "recevoir la bénédiction",
                        "bénédiction nuptiale"
                    ]
                },
                {
                    "sense_id": "0f9efee4-103f-38cd-9b7d-65beae29ff7e",
                    "sense_definition": "Accord solennel, approbation morale ou consentement accordé par les parents ou des proches.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consentement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est allé rendre visite à ses beaux-parents pour demander leur <w>bénédiction</w> avant le mariage."
                        },
                        {
                            "text": "Elle a créé son entreprise avec la <w>bénédiction</w> et les encouragements constants de toute sa famille."
                        }
                    ],
                    "common_phrases": [
                        "demander la bénédiction",
                        "avec la bénédiction de"
                    ]
                },
                {
                    "sense_id": "f900f197-f70b-396e-958d-76c91687ae9d",
                    "sense_definition": "Vœux fervents ou souhaits de bonheur et de prospérité adressés à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "souhait",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants ont comblé de <w>bénédictions</w> le médecin qui avait soigné tout le village gratuitement."
                        },
                        {
                            "text": "Pour son départ à la retraite, ses collègues lui ont adressé mille <w>bénédictions</w> sincères."
                        }
                    ],
                    "antonyms": [
                        "malédiction"
                    ],
                    "common_phrases": [
                        "combler de bénédictions"
                    ]
                },
                {
                    "sense_id": "15663d57-ca4d-38dd-ac5a-87c513c0e3a2",
                    "sense_definition": "Grande abondance ou excès d'une chose désagréable et pénible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce matin-là, il neigeait que c'était une <w>bénédiction</w>, impossible de sortir la voiture."
                        },
                        {
                            "text": "Toute la journée, les reproches lui sont tombés dessus que c'en était une <w>bénédiction</w>."
                        }
                    ],
                    "common_phrases": [
                        "que c'est une bénédiction"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "tournure ironique ancienne"
                        }
                    ]
                }
            ]
        }
