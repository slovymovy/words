                    }
                ],
                "senses": [
                    {
                        "sense_id": "550d9d06-64ad-35a8-ac86-01e0d437e0ad",
                        "entry_id": "37694ab1-eba1-3d61-b3f4-4434ef96c0b2",
                        "glosses": [
                            "произвести умножение"
                        ],
                        "tags": [],
