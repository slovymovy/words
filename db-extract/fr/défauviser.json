                "senses": [
                    {
                        "sense_id": "1a9af43d-4a5e-3947-b807-544d5a7d4a05",
                        "entry_id": "064fc298-d85e-3599-8185-2e88ec410dac",
                        "glosses": [
                            "Enlever les fauves d’un endroit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a87f37ca-c9d5-4fac-8b1d-ea8f6724978a",
                                "sense_id": "1a9af43d-4a5e-3947-b807-544d5a7d4a05",
                                "text": "Et la France éternelle s’est mis à fabriquer des tigres pour les revendre à ces contrées défauvisées aux fins de rétablissement de l’équilibre originel."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6a15dc9-7626-35ce-ad38-642cefaafea3",
                        "entry_id": "064fc298-d85e-3599-8185-2e88ec410dac",
                        "glosses": [
                            "Faire perdre son caractère fauve à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dbf5b92-3c03-491b-af68-59cada0392fa",
                                "sense_id": "f6a15dc9-7626-35ce-ad38-642cefaafea3",
                                "text": "Poor Martin, désoursisé, défauvisé, déchu, privé de neige et de soleil, de saumon et de baies, de courses dans l’eau rouge du gave et dans celle – blanche – de la Mac Neil river !"
                            },
                            {
                                "example_id": "66e5e2ac-d762-44b7-a8bf-21d25c7dfe81",
                                "sense_id": "f6a15dc9-7626-35ce-ad38-642cefaafea3",
                                "text": "Quand on aime le fier félin Le fauve sauvage que l’on jalouse On veut l’apprivoiser Le caresser Le domestiquer Le dresser Le faire obéir Le faire parader Et marcher Et galoper Et aller ensemble l’HUMANISER Le défauviser en somme !"
                            }
                        ]
                    }
