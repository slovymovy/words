                    {
                        "sense_id": "3165a33c-9f37-3644-a965-7813db70d414",
                        "entry_id": "5c9baa25-3e6c-3000-8a13-e1138325d2bb",
                        "glosses": [
                            "Gebäude, gewerbliches Unternehmen, in dem um Geld gespielt wird"
