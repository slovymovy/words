                                        "entry_id": "c163d62b-a840-3dc8-b4c2-7dfa299807ed",
                                        "glosses": [
                                            "To draw inward using suction. Used other than figuratively or idiomatically: see suck, in."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2aa7ffc4-c256-4780-b39e-14aad4d4a3a9",
                                                "sense_id": "8e5b6616-59ff-3023-9000-ea3c4160b471",
                                                "text": "This is the component of the vacuum cleaner that sucks in dust."
                                            },
                                            {
                                                "example_id": "00ad0c1d-214d-439c-9e41-c699924a2a4e",
                                                "sense_id": "8e5b6616-59ff-3023-9000-ea3c4160b471",
                                                "text": "I sucked in my belly, hoping to hide the extra weight I had put on over the holidays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff03f153-2b20-3826-b37e-a400e8252611",
                                        "entry_id": "c163d62b-a840-3dc8-b4c2-7dfa299807ed",
                                        "glosses": [
                                            "To cause (someone) to become slowly more and more involved in some business or situation that may not be to their advantage."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e12de49a-4067-47cf-8595-e05479334f32",
                                                "sense_id": "ff03f153-2b20-3826-b37e-a400e8252611",
                                                "text": "I really didn't want to be on the committee, but somehow I got sucked in."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
