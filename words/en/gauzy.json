{
    "word_family": [
        "gauze",
        "gauzily",
        "gauziness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c5978e51-0b16-38bd-8954-00ef1928409e",
                    "sense_definition": "Resembling gauze; very light, thin, and translucent.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "texture_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a light dress made of a <w>gauzy</w> fabric that drifted in the summer breeze.",
                            "target_lang_translations": {
                                "ru": "На ней было лёгкое платье из <w>полупрозрачной</w> ткани, колыхавшейся на летнем ветру."
                            }
                        },
                        {
                            "text": "Sunlight filtered through the <w>gauzy</w> curtains, illuminating dust motes in the quiet room.",
                            "target_lang_translations": {
                                "ru": "Солнечный свет пробивался сквозь <w>газовые</w> занавески, освещая пылинки в тихой комнате."
                            }
                        }
                    ],
                    "synonyms": [
                        "gauzelike"
                    ],
                    "common_phrases": [
                        "gauzy fabric",
                        "gauzy curtains"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий марлю или газ; очень тонкий, лёгкий и полупрозрачный (о ткани, материале)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "газовый",
                                "target_lang_sense_clarification": "сделанный из газа (лёгкой ткани)"
                            },
                            {
                                "target_lang_word": "марлевый",
                                "target_lang_sense_clarification": "похожий на марлю"
                            },
                            {
                                "target_lang_word": "полупрозрачный",
                                "target_lang_sense_clarification": "просвечивающий, тонкий"
                            },
                            {
                                "target_lang_word": "легкий",
                                "target_lang_sense_clarification": "тонкий и воздушный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ffcb555-5322-3d64-815b-5da6ab81b6d2",
                    "sense_definition": "Light and misty, creating the visual effect of haze.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "texture_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>gauzy</w> morning mist hung low over the surface of the quiet lake.",
                            "target_lang_translations": {
                                "ru": "<w>Полупрозрачный</w> утренний туман низко навис над гладью тихого озера."
                            }
                        },
                        {
                            "text": "Through the <w>gauzy</w> haze of the afternoon heat, the mountains appeared indistinct.",
                            "target_lang_translations": {
                                "ru": "Сквозь <w>зыбкую</w> дымку полуденного зноя горы казались нечёткими."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gauzy mist",
                        "gauzy haze"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лёгкий, туманный и полупрозрачный, создающий эффект дымки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "похожий на дымку"
                            },
                            {
                                "target_lang_word": "пеленистый",
                                "target_lang_sense_clarification": "покрытый легкой пеленой"
                            },
                            {
                                "target_lang_word": "призрачный",
                                "target_lang_sense_clarification": "едва различимый сквозь дымку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "420a88d1-31a1-3d36-83f6-98910f762023",
                    "sense_definition": "Lacking clarity or precision; vague, indistinct, or elusive.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_qualities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The candidate hid his controversial views behind <w>gauzy</w> rhetoric about unity and progress.",
                            "target_lang_translations": {
                                "ru": "Кандидат скрывал свои неоднозначные взгляды за <w>туманной</w> риторикой о единстве и прогрессе."
                            }
                        },
                        {
                            "text": "She retained only a <w>gauzy</w> memory of her early childhood in the countryside.",
                            "target_lang_translations": {
                                "ru": "Она сохранила лишь <w>смутные</w> воспоминания о своём раннем детстве в деревне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gauzy rhetoric",
                        "gauzy language"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лишённый чёткости или определённости; смутный, расплывчатый, неясный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смутный",
                                "target_lang_sense_clarification": "неясный, размытый"
                            },
                            {
                                "target_lang_word": "туманный",
                                "target_lang_sense_clarification": "неопределенный, двусмысленный"
                            },
                            {
                                "target_lang_word": "расплывчатый",
                                "target_lang_sense_clarification": "лишённый точности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5d99375-a1a9-3526-9176-93444cdd9d5f",
                    "sense_definition": "Romanticized, nostalgically tender, or sentimental rather than realistic.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_qualities",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The memoir presented a <w>gauzy</w> portrait of family life that ignored their real hardships.",
                            "target_lang_translations": {
                                "ru": "В мемуарах был представлен <w>идеализированный</w> портрет семейной жизни, в котором игнорировались их реальные трудности."
                            }
                        },
                        {
                            "text": "Critics dismissed the film as a <w>gauzy</w> romance with very little emotional depth.",
                            "target_lang_translations": {
                                "ru": "Критики охарактеризовали фильм как <w>сентиментальную</w> мелодраму, лишённую какой-либо эмоциональной глубины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gauzy nostalgia",
                        "gauzy portrait"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезмерно идеализированный, сентиментальный или ностальгический, далёкий от реальности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "идеализированный",
                                "target_lang_sense_clarification": "приукрашенный"
                            },
                            {
                                "target_lang_word": "сентиментальный",
                                "target_lang_sense_clarification": "чрезмерно чувствительный"
                            },
                            {
                                "target_lang_word": "романтизированный",
                                "target_lang_sense_clarification": "лишённый реализма"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}