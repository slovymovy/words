                "senses": [
                    {
                        "sense_id": "ce752c10-263e-392b-819a-b3d49d569e79",
                        "entry_id": "d0970a14-dd65-3375-b825-56854ac8a2b7",
                        "glosses": [
                            "eine westgermanische Sprache, die in der polnischen Stadt Wilmesau (Wilamowice) gesprochen wird, die sich aus einem mitteldeutschen Dialekt entwickelt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "649b1f0e-a808-4f09-a7ba-a5e1c4adb773",
                                "sense_id": "ce752c10-263e-392b-819a-b3d49d569e79",
                                "text": "„Nicht nur Ladinisch, auch zahlreiche andere Regional- und Minderheitensprachen in Europa geraten zunehmend in Vergessenheit. Manche von ihnen, wie etwa Livisch oder Wilmesaurisch, werden sogar nur noch von einer Handvoll Menschen gesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
