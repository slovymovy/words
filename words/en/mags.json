                            "target_lang_translations": {
                                "ru": "Она провела весь день, читая глянцевые <w>журналы</w> в ожидании приема."
                            }
                        },
                        {
                            "text": "I need to clear out those old <w>mags</w> from the coffee table.",
                            "target_lang_translations": {
                                "ru": "Мне нужно убрать те старые <w>журнальчики</w> с журнального столика."
                            }
                        }
                    ],
                    "synonyms": [
                        "magazines",
                        "periodicals"
                    ],
                    "common_phrases": [
