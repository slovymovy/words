                    "sense_definition": "Magasin où se vendent toutes sortes d'articles divers et bon marché.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a trouvé un seau en plastique dans un petit <w>bazar</w> de plage.",
                            "target_lang_translations": {
                                "en": "She found a plastic bucket in a small beach <w>bazaar</w>.",
                                "ru": "Она нашла пластиковое ведро в маленькой пляжной <w>лавке</w>.",
                                "de": "Sie fand einen Plastikeimer in einem kleinen <w>Ramschladen</w> am Strand.",
                                "es": "Encontró un cubo de plástico en un pequeño <w>bazar</w> de playa.",
                                "zh": "她在海边的一家小<w>杂货店</w>里找到了一个塑料桶。"
                            }
