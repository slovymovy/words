                "senses": [
                    {
                        "sense_id": "df16a4b5-a900-340f-a91d-7f3de8478916",
                        "entry_id": "1142f84a-f1fe-3be3-ac30-f2f8a4df0d20",
                        "glosses": [
                            "Donner un caractère potache à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e2305ea-f838-4e8c-bdc4-c8d91b864914",
                                "sense_id": "df16a4b5-a900-340f-a91d-7f3de8478916",
                                "text": "Mais la mise en scène, Edouard, comment peux-tu renoncer, comment peux-tu potachiser tout, réduire tes ambitions pourtant là, semble-t-il, tout abandonner et laisser aller, jusqu'à détruire irrémédiablement tes qualités ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "226b3770-402c-3d63-800a-7d47838dbcc4",
                        "entry_id": "1142f84a-f1fe-3be3-ac30-f2f8a4df0d20",
                        "glosses": [
                            "Se comporter en potache."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "2cec1013-17be-405e-8470-ca8161deb5db",
                                "sense_id": "226b3770-402c-3d63-800a-7d47838dbcc4",
                                "text": "Quand ses concurrents paraissent jouer leur vie, lui blague, potachise et se refuse à «jouer le jeu»."
                            },
                            {
                                "example_id": "54a33465-b080-4449-abcf-b797e041618e",
                                "sense_id": "226b3770-402c-3d63-800a-7d47838dbcc4",
                                "text": "Après tout, nous aussi nous pouvons potachiser."
                            }
                        ]
                    }
                ],
