                                "target_senses": [
                                    {
                                        "sense_id": "584f4550-c691-38c9-887f-b5574012eceb",
                                        "entry_id": "d023e78f-b0cd-374c-82fa-12feb37a169e",
                                        "glosses": [
                                            "nicht ersetzbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56d965aa-c07e-438d-988a-528fff7dfc36",
                                                "sense_id": "584f4550-c691-38c9-887f-b5574012eceb",
                                                "text": "„Keine Mathematik wird jemals diese Linienbeugungen, keine Chemie diese Farbenmischungen berechnen. Und wenn die Industrie noch so weit ausgebildet wird und alle menschliche Arbeitskraft und Geschicklichkeit ersetzt, für Gemälde wird man niemals Maschinen und Fabriken errichten; der Künstler bleibt ewig einzig, ewig unersetzbar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
