                    {
                        "translation_id": "7fdc8e79-6b71-4615-896c-e570533a2c28",
                        "source_entry_id": "4cfb23f2-01d0-3303-aac4-ea4733284216",
                        "source_sense_id": "4864bda8-2d04-320c-a0be-c0e542dd408b",
                        "source_sense_description": "Traduction de la langue chaoui",
                        "target_lang_word": "шауйя",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "шауйя",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "01e5eecc-ae3d-3730-8b5d-4a61733a4330",
                                        "entry_id": "6794a3aa-6438-385b-8a8a-77af4ce58922",
                                        "glosses": [
                                            "этногр. народность населяющая большую часть востока Алжира, в основном горный регион Орес, одна из этнических групп берберских народов Алжира"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50fad7c1-3ecd-4474-a58e-6ae89fcdc23b",
                                                "sense_id": "01e5eecc-ae3d-3730-8b5d-4a61733a4330",
                                                "text": "Шауйя наряду с земледелием занимаются скотоводством. На юге ещё много полукочевников. Шауйя — мусульмане, но сохранившие некоторые обычаи от язычества, в том числе магические ритуалы, которые практикуют женщины."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13b41e5d-d09e-3997-b5d5-b4f9ef01d153",
                                        "entry_id": "6794a3aa-6438-385b-8a8a-77af4ce58922",
                                        "glosses": [
                                            "лингв. язык зенетской группы северноберберской ветви берберо-ливийской семьи, распространённый в северо-восточной части Алжира (на границе с Тунисом) — главным образом в горах Орес"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3c396e1-a88c-484a-a4d7-f82b45c8455a",
                                                "sense_id": "13b41e5d-d09e-3997-b5d5-b4f9ef01d153",
                                                "text": "Берберские языки, или диалекты (кабильский, шильх, тамазигхт, шауйя и др.), сохранились лишь в горных областях Магриба и оазисах Сахары, но большинство их носителей говорит также по-арабски."
                                            },
                                            {
                                                "example_id": "a073f582-f25d-4e7b-a2e8-6338310bf5da",
                                                "sense_id": "13b41e5d-d09e-3997-b5d5-b4f9ef01d153",
                                                "text": "Бер­бер­ская (бер­бе­ро-ли­вий­ская) се­мья вклю­ча­ет мно­го­числ. язы­ки и диа­лек­ты бер­бе­ров. Их осн. вет­ви: та­шель­хит (шильх, шлух, шлёх); зе­нет­ская (риф­ский, сен­хайя, ка­биль­ский, ша­уйя, мзаб­ский и др.); не­фу­са, га­да­мес, си­ва и др.; туа­рег­ская (гат, та­ма­шек, та­нес­лемт и др.); зе­на­га."
                                            },
                                            {
                                                "example_id": "6e96b5ed-2f11-4129-bff4-26e43a671c98",
                                                "sense_id": "13b41e5d-d09e-3997-b5d5-b4f9ef01d153",
                                                "text": "В Алжире распространены следующие языки: алжирский арабский со своими местными разновидностями (80%), «классический» арабский, берберские 20% (тамазигхт, кабильский, шауйя)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
