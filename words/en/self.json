                            },
                            {
                                "target_lang_word": "内在自我",
                                "target_lang_sense_clarification": "强调内在精神层面的自己"
                            },
                            {
                                "target_lang_word": "自我认同",
                                "target_lang_sense_clarification": "如“自我认同”中所指的个人主体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "11595a6c-96f8-3a94-af66-63dbb4442812",
                    "sense_definition": "Personal interest or advantage, often pursued without regard for others.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "interest",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His actions were motivated purely by <w>self</w> rather than the good of the community.",
                            "target_lang_translations": {
                                "ru": "Его действия были мотивированы исключительно <w>личной выгодой</w>, а не благом общества.",
                                "zh": "他的行为完全出于<w>私利</w>，而不是为了社区的福祉。"
                            }
                        },
                        {
                            "text": "She learned to put <w>self</w> aside to care for her family.",
                            "target_lang_translations": {
                                "ru": "Она научилась откладывать <w>собственные интересы</w> в сторону ради заботы о семье.",
                                "zh": "她学会了放下<w>私心</w>来照顾家人。"
                            }
