                "translations": [
                    {
                        "translation_id": "fd3f0d81-4a28-4776-90df-6bd61cf712f3",
                        "source_entry_id": "f1332088-11ac-3bd8-964f-71dee9487640",
                        "source_sense_id": "47cc8827-1121-3ae9-82c2-00814d49bae7",
                        "source_sense_description": "een klank waarbij de lucht niet ongehinderd door de mond naar buiten kan",
                        "target_lang_word": "consonant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consonant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5160a313-ba13-3537-a0af-483b463284c9",
                                        "entry_id": "340229e4-1a82-32dd-ad76-0b078e1332ac",
                                        "glosses": [
                                            "A sound that results from the passage of air through restrictions of the oral cavity; any sound that is not the dominant sound of a syllable, the dominant sound generally being a vowel."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83b7189d-43fb-3ab4-97b1-ac37b899804e",
                                        "entry_id": "340229e4-1a82-32dd-ad76-0b078e1332ac",
                                        "glosses": [
                                            "A letter representing the sound of a consonant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0a6c459-5e86-400c-9691-e260a59d8143",
                                                "sense_id": "83b7189d-43fb-3ab4-97b1-ac37b899804e",
                                                "text": "Thus, when he drew up instructions in lawyer language, he expressed the important words by an initial, a medial, or a final consonant, and made scratches for all the words between; his clerks, however, understood him very well."
                                            },
                                            {
                                                "example_id": "42f812b6-55b7-4971-86a9-32be381926ff",
                                                "sense_id": "83b7189d-43fb-3ab4-97b1-ac37b899804e",
                                                "text": "“Tell me, has right anything to do with the law?” I asked. “You have used the wrong initial consonant,” he smiled in answer. “Might?” I queried; and he nodded his head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "consonant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                                        "entry_id": "8b4c7b5c-a346-3f58-aefd-e07a42687080",
                                        "glosses": [
                                            "Consistent, harmonious, compatible, or in agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5431be5d-234d-41e8-9a81-bd014e916558",
                                                "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                                                "text": "Each one pretends that his opinion […] is consonant to the words there used."
                                            },
                                            {
                                                "example_id": "94b80e69-fb7b-471f-a6de-02361b703345",
                                                "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                                                "text": "Cheerfulness, even gaiety, is consonant with every species of virtue and practice of religion, and I think it inconsistent only with impiety and vice."
                                            },
                                            {
                                                "example_id": "0202e40e-1bcc-4a5e-9e00-718b143545c5",
                                                "sense_id": "5fa29745-1c58-3772-bcdf-7acbf265dcf4",
                                                "text": "This essential right of the courts to be free of intimidation and coercion was held to be consonant with a recognition that freedom of the press must be allowed in the broadest scope compatible with the supremacy of order."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "caea22e6-9589-3fc1-9a57-fca136a1edb9",
                                        "entry_id": "8b4c7b5c-a346-3f58-aefd-e07a42687080",
                                        "glosses": [
                                            "Having the same sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04543379-20f4-4ecb-8920-5d4b0d19219d",
                                                "sense_id": "caea22e6-9589-3fc1-9a57-fca136a1edb9",
                                                "text": "1645-1650, James Howell, Epistolae Ho-Elianae\nconsonant words and syllables"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51135789-bda1-3be6-8dd5-5b7b734705fc",
                                        "entry_id": "8b4c7b5c-a346-3f58-aefd-e07a42687080",
                                        "glosses": [
                                            "Harmonizing together; accordant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b135e90-384c-4dea-8bde-ab36cd9297f4",
                                                "sense_id": "51135789-bda1-3be6-8dd5-5b7b734705fc",
                                                "text": "consonant tones; consonant chords"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e967bab-1c95-396f-acc1-0eddcd91b762",
                                        "entry_id": "8b4c7b5c-a346-3f58-aefd-e07a42687080",
                                        "glosses": [
                                            "Of or relating to consonants; made up of, or containing many, consonants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1cc5d0b-fb9a-43fb-9cb6-a346b3a77fda",
                                                "sense_id": "0e967bab-1c95-396f-acc1-0eddcd91b762",
                                                "text": "No Russian whose dissonant consonant name / Almost shatters to fragments the trumpet of fame."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25b44997-32db-434b-82b3-cfbbda2ac356",
                        "source_entry_id": "f1332088-11ac-3bd8-964f-71dee9487640",
                        "source_sense_id": "47cc8827-1121-3ae9-82c2-00814d49bae7",
                        "source_sense_description": "een klank waarbij de lucht niet ongehinderd door de mond naar buiten kan",
                        "target_lang_word": "consonne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "93a8256e-d1b8-33ce-9eff-885d69b78490",
                                        "entry_id": "c40eeffd-a99c-397d-9abe-ca086cc9cbbd",
                                        "glosses": [
                                            "Son de la voix produit par les différents organes de la bouche et qui en sort plus ou moins librement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779a53b2-cce7-4247-919d-68df67e489c1",
                                                "sense_id": "93a8256e-d1b8-33ce-9eff-885d69b78490",
                                                "text": "Toutes les consonnes qu’il ne pouvait prononcer figuraient comme autant de duretés dont il était incapable."
                                            },
                                            {
                                                "example_id": "f7d2d3f7-eb48-4602-a0d1-d7bb24db726b",
                                                "sense_id": "93a8256e-d1b8-33ce-9eff-885d69b78490",
                                                "text": "Du point de vue articulatoire, la différence fondamentale entre voyelles et consonnes est la suivante : alors que, pour les voyelles, l’air laryngé ne rencontre aucun obstacle, pour les consonnes, il y a toujours un obstacle, que ce soit un rétrécissement du canal buccal ou une obstruction complète, mais momentanée."
                                            },
                                            {
                                                "example_id": "70eff3c5-77b1-41c6-bab4-b512f7aae34a",
                                                "sense_id": "93a8256e-d1b8-33ce-9eff-885d69b78490",
                                                "text": "Je propose d’appeler « notes inouïes » ces sons écrits injouables qui font penser à ce que les grammairiens nomment les consonnes ineffables » (le p dans sept)."
                                            },
                                            {
                                                "example_id": "167e5f64-5600-4932-a113-4b2ac3bdfc6e",
                                                "sense_id": "93a8256e-d1b8-33ce-9eff-885d69b78490",
                                                "text": "Les consonnes subissent dans les langues celtiques divers traitements linguistiques dont la lénition interne. Ainsi les noms Péron, Pédron, Pezdron et Pezron sont tous des variantes d'un nom latin initialPetronem. Hormis le premier nom, les autres sont des archaïsmes."
                                            },
                                            {
                                                "example_id": "58985e50-7c09-4e58-9255-1e8a62f84673",
                                                "sense_id": "93a8256e-d1b8-33ce-9eff-885d69b78490",
                                                "text": "Les consonnes \\b\\, \\p\\ sont formées par le desserrement brusque des lèvres qui laissent passer le son."
                                            },
                                            {
                                                "example_id": "43b68fda-ac91-4f98-9da2-66a93926227d",
                                                "sense_id": "93a8256e-d1b8-33ce-9eff-885d69b78490",
                                                "text": "La consonne \\t\\ se prononce en appuyant la langue contre la rangée inférieure des dents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce399a2b-7367-3caa-8926-8984dd4c16d6",
                                        "entry_id": "c40eeffd-a99c-397d-9abe-ca086cc9cbbd",
                                        "glosses": [
                                            "Désigne aussi les lettres de l’alphabet autres que les voyelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db821e31-5366-4972-a436-7bb37559bdd1",
                                                "sense_id": "ce399a2b-7367-3caa-8926-8984dd4c16d6",
                                                "text": "En français, les consonnes sont : B C D F G H J K L M N P Q R S T V W X Z."
                                            },
                                            {
                                                "example_id": "3a9d6a5a-cc6a-4101-afc6-dc3eeecd44cf",
                                                "sense_id": "ce399a2b-7367-3caa-8926-8984dd4c16d6",
                                                "text": "Ajoutons ici que l’alphabet zend est composé de quarante-huit caractères, dont trente-deux consonnes et seize voyelles, nombre presque égal à celui des lettres qui composent l’alphabet dêvanâgary, qui a seize voyelles et trente-quatre consonnes."
                                            }
                                        ]
                                    }
                                ]
                            },
