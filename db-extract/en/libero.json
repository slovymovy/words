                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a1700238-6f0f-3a57-b72f-c4133c4349cf",
                                        "entry_id": "7bec4ee6-808e-35b6-a63d-07fa5c48beb7",
                                        "glosses": [
                                            "Défenseur évoluant librement devant le gardien de but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53525261-4653-4660-a09d-4959b8577fc0",
                                                "sense_id": "a1700238-6f0f-3a57-b72f-c4133c4349cf",
                                                "text": "Le libéro a un rôle d’essuie-glace, il est là pour couvrir ses trois autres défenseurs en cas d’erreur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
