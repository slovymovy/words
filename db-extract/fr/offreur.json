                                "target_senses": [
                                    {
                                        "sense_id": "2247e91d-b85d-3900-b712-d09fc52f130c",
                                        "entry_id": "19d4f203-c052-3b05-9cb9-f413a31ee07f",
                                        "glosses": [
                                            "iemand die beroepshalve een advies, dienst of een product ter beschikking stelt"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e26a9ce-cbb3-422d-8883-be325dfc838b",
                                                "sense_id": "2247e91d-b85d-3900-b712-d09fc52f130c",
                                                "text": "De twee grootste gemeenten van Denemarken zijn hun samenwerking met Microsoft aan het uitfaseren vanwege het behoud van digitale soevereiniteit. Het Amerikaanse buitenlandbeleid onder de regering van president Donald Trump heeft de kwestie volgens Espersen zodanig relevant gemaakt dat de gemeenten hebben besloten over te stappen naar een andere aanbieder."
                                            },
                                            {
                                                "example_id": "1efc003c-9599-49b0-962b-647c41ba2029",
                                                "sense_id": "2247e91d-b85d-3900-b712-d09fc52f130c",
                                                "text": "Niet meer zo vaak uit eten, geen gadgets kopen, minder autorijden. Door alle abonnementen op te zeggen konden we overal een goedkopere aanbieder voor zoeken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
