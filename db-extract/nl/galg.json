                    {
                        "sense_id": "686d9056-1f60-3c27-8800-a802d6603a64",
                        "entry_id": "3320607a-2ee1-3b98-b867-210775048ea8",
                        "glosses": [
                            "houten constructie bestaande uit één of meer staande balken met een horizontale balk haaks daarop en één of meer diagonale balken ter ondersteuning, in het verleden veel gebruikt om mensen door ophanging ter dood te brengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cbe2d1f-5d1a-48cb-9081-969649a91476",
                                "sense_id": "686d9056-1f60-3c27-8800-a802d6603a64",
                                "text": "De oude vrouw keek en ze zag haar beide kinderen, en de één hing aan de galg en de ander was op het rad gebonden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "63f2eadd-e09d-4eb0-94f3-d0a272bc0c5f",
                        "source_entry_id": "3320607a-2ee1-3b98-b867-210775048ea8",
                        "source_sense_id": "686d9056-1f60-3c27-8800-a802d6603a64",
                        "source_sense_description": "houten constructie bestaande uit één of meer staande balken met een horizontale balk haaks daarop en één of meer diagonale balken ter ondersteuning, in het verleden veel gebruikt om mensen door ophanging ter dood te brengen",
                        "target_lang_word": "gallows",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gallows",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cf3ca28b-cc0e-31df-aa06-84ed8e87c3a0",
                                        "entry_id": "bc47d000-4d56-3a51-9bec-74d7e3ed644b",
                                        "glosses": [
                                            "A wooden framework on which persons are executed by hanging."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "493fbedc-e88a-406e-b6df-a0dfa875233e",
                                                "sense_id": "cf3ca28b-cc0e-31df-aa06-84ed8e87c3a0",
                                                "text": "Near-synonym: gibbet"
                                            },
                                            {
                                                "example_id": "32ef8728-18ac-4bf3-9d22-63db6c7d31bf",
                                                "sense_id": "cf3ca28b-cc0e-31df-aa06-84ed8e87c3a0",
                                                "text": "No, Sir, 'tis fear of Hanging. Who would not ſteal, or do Murder, every time his Fingers itch'd at it, were it not for fear of the Gallows?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "744666e7-dd8e-3aa0-9b56-a7a1d50fc613",
                                        "entry_id": "bc47d000-4d56-3a51-9bec-74d7e3ed644b",
                                        "glosses": [
                                            "A wretch who deserves to be hanged."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6aad5a83-bf59-4f03-815e-3522fc64fc4a",
                                                "sense_id": "744666e7-dd8e-3aa0-9b56-a7a1d50fc613",
                                                "text": "Ay, and a shrewd unhappy gallows too. / You'll ne'er be friends with him: a' kill'd your sister."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a9b90b0a-12bc-35a6-ab6f-39c429422b72",
                                        "entry_id": "bc47d000-4d56-3a51-9bec-74d7e3ed644b",
                                        "glosses": [
                                            "The rest for the tympan when raised."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9943eda1-af4c-313d-bc62-69053fd82561",
                                        "entry_id": "bc47d000-4d56-3a51-9bec-74d7e3ed644b",
                                        "glosses": [
                                            "Suspenders; braces."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fdda10d-1b85-41f6-92ab-c740c576f51a",
                                                "sense_id": "9943eda1-af4c-313d-bc62-69053fd82561",
                                                "text": "The last pair of \"gallowses\" made by Mr. Gratacap was an order from Mr. Brokaw, the clothier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a0cc7b1-11bf-3777-95fe-d9b00c0c74b5",
                                        "entry_id": "bc47d000-4d56-3a51-9bec-74d7e3ed644b",
                                        "glosses": [
                                            "Any contrivance with posts and crossbeam for suspending objects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "620c8ba3-7a88-4fc3-a079-0c43a213c5b2",
                                                "sense_id": "7a0cc7b1-11bf-3777-95fe-d9b00c0c74b5",
                                                "text": "Lit by the moonlight through the window, he can see a FIGURE in the hospital bed alone in the room, and under a transparent oxygen tent. […] Tubes hang from a steel gallows beside the bed, and run to his nose and mouth."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1d8a0c5-972a-34d5-8c9c-b65ac2867f55",
                                        "entry_id": "bc47d000-4d56-3a51-9bec-74d7e3ed644b",
                                        "glosses": [
                                            "The main frame of a beam engine."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
