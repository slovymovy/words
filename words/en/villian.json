                    "sense_id": "b790c6dd-41b6-3b71-8543-971c98c93099",
                    "sense_definition": "A synonym of <w>vaudevillian</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "performer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old theater was once home to many a talented <w>villian</w> performing nightly.",
                            "target_lang_translations": {
                                "ru": "В старом театре когда-то выступало множество талантливых <w>артистов водевиля</w>."
                            }
                        },
                        {
                            "text": "He began his career as a traveling <w>villian</w> in the early twentieth century.",
                            "target_lang_translations": {
                                "ru": "Он начал свою карьеру как бродячий <w>водевилист</w> в начале двадцатого века."
                            }
                        }
                    ],
                    "synonyms": [
                        "vaudevillian"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used synonym for vaudevillian"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Синоним слова «vaudevillian» (артист водевиля)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "артист водевиля",
                                "target_lang_sense_clarification": "исполнитель в жанре водевиля"
                            },
                            {
                                "target_lang_word": "водевилист",
                                "target_lang_sense_clarification": "устаревший термин для актера водевиля"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbefa183-d2ae-3032-8a45-387be6b3480a",
                    "sense_definition": "A common misspelling of <w>villain</w>.",
