                    },
                    {
                        "translation_id": "b446300b-39f8-4885-818b-a7814d614878",
                        "source_entry_id": "c7912bec-25bb-3447-a130-bcd27ed6b6e0",
                        "source_sense_id": "ac10d578-5564-3a63-a477-d455cf51260c",
                        "target_lang_word": "фалери́стика",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
