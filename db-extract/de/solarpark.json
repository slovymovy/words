                "senses": [
                    {
                        "sense_id": "27b3b87f-9ec0-38cc-88ab-4b341b6bd16b",
                        "entry_id": "0822ccbe-418b-398d-bf89-fa4f09eea593",
                        "glosses": [
                            "großer Bereich mit sehr vielen Solarmodulen oder mehreren Solaranlagen die das Sonnenlicht nutzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b9b3e32-9ea6-43aa-90f5-7fe8b6872925",
                                "sense_id": "27b3b87f-9ec0-38cc-88ab-4b341b6bd16b",
                                "text": "„Der 101.000 Quadratmeter große Solarpark kostete zehn Millionen Euro. 20.000 Solarmodule wurden verbaut.“"
                            },
                            {
                                "example_id": "e7d6ba25-99f2-4b47-bfd7-d89e8e2e859b",
                                "sense_id": "27b3b87f-9ec0-38cc-88ab-4b341b6bd16b",
                                "text": "„Hier finden Sie eine Übersicht der größten Solarparks der Welt.“"
                            },
                            {
                                "example_id": "4986ab14-4a95-457f-a2e0-cf7f07b3cd2f",
                                "sense_id": "27b3b87f-9ec0-38cc-88ab-4b341b6bd16b",
                                "text": "[Der 2003 gegründete Solarverein Berlin-Brandenburg hat] vorgeschlagen, zur Nachnutzung des Flughafens Tempelhof einen Solarpark einzurichten."
                            },
                            {
                                "example_id": "8e223e21-5355-406b-ad23-7955ff69e72a",
                                "sense_id": "27b3b87f-9ec0-38cc-88ab-4b341b6bd16b",
                                "text": "„Auf immer mehr Flächen in Schleswig-Holstein werden Solarparks errichtet, vor allem entlang von Autobahnen und Bahnschienen.“"
                            },
                            {
                                "example_id": "884ded99-cca5-4c04-8ced-4d295bda5fcb",
                                "sense_id": "27b3b87f-9ec0-38cc-88ab-4b341b6bd16b",
                                "text": "„Mit Solarparks erzielen Landwirte hohe Pachten.“"
                            },
                            {
                                "example_id": "0d114395-9bbc-4f8f-93b9-7fd8f3b8ade1",
                                "sense_id": "27b3b87f-9ec0-38cc-88ab-4b341b6bd16b",
                                "text": "„[…] die Betreiber neuer Solarparks [können] schon bei Preisen von drei bis vier Cent kostendeckend arbeiten.“"
                            },
                            {
                                "example_id": "b78f2cee-11a2-4d96-8ff0-c25fc5b76ab7",
                                "sense_id": "27b3b87f-9ec0-38cc-88ab-4b341b6bd16b",
                                "text": "„Künftig sollen sich auch Bürger an den Solarparks finanziell beteiligen können […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
