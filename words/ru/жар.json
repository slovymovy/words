                {
                    "sense_id": "90a7fe72-00ef-35ca-bd0d-1e14b57d965b",
                    "sense_definition": "Болезненное состояние, при котором повышается температура тела.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_temperature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У ребёнка поднялся сильный <w>жар</w>, и мы вызвали врача.",
                            "target_lang_translations": {
                                "en": "The child developed a high <w>fever</w>, and we called the doctor.",
                                "de": "Das Kind bekam hohes <w>Fieber</w> und wir riefen den Arzt."
                            }
                        },
                        {
                            "text": "Лекарство подействовало, и через час <w>жар</w> спал.",
                            "target_lang_translations": {
                                "en": "The medicine worked, and an hour later the <w>fever</w> went down.",
                                "de": "Das Medikament wirkte und nach einer Stunde war das <w>Fieber</w> gesunken."
                            }
                        }
                    ],
                    "synonyms": [
                        "температура",
                        "лихорадка"
                    ],
                    "antonyms": [
                        "озноб"
                    ],
                    "common_phrases": [
                        "сильный жар",
                        "жар спал",
                        "лежать в жару"
                    ],
                    "target_lang_definitions": {
                        "en": "A painful condition in which body temperature rises.",
                        "de": "Ein krankhafter Zustand, bei dem die Körpertemperatur ansteigt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fever",
                                "target_lang_sense_clarification": "medical condition"
                            },
                            {
                                "target_lang_word": "temperature",
                                "target_lang_sense_clarification": "colloquial"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Fieber",
                                "target_lang_sense_clarification": "medizinischer Zustand"
                            },
                            {
                                "target_lang_word": "Temperatur",
                                "target_lang_sense_clarification": "umgangssprachlich für Fieber"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "878da1d8-2c90-3845-b912-6a1cf3a54f04",
                    "sense_definition": "Сильно нагретый, горячий воздух; зной.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_heat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В полдень на улице стоял невыносимый <w>жар</w>.",
                            "target_lang_translations": {
                                "en": "At noon, there was unbearable <w>heat</w> outside.",
                                "de": "Mittags herrschte draußen eine unerträgliche <w>Hitze</w>."
                            }
                        },
                        {
                            "text": "От раскалённого асфальта поднимался сухой <w>жар</w>.",
                            "target_lang_translations": {
                                "en": "Dry <w>heat</w> rose from the scorching asphalt.",
                                "de": "Vom glühend heißen Asphalt stieg trockene <w>Hitze</w> auf."
                            }
                        }
                    ],
                    "synonyms": [
                        "зной",
                        "пекло",
                        "жара"
                    ],
                    "antonyms": [
                        "холод",
                        "мороз"
                    ],
                    "common_phrases": [
