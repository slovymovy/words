                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "145b36c5-0c13-4b4e-ab24-d4821152c7f5",
                        "source_entry_id": "fafe26f6-d035-3e66-9cd3-eed5b0655937",
                        "source_sense_id": "a87a1484-4f79-332c-978b-19b9ea3dd929",
                        "source_sense_description": "amount an arm or arms can hold",
                        "target_lang_word": "бере́мя",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "бере́мя",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d6874c66-54d4-33a2-aa54-ae1d9a9545b4",
                                        "entry_id": "4c119d82-1641-30e0-b4e7-57ab72dc8737",
                                        "glosses": [
                                            "устар., высок. то же, что бремя; тяжёлая ноша; груз"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d0c2753-c21c-4839-919b-bcba4fc8120d",
                                                "sense_id": "d6874c66-54d4-33a2-aa54-ae1d9a9545b4",
                                                "text": "Не получив ответа, он потащил беремя толстых переплетенных книг и тотчас же разронял их."
                                            },
                                            {
                                                "example_id": "ff6aa2a6-8b47-476a-9fc7-593756e11e88",
                                                "sense_id": "d6874c66-54d4-33a2-aa54-ae1d9a9545b4",
                                                "text": "Худенький, маленький, с вострым носиком солдат, которого назвали вороной, покорно встал и пошел было исполнять приказание, но в это время в свет костра вступила уже тонкая красивая фигура молодого солдата, несшего беремя дров."
                                            },
                                            {
                                                "example_id": "79b6464d-0df1-42d5-8217-638763cd62d4",
                                                "sense_id": "d6874c66-54d4-33a2-aa54-ae1d9a9545b4",
                                                "text": "Лён, увязанный в беремена́, уложенный в лодью и хорошо накрытый, отправляется в далёкое путешествие."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06871b90-0b7b-3ae0-bb37-e26ed2d01e3a",
                                        "entry_id": "4c119d82-1641-30e0-b4e7-57ab72dc8737",
                                        "glosses": [
                                            "перен., устар. плод беременной женщины"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99e406f2-b109-41d7-aec8-0c5032c3a6ed",
                                                "sense_id": "06871b90-0b7b-3ae0-bb37-e26ed2d01e3a",
                                                "text": "Когда во время турецкой войны он попросил позволения государыни отправиться в армию Потемкина в скромном звании волонтера, Екатерина не дозволила ему этого, под предлогом скорого разрешения от беремени его супруги, и выразила опасение, что южный климат повредит его здоровью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5d7923f-4b8d-30f2-b22b-bedbc8f99660",
                                        "entry_id": "4c119d82-1641-30e0-b4e7-57ab72dc8737",
                                        "glosses": [
                                            "перен., устар. что-либо обременительное, тягостное"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fba0f1e-117c-4c10-a9f4-3b573da72b5b",
                                                "sense_id": "c5d7923f-4b8d-30f2-b22b-bedbc8f99660",
                                                "text": "Коварник говорил, что я хочу отнять власть и полномощество президентское; я отвечал, что я желаю снять с него беремя, которое выше сил одного человека, каков бы он ни был."
                                            },
                                            {
                                                "example_id": "9cf0d110-14f8-4896-afe2-02564505827b",
                                                "sense_id": "c5d7923f-4b8d-30f2-b22b-bedbc8f99660",
                                                "text": "Э, матушка, и рад бы остаться, да нельзя: дел беремя, а на кого положиться?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b10f3357-1983-4357-a9e6-62efaa58e03a",
                        "source_entry_id": "fafe26f6-d035-3e66-9cd3-eed5b0655937",
                        "source_sense_id": "a87a1484-4f79-332c-978b-19b9ea3dd929",
                        "source_sense_description": "amount an arm or arms can hold",
                        "target_lang_word": "оха́пка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "оха́пка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c681ed81-dfff-3385-9e06-fa206ab13e60",
                                        "entry_id": "2db8a60e-fcd7-3ef8-a8b2-5d23aa269640",
                                        "glosses": [
                                            "количество чего-либо, которое можно взять, унести, обхватив руками или рукой"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "148e694f-50e8-4b73-ae48-055a46050a70",
                                                "sense_id": "c681ed81-dfff-3385-9e06-fa206ab13e60",
                                                "text": "И в два прыжка она уже у цветов и срывает их охапками."
                                            },
                                            {
                                                "example_id": "a24ed9f4-d4e7-46e1-a3c4-a3f34af5903a",
                                                "sense_id": "c681ed81-dfff-3385-9e06-fa206ab13e60",
                                                "text": "Эх, бывало, заломишь шапку, // Да заложишь в оглобли коня, // Да приляжешь на сена охапку, ― // Вспоминай лишь, как звали меня."
                                            },
                                            {
                                                "example_id": "c43b5c74-624a-4381-8c5d-51a9bea3f8cb",
                                                "sense_id": "c681ed81-dfff-3385-9e06-fa206ab13e60",
                                                "text": "Он зашёл на кухню, разгрёб спрятанные в золе ещё не погасшие угольки, потом вышел на кухонную веранду и принёс оттуда охапку дров и сухих веток."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "211b1ceb-3aae-3ad5-85ce-468ebf66abfc",
                                        "entry_id": "2db8a60e-fcd7-3ef8-a8b2-5d23aa269640",
                                        "glosses": [
                                            "перен. большое количество чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd109495-8444-49f4-9032-ca13da65a422",
                                                "sense_id": "211b1ceb-3aae-3ad5-85ce-468ebf66abfc",
                                                "text": "У него, я вам доложу, одних овец сто тысяч по Оке пасутся, так если с каждой… ну, по скольку? ― ну, хоть по полупуду шерсти получать, так ведь денег-то какая охапка выйдет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
