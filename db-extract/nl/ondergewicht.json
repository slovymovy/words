                "senses": [
                    {
                        "sense_id": "d1971625-18a5-3081-9bd2-ebbfc30fd11d",
                        "entry_id": "366db407-1fe0-39f8-91fa-401ae856234a",
                        "glosses": [
                            "een ongezond laag lichaamsgewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1422aa2c-fb96-410e-9f98-02d826fcce4a",
                                "sense_id": "d1971625-18a5-3081-9bd2-ebbfc30fd11d",
                                "text": "Uw vitale functies zijn in orde al zijn uw hartslag en bloeddruk erg laag. Uw algehele conditie is slecht, u bent ondervoed en u hebt ernstig ondergewicht. Zuivel en vlees, room, eieren, kaas: dat heeft uw lichaam nodig."
                            },
                            {
                                "example_id": "cd482c36-d33c-4b36-a1cd-33ba82a448cb",
                                "sense_id": "d1971625-18a5-3081-9bd2-ebbfc30fd11d",
                                "text": "Volgens het Voedingscentrum is het aannemelijk dat een taille van 60 centimeter overeenkomt met een BMI lager dan 18,5. Dat betekent voor iemand van 1 meter 70 een gewicht van 53 kilo. Het Voedingscentrum trekt daar ook de grens: een BMI lager dan 18,5 en een taillemaat lager dan 68 centimeter beschouwt het als ondergewicht."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c467196-bfcf-41ec-ab53-a3d7a7008b34",
                        "source_entry_id": "366db407-1fe0-39f8-91fa-401ae856234a",
                        "source_sense_id": "d1971625-18a5-3081-9bd2-ebbfc30fd11d",
                        "source_sense_description": "een ongezond laag lichaamsgewicht",
                        "target_lang_word": "short weight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "short weight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d849dcfc-11be-31d1-bcdb-775e735da13d",
                                        "entry_id": "79324178-74e7-3df1-91ef-f43e66d57ed2",
                                        "glosses": [
                                            "Weight that is less than that declared or less than one is charged for."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee29f379-60cb-46b0-a135-e0e596bdb2f6",
                                                "sense_id": "d849dcfc-11be-31d1-bcdb-775e735da13d",
                                                "text": "However, in the face of irrefutable evidence that at a time when England was able to grow her own food supplies provision dealers wilfully adulterated their goods or gave short weight, we cannot be surprised that the punishments inflicted went beyond fines."
                                            },
                                            {
                                                "example_id": "f44bf478-b501-4111-b8ed-5491e7a3bad0",
                                                "sense_id": "d849dcfc-11be-31d1-bcdb-775e735da13d",
                                                "text": "The need to protect the customer against deception and short weight in the sale of coal led the Government to introduce legislation to prohibit the giving of short weight as early as 1889, hence the special provisions in Part II of the Weights and Measures Act, 1889, regulating the sale of coal and imposing penalties for short weight, frauds by draymen, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
