                        "examples": [
                            {
                                "example_id": "4249f199-92ae-4f4f-be18-be17bc466aef",
                                "sense_id": "d2c24b08-fdff-31f3-bb98-d4fdfa91f225",
                                "text": "De jonge hiphoptalenten garanderen daarmee niet alleen een groot publiek en een lucratieve loopbaan voor zichzelf, ze verbeteren daarmee ook negen van de tien keer de leefomstandigheid van hun families - en creëren daarmee weer een nieuw perspectief voor hun toekomst."
                            },
                            {
                                "example_id": "7ac96723-b9b0-4053-9081-904d39404741",
                                "sense_id": "d2c24b08-fdff-31f3-bb98-d4fdfa91f225",
                                "text": "Aan de orde komen de verschillende uilensoorten, wat zij zoal eten en natuurlijk wat we kunnen doen om de leefomgeving en leefomstandigheid van deze uilen te verbeteren."
                            }
                        ]
