                        "glosses": [
                            "Thema bei einer Abendveranstaltung oder Abendsendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac616888-c766-4134-8118-f044eb0a6833",
                                "sense_id": "09f5bbcb-d044-3368-bf9d-2bdd3fe0920f",
                                "text": "„Und es scheint, als hätte der Neue bereits das richtige Gespür - mit Zebra-Maserungen als Druckmotiv, athletischen Einflüssen, starken Lederakzenten, einer linearen Schnittführung, aber auch kurvigen Silhouetten im Abendthema.“"
                            },
                            {
                                "example_id": "aef01339-65e5-4a3a-97af-f8bebfc8948a",
                                "sense_id": "09f5bbcb-d044-3368-bf9d-2bdd3fe0920f",
                                "text": "„Sie erzählen aus ihrem Leben und wollen so eine Brücke schlagen zum jeweiligen Abendthema: Neben dem Mediziner Dr. Thomas Schmidt und Dozent Christian Bouillon der Theologischen Hochschule Ewersbach stellt sich auch der Unternehmer Dr. Friedhelm Loh und eine ehemalige Muslima den Fragen des Moderatorenpaars.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
