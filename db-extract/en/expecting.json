                    {
                        "translation_id": "d84569e4-0110-45ca-9899-9285ea13a9f8",
                        "source_entry_id": "f8c5df9b-26f4-3dd2-b3fb-52f9b887147b",
                        "source_sense_description": "in expectation of giving birth; pregnant",
