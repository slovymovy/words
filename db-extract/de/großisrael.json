                "senses": [
                    {
                        "sense_id": "b04cb946-825e-315a-9ef6-1c1f732d5f29",
                        "entry_id": "064d9bf6-5f7b-3754-88eb-b32b4bc32082",
                        "glosses": [
                            "von bestimmten jüdischen Gruppierungen geforderter, theoretischer Staat, der das gesamte biblische Israel umfassen soll"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d072fde8-a998-48e5-b618-e85b70693574",
                                "sense_id": "b04cb946-825e-315a-9ef6-1c1f732d5f29",
                                "text": "„Da mehrere Führungsmitglieder in die fortlaufenden Verhandlungen mit den Haschemiten in Transjordanien eingeweiht waren, stellten sie sich nur auf eine eventuelle Einschränkung in der Gestaltung ihrer zukünftigen Landkarte ein, und das war die Möglichkeit, dass gewisse Gebiete Ostpalästinas im heutigen Westjordanland nicht Teil Großisraels, sondern Großjordaniens werden könnte.“"
                            },
                            {
                                "example_id": "f0b80d18-299a-4168-ad1a-03399a79fe59",
                                "sense_id": "b04cb946-825e-315a-9ef6-1c1f732d5f29",
                                "text": "„Die Befürworter eines Großisrael wie Scharon, Begin und Jitzchak Schamir gingen davon aus, dass die militärische Vernichtung der PLO und die Ausschaltung ihrer Macht im Libanon auch dem palästinensischen Nationalismus im besetzten Westjordanland, im Gazastreifen und in Ostjerusalem ein Ende setzen würden.“"
                            },
                            {
                                "example_id": "adb312e8-0190-4ff3-b840-158db5505f61",
                                "sense_id": "b04cb946-825e-315a-9ef6-1c1f732d5f29",
                                "text": "„Wie sich herausstellt, sind die historischen Umstände in den neunzehn Jahren zwischen der Staatsgründung und dem Sechstagekrieg im Juni 1967 tiefer in den Herzen verankert als jede messianische Botschaft eines Großisrael.“"
                            },
                            {
                                "example_id": "0610215f-1b79-4466-bb12-bfc4f0d3e2ee",
                                "sense_id": "b04cb946-825e-315a-9ef6-1c1f732d5f29",
                                "text": "„Eine Gruppe prominenter Schriftsteller brachte die Erklärung ›Für ein Großisrael‹ heraus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
