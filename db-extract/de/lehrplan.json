                    {
                        "translation_id": "f48962ff-8f94-41e5-9033-23f7dcd04941",
                        "source_entry_id": "90762007-eb3f-3036-9f22-78ff5fdf8202",
                        "source_sense_id": "320ab7f2-a394-3f06-9cf3-26308c1cd6ff",
                        "source_sense_description": "Entwurf, der Lehrziele, Lehrinhalte, didaktische und gestalterische Hinweise enthält",
                        "target_lang_word": "programme scolaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "programme scolaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06f97041-f57e-3c97-82f5-d5653d5a8026",
                                        "entry_id": "0a4ebd49-05da-3cfd-a364-724db356387b",
                                        "glosses": [
                                            "Exposé écrit et publié, rédigé par un ministère chargé de l'éducation, qui détaille les savoirs que doivent apprendre et acquérir les élèves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38f0e21e-6098-4ebe-91e9-3f8d34244a90",
                                                "sense_id": "06f97041-f57e-3c97-82f5-d5653d5a8026",
                                                "text": "Après 1870, il faut bien se rendre à l'évidence, ceux qui ont fixé les programmes scolaires ont commis de funestes erreurs; ils n'ont cru qu'aux efforts de mémoire, à l'accumulation de notions positives ; ils ont oublié l'essentiel ; ils n'ont point pensé à l'âme."
                                            },
                                            {
                                                "example_id": "35b45b0f-bc56-478d-a5ba-b0c8d5fd6427",
                                                "sense_id": "06f97041-f57e-3c97-82f5-d5653d5a8026",
                                                "text": "Gay et Cole ont été intrigués par les difficultés qu’éprouvaient les élèves kpelle au Libéria dans l’apprentissage de concepts mathématiques exigés par le programme scolaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
