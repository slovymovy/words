                "senses": [
                    {
                        "sense_id": "83be8e4e-88f5-3f7a-ba53-10e73dd90a9f",
                        "entry_id": "426c2447-ea20-3295-a92e-481f4f7cfa44",
                        "glosses": [
                            "Soft; unctuous; loamy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a96c7b1-af2f-48ac-b731-6619d6561272",
                                "sense_id": "83be8e4e-88f5-3f7a-ba53-10e73dd90a9f",
                                "text": "Thy plumpe and swelling wombe, whose mellowy gleabe doth beare\nThe yellow ripened sheafe, that bendeth with the eare."
                            },
                            {
                                "example_id": "26c01493-1875-445b-b6b9-0388eac4393a",
                                "sense_id": "83be8e4e-88f5-3f7a-ba53-10e73dd90a9f",
                                "text": "The first a dry mellowy soil, made up of a due mixture of clay and sand, very deep, and passes under the name of daichy haughs."
                            }
                        ]
                    },
                    {
                        "sense_id": "118210c8-88c9-3b82-a267-b032269641c6",
                        "entry_id": "426c2447-ea20-3295-a92e-481f4f7cfa44",
                        "glosses": [
                            "Mild; subdued; gentle; not at all harsh or sharp."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eb1a3f4-0b14-4809-8511-9075e47df2e0",
                                "sense_id": "118210c8-88c9-3b82-a267-b032269641c6",
                                "text": "Get the fun of \"playing\" outdoors in the mellowy energising winter sunshine."
                            },
                            {
                                "example_id": "980a28c9-1765-4c89-a983-4a80c608f4fe",
                                "sense_id": "118210c8-88c9-3b82-a267-b032269641c6",
                                "text": "mellowy light"
                            },
                            {
                                "example_id": "716c1305-73d3-4409-a541-031990408e17",
                                "sense_id": "118210c8-88c9-3b82-a267-b032269641c6",
                                "text": "Like a stream-wrestling lily of mellowy gold, What sweet parted lips, and what glozy blue eyes, Purple-steeped as the heartsease held up to the light!"
                            },
                            {
                                "example_id": "b6f6707e-72a5-4422-b9d1-47e1a54e3b8a",
                                "sense_id": "118210c8-88c9-3b82-a267-b032269641c6",
                                "text": "A little distance off was a grey and mossy cottage, the sight of which made Michael's heart leap, and called to his memory many reflections, pleasing, but mellowy sad."
                            },
                            {
                                "example_id": "be8aae69-55fb-4c77-8e54-c7bcc93e73de",
                                "sense_id": "118210c8-88c9-3b82-a267-b032269641c6",
                                "text": "The fish sauce shall have a mellowy taste and should not be too salty."
                            },
                            {
                                "example_id": "2bd75dd1-20ef-4cda-9fa3-4a0cc947444d",
                                "sense_id": "118210c8-88c9-3b82-a267-b032269641c6",
                                "text": "The silver moon—the silver moon—how mellowy it gleams!"
                            },
                            {
                                "example_id": "a0f1b8fb-ba88-4f0c-ae55-9eb025c1c060",
                                "sense_id": "118210c8-88c9-3b82-a267-b032269641c6",
                                "text": "I have investigated with great care the alterations of the soft, free, mellowy character of the normal respiratory murmurs, in all the cases of auscultation I have met for some years, and I have learned to give to this class of signs more weight than is usually assigned to them."
                            }
                        ]
                    },
                    {
                        "sense_id": "13c48ea5-1a7f-3818-b0c1-727db14d2b24",
                        "entry_id": "426c2447-ea20-3295-a92e-481f4f7cfa44",
                        "glosses": [
                            "Tender; emotional."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b244179-c523-4c2e-9410-91b438983216",
                                "sense_id": "13c48ea5-1a7f-3818-b0c1-727db14d2b24",
                                "text": "Anita saw that look on him, that mellowy, kind of stupid look that some men get when they've been drinking."
                            },
                            {
                                "example_id": "9ddf762b-1cba-40e0-bdf0-741bc2eb7f4a",
                                "sense_id": "13c48ea5-1a7f-3818-b0c1-727db14d2b24",
                                "text": "Not that he got all soft and mellowy around them, but he'd never met one he didn't like."
                            }
                        ]
                    },
                    {
                        "sense_id": "06e7e5a4-2bc4-3d73-957b-a6550f9618e1",
                        "entry_id": "426c2447-ea20-3295-a92e-481f4f7cfa44",
                        "glosses": [
                            "Mature and soft; ripe."
                        ],
                        "tags": [
                            "of plants"
                        ],
                        "examples": [
                            {
                                "example_id": "30ef982a-16af-4d08-9319-38c36edfbc4c",
                                "sense_id": "06e7e5a4-2bc4-3d73-957b-a6550f9618e1",
                                "text": "Round its sides, A range of Gardens, gay as those which crown'd Thy work Semiramis, luxuriant waved With Autumn's mellowy growth;"
                            },
                            {
                                "example_id": "aae7bc9a-5c15-42b7-adc7-4e1a56451a28",
                                "sense_id": "06e7e5a4-2bc4-3d73-957b-a6550f9618e1",
                                "text": "Autumn's rich mellowy fruit bedecks the trees, Laid low, beneath a winter's stormy skies."
                            },
                            {
                                "example_id": "5fae0a28-72d8-4a9b-b6a7-340c0033255b",
                                "sense_id": "06e7e5a4-2bc4-3d73-957b-a6550f9618e1",
                                "text": "The first named never becomes a mellowy Pear, even grown on a south wall here ;"
                            }
                        ]
                    }
