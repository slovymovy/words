                    }
                ],
                "translations": [
                    {
                        "translation_id": "982410e9-bc51-4075-a11d-d47ace31620f",
                        "source_entry_id": "edce79a4-107a-3889-8179-d434156e16c4",
                        "source_sense_id": "5698f478-b71d-390f-9ef5-c7b3fb325582",
