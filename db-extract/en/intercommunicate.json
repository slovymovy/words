                "senses": [
                    {
                        "sense_id": "3b0cbe8b-2e78-3bc5-9063-20c916903057",
                        "entry_id": "7e2685b2-0509-33a9-9ba5-07f7de966287",
                        "glosses": [
                            "To communicate mutually, one with another."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f50af554-7cdc-4fd0-b597-8fce704cafdb",
                                "sense_id": "3b0cbe8b-2e78-3bc5-9063-20c916903057",
                                "text": "There is also a growing number of teleradio stations on small inter-island craft. All these stations communicate with or through Vila, but may intercommunicate by permission."
                            }
                        ]
                    },
                    {
                        "sense_id": "c906086a-466b-3219-8a4c-8481f57b608d",
                        "entry_id": "7e2685b2-0509-33a9-9ba5-07f7de966287",
                        "glosses": [
                            "To be interconnected."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "7ed685f4-27e6-47b3-97ee-7bf7ded8377e",
                                "sense_id": "c906086a-466b-3219-8a4c-8481f57b608d",
                                "text": "The two vehicles of each unit intercommunicate through a vestibule type corridor connection similar to that obtaining in long-distance passenger stock."
                            },
                            {
                                "example_id": "4cdf0eeb-cd21-42ec-b80c-c1fc63c97e4b",
                                "sense_id": "c906086a-466b-3219-8a4c-8481f57b608d",
                                "text": "[…] but in analysing the more highly developed houses, where the pavilions are integrated architecturally with other rooms at the ends of the hall, the possibility that they intercommunicated with them cannot be ignored."
                            }
                        ]
                    }
                ],
