                    {
                        "sense_id": "70c983db-acd0-32a2-bad5-aa6bfaa7a330",
                        "entry_id": "94bc810c-f75b-364b-aad1-ec86577998c0",
                        "glosses": [
                            "de tijd die besteed wordt aan persoonlijke bezigheden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8000157d-9a86-47a3-acb1-a26c82e9f703",
                                "sense_id": "70c983db-acd0-32a2-bad5-aa6bfaa7a330",
                                "text": "Heb je na al die werkzaamheden nog wel voldoende tijd voor je privéleven?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21a2d795-7b61-4bbe-988e-8782bce14580",
                        "source_entry_id": "94bc810c-f75b-364b-aad1-ec86577998c0",
                        "source_sense_id": "70c983db-acd0-32a2-bad5-aa6bfaa7a330",
                        "source_sense_description": "de tijd die besteed wordt aan persoonlijke bezigheden",
                        "target_lang_word": "Privatleben",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Privatleben",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d517f71c-6d4c-3c61-afa3-7fc5c11858b8",
                                        "entry_id": "48ae3b21-d9ec-3d8b-a1e4-9ba4d4ddad71",
                                        "glosses": [
                                            "derjenige Teil der Lebensgestaltung, der sich im privaten/persönlichen Bereich abspielt, also außerhalb von Beruf oder Öffentlichkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "403bd925-1a9c-421c-b539-067616861b7d",
                                                "sense_id": "d517f71c-6d4c-3c61-afa3-7fc5c11858b8",
                                                "text": "„Bis heute sind nur eine Handvoll Schwarzweißfotos von Turing bekannt, die aber kaum Einblick in sein Privatleben geben.“"
                                            },
                                            {
                                                "example_id": "f3cc0434-8e1d-4bbb-8863-1559850be5a0",
                                                "sense_id": "d517f71c-6d4c-3c61-afa3-7fc5c11858b8",
                                                "text": "„Die meistbeachtete Wortmeldung war allerdings eine Erklärung, in der sich der Altkanzler im Sommer 2011 gegen die »öffentliche Zurschaustellung und Vermarktung« seines Privatlebens wandte.“"
                                            },
                                            {
                                                "example_id": "bcd4a8ff-2e87-4cb8-96cc-f628cbbb4b56",
                                                "sense_id": "d517f71c-6d4c-3c61-afa3-7fc5c11858b8",
                                                "text": "„Es war eine Behinderung, die vor allem in ihrem Privatleben permanent zu Schwierigkeiten führte.“"
                                            },
                                            {
                                                "example_id": "7a931b56-bb66-4cc2-a8c7-aaba68b64325",
                                                "sense_id": "d517f71c-6d4c-3c61-afa3-7fc5c11858b8",
                                                "text": "„In seinem Privatleben sah es kaum besser aus.“"
                                            },
                                            {
                                                "example_id": "53237654-e866-4d8c-b494-8622432bf88f",
                                                "sense_id": "d517f71c-6d4c-3c61-afa3-7fc5c11858b8",
                                                "text": "„Er und seine Frau führten ein zurückgezogenes Privatleben ohne Besucher, sie nahmen ihre Mahlzeiten zu dritt mit Sallys Nichte Patricia ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0e9aea4-d9d2-48a0-aa7b-77e32315eb8d",
                        "source_entry_id": "94bc810c-f75b-364b-aad1-ec86577998c0",
                        "source_sense_id": "70c983db-acd0-32a2-bad5-aa6bfaa7a330",
                        "source_sense_description": "de tijd die besteed wordt aan persoonlijke bezigheden",
                        "target_lang_word": "private life",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "private life",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "560bd2bd-eb0c-3275-8cf5-4e3eac34de49",
                                        "entry_id": "4f5c0fd4-61f7-3f30-b826-71094c0e14a1",
                                        "glosses": [
                                            "The aspects of one's life that are personal, such as family, friends and other personal relationships, as opposed to the elements that make up one's public or professional life."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61fe5879-2604-45cb-9aff-587f21cf0357",
                                                "sense_id": "560bd2bd-eb0c-3275-8cf5-4e3eac34de49",
                                                "text": "Holonyms: life; daily life, real life"
                                            },
                                            {
                                                "example_id": "1717736b-a248-4e49-bb85-47cd41581867",
                                                "sense_id": "560bd2bd-eb0c-3275-8cf5-4e3eac34de49",
                                                "text": "Meronyms: dream life, nightlife, love life, sex life"
                                            },
                                            {
                                                "example_id": "2956fb91-303a-493b-8ec5-80342002120c",
                                                "sense_id": "560bd2bd-eb0c-3275-8cf5-4e3eac34de49",
                                                "text": "2017, Jennifer S. Holland, For These Monkeys, It’s a Fight for Survival., National Geographic (March 2017)http://www.nationalgeographic.com/magazine/2017/03/macaques-monkeys-indonesia-endangered-pet-trade/\nThe researchers are teasing out fine details of the yaki’s private life."
                                            },
                                            {
                                                "example_id": "6e4c0ae8-7979-425b-aad1-92edb607478b",
                                                "sense_id": "560bd2bd-eb0c-3275-8cf5-4e3eac34de49",
                                                "text": "As a political system democracy seems to me extraordinarily foolish,[…]. My servant is, so far as I am concerned, welcome to as many votes as he can get.[…]I do not suppose that it matters much in reality whether laws are made by dukes or cornerboys, but I like, as far as possible, to associate with gentlemen in private life."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb022043-f610-4ddc-8f14-497be0dfb28d",
                        "source_entry_id": "94bc810c-f75b-364b-aad1-ec86577998c0",
                        "source_sense_id": "70c983db-acd0-32a2-bad5-aa6bfaa7a330",
                        "source_sense_description": "de tijd die besteed wordt aan persoonlijke bezigheden",
                        "target_lang_word": "vie privée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vie privée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                        "entry_id": "aea76fdd-9bd2-361d-a50a-442a4fb76087",
                                        "glosses": [
                                            "Domaine personnel, par opposition au domaine public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3be017e-9c09-4f17-b67c-f7bd6aa95317",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "Nous ne voulons pas entrer dans la vie privée de beaucoup de canotiers ; mais à en croire les apparences, le canotage ne serait, pour quelques amateurs, qu’un prétexte d’orgies, une occasion de plaisirs faciles, au lieu d’un amusement salutaire et convenable à la dignité de l’homme."
                                            },
                                            {
                                                "example_id": "aeadd717-2ef1-4f8a-8aa6-613fac2f6adf",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "La maxime de M. Royer-Collard : « La vie privée doit être murée, » avait été inventée depuis bien des siècles par l’Orient, cette terre du soleil, d’où vient toute lumière et toute sagesse."
                                            },
                                            {
                                                "example_id": "8172fbae-d134-4fee-aecf-0f823b5a4746",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "Et puis, qu’est-ce que ça le regarde, celui-là, que je fasse de la peinture, des bottes ou des chaussons de lisière ?… C’est de la vie privée, ça !"
                                            },
                                            {
                                                "example_id": "df9b33fd-81ea-4ab5-aef2-edf57b2571ff",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "Dubois se veut le successeur de Richelieu et de Mazarin ; il rêve de la pourpre cardinalice, mais sa vie privée milite peu en faveur d’une telle promotion. Il n’a jamais caché son goût pour les femmes."
                                            },
                                            {
                                                "example_id": "7abe27b8-f549-40ea-89ad-69a1f7543aaf",
                                                "sense_id": "1a26f4a7-9fd8-3a00-866c-c7f84053c1ab",
                                                "text": "Toute personne qui souhaite protéger sa vie privée peut chiffrer ses communications."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
