                "senses": [
                    {
                        "sense_id": "6a1d570c-49d5-3341-9f82-2e96f10fb792",
                        "entry_id": "29146410-0bf8-3048-9697-26fe56d9b073",
                        "glosses": [
                            "Marktplatz für den Austausch von Gütern, die ansonsten Abfall wären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9278ecac-f09b-4c27-b247-21f9934975e9",
                                "sense_id": "6a1d570c-49d5-3341-9f82-2e96f10fb792",
                                "text": "„Ein praxisnahes und attraktives Angebot für die Bürger und Kunden des ZAV könnte beispielsweise die Einrichtung einer Müllbörse auf dem Bastwald sein, bei der Bürger ausgemusterte Möbel und andere wieder verwertbare Waren abgeben können, die dann andere Menschen abholen und gegen geringe Gebühr weiter nutzen könnten.“"
                            },
                            {
                                "example_id": "d05337c8-47a5-4c8f-893f-50a8f6b2a8aa",
                                "sense_id": "6a1d570c-49d5-3341-9f82-2e96f10fb792",
                                "text": "„Die SchülerInnen… [sic] - untersuchen den eigenen Abfall (Menge und Material) - sortieren den eigenen Abfall in passende Behälter - erstellen Plakate mit mit den Mülleimern (Papier, Bio, Rest, Wertstoff/gelb)und dem passenden Abfall für alle Klassen in der Schule - erstellen ein Müllmemory für alle Klassen an der Schule - basteln aus \"Müll\" bzw. verwerten Müll weiter - suchen Möglichkeiten, Müll zu vermeiden - veranstalten eine \"Müllbörse\" (Austausch von Spielzeug, mit denen sie nicht mehr spielen / tauschen anstatt entsorgen)“"
                            },
                            {
                                "example_id": "126d82d9-c0aa-400b-9bbc-e0a88bc60ee9",
                                "sense_id": "6a1d570c-49d5-3341-9f82-2e96f10fb792",
                                "text": "„Was in der Müllbörse zu finden ist, kann gratis genommen werden.“"
                            },
                            {
                                "example_id": "1ce46618-aa40-4df3-b046-9b324a9a1738",
                                "sense_id": "6a1d570c-49d5-3341-9f82-2e96f10fb792",
                                "text": "So sei zum Beispiel der Aufbau einer Müll-Börse denkbar."
                            },
                            {
                                "example_id": "4e327a2c-6b60-4592-b515-96bc1d9f62d5",
                                "sense_id": "6a1d570c-49d5-3341-9f82-2e96f10fb792",
                                "text": "So sei die Idee entstanden, eine Art Müllbörse für ganz Deutschland zu etablieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
