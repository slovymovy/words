                        "sense_id": "4d8b6d49-9e2e-3276-bc39-82240deb0940",
                        "entry_id": "92d17e0e-214e-3e0f-b436-96dbf2be00b5",
                        "glosses": [
                            "Flotter plus ou moins."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9648b231-36ee-4686-8575-e310a6f1103d",
                                "sense_id": "4d8b6d49-9e2e-3276-bc39-82240deb0940",
                                "text": "Toinon avait vu flottailler des débris divers, brusquement il y eut une brève projection de lampes-torches qui éclaira un peu mieux que la vague lueur des lampadaires."
                            },
                            {
                                "example_id": "cb384842-37c8-4ca7-ae99-99355e4c33fb",
                                "sense_id": "4d8b6d49-9e2e-3276-bc39-82240deb0940",
                                "text": "Le corps a flottaillé un instant, le suaire s’est gonflé."
                            },
                            {
                                "example_id": "22c50dd9-86b2-432a-a995-e92dd7084a8f",
                                "sense_id": "4d8b6d49-9e2e-3276-bc39-82240deb0940",
                                "text": "Berthier, qui flottaillait, vit revenir l’appareil."
                            }
                        ]
                    }
