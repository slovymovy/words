                    "sense_id": "b4d9197e-609e-3f35-8258-e44c368e1e4a",
                    "sense_definition": "Derde persoon enkelvoud tegenwoordige tijd van <w>zijn</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "copula_existential",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>is</w> erg blij met zijn nieuwe baan.",
                            "target_lang_translations": {
                                "en": "He <w>is</w> very happy with his new job.",
                                "ru": "Он очень рад своей новой работе.",
                                "de": "Er <w>ist</w> sehr glücklich mit seiner neuen Stelle."
                            }
                        },
                        {
                            "text": "Er <w>is</w> nog genoeg koffie voor iedereen.",
                            "target_lang_translations": {
                                "en": "There <w>is</w> still enough coffee for everyone.",
                                "ru": "Для всех <w>есть</w> еще достаточно кофе.",
                                "de": "Es <w>gibt</w> noch genug Kaffee für alle."
                            }
                        },
                        {
                            "text": "Twaalf min drie <w>is</w> negen.",
                            "target_lang_translations": {
                                "en": "Twelve minus three <w>is</w> nine.",
                                "ru": "Двенадцать минус три <w>равно</w> девяти.",
                                "de": "Zwölf minus drei <w>ist</w> neun."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dat is",
                        "het is",
                        "er is",
                        "wat is er"
                    ],
                    "target_lang_definitions": {
