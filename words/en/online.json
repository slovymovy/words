        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a56273a9-e604-3bbc-8498-7bb01c667a20",
                    "sense_definition": "Connected to a computer network or the Internet.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "connected_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will be <w>online</w> tonight, so I can reply to your email.",
                            "target_lang_translations": {
                                "ru": "Я буду <w>в сети</w> сегодня вечером, так что смогу ответить на твое письмо.",
                                "pl": "Będę dziś wieczorem <w>online</w>, więc będę mógł odpowiedzieć na Twój e-mail."
                            }
                        },
                        {
                            "text": "Is the printer <w>online</w> and ready to print documents?",
                            "target_lang_translations": {
                                "ru": "Принтер <w>в сети</w> и готов к печати документов?",
                                "pl": "Czy drukarka jest <w>podłączona</w> i gotowa do drukowania dokumentów?"
                            }
                        }
                    ],
                    "synonyms": [
                        "connected"
                    ],
                    "antonyms": [
                        "offline"
                    ],
                    "common_phrases": [
                        "go online",
                        "stay online",
                        "come online"
                    ],
                    "target_lang_definitions": {
