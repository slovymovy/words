                            {
                                "example_id": "a9d4b2f1-0ce2-4795-b743-ec759464a10c",
                                "sense_id": "73d041d6-798e-3a4a-bdc3-9e3e77755207",
                                "text": "Gestern haben wir im Garten drei kleine Windspiele aufgehängt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5aaefe71-0d4d-3827-a034-997ed46047e6",
