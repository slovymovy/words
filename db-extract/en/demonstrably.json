                "senses": [
                    {
                        "sense_id": "cbd8e994-7347-30ab-9591-01b9cd47efce",
                        "entry_id": "83621dbc-1f87-31f2-b95b-f80bff68a4d1",
                        "glosses": [
                            "In such a manner that is capable of being demonstrated, shown, or proved (without doubt)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "528a72c2-0bd9-4330-a0cd-230485ca1da6",
                                "sense_id": "cbd8e994-7347-30ab-9591-01b9cd47efce",
                                "text": "The country has become demonstrably less safe under his leadership."
                            },
                            {
                                "example_id": "bfe15078-59e5-45cf-88c5-9cd2eb83c2fb",
                                "sense_id": "cbd8e994-7347-30ab-9591-01b9cd47efce",
                                "text": "Hence it followeth demonstrably, if our refusall to receiue Maister Blackwell to our Arch-priest, did, or could any way possibly make vs schismaticks, that the only and principall cause of such our refusall, was, and of all necessitie must needes haue bin, for that the Pope (note our words) or the Cardinall by his commission, had (instituting the subordination) appointed him for our Superior […]"
                            },
                            {
                                "example_id": "65256de1-0682-4662-8481-e7332c2bf9ba",
                                "sense_id": "cbd8e994-7347-30ab-9591-01b9cd47efce",
                                "text": "Which (besides, that it would justifie the Socinian, in telling the World, That they have been a long Time troubled with a needless sort of Men called Preachers or Ministers) is most demonstrably false, there being some Thousands in the World, that can Discourse well in Company, and many Lawyers that can Plead very well at a Bar;"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2c44683-d75f-4ded-9198-7b7d92e27243",
                        "source_entry_id": "83621dbc-1f87-31f2-b95b-f80bff68a4d1",
                        "source_sense_id": "cbd8e994-7347-30ab-9591-01b9cd47efce",
                        "source_sense_description": "in such a manner as to be capable of being demonstrated",
                        "target_lang_word": "démontrablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "démontrablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61c29089-7134-301e-8966-a444d0d1be11",
                                        "entry_id": "be51865e-339c-32c4-958a-3b10b38c7054",
                                        "glosses": [
                                            "D’une façon démontrable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da10464d-1810-413c-90a5-0b479816bd70",
                                                "sense_id": "61c29089-7134-301e-8966-a444d0d1be11",
                                                "text": "Or, elle a démontrablement contribué à éloigner maints fidèles et à faire progresser de façon dramatique la déchristianisation."
                                            },
                                            {
                                                "example_id": "fd396c50-29b1-4b86-b7a4-2c536a9cebbd",
                                                "sense_id": "61c29089-7134-301e-8966-a444d0d1be11",
                                                "text": "Si ceux-ci ont toujours une solution, toute proposition est soit démontrablement vraie, soit démontrablement fausse. On pourrait croire encore que démontrer qu’un problème est insoluble équivaut à le résoudre effectivement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
