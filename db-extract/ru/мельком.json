        "ru-extract.jsonl": [
            {
                "entry_id": "d9ff2e5d-a2c3-32f0-9ba6-83d2f2519da8",
                "word": "мельком",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f44ad41c-70e7-38e8-bc1f-2bbf95085adc",
                        "entry_id": "d9ff2e5d-a2c3-32f0-9ba6-83d2f2519da8",
                        "glosses": [
                            "очень непродолжительное время; быстро, бегло"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322fa43e-6a3b-4ef7-90ea-4eeea7c15a86",
                                "sense_id": "f44ad41c-70e7-38e8-bc1f-2bbf95085adc",
                                "text": "Офицеров видели они только мельком и в спины, но уже́ решили, что между ними нет ни одного хорошенького и интересного…"
                            }
                        ]
                    },
                    {
                        "sense_id": "1880866b-2a27-3877-8d15-eac708f05bac",
                        "entry_id": "d9ff2e5d-a2c3-32f0-9ba6-83d2f2519da8",
                        "glosses": [
                            "бегло и не углубляясь в детали, поверхностно, вскользь"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "53b38b37-3689-4c00-bf86-91b7b687f8d3",
                        "source_entry_id": "d9ff2e5d-a2c3-32f0-9ba6-83d2f2519da8",
                        "source_sense_description": "очень непродолжительное время",
                        "target_lang_word": "rapidement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rapidement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e3c2172-e072-36f6-bf44-ef0b7308b39e",
                                        "entry_id": "ae17a514-c1bb-3525-adbf-4368a3d8558c",
                                        "glosses": [
                                            "Avec rapidité ; d’une manière rapide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce8bc542-a7f4-444f-b45b-73a23cad2339",
                                                "sense_id": "0e3c2172-e072-36f6-bf44-ef0b7308b39e",
                                                "text": "Autrefois, nos écorces se vendaient à vil prix, et nos cuirs n’avaient pas une grande valeur ; mais nos écorces et nos cuirs, une fois bonifiés, la rivière nous permit de construire des moulins à tan, il nous vint des tanneurs dont le commerce s’accrut rapidement."
                                            },
                                            {
                                                "example_id": "b6ad5e8a-db82-463b-bad0-c28b1b536236",
                                                "sense_id": "0e3c2172-e072-36f6-bf44-ef0b7308b39e",
                                                "text": "Mais, depuis la bataille de Tolbiac et la conversion de Clovis, l’Église eut ses coudées franches et put rapidement asseoir son influence à travers le territoire."
                                            },
                                            {
                                                "example_id": "1038d086-706f-4675-abd6-240a418372a2",
                                                "sense_id": "0e3c2172-e072-36f6-bf44-ef0b7308b39e",
                                                "text": "Cependant, il convient de retenir que les honoraires du radiesthésiste ne doivent pas être excessifs, sans quoi il perdrait rapidement sa clientèle."
                                            },
                                            {
                                                "example_id": "7e4e94b8-0266-461e-bc26-727a2c019352",
                                                "sense_id": "0e3c2172-e072-36f6-bf44-ef0b7308b39e",
                                                "text": "Les aliments détaillés en menus morceaux sont sautés très rapidement avec très peu de matière grasse dans un récipient hémisphérique placé sur un brûleur très puissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2fd267a-5570-372c-9115-f64161c88480",
                                        "entry_id": "ae17a514-c1bb-3525-adbf-4368a3d8558c",
                                        "glosses": [
                                            "À grande vitesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f044259-ae05-4acf-b2cb-2d802ea94289",
                                                "sense_id": "c2fd267a-5570-372c-9115-f64161c88480",
                                                "text": "J’aime bien rouler rapidement mais cela fait mal aux cervicales et aux bras, je dois demander des arrêts plus fréquents."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ea27eda-dac3-3f72-9ffa-0cd7da686de1",
                                        "entry_id": "ae17a514-c1bb-3525-adbf-4368a3d8558c",
                                        "glosses": [
                                            "Dans peu de temps ; en peu de temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63b1a767-1789-4756-a0f1-35460ca5179b",
                                                "sense_id": "7ea27eda-dac3-3f72-9ffa-0cd7da686de1",
                                                "text": "Sans doute eut-il peur que nous nous inquiétassions alors pour sa santé car il n'aborda rapidement plus le sujet et fit gauchement mine de s'être joué de nous."
                                            },
                                            {
                                                "example_id": "e70d6060-0675-4376-a931-315ff4bf408c",
                                                "sense_id": "7ea27eda-dac3-3f72-9ffa-0cd7da686de1",
                                                "text": "Il faut que je te parle rapidement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c8f75a4-670c-45d5-a92f-33c7c32c8526",
                        "source_entry_id": "d9ff2e5d-a2c3-32f0-9ba6-83d2f2519da8",
                        "source_sense_description": "очень непродолжительное время",
                        "target_lang_word": "brièvement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "brièvement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                        "entry_id": "714e0f27-ff97-31f4-8498-86fb01e50438",
                                        "glosses": [
                                            "En peu de mots, de façon brève."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0de1dfb8-7232-475b-b97c-f0a5f4315d4b",
                                                "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                                "text": "Nous avons montré aussi brièvement qu’il a été possible, quelle est la dignité de duc et pair dans tous les âges de la monarchie."
                                            },
                                            {
                                                "example_id": "1ac47509-57a8-4ad5-8d96-6bf2e4a9c73f",
                                                "sense_id": "22a979c3-0058-3b25-a03d-c6f47d5fd8eb",
                                                "text": "Je lui exposai brièvement mes aventures, et il m’écouta en silence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "887c87ce-e1e0-4190-9ee1-6fec5e3c402c",
                        "source_entry_id": "d9ff2e5d-a2c3-32f0-9ba6-83d2f2519da8",
                        "source_sense_description": "не углубляясь в детали",
                        "target_lang_word": "en passant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en passant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                        "entry_id": "8f66eeb2-a967-36bb-89f0-053f840638c2",
                                        "glosses": [
                                            "En faisant avec quelque sorte de précipitation et sans y avoir donné le temps nécessaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce26b0e5-0fa2-46f4-9f91-1d237f566b24",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "Je n’ai pas eu le loisir d’examiner l’endroit, je ne l’ai vu qu’en passant."
                                            },
                                            {
                                                "example_id": "5e61dcc1-c9c4-49fe-bdae-cba42d441375",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "Je ne lui ai parlé de votre affaire qu’en passant."
                                            },
                                            {
                                                "example_id": "fe87bf55-d1e2-464e-b9a6-1b8a731bfd5c",
                                                "sense_id": "7580ce3d-0a85-3aa9-90e8-139fb1fdc78c",
                                                "text": "J’ai traité cet appel comme n’importe quel autre, sans enjeu d’aucune sorte, un petit signe en passant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                        "entry_id": "8f66eeb2-a967-36bb-89f0-053f840638c2",
                                        "glosses": [
                                            "Se dit, en interrompant le fil d’une conversation, pour parler succinctement d’une chose qui se présente à l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85e1e6b1-acc3-4f9d-b790-9dd0afaa3658",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Nous dirons en passant que les céréales sont beaucoup moins sujettes à la verse en Champagne que dans d'autres contrées."
                                            },
                                            {
                                                "example_id": "a5ed221b-b9d9-42e8-8ea1-80fa3aa1242b",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Un peu de ridicule et de bizarrerie se mêle infailliblement à cette époque transitoire de l’âge des garçons, et il me faut bien indiquer cette note en passant."
                                            },
                                            {
                                                "example_id": "9dd02069-9bcd-4fb9-823f-6a7d19d92682",
                                                "sense_id": "a192a29c-0e1f-35c7-af28-082159c24050",
                                                "text": "Je mentionne, en passant, les méfaits du micronationalisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "17794a2b-4d60-444c-b328-e4be1e97bd8e",
                        "source_entry_id": "d9ff2e5d-a2c3-32f0-9ba6-83d2f2519da8",
                        "source_sense_description": "не углубляясь в детали",
                        "target_lang_word": "superficiellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "superficiellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6350995d-5593-3e55-9fdf-c4ce3db23f42",
                                        "entry_id": "45e4ea3d-3502-309a-82b5-50d6dd67918a",
                                        "glosses": [
                                            "En superficie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2df82a15-c75a-43ef-b0c1-dc7ce37f921d",
                                                "sense_id": "6350995d-5593-3e55-9fdf-c4ce3db23f42",
                                                "text": "Ce champ contient mille mètres superficiellement, c’est-à-dire 1000 mètres carrés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7dbc6a9b-f8b7-37e0-9efb-d173389e9997",
                                        "entry_id": "45e4ea3d-3502-309a-82b5-50d6dd67918a",
                                        "glosses": [
                                            "D’une manière superficielle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d714ab57-03fa-4e0d-9ad0-42095cc71300",
                                                "sense_id": "7dbc6a9b-f8b7-37e0-9efb-d173389e9997",
                                                "text": "Libre d’agir à sa guise, loin de tout contrôle, il sauvait seulement les apparences en émiant superficiellement son humus, sans guère se soucier des fondations — pour ce qu’il aurait à y planter !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d161d7d-5afd-3b40-ad29-d5ba56981921",
                                        "entry_id": "45e4ea3d-3502-309a-82b5-50d6dd67918a",
                                        "glosses": [
                                            "D’une manière superficielle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99568766-8c38-45bf-9d40-2e8a22633e45",
                                                "sense_id": "2d161d7d-5afd-3b40-ad29-d5ba56981921",
                                                "text": "J'ai dit que vous aviez lu superficiellement les petites lettres [les Provinciales] ; je m’en repens ; elles sont belles et trop dignes de vous pour avoir douté que vous ne les eussiez toutes lues avec application,"
                                            },
                                            {
                                                "example_id": "7ebb645d-94c1-470d-a292-bbaea6beb128",
                                                "sense_id": "2d161d7d-5afd-3b40-ad29-d5ba56981921",
                                                "text": "Si vous pensez que ces paroles passent superficiellement dans mon cœur, vous vous trompez ; je les sens vivement, elles s'y établissent,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
