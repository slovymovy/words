                ],
                "senses": [
                    {
                        "sense_id": "0515ac80-92ad-356e-85a6-532d91702fb9",
                        "entry_id": "2cec42b4-1fbf-368b-8d52-c80f059cbacf",
                        "glosses": [
                            "Élément qui s’insère de façon discontinue à l’intérieur d’un mot et qui en modifie le sens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a506488f-ee25-4cbb-9aa9-2c746eb0347a",
                                "sense_id": "0515ac80-92ad-356e-85a6-532d91702fb9",
                                "text": "On trouve des transfixes surtout dans les langues sémitiques. Par exemple : en maltais, à partir de la racine trilitère ktb = écrire, les quatre transfixes -i-e- / -i--u / --ie- / -o--a donnent kiteb / kitbu / ktieb / kotba = il a écrit / ils ont écrit / livre / livres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f440ce44-e996-4843-bfe3-5bf27210ae0d",
                        "source_entry_id": "2cec42b4-1fbf-368b-8d52-c80f059cbacf",
                        "source_sense_id": "0515ac80-92ad-356e-85a6-532d91702fb9",
                        "target_lang_word": "Transfix",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "0ebceb60-85fa-4be8-bb27-514a6de83031",
                        "source_entry_id": "2cec42b4-1fbf-368b-8d52-c80f059cbacf",
                        "source_sense_id": "0515ac80-92ad-356e-85a6-532d91702fb9",
                        "target_lang_word": "transfix",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "transfix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b8e0156-b625-320c-9a68-5634ade2b850",
                                        "entry_id": "19196002-d128-3ed5-813b-7eda1f428d38",
                                        "glosses": [
                                            "To render motionless, by arousing terror, amazement or awe."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7015402d-953f-497b-8d58-be0cd6e550e0",
                                                "sense_id": "3b8e0156-b625-320c-9a68-5634ade2b850",
                                                "text": "He stood transfixed before the unaccustomed view of London at night time, a vast panorama which reminded him […] of some wood engravings far off and magical, in a printshop in his childhood. They dated from the previous century and were coarsely printed on tinted paper, with tinsel outlining the design."
                                            },
                                            {
                                                "example_id": "0b2df3c5-d6da-4234-9d38-81bd1cf6d835",
                                                "sense_id": "3b8e0156-b625-320c-9a68-5634ade2b850",
                                                "text": "But we may as well accept her story as true, for it is likely she would have been transfixed by the narcissism of the weight lifters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac169ab5-29d7-3c91-8871-ac51e6777520",
                                        "entry_id": "19196002-d128-3ed5-813b-7eda1f428d38",
                                        "glosses": [
                                            "To pierce with a sharp pointed weapon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4428244-fd8b-467c-8ef2-c977625452fb",
                                                "sense_id": "ac169ab5-29d7-3c91-8871-ac51e6777520",
                                                "text": "The spear transfixed my arm that was uplifted\nIn swift expostulation, and the blood\nGushed round its point: I smiled, […]"
                                            },
                                            {
                                                "example_id": "8baca5ec-d114-4265-940d-d6bfe71c9e9e",
                                                "sense_id": "ac169ab5-29d7-3c91-8871-ac51e6777520",
                                                "text": "There was a little stream that ran not far away, in which he bathed, and down this on occasion would come a shoal of fish. Then the natives would assemble with spears, and with much shouting would transfix the great startled things as they hurried down to the sea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fe80594-8891-36d0-83d1-76d11df958d2",
                                        "entry_id": "19196002-d128-3ed5-813b-7eda1f428d38",
                                        "glosses": [
                                            "To fix or impale."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "transfix",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7a197a2-0af7-37f5-8ee4-a3bbb21b2709",
                                        "entry_id": "188fa411-e44e-3f29-b75c-9cc4e61c2f4a",
                                        "glosses": [
                                            "A discontinuous affix, typical of Afro-Asiatic languages, which occurs at more than one position in a word, i.e. a combination of prefixes, infixes and/or suffixes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f6398f8-f24f-490d-9f56-5a07d5527f29",
                                                "sense_id": "f7a197a2-0af7-37f5-8ee4-a3bbb21b2709",
                                                "text": "The Arabic word مكتوب (maktūb, “written”) is built from the root [script needed] (k–t–b, “writing”) and the transfix [script needed] (ma––ū–, “passive participle”)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
