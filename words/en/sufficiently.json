{
    "word_family": [
        "suffice",
        "sufficient",
        "sufficiency",
        "insufficient",
        "insufficiently"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "b142f75b-bc89-39ec-a15b-61bd719ef20e",
                    "sense_definition": "To a degree that is enough for a particular purpose.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could not find <w>sufficiently</w> long sticks to build the shelter.",
                            "target_lang_translations": {
                                "ru": "Мы не смогли найти <w>достаточно</w> длинные палки, чтобы построить укрытие.",
                                "pl": "Nie mogliśmy znaleźć <w>wystarczająco</w> długich kijów, aby zbudować schronienie.",
                                "zh": "我们找不到<w>足够</w>长的木棍来搭建避难所。"
                            }
                        },
                        {
                            "text": "Please ensure that the instructions are <w>sufficiently</w> clear for the students to understand.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что инструкции <w>достаточно</w> понятны для студентов.",
                                "pl": "Proszę upewnić się, że instrukcje są <w>dostatecznie</w> jasne, aby uczniowie mogli je zrozumieć.",
                                "zh": "请确保说明<w>足够</w>清晰，以便学生能够理解。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adequately",
                        "enough"
                    ],
                    "antonyms": [
                        "insufficiently"
                    ],
                    "common_phrases": [
                        "sufficiently large",
                        "sufficiently clear",
                        "sufficiently high",
                        "sufficiently strong"
                    ],
                    "target_lang_definitions": {
                        "ru": "В такой степени, которой хватает для определенной цели; в необходимой мере.",
                        "pl": "W stopniu wystarczającym do określonego celu.",
                        "zh": "达到某特定目的所需的程度；足够地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достаточно",
                                "target_lang_sense_clarification": "в необходимой мере"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wystarczająco",
                                "target_lang_sense_clarification": "w stopniu zaspokajającym potrzeby"
                            },
                            {
                                "target_lang_word": "dostatecznie",
                                "target_lang_sense_clarification": "w stopniu zadowalającym"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "足够",
                                "target_lang_sense_clarification": "程度满足特定要求"
                            },
                            {
                                "target_lang_word": "充分",
                                "target_lang_sense_clarification": "程度完全、达到要求"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3ab3eb9-99c2-3da4-8b8a-b05e5bcf530b",
                    "sense_definition": "In a way or amount that is enough.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Once we had eaten <w>sufficiently</w>, we went upstairs to sleep.",
                            "target_lang_translations": {
                                "ru": "Как только мы поели <w>достаточно</w>, мы пошли наверх спать.",
                                "pl": "Gdy już zjedliśmy <w>wystarczająco</w>, poszliśmy na górę spać.",
                                "zh": "等我们吃得<w>足够</w>饱了，就上楼睡觉了。"
                            }
                        },
                        {
                            "text": "The team was <w>sufficiently</w> prepared for the difficult challenge ahead.",
                            "target_lang_translations": {
                                "ru": "Команда была <w>достаточно</w> подготовлена к предстоящему трудному испытанию.",
                                "pl": "Zespół był <w>wystarczająco</w> przygotowany na nadchodzące trudne wyzwanie.",
                                "zh": "该团队为即将面临的艰巨挑战做好了<w>充分</w>的准备。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adequately"
                    ],
                    "antonyms": [
                        "inadequately",
                        "insufficiently"
                    ],
                    "common_phrases": [
                        "sufficiently prepared",
                        "sufficiently recovered",
                        "sufficiently developed"
                    ],
                    "target_lang_definitions": {
                        "ru": "В количестве или образом, которого достаточно; столько, сколько нужно.",
                        "pl": "W sposób lub w ilości, która jest wystarczająca.",
                        "zh": "以足够的方式或数量；充分地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "достаточно",
                                "target_lang_sense_clarification": "столько, сколько нужно"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wystarczająco",
                                "target_lang_sense_clarification": "w odpowiedniej ilości lub stopniu"
                            },
                            {
                                "target_lang_word": "dostatecznie",
                                "target_lang_sense_clarification": "w sposób zadowalający"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "充分",
                                "target_lang_sense_clarification": "程度或数量完备充足"
                            },
                            {
                                "target_lang_word": "足够",
                                "target_lang_sense_clarification": "数量或分量充足"
                            }
                        ]
                    }
                }
            ]
        }
    ]
