                                "target_senses": [
                                    {
                                        "sense_id": "bbab0eb0-0cc7-36a5-bd85-8a5b013b60db",
                                        "entry_id": "94463bd6-37a5-3461-8d00-da80e1c1a03c",
                                        "glosses": [
                                            "A subsequent stream or faultline."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76806960-feba-466c-9591-7a4b598b10a4",
                                                "sense_id": "bbab0eb0-0cc7-36a5-bd85-8a5b013b60db",
                                                "text": "When the Middle Wye was turned into the Severn system it still continued the northward subsequent, which of course may have been initiated as a tributary when the Middle Wye belonged to the Thames system."
