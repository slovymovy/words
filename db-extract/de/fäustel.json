                                        "examples": [
                                            {
                                                "example_id": "98143be1-b940-45f0-96de-26c057c169fb",
                                                "sense_id": "272b3a2b-1efe-33bd-8188-9bf30e6c940a",
                                                "text": "Hij gaf hem een klap met zijn vuist."
                                            },
                                            {
                                                "example_id": "b24a08e3-9eec-4b36-9a09-d11a179c310b",
                                                "sense_id": "272b3a2b-1efe-33bd-8188-9bf30e6c940a",
                                                "text": "En dit ' Nella houdt de plattegrond van haar jeugd in haar vuist omhoog."
                                            },
                                            {
                                                "example_id": "d009acd1-65e8-44b7-a0ff-7be2011d3677",
                                                "sense_id": "272b3a2b-1efe-33bd-8188-9bf30e6c940a",
                                                "text": "Langzaam, stilletjes, met de rol nog altijd in haar vuist, verwijdert ze zich van haar piepkleine ouders."
                                            },
                                            {
                                                "example_id": "2bbbbece-ed7f-4869-8c4f-3367bc963aca",
                                                "sense_id": "272b3a2b-1efe-33bd-8188-9bf30e6c940a",
                                                "text": "Ze houdt Walter in haar vuist en knijpt in hem, alsof ze haar geliefde daarmee kan motiveren beslissende stappen te zetten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44b97b88-8431-3231-9890-4f038cf638de",
                                        "entry_id": "7efd8df9-ef0e-32d8-978b-63ffb831417d",
                                        "glosses": [
                                            "en zware hamer met een korte steel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "800b0777-cb71-4bc3-8aea-cd48a71fdd71",
                                                "sense_id": "44b97b88-8431-3231-9890-4f038cf638de",
                                                "text": "Met een koudbeitel en vuist werd de vastgeroeste moer er grofweg afgeslagen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
