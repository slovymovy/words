                "senses": [
                    {
                        "sense_id": "7f9a8e49-c447-32ac-8b33-2101a5f8d44d",
                        "entry_id": "41f1eddb-b1a2-3d25-a8ef-dd75f51aacfe",
                        "glosses": [
                            "Nom donné à ceux qui avaient exercé la charge de préteur pendant un an, et plus tard à ceux qui dirigeaient les provinces avec l’autorité de préteur."
                        ],
                        "tags": [
                            "Ancient-Roman"
                        ],
                        "examples": [
                            {
                                "example_id": "75ec0f5e-efbe-496f-8630-54dbb245c445",
                                "sense_id": "7f9a8e49-c447-32ac-8b33-2101a5f8d44d",
                                "text": "Il a noué de très bons rapports avec les Convènes ; le propréteur entend s’en servir mais, étant donné les méthodes dont il use, les relations entre Romains et Gaulois vont rapidement se dégrader."
                            },
                            {
                                "example_id": "d518c244-ea1d-489c-b589-81a1f05932a1",
                                "sense_id": "7f9a8e49-c447-32ac-8b33-2101a5f8d44d",
                                "text": "Si trop de proconsuls et de propréteurs ne demandaient qu’à fermer les yeux sur les méfaits de ces derniers, sauf à recevoir de leur tolérance le juste prix, d’autres essayèrent d’y mettre obstacle."
                            }
                        ]
                    }
                ],
