                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6157c505-75e3-33fc-bb6f-a7d616cc183d",
                        "entry_id": "215b7856-1656-35f3-bd0f-32161b110da9",
                        "glosses": [
                            "Attention ! Gaffe !"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc79985-e741-4652-8a1b-eee56f360140",
                                "sense_id": "6157c505-75e3-33fc-bb6f-a7d616cc183d",
                                "text": "Les bouches se ferment machinalement, nos yeux se baissent, nos faces s’essaient à mentir — parce qu’un homme à mine douteuse vient d’entrer et s’est mis dans ce coin…\nLegrand m’a fait signe, et nous avons dû jouer la comédie comme au collège on criait : Vesse ! quand on croyait que le surveillant arrivait."
                            }
                        ]
                    }
                ],
