                            "trait_type": "form",
                            "comment": "used in sports and physical training"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Упражнение «приставной шаг со скрещиванием ног», при котором ноги поочередно ставятся спереди и сзади друг друга для растяжки нижней части тела."
                    },
                    "translations": {
                        "ru": [
