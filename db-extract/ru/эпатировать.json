                                        "glosses": [
                                            "To meet with a shock; to collide in a violent encounter."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e648c27-3229-4164-8f66-cd86147fdb50",
                                                "sense_id": "9b2ad3b7-4eff-3e4d-8478-be5feb3a3ef5",
                                                "text": "They saw the moment approach when the two parties would shock together."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0a4e03b-055b-3681-8142-5ad3c9cd9b60",
                                        "entry_id": "0228bf06-9a3b-3570-a06f-10073feac2fa",
                                        "glosses": [
                                            "To add a chemical to (a swimming pool) to moderate the chlorine levels."
                                        ],
