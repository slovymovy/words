                    {
                        "sense_id": "5a841b26-c16c-3672-9dd5-c5b049808951",
                        "entry_id": "a0c05adc-5e9a-3836-9e60-d3b4c00a470b",
                        "glosses": [
                            "pas z kieszeniami na pieniądze"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "65e9d22e-c228-41b9-9c5c-6b723cefd458",
                                "sense_id": "5a841b26-c16c-3672-9dd5-c5b049808951",
                                "text": "Nie zdobywajcie złota ani srebra, ani miedzi do swych trzosów"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "21c5fe98-be33-30d4-9c0d-096b8d009e84",
                        "entry_id": "a0c05adc-5e9a-3836-9e60-d3b4c00a470b",
