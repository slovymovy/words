                "senses": [
                    {
                        "sense_id": "0d081156-6a1d-30e4-9b8a-7bbfe3eb3145",
                        "entry_id": "f4bf1d9c-2600-33e8-b66f-f4256faf9c69",
                        "glosses": [
                            "Spielgeschehen, bei dem Einbußen an Siegpunkten erfolgen, Turnier, bei dem ein einzelnes Spiel verloren geht oder (übertragen) wettkampfähnliches Ereignis, bei dem ein Nachteil erlitten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b63d798d-1528-4c37-843e-9dd82ac89098",
                                "sense_id": "0d081156-6a1d-30e4-9b8a-7bbfe3eb3145",
                                "text": "„Endlich noch die Spiele im engeren Sinn: Gewinn- und Verlustspiele, nicht in körperlicher Bewegung bestehend und zwischen zwei oder wenig mehr Personen gespielt.“"
                            },
                            {
                                "example_id": "0cfafc27-22bc-4206-a6a7-acd4a7d3ca08",
                                "sense_id": "0d081156-6a1d-30e4-9b8a-7bbfe3eb3145",
                                "text": "„Bemerkenswert gut gelaunt war Ferguson zum Gespräch über die Champions League erschienen, die Aussicht eines desaströsen Verlustspiels gegen Kiew schien ihn nicht zu ängstigen.“"
                            },
                            {
                                "example_id": "e42905f0-afa6-42ab-a7f4-995bb6840039",
                                "sense_id": "0d081156-6a1d-30e4-9b8a-7bbfe3eb3145",
                                "text": "„Er erwartet nach dem Verlustspiel gegen Gladbach eine positive Reaktion seiner Elf.“"
                            },
                            {
                                "example_id": "97ad8c25-a4f8-4415-b811-b1b1928524f7",
                                "sense_id": "0d081156-6a1d-30e4-9b8a-7bbfe3eb3145",
                                "text": "„Fragt man die Berliner, warum sie sich auf dieses Verlustspiel einließen, murmeln sie.“"
                            },
                            {
                                "example_id": "d09d2d72-dd99-460c-92f5-b17612e0e7ee",
                                "sense_id": "0d081156-6a1d-30e4-9b8a-7bbfe3eb3145",
                                "text": "„Längerfristig ist es aber ein Verlustspiel, wenn in der Folge Beschäftigung abgebaut wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
