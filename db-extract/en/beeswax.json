                                "sense_id": "d2615860-53fa-35e2-a47b-8c0e438b734d",
                                "text": "The candle was made entirely of natural beeswax."
                            },
                            {
                                "example_id": "07a3d6f1-4173-4df4-b54a-bcd75020ee70",
                                "sense_id": "d2615860-53fa-35e2-a47b-8c0e438b734d",
                                "text": "She polished the furniture with beeswax to give it a shine."
                            },
                            {
                                "example_id": "0da37460-96f7-47a2-aed3-4f8e6aaac577",
                                "sense_id": "d2615860-53fa-35e2-a47b-8c0e438b734d",
                                "text": "The beekeeper collected honey and beeswax from the hives."
                            }
                        ]
