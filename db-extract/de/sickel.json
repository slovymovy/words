                ],
                "senses": [
                    {
                        "sense_id": "96cbae1f-bb13-3561-81c3-66ac33b566b1",
                        "entry_id": "2d23b6db-26ab-39fe-81ee-be25eeeffbf4",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a3a0dcb-beb3-466f-8a28-3fd2f9ed249e",
                                "sense_id": "96cbae1f-bb13-3561-81c3-66ac33b566b1",
                                "text": "Frau Sickel ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0465b14d-7a66-4bdf-8cff-a71dbbbc7197",
                                "sense_id": "96cbae1f-bb13-3561-81c3-66ac33b566b1",
                                "text": "Herr Sickel wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "53bfafdd-442a-4896-b56a-40ae00fe55c7",
                                "sense_id": "96cbae1f-bb13-3561-81c3-66ac33b566b1",
                                "text": "Die Sickels fahren heute ins Riesengebirge."
                            },
                            {
                                "example_id": "99395a83-f484-4529-b62a-554df119b967",
                                "sense_id": "96cbae1f-bb13-3561-81c3-66ac33b566b1",
                                "text": "Der Sickel trägt nie die Schals, die die Sickel ihm strickt."
                            },
                            {
                                "example_id": "4716d261-5606-47be-b5a7-c180c47bf2da",
                                "sense_id": "96cbae1f-bb13-3561-81c3-66ac33b566b1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Sickel kommt, geht der Herr Sickel.“"
                            },
                            {
                                "example_id": "fd32affa-927c-4e53-92ca-a2d80f4b7a9e",
                                "sense_id": "96cbae1f-bb13-3561-81c3-66ac33b566b1",
                                "text": "Sickel kommt und geht."
                            },
                            {
                                "example_id": "92c609fd-6232-4429-a471-9fd93b9a928f",
                                "sense_id": "96cbae1f-bb13-3561-81c3-66ac33b566b1",
                                "text": "Sickels kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
