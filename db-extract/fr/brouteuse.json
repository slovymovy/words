                    },
                    {
                        "sense_id": "993aac1e-b4ac-38e1-951e-ebe263a7ccd8",
                        "entry_id": "e0b5d327-53e5-3145-8dc9-36ba49242113",
                        "glosses": [
                            "Escroc qui contacte ses victimes à distance par Internet."
                        ],
                        "tags": [
