                                        "glosses": [
                                            "chi sostiene, segue o si ispira al pensiero o alla politica di Silvio Berlusconi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0098b7ad-248e-4cd7-9999-76ed7a964880",
                                                "sense_id": "4c937213-ed60-3f2b-bf37-055d79f67f58",
                                                "text": "contro un rigurgito comunista destabilizzante, i berlusconiani non possono accettare vani attacchi per la ricchezza, presunta immeritata"
                                            },
                                            {
                                                "example_id": "b58d37d5-ba6e-4cf5-a0a4-426a995d06c8",
                                                "sense_id": "4c937213-ed60-3f2b-bf37-055d79f67f58",
                                                "text": "io vorrei sapere come farà ogni berlusconiano con la morte di Silvio Berlusconi"
                                            }
                                        ]
