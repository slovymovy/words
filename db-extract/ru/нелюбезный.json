                ],
                "translations": [
                    {
                        "translation_id": "b0efd8a3-b221-474f-8ae1-17df0eec120c",
                        "source_entry_id": "6fcd04e5-36c6-36b2-be91-d885b7066e17",
                        "source_sense_id": "92561f0d-a476-32b1-91ca-c583a8d3cc0c",
                        "target_lang_word": "ungracious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ungracious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5fdcb5-310e-3b6c-bba0-d249efeedcb6",
                                        "entry_id": "0a51f446-2695-3574-86d7-8b871cfa270f",
                                        "glosses": [
                                            "Not gracious; unkind or cold-hearted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b97f6c4-8bfd-49ec-a64d-98d6bf861a66",
                                                "sense_id": "4d5fdcb5-310e-3b6c-bba0-d249efeedcb6",
                                                "text": "One might have hoped for more about the Widened Lines and about the G.C. approach to Marylebone—but it is ungracious to point to omissions when so much is contained within 260 pages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44597670-b367-4ded-9814-671152c2d1a4",
                        "source_entry_id": "6fcd04e5-36c6-36b2-be91-d885b7066e17",
                        "source_sense_id": "92561f0d-a476-32b1-91ca-c583a8d3cc0c",
                        "target_lang_word": "discourteous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discourteous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15aeba22-8813-3056-afbb-7a8daab188bf",
                                        "entry_id": "0535657f-d204-3992-99d9-93fb3cb98231",
                                        "glosses": [
                                            "impolite; lacking consideration for others"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "608d223f-3d0b-4849-b9f7-e382514ef1d1",
                                                "sense_id": "15aeba22-8813-3056-afbb-7a8daab188bf",
                                                "text": "Kirk, who succeeded Drumright, had an unusually short tour of duty in Taipei—only about a year. Despite the shortness of his duty, he left the impression of being an old sea captain who would have felt more at home barking his orders from the bridge than heading an important diplomatic mission. There was nothing civil or gentle about him, and even in talking to President Chiang, he sounded gruff and blunt. I could see that the President really didn't enjoy the envoy's company, but he remained unperturbed and discussed in a calm and friendly manner whatever had prompted the Ambassador to seek the audience. Once I heard him remark half to himself: \"How could anyone be so discourteous?\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "addfd5b1-512b-40b3-a5ff-5d56e5c3cb0a",
                        "source_entry_id": "6fcd04e5-36c6-36b2-be91-d885b7066e17",
                        "source_sense_id": "92561f0d-a476-32b1-91ca-c583a8d3cc0c",
                        "target_lang_word": "unfreundlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfreundlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1bdf0fd9-2c04-3253-aae0-1a3c9bf817bd",
                                        "entry_id": "0f74e6dd-3724-3aab-b163-d261d1f6b1d4",
                                        "glosses": [
                                            "auf eine abweisende Art und Weise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19cfd8ca-6c01-49a3-b8d9-228148ab7d46",
                                                "sense_id": "1bdf0fd9-2c04-3253-aae0-1a3c9bf817bd",
                                                "text": "„Sei nicht so unfreundlich zu deiner Tante!“"
                                            },
                                            {
                                                "example_id": "cfc16481-4466-46c4-919c-a04f8d975a52",
                                                "sense_id": "1bdf0fd9-2c04-3253-aae0-1a3c9bf817bd",
                                                "text": "Als Hubert die Aula betrat, erlebte ich einmal hautnah eine wirklich unfreundliche Begrüßung durch die anwesenden Studenten."
                                            },
                                            {
                                                "example_id": "666b69e9-76af-4e64-9135-97bda048544a",
                                                "sense_id": "1bdf0fd9-2c04-3253-aae0-1a3c9bf817bd",
                                                "text": "Musst du so unfreundlich sein? Du hättest auch mal Danke sagen können."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
