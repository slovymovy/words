                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5303a1e-23d9-4339-aac0-f2341c3256db",
                        "source_entry_id": "a12dcff4-ebf3-3111-8348-dd9f413338ba",
                        "source_sense_id": "d7c413b1-d775-339d-9ef1-d707584dd185",
