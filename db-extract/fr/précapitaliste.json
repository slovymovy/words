                    {
                        "sense_id": "28555abc-2a3c-3191-893c-5b6c57f70ea2",
                        "entry_id": "96e192a0-2339-374b-a329-b41aea94867d",
                        "glosses": [
                            "Antérieur au capitalisme, qui précède le capitalisme."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "6031303e-b5ba-41da-aade-5a78e9f7fe15",
                                "sense_id": "28555abc-2a3c-3191-893c-5b6c57f70ea2",
                                "text": "Contrairement à une économie capitaliste caractérisée par un lieu impersonnel d’échanges et de transactions économiques, l’économie précapitaliste se définissait et se définit encore par des échanges en grande partie fondés sur des relations personnelles et sociales entre les différents membres de la société."
                            },
                            {
                                "example_id": "02990962-1eb3-44aa-9b99-b668789e4fc0",
                                "sense_id": "28555abc-2a3c-3191-893c-5b6c57f70ea2",
                                "text": "En plus d’un rapport à l’échange spécifique, l’économie précapitaliste se caractérise par un rapport au temps particulier."
                            }
                        ]
                    }
