                        "glosses": [
                            "The state or characteristic of being lamentable."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1c3638cd-aca7-4ba1-a6c2-acf4d7df5cc2",
                                "sense_id": "d575b7a0-0516-38ea-a7dd-8c46c49028ba",
                                "text": "Mr. Bush . . ., noting first the lamentability of public violence against property(!) and holding responsible, once again, those black bodies on the street."
                            },
                            {
                                "example_id": "f4722626-4f45-4d29-85ae-d1da79cb0941",
                                "sense_id": "d575b7a0-0516-38ea-a7dd-8c46c49028ba",
                                "text": "Clearly, it is this imbalance, and not the procreative revolution that it provokes, that constitutes the lamentability of this future for Forster's narrator."
                            },
                            {
                                "example_id": "315af8d1-9c6f-4edd-83b9-edf81ea4828c",
                                "sense_id": "d575b7a0-0516-38ea-a7dd-8c46c49028ba",
                                "text": "The judge's wretchedness is a reflex of Augustine's skepticism about the possibility of justice in this world, and his deep conviction about the genuine lamentability of law's serious imperfections."
                            }
                        ]
                    }
