                        "entry_id": "5f914cbd-7c65-3cd8-a0dd-4e20c0ec6a4a",
                        "glosses": [
                            "A person who disposes of scraps, such as one who collects scrap metal to sell to a scrap dealer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d097085-f387-46f8-a9da-515869f8cca1",
                                "sense_id": "a6c79dc6-4932-3be5-a3a7-14b3244643b9",
                                "text": "After the uncle died they sold off most of his rustbuckets to a scrapper and kept one to fix up."
                            }
                        ]
                    },
                    {
                        "sense_id": "63498767-521b-38ff-98da-9972cd79b459",
                        "entry_id": "5f914cbd-7c65-3cd8-a0dd-4e20c0ec6a4a",
                        "glosses": [
                            "A person who fights doggedly, who exhibits indomitable will."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e22e06b9-a291-42af-807e-9278a23864f8",
                                "sense_id": "63498767-521b-38ff-98da-9972cd79b459",
                                "text": "He's a real scrapper, even against impossible odds, he always keeps fighting."
                            },
                            {
                                "example_id": "23c425ea-8921-40dc-963a-2418a9e29ca3",
                                "sense_id": "63498767-521b-38ff-98da-9972cd79b459",
                                "text": "\"An old scrapper don't find many openings. Chucker-out at a pub with free drinks. Nothing doing there.\""
                            }
                        ]
                    }
