                                "target_senses": [
                                    {
                                        "sense_id": "958a04ee-72d3-31f3-8489-d67a21863a24",
                                        "entry_id": "0580f787-a4d4-3aa3-b086-0e5c9f9ca03f",
                                        "glosses": [
                                            "Éclat généralement de bois et le plus souvent en forme de coin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1972e58-fcda-4076-beab-b78026c3469f",
                                                "sense_id": "958a04ee-72d3-31f3-8489-d67a21863a24",
                                                "text": "Une fois qu’elle dénouait un cordon d’or sifflant, elle s’aperçut qu’au géranium prisonnier contre la vitre d’une des fenêtres, sous le rideau de tulle, un rameau pendait, rompu, vivant encore. La ficelle d’or à peine déroulée s’enroula vingt fois autour du rameau rebouté, étayé d’une petite éclisse de carton..."
                                            },
                                            {
                                                "example_id": "d851315e-832a-4fc2-8e56-fed32aa0c8f0",
                                                "sense_id": "958a04ee-72d3-31f3-8489-d67a21863a24",
                                                "text": "Les jeunes rejets de quatre à cinq ans, fendus manuellement en fines lanières appelées éclisses, servaient à faire des paniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83eb7830-5a61-323d-996d-867506aea872",
                                        "entry_id": "0580f787-a4d4-3aa3-b086-0e5c9f9ca03f",
                                        "glosses": [
                                            "Éclat généralement de bois et le plus souvent en forme de coin.",
                                            "Bois de fente qui sert à faire des seaux, des minots, des tambours, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deec9781-e773-47e9-a9e6-f1df6fc25870",
                                                "sense_id": "83eb7830-5a61-323d-996d-867506aea872",
                                                "text": "Dans les coins [de l'atelier du brodeur], dormaient des outils antiques : […] des tambours de toutes grandeurs garnis de leur taffetas et de leur éclisse, servant à broder au crochet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "273ddfda-e9d5-3bd3-ae93-84863bc82c41",
                                        "entry_id": "0580f787-a4d4-3aa3-b086-0e5c9f9ca03f",
                                        "glosses": [
                                            "Éclat généralement de bois et le plus souvent en forme de coin.",
                                            "Plaques de bois minces dont on fait les parois latérales des violons, des violoncelles et autres instruments à cordes; ces parois elles-mêmes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47a883e2-561f-4818-9bf3-1d955806cb48",
                                                "sense_id": "273ddfda-e9d5-3bd3-ae93-84863bc82c41",
                                                "text": "Les éclisses, lames de bois qui font le tour de la caisse de résonance et relient la table d'harmonie avec la table de dessous."
                                            },
                                            {
                                                "example_id": "29e69050-022e-42ec-aedd-b68efeddfcd3",
                                                "sense_id": "273ddfda-e9d5-3bd3-ae93-84863bc82c41",
                                                "text": "A côté des guitares classiques, avec fond et éclisses en palissandre et mécanique d’accord, Torres a construit à toutes les époques de sa carrière un autre type de guitare, avec une caisse en cyprès et des chevilles d’accord ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81c0ca63-6b62-3779-b4e2-323dc0d5047f",
                                        "entry_id": "0580f787-a4d4-3aa3-b086-0e5c9f9ca03f",
                                        "glosses": [
                                            "Éclat généralement de bois et le plus souvent en forme de coin.",
                                            "Petite plaque de bois ou de carton qu’on applique le long d’un membre fracturé pour contenir les os dans une situation fixe ; attelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6731edc2-e664-4747-8324-cc15b5cca7e9",
                                                "sense_id": "81c0ca63-6b62-3779-b4e2-323dc0d5047f",
                                                "text": "Les parties de l'appareil général, nécessaire dans une fracture simple , […], sont les attelles ou les éclisses , qui sont indubitablement de toutes ces pièces celles qui agissent de la manière la plus efficace pour maintenir convenablement en contact les extrémités de l’os fracturé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d9caa0dd-baf4-3fe8-81ec-141876250901",
                                        "entry_id": "0580f787-a4d4-3aa3-b086-0e5c9f9ca03f",
                                        "glosses": [
                                            "Petit rond d’osier ou de jonc sur lequel on met égoutter le lait caillé pour en faire des fromages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af39177-3df3-43af-9ecc-9308740799ba",
                                                "sense_id": "d9caa0dd-baf4-3fe8-81ec-141876250901",
                                                "text": "[…], quand on voit que le caillé tombe au fond, on retire l'eau et le petit-lait ; on place une éclisse sur une claie à fromage placée en travers du baquet, et on y met le caillé de la manière suivante : […]."
                                            },
                                            {
                                                "example_id": "d8c136ea-9ff3-436f-9b5c-ba402ffa7ddb",
                                                "sense_id": "d9caa0dd-baf4-3fe8-81ec-141876250901",
                                                "text": "Dans la fabrication du fromage de Brie, on se sert pour le dressage des fromages, de cercles particuliers appelés hausses ou éclisses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7df07496-55b8-37b0-aeff-483658fa9874",
                                        "entry_id": "0580f787-a4d4-3aa3-b086-0e5c9f9ca03f",
                                        "glosses": [
                                            "Pièce d’acier destinée à relier les rails les uns aux autres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a131168-561a-4e31-a649-81b1d865f8b8",
                                                "sense_id": "7df07496-55b8-37b0-aeff-483658fa9874",
                                                "text": "[Les rails de mines] sont réunis bout à bout à l'aide d’éclisses, en vue de donner de la rigidité à la voie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39f17796-fd5c-319a-b59d-741c04d6717e",
                                        "entry_id": "0580f787-a4d4-3aa3-b086-0e5c9f9ca03f",
                                        "glosses": [
                                            "Plaque de bois ou de métal utilisée pour assembler bout à bout deux pièces de bois ou de métal dans le cas d'une charpente métallique. L'assemblage se fait généralement à l'aide de boulons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "688353e7-ef52-493b-aae6-bf015caa8556",
                                                "sense_id": "39f17796-fd5c-319a-b59d-741c04d6717e",
                                                "text": "Les longerons destinés à supporter le platelage du tablier sont munis , à une de leurs extrémités , d'une double éclisse."
                                            }
                                        ]
                                    }
                                ]
