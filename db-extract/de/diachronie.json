                    },
                    {
                        "form_id": "92ff0612-24bc-4cad-9b24-b0fc397f46ef",
                        "entry_id": "f2902d13-e643-3951-944a-40cb2492e9be",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Diachronie"
                    },
                    {
                        "form_id": "0494b6eb-3681-40f0-987f-998684931af3",
                        "entry_id": "f2902d13-e643-3951-944a-40cb2492e9be",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Diachronie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b8053f74-db91-3bb7-941d-42749703c5a1",
                        "entry_id": "f2902d13-e643-3951-944a-40cb2492e9be",
                        "glosses": [
                            "sprachwissenschaftlicher Ansatz zur Erforschung der historischen Entwicklung der Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdc63c6d-e9d7-406c-81e3-b02d85bee507",
                                "sense_id": "b8053f74-db91-3bb7-941d-42749703c5a1",
                                "text": "Diachronie ist ein Terminus Saussures für \"historische Sprachwissenschaft\"."
                            },
                            {
                                "example_id": "23713205-c908-4eff-8790-5c5cb68cafb0",
                                "sense_id": "b8053f74-db91-3bb7-941d-42749703c5a1",
                                "text": "„Auch sie berücksichtigt die Dialektik von Synchronie und Diachronie, um den Zustand des Wortschatzes als Resultat seiner Entwicklung im Zusammenhang mit und in Abhängigkeit von seinen Funktionen im sprachlichen Handeln zu beschreiben.“"
                            },
                            {
                                "example_id": "3aae069f-c582-4a9c-adb1-e1de654b78e4",
                                "sense_id": "b8053f74-db91-3bb7-941d-42749703c5a1",
                                "text": "„Saussures absolute Trennung von Synchronie und Diachronie wird dem Wesen der Sprache nicht gerecht.“"
                            },
                            {
                                "example_id": "2d23679e-c4d3-43c4-950d-81f098a2e7e3",
                                "sense_id": "b8053f74-db91-3bb7-941d-42749703c5a1",
                                "text": "„Nicht nur die Methode, auch das wissenschaftliche Interesse hat sich in der strukturellen Diachronie verschoben.“"
                            },
                            {
                                "example_id": "1c8aa865-7d77-4b29-8018-ea71150a997d",
                                "sense_id": "b8053f74-db91-3bb7-941d-42749703c5a1",
                                "text": "„Das neuerliche Interesse an der Diachronie, und da auch speziell an der Semantik, hat aber auch einen wissenschaftsgeschichtlichen Aspekt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "67e84768-0a85-3aea-9b98-fa52177521cd",
                        "entry_id": "f2902d13-e643-3951-944a-40cb2492e9be",
                        "glosses": [
                            "Abfolge von Entwicklungsstadien einer Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8062407-63f0-426f-a8cd-443db2dffbd3",
                                "sense_id": "67e84768-0a85-3aea-9b98-fa52177521cd",
                                "text": "Die Diachronie des Deutschen lässt sich in Sprachentwicklungsepochen (Althochdeutsch, Mittelhochdeutsch, Frühneuhochdeutsch und Neuhochdeutsch) einteilen."
                            },
                            {
                                "example_id": "3e0eaf1f-009b-4fb2-a54f-ba927f46f6cd",
                                "sense_id": "67e84768-0a85-3aea-9b98-fa52177521cd",
                                "text": "„Eine Sprachbetrachtung, die gleichermaßen Stabilität und Entwicklung berücksichtigt, das heißt, die Entwicklung als Veränderung der Stabilität versteht, wird neben der Diachronie auch die Synchronie respektieren müssen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "e1b08d60-867a-343e-bbf9-db952df18088",
                        "entry_id": "f2902d13-e643-3951-944a-40cb2492e9be",
                        "glosses": [
                            "Beschreibung des Sachverhalts, dass in verschiedenen Gegenden angetroffene vergleichbare Gesteinsgrenzen nicht zeitgleich entstanden sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a6196f6-632b-4a23-822a-9b80f6410d08",
                                "sense_id": "e1b08d60-867a-343e-bbf9-db952df18088",
                                "text": "„Die Buntsandsteinsedimentation beginnt jedoch nicht im gesamten Verbreitungsgebiet zur gleichen Zeit (Diachronie).“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
