                        "cross_references": [
                            {
                                "target_word": "шрапнельный",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2fcf35a4-3e6c-38e0-9a6d-5b0c63e23e97",
                                        "entry_id": "0c46be35-5b6b-39dc-a621-2a4a64c57b65",
                                        "glosses": [
                                            "воен. связанный, соотносящийся по значению с существительным шрапнель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2582929b-0020-4404-925e-04a0813b074d",
                                                "sense_id": "2fcf35a4-3e6c-38e0-9a6d-5b0c63e23e97",
                                                "text": "Солдат бережно вынимает из ящика тяжёлый шрапнельный патрон, снимает колпачок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c5f6fff-7900-359e-8138-1976f583982a",
                                        "entry_id": "0c46be35-5b6b-39dc-a621-2a4a64c57b65",
                                        "glosses": [
                                            "разг. связанный с существительным шрапнель в значении перловая каша"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d100b3-eaee-4d49-b12a-268544c48ba2",
                                                "sense_id": "9c5f6fff-7900-359e-8138-1976f583982a",
                                                "text": "Не вечно было и наше шрапнельное благоденствие. То ли Надежда Николаевна Филова ушла с работы в столовой, то ли столовую закрыли, уж не помню."
                                            }
                                        ]
                                    }
                                ]
