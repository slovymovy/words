                        "examples": [
                            {
                                "example_id": "2aa3e45c-a42d-4408-9bb5-9c1f342ab90a",
                                "sense_id": "fc577b55-84c5-3b89-ba97-2cd9d3e71d23",
                                "text": "He muttered an exclamation in Gaelic, strode across the floor, and then, with an air of dogged resolution, as if prepared to see the scene to an end, sate himself down on the oak table and whistled a strathspey."
                            },
                            {
                                "example_id": "87e9e713-2ddc-428f-9515-4246fbf859d0",
                                "sense_id": "fc577b55-84c5-3b89-ba97-2cd9d3e71d23",
                                "text": "Arms are raised, the cheers are deafening, the pipes turn to a strathspey and a whole section of the crowd launches into a mad jig."
                            }
                        ]
                    }
