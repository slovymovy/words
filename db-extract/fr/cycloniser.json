                "senses": [
                    {
                        "sense_id": "ee5a355c-3406-3f87-9aa5-a1dffef416ad",
                        "entry_id": "e9123852-548f-3b73-b387-222662aa7f1c",
                        "glosses": [
                            "Donner un caractère cyclonique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d7cec31-19e7-464d-af69-4a6ac7b70108",
                                "sense_id": "ee5a355c-3406-3f87-9aa5-a1dffef416ad",
                                "text": "La dénudation de l’Amérique les font naître, les alizés les cyclonisent, la plaine océanique les amplifie ; elles suivent les parallèles en obliquant légèrement vers le nord-est."
                            },
                            {
                                "example_id": "18ccacb5-c52d-47c8-ad0e-311fd1ba90fd",
                                "sense_id": "ee5a355c-3406-3f87-9aa5-a1dffef416ad",
                                "text": "Il semble que je ne sois pas le seul à avoir l’impression que nous nous sommes laissé cycloniser l’esprit par les tréfonds de l’estomac."
                            }
                        ]
                    }
