                                "sense_id": "03eb547c-1370-3366-91a2-c4504f3fd315",
                                "text": "„Der erfahrene Lippi weiß, dass hinter jedem Erfolg italienischer Mannschaften das Phantom des Catenaccio vermutet wird.“"
                            },
                            {
                                "example_id": "c9e4d17e-4659-4ec1-8a20-1be61d16e8bd",
                                "sense_id": "03eb547c-1370-3366-91a2-c4504f3fd315",
                                "text": "„Im modernen Fußball ist der Catenaccio verpönt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
