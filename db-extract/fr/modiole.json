                    {
                        "sense_id": "17a7c09f-cc09-3934-9b00-8b6333638257",
                        "entry_id": "36c6f149-4c36-322e-8e14-b9f56048824f",
                        "glosses": [
                            "Nom donné à plusieurs espèces de bivalves proches des moules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30c9d4cd-3ee9-492a-895c-df0e3b982c47",
                                "sense_id": "17a7c09f-cc09-3934-9b00-8b6333638257",
                                "text": "Les Modioles ne diffèrent des Moules que par leur coquille qui est transverse et par leurs crochets qui ne sont pas tout à fait terminaux. Comme les Moules, elles vivent sur nos côtes depuis le niveau des basses mers et s’attachent par leur byssus aux rochers et aux corps sous marins."
                            }
                        ]
                    },
                    {
                        "sense_id": "55c8118d-7abb-3851-bd5a-b4eb41d01316",
                        "entry_id": "36c6f149-4c36-322e-8e14-b9f56048824f",
                        "glosses": [
                            "Espèce de bivalve de l’Atlantique nord et du Pacifique nord-est."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "fb16964c-ded1-411e-a92b-3b855394cc7f",
                                "sense_id": "55c8118d-7abb-3851-bd5a-b4eb41d01316",
                                "text": "La plus grande est la modiole, Modiolus modiolus (16 cm), une espèce boréale qui atteint dans la Manche sa limite Sud de répartition."
                            }
                        ]
                    }
                ],
