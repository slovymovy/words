                        "translation_id": "57d2b478-139d-4ab1-b74c-4de53621b32b",
                        "source_entry_id": "46e9884d-55c3-3d90-8fc2-61ef463e09c4",
                        "source_sense_id": "b0775bdd-b7c3-3f61-81ae-1d96624c3570",
                        "target_lang_word": "лодочка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лодочка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "355b453f-4726-30b2-a066-b1b00bf0c5b7",
                                        "entry_id": "53b8c7ee-cb65-3fc9-88d2-ae1f81323afe",
                                        "glosses": [
                                            "уменьш. к лодка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53f9ea77-7274-4d7b-9ace-f83c398bbc12",
                                                "sense_id": "355b453f-4726-30b2-a066-b1b00bf0c5b7",
                                                "text": "Вода в пруде почернела, и лёгкая лодочка уже скользила по ней, и слышался плеск весла и смешки какой-то гражданки в лодочке."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a3756ea-156d-3361-90db-375235e48d05",
                                        "entry_id": "53b8c7ee-cb65-3fc9-88d2-ae1f81323afe",
                                        "glosses": [
                                            "открытая (как правило, дамская) туфля без ремешка и застёжки"
                                        ],
                                        "tags": [
                                            "обычно мн. ч."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420e4918-a666-4b20-83b0-0716e6370c7a",
                                                "sense_id": "7a3756ea-156d-3361-90db-375235e48d05",
                                                "text": "У песочницы стояли чёрные лодочки на высоких каблуках, будто сняла женщина туфли ненужные и побежала дальше."
                                            },
                                            {
                                                "example_id": "88b9e7c1-d6d0-48a1-8596-cff5741a25b9",
                                                "sense_id": "7a3756ea-156d-3361-90db-375235e48d05",
                                                "text": "Мама переодевалась в лёгкое ситцевое платье и в бежевых лодочках легко сбегала по шаткому трапу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d16bef42-1411-35e9-ba15-ca3c9af58364",
                                        "entry_id": "53b8c7ee-cb65-3fc9-88d2-ae1f81323afe",
                                        "glosses": [
                                            "ботан. один из двух нижних лепестков растений семейства мотыльковых"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05608912-edd4-3072-ba43-149e79e926a5",
                                        "entry_id": "53b8c7ee-cb65-3fc9-88d2-ae1f81323afe",
                                        "glosses": [
                                            "перен. любой предмет продолговатой формы, расширяющийся к середине и сужающийся к концам (часто — сосуд или углубление такой формы)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bc903f2-4563-444a-9b4d-005819dd58d9",
                                                "sense_id": "05608912-edd4-3072-ba43-149e79e926a5",
                                                "text": "Шея вытянута, обе руки согнуты в локтях и поставлены на стол, ладонь и пальцы образуют лодочку."
                                            },
                                            {
                                                "example_id": "2b9a4c6f-5298-400d-a66d-fb8394774d47",
                                                "sense_id": "05608912-edd4-3072-ba43-149e79e926a5",
                                                "text": "Для этой цели производители разработали всевозможные ролики и резаки для различных видов теста. Это и стандартные круглые, овальные, шестиугольные, восьмиугольные, гофрированные и прямые резаки, и резаки-сердечки, лодочки, лепестки, рыбки ― словом, любые формы, вплоть до мифологических заморских чудовищ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59bfa90e-8502-4db7-9f58-4721b7904787",
                        "source_entry_id": "46e9884d-55c3-3d90-8fc2-61ef463e09c4",
                        "source_sense_id": "aca8d67d-a923-3769-be06-81016d54aada",
                        "target_lang_word": "Pumps",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pumps",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                        "entry_id": "65ed485c-8853-3569-b2a8-dd47c98be65d",
                                        "glosses": [
                                            "weit ausgeschnittener, sonst aber geschlossener Damenhalbschuh ohne Verschluss mit flacher Sohle und einem modebedingten formvariierenden Absatz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48cdd33a-de22-4b72-a78d-83a89265f6b9",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "Pumps, wie wir sie heute noch kennen, kamen im 17./18. Jahrhundert auf und wurden mit weißen Kniestrümpfen zu Kniebundhosen von männlichen Hoflakaien getragen."
                                            },
                                            {
                                                "example_id": "ae58878b-0409-44a5-bc60-2fa041d5d509",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "\"Besonders Ballerinas und Pumps aus Veloursleder mit Schleife (159 Euro) werden hier zur Zeit gerne gekauft.\""
                                            },
                                            {
                                                "example_id": "c5d7731d-c703-4022-b5ee-49d7747e94bd",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "„Meine Großmutter trug bis zu ihrem neunzigsten Geburtstag bei besonderen Anlässen marineblaue Pumps mit Absätzen.“"
                                            },
                                            {
                                                "example_id": "2e0706d4-d966-44c6-ad28-2cf3fdcb58fe",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "„Sisi, an hohe Absätze nicht gewöhnt, konnte mit den glänzenden, silbernen Pumps kaum das Gleichgewicht halten, schwenkte aber ihren Po, wie sie es bei Models gesehen hatte.“"
                                            },
                                            {
                                                "example_id": "03a56ee4-14f5-41ab-927d-626c1c5ea3c1",
                                                "sense_id": "77493caf-d5d4-32e1-9d99-ef3bdf4a333a",
                                                "text": "„Sie senkte den Kopf und sah Cyprians rote Pumps an ihren Füßen, dann hob sie ihn wieder und begegnete Adriennes ruhigem, aufmunterndem Blick.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
