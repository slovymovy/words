                                "target_senses": [
                                    {
                                        "sense_id": "96d316b8-49e7-339e-8e6e-2f5a71e257c9",
                                        "entry_id": "00713edb-80e9-3a7c-aa31-0945782de421",
                                        "glosses": [
                                            "Born as the second child to parent or family."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aafd4948-a513-4a16-9efd-5a24d870bcae",
                                                "sense_id": "96d316b8-49e7-339e-8e6e-2f5a71e257c9",
                                                "text": "In the novel Pride and Prejudice, Elizabeth Bennett, the heroine, is her family's secondborn child."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ea7c768-7642-3527-b9cd-49e478cd7f40",
                                        "entry_id": "00713edb-80e9-3a7c-aa31-0945782de421",
                                        "glosses": [
                                            "Second of a particular type to be born to a parent or family."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a465999-4e9d-4c05-ba36-9c595324b0b2",
                                                "sense_id": "4ea7c768-7642-3527-b9cd-49e478cd7f40",
                                                "text": "Jane Austen, the secondborn daughter in a family of five boys and two girls, was very close to her sister older Cassandra."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "secondborn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1cf76bb-8516-38ef-af40-274480e859cc",
                                        "entry_id": "c3ec2bb8-efa1-3ab7-be66-117566b69eb5",
                                        "glosses": [
                                            "The second child to be born to a parent or family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "318ac6a8-e705-43c5-89f6-cc5ccd75fd68",
                                                "sense_id": "d1cf76bb-8516-38ef-af40-274480e859cc",
                                                "text": "My secondborn is more outgoing."
