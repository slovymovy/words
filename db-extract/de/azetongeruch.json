                "senses": [
                    {
                        "sense_id": "fad88f17-7e2d-3f24-acc6-d27e0b3feef7",
                        "entry_id": "d6f081c8-1a6a-34eb-8400-04d550471536",
                        "glosses": [
                            "Wahrnehmung von Geruch, der von Azeton stammt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49983393-080f-461f-af3d-971ec2e3826c",
                                "sense_id": "fad88f17-7e2d-3f24-acc6-d27e0b3feef7",
                                "text": "„Der Azetongeruch in der Ausatmungsluft ist auch für die Umgebung erkennbar.“"
                            },
                            {
                                "example_id": "ba1827ca-af1b-467e-b58d-3fc03c217eb2",
                                "sense_id": "fad88f17-7e2d-3f24-acc6-d27e0b3feef7",
                                "text": "„Andererseits kann auch eine Unterzuckerung durch einen Kohlenhydratmangel in der Ernährung Azetongeruch beim Ausatmen auslösen (\"Hungerazeton\", siehe Kapitel \"Wie Mundgeruch entsteht\").“"
                            },
                            {
                                "example_id": "a5d75f44-f760-40ad-a9ea-9c7258cadecf",
                                "sense_id": "fad88f17-7e2d-3f24-acc6-d27e0b3feef7",
                                "text": "„Dadurch wird ein obstartiger Azetongeruch in der Atemluft (sog. Kussmaulatmung) erzeugt.“"
                            },
                            {
                                "example_id": "c86445a1-df81-42bc-bb7e-250e78057e11",
                                "sense_id": "fad88f17-7e2d-3f24-acc6-d27e0b3feef7",
                                "text": "„Der Azetongeruch in der Ausatmungsluft ist auch für die Umgebung erkennbar.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
