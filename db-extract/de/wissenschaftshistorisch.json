                    }
                ],
                "senses": [
                    {
                        "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                        "entry_id": "eb778247-e14d-3046-a57e-ddd083357858",
                        "glosses": [
                            "die Geschichte der Wissenschaft betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f517da13-1b5c-4df7-959c-c4bb1a802c57",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "„Er arbeitet als freier wissenschaftlicher Autor und Publizist über biologische und wissenschaftshistorische Themen.“"
                            },
                            {
                                "example_id": "4b07e09c-534e-4537-9732-462331ef33b4",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "[Nobelpreis:] „Auch aus wissenschaftshistorischer Sicht wirft der Preis spannende Fragen über Exzellenz in den Wissenschaften auf, die zum besseren Verständnis der Funktionsweise moderner Wissenschaft beitragen.“"
                            },
                            {
                                "example_id": "b7e9c426-6340-4322-9639-18bf89197567",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "„Älteste Karte des Periodensystems entdeckt“ – […] „Der Chemiker Alan Aitken war vor fünf Jahren beim Entrümpeln an der Universität St. Andrews zufällig auf die wissenschaftshistorische Rarität gestoßen.“"
                            },
                            {
                                "example_id": "c7bc11c8-25d0-4911-bfd6-9a4b54ba60f8",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "„Von ähnlicher Seltenheit wie der Woldegker Tornado sind Dokumente wie der Genzmer-Bericht. Durch ihn gilt das Ereignis als Glücksfall für die Tornadoforschung. »Wissenschaftshistorisch ist der Genzmer-Bericht das wichtigste Zeugnis aus dieser Zeit«, sagt Bernold Feuerstein.“"
                            },
                            {
                                "example_id": "5388df18-4191-4696-8b15-1445ac8ab59a",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "[Buchbesprechung:] „Aber auch aus wissenschaftshistorischer Sicht lohnt sich die Lektüre.“"
                            },
                            {
                                "example_id": "2c30b7a9-e5aa-45d6-a9f3-a9f4f8ad1b33",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "„Die Qualität des Films von Knigge und Oldenburg kommt daher, dass er sich dem Thema wissenschaftshistorisch, gesellschaftlich und emotional nähert. Die Informationen sind so dicht, dass man gern dabeibleibt.“"
                            },
                            {
                                "example_id": "b9ae4018-e9a5-4698-9e1f-a1c1dfe3f897",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "„Das Seminar richtete sich an wissenschaftshistorisch Interessierte;“ […]."
                            },
                            {
                                "example_id": "f0356118-8565-4bb0-9c9c-8275c786db4b",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "[Buchbesprechung:] „Für natur- und wissenschaftshistorisch interessierte Leser ist es eine wunderbare Quelle, um Alfred Russel Wallace, der lange im Schatten des übergroßen Darwin stand, in seiner eigenen Stimme kennen zu lernen.“"
                            },
                            {
                                "example_id": "ffc67f2b-c642-479f-b4ed-58eee0d54775",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "[Buchbesprechung:] „Zweitens stellt der Autor große Zusammenhänge her und ordnet die gegenwärtige Situation anhand der Schlüsselfigur Keynes historisch, wissenschaftshistorisch und wissenschaftstheoretisch ein: So versteht auch ein Nicht-Kenner die letzten 100 Jahre Wirtschaftspolitik.“"
                            },
                            {
                                "example_id": "bda2f9af-1121-42fd-aa92-30dc29d49ae4",
                                "sense_id": "681b1a6b-bb20-3f50-af41-01603b224ccd",
                                "text": "[Buchbesprechung:] „Zur Grundlage seines Buches hat Thomas de Padova einen Briefwechsel zwischen Kepler und Galilei gemacht, der bis dahin wissenschaftshistorisch weitgehend unberücksichtigt geblieben war und der zu einer Entzauberung des „Mythos Galilei“ führt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
