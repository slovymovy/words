                                        "examples": [
                                            {
                                                "example_id": "a713b603-03e7-4763-b096-0bb4996cdedd",
                                                "sense_id": "765b99c0-255c-3b41-92d2-a81ce99667e5",
                                                "text": "Dieses Skript berechnet mit Hilfe von Sinus, Cosinus und Tangens Maße eines rechtwinkligen Dreieckes."
                                            },
                                            {
                                                "example_id": "ddc1f6d1-65e5-4851-a34c-b173336f927a",
                                                "sense_id": "765b99c0-255c-3b41-92d2-a81ce99667e5",
                                                "text": "„Er war jetzt fest davon überzeugt, daß von Sinus und Kosinus nicht die Rede sein würde.“"
                                            },
                                            {
                                                "example_id": "53af7d99-1281-497a-b2ce-1985f0ef3228",
                                                "sense_id": "765b99c0-255c-3b41-92d2-a81ce99667e5",
                                                "text": "„Doch Monika merkte schnell, dass ich mich für Caesar, Goethe und Schiller, notgedrungen sogar für Sinus und Cosinus mehr interessierte als für Kleider und Knilche, unser Wort für Jungen.“"
                                            }
                                        ],
