{
    "word_family": [
        "fascinate",
        "fascination",
        "fascinator"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c3c3e5a9-342f-3727-a5c5-55de21566f5f",
                    "sense_definition": "Extremely interesting, captivating, or attractive.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interesting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documentary about deep-sea creatures was absolutely <w>fascinating</w> to watch.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм о глубоководных существах было смотреть абсолютно <w>увлекательно</w>."
                            }
                        },
                        {
                            "text": "I find the history of ancient civilizations <w>fascinating</w> and read about it often.",
                            "target_lang_translations": {
                                "ru": "Я нахожу историю древних цивилизаций <w>захватывающей</w> и часто читаю о ней."
                            }
                        },
                        {
                            "text": "He told a <w>fascinating</w> story about his travels through the mountains of Tibet.",
                            "target_lang_translations": {
                                "ru": "Он рассказал <w>увлекательную</w> историю о своих путешествиях по горам Тибета."
                            }
                        }
                    ],
                    "synonyms": [
                        "alluring"
                    ],
                    "antonyms": [
                        "boring",
                        "uninteresting",
                        "dull"
                    ],
                    "common_phrases": [
                        "find something fascinating",
                        "absolutely fascinating",
                        "truly fascinating",
                        "utterly fascinating"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно интересный, захватывающий или привлекательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "увлекательный",
                                "target_lang_sense_clarification": "очень интересный"
                            },
                            {
                                "target_lang_word": "захватывающий",
                                "target_lang_sense_clarification": "полностью поглощающий внимание"
                            },
                            {
                                "target_lang_word": "очаровательный",
                                "target_lang_sense_clarification": "притягательный и интересный"
                            },
                            {
                                "target_lang_word": "обворожительный",
                                "target_lang_sense_clarification": "пленительный, вызывающий восхищение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1abc12d5-8317-3c46-94d0-75e8e1345211",
                    "sense_definition": "The present participle and gerund of <w>fascinate</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician was <w>fascinating</w> the audience with his incredible card tricks.",
                            "target_lang_translations": {
                                "ru": "Фокусник <w>очаровывал</w> публику своими невероятными карточными трюками."
                            }
                        },
                        {
                            "text": "By <w>fascinating</w> the children with stories, the teacher kept them quiet for an hour.",
                            "target_lang_translations": {
                                "ru": "<w>Увлекая</w> детей историями, учитель удерживал их в тишине в течение часа."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «fascinate» (очаровывать, увлекать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "очаровывающий",
                                "target_lang_sense_clarification": "причастие: вызывающий восхищение"
                            },
                            {
                                "target_lang_word": "увлекающий",
                                "target_lang_sense_clarification": "причастие: сильно интересующий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}