                        "sense_id": "06040c39-4540-38b5-8843-e816e14a801f",
                        "entry_id": "b0a85356-d0c0-396a-9b38-d98e4ad22baa",
                        "glosses": [
                            "Insecte lépidoptère (papillon) de jour de la famille des nymphalidés (Nymphalidae), dont les ailes ont un damier noir et blanc."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c2191fd1-298b-45ba-a37e-0b48d0e691f3",
                                "sense_id": "06040c39-4540-38b5-8843-e816e14a801f",
                                "text": "La chenille du demi-deuil se nourrit sur les graminées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57fdb873-69fc-4cf0-83f4-acede03ae7ed",
                        "source_entry_id": "b0a85356-d0c0-396a-9b38-d98e4ad22baa",
                        "source_sense_id": "06040c39-4540-38b5-8843-e816e14a801f",
                        "target_lang_word": "Schachbrett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schachbrett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f90a0b46-0be6-32ad-9cde-ed1292e7081f",
                                        "entry_id": "9b75f625-8d31-38db-8a4b-6f6693908d4b",
                                        "glosses": [
                                            "quadratisches Spielbrett von acht mal acht abwechselnd farbigen (hell und dunkel, meist weiß und braun), quadratischen Feldern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f0df4fb-ee3f-405a-a18d-8ce933fb0319",
                                                "sense_id": "f90a0b46-0be6-32ad-9cde-ed1292e7081f",
                                                "text": "Auf einem Schachbrett stand der Steine bunte Schar / Nach Stand und Würden hingepflanzt; / Der hölzerne Monarch und seine Dame war / Von Reisigen und Türmen rund umschanzt. (Gottlieb Konrad Pfeffel, Gedichte, Das Schachspiel, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "e82b08c1-5f9e-4964-98ce-3fa4c63ce57d",
                                                "sense_id": "f90a0b46-0be6-32ad-9cde-ed1292e7081f",
                                                "text": "\"Ein kleiner Spuk durch die Dampfheizung ging. / Keine Uhr war aufgezogen. / Ein zu früh geborener Schmetterling / Kam auf das Schachbrett geflogen.\""
                                            },
                                            {
                                                "example_id": "91818614-b5e5-4023-a508-5ea72f1ca9f9",
                                                "sense_id": "f90a0b46-0be6-32ad-9cde-ed1292e7081f",
                                                "text": "„Dr. Böttcher wendet sich wieder dem Schachbrett zu, aber er blickt nicht auf die Figuren, sondern auf Lassehn.“"
                                            },
                                            {
                                                "example_id": "886abcc4-1003-45f7-850e-afd7116dcde7",
                                                "sense_id": "f90a0b46-0be6-32ad-9cde-ed1292e7081f",
                                                "text": "„Väsele Li hatte, nachdem Simen Tjing fortgeschickt worden war, mit Silberschönchen Wu auf dem Tischchen das Schachbrett aufgestellt.“"
                                            },
                                            {
                                                "example_id": "d21bbb0f-d3bd-4cd1-8e7f-afb46c7cc9b0",
                                                "sense_id": "f90a0b46-0be6-32ad-9cde-ed1292e7081f",
                                                "text": "„Neben dem Bett stand auf dem Nachttisch ein Schachbrett.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a16aca7-f27d-3e92-99ee-6fd36aa10ba7",
                                        "entry_id": "9b75f625-8d31-38db-8a4b-6f6693908d4b",
                                        "glosses": [
                                            "Schmetterling aus der Familie der Augenfalter"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e289d67c-d027-4d07-a4a0-42934e29cd4d",
                                                "sense_id": "2a16aca7-f27d-3e92-99ee-6fd36aa10ba7",
                                                "text": "Das weibliche Schachbrett ist größer als das männliche."
                                            },
                                            {
                                                "example_id": "f49b3f7f-09ed-41c4-9e76-890b2056768c",
                                                "sense_id": "2a16aca7-f27d-3e92-99ee-6fd36aa10ba7",
                                                "text": "Das Schachbrett ist Schmetterling des Jahres 2019."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
