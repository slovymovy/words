                    }
                ],
                "senses": [
                    {
                        "sense_id": "8e565d31-19d4-344e-b0ed-edb4e3230fc3",
                        "entry_id": "204bdfc8-20bc-32c8-afae-1a64e81111b6",
                        "glosses": [
                            "gewerbliche Räumlichkeiten, in denen Fische zum Verkauf angeboten werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23cabc32-71b5-4f9e-8133-7c5f7fdbc690",
                                "sense_id": "8e565d31-19d4-344e-b0ed-edb4e3230fc3",
                                "text": "„Ganz seltsam und merkwürdig wurde es dann aber, als ich ein kleines Fischgeschäft entdeckte und vermutete, dass Mama bereits in diesem Fischgeschäft eingekauft hatte.“"
                            },
                            {
                                "example_id": "74aac8c6-fc8e-40bc-9a85-bf9dbabd1742",
                                "sense_id": "8e565d31-19d4-344e-b0ed-edb4e3230fc3",
                                "text": "„Zu den Namen, die Pellegrini in den Computer einfüttert, gehört einer, den die Familie des Opfers genannt hat: der Besitzer eines Fischgeschäfts in der Whitelock Street.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd74b723-3c0e-4b4e-8bd8-768ef2e40dc8",
                        "source_entry_id": "204bdfc8-20bc-32c8-afae-1a64e81111b6",
                        "source_sense_id": "8e565d31-19d4-344e-b0ed-edb4e3230fc3",
                        "source_sense_description": "gewerbliche Räumlichkeiten, in denen Fische zum Verkauf angeboten werden",
                        "target_lang_word": "poissonnerie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poissonnerie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "74f48a13-a8c4-342d-b0dc-bce4bb1c82c2",
                                        "entry_id": "a24b7bde-3d73-3e29-93bd-8ad41accf2a9",
                                        "glosses": [
                                            "Boutique où l’on vend le poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed516dca-e4b8-495d-92a9-d3c73e0a06c1",
                                                "sense_id": "74f48a13-a8c4-342d-b0dc-bce4bb1c82c2",
                                                "text": "Il y a queue à la poissonnerie, signe d’une intégration généralisée de la tradition catholique. En réalité, la seule croyance qui fasse acheter du poisson le vendredi, c’est celle qu’il est plus frais que les autres jours."
                                            },
                                            {
                                                "example_id": "25e05156-e896-4238-8fc6-7097e2dff18e",
                                                "sense_id": "74f48a13-a8c4-342d-b0dc-bce4bb1c82c2",
                                                "text": "Alric Paon, à la tête d’un réseau d’une quinzaine de poissonneries et points de vente en Loire-Atlantique, observe également cette augmentation soudaine du tarif du bulot : « Les habitués nous posent des questions, forcément. On explique le contexte et on tire sur nos marges. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
