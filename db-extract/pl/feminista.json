                                                "sense_id": "e5a307ce-8881-3aa2-83d2-f61a019564eb",
                                                "text": "Manfred ist ein Feminist."
                                            },
                                            {
                                                "example_id": "85cd867a-813a-43dd-8855-0dd2038b8b8e",
                                                "sense_id": "e5a307ce-8881-3aa2-83d2-f61a019564eb",
                                                "text": "Martin mag die Feministen nicht."
                                            },
                                            {
