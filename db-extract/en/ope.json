                ],
                "senses": [
                    {
                        "sense_id": "58e6d0d3-00f3-3142-9172-eda9058140e7",
                        "entry_id": "b78ab021-2520-3c3d-bead-3aca8f23bbab",
                        "glosses": [
                            "To open."
                        ],
                        "tags": [
                            "ambitransitive",
                            "dialectal",
                            "poetic"
                        ],
                        "examples": [
                            {
                                "example_id": "16fa5e6d-0a6e-482d-b335-823e84623caa",
                                "sense_id": "58e6d0d3-00f3-3142-9172-eda9058140e7",
                                "text": "Ere I ope his letter, / I pray you, tell me how my good friend doth."
                            },
                            {
                                "example_id": "59da2568-d1b1-4759-af31-07839b753d93",
                                "sense_id": "58e6d0d3-00f3-3142-9172-eda9058140e7",
                                "text": "The hour's now come, the very minute bids thee ope thine ear; obey and be attentive."
                            },
                            {
                                "example_id": "dbfb56f9-3edc-400b-bb5a-6929035bf9a2",
                                "sense_id": "58e6d0d3-00f3-3142-9172-eda9058140e7",
                                "text": "There came into many a burgher's pate / A text which says that heaven's gate / Opes to the rich at as easy rate / As the needle's eye takes a camel in!"
                            },
                            {
                                "example_id": "7d8f896f-439e-4fa4-92f4-b99d63d238b4",
                                "sense_id": "58e6d0d3-00f3-3142-9172-eda9058140e7",
                                "text": "An order asserted itself, and the hoods on the furnaces were oped wide, and a final march was organized. The wails of the injured and the roars of the dead-on-the-march overwhelmed the tinny speakers in the cell, and they all watched as nearly one thousand people reduced themselves to a few frantic hundred in less than an hour, then settled into a sustained orgy of battery, rapine and rape with no end in sight but the total depopulation of the entire facility."
                            }
                        ]
                    }
