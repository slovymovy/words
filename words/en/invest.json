                {
                    "sense_id": "f9c577c4-ca80-380c-a28c-0382cdcdb56d",
                    "sense_definition": "To formally give someone power, authority, or a rank.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "authority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constitution <w>invests</w> the president with the power to veto legislation.",
