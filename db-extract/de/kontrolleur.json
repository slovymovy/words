                "senses": [
                    {
                        "sense_id": "9fa2c4ec-fb5a-33ee-b41a-2c4eefcf4065",
                        "entry_id": "e003b2a0-53cd-31cb-bb88-628b994fa17e",
                        "glosses": [
                            "Person, die beruflich Kontrollen/Überprüfungen durchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2867b8fb-9ef3-4977-9b4b-29d882179756",
                                "sense_id": "9fa2c4ec-fb5a-33ee-b41a-2c4eefcf4065",
                                "text": "„Kontrolleure, die Ausweise oder Reisegenehmigungen sehen wollen, werden mich kaum erwischen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4135a513-aef7-4842-a837-deb21f99d0e6",
                        "source_entry_id": "e003b2a0-53cd-31cb-bb88-628b994fa17e",
                        "source_sense_id": "9fa2c4ec-fb5a-33ee-b41a-2c4eefcf4065",
                        "source_sense_description": "Person, die beruflich Kontrollen/Überprüfungen durchführt",
                        "target_lang_word": "inspector",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inspector",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A person employed to inspect something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fac90b57-8542-407c-8be0-2ecfe6e048aa",
                                                "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16.[…]There are no inspectors, no exams until the age of 18, no school league tables, no private tuition industry, no school uniforms.[…]"
                                            },
                                            {
                                                "example_id": "ca88941f-7061-4a50-a9b0-782a3e35c8dd",
                                                "sense_id": "1c6fe308-f661-3305-8391-ed26ef4fed91",
                                                "text": "Martin had served as inspector general since December 2023. While President Donald Trump fired inspectors general from more than a dozen federal agencies during his first week in office, the USAID watchdog had remained in place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6079a240-d345-3fed-983b-17b5c3c185f2",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A police officer ranking below superintendent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                        "entry_id": "cb77d2da-821f-3d31-9a6b-91bd8d46eceb",
                                        "glosses": [
                                            "A software tool used to examine something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0cf928f-a617-4478-bdd2-ad676abed471",
                                                "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                                "text": "Chrome has a built-in development tool called the Chrome Inspector. You can use it to examine the HTML elements in a web page; review what resources — or files, cookies, and databases — are active; follow network activity; […]"
                                            },
                                            {
                                                "example_id": "55752a7d-b5d7-4b9a-aa8e-535fdf57c37a",
                                                "sense_id": "ad5b85dd-0962-3b10-8b8e-859040fb396a",
                                                "text": "After that, with the help of the disk inspector, you can at any time compare the status of programs and system disk areas with the original one."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
