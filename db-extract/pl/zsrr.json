                        "source_entry_id": "7b161161-4ea2-3e4d-ae6f-ad6187ef3066",
                        "source_sense_id": "63242ce3-1908-3d98-b4ed-014d7b010f42",
                        "target_lang_word": "UdSSR",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "UdSSR",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a160a38e-6b3f-3027-864d-1fc04a5c77af",
                                        "entry_id": "750f7424-ed20-3ecb-9a74-ca3b636e9da9",
                                        "glosses": [
                                            "Union der Sozialistischen Sowjetrepubliken"
                                        ],
                                        "tags": [
                                            "historisch (1922–1991)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01138cc0-4e0e-41e5-8758-527477b8186e",
                                                "sense_id": "a160a38e-6b3f-3027-864d-1fc04a5c77af",
                                                "text": "Die UdSSR wurde im Dezember 1991 aufgelöst."
                                            },
                                            {
                                                "example_id": "e5bd91ff-7413-4ea3-b3c8-302209ff1d9b",
                                                "sense_id": "a160a38e-6b3f-3027-864d-1fc04a5c77af",
                                                "text": "Das Territorium der UdSSR umfaßt 53 % der Fläche Europas und 38 % der Fläche Asiens."
                                            },
                                            {
                                                "example_id": "78d5adcd-4a8a-4105-b558-cbc14dfa3f2f",
                                                "sense_id": "a160a38e-6b3f-3027-864d-1fc04a5c77af",
                                                "text": "„Das Gleiche galt für die damalige UdSSR: Wenn so viele von einem solch imposanten und attraktiven Staatengebilde fasziniert sind, wirkt dieses weit mächtiger, als es tatsächlich ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a77e87b8-8809-4e8d-8704-d42fa4fb612a",
                        "source_entry_id": "7b161161-4ea2-3e4d-ae6f-ad6187ef3066",
                        "source_sense_id": "63242ce3-1908-3d98-b4ed-014d7b010f42",
                        "target_lang_word": "СССР",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "СССР",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "579be05d-86a8-3aff-b454-e23e14c1beff",
                                        "entry_id": "82fbda3a-f1c0-32fd-a674-5e2f58f5be6e",
                                        "glosses": [
                                            "истор. сокр. от Союз Советских Социалистических Республик; название государства, существовавшего в Евразии с 1922 года по 1991 год"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7fffd93-e884-414a-b5ec-3081f0cda817",
                                                "sense_id": "579be05d-86a8-3aff-b454-e23e14c1beff",
                                                "text": "Он мечтал поехать в СССР, потому что ему обещали подарить там автомобиль, предмет его страстных мечтаний, иногда ему даже снившийся."
                                            },
                                            {
                                                "example_id": "f5dc227f-30ce-4f34-a92c-41945c7d4b9a",
                                                "sense_id": "579be05d-86a8-3aff-b454-e23e14c1beff",
                                                "text": "Она приехала к сыну в СССР, а после ареста Гавро все шарахались от неё, боялись её, и она, как безумная, не зная языка, бродила по Москве."
                                            },
                                            {
                                                "example_id": "b7ef061d-31c4-4346-9594-744d1d6d6f96",
                                                "sense_id": "579be05d-86a8-3aff-b454-e23e14c1beff",
                                                "text": "Чеховская «Чайка» в постановке выдающегося режиссёра современности Петера Штайна с актёрами знаменитой в СССР Рижской Русской драмы и с несколькими московскими гастролёрами — явление, выходящее далеко за пределы одного фестиваля."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
