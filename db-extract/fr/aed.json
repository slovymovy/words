                        "glosses": [
                            "Assistant d’éducation, assistante d’éducation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f7b33b7-5952-41b6-805a-019d360e77db",
                                "sense_id": "ffca4b36-6635-396d-b42a-5771ff18e2fe",
                                "text": "L’assistant d’éducation est un agent public non titulaire, recruté soit en tant qu’AED (assistant d’éducation), soit en tant qu’assistant pédagogique (AP)."
                            },
                            {
                                "example_id": "f3df0a08-b7b2-4f5d-872e-38a7b6fc98b5",
                                "sense_id": "ffca4b36-6635-396d-b42a-5771ff18e2fe",
                                "text": "La ministre de l’Éducation nationale, Nicole Belloubet, a annoncé mardi qu’elle souhaitait « tenir compte de la spécificité de l’éducation en Seine-Saint-Denis », rappelant qu’une prime de fidélisation de 12 000 € est octroyée aux profs qui restent plus de cinq ans dans le département, et que cette prime venait d’être étendue aux assistants d’éducation (AED) et aux accompagnants d’élèves en situation de handicap (AESH)."
                            }
                        ]
                    }
