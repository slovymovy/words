                ],
                "senses": [
                    {
                        "sense_id": "2302282d-ad2e-3a80-8df1-adef4c7db1e7",
                        "entry_id": "48c7d387-d631-33e4-8dfd-0dc948ead3d3",
                        "glosses": [
                            "Roche ultramafique de structure grenue constituée d’olivine associée à d’autres silicates ferro-magnésiens, essentiellement des pyroxènes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b220a45-2138-4a7f-a51c-a4b742b043a6",
                                "sense_id": "2302282d-ad2e-3a80-8df1-adef4c7db1e7",
                                "text": "Ainsi la fusion de la péridotite commence lorsque sa température devient supérieure à celle du solidus."
                            },
                            {
                                "example_id": "8b2a9a54-5e2d-4175-ba19-37fec93cca27",
                                "sense_id": "2302282d-ad2e-3a80-8df1-adef4c7db1e7",
                                "text": "La source la plus considérable est le manteau terrestre, où les péridotites sont justement formées de minéraux ferro-magnésiens comme les olivines et les pyroxènes."
                            }
                        ]
                    }
                ],
