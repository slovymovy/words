                "senses": [
                    {
                        "sense_id": "ff33c057-b97d-344a-bef2-7b6a971e2a3f",
                        "entry_id": "aa2c07af-20c2-33a5-944a-15881341741b",
                        "glosses": [
                            "Ausarbeitung und Testung eines neuen Vakzins bis es zum Einsatz zugelassen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f76c41c-c3bf-417c-9360-e93314324cce",
                                "sense_id": "ff33c057-b97d-344a-bef2-7b6a971e2a3f",
                                "text": "„Neueste Impfstoffentwicklungen konzentrieren sich aber nicht nur auf Infektionskrankheiten sondern auch auf sogenannte Zivilisationskrankheiten, wie Allergien oder Alzheimer.“"
                            },
                            {
                                "example_id": "aac1b01f-3249-4ce3-be6f-bcc36f7c20a5",
                                "sense_id": "ff33c057-b97d-344a-bef2-7b6a971e2a3f",
                                "text": "„Weltweit gibt es mehr als 150 Impfstoffprojekte gegen SARS-CoV-2. Warum dauert die Impfstoffentwicklung so lange und wann ist mit einem Impfstoff zu rechnen?“"
                            },
                            {
                                "example_id": "04dd88d0-806c-4579-8e09-38bba5be648a",
                                "sense_id": "ff33c057-b97d-344a-bef2-7b6a971e2a3f",
                                "text": "„In der Impfstoffentwicklung suchen Forscher nach einem geeigneten Teil des Virus, meist ein Protein an dessen Oberfläche, der das menschliche Immunsystem dazu bringt, sich gegen eine Infektion rechtzeitig zu wehren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
