    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2f58527c-e606-3853-9a46-ccd73443874e",
                    "sense_definition": "Étendue très vaste qui semble sans limites.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "espace",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le voyageur contemplait l'<w>immensité</w> du désert qui s'étendait devant lui."
                        },
                        {
                            "text": "Les marins se sentent souvent bien vulnérables face à l'<w>immensité</w> de la mer."
                        }
                    ],
                    "synonyms": [
                        "vastitude",
                        "infinité"
                    ],
                    "antonyms": [
                        "étroitesse",
                        "petitesse"
                    ],
                    "common_phrases": [
                        "immensité du désert",
                        "immensité du ciel"
                    ]
                },
                {
                    "sense_id": "a3a53327-cfea-3b9c-99f6-5e2aaef779c4",
                    "sense_definition": "Caractère démesuré ou très considérable d'une réalité abstraite ou morale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "grandeur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe a vite pris conscience de l'<w>immensité</w> de la tâche à accomplir."
                        },
                        {
                            "text": "Rien ne pouvait atténuer l'<w>immensité</w> de son chagrin après cet événement."
                        }
                    ],
                    "synonyms": [
                        "ampleur",
                        "démesure"
                    ],
                    "antonyms": [
                        "modicité",
                        "insignifiance"
                    ],
                    "common_phrases": [
                        "immensité de la tâche"
                    ]
                },
                {
                    "sense_id": "99561b11-d98d-3608-b047-9ec6d0fa4b9b",
                    "sense_definition": "Grandeur infinie et sans bornes considérée comme un attribut divin.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les théologiens ont longuement disserté sur l'<w>immensité</w> de la présence divine."
                        },
                        {
                            "text": "Ce penseur considérait l'<w>immensité</w> comme une propriété insaisissable de l'absolu."
                        }
                    ],
                    "synonyms": [
                        "infinité"
                    ],
                    "antonyms": [
                        "finitude"
                    ]
                }
            ]
        }
