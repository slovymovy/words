                ],
                "senses": [
                    {
                        "sense_id": "a4bb5d28-9a85-352f-bc58-da221c1b5fcf",
                        "entry_id": "a6484efa-d40c-3647-b972-63d2c5413b69",
                        "glosses": [
                            "tegen geweten, moraal, zeden of normen ingaand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e55f60ab-fc79-461f-bf0e-95f6c82ed2c9",
                                "sense_id": "a4bb5d28-9a85-352f-bc58-da221c1b5fcf",
                                "text": "Vier maanden daarna verliet Krotoa haar kinderen en begon een losgeslagen leven van drank en prostitutie voordat zij op 10 februari 1669 op aanklacht van immoreel openbaar gedrag in hechtenis werd genomen."
                            },
                            {
                                "example_id": "63efd1c9-eb3b-445a-913a-6e175f942f61",
                                "sense_id": "a4bb5d28-9a85-352f-bc58-da221c1b5fcf",
                                "text": "Het idee om na het tellen terug te keren naar zijn schrijfmachine was weliswaar rationeel, maar ook immoreel. Geen groot bedrog, maar toch bedrog."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c664e87f-8363-47ba-9303-7964f7698998",
                        "source_entry_id": "a6484efa-d40c-3647-b972-63d2c5413b69",
                        "source_sense_id": "a4bb5d28-9a85-352f-bc58-da221c1b5fcf",
                        "target_lang_word": "immoral",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immoral",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9ed6f6a6-f324-3ceb-aaa0-5cf79f3da5a3",
                                        "entry_id": "4e381a1f-a1d7-3c7a-ad13-5279b8ebda74",
                                        "glosses": [
                                            "Breaching principles of natural law, rectitude, or justice, and so inconsistent with the demands of virtue, purity, or \\\"good morals\\\"; not right, not moral. (Compare unethical, illegal.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d5af79-7d20-45a9-abb2-823950841338",
                                                "sense_id": "9ed6f6a6-f324-3ceb-aaa0-5cf79f3da5a3",
                                                "text": "Let marriage be held in honor among all, and let the marriage bed be undefiled, for God will judge the sexually immoral and adulterous."
                                            },
                                            {
                                                "example_id": "58f86286-51ac-4b67-8d10-4fd918be39f6",
                                                "sense_id": "9ed6f6a6-f324-3ceb-aaa0-5cf79f3da5a3",
                                                "text": "Lessons from history remind us that immoral societies don’t last very long and that the saying, “Good will be rewarded and evil will incur punishment” is a truism, reminding us of the proper way to behave—for our own benefit and that of others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4f53317-2600-4f6e-9ed7-45b889d76eb3",
                        "source_entry_id": "a6484efa-d40c-3647-b972-63d2c5413b69",
                        "source_sense_id": "a4bb5d28-9a85-352f-bc58-da221c1b5fcf",
                        "target_lang_word": "immoral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "immoral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "278809bf-58b5-31bf-bea9-ed72d861eab9",
                                        "entry_id": "106900a6-b503-3ce4-a656-606639c6f06c",
                                        "glosses": [
                                            "Qui est contraire à la morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600ab36e-1296-48b2-8779-b4b66dcc9266",
                                                "sense_id": "278809bf-58b5-31bf-bea9-ed72d861eab9",
                                                "text": "Les œuvres de l’urban fantasy se caractérisent moins par une attention aux aspects déplaisants ou désagréables de la vie urbaine qu’aux aspects immoraux de la vie contemporaine, dans le prolongement des récits du roman noir mettant en scène les personnages du vice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a041d10-8032-35b9-b2db-69eb40a05405",
                                        "entry_id": "106900a6-b503-3ce4-a656-606639c6f06c",
                                        "glosses": [
                                            "Qui est sans principes de morale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b6bf952-a713-4d1e-9945-7f37d909df09",
                                                "sense_id": "6a041d10-8032-35b9-b2db-69eb40a05405",
                                                "text": "Le chevalier d’industrie, la fille de joie, le voleur, le brigand, et l’assassin, le joueur, le bohème sont immoraux, et le brave bourgeois éprouve à l’égard de ces « gens sans mœurs » la plus vive répulsion."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4e727fa-95be-4250-bfe4-d32772478029",
                        "source_entry_id": "a6484efa-d40c-3647-b972-63d2c5413b69",
                        "source_sense_id": "a4bb5d28-9a85-352f-bc58-da221c1b5fcf",
                        "target_lang_word": "inmoral",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inmoral",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "b26def14-5679-3e72-a9fe-ddd74d5091ae",
                                        "entry_id": "be3cf9a5-19da-3c20-8fa0-1032603507f4",
                                        "glosses": [
                                            "Que falta a la moralidad vigente o a las buenas costumbres, o no la sigue. Dícese de una acción: contraria a la ética."
                                        ],
