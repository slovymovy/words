                    {
                        "sense_id": "5b8d56e5-0cca-35cb-b5dc-1d8ee917c764",
                        "entry_id": "26cf9a62-4716-3a51-b79b-b52914360b81",
                        "glosses": [
                            "öffentliche Bibliothek in städtischer Trägerschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b78c44-e835-492d-a733-f1345f4b5897",
                                "sense_id": "5b8d56e5-0cca-35cb-b5dc-1d8ee917c764",
                                "text": "Die Stadtbibliothek veranstaltet am Samstag einen Bücherflohmarkt."
                            },
                            {
                                "example_id": "750ed1fd-31c6-4a12-935d-791bfbaa72e7",
                                "sense_id": "5b8d56e5-0cca-35cb-b5dc-1d8ee917c764",
                                "text": "„Google wird binnen zehn Jahren gebührenfrei die Digitalisierung der mehr als 450.000 Bücher der Stadtbibliothek durchführen und die Bücher dann online auf der eigenen Webseite und auf jener der Bibliothek von Lyon anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
