            {
                "entry_id": "4aa33265-49ba-305d-85b8-07afc586a872",
                "word": "Taube",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1fb20215-d9dc-4f91-9a1f-f0a430fbdb42",
                        "entry_id": "4aa33265-49ba-305d-85b8-07afc586a872",
                        "tags": [],
                        "form": "taube"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "798919eb-2911-3cd9-b2ea-5cfdbca352fd",
                        "entry_id": "4aa33265-49ba-305d-85b8-07afc586a872",
                        "glosses": [
                            "Avion autrichien monoplan à ailes et queue de pigeon employé dès 1912 à des fins militaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f47f6c7-eae9-4385-9285-fc5003a93beb",
                                "sense_id": "798919eb-2911-3cd9-b2ea-5cfdbca352fd",
                                "text": "Un jour qu’un Taube avait jeté une bombe non loin de la résidence présidentielle, un moineau affolé par le bruit de l’explosion se réfugia dans le cabinet […]"
                            },
                            {
                                "example_id": "21f7f791-0e4a-42a4-a816-3dd7576de4e0",
                                "sense_id": "798919eb-2911-3cd9-b2ea-5cfdbca352fd",
                                "text": "Un Taube qui nous survole, avec l'aspect encrêpé et sinistre d'un corbeau, soulève la fusillade et même le canon."
                            },
                            {
                                "example_id": "9e9d7208-868f-46dc-a79c-b396945fe38a",
                                "sense_id": "798919eb-2911-3cd9-b2ea-5cfdbca352fd",
                                "text": "Mais la D.C.A. ne faisait jamais mouche : c'était des tubes de 75 vétustes qui avaient canardé les taubes de la dernière guerre."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "05a6d7b9-7882-375b-a43a-ffc48d25338e",
                "word": "taube",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8c7713ef-329d-4195-984d-c63a5985ef3f",
                        "entry_id": "05a6d7b9-7882-375b-a43a-ffc48d25338e",
                        "tags": [
