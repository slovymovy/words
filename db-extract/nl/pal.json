                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "663c48a0-cc54-3577-a151-c51ae7d89e7f",
                        "entry_id": "888b3b68-a50e-347b-bc72-8bb7636d5792",
                        "glosses": [
                            "direkt, zonder tussenruimte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cd6b50d-4b81-4fd4-b758-426d1b0deafe",
                                "sense_id": "663c48a0-cc54-3577-a151-c51ae7d89e7f",
                                "text": "We houden stil bij een kerkje dat verscholen ligt in een straatje pal achter de drukke winkelstraat."
                            },
                            {
                                "example_id": "a9c8c75b-7ef8-483d-b072-dbabf70df3d2",
                                "sense_id": "663c48a0-cc54-3577-a151-c51ae7d89e7f",
                                "text": "Meteen na de start, meldde ze zich vooraan, pal achter Can, en pal voor Grøvdal en de Zwitserse Fabienne Schlumpf. Maar gaandeweg begon ze van vermoeidheid te trekkebekken en kort daarop groeide het gat met de koplopers, Can, Schlumpf en uiteindelijk ook de Noorse."
                            },
                            {
                                "example_id": "71c61933-ba9c-4080-8635-0ccc800c6a78",
                                "sense_id": "663c48a0-cc54-3577-a151-c51ae7d89e7f",
                                "text": "' Het beest staat stil, pal voor mijn voeten."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
