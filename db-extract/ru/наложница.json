                        "source_sense_description": "пленница или крепостная, вынужденная стать любовницей",
                        "target_lang_word": "Nebenfrau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nebenfrau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "705833a0-62c4-35c2-a2c6-bf1d86ec12de",
                                        "entry_id": "903ee641-1543-3c29-a0b7-1f522aff1f0d",
                                        "glosses": [
                                            "eine nachrangige unter mehreren Ehefrauen eines Mannes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c40f1271-af90-4796-8ee6-33d3e993f851",
                                                "sense_id": "705833a0-62c4-35c2-a2c6-bf1d86ec12de",
                                                "text": "„Ihm war die dritte Nebenfrau, die kleine Dscho gestorben, und er hatte sie bestattet.“"
                                            },
                                            {
                                                "example_id": "e9885efc-4085-4db3-9402-dd50d8625298",
                                                "sense_id": "705833a0-62c4-35c2-a2c6-bf1d86ec12de",
                                                "text": "„Reumütig wird er auf den Pfad der Vernunft zurückkehren und die eigene Frau und die eigenen Nebenfrauen schätzenswert finden und bei ihnen Achtung und Gegenliebe finden, und in sein Ich und sein Haus werden wieder schönste Ordnung und Harmonie einkehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "113f175c-ab0a-4a23-8be2-26c5ad25bc09",
                        "source_entry_id": "f6011750-3d17-341f-9750-d5bec7a75f9c",
                        "source_sense_description": "пленница или крепостная, вынужденная стать любовницей",
                        "target_lang_word": "concubine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "concubine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a703ff7d-4dd8-337d-9a2b-16ebadd92e9c",
                                        "entry_id": "b9d623b9-5e47-3c76-b414-2d3df72b348d",
                                        "glosses": [
                                            "Femme qui partage la vie de quelqu’un sans être mariée avec lui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1917587-4fb2-4ef6-94d0-b2f449b78bfa",
                                                "sense_id": "a703ff7d-4dd8-337d-9a2b-16ebadd92e9c",
                                                "text": "Du moment, n’est-ce pas, ajouta-t-il, que la recherche de la paternité est autorisée dans ce cas-là, attendu que ta fille notoirement a vécu avec lui comme concubine."
                                            },
                                            {
                                                "example_id": "b6175c1b-1fc3-4e32-aaac-75cff81b8e01",
                                                "sense_id": "a703ff7d-4dd8-337d-9a2b-16ebadd92e9c",
                                                "text": "Tandis que les masseuses noires entrent en action, les moins bousculées trouvent le temps de manger et de potiner avec les concubines d'autres harems."
                                            }
                                        ]
                                    }
                                ]
                            },
