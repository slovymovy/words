            "senses": [
                {
                    "sense_id": "fb265bbc-9b03-3cc8-8856-cfd643e9cefb",
                    "sense_definition": "Высота стоящего человека или животного",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "height",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой старший брат очень высокого <w>роста</w>.",
                            "target_lang_translations": {
                                "en": "My older brother is very <w>tall</w>.",
                                "zh": "我哥哥的<w>个子</w>很高。"
                            }
                        },
                        {
                            "text": "В комнату вошёл мужчина среднего <w>роста</w> в сером пальто.",
                            "target_lang_translations": {
                                "en": "A man of average <w>height</w> in a grey coat entered the room.",
                                "zh": "一位穿灰色大衣、中等<w>身高</w>的男子走进了房间。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "высокого роста",
                        "среднего роста",
                        "маленького роста",
                        "в полный рост"
                    ],
                    "target_lang_definitions": {
                        "en": "The vertical measurement of a person or animal from head to foot",
                        "zh": "指人或动物站立时的身体高度"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "height",
                                "target_lang_sense_clarification": "measurement from base to top"
                            },
                            {
                                "target_lang_word": "stature",
                                "target_lang_sense_clarification": "natural height of a standing body"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "身高",
                                "target_lang_sense_clarification": "指人的身体高度"
                            },
                            {
                                "target_lang_word": "个子",
                                "target_lang_sense_clarification": "口语中指人的身材高矮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88a17ff9-5e0a-3416-99d2-3c66396c8d43",
                    "sense_definition": "Увеличение количества, размеров или степени проявления чего-либо",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом году наблюдается значительный <w>рост</w> цен на продукты.",
                            "target_lang_translations": {
