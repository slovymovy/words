                },
                {
                    "sense_id": "e88e4c57-3c08-367b-bced-81c132061fa8",
                    "sense_definition": "D'une manière sévère, stricte ou impitoyable, sans ménagement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur lui a parlé très <w>durement</w> après cette grave erreur au bureau.",
                            "target_lang_translations": {
                                "en": "The director spoke to him very <w>harshly</w> after this serious mistake at the office.",
                                "ru": "Директор очень <w>резко</w> поговорил с ним после этой серьёзной ошибки в офисе.",
                                "de": "Der Direktor hat nach diesem schweren Fehler im Büro sehr <w>hart</w> mit ihm gesprochen.",
                                "es": "El director le habló muy <w>duramente</w> tras este grave error en la oficina.",
                                "zh": "办公室里出了这么严重的错误后，主管对他非常<w>严厉</w>地训斥。"
                            }
                        },
                        {
                            "text": "Il a jugé <w>durement</w> la décision prise par ses collègues lors de la réunion.",
                            "target_lang_translations": {
                                "en": "He judged the decision his colleagues made at the meeting <w>harshly</w>.",
                                "ru": "Он <w>жёстко</w> оценил решение, принятое его коллегами на совещании.",
                                "de": "Er hat die Entscheidung, die seine Kollegen bei der Besprechung getroffen hatten, <w>hart</w> beurteilt.",
                                "es": "Él juzgó <w>duramente</w> la decisión tomada por sus colegas en la reunión.",
                                "zh": "他<w>苛刻</w>地评判了同事在会议上做出的决定。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sévèrement",
                        "rudement"
                    ],
                    "antonyms": [
                        "doucement",
                        "gentiment"
                    ],
                    "common_phrases": [
                        "parler durement",
                        "juger durement",
                        "traiter durement"
