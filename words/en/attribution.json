{
    "word_family": [
        "attribute",
        "attributable",
        "attributive",
        "attributor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e612ddb2-c5fa-3111-b18b-1d81a2566803",
                    "sense_definition": "An explicit or formal acknowledgment of ownership or authorship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "acknowledgment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>attribution</w> of the quote is widely regarded as dubious by most historians.",
                            "target_lang_translations": {
                                "ru": "<w>Атрибуция</w> этой цитаты считается сомнительной большинством историков."
                            }
                        },
                        {
                            "text": "You must provide proper <w>attribution</w> when using images from the internet in your presentation.",
                            "target_lang_translations": {
                                "ru": "Вы должны предоставить надлежащее <w>указание авторства</w> при использовании изображений из интернета в своей презентации."
                            }
                        }
                    ],
                    "synonyms": [
                        "credit",
                        "ascription",
                        "assignment"
                    ],
                    "common_phrases": [
                        "proper attribution",
                        "correct attribution",
                        "clear attribution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Явное или официальное признание права собственности или авторства."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указание авторства",
                                "target_lang_sense_clarification": "в контексте цитат или произведений"
                            },
                            {
                                "target_lang_word": "атрибуция",
                                "target_lang_sense_clarification": "официальное подтверждение авторства"
                            },
                            {
                                "target_lang_word": "ссылка на источник",
                                "target_lang_sense_clarification": "при использовании материалов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc391213-0e52-38a8-934c-7a132dc4f5c5",
                    "sense_definition": "The act of attributing a quality, cause, or characteristic to someone or something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Psychologists study the <w>attribution</w> of motives to understand how people perceive social interactions.",
                            "target_lang_translations": {
                                "ru": "Психологи изучают <w>приписывание</w> мотивов, чтобы понять, как люди воспринимают социальные взаимодействия."
                            }
                        },
                        {
                            "text": "The <w>attribution</w> of the painting to a specific artist changed its market value significantly.",
                            "target_lang_translations": {
                                "ru": "<w>Отнесение</w> картины к кисти конкретного художника значительно изменило её рыночную стоимость."
                            }
                        }
                    ],
                    "synonyms": [
                        "imputation",
                        "assignment"
                    ],
                    "common_phrases": [
                        "causal attribution",
                        "attribution error"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт приписывания качества, причины или характеристики кому-либо или чему-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приписывание",
                                "target_lang_sense_clarification": "свойств, мотивов или причин"
                            },
                            {
                                "target_lang_word": "атрибуция",
                                "target_lang_sense_clarification": "в психологии или искусствоведении"
                            },
                            {
                                "target_lang_word": "отнесение",
                                "target_lang_sense_clarification": "к определенной категории или автору"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6280d401-dfd9-32bd-b023-644b406fac57",
                    "sense_definition": "A legal doctrine by which liability is extended to a defendant who did not actually commit the tortious or criminal act.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal doctrine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prosecution relied on the principle of <w>attribution</w> to hold the corporation responsible for the manager's actions.",
                            "target_lang_translations": {
                                "ru": "Обвинение опиралось на принцип <w>вменения</w>, чтобы привлечь корпорацию к ответственности за действия менеджера."
                            }
                        },
                        {
                            "text": "Under the rules of <w>attribution</w>, the state can be held liable for the conduct of its officials.",
                            "target_lang_translations": {
                                "ru": "Согласно правилам <w>атрибуции</w>, государство может нести ответственность за поведение своих должностных лиц."
                            }
                        }
                    ],
                    "synonyms": [
                        "vicarious liability",
                        "imputation"
                    ],
                    "common_phrases": [
                        "rules of attribution",
                        "legal attribution"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридическая доктрина, согласно которой ответственность распространяется на ответчика, который фактически не совершал правонарушения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вменение",
                                "target_lang_sense_clarification": "юридической ответственности"
                            },
                            {
                                "target_lang_word": "атрибуция",
                                "target_lang_sense_clarification": "в международном или корпоративном праве"
                            },
                            {
                                "target_lang_word": "присвоение ответственности",
                                "target_lang_sense_clarification": "действий подчиненных организации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}
