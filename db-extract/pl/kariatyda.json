                                "target_senses": [
                                    {
                                        "sense_id": "ba6e7d1e-a060-30bc-b97e-e2e17013e60e",
                                        "entry_id": "9eeb2a56-68ee-3370-9d39-4fdf0910f66b",
                                        "glosses": [
                                            "plastika obvykle oděné ženské postavy sloužící jako podpěrný sloup"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2ad1c515-9f1b-4c06-a97f-d8592e018b24",
                        "source_entry_id": "074649cb-28dc-3a2b-8e75-780f6dd69535",
                        "source_sense_id": "d7f33514-5644-3cad-9635-ae75edfc5d86",
                        "target_lang_word": "cariatide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cariatide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "497b2e85-98ed-3d17-9187-bdfcdd9a2850",
                                        "entry_id": "290001c3-b409-33f9-89e0-eb6b181350f5",
                                        "glosses": [
                                            "Nom des figures employées par les architectes, au lieu de colonnes ou de pilastres, pour servir de soutien à une architrave qu’elles portent sur leur tête."
                                        ],
                                        "tags": [
                                            "Sculpture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68f622a7-4c81-47f8-b4b1-8a2dd021fe34",
                                                "sense_id": "497b2e85-98ed-3d17-9187-bdfcdd9a2850",
                                                "text": "Le balcon de l’Érechtéion est soutenu par des cariatides."
                                            },
                                            {
                                                "example_id": "c9ea5bd3-dd3f-429e-bf0f-dfb39ab8e368",
                                                "sense_id": "497b2e85-98ed-3d17-9187-bdfcdd9a2850",
                                                "text": "Sacrée noblesse !… Il n’y a qu’elle pour vous tailler des cariatides pareilles. Quel galbe ! mes enfants. Quelle poitrine, quelles épaules, quels bras ! Je la vois d’ici soutenant le balcon du Louvre restauré. Comme elle vous fige le sang rien qu’en se pliant sur une hanche…"
                                            },
                                            {
                                                "example_id": "06864623-a50b-4d91-aa28-72b32c54c69b",
                                                "sense_id": "497b2e85-98ed-3d17-9187-bdfcdd9a2850",
                                                "text": "Elle se remémorait en souriant la jolie salle tout en velours rouge, encore éclairée au gaz, mais copiant en petit quelque salle d’opéra fastueuse, à force de cariatides, de piliers, de balcons, de loges et de sculptures tarabiscotées à l’excès."
                                            },
                                            {
                                                "example_id": "e1e41ee9-858f-461f-b39d-f9b22eb51ea5",
                                                "sense_id": "497b2e85-98ed-3d17-9187-bdfcdd9a2850",
                                                "text": "Sur le trottoir d’en face vous trouvez le Café des Rossignols avec ses cariatides et ses guirlandes de fleurs en stuc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bebe9f1-50e0-36e3-9104-fb4fc5946245",
                                        "entry_id": "290001c3-b409-33f9-89e0-eb6b181350f5",
                                        "glosses": [
                                            "Ordre d’architecture dans lequel les cariatides sont employées au lieu de colonnes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2ab2124-12d1-464b-a7ee-6e3fe9eaa87a",
                                                "sense_id": "4bebe9f1-50e0-36e3-9104-fb4fc5946245",
                                                "text": "Ordre cariatide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a85f5e7b-9787-320b-bf71-dcee37d5d7a3",
                                        "entry_id": "290001c3-b409-33f9-89e0-eb6b181350f5",
                                        "glosses": [
                                            "Danse lacédémonienne en l’honneur de Diane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
