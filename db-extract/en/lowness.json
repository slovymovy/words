                                                "sense_id": "23c1027d-271b-3d19-ac55-50c59b969807",
                                                "text": "Binnendijks ontstond enige bebouwing rond de in de laagte achter de dijk gelegen kerk."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "386e7238-bf90-3f0c-be2f-69dccad325e7",
                                        "entry_id": "df28bb40-46f3-3bcb-b7ef-35f072a100fd",
                                        "glosses": [
                                            "een of meer tonen met een kleine frequentie"
                                        ],
