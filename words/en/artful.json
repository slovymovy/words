{
    "word_family": [
        "art",
        "artfully",
        "artfulness",
        "artist",
        "artless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "13a5505e-9db4-3aa2-bdb6-f19e57482920",
                    "sense_definition": "Clever at deceiving people or achieving goals by deceitful and indirect means; crafty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "deceitful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>artful</w> salesman managed to convince the elderly couple to buy products they did not need.",
                            "target_lang_translations": {
                                "ru": "<w>Хитрый</w> продавец сумел убедить пожилую пару купить товары, которые им были не нужны."
                            }
                        },
                        {
                            "text": "Through an <w>artful</w> dodge, the politician avoided answering the journalist's direct question.",
                            "target_lang_translations": {
                                "ru": "С помощью <w>ловкой</w> уловки политик избежал прямого ответа на вопрос журналиста."
                            }
                        }
                    ],
                    "synonyms": [
                        "crafty",
                        "cunning",
                        "deceitful",
                        "foxy",
                        "guileful",
                        "sly",
                        "wily"
                    ],
                    "antonyms": [
                        "artless",
                        "naive"
                    ],
                    "common_phrases": [
                        "artful dodge",
                        "artful scheme"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ловкий в обмане или достижении целей хитрыми и непрямыми путями; коварный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хитрый",
                                "target_lang_sense_clarification": "склонный к обману и уловкам"
                            },
                            {
                                "target_lang_word": "ловкий",
                                "target_lang_sense_clarification": "умело использующий хитрость"
                            },
                            {
                                "target_lang_word": "изворотливый",
                                "target_lang_sense_clarification": "умеющий находить выход обманом"
                            },
                            {
                                "target_lang_word": "коварный",
                                "target_lang_sense_clarification": "скрытно злонамеренный или лукавый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3a2d34f-ff4f-3acc-bd81-43ebedf2f19f",
                    "sense_definition": "Showing great skill, dexterity, or artistic taste in creation or execution.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skillful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dancer captivated the audience with her delicate and <w>artful</w> movements across the stage.",
                            "target_lang_translations": {
                                "ru": "Танцовщица пленила зрителей своими утонченными и <w>искусными</w> движениями на сцене."
                            }
                        },
                        {
                            "text": "Her garden was filled with an <w>artful</w> arrangement of colorful flowers and stones.",
                            "target_lang_translations": {
                                "ru": "Ее сад был украшен <w>мастерской</w> композицией из ярких цветов и камней."
                            }
                        }
                    ],
                    "synonyms": [
                        "adroit"
                    ],
                    "antonyms": [
                        "clumsy",
                        "inept"
                    ],
                    "common_phrases": [
                        "artful arrangement"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявляющий высокое мастерство, ловкость или художественный вкус в создании или исполнении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусный",
                                "target_lang_sense_clarification": "обладающий высоким мастерством"
                            },
                            {
                                "target_lang_word": "мастерский",
                                "target_lang_sense_clarification": "выполненный с большим вкусом и умением"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3e89566e-3309-304f-8db7-9d36677d1947",
                    "sense_definition": "Created or performed with ingenuity, cleverness, or calculated design.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "skillful",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The novel's plot relies on an <w>artful</w> manipulation of timelines to keep readers guessing.",
                            "target_lang_translations": {
                                "ru": "Сюжет романа опирается на <w>тонкое</w> манипулирование временными линиями, заставляя читателей строить догадки."
                            }
                        },
                        {
                            "text": "He designed an <w>artful</w> device that solved the engineering problem efficiently.",
                            "target_lang_translations": {
                                "ru": "Он разработал <w>изобретательное</w> устройство, которое эффективно решило инженерную задачу."
                            }
                        }
                    ],
                    "synonyms": [
                        "astute",
                        "shrewd",
                        "subtle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Созданный или выполненный с изобретательностью, умом или продуманным расчётом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изобретательный",
                                "target_lang_sense_clarification": "находчивый, оригинальный"
                            },
                            {
                                "target_lang_word": "тонкий",
                                "target_lang_sense_clarification": "глубоко продуманный, нюансированный"
                            },
                            {
                                "target_lang_word": "мудрёный",
                                "target_lang_sense_clarification": "хитроумно устроенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43c123c5-ac86-372e-8258-09d8bda97636",
                    "sense_definition": "Not produced naturally; artificial or imitative.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theater used <w>artful</w> thunder produced by metal sheets to simulate an approaching storm.",
                            "target_lang_translations": {
                                "ru": "В театре использовали <w>искусственный</w> гром, создаваемый металлическими листами, чтобы сымитировать приближающуюся бурю."
                            }
                        },
                        {
                            "text": "They escaped the bright afternoon heat into the <w>artful</w> shade of the stone pavilion.",
                            "target_lang_translations": {
                                "ru": "Они укрылись от полуденного зноя в <w>рукотворной</w> тени каменной беседки."
                            }
                        }
                    ],
                    "antonyms": [
                        "natural"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English to mean artificial"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Созданный искусственно, а не естественным путём; ненатуральный или имитационный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искусственный",
                                "target_lang_sense_clarification": "не природный, рукотворный"
                            },
                            {
                                "target_lang_word": "рукотворный",
                                "target_lang_sense_clarification": "созданный руками человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54f93fb9-af2b-3420-9896-4dbe24508bf6",
                    "sense_definition": "Knowledgeable in the liberal arts; learned or wise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient scholar was revered as an <w>artful</w> philosopher of exceptional wisdom.",
                            "target_lang_translations": {
                                "ru": "Древнего мудреца почитали как <w>учёного</w> философа исключительной мудрости."
                            }
                        },
                        {
                            "text": "Such complex debates were traditionally reserved for the most <w>artful</w> academics of the court.",
                            "target_lang_translations": {
                                "ru": "Такие сложные дебаты традиционно предназначались для самых <w>сведущих</w> придворных ученых."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "No longer used in contemporary English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сведущий в свободных искусствах или науках; ученый, мудрый."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "учёный",
                                "target_lang_sense_clarification": "обладающий обширными знаниями"
                            },
                            {
                                "target_lang_word": "сведущий",
                                "target_lang_sense_clarification": "хорошо разбирающийся в науках"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}