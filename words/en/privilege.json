{
    "word_family": [
        "privileged",
        "underprivileged"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c5ddcdce-28b9-3257-bbfa-d9b58b0a746e",
                    "sense_definition": "A special right, advantage, or immunity granted or available only to a particular person or group.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "benefit_right",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Senior managers enjoy the <w>privilege</w> of having their own reserved parking spaces.",
                            "target_lang_translations": {
                                "ru": "Старшие менеджеры пользуются <w>привилегией</w> иметь собственные зарезервированные парковочные места.",
                                "zh": "高级经理享有拥有专属预留车位的<w>特权</w>。"
                            }
                        },
                        {
                            "text": "In this country, education is a right for everyone, not a special <w>privilege</w> for the rich.",
                            "target_lang_translations": {
                                "ru": "В этой стране образование — это право для всех, а не особая <w>привилегия</w> для богатых.",
                                "zh": "在这个国家，教育是每个人的权利，而不是富人的特殊<w>特权</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advantage",
                        "right",
                        "prerogative",
                        "immunity",
                        "liberty"
                    ],
                    "antonyms": [
                        "disadvantage",
                        "restriction"
                    ],
                    "common_phrases": [
                        "special privilege",
                        "enjoy a privilege",
                        "abuse of privilege"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое право, преимущество или освобождение от обязанностей, предоставляемое только определенному лицу или группе лиц.",
                        "zh": "只授予或只对特定个人或群体开放的特殊权利、好处或豁免。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привилегия",
                                "target_lang_sense_clarification": "исключительное право"
                            },
                            {
                                "target_lang_word": "льгота",
                                "target_lang_sense_clarification": "преимущество, облегчение условий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特权",
                                "target_lang_sense_clarification": "仅某些人或群体享有的特殊权利"
                            },
                            {
                                "target_lang_word": "优待",
                                "target_lang_sense_clarification": "特殊待遇或好处"
                            },
                            {
                                "target_lang_word": "豁免权",
                                "target_lang_sense_clarification": "免于某些义务或限制的权利"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ffecb6c2-1ba5-3881-a98e-7222a1b15fe1",
                    "sense_definition": "An opportunity to do something special or enjoyable that makes you feel proud and lucky.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "honor_opportunity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a great <w>privilege</w> to meet the famous author in person.",
                            "target_lang_translations": {
                                "ru": "Для меня было большой <w>честью</w> встретиться с известным писателем лично.",
                                "zh": "能亲自见到那位著名作家是一种莫大的<w>荣幸</w>。"
                            }
                        },
                        {
                            "text": "I had the <w>privilege</w> of working with such a talented team on this project.",
                            "target_lang_translations": {
                                "ru": "Мне выпала <w>честь</w> работать с такой талантливой командой над этим проектом.",
                                "zh": "能与这样一支才华横溢的团队共同参与这个项目，是我的<w>荣幸</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "misfortune"
                    ],
                    "common_phrases": [
                        "have the privilege",
                        "great privilege",
                        "rare privilege"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возможность сделать что-то особенное или приятное, вызывающая чувство гордости и удачи.",
                        "zh": "做某件特别或令人愉快的事的机会，会让人感到自豪和幸运。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честь",
                                "target_lang_sense_clarification": "почетное право, удача"
                            },
                            {
                                "target_lang_word": "привилегия",
                                "target_lang_sense_clarification": "особая возможность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荣幸",
                                "target_lang_sense_clarification": "因获得难得机会而感到自豪和幸运"
                            },
                            {
                                "target_lang_word": "殊荣",
                                "target_lang_sense_clarification": "特别的荣誉或难得的机会"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c2c6b1fd-c830-393a-b03f-905804c684ba",
                    "sense_definition": "The state of having advantages or opportunities due to one's wealth, social status, or background.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "social_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew up in a life of wealth and <w>privilege</w>, never worrying about money.",
                            "target_lang_translations": {
                                "ru": "Он вырос в богатстве и <w>привилегированном положении</w>, никогда не беспокоясь о деньгах.",
                                "zh": "他在财富和<w>特权</w>中长大，从不为钱发愁。"
                            }
                        },
                        {
                            "text": "The professor gave a lecture on how social <w>privilege</w> affects career opportunities.",
                            "target_lang_translations": {
                                "ru": "Профессор прочитал лекцию о том, как социальные <w>привилегии</w> влияют на карьерные возможности.",
                                "zh": "教授做了一场关于社会<w>特权</w>如何影响职业机会的讲座。"
                            }
                        }
                    ],
                    "synonyms": [
                        "advantage"
                    ],
                    "antonyms": [
                        "disadvantage"
                    ],
                    "common_phrases": [
                        "wealth and privilege",
                        "position of privilege",
                        "check your privilege"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наличие преимуществ или возможностей благодаря богатству, социальному статусу или происхождению.",
                        "zh": "因个人的财富、社会地位或出身而拥有优势或更多机会的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привилегированное положение",
                                "target_lang_sense_clarification": "социальный статус"
                            },
                            {
                                "target_lang_word": "привилегия",
                                "target_lang_sense_clarification": "преимущество"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特权",
                                "target_lang_sense_clarification": "因财富、地位或出身而拥有的优势状态"
                            },
                            {
                                "target_lang_word": "优越地位",
                                "target_lang_sense_clarification": "社会中的有利位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf4bfce5-79e9-31b2-9ea2-60741ce20fda",
                    "sense_definition": "A legal right that protects certain communications, such as those between a lawyer and client, from being revealed in court.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_protection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The conversation is protected by attorney-client <w>privilege</w> and cannot be used as evidence.",
                            "target_lang_translations": {
                                "ru": "Разговор защищен адвокатской <w>тайной</w> и не может быть использован в качестве доказательства.",
                                "zh": "这段谈话受律师—委托人<w>保密特权</w>保护，不能作为证据使用。"
                            }
                        },
                        {
                            "text": "He refused to answer the questions, claiming executive <w>privilege</w>.",
                            "target_lang_translations": {
                                "ru": "Он отказался отвечать на вопросы, ссылаясь на исполнительную <w>привилегию</w>.",
                                "zh": "他拒绝回答这些问题，声称自己享有行政<w>特权</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immunity"
                    ],
                    "common_phrases": [
                        "attorney-client privilege",
                        "executive privilege",
                        "claim privilege"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Законное право, защищающее определенные виды общения (например, между адвокатом и клиентом) от разглашения в суде.",
                        "zh": "一种法律权利，用来保护某些交流内容（如律师与委托人之间的交流）不在法庭上被披露。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тайна",
                                "target_lang_sense_clarification": "адвокатская"
                            },
                            {
                                "target_lang_word": "привилегия",
                                "target_lang_sense_clarification": "юридическая, исполнительная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保密特权",
                                "target_lang_sense_clarification": "法律上保护某些交流内容不被披露的权利"
                            },
                            {
                                "target_lang_word": "特权",
                                "target_lang_sense_clarification": "法律上的特别权利，如行政特权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf4057b7-7987-39eb-9c08-e13eb478d63d",
                    "sense_definition": "A permission granted to a user to perform specific actions on a computer system.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_access",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need administrator <w>privilege</w> to install new software on this computer.",
                            "target_lang_translations": {
                                "ru": "Вам нужны <w>права</w> администратора для установки нового программного обеспечения на этот компьютер.",
                                "zh": "你需要管理员<w>权限</w>才能在这台电脑上安装新软件。"
                            }
                        },
                        {
                            "text": "The system denied his request because he did not have the necessary access <w>privilege</w>.",
                            "target_lang_translations": {
                                "ru": "Система отклонила его запрос, так как у него не было необходимых <w>прав</w> доступа.",
                                "zh": "系统拒绝了他的请求，因为他没有所需的访问<w>权限</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "permission"
                    ],
                    "common_phrases": [
                        "admin privileges",
                        "access privileges",
                        "grant privileges"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрешение, предоставляемое пользователю для выполнения определенных действий в компьютерной системе.",
                        "zh": "授予用户在计算机系统中执行特定操作的许可。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "права",
                                "target_lang_sense_clarification": "доступа"
                            },
                            {
                                "target_lang_word": "привилегии",
                                "target_lang_sense_clarification": "компьютерные"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "权限",
                                "target_lang_sense_clarification": "计算机系统中执行特定操作的许可"
                            },
                            {
                                "target_lang_word": "访问权限",
                                "target_lang_sense_clarification": "访问系统资源的许可"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d8203613-fdbb-3dc9-8bbf-064688ee7ce7",
                    "sense_definition": "A special right or immunity enjoyed by members of a legislative body.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "benefit_right",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The member of parliament spoke freely under the protection of parliamentary <w>privilege</w>.",
                            "target_lang_translations": {
                                "ru": "Член парламента свободно выступал под защитой парламентского <w>иммунитета</w>.",
                                "zh": "这位议员在议会<w>特权</w>的保护下自由发言。"
                            }
                        },
                        {
                            "text": "They debated whether the breach of <w>privilege</w> should be investigated by the committee.",
                            "target_lang_translations": {
                                "ru": "Они обсуждали, должен ли комитет расследовать злоупотребление <w>привилегиями</w>.",
                                "zh": "他们在讨论是否应由委员会调查这次侵犯<w>议会特权</w>的行为。"
                            }
                        }
                    ],
                    "synonyms": [
                        "immunity",
                        "right"
                    ],
                    "common_phrases": [
                        "parliamentary privilege",
                        "breach of privilege"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "politics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое право или неприкосновенность, которыми пользуются члены законодательного органа.",
                        "zh": "立法机构成员享有的特殊权利或豁免。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иммунитет",
                                "target_lang_sense_clarification": "парламентский"
                            },
                            {
                                "target_lang_word": "привилегия",
                                "target_lang_sense_clarification": "парламентская"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "议会特权",
                                "target_lang_sense_clarification": "议会成员享有的特殊权利或保护"
                            },
                            {
                                "target_lang_word": "议员豁免权",
                                "target_lang_sense_clarification": "议员享有的不受追究的保护"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f946552-8635-364a-aac5-65ec9921f1d8",
                    "sense_definition": "An exemption from certain religious laws granted by the Pope.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "religious_exemption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bishop requested a special <w>privilege</w> from the Vatican for the ceremony.",
                            "target_lang_translations": {
                                "ru": "Епископ запросил у Ватикана особую <w>привилегию</w> для церемонии.",
                                "zh": "主教向梵蒂冈请求为这场仪式授予一项特殊的<w>特许权</w>。"
                            }
                        },
                        {
                            "text": "Historically, a papal <w>privilege</w> could exempt a monastery from local jurisdiction.",
                            "target_lang_translations": {
                                "ru": "Исторически папская <w>привилегия</w> могла освободить монастырь от местной юрисдикции.",
                                "zh": "从历史上看，教皇的<w>特许权</w>可以使修道院免受地方司法管辖。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "historical, Roman Catholicism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Освобождение от определенных религиозных законов, даруемое Папой Римским.",
                        "zh": "由教皇授予的、免于遵守某些宗教法规的特殊许可或豁免。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "привилегия",
                                "target_lang_sense_clarification": "церковная"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "特许权",
                                "target_lang_sense_clarification": "教皇授予的宗教性特殊权利或豁免"
                            },
                            {
                                "target_lang_word": "教皇特许权",
                                "target_lang_sense_clarification": "教皇授予的特别宗教豁免"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c40b9d6-813d-3f8a-9e13-2912c3cf6175",
                    "sense_definition": "To give priority or higher status to something.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prioritize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This educational theory <w>privileges</w> practical experience over theoretical knowledge.",
                            "target_lang_translations": {
                                "ru": "Эта образовательная теория <w>отдает предпочтение</w> практическому опыту перед теоретическими знаниями.",
                                "zh": "这种教育理论<w>偏重</w>实践经验而非理论知识。"
                            }
                        },
                        {
                            "text": "The author's narrative style <w>privileges</w> the internal thoughts of the characters.",
                            "target_lang_translations": {
                                "ru": "Повествовательный стиль автора <w>ставит на первое место</w> внутренние мысли персонажей.",
                                "zh": "作者的叙事风格<w>偏重</w>人物的内心活动。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "formal, academic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдавать приоритет или присваивать более высокий статус чему-либо.",
                        "zh": "给予某事更高的优先级或地位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отдавать предпочтение",
                                "target_lang_sense_clarification": "ставить в приоритет"
                            },
                            {
                                "target_lang_word": "ставить выше",
                                "target_lang_sense_clarification": "ценить больше"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "偏重",
                                "target_lang_sense_clarification": "把某事看得比其他事更重要"
                            },
                            {
                                "target_lang_word": "优先考虑",
                                "target_lang_sense_clarification": "优先对待或首先考虑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1780f411-5a3d-32d3-a025-17745bcacfa0",
                    "sense_definition": "To grant a special right, immunity, or authority to someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "grant_right",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy <w>privileges</w> long-term employees with additional vacation days.",
                            "target_lang_translations": {
                                "ru": "Новая политика <w>наделяет привилегиями</w> сотрудников с большим стажем, предоставляя дополнительные дни отпуска.",
                                "zh": "新政策通过增加休假天数来<w>给予特权</w>长期员工。"
                            }
                        },
                        {
                            "text": "We should not <w>privilege</w> one group of citizens while ignoring the needs of others.",
                            "target_lang_translations": {
                                "ru": "Мы не должны <w>давать привилегии</w> одной группе граждан, игнорируя потребности других.",
                                "zh": "我们不应<w>给予特权</w>某一群公民而无视其他人的需求。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять кому-либо особое право, иммунитет или полномочия.",
                        "zh": "给予某人特殊权利、豁免或权力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наделять привилегиями",
                                "target_lang_sense_clarification": "давать особые права"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "给予特权",
                                "target_lang_sense_clarification": "赋予某人特殊权利或待遇"
                            },
                            {
                                "target_lang_word": "赋予特权",
                                "target_lang_sense_clarification": "正式地赋予特别权利"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}