                "senses": [
                    {
                        "sense_id": "5a34c39e-bcb9-31ea-bca5-a864e55a2c58",
                        "entry_id": "90655be0-3fc6-3a89-9772-db1bc01022be",
                        "glosses": [
                            "starke Abneigung gegen jemanden oder etwas"
                        ],
                        "tags": [
                            "gehoben"
                        ],
                        "examples": [
                            {
                                "example_id": "a1cdb80c-9739-4032-abc5-e76fa0ecf1e6",
                                "sense_id": "5a34c39e-bcb9-31ea-bca5-a864e55a2c58",
                                "text": "„Diese Musik klingt so universal, dass sie schon wieder beliebig klingt, man kann sie in der Badewanne mit demselben Genuss oder Degout konsumieren wie in einer leeren Bahnhofshalle beim Warten auf den ICE oder auf dem Nachtflug nach Kuala Lumpur.“"
                            },
                            {
                                "example_id": "eb06aeda-5058-465f-aa78-020867ff5773",
                                "sense_id": "5a34c39e-bcb9-31ea-bca5-a864e55a2c58",
                                "text": "„In dem Degout über die Mummerei, deren Zeuge sie sein mußte, löste sich ihr die Zunge; […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0b3fbfb-0a75-488f-b1da-bbd349a13a6d",
                        "source_entry_id": "90655be0-3fc6-3a89-9772-db1bc01022be",
                        "source_sense_id": "5a34c39e-bcb9-31ea-bca5-a864e55a2c58",
                        "source_sense_description": "gehoben: starke Abneigung gegen jemanden oder etwas",
                        "target_lang_word": "disgust",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disgust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                        "entry_id": "dbe037de-479d-3247-ae69-deb7a8e707fa",
                                        "glosses": [
                                            "To cause an intense dislike for something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d29b74f-85d8-4fb7-9b08-ff01667ea6d2",
                                                "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                                "text": "It disgusts me to see her chew with her mouth open."
                                            },
                                            {
                                                "example_id": "65fd8c42-b8b2-4ec0-9142-b488cbfa50f4",
                                                "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                                "text": "Tuc[ca]. […] Can thy Author doe it impudently enough? / Hiſt[rio]. O, I warrant you, Captaine: and ſpitefully inough too; he ha's one of the moſt ouerflowing villanous wits, in Rome. He will ſlander any man that breathes; If he diſguſt him. / Tucca. I'le know the poor, egregious, nitty Raſcall; and he haue ſuch commendable Qualities, I'le cheriſh him: […]"
                                            },
                                            {
                                                "example_id": "6c4df528-51da-4a0d-af0e-fadf09e11a6a",
                                                "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                                "text": "Mud This is a very specious piece of business; and above my implication—Dear me—dear me—what a thing it is, that one never can disgust one’s meals in peace—but one must be torn piecemeal with defamations—convocations—and other informalities—If I’d any of the fees and requisites of office for my pains—it would be a different thing—but every body knows I’m an ignoramous, and commit justice gratis—I must disperse the complaint."
                                            },
                                            {
                                                "example_id": "4fbd8aee-0860-481f-89d3-e011f510ab47",
                                                "sense_id": "954a3684-0fee-3374-86e3-5412d73f36fc",
                                                "text": "1874, Marcus Clarke, For the Term of His Natural Life Chapter V\nIt is impossible to convey, in words, any idea of the hideous phantasmagoria of shifting limbs and faces which moved through the evil-smelling twilight of this terrible prison-house. Callot might have drawn it, Dante might have suggested it, but a minute attempt to describe its horrors would but disgust."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disgust",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7f1f533-596c-3c76-b3cd-57e066e5eafc",
                                        "entry_id": "69300267-907c-34be-90f1-343193572dc0",
                                        "glosses": [
                                            "An intense dislike or loathing someone feels for something bad or nasty."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f0c47f2-9c9f-4cb1-97e1-6989601ac8a0",
                                                "sense_id": "b7f1f533-596c-3c76-b3cd-57e066e5eafc",
                                                "text": "With an air of disgust, she stormed out of the room."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c04b8b54-8b03-4b42-a46d-3c63153013ba",
                        "source_entry_id": "90655be0-3fc6-3a89-9772-db1bc01022be",
                        "source_sense_id": "5a34c39e-bcb9-31ea-bca5-a864e55a2c58",
                        "source_sense_description": "gehoben: starke Abneigung gegen jemanden oder etwas",
                        "target_lang_word": "dégoût",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégoût",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75398804-3750-3aa9-ace0-15beec73060c",
                                        "entry_id": "a65becde-665c-3200-ab47-b439b0a5483a",
                                        "glosses": [
                                            "Manque de goût, d’appétit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0271ef8-6664-462d-9db9-a0b0a39ce957",
                                                "sense_id": "75398804-3750-3aa9-ace0-15beec73060c",
                                                "text": "Il a un si grand dégoût, qu’il ne peut manger de rien."
                                            },
                                            {
                                                "example_id": "c4944a99-6447-435b-99ec-132aa94e0c2b",
                                                "sense_id": "75398804-3750-3aa9-ace0-15beec73060c",
                                                "text": "Il n’a plus de fièvre, mais il lui est resté du dégoût."
                                            },
                                            {
                                                "example_id": "1c2e5739-570f-46bd-b909-dda403b83ff8",
                                                "sense_id": "75398804-3750-3aa9-ace0-15beec73060c",
                                                "text": "Vaincre, surmonter son dégoût."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aaa606a0-0100-37f2-9f37-1f4d26018716",
                                        "entry_id": "a65becde-665c-3200-ab47-b439b0a5483a",
                                        "glosses": [
                                            "Répugnance violente éprouvée pour ce qui est perçu comme nuisible à sa santé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1831c4a-4da9-4d24-84f9-8751fe5b3375",
                                                "sense_id": "aaa606a0-0100-37f2-9f37-1f4d26018716",
                                                "text": "D’écœurement, de dégoût et d’indigestion, Tintin vomit tripes et boyaux et faillit en crever pendant la nuit."
                                            },
                                            {
                                                "example_id": "dd27e476-e2ad-4128-8b10-852ceb57c41d",
                                                "sense_id": "aaa606a0-0100-37f2-9f37-1f4d26018716",
                                                "text": "Des hoquets de dégoût convulsèrent de nouveau leurs faces hâlées, zébrées de rides : depuis un mois, ils avaient bu de l’eau dans laquelle mijotait ce noyé ; depuis un mois tout le pays s’abreuvait de cette pourriture."
                                            },
                                            {
                                                "example_id": "25fa0a79-242b-4c6c-995e-005e6b3b191b",
                                                "sense_id": "aaa606a0-0100-37f2-9f37-1f4d26018716",
                                                "text": "Le dégoût est une réaction émotionnelle de défense atavique à l’encontre d’agents extérieurs susceptibles de nous contaminer : les sécrétions corporelles (morves, vomissures, excréments), les parasites (vers, poux, etc.), les corps en décomposition et les vecteurs de maladies contagieuses (pestiférés, lépreux). Le dégoût entraîne une réaction de rejet, voire de destruction, des substances ou des individus virtuellement contaminants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4d65c7f-eb52-3f75-803a-ca2405c77685",
                                        "entry_id": "a65becde-665c-3200-ab47-b439b0a5483a",
                                        "glosses": [
                                            "Répugnance qu’on a pour certains aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "181a07d3-d918-4493-9a47-8769677e1f1d",
                                                "sense_id": "a4d65c7f-eb52-3f75-803a-ca2405c77685",
                                                "text": "Elle nous imposait ses goûts et ses dégoûts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "556b4889-5166-3ef2-bfc3-a1725d1a904b",
                                        "entry_id": "a65becde-665c-3200-ab47-b439b0a5483a",
                                        "glosses": [
                                            "Aversion qu’on prend pour une chose ou pour une personne."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d9c9824-6f25-4935-af79-ed2c62c98d76",
                                                "sense_id": "556b4889-5166-3ef2-bfc3-a1725d1a904b",
                                                "text": "Elle guettait les passants, mais avec un air d'indifférence profonde, presque de dégoût."
                                            },
                                            {
                                                "example_id": "1a2ac542-8da6-443e-81f6-ba2d215c4b90",
                                                "sense_id": "556b4889-5166-3ef2-bfc3-a1725d1a904b",
                                                "text": "Si Gobineau a été l’objet du dégoût, de la crainte, de l’ostracisme de nos « rationalistes », c’est qu’il s’est élevé à la fois contre leurs faux raisonnements et contre leur absurde principe de la primauté de la raison : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a5383f0-894d-3645-ae8d-1ee21acdf2b8",
                                        "entry_id": "a65becde-665c-3200-ab47-b439b0a5483a",
                                        "glosses": [
                                            "Déception dans l’usage d’une chose qui en amène la répugnance."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "note": "En ce sens, on l’emploie surtout au pluriel",
                                        "examples": [
                                            {
                                                "example_id": "5d76f700-237b-42a9-9596-08271dbf965f",
                                                "sense_id": "2a5383f0-894d-3645-ae8d-1ee21acdf2b8",
                                                "text": "Il fut abreuvé de dégoûts."
                                            },
                                            {
                                                "example_id": "426700ba-beae-4dab-aa55-115b8f9ae00c",
                                                "sense_id": "2a5383f0-894d-3645-ae8d-1ee21acdf2b8",
                                                "text": "Il a eu bien des dégoûts dans sa carrière."
                                            },
                                            {
                                                "example_id": "9a9fa3ab-da73-41dd-8d8f-2187c78f779b",
                                                "sense_id": "2a5383f0-894d-3645-ae8d-1ee21acdf2b8",
                                                "text": "Éprouver, essuyer des dégoûts."
                                            },
                                            {
                                                "example_id": "49074474-3208-4365-b567-1477edb4cbb4",
                                                "sense_id": "2a5383f0-894d-3645-ae8d-1ee21acdf2b8",
                                                "text": "Il connaît tous les dégoûts du métier."
                                            },
                                            {
                                                "example_id": "2b5f505c-9a6c-448b-95fa-8c321aab8c2b",
                                                "sense_id": "2a5383f0-894d-3645-ae8d-1ee21acdf2b8",
                                                "text": "— Les premiers mois sont fatigants, répondit M. Roux. Évidemment, l’exercice à six heures du matin, dans la cour du quartier, par huit degrés de froid, est pénible, et l’on ne surmonte pas tout de suite les dégoûts de la chambrée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
