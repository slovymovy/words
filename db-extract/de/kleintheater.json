                ],
                "senses": [
                    {
                        "sense_id": "94645d15-784b-3fbc-a479-0ef448b2ed77",
                        "entry_id": "ab01149c-435c-3e7e-a7da-8b4caff5a6a0",
                        "glosses": [
                            "Kleinkunstbühne, die im Unterschied zum Großtheater nur über begrenzte Räumlichkeiten und Mittel verfügt und entsprechend mit einer geringeren Zahl von Programmen und Schauspielern agiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0700af1-74ff-43e4-a5f5-d8b964f8445d",
                                "sense_id": "94645d15-784b-3fbc-a479-0ef448b2ed77",
                                "text": "„Demnächst ist Karl Dall, auch schon 74 Jahre alt, mit einer neuen Blödelshow in Kneipen und Kleintheatern unterwegs.“"
                            },
                            {
                                "example_id": "b32bc372-f0bb-459b-96c1-51631e060f8d",
                                "sense_id": "94645d15-784b-3fbc-a479-0ef448b2ed77",
                                "text": "„Früher war er Schauspieler in einem poetischen Kleintheater; heute ist er es auf der großen Bühne des Kunstmarkts.“"
                            },
                            {
                                "example_id": "9972452b-b1ec-41b3-bc99-135501f006c5",
                                "sense_id": "94645d15-784b-3fbc-a479-0ef448b2ed77",
                                "text": "„Eine Taschenlampe hilft, die Illusion eines Sonnen- oder Mondaufgangs auf die Bühne des Kleintheaters zu zaubern oder ein Großfeuer zu inszenieren.“"
                            },
                            {
                                "example_id": "922ed9ce-d8eb-4162-9ea9-8cd56ec00178",
                                "sense_id": "94645d15-784b-3fbc-a479-0ef448b2ed77",
                                "text": "„Aber in einer Stadt, die sich ein gutes Dutzend voll- oder teilsubventionierte Groß- und Kleintheater sowie eine prachtvolle Galerie von Museen für Alte Kunst, Neue Kunst, Kleinkunst, Baukunst, Postkunst, Kunstgewerbe und sonstiges leistet, gibt es gewiß auch ein paar zwingendere Gründe, das einzige nichtkommerzielle Kino zu schließen.“"
                            },
                            {
                                "example_id": "335ea0c5-b5a6-43a1-b099-f9c46ea3e4ee",
                                "sense_id": "94645d15-784b-3fbc-a479-0ef448b2ed77",
                                "text": "„Über einen Hinterhof und dann drei Treppen hoch führt der Weg in einen kleinen Theatersaal, das Hoftheater Kreuzbergs, ein typisches Kleintheater, mit mehr Charme als Profil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
