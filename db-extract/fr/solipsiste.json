                ],
                "senses": [
                    {
                        "sense_id": "54369b32-c9d1-3dab-92f4-ad790bcd1c78",
                        "entry_id": "782680ab-75e2-3ccd-b0e1-8e4fa8db56c3",
                        "glosses": [
                            "Qui relève du solipsisme, qui se vit ou se pense seul, sans les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c6dac8-f3e9-45bb-a0b4-473efab04c87",
                                "sense_id": "54369b32-c9d1-3dab-92f4-ad790bcd1c78",
                                "text": "La joie ne saurait être autiste ou solipsiste; elle est partage et partagée."
                            },
                            {
                                "example_id": "c2e55432-2958-48d3-826c-aece704f89e3",
                                "sense_id": "54369b32-c9d1-3dab-92f4-ad790bcd1c78",
                                "text": "Jadis la vie privée avant besoin du Dehors, elle était inachevée, c'était son seul privilège. Désormais, secondée par l'arborescence de la Toile, elle est solipsiste et s'enivre d'elle-même, des ombres qu'elle prend pour la réalité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "035ba760-59b0-406f-aec6-38a71c3baba6",
                        "source_entry_id": "782680ab-75e2-3ccd-b0e1-8e4fa8db56c3",
                        "source_sense_id": "54369b32-c9d1-3dab-92f4-ad790bcd1c78",
                        "target_lang_word": "solipsist",
                        "target_lang_code": "en",
