                        ],
                        "examples": [
                            {
                                "example_id": "4c80c7e5-61bc-4fe6-9e58-4921e41037b0",
                                "sense_id": "e8d9b467-b797-3fd6-bbe0-3fd01c68dec2",
                                "text": "На вопрос мой — кто он был? — узнал я, что то был старого покрою стряпчий, едущий в Петербург с великим множеством изодранных бумаг, которые он тогда разбирал.",
                                "translation": "When I asked who he was, I learned that he was a lawyer of the old school, going to Petersburg with a great heap of ragged papers, which he was then sorting.",
                                "english": "When I asked who he was, I learned that he was a lawyer of the old school, going to Petersburg with a great heap of ragged papers, which he was then sorting."
                            }
                        ]
                    }
