        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0fa92ae6-fa1d-3e4d-a089-f360595529b5",
                "word": "speedup",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6d80d3f5-cb05-425c-96ba-308eabc07bed",
                        "entry_id": "0fa92ae6-fa1d-3e4d-a089-f360595529b5",
                        "tags": [
                            "plural"
                        ],
                        "form": "speedups"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "787dd3e5-b4ff-3b4d-9571-11d3056ed578",
                        "entry_id": "0fa92ae6-fa1d-3e4d-a089-f360595529b5",
                        "glosses": [
                            "An amount or rate of decrease in time taken to do a certain amount of work."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0408fdcc-3d36-4029-9e81-5a272b30ddfa",
                                "sense_id": "787dd3e5-b4ff-3b4d-9571-11d3056ed578",
                                "text": "The results of this generalized speedup of the corporate metabolism are multiple: shorter product life cycles, more leasing and renting, more frequent buying and selling, more ephemeral consumption patterns, […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "a3006cef-72cb-34e4-819f-9b1dd358524c",
                        "entry_id": "0fa92ae6-fa1d-3e4d-a089-f360595529b5",
                        "glosses": [
                            "The relationship between time taken and number of processors used."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "07fcc40e-cf3a-3624-9143-bfc9d3d7270c",
                        "entry_id": "0fa92ae6-fa1d-3e4d-a089-f360595529b5",
                        "glosses": [
                            "An employer's demand for more output without more pay."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "92065b9d-a10c-427a-860a-688eb7b6e69f",
                                "sense_id": "07fcc40e-cf3a-3624-9143-bfc9d3d7270c",
                                "text": "There were, of course, those observers who argued that since in some industries 50 or 60 per cent of those employed were scientific, technical, and administrative staff, the employer would soon include them in his speedup plans."
                            },
                            {
                                "example_id": "200011a2-23fc-46bc-a546-ffddc2faade6",
                                "sense_id": "07fcc40e-cf3a-3624-9143-bfc9d3d7270c",
                                "text": "For the mass of new workers who had not come out of a syndicalist or craft tradition, incentive pay and the speedup idea carried relatively little negative meaning."
                            },
                            {
                                "example_id": "87357c85-042b-4d55-87ab-4306edc7c6a5",
                                "sense_id": "07fcc40e-cf3a-3624-9143-bfc9d3d7270c",
                                "text": "The strike was over a speedup of the assembly line, which in the previous week had increased from 49 to 58 cars per hour. Out of this strike emerged the Dodge Revolutionary Union Movement (DRUM)."
                            },
                            {
                                "example_id": "d564d3d9-88f3-4eae-b635-201ee37cdb88",
                                "sense_id": "07fcc40e-cf3a-3624-9143-bfc9d3d7270c",
                                "text": "With constant speedup of the line and with the cold temperatures of the plant, one angry worker told me, “After ten years, people walk like they're sixty or seventy.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ae8a9a3b-df2b-41ce-ad9f-542e3ba847aa",
                        "source_entry_id": "0fa92ae6-fa1d-3e4d-a089-f360595529b5",
                        "source_sense_description": "an amount of decrease in time taken",
                        "target_lang_word": "Beschleunigung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschleunigung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73848ed3-802f-3267-a390-14666f82502e",
                                        "entry_id": "e982a6ad-2f5b-32b1-8b89-2f721579c5b0",
                                        "glosses": [
                                            "Erhöhung der Geschwindigkeit eines Vorgangs"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2bb5d510-1719-43b5-a24e-dc6e85cb10ed",
                                                "sense_id": "73848ed3-802f-3267-a390-14666f82502e",
                                                "text": "Er machte seinen politischen Einfluss geltend, was eine sofortige Beschleunigung des Genehmigungsverfahrens zur Folge hatte."
                                            },
                                            {
                                                "example_id": "b858db03-1b14-425c-8ecc-c339a3278423",
                                                "sense_id": "73848ed3-802f-3267-a390-14666f82502e",
                                                "text": "Die Beschleunigung drückt den Piloten in den Sitz."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7a7a63f3-ac01-38c2-ad6a-bb094cb9528b",
                                        "entry_id": "e982a6ad-2f5b-32b1-8b89-2f721579c5b0",
                                        "glosses": [
                                            "Ableitung der Geschwindigkeit nach der Zeit (kann beliebiges Vorzeichen haben)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6beba132-66ca-485b-a329-8bdcfe2973a8",
                                                "sense_id": "7a7a63f3-ac01-38c2-ad6a-bb094cb9528b",
                                                "text": "Im freien Fall erfährt man eine Beschleunigung von ungefähr 9,81 m/s²."
                                            },
                                            {
                                                "example_id": "ef63537d-ac34-4995-8789-78742842040b",
                                                "sense_id": "7a7a63f3-ac01-38c2-ad6a-bb094cb9528b",
                                                "text": "Die Beschleunigung drückt den Piloten in den Sitz."
