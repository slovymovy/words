                "senses": [
                    {
                        "sense_id": "1b60197b-5f3e-33be-8c32-231e400ce235",
                        "entry_id": "2211fea6-6fdd-3c81-b8db-70dd13904bf6",
                        "glosses": [
                            "Relatif aux Hutus, peuple d’Afrique centrale majoritaire au Rwanda et au Burundi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "093da938-f28e-40c6-8da8-60bd1a618b78",
                                "sense_id": "1b60197b-5f3e-33be-8c32-231e400ce235",
                                "text": "Notre grande et belle famille, ni hutue ni tutsie, commença à se déchirer comme une meute de chiens affamés et fous."
                            },
                            {
                                "example_id": "13848e62-f5da-422c-8411-2877ccb697ae",
                                "sense_id": "1b60197b-5f3e-33be-8c32-231e400ce235",
                                "text": "Du 6 avril au 4 juillet, 800 000 personnes, en majorité des Tutsis, mais aussi des Hutus « modérés », furent exécutées par les partisans de la suprématie hutue, pendant que la communauté internationale détournait les yeux."
                            },
                            {
                                "example_id": "a1c48fbd-407e-48a1-a93d-13465dbc9736",
                                "sense_id": "1b60197b-5f3e-33be-8c32-231e400ce235",
                                "text": "Enfin, et parmi d'autres critiques, nous aurions favorisé la fuite des criminels hutu."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "384a6923-f5b1-462d-8dbf-e107633d970b",
