                    },
                    {
                        "translation_id": "dfc85ceb-3adb-4241-8846-66798e3a3b45",
                        "source_entry_id": "8d651777-2a14-3760-bd8e-4c6d55ed1d0a",
                        "source_sense_description": "of or relating to sound",
