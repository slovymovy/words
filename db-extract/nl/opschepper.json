                        "source_sense_id": "52a544c4-8af4-32e0-b625-1a5c13aad844",
                        "source_sense_description": "iemand die vaak opschept tot ergernis van anderen",
                        "target_lang_word": "Angeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Angeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                        "entry_id": "b03214ad-0a3e-3a7f-b121-356a75e57dd9",
                                        "glosses": [
                                            "Person, die ihre eigenen Leistungen freiwillig und unaufgefordert in den Vordergrund stellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc20af85-5b39-44ce-8343-6ce74b2d85b1",
                                                "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                                "text": "So ein Angeber hat mir gerade noch gefehlt!"
                                            },
                                            {
                                                "example_id": "dc28ff32-0070-4ae4-94ab-be55c7faa319",
                                                "sense_id": "7e33aca7-15d0-37ed-99b2-30e3e3b9a7cf",
                                                "text": "„Das Achtergewicht liegt nicht selten bei einem Amerikaner, der im Witz oft die Rolle eines übertrumpfungssüchtigen Angebers spielt, der alles noch schöner, noch größer und noch praktischer besitzt als sein Gegenüber aus der alten Welt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3329d98a-09f5-403f-aa6b-1dcf849bf6c6",
                        "source_entry_id": "607daf35-4754-3b22-8249-94f55f949791",
                        "source_sense_id": "52a544c4-8af4-32e0-b625-1a5c13aad844",
                        "source_sense_description": "iemand die vaak opschept tot ergernis van anderen",
                        "target_lang_word": "Aufschneider",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufschneider",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                                        "entry_id": "9b394ba5-e3ec-3303-bb00-787ef7422718",
                                        "glosses": [
                                            "Person, die stark übertreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d79fc840-dc69-4805-960f-22b4a0ccf0f9",
                                                "sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                                                "text": "Der Aufschneider gab sich als Besitzer der Kneipe aus, in der wir saßen, obwohl ich den Besitzer kenne."
                                            },
                                            {
                                                "example_id": "1ed5c61b-fdca-4b4d-a188-40f2df92217b",
                                                "sense_id": "14882dec-3504-3e80-9e53-1071be8d9a96",
                                                "text": "„Wir Spätgeborenen machen es zu unserem Problem, weil wir die »echte«, von allen Einmischungen männlicher Aufschneider befreite Austen haben wollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c9f5870e-2b3d-40aa-91d6-2e2cb10335ab",
                        "source_entry_id": "607daf35-4754-3b22-8249-94f55f949791",
                        "source_sense_id": "52a544c4-8af4-32e0-b625-1a5c13aad844",
                        "source_sense_description": "iemand die vaak opschept tot ergernis van anderen",
                        "target_lang_word": "show off",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "show off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acc292ed-d02c-32f9-9f43-805f00d6c57a",
                                        "entry_id": "d5a5bf0a-9ba4-32d6-81b5-55fdc3cd7fc9",
                                        "glosses": [
                                            "To exhibit the best attributes of something."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bebcf29d-27a9-4bf3-8811-04d61f4ba81b",
                                                "sense_id": "acc292ed-d02c-32f9-9f43-805f00d6c57a",
                                                "text": "Grocery stores show off their produce by placing the most attractive specimens in front."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                        "entry_id": "d5a5bf0a-9ba4-32d6-81b5-55fdc3cd7fc9",
                                        "glosses": [
                                            "To attract attention to for the purpose of bragging or personal exhibitionism; to demonstrate a skill, talent or property for the purpose of bragging or personal exhibitionism."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64fbb374-2db8-40da-a20a-1b91d153533d",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "She loves to show off her driving prowess."
                                            },
                                            {
                                                "example_id": "fe3a1bc2-c4b5-4172-b715-e470511eb755",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "She loves to show off when she gets behind the wheel of a car."
                                            },
                                            {
                                                "example_id": "354df866-4f1a-4552-afbe-74acebaf7689",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "“Listen, my Oscar,” she said, resuming at once her tender voice, “you have a propensity to talk, and to tell all you know, and all that you don’t know; and you do it to show off, with the foolish vanity of a mere lad.[…]”"
                                            },
                                            {
                                                "example_id": "925a5b52-f307-4ff6-a820-38c606b2acf1",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "If you've just acquired a Google Glass headset for £1,000, don't show it off at the movies. UK cinemas are to ban the headsets over fears that the gadgets can be used to make pirate copies of Hollywood blockbusters."
                                            },
                                            {
                                                "example_id": "8e8b0df0-e8ec-41a4-bba2-385f63000fcc",
                                                "sense_id": "e3800fdc-b0f5-3aed-9124-d8de27db0c29",
                                                "text": "She told the press that the group had been for an evening out and that the driver has been showing off by driving fast."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "show off",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "825d561f-748a-33ef-9cfb-a40b9fab65a3",
                                        "entry_id": "648d2671-d885-352a-8861-cf1c070ae9b6",
                                        "glosses": [
                                            "Nonstandard spelling of show-off."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "nonstandard"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
