            "senses": [
                {
                    "sense_id": "1a2e65a1-0797-3585-9ab9-da6e1b41bd49",
                    "sense_definition": "Souffrance physique ou morale cruelle et atroce infligée à une personne.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "souffrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les conventions internationales interdisent formellement l'usage de la <w>torture</w> contre les prisonniers de guerre."
                        },
                        {
                            "text": "Le pauvre animal a survécu à une véritable <w>torture</w> avant d'être enfin secouru par les soigneurs."
                        }
                    ],
                    "synonyms": [
                        "souffrance",
                        "supplice",
                        "tourment"
                    ],
                    "common_phrases": [
                        "actes de torture",
                        "instrument de torture"
                    ]
                },
                {
                    "sense_id": "a392f4e7-5f48-3eb7-afe8-436908a51488",
                    "sense_definition": "Supplice corporel infligé légalement ou arbitrairement à un accusé pour obtenir des aveux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "souffrance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au Moyen Âge, on soumettait régulièrement les criminels à la <w>torture</w> pour leur arracher des aveux."
                        },
                        {
                            "text": "Le juge a refusé d'employer la <w>torture</w> pour faire parler cet homme accusé de trahison."
                        }
                    ],
                    "synonyms": [
                        "question",
                        "supplice"
                    ],
                    "common_phrases": [
                        "mettre à la torture"
                    ]
                },
                {
                    "sense_id": "1aae0fa2-7959-3bf3-a9d3-c2f46a34b023",
                    "sense_definition": "Situation pénible, ennui extrême ou vive contrariété qui met la patience à l'épreuve.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Attendre les résultats de cet examen pendant des semaines est une véritable <w>torture</w> pour lui."
                        },
                        {
                            "text": "Rester immobile pendant trois heures dans cette salle étouffante était une pure <w>torture</w>."
                        }
                    ],
                    "synonyms": [
                        "calvaire",
                        "supplice",
                        "tourment"
                    ]
                }
            ]
        },
