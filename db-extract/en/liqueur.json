                        "translation_id": "aa522505-def3-42ba-8294-9c859df5c29c",
                        "source_entry_id": "3c17a100-f198-33bb-a9a7-2f20a2229bd7",
                        "source_sense_id": "41d41a54-b6f8-32de-8f09-bfb08dd0d3ff",
