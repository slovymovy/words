                "senses": [
                    {
                        "sense_id": "20955165-75a8-3560-92b8-750b06a2eab0",
                        "entry_id": "72d9d968-3d15-37de-9c20-a680648746e3",
                        "glosses": [
                            "Angebot und Nachfrage zu Waren aus der Lüftungsindustrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3047de82-112c-47b6-851b-e68e048e2490",
                                "sense_id": "20955165-75a8-3560-92b8-750b06a2eab0",
                                "text": "„Mit hochwertigsten Bauteilen, einer energetisch effizienten und flüsterleisen Lüftung sowie einer innovativen Steuer- und Regelungstechnik gehören die profi-air touch Lüftungsgeräte zu den modernsten und fortschrittlichsten Geräten im europäischen Lüftungsmarkt.“"
                            },
                            {
                                "example_id": "7f9aea3e-a6ce-4da9-b61f-2f54956f1356",
                                "sense_id": "20955165-75a8-3560-92b8-750b06a2eab0",
                                "text": "„Das Wachstum in der Lüftungssparte dürfte 2013 wieder anziehen: Nach Angaben von CFO Berchtold wachse der Lüftungsmarkt in diesem Jahr um rund 8%. “"
                            },
                            {
                                "example_id": "8533e523-0ed1-4185-a16e-f2a969acad44",
                                "sense_id": "20955165-75a8-3560-92b8-750b06a2eab0",
                                "text": "„Der Lüftungsmarkt ist ständig in Bewegung.“"
                            },
                            {
                                "example_id": "8ecc458a-89f2-48da-866c-8b267af7ebd3",
                                "sense_id": "20955165-75a8-3560-92b8-750b06a2eab0",
                                "text": "„Der Lüftungsmarkt bietet heute Systeme für jeden Baubestand und Geldbeutel.“"
                            },
                            {
                                "example_id": "a3ffcbc4-36a9-44b1-a0b9-8d7c8af4da4c",
                                "sense_id": "20955165-75a8-3560-92b8-750b06a2eab0",
                                "text": "„Pluggit entwickelt seit über 15 Jahren Produkte für den Lüftungsmarkt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
