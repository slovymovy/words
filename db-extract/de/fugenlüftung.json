                "senses": [
                    {
                        "sense_id": "6aac4d55-b292-31ca-9eb0-1bb98c196854",
                        "entry_id": "e8e93b7a-829a-3768-991b-c8f20fafdd5e",
                        "glosses": [
                            "freie, unkontrollierte Lüftung des Wohnraums, über undichte Stellen im umbauten Raum, insbesondere an Türen, Rollladenkästen, Fenstern, Dachkonstruktionen, Zwischendecken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "833382a7-5895-43a0-a621-521553f81293",
                                "sense_id": "6aac4d55-b292-31ca-9eb0-1bb98c196854",
                                "text": "„Fugenlüftung: Die Lüftung durch Fugen ist nicht kontrollierbar und entspricht in den wenigsten Fällen dem tatsächlichen Lüftungsbedarf.“"
                            },
                            {
                                "example_id": "99193cb4-131d-4e4d-8e4b-a43d1443e4b7",
                                "sense_id": "6aac4d55-b292-31ca-9eb0-1bb98c196854",
                                "text": "„Die Fugenlüftung eines Raumes wird dadurch hervorgerufen, dass Luft durch Undichtheiten in der Gebäudehülle in den Raum eindringt.“"
                            },
                            {
                                "example_id": "34b6e463-85f7-464b-a8a1-95e1f5f159af",
                                "sense_id": "6aac4d55-b292-31ca-9eb0-1bb98c196854",
                                "text": "„Während die Fugenlüftung bis in die 50er und 60er Jahre durch niedrige Energiepreise einerseits und hohe notwendige Luftwechselraten andererseits durchaus zum Luftwechsel beitragen oder diesen komplett sicherstellen konnte, ist aufgrund des hohen Wärmeverlustes und der Gefahr von Feuchteschäden infolge Tauwasserausfalls eine Lüftung über Undichtigkeiten in der Gebäudehülle heutzutage in jedem Fall zu vermeiden.“"
                            },
                            {
                                "example_id": "f567360c-28ac-4612-8792-244b9966bc94",
                                "sense_id": "6aac4d55-b292-31ca-9eb0-1bb98c196854",
                                "text": "„Unter Fugenlüftung versteht man den natürlichen Luftstrom durch Spalten, Löcher und Risse im Baukörper sowie durch undichte Fenster und Türen.“"
                            },
                            {
                                "example_id": "1aa48ecd-fe0d-440e-916e-12a99148eb9f",
                                "sense_id": "6aac4d55-b292-31ca-9eb0-1bb98c196854",
                                "text": "„Ein Grundproblem der Fugenlüftung ist, daß diese je nach Witterungsverhältnissen sehr stark schwankt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9bffdf4d-c9bc-3247-b3e2-2c58e2125c9a",
                        "entry_id": "e8e93b7a-829a-3768-991b-c8f20fafdd5e",
                        "glosses": [
                            "gezielte Fugenbildung (Offenlassung) als Lüftungsfuge bei verklinkerten Häusern zur Hinterlüftung"
                        ],
