                        "form": "anderenorts"
                    },
                    {
                        "form_id": "c43ffb2b-c91a-47ef-9933-c08952080a76",
                        "entry_id": "bd8e86e5-a14f-3fcd-af7e-5eafff1d465e",
                        "tags": [
                            "variant"
                        ],
                        "form": "anderorts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0d10e561-7ce1-3140-9c12-fe1d596d380a",
                        "entry_id": "bd8e86e5-a14f-3fcd-af7e-5eafff1d465e",
                        "glosses": [
                            "an einem anderen Ort, an einer anderen Stelle"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "563d310e-8541-4314-8457-71eb9f744be7",
                                "sense_id": "0d10e561-7ce1-3140-9c12-fe1d596d380a",
                                "text": "„Gezeigt werden Filme, die sich nicht nur mit der deutschen Provinz beschäftigen, sondern auch mit ländlichen Regionen andernorts.“"
                            },
                            {
                                "example_id": "bbcf4ea5-bbec-43d1-bc19-8b577ffc7016",
                                "sense_id": "0d10e561-7ce1-3140-9c12-fe1d596d380a",
                                "text": "„Die Bands, die die Macher der Wunderbar gerne für das Kneipenfestival engagiert hätten, waren schon andernorts gebucht.“"
                            },
                            {
                                "example_id": "b3f8fcd3-98e6-4a18-9836-30936f414126",
                                "sense_id": "0d10e561-7ce1-3140-9c12-fe1d596d380a",
                                "text": "Da wir in Ludwigslust kein Haus fanden, das uns zusagte, haben wir uns schließlich andernorts umgesehen."
                            },
                            {
                                "example_id": "00615442-25bb-46b5-a8cc-5b1257bfc1d9",
                                "sense_id": "0d10e561-7ce1-3140-9c12-fe1d596d380a",
                                "text": "Der Bedarf an Pflegekräften ist andernorts noch größer als hier."
                            },
                            {
                                "example_id": "4491cc3a-618a-41d8-adcb-0dbb5c8ad253",
                                "sense_id": "0d10e561-7ce1-3140-9c12-fe1d596d380a",
                                "text": "„Andernorts gab es deutlich mehr Unruhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad77c40b-8ead-4c00-a2b9-b48756fc3020",
                        "source_entry_id": "bd8e86e5-a14f-3fcd-af7e-5eafff1d465e",
                        "source_sense_id": "0d10e561-7ce1-3140-9c12-fe1d596d380a",
                        "source_sense_description": "an einem anderen Ort, an einer anderen Stelle",
                        "target_lang_word": "elsewhere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elsewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                        "entry_id": "4de48f43-29cc-3386-9221-bc520495bb6d",
                                        "glosses": [
                                            "Synonym of somewhere else: in, at, or to some other place."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7ce151b-7f71-45da-a63a-e7eb39744a62",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "If you won’t serve us, we’ll go elsewhere."
                                            },
                                            {
                                                "example_id": "33d31f54-3b16-4a65-b2bb-930020d3f068",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "These particular trees are not to be found elsewhere."
                                            },
                                            {
                                                "example_id": "def98377-dcc0-4774-b4ef-be7c6c001060",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "Oh, had we some bright little isle of our own, / In a blue summer ocean far off and alone; / [...] / Where simply to feel that we breathe, that we live, / Is worth the best joys that life elsewhere can give."
                                            },
                                            {
                                                "example_id": "e182a7b4-c3f2-44f1-9dc0-ab20c0cb867d",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "He draws eclectically on studies of baboons, descriptive anthropological accounts of hunter-gatherer societies and, in a few cases, the fossil record. With this biological framework in place, Corning endeavors to show that the capitalist system as currently practiced in the United States and elsewhere is manifestly unfair."
                                            },
                                            {
                                                "example_id": "657912fc-f8bc-44a3-b3c8-2896b9273fc3",
                                                "sense_id": "cb0b10f4-8494-3468-9c75-e8afddcb49b0",
                                                "text": "Many monuments sold in the US are crafted from granite produced in China, India and elsewhere overseas, while a lot of stone-working equipment comes from Europe."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "elsewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d21e4194-0c3d-3b82-8146-da9abfe4d551",
                                        "entry_id": "a3870cf0-6f7e-3c96-9222-2f8e0f6afc90",
                                        "glosses": [
                                            "Synonym of somewhere else: a place other than here."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40dbd045-65d0-4034-a60b-3e453ab0c787",
                                                "sense_id": "d21e4194-0c3d-3b82-8146-da9abfe4d551",
                                                "text": "We are back on the Ligurian coast, from which vertigos push human beings toward all kinds of elsewheres."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f51f217d-e2d5-4690-a2a2-6750533d37f4",
                        "source_entry_id": "bd8e86e5-a14f-3fcd-af7e-5eafff1d465e",
                        "source_sense_id": "0d10e561-7ce1-3140-9c12-fe1d596d380a",
                        "source_sense_description": "an einem anderen Ort, an einer anderen Stelle",
                        "target_lang_word": "ailleurs",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ailleurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                        "entry_id": "1dd616d2-c216-316e-93a9-4835872c863d",
                                        "glosses": [
                                            "En un autre lieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fad3c0d9-558d-4b8a-a7c0-aa16e5aa2779",
                                                "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                                "text": "Ailleurs, elles relèvent leur châle sur leur tête, et se trouvent toutes drapées pour un peintre."
                                            },
                                            {
                                                "example_id": "f42b590f-dba2-4363-a1f7-b763e2800a59",
                                                "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                                "text": "Sans cette hantise de retrouver ses assassins, depuis beau jour, Marcoul serait ailleurs. Il aurait obtenu sa mutation."
                                            },
                                            {
                                                "example_id": "8ff062d4-d1c1-46dc-9daa-f38cb1ac20aa",
                                                "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                                "text": "Les fêtes de roses qui se multipliaient, surtout autour de Paris, à Brie-Comte-Robert ou Grisy-Suisnes, en Brie, à Fontenay-aux-Roses, et ailleurs, étaient plus proches de la kermesse que de la mondanité."
                                            },
                                            {
                                                "example_id": "75fe98fb-f106-4209-99d4-75aab65267b7",
                                                "sense_id": "06fc70d4-9d88-31f5-8d2d-e1fc71b80cda",
                                                "text": "— Qu’il s’agisse de sensualité ou d’expériences préconjugales, les supporters traditionnels du poujadisme ont un comportement absolument prévisible, triste et réactionnaire, là comme ailleurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97cf5622-7fa4-3471-94e9-300ed2261e94",
                                        "entry_id": "1dd616d2-c216-316e-93a9-4835872c863d",
                                        "glosses": [
                                            "Dans un autre passage d’un document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1fd18ae-674b-4f90-9b51-fb45142a4847",
                                                "sense_id": "97cf5622-7fa4-3471-94e9-300ed2261e94",
                                                "text": "Nous avons démontré ailleurs que cette hypothèse est peu plausible."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ailleurs",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                        "entry_id": "56c8920d-e5f7-3cc1-a48e-3cf32d67bbb2",
                                        "glosses": [
                                            "Endroit se trouvant autre part."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b235d58-dad8-4c00-9eae-0ce87778922d",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "C’est « l’ailleurs » auquel tu as tant aspiré et sur quoi tu écrivais des pages et des pages redondantes sur tes cahiers secrets d’écolier."
                                            },
                                            {
                                                "example_id": "38492c50-15cf-4d81-a3c1-d3837c236249",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "Dans cet univers en dévers,\n Déshérence en plein cœur de verre,\n Je cherche un chemin de douceur\n Qui mène aux lisières de l’ailleurs."
                                            },
                                            {
                                                "example_id": "02eb83ed-1b3c-4e43-9b5e-56d951324c58",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "[…] la puissante odeur de kérosène qui devient aujourd'hui le parfum des ailleurs […]"
                                            },
                                            {
                                                "example_id": "adf8bbde-0f45-449d-a059-0cfaeb4c0364",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "Que représentaient pour moi notre tramway de banlieue, notre train à impériale ? Les voyages, l’évasion, le rêve, de grands espaces, ces ailleurs mystérieux sortis des romans de Loti."
                                            },
                                            {
                                                "example_id": "b5bf7a1b-f98a-4dbd-87db-10e3a315df71",
                                                "sense_id": "7bad4b19-691e-3526-a483-281065585d7a",
                                                "text": "Il saisit donc les traces de l'événement, il les arrache à l'accidentel, à la contingence, il les transporte dans les ailleurs du mythe"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
