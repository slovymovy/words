                            {
                                "example_id": "f3c99ac8-f11a-400b-aef2-010f4133a0a5",
                                "sense_id": "85977f8c-dd01-31f4-8e23-8d4f87a48926",
                                "text": "Smerigheid, ruimtegebrek, armoe, de vernedering van de mens in de hardwerkende arbeider, de vernedering van de vrouw."
                            },
                            {
                                "example_id": "c26593bc-bc85-4372-813e-ded2a6f0856a",
                                "sense_id": "85977f8c-dd01-31f4-8e23-8d4f87a48926",
                                "text": "Ook het ISO hoopt dat fysiek onderwijs op den duur weer de norm wordt. De Roos: \"Studenten snakken naar fysiek onderwijs. Online onderwijs zou alleen ingezet moeten worden wanneer dat ten dienste staat van de student, de docent en de kwaliteit van het onderwijs. Ruimtegebrek zou dus nooit dé reden moeten zijn om online onderwijs aan te bieden.\""
                            }
                        ]
                    }
