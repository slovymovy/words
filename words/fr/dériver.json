    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f0d9da1-1c94-3947-b8a0-2a17af4a95cd",
                    "sense_definition": "Dévier de sa trajectoire sous l'effet du vent ou du courant aquatique ; flotter sans direction imposée.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sans moteur, la petite barque commença à <w>dériver</w> vers le large."
                        },
                        {
                            "text": "Les marins ont surveillé l'iceberg qui <w>dérivait</w> lentement au fil des vagues."
                        }
                    ],
                    "common_phrases": [
                        "laisser dériver",
                        "dériver vers le large"
                    ]
                },
                {
                    "sense_id": "ff406adf-7abf-36ec-b0d5-9f6c55f5abe6",
                    "sense_definition": "Tirer son origine de quelque chose ; en résulter ou en découler logiquement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "origine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup de difficultés actuelles <w>dérivent</w> d'un simple manque d'organisation."
                        },
                        {
                            "text": "Cette tradition populaire <w>dérive</w> de coutumes agricoles très anciennes."
                        }
                    ],
                    "synonyms": [
                        "découler",
                        "provenir",
                        "résulter"
                    ],
                    "common_phrases": [
                        "dériver de"
                    ]
                },
                {
                    "sense_id": "43a864ce-e33a-3298-988f-86b5b541c17a",
                    "sense_definition": "Détourner un cours d'eau de son lit naturel pour l'orienter ailleurs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "detournement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers ont dû <w>dériver</w> la rivière pour permettre les travaux du pont."
                        },
                        {
                            "text": "En cas de forte crue, ce canal permet de <w>dériver</w> une partie des eaux."
                        }
                    ],
                    "synonyms": [
                        "détourner"
                    ],
                    "common_phrases": [
                        "dériver un cours d'eau",
                        "dériver les eaux"
                    ]
                },
                {
                    "sense_id": "64f8bf75-64ac-30c0-a988-7c5eadc25649",
                    "sense_definition": "Provenir d'un mot de base ou d'une autre langue par un procédé de dérivation linguistique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreux adjectifs français <w>dérivent</w> directement de racines latines."
                        },
                        {
                            "text": "Les spécialistes cherchent à savoir comment ce terme a pu <w>dériver</w> d'un mot grec."
                        }
                    ],
                    "synonyms": [
                        "provenir"
                    ],
                    "common_phrases": [
                        "dériver du latin"
                    ]
                },
                {
                    "sense_id": "f7de95b0-b2ca-3f4a-8f6c-5690e7489723",
                    "sense_definition": "Calculer la fonction dérivée d'une fonction mathématique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur nous a appris comment <w>dériver</w> une fonction exponentielle."
                        },
                        {
                            "text": "Il est facile de <w>dériver</w> une constante car son résultat est toujours zéro."
                        }
                    ],
                    "common_phrases": [
                        "dériver une fonction"
                    ]
                },
                {
                    "sense_id": "06f51dff-3dc5-3232-a813-cf0903b1004a",
                    "sense_definition": "Enlever ou détruire les rivets qui maintiennent un assemblage.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le mécanicien doit <w>dériver</w> la chaîne de la bicyclette afin de la nettoyer."
                        },
                        {
                            "text": "Il a utilisé un outil adapté pour <w>dériver</w> rapidement ces plaques métalliques."
                        }
                    ],
