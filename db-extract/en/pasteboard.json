    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "0be2bc7f-669a-3e78-8dcc-947bff6024cc",
                "word": "pasteboard",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0150b4c2-0baf-38c7-a269-f9527f22d98d",
                        "entry_id": "0be2bc7f-669a-3e78-8dcc-947bff6024cc",
                        "glosses": [
                            "unsubstantial; flimsy"
                        ],
                        "tags": [
                            "figuratively",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e439af53-b595-4d9c-8f91-7f75185cc97c",
                                "sense_id": "0150b4c2-0baf-38c7-a269-f9527f22d98d",
                                "text": "A poor, pasteboard story. The conventional, unattractive heroine is recovering from an illness in Rome. She is discontented and sorry for herself because her planned career as a sports mistress has now to be abandoned."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cf5a7667-beb8-37c8-919a-9dc4d78d9361",
                "word": "pasteboard",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "24638b47-dbdf-4c11-80c9-25a5a70d5bc1",
                        "entry_id": "cf5a7667-beb8-37c8-919a-9dc4d78d9361",
                        "tags": [
                            "plural"
                        ],
                        "form": "pasteboards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "985b24be-f7f0-31c1-b75c-79c0c67fbec9",
                        "entry_id": "cf5a7667-beb8-37c8-919a-9dc4d78d9361",
                        "glosses": [
                            "Card stock."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "adfaa00d-1469-4229-b5e2-e1836c86dcc6",
                                "sense_id": "985b24be-f7f0-31c1-b75c-79c0c67fbec9",
                                "text": "All visible objects, man, are but as pasteboard masks."
                            },
                            {
                                "example_id": "05d8feee-233d-469c-bd41-0a8a54a8698d",
                                "sense_id": "985b24be-f7f0-31c1-b75c-79c0c67fbec9",
                                "text": "He handed Larry two slips of pasteboard, theater tickets, as was evident at first glance."
                            },
                            {
                                "example_id": "29d2fb18-2a46-41c4-aab6-8af063fb5126",
                                "sense_id": "985b24be-f7f0-31c1-b75c-79c0c67fbec9",
                                "text": "To many, a railway ticket is but an uninteresting bit of pasteboard, which must be purchased before a journey is undertaken, and once obtained, may be stowed away in a convenient pocket and forgotten, until a watchful railway official requests its production."
                            }
                        ]
                    },
                    {
                        "sense_id": "6e6425c1-7227-307e-b8f6-7d1d0edb3acb",
                        "entry_id": "cf5a7667-beb8-37c8-919a-9dc4d78d9361",
                        "glosses": [
                            "A widget allowing multiple users to paste and share text or other items."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7d5157d9-1ac8-38e7-aae9-0bc15e26a247",
                        "entry_id": "cf5a7667-beb8-37c8-919a-9dc4d78d9361",
                        "glosses": [
                            "A person's visiting card."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "c8baa973-dbae-4465-b175-71a0c71a62c6",
                                "sense_id": "7d5157d9-1ac8-38e7-aae9-0bc15e26a247",
                                "text": "“We shall only have to leave our pasteboards, Arthur.” He used the word ‘pasteboards,’ having heard it from some of the ingenuous youth of the nobility about town, and as a modern phrase suited to Pen’s tender years."
                            },
                            {
                                "example_id": "887a27b3-096c-422f-9fbb-f040853bebd7",
                                "sense_id": "7d5157d9-1ac8-38e7-aae9-0bc15e26a247",
                                "text": "[…] he no sooner learnt that the British officer in command had sent in his pasteboard, than he instantly returned the visit […]"
                            },
                            {
                                "example_id": "aacce2cc-ca8d-4f6f-9598-8e16a801f391",
                                "sense_id": "7d5157d9-1ac8-38e7-aae9-0bc15e26a247",
                                "text": "Peter called on the Pierces, only to find them out, and as no notice was taken of his pasteboard, he drew his own inference, and did not repeat the visit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6b3b3128-42d3-49ed-b3a5-d7aafede611d",
                        "source_entry_id": "cf5a7667-beb8-37c8-919a-9dc4d78d9361",
                        "source_sense_description": "card stock",
                        "target_lang_word": "Pappkarton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pappkarton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                        "entry_id": "67a52218-4dbb-3011-be3e-863661189e2f",
                                        "glosses": [
                                            "Werkstoff aus einem festeren papierähnlichen Material (= Pappe)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5e2f427-4a63-4038-8b69-010a05368eb4",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "[Fridays for Future:] „Die meisten Teilnehmer sind Jugendliche: zwischen 12 und 17, ein paar Studenten und Grauhaarige sind auch mit dabei. Viele haben aus Pappkartons Schilder gebastelt.“"
                                            },
                                            {
                                                "example_id": "430f8017-7e9b-4315-bd11-cdaf69b75679",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "„Wir zeigen Ihnen, was für tolle Kinderspielzeuge Sie ganz einfach aus Pappkartons basteln können, ganz ohne dafür viel Geld ausgeben zu müssen.“"
                                            },
                                            {
                                                "example_id": "ca5da7f9-8f39-4dfd-9af3-7aaa1e37f7d4",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "„Diese Eltern haben sich so richtig ins Zeug gelegt und ihrem Sohn einen eigenen Kahn aus Pappkarton gebastelt.“"
                                            },
                                            {
                                                "example_id": "a853acc8-17d8-40b8-87fe-617aaa204cac",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "„Übertrage die Regenbogenform achtmal mit Bleistift auf Pappkarton und schneide sie mit dem Cuttermesser auf der Schneideunterlage aus.“"
                                            },
                                            {
                                                "example_id": "0d5b4e9d-8f01-4396-a318-9bf6d985d741",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "„Timo zeigte uns einen alten Ordner. Er war rot und hatte überall Risse, und er war voller alter Bilder, die auf Pappkarton aufgeklebt waren.“"
                                            },
                                            {
                                                "example_id": "568d56b9-f79a-4e46-8fc2-e78fb1f4eb5a",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "„George sah zu, wie ihre Mutter den Kragen aus Pappkarton ausschnitt, ihn um Timmys Hals legte und die Enden mit Klebeband zusammenfügte.“"
                                            },
                                            {
                                                "example_id": "4bcbd860-e035-4e67-8b05-6996e97e1f0b",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "„Wer Glück hat, liegt auf einer Matratze. Andere müssen mit dem blanken Kellerboden vorlieb nehmen, notdürftig mit Pappkartons ausgelegt.“"
                                            },
                                            {
                                                "example_id": "b9550c12-2bea-40ab-ac28-5e6d73c29b42",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "[Wohnungslose in Tokio:] „Mit Pappkartons und blauen Plastikplanen campierten sie in Parks und in der Nähe von U-Bahn-Eingängen oder wurden in eines der Übergangslager für Obdachlose eingewiesen.“"
                                            },
                                            {
                                                "example_id": "cb71a997-b979-478a-8222-09350e7c58db",
                                                "sense_id": "0af96c60-dad9-3091-be39-de7cdb58c89e",
                                                "text": "[Weihnachtsstern (Pflanze):] „Wenn Sie ihn im Haus am Fenster stehen lassen, sollten Sie ihn vor der Mittagssonne schützen. Am besten schieben Sie über Mittag einen Pappkarton zwischen die Pflanze und die Fensterscheibe, falls die Sonne brennt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                        "entry_id": "67a52218-4dbb-3011-be3e-863661189e2f",
                                        "glosses": [
                                            "Behälter aus Pappe, der (meist) zum Aufbewahren zusammengelegt ist und zum Benutzen aufgestellt/aufgefaltet werden muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9295719c-84c9-4214-8465-bb3ac79a3f63",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "Im Keller stehen Kisten und Pappkartons."
                                            },
                                            {
                                                "example_id": "6be90db2-d307-4a3e-9dd2-fb6ca41dc906",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "Wenn ich ein Paket mit der Post verschicken will, besorge ich mir einen Pappkarton."
                                            },
                                            {
                                                "example_id": "e67073f6-eca7-4eb7-bfed-4a18d6ee8510",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "Pappkartons kann man gut mit Klebeband verschließen."
                                            },
                                            {
                                                "example_id": "9a5c17de-8e11-4e34-a5f2-d29d11cbb342",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "„In einer Ecke stehen, noch in Pappkartons verpackt, die Küchengeräte.“"
                                            },
                                            {
                                                "example_id": "d07e0235-7354-4e56-8275-e1b9a7687585",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "„Wenn von Abfall die Rede ist, denken viele Menschen“ […] „an den Pappkarton, in dem der neue Laptop geliefert wird“ […]."
                                            },
                                            {
                                                "example_id": "b8984e7c-79d0-4aeb-ae42-5bdbfa4ef03e",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "„»Oft landen die Pappkartons – so wie sie sind – in der Papiertonne, ohne zerrissen oder zusammengefaltet zu werden«, teilte der VKU mit.“"
                                            },
                                            {
                                                "example_id": "a6dc4ed8-ca38-4e19-8271-731fcf1bc074",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "„Er verpackt zusammen mit einigen seiner Mitarbeiter die Gourmet-Hotdogs in Pappkartons und kritzelt ein \"Dankeschön\" auf die Verpackung.“"
                                            },
                                            {
                                                "example_id": "03edb28e-7944-4539-b9c0-7f4014773027",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "„Zwei Monate später fand man in Jakarta die Leiche eines neunjährigen Mädchens in einem Pappkarton am Straßenrand.“"
                                            },
                                            {
                                                "example_id": "de792025-811d-4be6-8629-74fb6c2fefc9",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "[Truman Copotes erster Roman von 1943:] „Ende 2004 wurde in einem alten Pappkarton bei Sotheby’s in New York ein vollständiges Manuskript abgegeben: Summer Crossing – Sommerdiebe.“"
                                            },
                                            {
                                                "example_id": "b0f06c3e-93b7-486a-b1ab-b8d6e05da5ad",
                                                "sense_id": "480a2ca1-2659-30b6-ae18-32e7bce67794",
                                                "text": "„Denken Sie mal zurück an die Zeit, als Sie fünf Jahre alt waren, und stellen Sie sich vor, jemand hätte Ihnen da einen Pappkarton gegeben. Was wäre das Erste, was Sie getan hätten? Richtig! Sie wären hineingeklettert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46b87b0d-c011-41c1-97ff-04cd44ab2224",
                        "source_entry_id": "cf5a7667-beb8-37c8-919a-9dc4d78d9361",
                        "source_sense_description": "card stock",
                        "target_lang_word": "Karton",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karton",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f3df906d-3c91-3344-9f22-2b9f2e8ad186",
                                        "entry_id": "df5181b7-6474-359f-b62d-977db1f0bc83",
                                        "glosses": [
                                            "festeres, papierähnliches Produkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "852a337f-01fa-4386-b993-483055ca4b9b",
                                                "sense_id": "f3df906d-3c91-3344-9f22-2b9f2e8ad186",
                                                "text": "Die Schachtel ist aus Karton."
                                            },
                                            {
                                                "example_id": "690bb2dd-e839-4375-9e02-b25004f6326d",
                                                "sense_id": "f3df906d-3c91-3344-9f22-2b9f2e8ad186",
                                                "text": "„Sie sah nur bemalte Kartons und merkwürdig herausgeputzte Männer und Frauen, die in einer merkwürdig grellen Beleuchtung merkwürdige Bewegungen machten, redeten und sangen.“"
                                            },
                                            {
                                                "example_id": "7e8c00a4-b028-435c-a689-ce5085ff4702",
                                                "sense_id": "f3df906d-3c91-3344-9f22-2b9f2e8ad186",
                                                "text": "„Als sich die Gruppe im Raum verteilte, um gewisse Maße auf einen Karton zu übertragen, nahm Robert den Freund beiseite.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                        "entry_id": "df5181b7-6474-359f-b62d-977db1f0bc83",
                                        "glosses": [
                                            "dünner, rechteckiger Behälter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d68cc9c-bca9-4722-b0c5-330d816c1319",
                                                "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                                "text": "Er verpackt das Geschenk in einen Karton."
                                            },
                                            {
                                                "example_id": "fc72856a-3ed7-4327-a626-5db8c5651e1c",
                                                "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                                "text": "„Ihr folgte gleich darauf mit einem großen Karton eine Frau wie ein Zeisig.“"
                                            },
                                            {
                                                "example_id": "6953825d-8e07-46e8-8a03-eaf0efc600d2",
                                                "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                                "text": "„Im kleinen Hinterzimmer packte ein junges Mädchen gerade einen Karton mit Zeitschriften aus.“"
                                            },
                                            {
                                                "example_id": "9e18fe2b-4108-48d8-9b9d-56bc9d7064f8",
                                                "sense_id": "1f37f473-3071-3838-b640-3d6b6cac5dc5",
                                                "text": "„Ihr Blick fiel auf die Kartons hinten im Kofferraum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
