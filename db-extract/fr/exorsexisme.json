                            "Très rare"
                        ],
                        "examples": [
                            {
                                "example_id": "da8d6cf8-6656-499f-ab22-2b9a69cdb654",
                                "sense_id": "8e61bb5a-528b-32c7-ab44-064bb3b7ee09",
                                "text": "N'utilisez pas d'insultes ou de propos homophobes, transphobes (y compris l’exorsexisme), aphobes ou biphobes, même s'ils ne visent personne en particulier."
                            }
                        ]
