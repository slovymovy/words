                                                "example_id": "4137efbb-32ad-45e3-b593-5febc3889d20",
                                                "sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                                                "text": "Dorota jest najpiękniejszą dziewczyną na świecie."
                                            },
                                            {
                                                "example_id": "291c7221-5385-47ce-98ac-48c31dbb9ea0",
                                                "sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                                                "text": "Pod koniec średniowiecza w Szwecji św. Dorotę dodano jako piętnastą do grona Czternastu Świętych Wspomożycieli"
                                            },
                                            {
                                                "example_id": "45fff4a8-e549-4163-af18-46a2e0bd3540",
                                                "sense_id": "767bf964-59ea-3cac-9bdf-81f42bc8387f",
                                                "text": "Córka skarży się na zachowanie wychowawczyni, pani Doroty i jej męża."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
