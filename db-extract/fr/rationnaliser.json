                "senses": [
                    {
                        "sense_id": "e54d5f04-7db0-350d-a994-4c4e5b1b256f",
                        "entry_id": "d2b69810-a030-3608-b70d-6d0e310a7d3a",
                        "glosses": [
                            "Variante orthographique de rationaliser (donner un caractère rationnel à)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a904ec89-47c9-40a1-a0f8-c3e0aa336fc1",
                                "sense_id": "e54d5f04-7db0-350d-a994-4c4e5b1b256f",
                                "text": "La force de Sass est d’introduire de nouveaux concepts pour rationnaliser l’écriture des feuilles de styles."
                            },
                            {
                                "example_id": "bb2093a3-927a-457d-823f-22ae28c27690",
                                "sense_id": "e54d5f04-7db0-350d-a994-4c4e5b1b256f",
                                "text": "Lorsqu’on désire le domestiquer et le rationnaliser, il doit obéir à un certain nombre de règles qui en constituent le fondement rationnel."
                            },
                            {
                                "example_id": "71a70cc9-b03f-4256-b93b-0aa7a6ebc9f3",
                                "sense_id": "e54d5f04-7db0-350d-a994-4c4e5b1b256f",
                                "text": "Cela peut rappeler le cartésianisme français ou le fameux plan de Sciences-Po, mais cela aide à rationnaliser une question."
                            }
                        ]
                    }
