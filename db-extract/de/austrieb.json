                ],
                "senses": [
                    {
                        "sense_id": "fbf89719-54ea-3494-b48e-1d3eadcfb815",
                        "entry_id": "354e63fe-0c06-3265-9346-9ca3859547eb",
                        "glosses": [
                            "das Hinaustreiben des Weideviehs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcbbf22e-98f6-4ebd-89c8-2e4dce87bb03",
                                "sense_id": "fbf89719-54ea-3494-b48e-1d3eadcfb815",
                                "text": "„Endlich nahte der langersehnte Tag, an dem der erste Austrieb des Viehes stattfand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85167bd0-679c-397c-bcea-e8ad31822348",
                        "entry_id": "354e63fe-0c06-3265-9346-9ca3859547eb",
                        "glosses": [
                            "das Hervorkommen neuer Triebe einer Pflanze; neu gewachsener Spross"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5545dc52-2bd7-4aa0-863b-1b236cbe87fa",
                                "sense_id": "85167bd0-679c-397c-bcea-e8ad31822348",
                                "text": "„Ein früherer Schnitt hätte einen verfrühten Austrieb zur Folge, der dann durch einen auftretenden Frost geschädigt werden kann.“"
                            },
                            {
                                "example_id": "99ccd4b3-f18f-40c2-8199-2039e2fa0801",
                                "sense_id": "85167bd0-679c-397c-bcea-e8ad31822348",
                                "text": "„Stauden haben inzwischen vollständig eingezogen, und die Reservestoffe für den nächsten Austrieb sind in den Überdauerungsorganen eingelagert.“"
                            },
                            {
                                "example_id": "44ac9b7e-0614-437a-b510-7f84973d74e6",
                                "sense_id": "85167bd0-679c-397c-bcea-e8ad31822348",
                                "text": "„Um einen gleichmäßigen Austrieb über die gesamte Fruchtrute zu erhalten, wird diese bei den meisten Erziehungsarten in die Waagrechte gebunden.“"
                            },
                            {
                                "example_id": "5373c140-deb9-483f-b3f2-8140b1c186ed",
                                "sense_id": "85167bd0-679c-397c-bcea-e8ad31822348",
                                "text": "„Die Austriebe bleiben weißlich bis hellgelb und sind so ein gesundes, nur leicht bitteres Wintergemüse.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
