                    ],
                    "synonyms": [
                        "tirer",
                        "puiser"
                    ],
                    "common_phrases": [
                        "extraire un passage",
                        "extraire une citation"
                    ]
                },
                {
                    "sense_id": "3ebbdf91-27b8-3612-b5a6-b31a5e83b2e4",
                    "sense_definition": "Calculer la valeur d'une racine d'un nombre donné.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematiques",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur explique aux élèves la méthode pour <w>extraire</w> une racine carrée à la main."
                        },
                        {
                            "text": "Ce programme mathématique permet d'<w>extraire</w> rapidement la racine cubique d'un grand nombre."
                        }
                    ],
                    "common_phrases": [
