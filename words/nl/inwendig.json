                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "internal",
                                "target_lang_sense_clarification": "situated on the inside of the body or a mechanism"
                            },
                            {
                                "target_lang_word": "inner",
                                "target_lang_sense_clarification": "located farther within or inside something"
                            },
                            {
                                "target_lang_word": "inside",
                                "target_lang_sense_clarification": "pertaining to the interior part"
