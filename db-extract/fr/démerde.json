        "fr-extract.jsonl": [
            {
                "entry_id": "e7c31166-95bb-32f3-81bc-77ddcae1d500",
                "word": "démerde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cd9487ac-74fe-4425-bd83-3c649ff24146",
                        "entry_id": "e7c31166-95bb-32f3-81bc-77ddcae1d500",
                        "tags": [
                            "plural"
                        ],
                        "form": "démerdes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0931caa6-5b2c-33b5-869d-e766970b9efe",
                        "entry_id": "e7c31166-95bb-32f3-81bc-77ddcae1d500",
                        "glosses": [
                            "Ensemble de savoir-faire et d’astuces permettant de se tirer de situations délicates."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1d99ab70-68f2-4c97-afbd-3b33642d9ac4",
                                "sense_id": "0931caa6-5b2c-33b5-869d-e766970b9efe",
                                "text": "C'est la démerde individuelle, tout le monde fait ses petites expériences sans rien dire à personne. Ça marche ou ça marche pas, si ça marche, tu continues."
                            },
                            {
                                "example_id": "8cdcdc37-c3e7-416a-b6c0-7b0c1c45ee65",
                                "sense_id": "0931caa6-5b2c-33b5-869d-e766970b9efe",
                                "text": "Au camp, on la sautait, c’est vrai, mais il y avait la démerde."
                            }
                        ]
                    },
                    {
                        "sense_id": "d95aedd6-d1f3-3eb3-8ceb-c637ecde30b8",
                        "entry_id": "e7c31166-95bb-32f3-81bc-77ddcae1d500",
                        "glosses": [
                            "Utilisé pour former des surnoms dans le milieu."
                        ],
                        "tags": [
                            "especially",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "980bc64f-c7c6-499a-880c-6873cee559f8",
                                "sense_id": "d95aedd6-d1f3-3eb3-8ceb-c637ecde30b8",
                                "text": "Jojo-la-démerde."
                            }
                        ]
                    },
                    {
                        "sense_id": "3abf008a-f6a7-3a16-96c3-75fb72d64659",
                        "entry_id": "e7c31166-95bb-32f3-81bc-77ddcae1d500",
                        "glosses": [
                            "Ensemble d’astuces et combines en marge de la loi."
                        ],
                        "tags": [
                            "colloquial",
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "478cc4e7-57de-4540-9e7d-1e4645879585",
                                "sense_id": "3abf008a-f6a7-3a16-96c3-75fb72d64659",
                                "text": "Chez lui comme chez nous, il n’y a que la démerde et la combine qui soient vraiment efficaces."
                            }
                        ]
                    }
                ],
