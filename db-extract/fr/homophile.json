                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "15f3ea53-3522-3525-bfc3-733e69c642fd",
                                        "entry_id": "de106a94-0775-35ba-8682-25628ba51675",
                                        "glosses": [
                                            "A homosexual, a gay man or lesbian, one who has a sexual or romantic preference for persons of the same gender; used to emphasize love over sex."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8aea529-a96c-4161-aed6-5603f1fd8154",
                                                "sense_id": "15f3ea53-3522-3525-bfc3-733e69c642fd",
                                                "text": "‘You see that dashing young homophile stood over there? The one with the highly commendable bone structure?’"
                                            }
                                        ]
                                    }
                                ]
                            }
