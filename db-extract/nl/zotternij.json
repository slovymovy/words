                        "examples": [
                            {
                                "example_id": "b7149be1-98e1-4118-a1b9-90a386ab0794",
                                "sense_id": "7d08d29c-08dc-35b7-847d-32734d10fc2d",
                                "text": "Protestanten kunnen zich er natuurlijk over verbazen en opwinden. Verbazen om de zotternij, opwinden om het on-Bijbelse bijgeloof."
                            },
                            {
                                "example_id": "acf1a560-edb6-477d-b479-679ae92d480d",
                                "sense_id": "7d08d29c-08dc-35b7-847d-32734d10fc2d",
                                "text": "De vorming van een Vlaamse regering hoeft niet te wachten op de federale regeringsvorming, ‘zolang daar geen zotternijen gebeuren’. Dat vindt Jan Jambon (N-VA). Een federale regering die geen meerderheid in Vlaanderen heeft, is zo’n zotternij."
                            }
                        ]
                    }
