                "senses": [
                    {
                        "sense_id": "00ba7bf5-7ad1-32bd-847f-3e1db58b164b",
                        "entry_id": "b1b81448-59cc-3b24-8bd4-394704349a28",
                        "glosses": [
                            "To hem and haw."
                        ],
                        "tags": [
                            "British"
                        ],
                        "examples": [
                            {
                                "example_id": "75cdc828-a42c-4e5e-9602-8f03f7e078ca",
                                "sense_id": "00ba7bf5-7ad1-32bd-847f-3e1db58b164b",
                                "text": "This didn't seem at all unlikely, but when I none the less havered, he insisted that his 'Egyptian fortune-teller' had confirmed it."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca3d15cb-2bd4-3c7f-b871-b1980c4d1b18",
                        "entry_id": "b1b81448-59cc-3b24-8bd4-394704349a28",
                        "glosses": [
                            "To talk foolishly; to chatter."
                        ],
                        "tags": [
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "834a7f98-f4c1-4dd5-9e93-2d70fcef7172",
                                "sense_id": "ca3d15cb-2bd4-3c7f-b871-b1980c4d1b18",
                                "text": "To business, and no more havers."
                            },
                            {
                                "example_id": "193fa057-f46b-46cc-ba4a-20679cc4c45a",
                                "sense_id": "ca3d15cb-2bd4-3c7f-b871-b1980c4d1b18",
                                "text": "And if I haver,\n Yeah I know I’m gonna be,\n I’m gonna be the man\n Who’s haverin' to you."
                            },
                            {
                                "example_id": "61373601-c289-41f5-aa1b-d60932a1d876",
                                "sense_id": "ca3d15cb-2bd4-3c7f-b871-b1980c4d1b18",
                                "text": "She havers on about her \"faither\" and \"mirra\" and the \"wee wean,\" her child, and \"hoo i wiz glaiket but bonny forby.\""
                            }
                        ]
                    }
