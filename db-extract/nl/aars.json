                                "target_senses": [
                                    {
                                        "sense_id": "4530c8e3-b315-3f0f-b8ee-b853d945d584",
                                        "entry_id": "2f23fe99-14ff-30dc-bc1a-0aedba25bb42",
                                        "glosses": [
                                            "The buttocks or more specifically, the anus."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2e2e997-9f72-4aaa-ac88-2fc1eb8c3d12",
                                                "sense_id": "4530c8e3-b315-3f0f-b8ee-b853d945d584",
                                                "text": "As the novel progresses, he is shot in the hand with his own gun, shot in the arse with someone else's and lacerated by a prosthetic weed trimmer."
                                            },
                                            {
                                                "example_id": "2a7d7a4f-bcc2-46b5-aa48-47da9fd4e455",
                                                "sense_id": "4530c8e3-b315-3f0f-b8ee-b853d945d584",
                                                "text": "No one, then or now, wanted to drink the mead that came out of Odin's arse."
                                            },
                                            {
                                                "example_id": "b23ed383-5cb8-4c9a-8b1d-14a8bedd394b",
                                                "sense_id": "4530c8e3-b315-3f0f-b8ee-b853d945d584",
                                                "text": "Or to put it in the more colourful language of our Prime Minister: \"The secret to improving rail transport, in my view, is you need to find the right arse to kick.\" Unfortunately, since the abolition of the Strategic Rail Authority (SRA) in 2005, the DfT has ostensibly been in direct control of railway policy setting, and this has meant that the only arse the government has been able to kick is its own."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44e6fe63-e2f2-35bd-ab96-d79c17661c70",
                                        "entry_id": "2f23fe99-14ff-30dc-bc1a-0aedba25bb42",
                                        "glosses": [
                                            "A stupid, pompous, arrogant, mean or despicable person."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b643c5-a91b-41a0-9871-c5bfc15039fa",
                                                "sense_id": "44e6fe63-e2f2-35bd-ab96-d79c17661c70",
                                                "text": "“You're an arse,” Ellen said. ¶ “Please? You must like something about me …?” ¶ “I do. You're an arse. I just told you that. I feel comfy with you, because you're such an arse.”"
                                            },
                                            {
                                                "example_id": "838aa5f6-0341-4be1-978c-4d983ff4347d",
                                                "sense_id": "44e6fe63-e2f2-35bd-ab96-d79c17661c70",
                                                "text": "He looked at me, was just about to call me an arse, when I told him, “You throw it too hard. Try and think of the javelin hitting the target before you throw it. Let it all go through your mind first, see it, feel it, then throw it.” ¶ “Good advice, you arse,” he said and tried again."
                                            },
                                            {
                                                "example_id": "7042be83-9930-499c-9189-59ea9d004dd2",
                                                "sense_id": "44e6fe63-e2f2-35bd-ab96-d79c17661c70",
                                                "text": "Felnigg. What a suppurating arse. Look at him. Arse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40def15a-9798-383d-a59c-d98ce30885c0",
                                        "entry_id": "2f23fe99-14ff-30dc-bc1a-0aedba25bb42",
                                        "glosses": [
                                            "Used in similes to express something bad or unpleasant."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b451f9f2-3af8-355a-9069-8bb1dde17c70",
                                        "entry_id": "2f23fe99-14ff-30dc-bc1a-0aedba25bb42",
                                        "glosses": [
                                            "A person; the self; (reflexively) oneself or one's person, chiefly their body; (by extension) one's personal safety, or figuratively one's job, prospects, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "metonymically",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "arse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                        "entry_id": "df8a9a47-e0a4-3fa2-92b8-e177198b6348",
                                        "glosses": [
                                            "To be silly, act stupid or mess around."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7372d73b-acb9-4e43-b02c-97ba9fef84cb",
                                                "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                                "text": "Stop arsing around!"
                                            },
                                            {
                                                "example_id": "73c62d3d-1428-44cc-90b0-95c44bc77e51",
                                                "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                                "text": "He was university material, just arsing about as a rigger, arsing about, killing time with bohunks like me[…]."
                                            },
                                            {
                                                "example_id": "0e7bf93e-60ca-4e11-ad39-83c6b1bad774",
                                                "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                                "text": "Pi, upset, roars, \"Quit arsing around there and get cracking,\" and a dozen heads turn their way."
                                            },
                                            {
                                                "example_id": "cc706419-e5d6-4706-a073-5a6caad639f6",
                                                "sense_id": "7d82ee28-e162-39a3-82da-d668f96d5e07",
                                                "text": "He was half-expecting a call from the lingua, telling him to stop arsing around, but his com stayed silent, so it looked like a certain amount of arsing around was allowed."
                                            }
                                        ]
                                    }
                                ]
                            },
