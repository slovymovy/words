                "senses": [
                    {
                        "sense_id": "cb36b244-c0aa-346b-9a1c-1cf855b04224",
                        "entry_id": "78d7286a-114c-3e86-a87a-c84b86c753e2",
                        "glosses": [
                            "Fachmann für die Betreuung von Einzelpersonen, Gruppen und Familien in problematischen Lebenssituationen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2fd02e4-9228-443b-8245-f71de9863452",
                                "sense_id": "cb36b244-c0aa-346b-9a1c-1cf855b04224",
                                "text": "„Allerdings fehlten ihr schon damals zwei Sozialpädagogen für eine weitere Gruppe.“"
                            },
                            {
                                "example_id": "5f195612-adb9-4c73-8fd3-669a9215e8d3",
                                "sense_id": "cb36b244-c0aa-346b-9a1c-1cf855b04224",
                                "text": "„1965 trat Bösz als Erzieher für männliche Jugendliche in den Dienst der Stadt Wien ein und arbeitete sodann als Sozialpädagoge in den Lehrlingsheimen ‚Leopoldstadt‘ und ‚Augarten‘.“"
                            },
                            {
                                "example_id": "b0b4fb1f-a8ae-4fa3-80a6-88c12e4f4cc5",
                                "sense_id": "cb36b244-c0aa-346b-9a1c-1cf855b04224",
                                "text": "„Vor vier Jahren hängte der gelernte Sozialpädagoge seinen Beruf als Jugendpfleger an den Nagel, um sich ganz dem Extremsport zu widmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
