{
    "word_family": [
        "rollerblade",
        "switchblade",
        "bladed",
        "razorblade"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7308512c-44e2-30cc-b0ca-c5c7d738f290",
                    "sense_definition": "The flat, sharp cutting part of a knife, sword, razor, or other tool.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cutting_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful when washing the knife because the <w>blade</w> is very sharp.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, когда моешь нож, потому что <w>лезвие</w> очень острое.",
                                "zh": "洗刀时要小心，因为<w>刀刃</w>非常锋利。"
                            }
                        },
                        {
                            "text": "He replaced the dull razor <w>blade</w> with a new one before shaving.",
                            "target_lang_translations": {
                                "ru": "Перед бритьем он заменил тупое <w>лезвие</w> бритвы на новое.",
                                "zh": "刮胡子前，他把钝了的剃须<w>刀片</w>换成了新的。"
                            }
                        }
                    ],
                    "antonyms": [
                        "handle"
                    ],
                    "common_phrases": [
                        "razor blade",
                        "knife blade",
                        "sharp blade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская острая режущая часть ножа, меча, бритвы или другого инструмента.",
                        "zh": "刀、剑、剃须刀或其他工具上扁平且锋利的切割部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лезвие",
                                "target_lang_sense_clarification": "острая кромка"
                            },
                            {
                                "target_lang_word": "клинок",
                                "target_lang_sense_clarification": "металлическая часть оружия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刀刃",
                                "target_lang_sense_clarification": "刀具的锋利部分"
                            },
                            {
                                "target_lang_word": "刀片",
                                "target_lang_sense_clarification": "剃须刀等工具的薄片"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "20159746-0475-3f02-8990-03e52e0bf286",
                    "sense_definition": "A single, narrow, flat leaf of grass or a similar plant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat in the park and plucked a <w>blade</w> of grass to chew on.",
                            "target_lang_translations": {
                                "ru": "Она сидела в парке и сорвала <w>травинку</w>, чтобы пожевать.",
                                "zh": "她坐在公园里，随手拔了一片<w>草叶</w>放在嘴里嚼。"
                            }
                        },
                        {
                            "text": "The drought was so severe that not a single <w>blade</w> of green grass remained.",
                            "target_lang_translations": {
                                "ru": "Засуха была такой сильной, что не осталось ни одной зеленой <w>травинки</w>.",
                                "zh": "旱情非常严重，连一片绿色的<w>草叶</w>都没剩下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blade of grass"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный узкий плоский лист травы или похожего растения.",
                        "zh": "草或其他类似植物的单片狭长叶子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травинка",
                                "target_lang_sense_clarification": "лист травы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "草叶",
                                "target_lang_sense_clarification": "单片草"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "035b4af6-a37c-3eac-9eab-37927aec21b5",
                    "sense_definition": "The flat, wide part of an object that pushes against air or water, such as on an oar, propeller, or fan.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flat_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The helicopter <w>blades</w> began to spin faster as the engine started.",
                            "target_lang_translations": {
                                "ru": "<w>Лопасти</w> вертолета начали вращаться быстрее, когда запустился двигатель.",
                                "zh": "引擎启动后，直升机的<w>旋翼</w>开始加速旋转。"
                            }
                        },
                        {
                            "text": "He dipped the <w>blade</w> of the oar into the water to turn the boat.",
                            "target_lang_translations": {
                                "ru": "Он погрузил <w>лопасть</w> весла в воду, чтобы повернуть лодку.",
                                "zh": "他把<w>桨叶</w>伸进水里，以便让船转向。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wiper blade",
                        "rotor blade",
                        "fan blade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская широкая часть предмета, которая отталкивается от воздуха или воды (например, у весла, пропеллера или вентилятора).",
                        "zh": "物体上用于推动空气或水的扁平宽阔部分，如桨、螺旋桨或风扇的叶片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопасть",
                                "target_lang_sense_clarification": "часть винта или весла"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "叶片",
                                "target_lang_sense_clarification": "风扇或螺旋桨的部件"
                            },
                            {
                                "target_lang_word": "桨叶",
                                "target_lang_sense_clarification": "桨的扁平部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e4a75def-b029-335a-8882-cdd265e827b5",
                    "sense_definition": "A flat bone in the upper back, specifically the shoulder blade.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sharp pain near her right shoulder <w>blade</w> after lifting the heavy box.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала острую боль возле правой <w>лопатки</w>, подняв тяжелую коробку.",
                                "zh": "搬完重箱子后，她感到右侧<w>肩胛骨</w>附近一阵剧痛。"
                            }
                        },
                        {
                            "text": "The doctor examined the area around his shoulder <w>blade</w> for any signs of injury.",
                            "target_lang_translations": {
                                "ru": "Врач осмотрел область вокруг его <w>лопатки</w> на предмет признаков травмы.",
                                "zh": "医生检查了他<w>肩胛骨</w>周围的区域，看是否有受伤的迹象。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoulder blade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская кость в верхней части спины (лопатка).",
                        "zh": "上背部的扁平骨头，即肩胛骨。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лопатка",
                                "target_lang_sense_clarification": "кость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "肩胛骨",
                                "target_lang_sense_clarification": "人体解剖部位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "74f5f545-76a6-3589-8e3d-9ba29ca63d42",
                    "sense_definition": "A compact computer server designed to slide into a chassis to save space.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The IT department installed a new rack of <w>blades</w> to handle the increased data traffic.",
                            "target_lang_translations": {
                                "ru": "IT-отдел установил новую стойку с <w>блейд-серверами</w>, чтобы справиться с возросшим трафиком данных.",
                                "zh": "IT部门安装了一组新的<w>刀片服务器</w>，以应对增加的数据流量。"
                            }
                        },
                        {
                            "text": "A <w>blade</w> server is often more energy-efficient than a traditional rack server.",
                            "target_lang_translations": {
                                "ru": "<w>Блейд-сервер</w> часто более энергоэффективен, чем традиционный стоечный сервер.",
                                "zh": "<w>刀片服务器</w>通常比传统的机架式服务器更节能。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "blade server"
                    ],
                    "target_lang_definitions": {
                        "ru": "Компактный компьютерный сервер, предназначенный для установки в общее шасси.",
                        "zh": "一种设计用于滑入机箱以节省空间的紧凑型计算机服务器。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "блейд-сервер",
                                "target_lang_sense_clarification": "компьютер"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刀片服务器",
                                "target_lang_sense_clarification": "计算机硬件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c76da12-cab5-39fb-a8e5-236158804df9",
                    "sense_definition": "A sword or knife, often used in literary or poetic contexts.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "cutting_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The knight drew his <w>blade</w> and prepared to defend the castle.",
                            "target_lang_translations": {
                                "ru": "Рыцарь обнажил свой <w>клинок</w> и приготовился защищать замок.",
                                "zh": "骑士拔出<w>利刃</w>，准备保卫城堡。"
                            }
                        },
                        {
                            "text": "Legends say that only the true king could pull the <w>blade</w> from the stone.",
                            "target_lang_translations": {
                                "ru": "Легенды гласят, что только истинный король мог вытащить <w>меч</w> из камня.",
                                "zh": "传说只有真正的国王才能将那把<w>宝剑</w>从石头中拔出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "knifeblade"
                    ],
                    "target_lang_definitions": {
                        "ru": "Меч или нож, часто используется в литературном или поэтическом контексте.",
                        "zh": "剑或刀，常用于文学或诗意语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "клинок",
                                "target_lang_sense_clarification": "оружие (поэт.)"
                            },
                            {
                                "target_lang_word": "меч",
                                "target_lang_sense_clarification": "оружие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利刃",
                                "target_lang_sense_clarification": "文学用语"
                            },
                            {
                                "target_lang_word": "宝剑",
                                "target_lang_sense_clarification": "武器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48498b4b-7dc6-336b-a6d5-103578f7cdc0",
                    "sense_definition": "A dashing, energetic young man.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>blades</w> of the town gathered at the tavern to boast about their adventures.",
                            "target_lang_translations": {
                                "ru": "Молодые <w>гуляки</w> города собрались в таверне, чтобы похвастаться своими приключениями.",
                                "zh": "城里的年轻<w>浪子</w>们聚在酒馆里，吹嘘着他们的冒险经历。"
                            }
                        },
                        {
                            "text": "He was known as quite a <w>blade</w> in his youth, always chasing excitement.",
                            "target_lang_translations": {
                                "ru": "В молодости он слыл отчаянным <w>удальцом</w>, всегда ищущим острых ощущений.",
                                "zh": "他年轻时是个出了名的<w>浪子</w>，总是追求刺激。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лихой, энергичный молодой человек (устаревшее).",
                        "zh": "精力充沛、风流倜傥的年轻人（旧用法）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гуляка",
                                "target_lang_sense_clarification": "человек (устар.)"
                            },
                            {
                                "target_lang_word": "удалец",
                                "target_lang_sense_clarification": "человек (устар.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浪子",
                                "target_lang_sense_clarification": "旧时称呼"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c3ddb732-3973-392d-85f1-35008caa8b0f",
                    "sense_definition": "To skate using rollerblades (inline skates).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We went <w>blading</w> along the beach path yesterday afternoon.",
                            "target_lang_translations": {
                                "ru": "Вчера днем мы ходили <w>кататься на роликах</w> по пляжной дорожке.",
                                "zh": "昨天下午我们沿着海滩小路去<w>滑旱冰</w>了。"
                            }
                        },
                        {
                            "text": "He loves <w>blading</w> in the park whenever the weather is nice.",
                            "target_lang_translations": {
                                "ru": "Он любит <w>кататься на роликах</w> в парке, когда погода хорошая.",
                                "zh": "只要天气好，他就喜欢去公园<w>滑旱冰</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go blading"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кататься на роликовых коньках.",
                        "zh": "穿轮滑鞋滑行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кататься на роликах",
                                "target_lang_sense_clarification": "спорт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滑旱冰",
                                "target_lang_sense_clarification": "运动"
                            },
                            {
                                "target_lang_word": "溜旱冰",
                                "target_lang_sense_clarification": "运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a44e8b6-d943-3956-a8eb-3536a50b88e1",
                    "sense_definition": "To stab someone with a sharp weapon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness reported that the victim was <w>bladed</w> during the street fight.",
                            "target_lang_translations": {
                                "ru": "Свидетель сообщил, что жертву <w>пырнули ножом</w> во время уличной драки.",
                                "zh": "目击者称，受害者在街头斗殴中被<w>刺伤</w>了。"
                            }
                        },
                        {
                            "text": "He was afraid of getting <w>bladed</w> if he walked through that alley at night.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что его <w>порежут</w>, если он пойдет через этот переулок ночью.",
                                "zh": "他担心晚上走那条小巷会被人<w>刺伤</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить кого-то острым оружием, пырнуть ножом.",
                        "zh": "用利器刺伤某人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пырнуть ножом",
                                "target_lang_sense_clarification": "насилие"
                            },
                            {
                                "target_lang_word": "порезать",
                                "target_lang_sense_clarification": "нанести рану"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "刺伤",
                                "target_lang_sense_clarification": "暴力行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}