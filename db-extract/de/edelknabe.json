                                    },
                                    {
                                        "sense_id": "0aa50db5-2c33-35d1-babc-1aeaedae04a3",
                                        "entry_id": "b5de11c7-e829-3b70-895c-e20d5ca75aff",
                                        "glosses": [
                                            "A male attendant on a great personage."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b29277c-2527-3211-a981-dc22d8cdc388",
                                        "entry_id": "b5de11c7-e829-3b70-895c-e20d5ca75aff",
                                        "glosses": [
                                            "A landowner from the English gentry during the early modern period."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "59836792-c1af-3060-8b3d-0417d2c71f3c",
                                        "entry_id": "b5de11c7-e829-3b70-895c-e20d5ca75aff",
                                        "glosses": [
                                            "A devoted attendant or follower of a lady; a beau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a072a938-8b96-3869-a8a4-6a76793dc00b",
                                        "entry_id": "b5de11c7-e829-3b70-895c-e20d5ca75aff",
                                        "glosses": [
                                            "A title of office and courtesy. See under esquire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "31d14ec8-815e-37bd-b82e-cd256cfbeb41",
                                        "entry_id": "b5de11c7-e829-3b70-895c-e20d5ca75aff",
                                        "glosses": [
                                            "Term of address to a male equal."
                                        ],
                                        "tags": [
                                            "UK",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33de16d0-31ae-4296-8643-a787d2a5f0c2",
                                                "sense_id": "31d14ec8-815e-37bd-b82e-cd256cfbeb41",
                                                "text": "Sorry squire, I've had a look 'round the back of the shop, and uh, we're right out of parrots."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb11f497-c9cd-3010-89eb-a68a8852c765",
                                        "entry_id": "6b1fcbb5-f8e9-3855-af84-9406bd0ff378",
                                        "glosses": [
                                            "To attend as a squire."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6feeb6a3-1325-3b7f-b8e3-2ea3e8b730e0",
                                        "entry_id": "6b1fcbb5-f8e9-3855-af84-9406bd0ff378",
                                        "glosses": [
                                            "To attend as a beau, or gallant, for aid and protection."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bba8406-d791-4243-a4ec-b060008761e5",
                                                "sense_id": "6feeb6a3-1325-3b7f-b8e3-2ea3e8b730e0",
                                                "text": "[O]n ſome occaſions, he diſplayed all his fund of good humour, vvith a vievv to beguile her ſorrovv; he importuned her to give him the pleasure of ’ſquiring her to ſome place of innocent entertainment; and, finally, inſiſted upon her accepting a pecuniary reinforcement to her finances, vvhich he knevv to be in a moſt conſumptive condition."
                                            },
                                            {
                                                "example_id": "09363eb7-ec23-40a7-8d1e-9c50eb698c99",
                                                "sense_id": "6feeb6a3-1325-3b7f-b8e3-2ea3e8b730e0",
                                                "text": "Perceiving, however, that I had on my best wig, she offered, if I would ’squire her there, to send home the footman."
                                            },
                                            {
                                                "example_id": "29a55c58-75f2-4285-946d-c2ddcb5a89cf",
                                                "sense_id": "6feeb6a3-1325-3b7f-b8e3-2ea3e8b730e0",
                                                "text": "To man a lady was, in former times, a phrase similar to the vulgar one at present in use, to squire."
                                            },
                                            {
                                                "example_id": "c52d537e-9c01-4790-87b3-d519696deb00",
                                                "sense_id": "6feeb6a3-1325-3b7f-b8e3-2ea3e8b730e0",
                                                "text": "Yes, such a thing as thou wouldst make of me should wear a book at his girdle instead of a poniard, and might just be suspected of manhood enough to squire a proud dame-citizen to the lecture at Saint Antonlin’s, and quarrel in her cause with any flat-capped threadmaker that would take the wall of her."
                                            },
                                            {
                                                "example_id": "431cb2ff-349c-46c2-8763-e4b42a648c8a",
                                                "sense_id": "6feeb6a3-1325-3b7f-b8e3-2ea3e8b730e0",
                                                "text": "And raising good cotton, riding well, shooting straight, dancing lightly, squiring the ladies with elegance and carrying one’s liquor like a gentleman were the things that mattered."
                                            },
                                            {
                                                "example_id": "f93e4c4b-9765-4f1e-b261-f7208db4eda3",
                                                "sense_id": "6feeb6a3-1325-3b7f-b8e3-2ea3e8b730e0",
                                                "text": "A butch entered squiring a blonde whore tottering along on spike heels under dairy whip hair, her chubby hand rising again and again to tuck a stray wisp back into the creamy dome."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "squire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1090baf8-3985-3d88-9ea5-70506482cc95",
                                        "entry_id": "552eaa38-f501-3cd1-9d0c-46e11462a3ae",
                                        "glosses": [
                                            "A ruler; a carpenter's square; a measure."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c391518a-c989-4a5c-af92-b23335adef90",
                                                "sense_id": "1090baf8-3985-3d88-9ea5-70506482cc95",
                                                "text": "But temperaunce, said he, with golden squire, / Betwixt them both can measure out a meane."
                                            },
                                            {
                                                "example_id": "f5574525-33a9-4009-9f80-1bd7d48e0023",
                                                "sense_id": "1090baf8-3985-3d88-9ea5-70506482cc95",
                                                "text": "do not you know my lady's foot by the squire."
                                            },
                                            {
                                                "example_id": "2604dc2b-1904-4f0d-bf95-d2a05e6ea639",
                                                "sense_id": "1090baf8-3985-3d88-9ea5-70506482cc95",
                                                "text": "as for a workman not to know his axe, saw, squire, or any other toole, […]."
                                            },
                                            {
                                                "example_id": "6c1d22b5-46f5-4a4f-a07f-ba32aaca82db",
                                                "sense_id": "1090baf8-3985-3d88-9ea5-70506482cc95",
                                                "text": "twelve foot and a half by the squire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
