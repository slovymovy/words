                "senses": [
                    {
                        "sense_id": "c3d3f2a4-c7b7-39a8-b458-226a9f69ce1d",
                        "entry_id": "2a93f854-8bf9-379c-a9b9-f78dc4889cd1",
                        "glosses": [
                            "Konto bei einer Bank, die es verwaltet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bb66f1-cdd3-461a-90ce-7d1be8e97520",
                                "sense_id": "c3d3f2a4-c7b7-39a8-b458-226a9f69ce1d",
                                "text": "Mit einem Bankkonto können Sie Ihre Geldgeschäfte leichter abwickeln."
                            },
                            {
                                "example_id": "692f9073-bb8e-424d-8613-6670ece56d59",
                                "sense_id": "c3d3f2a4-c7b7-39a8-b458-226a9f69ce1d",
                                "text": "Jeder hat das Recht auf ein Bankkonto."
                            },
                            {
                                "example_id": "6ef088f3-7535-4cb2-baed-606b0f2e0d2e",
                                "sense_id": "c3d3f2a4-c7b7-39a8-b458-226a9f69ce1d",
                                "text": "Wer hat das dickste Bankkonto?"
                            },
                            {
                                "example_id": "c5535503-1dfa-404c-906a-023a79d0c4e5",
                                "sense_id": "c3d3f2a4-c7b7-39a8-b458-226a9f69ce1d",
                                "text": "„Obwohl meiner Mutter privates Bankkonto einen sechsstelligen Saldo zu ihren Gunsten aufweist, laufen die Rechnungen fürs Telefon (und natürlich die Reisespesen nach Amsterdam und anderswohin) aufs Konto des Zentralkomitees.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
