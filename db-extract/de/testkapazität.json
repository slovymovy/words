                "senses": [
                    {
                        "sense_id": "5e3faf37-6cb4-38de-8e5b-32ccc633a015",
                        "entry_id": "fe28c342-6d2e-3084-9c9b-3bb28288ac1c",
                        "glosses": [
                            "räumliche, zeitliche, finanzielle, organisatorische Möglichkeit und Ressourcen, abgleichende Untersuchungen durchzuführen"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "9fcafa23-739e-4122-8ec0-5b306e97fc7e",
                                "sense_id": "5e3faf37-6cb4-38de-8e5b-32ccc633a015",
                                "text": "„Die erste und bis heute heftig diskutierte ‚seuchenhygienische‘ Maßnahme war die Entwicklung diagnostischer Testkapazitäten.“"
                            },
                            {
                                "example_id": "a9a0adf4-5eb6-42ac-8a7a-541ccbb31870",
                                "sense_id": "5e3faf37-6cb4-38de-8e5b-32ccc633a015",
                                "text": "„Für die Testdurchführung wird zusätzliche Testkapazität benötigt.“"
                            },
                            {
                                "example_id": "582ec947-2187-4022-b214-cef35ffff882",
                                "sense_id": "5e3faf37-6cb4-38de-8e5b-32ccc633a015",
                                "text": "„Die optimale Eingangswahrscheinlichkeit gibt an, unter welcher Prävalenz die Testkapazität voll ausgeschöpft werden kann.“"
                            }
                        ],
