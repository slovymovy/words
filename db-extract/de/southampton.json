                "senses": [
                    {
                        "sense_id": "92752977-37e4-3ca4-a0fe-665369384e28",
                        "entry_id": "141d6b2a-21d2-33e8-a2f0-904d75a59ddb",
                        "glosses": [
                            "Hafenstadt in der englischen Grafschaft Hampshire"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca57a653-2fa5-4151-b7b6-57b040fcc121",
                                "sense_id": "92752977-37e4-3ca4-a0fe-665369384e28",
                                "text": "„Mr. Allomby erzählt von einem Mädchen aus Southampton, das er mit einem Witz über Tintenfische und Tennisspieler verführt hat.“"
                            },
                            {
                                "example_id": "31af9456-e9ce-401c-b579-f32e804978ad",
                                "sense_id": "92752977-37e4-3ca4-a0fe-665369384e28",
                                "text": "„›Und ihr könnt alle schön wieder heimfahren nach Southampton, Bristol, London oder egal wohin und euer Geld verprassen und am besten schnell vergessen, was da abgelaufen ist.‹“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
