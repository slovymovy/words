                ],
                "senses": [
                    {
                        "sense_id": "5c245809-090d-300e-b1a1-b7ff0e1bc98a",
                        "entry_id": "f2b025cc-31d9-33c7-913b-df768f70584a",
                        "glosses": [
                            "Action d’uniformiser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e937c0b4-629c-4669-b8a1-83fb6b3e3237",
                                "sense_id": "5c245809-090d-300e-b1a1-b7ff0e1bc98a",
                                "text": "Pendant la période maoïste, l’uniformisation des vêtements avait mis fin à toute distinction vestimentaire."
                            },
                            {
                                "example_id": "4cf46100-91ca-434f-8c72-e916904975cc",
                                "sense_id": "5c245809-090d-300e-b1a1-b7ff0e1bc98a",
                                "text": "À date, il n’y a pas de standards de développement donc aucune uniformisation entre les métavers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5b1b00a-955c-4786-9e77-25b39c407158",
                        "source_entry_id": "f2b025cc-31d9-33c7-913b-df768f70584a",
                        "source_sense_id": "5c245809-090d-300e-b1a1-b7ff0e1bc98a",
                        "target_lang_word": "Gleichmacherei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gleichmacherei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2182e336-1e39-3293-9e9a-3750120825fb",
                                        "entry_id": "66bb3cae-c308-3915-8bcf-3355651e381c",
                                        "glosses": [
                                            "Beseitigung objektiv vorhandener Unterschiede (mit dem Ziel, wichtige, individuelle Besonderheiten, Charakteristika von jemandem oder etwas zu negieren); unangemessene Gleichsetzung von verschiedenen Menschen oder Sachverhalten"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff69eae0-9970-4169-b34d-dda8cec07587",
                                                "sense_id": "2182e336-1e39-3293-9e9a-3750120825fb",
                                                "text": "„Der Antisemitismus als Volksbewegung war stets, was seine Anstifter den Sozialdemokraten vorzuwerfen liebten: Gleichmacherei.“"
                                            },
                                            {
                                                "example_id": "0e9c0ad5-6d16-4523-a38d-4d1d676d1e36",
                                                "sense_id": "2182e336-1e39-3293-9e9a-3750120825fb",
                                                "text": "„Da Verschiedenartigkeit als Problem nicht aufscheinen darf, findet eine Gleichmacherei statt. […] ‚Integration‘, wie die Gleichmacherei in der offiziellen Sprachregelung heißt, ist die Vorausetzung für Akzeptanz.“"
                                            },
                                            {
                                                "example_id": "cb40d646-3473-43b0-b623-48ff65b84134",
                                                "sense_id": "2182e336-1e39-3293-9e9a-3750120825fb",
                                                "text": "„Es darf hier keine Gleichmachereien geben.“"
                                            },
                                            {
                                                "example_id": "a70bbda0-3268-44ff-9b07-315e5e829c97",
                                                "sense_id": "2182e336-1e39-3293-9e9a-3750120825fb",
                                                "text": "„Was ich noch über meinen Vater weiß, ist, dass er Rassismus und Gleichmacherei mehr als alles andere hasste, und das nicht aus einem Gefühl der Selbstgerechtigkeit oder moralischen Überlegenheit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c7966e3-c8e9-454b-ac73-1ff1a79df57c",
                        "source_entry_id": "f2b025cc-31d9-33c7-913b-df768f70584a",
