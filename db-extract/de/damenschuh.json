                "senses": [
                    {
                        "sense_id": "6749d202-7c12-3f1f-b7cd-1b9975606303",
                        "entry_id": "4aae3725-af7a-3d29-9fc1-5deef050bd92",
                        "glosses": [
                            "Schuh für Damen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51e7a2f9-1f36-416d-a8af-f2c94c930856",
                                "sense_id": "6749d202-7c12-3f1f-b7cd-1b9975606303",
                                "text": "„Sie kaufte am anderen Tage vier Geschenkgegenstände, fertigte ein Paar Damenschuhe an und wies den Kellner an, die Gaben in einem Kästchen zu tragen.“"
                            },
                            {
                                "example_id": "faa313a0-9761-4525-8e79-1fa32576a0e3",
                                "sense_id": "6749d202-7c12-3f1f-b7cd-1b9975606303",
                                "text": "„Als er die Treppe vor dem Gerichtsgebäude hinuntergeht, hört er das eilige Klackern von Damenschuhen hinter sich, in denen sich Vera Priori befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
