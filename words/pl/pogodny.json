    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4d7ff64c-6571-33ab-837a-39cc9a78bf33",
                    "sense_definition": "odznaczający się ładną pogodą, brakiem opadów",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "pogoda",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dlaczego w taki <w>pogodny</w> dzień siedzisz w domu? Wyszedłbyś na dwór.",
                            "target_lang_translations": {
                                "ru": "Почему ты сидишь дома в такой <w>погожий</w> день? Сходил бы на улицу."
                            }
                        },
                        {
                            "text": "Mieliśmy bardzo <w>pogodny</w> weekend, więc dużo spacerowaliśmy po parku.",
                            "target_lang_translations": {
                                "ru": "У нас были очень <w>ясные</w> выходные, поэтому мы много гуляли по парку."
                            }
                        }
                    ],
                    "synonyms": [
                        "słoneczny"
                    ],
                    "antonyms": [
                        "pochmurny",
                        "chmurny",
                        "niepogodny"
                    ],
                    "common_phrases": [
                        "pogodny dzień"
                    ],
                    "target_lang_definitions": {
                        "ru": "характеризующийся хорошей погодой, отсутствием осадков, ясный"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ясный",
                                "target_lang_sense_clarification": "о погоде, небе"
                            },
                            {
                                "target_lang_word": "солнечный",
                                "target_lang_sense_clarification": "о погоде, дне"
                            },
                            {
                                "target_lang_word": "погожий",
                                "target_lang_sense_clarification": "о хорошей, сухой погоде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "431f2382-b9d0-3315-82eb-515279a57530",
                    "sense_definition": "pełen spokoju, wesoły, odznaczający się pogodą ducha",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "osobowość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Damian jest bardzo <w>pogodnym</w> człowiekiem, który zawsze się uśmiecha.",
                            "target_lang_translations": {
                                "ru": "Дамиан — очень <w>жизнерадостный</w> человек, который всегда улыбается."
                            }
                        },
                        {
                            "text": "Mimo wielu problemów, staram się być <w>pogodny</w> i optymistycznie patrzeć w przyszłość.",
                            "target_lang_translations": {
                                "ru": "Несмотря на множество проблем, я стараюсь быть <w>безмятежным</w> и оптимистично смотреть в будущее."
                            }
                        }
                    ],
                    "synonyms": [
                        "wesoły",
                        "radosny",
                        "beztroski"
                    ],
                    "common_phrases": [
                        "pogodny człowiek"
                    ],
                    "target_lang_definitions": {
                        "ru": "исполненный спокойствия, жизнерадостный, обладающий душевным равновесием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жизнерадостный",
                                "target_lang_sense_clarification": "о человеке, полном оптимизма"
                            },
                            {
                                "target_lang_word": "безмятежный",
                                "target_lang_sense_clarification": "о спокойном, уравновешенном состоянии"
                            },
                            {
                                "target_lang_word": "добродушный",
                                "target_lang_sense_clarification": "о мягком, приветливом характере"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea4f6295-1993-347c-9d65-51f92200c451",
                    "sense_definition": "wyrażający takie cechy; wesoły, sympatyczny",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "osobowość",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miło widzieć u ciebie wreszcie <w>pogodną</w> twarz.",
                            "target_lang_translations": {
                                "ru": "Приятно видеть у тебя наконец <w>приветливое</w> лицо."
                            }
                        },
                        {
                            "text": "Przywitała nas swoim <w>pogodnym</w> uśmiechem, co od razu poprawiło nam humor.",
                            "target_lang_translations": {
                                "ru": "Она встретила нас своей <w>сияющей</w> улыбкой, что сразу подняло нам настроение."
                            }
                        }
                    ],
                    "synonyms": [
                        "promienny"
                    ],
                    "common_phrases": [
                        "pogodna twarz"
                    ],
                    "target_lang_definitions": {
                        "ru": "выражающий радость, приветливость, доброжелательность"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приветливый",
                                "target_lang_sense_clarification": "о выражении лица, улыбке"
                            },
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "о радостном, светлом выражении лица"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}