                        "form": "more tardigrade"
                    },
                    {
                        "form_id": "1f3aad21-4abd-410e-b891-13dee2fba197",
                        "entry_id": "0d4cb4ae-011d-3f9b-93bb-1208d19cf59d",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most tardigrade"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "685239b2-cdf6-32e5-9e18-1c350d34754b",
                        "entry_id": "0d4cb4ae-011d-3f9b-93bb-1208d19cf59d",
                        "glosses": [
                            "Sluggish; moving slowly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0b9fb25-289e-4411-95ed-fbfbe3e1f6d1",
                                "sense_id": "685239b2-cdf6-32e5-9e18-1c350d34754b",
                                "text": "Each tendril ending in a perfect claw, / Obeys the whole routine of Nature's law; / Transforms each sinus to a sylvan shade, / Though p'rhaps its force is rather tardigrade."
                            },
                            {
                                "example_id": "61ac13ad-be77-4430-aa90-3786397d7862",
                                "sense_id": "685239b2-cdf6-32e5-9e18-1c350d34754b",
                                "text": "He ran on into the piazza, but he quickly heard the tramp of feet behind him, for the other two prisoners had been released, and the soldiers were struggling and fighting their way after them, in such tardigrade fashion as their hoof-shaped shoes would allow—impeded, but not very resolutely attacked, by the people."
                            },
                            {
                                "example_id": "f13a2aba-7e99-4dbf-b9d7-a4f5de179870",
                                "sense_id": "685239b2-cdf6-32e5-9e18-1c350d34754b",
                                "text": "In sorrow, its voice is tardigrade but loud, dragging time at a snail's pace before our eyes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed79e6f7-8798-4e1a-abe6-929437b3460a",
