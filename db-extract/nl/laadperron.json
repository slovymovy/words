                    {
                        "sense_id": "3f722026-94f2-3357-ae39-a0d59ba054e2",
                        "entry_id": "e4733f4e-0370-3cb9-b7c3-b0b22de64af8",
                        "glosses": [
                            "verhoging naast een gebouw waar vrachtwagens hun lading kunnen lossen en laden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c014f593-a4b8-450f-b7ad-7b23bd424389",
                                "sense_id": "3f722026-94f2-3357-ae39-a0d59ba054e2",
                                "text": "Hij bevond zich in een bakstenen gebouw van één verdieping, met aan de zijkant een laadperron, in een nietszeggende New Yorkse buitenwijk."
                            },
                            {
                                "example_id": "1b19b22d-dda0-4839-94a6-d0bd7d672414",
                                "sense_id": "3f722026-94f2-3357-ae39-a0d59ba054e2",
                                "text": "Langs de Parallelweg is het ongewenste bezoek vooral te vinden onder de overkapping en in de nissen van de laadperrons. De overlastklachten komen ook van de medewerkers van Atak en het Wilminktheater."
                            }
                        ]
                    }
