                ],
                "senses": [
                    {
                        "sense_id": "5b721330-8684-313a-88b8-fb5d3a0b6c94",
                        "entry_id": "7d5e80cc-0637-308d-bf6c-47e1515da67c",
                        "glosses": [
                            "Stimmung, die von schlechter Laune geprägt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17475af4-ee1f-40fa-8375-11d56bca306b",
                                "sense_id": "5b721330-8684-313a-88b8-fb5d3a0b6c94",
                                "text": "„Dass er von melancholischem Missmut geplagt war, bedeutete für ihn, die Pflichten seines Berufes nicht erfüllen zu können.“"
                            },
                            {
                                "example_id": "adc7f5cb-8731-4e8a-9c2e-a3e68688ad52",
                                "sense_id": "5b721330-8684-313a-88b8-fb5d3a0b6c94",
                                "text": "„Voller Missmut wandelt sie wie ein apathischer, indifferenter Fremdkörper über die Insel, durch das Dorf, und wundert sich dabei, dass man ihr mit Ablehnung begegnet.“"
                            },
                            {
                                "example_id": "38755078-bc13-4f49-86d1-5499649c2536",
                                "sense_id": "5b721330-8684-313a-88b8-fb5d3a0b6c94",
                                "text": "„Ein leichter Missmut ergriff mich, da ich es unangenehm fand, dass sich eine ganze Grundschulklasse mit meinem Schlaganfall beschäftigte.“"
                            },
                            {
                                "example_id": "95dbab9a-d41f-409d-93a5-6f1b1fc6971e",
                                "sense_id": "5b721330-8684-313a-88b8-fb5d3a0b6c94",
                                "text": "„Ola beugte sich vor und küsste mich auf eine Weise, die allen Missmut aus meinem Körper vertrieb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5391ffc8-9df1-421b-861a-2aa444688d2b",
                        "source_entry_id": "7d5e80cc-0637-308d-bf6c-47e1515da67c",
                        "source_sense_id": "5b721330-8684-313a-88b8-fb5d3a0b6c94",
                        "source_sense_description": "Stimmung, die von schlechter Laune geprägt ist",
                        "target_lang_word": "discontent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discontent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "463ab6a6-4eb3-3d1b-9d29-f2ad594b271e",
                                        "entry_id": "697b33bc-1b82-3c3d-b3bf-f2a63eaa1265",
                                        "glosses": [
                                            "Dissatisfaction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b6bab83b-6c83-4b97-a537-46abd76d3d1e",
                                                "sense_id": "463ab6a6-4eb3-3d1b-9d29-f2ad594b271e",
                                                "text": "Another source of discontent with the Phase I stock has been obviated by relocation of the interior heating elements and the introduction of thermostatic control; this has eradicated the searing blasts of hot air passengers used to feel about their calves [...]."
                                            },
                                            {
                                                "example_id": "5a1f96c9-011d-4662-b6a6-3e3f7ef896a9",
                                                "sense_id": "463ab6a6-4eb3-3d1b-9d29-f2ad594b271e",
                                                "text": "Analysts and opinion polls had forecast losses for the ANC but a pivotal factor in the party’s staggering decline was former President Jacob Zuma and his newly formed uMkhonto weSizwe (MK) party, which capitalized on widespread discontent within the ANC’s traditional voter base."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f0b29308-8d84-3421-8031-b88273b37c8a",
                                        "entry_id": "697b33bc-1b82-3c3d-b3bf-f2a63eaa1265",
                                        "glosses": [
                                            "A longing for better times or circumstances."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bed8c15-2c95-4d65-a6bd-de5994b49d09",
                                                "sense_id": "f0b29308-8d84-3421-8031-b88273b37c8a",
                                                "text": "Now is the winter of our diſcontent, / Made glorious ſummer by this ſonne of Yorke: / And all the cloudes that lowrd vpon our houſe, / In the deepe boſome of the Ocean buried."
                                            },
                                            {
                                                "example_id": "ea4e63ff-773d-4e14-b4ac-7ff2798460f1",
                                                "sense_id": "f0b29308-8d84-3421-8031-b88273b37c8a",
                                                "text": "Spring was moving in the air above and in the earth below and around him, penetrating even his dark and lowly little house with its spirit of divine discontent and longing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44782edd-1f37-3333-ae5e-6d819d038121",
                                        "entry_id": "697b33bc-1b82-3c3d-b3bf-f2a63eaa1265",
                                        "glosses": [
                                            "A discontented person; a malcontent."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "discontent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "adbf9ab3-f2dd-309e-bf03-c5e64f7190dd",
                                        "entry_id": "8c63d27a-6183-3dde-aed3-e46e215acab0",
                                        "glosses": [
                                            "To deprive of contentment; to make uneasy; to dissatisfy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "discontent",
