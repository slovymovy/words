{
    "word_family": [
        "contain",
        "containment",
        "containerize",
        "containerization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea297cdb-be47-3872-a6f1-c903949fedd2",
                    "sense_definition": "An item in which objects or materials can be stored or transported.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She put the leftover food in a plastic <w>container</w> to keep it fresh.",
                            "target_lang_translations": {
                                "ru": "Она положила остатки еды в пластиковый <w>контейнер</w>, чтобы сохранить их свежими.",
                                "zh": "她把剩菜放进塑料<w>容器</w>里以保持新鲜。"
                            }
                        },
                        {
                            "text": "Please place your empty bottles in the recycling <w>container</w> outside.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, поместите пустые бутылки в <w>контейнер</w> для переработки на улице.",
                                "zh": "请把空瓶子放进外面的回收<w>箱</w>里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "receptacle",
                        "box",
                        "bin"
                    ],
                    "common_phrases": [
                        "plastic container",
                        "food container",
                        "airtight container",
                        "glass container"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет, в котором можно хранить или транспортировать объекты или материалы.",
                        "zh": "用于存放或运输物品的器具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контейнер",
                                "target_lang_sense_clarification": "ящик или коробка для хранения"
                            },
                            {
                                "target_lang_word": "ёмкость",
                                "target_lang_sense_clarification": "сосуд, вместилище"
                            },
                            {
                                "target_lang_word": "тара",
                                "target_lang_sense_clarification": "упаковка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容器",
                                "target_lang_sense_clarification": "泛指盛装物品的器具"
                            },
                            {
                                "target_lang_word": "盒子",
                                "target_lang_sense_clarification": "指较小的盛装物"
                            },
                            {
                                "target_lang_word": "箱子",
                                "target_lang_sense_clarification": "指较大的盛装物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "777c043e-22c2-39f2-8fcc-afd130b25db2",
                    "sense_definition": "A very large, typically metal, box used for transporting goods.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crane lifted the heavy <w>container</w> onto the deck of the ship.",
                            "target_lang_translations": {
                                "ru": "Кран поднял тяжелый <w>контейнер</w> на палубу корабля.",
                                "zh": "起重机把沉重的<w>集装箱</w>吊到了甲板上。"
                            }
                        },
                        {
                            "text": "Goods are often moved from a shipping <w>container</w> directly onto a truck.",
                            "target_lang_translations": {
                                "ru": "Товары часто перемещают из морского <w>контейнера</w> прямо в грузовик.",
                                "zh": "货物通常直接从<w>集装箱</w>卸到卡车上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shipping container",
                        "cargo container"
                    ],
                    "common_phrases": [
                        "container ship",
                        "container port",
                        "freight container"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень большой, обычно металлический ящик для перевозки грузов.",
                        "zh": "一种用于运输货物的大型金属箱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контейнер",
                                "target_lang_sense_clarification": "грузовой модуль"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "集装箱",
                                "target_lang_sense_clarification": "用于物流运输的标准化金属箱"
                            },
                            {
                                "target_lang_word": "货柜",
                                "target_lang_sense_clarification": "常用于港口或运输业的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16427390-e72f-3ac5-ba6e-53d1dc4e9622",
                    "sense_definition": "A bundle consisting of operating system, application code, and dependencies to be run sandboxed inside a virtualized environment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Developers use a <w>container</w> to ensure the application runs correctly on any server.",
                            "target_lang_translations": {
                                "ru": "Разработчики используют <w>контейнер</w>, чтобы гарантировать правильную работу приложения на любом сервере.",
                                "zh": "开发人员使用<w>容器</w>来确保应用程序能在任何服务器上正常运行。"
                            }
                        },
                        {
                            "text": "Each service runs in its own isolated <w>container</w> to prevent conflicts with other software.",
                            "target_lang_translations": {
                                "ru": "Каждая служба работает в собственном изолированном <w>контейнере</w> для предотвращения конфликтов с другим ПО.",
                                "zh": "每项服务都在其独立的<w>容器</w>中运行，以防止与其他软件发生冲突。"
                            }
                        }
                    ],
                    "synonyms": [
                        "software container"
                    ],
                    "common_phrases": [
                        "run in a container",
                        "container image",
                        "deploy a container"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пакет, состоящий из кода приложения и зависимостей, запускаемый в изолированной среде.",
                        "zh": "一种包含应用程序代码及其依赖项的软件包，可在虚拟化环境中隔离运行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контейнер",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容器",
                                "target_lang_sense_clarification": "计算机软件技术术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3f4861f4-dee4-39bc-b685-b64bbe4d07c5",
                    "sense_definition": "A file format that can hold various types of data.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The MP4 <w>container</w> can store both audio and video streams in a single file.",
                            "target_lang_translations": {
                                "ru": "<w>Контейнер</w> MP4 может хранить как аудио, так и видеопотоки в одном файле.",
                                "zh": "MP4<w>容器</w>可以将音频和视频流存储在同一个文件中。"
                            }
                        },
                        {
                            "text": "You need compatible software to open this specific multimedia <w>container</w>.",
                            "target_lang_translations": {
                                "ru": "Вам нужно совместимое программное обеспечение, чтобы открыть этот конкретный мультимедийный <w>контейнер</w>.",
                                "zh": "你需要兼容的软件才能打开这种特定的多媒体<w>容器</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "container format"
                    ],
                    "common_phrases": [
                        "multimedia container",
                        "video container"
                    ],
                    "target_lang_definitions": {
                        "ru": "Формат файла, который может содержать различные типы данных.",
                        "zh": "一种可以容纳多种数据类型的文件格式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "контейнер",
                                "target_lang_sense_clarification": "формат файла"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "容器",
                                "target_lang_sense_clarification": "多媒体文件格式术语"
                            },
                            {
                                "target_lang_word": "封装格式",
                                "target_lang_sense_clarification": "指代多媒体文件的包装形式"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}