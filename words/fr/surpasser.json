{
    "word_family": [
        "passer",
        "passable",
        "dépasser"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4214de88-09ad-32c4-a40f-4583216fc6dc",
                    "sense_definition": "Faire mieux qu'à l'accoutumée et aller au-delà de ses propres capacités habituelles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accomplissement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour remporter cette compétition difficile, l'athlète s'est <w>surpassé</w> lors de la finale."
                        },
                        {
                            "text": "Toute l'équipe doit se <w>surpasser</w> pour terminer ce projet ambitieux dans les délais."
                        }
                    ],
                    "common_phrases": [
                        "se surpasser"
                    ]
                },
                {
                    "sense_id": "bc2f27c1-7fe8-3da0-992e-2c9d4d6ca390",
                    "sense_definition": "Être supérieur à quelqu'un ou à quelque chose par des qualités, des compétences ou des mérites.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "superiorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Grâce à son entraînement quotidien, ce coureur <w>surpasse</w> tous ses rivaux sur la piste."
                        },
                        {
                            "text": "Par son talent musical précoce, elle <w>surpassait</w> largement les autres élèves de la classe."
                        }
                    ],
                    "synonyms": [
                        "surclasser"
                    ],
                    "common_phrases": [
                        "surpasser ses rivaux"
                    ]
                },
                {
                    "sense_id": "6967c821-be4c-383e-a4da-65f07b9e5c60",
                    "sense_definition": "Être plus grand en taille, en nombre ou en quantité qu'un autre élément de référence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les nouvelles constructions de la capitale <w>surpassent</w> en hauteur tous les anciens monuments."
                        },
                        {
                            "text": "Le nombre de participants à cet événement annuel <w>surpasse</w> celui de l'année dernière."
                        }
                    ],
                    "synonyms": [
                        "excéder"
                    ],
                    "common_phrases": [
                        "surpasser en nombre",
                        "surpasser en taille"
                    ]
                },
                {
                    "sense_id": "a7414fb0-77b1-356c-adbf-0ddce729d752",
                    "sense_definition": "Excéder les capacités humaines, l'imagination ou les forces dont on dispose.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "superiorite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'ampleur de ce désastre naturel <w>surpasse</w> tout ce que les sauveteurs pouvaient imaginer."
                        },
                        {
                            "text": "Cette tâche exigeante <w>surpassait</w> les forces de ces jeunes apprentis fatigués."
                        }
                    ],
                    "common_phrases": [
                        "surpasser l'imagination",
                        "surpasser les forces"
                    ]
                },
                {
                    "sense_id": "7685307a-5451-358b-8243-dc4682d98c6c",
                    "sense_definition": "Provoquer une incompréhension totale ou un grand étonnement qui déconcerte l'esprit.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une telle absurdité me <w>surpasse</w> complètement et me laisse sans voix."
                        },
                        {
                            "text": "Sa décision soudaine de tout abandonner nous <w>surpasse</w> profondément."
                        }
                    ],
                    "common_phrases": [
                        "cela me surpasse"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Remplacé couramment par le verbe dépasser"
                        }
                    ]
                }
            ]
        }
    ]
}