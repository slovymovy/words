                    }
                ],
                "senses": [
                    {
                        "sense_id": "55170dfe-2804-3b5e-9282-ef828f00e761",
                        "entry_id": "f7145c96-b6e2-377c-84ea-f037ea3c7770",
                        "glosses": [
                            "Langue bantoue parlée par les Mbundu en Angola dans les régions de Luanda, Bengo et Malange."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4faf7b5c-9a6a-44ef-85d2-141f406b3b75",
                                "sense_id": "55170dfe-2804-3b5e-9282-ef828f00e761",
                                "text": "On lui donnerait à chanter un annuaire, cette voix, s’exprimant en portugais d’Angola ou en kimbundu, l’une des langues les plus parlées du pays, produirait encore son effet."
                            },
                            {
                                "example_id": "b526d925-a234-4415-b91e-3521383ab594",
                                "sense_id": "55170dfe-2804-3b5e-9282-ef828f00e761",
                                "text": "En revanche, le kimbundu, langue des Mbundu, habitants de la région de Luanda, a beaucoup reculé face au portugais."
                            }
                        ]
                    }
