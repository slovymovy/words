                "senses": [
                    {
                        "sense_id": "17176f4d-2ef5-37c2-be77-79b7cbbf0b00",
                        "entry_id": "58b349ee-8e9c-3917-8274-22a4dee50b1c",
                        "glosses": [
                            "то же, что равнодействующая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97351781-b76c-406e-ba9b-07b5e9489470",
                                "sense_id": "17176f4d-2ef5-37c2-be77-79b7cbbf0b00",
                                "text": "Теперь они тащили корову в разные стороны, что ей было легче перенести в результате равнодействия сил."
                            },
                            {
                                "example_id": "8795c070-4560-4634-9f6d-db8960d07786",
                                "sense_id": "17176f4d-2ef5-37c2-be77-79b7cbbf0b00",
                                "text": "В день весеннего равноденствия установилось какое-то доверительное равнодействие между людьми, которые любят поэзию."
                            }
                        ]
                    }
