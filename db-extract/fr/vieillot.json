                                "target_senses": [
                                    {
                                        "sense_id": "cce74bbc-6cbb-3ea1-a28c-5944bb95f44d",
                                        "entry_id": "32b40053-8e05-31c0-9e2c-a94946798a51",
                                        "glosses": [
                                            "niet langer gebruikt of in de mode"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75e1f2fb-7700-4643-a082-fe85a764d55f",
                                                "sense_id": "cce74bbc-6cbb-3ea1-a28c-5944bb95f44d",
                                                "text": "Wanneer gooi je die ouderwetse platenspeler nou eens weg en koop je een cd-speler?"
                                            },
                                            {
                                                "example_id": "7001d9a5-6bad-4122-942d-a4c08ce64b37",
                                                "sense_id": "cce74bbc-6cbb-3ea1-a28c-5944bb95f44d",
                                                "text": "Ik grapte wel eens dat ik mijn vrouw tijdens de tocht misschien meer heb gesproken dan normaal dankzij lange gesprekken via FaceTime, audioberichten via WhatsApp en ouderwetse brieven."
                                            },
                                            {
                                                "example_id": "d983fc6e-aba2-4a48-8c16-b8e13d709b8b",
                                                "sense_id": "cce74bbc-6cbb-3ea1-a28c-5944bb95f44d",
                                                "text": "Hun houding was onbegrijpelijk. Of misschien was die gewoon extreem ouderwets."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
