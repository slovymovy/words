            {
                "entry_id": "e7dd4190-e8b5-30a5-8400-8c7bae5904c0",
                "word": "Brest",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b0cece0d-cca9-34ad-8785-8cf3b19a45ff",
                        "entry_id": "e7dd4190-e8b5-30a5-8400-8c7bae5904c0",
                        "glosses": [
                            "Ville de Biélorussie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "492c3069-08be-4ca7-9a58-75fa22756299",
                                "sense_id": "b0cece0d-cca9-34ad-8785-8cf3b19a45ff",
                                "text": "Le 3 mars 1918, fut signé le traité de Brest-Litovsk, qui conclut la paix entre l’Empire allemand et la Russie soviétique. La ville resta aux mains de l’Allemagne jusqu’en 1919, date à laquelle la Pologne en prit possession."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01ee4232-062b-46ae-95ad-32c3a458fa64",
                        "source_entry_id": "e7dd4190-e8b5-30a5-8400-8c7bae5904c0",
                        "source_sense_id": "b0cece0d-cca9-34ad-8785-8cf3b19a45ff",
                        "target_lang_word": "Brest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
