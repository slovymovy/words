                    {
                        "sense_id": "2a5727b1-1261-35a2-9f39-56816d13794c",
                        "entry_id": "e7751411-a9f8-3f31-9968-ca8645e25e69",
                        "glosses": [
                            "de mate waarin iets niet te begrijpen of te kennen valt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abe84b4b-23d9-478b-9f82-f438425880d6",
                                "sense_id": "2a5727b1-1261-35a2-9f39-56816d13794c",
                                "text": "Hij keek naar haar lachende ogen, die hem verschrikten door hun ondoorgrondelijkheid, en terwijl hij sprak, besefte hij heel het nutteloze en vergeefse van zijn woorden."
                            },
                            {
                                "example_id": "54cfe617-622b-44ae-a407-cf72c17bc481",
                                "sense_id": "2a5727b1-1261-35a2-9f39-56816d13794c",
                                "text": "Vanwege de ondoorgrondelijkheid van het nieuwe leiderschap is het nog niet zo eenvoudig om in te schatten welke kant het op gaat met het economische beleid."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e7a123e-2f36-335e-9663-0d48a9d75494",
                        "entry_id": "e7751411-a9f8-3f31-9968-ca8645e25e69",
                        "glosses": [
