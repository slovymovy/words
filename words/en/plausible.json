{
    "word_family": [
        "plausibility",
        "plausibly",
        "implausible",
        "implausibility"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec1e8dfe-ff67-3d5a-8cad-e5947d61c69c",
                    "sense_definition": "Seemingly or apparently valid, likely, or acceptable; conceivably true or likely.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "validity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective found his story to be a <w>plausible</w> explanation for his whereabouts.",
                            "target_lang_translations": {
                                "ru": "Детектив счел его историю <w>правдоподобным</w> объяснением его местонахождения.",
                                "pl": "Detektyw uznał jego historię za <w>wiarygodne</w> wyjaśnienie jego miejsca pobytu."
                            }
                        },
                        {
                            "text": "She gave a <w>plausible</w> excuse for being late to the meeting.",
                            "target_lang_translations": {
                                "ru": "Она привела <w>убедительное</w> оправдание своего опоздания на встречу.",
                                "pl": "Podała <w>prawdopodobną</w> wymówkę swojego spóźnienia na spotkanie."
                            }
                        }
                    ],
                    "synonyms": [
                        "credible",
                        "believable",
                        "reasonable",
                        "tenable"
                    ],
                    "antonyms": [
                        "implausible",
                        "incredible",
                        "unbelievable",
                        "far-fetched"
                    ],
                    "common_phrases": [
                        "plausible excuse",
                        "plausible explanation",
                        "plausible deniability",
                        "highly plausible"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кажущийся или являющийся обоснованным, вероятным или приемлемым; возможно истинный.",
                        "pl": "Wydający się słusznym, prawdopodobny lub możliwy do zaakceptowania; taki, który może być prawdziwy."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "правдоподобный",
                                "target_lang_sense_clarification": "похожий на правду"
                            },
                            {
                                "target_lang_word": "вероятный",
                                "target_lang_sense_clarification": "возможный"
                            },
                            {
                                "target_lang_word": "убедительный",
                                "target_lang_sense_clarification": "заслуживающий доверия"
                            },
                            {
                                "target_lang_word": "приемлемый",
                                "target_lang_sense_clarification": "допустимый"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wiarygodny",
                                "target_lang_sense_clarification": "zasługujący na wiarę i zaufanie"
                            },
                            {
                                "target_lang_word": "prawdopodobny",
                                "target_lang_sense_clarification": "przypuszczalnie prawdziwy"
                            },
                            {
                                "target_lang_word": "do przyjęcia",
                                "target_lang_sense_clarification": "taki, który można zaakceptować"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f14a82f4-6118-31b1-8b1d-c32ee8056dbf",
                    "sense_definition": "Superficially pleasing or persuasive but often deceptive; specious.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deceptive_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The salesman used <w>plausible</w> manners to hide the flaws in the product.",
                            "target_lang_translations": {
                                "ru": "Продавец использовал <w>благовидные</w> манеры, чтобы скрыть недостатки товара.",
                                "pl": "Sprzedawca użył <w>pozornie przekonujących</w> manier, aby ukryć wady produktu."
                            }
                        },
                        {
                            "text": "His argument was a <w>plausible</w> delusion that many people unfortunately believed.",
                            "target_lang_translations": {
                                "ru": "Его аргумент был <w>правдоподобным</w> заблуждением, в которое, к сожалению, поверили многие люди.",
                                "pl": "Jego argument był <w>wiarygodnie</w> brzmiącym złudzeniem, w które niestety uwierzyło wiele osób."
                            }
                        }
                    ],
                    "synonyms": [
                        "specious"
                    ],
                    "common_phrases": [
                        "plausible manners",
                        "plausible pretext"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поверхностно приятный или убедительный, но часто обманчивый; благовидный, но ложный.",
                        "pl": "Powierzchownie przekonujący, ale często zwodniczy; sprawiający wrażenie uczciwego."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благовидный",
                                "target_lang_sense_clarification": "скрывающий истинные намерения"
                            },
                            {
                                "target_lang_word": "спекулятивный",
                                "target_lang_sense_clarification": "внешне убедительный"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "pozornie przekonujący",
                                "target_lang_sense_clarification": "wyglądający na prawdziwy, lecz mylący"
                            },
                            {
                                "target_lang_word": "gładki",
                                "target_lang_sense_clarification": "o osobie: mówiący w sposób budzący zaufanie, ale nieszczery"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d234c22-65e6-3cbf-9c51-212471635dc8",
                    "sense_definition": "Worthy of being applauded; praiseworthy or commendable.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "praiseworthy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young man was described as <w>plausible</w> and well-behaved by his employers.",
                            "target_lang_translations": {
                                "ru": "Работодатели описывали молодого человека как <w>достойного похвалы</w> и хорошо воспитанного.",
                                "pl": "Młody człowiek był opisywany przez swoich pracodawców jako <w>chwalebny</w> i dobrze wychowany."
                            }
                        },
                        {
                            "text": "He provided a <w>plausible</w> answer that was met with great approval.",
                            "target_lang_translations": {
                                "ru": "Он дал <w>похвальный</w> ответ, который был встречен с большим одобрением.",
                                "pl": "Udzielił <w>godnej pochwały</w> odpowiedzi, która spotkała się z wielkim uznaniem."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is no longer in common usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Заслуживающий аплодисментов; достойный похвалы или одобрения (устаревшее значение).",
                        "pl": "Godny pochwały lub uznania (znaczenie przestarzałe)."
                    },
                    "translations": {
