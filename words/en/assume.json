{
    "word_family": [
        "assumption",
        "unassuming",
        "reassume",
        "assumable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "43aec05b-0973-31a8-90c1-420a6dae5d26",
                    "sense_definition": "To accept something as true without having proof.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We can safely <w>assume</w> that the store is closed at this late hour.",
                            "target_lang_translations": {
                                "ru": "Мы можем смело <w>предположить</w>, что магазин закрыт в такой поздний час.",
                                "zh": "我们可以放心地<w>假设</w>商店在这个深夜已经关门了。",
                                "pl": "Możemy śmiało <w>przypuszczać</w>, że sklep jest o tej późnej porze zamknięty."
                            }
                        },
                        {
                            "text": "I didn't want to <w>assume</w> anything until I had spoken to you directly.",
                            "target_lang_translations": {
                                "ru": "Я не хотел ничего <w>предполагать</w>, пока не поговорю с вами лично.",
                                "zh": "在和你直接交谈之前，我不想做任何<w>假定</w>。",
                                "pl": "Nie chciałem niczego <w>zakładać</w>, dopóki nie porozmawiam z tobą bezpośrednio."
                            }
                        }
                    ],
                    "synonyms": [
                        "suppose",
                        "presume",
                        "surmise",
                        "guess",
                        "think"
                    ],
                    "antonyms": [
                        "verify",
                        "prove"
                    ],
                    "common_phrases": [
                        "assume the worst",
                        "safely assume",
                        "naturally assume",
                        "assume that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать что-либо за истину без доказательств.",
                        "zh": "在没有证据的情况下将某事视为真实。",
                        "pl": "Przyjmować coś za prawdę bez posiadania dowodów."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагать",
                                "target_lang_sense_clarification": "считать возможным или вероятным"
                            },
                            {
                                "target_lang_word": "допускать",
                                "target_lang_sense_clarification": "считать возможным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "假设",
                                "target_lang_sense_clarification": "基于推测认为某事成立"
                            },
                            {
                                "target_lang_word": "假定",
                                "target_lang_sense_clarification": "认定某事为事实"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przypuszczać",
                                "target_lang_sense_clarification": "uważać coś za prawdopodobne bez pewności"
                            },
                            {
                                "target_lang_word": "dopuszczać",
                                "target_lang_sense_clarification": "uznawać coś za możliwe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4cad919-e8c2-3e7a-9ffc-e9ba1df6948b",
                    "sense_definition": "To take on a position, duty, responsibility, or physical form.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vice president will <w>assume</w> control of the company while the CEO is away.",
                            "target_lang_translations": {
                                "ru": "Вице-президент <w>возьмет на себя</w> управление компанией, пока генеральный директор в отъезде.",
                                "zh": "首席执行官不在时，副总裁将<w>承担</w>起公司的管理工作。",
                                "pl": "Wiceprezes <w>przejmie</w> kontrolę nad firmą pod nieobecność dyrektora generalnego."
                            }
                        },
                        {
                            "text": "In the fairy tale, the magical creature could <w>assume</w> the form of a human.",
                            "target_lang_translations": {
                                "ru": "В сказке волшебное существо могло <w>принимать</w> человеческий облик.",
                                "zh": "在童话故事里，那个魔法生物可以<w>呈现</w>出人类的形态。",
                                "pl": "W bajce magiczne stworzenie potrafiło <w>przybrać</w> ludzką postać."
                            }
                        }
                    ],
                    "synonyms": [
                        "undertake",
                        "accept",
                        "take on"
                    ],
                    "antonyms": [
                        "relinquish",
                        "give up"
                    ],
                    "common_phrases": [
                        "assume responsibility",
                        "assume control",
                        "assume the role",
                        "assume a form"
                    ],
                    "target_lang_definitions": {
                        "ru": "Брать на себя должность, обязанность, ответственность или принимать определенную форму.",
                        "zh": "承担职位、职责、责任或呈现某种物理形态。",
                        "pl": "Przyjmować stanowisko, obowiązek, odpowiedzialność lub przybierać określoną formę fizyczną."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брать на себя",
                                "target_lang_sense_clarification": "ответственность, руководство"
                            },
                            {
                                "target_lang_word": "занимать",
                                "target_lang_sense_clarification": "должность, пост"
                            },
                            {
                                "target_lang_word": "принимать",
                                "target_lang_sense_clarification": "форму, вид, командование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "承担",
                                "target_lang_sense_clarification": "担负起责任或任务"
                            },
                            {
                                "target_lang_word": "担任",
                                "target_lang_sense_clarification": "担任职务或职位"
                            },
                            {
                                "target_lang_word": "呈现",
                                "target_lang_sense_clarification": "显现出某种形态或外观"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "brać na siebie",
                                "target_lang_sense_clarification": "przyjmować odpowiedzialność lub zadanie"
                            },
                            {
                                "target_lang_word": "przyjmować",
                                "target_lang_sense_clarification": "przybierać postać lub formę"
                            },
                            {
                                "target_lang_word": "obejmować",
                                "target_lang_sense_clarification": "zaczynać pełnić funkcję lub stanowisko"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5722daec-ab67-3469-b8c1-a2b6ecf2a812",
                    "sense_definition": "To pretend to have a quality or manner that one does not actually possess.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>assume</w> an air of indifference, but his shaking hands gave him away.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>напустить на себя</w> равнодушный вид, но дрожащие руки выдавали его.",
                                "zh": "他试图<w>装出</w>一副漠不关心的样子，但他颤抖的双手出卖了他。",
                                "pl": "Próbował <w>przybrać</w> obojętny wyraz twarzy, ale drżące ręce go zdradziły."
                            }
                        },
                        {
                            "text": "The spy had to <w>assume</w> a false identity to enter the secure facility.",
                            "target_lang_translations": {
                                "ru": "Шпиону пришлось <w>взять</w> вымышленное имя, чтобы проникнуть на охраняемый объект.",
                                "zh": "为了进入那个安保设施，间谍不得不<w>假装</w>成另一个身份。",
                                "pl": "Szpieg musiał <w>przyjąć</w> fałszywą tożsamość, aby wejść do strzeżonego obiektu."
                            }
                        }
                    ],
                    "synonyms": [
                        "feign",
                        "simulate",
                        "fake"
                    ],
                    "common_phrases": [
                        "assume an air",
                        "assume a look",
                        "assume an attitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Притворяться, делая вид, что обладаешь каким-то качеством или манерой.",
                        "zh": "假装拥有某种实际上并不具备的品质或态度。",
                        "pl": "Udawać, że posiada się cechę lub sposób bycia, których w rzeczywistości się nie ma."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напускать на себя",
                                "target_lang_sense_clarification": "вид, манеру"
                            },
                            {
                                "target_lang_word": "принимать вид",
                                "target_lang_sense_clarification": "изображать внешне"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装出",
                                "target_lang_sense_clarification": "伪装出某种神态或样子"
                            },
                            {
                                "target_lang_word": "假装",
                                "target_lang_sense_clarification": "故意表现出某种虚假的状态"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "przybierać",
                                "target_lang_sense_clarification": "przyjmować sztuczną postawę lub wyraz twarzy"
                            },
                            {
                                "target_lang_word": "udawać",
                                "target_lang_sense_clarification": "stwarzać pozory posiadania jakiejś cechy"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}