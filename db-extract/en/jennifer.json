                "forms": [],
                "senses": [
                    {
                        "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                        "entry_id": "9a0e91ec-ed10-3229-9df0-3c1228c67429",
                        "glosses": [
                            "A female given name from Cornish, Middle Cornish, or Proto-Brittonic."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "998d4d44-ba25-471f-93f0-435197723b5d",
                                "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                "text": "RIDGEON. Thats a wonderful drawing. Why is it called Jennifer?\nMRS DUBEDAT. My name is Jennifer.\nRIDGEON. A strange name.\nMRS DUBEDAT. Not in Cornwall. I am Cornish. It's only what you call Guinevere."
                            },
                            {
                                "example_id": "1814917f-036a-43cf-bd2b-4725a6f1cab1",
                                "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                "text": "\"Most people's sisters have decent names like Jennifer or Jane or something. What did you say hers was?\""
                            },
                            {
                                "example_id": "9d97a681-5883-4270-87e8-fe97cabd225b",
                                "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                "text": "Jennifer. Jenny with the light brown hair. Jenny-fair, their high school French teacher had called her, and fair she had been."
                            },
                            {
                                "example_id": "d7991506-179e-44f3-be44-e908ed4578c8",
                                "sense_id": "3fa978ea-71e4-3082-a863-8c186a3ecfba",
                                "text": "“When it comes to the dry skin, it’s really a matter of that top barrier that’s not holding onto the moisture as well,” said Dr. Jennifer Stein, a dermatologist at NYU Langone Health."
                            }
                        ]
                    }
                ],
