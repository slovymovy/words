                            "vorübergehenden Zustand"
                        ],
                        "examples": [
                            {
                                "example_id": "6136efa6-405d-4bbe-9f14-9ad5f5d9fb47",
                                "sense_id": "b676946a-63a4-37a4-a4f6-a94e66dad105",
                                "text": "Es herrschte eine lange Dürreperiode — darunter litten viele Menschen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "4c357f69-1c67-3aa0-aa27-dc0ee8bcf46b",
                        "entry_id": "16bbbcce-0c72-3777-86d7-16531a005705",
                        "glosses": [
                            "zwischen diesen Dingen"
                        ],
                        "tags": [
                            "bezogen auf eine Anzahl bestimmter Dinge"
                        ],
                        "examples": [
                            {
                                "example_id": "b0f9adc7-1f40-49fa-b68f-2180fd66e721",
                                "sense_id": "4c357f69-1c67-3aa0-aa27-dc0ee8bcf46b",
                                "text": "In dem Album waren viele Briefmarken, aber es waren nur wenige wertvolle darunter."
                            },
                            {
                                "example_id": "cfc9fbbc-11f1-434b-9c54-977af0b08b5d",
                                "sense_id": "4c357f69-1c67-3aa0-aa27-dc0ee8bcf46b",
                                "text": "Man habe drei Personen festgenommen. Darunter sei eine Frau gewesen."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
