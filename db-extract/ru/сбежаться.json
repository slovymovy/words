                        "form": "сбежа́вшийся"
                    },
                    {
                        "form_id": "fefc7443-8d15-44e9-804e-da0e3ecb08bf",
                        "entry_id": "ad96a318-9a45-39db-a64a-4ff5c70e4ab2",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "сбежа́вшись"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "103a80d8-3dae-3f47-bd47-5cadf98b7db7",
                        "entry_id": "ad96a318-9a45-39db-a64a-4ff5c70e4ab2",
                        "glosses": [
                            "быстро собраться в одном месте, прибежать из разных мест"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "134838d8-25ca-406c-bc5f-93e9396255c7",
                                "sense_id": "103a80d8-3dae-3f47-bd47-5cadf98b7db7",
                                "text": "Корсаков засуетился, стал звонить изо всей мочи; люди сбежались; он стал поспешно одеваться."
                            },
                            {
                                "example_id": "d13a2d2b-d94b-42aa-9fa4-c5ca8a0e221b",
                                "sense_id": "103a80d8-3dae-3f47-bd47-5cadf98b7db7",
                                "text": "…если соседи увидят в ночных окнах свет, они подумают, что что-нибудь случилось, и сбегутся…"
                            },
                            {
                                "example_id": "ec09eac1-2eba-4f2f-bcc3-ae2626dec3e8",
                                "sense_id": "103a80d8-3dae-3f47-bd47-5cadf98b7db7",
                                "text": "На шум сбежалась родня, дюжина кривоногих и патриархальных приживалок."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb911992-4442-3850-bc75-18677edc83b1",
                        "entry_id": "ad96a318-9a45-39db-a64a-4ff5c70e4ab2",
                        "glosses": [
                            "перен., разг. соединиться, слиться, сойтись воедино (о дорогах, реках и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5d519f1-942a-47c9-98b8-fcbd45cfe2dd",
                                "sense_id": "eb911992-4442-3850-bc75-18677edc83b1",
                                "text": "Поприслушаться к говоркам ― со страхом услышать: в шумную половодную реку грозили сбежаться малые ручейки."
                            }
                        ]
                    },
                    {
                        "sense_id": "de27b20d-ada3-3fe7-8071-c220b1feda53",
                        "entry_id": "ad96a318-9a45-39db-a64a-4ff5c70e4ab2",
                        "glosses": [
                            "рег. (Юг) : то же, что сесть; уменьшиться в размере (обычно после стирки)"
                        ],
                        "tags": [
                            "об одежде"
                        ],
                        "examples": [
                            {
                                "example_id": "99bba93d-d08b-4953-9d3f-68a4e7b8ac40",
                                "sense_id": "de27b20d-ada3-3fe7-8071-c220b1feda53",
                                "text": "Однако нужно быть очень осторожным при чистке таких изделий, так как при стирке в воде шерсть смягчается от влаги и тепла, и, как следствие, изделие может сбежаться."
                            },
                            {
                                "example_id": "87296616-a8dd-4625-9956-3a19f04e0f49",
                                "sense_id": "de27b20d-ada3-3fe7-8071-c220b1feda53",
                                "text": "Свитер шерстяной сбежался, хотя я стирала его по инструкции"
                            }
                        ]
                    },
                    {
                        "sense_id": "3260f924-a2ce-3f90-b1ea-967da1857262",
                        "entry_id": "ad96a318-9a45-39db-a64a-4ff5c70e4ab2",
                        "glosses": [
                            "перен., разг. то же, что сойтись; начать сожительство, брак"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c25dd84-5472-46e1-84cc-1b0d7219a437",
                        "source_entry_id": "ad96a318-9a45-39db-a64a-4ff5c70e4ab2",
                        "source_sense_description": "быстро собраться в одном месте, прибежать из разных мест",
                        "target_lang_word": "come running",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "come running",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d116b9f1-99b4-33df-9cdf-53e3dc445acf",
                                        "entry_id": "209b9103-e618-353a-8fb6-0d7bdbfa844c",
                                        "glosses": [
                                            "To run towards somebody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3409d48c-8420-41d4-ab77-28fc39661f7c",
                                                "sense_id": "d116b9f1-99b4-33df-9cdf-53e3dc445acf",
                                                "text": "The burnt and bleeding man staggered to his feet, dazed and unbelieving, and asked the startled townspeople who came running whether his fireman and guard were safe. He was kept away from the smouldering crater where his engine had been, and taken to hospital."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19ac877d-78c4-3f6c-a617-bf6784c19df5",
                                        "entry_id": "209b9103-e618-353a-8fb6-0d7bdbfa844c",
                                        "glosses": [
                                            "To come quickly to somebody's aid or assistance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c803de04-8481-4bda-be33-3439ae333201",
                                                "sense_id": "19ac877d-78c4-3f6c-a617-bf6784c19df5",
                                                "text": "I see these sleepless nights and\nI count every tear you cry\nCall my name,\n I'll come running"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a962520-64bf-4f76-b9b8-f0ad895d4108",
                        "source_entry_id": "ad96a318-9a45-39db-a64a-4ff5c70e4ab2",
                        "source_sense_description": "быстро собраться в одном месте, прибежать из разных мест",
                        "target_lang_word": "acudir",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acudir",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bbe6cf36-4411-3395-939a-b0ba091f116f",
                                        "entry_id": "bf485561-47eb-38a8-9014-509193cf3cf8",
                                        "glosses": [
                                            "Ir, acompañar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff9a7e28-071e-4636-abf1-8f7684840b19",
                                                "sense_id": "bbe6cf36-4411-3395-939a-b0ba091f116f",
                                                "text": "El doctor Juvenal Urbino lo percibió desde que entró en la casa todavía en penumbras, adonde había acudido de urgencia a ocuparse de un caso que para él había dejado de ser urgente desde hacía muchos años."
                                            },
                                            {
                                                "example_id": "b619f63c-012f-4776-9528-c6cd20c7cff6",
                                                "sense_id": "bbe6cf36-4411-3395-939a-b0ba091f116f",
                                                "text": "La ceremonia estuvo marcada por la actuación de un grupo reducido de personas que acudió a la concentración de protesta, entre ellos algunos familiares de víctimas de Paracuellos, en parte convocados por un portal de Internet de inspiración católica."
                                            },
                                            {
                                                "example_id": "d16ac75a-5417-42c9-b74d-0f429c61f5ea",
                                                "sense_id": "bbe6cf36-4411-3395-939a-b0ba091f116f",
                                                "text": "El ejército italiano, partiendo de Libia (colonia suya), ataca las tropas británicas y de la Commonwealth en Egipto, pero fue casi derrotado y Alemania acudió en su auxilio."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "25880f70-79ec-343a-9fca-3f7fba2a682e",
                                        "entry_id": "bf485561-47eb-38a8-9014-509193cf3cf8",
                                        "glosses": [
                                            "Ayudar, apoyar."
                                        ],
