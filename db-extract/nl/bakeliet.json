                                        "sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                                        "entry_id": "8223d1fb-b6cc-3a41-bd6d-39b0ef15a0ee",
                                        "glosses": [
                                            "Matériau constitué à partir d’une résine de formaldéhyde de phénol thermodurcissable aussi appelée phénoplaste. Ce fut le premier plastique fait de polymères synthétiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "382d040f-74bf-4674-9ef9-e599bc79b38a",
                                                "sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                                                "text": "Tes petits seins de Bakélite, qui s’agitent."
                                            },
                                            {
                                                "example_id": "1b81afca-0d13-4c6d-9fdb-d345e7e77b79",
                                                "sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                                                "text": "L’homme appuya sur un petit bouton en Bakélite verte, incrusté sur la droite de l’appareil."
                                            },
                                            {
                                                "example_id": "f64595cf-7f63-4b8a-b65e-dc69c01caa0f",
                                                "sense_id": "54932c90-10c1-385c-a781-3fac3b885b29",
                                                "text": "Légère, résistante à la chaleur et à de nombreux produits chimiques, la bakélite est un excellent isolant électrique, qui a été rapidement adopté par l'industrie de construction électrique."
                                            }
                                        ]
