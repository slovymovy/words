                                        "entry_id": "a384a5dd-6d0e-3149-8269-f91b4016f78c",
                                        "glosses": [
                                            "The area of central nervous system that includes all higher nervous centers, enclosed within the skull and continuous with the spinal cord; synonym of brain."
                                        ],
                                        "tags": [],
