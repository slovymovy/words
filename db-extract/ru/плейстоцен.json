                "senses": [
                    {
                        "sense_id": "f2ea9a3b-9f53-3b92-afd8-8e79af121d20",
                        "entry_id": "771dfa5f-a5bf-360f-8145-673417ecf487",
                        "glosses": [
                            "геол. эпоха четвертичного периода, следующая за плиоценом и предшествующая голоцену; шестая эпоха кайнозойской эры геологического летоисчесления Земли, нижнее подразделение антропогена, характеризующееся появлением относительно большого количества новых форм жизни"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00b4d68f-9580-4da0-a295-476d1d0d80ed",
                        "source_entry_id": "771dfa5f-a5bf-360f-8145-673417ecf487",
                        "source_sense_id": "f2ea9a3b-9f53-3b92-afd8-8e79af121d20",
                        "target_lang_word": "Pleistocene",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pleistocene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "378d66f3-6311-3be2-a781-189f3f61d09c",
                                        "entry_id": "3ff86171-a6a9-37c7-a0b5-bc6251c52189",
                                        "glosses": [
                                            "Of a geologic epoch within the Quaternary period from about 2,588,000 to 11,700 years ago (earlier definition 1.7 million to 11,000 years ago); marked by the evolution of man, and the extinction of the large mammals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Pleistocene",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                                        "entry_id": "52df202c-1959-307c-b1a7-cd13f065f007",
                                        "glosses": [
                                            "The Pleistocene epoch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e91b8b68-8d55-48cf-a2f5-88293c60ce77",
                                                "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                                                "text": "A prehistoric site of late Pleistocene age, which was especially prepared for our visit, was seen at Ting-ts'un, above the Fen River (Shansi)."
                                            },
                                            {
                                                "example_id": "3cf5beac-bbeb-41b1-9920-caae0799d442",
                                                "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                                                "text": "Throughout the Pleistocene, climatic changes exerted another type of selective pressure on human biological evolution, contributing to the rapid emergence of various Homo species over time."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0d692c9-44ec-4b9e-99cd-3931785bd189",
                        "source_entry_id": "771dfa5f-a5bf-360f-8145-673417ecf487",
                        "source_sense_id": "f2ea9a3b-9f53-3b92-afd8-8e79af121d20",
                        "target_lang_word": "pleistoceno",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleistoceno",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "69ded531-6a49-3457-bb38-82edf503793c",
                                        "entry_id": "5176287a-4c0a-3c07-a6b2-ef8904e5f845",
                                        "glosses": [
                                            "Perteneciente o relacionado con el período geológico más antiguo del Cuaternario. Precedido por el Plioceno y seguida del Holoceno (ultimos 10.000 años). Es también la tercera época del período Neógeno, y la sexta de la era Cenozoica. Es una época geológica, que se encuentra comprendida entre los 1.8-1.6 millones y los 10.000 años antes del presente."
                                        ],
                                        "tags": [
                                            "masculine",
                                            "noun"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c039466-5853-4889-a19f-77cb98092134",
                        "source_entry_id": "771dfa5f-a5bf-360f-8145-673417ecf487",
                        "source_sense_id": "f2ea9a3b-9f53-3b92-afd8-8e79af121d20",
                        "target_lang_word": "pleistocene",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pleistocene",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "d03659f3-29f2-3238-94d5-a879532cedc1",
                                        "entry_id": "fc648f7e-8bbe-3f56-b06d-d33a8ee0c6f1",
                                        "glosses": [
                                            "prima epoca, iniziata due milioni e mezzo di anni fa, del periodo quaternario o neozoico, caratterizzato dall'apparizione dell'uomo e dal verificarsi di grandi glaciazioni"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11c3221a-d891-4a74-9ced-da595a5672bb",
                                                "sense_id": "d03659f3-29f2-3238-94d5-a879532cedc1",
                                                "text": "l'uomo di Neardenthal è un uomo del pleistocene medio e si estingue in quello superiore"
                                            },
                                            {
                                                "example_id": "ec19c1a5-667c-4f30-913c-1dede80e4257",
                                                "sense_id": "d03659f3-29f2-3238-94d5-a879532cedc1",
                                                "text": "Il Pleistocene inferiore inizia 2,588 milioni di anni fa e si conclude intorno a 781.000 anni fa"
                                            },
                                            {
                                                "example_id": "c371c3bf-e525-49cf-b0d3-73add7e9d84e",
                                                "sense_id": "d03659f3-29f2-3238-94d5-a879532cedc1",
                                                "text": "il pleistocene medio è un periodo che intercorre tra 774.000 e 129.000 anni fa durante il quale è nato l' Homo sapiens, Homo neanderthalensis, Homo floresiensis, Homo naledi e l'Homo heidelbergensis"
                                            },
                                            {
                                                "example_id": "8abe4c28-9fb2-4ac9-8e68-e3d899ae8498",
                                                "sense_id": "d03659f3-29f2-3238-94d5-a879532cedc1",
                                                "text": "Pleistocene superiore inizia 128.000 anni fa e termina 12.000 ani fa"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f082611a-04ac-40e2-8c44-eb56f9bf7619",
                        "source_entry_id": "771dfa5f-a5bf-360f-8145-673417ecf487",
                        "source_sense_id": "f2ea9a3b-9f53-3b92-afd8-8e79af121d20",
                        "target_lang_word": "Pleistozän",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pleistozän",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                        "entry_id": "b70393e2-4db1-3f65-91b3-cff337f2c5c9",
                                        "glosses": [
                                            "erdgeschichtliche Epoche, geprägt durch mehrere Eiszeiten, die vor etwa 2,4 Mio. Jahren begann und vor etwa 11.300 Jahren endete"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f29ec31-8236-4fb4-a0eb-7ef9bbb18ffd",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "Das Pleistozän wurde abgelöst vom Holozän."
                                            },
                                            {
                                                "example_id": "68712073-326f-4ea9-a4fc-097332fe9553",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "Im Pleistozän bedeckte das Eis bis zu 30% des gesamten Festlandes."
                                            },
                                            {
                                                "example_id": "cd145417-15ce-4c02-930e-bc34c0061194",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Zu dieser Zeit herrschten in Mitteleuropa noch kaltzeitliche Verhältnisse mit deutlich geringeren Jahresmitteltemperaturen als heute, die - abgesehen von kurzen Wärmeschwankungen - für fast das gesamte damals ausklingende Pleistozän, das Eiszeitalter, kennzeichnend waren.“"
                                            },
                                            {
                                                "example_id": "d00e6573-25a1-45cc-b78a-be3efc12e97f",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Im Pleistozän herrschten in Europa mehrere Eiszeiten.“"
                                            },
                                            {
                                                "example_id": "d8b73ce5-4bd9-436f-8fef-cfea21d6fc88",
                                                "sense_id": "b86d34a0-bc95-3d4d-92cb-5e4c11316d2d",
                                                "text": "„Im mittleren Pleistozän wirkten sich die klimatischen Bedingungen der Eiszeiten auf die biologische und kulturelle Evolution des Frühmenschen aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
