                        "examples": [
                            {
                                "example_id": "9c2d20cd-809c-48f6-85c0-0053bebf63c3",
                                "sense_id": "0c444561-4690-3690-9487-435953e58c32",
                                "text": "Cette verve dans la fantasmagorie n’est guère moindre que pour le makemono de Li Long-mien, et a pu provoquer entre telle image d’Europe et de Chine une ressemblance fortuite."
                            },
                            {
                                "example_id": "2becb09e-b5bd-4d42-8ae2-51c573ce0b08",
                                "sense_id": "0c444561-4690-3690-9487-435953e58c32",
                                "text": "Et ces montagnes plus dentelées, plus bizarres, plus japonaises que les montagnes de l’autre rive, évoquent une plus parfaite image des paysages que les vieux peintres fantasques peignirent sur le papier de riz des makemonos."
                            }
                        ]
                    }
