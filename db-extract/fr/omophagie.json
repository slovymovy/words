                                        "glosses": [
                                            "The eating of raw flesh."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29eb2508-a0d9-491b-900f-0e33f579577e",
                                                "sense_id": "196c7d28-9771-38c1-a92e-81e72fec00c5",
                                                "text": "Omophagy, ritual eating of raw flesh, is the assimilation and internalization of godhead."
                                            }
                                        ]
                                    }
