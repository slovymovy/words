                ],
                "senses": [
                    {
                        "sense_id": "f1cf8af8-d0e3-3717-8cc8-8578d52d0dbd",
                        "entry_id": "5b7de374-bacb-36a3-af7a-387211c27f0a",
                        "glosses": [
                            "Donner un caractère sibérien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eb7f92e-e5c2-4917-b6f0-7b874cb9c114",
                                "sense_id": "f1cf8af8-d0e3-3717-8cc8-8578d52d0dbd",
                                "text": "Le Morvan n’a que deux villes supérieures à la pauvre dignité de chef-lieu de canton : l’abrupte, la pittoresque Avallon et Château-Chinon, la cité la plus élevée de tout le bassin de la Seine, encore qu’elle n’ait même pas 600 mètres d'altitude, tout près du sommet de la montagne du Guet, d’où se déroule un grand panorama souvent sibérianisé par la neige."
                            },
                            {
                                "example_id": "c39a9025-a6a4-4ff4-8da2-517e04c133a2",
                                "sense_id": "f1cf8af8-d0e3-3717-8cc8-8578d52d0dbd",
                                "text": "Les Bouriales du Baïkal et d’Irkoulsk sont russifiés ou, plus exactement, sibérianisés depuis plus de deux siècles."
                            }
                        ]
                    },
                    {
                        "sense_id": "389b3ac6-75b4-3383-aaaf-148385244ce1",
                        "entry_id": "5b7de374-bacb-36a3-af7a-387211c27f0a",
                        "glosses": [
                            "Envoyer en Sibérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7483fb87-bfac-4541-a7b6-5a33f461cfac",
                                "sense_id": "389b3ac6-75b4-3383-aaaf-148385244ce1",
                                "text": "Mais le passage des idées aux actes ne fut pas du goût de Catherine et les deux plus remarquables représentants de ce « voltairianetz », Radichey et Novikov, furent alors sibérianisés."
                            }
                        ]
                    }
                ],
