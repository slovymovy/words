                        "glosses": [
                            "Saillie plus ou moins prononcée de la cavité intérieure du péricarpe qui sert de support ou de point d’attache aux graines."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfb60683-c3e9-449e-9186-471794260df1",
                                "sense_id": "c71267bb-14a7-3229-b666-e284f6487cdf",
                                "text": "Les ovaires sont au nombre de deux, soudées à leur base : le fruit est un follicule, simple ou double, contenant un grand nombre de graines attachées à un trophosperme uni d'abord à la suture, mais qui devient libre quand le fruit s'ouvre."
                            },
                            {
                                "example_id": "3caa1868-8637-4301-a272-d445be0f3840",
                                "sense_id": "c71267bb-14a7-3229-b666-e284f6487cdf",
                                "text": "Le fruit est une pyxide, à une loge renfermant un grand nombre de graines, à surface chagrinée, rattachées à un trophosperme central."
                            }
                        ]
                    }
