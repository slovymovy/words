                                "sense_id": "cca74958-d499-3738-b05c-5047c58879f6",
                                "text": "The enactment of this law will be a great step backward for our country."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfeb495d-3fc7-3015-b681-98f978f3b713",
                        "entry_id": "81167367-e8df-3869-ba21-5d8658c80894",
                        "glosses": [
