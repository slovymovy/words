                "senses": [
                    {
                        "sense_id": "e5418adc-cd84-3a42-80d5-1452c9caac8f",
                        "entry_id": "d92a54f7-1752-3510-bd1e-0618e8ef13e7",
                        "glosses": [
                            "Architecte de grande notoriété, élevé au rang de star."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d4140ae-be44-434d-8573-ba06f10782d1",
                                "sense_id": "e5418adc-cd84-3a42-80d5-1452c9caac8f",
                                "text": "Alors que Montréal s’enorgueillit tout juste d’avoir déniché son starchitecte, Paul Andreu, Toronto, elle, en a déjà plus d’un."
                            },
                            {
                                "example_id": "9a23af55-dfc6-4c67-80f1-757c484b14a8",
                                "sense_id": "e5418adc-cd84-3a42-80d5-1452c9caac8f",
                                "text": "Le vieux port, complètement réaménagé par le « starchitecte » génois Renzo Piano en 1992 à l’occasion du 500ᵉ anniversaire de la découverte de l’Amérique par Christophe Colomb, est aujourd’hui animé de nombreuses attractions familiales […]"
                            },
                            {
                                "example_id": "7ed59def-1eb8-4f9c-9b81-147a42ee1534",
                                "sense_id": "e5418adc-cd84-3a42-80d5-1452c9caac8f",
                                "text": "Tout le contraire de l’architecture du grand geste, du cri, du « j’existe, alors je fais un truc différent » de certains de nos starchitectes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d31f714b-7483-4f36-99fc-7052161107d4",
                        "source_entry_id": "d92a54f7-1752-3510-bd1e-0618e8ef13e7",
                        "source_sense_id": "e5418adc-cd84-3a42-80d5-1452c9caac8f",
                        "target_lang_word": "starchitect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starchitect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cc1b6b1a-f83a-3035-b0d9-25eda7532e62",
                                        "entry_id": "6ae5f610-cb48-3e8d-ae50-cac705651d88",
                                        "glosses": [
                                            "A celebrity architect."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "296a6af1-19c8-4d00-b421-ddc707bfd41d",
                                                "sense_id": "cc1b6b1a-f83a-3035-b0d9-25eda7532e62",
                                                "text": "Others are timelessly provocative; the stacked tubes of “Museum Design Based on a Cigarette Package” might have been dreamed up by a starchitect."
                                            },
                                            {
                                                "example_id": "ef3ea56f-2056-49bb-b013-b5873cc3bb7f",
                                                "sense_id": "cc1b6b1a-f83a-3035-b0d9-25eda7532e62",
                                                "text": "Gehry is more than an architect—he is a starchitect, a neologism coined to describe the small band of elite international architects whose personal brands transcend their buildings."
                                            },
                                            {
                                                "example_id": "db03f9f5-413b-4e9b-9992-ae84a09b85d2",
                                                "sense_id": "cc1b6b1a-f83a-3035-b0d9-25eda7532e62",
                                                "text": "Despite this starchitect presence, Quito is not Manhattan and La Carolina is not Central Park."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
