        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "79c1b0b2-0a42-3b5f-91c3-e1ae4428b495",
                    "sense_definition": "To make sense or be logical; often used in the negative to indicate something is confusing or contradictory.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "math_science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I tried to understand his explanation, but the math isn't <w>mathing</w>.",
                            "target_lang_translations": {
                                "ru": "Я пытался понять его объяснение, но что-то не <w>сходится</w>.",
                                "zh": "我试着理解他的解释，但逻辑上根本<w>说不通</w>。"
                            }
                        },
                        {
                            "text": "Her excuse just doesn't <w>math</w> given the evidence.",
                            "target_lang_translations": {
                                "ru": "Её оправдание просто не <w>стыкуется</w> с имеющимися уликами.",
                                "zh": "考虑到现有的证据，她的借口根本<w>对不上</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "math isn't mathing"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь смысл или быть логичным; часто используется в сленге для выражения недоумения.",
                        "zh": "指合乎逻辑或说得通；常用于否定句，表示某事令人困惑或自相矛盾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сходиться",
                                "target_lang_sense_clarification": "быть логичным"
                            },
                            {
                                "target_lang_word": "стыковаться",
                                "target_lang_sense_clarification": "соответствовать фактам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "说得通",
                                "target_lang_sense_clarification": "逻辑上合理"
                            },
                            {
                                "target_lang_word": "对得上",
                                "target_lang_sense_clarification": "事实或逻辑相符"
                            }
                        ]
                    }
                }
            ]
