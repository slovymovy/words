                        "examples": [
                            {
                                "example_id": "7b41eb2e-4f4d-4afe-a938-efab04081937",
                                "sense_id": "0f7d3fc0-5bab-3b7a-941c-0f572a4f0519",
                                "text": "„Der Bundesnachrichtendienst wusste Bescheid über das Versteck des flüchtigen Diktators Gaddafi.“"
                            },
                            {
                                "example_id": "bdbb0c28-1beb-41d7-87e8-3aa4443d946a",
                                "sense_id": "0f7d3fc0-5bab-3b7a-941c-0f572a4f0519",
                                "text": "„Sein Vater war ein hohes Tier beim Bundesnachrichtendienst, was ihm peinlich war.“"
                            }
