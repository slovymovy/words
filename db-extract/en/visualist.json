                        "glosses": [
                            "A person with a strong visual sense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de31c16c-bf4a-4d2c-8bd9-642c4fc745e8",
                                "sense_id": "eb2ace05-a35c-342b-8151-1654e39bd8ab",
                                "text": "It is not necessary to keep talking to children about imagery. It is rather better to suggest the scene and give them time to image it for themselves. Many children are naturally pretty strong visualists."
                            },
                            {
                                "example_id": "81f3d2a3-e46f-4805-88b9-64e57e266cba",
                                "sense_id": "eb2ace05-a35c-342b-8151-1654e39bd8ab",
                                "text": "There are, too, less subtle kinds of suggestion — the use of colour words, for instance. Some of us are bad visualists; the poet may describe meadows and lakes, mountains and oceans, but we cannot see them; […]"
                            }
                        ]
                    }
