                "senses": [
                    {
                        "sense_id": "a870ad11-db74-3ce2-a00a-d425fc1eaf77",
                        "entry_id": "6c5991d4-dbfc-3062-abe9-c6e87483069a",
                        "glosses": [
                            "Mensch, der wegen seiner Eigenschaften als widerlich angesehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd6d807-f4e1-4fd0-8f12-ac32696bd6a4",
                                "sense_id": "a870ad11-db74-3ce2-a00a-d425fc1eaf77",
                                "text": "Der US-Schauspieler Larry Hagman hat dem vielleicht bösesten Fernseh-Fiesling aller Zeiten ein Gesicht gegeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "451cbc59-c403-4e1b-8fe5-46b9532c0f1d",
                        "source_entry_id": "6c5991d4-dbfc-3062-abe9-c6e87483069a",
                        "source_sense_id": "a870ad11-db74-3ce2-a00a-d425fc1eaf77",
                        "source_sense_description": "Mensch, der wegen seiner Eigenschaften als widerlich angesehen wird",
                        "target_lang_word": "meanie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "meanie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddc3aeca-0dc5-3901-999a-2bfed251cbae",
                                        "entry_id": "9336946b-997e-340e-b134-b5adb714b14b",
                                        "glosses": [
                                            "A mean (unkind or miserly) person; a killjoy."
                                        ],
                                        "tags": [
                                            "childish",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cecbd19-8146-439c-ae46-355f17e25464",
                                                "sense_id": "ddc3aeca-0dc5-3901-999a-2bfed251cbae",
                                                "text": "Teacher kept me in after school again. What a meanie!"
                                            },
                                            {
                                                "example_id": "bab3f987-0f33-46b9-a297-f7ae7fc63bb3",
                                                "sense_id": "ddc3aeca-0dc5-3901-999a-2bfed251cbae",
                                                "text": "That meanie wouldn't even lend me the bus fare."
                                            },
                                            {
                                                "example_id": "46b57f26-e709-42b7-b350-327c8c6d76b8",
                                                "sense_id": "ddc3aeca-0dc5-3901-999a-2bfed251cbae",
                                                "text": "The indigent health-care bill died in the waning moments of the session, killed by Republican Representative Bill Ceverha of Dallas, a notorious meanie."
                                            },
                                            {
                                                "example_id": "17299f43-b261-4d04-8e6f-8097765cf479",
                                                "sense_id": "ddc3aeca-0dc5-3901-999a-2bfed251cbae",
                                                "text": "With a few gentle words, you calm Frank to a point of incoherent babbling and send him back to his office with a promise that you will do something to fight off those meanies and save the company from utter destruction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8227dc0e-4b81-3ab3-8762-46d8f115d221",
                                        "entry_id": "9336946b-997e-340e-b134-b5adb714b14b",
                                        "glosses": [
                                            "A villain."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1175c4df-b4e0-4fce-8a34-f83abae348b1",
                                                "sense_id": "8227dc0e-4b81-3ab3-8762-46d8f115d221",
                                                "text": "If you like your wrestling rough, we've had besides such old and revered roughies as Lisowski, Schmidt, Herman, etc., some great new meanies."
                                            },
                                            {
                                                "example_id": "7f4ad105-2ccb-4884-8aa7-a06188827721",
                                                "sense_id": "8227dc0e-4b81-3ab3-8762-46d8f115d221",
                                                "text": "More energy for Bliss to pursue the depraved denizens of Gotham, the meanies who lurked in the shadows, who left the messes and spills he and his partner Ward were constantly cleaning up."
                                            },
                                            {
                                                "example_id": "277f1b9e-3382-4f27-8ccc-abb879466759",
                                                "sense_id": "8227dc0e-4b81-3ab3-8762-46d8f115d221",
                                                "text": "It starts out as a friendly yeast among the beneficial microbes in your intestines but morphs into a meanie if you indulge in what is called the Western diet—a diet high in sugar, red meat, white flour, and processed foods."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
