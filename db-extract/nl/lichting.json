                "translations": [
                    {
                        "translation_id": "45f80260-bdf7-40df-b23d-03507d9c901e",
                        "source_entry_id": "e7918847-b853-3343-83e2-6a439c95aec1",
                        "source_sense_id": "269c9942-be63-308d-be4f-f829c26332b2",
                        "target_lang_word": "Altersklasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altersklasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                        "entry_id": "08375553-9511-3acb-a9f5-0eed022cad78",
                                        "glosses": [
                                            "Gruppe von Personen (oder auch anderen Lebewesen) gleichen Alters/gleicher Altersspanne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a6c9034-95f2-4947-bab7-0d4e644eda33",
                                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                                "text": "„Da es mit 560 Athleten auch die vollste Altersklasse war, kam Hoffnung auf, dass ich mit etwas Glück einen Slotfür dieIronman-70.“"
                                            },
                                            {
                                                "example_id": "713907b5-4001-4797-84d4-348f254bfce0",
                                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                                "text": "„Diese Größe drückt jene Wahrscheinlichkeit aus, die Individuen der jeweiligen Altersklasse haben, innerhalb dieser Zeitspanne zu sterben.“"
                                            },
                                            {
                                                "example_id": "8467c43d-7722-4240-8913-ba763a753013",
                                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                                "text": "„Die Unterschiede machen sich besonders bei den mittleren und höheren Altersklassen bemerkbar.“"
                                            },
                                            {
                                                "example_id": "d5e0590c-ff63-464b-815b-57d92591bd60",
                                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                                "text": "„Wie aus der Tabelle 8 zu entnehmen ist, erreichen in der Altersklasse von 16–30 Jahren die Ak-Mengen bei den HL-Ak den höchsten Wert überhaupt.“"
                                            },
                                            {
                                                "example_id": "13997817-6db0-4b91-8c1e-df1b8589855a",
                                                "sense_id": "6228dd43-683a-3313-a8f2-544eaa0e16d8",
                                                "text": "„Zum anderen sollte ermittelt werden, aus welcher Altersklasse diese Kundinnen mehrheitlich stammen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "626b0726-45e9-4980-a78e-2b8a0e428f22",
                        "source_entry_id": "e7918847-b853-3343-83e2-6a439c95aec1",
                        "source_sense_id": "269c9942-be63-308d-be4f-f829c26332b2",
                        "target_lang_word": "Jahrgang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jahrgang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "00dd5d1a-5039-3ff9-8834-22bedd981591",
                                        "entry_id": "0f39ba45-bdbe-30e2-96c4-d72fdf36448f",
                                        "glosses": [
                                            "Personen, die in einem bestimmten Jahr geboren sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90c8e69d-acff-421a-a1f8-25cd6053caab",
                                                "sense_id": "00dd5d1a-5039-3ff9-8834-22bedd981591",
                                                "text": "Ich bin Jahrgang 1970."
                                            },
                                            {
                                                "example_id": "bd33d614-71c9-4eb4-bcdb-793932848c88",
                                                "sense_id": "00dd5d1a-5039-3ff9-8834-22bedd981591",
                                                "text": "„Damals gab es vier Klassenzimmer, und die vier Lehrerinnen unterrichteten je zwei Jahrgänge.“"
                                            },
                                            {
                                                "example_id": "66343c67-3eaa-4a4e-a023-f8a096931d44",
                                                "sense_id": "00dd5d1a-5039-3ff9-8834-22bedd981591",
                                                "text": "Trinkst du mal Wein vom Rhein,",
                                                "translation": "(aus einem Rheinweinlied)"
                                            },
                                            {
                                                "example_id": "c29fbca9-ce56-487a-911f-630bbfbf8d75",
                                                "sense_id": "00dd5d1a-5039-3ff9-8834-22bedd981591",
                                                "text": "„Für die älteren und mittleren Jahrgänge unter uns war das noch eigene Lebenserfahrung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "93687e0a-dbc4-37c2-bfec-ba67ccb5dbec",
                                        "entry_id": "0f39ba45-bdbe-30e2-96c4-d72fdf36448f",
                                        "glosses": [
                                            "alle Produkte, die in einem bestimmten Jahr entstanden oder erschienen sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99255558-650c-4080-98ea-9e8e60a7d35e",
                                                "sense_id": "93687e0a-dbc4-37c2-bfec-ba67ccb5dbec",
                                                "text": "Trinkst du mal Wein vom Rhein,",
                                                "translation": "(aus einem Rheinweinlied)"
                                            },
                                            {
                                                "example_id": "263cb550-80ea-4752-a6d8-c32806a714e9",
                                                "sense_id": "93687e0a-dbc4-37c2-bfec-ba67ccb5dbec",
                                                "text": "Der Wein des Jahrgangs 2005 ist exzellent."
                                            },
                                            {
                                                "example_id": "d86a8248-0d35-4c21-820e-a497bdf79194",
                                                "sense_id": "93687e0a-dbc4-37c2-bfec-ba67ccb5dbec",
                                                "text": "Der Jahrgang 1994 des „Spiegel“ ist komplett vergriffen."
                                            },
                                            {
                                                "example_id": "5b46fda3-7ff9-413e-bc97-c302f7979d29",
                                                "sense_id": "93687e0a-dbc4-37c2-bfec-ba67ccb5dbec",
                                                "text": "„Nach 38 Jahrgängen erschien die letzte Ausgabe der lange Zeit wichtigsten literarisch-politischen Zeitschrift Deutschlands.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
