                                            {
                                                "example_id": "a111d040-6859-44eb-b505-c12783ad9df1",
                                                "sense_id": "cf38d4b3-febd-3a0b-85b6-045b2c6350fe",
                                                "text": "Hij koos een dusdanig bereik dat de meting niet van de schaal zou lopen."
                                            },
                                            {
                                                "example_id": "d42f6012-e297-472d-84b4-50addfd462f1",
                                                "sense_id": "cf38d4b3-febd-3a0b-85b6-045b2c6350fe",
                                                "text": "In dusdanige concentraties is deze stof niet bijster gevaarlijk."
                                            }
