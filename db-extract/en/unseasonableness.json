                "senses": [
                    {
                        "sense_id": "e296761b-f0de-30dc-8480-fcc19d4db5f5",
                        "entry_id": "b6befa90-9d68-3331-a14e-b85686ef7514",
                        "glosses": [
                            "The quality of being unseasonable; untimeliness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72394c42-7e25-4e9e-8049-8d989be4740b",
                                "sense_id": "e296761b-f0de-30dc-8480-fcc19d4db5f5",
                                "text": "[…] for notwithstanding his purse to buy provisions of the Country, and his Ships that wherever he went waited continually upon him, his Army through the unseasonableness of the weather, and want of Quarters, was so much harassed and wasted, many of his men falling sick and dying daily, that if he did not hasten to his Winter-quarters, he would in probability have perished without a blow […]"
                            },
                            {
                                "example_id": "07566fdf-d070-4de8-ab54-2d30f79c7d9e",
                                "sense_id": "e296761b-f0de-30dc-8480-fcc19d4db5f5",
                                "text": "A debauched person who lived in the parish came one night very late and demanded the keys of the church of the vicar, that he might ring a peal, which the vicar refused to let him have, alleging the unseasonableness of the time, and that he should, by granting his desires, give a disturbance to Sir George Wroughton and his family, whose house adjoined the churchyard."
                            },
                            {
                                "example_id": "93a6c4f5-c691-4c13-a637-3ee85f33a84c",
                                "sense_id": "e296761b-f0de-30dc-8480-fcc19d4db5f5",
                                "text": "I could not give any connected detail yesterday; but the suddenness, and, in one light, the unseasonableness with which the affair burst out, needs explanation […]"
                            }
                        ]
                    }
                ],
