                        "examples": [
                            {
                                "example_id": "6ddc18df-fc32-4da4-bc53-ef74fa3bb28a",
                                "sense_id": "2d3d0de8-655f-315f-b489-ae1eb093c78c",
                                "text": "„Die Anencephalie beschreibt das partielle Fehlen des Schädeldaches, der bedeckenden Haut und des Gehirns.“"
                            },
                            {
                                "example_id": "7bf7befa-8c6f-491d-b070-5433ac606564",
                                "sense_id": "2d3d0de8-655f-315f-b489-ae1eb093c78c",
                                "text": "\"Die Heilung oder Therapie einer Anenzephalie ist nicht möglich.\""
                            }
