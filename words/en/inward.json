                },
                {
                    "sense_id": "3d172229-b66c-3ae0-9fa9-37f8ec49cc6e",
                    "sense_definition": "Moving or directed toward the inside.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The door has an <w>inward</w> swing for safety reasons.",
                            "target_lang_translations": {
                                "zh": "出于安全考虑，这扇门是<w>向内</w>开启的。"
                            }
                        },
                        {
                            "text": "She felt an <w>inward</w> pressure to succeed in her new job.",
                            "target_lang_translations": {
                                "zh": "她感到有一种想要在工作中取得成功的<w>内心</w>压力。"
                            }
