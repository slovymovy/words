                                "target_senses": [
                                    {
                                        "sense_id": "e2ac4371-3a91-3a89-968a-abb8a2662e5a",
                                        "entry_id": "e91b2fe9-0932-3411-a342-9f2d335cae38",
                                        "glosses": [
                                            "In a stern manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e39e4ee0-3eff-44df-b067-6a6d2f464d13",
                                                "sense_id": "e2ac4371-3a91-3a89-968a-abb8a2662e5a",
                                                "text": "It was a historic night at Wembley Stadium that saw the European champions sternly tested by Copa America winners Brazil, but ended with the familiar sight of captain Leah Williamson lifting a trophy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
