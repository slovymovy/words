{
    "word_family": [
        "dripping",
        "drippy",
        "drip-dry",
        "drip-feed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "622a6ac4-f132-3b30-b177-a26094cf5fcb",
                    "sense_definition": "To fall one drop at a time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liquid-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The leaky faucet began to <w>drip</w> loudly in the middle of the night.",
                            "target_lang_translations": {
                                "ru": "Неисправный кран начал громко <w>капать</w> посреди ночи.",
                                "zh": "半夜里，漏水的龙头开始大声地<w>滴</w>水。",
                                "cs": "Kapající kohoutek začal uprostřed noci hlasitě <w>kapat</w>."
                            }
                        },
                        {
                            "text": "I could hear the water <w>drip</w> into the bucket from the ceiling.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как вода <w>капает</w> с потолка в ведро.",
                                "zh": "我能听到水从天花板<w>滴</w>进桶里的声音。",
                                "cs": "Slyšel jsem, jak voda ze stropu <w>kape</w> do kbelíku."
                            }
                        }
                    ],
                    "synonyms": [
                        "trickle",
                        "drop"
                    ],
                    "antonyms": [
                        "gush",
                        "pour"
                    ],
                    "common_phrases": [
                        "drip into",
                        "drip from"
                    ],
                    "target_lang_definitions": {
                        "ru": "Падать по одной капле за раз.",
                        "zh": "液体一滴一滴地落下。",
                        "cs": "Padat po jedné kapce."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капать",
                                "target_lang_sense_clarification": "о жидкости"
                            },
                            {
                                "target_lang_word": "протекать",
                                "target_lang_sense_clarification": "медленно пропускать жидкость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滴",
                                "target_lang_sense_clarification": "液体落下"
                            },
                            {
                                "target_lang_word": "滴漏",
                                "target_lang_sense_clarification": "因破损而缓慢滴水"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "kapat",
                                "target_lang_sense_clarification": "o tekutině padající po kapkách"
                            },
                            {
                                "target_lang_word": "odkapávat",
                                "target_lang_sense_clarification": "pomalu vytékat po kapkách"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "363ad1f6-44f7-311c-b167-ef77e89113b3",
                    "sense_definition": "To let fall in drops.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid-movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>drip</w> paint on the new carpet while you work.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>накапать</w> краской на новый ковер во время работы.",
                                "zh": "工作时小心别把油漆<w>滴</w>在新地毯上。",
                                "cs": "Při práci si dej pozor, abys <w>nekápl</w> barvu na nový koberec."
                            }
                        },
                        {
                            "text": "The chef decided to <w>drip</w> a little vinegar over the salad for extra flavor.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар решил <w>капнуть</w> немного уксуса в салат для дополнительного вкуса.",
                                "zh": "厨师决定在沙拉上<w>滴</w>一点醋来增加风味。",
                                "cs": "Šéfkuchař se rozhodl <w>kápnout</w> na salát trochu octa pro lepší chuť."
                            }
                        }
                    ],
                    "synonyms": [
                        "trickle",
                        "leak"
                    ],
                    "common_phrases": [
                        "drip oil",
                        "drip paint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Позволять жидкости падать каплями.",
                        "zh": "使液体呈滴状落下。",
                        "cs": "Nechat tekutinu padat po kapkách."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капать",
                                "target_lang_sense_clarification": "лить или ронять капли"
                            },
                            {
                                "target_lang_word": "накапать",
                                "target_lang_sense_clarification": "налить определенное количество капель"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滴",
                                "target_lang_sense_clarification": "使液体落下"
                            },
                            {
                                "target_lang_word": "滴入",
                                "target_lang_sense_clarification": "将液体滴入某处"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "kapat",
                                "target_lang_sense_clarification": "nechat padat kapky"
                            },
                            {
                                "target_lang_word": "kápnout",
                                "target_lang_sense_clarification": "nechat spadnout jednu nebo několik kapek"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd592233-77a0-37e1-848a-b3192501ca07",
                    "sense_definition": "To have a superabundance of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abundance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The duchess was <w>dripping</w> with jewels at the royal gala last night.",
                            "target_lang_translations": {
                                "ru": "Герцогиня была буквально <w>увешана</w> драгоценностями на вчерашнем королевском приеме.",
                                "zh": "昨晚的皇家晚宴上，公爵夫人<w>满身</w>珠宝。",
                                "cs": "Vévodkyně byla na včerejším královském galavečeru <w>ověšená</w> šperky."
                            }
                        },
                        {
                            "text": "His voice seemed to <w>drip</w> with sarcasm when he congratulated his rival.",
                            "target_lang_translations": {
                                "ru": "Его голос, казалось, <w>сочился</w> сарказмом, когда он поздравлял своего соперника.",
                                "zh": "当他祝贺对手时，他的声音里似乎<w>充满</w>了讽刺。",
                                "cs": "Jeho hlas při blahopřání soupeři přímo <w>překypoval</w> sarkasmem."
                            }
                        }
                    ],
                    "synonyms": [
                        "overflow",
                        "abound"
                    ],
                    "antonyms": [
                        "lack"
                    ],
                    "common_phrases": [
                        "drip with jewels",
                        "drip with sarcasm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь что-либо в избытке или преувеличенном количестве.",
                        "zh": "指某物极其丰富或表现出某种特质。",
                        "cs": "Mít něčeho nadbytek nebo být něčím výrazně obklopen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сочиться",
                                "target_lang_sense_clarification": "перен., об эмоциях или качествах"
                            },
                            {
                                "target_lang_word": "быть увешанным",
                                "target_lang_sense_clarification": "о драгоценностях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "满身",
                                "target_lang_sense_clarification": "形容佩戴大量珠宝"
                            },
                            {
                                "target_lang_word": "充满",
                                "target_lang_sense_clarification": "形容语气中带有某种情绪"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "překypovat",
                                "target_lang_sense_clarification": "mít něčeho velký nadbytek"
                            },
                            {
                                "target_lang_word": "být ověšený",
                                "target_lang_sense_clarification": "mít na sobě velké množství šperků"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "26e7d236-cb3a-35f0-8dca-29ca5fe895c8",
                    "sense_definition": "To whine or complain consistently; to grumble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "complaining",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He would constantly <w>drip</w> about the weather even when it was sunny.",
                            "target_lang_translations": {
                                "ru": "Он постоянно <w>ныл</w> по поводу погоды, даже когда было солнечно.",
                                "zh": "即使在晴天，他也总是对天气<w>抱怨</w>个不停。",
                                "cs": "Neustále si <w>stěžoval</w> na počasí, i když bylo slunečno."
                            }
                        },
                        {
                            "text": "The soldiers were told to stop <w>dripping</w> and get on with their duties.",
                            "target_lang_translations": {
                                "ru": "Солдатам велели перестать <w>ворчать</w> и приступить к своим обязанностям.",
                                "zh": "士兵们被告知停止<w>发牢骚</w>，继续执行任务。",
                                "cs": "Vojákům bylo řečeno, aby přestali <w>brblat</w> a věnovali se svým povinnostem."
                            }
                        }
                    ],
                    "synonyms": [
                        "whine",
                        "moan",
                        "grumble"
                    ],
                    "antonyms": [
                        "praise",
                        "rejoice"
                    ],
                    "common_phrases": [
                        "stop dripping"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Common in British military or nautical slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Постоянно ныть или жаловаться; ворчать.",
                        "zh": "持续地抱怨或发牢骚。",
                        "cs": "Neustále si stěžovat nebo brblat."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ныть",
                                "target_lang_sense_clarification": "жаловаться"
                            },
                            {
                                "target_lang_word": "капать на мозги",
                                "target_lang_sense_clarification": "разг., надоедать жалобами или поучениями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抱怨",
                                "target_lang_sense_clarification": "表达不满"
                            },
                            {
                                "target_lang_word": "发牢骚",
                                "target_lang_sense_clarification": "持续地抱怨"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "stěžovat si",
                                "target_lang_sense_clarification": "vyjadřovat nespokojenost"
                            },
                            {
                                "target_lang_word": "brblat",
                                "target_lang_sense_clarification": "neustále si nespokojeně mumlat"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "00a7cbf9-f347-36e2-9cf5-da07e4136410",
                    "sense_definition": "A small amount of liquid that falls in a spherical shape.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "liquid-unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I put a <w>drip</w> of vanilla extract in my hot cocoa for flavor.",
                            "target_lang_translations": {
                                "ru": "Я добавил <w>каплю</w> ванильного экстракта в горячее какао для вкуса.",
                                "zh": "我在热可可里加了一<w>滴</w>香草精来调味。",
                                "cs": "Do horkého kakaa jsem pro chuť přidal <w>kapku</w> vanilkového extraktu."
                            }
                        },
                        {
                            "text": "The <w>drip</w> of water from the ceiling was very annoying.",
                            "target_lang_translations": {
                                "ru": "<w>Капанье</w> воды с потолка очень раздражало.",
                                "zh": "天花板上水<w>滴</w>落的声音非常烦人。",
                                "cs": "<w>Kapání</w> vody ze stropu bylo velmi otravné."
                            }
                        }
                    ],
                    "synonyms": [
                        "drop",
                        "droplet"
                    ],
                    "common_phrases": [
                        "drip of water",
                        "catch the drips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество жидкости сферической формы.",
                        "zh": "一小滴液体。",
                        "cs": "Malé množství tekutiny kulovitého tvaru."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капля",
                                "target_lang_sense_clarification": "частица жидкости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "滴",
                                "target_lang_sense_clarification": "液体的量词或名词"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "kapka",
                                "target_lang_sense_clarification": "jednotka tekutiny"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdd60452-8186-386a-82ba-678b814e67db",
                    "sense_definition": "An apparatus that slowly releases a liquid, especially one that intravenously releases drugs into a patient's bloodstream.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical-equipment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was put on a <w>drip</w> to stay hydrated after the surgery.",
                            "target_lang_translations": {
                                "ru": "Пациенту поставили <w>капельницу</w>, чтобы избежать обезвоживания после операции.",
                                "zh": "术后为了保持水分，病人被挂上了<w>吊瓶</w>。",
                                "cs": "Pacientovi byla po operaci nasazena <w>kapačka</w>, aby se udržela hydratace."
                            }
                        },
                        {
                            "text": "The nurse checked the intravenous <w>drip</w> to ensure the medicine was flowing.",
                            "target_lang_translations": {
                                "ru": "Медсестра проверила внутривенную <w>капельницу</w>, чтобы убедиться, что лекарство поступает.",
                                "zh": "护士检查了静脉<w>输液</w>，以确保药物正常输入。",
                                "cs": "Sestra zkontrolovala nitrožilní <w>kapačku</w>, aby se ujistila, že lék proudí."
                            }
                        }
                    ],
                    "synonyms": [
                        "IV"
                    ],
                    "common_phrases": [
                        "on a drip",
                        "intravenous drip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аппарат для медленного введения жидкости, особенно внутривенно.",
                        "zh": "用于缓慢输送液体的医疗设备，常指静脉输液。",
                        "cs": "Zdravotnické zařízení pro pomalé podávání tekutin do krevního oběhu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капельница",
                                "target_lang_sense_clarification": "медицинское устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "输液",
                                "target_lang_sense_clarification": "医疗过程"
                            },
                            {
                                "target_lang_word": "吊瓶",
                                "target_lang_sense_clarification": "输液装置"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "kapačka",
                                "target_lang_sense_clarification": "infuzní souprava"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ddd9e811-88a6-32c0-9998-f023bfb6fb51",
                    "sense_definition": "Style; swagger; fashionable and/or expensive clothing.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He showed off his <w>drip</w> by wearing a brand new designer jacket.",
                            "target_lang_translations": {
                                "ru": "Он похвастался своим <w>стилем</w>, надев новенькую дизайнерскую куртку.",
                                "zh": "他穿着一件全新的名牌夹克，炫耀着他的<w>行头</w>。",
                                "cs": "Předváděl svůj <w>styl</w> v nové značkové bundě."
                            }
                        },
                        {
                            "text": "The cold weather cannot stop your <w>drip</w> if you have the right style.",
                            "target_lang_translations": {
                                "ru": "Холодная погода не испортит твой <w>вид</w>, если у тебя есть чувство стиля.",
                                "zh": "如果你有合适的风格，寒冷的天气也挡不住你的<w>潮</w>。",
                                "cs": "Chladné počasí tvůj <w>šmrnc</w> nezastaví, pokud máš ten správný styl."
                            }
                        }
                    ],
                    "synonyms": [
                        "swag",
                        "style",
                        "flair"
                    ],
                    "common_phrases": [
                        "show off drip",
                        "expensive drip"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Modern youth slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стиль, крутой вид; модная и дорогая одежда.",
                        "zh": "指时尚、酷炫的风格或昂贵的装扮。",
                        "cs": "Styl, módní a drahé oblečení."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стиль",
                                "target_lang_sense_clarification": "внешний вид"
                            },
                            {
                                "target_lang_word": "шмот",
                                "target_lang_sense_clarification": "сленг, модная одежда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "潮",
                                "target_lang_sense_clarification": "形容时尚"
                            },
                            {
                                "target_lang_word": "行头",
                                "target_lang_sense_clarification": "指装扮或衣着"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "styl",
                                "target_lang_sense_clarification": "osobitý vzhled"
                            },
                            {
                                "target_lang_word": "šmrnc",
                                "target_lang_sense_clarification": "módní vzhled"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "365f99bd-ebd8-3330-9bea-1958d5bf5a7d",
                    "sense_definition": "A limp, ineffectual, or uninteresting person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personality-types",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is such a <w>drip</w> that he never wants to try anything new.",
                            "target_lang_translations": {
                                "ru": "Он такой <w>зануда</w>, что никогда не хочет пробовать ничего нового.",
                                "zh": "他真是个<w>无趣的人</w>，从来不想尝试任何新事物。",
                                "cs": "Je to takový <w>suchar</w>, že nikdy nechce zkusit nic nového."
                            }
                        },
                        {
                            "text": "I found him to be a bit of a <w>drip</w> during our first date.",
                            "target_lang_translations": {
                                "ru": "На нашем первом свидании он показался мне каким-то <w>вялым</w>.",
                                "zh": "第一次约会时，我觉得他有点<w>软蛋</w>。",
                                "cs": "Na prvním rande mi přišel jako trochu <w>rozmazňa</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "bore",
                        "weakling"
                    ],
                    "antonyms": [
                        "extrovert",
                        "dynamo"
                    ],
                    "common_phrases": [
                        "bit of a drip",
                        "what a drip"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal derogatory term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вялый, неэффективный или неинтересный человек.",
                        "zh": "指性格软弱、无趣或乏味的人。",
                        "cs": "Nudný, nevýrazný nebo slabý člověk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зануда",
                                "target_lang_sense_clarification": "скучный человек"
                            },
                            {
                                "target_lang_word": "размазня",
                                "target_lang_sense_clarification": "бесхарактерный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无趣的人",
                                "target_lang_sense_clarification": "乏味的人"
                            },
                            {
                                "target_lang_word": "软蛋",
                                "target_lang_sense_clarification": "性格软弱的人"
                            }
                        ],
                        "cs": [
