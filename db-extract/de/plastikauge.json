                "senses": [
                    {
                        "sense_id": "1b7b8e3d-43eb-3b77-8853-43f862fc0c6e",
                        "entry_id": "79477d44-229d-3594-abf8-0920ecf70d60",
                        "glosses": [
                            "Nachbildung eines Auges aus Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86d416c-9675-4316-8167-09655f10d15e",
                                "sense_id": "1b7b8e3d-43eb-3b77-8853-43f862fc0c6e",
                                "text": "„Von der Wand sehen die beiden Bären und der Tiger zu, mit im Feuerschein glänzenden Plastikaugen und heraushängenden roten Flanellzungen.“"
                            },
                            {
                                "example_id": "ce82e6a9-4811-4f6d-bf2e-25552dfa4285",
                                "sense_id": "1b7b8e3d-43eb-3b77-8853-43f862fc0c6e",
                                "text": "„Erneut schaue ich auf Melina hinunter, doch sie starrt unverwandt auf den Fernseher, würdigt mich mit ihren glasierten Plastikaugen keines Blickes.“"
                            },
                            {
                                "example_id": "6a6494c8-498a-4a08-bc18-eb961f7ee341",
                                "sense_id": "1b7b8e3d-43eb-3b77-8853-43f862fc0c6e",
                                "text": "„Ich kratze mit den Fingernägeln über die Plastikaugen, aber die Farbe geht nicht ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
