                    }
                },
                {
                    "sense_id": "54fb7155-83fd-34c2-b958-45b8511c57ca",
                    "sense_definition": "Поминальный обед или угощение, устраиваемое в связи с похоронами.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После погребения всех пригласили на <w>халтуру</w>.",
                            "target_lang_translations": {
                                "en": "After the burial, everyone was invited to the <w>funeral wake</w>."
