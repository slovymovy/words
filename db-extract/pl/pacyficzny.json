                "translations": [
                    {
                        "translation_id": "c5d7a598-996d-4698-8885-b845db4a76a7",
                        "source_entry_id": "1343cdb6-2a87-3e40-8903-e99d312e204d",
                        "source_sense_id": "87b3839d-8690-3780-9fd0-f98b2bd152ca",
                        "target_lang_word": "Pacific",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pacific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "794dc7e4-f5b9-3916-a090-b9d72c98f652",
                                        "entry_id": "e1feccd0-4738-3ce6-b94e-cf87fc164c2e",
                                        "glosses": [
                                            "The Pacific Ocean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10fd0f23-feba-434e-bcaf-5218c1abc350",
                                                "sense_id": "794dc7e4-f5b9-3916-a090-b9d72c98f652",
                                                "text": "When our last plenary session was held in November of last year the Pacific was threatened with imminent outbreak of war. Since the subsequent beginning of the Japanese campaign of aggression in that ocean, China, in the company of her allies, has become the most important member of the forces fighting on the continent of East Asia."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "761a3b2f-9712-3181-828c-768597540e99",
                                        "entry_id": "e1feccd0-4738-3ce6-b94e-cf87fc164c2e",
                                        "glosses": [
                                            "A city in Franklin County, Missouri, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Pacific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "269a99ba-a541-31c9-acd8-8b6ebf6ca52c",
                                        "entry_id": "78e94986-7911-3986-befc-05b151cddfaa",
                                        "glosses": [
                                            "A steam locomotive of the 4-6-2 wheel arrangement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "273293b4-d715-4b4e-9a86-3aea443fd546",
                                                "sense_id": "269a99ba-a541-31c9-acd8-8b6ebf6ca52c",
                                                "text": "Britannia's firebox would appear to have derived from those of the Bulleid Pacifics, which it closely resembles."
                                            },
                                            {
                                                "example_id": "609d9ab1-266d-4b0e-b2d2-53baa315a5e1",
                                                "sense_id": "269a99ba-a541-31c9-acd8-8b6ebf6ca52c",
                                                "text": "These were the first class of tender locomotives with this wheel arrangement in the world, although there is some doubt as to whether the name \"Pacific\" was given to the type because New Zealand is in the Pacific Ocean or because some similar engines were built a few months later for the Missouri Pacific Railroad."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pacific",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3948f0bb-8f9d-3746-867a-2d3d16bda0ed",
                                        "entry_id": "6f4426c3-5d46-3e76-ae47-698a4c5380f9",
                                        "glosses": [
                                            "Related to the Pacific Ocean."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8edb49a1-a0ff-45d7-a659-80420c5df074",
                        "source_entry_id": "1343cdb6-2a87-3e40-8903-e99d312e204d",
                        "source_sense_id": "87b3839d-8690-3780-9fd0-f98b2bd152ca",
                        "target_lang_word": "tichomořský",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tichomořský",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "4e5162a3-2b84-30e0-98d5-fc3e9233ecf2",
                                        "entry_id": "c93cab8d-ac57-3427-a66b-654c40ba4447",
                                        "glosses": [
                                            "související s Tichým oceánem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "565ed9f8-2bc3-40d4-8aa5-549c97ccac8b",
                                                "sense_id": "4e5162a3-2b84-30e0-98d5-fc3e9233ecf2",
                                                "text": "Vědci z českobudějovického biologického centra Akademie věd ČR objevili v lososech na Aljašce tasemnici, která může napadnout i člověka. Doposud byl tento parazitický červ zaznamenán pouze v tichomořském pobřeží Asie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "414232f2-ea6b-45de-b3ac-8a85faeb0e65",
                        "source_entry_id": "1343cdb6-2a87-3e40-8903-e99d312e204d",
                        "source_sense_id": "87b3839d-8690-3780-9fd0-f98b2bd152ca",
                        "target_lang_word": "pacifique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pacifique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cb8a6ac-a745-3dca-bd3f-ca5ffb92dad5",
                                        "entry_id": "46674239-5ae9-31e3-91fc-b96ca696efbf",
                                        "glosses": [
                                            "Qui aime la paix, qui est favorable à la paix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf606358-66e6-49f7-bb0a-451636ca4878",
                                                "sense_id": "4cb8a6ac-a745-3dca-bd3f-ca5ffb92dad5",
                                                "text": "Un esprit doux et pacifique."
                                            },
                                            {
                                                "example_id": "5e313b8e-9353-498d-8cee-868dac9f8d23",
                                                "sense_id": "4cb8a6ac-a745-3dca-bd3f-ca5ffb92dad5",
                                                "text": "Avoir une humeur pacifique."
                                            },
                                            {
                                                "example_id": "dddf05cb-d7be-4305-b019-66f5759906d6",
                                                "sense_id": "4cb8a6ac-a745-3dca-bd3f-ca5ffb92dad5",
                                                "text": "Un esprit pacifique."
                                            },
                                            {
                                                "example_id": "3c57e000-81de-4fff-bbba-53a48879ee75",
                                                "sense_id": "4cb8a6ac-a745-3dca-bd3f-ca5ffb92dad5",
                                                "text": "Un prince pacifique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "305a256e-8867-3838-a311-8e44776e1d2d",
                                        "entry_id": "46674239-5ae9-31e3-91fc-b96ca696efbf",
                                        "glosses": [
                                            "Qui est paisible, tranquille, exempt de guerres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61e4089b-0a7d-458a-9969-207c500bda16",
                                                "sense_id": "305a256e-8867-3838-a311-8e44776e1d2d",
                                                "text": "Son règne fut pacifique."
                                            },
                                            {
                                                "example_id": "e4000101-2999-4d3d-8627-1e67ba90acd2",
                                                "sense_id": "305a256e-8867-3838-a311-8e44776e1d2d",
                                                "text": "Contrairement aux vieilles sagas scandinaves où bouillonne le sang des Vikings, Le Kalevala est un récit plutôt pacifique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e4fbd73-aead-3254-9b4b-0b30426e287f",
                                        "entry_id": "46674239-5ae9-31e3-91fc-b96ca696efbf",
                                        "glosses": [
                                            "Relatif à l’océan Pacifique ou aux régions baignées par cet océan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50649879-914c-4e1c-94fe-5e8919ae1570",
                                                "sense_id": "2e4fbd73-aead-3254-9b4b-0b30426e287f",
                                                "text": "Le tremblement de terre de magnitude 8,9 et le tsunami qui l’a suivi ont en effet dévasté la côte pacifique de la région du Tohoku (Nord-Est), qui représente 8 % du produit intérieur brut (PIB) de la troisième économie du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42c2f610-c1df-44af-b466-a783f6561780",
                        "source_entry_id": "1343cdb6-2a87-3e40-8903-e99d312e204d",
                        "source_sense_id": "87b3839d-8690-3780-9fd0-f98b2bd152ca",
                        "target_lang_word": "pazifisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pazifisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "214465ed-ecb7-3f57-be74-fe149105e5d2",
                                        "entry_id": "5ee36513-cccb-3ddf-999d-bbeb3990b793",
                                        "glosses": [
                                            "zum größten Ozean der Erde gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d044a2-e01e-4571-b63a-3e66255547f7",
                                                "sense_id": "214465ed-ecb7-3f57-be74-fe149105e5d2",
                                                "text": "Diesen Sommer wollen sie Urlaub auf einer pazifischen Insel machen."
                                            },
                                            {
                                                "example_id": "dd3a7743-49ad-4d5e-b763-25876f36c8c5",
                                                "sense_id": "214465ed-ecb7-3f57-be74-fe149105e5d2",
                                                "text": "Tuvalu ist ein pazifischer Inselstaat."
                                            },
                                            {
                                                "example_id": "36e4c563-a33b-4e8d-a56d-601e28289574",
                                                "sense_id": "214465ed-ecb7-3f57-be74-fe149105e5d2",
                                                "text": "Seit einigen Jahren leben sie an der pazifischen Küste der USA."
                                            },
                                            {
                                                "example_id": "99ceea8a-bed0-43b6-a22d-3f8cc5a6d3bc",
                                                "sense_id": "214465ed-ecb7-3f57-be74-fe149105e5d2",
                                                "text": "„Der kleine Inselstaat setzt sich vor allem für die Belange vieler pazifischer Länder ein, die vom Meeresspiegelanstieg infolge der globalen Erwärmung bedroht sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
