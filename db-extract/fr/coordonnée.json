            {
                "entry_id": "53835006-8524-36e1-b3ac-258643cf1c2a",
                "word": "coordonnée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ad2cd847-dc7a-4322-9705-81de50ce393a",
                        "entry_id": "53835006-8524-36e1-b3ac-258643cf1c2a",
                        "tags": [
                            "plural"
                        ],
                        "form": "coordonnées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9c4c1ae8-d6cb-3321-9204-93fd3b6b7eff",
                        "entry_id": "53835006-8524-36e1-b3ac-258643cf1c2a",
                        "glosses": [
                            "Donnée sur la position, sur l’endroit ou la façon de trouver."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f59e31d6-2ada-4e43-bb17-2d44a1d9cd9e",
                                "sense_id": "9c4c1ae8-d6cb-3321-9204-93fd3b6b7eff",
                                "text": "Nicolas Oresme applique à la représentation du mouvement une représentation graphique, grâce à un système de coordonnées rectangulaires, ce qui fait de lui un précurseur de la géométrie analytique de Descartes."
                            },
                            {
                                "example_id": "de2f3194-cda2-48fd-8348-86a9b91e8e6c",
                                "sense_id": "9c4c1ae8-d6cb-3321-9204-93fd3b6b7eff",
                                "text": "« Alfred. Vous avez les coordonnées ?\n— Presque Monsieur. Il y a plus d’interférences que d’habitude. »"
                            },
                            {
                                "example_id": "010d70d2-c1fc-4356-87c7-7b3798f17d24",
                                "sense_id": "9c4c1ae8-d6cb-3321-9204-93fd3b6b7eff",
                                "text": "Une coordonnée de ce point étant connue, l’autre sera facile à déterminer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "052906e5-3497-4a58-a925-ca2624aa9f93",
                        "source_entry_id": "53835006-8524-36e1-b3ac-258643cf1c2a",
                        "source_sense_id": "9c4c1ae8-d6cb-3321-9204-93fd3b6b7eff",
                        "target_lang_word": "Koordinate",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koordinate",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82070e91-cf23-3de3-9ef2-ecacf49d44ac",
                                        "entry_id": "cb67b40f-bd38-3558-b0cc-cf88204dd229",
                                        "glosses": [
                                            "Zahl, welche die Entfernung eines Punktes von einer Hyperebene (zum Beispiel Koordinatenachse oder -ebene) in einem geometrischen Raum angibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3dd53a29-72cd-4c75-8c45-a1b11bfe49ea",
                                                "sense_id": "82070e91-cf23-3de3-9ef2-ecacf49d44ac",
                                                "text": "Mithilfe mehrerer Koordinaten konnte er ein Dreieck konstruieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e75468f-623d-32c8-b50d-ccd6590006a8",
                                        "entry_id": "cb67b40f-bd38-3558-b0cc-cf88204dd229",
                                        "glosses": [
                                            "Zahl, welche die Entfernung eines Punktes auf der Erdoberfläche vom Äquator oder Nullmeridian angibt"
                                        ],
                                        "tags": [
                                            "Geographie",
                                            "Kartographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e7e8d89-508d-4949-888c-11d59378e96e",
                                                "sense_id": "3e75468f-623d-32c8-b50d-ccd6590006a8",
                                                "text": "Der Pilot fand die Landebahn nicht, da die Koordinaten falsch waren."
                                            },
                                            {
                                                "example_id": "014dec8d-6bdb-4953-b796-8e6d5619fca6",
                                                "sense_id": "3e75468f-623d-32c8-b50d-ccd6590006a8",
                                                "text": "„Der Pilot der Maschine meldete sich. Carlos gab Koordinaten an ihn durch.“"
                                            },
                                            {
                                                "example_id": "a6f1cf17-1ea5-4bf7-9686-c31a4e99c68e",
                                                "sense_id": "3e75468f-623d-32c8-b50d-ccd6590006a8",
                                                "text": "„Ich konnte nicht glauben, das Amalias Koordinaten uns hierher geführt hatten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b4a41a6-b5c3-4686-9954-c4431b236641",
                        "source_entry_id": "53835006-8524-36e1-b3ac-258643cf1c2a",
                        "source_sense_id": "9c4c1ae8-d6cb-3321-9204-93fd3b6b7eff",
                        "target_lang_word": "coordinate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coordinate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f4a9b4a0-2974-33ad-9960-01c1afe27e7d",
                                        "entry_id": "18e2be54-6f35-3db4-b652-b4f34c71141f",
                                        "glosses": [
                                            "Of the same rank; equal."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27d73e3e-a575-45ad-bdb8-08207316bfbb",
                                                "sense_id": "f4a9b4a0-2974-33ad-9960-01c1afe27e7d",
                                                "text": "two coordinate terms"
                                            },
                                            {
                                                "example_id": "86ef3be6-87d3-4f5b-aab6-29439a0eb675",
                                                "sense_id": "f4a9b4a0-2974-33ad-9960-01c1afe27e7d",
                                                "text": "whether there was one Supreme Governor of the world, or many co-ordinate powers presiding over each country"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coordinate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "419f3d9d-0699-354a-a00b-5360ad19c7d8",
                                        "entry_id": "fa487960-1a14-36ab-9f65-2e70f9601c4b",
                                        "glosses": [
                                            "A number representing the position of a point along a line, arc, or similar one-dimensional figure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e001fed-8537-4c4f-ba07-074c830f4fd6",
                                                "sense_id": "419f3d9d-0699-354a-a00b-5360ad19c7d8",
                                                "text": "Give me your coordinates and we'll come and rescue you."
                                            },
                                            {
                                                "example_id": "a32e0c87-a56a-496a-8b77-8e848eef10a7",
                                                "sense_id": "419f3d9d-0699-354a-a00b-5360ad19c7d8",
                                                "text": "What makes Doveland so fascinating is that there are no records of a town with such a name, the town was not renamed or altered its zoning, and there is no map of the state that includes the coordinates of a town called Doveland, Wisconsin. Yet people claim they remember the town, had friends or relatives who lived there, have visited it, and a few folks have souvenirs to prove they have been to Doveland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce422c9b-f6fa-3dc5-bbe7-6089b05c8dd6",
                                        "entry_id": "fa487960-1a14-36ab-9f65-2e70f9601c4b",
                                        "glosses": [
                                            "Something that is equal to another thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77bd10f5-e024-4201-b061-e49030b70aa1",
                                                "sense_id": "ce422c9b-f6fa-3dc5-bbe7-6089b05c8dd6",
                                                "text": "These are coordinates; because each, in the sphere of its powers, is equal to, and independent of the others; and because the three united make the government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "796b06e9-6c3a-3b49-93f3-caf96d6af45d",
                                        "entry_id": "fa487960-1a14-36ab-9f65-2e70f9601c4b",
                                        "glosses": [
                                            "Coordinated clothes."
                                        ],
                                        "tags": [
                                            "humorous",
                                            "in-plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "coordinate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53961a81-a346-3b44-a678-ecfdc2e773bb",
                                        "entry_id": "1e6e93e7-a9c9-3992-8c83-a04a5223d181",
                                        "glosses": [
                                            "To place in the same order or rank."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7399e76b-2e8a-3a5e-817a-98b9909e823b",
                                        "entry_id": "1e6e93e7-a9c9-3992-8c83-a04a5223d181",
                                        "glosses": [
                                            "To synchronize (activities)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54935aa4-7a5f-486f-8a5f-39cb59ac1e0a",
                                                "sense_id": "7399e76b-2e8a-3a5e-817a-98b9909e823b",
                                                "text": "It can be difficult to coordinate movement of both legs after an operation."
                                            },
                                            {
                                                "example_id": "424e1f3c-4fa4-4f81-acc3-27b701a2ff75",
                                                "sense_id": "7399e76b-2e8a-3a5e-817a-98b9909e823b",
                                                "text": "I was playing tennis for the first time, and it was difficult to coordinate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea0d25df-40b4-395f-8c21-c0063546bd8c",
                                        "entry_id": "1e6e93e7-a9c9-3992-8c83-a04a5223d181",
                                        "glosses": [
                                            "To match (objects, especially clothes)."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a07ea2e6-bde7-4506-be9d-8b8d8c7f1187",
                                                "sense_id": "ea0d25df-40b4-395f-8c21-c0063546bd8c",
                                                "text": "The outfit you're wearing doesn't coordinate."
                                            },
                                            {
                                                "example_id": "c2aff3e2-b429-4616-a70d-8452d28f1f71",
                                                "sense_id": "ea0d25df-40b4-395f-8c21-c0063546bd8c",
                                                "text": "As a fashion editor, I pay obsessive attention to my appearance. Even when I pretend to look insouciant, each look has been painfully considered. The right earrings, coordinating shoes, the careful symmetry of a well-balanced look — these are things that please me. The gym has crushed my sartorial ambitions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
