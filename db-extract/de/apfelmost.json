                        "sense_id": "9d4a9522-0339-32aa-a3d3-19312be10811",
                        "entry_id": "337097d8-725b-300e-bd87-26920d8b667f",
                        "glosses": [
                            "der noch nicht vergorene Apfelsaft, der durch das Pressen gemahlener Äpfel gewonnen wird"
