                                    {
                                        "sense_id": "f048c50c-75ff-3d3e-a760-a0d0d7417422",
                                        "entry_id": "e733c1f9-06a1-3651-b8df-b16aeabcc585",
                                        "glosses": [
                                            "zeer besmettelijke, tropische virusziekte die met inwendige bloedingen gepaard gaat."
