                        "entry_id": "a9346298-1d56-3c20-a59c-29a47b1f42d0",
                        "glosses": [
                            "iemand die tegen betaling met een spuitbus muurschilderingen maakt en schilderijen in een overeenkomstige stijl"
                        ],
