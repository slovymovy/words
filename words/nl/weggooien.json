{
    "word_family": [
        "gooien",
        "wegwerper"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb0f3f23-c1d8-38eb-af5d-57b8d66b367f",
                    "sense_definition": "Zich van iets ontdoen door het in het afval te deponeren.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ontdoen_van_afval",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je die oude dozen even voor me <w>weggooien</w>?",
                            "target_lang_translations": {
                                "en": "Could you <w>throw away</w> those old boxes for me?"
                            }
                        },
                        {
                            "text": "Ik moest het bedorven eten helaas <w>weggooien</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, I had to <w>throw out</w> the spoiled food."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegwerpen"
                    ],
                    "common_phrases": [
                        "afval weggooien",
                        "oud papier weggooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To get rid of something by putting it in the trash."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw away",
                                "target_lang_sense_clarification": "to discard something useless"
                            },
                            {
                                "target_lang_word": "throw out",
                                "target_lang_sense_clarification": "to dispose of trash"
                            },
                            {
                                "target_lang_word": "discard",
                                "target_lang_sense_clarification": "to get rid of unwanted items"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e6a14179-3402-363f-825d-de87d8600f9a",
                    "sense_definition": "Iets met de hand in beweging brengen zodat het zich snel vrij door de lucht verwijdert.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "werpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt simpelweg een bal <w>weggooien</w> en die terug laten brengen door je hond.",
                            "target_lang_translations": {
                                "en": "You can simply <w>throw</w> a ball and have your dog bring it back."
                            }
                        },
                        {
                            "text": "Hij wilde de steen zo ver mogelijk <w>weggooien</w> over het water.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>throw</w> the stone as far as possible across the water."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegwerpen"
                    ],
                    "common_phrases": [
                        "een bal weggooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To move something with the hand so that it travels quickly through the air away from you."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw away",
                                "target_lang_sense_clarification": "to throw an object to a distance"
                            },
                            {
                                "target_lang_word": "throw",
                                "target_lang_sense_clarification": "to propel something through the air"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d1c1a40b-3f7c-3488-8d03-54418b7dad82",
                    "sense_definition": "Iets waardevols door eigen toedoen of onvoorzichtigheid verliezen of verkwisten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verkwisten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We vinden het afgrijselijk dat die jongeren hun toekomst zo <w>weggooien</w>.",
                            "target_lang_translations": {
                                "en": "We find it terrible that those young people are <w>throwing away</w> their future like that."
                            }
                        },
                        {
                            "text": "Je moet je talent niet zomaar <w>weggooien</w> door niets te doen.",
                            "target_lang_translations": {
                                "en": "You shouldn't just <w>waste</w> your talent by doing nothing."
                            }
                        }
                    ],
                    "synonyms": [
                        "wegwerpen",
                        "wegwerpen"
                    ],
                    "common_phrases": [
                        "je toekomst weggooien",
                        "geld weggooien"
                    ],
                    "target_lang_definitions": {
                        "en": "To lose or waste something valuable through one's own actions or carelessness."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "throw away",
                                "target_lang_sense_clarification": "to waste an opportunity, talent, or future"
                            },
                            {
                                "target_lang_word": "waste",
                                "target_lang_sense_clarification": "to squander valuable resources or potential"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}