                "translations": [
                    {
                        "translation_id": "e0593d22-c3ba-4bc2-b68f-30a6bccc5474",
                        "source_entry_id": "2f51d049-8cb4-3871-97ad-c2391e0ea0c5",
                        "source_sense_id": "d7ef896a-8113-375b-8e48-45cf5aa2e5cd",
                        "target_lang_word": "loose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "loose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22c8350e-98e5-3cc4-95de-657502135583",
                                        "entry_id": "15f42c58-0631-3e1d-aa69-6ea3fdd47a60",
                                        "glosses": [
                                            "To let loose, to free from restraints."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9febcf3-daff-4504-b503-d97ed3c8f70b",
                                                "sense_id": "22c8350e-98e5-3cc4-95de-657502135583",
                                                "text": "Ye shall find an ass tied, and a colt with her; loose them, and bring them unto me."
                                            },
                                            {
                                                "example_id": "af29054c-1667-4401-bb9e-1d8955740460",
                                                "sense_id": "22c8350e-98e5-3cc4-95de-657502135583",
                                                "text": "\"Ay, and one was nigh to being slain by the hot-pot to be eaten of those brutes, thy children, and had not the others fought gallantly they too had been slain, and not even I could have called back the life which had been loosed from the body.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae0e7651-fbcc-3090-86cc-4f7278c225c6",
                                        "entry_id": "15f42c58-0631-3e1d-aa69-6ea3fdd47a60",
                                        "glosses": [
                                            "To unfasten, to loosen."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83d8f349-5109-383e-ad76-498ca8fe30cf",
                                        "entry_id": "15f42c58-0631-3e1d-aa69-6ea3fdd47a60",
                                        "glosses": [
                                            "To make less tight, to loosen."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7c906b1-1737-37eb-805b-641e72be59b7",
                                        "entry_id": "15f42c58-0631-3e1d-aa69-6ea3fdd47a60",
                                        "glosses": [
                                            "Of a grip or hold, to let go."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fc5bd3f1-00b1-35d2-8c6d-78fd1668f6a4",
                                        "entry_id": "15f42c58-0631-3e1d-aa69-6ea3fdd47a60",
                                        "glosses": [
                                            "To shoot (an arrow)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd681c63-19bd-3deb-b7b6-ad13550cded9",
                                        "entry_id": "15f42c58-0631-3e1d-aa69-6ea3fdd47a60",
                                        "glosses": [
                                            "To set sail."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8036a08a-138e-479e-b3f8-41b89260ff91",
                                                "sense_id": "bd681c63-19bd-3deb-b7b6-ad13550cded9",
                                                "text": "Now when Paul and his company loosed from Paphos, they came to Perga in Pamphylia: and John departing from them returned to Jerusalem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da68464b-3bc0-33aa-9dd1-33590aea7991",
                                        "entry_id": "15f42c58-0631-3e1d-aa69-6ea3fdd47a60",
                                        "glosses": [
                                            "To solve; to interpret."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53afb8b9-9204-469a-8e74-2e815cc5c7d4",
                                                "sense_id": "da68464b-3bc0-33aa-9dd1-33590aea7991",
                                                "text": "he had red her riddle, which no wight\nCould ever loose"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "loose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b9a488e-034c-30d9-bbb2-66623015d080",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Not fixed in place tightly or firmly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba3bf96b-604f-4856-9d2b-9d7a19a93c2f",
                                                "sense_id": "3b9a488e-034c-30d9-bbb2-66623015d080",
                                                "text": "This wheelbarrow has a loose wheel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "740d3824-0147-3724-91cc-4cd5938cb7b3",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Not held or packaged together."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb9d4f4f-ed3c-4617-8926-38d03d0d0104",
                                                "sense_id": "740d3824-0147-3724-91cc-4cd5938cb7b3",
                                                "text": "You can buy apples in a pack, but they are cheaper loose."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cae75e47-d696-39af-b60e-7e7f6d5cd072",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Not under control."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6abbe2d-18b0-4ab6-9ff8-4f6287149146",
                                                "sense_id": "cae75e47-d696-39af-b60e-7e7f6d5cd072",
                                                "text": "The dog is loose again."
                                            },
                                            {
                                                "example_id": "965d843b-4fce-4f07-9ab4-e3d5e978ed73",
                                                "sense_id": "cae75e47-d696-39af-b60e-7e7f6d5cd072",
                                                "text": "The very idea of a machine set loose to slaughter is chilling."
                                            },
                                            {
                                                "example_id": "f465e485-038e-4da3-a5da-6f9d8aacb491",
                                                "sense_id": "cae75e47-d696-39af-b60e-7e7f6d5cd072",
                                                "text": "Now I stand / Loose of my vow; but who knows Cato's thoughts?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ff24462-5b26-322e-ba11-8af977d847f3",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Not fitting closely."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54c112b8-9a19-4f81-baa6-d40bb5098dd7",
                                                "sense_id": "4ff24462-5b26-322e-ba11-8af977d847f3",
                                                "text": "I wear loose clothes when it is hot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f29ead7-34a3-301f-a069-c97cf033045c",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Not compact."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b92b0659-e01c-4edd-87c2-e2e080f946b2",
                                                "sense_id": "4f29ead7-34a3-301f-a069-c97cf033045c",
                                                "text": "a cloth of loose texture"
                                            },
                                            {
                                                "example_id": "b74020f7-a272-476e-9162-892ba2ed03d4",
                                                "sense_id": "4f29ead7-34a3-301f-a069-c97cf033045c",
                                                "text": "It is difficult walking on loose gravel."
                                            },
                                            {
                                                "example_id": "06c3ed45-f672-4351-99f7-92db7258f462",
                                                "sense_id": "4f29ead7-34a3-301f-a069-c97cf033045c",
                                                "text": "with horse and chariots ranked in loose array"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62aa9bfb-defc-3ebe-ab24-109a670a961a",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Relaxed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c407cae-b5ab-41c7-a619-5c8807d42c3d",
                                                "sense_id": "62aa9bfb-defc-3ebe-ab24-109a670a961a",
                                                "text": "She danced with a loose flowing movement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2728623-c7c8-3bb3-a832-c4453bee2f96",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Not precise or exact; vague; indeterminate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d708199c-07b3-4fda-bde0-3e949dcd1187",
                                                "sense_id": "f2728623-c7c8-3bb3-a832-c4453bee2f96",
                                                "text": "a loose way of reasoning"
                                            },
                                            {
                                                "example_id": "da07b88a-5f7a-4c13-9c1f-a08488661c24",
                                                "sense_id": "f2728623-c7c8-3bb3-a832-c4453bee2f96",
                                                "text": "The comparison employed […] must be considered rather as a loose analogy than as an exact scientific explanation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f155a77-afc8-3cd7-88f4-9e3d51130af1",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Indiscreet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddf7c3d4-f26a-4de3-81a5-5aae45f0caf2",
                                                "sense_id": "1f155a77-afc8-3cd7-88f4-9e3d51130af1",
                                                "text": "Loose talk costs lives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b27cc655-ab04-3a2c-aa1f-f84c71d16eeb",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Free from moral restraint; immoral, unchaste."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d539aeb7-3e1c-4bb7-8fe2-7301212551fe",
                                                "sense_id": "b27cc655-ab04-3a2c-aa1f-f84c71d16eeb",
                                                "text": "In all these he was much and deeply read; / But not a page of any thing that's loose, / Or hints continuation of the species, / Was ever suffer'd, lest he should grow vicious."
                                            },
                                            {
                                                "example_id": "9755b339-41ec-480b-819c-fa8157d4836a",
                                                "sense_id": "b27cc655-ab04-3a2c-aa1f-f84c71d16eeb",
                                                "text": "to seeke her errant Knight; / And then againe resolu'd to hunt him out / Amongst loose Ladies, lapped in delight"
                                            },
                                            {
                                                "example_id": "ce8ebc0c-4bcb-46c1-8411-e572b12de2e1",
                                                "sense_id": "b27cc655-ab04-3a2c-aa1f-f84c71d16eeb",
                                                "text": "the loose morality which he had learned"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e02ec83b-8339-3cb0-a5f0-1991ec26ac35",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Not being in the possession of any competing team during a game."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a00f7b23-9d07-49e8-9151-5e17b1949aa1",
                                                "sense_id": "e02ec83b-8339-3cb0-a5f0-1991ec26ac35",
                                                "text": "He caught an elbow going after a loose ball."
                                            },
                                            {
                                                "example_id": "b56a6078-c4ee-49a4-9d54-1e84a0c42672",
                                                "sense_id": "e02ec83b-8339-3cb0-a5f0-1991ec26ac35",
                                                "text": "The puck was momentarily loose right in front of the net."
                                            },
                                            {
                                                "example_id": "e9ec0892-cedc-4253-9e22-fe219d7dcd99",
                                                "sense_id": "e02ec83b-8339-3cb0-a5f0-1991ec26ac35",
                                                "text": "Tomas Rosicky released the left-back with a fine pass but his low cross was cut out by Ivan Marcano. However the Brazilian was able to collect the loose ball, cut inside and roll a right-footed effort past Franco Costanzo at his near post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96f5f918-cd52-314e-8036-e7d48be90518",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Not costive; having lax bowels."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c40ca23e-cb36-4546-a72d-9c1d186ea5a6",
                                                "sense_id": "96f5f918-cd52-314e-8036-e7d48be90518",
                                                "text": "People that are very loose, have seldom strong Thoughts, or strong Bodies"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "375e95f2-2aba-3600-bc87-139265c1d41c",
                                        "entry_id": "a8c1e22a-7034-3f86-84eb-d87727ca9b9f",
                                        "glosses": [
                                            "Measured loosely stacked or disorganized (such as of firewood)."
