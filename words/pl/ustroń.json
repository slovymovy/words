                {
                    "sense_id": "4ba1f510-8f67-38be-95b8-4e31499c745c",
                    "sense_definition": "miejsce zaciszne, ustronne, oddalone od skupisk ludzkich",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "miejsce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Stary mędrzec zaszył się w leśnej <w>ustroni</w>, aby z dala od zgiełku miasta pisać swoje dzieła.",
                            "target_lang_translations": {
                                "ru": "Старый мудрец укрылся в лесной <w>глуши</w>, чтобы вдали от городского шума писать свои труды."
                            }
                        },
                        {
                            "text": "Szukając spokoju po wyczerpującym dniu, spacerował ścieżkami w cichej <w>ustroni</w> za parkiem.",
                            "target_lang_translations": {
                                "ru": "В поисках покоя после утомительного дня он гулял по тропинкам в тихом <w>укромном уголке</w> за парком."
                            }
                        }
                    ],
                    "synonyms": [
                        "ustronie"
                    ],
                    "common_phrases": [
                        "leśna ustroń",
                        "cicha ustroń"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "wyraz rzadziej używany, częstszy w literaturze lub w formie ustronie"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "тихое, уединённое место, удалённое от людей и суеты"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затишье",
                                "target_lang_sense_clarification": "тихое, укромное место"
                            },
                            {
                                "target_lang_word": "уединение",
                                "target_lang_sense_clarification": "уединённое место, глушь"
                            },
                            {
                                "target_lang_word": "укромный уголок",
                                "target_lang_sense_clarification": "обособленное, тихое место"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f53ebf14-fe77-3207-b17b-078d3b73814b",
                    "sense_definition": "miasto uzdrowiskowe w Polsce, w województwie śląskim, w Beskidzie Śląskim",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "miejscowosc",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "W każdy weekend turyści chętnie odwiedzają <w>Ustroń</w>, aby spacerować po górskich szlakach.",
                            "target_lang_translations": {
                                "ru": "Каждые выходные туристы охотно посещают <w>Устронь</w>, чтобы погулять по горным тропам."
                            }
                        },
                        {
                            "text": "Zgubiłam zegarek w domu wypoczynkowym w <w>Ustroniu</w>.",
                            "target_lang_translations": {
                                "ru": "Я потеряла часы в доме отдыха в <w>Устрони</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "uzdrowisko Ustroń",
                        "wyjechać do Ustronia"
                    ],
                    "target_lang_definitions": {
                        "ru": "курортный город в Польше, в Силезском воеводстве, в Силезских Бескидах"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Устронь",
                                "target_lang_sense_clarification": "город в Силезском воеводстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dba6d8f7-6e88-3483-89b9-356b6a741666",
                    "sense_definition": "wieś w Polsce położona w województwie kujawsko-pomorskim, w powiecie żnińskim",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "miejscowosc",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Drogowskaz na skrzyżowaniu wskazywał drogę prowadzącą bezpośrednio do wsi <w>Ustroń</w>.",
                            "target_lang_translations": {
                                "ru": "Указатель на перекрёстке показывал дорогу, ведущую прямо в деревню <w>Устронь</w>."
                            }
                        },
                        {
                            "text": "Niewielki <w>Ustroń</w> w województwie kujawsko-pomorskim zachwyca spokojem i wiejskim krajobrazem.",
                            "target_lang_translations": {
                                "ru": "Небольшой <w>Устронь</w> в Куявско-Поморском воеводстве восхищает спокойствием и сельским пейзажем."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wieś Ustroń"
                    ],
                    "target_lang_definitions": {
                        "ru": "деревня в Польше, в Куявско-Поморском воеводстве, Жнинский повят"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Устронь",
                                "target_lang_sense_clarification": "деревня в Куявско-Поморском воеводстве"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d51f5222-d3b2-378f-be36-13720f229ed0",
                    "sense_definition": "część miasta Gdańska",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "miejscowosc",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "Gdański <w>Ustroń</w> to spokojny obszar położony w północnej części miasta.",
                            "target_lang_translations": {
                                "ru": "Гданьский <w>Устронь</w> — это спокойный район, расположенный в северной части города."
                            }
                        },
                        {
                            "text": "Mieszkańcy dzielnicy wspominają, że dawny <w>Ustroń</w> miał zupełnie inny charakter niż dzisiaj.",
                            "target_lang_translations": {
                                "ru": "Жители района вспоминают, что прежний <w>Устронь</w> имел совсем другой характер, нежели сегодня."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gdański Ustroń"
                    ],
                    "target_lang_definitions": {
                        "ru": "историческая часть города Гданьска"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Устронь",
                                "target_lang_sense_clarification": "район Гданьска"
                            }
                        ]
                    }
                }
            ]
