                "senses": [
                    {
                        "sense_id": "0293b0c6-3965-36f3-a22c-613f2c8602e3",
                        "entry_id": "cee59d4c-4014-31ee-afa4-df04c7f22f36",
                        "glosses": [
                            "Fahrzeug für den Transport von Flüssigkeiten auf Straße, Schiene, Binnengewässern oder dem Meer"
                        ],
                        "tags": [
                            "Fahrzeugbau"
                        ],
                        "examples": [
                            {
                                "example_id": "43ac961a-77ee-4468-a779-b3420d52485a",
                                "sense_id": "0293b0c6-3965-36f3-a22c-613f2c8602e3",
                                "text": "„Nicht nur, aber vor allem, in Tschechien ist es in den letzten Jahren üblich geworden, in ausgewählten Gastronomien sogenanntes Tankbier auszuschenken. In den Gaststätten fest installierte Tanks werden durch von der Brauerei betriebene Zisternenfahrzeuge befüllt, und aus den Tanks wird das Bier direkt an die Kunden ausgeschenkt.“"
                            },
                            {
                                "example_id": "0b889303-6293-4998-b933-6a872e5ad265",
                                "sense_id": "0293b0c6-3965-36f3-a22c-613f2c8602e3",
                                "text": "„Die TMT ist auf die Herstellung von Zisternenfahrzeuge für den Transport von Flüssigkeiten auf Straße, Meer und Bahn spezialisiert, in Konformität mit den geltenden Gesetzesnormen. Das breite Angebot der hergestellten Zisternen befriedigt jede Transportanforderung.“"
                            },
                            {
                                "example_id": "0f5c8057-e525-4d23-a118-1dc3b5f763cc",
                                "sense_id": "0293b0c6-3965-36f3-a22c-613f2c8602e3",
                                "text": "„Als Zisternenfahrzeug für Raketen-Treibstoffkomponenten gab es ebenfalls Spezialfahrzeuge, von denen sogar zwei an der Katastrophe vom 24.10.1960 in Baikonur zerstört wurden.“"
                            },
                            {
                                "example_id": "cf5d65e2-4eb6-4fdb-b2f3-787160c8d52c",
                                "sense_id": "0293b0c6-3965-36f3-a22c-613f2c8602e3",
                                "text": "„Rafinatoren und Conditioner werden nach speziellen Rezepturen in der Form von Granulat verschiedener Körnungen hergestellt und in Big-Bags oder direkt mit einem Zisternenfahrzeug nach Wunsch des Kunden geliefert.“"
                            },
                            {
                                "example_id": "94bbb858-f07e-462b-9b53-ffd31ffd8744",
                                "sense_id": "0293b0c6-3965-36f3-a22c-613f2c8602e3",
                                "text": "„Bis das Quellwasser wieder bedenkenlos genutzt werden kann, wird die Wasserversorgung seit Freitag mit einem Zisternenfahrzeug aufrechterhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
