                                        "glosses": [
                                            "Qualifie un religieux qui vit dans un cloître."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98300189-2cfd-4e5d-a01b-d100cf3e9241",
                                                "sense_id": "0b6c93bb-9450-3b27-8f18-58c674b3d22b",
                                                "text": "J'avais un mouvement précis de la langue pour empêcher le pain sacré d’effleurer mes dents. Je pratiquais même ma technique en mangeant des retailles d’hosties que j'achetais à la livre chez les religieuses cloîtrées qui les fabriquaient."
                                            }
                                        ]
