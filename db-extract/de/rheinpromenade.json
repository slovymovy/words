                "senses": [
                    {
                        "sense_id": "d7217fce-c9ac-3af5-aa1d-1dbf687c66e4",
                        "entry_id": "cd8af6c7-936f-3bfd-a956-8d7ea8d5b455",
                        "glosses": [
                            "angelegter Spazierweg am Ufer des Rheins"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dc34827-056b-4e27-9442-cace2f525f80",
                                "sense_id": "d7217fce-c9ac-3af5-aa1d-1dbf687c66e4",
                                "text": "„Oft empfing er Besucher, mit denen er auf der Unkeler Rheinpromenade spazieren ging oder im Siebengebirge wanderte.“"
                            },
                            {
                                "example_id": "e23b6ca7-a560-4b1d-864f-4565fb2b30b3",
                                "sense_id": "d7217fce-c9ac-3af5-aa1d-1dbf687c66e4",
                                "text": "„Die Rheinpromenade der Kur- und Quellenstadt Bad Breisig, linksrheinisch je 30 km von Bonn und Koblenz entfernt, ist übrigens auch ein hervorragender Ausgangspunkt für zahlreiche Unternehmungen.“"
                            },
                            {
                                "example_id": "2218f3a9-883c-4988-9b24-a34693577ba0",
                                "sense_id": "d7217fce-c9ac-3af5-aa1d-1dbf687c66e4",
                                "text": "„Als wir die Rheinpromenade entlangschlendern, ist davon nichts zu spüren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
