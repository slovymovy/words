{
    "word_family": [
        "bevatten",
        "omvatten",
        "samenvatten",
        "vat",
        "vatbaar",
        "vatting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "69cc3d9d-bea4-30d4-afff-8792b924617a",
                    "sense_definition": "iets met het verstand begrijpen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "begrijpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Vat</w> je wat ik bedoel?",
                            "target_lang_translations": {
                                "en": "Do you <w>grasp</w> what I mean?"
                            }
                        },
                        {
                            "text": "Het is soms moeilijk om de volledige situatie te <w>vatten</w>.",
                            "target_lang_translations": {
                                "en": "It is sometimes difficult to <w>understand</w> the full situation."
                            }
                        }
                    ],
                    "synonyms": [
                        "begrijpen"
                    ],
                    "common_phrases": [
                        "niet te vatten"
                    ],
                    "target_lang_definitions": {
                        "en": "to understand something with the mind"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grasp",
                                "target_lang_sense_clarification": "to understand a concept or situation"
                            },
                            {
                                "target_lang_word": "understand",
                                "target_lang_sense_clarification": "to know the meaning of something"
                            },
                            {
                                "target_lang_word": "comprehend",
                                "target_lang_sense_clarification": "to fully understand something complex"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "373b41df-e673-37c2-8907-1af080400541",
                    "sense_definition": "iets of iemand stevig vastpakken of grijpen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "grijpen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De politieagent <w>vatte</w> de dief bij de kraag.",
                            "target_lang_translations": {
                                "en": "The police officer <w>grabbed</w> the thief by the collar."
                            }
                        },
                        {
                            "text": "Hij probeerde de vallende vaas nog te <w>vatten</w>.",
                            "target_lang_translations": {
                                "en": "He still tried to <w>catch</w> the falling vase."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bij de kraag vatten"
                    ],
                    "target_lang_definitions": {
                        "en": "to firmly grab or seize something or someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grab",
                                "target_lang_sense_clarification": "to take hold of something suddenly"
                            },
                            {
                                "target_lang_word": "seize",
                                "target_lang_sense_clarification": "to take hold of something forcibly"
                            },
                            {
                                "target_lang_word": "catch",
                                "target_lang_sense_clarification": "to intercept and hold something in motion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "80103407-8906-3c43-b1cb-5889f742f849",
                    "sense_definition": "een ziekte of lichamelijke toestand krijgen of oplopen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "krijgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder jas zul je snel kou <w>vatten</w> in deze wind.",
                            "target_lang_translations": {
                                "en": "Without a coat, you will quickly <w>catch</w> a cold in this wind."
                            }
                        },
                        {
                            "text": "Na die drukke dag kon ik de slaap niet <w>vatten</w>.",
                            "target_lang_translations": {
                                "en": "After that busy day, I couldn't <w>get</w> to sleep."
                            }
                        }
                    ],
                    "common_phrases": [
                        "kou vatten",
                        "de slaap vatten"
                    ],
                    "target_lang_definitions": {
                        "en": "to contract an illness or enter a physical state"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "catch",
                                "target_lang_sense_clarification": "to become infected with a cold or illness"
                            },
                            {
                                "target_lang_word": "get",
                                "target_lang_sense_clarification": "to develop a condition like sleep or a cold"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b0650b23-34a9-3a67-a4bc-e713687eebac",
                    "sense_definition": "iemand gevangennemen of aanhouden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vangen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De voortvluchtige crimineel werd eindelijk door de recherche <w>gevat</w>.",
                            "target_lang_translations": {
                                "en": "The fugitive criminal was finally <w>caught</w> by the detectives."
                            }
                        },
                        {
                            "text": "Zij hopen de dader snel te <w>vatten</w> na de overval.",
                            "target_lang_translations": {
                                "en": "They hope to <w>apprehend</w> the perpetrator quickly after the robbery."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to capture or arrest someone"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "catch",
                                "target_lang_sense_clarification": "to capture a criminal"
                            },
                            {
                                "target_lang_word": "apprehend",
                                "target_lang_sense_clarification": "to arrest someone"
                            },
                            {
                                "target_lang_word": "capture",
                                "target_lang_sense_clarification": "to take someone as a prisoner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}