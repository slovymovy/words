                                "example_id": "ffc35c2d-4b13-4298-9924-34ba8f3b19a5",
                                "sense_id": "c0129e79-487f-362b-a5a9-24e5a1041299",
                                "text": "Five enucleated fragments were cut from the egg immediately after they were released and kept for an hour in the sterilized water;"
                            },
                            {
                                "example_id": "84e415ae-fd87-4d6b-a318-4e28915e1c97",
                                "sense_id": "c0129e79-487f-362b-a5a9-24e5a1041299",
                                "text": "For the nuclear transfer of somatic cells in farm animals, donor cells are fused with enucleated oocytes by eletric stimulation."
                            },
                            {
                                "example_id": "ae4d05cd-6cee-441d-9f61-d9edca5b0b69",
                                "sense_id": "c0129e79-487f-362b-a5a9-24e5a1041299",
                                "text": "When nuclei of medaka adult somatic cells were used as donors for transfer into enucleated recipient eggs, successful development of transplant embryos was markedly reduced (unpublished data); however, fertile, diploid NTs had been produced in previous studies in which embryonic cell nuclei were transferred into enucleated eggs."
                            }
                        ]
