                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a93182c1-966d-42f4-af31-c87a68bdbcca",
                        "source_entry_id": "f835cf48-d248-3bcc-a03c-967f57a97b71",
                        "target_lang_word": "wellevendheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wellevendheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6554ca1c-e3bc-3bfb-8a83-ce4628cacaf1",
                                        "entry_id": "b41b39f1-da47-339c-9507-f0a294a8f617",
                                        "glosses": [
                                            "een stelsel van manieren en gedragingen die waarborgen dat mensen met elkaar omgaan op een manier die maatschappelijk aanvaard is en die positief wordt gewaardeerd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "637f65da-6423-4e78-ac4f-320952b7fc9a",
                                                "sense_id": "6554ca1c-e3bc-3bfb-8a83-ce4628cacaf1",
                                                "text": "Doel is het vergroten van de bewustwording waar het gaat om wellevendheid, ofwel fatsoen. Personeelsleden krijgen geleerd hoe ze er in de praktijk mee moeten omgaan en hoe ze het probleem ook daadwerkelijk kunnen aanpakken. De training is in principe voor iedere medewerker in de woon-zorgcentra, omdat iedereen het pesten kan herkennen."
                                            },
                                            {
                                                "example_id": "3cf13418-aed2-45af-b680-d2252f30b4a4",
                                                "sense_id": "6554ca1c-e3bc-3bfb-8a83-ce4628cacaf1",
                                                "text": "„Een harmonieuze samenleving is gebouwd op respect, verdraagzaamheid en wellevendheid. Dat vergt geven en nemen, tolerantie maar ook aanpassing. Dit is de verantwoordelijkheid van ons allen.”"
                                            },
                                            {
                                                "example_id": "86c6404f-79da-4db5-8789-fb885b5066b8",
                                                "sense_id": "6554ca1c-e3bc-3bfb-8a83-ce4628cacaf1",
                                                "text": "Oud-fractievoorzitter van GroenLinks Femke Halsema twitterde meteen nadat de uitspraak bekend was geworden: 'Bij de terechte strafrechtelijke vrijspraak hoort wel de opdracht om de deugd van wellevendheid betrachten.'"
                                            },
                                            {
                                                "example_id": "0f8250b8-540f-4d05-bdfa-6465f10f59b8",
                                                "sense_id": "6554ca1c-e3bc-3bfb-8a83-ce4628cacaf1",
                                                "text": ",,Als ik kijk naar de wellevendheid van mijn dochter en mijn zoon en mijn schoondochter en schoonzoon… Dat zijn prima mensen. Ook mijn twee kleindochters, de oudste is 6 en de jongste 4, zijn buitengewoon scherpzinnige kinderen. Want zij zeggen over opa: ‘Pake is heel lief, maar hij is ook een beetje gek.’ Nou, dan moet je toch wel uiterst helder van geest zijn, wil je dat zomaar in een paar woorden samenvatten.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
