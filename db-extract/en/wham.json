    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "960eb6f1-b375-3cee-87fb-0e69c747d170",
                "word": "wham",
                "pos": "intj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "974878fc-5a38-358c-8ecf-f67aef84643a",
                        "entry_id": "960eb6f1-b375-3cee-87fb-0e69c747d170",
                        "glosses": [
                            "Used to indicate the sound of a forceful blow, an explosion, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34cee865-747d-471e-abf0-8b8f631e0801",
                                "sense_id": "974878fc-5a38-358c-8ecf-f67aef84643a",
                                "text": "Wham! The truck hit the wall."
                            },
                            {
                                "example_id": "2168c490-5fb6-470b-958b-39b4b824b274",
                                "sense_id": "974878fc-5a38-358c-8ecf-f67aef84643a",
                                "text": "\"Come here, kid, I got something for you.\" Then wham and he lit on his hands and knees beside the track. Nick rubbed his eye. There was a big bump coming up."
                            },
                            {
                                "example_id": "8e93bfbb-2ec3-4bc1-b4e6-1980ada037a9",
                                "sense_id": "974878fc-5a38-358c-8ecf-f67aef84643a",
                                "text": "The second matador slipped, and the bull caught him through the belly and he hung onto the horn with one hand and held the other right against the place, and the bull rammed him wham against the barrier and the horn came out, and he lay in the sand, and then got up like crazy drunk and tried to slug the men carrying him away and yelled for his sword, but he fainted."
                            },
                            {
                                "example_id": "6c549864-5654-40de-849b-db0f6a1131c9",
                                "sense_id": "974878fc-5a38-358c-8ecf-f67aef84643a",
                                "text": "I was off duty, minding my own business, walking across the Avenue of the Americas at Forty-fifth Street on my way to Charlie Rothstein's when I heard a gun go off. Wham! it roared, not more than twenty feet from me, and then, in quick succession, wham—wham!"
                            }
                        ]
                    },
                    {
                        "sense_id": "9f339851-f1af-387a-89cc-bf46187dfdc6",
                        "entry_id": "960eb6f1-b375-3cee-87fb-0e69c747d170",
                        "glosses": [
                            "Used to indicate something dramatic, sudden, and unanticipated has occurred."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58e9caa3-b10f-4fd5-afdb-49f4f64024a4",
                                "sense_id": "9f339851-f1af-387a-89cc-bf46187dfdc6",
                                "text": "Our relationship was going smoothly and then wham! Out of nowhere he told me he was leaving me for another woman."
                            },
                            {
                                "example_id": "f9aca1b3-112c-45b8-8ab1-c646ba97ade5",
                                "sense_id": "9f339851-f1af-387a-89cc-bf46187dfdc6",
                                "text": "Wham! Overnight he [Dwight D. Eisenhower] became a warmonger."
                            },
                            {
                                "example_id": "026ede90-d0c3-49d0-bf0b-fdf3df3247dc",
                                "sense_id": "9f339851-f1af-387a-89cc-bf46187dfdc6",
                                "text": "In myself I've come to notice that aging comes in spurts. […] I'll look the exact same way for a decade, and then—wham!—God hits the progeria switch and for two years the downhill plunge begins anew. And then it stops again."
                            }
                        ]
                    }
                ],
