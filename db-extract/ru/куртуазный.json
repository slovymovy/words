                ],
                "translations": [
                    {
                        "translation_id": "bcd6fd3a-6b66-4c21-bf23-e505185225c8",
                        "source_entry_id": "865dcd7a-d5c3-3f32-a41e-56da701fbcd0",
                        "source_sense_description": "галантный, рыцарский, аристократический",
                        "target_lang_word": "courteous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courteous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5445d71c-454f-3657-aab2-4f8b253edbef",
                                        "entry_id": "01c23e6a-54d4-392c-8d73-7f47d1320f76",
                                        "glosses": [
                                            "Showing regard or thought for others; especially, displaying good manners or etiquette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9261fbe-f519-4b9b-94d3-18655e34c1c4",
                                                "sense_id": "5445d71c-454f-3657-aab2-4f8b253edbef",
                                                "text": "a courteous gentleman   a courteous gesture"
                                            },
                                            {
                                                "example_id": "6b4366d4-c716-487b-a97e-4c5fa97a3535",
                                                "sense_id": "5445d71c-454f-3657-aab2-4f8b253edbef",
                                                "text": "Nectar ran / In courteous fountains to all cups outreach'd; / And plunder'd vines, teeming exhaustless, pleach'd / New growth about each shell and pendent lyre; [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dceca0c-c3dd-4ce1-b217-4e26d7b0260c",
                        "source_entry_id": "865dcd7a-d5c3-3f32-a41e-56da701fbcd0",
                        "source_sense_description": "галантный, рыцарский, аристократический",
                        "target_lang_word": "courtly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "courtly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49ce6b5e-bc05-3ad3-8d20-10309fa5ec04",
                                        "entry_id": "39268052-65de-39ac-9e0c-88f43bf17932",
                                        "glosses": [
                                            "Befitting of a royal court; reflecting the manners or behaviour of people at court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59ef06e3-0353-4dce-805e-590dfb8bb58a",
                                                "sense_id": "49ce6b5e-bc05-3ad3-8d20-10309fa5ec04",
                                                "text": "The troubadours sang songs about courtly love."
                                            },
                                            {
                                                "example_id": "9290dd5d-34e8-4793-9cac-82124c4d77f7",
                                                "sense_id": "49ce6b5e-bc05-3ad3-8d20-10309fa5ec04",
                                                "text": "He swept off his hat and made a deep courtly bow."
                                            },
                                            {
                                                "example_id": "a5c33d4e-a1fa-44a9-8cc0-c17e1f1cc057",
                                                "sense_id": "49ce6b5e-bc05-3ad3-8d20-10309fa5ec04",
                                                "text": "Corin: You have too courtly a wit for me; I’ll rest."
                                            },
                                            {
                                                "example_id": "ad97d527-a55d-479e-a412-2e1870106ad5",
                                                "sense_id": "49ce6b5e-bc05-3ad3-8d20-10309fa5ec04",
                                                "text": "[…] you must give men of Quality leave to speak in a Language more Gentile and Courtly than the ordinary sort of mankind."
                                            },
                                            {
                                                "example_id": "ba8dae1f-9e7b-42aa-bb22-51e8efe701fa",
                                                "sense_id": "49ce6b5e-bc05-3ad3-8d20-10309fa5ec04",
                                                "text": "He is a Master of Civility, no less well-bred to his own Sex than courtly to the other."
                                            },
                                            {
                                                "example_id": "844c57fe-55d0-4bd4-95e3-74466f3434ae",
                                                "sense_id": "49ce6b5e-bc05-3ad3-8d20-10309fa5ec04",
                                                "text": "As they abased themselves before him, Mr. Micawber took a seat, and waved his hand in his most courtly manner."
                                            },
                                            {
                                                "example_id": "7b7574be-6a21-48a3-b8b3-fd7e752f3a6b",
                                                "sense_id": "49ce6b5e-bc05-3ad3-8d20-10309fa5ec04",
                                                "text": "Their voices, the gestures of their refined grimy hands, were unbelievably courtly, delicate. Their carriage suggested the majesty of Aztec princes, their faces obscure sculpturings on Yucatecan ruins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43deade3-c3bf-3b32-a8c3-92943f422729",
                                        "entry_id": "39268052-65de-39ac-9e0c-88f43bf17932",
                                        "glosses": [
                                            "Of or relating to a royal court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b993bf8e-1d11-465e-8dc1-1f5503901f91",
                                                "sense_id": "43deade3-c3bf-3b32-a8c3-92943f422729",
                                                "text": "She tried to remain aloof from courtly intrigues."
                                            },
                                            {
                                                "example_id": "078c329d-7a7d-42c5-a149-3ca1b08c5573",
                                                "sense_id": "43deade3-c3bf-3b32-a8c3-92943f422729",
                                                "text": "in houres secure from courtly strife"
                                            },
                                            {
                                                "example_id": "5b57a34a-65e8-452c-8b76-bb49a8e21810",
                                                "sense_id": "43deade3-c3bf-3b32-a8c3-92943f422729",
                                                "text": "The rich are in general slaves to fear, and submit to courtly power with the trembling duplicity of a spaniel."
                                            },
                                            {
                                                "example_id": "b92f5b6d-a2eb-486e-82b5-d5e1c02d21a8",
                                                "sense_id": "43deade3-c3bf-3b32-a8c3-92943f422729",
                                                "text": "He had for years held some clerical office appertaining to courtly matters, which had enabled him to live in London,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3278921-0fc5-3f01-b7e0-0f0087a228b7",
                                        "entry_id": "39268052-65de-39ac-9e0c-88f43bf17932",
                                        "glosses": [
                                            "Overly eager to please or obey."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8b519d4-417b-450a-af7a-3e43a755854d",
                                                "sense_id": "c3278921-0fc5-3f01-b7e0-0f0087a228b7",
                                                "text": "Here FLATT’RY, eldest born of guile,\nWeaves with rare skill the silken smile,\nThe courtly cringe, the supple bow,\nThe private squeeze, the Levee vow,"
                                            },
                                            {
                                                "example_id": "d5816e74-09d5-4356-a170-5b15da3eec62",
                                                "sense_id": "c3278921-0fc5-3f01-b7e0-0f0087a228b7",
                                                "text": "That judgment James had notoriously obtained […] by dismissing scrupulous magistrates, and by placing on the bench other magistrates more courtly."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "courtly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b64257a3-0a24-3122-bdf2-62f345519e5d",
                                        "entry_id": "3088f225-000b-314d-945b-0a0f1cd71c2c",
                                        "glosses": [
                                            "In the manner of a royal court; in a manner befitting of a royal court."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8126d5ee-ecde-4c1b-85b0-79e73ea92572",
                                                "sense_id": "b64257a3-0a24-3122-bdf2-62f345519e5d",
                                                "text": "Then will I deck thee Princely, instruct thee courtly,\nAnd present thee to the Queene as my gift."
                                            },
                                            {
                                                "example_id": "f5e83c65-7ff0-4aaa-aab6-8658f1e362e9",
                                                "sense_id": "b64257a3-0a24-3122-bdf2-62f345519e5d",
                                                "text": "[…] where, in the name of wonder, have you learn’d to talk so courtly?"
                                            },
                                            {
                                                "example_id": "2a655c0c-f66b-4fdb-afb1-cce4019bfdff",
                                                "sense_id": "b64257a3-0a24-3122-bdf2-62f345519e5d",
                                                "text": "1766, Elizabeth Griffith, The Double Mistake, London: J. Almon et al., Act I, Scene 3, p. 12,\nVery courtly and correctly spoken on all sides, my lord;"
                                            },
                                            {
                                                "example_id": "dbcec64e-fe56-4e23-b2c4-4e39852c6dca",
                                                "sense_id": "b64257a3-0a24-3122-bdf2-62f345519e5d",
                                                "text": "The driver waited courtly by the open doors of the saloon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "239bd333-568e-47c5-a81f-0cdea10f2842",
