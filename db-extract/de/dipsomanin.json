                "senses": [
                    {
                        "sense_id": "337edd35-de6f-3961-85c3-1e606ba949e4",
                        "entry_id": "dab8c760-3407-38b1-ac30-c9d9b1553fe0",
                        "glosses": [
                            "weibliche Person, die von immer wiederkehrender Alkoholsucht befallen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa6e85f5-e16d-41c4-a867-930fc031e07e",
                                "sense_id": "337edd35-de6f-3961-85c3-1e606ba949e4",
                                "text": "„Wenn man mit einer Dipsomanin verheiratet wäre, würde man dann vorgeben, daß die Alkoholsucht völlig harmlos sei?“"
                            },
                            {
                                "example_id": "b6fab1f0-66dd-469c-8aa9-adbfc19bdf58",
                                "sense_id": "337edd35-de6f-3961-85c3-1e606ba949e4",
                                "text": "„Ich bin nicht betrunken“, sagte sie schließlich. „Ich bin vielleicht… leicht alkoholisiert, aber mir missfällt deine Unterstellung, ich könnte … könnte eine … Dipsomanin sein.“"
                            },
                            {
                                "example_id": "c9b0a7cc-2dab-4d9b-9a4c-b173d91278e2",
                                "sense_id": "337edd35-de6f-3961-85c3-1e606ba949e4",
                                "text": "„Leidesdorf sah eine Frau im Wochenbett Dipsomanin werden; ebenso Ball.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38e612e3-8ffa-44cb-9f49-30e44080905f",
                        "source_entry_id": "dab8c760-3407-38b1-ac30-c9d9b1553fe0",
                        "source_sense_id": "337edd35-de6f-3961-85c3-1e606ba949e4",
