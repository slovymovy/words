                                "example_id": "3e5bc22a-6685-4f56-a8ba-fb628d9c76b5",
                                "sense_id": "4a54ac9e-6f32-3008-a78d-7faa599675bc",
                                "text": "steadily increasing demand"
                            },
                            {
                                "example_id": "1be60f05-68e1-4ce6-a89e-68c2bd246370",
                                "sense_id": "4a54ac9e-6f32-3008-a78d-7faa599675bc",
                                "text": "The world’s environmental crises are an increasing concern in international politics. Deforestation of the Amazon was high on the agenda of this week’s G7 meeting in Biarritz, France. In September, world leaders will gather in New York for a climate action summit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "42f5c56c-ea57-40b2-b9b0-d73d10a8906b",
                        "source_entry_id": "1a38675f-17af-32fa-8b53-866097440500",
                        "source_sense_id": "4a54ac9e-6f32-3008-a78d-7faa599675bc",
                        "source_sense_description": "on the increase",
                        "target_lang_word": "croissant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9973e290-9abc-3b92-9561-f744ea8517e9",
                                        "entry_id": "8bddf18e-034c-3167-b5d1-9933b188f444",
                                        "glosses": [
                                            "Qui s’accroît ; qui va augmentant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc0a97f6-6b4f-4d33-84ed-4fcafa8dc3d1",
                                                "sense_id": "9973e290-9abc-3b92-9561-f744ea8517e9",
                                                "text": "Et moi je vous dis, s’écria Marguerite avec un dépit croissant, moi je vous dis qu’il ne viendra pas."
                                            },
                                            {
                                                "example_id": "fd14205a-ac21-45e6-970b-6ad02482a19d",
                                                "sense_id": "9973e290-9abc-3b92-9561-f744ea8517e9",
                                                "text": "Nous avons présenté cette histoire, non dans une successivité véritablement chronologique, mais dans un ordre d’heuristicité croissante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2afd2245-b6bd-3644-ae1b-acb9aba91c03",
                                        "entry_id": "8bddf18e-034c-3167-b5d1-9933b188f444",
                                        "glosses": [
                                            "Relatif aux phases de la lune quand elle passe de la nouvelle lune à la pleine lune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed8d4cf1-5714-4ecb-aad2-c5b78a509edc",
                                                "sense_id": "2afd2245-b6bd-3644-ae1b-acb9aba91c03",
                                                "text": "Si l’on voulait être plus précis, il faudrait diviser les phases lunaires en 8 étapes : Nouvelle lune, Premier croissant, Premier quartier, Lune gibbeuse croissante, Pleine lune, Lune gibbeuse décroissante, Dernier quartier et Dernier croissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c89c23c-09b8-307f-a8d6-5d86cf558185",
                                        "entry_id": "8bddf18e-034c-3167-b5d1-9933b188f444",
                                        "glosses": [
                                            "Qui satisfait la condition f(s) ≤ f(t) si s ≤ t pour tout couple (s, t) d’éléments, en parlant d’une fonction d’une variable réelle f."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "croissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43828ec0-8ea7-3053-ac03-c9e03a452f6a",
                                        "entry_id": "89b33a64-082a-3a79-a061-9766fde02630",
                                        "glosses": [
                                            "Phase de la lune quand elle passe de la nouvelle lune au premier quartier, ou du dernier quartier à la nouvelle lune, par opposition à la lune gibbeuse. Note d’usage : À ne pas confondre avec l’adjectif croissant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51ba4aaf-940a-4e3f-8dd7-5d44385e0a57",
                                                "sense_id": "43828ec0-8ea7-3053-ac03-c9e03a452f6a",
                                                "text": "Lorsque la Lune sortant nouvellement de la conjonction se tire au soir des rayons du Soleil, & qu’elle commence à nous montrer une petite portion de sa moitié illuminée, l’autre portion étant tournée vers le Ciel c’est alors & principalement environ à l’Aspect Sextil, que cette Phase est appellée Croissant, & qu’on dit que la Lune est en son Croissant. […] Il est évident que la Lune a les mêmes Phases en décroissant, qu’elle a en croissant, mais c’est en retrogradant."
                                            },
                                            {
                                                "example_id": "65bb857b-44b2-468b-8996-02c170ed40a7",
                                                "sense_id": "43828ec0-8ea7-3053-ac03-c9e03a452f6a",
                                                "text": "Là, des blocs moussus jonchent le sol et des colonnes brisées sont étendues comme des mortes ; les colombes se posent sur les tuiles du faîte et les rebords usés des corniches ; dans un angle, le croissant de la lune veille au ciel."
                                            },
                                            {
                                                "example_id": "16b724a2-b56e-4d40-b66e-1ed2f9ff0284",
                                                "sense_id": "43828ec0-8ea7-3053-ac03-c9e03a452f6a",
                                                "text": "Si l’on voulait être plus précis, il faudrait diviser les phases lunaires en 8 étapes : Nouvelle lune, Premier croissant, Premier quartier, Lune gibbeuse croissante, Pleine lune, Lune gibbeuse décroissante, Dernier quartier et Dernier croissant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7c049c8a-53dd-399a-bb97-17468b134edf",
                                        "entry_id": "89b33a64-082a-3a79-a061-9766fde02630",
                                        "glosses": [
                                            "Morceau de disque, concave d’un côté et convexe de l’autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e50ded6-8847-4550-a442-a70fef73ff84",
                                                "sense_id": "7c049c8a-53dd-399a-bb97-17468b134edf",
                                                "text": "Or j’eus comme voisin de lit un aumônier du genre fier et silencieux, qui s'équipait en musulman pour les tirailleurs marocains. Le croissant sur son calot était un beau sujet de plaisanterie ; […]."
                                            },
                                            {
                                                "example_id": "efcd1879-f363-43ec-b61e-318710f97af9",
                                                "sense_id": "7c049c8a-53dd-399a-bb97-17468b134edf",
                                                "text": "Une plantureuse matrone se coiffe avec majesté d’un tarbouche à glands d’or, orné sur le devant d’un croissant de cuivre."
                                            },
                                            {
                                                "example_id": "9fa64562-91f6-45e8-8e32-fd9c028df368",
                                                "sense_id": "7c049c8a-53dd-399a-bb97-17468b134edf",
                                                "text": "Il y a eu “Big bang”, une boule à facettes faisant tourbillonner étoiles de David et croissants musulmans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00bc3072-4798-3c30-ad5a-4fa3bf922849",
                                        "entry_id": "89b33a64-082a-3a79-a061-9766fde02630",
                                        "glosses": [
                                            "Viennoiserie qui adopte cette forme."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f93c9d0-3aca-447b-9a85-24577881646d",
                                                "sense_id": "00bc3072-4798-3c30-ad5a-4fa3bf922849",
                                                "text": "Je ne m’asseyais pas en face de lui pour ne pas le voir tremper son croissant beurré dans le chocolat."
                                            },
                                            {
                                                "example_id": "8c163129-f0e0-48a4-936d-58bbf8f67e77",
                                                "sense_id": "00bc3072-4798-3c30-ad5a-4fa3bf922849",
                                                "text": "Seuls quelques jeunes gens et quelques cheminots y venaient prendre un café-crème et un croissant ou un sandwich avec un rosé limé."
                                            },
                                            {
                                                "example_id": "718df285-5fe8-4adc-a26f-639b682da9fe",
                                                "sense_id": "00bc3072-4798-3c30-ad5a-4fa3bf922849",
                                                "text": "À l'époque, la boutique me paraissait plus grande, plus haute surtout puisque je devais me mettre sur la pointe des pieds pour inspecter croissants, pains aux raisins et pains au chocolat pour finalement toujours choisir ce dernier."
                                            },
                                            {
                                                "example_id": "eb840b1b-39cf-4769-81e6-d71a96562e91",
                                                "sense_id": "00bc3072-4798-3c30-ad5a-4fa3bf922849",
                                                "text": "Les inspecteurs se sont tout de même rendus sur place et ont fini par apercevoir l’objet dans un lilas, notant qu’il n’avait « ni pattes ni tête ». « Nous savions déjà que nous ne pouvions pas aider cette créature… La mystérieuse ‘lagune’… s’est avérée être un croissant », ont-ils rapporté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d995effe-dc46-3280-8de6-b00fea9ada3a",
                                        "entry_id": "89b33a64-082a-3a79-a061-9766fde02630",
                                        "glosses": [
                                            "Bombyx de l’ailante (papillon)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc280fb8-ba74-3bb7-838c-35aad21b05bf",
                                        "entry_id": "89b33a64-082a-3a79-a061-9766fde02630",
                                        "glosses": [
                                            "Outil à long manche et à lame en forme de faucille, qui sert à couper des ronces et des broussailles ; faucard, volant, goui."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1a7decf-9cac-4ebb-88c6-0e11b37873ff",
                                                "sense_id": "dc280fb8-ba74-3bb7-838c-35aad21b05bf",
                                                "text": "En Montagne bourbonnaise, l'élagage vertical des haies est réalisé indifféremment tantôt avec l'aide du croissant, tantôt avec celle d'un volant ( outil de moisson semblable à une faucille à courbure très prononcée ), fixé au bout d'un long manche."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30e6e418-cca5-35f4-9730-7c0c71ced4a9",
                                        "entry_id": "89b33a64-082a-3a79-a061-9766fde02630",
                                        "glosses": [
                                            "Meuble représentant un croissant de lune dans les armoiries. Sa position ordinaire est une orientation les pointes vers le chef. Il est dit versé ou renversé quand les pointes sont vers la pointe. Il est qualifié de couché ou tourné quand ses pointes sont à dextre et contourné quand les pointes sont à senestre. On trouve parfois adextré et senestré. À rapprocher de lune et lunel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0c312fa-3d42-4246-b826-c082b12b3d7a",
                                                "sense_id": "30e6e418-cca5-35f4-9730-7c0c71ced4a9",
                                                "text": "D’or à la barre d’azur chargée de trois étoiles de six rais d’argent posées à plomb, accompagnée en chef d’un croissant de gueules et en pointe d’une feuille de chêne de sinople posée en barre, qui est de la commune d’Autrecourt-et-Pourron → voir illustration « armoiries avec un croissant »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "croissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0e1df990-1dd5-3fa9-8f51-b940015ca91f",
                                        "entry_id": "82055a1e-b376-3ae8-8f48-33099197286b",
                                        "glosses": [
                                            "Croisement de voies, carrefour."
                                        ],
                                        "tags": [
                                            "Bretagne"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed4310bf-03ab-4c52-9007-9cf1cc3e0bcf",
                                                "sense_id": "0e1df990-1dd5-3fa9-8f51-b940015ca91f",
                                                "text": "Si on te dis : \"Tu tournes à droite au croissant\", ne t'attends pas à un virage en demi-lune, mais à un carrefour…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "croissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7dc93dc1-9283-3eaf-b80b-713dc1bea80e",
                                        "entry_id": "aee47086-39b0-308c-be7d-21a5c1464923",
                                        "glosses": [
                                            "Participe présent du verbe croître."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80e5fca-cfda-4897-955e-9002077105e7",
                                                "sense_id": "7dc93dc1-9283-3eaf-b80b-713dc1bea80e",
                                                "text": "Cette question mariant sécurité et efficacité dans des élevages dont la taille va croissant tandis que la main d’œuvre, elle, se fait rare, est de plus en plus prégnante avec les nombreuses interventions qui émaillent la vie des cheptels, allaitants notamment : pour piquer, vacciner, trier, écorner, tondre, parer… il faut alloter, désalloter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
