                            {
                                "example_id": "dba0c52f-a2c9-4bf0-9505-5e1a9d827f1a",
                                "sense_id": "28a42164-c619-34a1-84b1-7b6aaa5662c3",
                                "text": "Weihnachten verbringen Herr und Frau Diehl in Moskau."
                            },
                            {
                                "example_id": "fa0d7968-72ab-4b1b-9cde-63ee4f8c0c19",
                                "sense_id": "28a42164-c619-34a1-84b1-7b6aaa5662c3",
                                "text": "Zwischen den Diehls kriselt es."
                            },
                            {
                                "example_id": "5b020665-597e-4e91-804a-9a126d999707",
                                "sense_id": "28a42164-c619-34a1-84b1-7b6aaa5662c3",
                                "text": "Diehl junior hat sein Studium abgeschlossen."
                            },
                            {
                                "example_id": "46558643-3ccf-4739-82ab-233eb3fa7a05",
                                "sense_id": "28a42164-c619-34a1-84b1-7b6aaa5662c3",
                                "text": "Die kleine Diehl ist ganz schön keck."
                            },
                            {
                                "example_id": "2da43de3-92dd-4822-8ec7-25c1b743a468",
                                "sense_id": "28a42164-c619-34a1-84b1-7b6aaa5662c3",
                                "text": "Herrn Diehls Smoking ist dreckig."
                            }
                        ],
