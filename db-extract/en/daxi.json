                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d98e66d-8808-4d3f-964b-712ee38c46d0",
                                "sense_id": "c4fa5945-51bc-302d-9abd-067adf16174d",
                                "text": "At Cihu, near the town of Daxi, 30 miles (50 km) southwest of Taipei on Provincial Highway 7, Chiang Kai-shek lies entombed above ground in a granite and marble coffin in one of his former country villas. The gravesite is \"temporary,\" as before his death Chiang had requested his body be returned to his native province of Zhejiang in mainland China."
                            },
                            {
                                "example_id": "45302b1f-7ede-486a-b802-03c3645d0193",
                                "sense_id": "c4fa5945-51bc-302d-9abd-067adf16174d",
                                "text": "Now, busloads of Chinese tourists come every week to visit Chiang’s tomb, nestled between two red and blue Taiwanese flags in the small town of Daxi, an hour’s drive south of Taipei."
                            }
                        ]
                    }
