                    "frequency": "Low",
                    "semantic_group_id": "werkwoordvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schipper</w> tussen twee uitersten om iedereen tevreden te houden.",
                            "target_lang_translations": {
                                "en": "I <w>maneuver</w> between two extremes to keep everyone satisfied."
