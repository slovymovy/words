                        "glosses": [
                            "The military punishment of placing somebody on the back of another person, or on a wooden horse, etc., to be flogged."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75eed2d0-ae70-49cc-92a9-03dfd03f95bb",
                                "sense_id": "89ae6e8c-96bc-3889-88d4-ded9db621c46",
                                "text": "And though we cannot enumerate the “horsings,” and other little tender attentions that his juvenile indiscretions obtained him, we give him full credit for having received a modicum of castigation."
                            },
                            {
                                "example_id": "67ec586c-d6ca-44dc-83cf-e680f3f9370b",
                                "sense_id": "89ae6e8c-96bc-3889-88d4-ded9db621c46",
                                "text": "He grew up mortal fond of trading, and with a mortal hatred to learning; he, however, was flogged through Osterald's abridgement of the New Testament once or twice, and got one or two horsings over a Chapter of Genesis […]"
                            }
                        ]
                    }
