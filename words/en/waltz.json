{
    "word_family": [
        "waltzer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bdbe7b7b-5015-3983-96be-f9675a304042",
                    "sense_definition": "A ballroom dance in 3/4 time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waltz_dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They danced a beautiful <w>waltz</w> at their wedding reception.",
                            "target_lang_translations": {
                                "ru": "Они станцевали красивый <w>вальс</w> на своем свадебном торжестве."
                            }
                        },
                        {
                            "text": "The couple practiced the steps of the slow <w>waltz</w> for weeks.",
                            "target_lang_translations": {
                                "ru": "Пара неделями репетировала шаги медленного <w>вальса</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "slow waltz",
                        "dance a waltz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Бальный танец в трехдольном размере (3/4)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вальс",
                                "target_lang_sense_clarification": "бальный танец"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05966ad-0bfc-3606-bfef-f67bfeda6acb",
                    "sense_definition": "A piece of music written for a waltz dance, typically in triple time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waltz_dance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchestra played a famous <w>waltz</w> by Strauss.",
                            "target_lang_translations": {
                                "ru": "Оркестр исполнил знаменитый <w>вальс</w> Штрауса."
                            }
                        },
                        {
                            "text": "She sat at the piano and began to play a gentle <w>waltz</w>.",
                            "target_lang_translations": {
                                "ru": "Она села за пианино и начала играть нежный <w>вальс</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "play a waltz",
                        "beautiful waltz"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальное произведение, написанное в ритме вальса, обычно в трехдольном размере."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вальс",
                                "target_lang_sense_clarification": "музыкальное произведение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b18708fb-26a6-3250-9098-4b27863d46a4",
                    "sense_definition": "A simple task that is very easy to accomplish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "easy_task",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The final exam was a complete <w>waltz</w> for anyone who had studied.",
                            "target_lang_translations": {
                                "ru": "Выпускной экзамен оказался <w>проще простого</w> для всех, кто учился."
                            }
                        },
                        {
                            "text": "Winning the match turned out to be an absolute <w>waltz</w>.",
                            "target_lang_translations": {
                                "ru": "Победа в матче оказалась абсолютным <w>пустяком</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "breeze",
                        "cinch",
                        "cakewalk"
                    ],
                    "common_phrases": [
                        "absolute waltz",
                        "complete waltz"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe an easy task"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Простая задача, которую очень легко выполнить; пустяковое дело."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пустяк",
                                "target_lang_sense_clarification": "очень легкое дело"
                            },
                            {
                                "target_lang_word": "проще простого",
                                "target_lang_sense_clarification": "очень легкая задача"
                            },
                            {
                                "target_lang_word": "детский лепет",
                                "target_lang_sense_clarification": "очень простое дело"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d6859239-44b0-3012-85a8-1392a0a6a0a2",
                    "sense_definition": "To dance the waltz, either alone or with a partner.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "waltz_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They <w>waltzed</w> gracefully across the ballroom floor.",
                            "target_lang_translations": {
                                "ru": "Они грациозно <w>вальсировали</w> по залу."
                            }
                        },
                        {
                            "text": "He loved to <w>waltz</w> with her whenever the band played a slow song.",
                            "target_lang_translations": {
                                "ru": "Он обожал <w>кружиться в вальсе</w> с ней каждый раз, когда группа играла медленную песню."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waltz across the floor",
                        "waltz together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Танцевать вальс, в одиночку или с партнером."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вальсировать",
                                "target_lang_sense_clarification": "танцевать вальс"
                            },
                            {
                                "target_lang_word": "кружиться в вальсе",
                                "target_lang_sense_clarification": "танцевать вальс"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4a3e1a2-2730-3911-b7c7-7b92da729034",
                    "sense_definition": "To move briskly and unhesitatingly, especially in an inappropriately casual, uninvited, or confident manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "casual_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>waltzed</w> into the office late without even apologizing to his boss.",
                            "target_lang_translations": {
                                "ru": "Он <w>завалился</w> в офис с опозданием, даже не извинившись перед начальником."
                            }
                        },
                        {
                            "text": "You cannot just <w>waltz</w> in here and demand to see the manager.",
                            "target_lang_translations": {
                                "ru": "Вы не можете просто так <w>ввалиться</w> сюда и требовать встречи с менеджером."
                            }
                        }
                    ],
                    "synonyms": [
                        "breeze",
                        "barge"
                    ],
                    "common_phrases": [
                        "waltz in",
                        "waltz into the room"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe bold or casual intrusion"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться быстро и уверенно, особенно излишне непринужденно, без приглашения или бесцеремонно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завалиться",
                                "target_lang_sense_clarification": "бесцеремонно войти"
                            },
                            {
                                "target_lang_word": "ввалиться",
                                "target_lang_sense_clarification": "непринужденно или шумно войти"
                            },
                            {
                                "target_lang_word": "шествовать",
                                "target_lang_sense_clarification": "уверенно или вальяжно идти"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9deecb6-4af3-33bd-9980-65783426c027",
                    "sense_definition": "To accomplish or win a task with very little effort.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "easy_success",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With her qualifications, she will easily <w>waltz</w> through the job interview.",
                            "target_lang_translations": {
                                "ru": "С ее квалификацией она без труда <w>справится</w> с собеседованием."
                            }
                        },
                        {
                            "text": "The team is expected to <w>waltz</w> to victory in tomorrow's game.",
                            "target_lang_translations": {
                                "ru": "Ожидается, что команда без труда <w>придет</w> к победе в завтрашней игре."
                            }
                        }
                    ],
                    "synonyms": [
                        "breeze",
                        "sail"
                    ],
                    "common_phrases": [
                        "waltz through",
                        "waltz to victory"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe effortless success"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнить задачу или одержать победу с минимальными усилиями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "легко справиться",
                                "target_lang_sense_clarification": "без труда преодолеть"
                            },
                            {
                                "target_lang_word": "играючи пройти",
                                "target_lang_sense_clarification": "с легкостью преодолеть испытание"
                            },
                            {
                                "target_lang_word": "с легкостью победить",
                                "target_lang_sense_clarification": "без труда выиграть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42f70d49-8b3d-3aac-8607-bc730441115e",
                    "sense_definition": "To move or escort someone with fanfare, celebration, or showy display.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "showy_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd gathered to <w>waltz</w> the champion into town with a grand parade.",
                            "target_lang_translations": {
                                "ru": "Толпа собралась, чтобы торжественно <w>проводить</w> чемпиона в город грандиозным парадом."
                            }
                        },
                        {
                            "text": "They planned to <w>waltz</w> him through the streets to celebrate his victory.",
                            "target_lang_translations": {
                                "ru": "Они планировали с помпой <w>провести</w> его по улицам, чтобы отпраздновать его победу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "waltz into town"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вести или сопровождать кого-либо с помпой, торжественно или напоказ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вести с помпой",
                                "target_lang_sense_clarification": "торжественно сопровождать"
                            },
                            {
                                "target_lang_word": "триумфально вести",
                                "target_lang_sense_clarification": "сопровождать с почестями"
                            }
                        ]
                    }
                }
            ]
        },
        {
