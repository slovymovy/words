                                "target_lang_sense_clarification": "propio de un dandi"
                            },
                            {
                                "target_lang_word": "petulante",
                                "target_lang_sense_clarification": "excesivamente presumido en su porte"
                            },
                            {
                                "target_lang_word": "lechuguino",
