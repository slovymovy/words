                ],
                "senses": [
                    {
                        "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                        "entry_id": "64f67ef2-f9f0-3bde-af94-fd5d8ac1375e",
                        "glosses": [
                            "Zustand, bei dem das Klima nicht durch den Menschen beeinflusst wird"
                        ],
                        "tags": [
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "c2e9d6fc-6350-4c01-8191-ebe091b5ae2f",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "[Schlagzeile:] „\"Klimaneutralität bis 2050 ist eine Illusion\"“"
                            },
                            {
                                "example_id": "effb1f4e-531c-458d-bab4-379a6c28a78e",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Das Klimagesetz legt als langfristiges Klimaziel der EU die Klimaneutralität bis 2050 fest.“"
                            },
                            {
                                "example_id": "678bdc18-fb35-40c5-9bd5-1ab0de120248",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "[Schlagzeile:] „Hamburger Wirtschaft will Klimaneutralität bis 2040 erreichen“"
                            },
                            {
                                "example_id": "cdca1db4-dda3-4205-a527-481961612e64",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Die Deutsche Umwelthilfe wirft dem Unternehmen Greenwashing vor und reichte im Mai 2023 eine Klage wegen Verbrauchertäuschung ein, da das Unternehmen mit angeblicher Klimaneutralität wirbt.“"
                            },
                            {
                                "example_id": "b0dc28b1-bbe5-4f79-9f71-cc6d6324d9a7",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "[Schlagzeile:] „Ungezügeltes Fliegen und Klimaneutralität passen nicht zusammen“"
                            },
                            {
                                "example_id": "905ba922-cd35-456f-b159-46bf08882f86",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„In Berlin scheitert ein Volksentscheid für eine raschere Klimaneutralität.“"
                            },
                            {
                                "example_id": "10d053c5-dd90-43c4-ad7c-1cd5c92fa600",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Um das Ziel der Klimaneutralität zu erreichen, werden künftig riesige Mengen \"grünen\" Wasserstoffs gebraucht.“"
                            },
                            {
                                "example_id": "8ab4cc2d-bacf-485e-b58e-34233e1850db",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Auf dem Weg zur Klimaneutralität setzen Chemie- und Stahlindustrie nun auf Wasserstoff.“"
                            },
                            {
                                "example_id": "5f140661-1feb-454f-a9b1-0a058521cc59",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Deshalb ist es im Wettbewerb auch umso ärgerlicher, wenn sich Firmen ihre Klimaneutralität auch durch billige Zertifikate im globalen Süden erkaufen könne.“"
                            },
                            {
                                "example_id": "cd2375b5-1ce7-4a78-92f4-d351900d1940",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Jedoch wurde trotz kombinierter Maßnahmen im Außenraum und an den Gebäuden, die auch die Energiegewinnung durch Photovoltaik auf den Dächern einschloss, nur in einem von fünf untersuchten Quartieren Klimaneutralität erreicht.“"
                            },
                            {
                                "example_id": "3cc403f1-4416-4722-9ef0-def4c6ff0136",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Wenn etwa Privatleute jetzt noch Gas- und Ölheizungen einbauen, müssten die vorzeitig verschrottet werden, um die Klimaneutralität 2040 zu erreichen – oder mit teurem alternativen Brennstoff betrieben“ [werden]."
                            },
                            {
                                "example_id": "db11a986-fe6b-472f-81a9-9aae788158be",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Wenn in dem reformierten Klimaschutzgesetz Klimaneutralität 2045 und minus 65 Prozent für das Jahr 2030 als Ziel festgeschrieben werden - womit das 1,5-Grad-Ziel sicher nicht erreicht werden kann - dann erhält man bei analoger Rechnung wie oben, dass die CO2-Minderung jährlich \"nur\" 8,4 Prozent betragen müsste.“"
                            },
                            {
                                "example_id": "1101f761-a89c-4eae-abba-37c349f611a8",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Da ist schon noch viel zu tun bis zur Klimaneutralität.“"
                            },
                            {
                                "example_id": "9f2e1534-aeac-416b-9b98-a840bcdd1b21",
                                "sense_id": "bd11a98d-8e23-38d8-8854-be483fd2cee5",
                                "text": "„Erforderlich sind also mehr Anstrengungen in Sachen Klimaneutralität und Nachhaltigkeit, besonders in Ländern des Globalen Nordens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
