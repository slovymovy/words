                        "glosses": [
                            "Prouver en sens contraire, en réponse à une preuve fournie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5eeb402-74b5-4635-8923-3e0a743e37ef",
                                "sense_id": "573014d8-d9e0-3906-b887-ba4086b9868d",
                                "text": "Monsieur, fit Sartine, vous aurez toutes occasions d’intervenir, d’interroger et d’être interrogé, de prouver et de contre-prouver, d’attaquer et de contre-attaquer."
                            },
