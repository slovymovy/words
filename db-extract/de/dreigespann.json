                        "entry_id": "a82a3f9c-35d5-32dd-a784-4fe19e832dd9",
                        "glosses": [
                            "Gruppe aus drei zusammengehörenden Objekten, Personen, et cetera"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f56b1da9-740f-4a47-83c3-84af9974f71f",
                                "sense_id": "6be8af83-7617-31eb-a0b9-1a778dc52560",
                                "text": "„So nannten Irokesen und Cherokee das Dreigespann aus Mais, Bohnen und Kürbis.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
