                "senses": [
                    {
                        "sense_id": "437022ac-9e46-35f5-8f7a-41b415063c05",
                        "entry_id": "a336f639-6a7e-3fde-9f48-446bb77d0ea8",
                        "glosses": [
                            "explosieve ontbranding van een gas(mengsel)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9dbc6f2-4350-4bd9-ad96-a110d1fe1550",
                                "sense_id": "437022ac-9e46-35f5-8f7a-41b415063c05",
                                "text": "Naar de oorzaak van de gasontploffing van vanochtend wordt onderzoek gedaan. Eén vrouw kwam bij de ontploffing om het leven. Bewoners van de flat zeggen dat de vrouw de ontploffing zelf heeft veroorzaakt en zelfmoord wilde plegen."
                            },
                            {
                                "example_id": "c4b7cf47-a32f-488f-b3b0-b8da7420ada1",
                                "sense_id": "437022ac-9e46-35f5-8f7a-41b415063c05",
                                "text": "Ook voorgeleid wordt Mohammed Aalla, de bestuurder van de Audi waarmee de aanslag in Cambrils werd gepleegd. Een andere nog levende verdachte die wordt gehoord is Mohamed Houli Chemlal, die werd gearresteerd na de gasontploffing Alcanar. De vierde verdachte is Salah el Karib, die een internetcafé in Ripoll runde. De terroristische cel opereerde vanuit het Pyreneeën-dorp Ripoll."
                            },
                            {
                                "example_id": "e4bf6e9e-4fdc-4650-804f-7963c64fa47a",
                                "sense_id": "437022ac-9e46-35f5-8f7a-41b415063c05",
                                "text": "Het flatgebouw in Magnitogorsk stortte gisternacht gedeeltelijk in, vermoedelijk door een gasontploffing. Zeker negen mensen kwamen om, er worden nog zo'n 35 mensen vermist."
                            }
                        ]
                    }
