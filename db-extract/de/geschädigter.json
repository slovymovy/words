                "senses": [
                    {
                        "sense_id": "fe618746-a8a8-382f-9071-6f1d02461f77",
                        "entry_id": "386c23ca-53b9-3090-8891-820159cb629a",
                        "glosses": [
                            "jemand, der einen (finanziellen, materiellen, körperlichen, …) Schaden erlitten hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ee5044f-65da-48d0-a457-e1f3a5302a3a",
                                "sense_id": "fe618746-a8a8-382f-9071-6f1d02461f77",
                                "text": "Der Geschädigte klagt auf Schadensersatz."
                            },
                            {
                                "example_id": "9c82d1b6-964d-4a30-a50f-897f3491119f",
                                "sense_id": "fe618746-a8a8-382f-9071-6f1d02461f77",
                                "text": "Ein Geschädigter legt Berufung gegen die Entscheidung des Gerichts ein."
                            },
                            {
                                "example_id": "79898331-4272-49ff-9947-c72470d653e2",
                                "sense_id": "fe618746-a8a8-382f-9071-6f1d02461f77",
                                "text": "Das Schmerzensgeld ist aus Sicht des Geschädigten nicht ausreichend genug."
                            },
                            {
                                "example_id": "529195ff-7286-4a7d-8045-9fad2e0ecf6f",
                                "sense_id": "fe618746-a8a8-382f-9071-6f1d02461f77",
                                "text": "„Bei der Kundgebung waren aus der Menge Farbbeutel auf ein Gasthaus und das Palais Kaufmännischer Verein geschleudert wurden – von wem, war nicht mehr festzustellen. Die Geschädigten klagten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
