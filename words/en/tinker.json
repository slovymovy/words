{
    "word_family": [
        "tinkerer",
        "tinkering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75771252-e216-39c7-8d31-8aa3059ca754",
                    "sense_definition": "To fiddle with something in an attempt to fix, mend or improve it, especially in an experimental or unskilled manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "repair",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the whole afternoon in the garage to <w>tinker</w> with the old lawnmower engine.",
                            "target_lang_translations": {
                                "ru": "Он провел весь день в гараже, чтобы <w>повозиться</w> с двигателем старой газонокосилки."
                            }
                        },
                        {
                            "text": "The government decided to <w>tinker</w> around the edges of the policy instead of making major changes.",
                            "target_lang_translations": {
                                "ru": "Правительство решило внести <w>незначительные правки</w> в политику вместо того, чтобы проводить серьезные изменения."
                            }
                        }
                    ],
                    "synonyms": [
                        "fiddle",
                        "fudge",
                        "hack"
                    ],
                    "common_phrases": [
                        "tinker around the edges",
                        "tinker with something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Возиться с чем-либо, пытаясь починить, исправить или улучшить, часто экспериментальным или неумелым образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "возиться",
                                "target_lang_sense_clarification": "с чем-либо, пытаясь починить"
                            },
                            {
                                "target_lang_word": "ковыряться",
                                "target_lang_sense_clarification": "неумело или медленно чинить"
                            },
                            {
                                "target_lang_word": "химичить",
                                "target_lang_sense_clarification": "делать что-то сложное или непонятное"
                            },
                            {
                                "target_lang_word": "подправлять",
                                "target_lang_sense_clarification": "вносить мелкие изменения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df8233b5-482f-38a4-acac-bb1cd55f5f55",
                    "sense_definition": "To work as a <w>tinker</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "occupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, men would travel from village to village to <w>tinker</w> and mend pots.",
                            "target_lang_translations": {
                                "ru": "В прежние времена люди ходили из деревни в деревню, чтобы <w>заниматься лужением</w> и чинить горшки."
                            }
                        },
                        {
                            "text": "He earned a meager living as he continued to <w>tinker</w> across the countryside.",
                            "target_lang_translations": {
                                "ru": "Он зарабатывал на скудную жизнь, продолжая <w>странствовать как медник</w> по сельской местности."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to a historical occupation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать странствующим лудильщиком или медником."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заниматься лужением",
                                "target_lang_sense_clarification": "историческое ремесло"
                            },
                            {
                                "target_lang_word": "быть медником",
                                "target_lang_sense_clarification": "чинить металлическую посуду"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a521e8e4-2ecf-35ab-b934-7c46708257ea",
                    "sense_definition": "Someone who repairs, or attempts repair, on anything mechanical, or who invents such devices.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandfather was a natural <w>tinker</w> who could fix any broken clock in the house.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка был прирожденным <w>умельцем</w>, который мог починить любые сломанные часы в доме."
                            }
                        },
                        {
                            "text": "As a hobbyist <w>tinker</w>, she spent her weekends building small robots from spare parts.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>мастером-самоучкой</w>, она проводила выходные, собирая маленьких роботов из запчастей."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который чинит или пытается чинить механические устройства, или изобретает их."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "самоучка",
                                "target_lang_sense_clarification": "мастер на все руки"
                            },
                            {
                                "target_lang_word": "умелец",
                                "target_lang_sense_clarification": "человек, любящий мастерить"
                            },
                            {
                                "target_lang_word": "мастер-самоделкин",
                                "target_lang_sense_clarification": "любитель что-то чинить или собирать"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ed0f792-7431-3bfd-9e02-00420c789c85",
                    "sense_definition": "A mischievous person, especially a playful, impish youngster.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Come back here, you little <w>tinker</w>, and put those cookies back!",
                            "target_lang_translations": {
                                "ru": "А ну вернись, маленький <w>озорник</w>, и положи печенье на место!"
                            }
                        },
                        {
                            "text": "The young <w>tinker</w> hid his sister's shoes just to see her reaction.",
                            "target_lang_translations": {
                                "ru": "Юный <w>проказник</w> спрятал туфли сестры только для того, чтобы посмотреть на ее реакцию."
                            }
                        }
                    ],
                    "synonyms": [
                        "rapscallion",
                        "rascal",
                        "rogue",
                        "scamp"
                    ],
                    "common_phrases": [
                        "little tinker"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used affectionately for children"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Озорной человек, особенно игривый, проказливый ребенок."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "озорник",
                                "target_lang_sense_clarification": "о ребенке"
                            },
                            {
                                "target_lang_word": "проказник",
                                "target_lang_sense_clarification": "шаловливый человек"
                            },
                            {
                                "target_lang_word": "сорванец",
                                "target_lang_sense_clarification": "непоседливый ребенок"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cb9270f5-f327-356a-b3ae-b9c08beab647",
                    "sense_definition": "An act of repair or invention.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I'll have a <w>tinker</w> and see what I can do to fix the radio.",
                            "target_lang_translations": {
                                "ru": "Я немного <w>поковыряюсь</w> и посмотрю, что можно сделать, чтобы починить радио."
                            }
                        },
                        {
                            "text": "After a quick <w>tinker</w> with the settings, the computer started working perfectly again.",
                            "target_lang_translations": {
                                "ru": "После быстрой <w>настройки</w> параметров компьютер снова заработал идеально."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a tinker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт починки, мелкого ремонта или изобретения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "починка",
                                "target_lang_sense_clarification": "мелкий ремонт"
                            },
                            {
                                "target_lang_word": "доработка",
                                "target_lang_sense_clarification": "небольшое улучшение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4296966f-e89a-303b-9600-02ac9f88b4a8",
                    "sense_definition": "An itinerant tinsmith and mender of household utensils made of metal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "occupation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>tinker</w> arrived at the farm with his tools to fix the leaking kettles.",
                            "target_lang_translations": {
                                "ru": "<w>Лудильщик</w> прибыл на ферму со своими инструментами, чтобы починить протекающие чайники."
                            }
                        },
                        {
                            "text": "Historically, a <w>tinker</w> would travel between towns offering metal repair services.",
                            "target_lang_translations": {
                                "ru": "Исторически сложилось так, что <w>жестянщик</w> путешествовал между городами, предлагая услуги по ремонту изделий из металла."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical occupation"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Странствующий жестянщик и мастер по ремонту металлической домашней утвари."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лудильщик",
                                "target_lang_sense_clarification": "странствующий мастер"
                            },
                            {
                                "target_lang_word": "жестянщик",
                                "target_lang_sense_clarification": "мастер по изделиям из жести"
                            },
                            {
                                "target_lang_word": "медник",
                                "target_lang_sense_clarification": "ремонтник медной посуды"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8fba8445-a097-308d-bb68-4fd35a8fc72b",
                    "sense_definition": "A member of the Irish Traveller community or of other itinerant groups.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ethnic_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The documentary explored the traditional lifestyle of the Irish <w>tinker</w> families.",
                            "target_lang_translations": {
                                "ru": "Документальный фильм исследовал традиционный образ жизни семей ирландских <w>кочевников</w>."
                            }
                        },
                        {
                            "text": "In some regions, the term <w>tinker</w> is used to describe nomadic groups.",
                            "target_lang_translations": {
                                "ru": "В некоторых регионах термин <w>тинкер</w> используется для описания кочевых групп."
                            }
                        }
                    ],
                    "synonyms": [
                        "traveller"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily British Isles"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Представитель ирландских путешественников или других кочевых групп."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ирландский путешественник",
                                "target_lang_sense_clarification": "представитель кочевой группы"
                            },
                            {
                                "target_lang_word": "кочевник",
                                "target_lang_sense_clarification": "человек, ведущий бродячий образ жизни"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "b9981b2d-113c-34a1-8e30-b9bba623f545",
                    "sense_definition": "A northern English surname originating as an occupation for someone who mends pots and pans.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local history book mentions a family named <w>Tinker</w> living in the village since 1750.",
                            "target_lang_translations": {
                                "ru": "В книге по местной истории упоминается семья по фамилии <w>Тинкер</w>, живущая в деревне с 1750 года."
                            }
                        },
                        {
                            "text": "Professor <w>Tinker</w> published a significant study on medieval metalworking.",
                            "target_lang_translations": {
                                "ru": "Профессор <w>Тинкер</w> опубликовал значимое исследование по средневековой металлообработке."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "Northern England"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, распространенная на севере Англии, происходящая от профессии мастера по ремонту посуды."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Тинкер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}