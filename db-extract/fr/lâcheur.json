                                        "sense_id": "713d6bce-c5df-381f-92b7-d2e0b9a0bea4",
                                        "entry_id": "d6c8501a-3997-35b9-b365-d17615b35ae8",
                                        "glosses": [
                                            "To plant evidence to facilitate a corrupt arrest."
                                        ],
