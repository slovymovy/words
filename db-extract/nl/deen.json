                                                "sense_id": "b6f659a2-3b64-3b80-b5c7-22e96565ca39",
                                                "text": "Ostatniego lata setki tysięcy Duńczyków pojechało na wakacje do Turcji."
                                            },
                                            {
                                                "example_id": "a258a2b6-5895-4379-89ee-774f87987dec",
                                                "sense_id": "b6f659a2-3b64-3b80-b5c7-22e96565ca39",
                                                "text": "W referendum Duńczycy zdecydowali zachować swoją dotychczasową walutę."
                                            }
