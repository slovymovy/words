                    "frequency": "VeryLow",
                    "semantic_group_id": "household",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старик укрылся старой <w>шубой</w> вместо одеяла.",
                            "target_lang_translations": {
                                "en": "The old man covered himself with an old <w>blanket</w> instead of a quilt."
