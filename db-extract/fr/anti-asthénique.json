                        "entry_id": "8735fdea-f125-3654-a092-59ac4e2b756c",
                        "glosses": [
                            "Qui agit contre l’asthénie, généralement en parlant d’un médicament."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01ba565e-4689-453d-aa89-63067f083cf1",
                                "sense_id": "db91aa61-9238-34eb-8b97-57a615aee4ad",
                                "text": "La sauge est œstrogénique, antioxydante, antalgique, anti-inflammatoire, neuro-protectrice, anti-asthénique et antiseptique localement."
                            },
                            {
                                "example_id": "6521ab66-79a2-4c29-aeb8-0c7230eb9b6b",
                                "sense_id": "db91aa61-9238-34eb-8b97-57a615aee4ad",
                                "text": "Comment peut-on traiter la fatigue chronique ? Avec du repos et des exercices de relaxation, des aliments anti-asthéniques et des régimes riches en vitamines et en aliments énergétiques."
                            },
                            {
                                "example_id": "f89eda4f-0425-486e-9ef8-c5e261e8bdca",
                                "sense_id": "db91aa61-9238-34eb-8b97-57a615aee4ad",
                                "text": "Quant à ses conséquences, il existe de très nombreux médicaments dits anti-asthéniques à base de vitamines, d’acides aminés, de plantes… qui peuvent aider."
                            }
                        ]
                    }
