                "senses": [
                    {
                        "sense_id": "4d6a3a86-cd26-3b88-991e-20f198f82d05",
                        "entry_id": "f5619697-6e9c-348b-abf8-f1e3c99d47fd",
                        "glosses": [
                            "meist kleinere Hörbibliothek, in der man Hörbücher ausleihen kann und in der auch Vorlesungen und andere Veranstaltungen stattfinden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c4556d1-3d04-4def-980c-12537f59d8e3",
                                "sense_id": "4d6a3a86-cd26-3b88-991e-20f198f82d05",
                                "text": "„Am 28. November war der vor allem durch seine Kriminalromane rund um den Polizeioffizier David Bronstein bekannte Politikwissenschaftler, Historiker und Autor Andreas Pittler zu Gast in der Hörbücherei und las aus seinem Roman ‚Wiener Kreuzweg‘.“"
                            },
                            {
                                "example_id": "e25bd502-06ab-4086-81fe-8a105ad34a67",
                                "sense_id": "4d6a3a86-cd26-3b88-991e-20f198f82d05",
                                "text": "„Und die Leser in den Hörbüchereien sollten sich ihre Partner, eben uns zuhörende Blinde, vorstellen, damit sie für uns, nicht für sich lesen. Wir nehmen es ihnen nicht übel, wenn sie sich einmal räuspern oder tief Luft holen müssen. Das ist menschlich und verbindet, auch wenn wir dem Tonband kein Hustenbonbon oder einen Schluck Wasser anbieten können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
