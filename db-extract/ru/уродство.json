                ],
                "senses": [
                    {
                        "sense_id": "aecb2c9e-8e6b-3893-9615-b40dd6c2357b",
                        "entry_id": "e3860e9f-7af3-35ef-95e9-813913e02cb1",
                        "glosses": [
                            "свойство объекта вызывать своим видом отвращение, неприязнь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "744f503b-349d-4ae0-bdb8-dfb84a995678",
                                "sense_id": "aecb2c9e-8e6b-3893-9615-b40dd6c2357b",
                                "text": "Уродство сочеталось в нём с нечестностью."
                            }
                        ]
                    },
                    {
                        "sense_id": "abc5faa2-4e76-323c-bbd0-60c50a120147",
                        "entry_id": "e3860e9f-7af3-35ef-95e9-813913e02cb1",
                        "glosses": [
                            "перен. нечто отталкивающее, вызывающее отвращение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abfe591b-d08c-4443-b9de-d7b3c2e0e7e2",
                                "sense_id": "abc5faa2-4e76-323c-bbd0-60c50a120147",
                                "text": "Где ты взял это уродство?"
                            }
                        ]
                    },
                    {
                        "sense_id": "0642e521-1120-3e3c-8494-0127491e49db",
                        "entry_id": "e3860e9f-7af3-35ef-95e9-813913e02cb1",
                        "glosses": [
                            "анат. врождённая ненормальность строения живого организма, делающая его внешне отличающимся от всех прочих особей того же вида"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6c05b6f-5243-4ff5-99f6-a4cace6ae15a",
                                "sense_id": "0642e521-1120-3e3c-8494-0127491e49db",
                                "text": "Есть же извращенцы, которым уроды нравятся. А в уродах их привлекает уродство! ― Мы говорим про нормальных людей…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb93b19f-dc5d-4e2d-9e66-65728fe5c3c3",
                        "source_entry_id": "e3860e9f-7af3-35ef-95e9-813913e02cb1",
                        "target_lang_word": "ugliness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ugliness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f870880a-0bb0-3c8b-aefc-046221fb3fa9",
                                        "entry_id": "01a25a73-9c16-3e92-a4a6-ef2e58fef1cf",
                                        "glosses": [
                                            "The condition of being ugly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2738c4d-b956-4397-8fd5-1c0c561c6455",
                                                "sense_id": "f870880a-0bb0-3c8b-aefc-046221fb3fa9",
                                                "text": "His best friend would not have called him good-looking, but he was the fortunate possessor of that cheerful type of ugliness which inspires immediate confidence in its owner."
                                            },
                                            {
                                                "example_id": "a584beef-bf3f-4a43-afb4-2aec0d103c72",
                                                "sense_id": "f870880a-0bb0-3c8b-aefc-046221fb3fa9",
                                                "text": "Everything that's realistic has some sort of ugliness in it. Even a flower is ugly when it wilts, a bird when it seeks its prey, the ocean when it becomes violent. Sharon Tate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48fe9cab-7244-3efb-b810-4e034c0615e0",
                                        "entry_id": "01a25a73-9c16-3e92-a4a6-ef2e58fef1cf",
                                        "glosses": [
                                            "An unsightly or frightful object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "626e06f0-fe4e-3ffa-8a82-d7f9a25267e9",
                                        "entry_id": "01a25a73-9c16-3e92-a4a6-ef2e58fef1cf",
                                        "glosses": [
                                            "Unpleasant behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f26d56-d656-4c84-b4bc-0286925f696f",
                                                "sense_id": "626e06f0-fe4e-3ffa-8a82-d7f9a25267e9",
                                                "text": "There was some ugliness at the council meeting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
