        "fr-extract.jsonl": [
            {
                "entry_id": "3cf94f81-100a-34df-8558-f2fb60b6f173",
                "word": "devancier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "98e6daab-791d-48be-b6de-470df012c6e4",
                        "entry_id": "3cf94f81-100a-34df-8558-f2fb60b6f173",
                        "tags": [
                            "plural"
                        ],
                        "form": "devanciers"
                    },
                    {
                        "form_id": "a99792da-58e4-4965-8c9c-5ad977f56488",
                        "entry_id": "3cf94f81-100a-34df-8558-f2fb60b6f173",
                        "tags": [
                            "feminine"
                        ],
                        "form": "devancière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "80992da3-ff59-3198-81bf-b4230dd9fba6",
                        "entry_id": "3cf94f81-100a-34df-8558-f2fb60b6f173",
                        "glosses": [
                            "Celui qui a précédé une personne dans ce qu’elle fait."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bf35af3f-3bc0-44a6-9d0d-a69018939502",
                                "sense_id": "80992da3-ff59-3198-81bf-b4230dd9fba6",
                                "text": "[…] seulement il a confirmé tout ce que ses devanciers nous avaient raconté sur la population prodigieuse du Japon proprement dit […]"
                            },
                            {
                                "example_id": "c63c1762-906a-4443-b9e3-03638b3fe294",
                                "sense_id": "80992da3-ff59-3198-81bf-b4230dd9fba6",
                                "text": "Hermann s’avança le second, prit les mêmes précautions que son devancier et obtint le même résultat."
                            },
                            {
                                "example_id": "3759a261-4c82-4576-a3ab-b02eebbc60ec",
                                "sense_id": "80992da3-ff59-3198-81bf-b4230dd9fba6",
                                "text": "En combinant avec les observations si précises de M. Edwards celles de ses devanciers et de ses successeurs, nous pouvons en tirer une conclusion générale."
                            },
                            {
                                "example_id": "e8577a2b-f953-4415-b98b-fbf8492eed1e",
                                "sense_id": "80992da3-ff59-3198-81bf-b4230dd9fba6",
                                "text": "Au Québec, il est rarissime qu’un politicien cite un de ses illustres devanciers. «Je me souviens» est une sorte d’antiphrase placée au fronton de l’Assemblée nationale."
                            }
                        ]
                    },
                    {
                        "sense_id": "a45731c9-470b-3528-9a35-11788b3f7659",
                        "entry_id": "3cf94f81-100a-34df-8558-f2fb60b6f173",
                        "glosses": [
                            "Ancêtres ; aïeux."
                        ],
                        "tags": [
                            "figuratively",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "1432af09-6bf4-4b2a-a920-e70d54035dea",
                                "sense_id": "a45731c9-470b-3528-9a35-11788b3f7659",
                                "text": "Vous n’êtes point faits pour vous traîner servilement dans l’ornière des préjugés tyranniques tracée par vos devanciers, ou plutôt vous commencez une nouvelle carrière où personne ne vous a devancés."
                            },
                            {
                                "example_id": "12caf1fa-b513-462e-9ce6-8d590774df97",
                                "sense_id": "a45731c9-470b-3528-9a35-11788b3f7659",
                                "text": "La génération actuelle, en effet, ne se contente pas d’utiliser tels quels les procédés légués par les devanciers ; elle les perfectionne […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "716d9a59-bc81-42ca-a90b-4c5e2f3bae6c",
                        "source_entry_id": "3cf94f81-100a-34df-8558-f2fb60b6f173",
                        "target_lang_word": "precursor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precursor",
