                "senses": [
                    {
                        "sense_id": "f4752ff3-f91d-3426-98c3-ab96cc09fc85",
                        "entry_id": "f09b4076-8f5d-3f0b-a3be-299e7f4d49d5",
                        "glosses": [
                            "Partisan du néo-conservatisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eaf1dc0a-0ed4-4a68-9d0f-d82cb97719c6",
                                "sense_id": "f4752ff3-f91d-3426-98c3-ab96cc09fc85",
                                "text": "D’aucuns jugent que la politique étrangère de George W. Bush a été très fortement influencée par les néo-conservateurs."
                            },
                            {
                                "example_id": "12044579-f430-47de-abc4-5df60c87f858",
                                "sense_id": "f4752ff3-f91d-3426-98c3-ab96cc09fc85",
                                "text": "C'est un objectif proche qui commande les essais d'Yves Roucaute, l'un des rares intellectuels qui assument en France, avec Chantal Millon-Delsol, l'étiquette de « néo-conservateurs »."
                            },
                            {
                                "example_id": "fbfca00e-fc3a-47db-88b9-d99a3e02e543",
                                "sense_id": "f4752ff3-f91d-3426-98c3-ab96cc09fc85",
                                "text": "Plusieurs conseillers de Macron et d’autres néo-conservateurs, qui prolifèrent au sein des équipes présidentielle et gouvernementale, reprochent à leur chef vénéré d’avoir « viré de bord en Syrie », comme l’a relaté « Le Canard » la semaine dernière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7cc1332-157e-49e5-9bab-295d50b7d70f",
                        "source_entry_id": "f09b4076-8f5d-3f0b-a3be-299e7f4d49d5",
                        "source_sense_id": "f4752ff3-f91d-3426-98c3-ab96cc09fc85",
                        "target_lang_word": "neocon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neocon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01b0900e-efc8-31a9-8b78-8e267e8f2291",
                                        "entry_id": "4682e104-5c98-3c20-bbb7-560220ef15ef",
                                        "glosses": [
                                            "Neoconservative."
                                        ],
                                        "tags": [
                                            "US",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7435f207-2574-45fa-9ca9-c6d30b1faf44",
                                                "sense_id": "01b0900e-efc8-31a9-8b78-8e267e8f2291",
                                                "text": "Even Paul Wolfowitz, the former George W. Bush administration official credited as one of the architects behind the Iraq War and an anchor of the neocon movement, said he may vote for Clinton."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neocon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f8d9b3df-df61-3377-ba23-71e445059cac",
                                        "entry_id": "0f590b58-906a-345a-8a33-59f4092f1a69",
                                        "glosses": [
                                            "A neoconservative."
                                        ],
                                        "tags": [
                                            "US",
                                            "derogatory",
                                            "possibly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c504f6d0-f6db-49d2-a909-e267862934d8",
                                                "sense_id": "f8d9b3df-df61-3377-ba23-71e445059cac",
                                                "text": "I realized today that the politics of divisiveness embraced by the neocons has worked, and it has worked on me."
                                            },
                                            {
                                                "example_id": "c15654ed-c112-494f-b409-b87590f9bc42",
                                                "sense_id": "f8d9b3df-df61-3377-ba23-71e445059cac",
                                                "text": "[The film's] message is that Iraq's fabled \"weapons of mass destruction\" did not exist, and that neocons within the administration fabricated them, lied about them, and were ready to kill to cover up their deception."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
