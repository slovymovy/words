                "senses": [
                    {
                        "sense_id": "87ceeed9-a647-3ba6-b331-b264d2e265f2",
                        "entry_id": "159863c0-7949-34e8-89db-cf9c65cdff38",
                        "glosses": [
                            "Zeitabschnitt von circa 1250 bis 1500 nach Christus in Europa und dem Mittelmeerraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87faa609-d572-4169-b90b-34e73d4dc2f9",
                                "sense_id": "87ceeed9-a647-3ba6-b331-b264d2e265f2",
                                "text": "„Es sind solche Gemälde, die während des Spätmittelalters und der frühen Renaissance (also bis etwa 1550) in Deutschland, in den Niederlanden und Italien geschaffen wurden.“"
                            },
                            {
                                "example_id": "65c7654d-ce5d-4c96-9067-91399f31f31c",
                                "sense_id": "87ceeed9-a647-3ba6-b331-b264d2e265f2",
                                "text": "„Im Spätmittelalter bildeten sich die Engländer ein, rechtmäßige Eigentümer von Frankreich zu sein, weil ihre Könige wiederum aus Frankreich stammten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
