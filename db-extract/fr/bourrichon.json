                                                "sense_id": "8570cc5a-2162-3e3e-a6a7-3118b8129417",
                                                "text": "Hou je kop toch eens dicht!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec37de51-6ba0-3efa-96e1-27c6d650352a",
