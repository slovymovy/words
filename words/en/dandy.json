                                "target_lang_word": "excelente",
                                "target_lang_sense_clarification": "de gran calidad"
                            },
                            {
                                "target_lang_word": "estupendo",
                                "target_lang_sense_clarification": "fantástico o genial"
                            },
                            {
                                "target_lang_word": "magnífico",
                                "target_lang_sense_clarification": "admirable o muy bueno"
                            }
                        ]
                    }
