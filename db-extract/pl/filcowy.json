                                                "sense_id": "1561538c-a116-36c1-bfd8-b4743ca3c971",
                                                "text": "Gestern habe ich eine Mütze gefilzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "4cb15724-5d87-396b-9e47-8be0c08d8e53",
                                        "entry_id": "98712c28-ee72-373f-aed8-58eba18ee19f",
                                        "glosses": [
                                            "zu Filz [1] werden, in der Beschaffenheit so wie Filz werden"
