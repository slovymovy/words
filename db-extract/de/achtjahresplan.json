                "senses": [
                    {
                        "sense_id": "e150cb2b-8a1b-3222-9e1a-fdd42e20e26a",
                        "entry_id": "3d550388-18cc-3c30-b4c3-5f0b852f6c89",
                        "glosses": [
                            "Plan für acht Jahre"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4f0c52d-fe25-4d0d-b270-992d3e29d397",
                                "sense_id": "e150cb2b-8a1b-3222-9e1a-fdd42e20e26a",
                                "text": "„Die verschiedenen Arbeitsgebiete der Hitler-Jugend wurden in einem Achtjahresplan aufgegliedert.“"
                            },
                            {
                                "example_id": "fe9748b1-64c3-4f3a-a118-b76a72b7c93c",
                                "sense_id": "e150cb2b-8a1b-3222-9e1a-fdd42e20e26a",
                                "text": "„Indonesien: Briefaustausch über die Bereitschaft der DDR zur Lieferung kompletter Anlagen und Ausrüstungen zur Unterstützung des indonesischen Achtjahresplanes v. 16.2.1961 Dok. II, S. 351; …“"
                            },
                            {
                                "example_id": "f7087305-4e1c-4192-861d-6601b6f10da5",
                                "sense_id": "e150cb2b-8a1b-3222-9e1a-fdd42e20e26a",
                                "text": "„Mithilfe eines Achtjahresplans will der österreichische Triathlonverband (ÖTRV) bei Olympia wieder einmal richtig anschreiben.“"
                            },
                            {
                                "example_id": "4b816fd4-3e16-4659-8a87-3503e5a0efb0",
                                "sense_id": "e150cb2b-8a1b-3222-9e1a-fdd42e20e26a",
                                "text": "„Wie sonst käme er auf die Idee, seinem neuen Klub einen Zweijahresplan zu verordnen. Zweijahrespläne gibt es vielleicht beim DFB, und wenn man Joachim Löw heißt, auch Achtjahrespläne oder, wer weiß, sogar Zehnjahrespläne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
