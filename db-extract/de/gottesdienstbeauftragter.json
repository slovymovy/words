                "senses": [
                    {
                        "sense_id": "21b17875-523c-3455-b0c3-f5fcf584cb1b",
                        "entry_id": "325c7d4c-5f6c-35a4-8943-c897511bc27d",
                        "glosses": [
                            "Leiter von Gottesdiensten mit Ausnahme von Eucharistiefeiern (Messen)"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "5dca2c7b-206f-448a-8b33-b8db563e3ef9",
                                "sense_id": "21b17875-523c-3455-b0c3-f5fcf584cb1b",
                                "text": "„Wenn jedoch im Ausnahmefall aus besonderen Gründen mit Zustimmung des Ortsbischofs die Wort-Gottes-Feier mit einer Kommunionfeier verbunden ist, kommen dem Gottesdienstbeauftragten folgende Aufgaben zu: – die Gemeinde zur Kommunion einzuladen, – ihr die Kommunion, gegebenenfalls zusammen mit Kommunionhelfern/Kommunionhelferinnen zu reichen, – die gemeinsame Danksagung zu halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
