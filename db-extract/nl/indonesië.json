                        "translation_id": "ae0d5d9c-d900-453c-a75c-5fca74cda6ac",
                        "source_entry_id": "1722dd67-f6c2-34cb-a4f6-0e4c6f57ec13",
                        "source_sense_id": "ff72e586-276d-38e6-b18e-b49fa0ff6448",
                        "source_sense_description": "een land dat bestaat uit een groot eilandengebied tussen Zuidoost-Azië en Australië",
