                "senses": [
                    {
                        "sense_id": "78dd6a0d-b348-367b-9f4b-c2bd5c41ae7b",
                        "entry_id": "f782f987-01ed-3959-aa69-e0ae4fedde6f",
                        "glosses": [
                            "Agent de police dans les pays anglophones."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "2e83a6a1-284d-4846-9a6b-cc271cd08061",
                                "sense_id": "78dd6a0d-b348-367b-9f4b-c2bd5c41ae7b",
                                "text": "Les policemen et les gendarmes indigènes abandonnèrent le parti des voleurs pour celui des honnêtes gens."
                            },
                            {
                                "example_id": "4abd70cf-fc33-44cb-bd73-daa6d2c4040f",
                                "sense_id": "78dd6a0d-b348-367b-9f4b-c2bd5c41ae7b",
                                "text": "Il n’y a pas longtemps qu’un policeman de la Cité, étant de service dans une des rues qui se prolongent dans les districts métropolitains, fut informé par un passant qu’on assommait un de ses collègues à l’autre bout de la rue ; il répondit tranquillement que c’était en dehors de sa circonscription, et qu’il ne pouvait intervenir !"
                            },
                            {
                                "example_id": "57a30d43-6489-44cf-a6f8-c3248f2909af",
                                "sense_id": "78dd6a0d-b348-367b-9f4b-c2bd5c41ae7b",
                                "text": "A ce moment vient à nous un homme vêtu d’une longue redingote bleue et coiffé d’un chapeau garni de cuir verni ; autour de son poignet, est passé un galon noir et blanc ; un étui est suspendu à sa ceinture ; c’est un homme de police, un policeman."
                            }
                        ]
                    }
                ],
