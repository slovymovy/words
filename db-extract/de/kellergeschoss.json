                                "example_id": "cbe43d88-e439-452a-ad44-ea24e830072f",
                                "sense_id": "6aeca52e-7caa-350a-94a6-b3204132673c",
                                "text": "„Im Kellergeschoss befanden sich die Wirtschafts- und Nebenräume des Palais.“"
                            },
                            {
                                "example_id": "0b4df316-8023-4d02-a69f-a02a66c07fbf",
                                "sense_id": "6aeca52e-7caa-350a-94a6-b3204132673c",
                                "text": "„Bobby und Rosa erkundeten das Kellergeschoss.“"
                            }
                        ],
