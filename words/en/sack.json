                            },
                            {
                                "target_lang_word": "пакет",
                                "target_lang_sense_clarification": "бумажный или пластиковый, для покупок"
                            },
                            {
                                "target_lang_word": "куль",
                                "target_lang_sense_clarification": "устаревшее; мешок из рогожи"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "麻袋",
