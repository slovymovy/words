                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d160eaa-1aa7-3860-9720-9b1eb0d17ac1",
                        "entry_id": "a057a9af-d4df-3546-bc85-218373755717",
                        "glosses": [
                            "een plezierreisje met de boot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c60110bf-4796-4def-8828-1222b81108dd",
                                "sense_id": "8d160eaa-1aa7-3860-9720-9b1eb0d17ac1",
                                "text": "Wij hebben in Giethoorn een boottochtje gemaakt met een fluisterboot."
                            },
                            {
                                "example_id": "238e104b-124d-41f6-bb22-78de47f0402d",
                                "sense_id": "8d160eaa-1aa7-3860-9720-9b1eb0d17ac1",
                                "text": "De creatieve Fries bedacht een oplossing: hij bouwde een muur die naar binnen kon draaien. Het idee bedacht hij tijdens een boottochtje, vertelt De Vries donderdag aan Omrop Fryslân. „Op een gegeven moment voeren wij met de boot langs de sluizen van Stavoren. Ik zag die dikke sluisdeuren daar draaien en dacht: verdikkie, als die deuren kunnen draaien, dan kan de muur van het huis ook draaien!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "86d3fba2-4dd6-3724-8709-053d0e729f80",
                        "entry_id": "a057a9af-d4df-3546-bc85-218373755717",
                        "glosses": [
                            "een reis met de boot"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79ac8a69-de2f-4b2c-b637-0c5701644777",
                                "sense_id": "86d3fba2-4dd6-3724-8709-053d0e729f80",
                                "text": "Toen mijn grootouders naar Indië gingen duurde de boottocht daarnatoe vele weken."
                            },
                            {
                                "example_id": "cd6ee350-e46f-498e-a936-435928c418df",
                                "sense_id": "86d3fba2-4dd6-3724-8709-053d0e729f80",
                                "text": "Tijdens de boottocht is alles overboord gespoeld, zelfs mijn tanden, maar we hebben het gered! We hadden een goed leven en een mooi huis in Syrië, maar we maken er hier het beste van, zodat de wanhoop ons er niet onder krijgt.\""
                            }
                        ]
                    }
                ],
