                                                "sense_id": "36731dcf-b65a-3d95-8c3f-f3dd705e6a9c",
                                                "text": "Ich habe augenblicklich keine Zeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a9100fc2-8db9-362c-b2d7-5c08fd5facd3",
                                        "entry_id": "3f0908e8-04e4-3a8b-aa10-803bc58655e3",
                                        "glosses": [
