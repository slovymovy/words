        "fr-extract.jsonl": [
            {
                "entry_id": "306d1b7e-4b37-32d6-8635-3476cd563a1b",
                "word": "fumerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f316a856-fc80-4731-a3b6-bcfac14dcd9c",
                        "entry_id": "306d1b7e-4b37-32d6-8635-3476cd563a1b",
                        "tags": [
                            "plural"
                        ],
                        "form": "fumeries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "da772b59-ec1f-370f-8363-cc625ede40e9",
                        "entry_id": "306d1b7e-4b37-32d6-8635-3476cd563a1b",
                        "glosses": [
                            "Établissement aménagé pour y fumer de l’opium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a78b385-b064-46eb-a5cf-fae5690523c4",
                                "sense_id": "da772b59-ec1f-370f-8363-cc625ede40e9",
                                "text": "Je sais quand même que chaque nuit\nTout seul au fond de ma fumerie\nPour un public de vieux Chinois\nJe rechanterai ma chanson à moi\nCelle du temps où je m'appelais Jacky."
                            },
                            {
                                "example_id": "efeecd70-ee10-4848-956b-c49ea1cbce57",
                                "sense_id": "da772b59-ec1f-370f-8363-cc625ede40e9",
                                "text": "Il m’expliqua que, pendant l’Occupation, c’était la seule fumerie d’opium de Paris."
                            },
                            {
                                "example_id": "4ef6bbfd-5622-47e2-942c-f2c9dbe44904",
                                "sense_id": "da772b59-ec1f-370f-8363-cc625ede40e9",
                                "text": "En Chine, le dross était récupéré pour être mélangé avec du tabac, ou du thé, et être revendu aux couches pauvres de la population qui ne pouvaient s'offrir le luxe proposé dans les fumeries."
                            },
                            {
                                "example_id": "6cd0147c-2418-439e-b097-c6e3e5f15746",
                                "sense_id": "da772b59-ec1f-370f-8363-cc625ede40e9",
                                "text": "Il explore les marchés, s'arrête dans les temples, passe par les bordels et les fumeries d'opium."
                            },
                            {
                                "example_id": "c434e854-ca65-4f13-927f-cf3b5aeb9a4d",
                                "sense_id": "da772b59-ec1f-370f-8363-cc625ede40e9",
                                "text": "L'odeur lui rappelle la fumerie de crack qui s'est montée l'année précédente dans une des tours de la cité, un souk d'enfer, plein de mecs à moitié morts –et même qu'une fois il y en a eu un qui a clamsé pour de bon, […]."
                            },
                            {
                                "example_id": "75693fd9-cbaa-456d-ac61-eb8d673c843a",
                                "sense_id": "da772b59-ec1f-370f-8363-cc625ede40e9",
                                "text": "La première fois qu’il était entré dans cette fumerie d’opium, il avait 15 ans et c’était avec Francis."
                            }
                        ]
                    }
                ],
