                "translations": [
                    {
                        "translation_id": "f136ddd3-cb90-4445-92be-9524c02ffe73",
                        "source_entry_id": "865a9fce-8cdc-3712-8501-ad84b4c89cfe",
                        "source_sense_id": "4477ed4b-e3ef-3008-b494-2bf063b50b79",
                        "target_lang_word": "alliteration",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alliteration",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a7e2185-512b-39a0-b854-b49c1399b052",
                                        "entry_id": "81009185-519c-3425-b34b-591a4644eb4a",
                                        "glosses": [
                                            "The repetition of consonant sounds or letters at the beginning of two or more words immediately succeeding each other, or at short intervals; such repetition specifically involving stressed syllables."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "098f6d2b-a22c-4778-86d9-b66a1116c893",
                                                "sense_id": "8a7e2185-512b-39a0-b854-b49c1399b052",
                                                "text": "So fish fury all round, as there has been in the past. And as an aside, that alliteration was, sadly, not mine that of a former political correspondent of the Daily Record, John Deans, and applied to the 'cod wars' with Iceland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf79b5db-3713-3b0a-8f37-f6a7b7b0fc7a",
                                        "entry_id": "81009185-519c-3425-b34b-591a4644eb4a",
                                        "glosses": [
                                            "The recurrence of the same letters or sounds in accented parts of words, as in Anglo-Saxon alliterative meter."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "babdf95c-bff2-4910-b20a-2af1ab9655c8",
                        "source_entry_id": "865a9fce-8cdc-3712-8501-ad84b4c89cfe",
                        "source_sense_id": "4477ed4b-e3ef-3008-b494-2bf063b50b79",
                        "target_lang_word": "allitération",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allitération",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "409d2a37-c625-36c8-a238-3bbfb65074e4",
                                        "entry_id": "f98a9c7d-472c-3822-b2d2-0b612a6ff2b2",
                                        "glosses": [
                                            "Figure de style qui consiste en la répétition d'un son consonantique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92cdb70c-6117-4fed-bb03-1af0250a004f",
                                                "sense_id": "409d2a37-c625-36c8-a238-3bbfb65074e4",
                                                "text": "L’allitération, qui est originellement un phénomène poétique, se retrouve parfois en prose littéraire."
                                            },
                                            {
                                                "example_id": "8f8d5ae1-be8a-4998-8fa3-55a6a7c936ca",
                                                "sense_id": "409d2a37-c625-36c8-a238-3bbfb65074e4",
                                                "text": "Voici un exemple d'allitération : Pour qui sont ces serpents qui sifflent sur vos têtes ?"
                                            },
                                            {
                                                "example_id": "05ce1a68-e284-4b9b-8c31-6ae1688049dd",
                                                "sense_id": "409d2a37-c625-36c8-a238-3bbfb65074e4",
                                                "text": "Voici un autre exemple d'allitération : Devinant ce qu'il se passait, Kyle et moi avons levé la tête vers le ciel étoilé, pour découvrir avec enthousiasme la lumière flamboyante des feux d'artifice. Enfin !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9e3d3fa-b809-4b3e-8ece-c8428c74d19d",
                        "source_entry_id": "865a9fce-8cdc-3712-8501-ad84b4c89cfe",
                        "source_sense_id": "4477ed4b-e3ef-3008-b494-2bf063b50b79",
