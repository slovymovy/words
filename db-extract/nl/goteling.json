                        "examples": [
                            {
                                "example_id": "1dfa7fd8-18cc-46d7-95ec-ea42ca8ac489",
                                "sense_id": "4681a50f-c947-35b5-87a3-4ca4c045269b",
                                "text": "⧖ Grondstof en verwerkingsmiddelen voor het maken van het slangenbeeld mogen dus geacht worden gereed voorhanden geweest te zijn. Dit alles wel ingezien, zal het geen vermetelheid zijn te oordeelen dat het vervaardigen der koperen slang, - ongetwijfeld een goteling in brons, - alleszins minder moeite en tijd zal gekost hebben dan menige poging tot hergieten ervan door hedendaagsche bijbelvorschers."
                            }
                        ]
                    },
                    {
                        "sense_id": "e31a3dac-3aca-33a0-b7cd-c345784a3897",
                        "entry_id": "da080ae4-6105-3752-a78d-bf08325b77ad",
                        "glosses": [
                            "licht kanon\\nOorspronkelijk bedoeld als onderscheid met de oudere kanonnen die werden gesmeed, werd het naderhand toen alle kanonnen werden gegoten een aanduiding voor het lichte geschut dat vooral op schepen werd gebruikt."
                        ],
