                "senses": [
                    {
                        "sense_id": "c9f79279-44f9-3e69-b2cf-92748c6006d7",
                        "entry_id": "361a0e4f-1172-3736-8c40-4026583c5f74",
                        "glosses": [
                            "Gebiet, das von einer fremden Macht im Auftrag einer übergeordneten Institution verwaltet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e7e3da2-d06b-4ef0-ade4-1b3e8ffea385",
                                "sense_id": "c9f79279-44f9-3e69-b2cf-92748c6006d7",
                                "text": "„Sie lebten einst im früheren spanischen Mandatsgebiet Westsahara und forderten nach dem Rückzug der Spanier die Unabhängigkeit, doch dann besetzte Marokko große Teile des Landes, und den Einheimischen blieb nur die Flucht.“"
                            },
                            {
                                "example_id": "61e6fe7b-8d35-400e-af09-7fb904301906",
                                "sense_id": "c9f79279-44f9-3e69-b2cf-92748c6006d7",
                                "text": "„Deshalb oder aus diesem Grund fördert Frankreich die illegale Einwanderung ins englische Mandatsgebiet Palästina.“"
                            },
                            {
                                "example_id": "1edcc547-6eae-49e3-92bd-37c36780a4ea",
                                "sense_id": "c9f79279-44f9-3e69-b2cf-92748c6006d7",
                                "text": "„Hebräisch wurde neben Englisch und Arabisch als eine der drei offiziellen Sprachen des Mandatsgebiets anerkannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
