                "senses": [
                    {
                        "sense_id": "a5bff6bb-d4c6-3b78-a1f5-d934bafc468a",
                        "entry_id": "b2886fc2-e3ea-32f4-a85c-d25c9634f29c",
                        "glosses": [
                            "angeborene oder erworbene Störung der Wahrnehmung von Farben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aca506b4-c50f-4217-9578-61e2baee38f0",
                                "sense_id": "a5bff6bb-d4c6-3b78-a1f5-d934bafc468a",
                                "text": "„Die Farbsinnstörungen von Deuteranopen werden auch unter dem Begriff Grünblindheit zusammengefasst.“"
                            },
                            {
                                "example_id": "773caf3d-3c8a-4007-a203-eb2782bab1bd",
                                "sense_id": "a5bff6bb-d4c6-3b78-a1f5-d934bafc468a",
                                "text": "„Die Ärzte würden von cerebraler Achromatopsie sprechen, einer Farbsinnstörung, die manchmal bei älteren Menschen nach einem Hirnschlag auftrete.“"
                            },
                            {
                                "example_id": "32e37bde-fb70-4068-ba13-bb95b140920b",
                                "sense_id": "a5bff6bb-d4c6-3b78-a1f5-d934bafc468a",
                                "text": "„Farbsinnstörungen (Farbenschwachsichtigkeit und Farbenblindheit) sind unter Männern stärker verbreitet, kommen aber auch bei Frauen vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
