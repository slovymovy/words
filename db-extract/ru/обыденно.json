                    }
                ],
                "translations": [
                    {
                        "translation_id": "7441f4ce-9337-487d-bf1c-7a63971bc457",
                        "source_entry_id": "da325b4e-604d-3453-9158-5e0dc5f3cf2c",
                        "source_sense_id": "ed467660-e6b4-3659-b5ba-7692a34183bb",
                        "target_lang_word": "ordinaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordinaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a60e7f8-f9e6-32bb-b170-30210fc632c5",
                                        "entry_id": "41107cb1-3e32-3d7a-ad6f-998a52398595",
                                        "glosses": [
                                            "Commun ; habituel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10c2163c-1d24-4968-9576-94a05595782b",
                                                "sense_id": "0a60e7f8-f9e6-32bb-b170-30210fc632c5",
                                                "text": "Alors, si le vent du nord vient à souffler, ces graux sont promptement agrandis, il s'en forme même de nouveaux, et les étangs se déchargent en peu de jours d'une grande partie de leurs eaux ; ils se vident presque entièrement si le mistral (nord-ouest) souffle assez long-temps avec son impétuosité ordinaire."
                                            },
                                            {
                                                "example_id": "dbf5afd1-b777-490e-87e6-c1abe5ead654",
                                                "sense_id": "0a60e7f8-f9e6-32bb-b170-30210fc632c5",
                                                "text": "À la suractivité ordinaire des rues de New York s’ajouta une fièvre belliqueuse."
                                            },
                                            {
                                                "example_id": "58633101-cc86-4500-85aa-a6269cf51319",
                                                "sense_id": "0a60e7f8-f9e6-32bb-b170-30210fc632c5",
                                                "text": "La petite carte hypsométrique se base sur une centaine d’altitudes, dont nous avons relevé la majeure partie à l’aide d’un anéroïde et d’un thermomètre ordinaires."
                                            },
                                            {
                                                "example_id": "150582c1-7704-4a31-b893-e593d37ba66a",
                                                "sense_id": "0a60e7f8-f9e6-32bb-b170-30210fc632c5",
                                                "text": "En été, il arrive souvent que des rivières guéables en temps ordinaire grossissent subitement à la suite de la fonte des neiges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dfc8f6e-13e6-30a6-be5b-e3c4fe92cdbf",
                                        "entry_id": "41107cb1-3e32-3d7a-ad6f-998a52398595",
                                        "glosses": [
                                            "Qui est habituel à quelqu’un."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e854c3e-131f-44fc-92b1-c58241d7e372",
                                                "sense_id": "2dfc8f6e-13e6-30a6-be5b-e3c4fe92cdbf",
                                                "text": "On n’eût point dit d’ailleurs, en le voyant, qu’il se passât quelque chose d’insolite par la ville, ni au Louvre ; il était vêtu avec son élégance ordinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4132568-0a2e-395b-817f-598a36e61086",
                                        "entry_id": "41107cb1-3e32-3d7a-ad6f-998a52398595",
                                        "glosses": [
                                            "Qui ne dépasse pas le niveau commun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19dcb50-10a6-4e75-b8e3-aec69408f15c",
                                                "sense_id": "d4132568-0a2e-395b-817f-598a36e61086",
                                                "text": "C’est un homme très ordinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ae3b4c6-d023-31ce-8b5e-22fc48f8417c",
                                        "entry_id": "41107cb1-3e32-3d7a-ad6f-998a52398595",
                                        "glosses": [
                                            "Médiocre, dont les manières laissent à désirer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "daa35093-da35-481a-a513-b2d3a18ca74e",
                                                "sense_id": "0ae3b4c6-d023-31ce-8b5e-22fc48f8417c",
                                                "text": "Le lait frais vaut généralement 1 franc le kil de 2 litres, tandis que le vin, de qualité très ordinaire, se vend de 1 fr. 25 à 1 fr. 50 le litre."
                                            },
                                            {
                                                "example_id": "8aa8bcd1-b816-491a-8340-4ddf37c32fd1",
                                                "sense_id": "0ae3b4c6-d023-31ce-8b5e-22fc48f8417c",
                                                "text": "Vous m’avez présenté quelqu’un de bien ordinaire."
                                            },
                                            {
                                                "example_id": "9c25c2f9-9f8d-42e9-92bb-3b0a27d2949d",
                                                "sense_id": "0ae3b4c6-d023-31ce-8b5e-22fc48f8417c",
                                                "text": "Ce roman est d’un style bien ordinaire."
                                            },
                                            {
                                                "example_id": "3aafbded-bff5-4b86-b6f1-0671dc6e8f2f",
                                                "sense_id": "0ae3b4c6-d023-31ce-8b5e-22fc48f8417c",
                                                "text": "Le talent de ce musicien est des plus ordinaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a715d550-15ef-3649-91ec-f17ec9534d76",
                                        "entry_id": "41107cb1-3e32-3d7a-ad6f-998a52398595",
                                        "glosses": [
                                            "Il s’est dit des officiers de la maison du roi, qui remplissaient leurs fonctions toute l’année, par opposition à ceux qui servaient par quartier. Il s’est dit aussi de quelques autres serviteurs habituels de la maison du roi, quoiqu’ils ne servissent que par quartier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "951bcd39-2623-4feb-beaa-99b6290bf08b",
                                                "sense_id": "a715d550-15ef-3649-91ec-f17ec9534d76",
                                                "text": "Maître d’hôtel ordinaire."
                                            },
                                            {
                                                "example_id": "fb6df89b-fd53-4b79-9c6b-a20e3ee92484",
                                                "sense_id": "a715d550-15ef-3649-91ec-f17ec9534d76",
                                                "text": "Médecin ordinaire."
                                            },
                                            {
                                                "example_id": "84014928-0f26-4739-ae64-b901920417f5",
                                                "sense_id": "a715d550-15ef-3649-91ec-f17ec9534d76",
                                                "text": "Gentilhomme ordinaire du roi."
                                            },
                                            {
                                                "example_id": "6783c8b4-6d23-408e-b7e3-75cb611bdfa0",
                                                "sense_id": "a715d550-15ef-3649-91ec-f17ec9534d76",
                                                "text": "Musicien ordinaire de la chambre du roi, de la chapelle du roi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf65a3d9-b8a0-37ba-9454-eecd852e7a19",
                                        "entry_id": "41107cb1-3e32-3d7a-ad6f-998a52398595",
                                        "glosses": [
                                            "Malpoli, discourtois, peu aimable."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02cc0253-bfd8-48ea-92b1-a7b83e0439bf",
                                                "sense_id": "cf65a3d9-b8a0-37ba-9454-eecd852e7a19",
                                                "text": "Je trouve ça ordinaire qu'on t'a parlé de cette façon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ordinaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d49a32dc-5046-3a0d-b1bb-8777da99cdac",
                                        "entry_id": "036e76fb-3edf-3986-8ac1-55e93bee9223",
                                        "glosses": [
                                            "Ce qu’on a coutume de faire, ce qu’on a coutume d’être."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5489bf5c-3f86-4d1e-9724-cdf16803ad5c",
                                                "sense_id": "d49a32dc-5046-3a0d-b1bb-8777da99cdac",
                                                "text": "Ne vous en étonnez pas, c’est son ordinaire."
                                            },
                                            {
                                                "example_id": "5f460445-8b91-412f-ab8f-a9317ee73ed2",
                                                "sense_id": "d49a32dc-5046-3a0d-b1bb-8777da99cdac",
                                                "text": "Il fait telle chose à son ordinaire."
                                            },
                                            {
                                                "example_id": "d8dc45f5-5322-4d37-939d-870c82e29a10",
                                                "sense_id": "d49a32dc-5046-3a0d-b1bb-8777da99cdac",
                                                "text": "C’est un homme au-dessus de l’ordinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1503d6df-afe7-329c-bbf5-21756780d97d",
                                        "entry_id": "036e76fb-3edf-3986-8ac1-55e93bee9223",
                                        "glosses": [
                                            "Ce qu’on a coutume de servir pour un repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8be69a2b-35ea-45e0-9e60-5a39d13d0678",
                                                "sense_id": "1503d6df-afe7-329c-bbf5-21756780d97d",
                                                "text": "Elle avait d’elle-même ajouté à l’ordinaire de M. l’évêque une bouteille de vieux vin de Mauves."
                                            },
                                            {
                                                "example_id": "ebdedce7-9599-4fb5-9a96-7bd442a0c522",
                                                "sense_id": "1503d6df-afe7-329c-bbf5-21756780d97d",
                                                "text": "Il n’a que deux plats à son ordinaire."
                                            },
                                            {
                                                "example_id": "4d70fe0c-40bd-4585-b4f1-ed31e5a1b052",
                                                "sense_id": "1503d6df-afe7-329c-bbf5-21756780d97d",
                                                "text": "Se contenter de l’ordinaire."
                                            },
                                            {
                                                "example_id": "f71ee9b1-5266-4497-9ab8-155694548850",
                                                "sense_id": "1503d6df-afe7-329c-bbf5-21756780d97d",
                                                "text": "Le capitaine a fait améliorer l’ordinaire de sa compagnie."
                                            },
                                            {
                                                "example_id": "a4578b82-c7e7-4270-be1d-60c3d98fba2c",
                                                "sense_id": "1503d6df-afe7-329c-bbf5-21756780d97d",
                                                "text": "J’étais dans la révolution jusqu’au cou, et j’aimais Paris maintenant. Cette imprimerie !… Puis nous avions été manger des ordinaires dans des crèmeries, où il venait des ouvriers qui avaient appartenu aux Saisons et qui avaient été mêlés à des émeutes.\nLa blouse et la redingote s’asseyaient à la même table et l’on trinquait."
                                            },
                                            {
                                                "example_id": "e8b23705-ca8f-40bc-aaae-ff3c6da25a75",
                                                "sense_id": "1503d6df-afe7-329c-bbf5-21756780d97d",
                                                "text": "La popotte du soir n’est pas mauvaise et assez copieuse. Et à midi, la soupe est également bonne. Je dois me contenter de ces ordinaires, mais je ne m’en plains pas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4419d656-ce84-3e49-b318-492af67e1db2",
                                        "entry_id": "036e76fb-3edf-3986-8ac1-55e93bee9223",
                                        "glosses": [
                                            "Cantine militaire où les militaires du rang prennent leurs repas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e460f59-263e-40c6-8aa5-6d2cef394be0",
                                                "sense_id": "4419d656-ce84-3e49-b318-492af67e1db2",
                                                "text": "On ne parlait d’ailleurs par de « réfectoire », mais d’« ordinaire ». C’est que ce cosmos possédait sa propre langue, ses mots de toujours, ses expressions consacrées ; un volapük sur mesure régissait les règles de la discipline, de la physique, différentes de celles en vigueur à l’extérieur […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56d482d5-7d95-35fd-a472-152af68e8676",
                                        "entry_id": "036e76fb-3edf-3986-8ac1-55e93bee9223",
                                        "glosses": [
                                            "Les militaires non gradés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c003caee-c99d-464a-a683-45533a329401",
                                                "sense_id": "56d482d5-7d95-35fd-a472-152af68e8676",
                                                "text": "Si les officiers avaient droit à des cabines individuelles, l’ordinaire devait s’entasser jusqu’à cinquante dans une carrée. Les couchettes, surnommées les « cailles », étaient superposées sur trois niveaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49bf04bd-424e-3955-8545-bc4bc48fa61f",
                                        "entry_id": "036e76fb-3edf-3986-8ac1-55e93bee9223",
                                        "glosses": [
                                            "Évêque diocésain, autorité diocésaine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15a6a0ce-c0d6-426d-804d-0ae73bf24750",
                                                "sense_id": "49bf04bd-424e-3955-8545-bc4bc48fa61f",
                                                "text": "Il s’est pourvu par-devant l’ordinaire."
                                            },
                                            {
                                                "example_id": "e5e70f74-afcb-4f12-8528-a3effef71326",
                                                "sense_id": "49bf04bd-424e-3955-8545-bc4bc48fa61f",
                                                "text": "Il a pris son visa de l’ordinaire."
                                            },
                                            {
                                                "example_id": "621259c1-159a-4975-bc67-0a2358049dc6",
                                                "sense_id": "49bf04bd-424e-3955-8545-bc4bc48fa61f",
                                                "text": "Un chapitre, un monastère soumis à l’ordinaire, exempt de l’ordinaire."
                                            },
                                            {
                                                "example_id": "65ce04b8-9778-40a2-85a1-7d4cb4590053",
                                                "sense_id": "49bf04bd-424e-3955-8545-bc4bc48fa61f",
                                                "text": "Quand on rencontre un prêtre dans de pareilles Thébaïdes, s’il est jeune, on peut être sûr que c’est un hérétique intelligent disgracié par l’ordinaire ; s’il est vieux, que c’est un athée de mœurs scandaleuses qui subit une expiation. Il y a, dans les deux cas, une seconde hypothèse : c’est que son incapacité le rend impropre à intriguer dans le monde au profit de la cause du clergé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c024ed7b-2023-36cf-88f3-64fa798e2d5f",
                                        "entry_id": "036e76fb-3edf-3986-8ac1-55e93bee9223",
                                        "glosses": [
                                            "Prières qui se disent tous les jours à la messe, la partie de la messe qui ne varie pas."
                                        ],
                                        "tags": [
                                            "Liturgie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfc690a9-8c45-4176-a7bc-6f9f66fb9eee",
                                                "sense_id": "c024ed7b-2023-36cf-88f3-64fa798e2d5f",
                                                "text": "L’ordinaire de la messe,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ea2a7e7-956b-3e15-967f-b6fe5e475e5a",
                                        "entry_id": "036e76fb-3edf-3986-8ac1-55e93bee9223",
                                        "glosses": [
                                            "Courrier qui partait et arrivait à jours fixes."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0acb009-1dcd-40b2-af7a-0813cc8777d2",
                                                "sense_id": "0ea2a7e7-956b-3e15-967f-b6fe5e475e5a",
                                                "text": "Je vous écrirai par le premier ordinaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f643466e-2b9d-3ba5-ae4b-b93e32f88605",
                                        "entry_id": "036e76fb-3edf-3986-8ac1-55e93bee9223",
                                        "glosses": [
                                            "Fonds établi pour payer la Maison du roi, les commissaires des guerres et les compagnies de gendarmerie."
                                        ],
                                        "tags": [
                                            "Administration"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5d365e0-f2a6-4f7f-8133-e137819b16af",
                                                "sense_id": "f643466e-2b9d-3ba5-ae4b-b93e32f88605",
                                                "text": "Cela est assigné sur l’ordinaire des guerres."
                                            },
                                            {
                                                "example_id": "7109fd8c-ef43-4dae-9ed5-1a8a4fa993b2",
                                                "sense_id": "f643466e-2b9d-3ba5-ae4b-b93e32f88605",
                                                "text": "Trésorier, caisse de l’ordinaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ordinaire",
