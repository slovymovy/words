                ],
                "senses": [
                    {
                        "sense_id": "1d7e8b86-0cc1-39c4-be80-77ef536e15c6",
                        "entry_id": "80e7e447-18f1-3e31-a445-e22f6f91b7ac",
                        "glosses": [
                            "(in der Regel) speziell für diese Arbeit ausgebildeter Mitarbeiter eines Archivs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a382ee8-169f-4120-ad81-d86c7adf6f69",
                                "sense_id": "1d7e8b86-0cc1-39c4-be80-77ef536e15c6",
                                "text": "„Das ist für den Anfang, sagte der Archivar und legte mir drei dicke Bände auf den Tisch.“"
                            },
                            {
                                "example_id": "a53e13c4-44c5-402e-a8ba-93edfd36534a",
                                "sense_id": "1d7e8b86-0cc1-39c4-be80-77ef536e15c6",
                                "text": "„Katell hatte seinen Gefährten den neuen Archivar vorgestellt, die – es waren auch Ausländer darunter – ihn mit Zurückhaltung in ihrem Kreise aufnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "538e2f7d-5d4f-41f3-ba5c-a58cac953947",
                        "source_entry_id": "80e7e447-18f1-3e31-a445-e22f6f91b7ac",
                        "source_sense_id": "1d7e8b86-0cc1-39c4-be80-77ef536e15c6",
                        "source_sense_description": "(in der Regel) speziell für diese Arbeit ausgebildeter Mitarbeiter eines Archivs",
                        "target_lang_word": "archivist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archivist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9152d915-2d21-364b-885c-ec05f8974572",
                                        "entry_id": "b3447230-faae-3d08-9dcf-ca1239600898",
                                        "glosses": [
                                            "One who is in charge of, or performs the task of creating, collecting, cataloguing and organising archives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e753a63-e639-44a9-9c68-2e85f82c8a88",
                                                "sense_id": "9152d915-2d21-364b-885c-ec05f8974572",
                                                "text": "The billionaire’s will established a trust to create a staff of archivists that would chronicle and preserve his rise to prominence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fdc4793-a69d-4d6d-9453-b12f2fff6ade",
                        "source_entry_id": "80e7e447-18f1-3e31-a445-e22f6f91b7ac",
                        "source_sense_id": "1d7e8b86-0cc1-39c4-be80-77ef536e15c6",
                        "source_sense_description": "(in der Regel) speziell für diese Arbeit ausgebildeter Mitarbeiter eines Archivs",
                        "target_lang_word": "archiviste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archiviste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                        "entry_id": "270337a4-5acc-3fcd-892a-0472c3d12929",
                                        "glosses": [
                                            "Personne qui est préposée à la garde des archives."
                                        ],
                                        "tags": [
                                            "Bibliothéconomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab5d2f7a-4669-4663-86eb-f03d1ba555bf",
                                                "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                                "text": "Archiviste paléographe."
                                            },
                                            {
                                                "example_id": "d5fbcd9a-c81a-4ada-bf79-aed0d5f7bd6c",
                                                "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                                "text": "Il vient d’obtenir une place d’archiviste."
                                            },
                                            {
                                                "example_id": "543cbe9c-ebc1-474d-bf53-3fbc45889f74",
                                                "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                                "text": "Angèle. — Le gueux !… il a eu le cynisme de les consigner dans ce carnet, afin que la postérité n’en ignorât sans doute !… Il ne se contentait pas d’accomplir. Il fallait qu’il enregistrât !… Coureur !… Et archiviste !… Ah ! ça m’a édifiée sur sa conduite…"
                                            },
                                            {
                                                "example_id": "3eb37b55-0a09-4311-86cf-1ad516523eb7",
                                                "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                                "text": "C’était M. Mazure, l’archiviste départemental. Depuis que le ministre lui avait refusé les palmes académiques pour insuffisance de titres et que toutes les sociétés de la ville négligeaient de rendre des visites à madame Mazure, pour la secrète raison qu’elle avait été la cuisinière et la concubine des deux archivistes antérieurement préposés à la garde des archives départementales, M. Mazure avait pris en horreur le gouvernement, le monde en dégoût, et il était tombé dans une misanthropie noire."
                                            },
                                            {
                                                "example_id": "46e9fb7c-b809-411c-99f6-4c54e1c9a673",
                                                "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                                "text": "Swann demanda à faire la connaissance de tout le monde, même d’un vieil ami des Verdurin, Saniette, à qui sa timidité, sa simplicité et son bon cœur avaient fait perdre partout la considération que lui avaient value sa science d’archiviste, sa grosse fortune, et la famille distinguée dont il sortait."
                                            },
                                            {
                                                "example_id": "c33ae5d4-d120-4c70-a572-cb425532f296",
                                                "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                                "text": "En quittant la rue des Francs-Bourgeois, mon vieil archiviste me dit à voix basse qu’il considérait l’hôtel de Soubise comme la plus admirable maison du monde."
                                            },
                                            {
                                                "example_id": "42406357-e757-4125-96c4-63f3d6498279",
                                                "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                                "text": "Ayant décidé que son charme et son argent feraient tout, même dans une ville comme Paris où les administrations sont lentes et indifférentes, elle résolut d’attaquer le Marais par le haut, c’est-à-dire par le gouvernement, et se mit à inviter des ministres, des archivistes, des ambassadeurs à sa table, dans un palace où le plus officiel des hommes se rend toujours avec plaisir."
                                            },
                                            {
                                                "example_id": "d04cac0a-e871-431d-ae7b-caa3f3d045f5",
                                                "sense_id": "bc01f1d3-b4f1-332f-aa26-780e1a601846",
                                                "text": "Dans un vieux code où se résument les usages du lieu, pour comble de malheur, l’archiviste de la Préfecture découvre qu’il n’est pas permis, à moins de trois cents mètres de l’église, d’ouvrir un bordel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
