                "senses": [
                    {
                        "sense_id": "71336ae1-c403-3593-a0da-0822db24f86b",
                        "entry_id": "dd512052-2407-3057-b008-323bfebf09fd",
                        "glosses": [
                            "Relatif à l’Érythrée, son peuple et sa culture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b71daeb0-009d-4a23-8440-6f39a37d0047",
                                "sense_id": "71336ae1-c403-3593-a0da-0822db24f86b",
                                "text": "Pendant des mois, les autorités d'Asmara et d'Addis Abeba ont démenti la présence de forces érythréennes au Tigré, qui était pourtant largement rapportée par des habitants, des humanitaires, des diplomates et même certains responsables civils et militaires éthiopiens."
                            },
                            {
                                "example_id": "dd72cfb0-93e1-4e74-b59c-f59d32608c65",
                                "sense_id": "71336ae1-c403-3593-a0da-0822db24f86b",
                                "text": "En terminant troisième à Bordeaux, Biniam Girmay devient le premier coureur érythréen à finir dans le Top 3 d’une étape du Tour de France."
                            }
                        ]
                    }
                ],
