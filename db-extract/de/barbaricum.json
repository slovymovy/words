                        "sense_id": "265008c0-c999-3e51-bb19-107971d2d559",
                        "entry_id": "816cb550-1dad-3eb6-ad91-40f7cf0aabbb",
                        "glosses": [
                            "die an das römische Reich angrenzenden, weitgehend unbekannten germanischen Gebiete"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e57eb19-eed4-466f-af01-3f3c9fc15757",
                                "sense_id": "265008c0-c999-3e51-bb19-107971d2d559",
                                "text": "„Das Barbaricum jenseits des Limes bot kultivierten Römern wenig, und so war auch über die Barbaren östlich der Elbe und nördlich der Donau kaum etwas bekannt.“"
                            },
                            {
                                "example_id": "e93974f6-10c6-4d4a-a920-61e248324637",
                                "sense_id": "265008c0-c999-3e51-bb19-107971d2d559",
                                "text": "„Die im Barbaricum in Erscheinung tretenden Gräber mit steinernen oder hölzernen Grabkammern aus der Römischen Kaiserzeit waren vor allem – neben dem aufwändigen Grabbau – durch ihre oft außergewöhnlich reichen Grabausstattungen Schwerpunkt zahlreicher wissenschaftlicher Forschungen hinsichtlich gesellschaftlichem Status.“"
                            }
                        ],
