    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b3d8f37e-58de-3351-b93e-90c56244be24",
                    "sense_definition": "Uncertain, doubtful, or not guaranteed to succeed.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weather looks rather <w>iffy</w>, so we might need to cancel the outdoor picnic.",
                            "target_lang_translations": {
                                "ru": "Погода выглядит довольно <w>ненадёжной</w>, так что, возможно, нам придётся отменить пикник на открытом воздухе."
                            }
                        },
                        {
                            "text": "Our travel plans are still a bit <w>iffy</w> until we confirm the hotel booking.",
                            "target_lang_translations": {
                                "ru": "Наши планы на поездку пока <w>под вопросом</w>, пока мы не подтвердим бронирование отеля."
                            }
                        }
                    ],
                    "synonyms": [
                        "dicey",
                        "dubious",
                        "questionable"
                    ],
                    "antonyms": [
                        "reliable",
                        "solid"
                    ],
                    "common_phrases": [
                        "a bit iffy",
                        "still iffy",
                        "look iffy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неопределённый, сомнительный или не гарантирующий успеха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неопределённый",
                                "target_lang_sense_clarification": "не гарантированный, неточный"
                            },
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "вызывающий сомнения в успехе"
                            },
                            {
                                "target_lang_word": "под вопросом",
                                "target_lang_sense_clarification": "не окончательный, не решённый"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0e3595d-bc37-3bc6-8953-27e10ac61964",
                    "sense_definition": "Of dubious authenticity, honesty, or legality; suspicious.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered to sell a brand-new laptop for fifty dollars, which sounded <w>iffy</w> to everyone.",
                            "target_lang_translations": {
                                "ru": "Он предложил продать новенький ноутбук всего за пятьдесят долларов, что всем показалось <w>подозрительным</w>."
                            }
                        },
                        {
                            "text": "The contract contained a few <w>iffy</w> clauses that worried our lawyer.",
                            "target_lang_translations": {
                                "ru": "В договоре было несколько <w>сомнительных</w> пунктов, которые насторожили нашего юриста."
                            }
                        }
                    ],
                    "synonyms": [
                        "dodgy",
                        "fishy",
                        "shady",
                        "sketchy"
                    ],
                    "common_phrases": [
                        "sound iffy",
                        "seem iffy"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вызывающий сомнения в подлинности, честности или законности; подозрительный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий недоверие"
                            },
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "ненадёжный, не заслуживающий доверия"
                            },
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "нечестный, подозрительный (разг.)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}