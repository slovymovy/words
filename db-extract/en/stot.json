                "senses": [
                    {
                        "sense_id": "4fa1f894-3253-3c54-a42c-ca667e79b71c",
                        "entry_id": "0a52a287-aa3d-3154-b18c-f5dbaea8a904",
                        "glosses": [
                            "To bounce, rebound or ricochet."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c7d1bfb2-ecf4-4092-b159-f3da3f2c9f2e",
                                "sense_id": "4fa1f894-3253-3c54-a42c-ca667e79b71c",
                                "text": "‘I've plenty of money in my bank – and I have my cheque book here – could one of you cash a cheque for five pounds? – I promise it won't stot.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "d2df4719-6d86-3d4c-82af-9085af4ad65a",
                        "entry_id": "0a52a287-aa3d-3154-b18c-f5dbaea8a904",
                        "glosses": [
                            "To make bounce, rebound or ricochet."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "3a862631-2c41-31d6-b8a1-ce58bd34106f",
                        "entry_id": "0a52a287-aa3d-3154-b18c-f5dbaea8a904",
                        "glosses": [
                            "To stumble."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "transitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "4762f47f-9c9d-35c7-aee8-abb2585ff3b0",
                        "entry_id": "0a52a287-aa3d-3154-b18c-f5dbaea8a904",
                        "glosses": [
                            "To leap using all four legs at once."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "3c52e5ef-9cb2-4c26-96a5-0480592eefa7",
                                "sense_id": "4762f47f-9c9d-35c7-aee8-abb2585ff3b0",
                                "text": "This vigorous and conspicuous leaping in front of a predator is analogous to bird alarm calls, in that it seems to warn companions of danger while apparently calling the predator’s attention to the stotter himself. We have a responsibility to explain stotting Tommies and all similar phenomena, and this is something I am going to face in later chapters."
                            }
                        ]
                    },
                    {
                        "sense_id": "289f74f6-e538-3ad6-a26f-3f9dad6062d0",
                        "entry_id": "0a52a287-aa3d-3154-b18c-f5dbaea8a904",
                        "glosses": [
                            "To strike, push, shove."
