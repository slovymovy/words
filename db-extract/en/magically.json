                    },
                    {
                        "translation_id": "e88831e2-79b5-4840-aa73-47301eccd9c5",
                        "source_entry_id": "df892dd7-e8e4-30f5-849c-9cc95120e2ed",
                        "source_sense_id": "9f9de428-2a6f-349f-a8b1-a17f9a0bfd9f",
                        "source_sense_description": "in a magical manner",
                        "target_lang_word": "magisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "magisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "393d7906-3759-32eb-8f7c-ac2efb7fe2bd",
                                        "entry_id": "62ef7dfa-287e-3e45-91ae-e2371ce86119",
                                        "glosses": [
                                            "Magie beinhaltend oder verwendend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e27e43a-68d6-4170-a1b9-7496369c22a0",
                                                "sense_id": "393d7906-3759-32eb-8f7c-ac2efb7fe2bd",
                                                "text": "Und der magische Kobold gab der Prinzessin ein magisches Amulett."
                                            },
                                            {
                                                "example_id": "43c517f2-40a8-4fed-9732-3c15fe823fa5",
                                                "sense_id": "393d7906-3759-32eb-8f7c-ac2efb7fe2bd",
                                                "text": "„Magische Praktiken waren im Volk weit verbreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ad5b101-3c8e-3647-a63b-b1e95f5041fc",
                                        "entry_id": "62ef7dfa-287e-3e45-91ae-e2371ce86119",
                                        "glosses": [
                                            "auf unerklärliche Weise, scheinbar durch Magie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ed51a7a-f70b-47de-b9b1-f9e5bec8eb27",
                                                "sense_id": "7ad5b101-3c8e-3647-a63b-b1e95f5041fc",
                                                "text": "Sie zog ihn magisch an."
                                            },
                                            {
                                                "example_id": "08f6b2ca-cc27-412c-a211-18c0606f6f56",
                                                "sense_id": "7ad5b101-3c8e-3647-a63b-b1e95f5041fc",
                                                "text": "„Bei mehreren Flügen in den Höhenwinden (Lee-Wellen) über den argentinischen Anden gelang es einer Gruppe von Segelfliegern, mit der Stemme S10VT mehrfach die magische 1 000-Kilometer-Marke zu überwinden.“"
                                            },
                                            {
                                                "example_id": "35d83e34-e77a-4f42-850e-32aa36081cdb",
                                                "sense_id": "7ad5b101-3c8e-3647-a63b-b1e95f5041fc",
                                                "text": "„Der sensible Gipfelsammler erlebt bisweilen das, was der Religiöse befürchtet, eine Profanisierung, eine Entweihung des heiligen Berges, den Verlust der Unberührtheit und damit der magischen Ausstrahlung.\""
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
