                "senses": [
                    {
                        "sense_id": "98926c43-4e21-3768-bcac-3c415dd4ea2f",
                        "entry_id": "5344803e-cdf1-399f-ab47-2a4fb557a3f9",
                        "glosses": [
                            "женск. к победитель — та, кто побеждает, одерживает верх или добивается успеха в борьбе"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "540c3517-d516-4e51-95b5-344ef6fd70a6",
                                "sense_id": "98926c43-4e21-3768-bcac-3c415dd4ea2f",
                                "text": "И победительница была известна заранее, потому что — корона проплачена."
                            },
                            {
                                "example_id": "c8af223f-c89b-4fa6-ac77-11e0dbccb23e",
                                "sense_id": "98926c43-4e21-3768-bcac-3c415dd4ea2f",
                                "text": "Девочка, победительница международной олимпиады по биологии, торопится заявить со сцены: из России я никуда не уеду, если здесь буду востребована."
                            }
                        ]
                    }
