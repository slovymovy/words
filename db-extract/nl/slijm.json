                            {
                                "example_id": "8327b4d4-0dc1-4c9c-ae25-ce9411bc91ef",
                                "sense_id": "a9d22284-cc30-38a9-b155-5f50bd7ec58a",
                                "text": "Slijm is van groot belang bij het innemen van voedsel."
                            }
                        ]
                    },
                    {
                        "sense_id": "61f61e1e-5dc0-35e6-b572-b309f9ab7716",
                        "entry_id": "765976d3-bdba-3cee-8a6b-878c8ef3bc7b",
                        "glosses": [
