                "senses": [
                    {
                        "sense_id": "42062846-152e-31f8-98a6-23e2ff902205",
                        "entry_id": "ae7e3f88-5cd3-3839-978e-8458b448d4da",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca70c80-d3d1-483e-a117-f7ee291fc228",
                                "sense_id": "42062846-152e-31f8-98a6-23e2ff902205",
                                "text": "Valentiens kamen, sahen und siegten."
                            },
                            {
                                "example_id": "d05216a3-b4fe-4188-a8a8-ddc1ca3e03c0",
                                "sense_id": "42062846-152e-31f8-98a6-23e2ff902205",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Valentien kommt, geht der Herr Valentien.“"
                            },
                            {
                                "example_id": "2be58821-20d2-4e37-924f-c844278bcc7e",
                                "sense_id": "42062846-152e-31f8-98a6-23e2ff902205",
                                "text": "Frau Valentien ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c5c77ad6-c3f9-4a03-b00c-c385ab1055ac",
                                "sense_id": "42062846-152e-31f8-98a6-23e2ff902205",
                                "text": "Herr Valentien wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "169c4f7c-1b75-4dda-8ff8-2ea542fb403c",
                                "sense_id": "42062846-152e-31f8-98a6-23e2ff902205",
                                "text": "Die Valentiens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "cd4b10e9-62e7-47e7-9e4f-e58959c7003d",
                                "sense_id": "42062846-152e-31f8-98a6-23e2ff902205",
                                "text": "Der Valentien trägt nie die Schals, die die Valentien ihm strickt."
                            },
                            {
                                "example_id": "e1ebe66f-4978-4858-8ea5-bb559fd86e56",
                                "sense_id": "42062846-152e-31f8-98a6-23e2ff902205",
                                "text": "Valentien kommt und geht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
