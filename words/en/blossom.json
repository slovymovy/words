    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "96464430-77e7-3abf-b790-a4452ebde86a",
                    "sense_definition": "A female given name.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The teacher <w>Blossom</w> introduced the game to the students.",
                            "target_lang_translations": {
                                "zh": "<w>布洛瑟姆</w>老师向学生们介绍了这个游戏。"
                            }
                        },
                        {
                            "text": "My friend <w>Blossom</w> loves gardening in her spare time.",
                            "target_lang_translations": {
                                "zh": "我的朋友<w>布洛瑟姆</w>闲暇时喜欢园艺。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "女性人名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布洛瑟姆",
                                "target_lang_sense_clarification": "音译人名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc36422a-27c5-3677-b9e6-aac41a014c12",
                    "sense_definition": "A hamlet in New York.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to visit the small hamlet of <w>Blossom</w> during their trip.",
                            "target_lang_translations": {
                                "zh": "他们决定在旅行期间去参观<w>布洛瑟姆</w>这个小村庄。"
                            }
                        },
                        {
                            "text": "The quiet village of <w>Blossom</w> is located in rural New York.",
                            "target_lang_translations": {
                                "zh": "安静的<w>布洛瑟姆</w>村坐落在纽约州的乡村地区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于纽约州的一个小村庄。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布洛瑟姆",
                                "target_lang_sense_clarification": "音译地名"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6464a87d-3d03-30ed-b7d1-107c3d2b12a3",
                    "sense_definition": "A city in Texas.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The city of <w>Blossom</w> is situated in the state of Texas.",
                            "target_lang_translations": {
                                "zh": "<w>布洛瑟姆</w>市位于德克萨斯州。"
                            }
                        },
                        {
                            "text": "Many travelers pass through <w>Blossom</w> on their way across the state.",
                            "target_lang_translations": {
                                "zh": "许多旅客在穿越该州时会经过<w>布洛瑟姆</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "位于德克萨斯州的一个城市。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "布洛瑟姆",
                                "target_lang_sense_clarification": "音译地名"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ebe7370-7770-3d55-bf79-a01d7ec4fe6f",
                    "sense_definition": "A flower, especially one indicating that a fruit tree is fruiting.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apple tree is covered in white <w>blossom</w>.",
                            "target_lang_translations": {
                                "zh": "苹果树上开满了白色的<w>花</w>。"
                            }
                        },
                        {
                            "text": "The spring <w>blossom</w> looks beautiful in the garden.",
                            "target_lang_translations": {
                                "zh": "花园里春天的<w>花朵</w>看起来很美。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flower"
                    ],
                    "common_phrases": [
                        "apple blossom"
                    ],
                    "target_lang_definitions": {
                        "zh": "花，尤指果树开的花。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "花",
                                "target_lang_sense_clarification": "指植物的花朵"
                            },
                            {
                                "target_lang_word": "花朵",
                                "target_lang_sense_clarification": "指植物的花朵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc5cae63-0e0d-320e-a9cb-d57b564f2c0e",
                    "sense_definition": "The state or season of producing such flowers.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orchard is currently in <w>blossom</w>.",
                            "target_lang_translations": {
                                "zh": "果园现在正处于<w>花期</w>。"
                            }
                        },
                        {
                            "text": "We visited the park while the trees were in <w>blossom</w>.",
                            "target_lang_translations": {
                                "zh": "我们在树木<w>开花</w>的时候参观了公园。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in blossom"
                    ],
                    "target_lang_definitions": {
                        "zh": "开花的季节或状态。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "花期",
                                "target_lang_sense_clarification": "指植物开花的时期"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1329058-e658-3e36-afa2-865c378b53c0",
                    "sense_definition": "A blooming period or stage of development; something lovely that gives rich promise.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was in the <w>blossom</w> of her youth when she started her career.",
                            "target_lang_translations": {
                                "zh": "她开始职业生涯时正处于青春的<w>全盛时期</w>。"
                            }
                        },
                        {
                            "text": "The project is in the early <w>blossom</w> of its development.",
                            "target_lang_translations": {
                                "zh": "该项目正处于发展的初期阶段。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "发展的鼎盛时期或初期阶段；充满希望的阶段。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "全盛时期",
                                "target_lang_sense_clarification": "指人生或事物发展的鼎盛阶段"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "91ebb699-799b-3363-93ef-3d7c985bc08f",
                    "sense_definition": "The colour of a horse that has white hairs intermixed with sorrel and bay hairs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The horse has a unique <w>blossom</w> coat color.",
                            "target_lang_translations": {
                                "zh": "这匹马有着独特的<w>花斑色</w>皮毛。"
                            }
                        },
                        {
                            "text": "The stable master identified the horse as having a <w>blossom</w> pattern.",
                            "target_lang_translations": {
                                "zh": "马厩管理员确认这匹马具有<w>花斑</w>图案。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种马的毛色，指在栗色或枣色毛发中夹杂白色毛发。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "花斑色",
                                "target_lang_sense_clarification": "指马匹毛色中夹杂其他颜色"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "258523da-72d5-3239-9ba2-761ed2b06563",
                    "sense_definition": "To have, or open into, blossoms; to bloom.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cherry trees <w>blossom</w> every spring.",
                            "target_lang_translations": {
                                "zh": "樱桃树每年春天都会<w>开花</w>。"
                            }
                        },
                        {
                            "text": "Watch the flowers <w>blossom</w> in the warm sun.",
                            "target_lang_translations": {
                                "zh": "看着花儿在温暖的阳光下<w>绽放</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bloom",
                        "flower"
                    ],
                    "common_phrases": [
                        "trees blossom"
                    ],
                    "target_lang_definitions": {
                        "zh": "开花。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "开花",
                                "target_lang_sense_clarification": "指植物长出花朵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a99245c-f7ef-3ddd-8179-58a18c7bbe13",
                    "sense_definition": "To begin to thrive or flourish.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Their friendship began to <w>blossom</w> over the summer.",
                            "target_lang_translations": {
                                "zh": "他们的友谊在夏天开始<w>兴旺</w>起来。"
                            }
                        },
                        {
                            "text": "The company started to <w>blossom</w> after the new manager arrived.",
                            "target_lang_translations": {
                                "zh": "新经理到任后，公司开始<w>繁荣</w>起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flourish",
                        "thrive",
                        "prosper"
                    ],
                    "common_phrases": [
                        "blossom into"
                    ],
                    "target_lang_definitions": {
                        "zh": "开始兴旺或繁荣。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "兴旺",
                                "target_lang_sense_clarification": "指事物或关系蓬勃发展"
                            },
                            {
                                "target_lang_word": "繁荣",
                                "target_lang_sense_clarification": "指事物或关系蓬勃发展"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}