                        "examples": [
                            {
                                "example_id": "eecec813-387b-4c76-ab90-d5a54736dc8d",
                                "sense_id": "e069b3cb-15f9-39c9-992d-ef9c788f0505",
                                "text": "Door de suprematie van die ene renner gaat het bergaf met de suspense."
                            },
                            {
                                "example_id": "f5c62a38-9467-4a99-8c69-4f4ace0f172a",
                                "sense_id": "e069b3cb-15f9-39c9-992d-ef9c788f0505",
                                "text": "Sinds Moord in Eldorado heeft Simon heel wat bij- en afgeleerd. Desondanks vullen nog steeds veelal bordpapieren figuren en stereotypen zijn boeken en is de suspense vrij mager, zelfs al zet hij zoals in Dood op vleugels vier (!) verhaallijnen uit."
                            },
                            {
                                "example_id": "8681420d-7e29-4e38-982d-1386705ab18b",
                                "sense_id": "e069b3cb-15f9-39c9-992d-ef9c788f0505",
                                "text": "Want al heeft zijn Lifeboat anti-Duitse, dus propagandistische aspecten, de geschiedenis van de schipbreukelingen die met een opgepikte Duitse U-bootkapitein op de oceaan zwalken en, door hun krijgsgevangene misleid, bijna in handen van de vijand vallen, is een typisch Hitchcockiaanse oefening in suspense."
                            }
                        ]
                    }
