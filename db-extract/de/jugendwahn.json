                        "entry_id": "abe595e2-beb9-3a74-9941-456f2519b5ca",
                        "glosses": [
                            "wahnhafte Überbewertung des Jungseins"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "95e28fae-951c-4beb-80ee-6e1ddab8ec9c",
                                "sense_id": "af43828b-a341-363f-aab7-f6ff5b1d5e87",
                                "text": "„Mit ihr begann der Abschied vom Jugendwahn in den Betrieben, der sich in Zeiten der Frühverrentung ausgebreitet hatte“"
                            }
                        ],
                        "sense_index_json": "\"1\""
