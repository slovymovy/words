                    },
                    {
                        "translation_id": "5248f672-9bd7-48ae-bf35-c16069aa78c7",
                        "source_entry_id": "62839deb-4da6-3ed4-8696-5e29a4c43925",
                        "source_sense_id": "c8101bac-24eb-328d-8cf7-54d9f975050b",
                        "source_sense_description": "narrow alley or street in a traditional residential district of a Chinese city",
                        "target_lang_word": "hutong",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hutong",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0121d36-3af6-3db9-8a3d-afc9ccf50654",
                                        "entry_id": "2672e236-838b-3725-88ec-8af7d77b3a7d",
                                        "glosses": [
                                            "Série de petite venelles en Chine, en particulier dans le vieux Pékin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7d85f62-487b-490d-9087-5113a4b62813",
                                                "sense_id": "c0121d36-3af6-3db9-8a3d-afc9ccf50654",
                                                "text": "Les hutong sont le cœur de la capitale chinoise."
                                            },
                                            {
                                                "example_id": "c927c898-15bb-406e-a58e-2d5938b8f13e",
                                                "sense_id": "c0121d36-3af6-3db9-8a3d-afc9ccf50654",
                                                "text": "Il faut se promener dans les hutongs autour des lacs Houhai et Qianhai."
                                            },
                                            {
                                                "example_id": "43104f08-2739-4ce2-9aa2-0cd1f53bc553",
                                                "sense_id": "c0121d36-3af6-3db9-8a3d-afc9ccf50654",
                                                "text": "À l’aube, un jour, vers cinq heures du matin, je marche avec ma traductrice, une jeune femme sans grâce, dans un hutong, une de ces rues de Pékin grossièrement pavées où s’alignent de chaque côté des maisons basses, sans étage, avec une cour intérieure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
