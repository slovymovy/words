                ],
                "senses": [
                    {
                        "sense_id": "c4e09735-8d97-34c3-9024-1bbe6d8eb3fe",
                        "entry_id": "8d2b40a2-d17c-37de-9988-732bb2a1b67f",
                        "glosses": [
                            "Ware, die illegal über die Grenze ein- oder ausgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d601be5-f4ae-41eb-8070-4d1bf085719e",
                                "sense_id": "c4e09735-8d97-34c3-9024-1bbe6d8eb3fe",
                                "text": "„Ich bewachte die Schmuggelware, und der Onkel ging vorsichtig an den Fluss heran, um auszuspionieren, ob oder wo sich die Grenzsoldaten befänden.“"
                            },
                            {
                                "example_id": "d8913c72-1e58-4729-9077-6bc9bf191b43",
                                "sense_id": "c4e09735-8d97-34c3-9024-1bbe6d8eb3fe",
                                "text": "„Das nächste Mal, wenn wir jemanden dabei ertappen, Schmuggelware zu versenden oder zu empfangen, informieren wir die entsprechenden Behörden.“"
                            },
                            {
                                "example_id": "25459854-90e7-47fd-b75c-516163ebd1bf",
                                "sense_id": "c4e09735-8d97-34c3-9024-1bbe6d8eb3fe",
                                "text": "„Die Gesellschaft war hier in eine zwielichtige Sache hineingeschlittert, denn der versichernde Verkäufer des Sprits hatte auf Anfrage erklärt, es handle sich nicht um Schmuggelware.“"
                            },
                            {
                                "example_id": "73762584-22fe-4820-aac8-f1da7ba151e5",
                                "sense_id": "c4e09735-8d97-34c3-9024-1bbe6d8eb3fe",
                                "text": "„Das Patrouillenschiff kassierte monatlich Zölle in Höhe von 36000 Ljang Silber ein und gestattete die Einfuhr der Schmuggelware in den Hafen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
