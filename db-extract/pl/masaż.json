                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "massage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c228603-203a-3e80-8ddd-37096d393baf",
                                        "entry_id": "a28dad2c-3a4d-3ba5-b548-2b6afb694b88",
                                        "glosses": [
                                            "The action of rubbing, kneading or hitting someone's body, to help the person relax, prepare for muscular action (as in contact sports) or to relieve aches."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4745c5c5-03e2-4e9c-9123-052dfc92b833",
                                                "sense_id": "9c228603-203a-3e80-8ddd-37096d393baf",
                                                "text": "Having a massage can have many beneficial effects."
                                            },
                                            {
                                                "example_id": "610f3c77-495b-4411-a898-094f164b72e2",
                                                "sense_id": "9c228603-203a-3e80-8ddd-37096d393baf",
                                                "text": "During the long lapses in work common with on-location productions, Marilyn would silently meditate as Roberts provided a shoulder massage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11bbb011-bc45-399d-a124-c3d8b549d11b",
                                        "entry_id": "a28dad2c-3a4d-3ba5-b548-2b6afb694b88",
                                        "glosses": [
                                            "The action of rubbing or kneading anything."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c20a4ff-e8b6-43d2-b62c-8017ebd128b4",
                                                "sense_id": "11bbb011-bc45-399d-a124-c3d8b549d11b",
                                                "text": "The baker gave the dough one final massage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "massage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37d7d03e-c420-3ec7-90d9-8dc7dc2ff620",
                                        "entry_id": "af55091b-811f-3f01-b301-236f2d224721",
                                        "glosses": [
                                            "To rub and knead (someone's body or a part of a body), to perform a massage on (somebody)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3709a5b2-d58c-4235-8c08-7e8685025562",
                                                "sense_id": "37d7d03e-c420-3ec7-90d9-8dc7dc2ff620",
                                                "text": "My neck doesn't hurt as much as it did last night since my wife massaged me after I got back from the concert."
                                            },
                                            {
                                                "example_id": "778193fe-be6d-4c69-977a-c767a765b6cc",
                                                "sense_id": "37d7d03e-c420-3ec7-90d9-8dc7dc2ff620",
                                                "text": "So after massaging a nude woman while being nude or nearly nude myself, sex is a natural way to end things."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d08a4d77-2aba-3c13-baf6-facd0692b343",
                                        "entry_id": "af55091b-811f-3f01-b301-236f2d224721",
                                        "glosses": [
                                            "To rub or knead anything."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e8aa18f-a0ef-408f-88bf-3f2287963646",
                                                "sense_id": "d08a4d77-2aba-3c13-baf6-facd0692b343",
                                                "text": "Massage the kale to soften it before making the salad."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "447e118b-cc51-3afa-a9d1-600e47762123",
                                        "entry_id": "af55091b-811f-3f01-b301-236f2d224721",
                                        "glosses": [
                                            "To manipulate (data, a document etc.) to make it more presentable or more convenient to work with."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a1cb804-9181-4e79-83de-23a581421a63",
                                                "sense_id": "447e118b-cc51-3afa-a9d1-600e47762123",
                                                "text": "News relating to public disturbances was systematically massaged [...]."
                                            },
                                            {
                                                "example_id": "5b7bfdaa-da65-4753-a1e7-9e3caada2607",
                                                "sense_id": "447e118b-cc51-3afa-a9d1-600e47762123",
                                                "text": "The Conservatives have massaged expectations down by saying they would be delighted with a majority of 1,000 […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32f29d5a-07a8-3dc7-bb8f-93b887f19703",
                                        "entry_id": "af55091b-811f-3f01-b301-236f2d224721",
                                        "glosses": [
                                            "To falsify (data or accounts)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04b9ba49-2be1-4041-b1c8-0f8e4eee383d",
