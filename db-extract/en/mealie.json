                        "glosses": [
                            "An ear or kernel of maize; in plural as mass noun: maize, corn."
                        ],
                        "tags": [
                            "South-Africa"
                        ],
                        "examples": [
                            {
                                "example_id": "fa3ffa77-0800-4311-a342-3e2e6bba52f8",
                                "sense_id": "b0e03d19-fa17-34a0-bcc8-35c2aa9eb5fb",
                                "text": "The wants of a native living with his tribe and cultivating mealies or Kafir corn are confined to a kaross (skin cloak) or some pieces of cotton cloth."
                            },
                            {
                                "example_id": "495377a2-ffce-4f95-87f6-b2e163fe3cbb",
                                "sense_id": "b0e03d19-fa17-34a0-bcc8-35c2aa9eb5fb",
                                "text": "At the other end of the veranda, on two deck-chairs planted side by side and looking away over the bush and the mealie fields, were Mr. Quest and Mr. Van Rensberg […]"
                            },
                            {
                                "example_id": "77af7371-cb33-4684-9749-37d7971bf597",
                                "sense_id": "b0e03d19-fa17-34a0-bcc8-35c2aa9eb5fb",
                                "text": "My mother planted and harvested her own mealies."
                            }
                        ]
                    }
