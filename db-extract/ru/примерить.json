                        "translation_id": "6e78bd43-2501-4c6e-9022-6e569911b399",
                        "source_entry_id": "67fc5490-f608-370e-b96a-173fd7f5ca1c",
                        "source_sense_id": "c2d45b24-d92f-3534-a759-30ca940db196",
                        "target_lang_word": "essayer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "essayer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "46a77481-e2bd-3d32-afb4-2e3538c9b525",
                                        "entry_id": "0e9103f1-800e-3b29-860b-2dce7c9a378c",
                                        "glosses": [
                                            "Mettre à l’essai ; vérifier le bon fonctionnement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce6a42be-f2a9-4ecf-83c0-4ab6eb7e5a38",
                                                "sense_id": "46a77481-e2bd-3d32-afb4-2e3538c9b525",
                                                "text": "J’ai dix arquebuses dans cette chambre, reprit Charles IX, avec lesquelles je touche un écu d’or à cent cinquante pas. Voulez-vous en essayer une ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32d6283e-0b32-3370-b4b1-c1c84416cef7",
                                        "entry_id": "0e9103f1-800e-3b29-860b-2dce7c9a378c",
                                        "glosses": [
                                            "Porter un vêtement ou un accessoire pour vérifier s’il convient, s’il est à la bonne taille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c749fdd7-f72b-4a5e-b084-00055f5ff03c",
                                                "sense_id": "32d6283e-0b32-3370-b4b1-c1c84416cef7",
                                                "text": "Essayer un chapeau, des chaussures, etc., un habit à quelqu’un."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca5527e-d142-3b7d-93cd-26af8871f4b6",
                                        "entry_id": "0e9103f1-800e-3b29-860b-2dce7c9a378c",
                                        "glosses": [
                                            "Vérifier la composition et le titre de certains produits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2784bb98-39f1-4da7-80f3-5d2b558b10b1",
                                                "sense_id": "1ca5527e-d142-3b7d-93cd-26af8871f4b6",
                                                "text": "Essayer de l’or, de l’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eede0c4-3ea4-31e6-aea2-184519b3474a",
                                        "entry_id": "0e9103f1-800e-3b29-860b-2dce7c9a378c",
                                        "glosses": [
                                            "Tenter ; oser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3254a8f5-6e1f-44f4-9925-daa0a7cf90b1",
                                                "sense_id": "3eede0c4-3ea4-31e6-aea2-184519b3474a",
                                                "text": "Il n'a pas nié, d'ailleurs, et au lieu d’essayer de se justifier, il s'est mis en colère. Il l’a pris de très haut avec moi."
                                            },
                                            {
                                                "example_id": "33eac389-8527-42f3-8c83-16d4de4aa064",
                                                "sense_id": "3eede0c4-3ea4-31e6-aea2-184519b3474a",
                                                "text": "Il essaya de se persuader qu’il était à l’aise et en sécurité ; mais bientôt, l’indéfinissable inquiétude de l’animal sociable, abandonné dans la solitude, le tourmenta."
                                            },
                                            {
                                                "example_id": "6517808d-5e3a-4fe7-945b-f35f53b9f4eb",
                                                "sense_id": "3eede0c4-3ea4-31e6-aea2-184519b3474a",
                                                "text": "Il vente très fort, des goélands passent, emportés par la tempête, et essaient vainement de remonter le vent."
                                            },
                                            {
                                                "example_id": "52b178cb-aea0-4a17-b4c6-08e4db0f2399",
                                                "sense_id": "3eede0c4-3ea4-31e6-aea2-184519b3474a",
                                                "text": "Or, nous devons tout essayer pour maintenir peuplés ces plateaux de sol ingrat et non chercher à éloigner la population, l’obligeant […] à périr de la poitrine dans des bourgades industrielles."
                                            },
                                            {
                                                "example_id": "a2e97118-12e3-4f68-94ad-d72e490ca0cd",
                                                "sense_id": "3eede0c4-3ea4-31e6-aea2-184519b3474a",
                                                "text": "— Tes parents m'ont appris que tu ne passais pas les fêtes chez eux, ils m’ont invité, j’ai dit non, ils essaieraient encore de me faire exorciser. A la place, c’est la fête du slip à Mykonos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
