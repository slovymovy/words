{
    "word_family": [
        "onder",
        "boven",
        "onderstebovenhangen",
        "onderstebovenhouden"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "85085717-4080-380a-9b57-5032bbda92fa",
                    "sense_definition": "met de bovenkant naar beneden gericht",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "positie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat schilderij hangt, denk ik, <w>ondersteboven</w> aan de muur.",
                            "target_lang_translations": {
                                "en": "I think that painting is hanging <w>upside down</w> on the wall."
                            }
                        },
                        {
                            "text": "Je moet de fles <w>ondersteboven</w> houden om de laatste restjes saus eruit te krijgen.",
                            "target_lang_translations": {
                                "en": "You have to hold the bottle <w>upside down</w> to get the last bits of sauce out."
                            }
                        }
                    ],
                    "antonyms": [
                        "rechtop"
                    ],
                    "common_phrases": [
                        "ondersteboven hangen",
                        "ondersteboven houden"
                    ],
                    "target_lang_definitions": {
                        "en": "with the top part facing downwards"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "upside down",
                                "target_lang_sense_clarification": "with the top part at the bottom"
                            },
                            {
                                "target_lang_word": "inverted",
                                "target_lang_sense_clarification": "turned over or upside down"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a3bdd78-5c57-3f01-a41a-10dd18d87a79",
                    "sense_definition": "niet meer rechtopstaand door een val of botsing",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen de bus plotseling ging rijden, gingen de staande mensen <w>ondersteboven</w>.",
                            "target_lang_translations": {
                                "en": "When the bus suddenly started moving, the people standing were <w>knocked over</w>."
                            }
                        },
                        {
                            "text": "De fietser werd geraakt door een auto en lag even later <w>ondersteboven</w> in de berm.",
                            "target_lang_translations": {
                                "en": "The cyclist was hit by a car and a moment later lay <w>tumbled</w> in the roadside verge."
                            }
                        }
                    ],
                    "synonyms": [
                        "omver"
                    ],
                    "common_phrases": [
                        "ondersteboven gaan",
                        "ondersteboven liggen"
                    ],
                    "target_lang_definitions": {
                        "en": "no longer standing upright due to a fall or collision"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "knocked over",
                                "target_lang_sense_clarification": "pushed or hit so as to fall down"
                            },
                            {
                                "target_lang_word": "tumbled",
                                "target_lang_sense_clarification": "fallen over suddenly"
                            },
                            {
                                "target_lang_word": "upside down",
                                "target_lang_sense_clarification": "knocked into a position where the top is at the bottom"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}