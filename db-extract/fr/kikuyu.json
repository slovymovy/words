                    {
                        "sense_id": "3886e307-1957-3047-ac7f-b8479fb22efc",
                        "entry_id": "b4878e2e-8316-3690-8c4f-034c20aa7a2a",
                        "glosses": [
                            "Qui est relatif aux Kikuyus, à leur culture, à leur territoire, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a47b9e3a-a80b-46dd-8e4e-c23d8ea74e74",
                                "sense_id": "3886e307-1957-3047-ac7f-b8479fb22efc",
                                "text": "Pour avoir moqué l’Etat, Ngugi wa Thiong’o fut incarcéré en 1977, séjour en prison qui donna naissance au premier roman écrit en langue kikuyu."
                            }
                        ]
                    }
                ],
