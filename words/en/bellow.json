{
    "word_family": [
        "bellows"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a4ed5c71-0522-324b-85b0-039c9aa726da",
                    "sense_definition": "To make a loud, deep, hollow noise like the roar of an angry bull.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vocal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry bull began to <w>bellow</w> loudly as it charged across the field.",
                            "target_lang_translations": {
                                "ru": "Разъярённый бык начал громко <w>реветь</w>, когда понёсся через поле."
                            }
                        },
                        {
                            "text": "We could hear the distant <w>bellow</w> of the wild beast echoing through the dark forest.",
                            "target_lang_translations": {
                                "ru": "Мы слышали, как далёкий <w>рёв</w> дикого зверя эхом отдавался в тёмном лесу."
                            }
                        }
                    ],
                    "synonyms": [
                        "roar",
                        "bray"
                    ],
                    "common_phrases": [
                        "loud bellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать громкий, глубокий, утробный звук, похожий на рёв разъярённого быка."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реветь",
                                "target_lang_sense_clarification": "издавать протяжный громкий крик (о животных)"
                            },
                            {
                                "target_lang_word": "рычать",
                                "target_lang_sense_clarification": "издавать громкие, угрожающие, низкого тона звуки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81dd37a3-9f96-3d31-ba63-2678bf1f9118",
                    "sense_definition": "To shout in a deep voice.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vocal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coach continued to <w>bellow</w> instructions to his players from the sidelines.",
                            "target_lang_translations": {
                                "ru": "Тренер продолжал <w>реветь</w> инструкции своим игрокам с боковой линии."
                            }
                        },
                        {
                            "text": "He would often <w>bellow</w> orders at his staff whenever he felt frustrated.",
                            "target_lang_translations": {
                                "ru": "Он часто <w>ревел</w> приказы своим сотрудникам, когда чувствовал разочарование."
                            }
                        }
                    ],
                    "synonyms": [
                        "shout",
                        "yell",
                        "roar"
                    ],
                    "antonyms": [
                        "whisper"
                    ],
                    "common_phrases": [
                        "bellow orders"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кричать низким, громоподобным голосом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "реветь",
                                "target_lang_sense_clarification": "громко кричать неистовым голосом"
                            },
                            {
                                "target_lang_word": "орать",
                                "target_lang_sense_clarification": "разговорный вариант громкого крика"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7cb46803-9f27-3eab-b3b9-41aa8de17f08",
                    "sense_definition": "The deep roar of a large animal, or any similar loud noise.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vocal_sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden <w>bellow</w> from the bull startled everyone standing near the fence.",
                            "target_lang_translations": {
                                "ru": "Внезапный <w>рёв</w> быка напугал всех, кто стоял у забора."
                            }
                        },
                        {
                            "text": "A deep <w>bellow</w> of rage erupted from the crowd when the referee made the call.",
                            "target_lang_translations": {
                                "ru": "Глубокий <w>рёв</w> ярости вырвался из толпы, когда судья принял это решение."
                            }
                        }
                    ],
                    "synonyms": [
                        "roar"
                    ],
                    "common_phrases": [
                        "loud bellow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокий рёв крупного животного или любой подобный громкий звук."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рёв",
                                "target_lang_sense_clarification": "протяжный, громкий и напряжённый крик животного или сильный гул"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "79206656-d457-3680-be4a-79f7068a2587",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous author Saul <w>Bellow</w> won the Nobel Prize in Literature.",
                            "target_lang_translations": {
                                "ru": "Знаменитый писатель Сол <w>Беллоу</w> получил Нобелевскую премию по литературе."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Bellow</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера на конференции я встретил человека по фамилии <w>Беллоу</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Used as a family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Беллоу",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}