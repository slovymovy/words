{
    "word_family": [
        "minority"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c1f04e87-d1fa-33db-8882-85bc7a94a0dd",
                    "sense_definition": "Small in importance, size, or degree compared to other things.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "general_size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We made a few <w>minor</w> changes to the plan before approving it.",
                            "target_lang_translations": {
                                "ru": "Мы внесли несколько <w>незначительных</w> изменений в план перед его утверждением.",
                                "zh": "在批准计划之前，我们对计划做了一些<w>次要的</w>修改。"
                            }
                        },
                        {
                            "text": "It is a <w>minor</w> problem that we can easily fix later.",
                            "target_lang_translations": {
                                "ru": "Это <w>мелкая</w> проблема, которую мы легко сможем исправить позже.",
                                "zh": "这是一个<w>微小的</w>问题，我们稍后可以轻松解决。"
                            }
                        }
                    ],
                    "synonyms": [
                        "insignificant",
                        "slight",
                        "small"
                    ],
                    "antonyms": [
                        "major"
                    ],
                    "common_phrases": [
                        "minor change",
                        "minor problem",
                        "minor role",
                        "minor issue"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой по важности, размеру или степени по сравнению с другими вещами.",
                        "zh": "指相对于其他事物而言，在重要性、规模或程度上较小的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "незначи́тельный",
                                "target_lang_sense_clarification": "о важности или изменениях"
                            },
                            {
                                "target_lang_word": "ме́лкий",
                                "target_lang_sense_clarification": "о проблемах или деталях"
                            },
                            {
                                "target_lang_word": "второстепе́нный",
                                "target_lang_sense_clarification": "не основной"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "次要的",
                                "target_lang_sense_clarification": "指重要性较低"
                            },
                            {
                                "target_lang_word": "微小的",
                                "target_lang_sense_clarification": "指规模或程度较小"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58f30581-ed07-3721-8d96-34a588479012",
                    "sense_definition": "Not serious; not involving a risk of death or permanent health damage.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical_safety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fortunately, the driver suffered only <w>minor</w> injuries in the crash.",
                            "target_lang_translations": {
                                "ru": "К счастью, водитель получил лишь <w>лёгкие</w> травмы в аварии.",
                                "zh": "幸运的是，司机在车祸中只受了<w>轻微的</w>伤。"
                            }
                        },
                        {
                            "text": "He went to the hospital for <w>minor</w> surgery on his knee.",
                            "target_lang_translations": {
                                "ru": "Он лег в больницу для проведения <w>несложной</w> операции на колене.",
                                "zh": "他去医院做了个膝盖<w>小型</w>手术。"
                            }
                        }
                    ],
                    "antonyms": [
                        "major"
                    ],
                    "common_phrases": [
                        "minor injury",
                        "minor surgery",
                        "minor illness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Несерьезный; не влекущий за собой риска смерти или необратимого ущерба здоровью.",
                        "zh": "指不严重的；不涉及生命危险或永久性健康损害的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лёгкий",
                                "target_lang_sense_clarification": "о травмах или повреждениях"
                            },
                            {
                                "target_lang_word": "несло́жный",
                                "target_lang_sense_clarification": "об операциях или процедурах"
                            },
                            {
                                "target_lang_word": "незначи́тельный",
                                "target_lang_sense_clarification": "об ущербе здоровью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻微的",
                                "target_lang_sense_clarification": "指伤势或病情不重"
                            },
                            {
                                "target_lang_word": "小型的",
                                "target_lang_sense_clarification": "指手术或医疗程序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d89a2d22-f428-358b-8746-936c7a5a4de8",
                    "sense_definition": "Relating to a musical key, scale, or chord often associated with a sad or melancholy sound.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "music_theory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The symphony is written in C <w>minor</w> and has a very dramatic opening.",
                            "target_lang_translations": {
                                "ru": "Симфония написана в до <w>миноре</w> и имеет очень драматичное начало.",
                                "zh": "这部交响曲是用C<w>小调</w>写成的，开场非常戏剧化。"
                            }
                        },
                        {
                            "text": "Songs in a <w>minor</w> key often sound sadder than those in a major key.",
                            "target_lang_translations": {
                                "ru": "Песни в <w>минорной</w> тональности часто звучат грустнее, чем в мажорной.",
                                "zh": "<w>小调</w>歌曲听起来往往比大调歌曲更忧伤。"
                            }
                        }
                    ],
                    "antonyms": [
                        "major"
                    ],
                    "common_phrases": [
                        "minor key",
                        "minor chord",
                        "minor scale"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к музыкальной тональности, гамме или аккорду, часто ассоциируемый с грустным звучанием.",
                        "zh": "指音乐中的小调、小音阶或小和弦，通常与忧伤或忧郁的音色相关联。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мино́рный",
                                "target_lang_sense_clarification": "прилагательное (лад, аккорд)"
                            },
                            {
                                "target_lang_word": "мино́р",
                                "target_lang_sense_clarification": "существительное (название тональности)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小调",
                                "target_lang_sense_clarification": "指音乐调式"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "521f8059-cdab-3e07-a139-079b98580448",
                    "sense_definition": "A person who is under the legal age of full responsibility, usually under 18.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop is not allowed to sell alcohol to <w>minors</w>.",
                            "target_lang_translations": {
                                "ru": "Магазину не разрешено продавать алкоголь <w>несовершеннолетним</w>.",
                                "zh": "商店不允许向<w>未成年人</w>出售酒精饮料。"
                            }
                        },
                        {
                            "text": "As a <w>minor</w>, he cannot sign the contract without a parent present.",
                            "target_lang_translations": {
                                "ru": "Будучи <w>несовершеннолетним</w>, он не может подписать контракт без присутствия родителя.",
                                "zh": "作为<w>未成年人</w>，没有父母在场他不能签署合同。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "unaccompanied minor"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "law"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, не достигшее возраста, с которого наступает полная юридическая ответственность (обычно 18 лет).",
                        "zh": "指未达到完全法律责任年龄的人，通常指未满18岁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "несовершенноле́тний",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "未成年人",
                                "target_lang_sense_clarification": "法律术语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c013d21-c3fb-3636-ac63-0559b37a8a8e",
                    "sense_definition": "A secondary subject that a student studies at college or university, requiring fewer credits than a major.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "academic_study",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has a major in biology and a <w>minor</w> in chemistry.",
                            "target_lang_translations": {
                                "ru": "У нее основная специализация по биологии и <w>дополнительная</w> по химии.",
                                "zh": "她主修生物学，<w>辅修</w>化学。"
                            }
                        },
                        {
                            "text": "He decided to drop his <w>minor</w> to focus on his main degree requirements.",
                            "target_lang_translations": {
                                "ru": "Он решил отказаться от <w>дополнительной специализации</w>, чтобы сосредоточиться на требованиях основного диплома.",
                                "zh": "他决定放弃<w>辅修</w>，以便专注于主修学位的要求。"
                            }
                        }
                    ],
                    "antonyms": [
                        "major"
                    ],
                    "common_phrases": [
                        "minor in"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "education"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительная специализация студента в колледже или университете.",
                        "zh": "指大学生在主修专业之外学习的辅修学科，所需学分较少。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дополни́тельная специализа́ция",
                                "target_lang_sense_clarification": "в учебной программе"
                            },
                            {
                                "target_lang_word": "непро́фильный предме́т",
                                "target_lang_sense_clarification": "второстепенная дисциплина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辅修",
                                "target_lang_sense_clarification": "指大学学术专业"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d20dc9bf-5016-3728-8a7c-ad4254a20b62",
                    "sense_definition": "To study a secondary subject at university alongside a main subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "academic_study",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I plan to <w>minor</w> in Spanish while getting my business degree.",
                            "target_lang_translations": {
                                "ru": "Я планирую <w>изучать</w> испанский <w>дополнительно</w> во время получения степени в области бизнеса.",
                                "zh": "我计划在攻读商科学位的同时<w>辅修</w>西班牙语。"
                            }
                        },
                        {
                            "text": "She <w>minored</w> in art history during her undergraduate studies.",
                            "target_lang_translations": {
                                "ru": "Она <w>изучала</w> историю искусств <w>как дополнительный предмет</w> во время учебы в бакалавриате.",
                                "zh": "她在本科学习期间<w>辅修</w>了艺术史。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "minor in"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "education"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Изучать дополнительную дисциплину в университете параллельно с основной.",
                        "zh": "指在大学里在主修专业之外学习辅修学科。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изуча́ть дополни́тельно",
                                "target_lang_sense_clarification": "брать как вторую специальность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "辅修",
                                "target_lang_sense_clarification": "指学习行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c51488dd-4490-3daf-9ea8-5261cde5b7f4",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Minor</w> will see you in his office now.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Майнор</w> примет вас в своем кабинете сейчас.",
                                "zh": "<w>迈纳</w>先生现在要在办公室见你。"
                            }
                        },
                        {
                            "text": "We invited the <w>Minor</w> family to the dinner party.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили семью <w>Майнор</w> на званый ужин.",
                                "zh": "我们邀请了<w>迈纳</w>一家来参加晚宴。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ма́йнор",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "迈纳",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}