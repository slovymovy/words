                        "examples": [
                            {
                                "example_id": "3123d47d-8549-4d65-b64a-c3d6e497bfc7",
                                "sense_id": "587c8e27-dbf7-399f-ac16-17779351a886",
                                "text": "Bavaria ziet in de VS een groeiende markt voor bijzondere biertjes. Eerder dit jaar kocht de bierfabrikant al de Belgische brouwerijgroep Palm. De overname van de importeur moet helpen het bier uit de lage landen aan de andere kant van de oceaan aan de man te brengen."
                            },
                            {
                                "example_id": "2e622d4f-4852-4c07-82f5-4b892f36a528",
                                "sense_id": "587c8e27-dbf7-399f-ac16-17779351a886",
                                "text": "Sinds 2003 is er een verbod van kracht op het schenken van alcohol in de Braziliaanse voetbalstadions. De fans zouden er agressief van worden. Tijdens het WK is dat verbod tijdelijk opgeheven, omdat bierfabrikant Budweiser een belangrijke sponsor van de FIFA is."
                            },
                            {
                                "example_id": "1ad46d60-38a0-470f-9947-842cb84533cd",
                                "sense_id": "587c8e27-dbf7-399f-ac16-17779351a886",
                                "text": "Bij de komende Olympische Spelen in Rusland en Brazilië wordt toch een Holland Heineken House gebouwd, waar Nederlandse sporters en fans kunnen feesten. Dat hebben de bierfabrikant en sportkoepel NOC*NSF bekendgemaakt."
                            }
                        ]
                    }
