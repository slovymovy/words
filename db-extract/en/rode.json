                    }
                ],
                "senses": [
                    {
                        "sense_id": "c920fd07-55d3-34a3-b8d3-fce96b958ec2",
                        "entry_id": "551849cd-1ea4-3a6f-8e61-bde76fea6e29",
                        "glosses": [
                            "Obsolete form of road."
                        ],
                        "tags": [
                            "alt-of",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "af81f3fd-b7df-4f12-b6d0-535126108b61",
                                "sense_id": "c920fd07-55d3-34a3-b8d3-fce96b958ec2",
                                "text": "Thomas Carlysle, &c. rode a Forrey to Dunglas, and there seased and brought away 80 Nolt, 200 Shepe, 22 Naggs. A Rode made to a Stede called the Hayrebed, and there they gate 30 Nolt, 3 or 4 Naggs."
                            },
                            {
                                "example_id": "045863f4-f5a1-4518-9ff3-1496ef554292",
                                "sense_id": "c920fd07-55d3-34a3-b8d3-fce96b958ec2",
                                "text": "There dwelt a ſaluage nation, which did liue / Of ſtealth and ſpoile, and making nightly rode / Into their neighbours borders[…]"
                            },
                            {
                                "example_id": "0109ea4c-9314-4816-9278-5926ffbdb185",
                                "sense_id": "c920fd07-55d3-34a3-b8d3-fce96b958ec2",
                                "text": "And Achiſh said, Whither haue ye made a rode to day? And Dauid said, Againſt the South of Iudah, and againſt the South of the Ierahmeelites, and againſt the South of the Kenites."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "ad9f489b-c118-31aa-8cd9-8caa0b71d353",
                "word": "rode",
                "pos": "verb",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4314d4c9-b19c-3847-b42f-98eecca9a28e",
                        "entry_id": "ad9f489b-c118-31aa-8cd9-8caa0b71d353",
                        "glosses": [
                            "simple past of ride"
                        ],
                        "tags": [
