{
    "word_family": [
        "naïveté",
        "naïvement"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e8c0fb70-e798-3925-8dc2-da680ed5e48d",
                    "sense_definition": "Qui, par excès de confiance ou manque d'expérience, se laisse facilement tromper.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "credulite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est bien trop <w>naïf</w> pour croire toutes les promesses de ce vendeur."
                        },
                        {
                            "text": "Elle a été assez <w>naïve</w> pour donner ses coordonnées bancaires par téléphone."
                        }
                    ],
                    "synonyms": [
                        "crédule"
                    ],
                    "antonyms": [
                        "méfiant",
                        "lucide"
                    ],
                    "common_phrases": [
                        "regard naïf"
                    ]
                },
                {
                    "sense_id": "3a59d8a1-1bbe-305d-b956-cdac8f3e9abc",
                    "sense_definition": "Plein de fraîcheur, de simplicité et de sincérité, sans artifice ni calcul.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "naturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants portent souvent un regard <w>naïf</w> et touchant sur le monde qui les entoure."
                        },
                        {
                            "text": "Sa réponse pleine d'une joie <w>naïve</w> a désarmé tous ses interlocuteurs."
                        }
                    ],
                    "synonyms": [
                        "naturel",
                        "candide",
                        "innocent"
                    ],
                    "antonyms": [
                        "artificiel",
                        "affecté"
                    ],
                    "common_phrases": [
                        "charme naïf",
                        "curiosité naïve"
                    ]
                },
                {
                    "sense_id": "884ddb52-dc94-30b8-8486-6f577d82f581",
                    "sense_definition": "Qui relève d'un style artistique caractérisé par la simplicité du dessin, la franchise des couleurs et l'absence de perspective savante.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le musée municipal consacre une exposition temporaire aux peintres de l'art <w>naïf</w>."
                        },
                        {
                            "text": "Cette toile aux tons vifs s'inspire directement d'une esthétique <w>naïve</w> et poétique."
                        }
                    ],
                    "antonyms": [
                        "académique"
                    ],
                    "common_phrases": [
                        "art naïf",
                        "peinture naïve"
                    ]
                },
                {
                    "sense_id": "28f6eb06-3fe0-3b9f-af8c-f5f4ab2941ef",
                    "sense_definition": "Qui exprime sa pensée spontanément, avec une franchise totale et sans détours.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "naturel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "C'est un jeune homme très <w>naïf</w> qui dit toujours tout ce qui lui passe par la tête."
                        },
                        {
                            "text": "Par une question <w>naïve</w>, elle a mis en évidence le mensonge de son camarade."
                        }
                    ],
                    "synonyms": [
                        "ingénu",
                        "spontané"
                    ],
                    "antonyms": [
                        "hypocrite",
                        "sournois"
                    ],
                    "common_phrases": [
                        "question naïve"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9752e65b-3cca-3035-aace-9c5c403d9a5d",
                    "sense_definition": "Personne excessivement crédule ou innocente qui accorde sa confiance sans discernement.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "credulite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne faut pas prendre les gens pour des <w>naïfs</w> capables de croire de telles histoires."
                        },
                        {
                            "text": "Cette pauvre <w>naïve</w> pensait sincèrement avoir gagné le gros lot sans rien faire."
                        }
                    ]
                }
            ]
        }
    ]
}