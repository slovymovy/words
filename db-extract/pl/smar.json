                                        "sense_id": "2c234c53-6299-3ba4-8a16-8c2e0d18aed4",
                                        "entry_id": "71abd595-dfbc-337b-bbea-873c4a8ea931",
                                        "glosses": [
                                            "To bribe."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28eb4c93-351a-4241-adad-93aa8784392e",
                                                "sense_id": "2c234c53-6299-3ba4-8a16-8c2e0d18aed4",
                                                "text": "the greas'd advocate that grinds the poor"
                                            },
                                            {
                                                "example_id": "c7dfd808-9a48-4cab-a3c6-534054816ead",
                                                "sense_id": "2c234c53-6299-3ba4-8a16-8c2e0d18aed4",
                                                "text": "Then you remember we greased him to the tune of five hundred."
                                            },
                                            {
                                                "example_id": "b47b320b-2ba0-484d-9329-70b5434c2b88",
                                                "sense_id": "2c234c53-6299-3ba4-8a16-8c2e0d18aed4",
                                                "text": "His employee status didn't entitle him to one, but Magdy on reception would slip him a key if Sabr greased him with a fifty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "644f6432-ce34-35f9-8d9d-69cf2eea427a",
                                        "entry_id": "71abd595-dfbc-337b-bbea-873c4a8ea931",
                                        "glosses": [
                                            "To cause to go easily; to facilitate."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "278db1ad-6859-38f4-8284-c3a1c349f32f",
                                        "entry_id": "71abd595-dfbc-337b-bbea-873c4a8ea931",
                                        "glosses": [
                                            "To perform a landing extraordinarily smoothly."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc2fac62-5725-4f8f-8943-9f3184c72a4b",
                                                "sense_id": "278db1ad-6859-38f4-8284-c3a1c349f32f",
                                                "text": "To my amazement, I greased the landing despite the tricky crosswinds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "43642091-e61c-37f1-9948-66dec3bdad7e",
                                        "entry_id": "71abd595-dfbc-337b-bbea-873c4a8ea931",
                                        "glosses": [
                                            "To extinguish the life of."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "73c03988-0061-3399-87ac-68e8d5d3d26a",
                                        "entry_id": "71abd595-dfbc-337b-bbea-873c4a8ea931",
                                        "glosses": [
                                            "To have sexual intercourse with."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e5624ac-f340-4a4c-9ab8-3be72a8fa8a6",
                                                "sense_id": "73c03988-0061-3399-87ac-68e8d5d3d26a",
                                                "text": "I’m with a girl, call me Rick, I get my crank on\nChoppa knock him out his briefs, ayy free willy\nHe a blood, why the fuck I’m greasin his bitty"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ac8db1-86b0-3ee7-939f-f7b2aa4249be",
                                        "entry_id": "71abd595-dfbc-337b-bbea-873c4a8ea931",
                                        "glosses": [
                                            "To cheat or cozen; to overreach."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
