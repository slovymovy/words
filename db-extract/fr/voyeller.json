                        "sense_id": "11b54aab-c1f4-36f1-8f28-1817ec61070c",
                        "entry_id": "1a532a74-e89a-344e-953f-2ceaec7e8c9a",
                        "glosses": [
                            "Indiquer des voyelles dans un texte d’une langue sémitique (arabe, hébreu, principalement), les textes en ces langues étant généralement écrits sans vocalisation."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "69771d2c-2c1f-4bcc-9055-0fb153d917b2",
                                "sense_id": "11b54aab-c1f4-36f1-8f28-1817ec61070c",
                                "text": "Il conseille de ne pas voyeller par exemple le n du duel au cas sujet."
                            },
                            {
                                "example_id": "a81db81c-d174-4723-bfed-ac5a47d1e248",
                                "sense_id": "11b54aab-c1f4-36f1-8f28-1817ec61070c",
                                "text": "M. El Ayed insiste alors sur la nécessité de voyeller la langue arabe."
                            }
                        ]
