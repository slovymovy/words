                        "examples": [
                            {
                                "example_id": "7a16b6e2-6a6b-4065-b82e-f333fdbc4ea8",
                                "sense_id": "794ffddb-12f9-3cdb-a062-dc7fc511b969",
                                "text": "The landless younger sons of the gentry often entered the military as the only way to make a living."
                            },
                            {
                                "example_id": "900122ea-79be-4f6f-870a-4ccbfce648f0",
                                "sense_id": "794ffddb-12f9-3cdb-a062-dc7fc511b969",
                                "text": "The landless flock to the cities seeking jobs."
                            },
                            {
                                "example_id": "fe958050-c6d1-4757-ac26-5a58fc6b318e",
                                "sense_id": "794ffddb-12f9-3cdb-a062-dc7fc511b969",
                                "text": "By the mid-19th century, the typical village was sharply divided between the landowning class and the landless, voteless and largely illiterate labourers."
                            }
                        ]
                    },
                    {
