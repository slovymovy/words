                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "e39fe607-47e2-46ce-b7e3-9fbe3b2516f8",
                        "entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more intuitive"
                    },
                    {
                        "form_id": "8519e3fd-dc48-4e25-b45f-2c20c38de6b1",
                        "entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most intuitive"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                        "entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                        "glosses": [
                            "Spontaneous, without requiring conscious thought."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fae3462-89a5-42ad-ae0c-8a4ac9f036dd",
                                "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                                "text": "The intuitive response turned out to be correct."
                            },
                            {
                                "example_id": "25e27ed5-98a0-414a-951b-27acb171597e",
                                "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                                "text": "Libertarian paternalism is the view that, because the way options are presented to citizens affects what they choose, society should present options in a way that “nudges” our intuitive selves to make choices that are more consistent with what our more deliberative selves would have chosen if they were in control."
                            },
                            {
                                "example_id": "d752381a-d409-46e0-9863-171a2ae04d0a",
                                "sense_id": "03c75e1a-9d0e-34ce-9c86-9468cb89ddd7",
                                "text": "These impressions [of potential papal candidates], collected from interviews with a variety of church officials and experts, may influence the very intuitive, often unpredictable process the cardinals will use to decide who should lead the world’s largest church."
                            }
                        ]
                    },
                    {
                        "sense_id": "abf6aa49-868b-3a8a-9d08-94265644e6a9",
                        "entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                        "glosses": [
                            "Easily understood or grasped by intuition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dba9a90d-f972-4dd5-8714-f85882e43b0b",
                                "sense_id": "abf6aa49-868b-3a8a-9d08-94265644e6a9",
                                "text": "Designing software with an intuitive interface can be difficult."
                            }
                        ]
                    },
                    {
                        "sense_id": "c4b9a044-c039-3fc5-9100-865e6d4236ea",
                        "entry_id": "9f81fe93-fc23-3b67-aec2-5cbf6cdb6d8b",
                        "glosses": [
                            "Having a marked degree of intuition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c29fd67a-40d0-4521-824b-57ee9dcb2354",
                                "sense_id": "c4b9a044-c039-3fc5-9100-865e6d4236ea",
                                "text": "I'm real intuitive, everyone is, we're just conditioned not to trust it."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "659d2168-a738-4c50-9b21-652a0d7ff16b",
