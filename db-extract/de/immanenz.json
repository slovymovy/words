                        "entry_id": "4b514f6e-bba8-3a2b-9d26-4df7ade81a9c",
                        "glosses": [
                            "das Verbleiben in einem geschlossenen Bereich ohne dessen Grenzen zu überschreiten"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
