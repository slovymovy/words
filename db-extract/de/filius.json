                                "example_id": "abfe8cfa-c664-4c03-b091-ae2b14a59e7a",
                                "sense_id": "bcf5c0f9-88c8-3283-a9e0-9752efdf851e",
                                "text": "Für den Vorstadt-Familienvater gab es nur eine Möglichkeit, den Filius, der zu Unrecht verurteilt wurde, zu retten."
                            },
                            {
                                "example_id": "a3e589cc-0fca-4607-8d7e-8dae77ea551b",
                                "sense_id": "bcf5c0f9-88c8-3283-a9e0-9752efdf851e",
                                "text": "„Er habe, wandte sich der Justizrat an Anna, deren Blicke zwischen Vater und Sohn hin und her liefen, schon wiederholt beabsichtigt, sich mit seinem Filius darüber auszusprechen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7d780f3-2f74-441f-b9c7-3c58a0e73994",
                        "source_entry_id": "185ce589-4295-3842-86e2-bfdfb2c9c600",
                        "source_sense_id": "bcf5c0f9-88c8-3283-a9e0-9752efdf851e",
