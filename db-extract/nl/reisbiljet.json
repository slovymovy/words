                        "entry_id": "6ff3b90e-3e49-382a-951a-99c938ce1bd2",
                        "glosses": [
                            "papier waarop staat dat men gerechtigd is een bepaalde reis met een bepaald vervoermiddel te maken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ada5feb-e488-4627-b6ea-5f302a46d895",
                                "sense_id": "6705ef37-7990-3bd3-a517-89ea0f41c110",
                                "text": "Bezorgd toonde Quispel de kapitein, die met een laatdunkende trek op zijn gezicht stond te kijken naar al dat binnenstromende vee, zijn reisbiljet, waarop immers City of Hydra was ingevuld."
                            },
                            {
                                "example_id": "f125f837-e34b-46d8-a4b0-91116f7ba1ec",
                                "sense_id": "6705ef37-7990-3bd3-a517-89ea0f41c110",
                                "text": "Ze was aan boord zonder reisbiljet, 'want als je de maîtresse van zo iemand bent, heb je geen kaartje nodig'."
                            }
                        ]
                    }
                ],
