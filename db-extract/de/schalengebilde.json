                "senses": [
                    {
                        "sense_id": "1ddea8f1-0e8a-38ce-b9b5-71363fbd08aa",
                        "entry_id": "1de5ba0f-70a4-3b43-93e5-a4edb66b2704",
                        "glosses": [
                            "ein Gebilde aus Schale oder Schalen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8826cdb-d7bf-40fb-9298-7c716380d475",
                                "sense_id": "1ddea8f1-0e8a-38ce-b9b5-71363fbd08aa",
                                "text": "Vor oder nach dem Theaterbesuch bietet sich noch ein Abstecher in die Riedhalle an, wo die Ostereierausstellung von 10 bis 18 Uhr zu sehen ist. Wem das alles an einem Tag zu viel wird, der kann bereits am Samstag, 6. März, die einzigartigen Schalengebilde anschauen. Auch dann ist die Ausstellung von 10 bis 18 Uhr geöffnet. Der Eintritt kostet 2 Euro."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d85ab4b-1f98-3fe6-8889-e83988924dff",
                        "entry_id": "1de5ba0f-70a4-3b43-93e5-a4edb66b2704",
                        "glosses": [
                            "ein aus Schale gebildeter Gegenstand"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ed2ee7a8-51a0-33b5-92fc-2e09686ed125",
                        "entry_id": "1de5ba0f-70a4-3b43-93e5-a4edb66b2704",
                        "glosses": [
                            "die Schale eines Lebewesens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b284b7-8bb4-400a-9138-ac577a5d7338",
                                "sense_id": "ed2ee7a8-51a0-33b5-92fc-2e09686ed125",
                                "text": "Mithin dürfen wir schliessen, dass, gemäss jenem Entwickelungsgesetze, die jugendlichen Schalengebilde verwandter Cephalopoden einander noch ähnlicher sein werden als diejenigen der erwachsenen Thiere. (1880)"
                            },
                            {
                                "example_id": "b30f9413-c446-4c11-9a95-e84c15de5270",
                                "sense_id": "ed2ee7a8-51a0-33b5-92fc-2e09686ed125",
                                "text": "Daß ferner die außerordentlich zarten Schalengebilde, namentlich die über die Kolonieoberfläche hervortretenden Teile derselben durch Verwitterung und Abreibung für die Untersuchung sehr ungünstig werden können, ist begreiflich."
                            },
                            {
                                "example_id": "28b0ad99-19d0-4160-ad19-c365d59fcade",
                                "sense_id": "ed2ee7a8-51a0-33b5-92fc-2e09686ed125",
                                "text": "Die gewöhnlichen Schuppen der Fische gehören aber mehr zum Schalengebilde."
                            },
                            {
                                "example_id": "61d6769a-ba98-4e37-b961-3ffce0082c50",
                                "sense_id": "ed2ee7a8-51a0-33b5-92fc-2e09686ed125",
                                "text": "Die plattenförmigen Zähne bilden den Uebergang in das Schalengebilde der Mollusken u. s. w"
                            },
                            {
                                "example_id": "3600d992-870e-446a-b854-2a62e5b18943",
                                "sense_id": "ed2ee7a8-51a0-33b5-92fc-2e09686ed125",
                                "text": "In Wirklichkeit ist aber diese Anfangskammer nicht das älteste und erste Schalengebilde, sondern es schieden die Larven zuerst eine mützenförmige Embryonalschale, die Protoconcha, ab."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
