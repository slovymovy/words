                "senses": [
                    {
                        "sense_id": "35f3aea2-b4b2-3c0d-9d71-db5924f237af",
                        "entry_id": "44a28f90-a4df-3edc-802c-24c92d8d71a7",
                        "glosses": [
                            "Faire perdre son caractère chiral à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42b4accc-cffc-4560-b456-6c3737c670e4",
                                "sense_id": "35f3aea2-b4b2-3c0d-9d71-db5924f237af",
                                "text": "Ce nouveau défaut est une double paroi de déchiralisation constituée d’un coeur nématique séparant deux régions déchiralisées à couches orthogonales."
                            },
                            {
                                "example_id": "ef9b5a8a-1b14-47dd-a10a-deba0dfc87c8",
                                "sense_id": "35f3aea2-b4b2-3c0d-9d71-db5924f237af",
                                "text": "L’étude expérimentale est limitée au cas où l’ancrage sur les parois oblige le smectique C chiral à une orientation locale uniforme, c’est-à-dire à se « déchiraliser », alors que dans le volume de l’échantillon la structure hélicoïdale s’établit."
                            }
                        ]
                    }
