                    },
                    {
                        "translation_id": "8940cf5d-0e65-454f-8bf3-c770b137db8b",
                        "source_entry_id": "eb5a4f03-8e0e-3362-a651-1203d82c5dc8",
                        "source_sense_id": "0287cdb8-0177-3b7d-8806-91de548c5830",
                        "source_sense_description": "Kindersprache Hund",
                        "target_lang_word": "bow-wow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bow-wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0135efd7-3ea6-35e5-b3ff-9a9cb618185c",
                                        "entry_id": "805d404b-73be-31a4-9009-f9abf009b72f",
                                        "glosses": [
                                            "Representing the sound of a dog barking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6892ac2-5488-4e0f-b1ff-9222bfb2d9e4",
                                                "sense_id": "0135efd7-3ea6-35e5-b3ff-9a9cb618185c",
                                                "text": "Harke, harke, bowgh wawgh: the watch-Dogges barke, bowgh-wawgh."
                                            },
                                            {
                                                "example_id": "08853a2f-8ff0-495c-a4aa-0615a187bc1a",
                                                "sense_id": "0135efd7-3ea6-35e5-b3ff-9a9cb618185c",
                                                "text": "She […] hath ſtiled him with an immortall penne, the bawewawe of ſchollars, the tutt of gentlemen, the tee-heegh of gentlewomen, the phy of citizens, the blurt of Courtiers, the poogh of good letters, the faph of good manners, and the whoop-hooe of good boyes in London ſtreetes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bow-wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f863e76-50eb-375d-8de5-1da8f8a71e19",
                                        "entry_id": "07eb1131-6219-3a76-89ef-ca86c8795e4f",
                                        "glosses": [
                                            "The sound of a dog barking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64ee98d2-0a47-4bd5-8a75-a9ecd35b213d",
                                                "sense_id": "8f863e76-50eb-375d-8de5-1da8f8a71e19",
                                                "text": "And a chorus of quadruped, white and brown, / Bark’d affirmative, “gone to town,” / With affable bursts of French bow-wow; / (As part of the family they knew how!)"
                                            },
                                            {
                                                "example_id": "642537b3-816f-4ece-8f16-c951f114a610",
                                                "sense_id": "8f863e76-50eb-375d-8de5-1da8f8a71e19",
                                                "text": "The pack commenced to work back and forth along the ridge. We neared a hollow where Prince barked eagerly. Curley answered, and likewise Queen. Mux’s short, angry bow-wow showed that he was in line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "133c1f86-bde1-3bb0-b675-89c8acdf9bd9",
                                        "entry_id": "07eb1131-6219-3a76-89ef-ca86c8795e4f",
                                        "glosses": [
                                            "A dog."
                                        ],
                                        "tags": [
                                            "childish",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ecaa276-b2cc-4d27-8110-6f2ca3e4abb3",
                                                "sense_id": "133c1f86-bde1-3bb0-b675-89c8acdf9bd9",
                                                "text": "1902, Theodore Roosevelt, letter to Kermit Roosevelt dated 13 October, 1902, in Joseph Bucklin Bishop (editor), Theodore Roosevelt’s Letters to His Children, New York: Scribner, 1919, p. 36,\nGem is really a very nice small bow-wow, but Mother found that in this case possession was less attractive than pursuit."
                                            },
                                            {
                                                "example_id": "dc29f1a8-22c7-4ffc-881c-78c067dd0c92",
                                                "sense_id": "133c1f86-bde1-3bb0-b675-89c8acdf9bd9",
                                                "text": "My grandchild, who, when walking, wobbles,\nCalls dogs Bow-wows, and turkeys, Gobbles.\nToday I called a cow Moo-moo;\nShe’s got me talking that way too."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bow-wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c7e52ec-c54d-346f-8170-3cfa81a429f5",
                                        "entry_id": "ec14c455-82c6-3e11-b36c-17e26e7b1cb1",
                                        "glosses": [
                                            "To make the sound of a dog, to bark, to bow-wow"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bow-wow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f33943e6-5f73-3c96-acc7-3853c2ca6ce6",
                                        "entry_id": "18b3ce11-a276-3569-b1b3-df070ae1bad2",
                                        "glosses": [
                                            "Grandiose."
                                        ],
                                        "tags": [
                                            "dated",
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "858d3247-abfe-4b38-a537-dc3bed9c614c",
                                                "sense_id": "f33943e6-5f73-3c96-acc7-3853c2ca6ce6",
                                                "text": "Lord Pembroke said once to me at Wilton, with a happy pleasantry, and some truth, that “Dr. Johnson’s sayings would not appear so extraordinary were it not for his bow-wow way;” but I admit the truth of this only on some occasions."
                                            },
                                            {
                                                "example_id": "08861ce3-0e7d-411a-a7f3-bffe6ff0b9ff",
                                                "sense_id": "f33943e6-5f73-3c96-acc7-3853c2ca6ce6",
                                                "text": "1826, Walter Scott, Diary entry for 14 March, 1826, in The Complete Works of Sir Walter Scott; with a Biography, New York: Conner & Cooke, 1833, Volume 7, Chapter 68, p. 475,\nMiss Austen […] had a talent for describing the involvements, and feelings, and characters of ordinary life, which is to me the most wonderful I ever met with. The Big Bow-wow strain I can do myself like any now going; but the exquisite touch, which renders ordinary commonplace things and characters interesting, from the truth of the description and the sentiment, is denied to me."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdb65aa6-fac9-4b29-bb4a-b10a5bf0c476",
                        "source_entry_id": "eb5a4f03-8e0e-3362-a651-1203d82c5dc8",
                        "source_sense_id": "0287cdb8-0177-3b7d-8806-91de548c5830",
                        "source_sense_description": "Kindersprache Hund",
                        "target_lang_word": "toutou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "toutou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68b67890-cc0a-3ae7-8a38-112aebc3f003",
                                        "entry_id": "957b4c44-3fd8-3ca3-92af-61c47dfbe49e",
                                        "glosses": [
                                            "Chien."
                                        ],
                                        "tags": [
                                            "childish",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fedfa35a-2dc0-419a-9b81-32f07f0d55fb",
                                                "sense_id": "68b67890-cc0a-3ae7-8a38-112aebc3f003",
                                                "text": "Ils devaient avoir une bonne tête, tous la langue pendante, comme des toutous assis en rond sur leur derrière."
                                            },
                                            {
                                                "example_id": "c0297800-b594-4729-95e2-e828eeb765e8",
                                                "sense_id": "68b67890-cc0a-3ae7-8a38-112aebc3f003",
                                                "text": "J'attendrai. Je suis, par contre, impatient de rencontrer ton maître. Je veux dire ton maimaitre, gentil toutou."
                                            },
                                            {
                                                "example_id": "e30c9526-2152-49e9-b24d-2a1e85f9edf4",
                                                "sense_id": "68b67890-cc0a-3ae7-8a38-112aebc3f003",
                                                "text": "De plus, les amoureux des chiens pourront jouir du privilège rare de pouvoir loger avec toutou, à condition que celui-ci soit de petite dimension !"
                                            },
                                            {
                                                "example_id": "4e3b126c-f43b-4bc0-8f7e-df8f448f861b",
                                                "sense_id": "68b67890-cc0a-3ae7-8a38-112aebc3f003",
                                                "text": "Ceux qui n’ont pas peur du ridicule pourront même casquer quelques dollars pour le déguisement du toutou de la maison (27 $ pour un accoutrement de chien-pirate)."
                                            },
                                            {
                                                "example_id": "d69e70c7-ba9a-4f35-92a7-4c5607bc5387",
                                                "sense_id": "68b67890-cc0a-3ae7-8a38-112aebc3f003",
                                                "text": "La promenade fut aménagée pour le bonheur des promeneurs : piste cyclable, crottoirs pour toutous à sa mémère, bancs nombreux et propres permettant de s'extasier devant l’ire des marées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdf42448-0106-3727-ad16-d5e4ff40a1d7",
                                        "entry_id": "957b4c44-3fd8-3ca3-92af-61c47dfbe49e",
                                        "glosses": [
                                            "Petit nom donné à quelqu’un que l’on aime."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0423acee-69c9-4e01-ae44-62d3887b83ec",
                                                "sense_id": "bdf42448-0106-3727-ad16-d5e4ff40a1d7",
                                                "text": "Tu es mon petit toutou adoré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b56ec5-1ef7-3275-bbb3-fc69cf15e434",
                                        "entry_id": "957b4c44-3fd8-3ca3-92af-61c47dfbe49e",
                                        "glosses": [
                                            "Animal ou personnage en peluche."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21f5657d-e5cc-46ba-9e96-4a9707248e52",
                                                "sense_id": "88b56ec5-1ef7-3275-bbb3-fc69cf15e434",
                                                "text": "Ce n’est pas un hasard s’ils réclament un chien ou un hamster, s’ils veulent faire du poney et s’endorment en serrant leur toutou girafe. Les enfants apprennent et grandissent avec les animaux."
                                            },
                                            {
                                                "example_id": "4a60fbb8-4533-4859-8b52-7c10378f45d7",
                                                "sense_id": "88b56ec5-1ef7-3275-bbb3-fc69cf15e434",
                                                "text": "Il habite dans une résidence de la ville de Québec. Une maison des fous où il a sa chambre, où sur son lit reposent ses 100 toutous baptisés, où il enfile les cigarettes, en regardant par la fenêtre le temps qui passe lentement sur le fleuve majestueux."
                                            },
                                            {
                                                "example_id": "1cec5462-2248-48d7-a269-0b0a63acdb2c",
                                                "sense_id": "88b56ec5-1ef7-3275-bbb3-fc69cf15e434",
                                                "text": "Enfant, j'ai eu un toutou lapin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7c3e24f-1c32-3aea-9a0a-73b6c526829d",
                                        "entry_id": "957b4c44-3fd8-3ca3-92af-61c47dfbe49e",
                                        "glosses": [
                                            "ou Personne servile."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively",
                                            "ironic",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c25fe154-b0d6-4f2f-91c3-238e7fd7d69b",
                                                "sense_id": "c7c3e24f-1c32-3aea-9a0a-73b6c526829d",
                                                "text": "— Si j’ai commencé par un calcul, dit Crevel, depuis je suis devenu votre toutou."
                                            },
                                            {
                                                "example_id": "b09c6add-f828-4f20-b85e-d7dfcb46d3fd",
                                                "sense_id": "c7c3e24f-1c32-3aea-9a0a-73b6c526829d",
                                                "text": "Le ministre de l’Agriculture serait donc le toutou de la FNSEA, le larbin de la grande distribution, le chaouche des firmes de l’agroalimentaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
