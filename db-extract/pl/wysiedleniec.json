                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "25a2f468-3cf0-3a9d-81c5-da347dc00d25",
                                        "entry_id": "93a4367b-da2d-37a6-9017-6e679d32d898",
                                        "glosses": [
                                            "eine Person, die aussiedelt oder ausgesiedelt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19472c29-2c63-4b80-b463-b8fdf9b009aa",
                                                "sense_id": "25a2f468-3cf0-3a9d-81c5-da347dc00d25",
                                                "text": "Paul Schmidt ist ein Aussiedler."
                                            },
                                            {
                                                "example_id": "c589181e-87d2-4717-b929-e0cf4a93d255",
                                                "sense_id": "25a2f468-3cf0-3a9d-81c5-da347dc00d25",
                                                "text": "„Kamen die Aussiedler früher vor allem aus Polen und Rumänien, kommt die überwiegende Mehrheit der Spätaussiedler heutzutage aus den Nachfolgestaaten der ehemaligen Sowjetunion.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9679aade-c26f-3a48-8721-5dbd40b342d1",
                                        "entry_id": "93a4367b-da2d-37a6-9017-6e679d32d898",
                                        "glosses": [
                                            "eine Person der deutschen Minderheiten, deren Familien teilweise seit Generationen in Ostmitteleuropa, Osteuropa, Südosteuropa und Asien gelebt haben und die gemäß dem Bundesvertriebenengesetz bis zum 31. Dezember 1992 nach Deutschland eingereist sind"
                                        ],
                                        "tags": [
                                            "Germany"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0fb03ab-6aae-4cd6-874a-5a7e7ad46b21",
                                                "sense_id": "9679aade-c26f-3a48-8721-5dbd40b342d1",
                                                "text": "„Kamen die Aussiedler früher vor allem aus Polen und Rumänien, kommt die überwiegende Mehrheit der Spätaussiedler heutzutage aus den Nachfolgestaaten der ehemaligen Sowjetunion.“"
                                            },
                                            {
                                                "example_id": "5a9e9b8f-093c-4c0d-baa6-60399810269e",
                                                "sense_id": "9679aade-c26f-3a48-8721-5dbd40b342d1",
                                                "text": "„Die Gruppen der Türken, der russischen Aussiedler und der Afghanen sind am größten.“"
                                            },
                                            {
                                                "example_id": "ef200b59-71ef-408e-b7fe-a97b9789c77b",
                                                "sense_id": "9679aade-c26f-3a48-8721-5dbd40b342d1",
                                                "text": "„Die Gemeinde Friedland in Niedersachsen gilt bis heute als Symbol der Hoffnung für Flüchtlinge und Aussiedler, die nach Deutschland kommen.“"
                                            },
                                            {
                                                "example_id": "9809a8d2-1db0-4aef-b7cc-b47a889b0ef1",
                                                "sense_id": "9679aade-c26f-3a48-8721-5dbd40b342d1",
                                                "text": "„Von 1980 bis 1999 kommen rund drei Millionen Aussiedler und Spätaussiedler nach Deutschland.“"
                                            },
                                            {
                                                "example_id": "7249e0a3-eceb-4bc9-a6e1-5eae293d2bb7",
                                                "sense_id": "9679aade-c26f-3a48-8721-5dbd40b342d1",
                                                "text": "„Als Aussiedler oder Vertriebener müssen Sie sich hierzulande auf völlig andere Lebensbedingungen als in Ihrer Heimat einstellen und ein neues Leben beginnen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
