                "senses": [
                    {
                        "sense_id": "73036924-75c8-363d-94dc-80710cba86da",
                        "entry_id": "61659e29-9df0-3485-9e37-fe22158ebcb6",
                        "glosses": [
                            "Sachverständige für Vorfälle, bei denen Gegenstände, Menschen oder Tiere zu Schaden kommen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "206241b4-0e4d-4259-9e98-42136f00599d",
                                "sense_id": "73036924-75c8-363d-94dc-80710cba86da",
                                "text": "„Neben der polizeilichen Unfallaufnahme wurde durch die Staatsanwaltschaft München eine Unfallgutachterin am Unfallort eingesetzt.“"
                            },
                            {
                                "example_id": "728cb1a5-fc68-4c24-ad1b-ed51493e4d5c",
                                "sense_id": "73036924-75c8-363d-94dc-80710cba86da",
                                "text": "„Überhaupt sei sie ja keine Unfallgutachterin, könne das alles ja gar nicht beurteilen.“"
                            },
                            {
                                "example_id": "ae36786c-d711-44bd-921e-c6bf3a562579",
                                "sense_id": "73036924-75c8-363d-94dc-80710cba86da",
                                "text": "„Die Staatsanwaltschaft München setzte am Freitag eine Unfallgutachterin ein.“"
                            },
                            {
                                "example_id": "279e7fc4-8d26-4309-abd7-a07722ba2b84",
                                "sense_id": "73036924-75c8-363d-94dc-80710cba86da",
                                "text": "„Die Polizei und eine Unfallgutachterin wurden unterstützt, dazu die Einsatzstelle großflächig ausgeleuchtet.“"
                            },
                            {
                                "example_id": "984be507-95da-4ec9-9215-57e67bcd9f1b",
                                "sense_id": "73036924-75c8-363d-94dc-80710cba86da",
                                "text": "„Als KFZ-Sachverständige und unabhängige Unfallgutachterin […] kann ich Ihnen eine vertrauensvolle, seriöse und sichere Schadensaufnahme sowie Beweissicherung anbieten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
