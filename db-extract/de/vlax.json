                "senses": [
                    {
                        "sense_id": "16be797d-a8db-38a0-9589-fb05fb99f129",
                        "entry_id": "e205d273-e93e-3e91-be61-2ccae6b1dc1a",
                        "glosses": [
                            "eine Gruppe von Dialekten (auch als eigene Sprache betrachtet) des Romani"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c0b6edc-61e9-43a2-a834-5763f852c238",
                                "sense_id": "16be797d-a8db-38a0-9589-fb05fb99f129",
                                "text": "„Eine übliche Kategorisierung, die lange Bestand hatte, war die Einteilung in Vlax (von Vlach) und non-Vlax Dialekte.“"
                            },
                            {
                                "example_id": "95e498d5-c487-4b7d-96b6-e115f1a2cfc6",
                                "sense_id": "16be797d-a8db-38a0-9589-fb05fb99f129",
                                "text": "„Nach Hancock ist ‚marime‘ ein Vlax Wort, das bei anderen Roma unbekannt ist.“"
                            },
                            {
                                "example_id": "d0505efa-6ee1-478c-b31e-1d7f3c9ab4b3",
                                "sense_id": "16be797d-a8db-38a0-9589-fb05fb99f129",
                                "text": "„Heute unterscheiden die Linguisten die Romanes-Dialekte in Europa grob entlang so genannter Isoglossen, das sind gedachte Linien, die die Grenzen verschiedener Romanes-Sprachen markieren: den Vlax-Dialekt […] den Balkan-Dialekt […] und den nordischen Dialekt[…]“"
                            },
                            {
                                "example_id": "1994ebce-f476-4494-bbfc-2ac2905dd56f",
                                "sense_id": "16be797d-a8db-38a0-9589-fb05fb99f129",
                                "text": "„[…]Pl. findet man schließlich im Vlax und in Mitteleuropa -an, im Balkan -en, im Westen eine Assimilation mit 3. Pl. entweder als -en oder -an, und am Baltikum eine Assimilation an 3. Pl. -e.“"
                            },
                            {
                                "example_id": "ca5eebb8-d9f0-4ab7-a87c-652c199da525",
                                "sense_id": "16be797d-a8db-38a0-9589-fb05fb99f129",
                                "text": "„Auch die Anerkennung der Romani, Vlax oder Kalderash genannten Roma-Sprache steht noch aus.“"
                            },
                            {
                                "example_id": "43c76f8b-cacc-4d08-aa2f-c10ac297fafb",
                                "sense_id": "16be797d-a8db-38a0-9589-fb05fb99f129",
                                "text": "„Zigeuner mit Romani als Muttersprache, die sich als die eigentlichen ‚richtigen‘ Zigeuner betrachten und in der Dialektgruppe der Vlax […] noch eine kastenmäßig aufgesplitterte Stammes- und Sippenorganisation aufweisen[…]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
