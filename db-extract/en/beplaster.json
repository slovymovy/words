                "senses": [
                    {
                        "sense_id": "c12cccae-a507-3c89-ac9f-8a42de3015cd",
                        "entry_id": "83bb5710-4ced-33de-b40a-3f2c4e02e8a9",
                        "glosses": [
                            "To plaster over; to cover or smear thickly; to bedaub (with something)."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "6037f92c-b8c8-4c03-8d32-9bc36d5fbac6",
                                "sense_id": "c12cccae-a507-3c89-ac9f-8a42de3015cd",
                                "text": "Yet with talents like these, and an excellent heart,\nThe man had his failings, a dupe to his art;\nLike an ill-judging beauty, his colours he spread,\nAnd beplaister’d with rouge, his own natural red."
                            },
                            {
                                "example_id": "32f2b903-075b-4d75-84cf-2706bbcb9e5e",
                                "sense_id": "c12cccae-a507-3c89-ac9f-8a42de3015cd",
                                "text": "A starving man, however, little heeds conventional proprieties, especially on a South-Sea Island, and accordingly Toby and I partook of the dish after our own clumsy fashion, beplastering our faces all over with the glutinous compound, and daubing our hands nearly to the wrist."
                            },
                            {
                                "example_id": "196d3a58-d71b-49de-983c-c7ad3e5671df",
                                "sense_id": "c12cccae-a507-3c89-ac9f-8a42de3015cd",
                                "text": "He pelted straight on in his socks, beplastered with filth out of all semblance to a human being."
                            },
                            {
                                "example_id": "87599530-fd4f-419c-a312-fc9347581473",
                                "sense_id": "c12cccae-a507-3c89-ac9f-8a42de3015cd",
                                "text": "Even here, no movement of life is visible, but one who has lived and known towns like these feels for the first time an emotion of warmth and life as he looks at the gaudy, blazing bill-beplastered silence of that front."
                            }
                        ]
                    }
                ],
