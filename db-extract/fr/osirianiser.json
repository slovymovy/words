                "senses": [
                    {
                        "sense_id": "e2c1a7d1-0503-313b-bfdb-db0756192c82",
                        "entry_id": "355baf31-46e7-3402-ad1d-89309110c75b",
                        "glosses": [
                            "Donner un caractère osirien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f4d2da6-9e9f-4f57-b824-83ef94ea1328",
                                "sense_id": "e2c1a7d1-0503-313b-bfdb-db0756192c82",
                                "text": "En d'autres termes, le buisson hathorique aurait été osirianisé au point d'illustrer par son reverdissement la renaissance du dieu Osiris."
                            },
                            {
                                "example_id": "46b7ab30-1f7a-4fdd-bb94-51ca28796faf",
                                "sense_id": "e2c1a7d1-0503-313b-bfdb-db0756192c82",
                                "text": "D'abord les nouveaux éléments fournis aux spécialistes d'histoire religieuse pour suivre l'évolution de l'iconographique de Sérapis, très \"osirianisée\" au début, puis qui s'individualise, notamment par le calathos."
                            },
                            {
                                "example_id": "3a942f5f-8d59-4b2d-b344-99e57cb06b9a",
                                "sense_id": "e2c1a7d1-0503-313b-bfdb-db0756192c82",
                                "text": "Mais on soupçonne qu’il s'agissait surtout d’« osirianiser » un dieu majeur du Delta 77 – traduisons : de renforcer le contrôle de l’autorité monarchique sur l’activité économique d’un certain nombre d’institutions de poids."
                            }
                        ]
                    }
