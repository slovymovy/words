                        "glosses": [
                            "Sunny; having, characterised by, full of, or illuminated by sunshine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a4db409-7c5f-4e35-bc43-634d6d46aea3",
                                "sense_id": "6f739be7-c833-3c33-8200-5b2497952cd1",
                                "text": "There are men that roll through life, like a fire-new red ball going across Mr. Lord's cricket-ground on a sunshiny day […]"
                            },
                            {
                                "example_id": "02ad3a2a-a1a0-4fc2-9f6d-79bd6ba3107a",
                                "sense_id": "6f739be7-c833-3c33-8200-5b2497952cd1",
                                "text": "A sunshiny shower / Won't last half an hour."
                            }
                        ]
                    },
                    {
                        "sense_id": "53be414a-0e23-34c6-8c6a-5b8458f8feaa",
                        "entry_id": "2f5a14dc-2815-3d29-9bd3-9cca8e041aa9",
                        "glosses": [
                            "Beautiful and bright, as if illuminated by sunshine; radiant; beaming; glowing; resplendent; shining."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "01d79226-e429-4d32-9aa1-6a72da9979b8",
                                "sense_id": "53be414a-0e23-34c6-8c6a-5b8458f8feaa",
                                "text": "The blazing brightneſſe of her beauties beame, / And glorious light of her ſunſhyny face / To tell, vvere as to ſtriue against the ſtreame."
                            },
                            {
                                "example_id": "5a2cac72-616a-4985-b0b0-ead8bc1ea27d",
                                "sense_id": "53be414a-0e23-34c6-8c6a-5b8458f8feaa",
                                "text": "He to her lept vvith deadly dreadfull looke, / And her ſunſhynie helmet ſoon vnlaced, / Thinking at once both head and helmet to haue raced."
                            }
                        ]
                    },
                    {
                        "sense_id": "4762f3c0-8877-3ff5-b73c-586484456b2d",
                        "entry_id": "2f5a14dc-2815-3d29-9bd3-9cca8e041aa9",
                        "glosses": [
                            "Cheerful; happy; pleasant."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "440786dc-f0e4-4fc1-be70-0e1f7cad49a0",
                                "sense_id": "4762f3c0-8877-3ff5-b73c-586484456b2d",
                                "text": "a sunshiny disposition"
                            },
                            {
                                "example_id": "b9561b07-6464-4499-9e75-f879336b2045",
                                "sense_id": "4762f3c0-8877-3ff5-b73c-586484456b2d",
                                "text": "Flowers can make any room sunshiny."
                            },
                            {
                                "example_id": "052c7729-742c-4947-b533-f8b6fe2ac301",
                                "sense_id": "4762f3c0-8877-3ff5-b73c-586484456b2d",
                                "text": "He had always been a sunshiny sort of boy, but that sun was gone now, buried behind heavy banks of cloud which were still building."
                            }
                        ]
                    }
