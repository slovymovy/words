                ],
                "senses": [
                    {
                        "sense_id": "f2122b63-db81-3b3b-8a9d-5d199dc5d295",
                        "entry_id": "4cc3b63e-b9bb-326f-aa2a-45573cdfd79f",
                        "glosses": [
                            "niet bang"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e98eb08f-76e4-4b7d-b99f-90773b1c50c2",
                                "sense_id": "f2122b63-db81-3b3b-8a9d-5d199dc5d295",
                                "text": "Wat gebeurt er nu als politici met dit soort opvattingen het voor het zeggen krijgen? Dat zien we op dit moment in Oost-Europa gebeuren. De premier van Hongarije, Viktor Orbán, begon in de jaren negentig als relatief gematigd politicus, maar heeft zich in de afgelopen twintig jaar ontwikkeld tot een onverschrokken radicaal-rechtse populist. Orbán doet er alles aan om vluchtelingen uit zijn land te weren en steekt niet onder stoelen of banken dat hij de liberale democratie het liefst af zou schaffen. Zo heeft hij de mediavrijheid beknot, de bevoegdheden van het constitutionele hof beperkt, en politieke vriendjes op cruciale posities benoemd."
                            },
                            {
                                "example_id": "5dc28b50-fec7-4787-8f52-8b23df8e8a76",
                                "sense_id": "f2122b63-db81-3b3b-8a9d-5d199dc5d295",
                                "text": "Harald lag onder de deken met een zaklamp en las met bonkend hart. 'De loopgravenstrijd is de bloedigste, wildste en wreedste van alle veldslagen. Er stonden mannen in op die de situatie meester waren, onbekende, onverschrokken krijgers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "054bbcb2-4368-49a0-a181-bef3d3c95483",
                        "source_entry_id": "4cc3b63e-b9bb-326f-aa2a-45573cdfd79f",
                        "source_sense_id": "f2122b63-db81-3b3b-8a9d-5d199dc5d295",
                        "target_lang_word": "intrépido",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intrépido",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c73f01e6-9b19-304f-866d-b8fe595aee72",
                                        "entry_id": "3061f583-2408-36c3-a963-62fa07ce42b2",
                                        "glosses": [
                                            "Que no tiene miedo ante un peligro o una situación de riesgo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e31c2e73-d6ac-42e2-95b2-40e3353e98b3",
                                                "sense_id": "c73f01e6-9b19-304f-866d-b8fe595aee72",
                                                "text": "Diremos, pues, que el animoso se avanza ó adelanta; el valeroso prosigue, el valiente se espone, y el intrépido se sacrifica."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
