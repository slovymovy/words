{
    "word_family": [
        "polar",
        "polarity",
        "polarization",
        "polarize",
        "polarizer"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "95b2deff-8ff5-38c0-bf00-67e5edc5c86e",
                    "sense_definition": "Divided into two or more sharply contrasting groups or opinions.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "division",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The country has become increasingly <w>polarized</w> over the recent political elections.",
                            "target_lang_translations": {
                                "ru": "Страна стала все более <w>поляризованной</w> из-за недавних политических выборов."
                            }
                        },
                        {
                            "text": "A <w>polarized</w> society often struggles to find common ground on important social issues.",
                            "target_lang_translations": {
                                "ru": "<w>Поляризованному</w> обществу часто трудно найти общий язык по важным социальным вопросам."
                            }
                        }
                    ],
                    "synonyms": [
                        "divided",
                        "split"
                    ],
                    "antonyms": [
                        "united",
                        "unified"
                    ],
                    "common_phrases": [
                        "deeply polarized",
                        "politically polarized"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разделенный на две или более резко контрастирующие группы или мнения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поляризованный",
                                "target_lang_sense_clarification": "разделенный на противоположные лагеря"
                            },
                            {
                                "target_lang_word": "расколотый",
                                "target_lang_sense_clarification": "разделенный из-за конфликта мнений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "613c1966-bc1b-3a5a-9b74-ca29fab193f6",
                    "sense_definition": "Having light waves restricted to a specific direction of vibration.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "These <w>polarized</w> sunglasses help reduce glare when driving on a sunny day.",
                            "target_lang_translations": {
                                "ru": "Эти <w>поляризованные</w> солнцезащитные очки помогают уменьшить блики при вождении в солнечный день."
                            }
                        },
                        {
                            "text": "The camera lens uses a <w>polarized</w> filter to improve the clarity of the sky.",
                            "target_lang_translations": {
                                "ru": "Объектив камеры использует <w>поляризованный</w> фильтр для улучшения четкости неба."
                            }
                        }
                    ],
                    "common_phrases": [
                        "polarized light",
                        "polarized lenses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий световые волны, ограниченные определенным направлением колебаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поляризованный",
                                "target_lang_sense_clarification": "относящийся к физическому свойству света или фильтров"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8f54b72c-e877-3bcb-947c-6a437c7ea1fe",
                    "sense_definition": "Simple past and past participle of <w>polarize</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controversial speech <w>polarized</w> the entire audience.",
                            "target_lang_translations": {
                                "ru": "Спорная речь <w>поляризовала</w> всю аудиторию."
                            }
                        },
                        {
                            "text": "Public opinion has been <w>polarized</w> by the new legislation.",
                            "target_lang_translations": {
                                "ru": "Общественное мнение было <w>поляризовано</w> новым законодательством."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола «поляризовать»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поляризовал",
                                "target_lang_sense_clarification": "глагол в прошедшем времени"
                            },
                            {
                                "target_lang_word": "поляризованный",
                                "target_lang_sense_clarification": "причастие, описывающее состояние после воздействия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
