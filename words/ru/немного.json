{
    "word_family": [
        "немножко",
        "немножечко",
        "немногие"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a3a9bc66-bc9c-338b-bb7b-0e0a7cb3dda1",
                    "sense_definition": "В незначительной мере, степени; слегка.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>немного</w> понимаю по-русски, но говорить мне трудно.",
                            "target_lang_translations": {
                                "en": "I understand Russian <w>a little</w>, but speaking is hard for me.",
                                "cs": "Rusky rozumím <w>trochu</w>, ale mluvit je pro mě těžké.",
                                "zh": "我<w>一点</w>俄语，但对我来说说很难。"
                            }
                        },
                        {
                            "text": "Он <w>немного</w> ослабил крышку, и пар вырвался наружу.",
                            "target_lang_translations": {
                                "en": "He loosened the lid <w>a little</w>, and steam escaped.",
                                "cs": "Víčko <w>trochu</w> povolil a pára vyrazila ven.",
                                "zh": "他把盖子<w>稍微</w>松开了一些，蒸汽就冒出来了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "слегка",
                        "чуть-чуть",
                        "несколько",
                        "чуток",
                        "чуть",
                        "малость"
                    ],
                    "antonyms": [
                        "много"
                    ],
                    "common_phrases": [
                        "немного странно",
                        "немного устал",
                        "немного лучше",
                        "немного погодя"
                    ],
                    "target_lang_definitions": {
                        "en": "To a small extent or degree; slightly.",
                        "cs": "V nevýznamné míře, stupni; lehce.",
                        "zh": "在较小的程度或范围内；稍微。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a little",
                                "target_lang_sense_clarification": "to a small extent or degree"
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "slightly; to a small extent"
                            },
                            {
                                "target_lang_word": "slightly",
                                "target_lang_sense_clarification": "to a small degree"
                            },
                            {
                                "target_lang_word": "somewhat",
                                "target_lang_sense_clarification": "to a limited extent"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "trochu",
                                "target_lang_sense_clarification": "v malé míře nebo stupni"
                            },
                            {
                                "target_lang_word": "trošičku",
                                "target_lang_sense_clarification": "zdrobnělina vyjadřující velmi malou míru"
                            },
                            {
                                "target_lang_word": "mírně",
                                "target_lang_sense_clarification": "v mírném stupni"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "表示程度轻微"
                            },
                            {
                                "target_lang_word": "稍微",
                                "target_lang_sense_clarification": "表示程度略微"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7029168e-31e1-30a8-b023-72632146216e",
                    "sense_definition": "В течение небольшого промежутка времени; недолго.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Рядчик подумал <w>немного</w>, встряхнул головой и согласился.",
                            "target_lang_translations": {
                                "en": "The contractor thought <w>a little</w>, shook his head, and agreed.",
                                "cs": "Dodavatel <w>chvíli</w> přemýšlel, zavrtěl hlavou a souhlasil.",
                                "zh": "承包商想了<w>一会儿</w>，摇了摇头，同意了。"
                            }
                        },
                        {
                            "text": "Мы постояли <w>немного</w> у входа и решили войти внутрь.",
                            "target_lang_translations": {
                                "en": "We stood <w>a bit</w> at the entrance and decided to go inside.",
                                "cs": "<w>Chvíli</w> jsme stáli u vchodu a rozhodli se jít dovnitř.",
                                "zh": "我们在入口处站了<w>一会儿</w>，决定进去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "недолго"
                    ],
                    "common_phrases": [
                        "подождать немного",
                        "подумать немного",
                        "ещё немного",
                        "осталось немного"
                    ],
                    "target_lang_definitions": {
                        "en": "For a short period of time; briefly.",
                        "cs": "Po krátkou dobu; ne dlouho.",
                        "zh": "在较短的时间内；片刻。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a little",
                                "target_lang_sense_clarification": "for a short time"
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "for a short time"
                            },
                            {
                                "target_lang_word": "for a while",
                                "target_lang_sense_clarification": "for a period of time"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chvíli",
                                "target_lang_sense_clarification": "po krátký časový úsek"
                            },
                            {
                                "target_lang_word": "na chvíli",
                                "target_lang_sense_clarification": "na krátký okamžik"
                            },
                            {
                                "target_lang_word": "trochu",
                                "target_lang_sense_clarification": "po krátkou dobu (hovorově)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一会儿",
                                "target_lang_sense_clarification": "表示时间短暂"
                            },
                            {
                                "target_lang_word": "片刻",
                                "target_lang_sense_clarification": "表示极短的时间"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "numeral",
            "senses": [
                {
                    "sense_id": "119b10f2-1545-34f1-9bcb-76461096b76e",
                    "sense_definition": "Небольшое количество чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Чтобы яблоки не подгорели, надо подлить <w>немного</w> воды.",
                            "target_lang_translations": {
                                "en": "To keep the apples from burning, you need to add <w>a little</w> water.",
                                "cs": "Aby se jablka nepřipálila, je třeba přilít <w>trochu</w> vody.",
                                "zh": "为了不让苹果烧焦，需要加<w>一点</w>水。"
                            }
                        },
                        {
                            "text": "У меня есть <w>немного</w> времени, чтобы обсудить этот вопрос.",
                            "target_lang_translations": {
                                "en": "I have <w>a little</w> time to discuss this issue.",
                                "cs": "Mám <w>trochu</w> času probrat tuto otázku.",
                                "zh": "我还有<w>一些</w>时间来讨论这个问题。"
                            }
                        }
                    ],
                    "synonyms": [
                        "мало",
                        "чуть-чуть"
                    ],
                    "antonyms": [
                        "много",
                        "немало",
                        "полным-полно",
                        "тьма",
                        "уйма",
                        "куча",
                        "бездна",
                        "множество",
                        "не счесть"
                    ],
                    "common_phrases": [
                        "немного воды",
                        "немного денег",
                        "немного времени",
                        "немного терпения"
                    ],
                    "target_lang_definitions": {
                        "en": "A small amount of something.",
                        "cs": "Malé množství něčeho.",
                        "zh": "指少量的事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "a little",
                                "target_lang_sense_clarification": "a small amount of an uncountable thing"
                            },
                            {
                                "target_lang_word": "a bit",
                                "target_lang_sense_clarification": "a small amount"
                            },
                            {
                                "target_lang_word": "some",
                                "target_lang_sense_clarification": "an indefinite amount"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "trochu",
                                "target_lang_sense_clarification": "neurčité malé množství"
                            },
                            {
                                "target_lang_word": "trošičku",
                                "target_lang_sense_clarification": "velmi malé množství"
                            },
                            {
                                "target_lang_word": "trocha",
                                "target_lang_sense_clarification": "podstatné jméno označující malé množství"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一些",
                                "target_lang_sense_clarification": "表示不确定的少量"
                            },
                            {
                                "target_lang_word": "一点",
                                "target_lang_sense_clarification": "表示少量"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e9d0f12a-3f9c-35b3-92b9-eb80ab678c0d",
                    "sense_definition": "Недостаточно, не в избытке (как сказуемое).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Хомутов и телег в деревне <w>немного</w>, поэтому берегите их.",
                            "target_lang_translations": {
                                "en": "There are <w>few</w> collars and carts in the village, so take care of them.",
                                "cs": "Postrojů a vozů je v dědině <w>málo</w>, proto si jich važte.",
                                "zh": "村里的马具和马车<w>不多</w>，所以要爱护它们。"
                            }
                        },
                        {
                            "text": "Таких честных людей сейчас <w>немного</w>.",
                            "target_lang_translations": {
                                "en": "There are <w>few</w> such honest people nowadays.",
                                "cs": "Takových čestných lidí je dnes <w>málo</w>.",
                                "zh": "现在像这样诚实的人<w>很少</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "мало"
                    ],
                    "antonyms": [
                        "много"
                    ],
                    "target_lang_definitions": {
                        "en": "Not many or not much; insufficient in number or quantity.",
                        "cs": "Nedostatečně, ne v nadbytku; málo.",
                        "zh": "数量不多，不足。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "few",
                                "target_lang_sense_clarification": "not many; a small number of"
                            },
                            {
                                "target_lang_word": "not much",
                                "target_lang_sense_clarification": "not a large amount"
                            },
                            {
                                "target_lang_word": "little",
                                "target_lang_sense_clarification": "not much; small in quantity"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "málo",
                                "target_lang_sense_clarification": "nedostatečné množství nebo počet"
                            },
                            {
                                "target_lang_word": "poskrovnu",
                                "target_lang_sense_clarification": "velmi málo, nedostatečně"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "不多",
                                "target_lang_sense_clarification": "表示数量很少"
                            },
                            {
                                "target_lang_word": "很少",
                                "target_lang_sense_clarification": "表示稀少"
                            }
                        ]
                    }
                }
            ]
        }
    ]
