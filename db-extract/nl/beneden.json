                                            {
                                                "example_id": "6d2c5020-64f5-40e6-b16d-3293cc5babbb",
                                                "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                                "text": "The town is situated on a hillside, with a river running below."
                                            },
                                            {
                                                "example_id": "c0e3704c-c8ab-4b40-8cc9-2391f7bb59d0",
                                                "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                                "text": "He was pulled below by a sea monster."
                                            },
                                            {
                                                "example_id": "e947348d-80f1-49e6-9e92-2da63d3afbba",
                                                "sense_id": "8e81c23d-3216-3e22-b67a-9c085f9aa2ee",
                                                "text": "But then I had the [massive] flintlock by me for protection.\n[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window at the old mare feeding in the meadow below by the brook, and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge,[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8828b753-a391-3fb6-a84b-062898dd9b9e",
                                        "entry_id": "06f22599-3bd3-38c0-bbd7-647e08eb4aa5",
                                        "glosses": [
                                            "In or to a lower place.",
                                            "On or to a lower storey."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a935597-400d-45e4-8a8a-37dec3482fb0",
                                                "sense_id": "8828b753-a391-3fb6-a84b-062898dd9b9e",
                                                "text": "She lives below, on the ground floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4875a7da-47da-3b8a-80eb-7155632f37d3",
                                        "entry_id": "06f22599-3bd3-38c0-bbd7-647e08eb4aa5",
                                        "glosses": [
                                            "In or to a lower place.",
                                            "On or to a lower deck, especially as relative to the main deck."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d11e5ae-6362-4c84-be84-65ddbd46a9d5",
                                                "sense_id": "4875a7da-47da-3b8a-80eb-7155632f37d3",
                                                "text": "The captain went below to inspect the engine."
                                            },
                                            {
                                                "example_id": "bd6a394d-6c0d-4a0b-9b3b-a2456be1a50b",
                                                "sense_id": "4875a7da-47da-3b8a-80eb-7155632f37d3",
                                                "text": "the landlubbers lying down below"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a492b1e-afff-357f-8b91-8c44f35f93ea",
                                        "entry_id": "06f22599-3bd3-38c0-bbd7-647e08eb4aa5",
                                        "glosses": [
                                            "Later in the same text."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
