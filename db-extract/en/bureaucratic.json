                    },
                    {
                        "translation_id": "6c5ff3c4-feaa-45f8-95a7-d5a50f14037f",
                        "source_entry_id": "75688055-0839-3f5a-8026-e638a1669d15",
                        "source_sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                        "source_sense_description": "of or pertaining to bureaucracy",
                        "target_lang_word": "bureaucratisch",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bureaucratisch",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "f7825c9f-b033-34f8-a953-c310a7eaf85e",
                                        "entry_id": "1cfc3347-bd96-3791-b945-c895729f48d0",
                                        "glosses": [
                                            "van, volgens de bureaucratie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "723a1cb3-a5f5-4251-ba3e-3df6eb10e793",
                                                "sense_id": "f7825c9f-b033-34f8-a953-c310a7eaf85e",
                                                "text": "Mocht er ooit iemand informatie over deze zaak willen, dan zou men op een bureaucratische puinhoop stuiten."
                                            },
                                            {
                                                "example_id": "b18813c6-9f5f-42b6-9142-35b65a36a57f",
                                                "sense_id": "f7825c9f-b033-34f8-a953-c310a7eaf85e",
                                                "text": "Want de arbeidersmeerderheid had het probleem dat ze geen opgeleide mensen hadden voor alle bureaucratische en politieke posten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcfb937c-c001-48bc-912c-4f4fa4e985d1",
                        "source_entry_id": "75688055-0839-3f5a-8026-e638a1669d15",
                        "source_sense_id": "955352e6-f3e8-3f9e-b2bb-8e447ab0d442",
                        "source_sense_description": "of or pertaining to bureaucracy",
                        "target_lang_word": "bürokratisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bürokratisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                        "entry_id": "3746f71f-a636-36a5-b9a6-b8c869c87e80",
                                        "glosses": [
                                            "sich sehr pedantisch an Regeln haltend / Vorschriften befolgend, dabei autoritär, schwerfällig und unflexibel wirkend"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13b33a58-1213-422c-90fa-81e302ecbb13",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Der klassische Schüleraustausch ist beliebt, aber teuer und bürokratisch aufwendig. Viel einfacher ist die Begegnung unterschiedlicher Kulturen übers Netz.“"
                                            },
                                            {
                                                "example_id": "af2ce9af-b236-4102-8769-7deafa4c0091",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Im internationalen Vergleich ist das deutsche Gesundheitssystem […] teuer und bürokratisch.“"
                                            },
                                            {
                                                "example_id": "839de11c-f64b-445c-a53f-c13e950126e6",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Das Beschaffungswesen der Bundeswehr ist noch immer bürokratisch und langwierig.“"
                                            },
                                            {
                                                "example_id": "9ebb35b7-99ad-4f09-b0d5-233a88ce9770",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "[Seit Juni 2017] „dürfen auch in Deutschland homosexuelle Paare ohne größeren bürokratischen Aufwand heiraten.“"
                                            },
                                            {
                                                "example_id": "c3979d5d-749f-43c2-a06f-775696285b91",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Eine Baubewilligung für Fenster in Solardächern ist eine unnötige bürokratische Hürde, findet CVP-Landrat Oberbeck.“"
                                            },
                                            {
                                                "example_id": "ec26dc37-2158-4c55-9e7d-97814854bdb9",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "[China in der Corona-Pandemie:] „Private Straßenhändler, die viele Jahre politisch und bürokratisch bekämpft wurden, erleben in diesen Krisenzeiten einen überraschenden Aufschwung.“"
                                            },
                                            {
                                                "example_id": "53593d4d-03ad-4b10-a486-27ff5d244158",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Einige [der Wohnungslosen] wehren sich jetzt gegen bürokratische Hürden der Stadt München, bevor eine Wohnung zugewiesen wird.“"
                                            },
                                            {
                                                "example_id": "8b6f9b22-ff6a-4b76-a4cf-f59f3c1f2ef0",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„Der Thüringer Hotel- und Gaststättenverband Dehoga kritisiert die Gästelisten in Restaurants und Cafés. Hauptgeschäftsführer Dirk Ellinger bezeichnete sie als bürokratisches Monster.“"
                                            },
                                            {
                                                "example_id": "1bff3ac2-0485-4aed-a026-fd6c5d922939",
                                                "sense_id": "454fcbd9-f374-3e2f-aca1-021e951d1fca",
                                                "text": "„[Kunst-]werke, die nicht auf diese Weise [durch Verkauf] \"verwertet\" werden konnten, wurden von Propagandaminister Goebbels 1939 zur Vernichtung freigegeben - fein säuberlich in Listen erfasst. Der Referent in der Abteilung Bildende Kunst, Rolf Hetsch, hatte alle Exponate der \"entarteten Kunst\" bürokratisch genau dokumentiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9e64fee0-3787-39d2-8a83-0081174a9449",
                                        "entry_id": "3746f71f-a636-36a5-b9a6-b8c869c87e80",
                                        "glosses": [
                                            "den Regeln einer Verwaltung folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6626dd2-9787-44e2-a5c4-4ae87781ee9d",
                                                "sense_id": "9e64fee0-3787-39d2-8a83-0081174a9449",
                                                "text": "„Deutlicher zu erkennen als der bürokratische Ablauf sind die verschiedenen Elemente, die die Entscheidungsfindung beeinflußten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
