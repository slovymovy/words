        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6afd8d4b-28df-3991-8714-6a203094bb42",
                    "sense_definition": "The edible white root of a yellow-flowered plant, Brassica rapa, often used as a vegetable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer harvested a large <w>turnip</w> from the garden.",
                            "target_lang_translations": {
                                "ru": "Фермер собрал с огорода большую <w>репу</w>.",
                                "pl": "Rolnik zebrał z ogrodu dużą <w>rzepę</w>."
                            }
                        },
                        {
                            "text": "Boil the <w>turnip</w> until it is soft and tender.",
                            "target_lang_translations": {
                                "ru": "Варите <w>репу</w>, пока она не станет мягкой и нежной.",
                                "pl": "Gotuj <w>rzepę</w>, aż będzie miękka i delikatna."
                            }
                        }
                    ],
                    "common_phrases": [
                        "fresh turnip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Съедобный корнеплод растения Brassica rapa, часто используемый в пищу как овощ.",
                        "pl": "Jadalny korzeń rzepy (Brassica rapa), często używany jako warzywo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репа",
                                "target_lang_sense_clarification": "корнеплод растения, употребляемый в пищу"
                            },
                            {
                                "target_lang_word": "репка",
                                "target_lang_sense_clarification": "уменьшительно-ласкательная форма слова репа"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "rzepa",
                                "target_lang_sense_clarification": "warzywo korzeniowe"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "41bcc13f-fbcd-379e-978f-b277d1e99ce1",
                    "sense_definition": "The yellow root of the plant Brassica napus.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The yellow <w>turnip</w> has a slightly sweeter taste than the white variety.",
                            "target_lang_translations": {
                                "ru": "У желтой <w>брюквы</w> вкус немного слаще, чем у белого сорта.",
                                "pl": "Żółta <w>brukiew</w> ma nieco słodszy smak niż biała odmiana."
                            }
                        },
                        {
                            "text": "Many people confuse the yellow <w>turnip</w> with other root vegetables.",
                            "target_lang_translations": {
                                "ru": "Многие люди путают желтую <w>брюкву</w> с другими корнеплодами.",
                                "pl": "Wielu ludzi myli żółtą <w>brukiew</w> z innymi warzywami korzeniowymi."
                            }
                        }
                    ],
                    "synonyms": [
                        "rutabaga",
                        "swede",
                        "tumshie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Желтый корнеплод растения Brassica napus (брюква).",
                        "pl": "Żółty korzeń rośliny Brassica napus (brukiew)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "брюква",
                                "target_lang_sense_clarification": "кормовой и пищевой корнеплод, часто желтого цвета"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "brukiew",
                                "target_lang_sense_clarification": "korzeń Brassica napus"
                            },
                            {
                                "target_lang_word": "karpiel",
                                "target_lang_sense_clarification": "regionalna nazwa brukwi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0320db1-458b-3c88-a5e6-0679bc4a947a",
                    "sense_definition": "The long white root of the daikon plant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vegetable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chef sliced the <w>turnip</w> thinly for the salad.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар тонко нарезал <w>дайкон</w> для салата.",
                                "pl": "Szef kuchni cienko pokroił <w>daikon</w> do sałatki."
                            }
                        },
                        {
                            "text": "This type of <w>turnip</w> is very popular in Asian cuisine.",
                            "target_lang_translations": {
                                "ru": "Этот вид <w>дайкона</w> очень популярен в азиатской кухне.",
                                "pl": "Ten rodzaj <w>białej rzodkwi</w> jest bardzo popularny w kuchni azjatyckiej."
                            }
                        }
                    ],
                    "synonyms": [
                        "daikon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Длинный белый корнеплод растения дайкон.",
                        "pl": "Długi biały korzeń rzodkwi japońskiej (daikon)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дайкон",
                                "target_lang_sense_clarification": "японская редька, длинный белый корнеплод"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "daikon",
                                "target_lang_sense_clarification": "biała rzodkiew japońska"
                            },
                            {
                                "target_lang_word": "biała rzodkiew",
                                "target_lang_sense_clarification": "odmiana rzodkwi używana w kuchni azjatyckiej"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db4b3683-7168-39f9-bc30-4593f236d888",
                    "sense_definition": "A foolish or unintelligent person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be such a <w>turnip</w> and listen to what I am saying.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>болваном</w> и слушай, что я говорю.",
                                "pl": "Nie bądź takim <w>bałwanem</w> i posłuchaj, co mówię."
                            }
                        },
                        {
                            "text": "He acted like a complete <w>turnip</w> during the important meeting.",
                            "target_lang_translations": {
                                "ru": "Он вел себя как полный <w>дурак</w> во время важной встречи.",
                                "pl": "Podczas ważnego spotkania zachowywał się jak kompletny <w>głupek</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Used as a mild, informal insult."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глупый или неумный человек.",
                        "pl": "Głupia lub nierozgarnięta osoba."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дурак",
                                "target_lang_sense_clarification": "глупый человек"
                            },
                            {
                                "target_lang_word": "болван",
                                "target_lang_sense_clarification": "глупый, несообразительный человек"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "głupek",
                                "target_lang_sense_clarification": "osoba niemądra"
                            },
                            {
                                "target_lang_word": "baran",
                                "target_lang_sense_clarification": "potoczne określenie osoby niemądrej"
                            },
                            {
                                "target_lang_word": "bałwan",
                                "target_lang_sense_clarification": "osoba głupia, nierozgarnięta"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1d7bfbf7-b472-3559-b1e3-5e95049bec45",
                    "sense_definition": "To feed livestock on turnips.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "farming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Farmers often <w>turnip</w> their sheep during the cold winter months.",
                            "target_lang_translations": {
                                "ru": "Фермеры часто <w>кормят</w> своих овец <w>турнепсом</w> в холодные зимние месяцы.",
                                "pl": "W mroźne zimowe miesiące rolnicy często <w>karmią rzepą</w> swoje owce."
                            }
                        },
                        {
                            "text": "The cattle were <w>turniped</w> to help them gain weight before spring.",
                            "target_lang_translations": {
                                "ru": "Скот <w>откармливали</w> <w>турнепсом</w>, чтобы помочь им набрать вес перед весной.",
                                "pl": "Bydło było <w>skarmiane rzepą</w>, aby pomóc mu przybrać na wadze przed wiosną."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кормить скот репой.",
                        "pl": "Karmić zwierzęta hodowlane rzepą lub brukwią."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кормить турнепсом",
                                "target_lang_sense_clarification": "использовать кормовую репу для откорма скота"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "karmić rzepą",
                                "target_lang_sense_clarification": "skarmiać rzepą zwierzęta hodowlane"
                            },
                            {
                                "target_lang_word": "skarmiać rzepą",
                                "target_lang_sense_clarification": "podawać zwierzętom hodowlanym jako paszę"
                            }
                        ]
                    }
                }
            ]
        }
    ]
