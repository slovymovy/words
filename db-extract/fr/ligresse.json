                        "entry_id": "da9b7d44-eafb-3fe3-b650-036b959a4bb7",
                        "glosses": [
                            "Animal hybride issu du croisement d’une tigresse et d’un lion (qui ne se fait qu’en captivité)."
                        ],
                        "tags": [
                            "Félinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "74fb95e4-73df-426c-9262-6022b73ba6ef",
                                "sense_id": "2b04beed-1d88-3095-92d2-ec5cd7d3e701",
                                "text": "La première li-ligresse, enfant d’un lion et d’une ligresse (un croisement de tigresse et de lion) est née, et c’est probablement l’animal le plus mignon du MONDE."
                            }
                        ]
                    }
                ],
