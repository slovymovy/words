                "senses": [
                    {
                        "sense_id": "35aa1cbc-ed6a-37cf-962e-44d95233ca4b",
                        "entry_id": "e41d6228-b31f-3be2-8901-25406b7288a5",
                        "glosses": [
                            "een kleine flexibele magneetschijf waarop data vanuit de computer kan worden geschreven of afgelezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f61cbaef-d269-404b-9478-f8c85b6bf05a",
                                "sense_id": "35aa1cbc-ed6a-37cf-962e-44d95233ca4b",
                                "text": "Na de komst van de betrouwbaardere USB-stick, die ook een grotere capaciteit heeft, is de diskette nauwelijks meer in gebruik."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c2e03847-3e5e-4d9a-bcb7-c40769e811dd",
                        "source_entry_id": "e41d6228-b31f-3be2-8901-25406b7288a5",
                        "source_sense_id": "35aa1cbc-ed6a-37cf-962e-44d95233ca4b",
                        "source_sense_description": "Magneetschijf",
                        "target_lang_word": "Diskette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Diskette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cc67077e-2efc-3696-8410-8d4c8298ff9b",
                                        "entry_id": "8633af4c-b2bf-3694-afe7-7cc905404fa1",
                                        "glosses": [
                                            "runder, magnetischer Wechseldatenträger, meist fest in eine Kunststoff- oder Papierhülle eingebaut"
                                        ],
                                        "tags": [
                                            "Informationstechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6d7e6be-bde9-4f6f-8c0a-f44a4a530f9a",
                                                "sense_id": "cc67077e-2efc-3696-8410-8d4c8298ff9b",
                                                "text": "Die erste Diskette mit dem dazu gehörenden Laufwerk wurde von IBM 1971 auf den Markt gebracht."
                                            },
                                            {
                                                "example_id": "a97f7e94-d375-4537-ac19-11e398d3e453",
                                                "sense_id": "cc67077e-2efc-3696-8410-8d4c8298ff9b",
                                                "text": "Für viele Anwendungen wurde die Diskette von USB-Sticks abgelöst."
                                            },
                                            {
                                                "example_id": "1924ce19-8907-46bb-9af3-a622338fde4c",
                                                "sense_id": "cc67077e-2efc-3696-8410-8d4c8298ff9b",
                                                "text": "Legst Du bitte die Diskette ein, auf der meine Briefe gespeichert sind?"
                                            },
                                            {
                                                "example_id": "f0fc2ece-ed04-43ea-9c10-88c0e1469a4b",
                                                "sense_id": "cc67077e-2efc-3696-8410-8d4c8298ff9b",
                                                "text": "„Perlmann achtete darauf, daß seine Bewegungen für Giovanni gut zu erkennen waren, als er jetzt wieder zum Rechner zurückrollte und die Diskette ins Laufwerk schob.“"
                                            },
                                            {
                                                "example_id": "d9952eb5-3166-4d04-8369-d273bfac26b3",
                                                "sense_id": "cc67077e-2efc-3696-8410-8d4c8298ff9b",
                                                "text": "„Sie tragen ihren Lebenslauf auf einer Diskette mit sich herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0e4680d4-5df6-4670-bbc2-fd12f550529f",
                        "source_entry_id": "e41d6228-b31f-3be2-8901-25406b7288a5",
