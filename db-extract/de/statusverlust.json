                        "glosses": [
                            "Absinken der Stellung einer Person oder einer Gruppe innerhalb der Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23a924f1-05ba-478a-8f2e-2cdf0977911c",
                                "sense_id": "ffe89022-1a96-33a0-8c16-f76a4732a734",
                                "text": "„Auch wenn sie als Frau in der Hierarchie ohnehin weit unter einem verheirateten Mann stand, musste Bona als verlassene Ehefrau mit gesellschaftlichem Statusverlust kämpfen.“"
                            },
                            {
                                "example_id": "dff34fb9-4885-46df-a8ed-6e7fd3312527",
                                "sense_id": "ffe89022-1a96-33a0-8c16-f76a4732a734",
                                "text": "„Und, ihr Götter, ich kannte das Wort Statusverlust schon, bevor es Leonards Lippen verließ.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
