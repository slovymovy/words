                                        "entry_id": "a5fc3351-d54e-3110-a17a-9efd1a11cb3a",
                                        "glosses": [
                                            "The largest city in Pakistan situated along the Arabian Sea, as well as the provincial capital of Sindh Province."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e1af694-0c17-4652-a487-c11c4b454212",
                                                "sense_id": "f32f2c68-0f94-37e1-a616-29f5b2763943",
                                                "text": "Karachi, colourful buses, colourless buildings, graffitied walls, billboards advertising mobile phones and soft drinks and ice cream, birds circling in the white-hot sky."
                                            }
                                        ]
                                    }
                                ]
                            }
