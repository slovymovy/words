                        ]
                    },
                    {
                        "translation_id": "6c00474a-4cd6-41be-bd9c-acc5bd103735",
                        "source_entry_id": "164085f0-93da-3bcc-8d61-ef0dc940c113",
                        "target_lang_word": "tomografia",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "77bd0fb7-5af2-4d63-aacf-61f808b55eee",
                        "source_entry_id": "164085f0-93da-3bcc-8d61-ef0dc940c113",
                        "target_lang_word": "stratigraphie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stratigraphie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f31186e3-fccc-35f5-807b-d1398ddd4d53",
                                        "entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                                        "glosses": [
                                            "Étude de la succession des dépôts sédimentaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6299f56-7666-4a43-addb-5e2c51350414",
                                                "sense_id": "f31186e3-fccc-35f5-807b-d1398ddd4d53",
                                                "text": "On s’efforce, au cours des fouilles, de dégager chaque niveau, dans l’ordre inverse de sa formation, en suivant la stratigraphie naturelle, ce qui correspond rarement à l’établissement de tranches régulièrement horizontales."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0a15aa-a9df-320e-8094-687e5c6b4c22",
                                        "entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                                        "glosses": [
                                            "Étude des couches de terrain et de leur contenu afin d'établir des séquences chronologiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12a94ca0-e5c1-450a-a715-7c4512632740",
                                                "sense_id": "0a0a15aa-a9df-320e-8094-687e5c6b4c22",
                                                "text": "Cette œuvre réunit à elle seule le champ des possibles de la photographie, ainsi que les sujets essentiels à l’archéologie : chronologie, superposition des faits humains et stratigraphie des sols, occupation de l’espace et traces laissées dans le paysage."
                                            },
                                            {
                                                "example_id": "cc1cfc32-47e1-45f1-832e-f42ced8c34c3",
                                                "sense_id": "0a0a15aa-a9df-320e-8094-687e5c6b4c22",
                                                "text": "Occupé sur plus de 6 000 ans, ce lieu [= Megiddo] n’est pas sans poser des problèmes de stratigraphie et de concordances historiques… allant jusqu’à déstabiliser - avec raison - la grande chronologie traditionnelle établie en 1922, où les épisodes bibliques correspondraient aux périodes de la préhistoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "687cca6f-872c-313e-85cb-dfc61075809d",
                                        "entry_id": "1fc05520-01b8-387a-b33f-808a21186d40",
                                        "glosses": [
                                            "Autre nom pour la tomographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86abc611-6e87-40d4-8a99-6f77b4e52018",
                                                "sense_id": "687cca6f-872c-313e-85cb-dfc61075809d",
                                                "text": "La tomographie, ou stratigraphie, permet de radiographier un plan déterminé du corps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
