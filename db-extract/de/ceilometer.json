                "senses": [
                    {
                        "sense_id": "47b9ecf0-0077-3ad4-99f7-d0413cfd5b68",
                        "entry_id": "68f9ea62-dcbc-3bbf-8a19-7b921ca7bea0",
                        "glosses": [
                            "Apparat zur Bestimmung des vertikalen Abstands zwischen dem Erdboden und der Untergrenze der Bewölkung (Wolkenbasis)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29e8f6ad-b953-4446-8a0d-1e17a4cfe1b5",
                                "sense_id": "47b9ecf0-0077-3ad4-99f7-d0413cfd5b68",
                                "text": "„Auch dafür kann zusätzlich auf die Messungen des Ceilometers zurückgegriffen werden. Die Ergebnisse könnten sich befruchtend auf die Verifizierung und Weiterentwicklung von Wolken- und Niederschlagsmodellen auswirken.“"
                            },
                            {
                                "example_id": "4a52a434-1257-44b1-8271-1d603a49975b",
                                "sense_id": "47b9ecf0-0077-3ad4-99f7-d0413cfd5b68",
                                "text": "„Viele, vor allem sommerliche Wetterlagen, übersteigen deshalb mit den für sie typischen Wolkenmindesthöhen die Reichweite des Ceilometers.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
