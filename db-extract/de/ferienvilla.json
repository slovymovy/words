                "senses": [
                    {
                        "sense_id": "1562f895-cd95-304c-9965-f3ae9a5a2d28",
                        "entry_id": "cd167477-6f5c-35c2-bccc-723cd54a6b69",
                        "glosses": [
                            "Ferienhaus, das auch hohen Ansprüchen gerecht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3face8f9-6ee9-40d3-ac24-320aed6943dc",
                                "sense_id": "1562f895-cd95-304c-9965-f3ae9a5a2d28",
                                "text": "„Sie bleiben sechs Tage, sie sprechen mit niemandem, sie gehen die pinienbeschatteten Straßen zum oberen Ort hinauf, an großen dunklen und stillen Ferienvillen vorbei, die am Hang stehen und aufs Meer hinausblicken.“"
                            },
                            {
                                "example_id": "c8d0ebfd-f168-4ddb-9b96-81fae2f915c1",
                                "sense_id": "1562f895-cd95-304c-9965-f3ae9a5a2d28",
                                "text": "„Oberhalb der berühmten Schmugglerbucht hat Architekt Olivier Dwek eine Ferienvilla hingestellt, die das Blau des Meeres und des Himmels in Szene setzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
