        "nl-extract.jsonl": [
            {
                "entry_id": "a9aaefb9-f58d-3239-8b16-a4c347a8d9c8",
                "word": "treurmars",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "88f65a75-b10c-4337-8ecc-2740fa67020d",
                        "entry_id": "a9aaefb9-f58d-3239-8b16-a4c347a8d9c8",
                        "tags": [
                            "plural"
                        ],
                        "form": "treurmarsen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e20fc652-1802-3d71-a3cc-55d7d672adb7",
                        "entry_id": "a9aaefb9-f58d-3239-8b16-a4c347a8d9c8",
                        "glosses": [
                            "een optocht ter nagedachtenis van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f89543db-390f-428b-b8f0-dc2cdf5852b4",
                                "sense_id": "e20fc652-1802-3d71-a3cc-55d7d672adb7",
                                "text": "Achter de treurmars van de verliezers, slingerde de stroom van winnaars. Trots FC Twente, blij en verwonderd. Dat de ploeg zover zou komen, hadden de spelers amper twee maanden geleden niet kunnen bedenken. Nu wacht de ‘finale’. En krijgt de ploeg van trainer Jan van Staa maar één opdracht en dat is winnen."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a4f25ce-89ff-3a4e-93aa-3a43f4486f67",
                        "entry_id": "a9aaefb9-f58d-3239-8b16-a4c347a8d9c8",
                        "glosses": [
                            "langzaam en plechtig muziekstuk ter nagedachtenis van iets of iemand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59be14d0-e60b-4c1f-8098-b75ed60b704a",
                                "sense_id": "4a4f25ce-89ff-3a4e-93aa-3a43f4486f67",
                                "text": "De kist van Kalasjnikov werd tijdens de ceremonie bewaakt door een erewacht. Kalasjnikovs zoon Viktor voerde het woord. Een orkest zette een treurmars in. De wapenontwerper overleed maandag op 94-jarige leeftijd. Hij bedacht in 1947 de wereldberoemde AK-47, een lichtgewicht automatisch geweer. Het is nog steeds het meestgebruikte vuurwapen ter wereld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d8972e7-2ce7-4885-aa6d-4d4548e6b3d3",
                        "source_entry_id": "a9aaefb9-f58d-3239-8b16-a4c347a8d9c8",
                        "source_sense_id": "4a4f25ce-89ff-3a4e-93aa-3a43f4486f67",
                        "source_sense_description": "treurmuziek",
                        "target_lang_word": "dead march",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dead march",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44d74982-8037-3bcf-bdb8-c9f05dcc5261",
                                        "entry_id": "6692bf05-4cc6-32e9-a40e-56727e3b6bb4",
                                        "glosses": [
                                            "A mournful, deliberately-paced musical work suitable for a funeral or remembrance ceremony."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fed051e3-5960-4046-9c10-2d68ece67841",
                                                "sense_id": "44d74982-8037-3bcf-bdb8-c9f05dcc5261",
                                                "text": "I see a sad procession,\nAnd I hear the sound of coming full-key'd bugles,\nAll the channels of the city streets they're flooding,\nAs with voices and with tears.\n. . .\nNow nearer blow the bugles,\nAnd the drums strike more convulsive,\nAnd the daylight o'er the pavement quite has faded,\nAnd the strong dead-march enwraps me."
                                            },
                                            {
                                                "example_id": "86633600-4822-4f5a-bd81-84f944d9a733",
                                                "sense_id": "44d74982-8037-3bcf-bdb8-c9f05dcc5261",
                                                "text": "A captain's guard marched before the corpse, the captain of it in the rear, the firelocks reversed, the drums beating the dead march."
                                            },
                                            {
                                                "example_id": "9b720085-9ffa-4f53-9c0b-ae32304252e0",
                                                "sense_id": "44d74982-8037-3bcf-bdb8-c9f05dcc5261",
                                                "text": "Lord Cramer . . . described the burying of his company's colonel after it—the open grave in a cleft of hills dark with pines, the solemn dead march, the noble words spoken as they left their leader forever."
                                            },
                                            {
                                                "example_id": "13c4f664-b857-4cd7-a8cd-dc95114b6f3c",
                                                "sense_id": "44d74982-8037-3bcf-bdb8-c9f05dcc5261",
                                                "text": "At the end, the orchestra played a somber dead march that was punctuated by harsh, chilling blows on the timpani."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4bf075b-f431-3834-bcae-f336ed090af1",
                                        "entry_id": "6692bf05-4cc6-32e9-a40e-56727e3b6bb4",
                                        "glosses": [
                                            "Any of several particular notable musical works of this kind, such as the Marche funèbre by Frédéric Chopin or the funeral anthem in George Frideric Handel's Saul."
                                        ],
                                        "tags": [
                                            "capitalized"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e90c5d8c-ef98-4b7d-9f2b-bc123b5f44b2",
                                                "sense_id": "d4bf075b-f431-3834-bcae-f336ed090af1",
                                                "text": "[W]hat divine ravishments may we not anticipate from this venerable, embrowned old organ, which might almost have played the Dead March in Saul, when King Saul himself was buried."
                                            },
                                            {
                                                "example_id": "3fb6c792-ca63-4f8c-849d-8e570d049045",
                                                "sense_id": "d4bf075b-f431-3834-bcae-f336ed090af1",
                                                "text": "Conner's Band preceded the procession, playing the Dead March. The body was conveyed to Cypress Hill Cemetery."
                                            },
                                            {
                                                "example_id": "6aca4432-40ec-4192-9e5a-478a675e362d",
                                                "sense_id": "d4bf075b-f431-3834-bcae-f336ed090af1",
                                                "text": "It was 12:35 p.m. when the train pulled slowly out on its 21-mile journey to Windsor for the King's burial with his ancestors. As it left, the bands played their final farewell, Chopin's \"Dead March.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ba924a80-7417-4658-80ae-fc9f5bd0767a",
