                "senses": [
                    {
                        "sense_id": "c54170a6-2d19-30a5-8f77-b0a0b0b58a69",
                        "entry_id": "fa2ebb3e-b202-3345-9c81-d76511baa0bb",
                        "glosses": [
                            "het applaudisseren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f86219fb-81ae-4124-a0ab-94a5b382fd91",
                                "sense_id": "c54170a6-2d19-30a5-8f77-b0a0b0b58a69",
                                "text": "Toch konden ze rekenen op welwillend geklap bij 'Sign of the times'en 'Firebox', hardrock van poedersuiker die moest illustreren dat Joey Tempest en John Norum de voorbije jaren echt niet hadden zitten aftellen tot ze de dertigste verjaardag van hun grootste hit konden vieren."
                            },
                            {
                                "example_id": "d4e35b01-6f14-4966-bc53-aabb5059ac05",
                                "sense_id": "c54170a6-2d19-30a5-8f77-b0a0b0b58a69",
                                "text": "Als rond half twaalf een poging wordt gedaan of de steen al los komt van de ondergrond, stijgt hij zo een stuk omhoog. De banden schieten los, maar de gravers weten genoeg. Even de riemen op de goede plek sjorren, en het moet lukken. Twee pogingen later stijgt hij uit het gat. Gejuich en geklap: \"Nou, hij is er uit!\""
                            }
                        ]
                    },
                    {
                        "sense_id": "b8f0453d-d366-3b73-baf2-a54cfa11c009",
                        "entry_id": "fa2ebb3e-b202-3345-9c81-d76511baa0bb",
                        "glosses": [
                            "aanhoudend met veel lawaai tegen elkaar slaan van zaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63dfa036-46bf-4e46-bad4-4fa5477061be",
                                "sense_id": "b8f0453d-d366-3b73-baf2-a54cfa11c009",
                                "text": "Het geklap van de deuren maakte mij midden in de nach wakker."
                            }
                        ]
                    },
                    {
                        "sense_id": "c0bb4067-7e25-3ed9-a42d-40576db3820d",
                        "entry_id": "fa2ebb3e-b202-3345-9c81-d76511baa0bb",
                        "glosses": [
                            "aanhouden kwaad spreken over anderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f258062-be56-4584-a2a2-00941beffa19",
                                "sense_id": "c0bb4067-7e25-3ed9-a42d-40576db3820d",
                                "text": "Het geklap van die oude heertjes irriteerde iedereen enorm."
                            }
                        ]
                    }
