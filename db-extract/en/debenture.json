                                    {
                                        "sense_id": "ef1283c3-1bcb-3e1b-bf2e-5877f7c0e55a",
                                        "entry_id": "ddd54a5a-ff09-3f56-b8d2-d0377b412b59",
                                        "glosses": [
                                            "Wertpapier, in dem sich der Aussteller zur Zahlung einer bestimmten Geldsumme und zu laufender Verzinsung verpflichtet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54ce89a1-82c6-47dd-b297-9ae0bce54953",
                                                "sense_id": "ef1283c3-1bcb-3e1b-bf2e-5877f7c0e55a",
                                                "text": "Mit Schuldverschreibungen kann man kaum reich werden, weil die Zinsen dieser Wertpapiere in der Regel recht niedrig sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b98d6de6-5344-4738-8583-8a2cf32dfd82",
                        "source_entry_id": "64383074-069d-3742-bac2-c99481d3f5fe",
                        "source_sense_id": "9a669256-91d9-3f43-b482-f69b1c0f82c3",
