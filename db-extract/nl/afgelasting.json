                                                "sense_id": "b981a7ff-5f66-3730-885b-91f8d394622b",
                                                "text": "„Für die Organisatoren, die Vortragenden aber auch für die Besucher dürfte die Absage der Chemnitzer Linux-Tage schmerzlich sein.“"
                                            },
                                            {
                                                "example_id": "e4ab3585-a217-4e25-ad0e-55510b4a09f6",
                                                "sense_id": "b981a7ff-5f66-3730-885b-91f8d394622b",
                                                "text": "„Für Fenerbahce wäre João Pedro der fünfte Neuzugang in der Offensive und für Galatasaray die vierte Absage in wenigen Wochen.“"
                                            }
                                        ],
