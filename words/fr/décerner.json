                    "frequency": "Low",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge d'instruction a décidé de <w>décerner</w> un mandat d'arrêt contre le suspect en fuite."
