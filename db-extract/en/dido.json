            {
                "entry_id": "11576bdb-166e-3c13-b70d-e99ecfd16750",
                "word": "dido",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "9b7106e2-3572-495b-837d-1218bf0ed798",
                        "entry_id": "11576bdb-166e-3c13-b70d-e99ecfd16750",
                        "tags": [
                            "plural"
                        ],
                        "form": "didos"
                    },
                    {
                        "form_id": "6f227964-5c9b-48a2-a235-add26da98868",
                        "entry_id": "11576bdb-166e-3c13-b70d-e99ecfd16750",
                        "tags": [
                            "plural"
                        ],
                        "form": "didoes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e08ae78e-deb9-3952-b779-b763e45dd2c5",
                        "entry_id": "11576bdb-166e-3c13-b70d-e99ecfd16750",
                        "glosses": [
                            "A fuss, a row."
                        ],
                        "tags": [
                            "regional",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "aa6116d8-a102-4f77-9a0d-9a4e3630699b",
                                "sense_id": "e08ae78e-deb9-3952-b779-b763e45dd2c5",
                                "text": "… she always had strong physical attraction for me … that time I kissed her … one reason I’ve steered clear since … take no chances on emotional didos …"
                            },
                            {
                                "example_id": "dd2dd7b4-e881-4ef1-b90f-f35dfc90db65",
                                "sense_id": "e08ae78e-deb9-3952-b779-b763e45dd2c5",
                                "text": "I remember Raymond telling me years later how when he lived at home, if his mother heard he had been seen as much as talking to a girl, she would kick up a dido."
                            }
                        ]
                    },
                    {
                        "sense_id": "713ee5ae-44af-3ec0-8587-0e120546cd86",
                        "entry_id": "11576bdb-166e-3c13-b70d-e99ecfd16750",
                        "glosses": [
                            "A shrewd trick; an antic; a caper."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e0a1a06-7c8f-46c3-81d6-9d773640bf9d",
                                "sense_id": "713ee5ae-44af-3ec0-8587-0e120546cd86",
                                "text": "Young people,\" interposed a passing official, \"if you keep a cutting didoes, I must talk to you both like a Dutch uncle."
                            },
                            {
                                "example_id": "4e274be8-ac19-491f-9958-7a421b0cc082",
                                "sense_id": "713ee5ae-44af-3ec0-8587-0e120546cd86",
                                "text": "Our youngest uncle, Billy, was not old enough to join in their didoes. One of their more flamboyant escapades has become a proud family legend."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
