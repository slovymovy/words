                ],
                "senses": [
                    {
                        "sense_id": "64b5301f-dda0-37b7-b7b1-d06461086735",
                        "entry_id": "52964d57-89ba-35d1-aa3b-db14e1539d11",
                        "glosses": [
                            "The office, authority, or district of a vicar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4a0abd1-e5c2-4ca7-9175-1e41387ddee4",
                                "sense_id": "64b5301f-dda0-37b7-b7b1-d06461086735",
                                "text": "His next was to claim, in virtue of this vicariate, the mediatorial “power in heaven and in earth”"
                            }
                        ]
                    },
                    {
                        "sense_id": "c7edb571-0d1c-3e4a-ab50-87536aed7fa7",
                        "entry_id": "52964d57-89ba-35d1-aa3b-db14e1539d11",
                        "glosses": [
                            "The office, authority, or district held by a person as deputy for a bishop, or similar ecclesiastical authority."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f54654fa-3c52-4f33-b343-de95d904a244",
                                "sense_id": "c7edb571-0d1c-3e4a-ab50-87536aed7fa7",
                                "text": "Upon ye late remove of our patriarch's vicar there hath fallen vacant a benefice annexed to ye vicariat."
                            },
                            {
                                "example_id": "27eddc3b-a01a-4c91-bc46-bf14f81fa53f",
                                "sense_id": "c7edb571-0d1c-3e4a-ab50-87536aed7fa7",
                                "text": "Vigilius gave his Vicariate to this Arch-Bishop in the Provinces."
                            },
                            {
                                "example_id": "72afeb77-7e54-4088-a901-cda6ad30737e",
                                "sense_id": "c7edb571-0d1c-3e4a-ab50-87536aed7fa7",
                                "text": "St. Charles established a vicariat, that things might be done with deliberation and counsel, which many other bishops imitated."
                            }
                        ]
                    },
                    {
                        "sense_id": "db888e98-3558-36fa-9096-1e1dd867e54c",
                        "entry_id": "52964d57-89ba-35d1-aa3b-db14e1539d11",
                        "glosses": [
                            "The office, authority, or district managed by someone appointed as deputy to a secular political leader."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfa10d82-550c-48c8-b751-45556b6c7a97",
                                "sense_id": "db888e98-3558-36fa-9096-1e1dd867e54c",
                                "text": "If he should chance to fayle, the vicariate of Upper Germany must neades fall upon the Palatin."
                            },
                            {
                                "example_id": "3fda4f3b-20ef-49f9-b38a-d837bb24a04f",
                                "sense_id": "db888e98-3558-36fa-9096-1e1dd867e54c",
                                "text": "He has accepted and taken upon him‥his part of the Vicariate of the Empire during the present Vacancy."
                            },
                            {
                                "example_id": "cd6b0c0b-0483-4578-ad33-bfa8780f2005",
                                "sense_id": "db888e98-3558-36fa-9096-1e1dd867e54c",
                                "text": "The vicariat of that part of Germany which is governed by the Saxon laws, devolved to the elector of Saxony."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18ec790b-78e2-4ec5-b53a-176a7f9302f1",
