                        "sense_id": "d0fc5610-77dc-35ab-948e-608ab2835241",
                        "entry_id": "e84a36d4-efc7-39f0-8cf0-12c2cfd3be1a",
                        "glosses": [
                            "het voorzien in de behoefte aan water, m.n. aan drinkwater"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "9405f38e-330a-4e01-85ee-91d62015346d",
                                "sense_id": "d0fc5610-77dc-35ab-948e-608ab2835241",
                                "text": "Voor de watervoorziening lag aan beide zijden van de keuken een goot voor de in- en uitwatering."
                            },
                            {
                                "example_id": "99ea3305-f85f-4c8c-ac36-ab2e466456d8",
                                "sense_id": "d0fc5610-77dc-35ab-948e-608ab2835241",
                                "text": "Everts woonde begin dit jaar nog in Tokio waar ze meehielp aan de watervoorzieningen rondom alle Olympische locaties. Een avontuurlijke baan in een dynamische stad die geen uit-knop lijkt te hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2da1675b-9fe7-4f3f-ad0c-a346479e7004",
                        "source_entry_id": "e84a36d4-efc7-39f0-8cf0-12c2cfd3be1a",
                        "source_sense_id": "d0fc5610-77dc-35ab-948e-608ab2835241",
                        "target_lang_word": "Wasserversorgung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserversorgung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "65e01033-bd53-38d9-a54c-6746c3fe6024",
                                        "entry_id": "616b1342-0ea6-34e6-8bad-affe583e9af4",
                                        "glosses": [
                                            "die Bereitstellung des notwendigen Trinkwassers und Nutzwassers einschließlich des Sammeln, Hebens, Reinigens, Speicherns und Zuleitens von Trink- und Nutzwasser"
                                        ],
                                        "tags": [
                                            "öffentliche Versorgung und Infrastruktur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff7feab4-012f-4ba6-8533-b1d869494acc",
                                                "sense_id": "65e01033-bd53-38d9-a54c-6746c3fe6024",
                                                "text": "„Die Wasserversorgung an diesem Orte war sehr romantisch: Man holte das Wasser weder aus einem Brunnen noch aus einer Pumpe, sondern aus einer Quelle unterhalb des Hauses, unmittelbar am Elbufer.“"
                                            },
                                            {
                                                "example_id": "f5acd181-54cc-4e17-bbc4-5898bd3409ae",
                                                "sense_id": "65e01033-bd53-38d9-a54c-6746c3fe6024",
                                                "text": "„Die Sicherung der Wasserversorgung, die Bereitstellung von Trinkwasser ist in Kibera in vielen Fällen ein mafiöses Geschäft.“"
                                            },
                                            {
                                                "example_id": "e924e89d-a465-42f0-a569-1ec9eefcd323",
                                                "sense_id": "65e01033-bd53-38d9-a54c-6746c3fe6024",
                                                "text": "„Zusätzliche Mauern gliederten eine Quelle in die Stadt ein und garantierten damit ihre Wasserversorgung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
