                ],
                "senses": [
                    {
                        "sense_id": "1ccc890b-a91e-3d31-a597-25800af9ace2",
                        "entry_id": "7c587c42-a832-31f1-a6cf-16ea29846c4c",
                        "glosses": [
                            "Qui concerne la juridiction du prévôt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d94a73b-0123-4c5a-958d-5e57baf3070f",
                                "sense_id": "1ccc890b-a91e-3d31-a597-25800af9ace2",
                                "text": "Comment, au retour des princes légitimes, n’avait-on pas traduit cet homme-là devant une cour prévôtale ?"
                            },
                            {
                                "example_id": "2618ce47-2c5b-4a8b-b539-dc0968ff60ab",
                                "sense_id": "1ccc890b-a91e-3d31-a597-25800af9ace2",
                                "text": "Il s'était formé à cette époque non pas des tribunaux — la justice se respectait, elle n’ordonne pas l’assassinat des innocents, — mais des cours prévôtales."
                            }
                        ]
                    },
                    {
                        "sense_id": "76405318-4255-3cb9-bc3f-92bf73517e46",
                        "entry_id": "7c587c42-a832-31f1-a6cf-16ea29846c4c",
                        "glosses": [
                            "Relatif à la police générale des armées."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "f6c81061-1095-444e-9c32-a1b8ab16eeae",
                                "sense_id": "76405318-4255-3cb9-bc3f-92bf73517e46",
                                "text": "On institua des cours prévôtales ayant droit de traduire à leur barre tous les citoyens, et dont les arrêts étaient exécutoires dans les vingt-quatre heures."
                            },
                            {
                                "example_id": "5bb26327-5633-4336-8481-27b0a9d73e9d",
                                "sense_id": "76405318-4255-3cb9-bc3f-92bf73517e46",
                                "text": "La justice militaire est rendue au nom du peuple français sous le contrôle de la Cour de cassation :\n3° Lorsqu'ils sont établis dans les conditions prévues par le présent code, par les tribunaux prévôtaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "7528fe4e-c4e4-3827-a37e-865ebbc1156b",
                        "entry_id": "7c587c42-a832-31f1-a6cf-16ea29846c4c",
                        "glosses": [
                            "Qui est sans appel"
