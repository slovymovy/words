{
    "word_family": [
        "viscous",
        "viscously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fdafc38e-8585-3d6e-b298-95185250412b",
                    "sense_definition": "The state of being thick, sticky, and semi-fluid in consistency.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>viscosity</w> of the honey makes it pour very slowly from the jar.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>вязкости</w> мёд очень медленно вытекает из банки."
                            }
                        },
                        {
                            "text": "Engine oil must maintain a certain <w>viscosity</w> to protect the moving parts of the motor.",
                            "target_lang_translations": {
                                "ru": "Моторное масло должно сохранять определённую <w>вязкость</w>, чтобы защищать движущиеся детали двигателя."
                            }
                        }
                    ],
                    "synonyms": [
                        "viscousness"
                    ],
                    "antonyms": [
                        "runniness",
                        "wateriness",
                        "thinness"
                    ],
                    "common_phrases": [
                        "high viscosity",
                        "low viscosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Свойство или состояние густого, липкого и полужидкого вещества; густота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вязкость",
                                "target_lang_sense_clarification": "свойство полужидкого вещества"
                            },
                            {
                                "target_lang_word": "густота",
                                "target_lang_sense_clarification": "консистенция жидкости или массы"
                            },
                            {
                                "target_lang_word": "тягучесть",
                                "target_lang_sense_clarification": "способность тянуться, липкая густота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c1ebf5d6-7f9d-35ac-8622-b4f2dc589779",
                    "sense_definition": "A scientific measure of a fluid's resistance to flow or internal friction.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Engineers calculated the <w>viscosity</w> of the lubricant to ensure it would function under extreme heat.",
                            "target_lang_translations": {
                                "ru": "Инженеры рассчитали <w>вязкость</w> смазочного материала, чтобы убедиться, что он сможет работать при экстремально высоких температурах."
                            }
                        },
                        {
                            "text": "The experiment measured the <w>viscosity</w> of various oils at different temperatures.",
                            "target_lang_translations": {
                                "ru": "В ходе эксперимента измерялась <w>вязкость</w> различных масел при разных температурах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dynamic viscosity",
                        "kinematic viscosity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физическая величина, характеризующая сопротивление текучей среды течению или её внутреннее трение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вязкость",
                                "target_lang_sense_clarification": "физический параметр внутреннего трения"
                            },
                            {
                                "target_lang_word": "коэффициент вязкости",
                                "target_lang_sense_clarification": "количественная мера в физике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "89db3a70-7665-3dbe-bfac-3bdccb378dd3",
                    "sense_definition": "A tendency to prolong interpersonal encounters or social interactions.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His social <w>viscosity</w> made it difficult for guests to leave the party early.",
                            "target_lang_translations": {
                                "ru": "Его социальная <w>навязчивость</w> мешала гостям уйти с вечеринки пораньше."
                            }
                        },
                        {
                            "text": "The host's <w>viscosity</w> ensured that every conversation lasted much longer than necessary.",
                            "target_lang_translations": {
                                "ru": "Из-за <w>прилипчивости</w> хозяина каждый разговор длился гораздо дольше, чем следовало."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонность затягивать общение или социальные взаимодействия; навязчивость, прилипчивость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вязкость",
                                "target_lang_sense_clarification": "в общении или поведении"
                            },
                            {
                                "target_lang_word": "навязчивость",
                                "target_lang_sense_clarification": "надоедливое затягивание контактов"
                            },
                            {
                                "target_lang_word": "прилипчивость",
                                "target_lang_sense_clarification": "нежелание отпускать собеседника"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}