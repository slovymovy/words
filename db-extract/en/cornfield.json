                    {
                        "translation_id": "062f9129-a0d1-40f9-858c-aa17676ab808",
                        "source_entry_id": "9f13bd0e-0ea5-3e13-8916-dba947b39294",
                        "source_sense_description": "a field of corn",
                        "target_lang_word": "Kornfeld",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kornfeld",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3ad60c7f-686a-3ca0-a84f-713605a73de6",
                                        "entry_id": "9d2cc310-4ba9-3ac5-9fd9-be3f283ff7d7",
                                        "glosses": [
                                            "ein Feld, auf dem Getreide angebaut wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65546cd6-e67a-4589-bbf6-a316b7deedeb",
                                                "sense_id": "3ad60c7f-686a-3ca0-a84f-713605a73de6",
                                                "text": "„Es waren keine Kornfelder zu sehen, keine Anzeichen bestellten Bodens, nur Weiden und Wälder, die ihre verschiedenen Grüntöne zur Schau stellten.“"
                                            },
                                            {
                                                "example_id": "4a3e8c80-52cc-467a-bd1a-5841d3c96455",
                                                "sense_id": "3ad60c7f-686a-3ca0-a84f-713605a73de6",
                                                "text": "„Im Kornfeld wären sie unsichtbar,aber auch leicht zu überraschen.“"
                                            },
                                            {
                                                "example_id": "002f9c36-698e-4df1-b657-16094f620aa9",
                                                "sense_id": "3ad60c7f-686a-3ca0-a84f-713605a73de6",
                                                "text": "„Nach links zu wurde es ebener, hier zogen sich Kornfelder hin, und dann kam ein verbranntes, noch rauchendes Dorf, Semeonowskoje.“"
                                            },
                                            {
                                                "example_id": "bfb723b0-01ce-477f-8fbd-d68ff11f3926",
                                                "sense_id": "3ad60c7f-686a-3ca0-a84f-713605a73de6",
                                                "text": "„Nur die Brise vom Dorf und Fluß her wuchs, und die Kornfelder neigten sich und mit ihnen der rote Mohn, der in ganzen Büscheln zwischen den Halmen stand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b714a87c-03b0-4a74-b276-e74964bfcf5c",
