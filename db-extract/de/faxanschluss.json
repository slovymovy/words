                "senses": [
                    {
                        "sense_id": "0c868f18-3812-3253-8d64-5e125b204027",
                        "entry_id": "3bb6316d-7b05-3ca9-b187-b0740b3eb177",
                        "glosses": [
                            "von einem Netzbetreiber einem Teilnehmer bereitgestellte Infrastruktur zum Betrieb eines Faxgeräts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28fdce0d-d010-4db7-92d9-7367a531d01a",
                                "sense_id": "0c868f18-3812-3253-8d64-5e125b204027",
                                "text": "„Zur Glaubhaftmachung hat der Kläger acht Faxprotokolle vorgelegt, aus denen sich überwiegend ergibt, dass der Faxanschluss des Berufungsgerichts besetzt war.“"
                            },
                            {
                                "example_id": "ac17f6a9-f121-4bd8-8533-e4875ba5a8b7",
                                "sense_id": "0c868f18-3812-3253-8d64-5e125b204027",
                                "text": "„In Simmerath gibt es im Rathaus insgesamt 86 Nebenstellen mit Telefon- oder Faxanschluss.“"
                            },
                            {
                                "example_id": "b46caa6f-16e9-4bbb-96b4-238d87910683",
                                "sense_id": "0c868f18-3812-3253-8d64-5e125b204027",
                                "text": "„Zugleich signalisiert der Kunde, dass sein Faxanschluss noch existiert. “"
                            }
                        ],
