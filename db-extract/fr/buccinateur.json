                    {
                        "sense_id": "49e18bc5-adb2-3451-88f3-c56472c3ab0e",
                        "entry_id": "f9f46114-b153-3888-aae8-c81ee7c8bb55",
                        "glosses": [
                            "Muscle buccinateur."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "5c11e928-189e-4c2f-8a36-bae8978585af",
                                "sense_id": "49e18bc5-adb2-3451-88f3-c56472c3ab0e",
                                "text": "Et, prenant une des pièces sur la table : – Qu’est-ce que c’est ? – Le buccinateur, répondit Bouvard."
                            },
                            {
                                "example_id": "7857eb23-10a9-4dd2-acf8-82f6219fe83f",
                                "sense_id": "49e18bc5-adb2-3451-88f3-c56472c3ab0e",
                                "text": "Les insertions fixes, ostéo-fibreuses du buccinateur présentent dans leur ensemble la forme d’un fer à cheval à ouverture antérieure."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "613dea1c-884c-4c21-92c0-7b98acc9329f",
                        "source_entry_id": "f9f46114-b153-3888-aae8-c81ee7c8bb55",
                        "source_sense_id": "49e18bc5-adb2-3451-88f3-c56472c3ab0e",
                        "target_lang_word": "buccinator",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "buccinator",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30dcce83-2928-39e0-8143-18e01dc03a17",
                                        "entry_id": "63730a22-1a95-3f76-a175-3ae0868ddc31",
                                        "glosses": [
                                            "A thin broad muscle forming the wall of the cheek."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea3abdb9-d9a3-4d99-b988-303c367cb36b",
                                                "sense_id": "30dcce83-2928-39e0-8143-18e01dc03a17",
                                                "text": "Until now there has been no definitive anatomical study describing the area where the parotid duct enters the buccinator muscle."
                                            },
                                            {
                                                "example_id": "affa7d4c-9d75-437f-849f-69af14b31639",
                                                "sense_id": "30dcce83-2928-39e0-8143-18e01dc03a17",
                                                "text": "What a language it is, with all the organs of speech in loud concert - tongue, teeth, and tonsils, lips and larynx, buccinator and schnozzola!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
