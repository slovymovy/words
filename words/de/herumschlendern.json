                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An einem sonnigen Nachmittag <w>schlenderten</w> die Touristen gemütlich durch die Altstadt <w>herum</w>.",
                            "target_lang_translations": {
                                "en": "On a sunny afternoon, the tourists <w>strolled around</w> leisurely through the old town.",
                                "ru": "Солнечным днем туристы не спеша <w>прогуливались</w> по Старому городу."
                            }
                        },
                        {
                            "text": "Wir hatten noch Zeit vor der Abfahrt und wollten einfach ein wenig auf dem Markt <w>herumschlendern</w>.",
                            "target_lang_translations": {
                                "en": "We still had time before departure and just wanted to <w>wander around</w> the market a bit.",
                                "ru": "До отъезда у нас еще оставалось время, и мы просто хотели немного <w>побродить</w> по рынку."
                            }
                        }
                    ],
                    "synonyms": [
                        "umherschlendern"
                    ],
                    "common_phrases": [
                        "in der Stadt herumschlendern",
                        "ziellos herumschlendern",
                        "im Park herumschlendern",
                        "gemütlich herumschlendern"
                    ],
                    "target_lang_definitions": {
