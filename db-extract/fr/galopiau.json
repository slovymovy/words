                        ],
                        "examples": [
                            {
                                "example_id": "4d760b44-a2bf-4f08-b733-ac6143fddc36",
                                "sense_id": "8fc45658-07a2-3935-bcb4-0cfec621eb81",
                                "text": "Quelques galopiaux à Aix s'amusaient à cribler de boules de neige des passants inoffensifs. J'étais de ceux-ci et ne savais que faire."
                            },
                            {
                                "example_id": "e47279f5-4256-4f20-8b0f-cd3ec56c87dd",
                                "sense_id": "8fc45658-07a2-3935-bcb4-0cfec621eb81",
                                "text": "Des paroles comme ça, ça fait frémir le pire galopiau, d'autant que c'était pas mon propos même si la gênance du côté de l'âme s'était guère atténuée devant sa mélancolie."
                            }
                        ]
                    }
