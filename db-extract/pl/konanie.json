                                    {
                                        "sense_id": "5d849071-5129-3b35-be02-f01fd0bea9e1",
                                        "entry_id": "383a9825-87b9-3fde-b682-39b8a3de85b8",
                                        "glosses": [
                                            "cessazione della vita di un uomo, animale o pianta, che permette a una generazione di essere sostituita dalla successiva"
                                        ],
                                        "tags": [
                                            "diritto"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0da33801-9e55-4a8a-af10-d5963208b5ec",
                                                "sense_id": "5d849071-5129-3b35-be02-f01fd0bea9e1",
                                                "text": "morte biologica"
                                            },
                                            {
                                                "example_id": "e4921eef-040e-465c-b70d-e77dd33b6ba2",
                                                "sense_id": "5d849071-5129-3b35-be02-f01fd0bea9e1",
                                                "text": "morte clinica, morte apparente: si verifica quando l'organismo di un uomo non è irreversibilmente danneggiato e può essere sottoposto a rianimazione"
                                            },
                                            {
                                                "example_id": "d1589ccd-e0e8-4a8a-8a2e-619e211a5751",
                                                "sense_id": "5d849071-5129-3b35-be02-f01fd0bea9e1",
                                                "text": "morte improvvisa"
                                            },
                                            {
                                                "example_id": "72311985-b8ec-4a03-a8b3-f7a7faf1ec3e",
                                                "sense_id": "5d849071-5129-3b35-be02-f01fd0bea9e1",
                                                "text": "morte istantanea: come la morte improvvisa, ma che avviene in un tempo quantificabile in pochi secondi dal presentarsi dei primi sintomi"
                                            },
                                            {
                                                "example_id": "796a70a7-ce4a-424e-98aa-361e934484c0",
                                                "sense_id": "5d849071-5129-3b35-be02-f01fd0bea9e1",
