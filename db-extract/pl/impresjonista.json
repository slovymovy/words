                "senses": [
                    {
                        "sense_id": "f4b005bd-9e1c-354a-a63a-ba6970e2320e",
                        "entry_id": "813a2c4e-9d49-3fa0-bf1d-d23cb2455113",
                        "glosses": [
                            "przedstawiciel impresjonizmu, osoba tworząca w duchu impresjonizmu, tj. utrwalająca w swoich utworach własne, subiektywne oraz często ulotne wrażenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cd103c7-f4a5-4208-b985-be7566106714",
                                "sense_id": "f4b005bd-9e1c-354a-a63a-ba6970e2320e",
                                "text": "Polscy impresjoniści związani byli przede wszystkim z Krakowem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c8e4771-1b81-4ac0-b08a-dbda0bd140c2",
                        "source_entry_id": "813a2c4e-9d49-3fa0-bf1d-d23cb2455113",
                        "source_sense_id": "f4b005bd-9e1c-354a-a63a-ba6970e2320e",
                        "target_lang_word": "impressionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impressionist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b8fc3bd-057f-3cdb-abfe-9dbc376e9d53",
                                        "entry_id": "99e68ec1-a4c3-3ab6-a3ac-6979539dc462",
                                        "glosses": [
                                            "One who adheres to the theory or method of impressionism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "874dd950-36c4-3129-bb24-142f0e359f95",
                                        "entry_id": "99e68ec1-a4c3-3ab6-a3ac-6979539dc462",
                                        "glosses": [
                                            "A performer who does impressions; a mimic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "939c1de7-adeb-457d-94ab-0c54d6d15118",
                                                "sense_id": "874dd950-36c4-3129-bb24-142f0e359f95",
                                                "text": "When impressionists (and especially lazy impressionists) delivered their comedic interpretation of [Bill] Clinton, the phrase they always used was “I feel your pain,” expressed with a sympathetic Southern drawl."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ed91a20-1bba-4ec7-a1e1-efc8ee9adaa4",
                        "source_entry_id": "813a2c4e-9d49-3fa0-bf1d-d23cb2455113",
                        "source_sense_id": "f4b005bd-9e1c-354a-a63a-ba6970e2320e",
                        "target_lang_word": "impresionista",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a26c0256-d2a4-4de3-9a9e-d5313f9c0bef",
                        "source_entry_id": "813a2c4e-9d49-3fa0-bf1d-d23cb2455113",
                        "source_sense_id": "f4b005bd-9e1c-354a-a63a-ba6970e2320e",
                        "target_lang_word": "impressionniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "impressionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f69169fb-597b-3588-b19a-05a89eb608ca",
                                        "entry_id": "e68692e8-73ac-3126-bd9e-8276e67d8c11",
                                        "glosses": [
                                            "Relatif à l’impressionnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a592819-d0c1-45e3-95f9-83e239393023",
                                                "sense_id": "f69169fb-597b-3588-b19a-05a89eb608ca",
                                                "text": "A cette date, le public amateur d'art a commencé à comprendre les toiles impressionnistes qui, auparavant, lui apparaissaient comme des « barbouillages » tant leur facture inachevée et imprécise, destinée à rendre les variations de la lumière, les rendaient « irregardables »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be655ca8-0e7f-32c3-848a-173d0eb79136",
                                        "entry_id": "e68692e8-73ac-3126-bd9e-8276e67d8c11",
                                        "glosses": [
                                            "Qui ne se fonde que sur l’impression, le ressenti personnel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "322ceb82-669b-42cb-813f-52bca5f8fc0b",
                                                "sense_id": "be655ca8-0e7f-32c3-848a-173d0eb79136",
                                                "text": "La critique impressionniste jette son plus bel éclat avec Jules Lemaître, aux Débats, de 1885 à 1895."
                                            },
                                            {
                                                "example_id": "ba783fe6-10b2-44e2-8c73-d796939296e5",
                                                "sense_id": "be655ca8-0e7f-32c3-848a-173d0eb79136",
                                                "text": "L’impressionnisme et le dogmatisme ne s’opposent pas sur le problème essentiel de l’existence des valeurs esthétiques ; mais seulement sur la question de leur généralisation. Toutes les deux jugent ; mais pour le critique impressionniste, ces jugements ou ces valeurs sont purement personnels."
                                            },
                                            {
                                                "example_id": "c643b151-8da9-4f8c-a4bc-f6f4315de316",
                                                "sense_id": "be655ca8-0e7f-32c3-848a-173d0eb79136",
                                                "text": "Pas d’enquête ni d’exploration systématique donc, mais un journal, forme qui correspond le plus à mon tempérament, porté à la capture impressionniste des choses et des gens, des atmosphères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a715628-17e2-3fe7-9479-e1c63d18f0fb",
                                        "entry_id": "e68692e8-73ac-3126-bd9e-8276e67d8c11",
                                        "glosses": [
                                            "Qui n’est pas rigoureux, intuitif, subjectif."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c7c177e-6379-4779-99ad-9d33f2163615",
                                                "sense_id": "9a715628-17e2-3fe7-9479-e1c63d18f0fb",
                                                "text": "Nous nous sommes permis de contester […] l’exploitation impressionniste de tels documents pris isolément."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "impressionniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                                        "entry_id": "0fef4dc6-525b-3166-8d87-7708651f8cd1",
                                        "glosses": [
                                            "Peintre de la fin du XIXᵉ siècle qui suit les préceptes de l’impressionnisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30bea6ad-c066-4815-8a73-ac0417a7999f",
                                                "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                                                "text": "Mais il la peint comme un impressionniste : avec des tons gris et des reflets luisants, il a recréé l’ambiance de la ville sous la pluie."
                                            },
                                            {
                                                "example_id": "99a30e59-7000-4e51-ad79-a2c52d9787d1",
                                                "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                                                "text": "Que sa dénomination dérive d’un nom commun ou d’un nom propre, l’adepte ne prend jamais de majuscule initiale. L’adhérent, le disciple, le fidèle, le membre pas davantage. Toutes les catégories sont concernées (religion, philosophie, littérature, arts, politique, etc.) : un anglican, sept bouddhistes, trois catholiques, un dadaïste, deux existentialistes, un gnostique, un hindou, deux impressionnistes, trois jansénistes, quelques kharidjites, soixante laxistes, trois marxistes, quatre nudistes, deux oulipistes, dix presbytériennes, un quiétiste, un rexiste, des saint-simoniens, deux trotskistes, dix ultras, une voltairienne, un wahhabite, un zoroastrien."
                                            },
                                            {
                                                "example_id": "c23e120b-d9ad-4a68-8cd9-5c4218e4759d",
                                                "sense_id": "e2d14066-494a-301d-a1b9-ea92111aca6b",
                                                "text": "Les impressionnistes, qui se veulent réalistes, choisissent leurs sujets dans la vie contemporaine, dans un quotidien librement interprété selon la vision personnelle de chacun d'eux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98861b56-6057-4d29-8cba-e5e37fd63c1b",
                        "source_entry_id": "813a2c4e-9d49-3fa0-bf1d-d23cb2455113",
                        "source_sense_id": "f4b005bd-9e1c-354a-a63a-ba6970e2320e",
                        "target_lang_word": "Impressionist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Impressionist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                        "entry_id": "4ce167b2-d6aa-3452-9186-01222474a475",
                                        "glosses": [
                                            "ein Vertreter der Stilrichtung des Impressionismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d736292-e01e-48fb-9ea2-bfb33b159278",
                                                "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                                "text": "Einer der bekanntesten Impressionisten war Claude Monet."
                                            },
                                            {
                                                "example_id": "1671f174-512d-4eb6-8a58-b3c98a245b0a",
                                                "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                                "text": "„Um 1900 waren die Impressionisten noch umstritten, van Gogh wurde gerade erst entdeckt, Cézanne begann sich durchzusetzen.“"
                                            },
                                            {
                                                "example_id": "04bfd171-63b5-4d9e-8840-3a954a536d30",
                                                "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                                "text": "„Er kannte Degas und die französischen Impressionisten gut, und er wusste, dass ihre Bilder Millionen wert waren.“"
                                            },
                                            {
                                                "example_id": "3aca2bd9-ed41-42be-99c2-8d65750cb3c8",
                                                "sense_id": "1307b339-0c23-3948-b7db-578fcc4a6e42",
                                                "text": "„Vor den Bildern der Impressionisten fand ich Paris und die Landschaften Frankreichs wieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
