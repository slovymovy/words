                                                "sense_id": "e60a3ba1-0ea0-3473-9bc3-de051584cb41",
                                                "text": "He spoke with a slurry voice."
                                            },
                                            {
                                                "example_id": "30142932-73f0-41d1-a330-be6f960a8b90",
