                ],
                "senses": [
                    {
                        "sense_id": "ddaf2c71-2ae8-3ad4-b557-61c185400895",
                        "entry_id": "2729b38d-9946-33a8-bc53-6ce68f97ce37",
                        "glosses": [
                            "niet helder of zeker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "105454f9-da25-4421-ab4a-1f5a6bf661a6",
                                "sense_id": "ddaf2c71-2ae8-3ad4-b557-61c185400895",
                                "text": "Daarmee is de toekomst nog onduidelijker geworden."
                            },
                            {
                                "example_id": "6dd49a98-51fa-4dca-af72-a18447f3d86e",
                                "sense_id": "ddaf2c71-2ae8-3ad4-b557-61c185400895",
                                "text": "Wat er waar van was bleef onduidelijk aangezien hij zelden sprak."
                            },
                            {
                                "example_id": "09b77dd3-6002-4a1f-9cfe-7fe7a4b47f2b",
                                "sense_id": "ddaf2c71-2ae8-3ad4-b557-61c185400895",
                                "text": "Hoe het fout kon gaan, is nog onduidelijk. De gemeente gaat met de aannemer op zoek naar een oplossing. \"Er moet zo snel mogelijk een gebouw komen dat naar wens is van de school en waar we veertig jaar mee vooruit kunnen\", stelt Reijnierse. \"Eind volgende week moet duidelijk zijn wat de oplossing gaat zijn.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5e3782b0-35bf-3238-958a-4eef4b4ec2ba",
                        "entry_id": "2729b38d-9946-33a8-bc53-6ce68f97ce37",
                        "glosses": [
                            "niet goed zichtbaar en/of identificeerbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb1f6d86-6e96-475c-a439-4028a36b1135",
                                "sense_id": "5e3782b0-35bf-3238-958a-4eef4b4ec2ba",
                                "text": "De afbeelding is onduidelijk."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "18330513-8472-4efe-860b-d43af3fbc8b8",
                        "source_entry_id": "2729b38d-9946-33a8-bc53-6ce68f97ce37",
                        "source_sense_id": "ddaf2c71-2ae8-3ad4-b557-61c185400895",
                        "source_sense_description": "niet helder of zeker",
                        "target_lang_word": "unclear",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unclear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0587b687-6e19-36f8-986b-2ba1dd6ca8d0",
                                        "entry_id": "3eeed186-d26d-35c9-b6b5-48ef5c36a2f2",
                                        "glosses": [
                                            "Ambiguous; liable to more than one interpretation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a69614-b294-434c-8eb7-baa1db7d2be1",
                                                "sense_id": "0587b687-6e19-36f8-986b-2ba1dd6ca8d0",
                                                "text": "The remark she made comparing her life with that of a fish was unclear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bbdeab03-3e06-3ed8-a685-faa2218beaf4",
                                        "entry_id": "3eeed186-d26d-35c9-b6b5-48ef5c36a2f2",
                                        "glosses": [
                                            "Not clearly or explicitly defined."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dac27a9f-8e7c-3832-a935-753c48fba69f",
                                        "entry_id": "3eeed186-d26d-35c9-b6b5-48ef5c36a2f2",
                                        "glosses": [
                                            "Not easy to see or read; indecipherable or unreadable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ea3a3f0-105c-4a9a-8b23-09f724e84cc3",
                                                "sense_id": "dac27a9f-8e7c-3832-a935-753c48fba69f",
                                                "text": "From such a long distance away, the name on the signpost was unclear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a511164-0eb6-30e4-b312-21788428194d",
                                        "entry_id": "3eeed186-d26d-35c9-b6b5-48ef5c36a2f2",
                                        "glosses": [
                                            "Not having a clear idea; uncertain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "faaaa58a-166b-4ea0-813a-350b11c1a4d0",
                                                "sense_id": "2a511164-0eb6-30e4-b312-21788428194d",
                                                "text": "I'm still unclear about what she meant by that remark."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unclear",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ae3ecfd-35c0-355c-9009-b0d8acf37be4",
                                        "entry_id": "0ed8c079-7571-38a8-94d3-bb24bcad9575",
                                        "glosses": [
                                            "To undo the process of clearing."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "890b2dc4-d3bd-4ae6-8280-13b1b151bce5",
                                                "sense_id": "2ae3ecfd-35c0-355c-9009-b0d8acf37be4",
                                                "text": "Clearing, unclearing and deleting activities"
                                            },
                                            {
                                                "example_id": "82462e08-4cc2-49d5-82b0-4a7fe05fa389",
                                                "sense_id": "2ae3ecfd-35c0-355c-9009-b0d8acf37be4",
                                                "text": "[…] finally [the block] would be cleared and remain that way until moved. Although this clearing and unclearing can occur repeatedly, the current BAGGER algorithm is unable to generalize number within unwindable subproofs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0388d683-48e1-4078-9e70-bc3716300208",
                        "source_entry_id": "2729b38d-9946-33a8-bc53-6ce68f97ce37",
                        "source_sense_id": "ddaf2c71-2ae8-3ad4-b557-61c185400895",
                        "source_sense_description": "niet helder of zeker",
                        "target_lang_word": "precarious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "precarious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95529245-de0d-3578-97a9-c968c58c8f5f",
                                        "entry_id": "dd97e961-b3cf-37a7-9c50-ccfe5e1b79e3",
                                        "glosses": [
                                            "Dangerously insecure or unstable; perilous."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae999bf3-3dfe-4e8d-9c00-30827ab51119",
                                                "sense_id": "95529245-de0d-3578-97a9-c968c58c8f5f",
                                                "text": "One morning I had been driven to the precarious refuge afforded by the steps of the inn, after rejecting offers from the Celebrity to join him in a variety of amusements. But even here I was not free from interruption, for he was seated on a horse-block below me, playing with a fox terrier."
                                            },
                                            {
                                                "example_id": "d71d03cc-2c5f-47ad-9f72-73ad99ab87f9",
                                                "sense_id": "95529245-de0d-3578-97a9-c968c58c8f5f",
                                                "text": "Never had he been so fond of this body of his as now when his tenure of it was so precarious."
                                            },
                                            {
                                                "example_id": "345262c4-19ff-4c49-af55-cea800155e71",
                                                "sense_id": "95529245-de0d-3578-97a9-c968c58c8f5f",
                                                "text": "The existence of Jewish partisans was precarious. They lived from hand to mouth, stealing when necessary, arranging secret deliveries of food, and spending hours and even days in holes in the ground when danger threatened."
                                            },
                                            {
                                                "example_id": "6b2c141a-14a6-49ce-83e3-c4b00c7d853a",
                                                "sense_id": "95529245-de0d-3578-97a9-c968c58c8f5f",
                                                "text": "One can't escape the huge nuclear facility at Sellafield (supplier of much of the line's remaining freight traffic), or miss the wild shingle beaches with exposed and precarious bungalows sandwiched between the railway and the shore at Braystones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4bdf6813-4d72-3170-b12c-149ed6ee2353",
                                        "entry_id": "dd97e961-b3cf-37a7-9c50-ccfe5e1b79e3",
                                        "glosses": [
                                            "Depending on the intention of another."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
