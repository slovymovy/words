                                "target_word": "zijbalk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "12511e2a-721f-3dfe-b3e7-a840118a3853",
                                        "entry_id": "0cdacd29-a563-3af3-bccf-52e87340adbd",
                                        "glosses": [
                                            "een vertikale kolom aan de linker- of rechterkant van een computervenster"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afa4e7d-4ef7-44c0-ba74-7967a53abde9",
                                                "sense_id": "12511e2a-721f-3dfe-b3e7-a840118a3853",
                                                "text": "Door de problemen zien gebruikers een zwart scherm wanneer ze zijn ingelogd. De desktop, taakbalken, zijbalken en systeemvakken zijn verdwenen. Volgens Microsoft zouden de problemen zijn ontstaan door de laatste veiligheidsupdate, die op 25 november is vrijgegeven."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33e625a2-6786-3f32-9b38-ac53263fcbd8",
                                        "entry_id": "0cdacd29-a563-3af3-bccf-52e87340adbd",
                                        "glosses": [
                                            "een balk die aan de zijkant van een constructie loopt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edf18575-4e36-4f9e-8553-475c6d294ff9",
                                                "sense_id": "33e625a2-6786-3f32-9b38-ac53263fcbd8",
                                                "text": "Op het gebied van entertainment heeft de C-Klasse een zogenoemde Frontbass-systeem dat via de ruimten in de dwarsbalken en zijbalken van de koets een bass-achtige toon creëert. Maar voor de echte muziekliefhebbers is er het optionele Burmester-geluidssysteem. Je kunt de muziek onder meer afspelen via Bluetooth, smartphones, een SD-kaart, USB-stick of via een CD/DVD."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
