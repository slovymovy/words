                ],
                "translations": [
                    {
                        "translation_id": "3fc26ca3-fa18-4423-a680-caddb58e6f1b",
                        "source_entry_id": "ec09577d-f11c-3597-b025-d802519ae460",
                        "source_sense_id": "7b965b42-5c36-3f0d-a949-5e2c5079452e",
                        "source_sense_description": "dans",
                        "target_lang_word": "Walzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Walzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df606c7f-9f95-3b09-b4bb-0999b3093e12",
                                        "entry_id": "ece26ea8-f27e-37c5-b8d5-b5260ec9746a",
                                        "glosses": [
                                            "Drehtanz im Dreivierteltakt (Oberbegriff für den Wiener und den Langsamen Walzer)"
                                        ],
                                        "tags": [
                                            "Tanz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "829461cc-b91c-4178-8b7f-2b6b4f441fe4",
                                                "sense_id": "df606c7f-9f95-3b09-b4bb-0999b3093e12",
                                                "text": "„Der Walzer war zunächst wegen Unzüchtigkeit, z. B. weil die Fußknöchel der Damen sichtbar waren, aber vor allem wegen der ständigen Berührung der Paare, verpönt.“ (aus: Wikipedia: Wiener Walzer)"
                                            },
                                            {
                                                "example_id": "f67ed2a5-f2eb-48de-9b64-000352ac66fb",
                                                "sense_id": "df606c7f-9f95-3b09-b4bb-0999b3093e12",
                                                "text": "Das Brautpaar eröffnete den Ball mit einem Walzer."
                                            },
                                            {
                                                "example_id": "140495de-45c6-4d44-9859-7fa57798c8b5",
                                                "sense_id": "df606c7f-9f95-3b09-b4bb-0999b3093e12",
                                                "text": "„Und nun kamen vom Orchester, zunächst noch zögernd und behutsam, aber doch schon deutlich die rhythmisch mitreissenden Klänge eines Walzers.“"
                                            },
                                            {
                                                "example_id": "1aeae130-515a-4ee7-b575-427f22790a4d",
                                                "sense_id": "df606c7f-9f95-3b09-b4bb-0999b3093e12",
                                                "text": "„Brutale Burschen, von denen sie sich vor zwei Jahren allenfalls zu einem Walzer hätte auffordern lassen, hatten sie allzu rasch mit der Wirklichkeit bekannt gemacht, die sich hinter Liebeserklärungen zu verbergen pflegt.“"
                                            },
                                            {
                                                "example_id": "87b4dee0-9b1e-49b1-98f7-3903acfa0659",
                                                "sense_id": "df606c7f-9f95-3b09-b4bb-0999b3093e12",
                                                "text": "„Eduard tänzelt um Gerda herum wie ein Mittelschullehrer, der Walzer übt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "07998027-db14-3699-b8f1-3fa0325c27df",
                                        "entry_id": "ece26ea8-f27e-37c5-b8d5-b5260ec9746a",
                                        "glosses": [
                                            "Musikstück im Dreivierteltakt"
                                        ],
                                        "tags": [
                                            "Musik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "861afb5b-2e53-4289-b2d3-af33e50bf665",
                                                "sense_id": "07998027-db14-3699-b8f1-3fa0325c27df",
                                                "text": "„Wiener Praterleben“ ist ein von Siegfried Translateur im Jahr 1892 komponierter Walzer, der in den 1920er Jahren in Berlin auch unter dem Namen „Sportpalastwalzer“ populär wurde."
                                            },
                                            {
                                                "example_id": "df290f00-fff5-4549-95bd-db8a42f2ec10",
                                                "sense_id": "07998027-db14-3699-b8f1-3fa0325c27df",
                                                "text": "„Das Orchester spielte ein Potpourri von Mazurkas, Quadrillen und Walzern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4059c53b-02ee-331f-8b64-f41133152097",
                                        "entry_id": "ece26ea8-f27e-37c5-b8d5-b5260ec9746a",
                                        "glosses": [
                                            "Beruf in der stahlverarbeitenden Industrie"
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cf98652-89bd-441b-a65f-ee153efe3bfa",
                                                "sense_id": "4059c53b-02ee-331f-8b64-f41133152097",
                                                "text": "Im Walzwerk überwacht der Walzer die Walze, die Stahlbarren in Stahlbleche walzt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "af05a7df-b6c0-4363-8d32-f1d9e5aacb51",
                        "source_entry_id": "ec09577d-f11c-3597-b025-d802519ae460",
                        "source_sense_id": "7b965b42-5c36-3f0d-a949-5e2c5079452e",
                        "source_sense_description": "dans",
                        "target_lang_word": "waltz",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "waltz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bdbe7b7b-5015-3983-96be-f9675a304042",
                                        "entry_id": "9c4f7c66-ecf6-3d0d-92f7-0d29eac4cdce",
                                        "glosses": [
                                            "A ballroom dance in 3/4 time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38b66d14-e59b-4b59-a20d-f5db599ee846",
                                                "sense_id": "bdbe7b7b-5015-3983-96be-f9675a304042",
                                                "text": "Miss Esler and Mr. McMorrow went to Kalgoorlie to adjudicate at the goldfields waltz and quickstep championships, and found the standard of dancing surprisingly high."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c05966ad-0bfc-3606-bfef-f67bfeda6acb",
                                        "entry_id": "9c4f7c66-ecf6-3d0d-92f7-0d29eac4cdce",
                                        "glosses": [
                                            "A piece of music for this dance (or in triple time)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b18708fb-26a6-3250-9098-4b27863d46a4",
                                        "entry_id": "9c4f7c66-ecf6-3d0d-92f7-0d29eac4cdce",
                                        "glosses": [
                                            "A simple task."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "waltz",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d6859239-44b0-3012-85a8-1392a0a6a0a2",
                                        "entry_id": "b667a6bc-93b5-32a9-b8f3-778a89c1f31e",
                                        "glosses": [
                                            "To dance the waltz (with)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c86c82d-a0cc-469b-884b-c2542736d8ba",
                                                "sense_id": "d6859239-44b0-3012-85a8-1392a0a6a0a2",
                                                "text": "They waltzed for twenty-one hours and seventeen minutes straight, setting a record."
                                            },
                                            {
                                                "example_id": "69dd9ba4-06a0-4b31-a072-14b457e41bdf",
                                                "sense_id": "d6859239-44b0-3012-85a8-1392a0a6a0a2",
                                                "text": "While waltzing her around the room, he stepped on her toes only once."
                                            },
                                            {
                                                "example_id": "71544d99-dec4-4408-8ef2-e1b01b400c44",
                                                "sense_id": "d6859239-44b0-3012-85a8-1392a0a6a0a2",
                                                "text": "\"Can you flamenco?\" \"If I have to. How about you?\" \"Love, I can barely waltz. Jive a bit if I'm pissed enough.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4a3e1a2-2730-3911-b7c7-7b92da729034",
                                        "entry_id": "b667a6bc-93b5-32a9-b8f3-778a89c1f31e",
                                        "glosses": [
                                            "To move briskly and unhesitatingly, especially in an inappropriately casual manner, or when unannounced or uninvited."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c11127-1be4-4b36-8db0-b5e0ba02b371",
                                                "sense_id": "a4a3e1a2-2730-3911-b7c7-7b92da729034",
                                                "text": "He waltzed into the room like he owned the place."
                                            },
                                            {
                                                "example_id": "7ff6a69b-e1f7-47a8-8655-cb93e8fc3cad",
                                                "sense_id": "a4a3e1a2-2730-3911-b7c7-7b92da729034",
                                                "text": "You can't just waltz him in here without documentation!"
                                            },
                                            {
                                                "example_id": "7cc23c89-f4ae-41b4-b12e-9b0bc451c609",
                                                "sense_id": "a4a3e1a2-2730-3911-b7c7-7b92da729034",
                                                "text": "Oxlade-Chamberlain, 18, became the youngest English Champions League scorer when he waltzed across the area to plant a low shot into the corner."
                                            },
                                            {
                                                "example_id": "ae1a9670-a8b3-4e4a-a86c-d176908a05c2",
                                                "sense_id": "a4a3e1a2-2730-3911-b7c7-7b92da729034",
                                                "text": "The women in Ms. Telfer’s book waltz right by societal rules that would leave the rest of us at a standstill. We are left tsk-tsking, while also in awe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9deecb6-4af3-33bd-9980-65783426c027",
                                        "entry_id": "b667a6bc-93b5-32a9-b8f3-778a89c1f31e",
                                        "glosses": [
                                            "To accomplish a task with little effort."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83af11ad-673c-4e6e-b984-8a5b865a51c4",
                                                "sense_id": "b9deecb6-4af3-33bd-9980-65783426c027",
                                                "text": "Don't worry about the interview — you'll waltz it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42f70d49-8b3d-3aac-8607-bc730441115e",
                                        "entry_id": "b667a6bc-93b5-32a9-b8f3-778a89c1f31e",
                                        "glosses": [
                                            "To move with fanfare."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84167457-10e0-4a2b-9c77-39280fe96500",
                                                "sense_id": "42f70d49-8b3d-3aac-8607-bc730441115e",
                                                "text": "And he said, what he had planned in his head from the start, if we got Jim out all safe, was for us to[…] take him back up home on a steamboat, in style, and pay him for his lost time, and write word ahead and get out all the niggers around, and have them waltz him into town with a torchlight procession and a brass-band, and then he would be a hero, and so would we."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c46935a0-fe46-44d0-b9ba-44cf17b83262",
                        "source_entry_id": "ec09577d-f11c-3597-b025-d802519ae460",
                        "source_sense_id": "7b965b42-5c36-3f0d-a949-5e2c5079452e",
                        "source_sense_description": "dans",
                        "target_lang_word": "valse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "valse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "44b8bd29-d110-3c17-8271-26315cb7afc9",
                                        "entry_id": "8977218c-43fe-38ec-af93-3d19654bc435",
                                        "glosses": [
                                            "Danse tournante exécutée par un couple sur un mouvement, habituellement à trois temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb793b24-e530-45ea-9c2b-484ea0591d57",
                                                "sense_id": "44b8bd29-d110-3c17-8271-26315cb7afc9",
                                                "text": "Lorsqu'il a racheté ce petit dancing, en 1986, ce n'était qu'un modeste « parquet » où les sexagénaires des villages entre Narbonne et Béziers aimaient se retrouver le samedi soir pour danser le tango et la valse au rythme d'un orchestre local."
                                            },
                                            {
                                                "example_id": "590a0f07-5945-4595-8cbf-91391bdc319f",
                                                "sense_id": "44b8bd29-d110-3c17-8271-26315cb7afc9",
                                                "text": "Mes trois aînés avaient en commun un amour exalté de la danse. La polka pointée, la mazurka, la scottish, la valse étourdissante, la valse vertigineuse, le pas des patineurs, les quadrilles, les lanciers…, rien ne leur était inconnu."
                                            },
                                            {
                                                "example_id": "6841bd93-cfe8-4754-9bdc-79cf046b98fe",
                                                "sense_id": "44b8bd29-d110-3c17-8271-26315cb7afc9",
                                                "text": "Joue-moi plutôt une de ces valses allemandes où la Joie et la Douleur, voluptueusement embrassées, semblent tourner doucement et montrer tour à tour une face pâle baignée de larmes et un front rayonnant couronné de fleurs."
                                            },
                                            {
                                                "example_id": "be27cb2e-d0f9-4cd0-a2a9-a89c3f977cf8",
                                                "sense_id": "44b8bd29-d110-3c17-8271-26315cb7afc9",
                                                "text": "Antoine fit une valse avec Charlotte, ce qui l'étourdit passablement car il en avait perdu l'habitude."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce72fd6a-bbff-3644-a51d-f635d5480c5c",
                                        "entry_id": "8977218c-43fe-38ec-af93-3d19654bc435",
                                        "glosses": [
                                            "Air sur lequel on exécute cette danse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cdd264f-33d8-49c3-8471-85809cf8d812",
                                                "sense_id": "ce72fd6a-bbff-3644-a51d-f635d5480c5c",
                                                "text": "De leur balcon qu'on atteignait par une échelle,, les musiciens déversaient sans répit sur la foule, des airs de valse, de java, de shimmy, de charleston et tout le monde se trémoussait."
