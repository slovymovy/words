                                            {
                                                "example_id": "7e2d5977-2845-4af8-b4a3-ea2b824e98a3",
                                                "sense_id": "e2e145c6-08c6-3e9b-968a-964651c5cb6c",
                                                "text": "Living beyond the Omega-4 mass relay in the Terminus Systems, the mysterious Collector species is glimpsed so rarely as to be taken for a myth by most in galactic society. In reality, Collectors are human-sized insectoid bipeds and can resemble massive winged beetles. They are a terrifying force in the galaxy, responsible for the murder of hundreds of thousands."
                                            }
                                        ]
                                    }
                                ]
                            },
