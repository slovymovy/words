                                    {
                                        "sense_id": "430594cc-8b9c-3652-a102-f7e13e00920b",
                                        "entry_id": "237815bb-ffd1-3e22-a791-145be2ebc25c",
                                        "glosses": [
                                            "auf die Sinne des Betrachters harmonisch wirkend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6af3fbc4-b054-4c2e-88e8-d39cc7f58cff",
                                                "sense_id": "430594cc-8b9c-3652-a102-f7e13e00920b",
                                                "text": "Doch gerade dieser sechsstöckige Bau ist seiner Spitze wegen der ästhetisch auffälligste in diesem Ensemble."
                                            },
                                            {
                                                "example_id": "fd7d4cc8-c9c3-45dc-aa08-4a744f1bf38c",
                                                "sense_id": "430594cc-8b9c-3652-a102-f7e13e00920b",
                                                "text": "Sie inszenieren die Resultate der Forschung als ästhetisches Objekt und erwecken damit den Anschein, die Hervorbringungen der Wissenschaften seien sei so schön wie die Natur selbst."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                        "entry_id": "237815bb-ffd1-3e22-a791-145be2ebc25c",
                                        "glosses": [
                                            "die Ästhetik betreffend; der Ästhetik entsprechend; den Gesetzen der Ästhetik folgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a87ab3f-ee6e-474c-ba87-86b6644d74fa",
                                                "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                                "text": "Die experimentell ausgerichtete psycho-physische Analyse des Erlebens fragt danach, wie ästhetisch wirkende physikalische Gegebenheiten und psychische Erfahrung korrelieren (…)."
                                            },
                                            {
                                                "example_id": "8bd1f6c8-6599-4fca-8fd8-959212ee8abe",
                                                "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                                "text": "Die Besitzer legen auf eine ästhetische Gestaltung großen Wert."
                                            },
                                            {
                                                "example_id": "f920ea65-0824-4262-a011-602f99d25a8a",
                                                "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                                "text": "Ästhetischer Genuss unterscheidet sich, nach Jauß, vom reinen Sinngenuss dadurch, dass genießendes Verhalten in einem Wechselspiel zwischen Subjekt und Objekt stattfindet."
                                            },
                                            {
                                                "example_id": "64a74b03-e662-40e9-b71a-be7228a949ef",
                                                "sense_id": "1053aba7-23b5-3aa7-92f7-2b44a87a6b33",
                                                "text": "Die Wirklichkeit ist ein Fehler. Jedenfalls rein ästhetisch betrachtet. Denn rein ästhetisch betrachtet, hat alles eine vollkommene poetische Logik."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
