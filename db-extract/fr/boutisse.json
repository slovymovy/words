                                            {
                                                "example_id": "ff5fb0ea-97ad-4242-b798-447a8d057dc0",
                                                "sense_id": "7fafb28e-c896-3925-8657-3b436e347aa9",
                                                "text": "If you reduce the header of this document, the body will fit onto a single page."
