                "senses": [
                    {
                        "sense_id": "98c7a92d-98b4-3595-879e-6a5a7c074d3c",
                        "entry_id": "4f815e53-cb0e-3c0b-a781-3c285b872965",
                        "glosses": [
                            "устар., воен. то же, что пехота"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98747431-4cfb-4c11-8d54-041bfc65aae2",
                                "sense_id": "98c7a92d-98b4-3595-879e-6a5a7c074d3c",
                                "text": "― С шестью тысячами инфантерии, двумя кавалерии и несколькими орудиями разбить всю армию, воля ваша, это хорошее дело."
                            },
                            {
                                "example_id": "bed0319c-d795-4f0d-bca6-61aa1c8e9520",
                                "sense_id": "98c7a92d-98b4-3595-879e-6a5a7c074d3c",
                                "text": "Я принял решение инфантерию не привлекать к походу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
