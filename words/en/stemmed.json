        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b116defd-1ef4-36a0-864d-f0fa232f66ee",
                    "sense_definition": "Having a stem.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long-<w>stemmed</w> roses did not fit in the short vase.",
                            "target_lang_translations": {
                                "nl": "De rozen met <w>lange stelen</w> pasten niet in de korte vaas.",
                                "ru": "Розы <w>на длинных стеблях</w> не помещались в низкую вазу."
                            }
                        },
                        {
                            "text": "He bought a beautiful brown-<w>stemmed</w> pipe for his collection.",
                            "target_lang_translations": {
                                "nl": "Hij kocht een prachtige pijp met een <w>bruine steel</w> voor zijn verzameling.",
                                "ru": "Он купил для своей коллекции красивую трубку <w>с коричневым мундштуком</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "long-stemmed rose"
                    ],
                    "target_lang_definitions": {
                        "nl": "Voorzien van een steel of stengel.",
                        "ru": "Имеющий стебель, ножку или черенок (часто в сложных словах)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "met een steel",
                                "target_lang_sense_clarification": "algemeen gebruik voor objecten met een steel"
                            },
                            {
                                "target_lang_word": "gesteeld",
                                "target_lang_sense_clarification": "botanische term voor planten of bloemen"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "на стебле",
                                "target_lang_sense_clarification": "о цветах или растениях"
                            },
                            {
                                "target_lang_word": "с ножкой",
                                "target_lang_sense_clarification": "о бокалах, трубках и других предметах"
                            },
                            {
                                "target_lang_word": "-стебельный",
                                "target_lang_sense_clarification": "как часть сложного прилагательного, например длинностебельный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5b5eb99d-5858-3ae4-9f99-b9840fe72868",
                    "sense_definition": "Simple past and past participle of <w>stem</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor <w>stemmed</w> the bleeding with a clean bandage.",
                            "target_lang_translations": {
                                "nl": "De dokter <w>stelpte</w> de bloeding met een schoon verband.",
                                "ru": "Врач <w>остановил</w> кровотечение чистой повязкой."
                            }
                        },
                        {
                            "text": "The river flow was <w>stemmed</w> by the construction of the new dam.",
                            "target_lang_translations": {
                                "nl": "De rivierstroom werd <w>tegengehouden</w> door de bouw van de nieuwe dam.",
                                "ru": "Течение реки было <w>сдержано</w> строительством новой плотины."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "This is a grammatical form of the verb stem."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Verleden tijd en voltooid deelwoord van 'stemmen' (in de betekenis van tegenhouden of stelpen).",
                        "ru": "Форма прошедшего времени и причастие прошедшего времени глагола stem (останавливать, сдерживать)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "gestelpt",
                                "target_lang_sense_clarification": "gebruikt bij het stoppen van een bloeding"
                            },
                            {
                                "target_lang_word": "tegengehouden",
                                "target_lang_sense_clarification": "gebruikt bij het stoppen van een stroom of beweging"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "остановил",
                                "target_lang_sense_clarification": "прекратил течение или распространение чего-либо"
                            },
                            {
                                "target_lang_word": "сдержал",
                                "target_lang_sense_clarification": "предотвратил дальнейшее движение или развитие"
                            },
                            {
                                "target_lang_word": "остановленный",
                                "target_lang_sense_clarification": "причастие прошедшего времени"
                            }
                        ]
                    }
                }
            ]
        }
    ]
