    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "df2ea665-c0a0-3516-9c64-13b230ee3dec",
                    "sense_definition": "Osoba lubiąca wykwintne jedzenie i potrafiąca docenić jego jakość.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do tej tawerny często pielgrzymują <w>smakosze</w> świeżych ostryg.",
                            "target_lang_translations": {
                                "ru": "В эту таверну часто приходят <w>гурманы</w> свежих устриц."
                            }
                        },
                        {
                            "text": "Prawdziwy <w>smakosz</w> zawsze rozpozna składniki dobrej potrawy.",
                            "target_lang_translations": {
                                "ru": "Настоящий <w>гурман</w> всегда распознает ингредиенты хорошего блюда."
                            }
                        }
                    ],
                    "synonyms": [
                        "koneser",
                        "gastrolatra"
                    ],
                    "common_phrases": [
                        "prawdziwy smakosz",
                        "smakosz kuchni"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который любит изысканную еду и умеет ценить её качество."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гурман",
                                "target_lang_sense_clarification": "любитель и ценитель тонких, изысканных блюд"
                            },
                            {
                                "target_lang_word": "гастроном",
                                "target_lang_sense_clarification": "устар. знаток и ценитель изысканных блюд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "984408fa-6b34-3e4b-b2bc-3acff5f8b9c7",
                    "sense_definition": "Osoba posiadająca dużą wiedzę i wyczucie w jakiejś dziedzinie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "znawca",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beniamin zna wielu <w>smakoszy</w> nowoczesnego jazzu.",
                            "target_lang_translations": {
                                "ru": "Беньямин знает многих <w>ценителей</w> современного джаза."
                            }
                        },
                        {
                            "text": "Jako <w>smakosz</w> literatury klasycznej, polecił mi tę książkę.",
                            "target_lang_translations": {
                                "ru": "Как <w>знаток</w> классической литературы, он порекомендовал мне эту книгу."
                            }
                        }
                    ],
                    "synonyms": [
                        "koneser"
                    ],
                    "common_phrases": [
                        "smakosz sztuki",
                        "smakosz muzyki"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, обладающий глубокими знаниями и тонким вкусом в какой-либо области."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ценитель",
                                "target_lang_sense_clarification": "человек, который хорошо разбирается в чем-либо и умеет оценить достоинства"
                            },
                            {
                                "target_lang_word": "гурман",
                                "target_lang_sense_clarification": "перен. тонкий ценитель искусства или чего-либо изысканного"
                            },
                            {
                                "target_lang_word": "знаток",
                                "target_lang_sense_clarification": "человек, обладающий глубокими знаниями в какой-то области"
                            }
                        ]
                    }
                }
            ]
        }
    ]
