                                    {
                                        "sense_id": "8c104070-d6ce-30a3-ba55-e6cb534b933c",
                                        "entry_id": "f4198b73-d729-32ad-bb97-ac4cb44f81e3",
                                        "glosses": [
                                            "To attach by, or equip with a hinge."
                                        ],
