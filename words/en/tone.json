                        "firm up",
                        "tone up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать тело или мышцы более упругими и сильными.",
                        "zh": "使身体或肌肉更紧实、更强壮。"
                    },
                    "translations": {
