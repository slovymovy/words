                    {
                        "translation_id": "225ecec9-fed0-4e32-9f38-8c81829a2114",
                        "source_entry_id": "7cf09512-2242-3b38-9aaa-d807842dbfe1",
                        "source_sense_description": "process of flowing out",
                        "target_lang_word": "пото́к",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пото́к",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "38d0058b-4157-3b81-8fbf-ffdebabe395f",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "постоянное перемещение масс жидкости или газа в определённом направлении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03fdf078-df6f-4aaa-a36a-bdd45d2fa83e",
                                                "sense_id": "38d0058b-4157-3b81-8fbf-ffdebabe395f",
                                                "text": "Ручей представляет собой неширокий поток воды, имеющий извилистое русло."
                                            },
                                            {
                                                "example_id": "25a20cdf-6c8f-473c-9ce2-2ea349338716",
                                                "sense_id": "38d0058b-4157-3b81-8fbf-ffdebabe395f",
                                                "text": "При малой скорости потока в гладкой трубе режим движения жидкости ламинарный."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2087887-75be-3ff0-a4bb-150203927347",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "перен. постоянное перемещение чего-либо или кого-либо в определённом направлении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c551eac6-aacc-4f34-bb24-7ebe625f5bd0",
                                                "sense_id": "f2087887-75be-3ff0-a4bb-150203927347",
                                                "text": "Железнодорожные станции являются объектами повышенной опасности, для которых характерен большой поток людей."
                                            },
                                            {
                                                "example_id": "e7a41dea-6d4c-4fce-a85f-1c2a7ee1dfb6",
                                                "sense_id": "f2087887-75be-3ff0-a4bb-150203927347",
                                                "text": "Уже известно, по каким полосам движения и в какое время суток идет наиболее интенсивный поток машин."
                                            },
                                            {
                                                "example_id": "b1e41bfc-7886-46aa-be2b-fd13ac2912cb",
                                                "sense_id": "f2087887-75be-3ff0-a4bb-150203927347",
                                                "text": "Разработанные в сфере логистики технологии управления материальными ресурсопотоками рассматривают финансовые потоки как обеспечивающие функционирование уже существующих систем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05af9b46-d948-3f77-a034-fd8a2c0c96e2",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "совокупность групп студентов одной специальности и года обучения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e87d05be-64cb-42a2-a9af-fd1442c65550",
                                                "sense_id": "05af9b46-d948-3f77-a034-fd8a2c0c96e2",
                                                "text": "На нашем потоке было много таких студентов, а также выпускников с красными дипломами."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe76b317-84c8-3b25-aa2f-5b63e09cb134",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "прогр. унифицированный абстрактный источник ввода или вывода данных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e706d56-d25e-4503-b58e-1f224586f9cf",
                                                "sense_id": "fe76b317-84c8-3b25-aa2f-5b63e09cb134",
                                                "text": "С помощью этого класса можно легко и просто записать в поток и прочитать из него."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77343faa-4018-3713-969c-b107616ad1f0",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "комп. информ. непрерывно прибывающие данные"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f94937a7-9449-4258-b7e6-8f51cff22353",
                                                "sense_id": "77343faa-4018-3713-969c-b107616ad1f0",
                                                "text": "Какой программой можно записать поток со звуковой карты?"
                                            },
                                            {
                                                "example_id": "49d08ae0-27b0-4f9f-b661-b13046c3973a",
                                                "sense_id": "77343faa-4018-3713-969c-b107616ad1f0",
                                                "text": "Цыбашев слушал, стараясь вытащить из этого речевого потока смысл."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "182d6b30-f395-3d00-9563-31fe6a09bf72",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "прогр. одна (в вырожденных случаях - единственная) из нескольких независимых последовательностей команд, которые одновременно или псевдоодновременно выполняются процессором в общем адресном пространстве, но с независимыми регистрами и стеком"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90a5a556-690f-4170-8efe-5093f29a2624",
                                                "sense_id": "182d6b30-f395-3d00-9563-31fe6a09bf72",
                                                "text": "Таким образом, в многопоточной среде необходима синхронизация потоков при обращении к критическим ресурсам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "778f620d-a273-344e-be8e-f05a0b8c88b3",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "матем., физ. интеграл векторного поля по поверхности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1eccaa86-073d-4fcd-b84e-d0099a3def27",
                                                "sense_id": "778f620d-a273-344e-be8e-f05a0b8c88b3",
                                                "text": "При непосредственном вычислении потока через замкнутую поверхность приходится разбивать ее на части, однозначно проектируемые на координатные плоскости."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c77f4cf-2372-3b03-aad5-f7e22a1a2703",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "физ. количественная мера интенсивности потока[2], равная количеству чего-либо (вещества, энергии, информации), проходящему через заданную границу в единицу времени."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c0a9857-3df5-4a62-bcce-743d696cbd60",
                                                "sense_id": "1c77f4cf-2372-3b03-aad5-f7e22a1a2703",
                                                "text": "Естественно, при такой скорости воздушный поток равен всего-навсего 29 кубических футов в минуту, но зато кулер работает очень тихо — 20 дБ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a3e4570-9fcc-37ce-9622-5bd3e1d085c1",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "психол. то же, что потоковое состояние; психическое состояние, в котором человек полностью поглощён своим занятием, не обращая внимания на отвлекающие факторы."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd4509c8-8326-3174-9e75-78bf7c0c074a",
                                        "entry_id": "d45b59fc-2c7f-3c64-9bcb-076cdcc3302a",
                                        "glosses": [
                                            "перен. последовательность каких-либо событий, непрерывно следующих одно за другим"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51179674-55b5-4cc9-bb9e-f00eb61d08da",
                                                "sense_id": "cd4509c8-8326-3174-9e75-78bf7c0c074a",
                                                "text": "Поток событий."
                                            },
                                            {
                                                "example_id": "511f6936-03f7-40c0-9e16-6e2d0b38e8ca",
                                                "sense_id": "cd4509c8-8326-3174-9e75-78bf7c0c074a",
                                                "text": "В потоке дней."
                                            },
                                            {
                                                "example_id": "feb8cb00-2fb5-4b74-a246-2756d1b76cfd",
                                                "sense_id": "cd4509c8-8326-3174-9e75-78bf7c0c074a",
                                                "text": "Поток жалоб."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
