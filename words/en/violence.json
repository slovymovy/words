                                "target_lang_sense_clarification": "применение физической силы"
                            },
                            {
                                "target_lang_word": "жестокость",
                                "target_lang_sense_clarification": "грубое обращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "暴力",
                                "target_lang_sense_clarification": "指使用武力造成伤害的行为"
                            },
                            {
                                "target_lang_word": "残暴",
                                "target_lang_sense_clarification": "指行为极其凶狠、残酷"
                            }
                        ]
