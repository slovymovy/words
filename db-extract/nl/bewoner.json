                        "translation_id": "ddc50730-274d-4d35-8377-867e3be5ae47",
                        "source_entry_id": "a8d8eee3-03de-3486-8083-19f00e8929b9",
                        "source_sense_id": "28f39fc5-7c17-33d4-bda5-47927fcd2f83",
