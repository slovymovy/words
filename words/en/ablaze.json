                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chandelier shone <w>ablaze</w> above the elegant dining hall.",
                            "target_lang_translations": {
                                "ru": "Люстра <w>ослепительно ярко</w> сияла над изысканным обеденным залом."
