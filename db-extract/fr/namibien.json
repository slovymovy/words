                    }
                ],
                "senses": [
                    {
                        "sense_id": "32483165-1568-393c-a25c-de995ff42007",
                        "entry_id": "4bb678a4-6f89-3709-ac41-2910f7b2ef09",
                        "glosses": [
                            "Habitant ou natif de la Namibie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "691305e5-8a84-4182-9f0d-4262ff592b33",
                                "sense_id": "32483165-1568-393c-a25c-de995ff42007",
                                "text": "En ce 21 septembre, les Namibiens surprennent le Vélodrome par Tiaan Swanepoel (joueur de Valence-d’Agen)."
                            },
                            {
                                "example_id": "64057afa-e081-42c0-9125-6fa9a0ebc4a5",
                                "sense_id": "32483165-1568-393c-a25c-de995ff42007",
                                "text": "Le capitaine des Bleus a dû sortir peu après la reprise de la seconde période, après avoir subi une violente charge du Namibien Johan Deysel au niveau de la tête — qui lui a valu une expulsion."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b192a38d-e454-4b61-8fdf-cdd712087ee1",
                        "source_entry_id": "4bb678a4-6f89-3709-ac41-2910f7b2ef09",
                        "source_sense_id": "32483165-1568-393c-a25c-de995ff42007",
                        "target_lang_word": "Namibier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namibier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                        "entry_id": "76210e86-bce7-3c8c-81aa-239bcc5750cc",
                                        "glosses": [
                                            "Staatsbürger von Namibia"
                                        ],
                                        "tags": [
                                            "amtlich"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "466dd81c-c581-44b0-9e9a-22e8635e2723",
                                                "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                                "text": "„Die deutsche Regierung sollte mit allen namibischen Einrichtungen und Instanzen einschließlich politischer Parteien und Gemeinschaften zusammenarbeiten, ‚um Versöhnung und die Wiederherstellung der Würde unter Namibiern zu gewährleisten‘.“"
                                            },
                                            {
                                                "example_id": "e5b5b2b1-9bf3-4af9-ae75-c763a309ce17",
                                                "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                                "text": "„Dieser bezeichnete die Ermordung Zehntausender Namibier unter deutscher Kolonialherrschaft als ‚ersten Genozid des 20. Jahrhunderts‘ und die Überführung von Knochen zu Forschungszwecken als ‚rassistisch motivierte Verbrechen‘.“"
                                            },
                                            {
                                                "example_id": "a1a9b0ee-ecc5-4a7e-a87b-75769931ee4b",
                                                "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                                "text": "„Die meisten Namibier sind Farmer, aber arme.“"
                                            },
                                            {
                                                "example_id": "bc244994-1847-491d-b353-9e9cb59b3da1",
                                                "sense_id": "aebf50dc-4954-385d-8949-65bf2d35eda6",
                                                "text": "„Andere weiße Namibier lenken von den historisch bedingten Ungerechtigkeiten ab, indem sie aktuelle Missstände in der namibischen Politik betonten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa1e346f-e376-47a6-9d36-d7c7e965a81e",
                        "source_entry_id": "4bb678a4-6f89-3709-ac41-2910f7b2ef09",
                        "source_sense_id": "32483165-1568-393c-a25c-de995ff42007",
                        "target_lang_word": "Namibierin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namibierin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c0b5f979-82ee-3062-9e5c-86b8e5c77f93",
                                        "entry_id": "2e4af0c8-0281-3be2-8a85-558ce980e49f",
                                        "glosses": [
                                            "Staatsbürgerin von Namibia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "915f6901-9a02-4b83-82b5-8197dd1c5a5d",
                                                "sense_id": "c0b5f979-82ee-3062-9e5c-86b8e5c77f93",
                                                "text": "Sie ist Namibierin."
                                            },
                                            {
                                                "example_id": "73d532f6-2779-4bd9-9ace-58bc51b8805a",
                                                "sense_id": "c0b5f979-82ee-3062-9e5c-86b8e5c77f93",
                                                "text": "„Über zehn Jahre ist es her, dass es mit ihrem früheren Job bei einer Bank zu Ende ging und die Namibierin das Thema Solarenergie für sich entdeckt hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
