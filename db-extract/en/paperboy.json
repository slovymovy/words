            {
                "entry_id": "166da822-2565-3fa0-8ed0-9c22633d122c",
                "word": "paperboy",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7ff8d356-4765-4a38-b67b-50ce7ae6c2f8",
                        "entry_id": "166da822-2565-3fa0-8ed0-9c22633d122c",
                        "tags": [
                            "plural"
                        ],
                        "form": "paperboys"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "abc7898a-233d-3111-92d2-8f0a2334eced",
                        "entry_id": "166da822-2565-3fa0-8ed0-9c22633d122c",
                        "glosses": [
                            "A boy who delivers newspapers to houses on a paper round."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cff2794-00e4-43c5-a34d-08177a40d903",
                                "sense_id": "abc7898a-233d-3111-92d2-8f0a2334eced",
                                "text": "Our current paperboy does a nicely consistent job of throwing the paper onto the porch. Our old paperboy sometimes would fling it into the bushes!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "44d71148-3249-4e2a-a15b-c5dc589c8c20",
                        "source_entry_id": "166da822-2565-3fa0-8ed0-9c22633d122c",
                        "source_sense_id": "abc7898a-233d-3111-92d2-8f0a2334eced",
                        "source_sense_description": "male who delivers newspapers",
                        "target_lang_word": "livreur de journaux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c56ae236-56b6-4cea-a915-4059fd71c1ad",
                        "source_entry_id": "166da822-2565-3fa0-8ed0-9c22633d122c",
                        "source_sense_id": "abc7898a-233d-3111-92d2-8f0a2334eced",
                        "source_sense_description": "male who delivers newspapers",
                        "target_lang_word": "camelot",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "camelot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                        "entry_id": "9286b98c-eb76-3683-9b93-b29b4506871b",
                                        "glosses": [
                                            "Espèce d’étoffe qui était faite ordinairement de poil de chèvre ou de laine mêlée quelquefois de soie en chaîne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b6bf954-6418-4ca5-aa54-cd20621709cd",
                                                "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                                "text": "Son manteau de camelot bleu était une antiquité locale au même titre que le clocher de l’église."
                                            },
                                            {
                                                "example_id": "9a3966d2-e90d-4b0a-92b2-1746f4eb8c05",
                                                "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                                "text": "Parmi les importations du sud, on remarque les fruits secs, le sucre, les articles de verroterie, le camelot, la laine, l’opium, etc., en petite quantité."
                                            },
                                            {
                                                "example_id": "709936bd-859a-45b7-a83f-2a1a7d144178",
                                                "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                                "text": "— Mais pas laide, Madame, interrompit vivement Passerose ; vous êtes encore belle et aimable, malgré votre petit bonnet de fermière, votre jupe de drap rayé, votre corsage de camelot rouge et votre guimpe de simple toile."
                                            },
                                            {
                                                "example_id": "db41d685-40aa-4706-a176-01b3ae20c382",
                                                "sense_id": "0be215bb-2154-3598-9edd-1cf29b8328f9",
                                                "text": "Il n’y aura pas de concurrence pour les étoffes de laine d’autres espèces et qualités, telles que camelots, callimanco, shallons, durants, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "camelot",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb526759-8e14-37f3-91ec-fd3d257030a0",
                                        "entry_id": "888f0add-5a13-3cca-8e95-56dc56b0ab3a",
                                        "glosses": [
                                            "Marchand ambulant qui vend des articles dans un lieu public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5248e4c-8826-4a7a-9f02-d8423f50d858",
                                                "sense_id": "cb526759-8e14-37f3-91ec-fd3d257030a0",
                                                "text": "Les boniments des camelots. Quand un sergent de ville s’éloigne, un camelot surgit. Coiffés d’une casquette, le visage animé, la moustache déteinte, ils parlent avec chaleur, car leurs passions sont violentes et ils veulent gagner de quoi manger et de quoi boire."
                                            },
                                            {
                                                "example_id": "09d3624d-a048-47df-b1db-568eeffb2ef1",
                                                "sense_id": "cb526759-8e14-37f3-91ec-fd3d257030a0",
                                                "text": "Les camelots, c’est bien plus marrant que les clowns."
                                            },
                                            {
                                                "example_id": "e8d33197-4f5f-41fc-83cc-ac305b19f053",
                                                "sense_id": "cb526759-8e14-37f3-91ec-fd3d257030a0",
                                                "text": "Le petit camelot ajuste régulièrement la sangle du présentoir portable qui blesse son épaule, et repart. Remplie d’une dizaine de paquets de cigarettes, de bonbons et autres sucreries, sa modeste boutique portative pèse son poids."
                                            },
                                            {
                                                "example_id": "e3fcdf49-7a8b-4fd5-b7ba-6e168bf3ecde",
                                                "sense_id": "cb526759-8e14-37f3-91ec-fd3d257030a0",
                                                "text": "L’importante inflation alimentaire et la baisse de pouvoir d’achat des consommateurs affectent les quelque 145 000 camelots, qui, chaque semaine, travaillent sur les marchés de l’Hexagone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "054dfe78-22ca-307a-84d9-3fa7f49461e9",
                                        "entry_id": "888f0add-5a13-3cca-8e95-56dc56b0ab3a",
                                        "glosses": [
                                            "Vendeurs de journaux, de chansons ; distributeurs de prospectus."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e61fd8-7196-467e-bf7c-38fbf6aa15e3",
                                                "sense_id": "054dfe78-22ca-307a-84d9-3fa7f49461e9",
                                                "text": "Des escouades de camelots ont parcouru les boulevards en hurlant le titre d’une nouvelle feuille : « Demandez Le Glaive ! »"
                                            },
                                            {
                                                "example_id": "4466318a-4ed0-4581-9720-f0dcd77cf446",
                                                "sense_id": "054dfe78-22ca-307a-84d9-3fa7f49461e9",
                                                "text": "[…], il hochait le chef, tout pareil à l’un de ces branle-tête que vendent les camelots dans les villes aux jours de grande foire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "003edb00-5b5e-3319-a854-d204860da43a",
                                        "entry_id": "888f0add-5a13-3cca-8e95-56dc56b0ab3a",
                                        "glosses": [
                                            "Camelot du Roi."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08c4592d-b533-46b5-951a-2260f91d1e71",
                                                "sense_id": "003edb00-5b5e-3319-a854-d204860da43a",
                                                "text": "Aujourd’hui, le Café de Flore a été abandonné par les chefs du mouvement, mais les camelots chargés de coller des papillons dans le quartier y viennent encore, et y sirotent avec respect le mêlé-cass des classes moyennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "850e56cd-5366-49ad-b04d-408a35689673",
