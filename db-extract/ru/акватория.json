                "senses": [
                    {
                        "sense_id": "149b43f9-0528-3bfc-9dff-83d00d879541",
                        "entry_id": "cd83987c-e9fa-3ef1-8e9a-460194e0f5a1",
                        "glosses": [
                            "water area, waters, harbour water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc9cb3a8-628e-4ebc-9761-952a01e8b586",
                                "sense_id": "149b43f9-0528-3bfc-9dff-83d00d879541",
                                "text": "Как только яхта показалась в акватории гавани, к ней с противоположных сторон приблизились две шлюпки с вооруженными людьми.",
                                "translation": "As soon as the yacht appeared in the harbour waters, she was approached from opposite sides by two dinghies with armed men.",
                                "english": "As soon as the yacht appeared in the harbour waters, she was approached from opposite sides by two dinghies with armed men."
                            },
                            {
                                "example_id": "9b248c3b-7e87-4318-9cd7-e8b1e398458f",
                                "sense_id": "149b43f9-0528-3bfc-9dff-83d00d879541",
                                "text": "В свете прожекторов катер мотался по акватории.",
                                "translation": "In the light of the searchlights, the motorboat sped around the water area.",
                                "english": "In the light of the searchlights, the motorboat sped around the water area."
                            },
                            {
                                "example_id": "e09977bf-d63c-4ca5-a7e1-462a012aed63",
                                "sense_id": "149b43f9-0528-3bfc-9dff-83d00d879541",
                                "text": "Потом речка пересекает бывшую акваторию давным-давно спущенного Просянского пруда.",
                                "translation": "Then the river crosses the former water area of the long-drained Prosyansky Pond.",
                                "english": "Then the river crosses the former water area of the long-drained Prosyansky Pond."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
