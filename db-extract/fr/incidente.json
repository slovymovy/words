                "senses": [
                    {
                        "sense_id": "cd313b8c-621a-3d77-af7e-82cd7e499e6f",
                        "entry_id": "69f4dba5-4cda-35f7-a092-2f0149e8c346",
                        "glosses": [
                            "Proposition qui est insérée dans une proposition dont elle fait partie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "998f9cb3-94dc-4e3b-9121-4ee2215a8024",
                                "sense_id": "cd313b8c-621a-3d77-af7e-82cd7e499e6f",
                                "text": "Bossuet, dans ses manuscrits, a raturé des incidentes riches de sève afin que l’esprit de ses auditeurs ne fût pas distrait des idées maîtresses auxquelles il s’attachait."
                            },
                            {
                                "example_id": "3289c368-41f9-4c63-8b35-8ee61d94cdc9",
                                "sense_id": "cd313b8c-621a-3d77-af7e-82cd7e499e6f",
                                "text": "Pour que le texte soit clair, il faut dans toute la mesure du possible écrire des phrases simples, en évitant tout particulièrement la multiplication de subordonnées et d’incidentes emboîtées, les doubles négations et les accumulations de substantifs."
                            },
                            {
                                "example_id": "1f34aa2e-2bf8-4938-83ab-9e74454f872b",
                                "sense_id": "cd313b8c-621a-3d77-af7e-82cd7e499e6f",
                                "text": "La musique des conversations a pris cette ampleur sereine qui s’installe quand les plats sont servis, qu’en incidente un des convives salue la fraîcheur des petits légumes."
                            }
                        ]
                    }
