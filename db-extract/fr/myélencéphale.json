                    {
                        "sense_id": "70b3c708-e808-3419-8e35-2f4a2b43c20a",
                        "entry_id": "12ca7c58-8eb8-37a7-abc5-e59b10ddec40",
                        "glosses": [
                            "Nom donné à la partie centrale du système nerveux central, la partie caudale du rhombencéphale chez l’embryon, et quasi synonyme de bulbe rachidien chez l’adulte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0af149ed-3883-47f9-9ee9-3798449af031",
                                "sense_id": "70b3c708-e808-3419-8e35-2f4a2b43c20a",
                                "text": "La flexion pontique, au terme du 35ᵉ jour de développement, divise le rhombencéphale en myélencéphale et en métencéphale."
                            },
                            {
                                "example_id": "e7a63237-2471-48ca-9e87-96b4a05a51f4",
                                "sense_id": "70b3c708-e808-3419-8e35-2f4a2b43c20a",
                                "text": "Enfin, le myélencéphale contient toutes les voies ascendantes et descendantes qui relient les structures de l’encéphale vers la moelle épinière."
                            }
                        ]
                    }
                ],
