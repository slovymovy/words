                "translations": [
                    {
                        "translation_id": "a0781db2-3664-4df1-b89f-cfdfbff0a96e",
                        "source_entry_id": "eb834988-4d45-3e38-9f36-266d87f4720c",
                        "source_sense_id": "b47ffc60-ed1b-3f70-837c-837acdf3038f",
                        "target_lang_word": "sister",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sister",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c21467b-d30b-3b4e-831d-f7389c26064e",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "A daughter of the same parents as another person; a female sibling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f8780b5-9991-450d-9f79-4c9636c580f7",
                                                "sense_id": "1c21467b-d30b-3b4e-831d-f7389c26064e",
                                                "text": "My sister is always driving me crazy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ada9a459-5df3-380d-8dd1-71638e1f10e9",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "A female member of a religious order; especially one devoted to more active service; (informal) a nun."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46afe8aa-2890-49e2-ada2-1146a899a2cf",
                                                "sense_id": "ada9a459-5df3-380d-8dd1-71638e1f10e9",
                                                "text": "Michelle left behind her bank job and became a sister at the local convent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc0d35e4-c372-3118-91c1-a660ae926e84",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "Any butterfly in the genus Adelpha, so named for the resemblance of the dark-colored wings to the black habit traditionally worn by nuns."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a99e0f1b-b6f9-3b0e-9bb4-7bbfd021e3a2",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "A senior or supervisory nurse, often in a hospital."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce062100-7884-3d7d-a596-9ee3b947559c",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "Any woman or girl with whom a bond is felt through the same biological sex, gender or common membership in a community, race, profession, religion, organization, or ism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad677fe0-a0b1-4de2-841a-adeab54532ee",
                                                "sense_id": "ce062100-7884-3d7d-a596-9ee3b947559c",
                                                "text": "Connie was very close to her friend Judy and considered her to be her sister."
                                            },
                                            {
                                                "example_id": "2d2c76e4-8c3f-497f-8bdf-d498d7f02ef4",
                                                "sense_id": "ce062100-7884-3d7d-a596-9ee3b947559c",
                                                "text": "Sisters are doing it for themselves / Standing on their own two feet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d40a65f-ed9f-3e89-9016-eb2b4d6a0611",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "A black woman."
                                        ],
                                        "tags": [
                                            "capitalized",
                                            "slang",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aff07a8b-0c4b-40f0-9078-a94911d800aa",
                                                "sense_id": "8d40a65f-ed9f-3e89-9016-eb2b4d6a0611",
                                                "text": "A fly sister rolled in with a suitcase full of hip-hop novels called The Glamorous Life, and an African brother with long dreads wanted to sell them some incense and some fake Jacob watches."
                                            },
                                            {
                                                "example_id": "655d1c0e-30ec-43b1-841a-13b9ba58d91a",
                                                "sense_id": "8d40a65f-ed9f-3e89-9016-eb2b4d6a0611",
                                                "text": "The short “naps” of the average Sister do not sway in the wind as that of a blonde."
                                            },
                                            {
                                                "example_id": "0a196f9b-d121-4077-8507-8ae1dbe28503",
                                                "sense_id": "8d40a65f-ed9f-3e89-9016-eb2b4d6a0611",
                                                "text": "And now, social media has made it worse. From Facebook to Twitter, I get all kinds of invitations. Recently a sister inboxed me on Facebook and told me that she knew for a fact that I wanted her and she wanted me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1fcc4a02-9282-38be-9af1-18a86f50251f",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "A form of address to a woman."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "192b2340-1f05-4bb9-b040-b856518b6578",
                                                "sense_id": "1fcc4a02-9282-38be-9af1-18a86f50251f",
                                                "text": "What’s up, sister?"
                                            },
                                            {
                                                "example_id": "4c14cbd9-5178-41f6-905b-467c41e57067",
                                                "sense_id": "1fcc4a02-9282-38be-9af1-18a86f50251f",
                                                "text": "\"Listen, sister. I've got a job for you.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a423184-7325-33c9-a39a-efa564afa57b",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "A female fellow member of a religious community, church, trades union etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59e421a5-c36c-449c-9eb1-016d6a061294",
                                                "sense_id": "2a423184-7325-33c9-a39a-efa564afa57b",
                                                "text": "Thank you, sister. I would like to thank the sister who just spoke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dc35051-294f-39c6-90a3-33ded0ab2950",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "An entity that has a special or affectionate, non-hierarchical relationship with another."
                                        ],
                                        "tags": [
                                            "attributive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86e74ce2-8bf0-47bd-a305-c5446a2dd6ae",
                                                "sense_id": "2dc35051-294f-39c6-90a3-33ded0ab2950",
                                                "text": "sister publication"
                                            },
                                            {
                                                "example_id": "2331c5f1-7dd1-4345-aef0-9ae56a1db482",
                                                "sense_id": "2dc35051-294f-39c6-90a3-33ded0ab2950",
                                                "text": "sister city"
                                            },
                                            {
                                                "example_id": "3832b435-74bc-471c-9710-84eab4eeb3ff",
                                                "sense_id": "2dc35051-294f-39c6-90a3-33ded0ab2950",
                                                "text": "sister projects"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea2e7dfd-30c7-37ff-9448-d28bd13d7936",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "A node in a data structure that shares its parent with another node."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5f89ca4-f3ae-311c-aef4-89571dbdbd38",
                                        "entry_id": "50a28445-e172-350a-8dc8-99db3956c544",
                                        "glosses": [
                                            "Something in the same class."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d08985e2-b00e-45f4-8580-ad4cdfae7c4a",
                                                "sense_id": "c5f89ca4-f3ae-311c-aef4-89571dbdbd38",
                                                "text": "sister ships"
                                            },
                                            {
                                                "example_id": "a850b20a-b719-4dc8-9501-ae5b8f417a62",
                                                "sense_id": "c5f89ca4-f3ae-311c-aef4-89571dbdbd38",
                                                "text": "sister facility"
                                            },
                                            {
                                                "example_id": "9c90b62e-66a2-49d9-8af2-433007175b7e",
                                                "sense_id": "c5f89ca4-f3ae-311c-aef4-89571dbdbd38",
                                                "text": "Within the ABCZ clade, Arecanae are sister of a group that includes all of the other taxa, and the latter fall into two major clades."
                                            },
                                            {
                                                "example_id": "d15f1331-0f4f-4a71-8310-bd1e97502933",
                                                "sense_id": "c5f89ca4-f3ae-311c-aef4-89571dbdbd38",
                                                "text": "Karimi (1999) and Cheng et al. (1997), among others, on the other hand, assume that specific objects are base-generated at SpecVP, whereas nonspecific objects are sister of V."
                                            },
                                            {
                                                "example_id": "fe0edfc9-31cd-494d-9e11-96742a7c7613",
                                                "sense_id": "c5f89ca4-f3ae-311c-aef4-89571dbdbd38",
                                                "text": "The bee-eaters are sister to a clade that includes the rollers, ground-rollers, todies, motmots, and kingfishers (Cracraft 2013)."
                                            }
