                "senses": [
                    {
                        "sense_id": "4ace107b-feba-3067-aa3d-43429b9124e4",
                        "entry_id": "8b67522f-4f63-39ab-ac39-dd3f7a32ad90",
                        "glosses": [
                            "zentrale Einrichtung zur Registrierung von Flüchtlingen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46188c9a-25e0-406c-a0a3-2957d75c720d",
                                "sense_id": "4ace107b-feba-3067-aa3d-43429b9124e4",
                                "text": "„Eine ehemalige Kaserne bei Kirkenes, in der Nähe des Grenzübergangs, soll als Registrierungszentrum und Notunterkunft dienen, zitierte die norwegische Nachrichtenagentur NTB zuletzt aus dem Regierungsbeschluss.“"
                            },
                            {
                                "example_id": "9ab3936c-d1fa-4527-b452-a7e3a47f5871",
                                "sense_id": "4ace107b-feba-3067-aa3d-43429b9124e4",
                                "text": "„Seine Partei spricht lieber von Registrierungszentren, die auch in Erstaufnahme-Einrichtungen entstehen könnten.“"
                            },
                            {
                                "example_id": "0d849737-62b8-4184-a8a9-c8c0b6d3b2fa",
                                "sense_id": "4ace107b-feba-3067-aa3d-43429b9124e4",
                                "text": "„Das Land baut derzeit die bisherige Notunterkunft im Heidelberger Patrick Henry Village (PHV) vorübergehend zu einem Registrierungszentrum aus.“"
                            },
                            {
                                "example_id": "c5338e9f-f2bd-46af-bdb8-dc88e836567c",
                                "sense_id": "4ace107b-feba-3067-aa3d-43429b9124e4",
                                "text": "„Integrationsministerin Bilkay Öney und Innenminister Reinhold Gall haben das sich im Aufbau befindende Registrierungszentrum für Flüchtlinge im Heidelberger Patrick-Henry-Village (PHV) besucht.“"
                            },
                            {
                                "example_id": "9fcea278-b30f-42b6-9822-ef5ff2c5d383",
                                "sense_id": "4ace107b-feba-3067-aa3d-43429b9124e4",
                                "text": "„Zwei der Registrierungszentren werden in Bayern stehen, und zwar in Bamberg und Manching.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
