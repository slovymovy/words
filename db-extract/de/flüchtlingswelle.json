                "senses": [
                    {
                        "sense_id": "6132fa2b-e79c-33eb-90f0-f0ca297a56f6",
                        "entry_id": "65ae13c5-d191-3798-86f4-039e8324b3e1",
                        "glosses": [
                            "aus Flüchtlingen bestehende größere Menschenmenge, die aus einem bestimmten Grund plötzlich ihre Heimat verlässt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3271014c-8bcd-43d8-8345-7b22a67eb151",
                                "sense_id": "6132fa2b-e79c-33eb-90f0-f0ca297a56f6",
                                "text": "„Mit der ersten Flüchtlingswelle aus Kirgistan kamen 80 000 bis 100 000 Menschen nach Usbekistan, für die man Lager errichtete.“"
                            },
                            {
                                "example_id": "f5609f25-eaf5-4375-8d0c-554f22ffd1e3",
                                "sense_id": "6132fa2b-e79c-33eb-90f0-f0ca297a56f6",
                                "text": "„PolitikerInnen [sic] und Medien ereifern sich über «Flüchtlingswellen», die sich über die Schweiz «ergiessen» könnten.“"
                            },
                            {
                                "example_id": "3728cdec-9fcf-44ec-b236-aa2f6ac85a30",
                                "sense_id": "6132fa2b-e79c-33eb-90f0-f0ca297a56f6",
                                "text": "„Von der aktuellen Flüchtlingswelle nach Europa waren, nach allem, was ich aus meiner alten Heimat hörte, vor allem Russen betroffen, obwohl die in Russland niemanden aufzunehmen brauchten.“"
                            },
                            {
                                "example_id": "e0c8723c-5684-4ad5-ad9f-b57606bd1b78",
                                "sense_id": "6132fa2b-e79c-33eb-90f0-f0ca297a56f6",
                                "text": "„Die aktuellen Flüchtlingswellen sind dabei noch gar nicht berücksichtigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
