                        ],
                        "examples": [
                            {
                                "example_id": "4d6d0c09-964e-451c-a260-9dfbf021510f",
                                "sense_id": "59a4a018-a813-3cf3-927f-80a991f3aedf",
                                "text": "Dans l’attentive et bien-apprise\nJ’ai vu feuilloler nos forêts."
                            },
                            {
                                "example_id": "805f655e-a34a-42cb-8e40-9ca6a6c99b98",
                                "sense_id": "59a4a018-a813-3cf3-927f-80a991f3aedf",
                                "text": "Ils s’embrassent à bouches folles\nDevant des sites ingénus\nOù sous les roses qui feuillolent\nDe beaux dieux roses dansent nus"
                            }
                        ]
