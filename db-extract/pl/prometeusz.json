                    {
                        "sense_id": "b1ac5464-2699-35ab-ae5f-aa8c0322bd12",
                        "entry_id": "2472d3a6-e5bb-304d-b66f-48f3add6abcf",
                        "glosses": [
                            "tytan, opiekun ludzi, dla których to wykradł bogom olimpijskim ogień"
                        ],
                        "tags": [
                            "Ancient-Greek"
                        ],
                        "examples": [
                            {
                                "example_id": "faba22d6-f85c-4d83-b070-761b0a1c4892",
                                "sense_id": "b1ac5464-2699-35ab-ae5f-aa8c0322bd12",
                                "text": "Gdy Prometeusz, jak nam wieść niesie daleka, • Wziąwszy kawałek gliny ulepił z niej człeka, • Tak był doskonałością pupki tej przejęty • Iż chciał ją widzieć pierwszą pomiędzy zwierzęty"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
