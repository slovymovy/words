                ],
                "senses": [
                    {
                        "sense_id": "88557941-a3c2-3daf-bc14-e29560460647",
                        "entry_id": "afa20061-5978-313c-9a8e-d869921494c3",
                        "glosses": [
                            "wcielenie jako dobrowolne, zbawcze samouniżenie się Chrystusa, poprzez wyrzeczenie się atrybutów Bożych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d48dc4a-7bfe-445e-b755-809151b0e453",
                                "sense_id": "88557941-a3c2-3daf-bc14-e29560460647",
                                "text": "Gdy mówimy o kenozie, często skupiamy się na tym co Jezus porzucił. Kenoza dotyczy również tego, co Chrystus przyjął"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "2f0c2044-b557-317b-8dbe-e5e4cf3319ab",
                        "entry_id": "afa20061-5978-313c-9a8e-d869921494c3",
                        "glosses": [
                            "zstąpienie Ducha Świętego i jego przebywanie w Kościele"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acffeb39-7113-463a-b4f0-696f2b435343",
                                "sense_id": "2f0c2044-b557-317b-8dbe-e5e4cf3319ab",
                                "text": "Duch dostosowuje się do tego ludzkiego sposobu postępowania i dlatego nie rozwala instytucji swoją nieograniczoną mocą, ale działa w nich uniżając się, wchodząc w kenozę"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bbd57c9b-553f-4c31-82b3-5aa75d98a660",
                        "source_entry_id": "afa20061-5978-313c-9a8e-d869921494c3",
                        "source_sense_id": "88557941-a3c2-3daf-bc14-e29560460647",
                        "target_lang_word": "kenosis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kenosis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "19362c2b-e335-30dd-83fd-29c6a12594c2",
                                        "entry_id": "9a650cb0-28f3-385e-b6eb-dc5ce192d75b",
                                        "glosses": [
                                            "Christ's voluntary abasement consisting of humanity and the simultaneous occultation of the Divinity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4197eb67-9b4f-4244-bf15-bb235a022e73",
                                                "sense_id": "19362c2b-e335-30dd-83fd-29c6a12594c2",
                                                "text": "So then, kenosis is the general way in which God interacts with the world. It is interesting to ponder that the term kenosis is most frequently linked to Christ's voluntary renunciation of certain divine attributes in order to identify himself with mankind, as recorded in the Pauline hymn found in Phil 2:5–11."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b5413804-dfa3-46e7-9c10-ae4a54f1a228",
                        "source_entry_id": "afa20061-5978-313c-9a8e-d869921494c3",
                        "source_sense_id": "88557941-a3c2-3daf-bc14-e29560460647",
                        "target_lang_word": "kénose",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kénose",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fd774ada-b009-35fb-8c94-4367568c1a6b",
                                        "entry_id": "168b0470-370a-33e4-85b9-370d1fbf145e",
                                        "glosses": [
                                            "Mouvement d’abaissement par lequel Jésus-Christ quitta ses attributs divins pour rejoindre l’humanité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a67d71e-b31d-4a98-87db-c5113c25e2fa",
                                                "sense_id": "fd774ada-b009-35fb-8c94-4367568c1a6b",
                                                "text": "Plus qu’un contenu confessionnel, il s’agit pour eux de penser la logique de la kénose du Verbe selon son incarnation dans l’histoire humaine de Jésus de Nazareth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
