        "nl-extract.jsonl": [
            {
                "entry_id": "20418e6a-a1d4-3a44-9bbf-b5a7ed80f5a7",
                "word": "theologie",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4b0dff34-bfa4-3e1c-ad65-964a6a0b3007",
                        "entry_id": "20418e6a-a1d4-3a44-9bbf-b5a7ed80f5a7",
                        "glosses": [
                            "de leer over God, het goddelijke en de godsdienst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde0136b-c391-454e-ad9c-43bb98e0d5a8",
                                "sense_id": "4b0dff34-bfa4-3e1c-ad65-964a6a0b3007",
                                "text": "Velen hielden zich vroeger bezig met pastorale theologie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bdfa5ff-1ec1-427a-9d64-609500e707d3",
                        "source_entry_id": "20418e6a-a1d4-3a44-9bbf-b5a7ed80f5a7",
                        "source_sense_id": "4b0dff34-bfa4-3e1c-ad65-964a6a0b3007",
                        "source_sense_description": "de leer over God, het goddelijke en de godsdienst",
                        "target_lang_word": "Theologie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Theologie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b3a8f0-1662-3c57-b2a0-7036d7cc7452",
                                        "entry_id": "5649ad96-b08a-32b6-ae44-953b45b7a95e",
                                        "glosses": [
                                            "Religionslehre; Erforschung und Lehre einer Religion; die Lehre von Gott"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad9aa9b0-67da-41b3-91e3-982b955a3bbf",
                                                "sense_id": "c9b3a8f0-1662-3c57-b2a0-7036d7cc7452",
                                                "text": "Theologie ist an vielen Universitäten ein eigenes Studienfach."
                                            },
                                            {
                                                "example_id": "b510a3af-aa27-45fe-8de0-136d1f9f6cb6",
                                                "sense_id": "c9b3a8f0-1662-3c57-b2a0-7036d7cc7452",
                                                "text": "„Auf einem anderen Blatt steht aber, daß jegliche Theologie mehr Probleme stellt, als sie zu lösen vermag.“"
                                            },
                                            {
                                                "example_id": "c84767e4-ecda-4fe0-a6bf-6430d3bc84b9",
                                                "sense_id": "c9b3a8f0-1662-3c57-b2a0-7036d7cc7452",
                                                "text": "„Wir sahen auch junge, ernste Menschen mit Schriften unter dem Arm gehen; das waren wohl Schüler der Theologie oder der Rechtslehre auf dem Wege zum oder vom Meister.“"
                                            },
                                            {
                                                "example_id": "e7fd0ca4-a6f2-42e3-8fb8-c0bebbb8c4ee",
                                                "sense_id": "c9b3a8f0-1662-3c57-b2a0-7036d7cc7452",
                                                "text": "„Aber darin täuschte ich mich; der gesunde Menschenverstand ist der ganzen Theologie, und besonders der spekulativen, fremd, und Stratico bewies es mir streng theologisch noch am gleichen Tag in einem Haus, in das er mich zu Abendessen mitnahm.“"
                                            },
                                            {
                                                "example_id": "f59c6998-0047-472f-b61e-ad627c5fe50e",
                                                "sense_id": "c9b3a8f0-1662-3c57-b2a0-7036d7cc7452",
                                                "text": "„Lesen und Schreiben eroberten Bereiche jenseits der Theologie: den Handel, die Diplomatie und sogar die Liebeslyrik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7b6d159-36b9-4dac-a6dc-ee8cc48dff8c",
                        "source_entry_id": "20418e6a-a1d4-3a44-9bbf-b5a7ed80f5a7",
                        "source_sense_id": "4b0dff34-bfa4-3e1c-ad65-964a6a0b3007",
                        "source_sense_description": "de leer over God, het goddelijke en de godsdienst",
                        "target_lang_word": "theology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "theology",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cc2c146-7632-3b4a-a3d8-1c120abd17cd",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "The study of God, a god, or gods; and of the truthfulness of religion in general."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1a4e0d54-de5d-3f38-858b-fd02e51041c9",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "Synonym of religious studies."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57fe9ba3-3b61-436a-bff9-f44c9bb2897c",
                                                "sense_id": "1a4e0d54-de5d-3f38-858b-fd02e51041c9",
                                                "text": "Theology is a study, but religion is an experience. Theology is the study of religion, and when we study theology we are studying religion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f5c82a17-482c-353e-af2b-280db4a00c6d",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "An organized method of interpreting spiritual works and beliefs into practical form."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3887daf3-f7b4-3764-96e2-2544aabee266",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "A particular belief within a religion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57879a74-babf-470d-85c6-1f62bf2a7448",
                                                "sense_id": "3887daf3-f7b4-3764-96e2-2544aabee266",
                                                "text": "In this context, one could conceivably hold onto the theology that baptism is essential for salvation."
                                            },
                                            {
                                                "example_id": "db145ece-2f07-4101-9387-79fc413eb3c6",
                                                "sense_id": "3887daf3-f7b4-3764-96e2-2544aabee266",
                                                "text": "Most Muslims reject the theology that Jesus died on a cross and was resurrected from the dead (though there is some ambiguity in the Qur'an on the matter), but they do hold that he ascended to heaven and will return again."
                                            },
                                            {
                                                "example_id": "b0b9ca2d-f4cb-452c-acaa-2cb65ba0400f",
                                                "sense_id": "3887daf3-f7b4-3764-96e2-2544aabee266",
                                                "text": "Another problem with the theology that Jews are chosen for a universal ethical mission is that one does not need to be Jewish to be a beacon of light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b616a1ac-db8c-3352-9914-8e77c7e46734",
                                        "entry_id": "a1e87c67-4c81-3bde-ad86-5104f6a04bca",
                                        "glosses": [
                                            "Subjective marginal details."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae6188fa-1b36-42fd-91bd-b451c6701f1b",
                                                "sense_id": "b616a1ac-db8c-3352-9914-8e77c7e46734",
                                                "text": "While those folks are caught up in theological arguments about LISP versus PROLOG, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ac549e8f-502e-4866-b7a0-b04af5b9c2a4",
                        "source_entry_id": "20418e6a-a1d4-3a44-9bbf-b5a7ed80f5a7",
                        "source_sense_id": "4b0dff34-bfa4-3e1c-ad65-964a6a0b3007",
                        "source_sense_description": "de leer over God, het goddelijke en de godsdienst",
                        "target_lang_word": "théologie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "théologie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87130a55-bd20-39af-ab94-ab363a025807",
                                        "entry_id": "eed7de81-e1c8-3d5c-8ecc-eabce5429c40",
                                        "glosses": [
                                            "Étude des choses divines, des dogmes et des préceptes religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4b385c0-c2e7-4494-a031-48edc1286141",
                                                "sense_id": "87130a55-bd20-39af-ab94-ab363a025807",
                                                "text": "Comme aucun Théologien Luthérien n'étoit plus zélé pour l'ancienne doctrine que MATHIEU FLACIUS , l'ennemi invétéré de MÉLANCTHON , & de tous les Philippistes, il fut nommé, l'an 1557, Professeur de Théologie à Jene. Les suites de cette nomination furent des plus déplorables : […]."
                                            },
                                            {
                                                "example_id": "07b72ef6-dc83-4a3f-acee-ff31aaa127c3",
                                                "sense_id": "87130a55-bd20-39af-ab94-ab363a025807",
                                                "text": "M. Pierre-Nicolas Anot, prêtre, docteur en théologie, chanoine, théologal et grand-pénitencier de Reims, est mort le 21 octobre dernier, âgé de près de 61 ans."
                                            },
                                            {
                                                "example_id": "7c18a334-b8b6-462e-acbf-b833460f4c37",
                                                "sense_id": "87130a55-bd20-39af-ab94-ab363a025807",
                                                "text": "On raconte qu'un professeur de théologie fut, à raison de quelque proposition hétérodoxe, suspendu et mis en prison, où il resta un an."
                                            },
                                            {
                                                "example_id": "30c8d686-6a0f-40d8-89bb-abb7762531ef",
                                                "sense_id": "87130a55-bd20-39af-ab94-ab363a025807",
                                                "text": "Tout entière construction du XIIIᵉ siècle, la théologie ressemble à une cathédrale gothique : elle en a la grandeur, les vides immenses et le peu de solidité."
                                            },
                                            {
                                                "example_id": "1d18f2c5-e55e-432c-8df4-7cef8b37b174",
                                                "sense_id": "87130a55-bd20-39af-ab94-ab363a025807",
                                                "text": "[…]; les gens des hautes classes ont toujours estimé qu'ils avaient moins besoin d'être disciplinés moralement que leurs subordonnés, et c'est pour avoir fait de cette belle découverte la base de leur théologie, que des jésuites ont tant de succès dans la bourgeoisie contemporaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e827d5e-0192-3860-8769-0fefe73895d7",
                                        "entry_id": "eed7de81-e1c8-3d5c-8ecc-eabce5429c40",
                                        "glosses": [
                                            "Dogmes admis dans les religions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "419ae4a7-e581-4405-903e-913d43fc7a7a",
                                                "sense_id": "7e827d5e-0192-3860-8769-0fefe73895d7",
                                                "text": "La théologie des mahométans, des Indiens."
                                            },
                                            {
                                                "example_id": "1954c161-eb8d-4983-b2f8-c503ea2f2614",
                                                "sense_id": "7e827d5e-0192-3860-8769-0fefe73895d7",
                                                "text": "Théologie naturelle se dit de ce que la raison nous apprend de l’existence et des attributs de Dieu, et des vérités premières et fondamentales de la philosophie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee8e93e1-a941-3855-9f9e-0caae19b41a7",
                                        "entry_id": "eed7de81-e1c8-3d5c-8ecc-eabce5429c40",
                                        "glosses": [
                                            "Doctrine théologique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecdd4326-5531-4ffc-98fd-ed77e03d0529",
                                                "sense_id": "ee8e93e1-a941-3855-9f9e-0caae19b41a7",
                                                "text": "Toute théologie morale se divise nécessairement en deux tendances : il y a des casuistes pour dire qu'il faut se contenter des opinions ayant une légère probabilité ; d'autres veulent qu'on adopte toujours l'avis le plus sévère et le plus sûr."
                                            },
                                            {
                                                "example_id": "324aead6-5c7a-4240-bbb7-a6e4cfc322f3",
                                                "sense_id": "ee8e93e1-a941-3855-9f9e-0caae19b41a7",
                                                "text": "L'attitude de la théologie chrétienne à l'égard des juifs a été fixée dans le début du IVᵉ siècle (concile de Nicée, 325) : le judaïsme ne doit pas disparaître, il doit vivre, mais dans un état d'avilissement et de misère tel qu'il fasse nettement apparaître aux yeux des croyants comme des incroyants le châtiment infligé par Dieu à ceux qui n'ont pas voulu reconnaître la divinité de Jésus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "980c1fc2-8c3d-35f5-a21e-7d1ba00f561c",
                                        "entry_id": "eed7de81-e1c8-3d5c-8ecc-eabce5429c40",
                                        "glosses": [
                                            "Opinions particulières, plus ou moins reçues, parmi les écrivains ecclésiastiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "529b9114-d9fc-46ef-a231-991ed3ae50c1",
                                                "sense_id": "980c1fc2-8c3d-35f5-a21e-7d1ba00f561c",
                                                "text": "Plusieurs pères ont contredit sur ce point la théologie de saint Irénée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b122f1-d5ce-3d00-8f2b-325881e55f5f",
                                        "entry_id": "eed7de81-e1c8-3d5c-8ecc-eabce5429c40",
                                        "glosses": [
                                            "Recueil des ouvrages théologiques d’un auteur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dbbc3f9-1b83-4241-a3dc-1ad78fdc93ff",
                                                "sense_id": "12b122f1-d5ce-3d00-8f2b-325881e55f5f",
                                                "text": "Théologie de Bellarmin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
