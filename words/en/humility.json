                {
                    "sense_id": "8866ec4e-911c-36db-9d70-e67427c4d839",
                    "sense_definition": "The quality of being humble and modest, without excessive pride or arrogance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She accepted the award with great <w>humility</w> and thanked her team for their support.",
                            "target_lang_translations": {
                                "tr": "Ödülü büyük bir <w>alçakgönüllülükle</w> kabul etti ve desteği için ekibine teşekkür etti.",
                                "zh": "她怀着极大的<w>谦逊</w>接受了奖项，并感谢了团队的支持。"
                            }
                        },
                        {
                            "text": "His genuine <w>humility</w> made him popular among his coworkers and friends.",
                            "target_lang_translations": {
                                "tr": "Onun samimi <w>alçakgönüllülüğü</w>, iş arkadaşları ve dostları arasında popüler olmasını sağladı.",
                                "zh": "他真诚的<w>谦卑</w>使他在同事和朋友中很受欢迎。"
                            }
                        }
                    ],
                    "synonyms": [
                        "modesty",
                        "meekness",
                        "self-effacement",
                        "egolessness"
                    ],
                    "antonyms": [
                        "pride"
                    ],
                    "common_phrases": [
                        "great humility",
                        "true humility"
                    ],
                    "target_lang_definitions": {
                        "tr": "Aşırı gurur veya kibirden uzak, alçakgönüllü ve mütevazı olma durumu.",
                        "zh": "指不自大、不傲慢，保持谦逊和低调的品质。"
                    },
