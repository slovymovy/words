        "fr-extract.jsonl": [
            {
                "entry_id": "77a49afe-0486-31a2-9c20-93b8ba8c1c60",
                "word": "solidairement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                        "entry_id": "77a49afe-0486-31a2-9c20-93b8ba8c1c60",
                        "glosses": [
                            "D’une façon solidaire, d’une manière où chacun répond pour le tout."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d1f70a5-c94c-45d9-9915-c64d75198a60",
                                "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                "text": "Une bonne amende de mille écus, à quoi vous êtes solidairement condamnée avec votre M. le baron,"
                            },
                            {
                                "example_id": "1230fa78-a995-4dd3-8525-ea17d60b613f",
                                "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                "text": "Dès lors [depuis que Henri IV prit un jésuite pour confesseur] chaque frère jésuite se crut solidairement confesseur du roi,"
                            },
                            {
                                "example_id": "7d2484b4-ae63-4666-b8c1-063b41092638",
                                "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                "text": "Dans les sociétés autres que celles de commerce, les associés ne sont pas tenus solidairement des dettes sociales,"
                            },
                            {
                                "example_id": "7edc5efe-46c1-408b-b9f4-291e6dcb84d1",
                                "sense_id": "6375dfb2-9088-35a3-9e66-51c3ff8af8ff",
                                "text": "Si plusieurs ont conjointement emprunté la même chose, ils en sont solidairement responsables envers le prêteur,"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84003831-895c-455e-b495-76945b216d5d",
                        "source_entry_id": "77a49afe-0486-31a2-9c20-93b8ba8c1c60",
