                ],
                "senses": [
                    {
                        "sense_id": "56fa4da8-b2c3-300d-933f-813c6c331a4d",
                        "entry_id": "d7fa5953-4c93-31b5-b89e-ffa8c999bb9e",
                        "glosses": [
                            "Améliorer le goût de (quelque chose) grâce à des condiments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "71b48617-3510-4b8e-9ff0-9b7fe14b98a5",
                                "sense_id": "56fa4da8-b2c3-300d-933f-813c6c331a4d",
                                "text": "Les Orientaux, ainsi que les peuples du Nord de l'Europe, en font un grand usage pour condimenter leurs mets et pâtisseries."
                            },
                            {
                                "example_id": "88d8dd76-9ec6-4230-81c8-67a68b942395",
                                "sense_id": "56fa4da8-b2c3-300d-933f-813c6c331a4d",
                                "text": "Assaisonner et condimenter ne sont pas choses semblables."
                            },
                            {
                                "example_id": "d9b85909-1296-4f0e-836c-fc9db06261f1",
                                "sense_id": "56fa4da8-b2c3-300d-933f-813c6c331a4d",
                                "text": "Les ironistes impitoyables pourront se payer l’audace de condimenter leurs boulettes avec leur épice décisive, pour peu qu’ils aient poussé la bravade jusqu’à conserver par-devers eux cette preuve accablante."
                            }
                        ]
                    }
