                "senses": [
                    {
                        "sense_id": "8c85e350-46f3-3570-b24e-037553187805",
                        "entry_id": "dd7d0ee6-b5ce-3f4f-a379-f4ed3ee90376",
                        "glosses": [
                            "nieudanie się jakiejś sprawy, niepowodzenie się czegoś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41aea4fa-c21b-483e-805a-f2e6c748f422",
                                "sense_id": "8c85e350-46f3-3570-b24e-037553187805",
                                "text": "Próba zainteresowania mieszkańców dzielnicy kulturą i sztuką skończyła się kompletnym fiaskiem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "efe943a3-7f50-442d-89ba-f7ae54c48131",
                        "source_entry_id": "dd7d0ee6-b5ce-3f4f-a379-f4ed3ee90376",
                        "source_sense_id": "8c85e350-46f3-3570-b24e-037553187805",
                        "target_lang_word": "fiasco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiasco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e323c6b-885f-3952-8f56-d7fd2d982cae",
                                        "entry_id": "9442e23b-fabd-3679-b95b-c4e34f9fa66b",
                                        "glosses": [
                                            "A sudden or unexpected failure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e11e225-7bc8-4bd1-8fac-31343a4720df",
                                                "sense_id": "6e323c6b-885f-3952-8f56-d7fd2d982cae",
                                                "text": "The event turned into a complete fiasco when the power went out."
                                            },
                                            {
                                                "example_id": "970dbe76-0738-4e23-8526-482630125071",
                                                "sense_id": "6e323c6b-885f-3952-8f56-d7fd2d982cae",
                                                "text": "His speech was a fiasco that left the audience confused."
                                            },
                                            {
                                                "example_id": "8382c60a-5d19-4aeb-9868-f671a60e122c",
                                                "sense_id": "6e323c6b-885f-3952-8f56-d7fd2d982cae",
                                                "text": "\"Well, doctor,\" said Mr. Curtis, heartily, \"I am glad for your sake that the financial part of the enterprise has succeeded so well, because, the more I think over the scheme, the more I am convinced that it will prove a complete fiasco in practice. And that reminds me that there is one question which I wish to ask you.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09f2d55f-f9ae-3a16-b5cf-550170e76891",
                                        "entry_id": "9442e23b-fabd-3679-b95b-c4e34f9fa66b",
                                        "glosses": [
                                            "A ludicrous or humiliating situation. Some effort that went quite wrong."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00bb5bcf-eb9d-4427-851f-83db2d08fa23",
                                                "sense_id": "09f2d55f-f9ae-3a16-b5cf-550170e76891",
                                                "text": "There was the fiasco about Olga coming to the tableaux, which was the cause of her sending that very tart reply, via Miss Lyall, to Lady Ambermere's impertinence, and the very next morning, Lady Ambermere, coming again into Riseholme, perhaps for that very purpose, had behaved to Lucia as Lucia had behaved to the moon, and cut her. That was irritating, but the counter-irritant to it had been that Lady Ambermere had then gone to Olga's, and been told that she was not at home, though she was very audibly practising in her music-room at the time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24bb98e8-fac6-35ec-aced-ec0fdf476c61",
                                        "entry_id": "9442e23b-fabd-3679-b95b-c4e34f9fa66b",
                                        "glosses": [
                                            "A wine bottle in a (usually straw) jacket."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f6a304-e7f1-4ccb-8ddc-7c572dd70f3b",
                                                "sense_id": "24bb98e8-fac6-35ec-aced-ec0fdf476c61",
                                                "text": "I sent for the porter and when he came I told him in Italian to get me a bottle of Cinzano at the wine shop, a fiasco of chianti and the evening papers. He went away and brought them wrapped in newspaper, unwrapped them and, when I asked him to, drew the corks and put the wine and vermouth under the bed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97a3041b-5514-4bdc-b0be-05b016867b77",
                        "source_entry_id": "dd7d0ee6-b5ce-3f4f-a379-f4ed3ee90376",
                        "source_sense_id": "8c85e350-46f3-3570-b24e-037553187805",
                        "target_lang_word": "fiasko",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiasko",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "138580a3-f3d7-3834-a3da-3dc01d6f0ec8",
                                        "entry_id": "b38c260a-d683-3251-9e77-6dfefee7dd5b",
                                        "glosses": [
                                            "trapné či ponižující selhání"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "766d8a7a-f541-48a1-b77b-ebf51f526bb9",
                        "source_entry_id": "dd7d0ee6-b5ce-3f4f-a379-f4ed3ee90376",
                        "source_sense_id": "8c85e350-46f3-3570-b24e-037553187805",
                        "target_lang_word": "fiasco",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fiasco",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0a1c9c0c-1a99-3abc-bdbd-a04b921b7df0",
                                        "entry_id": "3e9f7f68-7c54-3baf-9abd-0027d4caedc3",
                                        "glosses": [
                                            "Échec complet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a6f591-8455-4555-8bfb-8e3322e8a853",
                                                "sense_id": "0a1c9c0c-1a99-3abc-bdbd-a04b921b7df0",
                                                "text": "Si Hostrup faisait marche arrière aujourd'hui, toutes les mésaventures qu'il avait subies pour faire plier Mørk n'auraient plus aucun sens et rimeraient tout au plus avec fiasco. Hostrup ne pouvait plus faire marche arrière."
                                            },
                                            {
                                                "example_id": "f17cf216-6793-455c-987e-bb1da3845107",
                                                "sense_id": "0a1c9c0c-1a99-3abc-bdbd-a04b921b7df0",
                                                "text": "Notre révolution a été un fiasco ; la preuve, après trente années d’indépendance, c’est la régression, le totalitarisme, le règne de la médiocrité."
                                            },
                                            {
                                                "example_id": "89891d3c-6692-45a1-b237-e2c4c86ae6a3",
                                                "sense_id": "0a1c9c0c-1a99-3abc-bdbd-a04b921b7df0",
                                                "text": "Une colo tourne au fiasco."
                                            },
                                            {
                                                "example_id": "9eb98003-8666-4c00-9abd-10ac2dd2150b",
                                                "sense_id": "0a1c9c0c-1a99-3abc-bdbd-a04b921b7df0",
                                                "text": "À les en croire, le chef de l’État, qui s’avère, à l’usage, être redoutablement rancunier, reproche encore à Le Maire d’avoir commandé à son ancienne maison, l’Inspection générale des finances, un rapport sur le fiasco à 10 milliards de la taxe sur les dividendes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "595d6e6d-765d-3236-8fe5-a77199667439",
                                        "entry_id": "3e9f7f68-7c54-3baf-9abd-0027d4caedc3",
                                        "glosses": [
                                            "Défaillance sexuelle masculine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c2836d-a782-44ea-aa8d-fe626ca60105",
                                                "sense_id": "595d6e6d-765d-3236-8fe5-a77199667439",
                                                "text": "Nous parlions ce soir de fiasco à l’état-major du général Michaud, cinq très-beaux jeunes gens de vingt-cinq à trente ans et moi. Il s’est trouvé que, à l’exception d’un fat, qui probablement n’a pas dit vrai, nous avions tous fait fiasco la première fois avec nos maîtresses les plus célèbres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc27f6b-6a87-38b6-9b52-b2dcba2591e9",
                                        "entry_id": "3e9f7f68-7c54-3baf-9abd-0027d4caedc3",
                                        "glosses": [
                                            "Flasque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81f5af12-395d-4944-b476-0a84d1c8b131",
                                                "sense_id": "5dc27f6b-6a87-38b6-9b52-b2dcba2591e9",
                                                "text": "On se battit même à coup de fiascos pleins de vin d’Italie, qui portaient une date vénérable."
                                            },
                                            {
                                                "example_id": "a2d1bc03-2243-4896-a6fb-ddda81706eee",
                                                "sense_id": "5dc27f6b-6a87-38b6-9b52-b2dcba2591e9",
                                                "text": "Il y a aussi des mouches ; il y en a partout, jusque dans la paille des fiascos."
                                            },
                                            {
                                                "example_id": "8a79f579-998a-44c8-bcc9-9f9b507f2d56",
                                                "sense_id": "5dc27f6b-6a87-38b6-9b52-b2dcba2591e9",
                                                "text": "Sur la table, entre elles, il y avait un énorme plat de cannellonis et un fiasco de chianti."
                                            },
                                            {
                                                "example_id": "59f65d54-9cb5-41b2-bc0b-95e2540c7d7a",
                                                "sense_id": "5dc27f6b-6a87-38b6-9b52-b2dcba2591e9",
                                                "text": "Près de ces pois chiches, Peppino posa encore un joli petit panier de raisin de Velletri et un fiasco de vin d’Orvietto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
