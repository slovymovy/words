                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ауспиция",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ea688e-6914-3d59-ba46-11171871023b",
                                        "entry_id": "937a84ac-0be1-33e4-9751-b58c27ba5f32",
                                        "glosses": [
                                            "в Древнем Риме предсказание будущего по полёту птиц или их поведению"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a261b50-4e8f-46cb-819d-4e674630071a",
                                                "sense_id": "d3ea688e-6914-3d59-ba46-11171871023b",
                                                "text": "Но знаки славы в тайнах ауспиций // Не скрыты от прозрительных умов, // Когда с пустых вершин твоих холмов // Взлетели с криком царственные птицы."
                                            },
                                            {
                                                "example_id": "cbe5c76d-1b1c-43fa-8aa7-3e3f642b4b93",
                                                "sense_id": "d3ea688e-6914-3d59-ba46-11171871023b",
                                                "text": "Во второй половине XIX века датский учёный И. Валетон сделал вывод о том, что ауспиции относятся к категории signa oblata — непрошеным знакам, а авгурии причисляются к signa imperativa, т.е. к заранее намеченным знакам."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abdb7bb3-827d-3a85-9003-ecba90f19bb2",
                                        "entry_id": "937a84ac-0be1-33e4-9751-b58c27ba5f32",
                                        "glosses": [
                                            "любое гадание и предсказание"
                                        ],
                                        "tags": [
                                            "расширительно"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "618c7c9e-e07f-4bfd-a33a-56d46e7b73d8",
                                                "sense_id": "abdb7bb3-827d-3a85-9003-ecba90f19bb2",
                                                "text": "Ослы бодро помахивали хвостиками. Это ауспиция благоприятная."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
