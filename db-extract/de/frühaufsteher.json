                                        "entry_id": "48966837-034e-3066-86c7-4d7544d7010b",
                                        "glosses": [
                                            "ptaszek, który odniósł ranę"
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5f0b4736-6bf7-41f1-8eb8-6d50727f9294",
                                                "sense_id": "29fdc267-7000-320f-85cb-12a536ccaffd",
                                                "text": "Jacek znalazł w lesie rannego ptaszka, wykurował i oswoił."
                                            }
                                        ],
