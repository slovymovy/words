{
    "word_family": [
        "baiter",
        "clickbait",
        "jailbait",
        "race-baiting",
        "queerbaiting"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "aac6a975-af65-36d6-ab9c-7ee6caebc5f9",
                    "sense_definition": "Any substance, especially food, used in catching fish or other animals by alluring them to a hook, snare, trap, or net.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fisherman placed a worm on the hook as <w>bait</w>.",
                            "target_lang_translations": {
                                "ru": "Рыбак насадил червя на крючок в качестве <w>наживки</w>.",
                                "de": "Der Fischer steckte einen Wurm als <w>Köder</w> auf den Haken.",
                                "zh": "渔夫把一条虫子挂在钩子上当作<w>鱼饵</w>。"
                            }
                        },
                        {
                            "text": "We used cheese as <w>bait</w> to catch the mouse in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Мы использовали сыр как <w>приманку</w>, чтобы поймать мышь на кухне.",
                                "de": "Wir benutzten Käse als <w>Köder</w>, um die Maus in der Küche zu fangen.",
                                "zh": "我们用奶酪做<w>诱饵</w>来捕捉厨房里的老鼠。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lure"
                    ],
                    "common_phrases": [
                        "take the bait",
                        "live bait",
                        "cut bait"
                    ],
                    "target_lang_definitions": {
                        "ru": "Еда или вещество, используемое для привлечения рыбы или животных в ловушку.",
                        "de": "Ein Köder oder eine Substanz, die verwendet wird, um Fische oder Tiere in eine Falle oder an einen Haken zu locken.",
                        "zh": "用于诱捕鱼类或其他动物的食物或物质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наживка",
                                "target_lang_sense_clarification": "для ловли рыбы на крючок"
                            },
                            {
                                "target_lang_word": "приманка",
                                "target_lang_sense_clarification": "для ловушек и капканов"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Köder",
                                "target_lang_sense_clarification": "allgemeiner Begriff für Lockmittel bei der Jagd oder Fischerei"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鱼饵",
                                "target_lang_sense_clarification": "专门用于钓鱼的诱饵"
                            },
                            {
                                "target_lang_word": "诱饵",
                                "target_lang_sense_clarification": "用于捕捉动物的通用诱饵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fe67cbf6-4928-34b8-88cd-f8b679263a77",
                    "sense_definition": "Something used to lure or entice someone into doing something, often by deception.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The low price was just <w>bait</w> to get customers into the store.",
                            "target_lang_translations": {
                                "ru": "Низкая цена была лишь <w>приманкой</w>, чтобы завлечь покупателей в магазин.",
                                "de": "Der niedrige Preis war nur ein <w>Köder</w>, um Kunden in den Laden zu locken.",
                                "zh": "低价只是把顾客引诱进店的<w>诱饵</w>。"
                            }
                        },
                        {
                            "text": "He refused to take the <w>bait</w> when his brother tried to start an argument.",
                            "target_lang_translations": {
                                "ru": "Он отказался заглатывать <w>наживку</w>, когда брат попытался затеять ссору.",
                                "de": "Er weigerte sich, auf den <w>Köder</w> anzubeißen, als sein Bruder versuchte, einen Streit anzufangen.",
                                "zh": "当他哥哥试图挑起争吵时，他拒绝<w>上钩</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "deterrent"
                    ],
                    "common_phrases": [
                        "rise to the bait",
                        "swallow the bait"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, используемое для заманивания или обмана кого-либо.",
                        "de": "Etwas, das benutzt wird, um jemanden durch Täuschung oder Verlockung zu einer Handlung zu bewegen.",
                        "zh": "用来引诱某人做某事的东西，通常带有欺骗性质。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приманка",
                                "target_lang_sense_clarification": "средство завлечения"
                            },
                            {
                                "target_lang_word": "наживка",
                                "target_lang_sense_clarification": "в переносном смысле (проглотить наживку)"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Köder",
                                "target_lang_sense_clarification": "im übertragenen Sinne für ein Lockmittel"
                            },
                            {
                                "target_lang_word": "Lockmittel",
                                "target_lang_sense_clarification": "etwas, das jemanden anlockt"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诱饵",
                                "target_lang_sense_clarification": "比喻引诱人的手段"
                            },
                            {
                                "target_lang_word": "圈套",
                                "target_lang_sense_clarification": "引诱人上当的陷阱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b13855f1-362f-391d-912e-b8e3bab00e55",
                    "sense_definition": "A post or comment on the internet intended to elicit a strong or negative reaction from others.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't reply to that comment; it is obvious <w>bait</w> for trolls.",
                            "target_lang_translations": {
                                "ru": "Не отвечай на этот комментарий, это очевидная <w>провокация</w> для троллей.",
                                "de": "Antworte nicht auf diesen Kommentar; das ist offensichtliche <w>Provokation</w> für Trolle.",
                                "zh": "别回复那条评论，那显然是给喷子准备的<w>钓鱼贴</w>。"
                            }
                        },
                        {
                            "text": "The headline was pure <w>bait</w> designed to make people angry.",
                            "target_lang_translations": {
                                "ru": "Заголовок был чистой <w>провокацией</w>, созданной, чтобы разозлить людей.",
                                "de": "Die Schlagzeile war reine <w>Provokation</w>, die darauf abzielte, die Leute wütend zu machen.",
                                "zh": "这个标题纯粹是为了激怒人们而设计的<w>引战</w>内容。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "internet slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщение в интернете, созданное для провокации конфликта или бурной реакции.",
                        "de": "Ein Beitrag oder Kommentar im Internet, der darauf abzielt, eine starke oder negative Reaktion hervorzurufen.",
                        "zh": "互联网上旨在引起他人强烈或负面反应的帖子或评论。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провокация",
                                "target_lang_sense_clarification": "действие с целью вызвать реакцию"
                            },
                            {
                                "target_lang_word": "байт",
                                "target_lang_sense_clarification": "интернет-сленг"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Provokation",
                                "target_lang_sense_clarification": "absichtliches Reizen zur Reaktion"
                            },
                            {
                                "target_lang_word": "Clickbait",
                                "target_lang_sense_clarification": "reißerische Inhalte zur Klickgenerierung"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "钓鱼贴",
                                "target_lang_sense_clarification": "互联网俚语，指故意引战的帖子"
                            },
                            {
                                "target_lang_word": "引战",
                                "target_lang_sense_clarification": "故意挑起争论的行为"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9484e395-ee38-3bad-88da-14fc3a71c4b4",
                    "sense_definition": "To affix food or a lure to a hook, trap, or fishing line.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>baited</w> the hook with a small fish before casting his line.",
                            "target_lang_translations": {
                                "ru": "Он <w>наживил</w> крючок маленькой рыбкой, прежде чем забросить леску.",
                                "de": "Er <w>köderte</w> den Haken mit einem kleinen Fisch, bevor er die Angel auswarf.",
                                "zh": "他在抛线前给鱼钩<w>上</w>了一条小鱼作为诱饵。"
                            }
                        },
                        {
                            "text": "You need to <w>bait</w> the trap with peanut butter to catch the rat.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно <w>положить приманку</w> из арахисового масла в ловушку, чтобы поймать крысу.",
                                "de": "Du musst die Falle mit Erdnussbutter <w>bestücken</w>, um die Ratte zu fangen.",
                                "zh": "你需要往陷阱里<w>放</w>花生酱作为诱饵来抓那只老鼠。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bait the hook",
                        "bait a trap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Насаживать еду на крючок или класть приманку в ловушку.",
                        "de": "Einen Köder an einem Haken oder in einer Falle befestigen.",
                        "zh": "在鱼钩、陷阱或钓线上放置食物或诱饵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наживлять",
                                "target_lang_sense_clarification": "насаживать на крючок"
                            },
                            {
                                "target_lang_word": "класть приманку",
                                "target_lang_sense_clarification": "в ловушку"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ködern",
                                "target_lang_sense_clarification": "mit einem Köder versehen"
                            },
                            {
                                "target_lang_word": "bestücken",
                                "target_lang_sense_clarification": "eine Falle mit einem Köder ausstatten"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上饵",
                                "target_lang_sense_clarification": "在鱼钩上挂饵"
                            },
                            {
                                "target_lang_word": "放置诱饵",
                                "target_lang_sense_clarification": "在陷阱中放入诱饵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4bdea11-4027-3167-9971-cfb4162e3056",
                    "sense_definition": "To intentionally annoy, torment, or harass someone, often to provoke a reaction.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The older students used to <w>bait</w> him about his accent.",
                            "target_lang_translations": {
                                "ru": "Старшеклассники раньше <w>дразнили</w> его из-за акцента.",
                                "de": "Die älteren Schüler haben ihn früher wegen seines Akzents <w>gereizt</w>.",
                                "zh": "高年级的学生过去常因为他的口音而<w>挑衅</w>他。"
                            }
                        },
                        {
                            "text": "She tried to <w>bait</w> me into losing my temper, but I stayed calm.",
                            "target_lang_translations": {
                                "ru": "Она пыталась <w>спровоцировать</w> меня, чтобы я вышел из себя, но я оставался спокоен.",
                                "de": "Sie versuchte, mich zu <w>provozieren</w>, damit ich die Beherrschung verliere, aber ich blieb ruhig.",
                                "zh": "她试图<w>激怒</w>我让我发火，但我保持了冷静。"
                            }
                        }
                    ],
                    "synonyms": [
                        "harass",
                        "pester",
                        "badger",
                        "hound",
                        "plague",
                        "vex",
                        "bedevil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Намеренно раздражать или мучить кого-то, часто чтобы вызвать реакцию.",
                        "de": "Jemanden absichtlich ärgern, quälen oder belästigen, oft um eine Reaktion zu provozieren.",
                        "zh": "故意激怒、折磨或骚扰某人，通常是为了引发对方的反应。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дразнить",
                                "target_lang_sense_clarification": "насмехаться"
                            },
                            {
                                "target_lang_word": "провоцировать",
                                "target_lang_sense_clarification": "вызывать на конфликт"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "provozieren",
                                "target_lang_sense_clarification": "jemanden gezielt reizen"
                            },
                            {
                                "target_lang_word": "reizen",
                                "target_lang_sense_clarification": "jemanden ärgern oder herausfordern"
                            },
                            {
                                "target_lang_word": "schikanieren",
                                "target_lang_sense_clarification": "jemanden durch ständige Belästigung quälen"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挑衅",
                                "target_lang_sense_clarification": "故意激怒他人"
                            },
                            {
                                "target_lang_word": "戏弄",
                                "target_lang_sense_clarification": "嘲弄或捉弄他人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f35566a4-bfab-39e1-9af9-dd3953b729dd",
                    "sense_definition": "To set dogs on an animal to bite or worry it, especially for sport.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In medieval times, people would <w>bait</w> bears for entertainment.",
                            "target_lang_translations": {
                                "ru": "В средневековье люди <w>травили</w> медведей ради развлечения.",
                                "de": "Im Mittelalter <w>hetzten</w> die Menschen Bären zur Unterhaltung.",
                                "zh": "在中世纪，人们会<w>放狗咬</w>熊来取乐。"
                            }
                        },
                        {
                            "text": "It is illegal to <w>bait</w> animals in modern society.",
                            "target_lang_translations": {
                                "ru": "В современном обществе запрещено <w>травить</w> животных.",
                                "de": "Es ist in der modernen Gesellschaft illegal, Tiere zu <w>hetzen</w>.",
                                "zh": "在现代社会，<w>虐待</w>动物是违法的。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Натравливать собак на животное для развлечения.",
                        "de": "Tiere (oft Hunde) auf ein anderes Tier hetzen, meist zur Unterhaltung.",
                        "zh": "指使狗去撕咬或骚扰动物，通常作为一种娱乐活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "натравливать собак"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "hetzen",
                                "target_lang_sense_clarification": "Tiere auf jemanden oder etwas loslassen"
                            },
                            {
                                "target_lang_word": "abrichten",
                                "target_lang_sense_clarification": "historisch im Kontext der Tierhatz"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放狗咬",
                                "target_lang_sense_clarification": "指使狗攻击"
                            },
                            {
                                "target_lang_word": "围猎",
                                "target_lang_sense_clarification": "历史上指利用动物进行狩猎娱乐"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "efb1e2c1-f3a9-3bd5-b92b-1a3b4689d2c0",
                    "sense_definition": "Obvious or blatant.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a bit <w>bait</w> that he was lying to the teacher.",
                            "target_lang_translations": {
                                "ru": "Было немного <w>палевно</w>, что он врал учителю.",
                                "de": "Es war ziemlich <w>auffällig</w>, dass er den Lehrer anlog.",
                                "zh": "他向老师撒谎这件事表现得有点<w>显眼</w>。"
                            }
                        },
                        {
                            "text": "Try not to be so <w>bait</w> when you leave the room.",
                            "target_lang_translations": {
                                "ru": "Постарайся не быть таким <w>палевным</w>, когда будешь выходить из комнаты.",
                                "de": "Versuch, nicht so <w>auffällig</w> zu sein, wenn du den Raum verlässt.",
                                "zh": "离开房间时尽量别那么<w>显眼</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Multicultural London English"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "UK"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Очевидный или заметный (сленг).",
                        "de": "Offensichtlich oder auffällig (Slang).",
                        "zh": "明显的或公然的（俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "палевный",
                                "target_lang_sense_clarification": "сленг: очевидный, заметный"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auffällig",
                                "target_lang_sense_clarification": "leicht zu bemerken"
                            },
                            {
                                "target_lang_word": "offensichtlich",
                                "target_lang_sense_clarification": "klar erkennbar"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "显眼",
                                "target_lang_sense_clarification": "容易被察觉的"
                            },
                            {
                                "target_lang_word": "露馅",
                                "target_lang_sense_clarification": "指行为过于明显而暴露"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}