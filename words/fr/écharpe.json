            "senses": [
                {
                    "sense_id": "c86d0420-c880-38b0-bba7-4bee9950e7c1",
                    "sense_definition": "Troisième personne du singulier du présent de l'indicatif de <w>écharper</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le débat politique devient si violent que chaque orateur <w>écharpe</w> impitoyablement son adversaire."
                        },
                        {
                            "text": "Cette polémique médiatique grandit et <w>écharpe</w> la réputation du ministre en place."
