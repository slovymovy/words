                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "origine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette belle poterie <w>vient</w> directement d'un petit village italien."
                        },
                        {
                            "text": "Son grand intérêt pour la cuisine <w>vient</w> de sa grand-mère."
