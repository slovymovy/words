                        "sense_id": "a0fca7c6-7e05-3cd6-952a-421e51a8ca2f",
                        "entry_id": "f87c0df8-92f7-3271-a16c-756ca047e22b",
                        "glosses": [
                            "Beta saccharifera Beta vulgaris (subsp. vulgaris var. altissima) een biet waaruit bietsuiker gewonnen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c584f3-35a9-46a3-897d-ae141df8431d",
                                "sense_id": "a0fca7c6-7e05-3cd6-952a-421e51a8ca2f",
                                "text": "Vroeger werd er met St. Maarten wel met lampionnen van suikerbiet gelopen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "646e9fd9-edd8-4f6b-9f51-8d9dc653b59b",
                        "source_entry_id": "f87c0df8-92f7-3271-a16c-756ca047e22b",
                        "source_sense_id": "a0fca7c6-7e05-3cd6-952a-421e51a8ca2f",
                        "source_sense_description": "een biet waaruit bietsuiker gewonnen wordt",
                        "target_lang_word": "Zuckerrübe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuckerrübe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b6c9b911-3152-3450-9eba-d8dc3a077580",
                                        "entry_id": "06a0233c-9798-3669-bf1d-1a6dca025bc4",
                                        "glosses": [
                                            "Unterart der Rübe, die für die Herstellung von Zucker verwendet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8af686b7-86ea-4064-91b5-ddf28f69a170",
                                                "sense_id": "b6c9b911-3152-3450-9eba-d8dc3a077580",
                                                "text": "Die Zuckerrübe wurde zur Zuckergewinnung aus der Runkelrübe gezüchtet."
                                            },
                                            {
                                                "example_id": "1def9400-52c5-42e6-8c12-ee0066757da7",
                                                "sense_id": "b6c9b911-3152-3450-9eba-d8dc3a077580",
                                                "text": "„Bei Kulturen, die noch länger am Feld sind, wie Mais, Erdäpfel, Zuckerrübe und Sojabohne droht wegen der Trockenheit zuletzt allerdings in manchen Regionen ein Totalausfall.“"
                                            },
                                            {
                                                "example_id": "fe8a9bc6-8c5a-4f93-abca-1c11e3f93280",
                                                "sense_id": "b6c9b911-3152-3450-9eba-d8dc3a077580",
                                                "text": "„Kaum hatte die Vollerntemaschine die letzten Zuckerrüben ausgegraben, zurechtgestutzt und eingesammelt, verliess er Heim und Scholle.“"
                                            },
                                            {
                                                "example_id": "eb47194e-cfe7-47fa-b7cb-f6c8ef0097fd",
                                                "sense_id": "b6c9b911-3152-3450-9eba-d8dc3a077580",
                                                "text": "„Der Anbau von Gerste, Zuckerrüben, Sonnenblumen, Faserflachs und Rotklee ist in den letzten Jahrzehnten auf Kosten von Hafer, Futterrüben und Kartoffeln erweitert worden.“"
                                            },
                                            {
                                                "example_id": "7a4c8b17-f24b-4ff7-a3ef-c129bd04357c",
                                                "sense_id": "b6c9b911-3152-3450-9eba-d8dc3a077580",
                                                "text": "„Die Produktion von Biokraftstoff, der aus Palmöl, Weizen, Mais oder Zuckerrüben hergestellt wird, führt zu massiven Entwaldungen in Südostasien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50775109-5ce1-4264-8493-dd023cc68ad1",
                        "source_entry_id": "f87c0df8-92f7-3271-a16c-756ca047e22b",
                        "source_sense_id": "a0fca7c6-7e05-3cd6-952a-421e51a8ca2f",
                        "source_sense_description": "een biet waaruit bietsuiker gewonnen wordt",
                        "target_lang_word": "sugar beet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sugar beet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bf68bb0-5be8-36e1-9e72-fccfa12ec6b6",
                                        "entry_id": "b0ffc907-10f2-35c3-b6c3-b13a05f38b4e",
                                        "glosses": [
                                            "A type of beet whose root contains a high concentration of sucrose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14f10891-2a87-4bfe-980b-5905c96ba4a3",
                                                "sense_id": "1bf68bb0-5be8-36e1-9e72-fccfa12ec6b6",
                                                "text": "It was heading a freight train, loaded mainly with sugar beet, en route from the country area of Angus to the beet factory at Cupar (Fife)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4d5339-e7e7-3e39-a805-5b3e597fa9f5",
                                        "entry_id": "b0ffc907-10f2-35c3-b6c3-b13a05f38b4e",
                                        "glosses": [
                                            "Darling; sweetheart"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95b63c46-62f6-46da-be43-4950f0411cad",
                                                "sense_id": "7a4d5339-e7e7-3e39-a805-5b3e597fa9f5",
                                                "text": "I just want to say I wouldn't be here without the support of a very special lady- my always outrageous fiancée, Selma. Take a bow, sugar beet."
                                            },
                                            {
                                                "example_id": "0999cbf1-337f-4833-8def-88acd4e1c986",
                                                "sense_id": "7a4d5339-e7e7-3e39-a805-5b3e597fa9f5",
                                                "text": "“So is my sugar beet all tucked in?”\n“She is. Happily exhausted, too. Just like me.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a442afb-c00a-44d9-b811-242dcd79ea86",
                        "source_entry_id": "f87c0df8-92f7-3271-a16c-756ca047e22b",
                        "source_sense_id": "a0fca7c6-7e05-3cd6-952a-421e51a8ca2f",
                        "source_sense_description": "een biet waaruit bietsuiker gewonnen wordt",
                        "target_lang_word": "betterave sucrière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betterave sucrière",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "515f5acb-3c19-34f2-90af-786c9c1468aa",
                                        "entry_id": "37f61d32-214a-3019-87c9-dcf9ecfab501",
                                        "glosses": [
                                            "Betterave à sucre."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "361fb7e7-8136-4ca5-b812-5014a603244d",
                                                "sense_id": "515f5acb-3c19-34f2-90af-786c9c1468aa",
                                                "text": "Vu la sensibilité des betteraves sucrières, il n'a été utilisé que des traitements de pré-émergence."
                                            },
                                            {
                                                "example_id": "4a22804e-5002-453c-a216-f30a6cbb7308",
                                                "sense_id": "515f5acb-3c19-34f2-90af-786c9c1468aa",
                                                "text": "Mais dans les milieux grainiers de la betterave sucrière, on s'énerve à qui mieux mieux en vue de produire la graine monogerme génétique. Celle-ci existe aux États-Unis et en U.R.S.S."
                                            },
                                            {
                                                "example_id": "e0e2737f-e65f-477d-b59c-495db8d3ddd3",
                                                "sense_id": "515f5acb-3c19-34f2-90af-786c9c1468aa",
                                                "text": "Deux plantes ont une richesse en saccharose beaucoup plus importante : la canne à sucre (qui contient 20 % de saccharose), connue depuis l’Antiquité, et la betterave sucrière (dont la racine en contient 18,7 %), qui sont aujourd’hui les deux sources principales de sucre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
