                        "glosses": [
                            "Parasitose cosmopolite résultant de l’infestation de l’homme par Ascaris lumbricoides, un nématode de grande taille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a08f80e1-dd90-48fb-a34f-125d10768e52",
                                "sense_id": "1a373f54-eab5-332e-a59a-f8932cad61c4",
                                "text": "L’ascaridiose est due à un nématode (ver rond) blanc rosé de 15 à 25 cm de long lumbricoïdes."
                            },
                            {
                                "example_id": "22c60a08-5971-449f-924b-153e6808c2e1",
                                "sense_id": "1a373f54-eab5-332e-a59a-f8932cad61c4",
                                "text": "Les derniers moments de la belle Agnès [Sorel] ne sont plus ignorés : elle est atteinte d’ascaridiose, une affection due à des vers blanchâtres."
                            }
                        ]
                    }
                ],
