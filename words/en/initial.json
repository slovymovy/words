                                "target_lang_sense_clarification": "общее значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "签署首字母",
                                "target_lang_sense_clarification": "在文件上标注以示认可"
                            }
                        ]
                    }
                }
            ]
        }
    ]
