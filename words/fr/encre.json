                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le calmar a projeté un épais nuage d'<w>encre</w> noire pour fuir le prédateur."
                        },
                        {
                            "text": "Le chef prépare des pâtes fraîches colorées avec de l'<w>encre</w> de seiche."
