                                "example_id": "07e83a48-6632-419c-aec1-3aa206421a23",
                                "sense_id": "fadc8faa-ec42-362b-a5ba-4ec215bbd1bd",
                                "text": "We eten steeds meer gekweekte vis. De meeste verkochte vissoort in Nederland ìs zelfs een kweekvis, de pangasius."
                            },
                            {
                                "example_id": "b3110688-d852-4cc5-b9ca-5fe01bf6fe79",
                                "sense_id": "fadc8faa-ec42-362b-a5ba-4ec215bbd1bd",
                                "text": "Het gaat om de pangasius, een gekweekte vissoort uit het Verre Oosten. Hij is goedkoper dan paling en door zijn neutrale smaak erg geliefd bij vooral de jeugd."
                            }
                        ]
                    }
