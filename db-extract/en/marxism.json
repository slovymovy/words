                                        "glosses": [
                                            "politická ekonomie a z ní odvozená ideologie, filozofie i praxe (politika) založená na učení Karla Marxe a Friedricha Engelse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c8d09fb-ce7a-49e0-a662-030285069247",
                                                "sense_id": "7c684756-c19a-37d1-8148-d7ee59d312d1",
                                                "text": "Marxismus společnost viděl jako fatálně polarizovanou mezi vykořisťovanými dělníky a těmi, kteří je vykořisťovali."
