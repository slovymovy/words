                                        "sense_id": "86270554-3c19-38aa-922e-5578da474454",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
                                        "glosses": [
                                            "Specifically, a state of agitation or disturbance in the air which is disruptive to an aircraft."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e239cda-15ed-3826-9248-c55e882ae8bf",
                                        "entry_id": "099d069a-503f-3b35-b894-5489452db528",
