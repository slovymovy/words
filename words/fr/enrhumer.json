                    "frequency": "Low",
                    "semantic_group_id": "rhume",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ferme cette fenêtre immédiatement, ce courant d'air va tous nous <w>enrhumer</w>."
