                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "карто́шках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "319b019b-17f9-3607-81bb-ae951a7fb3c8",
                        "entry_id": "12fe67ad-b814-3f96-8a98-72fb4c93a08e",
                        "glosses": [
                            "разг. то же, что картофель"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff8ade6-82a3-4942-929f-7d6fa0365029",
                                "sense_id": "319b019b-17f9-3607-81bb-ae951a7fb3c8",
                                "text": "Уже был один никем не замеченный мороз: почернела ботва на картошке, брусника стала мягкая, горькая рябина ― сладкая и зелёная клюква ― багрово-красная."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9925d82-b592-3339-a057-a087e761e890",
                        "entry_id": "12fe67ad-b814-3f96-8a98-72fb4c93a08e",
                        "glosses": [
                            "разг., то же, что картофелина"
                        ],
                        "tags": [
                            "иногда неисч."
                        ],
                        "examples": [
                            {
                                "example_id": "de7365e7-b7fc-4c06-8db4-eac53f0e8a67",
                                "sense_id": "a9925d82-b592-3339-a057-a087e761e890",
                                "text": "Он достал опять складной ножик, разрезал на своей ладони картошку на равные две половины, посыпал соли из тряпки и поднёс Пьеру."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8bfd704-93e0-3705-80f6-04d813829cd8",
                        "entry_id": "12fe67ad-b814-3f96-8a98-72fb4c93a08e",
                        "glosses": [
                            "разг., кулин. блюдо из картофеля"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83c21054-b48c-3e1c-9197-7c0e9669d22e",
                        "entry_id": "12fe67ad-b814-3f96-8a98-72fb4c93a08e",
                        "glosses": [
                            "перен., разг. сельскохозяйственные работы по уборке картофеля и других овощей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1d2ea0-7ba5-4f2f-b49c-524ffe6bf7d1",
                                "sense_id": "83c21054-b48c-3e1c-9197-7c0e9669d22e",
                                "text": "Нельзя было достать баб, чтобы вымыть полы, ― все были на картошках."
                            }
                        ]
                    },
                    {
                        "sense_id": "7d0f3c92-ab65-3460-8ca3-f2e2174b7893",
                        "entry_id": "12fe67ad-b814-3f96-8a98-72fb4c93a08e",
                        "glosses": [
                            "бисквитно-шоколадное пирожное округлой формы"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "63b9088c-f875-3f30-8106-f3904422e16d",
                        "entry_id": "12fe67ad-b814-3f96-8a98-72fb4c93a08e",
                        "glosses": [
                            "подвижная групповая игра с мячом"
                        ],
