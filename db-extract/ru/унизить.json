                    },
                    {
                        "form_id": "0a3b9520-5b7b-4984-91c7-113bd2302c8c",
                        "entry_id": "3ca6a6d0-d03a-3599-a84d-83581881b4af",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "уни́зивши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21e20fe0-231f-3794-bbeb-506085998337",
                        "entry_id": "3ca6a6d0-d03a-3599-a84d-83581881b4af",
                        "glosses": [
                            "умалить чьё-либо достоинство, оскорбить чьё-либо самолюбие чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70a97f0a-66cd-40d2-8691-59ab2de6d297",
                                "sense_id": "21e20fe0-231f-3794-bbeb-506085998337",
                                "text": "Он унизил не только меня, но и весь наш дом и весь наш род."
                            },
                            {
                                "example_id": "a75ea820-20f0-49db-8db4-cd192912218d",
                                "sense_id": "21e20fe0-231f-3794-bbeb-506085998337",
                                "text": "Как-то раз она заплакала, потому что её унизили в домоуправлении."
                            },
                            {
                                "example_id": "1388f260-55c4-4b1f-8fe6-52f88a966376",
                                "sense_id": "21e20fe0-231f-3794-bbeb-506085998337",
                                "text": "Но клеветой героя не унижу."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90dfc6cc-6d97-4813-88e6-9a136908c8f4",
                        "source_entry_id": "3ca6a6d0-d03a-3599-a84d-83581881b4af",
                        "source_sense_id": "21e20fe0-231f-3794-bbeb-506085998337",
                        "target_lang_word": "disgrace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disgrace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af9f5d1c-214c-3f41-8c98-ba33b4a6b5be",
                                        "entry_id": "418ac08e-bc44-3cce-a52d-3ddaf9064f33",
                                        "glosses": [
                                            "The condition of being out of favor; loss of favor, regard, or respect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbc174b0-9d1e-4575-ac38-d9b3727b12c9",
                                                "sense_id": "af9f5d1c-214c-3f41-8c98-ba33b4a6b5be",
                                                "text": "I heare / Macduffe liues in diſgrace. Sir, can you tell / Where he beſtowes himſelfe?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6be99cd5-8000-39e5-aab9-78c3cfd109e1",
                                        "entry_id": "418ac08e-bc44-3cce-a52d-3ddaf9064f33",
                                        "glosses": [
                                            "The state of being dishonored, or covered with shame."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7756053a-8f4a-47b8-a6dc-35ce986c9d1f",
                                                "sense_id": "6be99cd5-8000-39e5-aab9-78c3cfd109e1",
                                                "text": "Now she lives in disgrace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "161ed4fb-fdb4-3973-bd91-75d3def376ac",
                                        "entry_id": "418ac08e-bc44-3cce-a52d-3ddaf9064f33",
                                        "glosses": [
                                            "Something which brings dishonor; the cause of reproach or shame; great discredit."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6366a8e0-9952-49d6-826e-46e7372d03ac",
                                                "sense_id": "161ed4fb-fdb4-3973-bd91-75d3def376ac",
                                                "text": "His behaviour at the party was a total disgrace! He was leeching on all the ladies, and insulting the men."
                                            },
                                            {
                                                "example_id": "c0e8ca50-9b33-4a8d-8471-0825a5e950d1",
                                                "sense_id": "161ed4fb-fdb4-3973-bd91-75d3def376ac",
                                                "text": "Practice and whipping were alike unavailing, and Epps, satisfied of it at last, swore I was a disgrace—that I was not fit to associate with a cotton-picking \"nigger\"—that I could not pick enough in a day to pay the trouble of weighing it, and that I should go into the cotton field no more."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74fcdf24-767f-3906-890a-83d77428e0ad",
                                        "entry_id": "418ac08e-bc44-3cce-a52d-3ddaf9064f33",
                                        "glosses": [
                                            "An act of unkindness; a disfavor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "358e13b3-720c-4406-b42c-04b97bbfb423",
                                                "sense_id": "74fcdf24-767f-3906-890a-83d77428e0ad",
                                                "text": "As for the pulling of them [ambitious men] downe, if the Affaires require it, and that it may not be done with ſafety ſuddainly, the onely Way is, the Enterchange, continually of Fauours, and Diſgraces, whereby they may not know, what to expect; And be, as it were, in a Wood."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disgrace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e20ef1d8-7040-3dc1-b0a5-da0a9fb4735f",
                                        "entry_id": "3de008e8-961c-3a15-a0c5-566717b3bb8c",
                                        "glosses": [
                                            "To put someone or something out of favor; to bring shame or ignominy upon."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e07fe5c7-a9db-4a30-a640-26c42383455e",
                                                "sense_id": "e20ef1d8-7040-3dc1-b0a5-da0a9fb4735f",
                                                "text": "[…] some families renounced the use of a certain praenomen which had been disgraced by one of their name […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f4e915d-2d24-4cbe-8cf9-0d36e1e0af11",
                        "source_entry_id": "3ca6a6d0-d03a-3599-a84d-83581881b4af",
                        "source_sense_id": "21e20fe0-231f-3794-bbeb-506085998337",
                        "target_lang_word": "humiliate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "humiliate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6def7261-2cc4-31f2-8b42-542b47181750",
                                        "entry_id": "f2708a55-b8fb-37f3-8357-268ae7e956e9",
                                        "glosses": [
                                            "To cause to be ashamed; to injure the dignity and self-respect of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c09b8fd-afe3-4005-b93e-7d0ea82d65b7",
                                                "sense_id": "6def7261-2cc4-31f2-8b42-542b47181750",
                                                "text": "The bully tried to humiliate the other students during lunch."
                                            },
                                            {
                                                "example_id": "7a4ec644-d059-49bd-8db9-0c41313790a2",
                                                "sense_id": "6def7261-2cc4-31f2-8b42-542b47181750",
                                                "text": "He would never intentionally humiliate anyone, even in jest."
                                            },
                                            {
                                                "example_id": "1292d647-12c4-4b72-baeb-35f7eae0d7ab",
                                                "sense_id": "6def7261-2cc4-31f2-8b42-542b47181750",
