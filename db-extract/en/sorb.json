                    },
                    {
                        "sense_id": "73c8e0bf-00d4-31d3-a21e-e22950f8a810",
                        "entry_id": "953ea6bc-a18f-3877-89a2-33f0934100cf",
                        "glosses": [
                            "Any of various related trees, including the wild service tree, S. torminalis, and the rowan, S. aucuparia."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "c65d007c-820c-32bf-ad0a-0816037cb4a8",
                        "entry_id": "953ea6bc-a18f-3877-89a2-33f0934100cf",
                        "glosses": [
                            "The fruit of any of these trees, especially of the service tree."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ead3b13c-412a-44ed-bc8a-fbdb9c9a96ff",
                        "source_entry_id": "953ea6bc-a18f-3877-89a2-33f0934100cf",
                        "source_sense_description": "rowan tree",
                        "target_lang_word": "sorbier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorbier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "77ef49fe-7d82-35ac-bb4f-7d299e4121b5",
                                        "entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
                                        "glosses": [
                                            "Genre de rosacées, arbres ou arbustes ornementaux à feuilles composées, et aux petits fruits globuleux, rouge, orange ou bruns, appréciés des oiseaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93840a57-1ec2-4c4e-b075-3e0cc5ea1ac8",
                                                "sense_id": "77ef49fe-7d82-35ac-bb4f-7d299e4121b5",
                                                "text": "Je m’efforçais d’imaginer les sorbiers sans leurs feuilles vertes d’une part, argentées de l’autre, sans leurs ombelles de fruits rouges."
                                            },
                                            {
                                                "example_id": "b7347303-9fa7-488f-8441-4928c135e98e",
                                                "sense_id": "77ef49fe-7d82-35ac-bb4f-7d299e4121b5",
                                                "text": "Le bois des sorbiers, au grain serré, est utilisé en ébénisterie."
                                            },
                                            {
                                                "example_id": "228584da-358d-44ed-8516-3176580b3547",
                                                "sense_id": "77ef49fe-7d82-35ac-bb4f-7d299e4121b5",
                                                "text": "Il semble même, par l’exemple des fruits des diospyros, du sorbier et du néflier, qu’on ne peut manger que blets, que plus l’acerbité a été grande, plus le fruit est susceptible de blessir régulièrement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b179d798-7f88-3801-afce-62b33609c395",
                                        "entry_id": "95e2235e-8dde-3991-834a-87e7ba5b5672",
                                        "glosses": [
                                            "Sorbus subg. Sorbus, un des sous-genres de Sorbus (par opposition aux alisiers)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d04e8f1-d429-44c0-8dac-c965abee330b",
                                                "sense_id": "b179d798-7f88-3801-afce-62b33609c395",
                                                "text": "Soudain, sans raison valable, elle se réveillait chez un tel parce que les sorbiers croulaient de fleurs musquées, chez un autre parce qu’un gel tardif avait rôti leurs blancs corymbes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6111565b-1ddf-4d9b-ae90-d517e7125903",
                        "source_entry_id": "953ea6bc-a18f-3877-89a2-33f0934100cf",
                        "source_sense_description": "rowan tree",
                        "target_lang_word": "jarząb domowy",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b39b6469-1dcb-43ed-aadc-b7af9ebcb9d5",
                        "source_entry_id": "953ea6bc-a18f-3877-89a2-33f0934100cf",
                        "source_sense_description": "fruit",
                        "target_lang_word": "sorbe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sorbe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5af3c7e-2ba1-323c-b957-861040a0a1f9",
                                        "entry_id": "585f93ed-353f-3e63-9917-b95f0e4a9cde",
                                        "glosses": [
                                            "Fruit du sorbier des oiseleurs et des espèces apparentées du sous-genre Sorbus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "054571fa-a60c-49d7-bbf5-ec79afff6bc5",
                                                "sense_id": "c5af3c7e-2ba1-323c-b957-861040a0a1f9",
                                                "text": "On m’appelle Rouget à cause de mon bec et de mes pattes couleur de sorbe."
                                            },
                                            {
                                                "example_id": "deac2ad4-7903-4b96-baf7-ebe71536a58f",
                                                "sense_id": "c5af3c7e-2ba1-323c-b957-861040a0a1f9",
                                                "text": "On apporta bientôt de l'eau-de-vie de sorbe qui, d'après Nozdirov, rappelait la prune à s'y méprendre, mais qui, au profond étonnement des invités, se révéla un atroce tord-boyaux."
                                            },
                                            {
                                                "example_id": "fd50abed-b334-496b-b187-be17e297c51f",
                                                "sense_id": "c5af3c7e-2ba1-323c-b957-861040a0a1f9",
                                                "text": "La gelée de mai avait compromis la récolte des sorbes et depuis déjà longtemps c'était le souci numéro un des griveleux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df200563-fd95-360e-8f41-68b8c25191a7",
                                        "entry_id": "585f93ed-353f-3e63-9917-b95f0e4a9cde",
                                        "glosses": [
                                            "Fruit de l’ensemble des espèces de sorbier du genre Sorbus (dont le cormier et les alisiers)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "043cf0e4-5873-4ed0-a64f-e11e6c5b1657",
                                                "sense_id": "df200563-fd95-360e-8f41-68b8c25191a7",
                                                "text": "« Je ferai sécher des figues, des amandes, des sorbes, je ramasserai des mûres, des prunelles… »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f902243-302d-4a55-84a7-3be45900b7aa",
                        "source_entry_id": "953ea6bc-a18f-3877-89a2-33f0934100cf",
                        "source_sense_description": "fruit",
                        "target_lang_word": "corme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "67023611-b8c1-3523-9729-d030eccbe185",
                                        "entry_id": "2849bb91-233d-3134-b7df-94b2a5c2f2c1",
                                        "glosses": [
                                            "Organe de réserve souterrain morphologiquement proche du bulbe mais formé d’une tige renflée entourée d’écailles."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc5135e3-89a8-40c0-ae7c-0d98fdb095dc",
                                                "sense_id": "67023611-b8c1-3523-9729-d030eccbe185",
                                                "text": "Les cormes mous à chair blanche du taro se consomment cuits à l’eau, frits ou rôtis en accompagnement, ou bien s’utilisent pour préparer le foufou."
                                            },
                                            {
                                                "example_id": "7329fbd2-24fe-45e4-b925-d9322e04c7be",
                                                "sense_id": "67023611-b8c1-3523-9729-d030eccbe185",
                                                "text": "La première preuve de culture de Crocus triploïde peut être trouvée dans l’atlas botanique de Théophraste : Historia Plantarum (350–287 BC). Il y décrit la plante donnant le safran et la propagation par les cormes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "corme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b68e1f6-24cc-36fe-b375-dd3a68f2d0ff",
                                        "entry_id": "c6e66fd4-e2c6-302c-b1d6-71d3d8f16a82",
                                        "glosses": [
                                            "Fruit acide en forme de petite poire produit par le cormier ou sorbier domestique (Sorbus domestica). Ce fruit se mange blet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5767b22b-f816-4b9b-9c51-79f33c10be70",
                                                "sense_id": "1b68e1f6-24cc-36fe-b375-dd3a68f2d0ff",
                                                "text": "Par là-bas, les cochons, tant qu’ils sont jeunes, se mènent paître comme des moutons, mais au bois, pas au pré. Ils fouillent l’humus de leur groin et dévorent les glands, les sorbes, qu’on appelle là-bas des cormes, les gratte-cul, les champignons, la mousse, les petites bêtes qu’il y a dedans, des tas de bonnes choses qui donnent du goût au jambon, et ils courent comme des fous, s’amusent, se bousculent, c’est très gai, un cochon, très farceur."
                                            },
                                            {
                                                "example_id": "eb2828aa-2181-45ff-b348-e79c1c4100c9",
                                                "sense_id": "1b68e1f6-24cc-36fe-b375-dd3a68f2d0ff",
                                                "text": "Et, comme l’écrivit le Bordelais Jules Gérand en 1855, il « donne des fruits mangeables, les sorbes, plus souvent appelés cormes ; aussi le classe-t-on dans les arbres fruitiers »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82032fb9-423e-3bee-b3ca-49a3f1ad804e",
                                        "entry_id": "c6e66fd4-e2c6-302c-b1d6-71d3d8f16a82",
                                        "glosses": [
                                            "Cornouille, fruit du cornouiller mâle."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
