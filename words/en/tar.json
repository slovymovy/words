                    "target_lang_definitions": {
                        "ru": "Упаковывать файлы в архив с помощью утилиты tar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "архивировать",
                                "target_lang_sense_clarification": "создавать архив с помощью tar"
                            },
                            {
                                "target_lang_word": "тарировать",
                                "target_lang_sense_clarification": "жаргон программистов: упаковывать в tar"
                            }
