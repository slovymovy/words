{
    "word_family": [
        "mist",
        "mistily",
        "mistiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e03909f-16e2-37f9-90d7-267ab18925ef",
                    "sense_definition": "Filled or obscured with mist; foggy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "weather_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Drivers were advised to slow down on the cold and <w>misty</w> morning.",
                            "target_lang_translations": {
                                "es": "Se aconsejó a los conductores que redujeran la velocidad en esa mañana fría y <w>neblinosa</w>."
                            }
                        },
                        {
                            "text": "The tall mountains looked mysterious hidden behind the <w>misty</w> air.",
                            "target_lang_translations": {
                                "es": "Las altas montañas parecían misteriosas ocultas tras el aire <w>brumoso</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "foggy",
                        "hazy"
                    ],
                    "antonyms": [
                        "clear"
                    ],
                    "common_phrases": [
                        "misty morning",
                        "misty day"
                    ],
                    "target_lang_definitions": {
                        "es": "Cubierto u oscurecido por la niebla o la neblina."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "neblinoso",
                                "target_lang_sense_clarification": "con niebla o neblina"
                            },
                            {
                                "target_lang_word": "con neblina",
                                "target_lang_sense_clarification": "cubierto de bruma o niebla"
                            },
                            {
                                "target_lang_word": "brumoso",
                                "target_lang_sense_clarification": "cargado de bruma"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "588c950d-085a-38f9-82e1-024ae185a44e",
                    "sense_definition": "Filled with tears, often from strong emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "eyes",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her eyes grew <w>misty</w> as she remembered her late grandfather.",
                            "target_lang_translations": {
                                "es": "Sus ojos se pusieron <w>llorosos</w> al recordar a su difunto abuelo."
                            }
                        },
                        {
                            "text": "He listened to the sad song with <w>misty</w> eyes.",
                            "target_lang_translations": {
                                "es": "Escuchó la triste canción con los ojos <w>empañados</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "tearful",
                        "dewy-eyed"
                    ],
                    "common_phrases": [
                        "misty eyes",
                        "grow misty"
                    ],
                    "target_lang_definitions": {
                        "es": "Lleno de lágrimas o vidrioso por una fuerte emoción."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "lloroso",
                                "target_lang_sense_clarification": "con lágrimas o a punto de llorar"
                            },
                            {
                                "target_lang_word": "vidrioso",
                                "target_lang_sense_clarification": "dicho de los ojos, empañados por la emoción"
                            },
                            {
                                "target_lang_word": "empañado",
                                "target_lang_sense_clarification": "cubierto por lágrimas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92f8ad94-2351-3e22-987b-ca3c7cf58a10",
                    "sense_definition": "Not clear to the mind; dim, vague, or obscure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "clarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He kept only a <w>misty</w> recollection of his early childhood years.",
                            "target_lang_translations": {
                                "es": "Solo conservaba un recuerdo <w>borroso</w> de sus primeros años de infancia."
                            }
                        },
                        {
                            "text": "The future of the company remains a bit <w>misty</w> at present.",
                            "target_lang_translations": {
                                "es": "El futuro de la empresa sigue siendo un poco <w>incierto</w> en la actualidad."
                            }
                        }
                    ],
                    "synonyms": [
                        "vague",
                        "dim",
                        "obscure",
                        "unclear"
                    ],
                    "antonyms": [
                        "clear",
                        "distinct"
                    ],
                    "common_phrases": [
                        "misty memory"
                    ],
                    "target_lang_definitions": {
                        "es": "Poco claro para la mente; vago, confuso o borroso."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "borroso",
                                "target_lang_sense_clarification": "poco nítido o impreciso"
                            },
                            {
                                "target_lang_word": "vago",
                                "target_lang_sense_clarification": "impreciso o difuso"
                            },
                            {
                                "target_lang_word": "difuso",
                                "target_lang_sense_clarification": "poco claro en la mente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3e17ce8e-98ac-3367-88bb-585196c7308f",
                    "sense_definition": "A female given name.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "given_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Misty</w> decided to invite all her classmates to the celebration.",
                            "target_lang_translations": {
                                "es": "<w>Misty</w> decidió invitar a todos sus compañeros de clase a la celebración."
                            }
                        },
                        {
                            "text": "We met an artist named <w>Misty</w> during our trip to London.",
                            "target_lang_translations": {
                                "es": "Conocimos a una artista llamada <w>Misty</w> durante nuestro viaje a Londres."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Nombre propio femenino."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "Misty",
                                "target_lang_sense_clarification": ""
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dafa7ff1-de25-3118-94f4-34d27a8f7a9b",
                    "sense_definition": "A diminutive of the female given name Melissa.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "given_names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Her legal name was Melissa, but everyone affectionately called her <w>Misty</w>.",
                            "target_lang_translations": {
                                "es": "Su nombre legal era Melissa, pero todos la llamaban cariñosamente <w>Misty</w>."
                            }
                        },
                        {
                            "text": "Aunt <w>Misty</w> always sent the most thoughtful holiday greeting cards.",
                            "target_lang_translations": {
                                "es": "La tía <w>Misty</w> siempre enviaba las tarjetas navideñas más detallistas."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Diminutivo del nombre propio femenino Melissa."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "Misty",
                                "target_lang_sense_clarification": ""
                            }
                        ]
                    }
                }
            ]
        }
    ]
}