{
    "word_family": [
        "scarletness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6783eac1-a006-3b7b-8c96-9851e53f0249",
                    "sense_definition": "Of a bright red colour.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird had bright <w>scarlet</w> feathers that stood out against the green trees.",
                            "target_lang_translations": {
                                "zh": "那只鸟有着鲜艳的<w>绯红</w>色羽毛，在绿树的映衬下格外显眼。"
                            }
                        },
                        {
                            "text": "She wore a <w>scarlet</w> dress to the party and looked stunning.",
                            "target_lang_translations": {
                                "zh": "她穿着一件<w>绯红</w>色的裙子去参加派对，看起来美极了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "scarlet red"
                    ],
                    "common_phrases": [
                        "scarlet red"
                    ],
                    "target_lang_definitions": {
                        "zh": "鲜艳的红色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绯红",
                                "target_lang_sense_clarification": "形容鲜艳的红色。"
                            },
                            {
                                "target_lang_word": "猩红",
                                "target_lang_sense_clarification": "形容像鲜血一样的红色。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6652866-5661-319e-a8b6-1ceb604508b1",
                    "sense_definition": "Blushing; embarrassed or mortified.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emotion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He turned <w>scarlet</w> when everyone started singing happy birthday to him.",
                            "target_lang_translations": {
                                "zh": "当大家开始为他唱生日歌时，他<w>满脸通红</w>。"
                            }
                        },
                        {
                            "text": "I felt <w>scarlet</w> after realizing I had made such a silly mistake in front of my boss.",
                            "target_lang_translations": {
                                "zh": "意识到自己在老板面前犯了这么愚蠢的错误后，我感到<w>满脸通红</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to describe the physical appearance of embarrassment."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "因尴尬或羞愧而脸红。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "满脸通红",
                                "target_lang_sense_clarification": "形容因羞愧或尴尬而脸部充血。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "02ce1dcb-5968-3a74-9d8e-1a864848627d",
                    "sense_definition": "Sinful or whorish.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The historical novel depicted her as a <w>scarlet</w> woman living in a strict society.",
                            "target_lang_translations": {
                                "zh": "那部历史小说将她描绘成一个生活在严苛社会中的<w>放荡</w>女人。"
                            }
                        },
                        {
                            "text": "In older literature, the term <w>scarlet</w> was often used to imply moral corruption.",
                            "target_lang_translations": {
                                "zh": "在旧文学中，这个词常被用来暗示<w>放荡</w>的道德败坏。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers to a moral judgment common in older texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指道德败坏的或淫荡的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "放荡的",
                                "target_lang_sense_clarification": "指行为不检点或道德败坏。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "106f9b5c-ee5d-340e-be09-18c4e944ea57",
                    "sense_definition": "A brilliant red colour sometimes tinged with orange.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist mixed a vibrant <w>scarlet</w> to paint the sunset.",
                            "target_lang_translations": {
                                "zh": "艺术家调配了一种鲜艳的<w>绯红</w>色来描绘日落。"
                            }
                        },
                        {
                            "text": "She chose a deep <w>scarlet</w> for the walls of her living room.",
                            "target_lang_translations": {
                                "zh": "她为客厅的墙壁选择了深<w>绯红</w>色。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种带橙色调的鲜艳红色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "绯红色",
                                "target_lang_sense_clarification": "指代绯红这种颜色。"
                            },
                            {
                                "target_lang_word": "猩红色",
                                "target_lang_sense_clarification": "指代猩红这种颜色。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0e64e14c-60b8-31e9-8763-2a76547aa1de",
                    "sense_definition": "Cloth of a scarlet color.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king was draped in fine <w>scarlet</w> during the coronation ceremony.",
                            "target_lang_translations": {
                                "zh": "加冕典礼上，国王身披精美的<w>猩红呢绒</w>。"
                            }
                        },
                        {
                            "text": "Merchants traveled far to sell their finest <w>scarlet</w> to the nobility.",
                            "target_lang_translations": {
                                "zh": "商人们长途跋涉，将他们最上等的<w>猩红呢绒</w>卖给贵族。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers to a specific historical type of fabric."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一种历史上的猩红色布料。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "猩红呢绒",
                                "target_lang_sense_clarification": "指代古代昂贵的猩红色织物。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "2dc50926-0241-34c6-a254-6312437ef94a",
                    "sense_definition": "A female given name.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "<w>Scarlet</w> is a popular name for girls in many English-speaking countries.",
                            "target_lang_translations": {
                                "zh": "<w>斯嘉丽</w>在许多英语国家是一个受欢迎的女孩名字。"
                            }
                        },
                        {
                            "text": "My friend <w>Scarlet</w> is coming over for dinner tonight.",
                            "target_lang_translations": {
                                "zh": "我的朋友<w>斯嘉丽</w>今晚要来吃晚饭。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Also used as a given name."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "女性名字。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斯嘉丽",
                                "target_lang_sense_clarification": "常见的女性英文名音译。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af373bc2-a8ec-3ed2-a118-ae55bdae0e0b",
                    "sense_definition": "To dye or tinge something with scarlet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The setting sun seemed to <w>scarlet</w> the entire horizon.",
                            "target_lang_translations": {
                                "zh": "落日似乎将整个地平线都<w>染成猩红</w>了。"
                            }
                        },
                        {
                            "text": "The artist decided to <w>scarlet</w> the fabric using natural pigments.",
                            "target_lang_translations": {
                                "zh": "艺术家决定使用天然颜料将布料<w>染成猩红</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将某物染成猩红色。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "染成猩红",
                                "target_lang_sense_clarification": "指将物体染成鲜艳的红色。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}