                    {
                        "sense_id": "1df45cfb-c9bc-3aaf-b7f7-f5f4108265b3",
                        "entry_id": "bea42b8c-326b-3163-ae94-3c38d91bbcc7",
                        "glosses": [
                            "Verbrennungsmotor, bei dem der Verbrennungsdruck durch einen rotierenden Kreiskolben in Bewegung umgesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c62610-8cfa-4942-a1b7-940d8b74b93c",
                                "sense_id": "1df45cfb-c9bc-3aaf-b7f7-f5f4108265b3",
                                "text": "Obwohl alle großen Motorradmarken an der Integration eines Wankelmotors für Motorräder arbeiteten, konnten keine nennenswerten Verkaufszahlen erreicht werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
