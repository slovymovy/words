                        "sense_id": "ada1d623-7e36-3ff3-bd4f-39f2d9d99d31",
                        "entry_id": "7837342a-525a-3357-9e5b-3d2c9ab02030",
                        "glosses": [
                            "The act of physically keeping an opposing player in check."
                        ],
