                "senses": [
                    {
                        "sense_id": "c1f04ef1-dd78-35dc-83b7-995cdea36243",
                        "entry_id": "da985379-a240-36b9-85c6-1659917ffb7d",
                        "glosses": [
                            "Person mit Beamtenrechten, die bei einem Staat angestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44043b92-7161-4c0e-b0f0-5608c78d2d99",
                                "sense_id": "c1f04ef1-dd78-35dc-83b7-995cdea36243",
                                "text": "„Gaius Petronius Arbiter (11–66 n. Chr.) war ein hoher Staatsbeamter, der zeitweise sogar das Amt eines Konsuls bekleidete.“"
                            },
                            {
                                "example_id": "e5d9c76d-e535-471b-9395-8b677a1653a0",
                                "sense_id": "c1f04ef1-dd78-35dc-83b7-995cdea36243",
                                "text": "„Bis heute gibt es im Wesentlichen zwei Formen von Terrorismus: Angriffe auf Politiker und hohe Staatsbeamte und solche auf die Öffentlichkeit.“"
                            },
                            {
                                "example_id": "155670b4-7af2-40b5-8dae-d3485cd1df8d",
                                "sense_id": "c1f04ef1-dd78-35dc-83b7-995cdea36243",
                                "text": "„Der Vater, ein Staatsbeamter namens Kurt Böhme, steht nicht zu dem Kind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
