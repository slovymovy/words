        "fr-extract.jsonl": [
            {
                "entry_id": "fc1e29b1-6d12-3f35-bf5e-0a974ac9e517",
                "word": "insécurité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc8a1be2-c83b-45d8-a71a-3c1f0251e11b",
                        "entry_id": "fc1e29b1-6d12-3f35-bf5e-0a974ac9e517",
                        "tags": [
                            "plural"
                        ],
                        "form": "insécurités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4a2f6226-c184-382e-8b5a-3f4af06fb5b4",
                        "entry_id": "fc1e29b1-6d12-3f35-bf5e-0a974ac9e517",
                        "glosses": [
                            "Manque de sécurité, perception d’une situation menaçante ou imprévisible."
                        ],
                        "tags": [
                            "Sécurité"
                        ],
                        "examples": [
                            {
                                "example_id": "1654748a-fd16-4835-b630-5b9dbe674fdd",
                                "sense_id": "4a2f6226-c184-382e-8b5a-3f4af06fb5b4",
                                "text": "Conscients de leurs forces mutuelles dans l’agroalimentaire et les technologies connexes, l’Italie et le Canada s’efforceront de collaborer dans ces domaines en vue de trouver des solutions à l’insécurité alimentaire et aux perturbations de la chaîne d’approvisionnement."
                            },
                            {
                                "example_id": "b986f678-c109-47a6-afdc-5293d43b94c6",
                                "sense_id": "4a2f6226-c184-382e-8b5a-3f4af06fb5b4",
                                "text": "La courte nuit d’été lui parut cependant interminablement longue. Il éprouvait une sensation désagréable d’insécurité et il s’imaginait, sans la moindre raison, que le jour la dissiperait."
                            },
                            {
                                "example_id": "a6f9e3ce-1ae9-45a2-bdde-5b6434cfcbe3",
                                "sense_id": "4a2f6226-c184-382e-8b5a-3f4af06fb5b4",
                                "text": "En Chaouïa, dès 1904, Settat, puis Dar Ber-Rechid avaient été mis à sac par les tribus, et, depuis lors, l’insécurité n’avait fait que croître et embellir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3964eb9-c33e-4798-b017-026697e6644d",
                        "source_entry_id": "fc1e29b1-6d12-3f35-bf5e-0a974ac9e517",
                        "source_sense_id": "4a2f6226-c184-382e-8b5a-3f4af06fb5b4",
                        "target_lang_word": "insecurity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insecurity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13f4e777-c016-3490-baca-5296390acce5",
                                        "entry_id": "6bad8ca1-aa11-3461-af8c-8250bb77d4b3",
                                        "glosses": [
                                            "A lack of security; uncertainty."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8896c85f-d5d4-4845-82b9-368abdf4f01f",
                                                "sense_id": "13f4e777-c016-3490-baca-5296390acce5",
                                                "text": "They are also more likely to be on freelance or short-term contracts, which can contribute to feelings of financial insecurity and therefore a greater tendency for people to attend work even they are unwell."
                                            },
                                            {
                                                "example_id": "f5b4b10f-928b-40ac-b8f4-1d4779e4be7c",
                                                "sense_id": "13f4e777-c016-3490-baca-5296390acce5",
                                                "text": "Jealousy: It's all the feelings that come over you when you think you're being overlooked by others. It comes from inside, from your insecurities and fears—fear of loss, fear of betrayal, and fear of hurt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d289c377-f4d7-3e0d-8b93-8a68bb8f6f85",
                                        "entry_id": "6bad8ca1-aa11-3461-af8c-8250bb77d4b3",
                                        "glosses": [
                                            "A lack of security; uncertainty.",
                                            "A lack of confidence in oneself."
                                        ],
