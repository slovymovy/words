                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684b4d85-5e97-498b-9f80-38b55c74038b",
                                "sense_id": "019767c0-112c-34b4-8442-244cf1c65dde",
                                "text": "„Beim Tode des Ehepartners wurde vielfach eine einjährige Trauerzeit als angemessen betrachtet, besonders für Witwen.“"
                            },
                            {
                                "example_id": "d23c9e9f-76e9-43e4-9a89-121b625f73f7",
                                "sense_id": "019767c0-112c-34b4-8442-244cf1c65dde",
                                "text": "„Als die Trauerzeit vorüber war, fragte Sung das Mädchen aus der Schneiderei ein paar Häuser weiter, ob sie diese Familie mit ihm gründen wolle.“"
                            }
                        ],
