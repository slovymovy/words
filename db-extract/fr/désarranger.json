                ],
                "senses": [
                    {
                        "sense_id": "15c5207c-efe7-3fae-ab33-c712d71ae5c7",
                        "entry_id": "513b8b5b-70e0-3f5f-bfdb-8ebb8e3a4dd8",
                        "glosses": [
                            "Faire cesser modifier, un arrangement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68aa02b4-a47c-446d-aff7-672fdfece2d5",
                                "sense_id": "15c5207c-efe7-3fae-ab33-c712d71ae5c7",
                                "text": "Les patients étaient brutalisés et mutilés au moyen de drogues, de chocs et de lobotomies alors que Cameron cherchait un moyen de « désarranger » et « reprogrammer » le mental humain."
                            },
                            {
                                "example_id": "b5aa7cdc-448d-4891-a57a-2a04a0c5260d",
                                "sense_id": "15c5207c-efe7-3fae-ab33-c712d71ae5c7",
                                "text": "La courbe exprime la nécessité pour l’énergie de « décrire » un « circuit à travers le compliqué… circuit suivant lequel elle s’arrange avant de se désarranger en fin de compte conformément aux lois de moindre effort et de plus grande probabilité »."
                            }
                        ]
                    }
