                "senses": [
                    {
                        "sense_id": "069934ab-e7d6-39d0-aa34-4fc5c1d6a6c9",
                        "entry_id": "04d2ea06-f6af-3295-ab6b-16d7949cee42",
                        "glosses": [
                            "cherry, sweet cherry (relating to Prunus avium and its fruit)"
                        ],
                        "tags": [
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "d7496f2b-985d-448c-b9da-15b861a4ca64",
                                "sense_id": "069934ab-e7d6-39d0-aa34-4fc5c1d6a6c9",
                                "text": "Она́ кури́ла папиро́ску в чере́шневом тё́мном мундштуке́ и улыба́лась слегка́, сло́вно зна́ла тако́е, чего́ не говоря́т, но чему́ улыба́ются.",
                                "translation": "She was smoking a cigarette, in a dark, cherrywood mouthpiece, and smiling lightly, as though she knew something that was not to be said, but to be smiled at.",
                                "english": "She was smoking a cigarette, in a dark, cherrywood mouthpiece, and smiling lightly, as though she knew something that was not to be said, but to be smiled at."
                            }
                        ]
                    }
                ],
