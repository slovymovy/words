{
    "word_family": [
        "droog",
        "droogte",
        "drogen",
        "uitdrogen",
        "verdroging"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1a65ae59-4b9e-3506-8db7-974e27add9cd",
                    "sense_definition": "door gebrek aan vocht droog en dor worden, vaak met de dood van een plant tot gevolg",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitdrogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zonder regelmatig water zullen de bloemen in de tuin snel <w>verdrogen</w>.",
                            "target_lang_translations": {
                                "en": "Without regular water, the flowers in the garden will quickly <w>wither</w>."
                            }
                        },
                        {
                            "text": "De bladeren van de plant beginnen te <w>verdrogen</w> door de felle zon.",
                            "target_lang_translations": {
                                "en": "The leaves of the plant are starting to <w>shrivel</w> due to the bright sun."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitdrogen",
                        "verdorren"
                    ],
                    "antonyms": [
                        "bevochtigen"
                    ],
                    "common_phrases": [
                        "volledig verdrogen",
                        "beginnen te verdrogen"
                    ],
                    "target_lang_definitions": {
                        "en": "to become dry and withered due to a lack of moisture, often resulting in the death of a plant"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wither",
                                "target_lang_sense_clarification": "of plants, to shrivel and die"
                            },
                            {
                                "target_lang_word": "dry up",
                                "target_lang_sense_clarification": "to lose all moisture and become brittle"
                            },
                            {
                                "target_lang_word": "shrivel",
                                "target_lang_sense_clarification": "to wrinkle and contract due to loss of moisture"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d9b0661-2c08-38af-a93a-502d66f873f6",
                    "sense_definition": "op een schadelijke of gevaarlijke manier een grote hoeveelheid water verliezen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitdrogen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de hitte en het uitblijven van de regen is het gras helemaal aan het <w>verdrogen</w>.",
                            "target_lang_translations": {
                                "en": "Due to the heat and the lack of rain, the grass is completely <w>drying up</w>."
                            }
                        },
                        {
                            "text": "De boer was bang dat zijn hele oogst zou <w>verdrogen</w> tijdens de lange hittegolf.",
                            "target_lang_translations": {
                                "en": "The farmer was afraid that his entire crop would <w>dry out</w> during the long heatwave."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitdrogen"
                    ],
                    "common_phrases": [
                        "aan het verdrogen"
                    ],
                    "target_lang_definitions": {
                        "en": "to lose a large amount of water in a harmful or dangerous way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dry out",
                                "target_lang_sense_clarification": "to lose moisture completely"
                            },
                            {
                                "target_lang_word": "dry up",
                                "target_lang_sense_clarification": "to become completely dry, often of land or water sources"
                            },
                            {
                                "target_lang_word": "dehydrate",
                                "target_lang_sense_clarification": "to lose water from a biological organism or substance"
                            },
                            {
                                "target_lang_word": "parch",
                                "target_lang_sense_clarification": "to make or become extremely dry through heat"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}