                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5c3c6bf-edc7-4ed9-81ac-ea99ed303fec",
                                                "sense_id": "fcaf80e4-5bf2-30a6-b757-6370eccc3bcb",
                                                "text": "Hable con el quejumbroso en privado, dígale cómo se siente sobre sus quejas continuas."
                                            }
