                "senses": [
                    {
                        "sense_id": "5b451ed4-a0e1-3f31-a414-e4292dc3ea4f",
                        "entry_id": "aab3b801-9979-3038-a1cd-20abf506f86a",
                        "glosses": [
                            "mieszkaniec Walencji; osoba z tego miasta"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fadeec85-8086-4328-b9cf-42e207f95693",
                                "sense_id": "5b451ed4-a0e1-3f31-a414-e4292dc3ea4f",
                                "text": "Cóż dziwnego, że właśnie walencjanin Guillen de Castro jest autorem słynnego dyptyku dramatycznego o młodości Cyda!"
                            },
                            {
                                "example_id": "e83dc660-f563-4285-aebf-0f6d94aebe56",
                                "sense_id": "5b451ed4-a0e1-3f31-a414-e4292dc3ea4f",
                                "text": "Po beatyfikacji Szymona de Rojas powstało niemało rycin, głównie o charakterze dewocyjnym, eksponujących jego troskę o ubogich. Do typowych przykładów takiego ujęcia należy miedzioryt z akwafortą walencjanina Manuela Bru"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
