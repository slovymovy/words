    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "43157081-3c4a-3a9f-ad04-d47adbaef2df",
                    "sense_definition": "Technology; electronic equipment, machinery, or digital devices.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tech_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can't understand how to use all this new <w>tech</w>.",
                            "target_lang_translations": {
                                "ru": "Я не понимаю, как пользоваться всей этой новой <w>техникой</w>.",
                                "zh": "我搞不懂怎么用这些新<w>科技</w>。"
                            }
                        },
                        {
                            "text": "Modern <w>tech</w> has completely changed the way we communicate with each other.",
                            "target_lang_translations": {
                                "ru": "Современные <w>технологии</w> полностью изменили то, как мы общаемся друг с другом.",
                                "zh": "现代<w>技术</w>彻底改变了我们彼此交流的方式。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "high tech",
                        "new tech",
                        "low tech",
                        "tech support"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "clipping of technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Технологии; электронное оборудование, техника или цифровые устройства.",
                        "zh": "科技；电子设备、机械或数字装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "техника",
                                "target_lang_sense_clarification": "оборудование, устройства"
                            },
                            {
                                "target_lang_word": "технологии",
                                "target_lang_sense_clarification": "общая концепция"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科技",
                                "target_lang_sense_clarification": "科学技术"
                            },
                            {
                                "target_lang_word": "技术",
                                "target_lang_sense_clarification": "设备或方法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ae01eb4-9ebc-31c1-bd06-098c8c981c49",
                    "sense_definition": "The technology industry or businesses, especially those related to computing, software, and the internet.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "tech_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Tech</w> giants such as Google and Facebook have a significant influence on society.",
                            "target_lang_translations": {
                                "ru": "Гиганты <w>сферы технологий</w>, такие как Google и Facebook, оказывают значительное влияние на общество.",
                                "zh": "像谷歌和脸书这样的<w>科技行业</w>巨头对社会有着深远的影响。"
                            }
                        },
                        {
                            "text": "She hopes to find a high-paying job in <w>tech</w> after she graduates.",
                            "target_lang_translations": {
                                "ru": "Она надеется найти высокооплачиваемую работу в <w>сфере технологий</w> после окончания учебы.",
                                "zh": "她希望毕业后能在<w>科技行业</w>找到一份高薪工作。"
                            }
