                        "glosses": [
                            "Nature et qualité de ce qui est protéiforme."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "d963f95a-7ce1-4612-9a53-a8b282410284",
                                "sense_id": "90d55693-a057-3a48-8bdc-e49784840720",
                                "text": "Cette névrose se distingue par la protéiformité de ses symptômes, des diverses maladies qui sont un effet consécutif de la sur-excitation du système nerveux, maladies que caractérise la prédominance d'un symptôme particulier."
                            },
                            {
                                "example_id": "57874145-36fb-49b8-aca3-6056ceed7ad1",
                                "sense_id": "90d55693-a057-3a48-8bdc-e49784840720",
                                "text": "Considérée dans son ensemble, l'écriture de Rimbaud marche bien de la protéiformité, de l'extravagance, de la discordance à une relative régularité, de l'exubérance à une relative indigence."
                            }
                        ]
                    }
