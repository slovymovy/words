{
    "word_family": [
        "verwaarlozen",
        "verwaarlozing"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a150f79e-e3c3-3a7b-890a-f225b90d87f9",
                    "sense_definition": "zo klein of onbeduidend dat het niet de moeite waard is om rekening mee te houden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbeduidend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het aantal bezoekers daalde met drie procent, wat volgens de directeur een <w>verwaarloosbare</w> hoeveelheid was.",
                            "target_lang_translations": {
                                "en": "The number of visitors fell by three percent, which according to the director was a <w>negligible</w> amount."
                            }
                        },
                        {
                            "text": "Het verschil in prijs tussen de twee winkels is gelukkig <w>verwaarloosbaar</w> klein.",
                            "target_lang_translations": {
                                "en": "The difference in price between the two stores is fortunately <w>negligibly</w> small."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbeduidend",
                        "miniem",
                        "gering"
                    ],
                    "antonyms": [
                        "significant"
                    ],
                    "common_phrases": [
                        "verwaarloosbaar klein",
                        "verwaarloosbare hoeveelheid",
                        "verwaarloosbaar verschil"
                    ],
                    "target_lang_definitions": {
                        "en": "so small or insignificant that it is not worth taking into account"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "negligible",
                                "target_lang_sense_clarification": "too small to be important"
                            },
                            {
                                "target_lang_word": "insignificant",
                                "target_lang_sense_clarification": "not large enough to be noticed"
                            },
                            {
                                "target_lang_word": "trifling",
                                "target_lang_sense_clarification": "of little value or importance"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62be87e0-5eb2-3eb3-ac7f-647660b1cfd8",
                    "sense_definition": "bijna niet aanwezig of zo gering dat er geen gevaar of effect van uitgaat",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onbeduidend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De experts stelden vast dat het risico op een overstroming in dit gebied <w>verwaarloosbaar</w> is.",
                            "target_lang_translations": {
                                "en": "The experts determined that the risk of flooding in this area is <w>negligible</w>."
                            }
                        },
                        {
                            "text": "Hoewel er wat straling vrijkwam, was de impact op de volksgezondheid <w>verwaarloosbaar</w>.",
                            "target_lang_translations": {
                                "en": "Although some radiation was released, the impact on public health was <w>negligible</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "nihil"
                    ],
                    "antonyms": [
                        "significant"
                    ],
                    "common_phrases": [
                        "risico is verwaarloosbaar",
                        "verwaarloosbaar effect"
                    ],
                    "target_lang_definitions": {
                        "en": "hardly present or so slight that there is no danger or effect resulting from it"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "negligible",
                                "target_lang_sense_clarification": "so small it can be ignored"
                            },
                            {
                                "target_lang_word": "minimal",
                                "target_lang_sense_clarification": "the smallest possible amount"
                            },
                            {
                                "target_lang_word": "paltry",
                                "target_lang_sense_clarification": "meager or insignificant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b310019d-c769-398d-acd1-f0c59c729b9e",
                    "sense_definition": "met een massa of waarde die bijna nul is, vaak gebruikt in een wetenschappelijke context",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wetenschappelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Neutrino's hebben een <w>verwaarloosbare</w> massa en zijn daarom uitzonderlijk moeilijk te detecteren.",
                            "target_lang_translations": {
                                "en": "Neutrinos have a <w>negligible</w> mass and are therefore exceptionally difficult to detect."
                            }
                        },
                        {
                            "text": "In deze berekening beschouwen we de wrijving van de lucht als een <w>verwaarloosbare</w> factor.",
                            "target_lang_translations": {
                                "en": "In this calculation, we consider air friction to be a <w>negligible</w> factor."
                            }
                        }
                    ],
                    "synonyms": [
                        "minuscuul"
                    ],
                    "antonyms": [
                        "significant"
                    ],
                    "common_phrases": [
                        "verwaarloosbare massa",
                        "verwaarloosbare factor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in wetenschappelijke of technische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "having a mass or value that is nearly zero, often used in a scientific context"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "negligible",
                                "target_lang_sense_clarification": "mathematically or scientifically insignificant"
                            },
                            {
                                "target_lang_word": "vanishingly small",
                                "target_lang_sense_clarification": "approaching zero"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}