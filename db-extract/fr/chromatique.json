                                    },
                                    {
                                        "sense_id": "1ce9e4ba-ac44-3f9d-aa1c-a13ca8213b6b",
                                        "entry_id": "7b0509f0-252b-35d0-9448-67d5b992b877",
                                        "glosses": [
