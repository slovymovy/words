                "senses": [
                    {
                        "sense_id": "137f6831-d3fc-31b5-a4ca-738c55f09ef4",
                        "entry_id": "1ba5d438-30af-308c-b416-53d82f813aff",
                        "glosses": [
                            "The compulsion to write."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "5cf38d71-d62d-4ea6-a203-1a3785e974ab",
                                "sense_id": "137f6831-d3fc-31b5-a4ca-738c55f09ef4",
                                "text": "Wagner’s graphomania is shown not only by the substance, but also by the outward form of his writings."
                            }
                        ]
                    },
                    {
                        "sense_id": "99568c54-03c3-3b32-9e36-0ec90f6f0884",
                        "entry_id": "1ba5d438-30af-308c-b416-53d82f813aff",
                        "glosses": [
                            "Used as part of the name of various surrealist techniques, e.g., a method in which dots are made at the sites of impurities in a blank sheet of paper, and lines are then made between the dots; see \\\"Entoptic graphomania\\\"."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "36aac8ed-805b-40bc-8335-50e8b718975a",
                                "sense_id": "99568c54-03c3-3b32-9e36-0ec90f6f0884",
                                "text": "A devoted explorer of decalcomania, fumage, frottage, collage and other methods of pictorial automatism, Colquhoun invented several magic-inspired techniques of her own, including graphomania, stillomania, and parsemage."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe192ca7-cf99-4a9c-9ad9-2129db69d03f",
                        "source_entry_id": "1ba5d438-30af-308c-b416-53d82f813aff",
                        "source_sense_description": "the compulsion to write",
                        "target_lang_word": "graphomanie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "graphomanie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4261da-0cbf-3c90-830b-80e035eb245c",
                                        "entry_id": "8c263adb-c94a-3598-a93e-faa0354b17aa",
                                        "glosses": [
                                            "Manie de l'écriture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25d5f785-1df5-44f8-92a2-67d79f26d3d5",
                                                "sense_id": "fe4261da-0cbf-3c90-830b-80e035eb245c",
                                                "text": "Tout s’était noué pendant l’année 1967. François Duprat disposait de loisirs suite à son exclusion d’Occident. Il laissait libre cours à sa graphomanie dans des publications nationalistes ; il entretenait une autre de ses pathologies dans Défense de l’Occident, la revue de Maurice Bardèche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "541cfd41-a178-4fb1-a994-90824f79b9dd",
                        "source_entry_id": "1ba5d438-30af-308c-b416-53d82f813aff",
