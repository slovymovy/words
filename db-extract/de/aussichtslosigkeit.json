                "senses": [
                    {
                        "sense_id": "81d54349-4802-382a-8c7e-1e2a7be06fc8",
                        "entry_id": "fa01afb9-5161-3fde-a381-06d5bf3d2f01",
                        "glosses": [
                            "der Zustand, aussichtslos zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92ea625d-1654-4577-8ac0-6fc955a3ba02",
                                "sense_id": "81d54349-4802-382a-8c7e-1e2a7be06fc8",
                                "text": "Angesichts der Aussichtslosigkeit ihrer Lage legten sie die Waffen nieder und ergaben sich."
                            },
                            {
                                "example_id": "432db8d6-de73-4cec-a1dc-cb50847f680e",
                                "sense_id": "81d54349-4802-382a-8c7e-1e2a7be06fc8",
                                "text": "„Die Alternative wäre gewesen, der Große Generalstab hätte spätestens am 1. August 1914 die Reichsregierung über die Aussichtslosigkeit eines Zweifrontenkrieges unterrichtet und zur radikalen Änderung ihrer Außenpolitik gedrängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c920f3d-0cdd-42b5-b446-9c3ed9995b36",
                        "source_entry_id": "fa01afb9-5161-3fde-a381-06d5bf3d2f01",
                        "source_sense_id": "81d54349-4802-382a-8c7e-1e2a7be06fc8",
                        "source_sense_description": "der Zustand, aussichtslos zu sein",
                        "target_lang_word": "hopelessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hopelessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                        "entry_id": "28c56b92-1c46-3fb9-b5df-c716889bab9d",
                                        "glosses": [
                                            "A lack of hope; despair."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "916591c0-80f4-44ab-9307-570819fe57cf",
                                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                                "text": "Depression can induce an overwhelming sense of sadness and hopelessness."
                                            },
                                            {
                                                "example_id": "e00d7018-d676-462f-a2d1-f22175c7325b",
                                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                                "text": "The survey found increasing mental health challenges, experiences of violence, and suicidal thoughts and behavior among all teens. More than 40% of high school students said that feelings of sadness or hopelessness prevented them from engaging in their regular activities for at least two weeks of the year."
                                            },
                                            {
                                                "example_id": "8fd428eb-b347-41ce-8035-7e92a998c5cd",
                                                "sense_id": "193d6c75-23eb-3a2d-a0c4-69a447da42c3",
                                                "text": "On the app I’d ultimately go with, I presented myself truthfully, as a Republican-curious woman tired of the Democrats’ hopelessness and constant pivoting during a highly charged election year."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54c289ce-4e75-4722-a12e-c3b32a07ea8b",
                        "source_entry_id": "fa01afb9-5161-3fde-a381-06d5bf3d2f01",
                        "source_sense_id": "81d54349-4802-382a-8c7e-1e2a7be06fc8",
