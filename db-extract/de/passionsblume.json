                        "glosses": [
                            "Passiflore, fleur de la passion."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72351749-1724-4fcc-a84a-f8e92cea3d59",
                                "sense_id": "41fcc6b4-4ff5-3370-a9d2-e17f9ee77522",
                                "text": "Die Früchte von der Blauen Passionsblume (Passiflora caerulea) sind etwa 5 cm lang, gelb und vom Geschmack eher ungenießbar.",
                                "translation": "Les fruits de la fleur de la passion bleue (Passiflora caerulea) ont une longueur d’environ 5 cm de long, sont jaunes et leur goût les rend plutôt immangeables."
                            },
                            {
                                "example_id": "02b7d0a8-b385-44fb-83c8-58112b4daddc",
                                "sense_id": "41fcc6b4-4ff5-3370-a9d2-e17f9ee77522",
                                "text": "Passionsblumen sind sehr artenreich. So finden Sie weltweit über 530 Sorten. Die Früchte sind bei den meisten Passionsblumen essbar, jedoch nicht bei allen.",
                                "translation": "Les passiflores sont très variées ; on trouve plus de 530 variétés dans le monde entier. Les fruits sont comestibles avec la plupart des passiflores, mais pas pour tous."
                            }
                        ]
                    }
