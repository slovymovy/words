                                                "sense_id": "87d08c29-24f3-3cb4-8839-da5eb616904a",
                                                "text": "What happened to your regular Jane?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a267150b-8b27-35b5-8c21-7d327c0b929b",
                                        "entry_id": "cfc4f261-f1b6-3611-8f77-3359f3f5f663",
                                        "glosses": [
                                            "Alternative letter-case form of jane (“female client of a prostitute”)."
                                        ],
