                                "target_senses": [
                                    {
                                        "sense_id": "202cab8d-666d-3e2e-a6ff-8ebb82e8ffdc",
                                        "entry_id": "d02ab9c7-4077-3ad0-b996-8c0b2d865c41",
                                        "glosses": [
                                            "The action of competing."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3d839f6-6ce8-47c0-87ce-6da06ff0161c",
                                                "sense_id": "202cab8d-666d-3e2e-a6ff-8ebb82e8ffdc",
                                                "text": "The competition for this job is strong."
                                            },
                                            {
                                                "example_id": "e88702e2-c917-4813-b688-f06eca1ca8a6",
                                                "sense_id": "202cab8d-666d-3e2e-a6ff-8ebb82e8ffdc",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3527c88a-27aa-3e7b-9d6b-74503d94fc36",
                                        "entry_id": "d02ab9c7-4077-3ad0-b996-8c0b2d865c41",
                                        "glosses": [
                                            "A contest for a prize or award."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8379afb-3380-4061-bb78-6dff443b1029",
                                                "sense_id": "3527c88a-27aa-3e7b-9d6b-74503d94fc36",
                                                "text": "The newspaper is featuring a competition to win a car."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97079ce5-afc0-394f-b53b-1529f30a28a4",
                                        "entry_id": "d02ab9c7-4077-3ad0-b996-8c0b2d865c41",
                                        "glosses": [
                                            "The competitors in such a contest."
                                        ],
                                        "tags": [
                                            "collective",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b19f1b4-d6a0-4f58-a1fd-66cbe2ba2044",
                                                "sense_id": "97079ce5-afc0-394f-b53b-1529f30a28a4",
                                                "text": "The new stain remover was ten times more effective than the competition."
                                            },
                                            {
                                                "example_id": "1092e299-b707-42fb-b1a6-836972b0ece6",
                                                "sense_id": "97079ce5-afc0-394f-b53b-1529f30a28a4",
                                                "text": "Japanese retail stores have strove to, and have succeeded in, fulfilling these severe demands, and in doing so, have constantly had to innovate both technologically and institutionally in order to keep up with the competition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
