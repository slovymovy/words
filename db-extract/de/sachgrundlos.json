                ],
                "senses": [
                    {
                        "sense_id": "2d576e6f-a028-39d8-b2ea-57a97e568b43",
                        "entry_id": "cddad0c4-42b7-379d-90eb-d100c2dbf2ef",
                        "glosses": [
                            "ohne Sachgrund, sachlich unbegründet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a71aafc-350d-4339-821b-3322ba6198f9",
                                "sense_id": "2d576e6f-a028-39d8-b2ea-57a97e568b43",
                                "text": "Die Stelle ist für zwei Jahre sachgrundlos befristet."
                            },
                            {
                                "example_id": "e6dcc98c-a0ac-4859-98d7-3e03dc647a2d",
                                "sense_id": "2d576e6f-a028-39d8-b2ea-57a97e568b43",
                                "text": "„Somit nutzte die Regierung das Instrument der sachgrundlosen Befristung bei mehr als der Hälfte aller ihrer Befristungsfälle.“"
                            },
                            {
                                "example_id": "a2477a0a-20db-445a-954e-217a25bf154a",
                                "sense_id": "2d576e6f-a028-39d8-b2ea-57a97e568b43",
                                "text": "„2002 hatte der Gesetzgeber diesen Sonderbefristungstatbestand wieder aufgehoben und durch ein sachgrundloses Befristungskonzept im Hochschulbereich ersetzt.“"
                            },
                            {
                                "example_id": "3981a26a-466a-4e7b-9381-4ec9bc22cc9e",
                                "sense_id": "2d576e6f-a028-39d8-b2ea-57a97e568b43",
