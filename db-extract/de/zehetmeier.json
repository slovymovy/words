                ],
                "senses": [
                    {
                        "sense_id": "92b8a890-c5e6-39a3-81cb-69e701caf726",
                        "entry_id": "7b0cc5fb-d7c1-3ba1-ac5b-274d8ffbf15d",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7c20aba-acfd-4cde-b6e0-e99a3351989f",
                                "sense_id": "92b8a890-c5e6-39a3-81cb-69e701caf726",
                                "text": "Frau Zehetmeier ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "fac1aee4-b1db-4dde-be8d-7503f084caa4",
                                "sense_id": "92b8a890-c5e6-39a3-81cb-69e701caf726",
                                "text": "Herr Zehetmeier wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8802e737-5670-48a0-b79f-9c6138e12855",
                                "sense_id": "92b8a890-c5e6-39a3-81cb-69e701caf726",
                                "text": "Die Zehetmeiers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "4652989c-c14e-442a-90eb-1ed157cf6cfa",
                                "sense_id": "92b8a890-c5e6-39a3-81cb-69e701caf726",
                                "text": "Der Zehetmeier trägt nie die Schals, die die Zehetmeier ihm strickt."
                            },
                            {
                                "example_id": "618e2c48-8956-481f-9b6a-b9ebd0c96aa4",
                                "sense_id": "92b8a890-c5e6-39a3-81cb-69e701caf726",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zehetmeier kommt, geht der Herr Zehetmeier.“"
                            },
                            {
                                "example_id": "2f81ae5b-5f90-496d-9eda-b304e8909eb3",
                                "sense_id": "92b8a890-c5e6-39a3-81cb-69e701caf726",
                                "text": "Zehetmeier kommt und geht."
                            },
                            {
                                "example_id": "20c2a5fa-34e7-4a22-9438-ba811296b319",
                                "sense_id": "92b8a890-c5e6-39a3-81cb-69e701caf726",
                                "text": "Zehetmeiers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
