                "senses": [
                    {
                        "sense_id": "289a93a8-c7c0-30e9-b275-7418c018ca6a",
                        "entry_id": "5296fbc7-8920-3d19-81fa-dac945d2d3fb",
                        "glosses": [
                            "To feed by hand."
                        ],
                        "tags": [
                            "of an animal or machine"
                        ],
                        "examples": [
                            {
                                "example_id": "b2bc86b4-6bfb-49c8-bb9c-64f62b7f1cf1",
                                "sense_id": "289a93a8-c7c0-30e9-b275-7418c018ca6a",
                                "text": "Walker only saw the place in its deceitful summer promise, when the corn, whose husks were never to fill, was waving in sunshine, when the potato-fields, which were to yield nothing but dwarfed and rotten tubercles, were still gay in blossom, and the cattle, which for nine months of the year have to be housed and handfed with more tenderness than their masters, were luxuriating in sunny grass."
                            },
                            {
                                "example_id": "d98119d4-536f-4dbf-abd7-382cde2f2f9b",
                                "sense_id": "289a93a8-c7c0-30e9-b275-7418c018ca6a",
                                "text": "Marjorie handfeeds one of her many pets, an orphaned joey, at Campbell Town."
                            },
                            {
                                "example_id": "cb31aa99-e009-4523-a7f2-298e784c69ba",
                                "sense_id": "289a93a8-c7c0-30e9-b275-7418c018ca6a",
                                "text": "It would be important to keep the total number of cattle handfed on property to a minimum."
                            }
                        ]
                    }
                ],
