                        "glosses": [
                            "Estrade qui soutient le trône roi de Perse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb7cd7cf-2635-4b5e-8b2e-4dd8965a06c0",
                                "sense_id": "6706e95e-a9f1-34db-a5b8-c4fb173a9149",
                                "text": "L’action se passe sur le bord de la mer, au palais du khan de Lenkran, dans la salle du conseil. Le khan est assis au haut bout du talar, sur le trône."
                            }
                        ]
                    },
