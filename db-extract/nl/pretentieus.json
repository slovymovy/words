                ],
                "senses": [
                    {
                        "sense_id": "4e14c5d7-d93d-3fbf-b71d-85fd891fc962",
                        "entry_id": "888c07ca-b9ae-37b2-bfa7-9dcc1b15996a",
                        "glosses": [
                            "verwaand, met veel pretenties"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de7013b0-446f-4986-a129-e7d7c16f37a3",
                                "sense_id": "4e14c5d7-d93d-3fbf-b71d-85fd891fc962",
                                "text": "Opvallend is dat Avant Arte veel kunstwerken plaatst die visueel krachtig zijn, kunstwerken waarbij je misschien makkelijker even blijft hangen wanneer je door je tijdlijn heen scrollt: „We willen niet pretentieus zijn, dus we plaatsen ook geen ingewikkelde teksten bij de werken: alleen de naam van het werk en de kunstenaar. Een klassieke galerie kan nogal intimiderend zijn, wij willen het tegenovergestelde zijn”, legt Luiten uit. „Wat wel grappig om te zien is, is hoe onze volgers in de reacties uitgebreid interpreteren en discussiëren over de kunstwerken.”"
                            },
                            {
                                "example_id": "736d7e32-7418-4f18-bf52-43f24c139d48",
                                "sense_id": "4e14c5d7-d93d-3fbf-b71d-85fd891fc962",
                                "text": "Goldie vond de naam Van Go duidelijk veel te pretentieus, omdat hij iets te veel aandachttrekkende Van Go-experimenten had meegemaakt en hij vond het hoog tijd om mij nu op mijn plek te zetten."
                            },
                            {
                                "example_id": "b26090fb-aff7-416c-9e5a-7efbd2d1ab24",
                                "sense_id": "4e14c5d7-d93d-3fbf-b71d-85fd891fc962",
                                "text": "Vanavond werd ik verplicht om naast graaf Bryston plaats te nemen, een pretentieuze blaaskaak die zeer weinig aan het hof is geweest. Hij is de bestuurder van een of ander godverlaten moerasland in het noorden en verkeert blijkbaar in de veronderstelling dat hij, vanwege de loyaliteit van zijn voorouders aan het koningshuis, over de koninklijke familie mag zeggen wat hij wil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eef8e01c-f21f-435d-bab7-de8c749314fa",
                        "source_entry_id": "888c07ca-b9ae-37b2-bfa7-9dcc1b15996a",
                        "source_sense_id": "4e14c5d7-d93d-3fbf-b71d-85fd891fc962",
                        "source_sense_description": "verwaand, met veel pretenties",
                        "target_lang_word": "pretentious",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pretentious",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46cd539f-e49f-317f-8fd0-966cbc4720a4",
                                        "entry_id": "a54f539a-6153-3622-8aa3-14add6393fee",
                                        "glosses": [
                                            "Motivated by an inappropriate, excessive, or unjustified desire to impress others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a569c19b-599b-4012-9f0d-0f849692faa4",
                                                "sense_id": "46cd539f-e49f-317f-8fd0-966cbc4720a4",
                                                "text": "Her dress was obviously more pretentious than comfortable."
                                            },
                                            {
                                                "example_id": "c0487ad9-b8e1-4d5f-bd4e-f9114d9f91d9",
                                                "sense_id": "46cd539f-e49f-317f-8fd0-966cbc4720a4",
                                                "text": "I recall the height of comfort attained by the green-cushioned \"first\" with starched white antimacassars and a pretentious grey floor mat on which it seemed a sacrilege to stand, as it was embellished with the North Western conception of Britannia, complete with trident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c6576c7-003b-3f98-ba9b-7dc95ff409f8",
                                        "entry_id": "a54f539a-6153-3622-8aa3-14add6393fee",
                                        "glosses": [
                                            "Marked by an unwarranted claim to importance or distinction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69ad8230-3ee1-43cc-81ba-286954219ed4",
                                                "sense_id": "1c6576c7-003b-3f98-ba9b-7dc95ff409f8",
                                                "text": "Their song titles are pretentious in the context of their basic lyrics."
                                            },
                                            {
                                                "example_id": "1325e290-00b5-4c76-9591-6a5023548eb7",
                                                "sense_id": "1c6576c7-003b-3f98-ba9b-7dc95ff409f8",
                                                "text": "The station (1840) was originally Cheltenham but the more grandiose Cheltenham Spa since 1925, which feels a bit pretentious as the town has never allowed itself to assume such airs and graces."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
