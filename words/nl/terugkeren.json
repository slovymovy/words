{
    "word_family": [
        "keer",
        "terugkeer",
        "omkeren",
        "bekeren",
        "verkeren"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b0b16c9c-9730-39c2-a34e-d2a918170334",
                    "sense_definition": "gaan naar een plaats waar men eerder vandaan kwam",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "terugkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na een lange vakantie in het buitenland wilde de familie eindelijk <w>terugkeren</w> naar huis.",
                            "target_lang_translations": {
                                "en": "After a long holiday abroad, the family finally wanted to <w>return</w> home."
                            }
                        },
                        {
                            "text": "Hij besloot om na zijn studie direct naar zijn geboortedorp <w>terug te keren</w>.",
                            "target_lang_translations": {
                                "en": "He decided to <w>go back</w> to his home village immediately after his studies."
                            }
                        }
                    ],
                    "synonyms": [
                        "weerkomen",
                        "terugkomen"
                    ],
                    "antonyms": [
                        "vertrekken",
                        "weggaan"
                    ],
                    "common_phrases": [
                        "terugkeren naar huis",
                        "veilig terugkeren",
                        "terugkeren van vakantie"
                    ],
                    "target_lang_definitions": {
                        "en": "to go to a place where one previously came from"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "return",
                                "target_lang_sense_clarification": "to come or go back to a place"
                            },
                            {
                                "target_lang_word": "go back",
                                "target_lang_sense_clarification": "to return to a previous location"
                            },
                            {
                                "target_lang_word": "come back",
                                "target_lang_sense_clarification": "to return to where the speaker is"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e60c75d-3464-339d-8d76-26f8e305c60b",
                    "sense_definition": "opnieuw verschijnen na gedurende enige tijd te zijn weggeweest",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "herhaling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Iedereen vraagt zich af of de warme zomer dit jaar nog zal <w>terugkeren</w>.",
                            "target_lang_translations": {
                                "en": "Everyone wonders if the warm summer will <w>return</w> again this year."
                            }
                        },
                        {
                            "text": "De rust in de stad begon langzaam <w>terug te keren</w> na de grote demonstratie.",
                            "target_lang_translations": {
                                "en": "Peace and quiet slowly began to <w>return</w> to the city after the large demonstration."
                            }
                        }
                    ],
                    "synonyms": [
                        "weerkomen"
                    ],
                    "antonyms": [
                        "verdwijnen"
                    ],
                    "common_phrases": [
                        "rust keert terug",
                        "jaarlijks terugkeren"
                    ],
                    "target_lang_definitions": {
                        "en": "to reappear after having been away for some time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "return",
                                "target_lang_sense_clarification": "to recur or come again"
                            },
                            {
                                "target_lang_word": "reappear",
                                "target_lang_sense_clarification": "to become visible or present again"
                            },
                            {
                                "target_lang_word": "come back",
                                "target_lang_sense_clarification": "to start happening or existing again"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3beeeec9-31a3-3eb3-b561-1b61a9e1fbe8",
                    "sense_definition": "opnieuw in het bezit komen van de rechtmatige eigenaar",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bezit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gestolen schilderijen zullen uiteindelijk <w>terugkeren</w> naar de oorspronkelijke eigenaar.",
                            "target_lang_translations": {
                                "en": "The stolen paintings will eventually <w>be returned</w> to the original owner."
                            }
                        },
                        {
                            "text": "Na de rechtszaak moesten alle documenten onmiddellijk naar het archief <w>terugkeren</w>.",
                            "target_lang_translations": {
                                "en": "After the lawsuit, all documents had to <w>return</w> to the archive immediately."
                            }
                        }
                    ],
                    "common_phrases": [
                        "terugkeren naar de eigenaar"
                    ],
                    "target_lang_definitions": {
                        "en": "to come back into the possession of the rightful owner"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "return",
                                "target_lang_sense_clarification": "to be given back to the original owner"
                            },
                            {
                                "target_lang_word": "be restored",
                                "target_lang_sense_clarification": "to be returned to a former owner or condition"
                            },
                            {
                                "target_lang_word": "go back",
                                "target_lang_sense_clarification": "to revert to a previous owner"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}