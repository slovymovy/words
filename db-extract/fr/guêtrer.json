                ],
                "senses": [
                    {
                        "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                        "entry_id": "bddc9138-a46d-3c4e-a421-680429cf72bf",
                        "glosses": [
                            "Chausser de guêtres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f23e293-9ca1-4bab-ab00-a276e4624c46",
                                "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                                "text": "Il est bien, il est mal guêtré."
                            },
                            {
                                "example_id": "d014bc55-a5fb-402f-9e83-44ba112c5a39",
                                "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                                "text": "On voyait dans les chemins des bandes de vignerons, guêtrés de coutil et la serpette au genou, allant bêcher leurs vignes."
                            },
                            {
                                "example_id": "d1c97714-da56-4f2f-bc24-ed9cde9aa641",
                                "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                                "text": "En trois minutes, il est prêt, guêtré, coiffé du képi pour jusqu’au soir."
                            },
                            {
                                "example_id": "41e7e73c-1a5a-492d-8eb0-111d3bf15a72",
                                "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                                "text": "Je me revois guêtré, le fusil sous le bras, à l’affût dès l’aube rose, tandis que mes chiens donnaient de la voix par les halliers."
                            },
                            {
                                "example_id": "4cc1fe31-d289-4212-935f-3b96d6ccd54e",
                                "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                                "text": "Le chauffeur était descendu de la cabine, et le dos accoté au capot de la voiture, il allumait une cigarette. C’était un grand garçon vulgaire et bien bâti, avec une petite moustache en virgule sous le nez. Il avait croisé ses jambes guêtrées de cuir, et regardait droit devant lui d’un air distant."
                            },
                            {
                                "example_id": "73fc35ab-26f7-470b-9480-fb863c9a17a8",
                                "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                                "text": "Très élégant, guêtré de gris, veston noir, pantalon à rayures, il ne parlait jamais de la guerre."
                            },
                            {
                                "example_id": "14b04c4d-443f-4d21-bfa0-14fadb99ff5d",
                                "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                                "text": "Se guêtrer."
                            },
                            {
                                "example_id": "9500529f-fd94-4852-b364-e987f20c28ff",
                                "sense_id": "df64e9a1-91cb-3e91-ad98-451c21c206a6",
                                "text": "Vous voilà bien guêtré !"
                            }
                        ]
                    },
                    {
                        "sense_id": "fe8262ed-0659-3fbb-b83b-a4db8f98ea96",
                        "entry_id": "bddc9138-a46d-3c4e-a421-680429cf72bf",
                        "glosses": [
                            "Dont le bas des jambes est recouvert comme de guêtres."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "77671f28-c51f-4559-b6c4-5635b4f2f62c",
                                "sense_id": "fe8262ed-0659-3fbb-b83b-a4db8f98ea96",
                                "text": "Prisonnier, il venait d’être délivré par l’armistice. En guenilles, les yeux luisants de fièvre, barbu, guêtré de boue, il s’était arrêté pour saluer, sur le seuil."
                            }
                        ]
                    }
                ],
