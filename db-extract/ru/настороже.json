                                "target_word": "on the alert",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f178a6ff-e372-3853-8588-7323144d56c9",
                                        "entry_id": "c7ceab29-5707-3272-8109-518a73820fe6",
                                        "glosses": [
                                            "Very attentive, or vigilant"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94302549-bbfe-4fda-939c-fb5768330590",
                                                "sense_id": "f178a6ff-e372-3853-8588-7323144d56c9",
                                                "text": "Wild animals have to be constantly on the alert for predators."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
