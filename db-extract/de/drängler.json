                "senses": [
                    {
                        "sense_id": "0b4d9e61-82c0-366b-9042-64b47194d0d3",
                        "entry_id": "950d8ee5-0414-3fa2-b4fb-c594320ae839",
                        "glosses": [
                            "Person, die drängelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3afcbeca-cc8e-4184-b7d7-7ffb9182ca5d",
                                "sense_id": "0b4d9e61-82c0-366b-9042-64b47194d0d3",
                                "text": "„Drängler bringen 55 Prozent der Teilnehmer an einer Umfrage des Online-Automarkts AutoScout24 in Rage. Vor allem Frauen sehen bei Dränglern Rot: 59 Prozent ärgern sich über Lenker, die auf der Autobahn ständig zu dicht auffahren.“"
                            },
                            {
                                "example_id": "c2736895-f8d8-4bbe-a169-802528d00e39",
                                "sense_id": "0b4d9e61-82c0-366b-9042-64b47194d0d3",
                                "text": "„Nach einer kilometerlangen Verfolgungsjagd hat die Polizei auf der Autobahn 3 bei Erlangen einen Raser und Drängler gestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
