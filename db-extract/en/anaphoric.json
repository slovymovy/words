                                "target_senses": [
                                    {
                                        "sense_id": "f1f58dac-a04f-3d2d-b648-bfe3119eb449",
                                        "entry_id": "a296deec-98c9-3480-8f9f-7091ad2c9cf1",
                                        "glosses": [
                                            "Propre à l'anaphore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "126079fe-5079-41b5-9549-c7d9c41ef085",
                                                "sense_id": "f1f58dac-a04f-3d2d-b648-bfe3119eb449",
                                                "text": "Ce système de référence anaphorique est étranger aux langues amérindiennes dont nous avons parlé, alors que l’ambiguïté fonctionnelle, propre à l’eyak, est totalement étrangère à l’aléoute : […]"
                                            },
                                            {
                                                "example_id": "d7ed6d6c-b0b3-47a0-bfb0-91ecc3b7e730",
                                                "sense_id": "f1f58dac-a04f-3d2d-b648-bfe3119eb449",
                                                "text": "Apparemment, l’article zéro devant Npr force l’interprétation déictique, alors que l’article défini laisse ouverte la possibilité d’une interprétation anaphorique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d928bbac-8466-46e0-b2fc-927ceb7609d9",
                        "source_entry_id": "4a17b699-37a2-346b-9a61-b0682037ec23",
                        "source_sense_id": "ee397fda-2a6e-34c2-a427-e025d3f4bed6",
                        "source_sense_description": "relating to an anaphora",
                        "target_lang_word": "anaphorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anaphorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "084de825-e0c5-3906-a6e7-e205f9630caa",
                                        "entry_id": "3a1bb053-0666-3d2d-9164-7b8184b294dc",
                                        "glosses": [
                                            "eine frühere Textstelle wiederaufnehmend; rückverweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "737867c3-0868-4a7c-9e9e-ee3386b716e7",
                                                "sense_id": "084de825-e0c5-3906-a6e7-e205f9630caa",
                                                "text": "„Dabei verweist anaphorisch auf etwas bereits Erwähntes, kataphorisch deutet auf etwas Folgendes hin.“"
                                            },
                                            {
                                                "example_id": "2b1ac941-18e9-4e81-b280-ae71c6e867a6",
                                                "sense_id": "084de825-e0c5-3906-a6e7-e205f9630caa",
                                                "text": "„Die kognitive Zugänglichkeit des Erstglieds hängt eng mit dem Aufbau anaphorischer Referenz zum Erstglied zusammen.“"
                                            },
                                            {
                                                "example_id": "acee6ec4-ed75-45b2-9c44-8facc71b0bc4",
                                                "sense_id": "084de825-e0c5-3906-a6e7-e205f9630caa",
                                                "text": "„Die dritte Funktion der Deixis, der anaphorische Gebrauch, schafft Verweise innerhalb der Rede selbst […].“"
                                            },
                                            {
                                                "example_id": "d8a69bc5-ef2c-4306-96c4-c6639c6707ec",
                                                "sense_id": "084de825-e0c5-3906-a6e7-e205f9630caa",
                                                "text": "„Die deiktische Referenz und die anaphorische Referenz sind daher eigentlich auf unterschiedlichen Ebenen angesiedelt.“"
                                            },
                                            {
                                                "example_id": "7a68639e-6878-4d23-ba1b-25aa8ec0dbb4",
                                                "sense_id": "084de825-e0c5-3906-a6e7-e205f9630caa",
                                                "text": "„Demonstrativa haben in den meisten Sprachen auch anaphorische Verwendungen.“"
                                            },
                                            {
                                                "example_id": "c58587f3-bd69-4419-a01e-d6f8f26cd6f1",
                                                "sense_id": "084de825-e0c5-3906-a6e7-e205f9630caa",
                                                "text": "„Es signalisiert die Topikeinführung und zugleich die anaphorische Verbindung zum rhematischen Referenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee5cb7b4-05ee-384e-a7ed-58524f3cdb35",
                                        "entry_id": "3a1bb053-0666-3d2d-9164-7b8184b294dc",
                                        "glosses": [
                                            "Wörter oder Wortgruppen am Anfang von Sätzen oder Versen wiederholend"
                                        ],
                                        "tags": [
                                            "Rhetorik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1fe2f93-7d34-4623-a26a-8cc5bd98ec40",
                                                "sense_id": "ee5cb7b4-05ee-384e-a7ed-58524f3cdb35",
                                                "text": "„So sind mehrere Sonette durchgängig anaphorisch strukturiert, was schon Petrarca in die europäische Sonettdichtung eingeführt hatte.“"
                                            },
                                            {
                                                "example_id": "c2837638-593f-4195-b7ba-7dd82020078b",
                                                "sense_id": "ee5cb7b4-05ee-384e-a7ed-58524f3cdb35",
                                                "text": "„Zwar lassen sich anaphorische Gedichte bereits im Frühwerk vor 1948 finden, und auch in den in traditioneller Form verfassten Gedichten wurde die rhythmische Glätte bereits oft durch Enjambements gestört.“"
                                            },
                                            {
                                                "example_id": "529d1032-f9a3-4ea9-8935-d3e7d6fe60fb",
                                                "sense_id": "ee5cb7b4-05ee-384e-a7ed-58524f3cdb35",
                                                "text": "„Die Tatsache, daß ihr ein Stern verliehen wird, betont das Gedicht durch anaphorische Wiederholung (V. 9 u. 15).“"
                                            },
                                            {
                                                "example_id": "29ac0a86-a35d-412d-a6dc-4f275c0024a3",
                                                "sense_id": "ee5cb7b4-05ee-384e-a7ed-58524f3cdb35",
                                                "text": "„Syntaktisch ist das Gedicht durch eine anaphorische Wenn-Dann-Struktur gegliedert, die allerdings keineswegs eindeutig verläuft.“"
                                            },
                                            {
                                                "example_id": "3e0b600b-91d7-4b62-b6b4-c4597823a380",
                                                "sense_id": "ee5cb7b4-05ee-384e-a7ed-58524f3cdb35",
                                                "text": "„Konsistenz verleiht dem Gedicht der mehrfache anaphorische Beginn aufeinanderfolgender Zeilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
