                        "examples": [
                            {
                                "example_id": "1c832672-7c21-4b84-8283-b338bdc24f39",
                                "sense_id": "708ec71e-c9b3-3d70-a525-bda04512ad86",
                                "text": "Смотри-кось, брат, какую машинищу Иван Онуфрич изладил!"
                            },
                            {
                                "example_id": "f8692b1a-c835-4ade-a143-0bb01c1ef1f5",
                                "sense_id": "708ec71e-c9b3-3d70-a525-bda04512ad86",
                                "text": "― Линолеум у вас скверно положен, ― говорит Андрей. ― Ну, ничего, я потом излажу как надо."
                            }
                        ]
                    }
