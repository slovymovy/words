                        "examples": [
                            {
                                "example_id": "8615d04b-ea19-454a-ab22-8d47930eac39",
                                "sense_id": "f4ebdd08-b391-303c-a905-343fe53cd838",
                                "text": "Aan de andere kant dorade, de grijze zeebrasem die meestal uit de kweek komt. De roze brasem, die je in onze restaurants niet vaak tegenkomt, is vaak gevangen 'in het wild'."
                            },
                            {
                                "example_id": "949926b2-4453-495c-a2d8-9cc4c2422026",
                                "sense_id": "f4ebdd08-b391-303c-a905-343fe53cd838",
                                "text": "Bij een stukje prima gebakken maar wel wat afgekoelde zeebrasem komt pastinaakpuree, lamsoor, zeekraal en palmkool. Die laatste is ruw en rauw, het gerecht mist zout en het geheel is ongebalanceerd zuur door kwistig gestrooide kappertjes vol azijn."
                            }
                        ]
                    }
