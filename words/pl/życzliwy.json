                    "frequency": "High",
                    "semantic_group_id": "cecha_charakteru",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ona jest bardzo <w>życzliwa</w> i chętnie pomogła mi w trudnej sytuacji.",
