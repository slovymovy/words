                "senses": [
                    {
                        "sense_id": "9c66af0d-0753-31ca-b11b-c6a7d6ce837c",
                        "entry_id": "eae484ff-d5d7-36ea-a898-8151ee073f1a",
                        "glosses": [
                            "Qui ressemble au sucre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40f2fdc-8c37-45c6-9389-64398f16e5fa",
                                "sense_id": "9c66af0d-0753-31ca-b11b-c6a7d6ce837c",
                                "text": "L'éclat du zircon peut être adamantin, chatoyant ou saccharoïde."
                            },
                            {
                                "example_id": "b6232714-3cf9-476e-8103-6d95bebab8b1",
                                "sense_id": "9c66af0d-0753-31ca-b11b-c6a7d6ce837c",
                                "text": "Le gypse se présente également sous une forme massive dont l’aspect rappelle celui du sucre, d’où le terme de gypse saccharoïde, ou sous forme de masses fibreuses."
                            },
                            {
                                "example_id": "68f080d7-a982-4aef-ac22-2339b56ce58e",
                                "sense_id": "9c66af0d-0753-31ca-b11b-c6a7d6ce837c",
                                "text": "La calcite qui confère un aspect saccharoïde à la roche est souvent accompagnée de minéraux accessoires comme des grenats, du pyroxène (diopside) et de l’olivine (forstérite), en liaison avec la présence de silicium et de magnésium."
                            }
                        ]
                    }
