        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b244f067-6c53-3340-8c9d-08c91e136545",
                    "sense_definition": "Extremely wet; completely saturated with liquid.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wetness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After walking home through the thunderstorm, my clothes were <w>soaking</w> wet.",
                            "target_lang_translations": {
                                "ru": "После прогулки домой под грозой моя одежда была <w>насквозь</w> мокрой."
                            }
                        },
                        {
                            "text": "Take off your <w>soaking</w> shoes before you step onto the clean carpet.",
                            "target_lang_translations": {
                                "ru": "Сними свои <w>промокшие насквозь</w> туфли, прежде чем наступать на чистый ковёр."
                            }
