                        "glosses": [
                            "Any large grasshopper of the genus Schistocerca."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "dfdbbec4-34f7-4183-ac0c-61f68beb8ae6",
                                "sense_id": "20f80c93-8c42-3a02-9b1a-dfca19011c8e",
                                "text": "All the other schistocercas, except for the desert locust, schistocerca gregaria, (responsible for biblical and modern day plagues in Africa) are found in the New World."
                            },
                            {
                                "example_id": "24531e25-fbd6-4aef-b979-c2c14a479aee",
                                "sense_id": "20f80c93-8c42-3a02-9b1a-dfca19011c8e",
                                "text": "Schistocercas shouldn't be such fussy eaters. We give them dried oats and green cabbage but they should also be able to survive on grass, carrots, anything really."
                            }
                        ]
                    }
