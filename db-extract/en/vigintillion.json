                    {
                        "translation_id": "cd967c4a-4292-4894-981b-237171d84c98",
                        "source_entry_id": "7870d596-dfa2-3dbe-a8cf-e235a970c11d",
                        "source_sense_id": "9326f387-0d97-3039-b49f-feffc887ea2b",
                        "source_sense_description": "1063",
                        "target_lang_word": "вигинтиллио́н",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вигинтиллио́н",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "15879128-2b27-3437-9bc9-75232c4dea7f",
                                        "entry_id": "506011e6-45fa-3a53-8d83-a93187d56c7f",
                                        "glosses": [
                                            "матем. в США: тысяча новемдециллионов; число, равное 10⁶³ и записываемое в десятичной системе как единица с 63 нулями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94e7e0d9-6f57-42b6-81ae-91a39ee68f4f",
                                                "sense_id": "15879128-2b27-3437-9bc9-75232c4dea7f",
                                                "text": ".. двадцать по-латыни viginti (виги́нти); значит, наше число следует назвать «вигинтиллион»."
                                            },
                                            {
                                                "example_id": "2b5011c4-742b-41c3-85e5-b0a6d56a85f2",
                                                "sense_id": "15879128-2b27-3437-9bc9-75232c4dea7f",
                                                "text": "Для сравнения: в миллионе 6 нулей, в миллиарде — 9, в триллионе — 12, а в квадриллионе — 15 нулей. За квинтиллионом следует секстиллион (21 нуль), септиллион (24 нуля) и так далее вплоть до вигинтиллиона. Это число с 63 нулями."
                                            },
                                            {
                                                "example_id": "162b5798-9492-4c24-9069-babcc7dec98e",
                                                "sense_id": "15879128-2b27-3437-9bc9-75232c4dea7f",
                                                "text": "Однако вам никогда не приходится об этом задумываться, потому что каждую секунду каждого дня ваше тело выполняет в буквальном смысле бессчётное число задач: квадриллион, нониллион, квиндециллион, вигинтиллион (это всё реально существующие понятия) – в общем, число, значительно превосходящее возможности человеческой фантазии, – и при этом не требует ни мгновения вашего внимания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5729a54b-82d5-39a5-9d55-c8b6f434bbb4",
                                        "entry_id": "506011e6-45fa-3a53-8d83-a93187d56c7f",
                                        "glosses": [
                                            "матем. в Британии: миллион новемдециллионов; число, равное 10¹²⁰ и записываемое в десятичной системе как единица с 120 нулями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a415a38-9540-401e-a831-0c1deaf67a54",
                                                "sense_id": "5729a54b-82d5-39a5-9d55-c8b6f434bbb4",
                                                "text": "В Великобритании же, Германии и Испании есть число в сто миллиардов миллиардов раз больше гугола – это вигинтиллион, содержащий 120 нулей! Не путайте его с российско-американским вигинтиллионом."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
