                                        "glosses": [
                                            "Digno de ser amado."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e14a021-2898-452d-b08f-c75ec16741e6",
                                                "sense_id": "8b9dfb9a-b6a9-3046-9555-e42524263c03",
                                                "text": "«Desde luego, gracias al amable público de la radio, que comparte estas inquietudes conmigo, ha sido posible realizar esta labor»."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
