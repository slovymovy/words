                                "target_senses": [
                                    {
                                        "sense_id": "3775919d-e34b-3f60-a307-7d8aaea4f0f8",
                                        "entry_id": "3207836d-0fd4-30ce-b011-28bc35cce917",
                                        "glosses": [
                                            "Ensemble des branches de la physique qui utilisent la mécanique quantique dans leurs travaux."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b9e8bb-256e-4746-96a6-5c170f72e87e",
                                                "sense_id": "3775919d-e34b-3f60-a307-7d8aaea4f0f8",
                                                "text": "Est-il vrai que la physique moderne, la « physique quantique » pour l’appeler par son nom, soit si difficile que seuls des scientifiques de haut niveau soient en mesure de la comprendre ?"
                                            },
                                            {
                                                "example_id": "02c56002-9bf2-4744-b33e-90cc6172c14c",
                                                "sense_id": "3775919d-e34b-3f60-a307-7d8aaea4f0f8",
                                                "text": "La physique quantique nous a appris qu'il n'y a pas de réalité. L'univers que nous percevons n'est qu'une somme infinie de possibles."
                                            },
                                            {
                                                "example_id": "84fde414-e87b-4f3d-b93f-e10513b520a6",
                                                "sense_id": "3775919d-e34b-3f60-a307-7d8aaea4f0f8",
                                                "text": "L’intrication désigne une propriété étrange de la physique quantique, théorie qui décrit la matière aux petites échelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
