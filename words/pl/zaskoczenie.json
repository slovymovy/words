                    "sense_definition": "stan emocjonalny wywołany przez coś nieoczekiwanego",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "emocje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jej twarzy malowało się wielkie <w>zaskoczenie</w>.",
