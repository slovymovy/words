    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d8d2c3ec-0465-38c9-b8f3-8d725888ec1a",
                    "sense_definition": "Feeling or showing pleasure, contentment, or joy.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Listening to upbeat music always makes me feel <w>happy</w> and energetic.",
                            "target_lang_translations": {
                                "ru": "Прослушивание энергичной музыки всегда заставляет меня чувствовать себя <w>счастливым</w> и полным сил."
                            }
                        },
                        {
                            "text": "The children were <w>happy</w> as a lark while playing in the park all afternoon.",
                            "target_lang_translations": {
                                "ru": "Дети были <w>счастливы</w> как никогда, играя в парке весь день."
                            }
                        }
                    ],
                    "synonyms": [
                        "cheerful",
                        "contented",
                        "joyful",
                        "glad",
                        "merry"
                    ],
                    "antonyms": [
                        "sad",
                        "unhappy",
                        "miserable",
                        "depressed"
                    ],
                    "common_phrases": [
                        "happy as a lark",
                        "feel happy",
                        "look happy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Чувство или проявление удовольствия, удовлетворения или радости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "счастливый",
                                "target_lang_sense_clarification": "ощущающий счастье"
                            },
                            {
                                "target_lang_word": "радостный",
                                "target_lang_sense_clarification": "выражающий радость"
                            },
                            {
                                "target_lang_word": "довольный",
                                "target_lang_sense_clarification": "удовлетворенный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "db4ff900-6599-3d2e-a42d-b621f1896e6e",
                    "sense_definition": "Used in greetings to wish someone well during a specific celebration or event.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "greetings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wanted to be the first person to wish you a <w>happy</w> birthday today.",
                            "target_lang_translations": {
                                "ru": "Я хотел быть первым, кто поздравит тебя <w>с</w> днем рождения сегодня."
                            }
                        },
                        {
                            "text": "Everyone gathered around the table to shout <w>happy</w> anniversary to the couple.",
                            "target_lang_translations": {
                                "ru": "Все собрались вокруг стола, чтобы поздравить пару <w>с</w> годовщиной."
                            }
                        }
                    ],
                    "common_phrases": [
                        "happy birthday",
                        "happy anniversary",
                        "happy holidays"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в поздравлениях, чтобы пожелать кому-то благополучия во время праздника или события."
