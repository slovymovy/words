                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3735d968-1a52-4d00-85c4-a36a0c6c76b4",
                                "sense_id": "d8e33bae-b55a-3b12-a0cc-7c2433c962f6",
                                "text": "Door zijn ziekte had hij last van bevingen en verkrampingen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee1e9f02-1f54-4910-8bab-e036df50198d",
                        "source_entry_id": "e9215be2-1d25-398b-9351-7ab1bb09254e",
                        "source_sense_id": "fac3da41-efae-3d23-9c4b-f21a3a7b860e",
                        "source_sense_description": "aardbeving",
                        "target_lang_word": "quake",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f08865d-cdf4-36f2-b442-3bbf42bfdc43",
                                        "entry_id": "c0fbc932-8652-3d74-951c-a80b42a808c6",
                                        "glosses": [
                                            "A trembling or shaking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ec32de3-48a3-4ab5-bd48-f624e9ed1eb1",
                                                "sense_id": "0f08865d-cdf4-36f2-b442-3bbf42bfdc43",
                                                "text": "We felt a quake in the apartment every time the train went by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64246f2a-46d1-3f95-be4c-3d5449831dcf",
                                        "entry_id": "c0fbc932-8652-3d74-951c-a80b42a808c6",
                                        "glosses": [
                                            "An earthquake, a trembling of the ground with force."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a69271b-b440-4b90-80aa-c53e644be3c3",
                                                "sense_id": "64246f2a-46d1-3f95-be4c-3d5449831dcf",
                                                "text": "California is plagued by quakes; there are a few minor ones almost every month."
                                            },
                                            {
                                                "example_id": "895b78bd-7766-4b2b-abdf-6e58471fecc0",
                                                "sense_id": "64246f2a-46d1-3f95-be4c-3d5449831dcf",
                                                "text": "Well, everybody talks about the California quakes\nBut the first time I ever felt the earth shake\nWas in Miami, when Amy touched me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a15c0a30-d5fb-3d6a-8437-4badf4aab691",
                                        "entry_id": "c0fbc932-8652-3d74-951c-a80b42a808c6",
                                        "glosses": [
                                            "Something devastating, like a strong earthquake."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0c55a12-f8df-4b0b-a33f-847a088bbf7f",
                                                "sense_id": "a15c0a30-d5fb-3d6a-8437-4badf4aab691",
                                                "text": "But HS1 was more exposed to the COVID quake than most given its inherent reliance on international travel, which had collapsed, leaving cross-Channel operator Eurostar stacked with millions of debt."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quake",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9302ee7-1b47-3e98-b931-6a7fd66edeb0",
                                        "entry_id": "5661c46b-0ff6-39e1-b843-c30086aff8a6",
                                        "glosses": [
                                            "To tremble or shake."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "913befef-428a-49d0-a7f5-1e6cff8b92ae",
                                                "sense_id": "c9302ee7-1b47-3e98-b931-6a7fd66edeb0",
                                                "text": "I felt the ground quaking beneath my feet."
                                            },
                                            {
                                                "example_id": "630f7870-9892-4171-9399-561fb16e7662",
                                                "sense_id": "c9302ee7-1b47-3e98-b931-6a7fd66edeb0",
                                                "text": "Dorus threw Pamela behind a tree; where she stood quaking like the partridge on which the hawk is even ready to seize.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "96c307e3-572c-4ae0-a005-fc3d28d5cf8f",
                                                "sense_id": "c9302ee7-1b47-3e98-b931-6a7fd66edeb0",
                                                "text": "The mountains quake at him, and the hills melt, and the earth is burnt at his presence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dfa2b97-62ac-3a57-8555-7cfb411cdb9a",
                                        "entry_id": "5661c46b-0ff6-39e1-b843-c30086aff8a6",
                                        "glosses": [
                                            "To be in a state of fear, shock, amazement, etc., such as might cause one to tremble."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "620a96f7-0bf2-4949-a211-8ce1a20c5c58",
                                                "sense_id": "0dfa2b97-62ac-3a57-8555-7cfb411cdb9a",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            },
                                            {
                                                "example_id": "aa1d36b7-2eba-455b-853e-be5f2100233f",
                                                "sense_id": "0dfa2b97-62ac-3a57-8555-7cfb411cdb9a",
                                                "text": "If Cupid have not spent all his quiver in / Venice, thou wilt quake for this shortly."
                                            },
                                            {
                                                "example_id": "b41ff8ac-dd57-4dd0-a8df-9c7e2befe184",
                                                "sense_id": "0dfa2b97-62ac-3a57-8555-7cfb411cdb9a",
                                                "text": "Now could I drink hot blood / And do such bitter business as the bitter day / Would quake to look on."
                                            },
                                            {
                                                "example_id": "23771412-30a4-4687-90c1-a37b080300eb",
                                                "sense_id": "0dfa2b97-62ac-3a57-8555-7cfb411cdb9a",
                                                "text": "Who honours not his father, Henry the fifth, that made all France to quake, Shake he his weapon at us, and pass by."
                                            },
                                            {
                                                "example_id": "ef9d35f2-827c-41f8-a13f-880e4279b369",
                                                "sense_id": "0dfa2b97-62ac-3a57-8555-7cfb411cdb9a",
                                                "text": "Son of man, eat thy bread with quaking, and drink thy water with trembling and carefulness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "787003d3-0263-4314-8103-65fdd6a0479d",
                        "source_entry_id": "e9215be2-1d25-398b-9351-7ab1bb09254e",
