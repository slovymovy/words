                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "34cd8d7d-aba0-3a83-a801-c40f9d04f42e",
                                        "entry_id": "3651b2d2-523b-3abb-b085-b5a3b4c3daca",
                                        "glosses": [
                                            "взаимная зависимость или механическая соединённость каких-либо объектов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f77ed636-dd10-4b4a-ae48-cb3cd3a45deb",
                                                "sense_id": "34cd8d7d-aba0-3a83-a801-c40f9d04f42e",
                                                "text": "Отгадать — это значит понять признаки умалчиваемого предмета, установить между двумя различными предметами или явлениями родственные связи."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4158e57b-966d-362b-aedb-9096f28243bf",
                                        "entry_id": "3651b2d2-523b-3abb-b085-b5a3b4c3daca",
                                        "glosses": [
                                            "любовные отношения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06dee25-be24-4713-9111-fd1ecffb1041",
                                                "sense_id": "4158e57b-966d-362b-aedb-9096f28243bf",
                                                "text": "Жена узнала, что муж был в связи с бывшею в их доме француженкою-гувернанткой, и объявила мужу, что не может жить с ним в одном доме."
                                            },
                                            {
                                                "example_id": "9ac3e8e6-9548-4377-a703-5ffb302c836c",
                                                "sense_id": "4158e57b-966d-362b-aedb-9096f28243bf",
                                                "text": "Никто не знал о нашей связи, за это я вам ручаюсь, хотя так никогда и не бывает."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9305f9aa-52e3-34d7-a392-bd9cb44e1d4e",
                                        "entry_id": "3651b2d2-523b-3abb-b085-b5a3b4c3daca",
                                        "glosses": [
                                            "мн. ч. наличие высокопоставленных знакомых, покровителей; знакомство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "002c05df-d57b-49e0-a128-7a6c07c19e1f",
                                                "sense_id": "9305f9aa-52e3-34d7-a392-bd9cb44e1d4e",
                                                "text": "У него обширные связи в высших кругах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9da83d-85cb-3b76-addc-7b30f7739626",
                                        "entry_id": "3651b2d2-523b-3abb-b085-b5a3b4c3daca",
                                        "glosses": [
                                            "раздел техники и соответствующая отрасль народного хозяйства, имеющие отношение к средствам передачи сигналов на расстоянии."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02bfdef-2956-463d-8b8c-2b67d234615a",
                                                "sense_id": "bf9da83d-85cb-3b76-addc-7b30f7739626",
                                                "text": "Министр связи."
                                            },
                                            {
                                                "example_id": "7a1de62f-8ba7-4ff6-8a54-63668d3854f0",
                                                "sense_id": "bf9da83d-85cb-3b76-addc-7b30f7739626",
                                                "text": "Отрасль связи."
                                            },
                                            {
                                                "example_id": "aed0e6f7-e81f-4c14-a483-ec42b58102ae",
                                                "sense_id": "bf9da83d-85cb-3b76-addc-7b30f7739626",
                                                "text": "Предприятие связи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
