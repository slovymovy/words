                "senses": [
                    {
                        "sense_id": "dc2546ce-d5cb-32db-b1ac-5bedd460edb7",
                        "entry_id": "c0b994a3-eaa9-364e-a10d-6864dd546a03",
                        "glosses": [
                            "mała, kieszonkowa, zamykana torebka na bilon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b0ba1de-f8db-4106-b1af-69b90e0cadc3",
                                "sense_id": "dc2546ce-d5cb-32db-b1ac-5bedd460edb7",
                                "text": "Przechodzień wyjął z portmonetki kilka monet."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fdf117d-e7f3-46aa-a449-593455737db2",
                        "source_entry_id": "c0b994a3-eaa9-364e-a10d-6864dd546a03",
                        "source_sense_id": "dc2546ce-d5cb-32db-b1ac-5bedd460edb7",
                        "target_lang_word": "coin purse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coin purse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "610a9980-fb6f-39b7-9d7d-fd8b958fa7ef",
                                        "entry_id": "9311dd47-8ef5-369c-a225-c1fc1c2d1de4",
                                        "glosses": [
                                            "A small bag or pouch designed for carrying money, particularly coins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b865ec2d-a77c-49d6-8a1f-eb5f4dded3b1",
                                                "sense_id": "610a9980-fb6f-39b7-9d7d-fd8b958fa7ef",
                                                "text": "“I have gold,” Mananda repeated to the men as they drew closer, and he shook his coin purse, ringing the coins together."
                                            },
                                            {
                                                "example_id": "057bb458-042a-494d-9e26-2b4089ee6e5d",
                                                "sense_id": "610a9980-fb6f-39b7-9d7d-fd8b958fa7ef",
                                                "text": "As I grabbed my donuts and turned, all the change from my coin purse flew out and landed all over the store floor, under twenty sets of feet."
                                            },
                                            {
                                                "example_id": "eda02b85-fef2-4089-b42d-693205c310ce",
                                                "sense_id": "610a9980-fb6f-39b7-9d7d-fd8b958fa7ef",
                                                "text": "“I can't find the change I got from the gas station.” She snapped open her coin purse in hopes that she'd stuck it there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bdc46aa-9b8e-3e01-90a6-687b4d574606",
                                        "entry_id": "9311dd47-8ef5-369c-a225-c1fc1c2d1de4",
                                        "glosses": [
                                            "Testicles."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6025adcd-b9a5-4f6c-8846-6dacdd3a1bbf",
                                                "sense_id": "3bdc46aa-9b8e-3e01-90a6-687b4d574606",
                                                "text": "Before YouTube debuted with countless videos of dudes getting kicked in the coin purse, one of the hottest things on the Internet was Laid Off, a series of animated shorts about a guy in a blue bathrobe who reflects on his joblessness."
                                            },
                                            {
                                                "example_id": "1f0b3bd4-86ba-41d1-9407-b62ba4c555ed",
                                                "sense_id": "3bdc46aa-9b8e-3e01-90a6-687b4d574606",
                                                "text": "That is partially what was so great about the brief interaction between Kevin Love and Louis Scola the other night. It was malicious, perhaps, and invites us to qualify dirty play and physical play, but it was a shade of Laimbeer – boys being boys. A week or so ago, Scola had chicken legged Love – a la every schoolyard basketball game – while attempting to save the ball from going out of bounds, only he tagged Love in his coin purse."
                                            },
                                            {
                                                "example_id": "5228c9ec-c715-4e3e-9b17-1a160b77db48",
                                                "sense_id": "3bdc46aa-9b8e-3e01-90a6-687b4d574606",
                                                "text": "The classy trend of kneeing a man in his coin purse once seemed fresh. Like Paul Newman kicking that baddie in the nuts in Butch Cassidy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fba5fa9f-bc9d-318b-9196-e1677b8d5a9e",
                                        "entry_id": "9311dd47-8ef5-369c-a225-c1fc1c2d1de4",
                                        "glosses": [
                                            "a type of theatrical performance undergarment used to hide male genitalia, by stuffing it into a pouch with a drawstring, to simulate being nude"
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
