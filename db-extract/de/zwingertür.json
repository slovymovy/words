                                "example_id": "7408b13e-b58c-429b-a732-9cde4d570b1d",
                                "sense_id": "39b742de-8216-3303-a0d7-6f34cf05cf58",
                                "text": "„Jemand hat die Zwingertür geöffnet.“"
                            },
                            {
                                "example_id": "7e972052-07c9-4c02-bac9-e6b0bd523ebe",
                                "sense_id": "39b742de-8216-3303-a0d7-6f34cf05cf58",
                                "text": "„Die Diebe brachen die Zwingertür auf und entführten das Tier.“"
                            },
                            {
                                "example_id": "6816fff5-f368-4ef1-ba5f-0b877e44781d",
                                "sense_id": "39b742de-8216-3303-a0d7-6f34cf05cf58",
                                "text": "„Jeden Morgen stehen sie an ihren Zwingertüren und warten, warten, dass man zu ihnen kommt.“"
