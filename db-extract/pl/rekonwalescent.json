                "senses": [
                    {
                        "sense_id": "56779599-f61a-3099-8227-1ed9d4734de3",
                        "entry_id": "f781821b-c8ba-3886-b689-1ff4020a02c8",
                        "glosses": [
                            "pacjent powracający do zdrowia po przebytej chorobie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa324561-c369-4ec6-99e3-64fffcb98401",
                                "sense_id": "56779599-f61a-3099-8227-1ed9d4734de3",
                                "text": "Michał jest na specjalnej diecie dla rekonwalescentów."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1bc94f4e-5df0-440d-b067-bd0556101701",
                        "source_entry_id": "f781821b-c8ba-3886-b689-1ff4020a02c8",
                        "source_sense_id": "56779599-f61a-3099-8227-1ed9d4734de3",
                        "target_lang_word": "convalescent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convalescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bef5ff4f-6429-3959-971f-0598a106b64e",
                                        "entry_id": "0d6bb24f-f940-3627-809f-2f3b68388da0",
                                        "glosses": [
                                            "recovering one's health and strength after a period of illness"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dabb2be-9b03-4bdb-bde0-7e0b1c20a9db",
                                                "sense_id": "bef5ff4f-6429-3959-971f-0598a106b64e",
                                                "text": "So soon as Lady Anne was pronounced convalescent by the medical men, she insisted on discharging \"that odious woman,\" the nurse,..."
                                            },
                                            {
                                                "example_id": "03a2a96f-9708-4453-8d3a-d0f37f7b5147",
                                                "sense_id": "bef5ff4f-6429-3959-971f-0598a106b64e",
                                                "text": "\"Mid-Lent, and the Enemy grins,\" remarked Selwyn as he started for church with Nina and the children. Austin, knee-deep in a dozen Sunday supplements, refused to stir; poor little Eileen was now convalescent from grippe, but still unsteady on her legs; her maid had taken the grippe, and now moaned all day: \"Mon dieu! Mon dieu! Che fais mourir!\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d3a470a-6c5b-3d99-80a4-3c4bb6e6a84d",
                                        "entry_id": "0d6bb24f-f940-3627-809f-2f3b68388da0",
                                        "glosses": [
                                            "of convalescence or convalescents"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6f65c28-46bd-48b3-bc50-2085f31a0013",
                                                "sense_id": "2d3a470a-6c5b-3d99-80a4-3c4bb6e6a84d",
                                                "text": "She stayed in a convalescent hospital for two weeks before returning home."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "convalescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24430549-5e9b-318c-8d2c-e2eb7354016c",
                                        "entry_id": "6766fa98-88c0-3520-be2a-bca0b9b3b47b",
                                        "glosses": [
                                            "A person recovering from illness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d78a939-64cc-4d13-8912-67312d7a9afe",
                                                "sense_id": "24430549-5e9b-318c-8d2c-e2eb7354016c",
                                                "text": "I had been ill in health, but am now a convalescent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8605029e-7410-4942-b6c3-f2c384642bc5",
                        "source_entry_id": "f781821b-c8ba-3886-b689-1ff4020a02c8",
                        "source_sense_id": "56779599-f61a-3099-8227-1ed9d4734de3",
                        "target_lang_word": "convaleciente",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "convaleciente",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "bde66eb5-86b7-3efd-aac4-5673cbd639e9",
                                        "entry_id": "5a1bd7ae-9ff3-312c-9af6-d0add23a15a2",
                                        "glosses": [
                                            "Que convalece (que recobra las fuerzas que por alguna enfermedad había perdido)."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c32c174-ff4e-4a07-808c-e344096c9522",
                                                "sense_id": "bde66eb5-86b7-3efd-aac4-5673cbd639e9",
                                                "text": "Cuatro días después, según datos seguros, suministrados por la diligente observación de Centeno, estaba D. Agustín Caballero en el propio ser y estado que un convaleciente de enfermedad grave."
                                            },
                                            {
                                                "example_id": "1f40edeb-424a-4ffc-b9e8-1d39a5c9f841",
                                                "sense_id": "bde66eb5-86b7-3efd-aac4-5673cbd639e9",
                                                "text": "Ananna se repuso pronto de su enfermedad, y un día quiso que Kengi trajera el estilo y las tablillas. Aunque estuviera convaleciente, aún tardaría un poco en salir de casa."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26b2eb80-fca1-4c25-8664-a443124b4e18",
                        "source_entry_id": "f781821b-c8ba-3886-b689-1ff4020a02c8",
                        "source_sense_id": "56779599-f61a-3099-8227-1ed9d4734de3",
                        "target_lang_word": "Rekonvaleszent",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rekonvaleszent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5f3a5a34-24c4-397a-abca-886ec724d324",
                                        "entry_id": "0a95bc8e-eafe-3a10-9815-6adc8cb21563",
                                        "glosses": [
                                            "Medizin: eine Person, die sich nach einer Krankheit oder Verletzung in einem Genesungsprozess befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "284e5fd2-8974-4ff2-ae40-f6a205bb33fd",
                                                "sense_id": "5f3a5a34-24c4-397a-abca-886ec724d324",
                                                "text": "Der Rekonvaleszent macht gute Fortschritte."
                                            },
                                            {
                                                "example_id": "c62bf2c0-e7f9-4bdb-a8f2-798ae174461e",
                                                "sense_id": "5f3a5a34-24c4-397a-abca-886ec724d324",
                                                "text": "„Doch bis es so weit war, verbrachten die Rekonvaleszenten, sofern sie sich bewegen konnten, möglichst viel Zeit außerhalb der Lazarette.“"
                                            },
                                            {
                                                "example_id": "e3f92916-7cef-4f2a-b4b7-f9aa915ae3af",
                                                "sense_id": "5f3a5a34-24c4-397a-abca-886ec724d324",
                                                "text": "„Ballettis Vater Mario kam, da er Rekonvaleszent war, nicht zu Tisch, aber ich lernte seine ältere Schwester kennen, die mit ihrem Theaternamen Flaminia hieß.“"
                                            },
                                            {
                                                "example_id": "8c63d9f9-a443-428c-b61e-603325a1b866",
                                                "sense_id": "5f3a5a34-24c4-397a-abca-886ec724d324",
                                                "text": "„Nach 10 Tagen konnte er wieder aufstehen, seine Verletzungen waren vernarbt, und wie alle Rekonvaleszenten hatte er einen Mordshunger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
