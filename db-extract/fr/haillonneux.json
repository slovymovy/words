                        "sense_id": "aa93bc75-f029-30fa-b68f-2da1deedfe17",
                        "entry_id": "778ca2f0-4ccc-3ca9-bf79-8a48db9f62b8",
                        "glosses": [
                            "Personne vêtue de haillons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0742d750-f59f-4ae5-93b7-0ced0ab4d3a0",
                                "sense_id": "aa93bc75-f029-30fa-b68f-2da1deedfe17",
                                "text": "Les rues de l'ancien quartier de Covent Garden, encombrées de voitures maraîchères, de camions surchargés d'oranges et de bananes, parcourues par des légions de haillonneux en quête d'une heure de travail et surtout de maraude, n'étaient guère faites en ce moment pour teindre l'humeur des passants en rose tendre."
                            }
                        ]
                    }
