                        ],
                        "examples": [
                            {
                                "example_id": "7113b237-53c2-44b4-b0b3-5b769b6a3d5b",
                                "sense_id": "75331241-dd7a-3786-8a12-c50f570e4e2f",
                                "text": "Ce matin-là, ils portaient encore leurs costumes de drap foncé mis pour le mariage – des vêtements trops épais et trop classiques pour nos terres caraïbes – …"
                            }
                        ]
                    }
                ],
