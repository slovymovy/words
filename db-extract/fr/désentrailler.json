                ],
                "senses": [
                    {
                        "sense_id": "c28299ef-bf53-3a09-90bb-7ca6664a710b",
                        "entry_id": "c3d5526b-f53a-38a3-a687-561a17ce2f73",
                        "glosses": [
                            "Ôter les entrailles d’une bête, l’éventrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94e80d7f-f5e2-45a8-98f0-66f8249f884e",
                                "sense_id": "c28299ef-bf53-3a09-90bb-7ca6664a710b",
                                "text": "Tu luy veux persuader, comme à un merle, qu’il se mette à la broche et se tourne tout seul au feu pour se désentrailler et engresser le pain d’autruy."
                            },
                            {
                                "example_id": "8f6a0a3e-8482-42e8-965f-0f5a7bd84f56",
                                "sense_id": "c28299ef-bf53-3a09-90bb-7ca6664a710b",
                                "text": "« Où es-tu, que je te larde, que je te crible…, que je te désentraille. »"
                            },
                            {
                                "example_id": "ffe66713-a297-455c-94e6-43ebb34e2a3f",
                                "sense_id": "c28299ef-bf53-3a09-90bb-7ca6664a710b",
                                "text": "Comme si on pouvait se désentrailler impunément ! Les tripes ne voyagent pas. Elles vous laissent aller de l’avant, et un beau jour, vlan, elles vous rattrapent et vous serrent la bride."
                            }
                        ]
                    }
