                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfcd7f72-3be9-44b1-95e4-c37d0ea02a95",
                                                "sense_id": "869ee372-c5ab-30cc-add3-4d898a7582e7",
                                                "text": "Sommige mensen zeggen om de haverklap \"euh\" en dat kan erg irritant worden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20d5cc4e-e8f0-43a3-92b9-a3e4cd44b53c",
                        "source_entry_id": "18475826-8f0e-3482-9f78-6242c4583dfe",
                        "source_sense_description": "expression of uncertainty",
                        "target_lang_word": "euh",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euh",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "82988eb4-5351-397a-9235-3467f17d6f58",
                                        "entry_id": "260ec30c-877c-30b8-9bbe-c1e625bb551c",
                                        "glosses": [
                                            "Interjection qui marque le doute, l’incertitude, l’étonnement ou une certaine contradiction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "759ee1fb-8e27-4ee1-ac1f-c3ff9f7ee0ac",
                                                "sense_id": "82988eb4-5351-397a-9235-3467f17d6f58",
                                                "text": "Euh ! Avait-il fait cela ?"
                                            },
                                            {
                                                "example_id": "7c649a2c-00c2-4da5-8aa7-b82c771f6c7b",
                                                "sense_id": "82988eb4-5351-397a-9235-3467f17d6f58",
                                                "text": "« Sus à l’ennemi !\n— Oui. Sis à l’ennemu ! Euh… à l’ennemi ! Çonfons ! Euh… Fonçons ! »"
                                            },
                                            {
                                                "example_id": "9fb42f18-efe4-49fa-b22a-38fa2e912024",
                                                "sense_id": "82988eb4-5351-397a-9235-3467f17d6f58",
                                                "text": "« Qu’est-ce qui est petit, rond, vert, et qui va très vite ?\n— Euh… Je ne sais vraiment pas.\n— Un chou de Bruxelles accroché à la queue d’un avion. »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cb44b86-807d-3f4e-a3d6-6673f346f601",
                                        "entry_id": "260ec30c-877c-30b8-9bbe-c1e625bb551c",
                                        "glosses": [
                                            "On s’en sert encore, et plutôt en la redoublant, pour laisser entendre ce qu’on ne veut pas exprimer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e094fe8-b95f-45c1-8070-9129fbf3a1de",
                                                "sense_id": "0cb44b86-807d-3f4e-a3d6-6673f346f601",
                                                "text": "Comment est-il dans ses affaires ?\nEuh !"
                                            },
                                            {
                                                "example_id": "6add344a-5617-4057-9928-02e9ed6c618a",
                                                "sense_id": "0cb44b86-807d-3f4e-a3d6-6673f346f601",
                                                "text": "Euh… Ah oui ?"
                                            },
                                            {
                                                "example_id": "e58da5fb-64f7-4d50-aa33-4563e12b81c3",
                                                "sense_id": "0cb44b86-807d-3f4e-a3d6-6673f346f601",
                                                "text": "Euh… Des menaces ?"
                                            },
                                            {
                                                "example_id": "e590b3e6-3879-4235-97cf-cbac228c96d3",
                                                "sense_id": "0cb44b86-807d-3f4e-a3d6-6673f346f601",
                                                "text": "Euh… Allez-y vous !"
                                            },
                                            {
                                                "example_id": "2968f378-c6a0-41cd-9a7d-5513f5174c48",
                                                "sense_id": "0cb44b86-807d-3f4e-a3d6-6673f346f601",
                                                "text": "Euh… T’as des congés ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50abfd14-b68e-4882-bc8c-2105e91ffcde",
                        "source_entry_id": "18475826-8f0e-3482-9f78-6242c4583dfe",
