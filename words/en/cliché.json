                        },
                        {
                            "text": "It is a <w>cliché</w> to say that time flies, but it feels true."
                        }
                    ],
                    "synonyms": [
                        "platitude",
                        "stereotype",
                        "saying",
                        "adage",
                        "proverb",
                        "maxim"
                    ],
                    "common_phrases": [
