                            {
                                "example_id": "312ca667-52d5-4f34-a6ef-24ecfbc95f6d",
                                "sense_id": "a092a5bf-ffd6-3ab0-a08a-20c8d3e4a8f0",
                                "text": "Kim Jong-il, who has died aged 69, was the general secretary of the Workers party of Korea, and head of the military in the Democratic People's Republic of Korea (DPRK). He was one of the most reclusive and widely condemned national leaders of the late 20th and early 21st century, leaving his country diplomatically isolated, economically broken and divided from South Korea."
                            },
                            {
                                "example_id": "e13a950a-a5ff-46b7-9cb7-e0111efe5078",
                                "sense_id": "a092a5bf-ffd6-3ab0-a08a-20c8d3e4a8f0",
                                "text": "More than 40% of Dominicans are economically vulnerable and are at risk of falling into poverty due to climate-related impacts and economic crises, according to the World Bank."
                            }
                        ]
