                                    {
                                        "sense_id": "6edaaf98-e1e6-3155-a0fb-ee2977e2c23d",
                                        "entry_id": "e95a661c-5cb0-3b82-a55c-82d250040eed",
                                        "glosses": [
                                            "Disposition particulière faisant partie d’un traité, d’un contrat, d’un arrêté, d’une loi ou de tout autre acte public ou particulier, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d860c860-4f07-46e7-8cd6-2815ef48f43e",
                                                "sense_id": "6edaaf98-e1e6-3155-a0fb-ee2977e2c23d",
                                                "text": "Comme le tarif était peu élevé (1 fr. 25 par verso ou par 72 mots ), les solicitors allongèrent leurs actes en y insérant des clauses redondantes, afin de rendre suffisant le montant de leurs honoraires."
                                            },
                                            {
                                                "example_id": "ade7ea85-cb8d-4bcb-99bc-acbbbc97c6f6",
                                                "sense_id": "6edaaf98-e1e6-3155-a0fb-ee2977e2c23d",
                                                "text": "Il s’allongea de nouveau, s’ingéniant à rédiger des clauses testamentaires en faveur d’Edna, pour la plupart, […] et à stipuler divers menus legs, avec des codicilles de plus en plus fantasques et extravagants…"
                                            },
                                            {
                                                "example_id": "7c756c6e-721a-4c34-93e4-40afb0f11d43",
                                                "sense_id": "6edaaf98-e1e6-3155-a0fb-ee2977e2c23d",
                                                "text": "Ces clauses jouent généralement lorsque l'entreprise est proche de la faillite. Toutefois, l’application de ces clauses est subordonnée à des garanties d'emploi et à l’approbation du syndicat et de la fédération d’employeurs."
                                            },
                                            {
                                                "example_id": "319274c7-0e44-4994-a57c-fc1a5c020c94",
                                                "sense_id": "6edaaf98-e1e6-3155-a0fb-ee2977e2c23d",
                                                "text": "Cahier des charges, clauses et conditions auxquelles aura lieu la vente."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51768196-b3a8-491f-816a-7f379068c8bf",
                        "source_entry_id": "18498160-0f1d-3d2c-9988-91bc8ea48039",
                        "source_sense_id": "c3e0acf5-6765-382e-aeee-e7c18a3b8b24",
                        "source_sense_description": "een extra bepaling in een ambtelijke brief.",
                        "target_lang_word": "stipulation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stipulation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54901acc-e676-3a42-b664-8292888415d3",
                                        "entry_id": "e2f660dd-5bdc-361e-9ffe-1d0ca6ab9b69",
                                        "glosses": [
                                            "Clause, condition expresse ou convention qui entre dans un contrat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28fc9857-e39b-4ced-8f0f-be6e245c68c2",
                                                "sense_id": "54901acc-e676-3a42-b664-8292888415d3",
                                                "text": "La stipulation de reprise est une clause apposée dans un contrat de mariage, par laquelle il est porté que la femme, au cas qu'elle renonce à la communauté, reprendra franchement et quittement tout ce qu'elle aura mis dans ladite communauté."
                                            },
                                            {
                                                "example_id": "906d733b-0567-424a-a10d-2c528f8de40c",
                                                "sense_id": "54901acc-e676-3a42-b664-8292888415d3",
                                                "text": "Les personnes physiques peuvent déclarer l'adresse de leur local d'habitation et y exercer une activité, dès lors qu'aucune disposition législative ou stipulation contractuelle ne s'y oppose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
