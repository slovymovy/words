                        "sense_id": "5e29e3a4-5a39-3fd3-8802-715b86f86722",
                        "entry_id": "ecc8980c-2c7d-31e7-a597-89142166db19",
                        "glosses": [
                            "the full complement of chromosomes in the cell nucleus"
                        ],
                        "tags": [
