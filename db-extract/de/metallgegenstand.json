                "senses": [
                    {
                        "sense_id": "0e6efbae-ca55-330e-ad53-f8d79395f7ac",
                        "entry_id": "c814947f-5906-36c3-b2e1-86e45b437747",
                        "glosses": [
                            "ein Gegenstand aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5203515e-71f5-4a99-8e6c-d5c2506e2f3f",
                                "sense_id": "0e6efbae-ca55-330e-ad53-f8d79395f7ac",
                                "text": "Die Metallgegenstände in der Fabrik werden rostfrei produziert."
                            },
                            {
                                "example_id": "32b9d06e-0705-4d4e-8e85-470cf23f956d",
                                "sense_id": "0e6efbae-ca55-330e-ad53-f8d79395f7ac",
                                "text": "„Silver ergriff sie, und im selben Moment fühlte ich einen Metallgegenstand in meine Hand gleiten.“"
                            },
                            {
                                "example_id": "d9b811b4-e4d2-44ba-b6cd-80431176666a",
                                "sense_id": "0e6efbae-ca55-330e-ad53-f8d79395f7ac",
                                "text": "„Wenn man die Schwelle überschritt, stieß man gegen einen steinernen Trog (einen gallo-römischen Sarkophag); dann fiel der Blick auf allerhand Metallgegenstände.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
