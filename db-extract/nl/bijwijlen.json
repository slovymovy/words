                "senses": [
                    {
                        "sense_id": "1972d30d-d436-3e2c-9bf3-8ad590187a21",
                        "entry_id": "6e40cfb6-5777-3272-9729-d760008e86e0",
                        "glosses": [
                            "soms, geregeld, van tijd tot tijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1afe61ed-2cdf-47df-b76e-3a98d7315e46",
                                "sense_id": "1972d30d-d436-3e2c-9bf3-8ad590187a21",
                                "text": "Vroeger zagen we je bijwijlen voorbijkomen, maar tegenwoordig kom je maar zelden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6332d295-d026-4ed5-a9f8-6d1e6ce88381",
                        "source_entry_id": "6e40cfb6-5777-3272-9729-d760008e86e0",
                        "source_sense_id": "1972d30d-d436-3e2c-9bf3-8ad590187a21",
                        "source_sense_description": "soms, geregeld, van tijd tot tijd",
                        "target_lang_word": "mitunter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mitunter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f515fde5-45a5-3952-855d-00c01161225a",
                                        "entry_id": "4d3a6373-b645-3996-bf37-f63434d62ad1",
                                        "glosses": [
                                            "gelegentlich, manchmal"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9868b5c-52ab-41f3-a6c4-9e9367c7ca09",
                                                "sense_id": "f515fde5-45a5-3952-855d-00c01161225a",
                                                "text": "Mein Mitbewohner ist sehr eifrig, der arbeitet mitunter 12 Stunden am Tag."
                                            },
                                            {
                                                "example_id": "7aaf4bb3-748b-4c51-9285-322566e70c3b",
                                                "sense_id": "f515fde5-45a5-3952-855d-00c01161225a",
                                                "text": "„Sowohl im Deutschen Reich wie auch in Großbritannien lehnten führende Finanzmagnaten wie Warburg und Rothschild Krieg deshalb strikt ab, ja versuchten ihn mitunter sogar aktiv zu verhindern.“"
                                            },
                                            {
                                                "example_id": "098e90c8-ed16-48a8-9bea-5c51fafbd165",
                                                "sense_id": "f515fde5-45a5-3952-855d-00c01161225a",
                                                "text": "„Mitunter stoßen die Fahnder bei dem Procedere auch auf Steuersünder, die sich selbst angezeigt haben - ein Beleg für die Authentizität des Materials.“"
                                            },
                                            {
                                                "example_id": "6849fdd6-c4aa-4e3a-ae54-d27b40ec7869",
                                                "sense_id": "f515fde5-45a5-3952-855d-00c01161225a",
                                                "text": "„Zuständig für die Nahrungsbeschaffung der Bevölkerung waren in allen Gesellschaftsschichten in der Regel Frauen, mitunter auch Kinder, aber nur ausnahmsweise Männer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fc78e9f-af4e-4f3c-a159-32c6297fea1f",
                        "source_entry_id": "6e40cfb6-5777-3272-9729-d760008e86e0",
