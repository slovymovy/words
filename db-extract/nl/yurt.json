                    }
                ],
                "translations": [
                    {
                        "translation_id": "eccd8ad1-8cd1-444d-9b37-17fd39ee68f9",
                        "source_entry_id": "c4dbb235-27b4-39c3-bd9d-0710684bdb8a",
                        "source_sense_id": "bf5e511c-c96e-33d4-b9ed-1c0cd7d3391a",
                        "source_sense_description": "een ronde nomadentent",
                        "target_lang_word": "Jurte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jurte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4df69c53-c5f9-37cf-b38f-1fb086b4328b",
                                        "entry_id": "14502578-73d9-39e2-8690-47c993792f8e",
                                        "glosses": [
                                            "zerlegbares, beheizbares, leicht zu transportierendes Rundzelt der Nomaden in West- und Zentralasien, insbesondere in der Mongolei, aber auch in Kasachstan, Usbekistan und Turkmenistan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c36acc6c-8dc8-4f81-9a61-96784c490c2b",
                                                "sense_id": "4df69c53-c5f9-37cf-b38f-1fb086b4328b",
                                                "text": "Auf einem der zwei Betten in der kleinen Jurte durfte er schlafen, während der Rest der Familie sich das andere Bett geteilt hat."
                                            },
                                            {
                                                "example_id": "b651a35e-1fd3-4412-a528-1f8395805031",
                                                "sense_id": "4df69c53-c5f9-37cf-b38f-1fb086b4328b",
                                                "text": "Mit einer Jurte, Film- und Musikvorführungen, Reitshows und jeder Menge echter Mongolen präsentiert sich das Land hier."
                                            },
                                            {
                                                "example_id": "c208934c-f704-4a7c-b0a2-bfc221da2cf0",
                                                "sense_id": "4df69c53-c5f9-37cf-b38f-1fb086b4328b",
                                                "text": "Die schwere, mit Pferdehaut beschlagene Thür der Jurte wurde aufgehoben; vom Hofe herein schlug eine Dampfwolke und zum Ofen trat ein Fremder – ein Mann von hohem Wuchs, breitschultrig und stattlich."
                                            },
                                            {
                                                "example_id": "57c4bcca-0e75-4545-8732-5120c1b4963c",
                                                "sense_id": "4df69c53-c5f9-37cf-b38f-1fb086b4328b",
                                                "text": "Merkwürdigerweise war es ein Lied, das mir wohlbekannt war, denn oft genug hatte ich es vor der Jurte Schemingas von den Mädchen seines Stammes singen hören, wenn wir ermüdet von einem Jagdzuge auf den Filzdecken ruhten und den Rauch aus unsern Pfeifen in die Luft bliesen."
                                            },
                                            {
                                                "example_id": "a9567b00-3690-4600-ad80-a4c5b78bdeef",
                                                "sense_id": "4df69c53-c5f9-37cf-b38f-1fb086b4328b",
                                                "text": "In den Pologs seiner Jurte hielt er Schätze versteckt; Waffen, in Petropawlowsk gegen Zobelfelle eingetauscht; einen Topf voll Rubel und einen Rasiernapf, dessen Bedeutung ihm verborgen war und den er in Ehren hielt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34e00003-caae-41ee-8f69-6b25e4c05b97",
                        "source_entry_id": "c4dbb235-27b4-39c3-bd9d-0710684bdb8a",
                        "source_sense_id": "bf5e511c-c96e-33d4-b9ed-1c0cd7d3391a",
                        "source_sense_description": "een ronde nomadentent",
                        "target_lang_word": "yurt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yurt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                        "entry_id": "7bb3fd91-0001-3348-a69a-a965fdb17176",
                                        "glosses": [
                                            "A large, round, semi-permanent tent with vertical walls and a conical roof, usually associated with Central Asia and Mongolia (where it is known as a ger)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e82fc774-4e2e-4361-8947-a0c2fb541f8e",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "[T]heir [the Nogais'] cattle grazed on the Little Injik, only seven versts from the boundary line. In summer they kept them in the Black Mountains, and in winter at their auls. They lived in felt yurts, and often changed their place of abode."
                                            },
                                            {
                                                "example_id": "4d8109c8-80cf-4c5b-a9f5-4559a14e95f4",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "Gervasius and Borodijin rode on to reconnoitre. As my caravan entered the strip of pasture fringing the shore I saw my people in conversation with Sarts by a yurt at the north-east corner of the lake. They soon returned with the information that the whole neighbourhood, which included Kala Otlak and Bulag Bashi, was known as Dakherukta. There was no tura, but two or three miles off to the west there lived a wealthy Sart who was at the moment away from home attending a wedding at some friends of his. The festivities were taking place on the farther side of the northern mountains."
                                            },
                                            {
                                                "example_id": "b25091f3-bd31-4e14-966d-ef50deedbd81",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "Who would have imagined that the circular, skin-covered, pole-framed tents used by Mongolian nomads would find another life in the Colorado backcountry? The Mongols might be surprised if they could see how their portable structures have been improved and put to use in the San Juan Mountains of southern Colorado and northern New Mexico. […] About halfway to the [Neff Mountain] yurt, the trail makes an uphill switchback and passes the bottom of a big, open bowl."
                                            },
                                            {
                                                "example_id": "d9f5950d-d508-470f-b984-f1b2c5e81ab8",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "Northeast of the center's main group of yurts is a new neighbor—the Spruce Hole Yurt—operated by Cumbres Nordic Adventures. This yurt is easy to get to, affords scenic views, and serves up classic touring terrain."
                                            },
                                            {
                                                "example_id": "23868362-f3bc-4379-ba8c-3212a5d1dfc5",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "The principal dwelling of the nomadic Kazakhs, the circular, felt-covered yurt is a potent image of Kazakh culture. Few Kazakhs now live in yurts, although they are still used by some pastoralists who still move their herds into summer mountain pastures. […] But the imagery of the yurt remains central to Kazakh ethnic identity, and provides national cultural symbolism deployed by the authorities of independent Kazakhstan."
                                            },
                                            {
                                                "example_id": "0a8b9949-05d3-47b0-b525-5870114dee68",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "I saw the first round white roofs of yurts, or gers as they are called in Mongolian. Yurt is Russian, and all that is Russian is now on the outer in Mongolia. If you said yurt, Mongolians looked at you as though you had uttered a dirty word."
                                            },
                                            {
                                                "example_id": "fc237883-18c4-4c48-9dd3-859318bd4f70",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "When designing any building (including a yurt), one should consider the trade-off between letting in more light and heat in the winter and blocking the intense rays of the sun in the summer. […] The first few months during which we lived in our yurt saw the sun burning into our south and southwest facing windows. Our only solution was to use blinds, which left the yurt darkened. A more viable solution was a mirrored portable awning that was built into a scaffold sitting just outside the window."
                                            },
                                            {
                                                "example_id": "05b28e25-88a5-41e8-9406-abea5ce76f15",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "A yurt houses a Tajik family along the Karakal Lake."
                                            },
                                            {
                                                "example_id": "d658aa3e-48cf-43de-8884-fea0a6782f69",
                                                "sense_id": "09191c90-7979-31da-86f4-aedf8d46bb6c",
                                                "text": "For centuries, the nomadic tribes of Central Asia used colorful textiles called suzanis as seating, prayer mats, bedding and dividers in their yurts – the traditional tents that were their homes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yurt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d09166b-ab02-33e1-93d5-8cad9a0f0d73",
                                        "entry_id": "56d8f442-a1d1-3f14-bb92-c7a2cea7fb58",
                                        "glosses": [
                                            "The natural resources and arable land over which a Cossack stanitsa had exclusive control in their territory."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed4569af-319b-4dbe-b6e3-e17ecb12107e",
                        "source_entry_id": "c4dbb235-27b4-39c3-bd9d-0710684bdb8a",
                        "source_sense_id": "bf5e511c-c96e-33d4-b9ed-1c0cd7d3391a",
                        "source_sense_description": "een ronde nomadentent",
                        "target_lang_word": "yourte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yourte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b5fbb52-7fc4-35ee-99dd-7bba82299933",
                                        "entry_id": "1a469ecb-3915-3052-9ced-4e3ddc9c7fc6",
                                        "glosses": [
                                            "Tente en peau ou en feutre des nomades mongols et turcs qui vivent en Asie centrale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0bbdf05-aa64-4405-aa05-32b9b8289f11",
                                                "sense_id": "2b5fbb52-7fc4-35ee-99dd-7bba82299933",
                                                "text": "Au milieu du plateau, on apercevait une grande yourte de l’ancien modèle ouzbek, moitié hutte et moitié tente, habitation fixe et nomade à la fois, ronde à sa base, aiguë au sommet, faite en partie de laine brute et en partie de roseaux."
                                            },
                                            {
                                                "example_id": "1bcd0f34-cd89-47d4-b849-33d39ab79826",
                                                "sense_id": "2b5fbb52-7fc4-35ee-99dd-7bba82299933",
                                                "text": "La migration permanente du bétail demandait une demeure transportable, c’était la yourte (en mongol guer)."
                                            },
                                            {
                                                "example_id": "1f65740b-380c-410a-b000-2c282cc59798",
                                                "sense_id": "2b5fbb52-7fc4-35ee-99dd-7bba82299933",
                                                "text": "— Ce Turc, tout juste sorti de sa yourte"
                                            },
                                            {
                                                "example_id": "334ae2b4-a9b7-449c-a134-d3b80241eda2",
                                                "sense_id": "2b5fbb52-7fc4-35ee-99dd-7bba82299933",
                                                "text": "Autre genre de tente, la yourte nous vient d’Asie centrale."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
