                    "sense_definition": "A public lavatory or toilet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council maintains a public <w>convenience</w> in the park.",
                            "target_lang_translations": {
                                "ru": "Городской совет содержит общественный <w>туалет</w> в парке.",
                                "de": "Die Stadtverwaltung unterhält eine öffentliche <w>Toilette</w> im Park.",
                                "zh": "市议会在公园里维护着一间<w>公共厕所</w>。"
                            }
                        },
                        {
                            "text": "He asked for directions to the nearest <w>convenience</w>.",
                            "target_lang_translations": {
                                "ru": "Он спросил дорогу до ближайшего <w>туалета</w>.",
                                "de": "Er fragte nach dem Weg zur nächsten <w>Toilette</w>.",
                                "zh": "他问了去最近的<w>公共厕所</w>怎么走。"
                            }
                        }
