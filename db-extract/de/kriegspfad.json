                                        "sense_id": "b2d2a6ea-3bfb-3135-a13f-59b58d4a95a7",
                                        "entry_id": "4c0e5229-b530-3bc2-a18c-f57739a7a785",
                                        "glosses": [
                                            "Cheminement menant à un affrontement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7436fa13-df34-4260-b186-635eb4135d9b",
                                                "sense_id": "b2d2a6ea-3bfb-3135-a13f-59b58d4a95a7",
                                                "text": "Jamais un Indien sur le sentier de la guerre ne se montra plus attentif que Soubray se dirigeant vers la piazza VIII Agosto où se dresse le Palazzo del Genio Civile, sous les combles duquel est installé le service dirigé par Giogio Luppo."
                                            },
                                            {
                                                "example_id": "3b2cd6a7-5717-4ba7-9291-b5379cd8b2e3",
                                                "sense_id": "b2d2a6ea-3bfb-3135-a13f-59b58d4a95a7",
                                                "text": "Nicolas et Laurent revinrent, plus zébrés de peinture que des Indiens sur le sentier de la guerre."
                                            }
                                        ]
                                    }
