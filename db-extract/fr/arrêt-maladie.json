                "senses": [
                    {
                        "sense_id": "34d7acf3-1d59-3d37-ae5d-ecab7af32f1e",
                        "entry_id": "d2a1237a-37a5-3c77-8805-ef1ad80ed41e",
                        "glosses": [
                            "Variante orthographique, plus rare, de arrêt maladie (arrêt de travail pour cause de maladie)."
                        ],
                        "tags": [
                            "Droit du travail"
                        ],
                        "examples": [
                            {
                                "example_id": "cbd2d8b5-8620-4b19-80b1-1a3c3005ff4f",
                                "sense_id": "34d7acf3-1d59-3d37-ae5d-ecab7af32f1e",
                                "text": "Pendant un arrêt-maladie, le contrat de travail est suspendu."
                            },
                            {
                                "example_id": "3c17b51b-d956-4366-a0f5-859a2f69d847",
                                "sense_id": "34d7acf3-1d59-3d37-ae5d-ecab7af32f1e",
                                "text": "Covid-19 : des arrêts-maladie \"immédiats\" très utilisés, mais peu d’abus constatés"
                            },
                            {
                                "example_id": "567022b8-fb01-43c0-90ce-7084a950a482",
                                "sense_id": "34d7acf3-1d59-3d37-ae5d-ecab7af32f1e",
                                "text": "Cette plainte n’aura pas de suite mais je resterai en arrêt-maladie jusqu’à la fin de mon CDD."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d4a53f00-af10-42b0-baaa-fb547abd2cf8",
