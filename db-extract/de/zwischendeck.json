                        "entry_id": "7c088c65-c35b-368e-a978-06c63b2d541b",
                        "glosses": [
                            "Deck auf großen Schiffen, das zwischen dem Hauptdeck und dem Schiffsboden liegt"
                        ],
                        "tags": [
                            "Schifffahrt"
                        ],
                        "examples": [
                            {
                                "example_id": "6b9f26ed-aab8-4a73-8468-96f3d30cfe6c",
                                "sense_id": "9d36c5d3-b4f4-3961-9098-2cfaa5faa394",
                                "text": "Auf dem Zwischendeck befanden sich unsere Kojen."
                            },
                            {
                                "example_id": "6f25ba4d-cab2-4b96-9816-5e8192eb1f5a",
                                "sense_id": "9d36c5d3-b4f4-3961-9098-2cfaa5faa394",
                                "text": "„Daraufhin wurden wir mit Wachaufsicht im Zwischendeck eingesperrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "105de60d-7054-3f3a-af79-eef91491d069",
                        "entry_id": "7c088c65-c35b-368e-a978-06c63b2d541b",
                        "glosses": [
                            "Raum zur massenhaften Unterbringung von Fahrgästen, der zum Laderaum gehört"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "3f88a7c9-3496-4126-ad85-a74e06da1e8c",
                                "sense_id": "105de60d-7054-3f3a-af79-eef91491d069",
                                "text": "Die Auswanderer waren auf dem Zwischendeck untergebracht."
                            }
                        ],
                        "sense_index_json": "\"2\""
