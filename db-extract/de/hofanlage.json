                ],
                "senses": [
                    {
                        "sense_id": "6ecca24d-d1bb-3b93-a4ad-28086c00dc31",
                        "entry_id": "93a4717a-97fe-3043-8964-39511f046b4b",
                        "glosses": [
                            "Komplex aus Gebäuden und Flächen eines Bauern-/Gutshofs (eines Hofs)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e557fe9-6d56-4aa5-92a8-5377d5bfdda2",
                                "sense_id": "6ecca24d-d1bb-3b93-a4ad-28086c00dc31",
                                "text": "„Hinter der Hofanlage begann dichter Wald.“"
                            },
                            {
                                "example_id": "7b8a5a23-6ef5-4325-802c-4d57fbc95d0b",
                                "sense_id": "6ecca24d-d1bb-3b93-a4ad-28086c00dc31",
                                "text": "„Außerhalb der vierseitig umbauten Hofanlage stand das private Backhaus im Garten hinter dem Wohnhaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4b47abae-23c6-3696-bc05-474cbba889c1",
                        "entry_id": "93a4717a-97fe-3043-8964-39511f046b4b",
                        "glosses": [
                            "Komplex aus Gebäuden um eine oder mehrere freie Fläche(n) (einen Hof/Innenhof)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08adde27-fea5-4de0-a573-a8524a54ab62",
                                "sense_id": "4b47abae-23c6-3696-bc05-474cbba889c1",
                                "text": "„Die schmale Hofanlage besitzt bemerkenswerterweise Runderkergruppen.“"
                            },
                            {
                                "example_id": "274c9a7c-a675-4b8d-93f1-f168e42d7991",
                                "sense_id": "4b47abae-23c6-3696-bc05-474cbba889c1",
                                "text": "„Eine dumpf-dreiste Hofanlage, die an eine vergessen geglaubte Epoche erinnert.“"
                            },
                            {
                                "example_id": "dcda3287-8b2d-4fb2-a204-e5eba15856f6",
                                "sense_id": "4b47abae-23c6-3696-bc05-474cbba889c1",
                                "text": "„Der neunstöckige Uhrenturm deutet wohl an, dass die Hofanlage eine Stadt in der Stadt sein könnte, wie sie dem Namensgeber, Bürgermeister Karl Seitz, durchaus zugestanden wäre.“"
                            },
                            {
                                "example_id": "75608c06-1e04-4288-ba2c-f3c1b537c964",
                                "sense_id": "4b47abae-23c6-3696-bc05-474cbba889c1",
                                "text": "„Front des Gebäudes, wurden weitere Wiedererkennungsmerkale hinzugefügt: hohe Leuchter und ein breites Wasserbecken im Mittelteil der Hofanlage.“"
                            },
                            {
                                "example_id": "c682cbea-595b-4e13-9555-f58795320a3f",
                                "sense_id": "4b47abae-23c6-3696-bc05-474cbba889c1",
                                "text": "„Es handelt sich um eine geschlossene Hofanlage, die mit dem Herweghhof eine Einheit bildet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
