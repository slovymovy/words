                ],
                "senses": [
                    {
                        "sense_id": "9cdd1cd2-c0b5-379a-9b99-0b94d11e534d",
                        "entry_id": "d7b64945-e1a4-315f-abdd-bd89a470bdbb",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "623ed6fc-5e8b-4e38-b2a2-79178d7b4169",
                                "sense_id": "9cdd1cd2-c0b5-379a-9b99-0b94d11e534d",
                                "text": "Frau Dressler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "7dc40e47-67fb-4ef5-9b3d-03ce6a6f0f78",
                                "sense_id": "9cdd1cd2-c0b5-379a-9b99-0b94d11e534d",
                                "text": "Herr Dressler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "57c85088-22d2-41c0-ad28-75f4bc376974",
                                "sense_id": "9cdd1cd2-c0b5-379a-9b99-0b94d11e534d",
                                "text": "Die Dresslers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2fe84a11-c492-49c5-b748-ff23c589be9a",
                                "sense_id": "9cdd1cd2-c0b5-379a-9b99-0b94d11e534d",
                                "text": "Der Dressler trägt nie die Schals, die die Dressler ihm strickt."
                            },
                            {
                                "example_id": "027290e2-0cd8-4148-bc32-9d1bc028f8c2",
                                "sense_id": "9cdd1cd2-c0b5-379a-9b99-0b94d11e534d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Dressler kommt, geht der Herr Dressler.“"
                            },
                            {
                                "example_id": "342549db-c577-4c07-8f72-fdd9cc29970f",
                                "sense_id": "9cdd1cd2-c0b5-379a-9b99-0b94d11e534d",
                                "text": "Dressler kommt und geht."
                            },
                            {
                                "example_id": "5e6684fe-bb4c-4988-bde7-99aa6415b9b8",
                                "sense_id": "9cdd1cd2-c0b5-379a-9b99-0b94d11e534d",
                                "text": "Dressler kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
