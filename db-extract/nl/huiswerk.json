                    {
                        "form_id": "f0e5b844-1a5b-4c39-b604-9f2c672d6aef",
                        "entry_id": "b77061fc-6d67-3e66-bdeb-d57a0d6ec869",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "huiswerkjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4f73eee7-89a5-3121-b62c-4be79b9afc19",
                        "entry_id": "b77061fc-6d67-3e66-bdeb-d57a0d6ec869",
                        "glosses": [
                            "schoolwerk dat thuis verricht moet worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3542fd63-621f-44ea-980f-6e11c8934879",
                                "sense_id": "4f73eee7-89a5-3121-b62c-4be79b9afc19",
                                "text": "Ze kregen geen huiswerk op, omdat er een proefwerk volgde."
                            },
                            {
                                "example_id": "7477c239-d530-495c-87db-e9e00bc918bc",
                                "sense_id": "4f73eee7-89a5-3121-b62c-4be79b9afc19",
                                "text": "De sfeer was altijd opgewekt, maar al snel ging iedereen over tot de orde van de dag en vertrok naar zijn of haar kamer om huiswerk te maken en ‘écht’ belangrijke mensen te bellen over de laatste drama’s op school."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab5bf072-c090-4f1b-a85e-2135b6afa3d2",
                        "source_entry_id": "b77061fc-6d67-3e66-bdeb-d57a0d6ec869",
                        "source_sense_id": "4f73eee7-89a5-3121-b62c-4be79b9afc19",
                        "source_sense_description": "schoolwerk dat thuis verricht moet worden",
                        "target_lang_word": "Hausaufgabe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hausaufgabe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eaba65a6-f55a-33a9-92b5-260690837ab4",
                                        "entry_id": "b6fa9345-e4d5-3435-9c7c-bc739077e40b",
                                        "glosses": [
                                            "Aufgabe, welche ein Lehrer Schülern aufgibt und in der Regel zu Hause gemacht werden soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c9c367f-2516-4e32-8bb2-2ce439e7e692",
                                                "sense_id": "eaba65a6-f55a-33a9-92b5-260690837ab4",
                                                "text": "Hast du deine Hausaufgaben schon gemacht?"
                                            },
                                            {
                                                "example_id": "5152bffb-652e-4184-a038-00793c142272",
                                                "sense_id": "eaba65a6-f55a-33a9-92b5-260690837ab4",
                                                "text": "„Oma Phillipine war es, die uns bei den Hausaufgaben half, wenn wir alleine nicht weiterwussten.“"
                                            },
                                            {
                                                "example_id": "d4c98e0b-51e2-4c04-9113-4c32e0958509",
                                                "sense_id": "eaba65a6-f55a-33a9-92b5-260690837ab4",
                                                "text": "„Nach dem Mittagessen, wenn all meine Hausaufgaben erledigt sind, gehe ich mit Eva spazieren.“"
                                            },
                                            {
                                                "example_id": "f5df50e2-0f23-451a-ad41-911a530a3f7a",
                                                "sense_id": "eaba65a6-f55a-33a9-92b5-260690837ab4",
                                                "text": "„Als Hausaufgabe sollten wir die Sage schriftlich nacherzählen.“"
                                            },
                                            {
                                                "example_id": "286df4aa-6da5-4946-aaff-08b9c297991c",
                                                "sense_id": "eaba65a6-f55a-33a9-92b5-260690837ab4",
                                                "text": "„Zwischen Hausarbeit und Hausaufgaben stahl Mây sich Zeit, schlich die Treppen hoch und öffnete leise die Tür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3672ba1-96fd-41cf-ab13-8768dcba8baf",
                        "source_entry_id": "b77061fc-6d67-3e66-bdeb-d57a0d6ec869",
                        "source_sense_id": "4f73eee7-89a5-3121-b62c-4be79b9afc19",
                        "source_sense_description": "schoolwerk dat thuis verricht moet worden",
                        "target_lang_word": "homework",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "homework",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e30204a7-5187-387d-96de-ef81ddd98d7a",
                                        "entry_id": "af460a66-dc1a-3331-91de-f3d12cb8a844",
                                        "glosses": [
                                            "Exercises assigned by a teacher to a student which review concepts studied in class."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27a41937-aab2-4c46-bb7c-3e2a6938b5f5",
                                                "sense_id": "e30204a7-5187-387d-96de-ef81ddd98d7a",
                                                "text": "You must do your homework before you can watch television."
                                            },
                                            {
                                                "example_id": "4e83d0fc-5013-43e5-9102-65b3fd305473",
                                                "sense_id": "e30204a7-5187-387d-96de-ef81ddd98d7a",
                                                "text": "They will also be doing a few preparation homeworks for the practical CA during this time so it won't all be Unit1 focussed."
                                            },
                                            {
                                                "example_id": "bf074bc8-66f8-4d5b-8e62-dfdec1861226",
                                                "sense_id": "e30204a7-5187-387d-96de-ef81ddd98d7a",
                                                "text": "Even 15-year-olds do no more than 30 minutes' homework a night."
                                            },
                                            {
                                                "example_id": "62607edd-6a19-4e72-b540-1f93ea87e5bb",
                                                "sense_id": "e30204a7-5187-387d-96de-ef81ddd98d7a",
                                                "text": "And I'm sympathetic to teachers who feel that they have enough to worry about, without adding A.I.-generated homework to the mix."
                                            },
                                            {
                                                "example_id": "064c8951-9eae-45cc-a4da-86489a7cbdac",
                                                "sense_id": "e30204a7-5187-387d-96de-ef81ddd98d7a",
                                                "text": "Under the proposals, an assurance is given that GBR (in the words of the plan) will not be marking its own homework."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3302b88a-d95d-3ba1-a706-0f3b77f38a4f",
                                        "entry_id": "af460a66-dc1a-3331-91de-f3d12cb8a844",
                                        "glosses": [
                                            "Exercises assigned by a teacher to a student which review concepts studied in class.",
                                            "Something which one is encouraged to learn or study on one's own."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8dc2afdc-488f-4d00-a396-5e5f73471056",
                                                "sense_id": "3302b88a-d95d-3ba1-a706-0f3b77f38a4f",
                                                "text": "The speaker had certainly done his homework before delivering the lecture."
                                            },
                                            {
                                                "example_id": "89f039c5-8adf-43da-84a9-c61403b07446",
                                                "sense_id": "3302b88a-d95d-3ba1-a706-0f3b77f38a4f",
                                                "text": "Since the whole world is watching this launch, they probably should've done some homework on their talking points."
                                            },
                                            {
                                                "example_id": "a988d6a5-4c54-47b1-9c68-ec499c3712f9",
                                                "sense_id": "3302b88a-d95d-3ba1-a706-0f3b77f38a4f",
                                                "text": "Four years after her first sexual health book came out, Dr. Lori Brotto is giving her readers a little bit of homework for the bedroom."
                                            },
                                            {
                                                "example_id": "fa2d77a5-4cc0-4caa-8b7b-4357233a1e86",
                                                "sense_id": "3302b88a-d95d-3ba1-a706-0f3b77f38a4f",
                                                "text": "I didn't even know who he was until I did my homework and realised he was a premier footballer for Bayern."
                                            },
                                            {
                                                "example_id": "7ebdd830-1604-469a-b544-0d544106e285",
                                                "sense_id": "3302b88a-d95d-3ba1-a706-0f3b77f38a4f",
                                                "text": "Nigeria had done their homework and were well organised. Halimatu Ayinde was exceptional in her marking of James, who had scored twice and provided three assists as she ran the show against China."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6b43abc-ef51-3020-95c6-7e6c122b9ba9",
                                        "entry_id": "af460a66-dc1a-3331-91de-f3d12cb8a844",
                                        "glosses": [
                                            "Any work that is done at home; housework."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "literally",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6154e18-000a-469a-8d5f-9be59d7dc533",
                                                "sense_id": "b6b43abc-ef51-3020-95c6-7e6c122b9ba9",
                                                "text": "Hatch perceived homework to be one tool—along with various workfare schemes and private sector training programs—that would take women off welfare and make poor women \"independent.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed45a115-a9e6-363c-b837-29f9341236e3",
                                        "entry_id": "af460a66-dc1a-3331-91de-f3d12cb8a844",
                                        "glosses": [
                                            "Sexual intercourse."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "slang",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10e3c7e3-bc5d-4225-bba1-87e9685bef73",
                                                "sense_id": "ed45a115-a9e6-363c-b837-29f9341236e3",
                                                "text": "My wife and I want a kid, and we do plenty of homework, but goddamn it, Dutch, I just can't connect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d19beda3-8ced-37b8-b115-87a9977fe5fd",
                                        "entry_id": "af460a66-dc1a-3331-91de-f3d12cb8a844",
                                        "glosses": [
                                            "Tasks assigned by a dominant for a submissive to perform when they are physically away from their dominant or otherwise free."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bc07eb4-48a6-4cfa-809a-71a2a6b5dfee",
