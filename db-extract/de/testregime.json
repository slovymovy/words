                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f8aeb9a-6b66-42a6-a22e-2b94f61547b1",
                                "sense_id": "85f3ae97-928e-381f-b608-204029c10359",
                                "text": "„Zum 15. Oktober soll zudem das von Gesundheitsminister Jens Spahn (CDU) aufgestellte neue Testregime greifen.“"
                            },
                            {
                                "example_id": "b9844840-3a9e-4e6a-9a7a-8b2d8b00fb84",
                                "sense_id": "85f3ae97-928e-381f-b608-204029c10359",
                                "text": "„Die Zürcher Gesundheitsdirektion will deshalb ein neues Testregime in ihre Weisung aufnehmen: Kommt es in einem Altersheim zu einem Corona-Fall, werden künftig sämtliche Bewohnerinnen und Mitarbeiter der betroffenen Abteilung getestet.“"
                            }
                        ],
