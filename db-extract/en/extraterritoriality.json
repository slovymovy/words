                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd8a37f7-b53c-3bb4-8a5e-5b5ec9117d20",
                        "entry_id": "ce4eba2c-999d-34dc-a130-b930c8edfa4e",
                        "glosses": [
                            "Immunity from the local laws of a certain area, especially due to diplomatic negotiation."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "0a16b27d-4454-4fe5-acc5-b00f94f04140",
                                "sense_id": "dd8a37f7-b53c-3bb4-8a5e-5b5ec9117d20",
                                "text": "Although both home country and host country extraterritoriality involve the extension of national law over foreign corporations, the two differ sharply in the nature of application."
                            }
                        ]
                    },
                    {
                        "sense_id": "f342d049-e3c3-3026-aa9a-e89a6aabc3fa",
                        "entry_id": "ce4eba2c-999d-34dc-a130-b930c8edfa4e",
                        "glosses": [
                            "A territory or space that is under the power of a certain area but not defined by its norms."
                        ],
                        "tags": [
                            "countable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
