            "senses": [
                {
                    "sense_id": "a9a53180-bb35-365c-b525-9573457b10e3",
                    "sense_definition": "Voltooid deelwoord van <w>verliezen</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_forms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb gisteren mijn portemonnee <w>verloren</w> in de trein.",
                            "target_lang_translations": {
                                "en": "I <w>lost</w> my wallet on the train yesterday.",
                                "ru": "Я вчера <w>потерял</w> свой кошелек в поезде.",
                                "fr": "J'ai <w>perdu</w> mon portefeuille dans le train hier.",
                                "zh": "我昨天在火车上<w>丢失</w>了钱包。"
                            }
                        },
                        {
                            "text": "Zij hebben de wedstrijd helaas met 1-0 <w>verloren</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, they <w>lost</w> the match 1-0.",
                                "ru": "К сожалению, они <w>проиграли</w> матч со счетом 1:0.",
                                "fr": "Ils ont malheureusement <w>perdu</w> le match 1-0.",
                                "zh": "遗憾的是，他们以0比1<w>输掉</w>了比赛。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past participle"
                        }
                    ],
                    "target_lang_definitions": {
