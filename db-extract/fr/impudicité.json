                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c5d941a-fe46-4875-bb85-85e50f3b74b9",
                        "source_entry_id": "02bd68ee-0b63-303e-b75a-31dfbf8aaef0",
                        "target_lang_word": "schaamteloosheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schaamteloosheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "a989f585-c8e7-3721-9c3c-14f77879159b",
                                        "entry_id": "717ab514-a5be-3e45-94d7-78ba744c672c",
                                        "glosses": [
                                            "het schaamteloos zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "869a1ce8-3b76-487a-8aa4-21ce744428e1",
                                                "sense_id": "a989f585-c8e7-3721-9c3c-14f77879159b",
                                                "text": "De schaamteloosheid van de toneelspeler was de oorzaak van zijn ondergang."
                                            },
                                            {
                                                "example_id": "0827b3d2-b540-4ae6-acf4-7d1f34ea16dc",
                                                "sense_id": "a989f585-c8e7-3721-9c3c-14f77879159b",
                                                "text": "Psychologisch gezien is hij een narcistische sociopaat, vandaar die onophoudelijke leugens en zijn complete schaamteloosheid. Dat laatste spreekt mensen aan(!)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
