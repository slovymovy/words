                        "entry_id": "bf19adec-4630-35ca-b6be-32c3d5375d81",
                        "glosses": [
                            "Any salt of chloric acid."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ee86785-6e61-4570-9532-d8a82a298974",
                                "sense_id": "d8b7a3dd-135a-3ea7-b833-97553bdd5ae8",
                                "text": "Chlorates are powerful oxidizing agents."
                            },
                            {
                                "example_id": "13c33c3e-943b-48c8-b5e7-bce0fb014b9b",
                                "sense_id": "d8b7a3dd-135a-3ea7-b833-97553bdd5ae8",
                                "text": "The new fulminate consists of a mixture of chlorate of potash, with the prussiates, soluble or unsoluble, the hyposulphites, the hypophosphites, the phosphides, the amorphous phosphorus, alone or combined."
                            },
                            {
                                "example_id": "12751cda-dc8b-4978-92c9-93f594746369",
                                "sense_id": "d8b7a3dd-135a-3ea7-b833-97553bdd5ae8",
                                "text": "The higher levels of chlorate were discovered during routine testing at the company's production facility in Ghent, Belgium, according to an unnamed company spokesperson quoted by the AFP news agency."
                            }
                        ]
                    }
