                "senses": [
                    {
                        "sense_id": "34ca010d-271b-378a-a912-a5faeb18a500",
                        "entry_id": "08bfc5e3-b5fd-36ac-b10b-c71da67ea2a1",
                        "glosses": [
                            "Rubus phoenicolasius soort struik met vruchten die veel op bramen lijken"
                        ],
                        "tags": [
                            "fruit"
                        ],
                        "examples": [
                            {
                                "example_id": "38609d02-9466-4814-896b-50181064ed8d",
                                "sense_id": "34ca010d-271b-378a-a912-a5faeb18a500",
                                "text": "De bewoners kijken met bewondering hoe de stevige poldervrouw die ze niet of nauwelijks kennen, onvermoeibaar in de weer is. Ze plant er allerhande struiken zoals wijnbessen en wilde (on)kruiden. „Zelfs bij droog weer brengt ze water om te zorgen dat haar aanplant niet verdroogt”, zegt een ouder echtpaar."
                            },
                            {
                                "example_id": "e20450ff-20de-4f98-b2d9-b3bbad7c8a6d",
                                "sense_id": "34ca010d-271b-378a-a912-a5faeb18a500",
                                "text": "Mispels horen tot de grote rozenfamilie Rosacea, die over de hele wereld zo'n drieduizend vijfhonderd soorten telt. Ook appelen, peer, pruim, kers, abrikoos, perzik, aardbei en framboos zijn lid van dezelfde familie. Het zijn allemaal vruchten met een economische betekenis. De mispel behoort net zoals de kweepeer, de Japanse wijnbes, de loganbes en de succesvollere rozenbottel tot de ‘verarmde’ tak van de familie, waarvoor de belangstelling maar gering is."
                            }
                        ]
                    }
