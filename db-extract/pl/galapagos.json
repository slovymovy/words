                        "glosses": [
                            "archipelag na Oceanie Spokojnym, na zachód od wybrzeża Ameryki Południowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77536fbd-db69-4f5c-ab68-51f86e1fc363",
                                "sense_id": "b202ba7e-a9c3-3b5e-970b-0e45858fe89d",
                                "text": "Archipelag Galapagos składa się z dziewiętnastu wysp oraz towarzyszących im wysepek."
                            },
                            {
                                "example_id": "057fbe0f-afc9-41c9-a76d-a156f913586d",
                                "sense_id": "b202ba7e-a9c3-3b5e-970b-0e45858fe89d",
                                "text": "Na Galapagos nie ma w ogóle płazów i ryb słodkowodnych."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "ffba1bf6-9858-3f5f-9bc2-e8c8f8359a17",
