                "senses": [
                    {
                        "sense_id": "4b452ccb-0972-3b0b-83fb-1c603d473b91",
                        "entry_id": "2b27c173-d6e5-327e-9384-1288099f0770",
                        "glosses": [
                            "Enlever le soufre par hydrogénolyse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d83ad71-309c-4135-84f7-6f9d2e0b3025",
                                "sense_id": "4b452ccb-0972-3b0b-83fb-1c603d473b91",
                                "text": "Selon un mode de réalisation, le gaz résiduaire est utilisé pour hydrodésulfuriser les liquides d'hydrocarbures contenant du soufre récupérés du gaz naturel utilisé pour produire le gaz de synthèse."
                            },
                            {
                                "example_id": "5baea8f4-6775-4683-8f99-abc16023dcf4",
                                "sense_id": "4b452ccb-0972-3b0b-83fb-1c603d473b91",
                                "text": "Le catalyseur de l'invention présente une activité d'hydrodésulfurisation élevée et permet de réduire la saturation des oléfines lorsqu'il est utilisé pour hydrodésulfuriser du naphta produit par FCC."
                            }
                        ]
                    }
