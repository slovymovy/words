{
    "word_family": [
        "arrêt",
        "arrêtoir",
        "inarrêtable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "780bc5ff-8efa-363d-9075-16ce47ea7684",
                    "sense_definition": "Cesser de faire une action, interrompre une activité habituelle ou en cours.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cessation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a enfin décidé d'<w>arrêter</w> de fumer pour préserver sa santé."
                        },
                        {
                            "text": "Nous devons <w>arrêter</w> le travail maintenant car il est très tard."
                        }
                    ],
                    "common_phrases": [
                        "arrêter de fumer",
                        "arrêter de parler"
                    ]
                },
                {
                    "sense_id": "53f68f77-d0d9-356f-b8c9-afd03242e439",
                    "sense_definition": "Interrompre le mouvement ou le fonctionnement de quelque chose ou de quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur appuie sur le frein pour <w>arrêter</w> la voiture à temps."
                        },
                        {
                            "text": "N'oublie pas d'<w>arrêter</w> la machine avant de quitter la pièce."
                        }
                    ],
                    "common_phrases": [
                        "arrêter le moteur",
                        "arrêter une machine"
                    ]
                },
                {
                    "sense_id": "98dd6367-dc39-31a1-847c-fe0c4844ada6",
                    "sense_definition": "Cesser d'avancer, faire une halte en parlant d'un individu ou d'un véhicule.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bus s'<w>arrête</w> à chaque station pendant environ une minute."
                        },
                        {
                            "text": "Les touristes s'<w>arrêtent</w> devant ce monument pour prendre une jolie photo."
                        }
                    ],
                    "common_phrases": [
                        "s'arrêter un instant",
                        "s'arrêter en chemin"
                    ]
                },
                {
                    "sense_id": "384cc89d-0602-379d-a0d7-1e9c9aaa6b74",
                    "sense_definition": "Capturer une personne soupçonnée d'un délit et la priver de liberté.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "police",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police a réussi à <w>arrêter</w> le voleur quelques minutes après le vol."
                        },
                        {
                            "text": "Les gendarmes ont <w>arrêté</w> deux suspects au milieu de la nuit."
                        }
                    ],
                    "synonyms": [
                        "appréhender",
                        "capturer",
                        "interpeller"
                    ],
                    "common_phrases": [
                        "arrêter un suspect",
                        "arrêter un criminel"
                    ]
                },
                {
                    "sense_id": "cb5c20a3-d287-3652-bae4-5322de486160",
                    "sense_definition": "Prendre une décision formelle, convenir de quelque chose de manière définitive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "decision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conseil municipal a <w>arrêté</w> la date officielle de la prochaine élection."
                        },
                        {
                            "text": "Les membres du jury ont enfin <w>arrêté</w> leur choix après de longues discussions."
                        }
                    ],
                    "common_phrases": [
                        "arrêter son choix",
                        "arrêter une décision"
                    ]
                }
            ]
        }
    ]
}