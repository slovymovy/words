                                        "examples": [
                                            {
                                                "example_id": "cfeeff58-61e8-49c1-96c4-e7eaff18c717",
                                                "sense_id": "1bd45204-183b-3a9c-8eca-46cacd179c83",
                                                "text": "Le girafon a un air trop craquant."
                                            },
                                            {
                                                "example_id": "3895e491-69aa-460a-aae6-24df1c31143e",
                                                "sense_id": "1bd45204-183b-3a9c-8eca-46cacd179c83",
                                                "text": "Un girafon d’un an et demi, en parfaite santé, a été abattu dimanche au zoo de Copenhague, parce que l’animal ne présentait pas un patrimoine génétique suffisamment original."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
