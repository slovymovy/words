                "senses": [
                    {
                        "sense_id": "78a1c881-527f-3138-92d3-3c13ccfbd27c",
                        "entry_id": "3af80734-5a98-309d-a8b8-0680835a4602",
                        "glosses": [
                            "Gürtel eines Amtsträgers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16b9d758-505c-4d0d-8d18-c703d6b29628",
                                "sense_id": "78a1c881-527f-3138-92d3-3c13ccfbd27c",
                                "text": "„Endlich ließ er eine Zahl Handwerker rufen, um sieben oder acht Amtsgürtel beschlagen zu lassen.“"
                            },
                            {
                                "example_id": "804f7d8a-3ca0-4f63-a9b7-439c16de9a7a",
                                "sense_id": "78a1c881-527f-3138-92d3-3c13ccfbd27c",
                                "text": "„So oft beschäftigte er sich damit, wenn ihn der Amtsgürtel besonders eng deuchte, daß er die Einnahmen und Ausgaben des Gutes auf den Heller kannte, die Schuldscheine und Quittungen geschrieben sah und sich etwa beim Entschluß ertappte: Aber nächstes Jahr will ich es gegen das Wasser hinunter doch einmal mit Randich und Hasenklee probieren ...“"
                            },
                            {
                                "example_id": "1166dba0-b16e-47ee-a97d-fa8974fcf1e8",
                                "sense_id": "78a1c881-527f-3138-92d3-3c13ccfbd27c",
                                "text": "„Denn Theudebert gewährt dir als Lohn das Grafenamt (20) und er vergrößert den deiner Verdienste würdigen Amtsgürtel.“"
                            },
                            {
                                "example_id": "0b1fda53-3ef9-453c-b7bb-391bf5fb288f",
                                "sense_id": "78a1c881-527f-3138-92d3-3c13ccfbd27c",
                                "text": "„Johannes Lydus deutet offensichtlich eine je nach Amt verschiedene Ausgestaltung der Amtsgürtel an, wenn er sich darüber beschwert, dass früher nicht jeder, der einen wie auch immer beschaffenen Gürtel tragen wollte, dazu die Erlaubnis bekam, ohne vorher einer Prüfung unterzogen worden zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
