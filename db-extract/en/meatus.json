                    {
                        "translation_id": "f6eb84d2-5b38-4b4a-9eab-36fd2d03feb0",
                        "source_entry_id": "0018c281-f626-37d3-99dd-23f1817b70d3",
                        "source_sense_description": "tubular opening",
                        "target_lang_word": "Gang",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gang",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "26ce650b-cb83-3f7f-879e-8e93463a83f7",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Art und Weise eines Menschen oder Tieres zu gehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2713a9b6-4f80-49d8-987d-94e6dbeaf5e3",
                                                "sense_id": "26ce650b-cb83-3f7f-879e-8e93463a83f7",
                                                "text": "Läufer haben einen schnellen Gang."
                                            },
                                            {
                                                "example_id": "6b4788e8-83dd-49d1-b8ac-27cb284194db",
                                                "sense_id": "26ce650b-cb83-3f7f-879e-8e93463a83f7",
                                                "text": "„Wie schon beim für den Homo sapiens entwicklungsgeschichtlich bedeutsamen Fortschritt des aufrechten Gangs ist beim Erklettern hoher Bäume und Felsen der Abstand zum Erdboden selbst schon eine Errungenschaft.“"
                                            },
                                            {
                                                "example_id": "c675a7cd-ba79-4bdd-9957-640029ad8382",
                                                "sense_id": "26ce650b-cb83-3f7f-879e-8e93463a83f7",
                                                "text": "Das Pferd wechselte den Gang, es galoppierte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8c2c23c8-e111-340b-b68c-e4c4cc533a86",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Zurücklegen eines (bestimmten) Weges"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e226410-d0d2-4195-9e4f-225bd331de53",
                                                "sense_id": "8c2c23c8-e111-340b-b68c-e4c4cc533a86",
                                                "text": "Das Auto sprang nicht an; es war ein langer Gang nach Hause."
                                            },
                                            {
                                                "example_id": "26eef1c6-ff9f-47d9-a493-c5fc7bd8e727",
                                                "sense_id": "8c2c23c8-e111-340b-b68c-e4c4cc533a86",
                                                "text": "„Schon an einem der nächsten Nachmittage entschloß sich Robert zu einem Gang durch die Stadt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d4dc5e29-8bee-3c25-b712-0c13a0fdc31a",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Erledigung einer bestimmten Besorgung, für die ein Weg zurückgelegt werden muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5fc3316-dfa7-4567-b207-7edd8008b3a4",
                                                "sense_id": "d4dc5e29-8bee-3c25-b712-0c13a0fdc31a",
                                                "text": "„Der Gang aufs Land“. Gedicht von Hölderlin."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "27d349c0-c4cf-31e9-8fac-002764e73f6b",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "lang gezogener Verbindungsraum in Gebäuden, in Tierbehausungen oder im Bergbau"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ec5f51-2418-4988-b214-e0779ec66ce2",
                                                "sense_id": "27d349c0-c4cf-31e9-8fac-002764e73f6b",
                                                "text": "Hinter der Tür erstreckte sich ein dunkler Gang."
                                            },
                                            {
                                                "example_id": "b47f4a0a-9419-4891-895f-d2d4125c352e",
                                                "sense_id": "27d349c0-c4cf-31e9-8fac-002764e73f6b",
                                                "text": "„Er geht langsam durch den Gang und läßt den Blick in alle Ecken laufen.“"
                                            },
                                            {
                                                "example_id": "ae71fe23-941d-483c-a242-bd2be25f8ae8",
                                                "sense_id": "27d349c0-c4cf-31e9-8fac-002764e73f6b",
                                                "text": "„Am Ende dieses Ganges aber traf er einen Kammerdiener, der ihn, nach vorgängiger Meldung, in das Arbeitskabinett des Königs führte.“"
                                            },
                                            {
                                                "example_id": "59f684cc-0207-4c38-90e2-4c49b9898c0e",
                                                "sense_id": "27d349c0-c4cf-31e9-8fac-002764e73f6b",
                                                "text": "„Die Zizenhausener Heidenlöcher bestehen aus einem engen Gang, der in einen Raum mündet, von dem aus ein breiterer Gang wieder ins Freie führt – von diesem Gang wiederum gehen zwei Seitenkammern ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a85f71ce-d5bb-3307-b570-a7a85855c152",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "freier Raum zwischen Sitzreihen (in Kirche, Kino, Stadion, Theater, Zug)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54a97bd9-97e5-458f-a845-afbbe24e5902",
                                                "sense_id": "a85f71ce-d5bb-3307-b570-a7a85855c152",
                                                "text": "Mit ihren ungewohnt hohen Absätzen stolperte die Braut den Gang entlang."
                                            },
                                            {
                                                "example_id": "2e4c8771-c415-49a4-9d73-c477dcfd83d9",
                                                "sense_id": "a85f71ce-d5bb-3307-b570-a7a85855c152",
                                                "text": "Bis Kassel mussten wir auf dem Gang stehen, dann wurden endlich zwei Sitzplätze frei."
                                            },
                                            {
                                                "example_id": "76eda9e4-c060-42f4-92ba-2e76fcadc676",
                                                "sense_id": "a85f71ce-d5bb-3307-b570-a7a85855c152",
                                                "text": "„Auf der anderen Seite des Gangs saß eine Frau mit groben Gesichtszügen und einem dicken Pickel am Kinn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "191076c3-370c-3a7a-a4cf-dbbecd6ef678",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Hausflur"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "South-German",
                                            "Swiss Standard German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69c311be-5fa5-4645-a934-11e0cfbb06d3",
                                                "sense_id": "191076c3-370c-3a7a-a4cf-dbbecd6ef678",
                                                "text": "Du kannst deinen Mantel am (auf dem) Gang aufhängen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "f5baf08d-1eb1-3dd8-a318-62bad2bcce82",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "enge Gasse"
                                        ],
                                        "tags": [
                                            "North German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56b9074-d3ca-462a-857b-8e9a789bd177",
                                                "sense_id": "f5baf08d-1eb1-3dd8-a318-62bad2bcce82",
                                                "text": "Sie wohnten in einem dunklen Gang nahe dem Großneumarkt."
                                            },
                                            {
                                                "example_id": "d32d9764-ee29-4bf1-8e86-7a6261bd9f3d",
                                                "sense_id": "f5baf08d-1eb1-3dd8-a318-62bad2bcce82",
                                                "text": "Zwischen Kornträgergang und Stadthausbrücke querte früher noch der Lange Gang die Wexstraße."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "2202952b-c334-38fd-9a5e-93ba05baac35",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "beständiges Laufen, Betrieb einer Maschine oder eines Apparates"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8157e0-aa2e-4e9c-bedb-8735c878a56f",
                                                "sense_id": "2202952b-c334-38fd-9a5e-93ba05baac35",
                                                "text": "Diese Maschine ist gut in Gang."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "bdffa798-2d92-32ed-846f-f85ca8571cac",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Ablauf oder Verlauf einer Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3dcc8ef-6791-4a9e-894a-0f13b06750ef",
                                                "sense_id": "bdffa798-2d92-32ed-846f-f85ca8571cac",
                                                "text": "Der Gang des Films war verworren."
                                            },
                                            {
                                                "example_id": "47e4d89b-36a7-4304-8939-80a438bd88cb",
                                                "sense_id": "bdffa798-2d92-32ed-846f-f85ca8571cac",
                                                "text": "Es nahm alles seinen geordneten Gang."
                                            },
                                            {
                                                "example_id": "c93f1e23-c311-4fa1-b1c3-cb4fc38aec94",
                                                "sense_id": "bdffa798-2d92-32ed-846f-f85ca8571cac",
                                                "text": "„Das Hotel war hell erleuchtet und voller Lärm; es wimmelte von Offizieren, Frauen von Armeeangehörigen, weiblichen Armeeangehörigen; zwischen Bar und Empfangshalle war eine laute Party in vollem Gang, und im Speisesaal spielte eine Band.“"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "83d62c04-eb2b-3187-bdc1-efe1a0c86558",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Schaltstufe eines Getriebes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dcd4a96-d50f-46cd-88bd-1e2807f1fa3a",
                                                "sense_id": "83d62c04-eb2b-3187-bdc1-efe1a0c86558",
                                                "text": "Der Rennfahrer schaltet vor der Kurve in den dritten Gang."
                                            },
                                            {
                                                "example_id": "95413a32-cf2b-47cb-9650-301244d7b364",
                                                "sense_id": "83d62c04-eb2b-3187-bdc1-efe1a0c86558",
                                                "text": "„Er legte den ersten Gang ein, schaute kurz in den Seitenspiegel und gab Vollgas.“"
                                            },
                                            {
                                                "example_id": "ea901ec2-c750-4027-8f04-0b6963b83688",
                                                "sense_id": "83d62c04-eb2b-3187-bdc1-efe1a0c86558",
                                                "text": "„Wir waren auf die Autobahn aufgefahren, er beschleunigte und schaltete in den fünften Gang.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "ff7145ee-704b-39c7-9880-9be2c727aee6",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "einzelnes Gericht einer Speisenfolge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fec771db-2a38-4450-9917-29ea06347fa3",
                                                "sense_id": "ff7145ee-704b-39c7-9880-9be2c727aee6",
                                                "text": "Nach dem Hors-d'œuvre folgte als nächster Gang die Suppe."
                                            },
                                            {
                                                "example_id": "1c890e69-1fc2-4666-a077-888367dd734d",
                                                "sense_id": "ff7145ee-704b-39c7-9880-9be2c727aee6",
                                                "text": "„Die Frau Präzeptorin hatte nämlich über die vereinbarten Gänge hinaus auch noch für ein Extra Sorge getragen, für eine Kerbelsuppe, hinsichtlich deren ihr Haushalt ein Renommee hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    },
                                    {
                                        "sense_id": "9c6f1be6-035c-32ef-bdf9-d66f6d1e0b82",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Abschnitt eines mehrteiligen Duells oder Zweikampfes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54fbaf72-04d8-4005-9fbd-6d0aba49ccfd",
                                                "sense_id": "9c6f1be6-035c-32ef-bdf9-d66f6d1e0b82",
                                                "text": "Der Student erlitt im dritten Gang der Mensur eine Schnittverletzung."
                                            }
                                        ],
                                        "sense_index_json": "\"12\""
                                    },
                                    {
                                        "sense_id": "08bd888a-283d-3f17-a820-76a584559ad7",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Verbindung zwischen Organen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19121c25-5c50-4f9d-b6fc-0ab303270045",
                                                "sense_id": "08bd888a-283d-3f17-a820-76a584559ad7",
                                                "text": "Er ist jedoch durch einen dünnen Gang (Ductus reuniens) mit dem Sacculus […] verbunden"
                                            }
                                        ],
                                        "sense_index_json": "\"13\""
                                    },
                                    {
                                        "sense_id": "be53bdaa-20aa-383f-8f65-a78567b64eb1",
                                        "entry_id": "c9b912f5-d757-3c0e-a7fa-74c1dbf9d93e",
                                        "glosses": [
                                            "Füllung einer Spalte innerhalb eines Gesteinskörpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90bd0cc9-ce53-47ad-89f1-3851c526e593",
                                                "sense_id": "be53bdaa-20aa-383f-8f65-a78567b64eb1",
                                                "text": "Kleinere Gänge, die nur wenig durchhalten und nur eine geringe Dicke (Mächtigkeit) aufweisen, werden zuweilen als Adern bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"14\""
                                    }
                                ]
                            },
                            {
