            "senses": [
                {
                    "sense_id": "933d4b6e-2844-32e3-b479-e774ca8e3b7c",
                    "sense_definition": "Émotion pénible et vive causée par la présence ou la perspective d'un danger réel ou imaginaire.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "sentiment_danger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit garçon a <w>peur</w> de rester seul dans le noir.",
                            "target_lang_translations": {
                                "en": "The little boy is <w>afraid</w> of staying alone in the dark.",
                                "ru": "Маленький мальчик <w>боится</w> оставаться один в темноте.",
                                "nl": "De kleine jongen is <w>bang</w> om alleen in het donker te blijven.",
                                "de": "Der kleine Junge hat <w>Angst</w>, im Dunkeln allein zu bleiben.",
                                "pl": "Mały chłopiec <w>boi się</w> zostawać sam w ciemności.",
                                "it": "Il bambino ha <w>paura</w> di restare solo al buio.",
                                "cs": "Malý chlapec <w>se bojí</w> zůstat sám ve tmě.",
                                "tr": "Küçük çocuk karanlıkta yalnız kalmaktan <w>korkuyor</w>.",
                                "es": "El niño pequeño tiene <w>miedo</w> de quedarse solo en la oscuridad.",
                                "zh": "这个小男孩<w>害怕</w>独自待在黑暗里。"
                            }
                        },
                        {
                            "text": "Ce gros chien aboie très fort et fait <w>peur</w> aux enfants.",
                            "target_lang_translations": {
                                "en": "This big dog barks very loudly and <w>frightens</w> the children.",
                                "ru": "Этот крупный пёс громко лает и <w>пугает</w> детей.",
                                "nl": "Deze grote hond blaft heel hard en jaagt de kinderen <w>angst</w> aan.",
                                "de": "Dieser große Hund bellt sehr laut und macht den Kindern <w>Angst</w>.",
                                "pl": "Ten duży pies szczeka bardzo głośno i <w>przeraża</w> dzieci.",
                                "it": "Questo grosso cane abbaia molto forte e fa <w>paura</w> ai bambini.",
                                "cs": "Ten velký pes štěká velmi hlasitě a dětem nahání <w>strach</w>.",
                                "tr": "Bu iri köpek çok yüksek sesle havlıyor ve çocukları <w>korkutuyor</w>.",
                                "es": "Este perro grande ladra muy fuerte y da <w>miedo</w> a los niños.",
                                "zh": "这条大狗叫得很凶，让孩子们很<w>害怕</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "crainte",
                        "frayeur",
                        "frousse",
                        "terreur",
                        "trouille"
                    ],
                    "antonyms": [
                        "courage",
                        "bravoure",
                        "audace",
                        "intrépidité"
                    ],
                    "common_phrases": [
                        "avoir peur",
                        "faire peur",
                        "mourir de peur",
                        "trembler de peur"
                    ],
                    "target_lang_definitions": {
                        "en": "A strong, unpleasant feeling caused by the presence or prospect of a real or imagined danger.",
                        "ru": "Сильное неприятное чувство, которое возникает из-за реальной или воображаемой опасности.",
                        "nl": "Een sterk, onaangenaam gevoel dat ontstaat door de aanwezigheid of het vooruitzicht van een echt of ingebeeld gevaar.",
                        "de": "Starkes, unangenehmes Gefühl, das durch die Gegenwart oder die Aussicht auf eine echte oder eingebildete Gefahr entsteht.",
                        "pl": "Silne, nieprzyjemne uczucie wywołane obecnością lub perspektywą rzeczywistego albo wyimaginowanego niebezpieczeństwa.",
                        "it": "Sentimento spiacevole e intenso provocato dalla presenza o dalla prospettiva di un pericolo reale o immaginario.",
                        "cs": "Nepříjemný a silný citový stav vyvolaný přítomností nebo očekáváním skutečného či domnělého nebezpečí.",
                        "tr": "Gerçek ya da hayali bir tehlikenin varlığından veya ihtimalinden kaynaklanan, acı verici ve güçlü bir duygu.",
                        "es": "Emoción intensa y desagradable provocada por la presencia o la perspectiva de un peligro real o imaginario.",
                        "zh": "一种强烈而令人不快的情绪，由真实或想象中的危险出现或即将到来而引起。"
                    },
