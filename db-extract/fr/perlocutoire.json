                    {
                        "sense_id": "f9350e78-696f-3d71-863a-11911662d2dc",
                        "entry_id": "fffb63d3-d57c-3a18-8a66-782f1a0cb14e",
                        "glosses": [
                            "Se dit d’un effet ou d’un acte, non obligatoire, qui résulte d’un énoncé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a64f8c01-6b04-484e-a7c6-973d55a09068",
                                "sense_id": "f9350e78-696f-3d71-863a-11911662d2dc",
                                "text": "Pour intégrer celle-ci, il faut analyser les dimensions illocutoires et perlocutoire qui correspondent à la composante organisationnelle de la communication."
                            },
                            {
                                "example_id": "fc614791-63d8-47d7-9b7d-086922a816ff",
                                "sense_id": "f9350e78-696f-3d71-863a-11911662d2dc",
                                "text": "Enfin, l’acte perlocutoire consiste « à produire des effets sur les sentiments, les pensées, les actes de l’auditoire » ; il a trait aux conséquences de l’acte de dire quelque chose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a5cfa69-eb3b-4e1b-b889-3899ba5c1007",
                        "source_entry_id": "fffb63d3-d57c-3a18-8a66-782f1a0cb14e",
                        "source_sense_id": "f9350e78-696f-3d71-863a-11911662d2dc",
                        "target_lang_word": "perlocutionary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "perlocutionary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "15b73fad-2395-3d39-a77d-fb6f702d62b4",
                                        "entry_id": "456d0a57-f68e-3f5e-8b3e-7f6007643da3",
                                        "glosses": [
                                            "Of or pertaining to perlocution."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57cf9c4e-1bd1-4452-8c0e-072662292eea",
                                                "sense_id": "15b73fad-2395-3d39-a77d-fb6f702d62b4",
                                                "text": "Derridean \"messianicity without messianism\" that marks so much of post-modernist educational theorizing today, and that makes use of esotericism, sigetics, acroamatics, proleptics, and illocutionary and perlocutionary acts in the disguise of a new pedagogy of the unknowable, wasn't the answer ten years ago."
                                            },
                                            {
                                                "example_id": "761939d3-669a-4c94-96dc-25ce86b70d2a",
                                                "sense_id": "15b73fad-2395-3d39-a77d-fb6f702d62b4",
                                                "text": "Threats and offers have many perlocutionary effects, not all of which determine their effect on freedom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
