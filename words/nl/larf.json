                {
                    "sense_id": "c52bb810-50cd-33a6-abaf-0e5bac105e04",
                    "sense_definition": "De eerste actieve levensfase van een insect of amfibie na het ei, die uiterlijk sterk afwijkt van het volwassen dier.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "insecten_ontwikkeling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>larf</w> van een kikker wordt meestal een kikkervisje genoemd.",
                            "target_lang_translations": {
                                "en": "The <w>larva</w> of a frog is usually called a tadpole."
                            }
                        },
                        {
                            "text": "In de vijver zagen we een kleine <w>larf</w> zwemmen die later een libel zal worden.",
                            "target_lang_translations": {
                                "en": "In the pond, we saw a small <w>larva</w> swimming that will later become a dragonfly."
                            }
                        }
                    ],
                    "synonyms": [
                        "larve"
                    ],
                    "antonyms": [
                        "imago"
                    ],
                    "common_phrases": [
                        "de larf van een insect"
                    ],
                    "target_lang_definitions": {
                        "en": "The first active life stage of an insect or amphibian after the egg, which differs significantly in appearance from the adult animal."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "larva",
                                "target_lang_sense_clarification": "the active immature form of an insect or amphibian"
                            },
                            {
                                "target_lang_word": "grub",
                                "target_lang_sense_clarification": "the larva of certain insects, especially beetles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a1170ce-cf61-3b42-b06b-4d15c4701b17",
