                        "glosses": [
                            "покрыться льдом со всех сторон, по всей поверхности; превратиться в лёд"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd79a560-2b50-48ee-8f73-f2260ad3f8d3",
                                "sense_id": "3246217e-636c-3aeb-9f2e-6b273179ec52",
                                "text": "Окрай небес — звезда омега, // Весь в искрах, Сириус цветной. // Над головой — немая Вега // Из царства сумрака и сне́га // Оледенела над землёй."
                            }
                        ]
                    },
