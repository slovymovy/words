                        "entry_id": "ece4e60d-b1ae-30f7-bab5-9a6f61b0dba9",
                        "glosses": [
                            "Qui a rapport à la fièvre, qui produit la fièvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879d8bfc-1814-455c-bd93-e705b7b909d5",
                                "sense_id": "504bd196-f8d4-3f90-95bb-eff9b7c39e45",
                                "text": "Chaleur fébrile."
                            }
                        ]
                    },
                    {
                        "sense_id": "544c6feb-6dd1-3dcd-990b-d7649a537053",
                        "entry_id": "ece4e60d-b1ae-30f7-bab5-9a6f61b0dba9",
                        "glosses": [
                            "Ce qui est l’effet de la fièvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57e20ee8-9ebc-494b-a60d-4be8ddd3148a",
                                "sense_id": "544c6feb-6dd1-3dcd-990b-d7649a537053",
                                "text": "Mouvement fébrile."
                            },
                            {
                                "example_id": "9d7810b2-e102-42f9-8d41-dc3bfdbc1b54",
                                "sense_id": "544c6feb-6dd1-3dcd-990b-d7649a537053",
                                "text": "Le délire fébrile, le vomissement, la diarrhée, etc. fébriles."
                            }
                        ]
                    },
                    {
                        "sense_id": "20f199a7-29e4-3541-b64e-c90ede941f48",
                        "entry_id": "ece4e60d-b1ae-30f7-bab5-9a6f61b0dba9",
                        "glosses": [
                            "Qui est accompagné de la fièvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c9e102e-1031-4622-8d6a-b42e054c5e8e",
                                "sense_id": "20f199a7-29e4-3541-b64e-c90ede941f48",
                                "text": "Les infections fungiques sont démontrées chez environ 5 % des patients présentant une neutropénie fébrile ; cette fréquence a tendance à augmenter dans de nombreux centres, au cours des dernières années."
                            }
                        ]
                    },
                    {
                        "sense_id": "f8b47275-e9bc-30ea-9fe4-c6d73528ac1b",
                        "entry_id": "ece4e60d-b1ae-30f7-bab5-9a6f61b0dba9",
                        "glosses": [
                            "Excessif, désordonné, ardent ou agité."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4663dbdd-aa85-4350-b148-c55a3018a815",
                                "sense_id": "f8b47275-e9bc-30ea-9fe4-c6d73528ac1b",
                                "text": "Une ardeur fébrile."
                            },
                            {
                                "example_id": "3b406c60-fc6d-44f4-98a1-f8b20c61938b",
                                "sense_id": "f8b47275-e9bc-30ea-9fe4-c6d73528ac1b",
                                "text": "Parole fébrile."
                            },
                            {
                                "example_id": "38befe62-fb9e-4dfc-a0d7-f1706f4c1b39",
                                "sense_id": "f8b47275-e9bc-30ea-9fe4-c6d73528ac1b",
                                "text": "Une éloquence fébrile."
                            },
                            {
                                "example_id": "51f6d4a1-265c-4695-a165-f17b0cd2f7d8",
                                "sense_id": "f8b47275-e9bc-30ea-9fe4-c6d73528ac1b",
                                "text": "Je vous ai vu hier, vous étiez fébrile."
                            },
                            {
                                "example_id": "6dcb2697-e0b7-4b9b-a1d4-1465a7c2c98d",
                                "sense_id": "f8b47275-e9bc-30ea-9fe4-c6d73528ac1b",
                                "text": "Ils faisaient preuve d’une activité fébrile et désordonnée, gambadant, se bousculant, se donnant en spectacle, se livrant à mille facéties."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "057c4fa8-5fbf-4046-9b67-d2297e83ad6c",
                        "source_entry_id": "ece4e60d-b1ae-30f7-bab5-9a6f61b0dba9",
                        "target_lang_word": "feverish",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
