                "senses": [
                    {
                        "sense_id": "a7feb494-cfd7-3a17-9311-55bfcef00731",
                        "entry_id": "41a688b8-833e-3bef-b51b-74b2ccf60f08",
                        "glosses": [
                            "Structure rigide dorsale présente dans l’embryon de tous les chordés (Chordata) et qui, pour les vertébrés, participe à la formation de la colonne vertébrale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "def6633e-9c36-4e10-80be-5c168c1e89de",
                                "sense_id": "a7feb494-cfd7-3a17-9311-55bfcef00731",
                                "text": "Chez le sous-embranchement des Urochordés, ou tuniciers, la notochorde est présente chez la larve. Par contre, après une métamorphose qui transforme la larve en adulte, la majorité du temps sessile, la notochorde disparaît."
                            },
                            {
                                "example_id": "def5cd1d-da11-4b52-b486-dd3ea0ceacb9",
                                "sense_id": "a7feb494-cfd7-3a17-9311-55bfcef00731",
                                "text": "Le rôle de la notochorde dans la ventralisation du somite est particulièrement bien démontré chez l’oiseau et la souris."
                            }
                        ]
                    }
                ],
