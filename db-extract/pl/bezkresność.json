                        "entry_id": "a56c4869-0b90-386b-8f75-4cdb2efa9a98",
                        "glosses": [
                            "Grenzenlosigkeit, Unendlichkeit, Endlosigkeit"
                        ],
                        "tags": [
                            "Weite von scheinbar grenzenlosem Ausmaß"
