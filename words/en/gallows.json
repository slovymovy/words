{
    "word_family": [
        "gallow",
        "gallows-bird",
        "gallows-humor"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf3ca28b-cc0e-31df-aa06-84ed8e87c3a0",
                    "sense_definition": "A wooden framework on which persons are executed by hanging.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "execution structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner was led to the <w>gallows</w> at dawn for his crimes.",
                            "target_lang_translations": {
                                "pl": "Więzień został o świcie doprowadzony na <w>szubienicę</w> za swoje zbrodnie."
                            }
                        },
                        {
                            "text": "In many historical novels, the <w>gallows</w> humor of the condemned man surprised the crowd.",
                            "target_lang_translations": {
                                "pl": "W wielu powieściach historycznych <w>wisielczy</w> humor skazańca zaskakiwał tłum."
                            }
                        }
                    ],
                    "synonyms": [
                        "gallows tree",
                        "gallow tree",
                        "hanging tree",
                        "gibbet",
                        "Tyburn tree"
                    ],
                    "common_phrases": [
                        "gallows humor",
                        "sent to the gallows",
                        "on the gallows"
                    ],
                    "target_lang_definitions": {
                        "pl": "Drewniana konstrukcja służąca do wykonywania kary śmierci przez powieszenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szubienica",
                                "target_lang_sense_clarification": "miejsce egzekucji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a0cc7b1-11bf-3777-95fe-d9b00c0c74b5",
                    "sense_definition": "Any contrivance with posts and crossbeam for suspending objects.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "suspension structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tubes hang from a steel <w>gallows</w> beside the hospital bed to provide oxygen.",
                            "target_lang_translations": {
                                "pl": "Rurki zwisają ze stalowego <w>stelaża</w> obok łóżka szpitalnego, aby dostarczać tlen."
                            }
                        },
                        {
                            "text": "The mechanic used a small <w>gallows</w> to lift the heavy engine out of the car.",
                            "target_lang_translations": {
                                "pl": "Mechanik użył małego <w>wysięgnika</w>, aby wyciągnąć ciężki silnik z samochodu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "steel gallows"
                    ],
                    "target_lang_definitions": {
                        "pl": "Wszelkiego rodzaju konstrukcja wsporcza ze słupami i poprzeczką do zawieszania przedmiotów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "stelaż",
                                "target_lang_sense_clarification": "konstrukcja do zawieszania"
                            },
                            {
                                "target_lang_word": "wysięgnik",
                                "target_lang_sense_clarification": "ramię do podtrzymywania"
                            },
                            {
                                "target_lang_word": "szubienica",
                                "target_lang_sense_clarification": "techniczne określenie ramy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9943eda1-af4c-313d-bc62-69053fd82561",
                    "sense_definition": "A pair of suspenders or braces used to hold up trousers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He adjusted his <w>gallowses</w> before heading out to the fields.",
                            "target_lang_translations": {
                                "pl": "Poprawił <w>szelki</w> przed wyjściem w pole."
                            }
                        },
                        {
                            "text": "The old man preferred wearing a pair of <w>gallowses</w> instead of a leather belt.",
                            "target_lang_translations": {
                                "pl": "Starzec wolał nosić <w>szelki</w> zamiast skórzanego paska."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pair of gallowses"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "chiefly US and dialectal"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Szelki służące do podtrzymywania spodni."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szelki",
                                "target_lang_sense_clarification": "do spodni"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "744666e7-dd8e-3aa0-9b56-a7a1d50fc613",
                    "sense_definition": "A person who is considered a wretch or deserves to be hanged.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That shrewd and unhappy <w>gallows</w> will never be a friend to anyone.",
                            "target_lang_translations": {
                                "pl": "Ten przebiegły i nieszczęsny <w>szubienicznik</w> nigdy nie będzie niczyim przyjacielem."
                            }
                        },
                        {
                            "text": "The villagers called the thief a <w>gallows</w> as they chased him away.",
                            "target_lang_translations": {
                                "pl": "Wieśniacy wyzywali złodzieja od <w>wisielców</w>, gdy go przepędzali."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba uważana za nędznika lub zasługująca na powieszenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "szubienicznik",
                                "target_lang_sense_clarification": "osoba godna szubienicy"
                            },
                            {
                                "target_lang_word": "wisielec",
                                "target_lang_sense_clarification": "łotr, nędznik"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1d8a0c5-972a-34d5-8c9c-b65ac2867f55",
                    "sense_definition": "The main frame of a beam engine.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "engineering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer inspected the <w>gallows</w> of the beam engine for signs of wear.",
                            "target_lang_translations": {
                                "pl": "Inżynier sprawdził <w>ramę</w> silnika wahadłowego pod kątem oznak zużycia."
                            }
                        },
                        {
                            "text": "The massive iron <w>gallows</w> supported the weight of the moving machinery.",
                            "target_lang_translations": {
                                "pl": "Masywny żelazny <w>stojak</w> podtrzymywał ciężar ruchomych maszyn."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical engineering term"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Główna rama silnika parowego wahadłowego."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rama nośna",
                                "target_lang_sense_clarification": "w silniku parowym"
                            },
                            {
                                "target_lang_word": "stojak",
                                "target_lang_sense_clarification": "konstrukcja wsporcza maszyny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "2147d334-8b62-3378-8baf-0bb2c24cce8c",
                    "sense_definition": "To a great degree; utterly or very.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They have got a <w>gallows</w> bad reputation in this part of the town.",
                            "target_lang_translations": {
                                "pl": "Mają <w>cholernie</w> złą reputację w tej części miasta."
                            }
                        },
                        {
                            "text": "It was a <w>gallows</w> long walk back to the station in the rain.",
                            "target_lang_translations": {
                                "pl": "To był <w>strasznie</w> długi spacer z powrotem na stację w deszczu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gallows bad"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "used as an intensifier"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "W stopniu znacznym; całkowicie lub bardzo."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "cholernie",
                                "target_lang_sense_clarification": "intensyfikator"
                            },
                            {
                                "target_lang_word": "strasznie",
                                "target_lang_sense_clarification": "bardzo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3328d1a6-f7c3-3d53-8e05-cbb7f0d1fc86",
                    "sense_definition": "The plural form of the surname <w>Gallow</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The <w>Gallows</w> are coming over for dinner this Sunday evening.",
                            "target_lang_translations": {
                                "pl": "<w>Gallowie</w> przychodzą do nas na kolację w tę niedzielę wieczorem."
                            }
                        },
                        {
                            "text": "We researched the history of the <w>Gallows</w> family in the local archives.",
                            "target_lang_translations": {
                                "pl": "Badaliśmy historię rodziny <w>Gallowów</w> w lokalnych archiwach."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "plural of the name Gallow"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Liczba mnoga nazwiska Gallow."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "Gallowie",
                                "target_lang_sense_clarification": "rodzina o nazwisku Gallow"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bdd395e3-2719-3b27-9b23-4d31bc5bef7b",
                    "sense_definition": "The third-person singular simple present indicative form of <w>gallow</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The loud thunder <w>gallows</w> the cattle and makes them run.",
                            "target_lang_translations": {
                                "pl": "Głośny grzmot <w>przeraża</w> bydło i zmusza je do ucieczki."
                            }
                        },
                        {
                            "text": "It <w>gallows</w> the very wanderers of the dark with its intensity.",
                            "target_lang_translations": {
                                "pl": "Swoją intensywnością <w>trwoży</w> nawet wędrowców mroku."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "from the verb gallow meaning to frighten"
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Forma czasu teraźniejszego czasownika 'gallow' (przerażać)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "przeraża",
                                "target_lang_sense_clarification": "budzi trwogę"
                            },
                            {
                                "target_lang_word": "trwoży",
                                "target_lang_sense_clarification": "napawa lękiem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}