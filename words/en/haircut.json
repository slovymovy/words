                                "target_lang_word": "причёска",
                                "target_lang_sense_clarification": "стиль укладки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发型",
                                "target_lang_sense_clarification": "头发的样式"
                            },
                            {
                                "target_lang_word": "剪发",
                                "target_lang_sense_clarification": "剪出的发型"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f0b41f1-008c-3f7d-9650-6e66e29631ab",
                    "sense_definition": "A reduction in the value of an asset or a reduction in the amount of debt that will be repaid to creditors.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance_haircut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors were forced to take a significant <w>haircut</w> on their bonds during the crisis.",
                            "target_lang_translations": {
                                "ru": "Инвесторы были вынуждены пойти на значительное <w>списание</w> по своим облигациям во время кризиса.",
                                "zh": "危机期间，投资者被迫对他们的债券进行大幅<w>减记</w>。"
                            }
                        },
                        {
                            "text": "The bank agreed to a restructuring plan that involved a <w>haircut</w> on the original loan amount.",
                            "target_lang_translations": {
                                "ru": "Банк согласился на план реструктуризации, который включал <w>списание</w> части первоначальной суммы кредита.",
                                "zh": "银行同意了一项重组计划，其中包括对原始贷款金额进行<w>减记</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "take a haircut",
                        "accept a haircut",
                        "valuation haircut"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "in business/finance contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижение стоимости актива или уменьшение суммы долга, которая будет возвращена кредиторам.",
                        "zh": "资产价值的降低，或债权人收回的债务金额的减少。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисконт",
                                "target_lang_sense_clarification": "финансы"
                            },
                            {
                                "target_lang_word": "списание",
                                "target_lang_sense_clarification": "части долга"
                            },
                            {
                                "target_lang_word": "стрижка",
                                "target_lang_sense_clarification": "финансовый жаргон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "减记",
                                "target_lang_sense_clarification": "金融资产价值缩减"
                            },
                            {
                                "target_lang_word": "折扣",
                                "target_lang_sense_clarification": "金融估值折让"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94b04c5a-dbbf-3487-973c-81a607f15d07",
                    "sense_definition": "The difference between the market value of an asset used as loan collateral and the amount of the loan.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance_haircut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Government securities are usually subject to a small <w>haircut</w> when used as collateral.",
                            "target_lang_translations": {
                                "ru": "Государственные ценные бумаги обычно подлежат небольшому <w>дисконту</w> при использовании в качестве залога.",
                                "zh": "政府证券在用作抵押品时通常会面临小幅<w>折价</w>。"
                            }
                        },
                        {
                            "text": "For risky assets, the lender may demand a <w>haircut</w> of up to thirty percent.",
                            "target_lang_translations": {
                                "ru": "Для рискованных активов кредитор может потребовать <w>дисконт</w> до тридцати процентов.",
                                "zh": "对于高风险资产，贷款方可能会要求高达百分之三十的<w>折价</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "margin"
                    ],
                    "common_phrases": [
                        "collateral haircut"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "in business/finance contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разница между рыночной стоимостью актива, используемого в качестве залога, и суммой кредита.",
                        "zh": "用作贷款抵押品的资产的市场价值与贷款金额之间的差额。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисконт",
                                "target_lang_sense_clarification": "залоговый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抵押折扣",
                                "target_lang_sense_clarification": "抵押品估值折让"
                            },
                            {
                                "target_lang_word": "折价",
                                "target_lang_sense_clarification": "抵押品估值折让"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8b987c3-3bc0-3512-a71b-98dbeaae1a00",
                    "sense_definition": "To reduce the estimated value assigned to an asset.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "finance_haircut",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The value of the collateral was <w>haircutted</w> to account for potential market volatility.",
                            "target_lang_translations": {
                                "ru": "Стоимость залога была <w>дисконтирована</w> для учета возможной волатильности рынка.",
                                "zh": "为了应对潜在的市场波动，抵押品的价值被<w>减记</w>了。"
                            }
                        },
                        {
                            "text": "Assets must be <w>haircutted</w> appropriately before they are accepted as security for the loan.",
                            "target_lang_translations": {
                                "ru": "Активы должны быть надлежащим образом <w>дисконтированы</w>, прежде чем они будут приняты в качестве обеспечения по кредиту.",
                                "zh": "资产在被接受作为贷款担保之前，必须进行适当的<w>折价</w>处理。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "in business/finance contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Снижать оценочную стоимость, приписанную активу.",
                        "zh": "降低分配给资产的估计价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дисконтировать",
                                "target_lang_sense_clarification": "применять дисконт"
