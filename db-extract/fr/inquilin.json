                "translations": [
                    {
                        "translation_id": "71cce1e6-8c3d-4483-b7b1-e0bcf1f91d64",
                        "source_entry_id": "5de4ab9c-3caa-3be6-9527-238a7ac0d4d1",
                        "source_sense_id": "92060479-c405-3109-9743-214e06a47bc1",
                        "target_lang_word": "inquiline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inquiline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47a4533a-3218-3b18-b0bf-5d6eb353ed19",
                                        "entry_id": "00d0d66d-acc7-3dbe-bbbc-1b164f04b1b5",
                                        "glosses": [
                                            "An animal that lives commensally in the nest, burrow, gall, or dwelling place of an animal of another species."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6522f92a-b249-4eed-be84-aa2725f9e7a5",
                                                "sense_id": "47a4533a-3218-3b18-b0bf-5d6eb353ed19",
                                                "text": "The other study[…]involved the larvae of the caterpillar Maculinea rebeli, an inquiline of Myrmica schenki."
                                            },
                                            {
                                                "example_id": "4823c140-f90d-4013-84f5-81dd4ac9460d",
                                                "sense_id": "47a4533a-3218-3b18-b0bf-5d6eb353ed19",
                                                "text": "Queens of socially parasitic inquiline ants reproduce by laying eggs in the colonies of other species."
                                            },
                                            {
                                                "example_id": "4fd2d52c-4393-49cc-a325-7e34b4ce6921",
                                                "sense_id": "47a4533a-3218-3b18-b0bf-5d6eb353ed19",
                                                "text": "A reproductive female inquiline gains access to a host nest and usually kills the resident queen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b36f18a-da70-3837-b77d-0468f749b702",
                                        "entry_id": "00d0d66d-acc7-3dbe-bbbc-1b164f04b1b5",
                                        "glosses": [
                                            "An organism that lives within a reservoir of water collected in the hollow of a plant stem or leaf."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c695052b-e485-45e6-802e-661c4d608b12",
                                                "sense_id": "5b36f18a-da70-3837-b77d-0468f749b702",
                                                "text": "Captured prey also constitute the resource base for a community of inquiline bacteria, protozoa, and invertebrates that inhabit the water-filled pitchers. For at least two of these inquilines (the pitcher-plant mosquito Wyeomyia smithii Coquillet and the pitcher-plant midge Metriocnemus knabi Coquillet) the availability of captured prey limits individual growth, and ultimately population growth[…]"
                                            },
                                            {
                                                "example_id": "ae8b1bba-1363-46b1-bc5a-12c411396db9",
                                                "sense_id": "5b36f18a-da70-3837-b77d-0468f749b702",
                                                "text": "The insect and other animal inhabitants of the pitchers, known collectively as the inquilines, may benefit the plants by breaking down prey and making nutrients available for plant absorption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
