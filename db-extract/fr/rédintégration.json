                                        "sense_id": "90fda84c-75f0-3ed9-b30a-c723c75906df",
                                        "entry_id": "09571820-4c04-3978-a09b-58637a125cfd",
                                        "glosses": [
                                            "Restoration of a mixture to its former nature and state."
                                        ],
                                        "tags": [
