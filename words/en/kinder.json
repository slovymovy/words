                    "sense_id": "064f05ff-59b7-3462-9436-c4194fb1f909",
                    "sense_definition": "comparative form of <w>kind</w>: more kind",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kindness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My aunt has been <w>kinder</w> to me since my father died.",
                            "target_lang_translations": {
                                "ru": "Моя тетя стала <w>добрее</w> ко мне после смерти отца."
                            }
                        },
                        {
                            "text": "Electric trains have much lower operating costs and are <w>kinder</w> to the track.",
                            "target_lang_translations": {
                                "ru": "Электрические поезда имеют гораздо более низкие эксплуатационные расходы и <w>более бережно</w> воздействуют на пути."
                            }
