                "senses": [
                    {
                        "sense_id": "31d5cabf-21c1-385e-a6e4-e1bbeec80de5",
                        "entry_id": "7c31c7a2-9021-3305-a133-b4f7000bf69a",
                        "glosses": [
                            "ботан. то же, что гладиолус"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5d3bd6e-557c-42f8-b1ce-7dca4a57a856",
                                "sense_id": "31d5cabf-21c1-385e-a6e4-e1bbeec80de5",
                                "text": "Чай пили в садике, где цвели резеда, левкои, табак и уже распускались ранние шпажники."
                            },
                            {
                                "example_id": "f3ff8951-ea43-4a0a-989c-f6279d5eb621",
                                "sense_id": "31d5cabf-21c1-385e-a6e4-e1bbeec80de5",
                                "text": "Старое русское название цветка ― шпажник ― дано также за характерную форму листьев."
                            }
                        ]
                    }
                ],
