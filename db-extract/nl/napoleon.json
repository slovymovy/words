                    {
                        "sense_id": "fde6d25e-2af3-3ed3-9b6b-5c3c03a22d1a",
                        "entry_id": "8183743b-2227-3570-ae0e-4de4fb96cc23",
                        "glosses": [
                            "gouden munt met een waarde van 20 francs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "632f7c19-2292-427b-bc86-a386e8d6368c",
                                "sense_id": "fde6d25e-2af3-3ed3-9b6b-5c3c03a22d1a",
                                "text": "Ze trokken hun kleren weer aan en stapten de barakken van de douane binnen. Nicholas had geen paspoort, hij kon geen woord Engels spreken. Hij had tien napoleons die hij hen liet zien om duidelijk te maken dat hij niet afhankelijk zou zijn. Ze lieten hem door."
                            }
                        ]
                    },
                    {
                        "sense_id": "b34d4dea-f9bc-36b0-bc08-933bfb987fda",
                        "entry_id": "8183743b-2227-3570-ae0e-4de4fb96cc23",
                        "glosses": [
                            "smal baardje met bijpassende puntige snor"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "48ebbb70-5916-339f-ae7e-5e252da31760",
                        "entry_id": "8183743b-2227-3570-ae0e-4de4fb96cc23",
                        "glosses": [
                            "kattenras met korte pootjes en een lange, zijdeachtige vacht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72ceb6aa-3d54-4d1d-acc0-e80cf0913b64",
                                "sense_id": "48ebbb70-5916-339f-ae7e-5e252da31760",
                                "text": "De napoleon heeft zijn actieve en wendbare eigenschappen van de munchkin, maar is net als de pers een echte schootkat."
                            }
                        ]
                    },
                    {
                        "sense_id": "ada53516-50ef-300c-baa9-63e9057b21ee",
                        "entry_id": "8183743b-2227-3570-ae0e-4de4fb96cc23",
                        "glosses": [
                            "bepaald soort grote lipvis, Cheilinus undulatus, die van nature voorkomt in koraalriffen in het Midden-Oosten"
                        ],
                        "tags": [
                            "straalvinnigen"
                        ],
                        "examples": [
