                                        "glosses": [
                                            "Que no actúa con cortesía o amabilidad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eda12f20-98e3-45a1-9052-7e2007d0d581",
                                                "sense_id": "a65be91a-9754-3f05-be9e-e073d40ecb63",
                                                "text": "Tu hermana está en su habitación. Deberías ir a darle las buenas noches; ¡no seas descortés!"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
