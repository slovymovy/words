                    {
                        "translation_id": "f5d1e161-f19e-4d5f-aaa1-993c30167a51",
                        "source_entry_id": "d7e9f3df-f0b6-3ee0-af26-68cadf9d299f",
                        "source_sense_id": "b7a65776-cf87-3266-8096-558de70fd0f4",
                        "source_sense_description": "(Vêtements) Sorte de vêtement court et sans basques.",
                        "target_lang_word": "Jacke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jacke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                        "entry_id": "a0230f66-884b-3850-9f1a-38262a7e57b3",
                                        "glosses": [
                                            "ein Bekleidungsstück für Männer und Frauen, welches zum Bedecken des Oberkörpers vorgesehen ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27ddb63c-eb95-4dbf-a551-58b43c0ece2c",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "Ziehe dir eine Jacke über, es ist Herbst!"
                                            },
                                            {
                                                "example_id": "183fdd4f-44af-46c8-b930-8066d3b34c76",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„Sie zieht die Jacke aus.“"
                                            },
                                            {
                                                "example_id": "11dd9b12-096e-49c1-b4ff-cdc16afc161a",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„In Kopenhagen vor einem Haustor von vornehmem Aussehen steht ein Soldat in einer ziemlich neuen Jacke und Stulpenstiefeln, mit Gürtel um den Leib und einem schwarzen Kriegerhut, jedoch ohne Waffen.“"
                                            },
                                            {
                                                "example_id": "a5566e23-d7bd-4edd-a7cf-f8d8e4dbcb15",
                                                "sense_id": "d818ed0c-2a44-3ef9-97db-b72eba95de98",
                                                "text": "„Sie zog den Reißverschluss der Jacke höher, setzte die Kapuze auf und beeilte sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44a1f5aa-8dd2-43f7-abc0-f45cc8490777",
                        "source_entry_id": "d7e9f3df-f0b6-3ee0-af26-68cadf9d299f",
                        "source_sense_id": "b7a65776-cf87-3266-8096-558de70fd0f4",
                        "source_sense_description": "(Vêtements) Sorte de vêtement court et sans basques.",
                        "target_lang_word": "Jackett",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jackett",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                        "entry_id": "c94b417a-43f9-3fd9-a9a6-f6f8dcd334ac",
                                        "glosses": [
                                            "kurzer, enger Männerrock (Männerrock im Sinne von Jacke)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac7eadbc-d4da-468b-a477-9742af928cc5",
                                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                                "text": "Das Jackett ist farblich auf die Hose abgestimmt und sitzt perfekt."
                                            },
                                            {
                                                "example_id": "0c295a6c-f989-4583-95e2-bc81cc1c675b",
                                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                                "text": "„Er trug eine untadelig gepuderte Perücke und ein Jackett aus Seidenbrokat.“"
                                            },
                                            {
                                                "example_id": "b1ecc7af-c977-48e6-a106-b11161f77458",
                                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                                "text": "„Das Jackett saß ihm wie angegossen.“"
                                            },
                                            {
                                                "example_id": "12b670b4-004d-4218-9c46-a2404f235793",
                                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                                "text": "„Im Jackett fand er die Brieftasche und ein leeres Zigarettenetui, flach, elegant und mit eingraviertem ›Betsy‹.“"
                                            },
                                            {
                                                "example_id": "de7f250f-fd52-4c31-9c96-d72e389d3d50",
                                                "sense_id": "41aa1519-926a-319f-965e-1a43ad2067ab",
                                                "text": "„Nachmittags hört er schon die Schwägerinnen in der Küche sitzen und reden, wenn er sein Jackett an der Garderobe aufhängt und die Schuhe abstreift.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b6883833-4cc6-4d22-9336-e664b0316480",
                        "source_entry_id": "d7e9f3df-f0b6-3ee0-af26-68cadf9d299f",
                        "source_sense_id": "b7a65776-cf87-3266-8096-558de70fd0f4",
                        "source_sense_description": "(Vêtements) Sorte de vêtement court et sans basques.",
                        "target_lang_word": "Sakko",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sakko",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d7c4cddf-db80-373c-bf2d-1a8092bfd2b9",
                                        "entry_id": "8d515eda-f795-32d3-8551-f686264b063a",
                                        "glosses": [
                                            "Oberbekleidungsstück für Herren mit Knöpfen aus nicht allzu weichem Stoff"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f6c6373-d5d5-4e3e-b570-9e7c998d35ee",
                                                "sense_id": "d7c4cddf-db80-373c-bf2d-1a8092bfd2b9",
                                                "text": "„[Danijel Lacić:] ‚Der Ärmel des Sakkos soll bis zur Daumenwurzel gehen, vom Hemd soll etwa ein Zentimeter zu sehen sein.‘“"
                                            },
                                            {
                                                "example_id": "77c57384-b141-4827-8ec6-d8919d3c745e",
                                                "sense_id": "d7c4cddf-db80-373c-bf2d-1a8092bfd2b9",
                                                "text": "„Rickmers mit seinem blauen Sakko und den Goldknöpfen passt in dieses Ambiente wie gemalt.“"
                                            },
                                            {
                                                "example_id": "2f99d603-c4a9-4f85-8886-a7cc8fd950e0",
                                                "sense_id": "d7c4cddf-db80-373c-bf2d-1a8092bfd2b9",
                                                "text": "„Er nimmt eine Zigarette heraus, lässt das Etui wieder in die Tasche seines Sakkos gleiten und lehnt sich auf seinem Stuhl auf dem Deck zurück.“"
                                            },
                                            {
                                                "example_id": "71d9d11a-dfac-4b30-bbd0-af2b3633a225",
                                                "sense_id": "d7c4cddf-db80-373c-bf2d-1a8092bfd2b9",
                                                "text": "„Matthyas holt aus der Innentasche seines Sakkos die heutige Ausgabe der Baseler Zeitung, in der das Buch ganzseitig besprochen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
