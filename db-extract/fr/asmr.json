                    {
                        "sense_id": "9bd218b8-d5bc-31f0-b943-5735505abe95",
                        "entry_id": "130082aa-98ec-3bcd-bf2a-f68127ac892d",
                        "glosses": [
                            "C'est le progrès thérapeutique apporté par un médicament par rapport aux anciens médicaments de référence. Elle est notée de 1 (I) à 5 (V)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d334b678-a69c-43da-8f22-fb0b0b95f286",
                                "sense_id": "9bd218b8-d5bc-31f0-b943-5735505abe95",
                                "text": "Le médecin généraliste, peut-il s'appuyer sur la classification ASMR pour limiter la polymédication, principal facteur de risque d'accidents médicamenteux chez la personne âgée de plus de 65 ans ?"
                            },
                            {
                                "example_id": "9a110730-0af7-4c64-abff-d379be422692",
                                "sense_id": "9bd218b8-d5bc-31f0-b943-5735505abe95",
                                "text": "En médecine humaine, le Service Médical Rendu (SMR) et l’Amélioration du SMR (ASMR) permettent respectivement de déterminer le taux de remboursement et le prix du médicament évalué."
                            }
                        ]
                    }
