    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a8ff6fc6-fd3d-34f5-ab4b-771481fe7e02",
                    "sense_definition": "To express the essential features of something in a brief summary.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "summarize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This short speech perfectly <w>encapsulates</w> the main goals of our new project."
                        },
                        {
                            "text": "The photograph <w>encapsulated</w> the joy of the entire summer vacation."
                        }
                    ],
                    "synonyms": [
                        "summarize",
                        "epitomize",
                        "embody"
                    ]
                },
                {
                    "sense_id": "6c324098-bfac-344d-9691-7e0c6629d2f6",
                    "sense_definition": "To cover or surround something completely, as if in a capsule.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "enclose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thick layer of wax <w>encapsulates</w> the delicate flower to preserve it."
                        },
                        {
                            "text": "The ancient resin <w>encapsulated</w> the insect for thousands of years."
                        }
                    ],
                    "synonyms": [
                        "enclose",
                        "surround",
                        "envelop"
                    ]
                },
                {
                    "sense_id": "c919f636-5a99-3a94-be8f-4059fad190c5",
                    "sense_definition": "To hide the internal details of an object or function within a program to protect its state.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "programming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good software design helps to <w>encapsulate</w> complex logic within simple classes."
                        },
                        {
                            "text": "We <w>encapsulated</w> the database connection settings to prevent accidental modification."
                        }
                    ]
                },
                {
                    "sense_id": "fd0a26d2-5089-3676-b684-b6ea92793b24",
                    "sense_definition": "To wrap data into a specific format for transmission over a network.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "programming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The network protocol <w>encapsulates</w> the data packets before sending them."
                        },
                        {
                            "text": "The system <w>encapsulated</w> the information to ensure it could be read by the receiver."
                        }
                    ]
                }
            ]
        }
    ]
