                        ],
                        "form": "doodzieke"
                    },
                    {
                        "form_id": "981df0f3-6732-4796-ae16-7de97cf52ff0",
                        "entry_id": "50dd3640-2873-374e-ae69-eb9ccd7e0a88",
                        "tags": [
                            "partitive",
                            "positive"
                        ],
                        "form": "doodzieks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4428b10-2e35-3d2a-8072-7d462dab5112",
                        "entry_id": "50dd3640-2873-374e-ae69-eb9ccd7e0a88",
                        "glosses": [
                            "door een aandoening er zo slecht aan toe zijn dat overlijden dreigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d8270f9-1f98-4ac2-bbed-c473338cdb65",
                                "sense_id": "f4428b10-2e35-3d2a-8072-7d462dab5112",
                                "text": "De doodzieke oude man had niet lang meer te leven."
                            },
                            {
                                "example_id": "7dab84d1-d832-4ad9-a53b-547a983b6584",
                                "sense_id": "f4428b10-2e35-3d2a-8072-7d462dab5112",
                                "text": "Sinds de introductie van Monsanto’s pesticideresistente gengewassen in 1996 in Argentinië, is het gebruik van bestrijdingsmiddelen met het negenvoudige toegenomen. Omwonenden van de plantages claimen daar doodziek van te worden, en begonnen een rechtszaak tegen de soja-industrie."
                            },
                            {
                                "example_id": "14906fda-5fe0-4b82-80ed-84411406ddcd",
                                "sense_id": "f4428b10-2e35-3d2a-8072-7d462dab5112",
                                "text": "Van 18 Mexicaanse grieppatiënten die doodziek in één ziekenhuis in Mexico Stad lagen, is de ziektegeschiedenis gedetailleerd beschreven. Zeven overleden binnen 14 dagen."
                            }
                        ]
                    },
                    {
                        "sense_id": "ea886202-6424-32dc-9b3c-d724403d0e22",
                        "entry_id": "50dd3640-2873-374e-ae69-eb9ccd7e0a88",
                        "glosses": [
                            "heel erg ziek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95fcfa6e-8eb6-48a3-baf7-114e1c9d16b6",
                                "sense_id": "ea886202-6424-32dc-9b3c-d724403d0e22",
                                "text": "Hij had de nacht tevoren te veel gedronken en nu voelde hij zich doodziek."
                            },
                            {
                                "example_id": "11d4f920-a995-4b49-9cb0-19670e3ac326",
                                "sense_id": "ea886202-6424-32dc-9b3c-d724403d0e22",
                                "text": "Maar na de eerste wedstrijd werd Roeland doodziek, net als andere Nederlandse roeiers door een virus, waarna we de finale niet hebben gehaald."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9967dcf1-ba70-4cfa-93e7-c99fab4190cb",
                        "source_entry_id": "50dd3640-2873-374e-ae69-eb9ccd7e0a88",
                        "source_sense_id": "ea886202-6424-32dc-9b3c-d724403d0e22",
                        "source_sense_description": "heel erg ziek",
                        "target_lang_word": "todkrank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "todkrank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95b89c5a-dfa7-3de7-997d-8f314c4fbe6e",
                                        "entry_id": "8d2c7ea4-f2ad-3d2b-b88a-c638d197e1d5",
                                        "glosses": [
                                            "so sehr krank, dass man an der Krankheit zu sterben droht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0213f0b-a81e-4920-82fd-d5e77809b7e1",
                                                "sense_id": "95b89c5a-dfa7-3de7-997d-8f314c4fbe6e",
                                                "text": "Er war todkrank, als er sein Testament aufsetzte und Klaus alles hinterließ."
                                            },
                                            {
                                                "example_id": "03ec1ab6-1625-4f20-b08e-d884a1b6c1a0",
                                                "sense_id": "95b89c5a-dfa7-3de7-997d-8f314c4fbe6e",
                                                "text": "„Vor allem aber war er todkrank und nicht mehr in der Lage, ins Exil zu segeln.“"
                                            },
                                            {
                                                "example_id": "02aa4fcb-183b-40ad-b0e9-6b1a5b94b079",
                                                "sense_id": "95b89c5a-dfa7-3de7-997d-8f314c4fbe6e",
                                                "text": "„Er kehrte nach Delhi zurück, als sein Vater erkrankt war und wurde dann selbst todkrank.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
