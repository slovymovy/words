                {
                    "sense_id": "2491fc6c-e431-37da-9175-f869499af1ee",
                    "sense_definition": "Subdued or humbled as a result of having been severely scolded, criticized, or punished.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He offered a weak apology with a quiet, <w>chastised</w> look on his face.",
                            "target_lang_translations": {
                                "es": "Ofreció una disculpa tibia con una mirada tranquila y <w>avergonzada</w> en el rostro."
                            }
                        },
                        {
                            "text": "The team returned to the locker room looking thoroughly <w>chastised</w> after the defeat.",
                            "target_lang_translations": {
                                "es": "El equipo volvió al vestuario viéndose completamente <w>escarmentado</w> tras la derrota."
                            }
                        }
                    ],
                    "synonyms": [
