                        "cross_references": [
                            {
                                "target_word": "ERP",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bc434732-d529-3d6d-9596-d2bd76caa597",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of effective radiated power or equivalent radiated power."
                                        ],
