                ],
                "senses": [
                    {
                        "sense_id": "d9b28496-a8da-35d4-b2c6-dcd330f899f9",
                        "entry_id": "1edb01d1-a3e9-3e39-87d4-273651db1e16",
                        "glosses": [
                            "устар. вызывать смуту, волнение, мятеж, раздоры"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f9e7c46-a37e-46f6-9ab6-08f30aec1997",
                                "sense_id": "d9b28496-a8da-35d4-b2c6-dcd330f899f9",
                                "text": "Смутить народ."
                            },
                            {
                                "example_id": "fbae144d-83c7-437a-8d75-81e39ed64041",
                                "sense_id": "d9b28496-a8da-35d4-b2c6-dcd330f899f9",
                                "text": "Смутить толпу."
                            }
                        ]
                    },
                    {
                        "sense_id": "7528896c-5098-3117-8332-9397a8baa912",
                        "entry_id": "1edb01d1-a3e9-3e39-87d4-273651db1e16",
                        "glosses": [
                            "устар. нарушать спокойствие кого-либо, вызывать смятение, волнение, тревогу"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "feabe6b3-4139-4335-acda-78ae66335a5a",
                                "sense_id": "7528896c-5098-3117-8332-9397a8baa912",
                                "text": "Эта страшная весть меня крайне смутила."
                            },
                            {
                                "example_id": "3211f22d-22d1-4c96-9a59-e6342be7e446",
                                "sense_id": "7528896c-5098-3117-8332-9397a8baa912",
                                "text": "Смутить чей-либо покой."
                            }
                        ]
                    },
                    {
                        "sense_id": "2ac97c90-9d43-3f18-9753-00e141f96313",
                        "entry_id": "1edb01d1-a3e9-3e39-87d4-273651db1e16",
                        "glosses": [
                            "вызывать у кого-либо чувство неловкости, приводить в замешательство"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6f021e6-f741-4ba6-9d71-c92407b9220c",
                                "sense_id": "2ac97c90-9d43-3f18-9753-00e141f96313",
                                "text": "Смутить кого-либо похвалой."
                            },
                            {
                                "example_id": "02709a3a-8e6a-402f-85f1-12d8a2a7cc5d",
                                "sense_id": "2ac97c90-9d43-3f18-9753-00e141f96313",
                                "text": "Вы меня смутили своим замечанием."
                            },
                            {
                                "example_id": "64808782-905a-4628-bb0e-9669ece50669",
                                "sense_id": "2ac97c90-9d43-3f18-9753-00e141f96313",
                                "text": "Он, признаю́сь, тогда меня смутил спокойствием."
                            }
                        ]
                    }
                ],
