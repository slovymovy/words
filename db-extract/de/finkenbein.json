                ],
                "senses": [
                    {
                        "sense_id": "9bcb0e05-45fe-3ee2-aaeb-42e6e059c89c",
                        "entry_id": "5c4cade0-e3a2-3a0f-be1d-3cc057eb0042",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "037ea96b-e9ba-4b3e-84bf-b6d841584e01",
                                "sense_id": "9bcb0e05-45fe-3ee2-aaeb-42e6e059c89c",
                                "text": "Frau Finkenbein ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ef9f637e-c5fc-4e77-8d1e-c343904535a7",
                                "sense_id": "9bcb0e05-45fe-3ee2-aaeb-42e6e059c89c",
                                "text": "Herr Finkenbein wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "768976dd-7f05-45d6-9aa0-afa7a3ca0ba7",
                                "sense_id": "9bcb0e05-45fe-3ee2-aaeb-42e6e059c89c",
                                "text": "Die Finkenbeins fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "004a3a08-f4c4-4dbc-a0ce-99d5eb5c92e9",
                                "sense_id": "9bcb0e05-45fe-3ee2-aaeb-42e6e059c89c",
                                "text": "Der Finkenbein trägt nie die Schals, die die Finkenbein ihm strickt."
                            },
                            {
                                "example_id": "c634e4f0-e644-4d0c-b596-62c8d67d5fcb",
                                "sense_id": "9bcb0e05-45fe-3ee2-aaeb-42e6e059c89c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Finkenbein kommt, geht der Herr Finkenbein.“"
                            },
                            {
                                "example_id": "f75a4e6e-ddfa-45c4-8f43-b69ec8b8cde0",
                                "sense_id": "9bcb0e05-45fe-3ee2-aaeb-42e6e059c89c",
                                "text": "Finkenbein kommt und geht."
                            },
                            {
                                "example_id": "552d62db-a2e8-448b-b1ce-ca19199cbe5f",
                                "sense_id": "9bcb0e05-45fe-3ee2-aaeb-42e6e059c89c",
                                "text": "Finkenbeins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
