                "senses": [
                    {
                        "sense_id": "2d0a2b58-4e6d-3c0b-b869-8eb0467100cf",
                        "entry_id": "02fd7c7b-248e-37f5-b72a-423c5255c8cc",
                        "glosses": [
                            "Se défendre contre un adversaire qui chope."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd1b6a14-8e91-4db6-89cd-02d4207ae33a",
                                "sense_id": "2d0a2b58-4e6d-3c0b-b869-8eb0467100cf",
                                "text": "Savoir quand choper (petit poing + petit pied en attaque) ou déchoper (petit poing + petit pied en défense) est une des stratégies fondamentales dans Street Fighter V."
                            },
                            {
                                "example_id": "cbb91b4e-de83-4690-bf62-5ec59492bc20",
                                "sense_id": "2d0a2b58-4e6d-3c0b-b869-8eb0467100cf",
                                "text": "Après 2 ou 3 fois les mecs ont tendance à comprendre et déchopent."
                            },
                            {
                                "example_id": "12fffbc7-4c5b-456f-93ba-acecad1a06f1",
                                "sense_id": "2d0a2b58-4e6d-3c0b-b869-8eb0467100cf",
                                "text": "Sans compter qu'au corps à corps les adversaires esquivent mes « triangle », bloquent mes « croix » et se déchopent quand je fais « haut+croix » (presque) systématiquement…"
                            }
                        ]
                    }
