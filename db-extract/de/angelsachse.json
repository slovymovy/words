                                "target_word": "Anglo-Saxon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8a3aa8ba-7126-3fe2-8642-7f652458fc1a",
                                        "entry_id": "c9037294-77f4-3b8d-ac2e-416d509090ab",
                                        "glosses": [
                                            "Related to the Anglo-Saxon peoples or language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39c53ca9-e083-36ba-b5f7-2bc612431838",
                                        "entry_id": "c9037294-77f4-3b8d-ac2e-416d509090ab",
                                        "glosses": [
                                            "Related to nations which speak primarily English and are influenced by English culture and customs, especially Australia, Canada, New Zealand, United Kingdom and the United States."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "795d80ce-87ad-4ba0-a8a2-4fe57a6f9483",
                                                "sense_id": "39c53ca9-e083-36ba-b5f7-2bc612431838",
                                                "text": "[...] Ethnography thus aims at record-\n ing as accurately as possible the respective modes of life of various\n groups. Ethnology, on the other hand, utilizes for comparative\n purposes (the nature of which will be explained below) the data\n provided by the ethnographer. Thus, ethnography has the same\n meaning in all countries, and ethnology corresponds approximately\n to what is known in Anglo-Saxon countries—where the term eth-\n nology has become obsolete—as social or cultural anthropology."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f4967ad-1a31-3ca2-b3f8-df23954157ad",
                                        "entry_id": "c9037294-77f4-3b8d-ac2e-416d509090ab",
                                        "glosses": [
                                            "Favouring a liberal free-market economy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
