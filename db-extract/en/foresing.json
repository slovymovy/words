                    {
                        "sense_id": "1c2e571c-2efb-3b5d-bad8-4f024dce5a3c",
                        "entry_id": "d6896dda-741b-307e-ac4e-530d61746a40",
                        "glosses": [
                            "To sing beforehand or in advance."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "86cd42d6-a915-4800-b412-2df84c131a78",
                                "sense_id": "1c2e571c-2efb-3b5d-bad8-4f024dce5a3c",
                                "text": "Jacob with the patriarchs (Himself their patriarch) through all his own Life's space the gladdest times of Christ foresang By words, act, virtue, toil."
                            },
                            {
                                "example_id": "e9d7ead4-21c1-4779-82f8-3e742b5a2863",
                                "sense_id": "1c2e571c-2efb-3b5d-bad8-4f024dce5a3c",
                                "text": "God grant that I as thou May still at heart have Spring, Still may the fair To-be feel through the niggard Now And in the Winter-night the summer-day foresing!"
                            },
                            {
                                "example_id": "620c1e1a-6b95-4e04-aba0-c7f3e227f961",
                                "sense_id": "1c2e571c-2efb-3b5d-bad8-4f024dce5a3c",
                                "text": "They whispered like the windy river-reeds In thoughts that rise far under heights of Heaven — Did they foresing to Heaven of this day ?"
                            }
                        ]
                    }
                ],
