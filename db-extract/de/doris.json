                                        "tags": [
                                            "British",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4390ea29-8bbb-481d-8e55-79883ea4ff46",
                                                "sense_id": "769f0476-41da-3775-b8e3-e30512ebede9",
                                                "text": "Fella at work, right? He's met this Doris on a park bench, at lunch time, and he's started going out on like, dates with her!"
                                            }
                                        ]
                                    }
