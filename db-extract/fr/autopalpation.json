                    {
                        "sense_id": "41a282f4-984f-3656-9a00-d0b26de17860",
                        "entry_id": "afeabb9c-4291-3223-9e48-e30d0e6a12f9",
                        "glosses": [
                            "Méthode de dépistage du cancer du sein ou du testicule consistant à palper soi-même ses seins ou testicules."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e12cd2d3-bcab-46ba-b151-2003efc19afe",
                                "sense_id": "41a282f4-984f-3656-9a00-d0b26de17860",
                                "text": "L’autopalpation du testicule restant après orchidectomie pour cancer est une alternative simple, gratuite et efficace qui doit être encouragée et développée."
                            },
                            {
                                "example_id": "5bc33183-e0f4-4b5e-be47-6fff67167439",
                                "sense_id": "41a282f4-984f-3656-9a00-d0b26de17860",
                                "text": "Cette année, l’atelier Cognacq-Jay renouvelle Yoga rose en proposant, jeudi, des séances de yoga et une formation à l’autopalpation dans sept spots de Paris et d’Île-de-France."
                            },
                            {
                                "example_id": "eac204b3-0f2e-402f-a21b-1d0a47c7403d",
                                "sense_id": "41a282f4-984f-3656-9a00-d0b26de17860",
                                "text": "Pour tout savoir sur l’autopalpation, 20 Minutes a rencontré Natacha Naoun, oncologue médicale à l’hôpital Gustave-Roussy de Villejuif (Val-de-Marne)."
                            }
                        ]
                    }
