                ],
                "senses": [
                    {
                        "sense_id": "d8a246d9-5ef0-39ec-9ef1-99ff252cf80e",
                        "entry_id": "148dda2f-e3e4-380f-aa84-1b65ad6c8bb1",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b23d7fc7-dea0-4c1b-89e7-5dda33574fe1",
                                "sense_id": "d8a246d9-5ef0-39ec-9ef1-99ff252cf80e",
                                "text": "Frau Bartsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "51567071-b809-431f-bf4a-2d7b25c82e80",
                                "sense_id": "d8a246d9-5ef0-39ec-9ef1-99ff252cf80e",
                                "text": "Herr Bartsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "107c4ee7-47c7-4b05-b620-2358f94aec7e",
                                "sense_id": "d8a246d9-5ef0-39ec-9ef1-99ff252cf80e",
                                "text": "Die Bartschs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "64db1f8a-dd43-4ce0-8579-15045e6fb902",
                                "sense_id": "d8a246d9-5ef0-39ec-9ef1-99ff252cf80e",
                                "text": "Der Bartsch trägt nie die Schals, die die Bartsch ihm strickt."
                            },
                            {
                                "example_id": "a1213085-376c-4a61-bbde-69946235ce8c",
                                "sense_id": "d8a246d9-5ef0-39ec-9ef1-99ff252cf80e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Bartsch kommt, geht der Herr Bartsch.“"
                            },
                            {
                                "example_id": "dd1a415f-44a8-4ab1-8d77-4545fc2b36c3",
                                "sense_id": "d8a246d9-5ef0-39ec-9ef1-99ff252cf80e",
                                "text": "Bartsch kommt und geht."
                            },
                            {
                                "example_id": "98cd86a3-1173-4bb6-a5a4-806c6a9bdddb",
                                "sense_id": "d8a246d9-5ef0-39ec-9ef1-99ff252cf80e",
                                "text": "Bartschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
