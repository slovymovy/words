                "entry_id": "918d7b7e-59d1-3976-9526-015da6449922",
                "word": "lissoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "921496bc-8847-48e4-8ee4-20f71a6267fa",
                        "entry_id": "918d7b7e-59d1-3976-9526-015da6449922",
                        "tags": [
                            "plural"
