                "senses": [
                    {
                        "sense_id": "071f7bc8-ec43-33d9-8696-15c3fa4366b7",
                        "entry_id": "27557493-6232-3837-9b6c-402d3a41d66a",
                        "glosses": [
                            "die Querschnittswissenschaft betreffend; in der Art einer Querschnittswissenschaft vorgehend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9f27464-ec83-406f-b8df-126f822c081f",
                                "sense_id": "071f7bc8-ec43-33d9-8696-15c3fa4366b7",
                                "text": "„Der Lebenslageansatz kann Integration einer personologisch orientierten Entwicklungspsychologie und einer querschnittswissenschaftlich ausgerichteten Wissenschaft von der Sozialpolitik fundieren helfen“"
                            },
                            {
                                "example_id": "90edabf2-5a6a-4123-aabb-be3e7af70b55",
                                "sense_id": "071f7bc8-ec43-33d9-8696-15c3fa4366b7",
                                "text": "„Dies verdeutlicht sich nicht zuletzt an den (idealiter) querschnittswissenschaftlichen Blicken in Gerontologie und Geschlechterforschung: Beide sind differentielle (Geschlechtsspezifik, Generationenstile) und zugleich in sich relationale Kategorien […].“"
                            }
