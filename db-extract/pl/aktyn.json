                                            {
                                                "example_id": "01413dcc-6630-4ab0-bc3d-353379c06751",
                                                "sense_id": "8ec67477-2416-37c8-9724-ad79afe61c0b",
                                                "text": "Actinium kommt in geringen Mengen in Uranerzen vor."
                                            },
                                            {
                                                "example_id": "9fbb8d32-cf89-4979-8970-7958e9700f07",
                                                "sense_id": "8ec67477-2416-37c8-9724-ad79afe61c0b",
