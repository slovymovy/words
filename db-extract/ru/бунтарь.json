                                "target_senses": [
                                    {
                                        "sense_id": "25891337-b37b-3e99-bfe3-15d4d0b74b9e",
                                        "entry_id": "118f1483-cbb3-3f0d-951b-72fb535cdda6",
                                        "glosses": [
                                            "A person who resists an established authority, often violently."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e51d2e5-2e4d-4f3c-8d78-2228b3adb803",
                                                "sense_id": "25891337-b37b-3e99-bfe3-15d4d0b74b9e",
                                                "text": "My little sister is such a rebel - coming home late, piercing her ears, and refusing to do any of her chores."
                                            },
                                            {
                                                "example_id": "c2ad80ea-37a3-41df-bce6-1dab58c41e71",
                                                "sense_id": "25891337-b37b-3e99-bfe3-15d4d0b74b9e",
                                                "text": "A group of rebels defied the general's orders and split off from the main army."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4962e93-8bca-3b56-a373-0e8dcae94f8a",
                                        "entry_id": "118f1483-cbb3-3f0d-951b-72fb535cdda6",
                                        "glosses": [
                                            "Synonym of Confederate: a citizen of the Confederate States of America, especially a Confederate soldier."
                                        ],
                                        "tags": [
                                            "US",
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rebel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "faead915-81f9-3530-b428-9d3e8e18008a",
                                        "entry_id": "ea3c7d82-b676-33d1-8eca-7e0fbb040d9e",
                                        "glosses": [
                                            "To resist or become defiant toward an authority."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0fcfa2af-f201-4678-8f92-9eb48a9b2579",
                                                "sense_id": "faead915-81f9-3530-b428-9d3e8e18008a",
                                                "text": "to rebel against the system"
                                            },
                                            {
                                                "example_id": "563312ca-e02a-4e56-b788-59280314be01",
                                                "sense_id": "faead915-81f9-3530-b428-9d3e8e18008a",
                                                "text": "\"Tedd's feeling a bit rebellious.\" \"I'm not rebelling! I'm self actualizing! By rebelling.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "455e65a7-b538-3d56-bd28-dfcc6de6c9ae",
                                        "entry_id": "ea3c7d82-b676-33d1-8eca-7e0fbb040d9e",
