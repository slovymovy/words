                "senses": [
                    {
                        "sense_id": "b806b118-43c8-38f8-b553-27363c605b80",
                        "entry_id": "fccf15df-9d63-3b71-ae31-4df7c356713e",
                        "glosses": [
                            "jemand, der hobbymäßig oder als Sport auf einer Slackline balanciert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82c83f65-0edc-4b45-abf0-b7d1699a2a81",
                                "sense_id": "b806b118-43c8-38f8-b553-27363c605b80",
                                "text": "In \"The Ballerina Stunt\" balanciert Slacklinerin Faith Dickey zwischen zwei Volvo FH, die auf einer Schnellstraße fahren"
                            },
                            {
                                "example_id": "93464c22-e30a-4d96-8d46-322ae9d7b96f",
                                "sense_id": "b806b118-43c8-38f8-b553-27363c605b80",
                                "text": "Elli Schulte macht Spagat, Handstand und Salti auf einem schmalen Band. Sie ist die beste deutsche Slacklinerin."
                            },
                            {
                                "example_id": "366320da-009a-4cbf-aa77-35c0372bec99",
                                "sense_id": "b806b118-43c8-38f8-b553-27363c605b80",
                                "text": "\"Das Lebensgefühl ist das Tolle\", schwärmt Slacklinerin Eva Gilch, als sie das fest gespannte Band im Englischen Garten betritt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
