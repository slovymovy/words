                                                "sense_id": "40a901c4-9e05-3ccb-a8da-15f4e37babdc",
                                                "text": "À l’ombre d’une treille."
                                            },
                                            {
                                                "example_id": "c3654ea4-b9b2-4668-bf51-0dcf6c29277c",
                                                "sense_id": "40a901c4-9e05-3ccb-a8da-15f4e37babdc",
                                                "text": "Sous la treille."
                                            },
                                            {
                                                "example_id": "27cfcee1-e3d2-42a4-881e-f7be5ece1394",
                                                "sense_id": "40a901c4-9e05-3ccb-a8da-15f4e37babdc",
                                                "text": "Les grappes qui pendent à la treille."
                                            },
                                            {
                                                "example_id": "767767aa-7a58-46e2-b1d3-fd212f21f5aa",
                                                "sense_id": "40a901c4-9e05-3ccb-a8da-15f4e37babdc",
                                                "text": "Vin de treille."
                                            },
                                            {
                                                "example_id": "af920bf9-c7db-47e0-b1b0-ce6e2ba1a2e9",
                                                "sense_id": "40a901c4-9e05-3ccb-a8da-15f4e37babdc",
                                                "text": "Les pampres tombaient un à un, sans qu’un souffle d’air agitât les treilles."
                                            }
                                        ]
                                    },
