                "senses": [
                    {
                        "sense_id": "137d8903-b6d6-3464-84b9-8d764c93a0d4",
                        "entry_id": "c41b3037-1718-3fa5-8aae-e93e33911279",
                        "glosses": [
                            "spezielle Tür zu einem Müllraum die einer Brandlast widerstehen muss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8f40505-9bb5-4ba2-a95f-4e64ff8c83f5",
                                "sense_id": "137d8903-b6d6-3464-84b9-8d764c93a0d4",
                                "text": "„Für die Müllgroßbehälter (770 und 1100 Liter) sind Müllraumtüren und Türen in Hausdurchgängen mit mindestens 1,35 m lichter Breite auszuführen (beim Einsatz von Mülltonnen bis 240 l Inhalt mindestens 1 m breite Türöffnungen).“"
                            },
                            {
                                "example_id": "cb820bb7-46a6-472e-b3a6-3fff96be2fc7",
                                "sense_id": "137d8903-b6d6-3464-84b9-8d764c93a0d4",
                                "text": "„ Müllraumtür innen T30 und Rauchdicht.“"
                            },
                            {
                                "example_id": "653f5814-3317-4a63-962d-891689a1ab41",
                                "sense_id": "137d8903-b6d6-3464-84b9-8d764c93a0d4",
                                "text": "„Auch hiermit können Müllraumtüren unproblematisch durch die Abfallwirtschaftsbetriebe geöffnet werden.“"
                            },
                            {
                                "example_id": "7ac6dc85-a66a-44bc-82e5-8915a8de7fe7",
                                "sense_id": "137d8903-b6d6-3464-84b9-8d764c93a0d4",
                                "text": "„Mit vier Rädern (zwei feststellbare) ist sie leicht zu bewegen und mit einer Breite von 77 cm passt sie bequem durch unsere 83 cm breiten Müllraumtüren.“"
                            },
                            {
                                "example_id": "915875b4-79e1-493d-89da-ca5e2ad7925b",
                                "sense_id": "137d8903-b6d6-3464-84b9-8d764c93a0d4",
                                "text": "„Die Müllraumtür (ausgeführt mit Lüftungsschlitzen) und sämtliche Türen im Kellergeschoss erfolgen als Schichtstoff oder Stahlblechtüren mit ggf. Türschließer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
