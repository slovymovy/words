                        "form": "fructified"
                    },
                    {
                        "form_id": "8ad9f4bd-6d7b-4ebb-a6c6-47431388f5da",
                        "entry_id": "a40abc6b-9662-3009-bf4f-00287b37935c",
                        "tags": [
                            "past"
                        ],
                        "form": "fructified"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f74ebf27-1d72-3165-ae05-1501d1767b8c",
                        "entry_id": "a40abc6b-9662-3009-bf4f-00287b37935c",
                        "glosses": [
                            "To bear fruit; to generate useful products or ideas."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "52e83480-0c69-40e2-8f07-d48a3ee8030f",
                                "sense_id": "f74ebf27-1d72-3165-ae05-1501d1767b8c",
                                "text": "Atop the [Palmito] tree is a pith, in taſte better then Cabbage; and eating it takes avvay the future benefit of grovvth or fructifying, theſe and the Date-tree thriue not, except the male and female be vnited, and haue copulation: the ſhe is only fruitfull."
                            },
                            {
                                "example_id": "3e768c33-1443-4b9a-ab09-7ae7bd2df12e",
                                "sense_id": "f74ebf27-1d72-3165-ae05-1501d1767b8c",
                                "text": "It is good to detect hints of a more aggressive attitude from the B.T.C. in face of constant reminders of accumulated deficits and niggling for economies before modernisation schemes have had a chance fully to fructify [...]."
                            }
                        ]
                    },
                    {
                        "sense_id": "4aa9280f-76a8-3f63-bf2d-48730f507cea",
                        "entry_id": "a40abc6b-9662-3009-bf4f-00287b37935c",
                        "glosses": [
                            "To make productive or fruitful."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "04e3f12f-aa7c-403d-8b89-b558a36827a8",
                                "sense_id": "4aa9280f-76a8-3f63-bf2d-48730f507cea",
                                "text": "When fruit trees are to be planted it is good practice to plant alternate rows of different varieties of the same fruit, because the pollen of one variety is often wanted to fructify or fertilise the flowers of another."
                            },
                            {
                                "example_id": "34a99cdf-eed5-49c5-94ad-6cae5200d37d",
                                "sense_id": "4aa9280f-76a8-3f63-bf2d-48730f507cea",
                                "text": "He slew the Bull (symbol of the gross Earth which the sunlight fructifies)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d8a48e97-e301-4c7e-bb9d-2a37b34adc1b",
                        "source_entry_id": "a40abc6b-9662-3009-bf4f-00287b37935c",
                        "source_sense_description": "to bear fruit",
                        "target_lang_word": "fructifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fructifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b13d1d3b-b6fd-311d-993b-0a26b57f2faf",
                                        "entry_id": "922f57cb-c0d7-3731-a0c7-2be090d9aa10",
                                        "glosses": [
                                            "Produire des fruits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0e755eb-4191-40d2-b2db-64dc79fec946",
                                                "sense_id": "b13d1d3b-b6fd-311d-993b-0a26b57f2faf",
                                                "text": "M. des Lourdines (…) recueillait des joies, dont une des principales consistait à faire fructifier sa terre, non dans un esprit d'intérêt, mais par amour, pour lui faire son bonheur : « On n'a, disait-il, que le plaisir qu'on donne »."
                                            },
                                            {
                                                "example_id": "5c2f8de6-95e8-4f1f-8efd-b28251f674e7",
                                                "sense_id": "b13d1d3b-b6fd-311d-993b-0a26b57f2faf",
                                                "text": "Les arbres commencent à fleurir vers 10 ans, mais ne fructifient qu’après 15 ans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4b6631b-6de9-300f-8fdb-7d6619213940",
                                        "entry_id": "922f57cb-c0d7-3731-a0c7-2be090d9aa10",
                                        "glosses": [
                                            "Produire un effet, un résultat avantageux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67adb0ad-fac2-465b-bbee-bd0bb174a0a5",
                                                "sense_id": "d4b6631b-6de9-300f-8fdb-7d6619213940",
                                                "text": "Jusqu’à ce qu’elles retrouvent ces deux moteurs, qu’elles ont perdus lorsqu’elles ont péché contre la vie, acceptant d’être les inférieures des hommes comme ceux-ci le leur demandaient, les femmes ne pourront jamais faire fructifier ces étincelles d’individualité et de vitalité qui vacillent encore en elles."
                                            },
                                            {
                                                "example_id": "36fb36ef-e1a0-4036-8386-3290a8d70f7e",
                                                "sense_id": "d4b6631b-6de9-300f-8fdb-7d6619213940",
                                                "text": "Kim Jong-un, troisième du nom, a fait fructifier cet héritage et multiplié les essais souterrains ainsi que les lancers de missiles, malgré les récentes condamnations du Conseil de sécurité de l’ONU (Russie et Chine comprises)."
                                            },
                                            {
                                                "example_id": "dc699322-0974-42c8-b967-b2306e04f863",
                                                "sense_id": "d4b6631b-6de9-300f-8fdb-7d6619213940",
                                                "text": "Dieu a béni leur travail et l’a fait fructifier."
                                            },
                                            {
                                                "example_id": "1b523f33-3489-445d-ad20-90686b90a2fa",
                                                "sense_id": "d4b6631b-6de9-300f-8fdb-7d6619213940",
                                                "text": "Faire fructifier la parole de Dieu."
                                            },
                                            {
                                                "example_id": "9d330cfd-1e55-432f-bce2-58575e0459e4",
                                                "sense_id": "d4b6631b-6de9-300f-8fdb-7d6619213940",
                                                "text": "Les bons exemples fructifient."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
