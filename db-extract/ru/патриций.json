                    {
                        "translation_id": "2bb7825a-6b90-48bb-984a-3f1fc6a37683",
                        "source_entry_id": "74e438f6-ce47-36bb-9e07-46dfa2e1a9f8",
                        "source_sense_description": "лицо, принадлежавшее к исконным римским родам, составлявшим правящий класс",
                        "target_lang_word": "Patrizier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patrizier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "313f772a-a91f-35fc-abd7-f5963d07c4d3",
                                        "entry_id": "369b6da5-82f1-3e78-b7c4-13caea3e116b",
                                        "glosses": [
                                            "Angehöriger der alteingesessenen Oberschicht im antiken Rom; altrömischer Adliger"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47f856e6-10aa-46c6-971e-ecb9001d5423",
                                                "sense_id": "313f772a-a91f-35fc-abd7-f5963d07c4d3",
                                                "text": "„Ein Patrizier namens Albinus war des Hochverrats überführt und verurteilt worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a9ad3f80-77e3-37f2-9f91-ee586a3036d4",
                                        "entry_id": "369b6da5-82f1-3e78-b7c4-13caea3e116b",
                                        "glosses": [
                                            "Bürger im Mittelalter, der wohlhabend und vornehm war"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b211497c-229e-4f10-b751-5686002dd9ea",
                                                "sense_id": "a9ad3f80-77e3-37f2-9f91-ee586a3036d4",
                                                "text": "„Wer wissen will, wie die Patrizier einst gelebt haben, der dürfte das kaum woanders besser erleben können als im Tucherschlösschen in Nürnberg.“"
                                            },
                                            {
                                                "example_id": "a15364ed-79e9-47dc-9e2f-8841a3f308d4",
                                                "sense_id": "a9ad3f80-77e3-37f2-9f91-ee586a3036d4",
                                                "text": "„Der Vater Galileis, Vincenzio (1520-91), war Florentiner und stammte aus einem Geschlecht, das schon im 14. Jahrhundert zu den Patriziern der Stadt gehörte.“"
                                            },
                                            {
                                                "example_id": "a89842c1-6853-4806-b373-60c46b9076de",
                                                "sense_id": "a9ad3f80-77e3-37f2-9f91-ee586a3036d4",
                                                "text": "„Albrecht Dürer gehörte zu den oberen Fünfhundert in Nürnberg, ein Patrizier war er nicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ddd5aa75-2bf6-4cc5-81fe-cfb9a993cb56",
                        "source_entry_id": "74e438f6-ce47-36bb-9e07-46dfa2e1a9f8",
                        "source_sense_description": "лицо, принадлежавшее к исконным римским родам, составлявшим правящий класс",
                        "target_lang_word": "patriciër",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriciër",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "95bd4230-95df-3d27-a4d8-6614e7816c53",
                                        "entry_id": "7fb3c817-66f9-3aa9-98d3-061adbc10156",
                                        "glosses": [
                                            "aanzienlijk persoon, burger, rijke koopman, regent, hoewel het niet om een adellijk persoon gaat is de persoon wel meestal afkomstig uit bepaalde families"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "253c1e10-065c-4b9b-9aba-bc1748f382d3",
                                                "sense_id": "95bd4230-95df-3d27-a4d8-6614e7816c53",
                                                "text": "‘Hij gedraagt zich als een patriciër die zichzelf presenteert als een tribuun, aanhanger van een ongegeneerd populisme.’ ‘Hij heeft minder charisma dan wijlen John Kennedy en minder principes dan oud-premier Pierre Mendès France.’"
                                            },
                                            {
                                                "example_id": "1b4f44bb-cc5d-4387-ba96-b2d451071bae",
                                                "sense_id": "95bd4230-95df-3d27-a4d8-6614e7816c53",
                                                "text": "De autobiografie is een uiteraard subjectieve maar volledig waarheidsgetrouwe en op naspeurbare feiten gebaseerde beschrijving van het leven van de onechte zoon van een Venetiaanse actrice en waarschijnlijk een patriciër, die ondanks zijn wat obscure afkomst dankzij zijn intelligentie, lef, nieuwsgierigheid, uiterlijk en aanpassingsvermogen in contact kwam met hertogen, koningen, keizerinnen en pausen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
