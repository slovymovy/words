                "senses": [
                    {
                        "sense_id": "623dff73-a40f-3843-9b54-281cd07c561b",
                        "entry_id": "4c7e19f5-c8d8-37a5-9b15-6e34f9dce3ca",
                        "glosses": [
                            "wenig belebte, unkultivierte Gegend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ec3642-b310-4b7a-9e77-2de143e6623f",
                                "sense_id": "623dff73-a40f-3843-9b54-281cd07c561b",
                                "text": "„Manchmal ist es auf diesem Teil der Strecke verlockend, in die Ödnis links oder rechts der Route 1 zu fahren, mit dem normalen Mietwagen.“"
                            },
                            {
                                "example_id": "656922ae-e4c0-4212-9047-4ec39991326d",
                                "sense_id": "623dff73-a40f-3843-9b54-281cd07c561b",
                                "text": "„Eine flotte Geheimpolizistin (Karoline Herfurth) verschafft Beat eine Ahnung davon, dass es auch ein Leben außerhalb dieser gottlosen Ödnis gibt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
