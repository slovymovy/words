                    {
                        "sense_id": "398d6477-0448-39f1-98d1-6b97c86dbd02",
                        "entry_id": "27ca1069-66c5-3a92-834a-8f96e21cd885",
                        "glosses": [
                            "In a grotesque manner; disgustingly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e8bebaa-9a36-4c95-9724-ca5d02035bcc",
                                "sense_id": "398d6477-0448-39f1-98d1-6b97c86dbd02",
                                "text": "Till the grotesquely angry scene was interrupted by the arrival of Mina, who came asking for Andrew."
                            },
                            {
                                "example_id": "89c5a493-a19d-4c68-8754-50e2c1ed6c97",
                                "sense_id": "398d6477-0448-39f1-98d1-6b97c86dbd02",
                                "text": "Anything more appalling than this jumbled mass of the remains of a departed race I cannot imagine, and what made it even more dreadful was that in this dry air a considerable number of the bodies had simply become desiccated with the skin still on them, and now, fixed in every conceivable position, stared at us out of the mountain of white bones, grotesquely horrible caricatures of humanity."
                            },
                            {
                                "example_id": "f061cee1-9e73-44d0-845f-604b6f394022",
                                "sense_id": "398d6477-0448-39f1-98d1-6b97c86dbd02",
                                "text": "Slowly, the grotesquely large lady made her way up the steps, the ladder creaking under her considerable weight."
                            }
                        ]
                    }
                ],
