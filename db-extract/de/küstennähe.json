                        "tags": [],
                        "examples": [
                            {
                                "example_id": "00e70bd3-04a7-49cc-9d3a-d65766582761",
                                "sense_id": "69e34ed5-dcc8-3d24-addc-9e9fe987cb71",
                                "text": "„Allerdings lebte in Küstennähe eine Familie namens Fraser, mit der ich gut bekannt war und in die ich großes Vertrauen hatte.“"
                            },
                            {
                                "example_id": "ea358104-9357-4e6b-992a-62a55096270f",
                                "sense_id": "69e34ed5-dcc8-3d24-addc-9e9fe987cb71",
                                "text": "„Diogenes wird Zeuge eines Schiffbruchs in Küstennähe, er springt ins Wasser, rettet eine Dame.“"
                            },
                            {
                                "example_id": "e243d945-13ae-4bd2-85bc-f81cb7524835",
                                "sense_id": "69e34ed5-dcc8-3d24-addc-9e9fe987cb71",
                                "text": "„Nab war es ganz recht, daß man vorläufig in Küstennähe bleiben wollte, wo sein Herr und Meister spurlos verschwunden war.“"
                            }
                        ],
