                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2938834b-c9b9-4c7d-b79c-ac6c1bf8b9fb",
                                "sense_id": "ab18350b-86d5-3b02-9bab-7a1d3362988b",
                                "text": "De ministerraad kwam op 23 juni bijeen om een besluit te nemen."
                            }
                        ]
                    },
                    {
                        "sense_id": "1643e0b8-dde9-388c-bee2-258841d312ba",
                        "entry_id": "161d357e-109e-36c2-8b39-a6206bc4d0d9",
