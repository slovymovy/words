                "senses": [
                    {
                        "sense_id": "b383fb1b-bde3-3d20-b77f-be2286f05388",
                        "entry_id": "1714185f-4819-3191-b03e-68cb328efab3",
                        "glosses": [
                            "Faire perdre son caractère de chef à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a139c5c-49b1-4e24-926e-1ce18dca9db4",
                                "sense_id": "b383fb1b-bde3-3d20-b77f-be2286f05388",
                                "text": "D'après mes diverses expérience, j'imagine qu'un chef de guilde qui demanderait cela à ces membres serait vite \"décheffé\""
                            }
                        ]
                    },
                    {
                        "sense_id": "5dc1519f-0475-3b9d-9bd3-fa99a27202a8",
                        "entry_id": "1714185f-4819-3191-b03e-68cb328efab3",
                        "glosses": [
                            "Enlever ce qui couvre le chef."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18695295-743c-4ab6-a85b-5bb47a0c3122",
                                "sense_id": "5dc1519f-0475-3b9d-9bd3-fa99a27202a8",
                                "text": "Le phare est décoiffé ! C’est un coup du maufait Paimpol, ah ! quels coups secs, à décheffer les fées volant ébouriffées de Bréhat-z-à Bréhec."
                            },
                            {
                                "example_id": "2b44cbe6-0ad2-4b16-9c58-5a9b3f8883e2",
                                "sense_id": "5dc1519f-0475-3b9d-9bd3-fa99a27202a8",
                                "text": "Doux sire, je n'espère pas avoir à vous décheffer trop souvent, vu ce qu'il m'en coute!"
                            }
                        ]
                    }
                ],
