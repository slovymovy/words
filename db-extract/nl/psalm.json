                    {
                        "sense_id": "099b9db8-7419-3357-9644-eb02424777a8",
                        "entry_id": "671423bb-e0ef-31de-a9b3-1211426f8ef2",
                        "glosses": [
                            "elk van honderdvijftig gezangen uit de Tenach en het Oude Testament"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6eb5c8c6-e668-4762-aaf6-ca12258dac8f",
                                "sense_id": "099b9db8-7419-3357-9644-eb02424777a8",
                                "text": "Alles draait in dienst in Baptistenkerk om het thema dankbaarheid. Of het nu het gebed, de preek, een klein toneelspel of de tekst van psalmen, gezangen en liederen, is, alles daat erom dat mensen in het leven dankbaar moeten zijn."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a09b28f5-e3a4-44b8-81b6-79164b5e7b20",
                        "source_entry_id": "671423bb-e0ef-31de-a9b3-1211426f8ef2",
                        "source_sense_id": "099b9db8-7419-3357-9644-eb02424777a8",
                        "source_sense_description": "elk van honderdvijftig gezangen uit de Tenach en het Oude Testament",
                        "target_lang_word": "Psalm",
