                                                "sense_id": "9fabc065-3d9a-3c73-9936-55f8350575a4",
                                                "text": "My favorite was the simplest: alfajor, a double-deck Peruvian cookie, spread with a layer of caramel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
