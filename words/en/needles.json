                    "sense_id": "de5f574f-32b5-3d33-ab63-8f53ebaf2002",
                    "sense_definition": "plural of <w>needle</w>",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a pack of sewing <w>needles</w> to repair her torn coat.",
                            "target_lang_translations": {
