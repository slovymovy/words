                ],
                "senses": [
                    {
                        "sense_id": "eaa7fcbb-a39a-3dd7-bb70-c40bf5f0eea9",
                        "entry_id": "9fade96a-2127-3308-a0c4-2951457903b2",
                        "glosses": [
                            "Antrieb, Bedürfnis, Impuls zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54c0e210-38ed-460d-bc43-734a0f208a28",
                                "sense_id": "eaa7fcbb-a39a-3dd7-bb70-c40bf5f0eea9",
                                "text": "„Die Motivationsforschung hat zu ergründen versucht, welche Faktoren diese Spannung begründen und aufrechterhalten und wie die Spielmotivation mit anderen Motivationen, dem Neugierverhalten und der Lern- und Leistungsmotivation, zusammenhängen.“"
                            },
                            {
                                "example_id": "b25c9276-2cf4-44cd-af79-35e6589c8815",
                                "sense_id": "eaa7fcbb-a39a-3dd7-bb70-c40bf5f0eea9",
                                "text": "„Das Spiel ist keine produktive Tätigkeit, die Spielmotivation gründet sich nicht auf dem erstrebenswerten Ergebnis einer Handlung, sondern liegt im Prozess selbst.“"
                            },
                            {
                                "example_id": "468bd247-7f8d-4612-9438-5aec339d14f8",
                                "sense_id": "eaa7fcbb-a39a-3dd7-bb70-c40bf5f0eea9",
                                "text": "„Der verinnerlichte Mensch wird mit dieser Vorstellung in seiner Spielmotivation nicht erfasst.“"
                            },
                            {
                                "example_id": "75fccf71-718c-4ede-ad0c-f32acf415f18",
                                "sense_id": "eaa7fcbb-a39a-3dd7-bb70-c40bf5f0eea9",
                                "text": "„Das Unternehmen Google ist voll von diesen Spielmotivationen.“"
                            },
                            {
                                "example_id": "06c54236-11b4-40bb-89cd-225ca0f91579",
                                "sense_id": "eaa7fcbb-a39a-3dd7-bb70-c40bf5f0eea9",
                                "text": "„Sie kommt zu dem Ergebnis, daß für intensives Spielen nicht etwa Kontrollmangel, sondern eine erhöhte positive Spielmotivation verantwortlich sei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
