                "senses": [
                    {
                        "sense_id": "334fdfe8-7440-3778-bb6b-9276016ec241",
                        "entry_id": "ad9c46c3-47e3-3fad-884d-af773339122c",
                        "glosses": [
                            "Kinderstreich, bei dem man an einer Haustür klingelt und dann wegrennt beziehungsweise sich versteckt, um die Reaktion der hereingelegten Person zu beobachten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ec62398-a7d2-4a5c-94b4-c64ea5c4a609",
                                "sense_id": "334fdfe8-7440-3778-bb6b-9276016ec241",
                                "text": "Um einen Klingelstreich effektiver zu gestalten, besteht die Möglichkeit, eine Türklingel beispielsweise mit Klebeband oder einem Streichholz zu fixieren, nachdem sie gedrückt wurde."
                            }
                        ],
                        "sense_index_json": "\"1\""
