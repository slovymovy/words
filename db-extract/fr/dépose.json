                "senses": [
                    {
                        "sense_id": "dce450f6-85ea-3981-a54f-922052518a48",
                        "entry_id": "b3951a4d-e252-3ec8-98da-76593edb2d76",
                        "glosses": [
                            "Action d’enlever ce qui était posé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7dd6222-ce63-4803-b91d-404f6b45594a",
                                "sense_id": "dce450f6-85ea-3981-a54f-922052518a48",
                                "text": "Les travaux neufs de pose et de dépose des conduites seront également payés au mètre courant suivant les divers prix du bordereau et sans qu’il puisse être compté sous aucun prétexte d’autre plus-value que celles qui sont prévues audit bordereau."
                            },
                            {
                                "example_id": "cd4a40c1-903b-4b3c-b7c2-a75a49b2d69f",
                                "sense_id": "dce450f6-85ea-3981-a54f-922052518a48",
                                "text": "Ce fut une question pratique qui entraîna sa dépose: son plomb fatiguait outre mesure la charpente."
                            },
                            {
                                "example_id": "0c110f24-72f7-4596-8091-b208f26752b2",
                                "sense_id": "dce450f6-85ea-3981-a54f-922052518a48",
                                "text": "La dépose d’un tapis, d’un rideau, d’un store."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8045970-3061-37e6-bd2f-edf9f3cf6c19",
                        "entry_id": "b3951a4d-e252-3ec8-98da-76593edb2d76",
                        "glosses": [
                            "Fait de déposer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc947638-ca18-4146-bec9-0abaadb91454",
                                "sense_id": "c8045970-3061-37e6-bd2f-edf9f3cf6c19",
                                "text": "C'est un mode de dépose des élèves qui correspond à une attente de la part de certaines familles, affirme le directeur de l’établissement, Yann Denimal."
                            }
                        ]
                    }
