                    "sense_definition": "Страна, имеющая своё правительство, независимость и определённую территорию.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это маленькое <w>государство</w> находится в центре Европы.",
                            "target_lang_translations": {
                                "en": "This small <w>state</w> is located in the center of Europe.",
                                "es": "Este pequeño <w>Estado</w> se encuentra en el centro de Europa.",
                                "fr": "Ce petit <w>État</w> se trouve au centre de l'Europe."
                            }
                        },
                        {
                            "text": "Мы пересекли границу соседнего <w>государства</w> на машине.",
                            "target_lang_translations": {
                                "en": "We crossed the border of the neighboring <w>state</w> by car.",
                                "es": "Cruzamos la frontera del <w>país</w> vecino en coche.",
                                "fr": "Nous avons traversé la frontière de l'<w>État</w> voisin en voiture."
                            }
                        }
                    ],
