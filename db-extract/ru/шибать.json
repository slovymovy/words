                ],
                "senses": [
                    {
                        "sense_id": "0a50ab78-dbf2-33ce-b71b-8953d8d69201",
                        "entry_id": "08d6b077-c500-3e80-af4f-a38676390cd6",
                        "glosses": [
                            "прост. наносить удары, ударять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89c2ebbf-3910-413d-8cf7-13ed5aafc0c5",
                                "sense_id": "0a50ab78-dbf2-33ce-b71b-8953d8d69201",
                                "text": "Сперва на деревья лазила за бананами, потом палкой их стала шибать, а уж опосля и камень в руки взяла…"
                            },
                            {
                                "example_id": "e196f320-062c-4d8a-b542-65c8c7217cae",
                                "sense_id": "0a50ab78-dbf2-33ce-b71b-8953d8d69201",
                                "text": "Да это машина твоя, Игорь, током шибает!"
                            }
                        ]
                    },
                    {
                        "sense_id": "53471846-1eed-39cf-accf-d2466e01c466",
                        "entry_id": "08d6b077-c500-3e80-af4f-a38676390cd6",
                        "glosses": [
                            "разг., с особой силой действовать на обоняние (о запахе, вине и т. п.)."
                        ],
                        "tags": [
                            "обычно в сочетании со словами: «в нос», «в голову» и т. п."
                        ],
                        "examples": [
                            {
                                "example_id": "8f9871cb-c78d-4090-bf6d-61adee01d2f8",
                                "sense_id": "53471846-1eed-39cf-accf-d2466e01c466",
                                "text": "Шибает от тебя водочкой. Должно, выпил вчера на радостях?"
                            },
                            {
                                "example_id": "cf88c5d8-48a3-4db4-8809-984798f3467d",
                                "sense_id": "53471846-1eed-39cf-accf-d2466e01c466",
                                "text": "Кислые щи и в нос шибают, и хмель вышибают!"
                            }
                        ]
                    },
                    {
                        "sense_id": "40bf50fe-d86d-3960-bd00-19c5233baa00",
                        "entry_id": "08d6b077-c500-3e80-af4f-a38676390cd6",
                        "glosses": [
                            "разг. бросать, кидать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9da6ea68-c65a-426e-88fa-4cba3db2709c",
                                "sense_id": "40bf50fe-d86d-3960-bd00-19c5233baa00",
                                "text": "Леший царь елки и сосны из земли с корнем выхватывал и в водяного царя шибал"
                            },
                            {
                                "example_id": "c1c4cafa-7eb6-490d-a8d0-f43b8a5e4be0",
                                "sense_id": "40bf50fe-d86d-3960-bd00-19c5233baa00",
                                "text": "А ты, Максим, конский хвост увидишь ― и то в жар тебя шибает!"
                            }
                        ]
                    }
                ],
