                        "examples": [
                            {
                                "example_id": "fc4434cd-260f-41e0-a0b1-9f51eae746e5",
                                "sense_id": "552feccb-9946-3269-8618-9d13cf67fbea",
                                "text": "Mogelijke opties zijn toeritdosering, het verlengen van een weefvak en het volledig ontvlechten van de kruisende verkeersbanen bij de knooppunten."
                            },
                            {
                                "example_id": "29ec1539-da18-4f00-9772-f71f7df1f5b7",
                                "sense_id": "552feccb-9946-3269-8618-9d13cf67fbea",
                                "text": "Senior Roijé moet een voorstel doen om de familietoko te ontvlechten. Het geding wordt tot half januari aangehouden."
                            }
                        ]
                    }
