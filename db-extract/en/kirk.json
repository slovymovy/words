                "senses": [
                    {
                        "sense_id": "2cdc77a3-c684-32d0-a854-e8328a7d46b7",
                        "entry_id": "044bec4f-3854-311d-bbaf-593ed4c32a11",
                        "glosses": [
                            "A church."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "7b1ba8b2-9e11-48b5-9881-18cfa3a0e33a",
                                "sense_id": "2cdc77a3-c684-32d0-a854-e8328a7d46b7",
                                "text": "When she sang in the kirk, folk have told me that they had a foretaste of the musick of the New Jerusalem, and when she came in by the village of Caulds old men stottered to their doors to look at her."
                            },
                            {
                                "example_id": "f48588cd-574d-45e7-9d0a-ab6fae07e3b7",
                                "sense_id": "2cdc77a3-c684-32d0-a854-e8328a7d46b7",
                                "text": "But long, long ago an enthusiastic reporter called it a \"fairy palace,\" and the office building on the west side was once a church. Hence, in North British phraseology, to \"gang tae the Kirk\" meant to be had up on the carpet."
                            }
                        ]
                    }
                ],
