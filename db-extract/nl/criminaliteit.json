                ],
                "translations": [
                    {
                        "translation_id": "f0ccce4a-5f36-48fc-9489-d690efac178e",
                        "source_entry_id": "3e74ed07-b3e2-3565-9026-352517255caa",
                        "source_sense_id": "1568c83e-19ff-3e34-8829-6c0853cc482c",
                        "source_sense_description": "de misdadigheid, het begaan van misdaden",
