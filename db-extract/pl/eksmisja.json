                                                "example_id": "2a6a4951-fb98-4958-8a2e-1cb65bb71a43",
                                                "sense_id": "90d68113-ca4a-3070-a787-832154309a14",
                                                "text": "Nachdem die Mieterin ein Jahr lang keine Miete gezahlt hatte, kam es nun zur Zwangsräumung."
                                            }
