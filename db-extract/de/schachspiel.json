                                        "entry_id": "18e5f810-b513-355d-9d27-6d7ed4a34e74",
                                        "glosses": [
                                            "A board game for two players, each beginning with sixteen chess pieces moving according to fixed rules across a chessboard with the objective to checkmate the opposing king."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae7b0a29-876c-4111-bdaa-01c93f744781",
                                                "sense_id": "4b3ccfa2-5933-3b88-a7ec-fd6105871876",
                                                "text": "At the tender age of 20, Penguingm1 is already one of the best hyperbullet and ultrabullet chess players in the world."
