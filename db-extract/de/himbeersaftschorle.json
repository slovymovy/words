                ],
                "senses": [
                    {
                        "sense_id": "605494db-971e-3867-92f3-e152b2e83a6c",
                        "entry_id": "26f57d00-af47-3333-8e37-db0aa9b7b10a",
                        "glosses": [
                            "Mischgetränk aus Himbeersaft und Mineralwasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "095e73fd-edcf-4072-b285-9a36b7bc624e",
                                "sense_id": "605494db-971e-3867-92f3-e152b2e83a6c",
                                "text": "„Sie sangen und lachten und tranken Himbeersaftschorle.“"
                            },
                            {
                                "example_id": "39c6e299-cdaa-4d48-b0a1-a53485edb7d2",
                                "sense_id": "605494db-971e-3867-92f3-e152b2e83a6c",
                                "text": "„Wir anderen haben auch unsere Gläser gehoben, für Louisa und mich hatte Mama Himbeersaftschorle gemacht, und dann haben wir alle angestoßen und es hat leise geklirrt wie tausend kleine Glöckchen.“"
                            },
                            {
                                "example_id": "66c32884-9e6b-4da2-a2dc-500a9da800a5",
                                "sense_id": "605494db-971e-3867-92f3-e152b2e83a6c",
                                "text": "„Tja, in Anbetracht der gegenwärtigen Umstände könnten wir vielleicht mit einer leckeren Himbeersaftschorle Brüderschaft trinken?“"
                            },
                            {
                                "example_id": "696416c3-63d8-4a4d-b37b-b1511540eada",
                                "sense_id": "605494db-971e-3867-92f3-e152b2e83a6c",
                                "text": "„Die Toten frieren nicht mehr, die leben nah bei der Sonne, sie kriegen jeden Tag ein Essen gratis und ein Wasser dazu oder eine Himbeersaftschorle, und in der Nacht haben sie ganz leichte Träume.“"
                            },
                            {
                                "example_id": "96719e3b-9cf8-43e7-a237-1a7480b2e3a8",
                                "sense_id": "605494db-971e-3867-92f3-e152b2e83a6c",
                                "text": "„»Ach ja, eine rauchende Himbeersaftschorle bitte. Oder – lieber gleich zwei.« Vincent hatte keine Ahnung, warum rauchende Himbeersaftschorle rauchte, aber er konnte nicht genug davon bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
