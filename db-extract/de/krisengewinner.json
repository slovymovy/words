                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24343581-7708-4a0f-8423-2a7f45b59b4f",
                                "sense_id": "3d92fc8b-2595-3de8-892d-faa8b8e68230",
                                "text": "„Er erwarte sich von der EU-Ratspräsidentschaft, die Deutschland in wenigen Tagen übernimmt, dass solche Krisengewinner besteuert würden. Müller betonte außerdem, er unterstütze Bundesfinanzminister Scholz darin, eine Transaktionssteuer in Europa umzusetzen.“"
                            }
