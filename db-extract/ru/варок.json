                                "target_senses": [
                                    {
                                        "sense_id": "040f3609-93fc-39c1-833a-6424306553e7",
                                        "entry_id": "cece768a-e7de-3048-97e1-fec21d1fe4b9",
                                        "glosses": [
                                            "An enclosure (enclosed area) used to contain domesticated animals, especially sheep or cattle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88b25538-a34f-4c08-a2cb-e4b421617358",
                                                "sense_id": "040f3609-93fc-39c1-833a-6424306553e7",
                                                "text": "There are two steers in the third pen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77ee66d3-6519-3f77-8e3e-3bf405cfa257",
                                        "entry_id": "cece768a-e7de-3048-97e1-fec21d1fe4b9",
                                        "glosses": [
                                            "A penitentiary, i.e. a state or federal prison for convicted felons."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1357154f-b414-4ade-8df1-35b37cdabe63",
                                                "sense_id": "77ee66d3-6519-3f77-8e3e-3bf405cfa257",
                                                "text": "They caught him with a stolen horse, and he wound up in the pen again."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ac0dd39-b346-3e51-a8a2-7818ca6fa41c",
                                        "entry_id": "cece768a-e7de-3048-97e1-fec21d1fe4b9",
                                        "glosses": [
                                            "The bullpen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8358eeca-b6ab-492d-8b8f-e5905b8191f3",
                                                "sense_id": "6ac0dd39-b346-3e51-a8a2-7818ca6fa41c",
                                                "text": "Two righties are up in the pen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d57fd79f-6725-33b6-a562-0610e4ef280d",
                                        "entry_id": "8e22e324-9460-32cc-ab67-8ca9a629e7d9",
                                        "glosses": [
                                            "To enclose in a pen."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f1804a9-5bb8-4855-9779-034403826415",
                                                "sense_id": "d57fd79f-6725-33b6-a562-0610e4ef280d",
                                                "text": "Watching where shepherds pen their flocks at eve."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12f75f7e-eff9-32aa-a843-799e8abed42b",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "A tool, originally made from a feather but now usually a small tubular instrument, containing ink used to write or make marks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdf2fe6d-ab0d-4e79-801c-910de989f614",
                                                "sense_id": "12f75f7e-eff9-32aa-a843-799e8abed42b",
                                                "text": "He took notes with a pen."
                                            },
                                            {
                                                "example_id": "e5c9d030-7d93-4790-a392-88454e3f9749",
                                                "sense_id": "12f75f7e-eff9-32aa-a843-799e8abed42b",
                                                "text": "Please use a pen, not a pencil, when filling out this form. Use black or blue ink only."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f25bd60-59ed-3959-b8a5-6372c17df252",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "A writer, or their style."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "031f4c05-9552-461e-a585-6e9766d550dd",
                                                "sense_id": "8f25bd60-59ed-3959-b8a5-6372c17df252",
                                                "text": "He has a sharp pen."
                                            },
                                            {
                                                "example_id": "76905466-c1f8-4c2c-9cf0-36f1d88e1cea",
                                                "sense_id": "8f25bd60-59ed-3959-b8a5-6372c17df252",
                                                "text": "those learned pens"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "739cc2c7-711a-38da-aed4-11c494fbe243",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "Marks of ink left by a pen."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c39a480e-283c-468a-8482-822a1d86603e",
                                                "sense_id": "739cc2c7-711a-38da-aed4-11c494fbe243",
                                                "text": "He's unhappy because he got pen on his new shirt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8ea99a7-f45e-3548-9820-4f6010b023bc",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "A light pen."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "848b6975-7033-3515-8c70-77846935f961",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "The internal cartilage skeleton of a squid, shaped like a pen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ba2743ed-4a4c-4f2a-b29b-4cb06d6a5f3f",
                                                "sense_id": "848b6975-7033-3515-8c70-77846935f961",
                                                "text": "A pen is nothing more complex than a decalcified shell, so one mutation of the genes that controlled calcification could be all it took."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78789291-8a0b-38bb-8913-067b9f8c28c6",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "A feather, especially one of the flight feathers of a bird, angel etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "dialectal",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7673314-c99a-4295-acfa-525b8d17f4e6",
                                                "sense_id": "78789291-8a0b-38bb-8913-067b9f8c28c6",
                                                "text": "And eke the pennes, that did his pineons bynd,\n Were like mayne-yards, with flying canuas lynd,\n With which whenas him liſt the ayre to beat […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e9ac6eee-496a-347b-9445-004bd8932541",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "A wing."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd81f76e-92c5-424b-9b79-23f22d5c733e",
                                                "sense_id": "e9ac6eee-496a-347b-9445-004bd8932541",
                                                "text": "but feather'd soon and fledge\nThey summed their pens, and soaring the air sublime"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b9a7d57-6350-31de-8fb8-f55d31674faa",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "A syringe-like device for injecting a dose of medication such as insulin or epinephrine. (See Injector pen.)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e3fb196-65a4-4d97-9b86-ec97a484a20a",
                                                "sense_id": "8b9a7d57-6350-31de-8fb8-f55d31674faa",
                                                "text": "\"I'm sure she had more than one EpiPen […]\" \"But she didn't have one when she got stung or she'd have used it.\" By all appearances, Mariah died in the woods, […] If she managed to grab the pen found under her leg from her bag or pocket, she never discharged it. But Crystal doesn't have these details. \"Doesn't it make sense that she kept an extra pen in her cupboard, and one in her bag? The extra pen fell out, is all.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31f0cc40-4aaa-3960-8901-36f77fd45207",
                                        "entry_id": "0a94df61-3283-31ad-b97d-b520c46e80f9",
                                        "glosses": [
                                            "Ellipsis of vapor pen (“electronic cigarette”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ed365ce-31a0-4af2-aee1-403c82190444",
                                                "sense_id": "31f0cc40-4aaa-3960-8901-36f77fd45207",
                                                "text": "a dab pen; a wax pen"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da02682e-b03d-3527-993e-cc1ee15a0441",
                                        "entry_id": "84f62533-39ae-3881-ae49-ea01276fbbd0",
                                        "glosses": [
                                            "To write (an article, a book, etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20d4b269-ef28-4a67-8898-be712539b97a",
                                                "sense_id": "da02682e-b03d-3527-993e-cc1ee15a0441",
                                                "text": "Prying open the crate, you discover a carefully wrapped, handwritten copy of one of Matriarch Dilinaga's treatises. It is unlikely she penned it herself, but the flowing brushwork and intricate watercolor illustrations clearly show the hand of a master scribe."
                                            },
                                            {
                                                "example_id": "86120037-9fde-4cb3-92a4-9954445559fb",
                                                "sense_id": "da02682e-b03d-3527-993e-cc1ee15a0441",
                                                "text": "His two most recent films are last year's Greyhound, a Hanks-penned World War Two thriller in which he plays a naval commander, and now News of the World, a Western set in the years immediately following the close of the US Civil War, directed by Paul Greengrass, which is premiering around the world on Netflix tomorrow."
                                            },
                                            {
                                                "example_id": "5506a4db-7e31-4f0a-a8e6-e6459dd9bf94",
                                                "sense_id": "da02682e-b03d-3527-993e-cc1ee15a0441",
                                                "text": "It was in this era, too, that author and Scotland the Brave songwriter Cliff Hanley penned The Glasgow Underground, a tongue-in-cheek love letter to the Subway in song."
                                            }
                                        ]
                                    }
                                ]
                            },
