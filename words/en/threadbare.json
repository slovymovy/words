{
    "word_family": [
        "thread"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0409130a-1d7e-3b59-8041-66062d988f4b",
                    "sense_definition": "Of fabric or clothing, worn so thin that the individual threads are visible.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wore a <w>threadbare</w> coat that had seen better days.",
                            "target_lang_translations": {
                                "cs": "Měl na sobě <w>prodřený</w> kabát, který už zažil lepší časy."
                            }
                        },
                        {
                            "text": "The old rug in the hallway was completely <w>threadbare</w> after years of use.",
                            "target_lang_translations": {
                                "cs": "Starý koberec v předsíni byl po letech používání úplně <w>ošoupaný</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "frayed",
                        "shabby",
                        "worn-out"
                    ],
                    "common_phrases": [
                        "threadbare coat",
                        "threadbare rug"
                    ],
                    "target_lang_definitions": {
                        "cs": "O látce nebo oblečení: tak obnošené, že jsou vidět jednotlivá vlákna, prodřený."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prodřený",
                                "target_lang_sense_clarification": "o látce, která je na povrchu poškozená používáním"
                            },
                            {
                                "target_lang_word": "obnošený",
                                "target_lang_sense_clarification": "o oblečení, které je dlouhým nošením opotřebované"
                            },
                            {
                                "target_lang_word": "ošoupaný",
                                "target_lang_sense_clarification": "o povrchu nebo látce, která ztratila svou původní kvalitu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "21e898cc-aafd-39c2-a31f-4e3953b8f44d",
                    "sense_definition": "Of an idea or argument, used so often that it has lost its effectiveness or interest.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "worn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician relied on a <w>threadbare</w> excuse to explain his absence.",
                            "target_lang_translations": {
                                "cs": "Politik se spoléhal na <w>ohranou</w> výmluvu, aby vysvětlil svou nepřítomnost."
                            }
                        },
                        {
                            "text": "His <w>threadbare</w> argument failed to convince the skeptical audience.",
                            "target_lang_translations": {
                                "cs": "Jeho <w>otřepaný</w> argument skeptické publikum nepřesvědčil."
                            }
                        }
                    ],
                    "synonyms": [
                        "hackneyed",
                        "trite",
                        "clichéd",
                        "stale"
                    ],
                    "antonyms": [
                        "fresh"
                    ],
                    "common_phrases": [
                        "threadbare argument",
                        "threadbare excuse"
                    ],
                    "target_lang_definitions": {
                        "cs": "O myšlence nebo argumentu: tak často používaný, že ztratil svou účinnost nebo zajímavost, ohraný."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ohraný",
                                "target_lang_sense_clarification": "o argumentu nebo výmluvě, která je příliš častá a neúčinná"
                            },
                            {
                                "target_lang_word": "otřepaný",
                                "target_lang_sense_clarification": "o myšlence nebo frázi, která ztratila svou novost"
                            },
                            {
                                "target_lang_word": "klišovitý",
                                "target_lang_sense_clarification": "o argumentu, který postrádá originalitu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}