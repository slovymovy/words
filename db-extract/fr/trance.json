                "forms": [
                    {
                        "form_id": "0402de7b-d4f3-4b38-a53a-90174dcc2709",
                        "entry_id": "45ad69bc-7b85-35b6-a7c6-f6f9fab732a6",
                        "tags": [
                            "plural"
                        ],
                        "form": "trances"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69620de5-3828-3053-9937-926bbe5f5ee7",
                        "entry_id": "45ad69bc-7b85-35b6-a7c6-f6f9fab732a6",
                        "glosses": [
                            "Musique électronique ayant émergé en Allemagne dans les années 1990 qui permet d’atteindre un état de transe qui se caractérise par une recherche systématique de lignes mélodiques répétitives et planantes obtenues harmoniquement et par l’utilisation de filtres dont les fréquences de coupure varient dans le temps."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "96275f98-2c38-4b81-b494-5c26d602f2ec",
                                "sense_id": "69620de5-3828-3053-9937-926bbe5f5ee7",
                                "text": "Vers 1990, à Goa, en Inde, un mouvement underground se développe pour donner naissance à ce que l’on appellera la trance psychédélique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c407dc40-230b-4c52-82d3-10af341abd07",
                        "source_entry_id": "45ad69bc-7b85-35b6-a7c6-f6f9fab732a6",
                        "source_sense_id": "69620de5-3828-3053-9937-926bbe5f5ee7",
                        "target_lang_word": "Trance",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trance",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4747dcb4-2188-35f3-ac01-5f902c3e2a79",
                                        "entry_id": "b0fd872b-5a1c-37c5-bb70-09b059fa7768",
                                        "glosses": [
                                            "(durch Hypnose, Suggestion, Drogen, religiöser Ekstase oder dergleichen herbeigeführter) veränderter Bewusstseinszustand, der einhergeht mit einer Bewusstseinstrübung (Einschränkung der freien Willensbestimmung und einer ungenauen Wahrnehmung der Umwelt) und dem eines Dämmerzustands ähnelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e93d491-fc15-482d-afdd-7b3e10a77fd6",
                                                "sense_id": "4747dcb4-2188-35f3-ac01-5f902c3e2a79",
                                                "text": "Viele Drogen versetzen den Konsumenten in eine Trance."
                                            },
                                            {
                                                "example_id": "70272431-1c53-4df2-bbbb-3ed3225b02a7",
                                                "sense_id": "4747dcb4-2188-35f3-ac01-5f902c3e2a79",
                                                "text": "Wir haben uns in eine Trance getanzt."
                                            },
                                            {
                                                "example_id": "6a015bc5-8e77-484a-b96f-404af73676fe",
                                                "sense_id": "4747dcb4-2188-35f3-ac01-5f902c3e2a79",
                                                "text": "„Er war ein wandelndes Lexikon, und am Ende der Stunde wachte er wie aus einer Trance auf und wunderte sich, wie schnell die Zeit verflogen war.“"
                                            },
                                            {
                                                "example_id": "6450509c-e4a7-4b68-966f-2b9f97f8cffd",
                                                "sense_id": "4747dcb4-2188-35f3-ac01-5f902c3e2a79",
                                                "text": "„Die Schlagzeuger spielten in der völligen Selbstvergessenheit eines Rituals und suchten ihre eigenen Trancen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d23de98c-bace-3972-be1d-f3daf28b1f36",
                                        "entry_id": "b0fd872b-5a1c-37c5-bb70-09b059fa7768",
                                        "glosses": [
                                            "Dämmerzustand zwischen Wachsein und Schlaf"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52b8589c-dea5-4708-920a-505b4ffc9d96",
                                                "sense_id": "d23de98c-bace-3972-be1d-f3daf28b1f36",
                                                "text": "„Im täglichen Leben aber führten meine Beobachtungssysteme und all meine anderen seltsamen Spleens dazu, dass ich viel Zeit wie in Trance herumsitzend oder -liegend verbrachte, in Gedanken versunken, nur mit mir selbst beschäftigt.“"
                                            },
                                            {
                                                "example_id": "73b21ffd-86d3-4e76-968e-7eee263e4cd4",
                                                "sense_id": "d23de98c-bace-3972-be1d-f3daf28b1f36",
                                                "text": "„In der Bar kreischte der Fernseher weiter, Heide kam vorbei wie in Trance und erkannte oder beachtete uns nicht oder verachtete uns, ging in die Bar und holte ein paar Dosen Bier.“"
                                            },
                                            {
                                                "example_id": "4be70619-d932-42a0-8866-699a4c292bb0",
                                                "sense_id": "d23de98c-bace-3972-be1d-f3daf28b1f36",
                                                "text": "„Leskov verließ das Schiff wie in Trance und blieb nach wenigen Schritten wieder stehen.“"
                                            },
                                            {
                                                "example_id": "1db73a01-856f-49d4-ad1a-7619d8f7c0b2",
                                                "sense_id": "d23de98c-bace-3972-be1d-f3daf28b1f36",
                                                "text": "„Wie in Trance war sie zu ihrem Putzeimer gegangen und hatte den Aufnehmer ins Wasser getaucht, um die Gaststube fertig zu putzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
