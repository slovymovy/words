                        "entry_id": "b86bfdc4-231f-3483-9011-8c5e45cecefb",
                        "glosses": [
                            "Musicien ou musicienne qui maîtrise les règles de l’harmonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "430a9b8e-8e28-441e-8959-c6a2762d9904",
                                "sense_id": "8988176b-15ed-39c0-b74c-0036597831b6",
                                "text": "Ce compositeur est un bon harmoniste."
                            },
                            {
                                "example_id": "3a3dc935-918c-45f4-b37b-2d2e7a98f8bb",
                                "sense_id": "8988176b-15ed-39c0-b74c-0036597831b6",
                                "text": "« M. Firmin Richard est un musicien très distingué. Harmoniste habile, contrepointiste savant, la grandeur est le principal caractère de sa composition. »"
                            },
                            {
                                "example_id": "dc2d7080-dce2-4daa-b2d1-e9a03be4afe9",
                                "sense_id": "8988176b-15ed-39c0-b74c-0036597831b6",
                                "text": "Sans la pratique du contrepoint, l’auteur du Fils des étoiles fût resté un harmoniste voluptueux."
                            }
                        ]
                    },
                    {
                        "sense_id": "c877ce02-9e58-3f5f-a7e0-1422b10f019a",
                        "entry_id": "b86bfdc4-231f-3483-9011-8c5e45cecefb",
                        "glosses": [
                            "Peintre ayant le sens de l’harmonie dans l’agencement des couleurs."
                        ],
