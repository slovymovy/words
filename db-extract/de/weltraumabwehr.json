                "senses": [
                    {
                        "sense_id": "0b921650-6293-356b-9d09-411e220bc43e",
                        "entry_id": "8c2e4ddd-1f8f-3a7d-ac29-626a94add820",
                        "glosses": [
                            "Maßnahme zur Verhinderung von Angriffen aus dem Weltall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ebb5c45-7fd9-4680-91b2-029d00aee775",
                                "sense_id": "0b921650-6293-356b-9d09-411e220bc43e",
                                "text": "„Die Sowjets scheuen die immensen Kosten, die eine Nachrüstung für den von Reagan beschworenen »Krieg der Sterne« verursachen würde - zumal wenn die USA die Weltraumabwehr nicht nur auf ihr eigenes Territorium begrenzen, sondern auch die Europäer vom Sinn eines solchen Schutzschirms überzeugen sollten.“"
                            },
                            {
                                "example_id": "9c37cecf-8bad-4c62-86e1-e0c34276572e",
                                "sense_id": "0b921650-6293-356b-9d09-411e220bc43e",
                                "text": "„Die Verteidigungsminister der Nato beschließen eine Weltraumabwehr.“"
                            },
                            {
                                "example_id": "292ddd51-6dae-48be-9dc1-8b3a02c733dc",
                                "sense_id": "0b921650-6293-356b-9d09-411e220bc43e",
                                "text": "„Auch durch eine Weltraumabwehr kann nicht ausgeschlossen werden, daß das nukleare Material der Sprengköpfe in die Atmosphäre eindringt und dort verteilt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
