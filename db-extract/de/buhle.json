                ],
                "senses": [
                    {
                        "sense_id": "785938a0-4909-3261-936b-780b826c5b99",
                        "entry_id": "275b4c5c-21ef-3ef0-90ac-7e7471e75011",
                        "glosses": [
                            "Geliebter"
                        ],
                        "tags": [
                            "gehoben",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "de4bf326-be32-47ce-bcc2-fdeae7e5dfb0",
                                "sense_id": "785938a0-4909-3261-936b-780b826c5b99",
                                "text": "Sie hat sich doch tatsächlich einen Grafen zum Buhlen genommen."
                            },
                            {
                                "example_id": "cf509fa3-dd9c-4217-9b1c-5d706b19e0e5",
                                "sense_id": "785938a0-4909-3261-936b-780b826c5b99",
                                "text": "„Es interessiert mich nur mäßig, Namen und Titel von Fräulein Lindenthals Buhlen zu erfahren.“, sagte er, ohne Miklas eines Blickes zu würdigen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "740d1c7b-b950-468a-8ff5-a34b92b2ac70",
                        "source_entry_id": "275b4c5c-21ef-3ef0-90ac-7e7471e75011",
                        "source_sense_id": "785938a0-4909-3261-936b-780b826c5b99",
                        "source_sense_description": "gehoben, veraltet: Geliebter",
                        "target_lang_word": "amant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ad346727-cca1-3dbd-83e2-d5931e71097c",
                                        "entry_id": "82f12320-a09d-356f-8b1b-631d4cc8ab72",
                                        "glosses": [
                                            "ou Celui qui a de l’amour pour une autre personne."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44ad0c2e-f1d6-496f-bfbf-a818797b716d",
                                                "sense_id": "ad346727-cca1-3dbd-83e2-d5931e71097c",
                                                "text": "Les amants, au désespoir, oublièrent qu’ils ne pourraient jamais être époux, et un fils naquit, qui ne pouvait porter le nom ni de l’un ni de l’autre."
                                            },
                                            {
                                                "example_id": "c82b6726-a939-4d57-85f9-e47158193203",
                                                "sense_id": "ad346727-cca1-3dbd-83e2-d5931e71097c",
                                                "text": "Quand les jeunes filles de la Bretagne chantent, dit Dumay redevenu sombre, l’amant est bien près d’elles."
                                            },
                                            {
                                                "example_id": "c3c4415f-7189-4df8-bed8-5b1127fe3651",
                                                "sense_id": "ad346727-cca1-3dbd-83e2-d5931e71097c",
                                                "text": "Comment l’amant prime-t-il sur le mari ? Moins par la passion, le plus souvent, que par l’assiduité et la complaisance, en flattant la fantaisie."
                                            },
                                            {
                                                "example_id": "a907ac37-0001-4edb-869c-010df8767d43",
                                                "sense_id": "ad346727-cca1-3dbd-83e2-d5931e71097c",
                                                "text": "Je voulais parler des perles, des diamants, des pierres précieuses et mes amants ne comprenaient pas qu’au lieu de les porter sur moi, je préférasse y plonger les mains jusqu’aux coudes, farouchement."
                                            },
                                            {
                                                "example_id": "f748520e-4189-4c35-9fc9-f3ec9d7bc0b2",
                                                "sense_id": "ad346727-cca1-3dbd-83e2-d5931e71097c",
                                                "text": "Adolphe pouvait d'ailleurs passer , au début, pour le modèle des amants, tendre, empressé, inquiet dans la juste mesure ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a46fc518-f1f3-38a4-8b8a-7f5c7179a2be",
                                        "entry_id": "82f12320-a09d-356f-8b1b-631d4cc8ab72",
                                        "glosses": [
                                            "ou Celui qui aime quelque chose avec passion."
                                        ],
                                        "tags": [
                                            "dated",
                                            "figuratively",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fbed174-a68b-4ee1-aa5b-fcc5a99db0df",
                                                "sense_id": "a46fc518-f1f3-38a4-8b8a-7f5c7179a2be",
                                                "text": "Quant au moine, Gurth le reconnut à l’instant même pour le prieur de l’abbaye de Jorvaulx, connu à plusieurs milles à la ronde comme un amant enragé de la chasse, de la table […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "amant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0ee1c94-64df-3cc5-b6a0-7d66c9df6ec5",
                                        "entry_id": "503c4f9a-bc5e-3091-b6fd-40a89e101ea6",
                                        "glosses": [
                                            "Celui qui reçoit les faveurs d’une femme (ou, plus rarement, d’un homme) avec laquelle il n’est pas marié."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b864e17-9509-409c-9399-5402a3297b1c",
                                                "sense_id": "f0ee1c94-64df-3cc5-b6a0-7d66c9df6ec5",
                                                "text": "Elle savait que beaucoup d’entre les filles de sa race avaient des amants, qu’elles se cachaient soigneusement de leurs familles, mais que, généralement, cela finissait par un mariage."
                                            },
                                            {
                                                "example_id": "2988afe0-a909-44ff-a320-426c62923327",
                                                "sense_id": "f0ee1c94-64df-3cc5-b6a0-7d66c9df6ec5",
                                                "text": "Pour choisir un amant, il suffit qu’on en ait envie. Et pour choisir un mari, combien le jugement serait plus sûr et plus libre, si l’on avait d’abord eu l’amant."
                                            },
                                            {
                                                "example_id": "9e4f9e8d-f527-4691-bcd2-190b206267a1",
                                                "sense_id": "f0ee1c94-64df-3cc5-b6a0-7d66c9df6ec5",
                                                "text": "Il est plus facile d’être amant que mari, par la raison qu’il est plus difficile d’avoir de l’esprit tous les jours que de dire de jolies choses de temps en temps."
                                            },
                                            {
                                                "example_id": "2bf797e7-d733-45c3-82d0-336be7cd5fa3",
                                                "sense_id": "f0ee1c94-64df-3cc5-b6a0-7d66c9df6ec5",
                                                "text": "Notre Grec, d'après ce que tu me dis, paraît être à voile et à vapeur, car il n'empêche pas qu'il est l’amant en titre de la belle Olga !..."
                                            },
                                            {
                                                "example_id": "e7617276-ef3d-42ce-b008-dff26ec71c69",
                                                "sense_id": "f0ee1c94-64df-3cc5-b6a0-7d66c9df6ec5",
                                                "text": "Désormais, pour continuer de se voir, il faut aux amants user de subterfuges. Après tout, il est prêtre, elle est mariée, tous deux savent ou devraient savoir que cela finira mal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ce03970-945e-307d-9341-21af82bd47c6",
                                        "entry_id": "503c4f9a-bc5e-3091-b6fd-40a89e101ea6",
                                        "glosses": [
                                            "Celui qui donne du plaisir sexuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5ff8722-d4d5-40c1-bbe8-0efb70b3b070",
                                                "sense_id": "9ce03970-945e-307d-9341-21af82bd47c6",
                                                "text": "Un bon amant ; un piètre amant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
