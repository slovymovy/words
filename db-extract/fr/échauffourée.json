                                "target_senses": [
                                    {
                                        "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                        "entry_id": "71014977-97c1-3f67-9422-5a4f011c521d",
                                        "glosses": [
                                            "To engage in a minor battle or dispute."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f082c05b-7707-4a2d-86e6-ab3863eefe5b",
                                                "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                                "text": "The deer and the pig and the nilghai were milling round and round in a circle of eight or ten miles radius, while the Eaters of Flesh skirmished round its edge."
                                            },
                                            {
                                                "example_id": "64c7c6b9-c63e-43b8-b698-c69c01c05f23",
                                                "sense_id": "7d3f4e9c-aa74-3bcf-8f9d-83b13e7066fc",
                                                "text": "Other historians might also remark that […] they have persisted all this time, constantly wrestling and skirmishing and yet never destroying themselves."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
