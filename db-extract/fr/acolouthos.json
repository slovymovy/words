            {
                "entry_id": "35ed9c24-fb01-35ad-aa78-14d63bbd65d0",
                "word": "acolouthos",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "54e0f3ea-b93f-387e-a741-f7e50a823a5f",
                        "entry_id": "35ed9c24-fb01-35ad-aa78-14d63bbd65d0",
                        "glosses": [
                            "Poste dirigeant dans l’armée byzantine des XIᵉ et XIIᵉ siècles, en particulier chef de la garde varangienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c78c32a8-d5e4-49d8-a183-2d6405a25a56",
                                "sense_id": "54e0f3ea-b93f-387e-a741-f7e50a823a5f",
                                "text": "Un regard échangé avec l’acolouthos semblait tout ce qui était nécessaire pour lui assurer le droit de passer avec son compagnon."
                            },
                            {
                                "example_id": "32439439-cb8f-4727-9cc3-60b24f753140",
                                "sense_id": "54e0f3ea-b93f-387e-a741-f7e50a823a5f",
                                "text": "C’était l’acolouthos, le chef des Varangiens."
                            },
                            {
                                "example_id": "d1ef58a2-1436-438b-ad40-ad10c87e712a",
                                "sense_id": "54e0f3ea-b93f-387e-a741-f7e50a823a5f",
                                "text": "L’acolouthos, généralement d’origine étrangère, devint vite un personnage important. Il est probable que, tout en relevant du drongaire de la Veille, il jouissait d’une certaine indépendance dans son service."
                            }
                        ]
                    }
