                        {
                            "text": "De <w>snelle</w> trein brengt ons in een uur naar Parijs.",
                            "target_lang_translations": {
                                "en": "The <w>fast</w> train takes us to Paris in an hour.",
                                "ru": "<w>Скорый</w> поезд доставит нас в Париж за час.",
                                "pl": "<w>Szybki</w> pociąg zabierze nas do Paryża w godzinę.",
                                "de": "Der <w>schnelle</w> Zug bringt uns in einer Stunde nach Paris.",
                                "fr": "Le train <w>rapide</w> nous emmène à Paris en une heure.",
                                "it": "Il treno <w>veloce</w> ci porta a Parigi in un'ora.",
                                "cs": "<w>Rychlý</w> vlak nás doveze do Paříže za hodinu.",
