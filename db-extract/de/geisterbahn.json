                "senses": [
                    {
                        "sense_id": "c4cdd42a-b6be-3412-978e-81698e459e42",
                        "entry_id": "bee18a3c-fda4-331f-907b-741c844a56fe",
                        "glosses": [
                            "in Vergnügungsparks oder auf Rummelplätzen installierte, überdachte Bahn, in der die mitfahrenden Besucher durch schaurige Effekte und Erscheinungen ein leichtes Gruseln erleben sollen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "322e1d16-7776-4dd4-a0be-d25911fd8888",
                                "sense_id": "c4cdd42a-b6be-3412-978e-81698e459e42",
                                "text": "Die Liga ähnelt einer Geisterbahn: Keiner weiß, welcher Schrecken hinter der nächsten Ecke lauert – oder welche Erleichterung."
                            },
                            {
                                "example_id": "11003636-766e-44a5-8d02-4a9240d23bb4",
                                "sense_id": "c4cdd42a-b6be-3412-978e-81698e459e42",
                                "text": "Der Prater, ein Phobienparadies, sagt Elfriede Jelinek dazu und posiert mit einem großen Gorilla, während Veruschka als Barbarella durch die Geisterbahn turnt und Peter Fitz mit sonorer Stimme Prater-Texte von Elias Canetti bis Erich Kästner vorliest."
                            },
                            {
                                "example_id": "aab423c5-55e8-4055-b7aa-0234bf3a9b2b",
                                "sense_id": "c4cdd42a-b6be-3412-978e-81698e459e42",
                                "text": "Betreiber von Fahrgeschäften für Familien sind hingegen skeptisch: „Fußballfans fahren nicht Geisterbahn. Meine Kunden haben schon gesagt, dass sie uns während der EM meiden werden“, so Alice Kolnhofer."
                            },
                            {
                                "example_id": "07519082-7ca3-4045-aaae-27e69582de81",
                                "sense_id": "c4cdd42a-b6be-3412-978e-81698e459e42",
                                "text": "Downtown Detroit, eine Geisterstadt. Wie in der Geisterbahn verlässt man den Wagen besser nicht."
                            },
                            {
                                "example_id": "cf9f0da0-291a-44ab-ba79-bf69da5bd32f",
                                "sense_id": "c4cdd42a-b6be-3412-978e-81698e459e42",
                                "text": "Ein wildes literarisches Gebilde, eine Fahrt durch die Geisterbahn, aus der niemand aussteigen darf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbb787b4-cc88-4301-b0a8-ccff8d6c4efa",
