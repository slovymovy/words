                "pos": "intj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d14876de-3038-4246-ac02-18320dc51d1b",
                        "entry_id": "915733fc-d62d-3251-b087-f13901fe0a30",
