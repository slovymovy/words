{
    "word_family": [
        "nowadays",
        "now-former",
        "now-defunct"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "afc22c5f-0061-3fb1-bd89-83f581491654",
                    "sense_definition": "At the present time.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "current_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am busy <w>now</w> but I can help you in ten minutes.",
                            "target_lang_translations": {
                                "ru": "Я <w>сейчас</w> занят, но смогу помочь тебе через десять минут."
                            }
                        },
                        {
                            "text": "We should leave <w>now</w> if we want to catch the bus.",
                            "target_lang_translations": {
                                "ru": "Нам нужно выходить <w>сейчас</w>, если мы хотим успеть на автобус."
                            }
                        }
                    ],
                    "synonyms": [
                        "now"
                    ],
                    "antonyms": [
                        "then",
                        "later"
                    ],
                    "common_phrases": [
                        "right now",
                        "starting now",
                        "until now"
                    ],
                    "target_lang_definitions": {
                        "ru": "В настоящее время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "в данный момент"
                            },
                            {
                                "target_lang_word": "теперь",
                                "target_lang_sense_clarification": "в настоящий момент в сравнении с прошлым"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1190313-6eed-3c57-8305-d3885026eded",
                    "sense_definition": "Used to indicate a context of urgency or immediate action.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "urgency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Now</w> listen to me because this is very important.",
                            "target_lang_translations": {
                                "ru": "<w>А теперь</w> послушай меня, потому что это очень важно."
                            }
                        },
                        {
                            "text": "You need to stop that <w>now</w> before someone gets hurt.",
                            "target_lang_translations": {
                                "ru": "Тебе нужно прекратить это <w>немедленно</w>, пока кто-нибудь не пострадал."
                            }
                        }
                    ],
                    "common_phrases": [
                        "do it now",
                        "listen now"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для указания на срочность или немедленное действие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сейчас же",
                                "target_lang_sense_clarification": "немедленно"
                            },
                            {
                                "target_lang_word": "немедленно",
                                "target_lang_sense_clarification": "без промедления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "399e3c85-7f9f-3603-a5fc-02e886ba3cdf",
                    "sense_definition": "At the time reached within a narration or story.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "narrative_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hero <w>now</w> realized that the treasure was hidden in the cave.",
                            "target_lang_translations": {
                                "ru": "Герой <w>теперь</w> понял, что сокровище было спрятано в пещере."
                            }
                        },
                        {
                            "text": "The dinner was <w>now</w> ready to be served to the guests.",
                            "target_lang_translations": {
                                "ru": "Ужин был <w>уже</w> готов к подаче гостям."
                            }
                        }
                    ],
                    "common_phrases": [
                        "by now"
                    ],
                    "target_lang_definitions": {
                        "ru": "В момент времени, достигнутый в повествовании или рассказе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "теперь",
                                "target_lang_sense_clarification": "к этому моменту в рассказе"
                            },
                            {
                                "target_lang_word": "уже",
                                "target_lang_sense_clarification": "к наступившему времени"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdb1794d-538a-3e05-894e-9f6941d4279d",
                    "sense_definition": "Used to introduce a point, a qualification, or a gentle rebuke.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "discourse_marker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Now</w>, we all want what is best for our children.",
                            "target_lang_translations": {
                                "ru": "<w>Ну</w>, мы все желаем нашим детям только лучшего."
                            }
                        },
                        {
                            "text": "<w>Now</w>, Jimmy, you know you shouldn't be doing that.",
                            "target_lang_translations": {
                                "ru": "<w>Послушай</w>, Джимми, ты же знаешь, что не должен так поступать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "now then"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a filler or transition in speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для введения нового пункта, уточнения или мягкого упрека."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ну",
                                "target_lang_sense_clarification": "вводное слово для привлечения внимания"
                            },
                            {
                                "target_lang_word": "итак",
                                "target_lang_sense_clarification": "для перехода к новой мысли"
                            },
                            {
                                "target_lang_word": "послушай",
                                "target_lang_sense_clarification": "при мягком упреке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a04438cb-0bf6-3502-9f8b-14c28e8881a2",
                    "sense_definition": "Used in a series to describe alternating or changing states; sometimes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "alternation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His mood was unpredictable, <w>now</w> happy, <w>now</w> suddenly angry.",
                            "target_lang_translations": {
                                "ru": "Его настроение было непредсказуемым: <w>то</w> счастливый, <w>то</w> вдруг сердитый."
                            }
                        },
                        {
                            "text": "The wind shifted constantly, <w>now</w> blowing from the north, <w>now</w> from the east.",
                            "target_lang_translations": {
                                "ru": "Ветер постоянно менялся, дуя <w>то</w> с севера, <w>то</w> с востока."
                            }
                        }
                    ],
                    "common_phrases": [
                        "now and then"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary style"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется в ряду для описания чередующихся или меняющихся состояний; то... то..."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "то",
                                "target_lang_sense_clarification": "при описании смены состояний"
                            },
                            {
                                "target_lang_word": "теперь",
                                "target_lang_sense_clarification": "в литературном контексте чередования"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "conjunction",
            "senses": [
                {
                    "sense_id": "b6dce725-d2c1-37c6-b9f1-90dd270b429d",
                    "sense_definition": "Since or because, especially in light of a new fact or situation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Now</w> that the rain has stopped, we can finally go outside.",
                            "target_lang_translations": {
                                "ru": "<w>Теперь, когда</w> дождь закончился, мы наконец можем выйти на улицу."
                            }
                        },
                        {
                            "text": "The house is very quiet <w>now</w> all the children have grown up.",
                            "target_lang_translations": {
                                "ru": "В доме стало очень тихо, <w>раз уж</w> все дети выросли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "now that"
                    ],
                    "target_lang_definitions": {
                        "ru": "Так как или потому что, особенно в свете нового факта или ситуации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "теперь, когда",
                                "target_lang_sense_clarification": "в связи с наступившими обстоятельствами"
                            },
                            {
                                "target_lang_word": "раз уж",
                                "target_lang_sense_clarification": "поскольку ситуация изменилась"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d3e29be2-ce1c-3364-a3e0-d03e2be0947e",
                    "sense_definition": "The present time.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "current_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no better time to start than <w>now</w>.",
                            "target_lang_translations": {
                                "ru": "Нет лучшего времени для начала, чем <w>сейчас</w>."
                            }
                        },
                        {
                            "text": "The <w>now</w> is all we really have to focus on.",
                            "target_lang_translations": {
                                "ru": "<w>Настоящее</w> — это всё, на чём нам действительно нужно сосредоточиться."
                            }
                        }
                    ],
                    "synonyms": [
                        "present",
                        "here and now"
                    ],
                    "antonyms": [
                        "past",
                        "future"
                    ],
                    "common_phrases": [
                        "the here and now"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настоящее время."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящее",
                                "target_lang_sense_clarification": "текущий момент времени"
                            },
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "момент речи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a0a86ea-0730-3944-891b-f86de341f991",
                    "sense_definition": "The state of living in the present moment without worrying about the past or future.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mindfulness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She practices mindfulness to help her live in the <w>now</w>.",
                            "target_lang_translations": {
                                "ru": "Она практикует осознанность, чтобы научиться жить в <w>настоящем</w>."
                            }
                        },
                        {
                            "text": "Forget your worries about tomorrow and focus on the <w>now</w>.",
                            "target_lang_translations": {
                                "ru": "Забудь о своих тревогах о завтрашнем дне и сосредоточься на <w>сегодняшнем</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "living in the now"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние жизни в настоящем моменте без беспокойства о прошлом или будущем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "настоящее",
                                "target_lang_sense_clarification": "момент «здесь и сейчас»"
                            },
                            {
                                "target_lang_word": "сегодняшний день",
                                "target_lang_sense_clarification": "текущая жизнь"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "86c11fb3-19e3-37bf-8f43-3fe97ee5f18b",
                    "sense_definition": "Fashionable, popular, or up to date.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fashion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That designer's new collection is very <w>now</w> and trendy.",
                            "target_lang_translations": {
                                "ru": "Новая коллекция этого дизайнера очень <w>актуальная</w> и модная."
                            }
                        },
                        {
                            "text": "I think this band's electronic sound is very <w>now</w>.",
                            "target_lang_translations": {
                                "ru": "Я думаю, электронное звучание этой группы очень <w>современно</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "present"
                    ],
                    "antonyms": [
                        "dated",
                        "old-fashioned"
                    ],
                    "common_phrases": [
                        "very now"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in fashion or media contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Модный, популярный или современный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "актуальный",
                                "target_lang_sense_clarification": "соответствующий моменту"
                            },
                            {
                                "target_lang_word": "современный",
                                "target_lang_sense_clarification": "модный сейчас"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "020b32c7-105a-33d5-9a10-9029a43f9110",
                    "sense_definition": "Present or current.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "current_time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>now</w> president has proposed a new law regarding taxes.",
                            "target_lang_translations": {
                                "ru": "<w>Нынешний</w> президент предложил новый закон о налогах."
                            }
                        },
                        {
                            "text": "Our <w>now</w> happiness depends on the choices we make today.",
                            "target_lang_translations": {
                                "ru": "Наше <w>текущее</w> счастье зависит от выбора, который мы делаем сегодня."
                            }
                        }
                    ],
                    "synonyms": [
                        "present"
                    ],
                    "antonyms": [
                        "former"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal or legal writing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нынешний или текущий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нынешний",
                                "target_lang_sense_clarification": "действующий в настоящее время"
                            },
                            {
                                "target_lang_word": "текущий",
                                "target_lang_sense_clarification": "существующий сейчас"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "d37da9bc-aba0-3c72-baab-132fa7795bba",
                    "sense_definition": "A signal to begin an action immediately.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Now</w>! Jump into the water before the boat leaves!",
                            "target_lang_translations": {
                                "ru": "<w>Давай</w>! Прыгай в воду, пока лодка не ушла!"
                            }
                        },
                        {
                            "text": "Ready, set, <w>now</w>!",
                            "target_lang_translations": {
                                "ru": "На старт, внимание, <w>марш</w>!"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сигнал к немедленному началу действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "марш",
                                "target_lang_sense_clarification": "команда к началу"
                            },
                            {
                                "target_lang_word": "пора",
                                "target_lang_sense_clarification": "сигнал, что время пришло"
                            },
                            {
                                "target_lang_word": "сейчас",
                                "target_lang_sense_clarification": "в значении «давай!»"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3f86dacc-85a4-3e95-855d-0a950c7cecb8",
                    "sense_definition": "Acronym of National Organization for Women, an American feminist organization.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization",
                    "name_type": "organization_name",
                    "examples": [
                        {
                            "text": "She joined <w>NOW</w> to advocate for equal pay in the workplace.",
                            "target_lang_translations": {
                                "ru": "Она вступила в <w>NOW</w>, чтобы бороться за равную оплату труда."
                            }
                        },
                        {
                            "text": "The local chapter of <w>NOW</w> organized a march downtown.",
                            "target_lang_translations": {
                                "ru": "Местное отделение <w>NOW</w> организовало марш в центре города."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура Национальной организации женщин, американской феминистской организации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "NOW",
                                "target_lang_sense_clarification": "название организации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}