            {
                "entry_id": "f20a3df1-6e3d-3fe0-a0c1-dca6c553a60e",
                "word": "railroad",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "f96acad9-a377-43f1-a772-ecec8240afcf",
                        "entry_id": "f20a3df1-6e3d-3fe0-a0c1-dca6c553a60e",
                        "tags": [
                            "plural"
                        ],
                        "form": "railroads"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "26621894-5667-33af-8bf9-a85a70546cbf",
                        "entry_id": "f20a3df1-6e3d-3fe0-a0c1-dca6c553a60e",
                        "glosses": [
                            "A permanent track consisting of fixed metal rails to drive trains or similar motorized vehicles on."
                        ],
                        "tags": [
                            "Philippines",
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "b8e7c11c-6427-4ccd-b1b7-575fa518c564",
                                "sense_id": "26621894-5667-33af-8bf9-a85a70546cbf",
                                "text": "Many railroads roughly follow the trace of older land or water roads."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b002d95-57c9-398f-9602-b3ab44ef5484",
                        "entry_id": "f20a3df1-6e3d-3fe0-a0c1-dca6c553a60e",
                        "glosses": [
                            "The transportation system comprising such tracks and vehicles fitted to travel on the rails, usually with several vehicles connected together in a train."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "78745fdc-6c00-355a-bcbc-fb6a050ab4ff",
                        "entry_id": "f20a3df1-6e3d-3fe0-a0c1-dca6c553a60e",
                        "glosses": [
                            "A single, privately or publicly owned property comprising one or more such tracks and usually associated assets"
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "1e865f67-7ab7-48c6-b2ab-661c86fc6e43",
                                "sense_id": "78745fdc-6c00-355a-bcbc-fb6a050ab4ff",
                                "text": "Railroads can only compete fully if their tracks are technically compatible with and linked to each other."
                            }
                        ]
                    },
                    {
                        "sense_id": "3a8b6ab2-b5dd-3928-b640-5c229a68f9da",
                        "entry_id": "f20a3df1-6e3d-3fe0-a0c1-dca6c553a60e",
                        "glosses": [
                            "A procedure conducted in haste without due consideration."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b6b581e8-049f-4ef5-b9ad-16a249d9ba15",
                                "sense_id": "3a8b6ab2-b5dd-3928-b640-5c229a68f9da",
                                "text": "The lawyers made the procedure a railroad to get the signatures they needed."
                            },
                            {
                                "example_id": "e4c2ddeb-1aae-4653-b5c6-b47733ca69cd",
                                "sense_id": "3a8b6ab2-b5dd-3928-b640-5c229a68f9da",
                                "text": "Gregory Scroggins, a PWA [person with AIDS] in Georgia who was found guilty of assault with intent to commit murder for biting a cop during arrest. It took only three days in October of 1989 to charge, try, convict and sentence Scroggins, who is now serving a 10-year sentence and has been denied bail (and medical treatment) pending appeal. […] Judy Siff of ACT/UP/Atlanta told GCN that Scroggins' case was a \"railroad\" of unbelievable proportions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b94fbe65-b5bf-4b7f-88cf-ea5f81f46b4c",
                        "source_entry_id": "f20a3df1-6e3d-3fe0-a0c1-dca6c553a60e",
                        "source_sense_description": "unduly hastened procedure",
                        "target_lang_word": "sneltreinprocedure",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    }
                ],
