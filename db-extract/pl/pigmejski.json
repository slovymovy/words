                    {
                        "sense_id": "0f4322f9-dc26-34f5-8fb5-5c916e18a33e",
                        "entry_id": "cc585a85-8961-3034-a1ed-8d5571e88fa0",
                        "glosses": [
                            "związany z Pigmejami, dotyczący Pigmejów, ich kultury, sztuki"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf691ff-6ae8-404b-9af6-8c26f9101935",
                                "sense_id": "0f4322f9-dc26-34f5-8fb5-5c916e18a33e",
                                "text": "Już prędzej spodziewałbym się spotkać Polaków posługujących się narzeczami papuaskimi i pigmejskimi, bo tych uczą się podróżnicy i przyrodnicy"
                            },
                            {
                                "example_id": "6ce92466-2f7b-4dd9-9a89-70d8daa3aef9",
                                "sense_id": "0f4322f9-dc26-34f5-8fb5-5c916e18a33e",
                                "text": "Pomysł stworzenia państwa śląskiego można porównać do pomysłu stworzenia państwa pigmejskiego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
