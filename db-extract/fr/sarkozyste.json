                    {
                        "sense_id": "a3b9936c-49f8-3f63-bf89-25879dd635e5",
                        "entry_id": "afd525b2-e106-321e-9258-6c88240508f3",
                        "glosses": [
                            "Partisan ou partisane de Nicolas Sarkozy."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7ac10a-9351-4f4e-bd45-e7060c422890",
                                "sense_id": "a3b9936c-49f8-3f63-bf89-25879dd635e5",
                                "text": "Et voici l’intégralité des propos de Mᵐᵉ Thepaut dans le reportage, qualifiés de violemment hostiles à Nicolas Sarkozy par les sarkozystes."
                            },
                            {
                                "example_id": "f574406d-cadd-43e3-bff4-49484aa60ad1",
                                "sense_id": "a3b9936c-49f8-3f63-bf89-25879dd635e5",
                                "text": "Laurent Wauquiez vient d’intégrer trois sarkozystes historiques aux réunions de l’équipe dirigeante du mardi matin : Nadine Morano, Rachida Dati et Brice Hortefeux."
                            }
                        ]
                    }
