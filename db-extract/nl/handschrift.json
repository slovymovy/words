                "senses": [
                    {
                        "sense_id": "17eac6bb-2e75-3b7b-b3bb-4158f9cfbeae",
                        "entry_id": "b7f61819-2849-3d82-a279-677d8b30bf21",
                        "glosses": [
                            "de manier waarop iemand met de hand schrijft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bdb6451-beca-48bc-ad9b-db42074ae6a5",
                                "sense_id": "17eac6bb-2e75-3b7b-b3bb-4158f9cfbeae",
                                "text": "Een forensisch expert vergeleek de handschriften."
                            },
                            {
                                "example_id": "91aa47ca-d62d-41f2-939e-c9683e529b0d",
                                "sense_id": "17eac6bb-2e75-3b7b-b3bb-4158f9cfbeae",
                                "text": "Het gejaagde handschrift leunt naar voren en helt gretig in de richting van de punt."
                            },
                            {
                                "example_id": "5618b64b-9b34-456a-a71f-ac415be364d8",
                                "sense_id": "17eac6bb-2e75-3b7b-b3bb-4158f9cfbeae",
                                "text": "Nella's hart springt op omdat ze denkt dat de miniatuurmaakster haar iets nieuws heeft gestuurd, maar het handschrift op de enveloppe maakt haar al melancholiek voordat ze de brief openmaakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "35a2fb73-cb25-3ed9-bfb6-2fa2685ba705",
                        "entry_id": "b7f61819-2849-3d82-a279-677d8b30bf21",
                        "glosses": [
                            "een met de hand geschreven boekwerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "061fffb3-7cb7-40f2-a85b-d18c556b35f4",
                                "sense_id": "35a2fb73-cb25-3ed9-bfb6-2fa2685ba705",
                                "text": "Men heeft een tot nu toe onbekend handschrift van de filosoof gevonden."
                            },
                            {
                                "example_id": "a6f2c673-d7a4-4e2d-b1e0-e0ec44b7fa7c",
                                "sense_id": "35a2fb73-cb25-3ed9-bfb6-2fa2685ba705",
                                "text": "Vorige week was er op Catawiki een online-veiling met handschriften en eerste drukken van de verzamelaar, reiziger, schrijver en programmamaker Büch. Onder de parafernalia ook twee ingelijste fineliner-tekeningetjes van Drost: inderdaad fijn en vrolijk."
                            }
                        ]
                    }
                ],
