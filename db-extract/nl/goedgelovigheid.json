                                                "sense_id": "7ebaf31b-f597-3cd5-8a94-cdfe6cf4d546",
                                                "text": "Sie ist voller Gutgläubigkeit."
                                            },
                                            {
                                                "example_id": "2442eba4-5b3f-43cb-8529-ceaaac253967",
                                                "sense_id": "7ebaf31b-f597-3cd5-8a94-cdfe6cf4d546",
                                                "text": "Seine Gutgläubigkeit wurde von den Verkäufern dann auch prompt schamlos ausgenutzt."
                                            }
