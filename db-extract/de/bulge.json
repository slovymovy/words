                "senses": [
                    {
                        "sense_id": "cb2cf6ec-411a-3571-b041-af265ad0353c",
                        "entry_id": "e2167c05-9be7-30b4-a246-d1b84200602b",
                        "glosses": [
                            "dichter, heller Zentralbereich einer Spiralgalaxie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bb17d1e-7b60-4376-a522-1f9036a1e32b",
                                "sense_id": "cb2cf6ec-411a-3571-b041-af265ad0353c",
                                "text": "Die Milchstraße ist ein System aus 100 bis 400 Milliarden Sternen, die überwiegend in einer dünnen Scheibe und einem zentralen Bulge (englisch „Bauch“) lokalisiert sind."
                            },
                            {
                                "example_id": "9cd27747-09fa-44f9-ab2f-bd220971dd5c",
                                "sense_id": "cb2cf6ec-411a-3571-b041-af265ad0353c",
                                "text": "Es beherbergt ein supermassereiches Schwarzes Loch mit vier Millionen Sonnenmassen. Umhüllt wird es vom galaktischen Bulge."
                            },
                            {
                                "example_id": "48ed9ca0-cc19-42c3-bbb2-89196e25d32f",
                                "sense_id": "cb2cf6ec-411a-3571-b041-af265ad0353c",
                                "text": "Astronomen können nur dann einen guten Blick auf den Bulge bekommen, indem sie bei längeren Wellenlängen beobachten, zum Beispiel im Infrarotlicht, das Staubwolken durchdringen kann."
                            },
                            {
                                "example_id": "b00c52dc-25ff-4265-a202-7c77003e1650",
                                "sense_id": "cb2cf6ec-411a-3571-b041-af265ad0353c",
                                "text": "Seit langem vermuten die Astronomen, dass sich die ersten Sterne in den heutigen Bulges gebildet haben – bislang wurden uralte Sterne jedoch nur in den Außenbezirken der Milchstraße nachgewiesen."
                            },
                            {
                                "example_id": "79282e25-0081-4d9c-875a-6660cf41f047",
                                "sense_id": "cb2cf6ec-411a-3571-b041-af265ad0353c",
                                "text": "Die Masse des schwarzen Lochs hängt vielmehr von der Entstehung des galaktischen Bulges ab."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
