                    "frequency": "Middle",
                    "semantic_group_id": "habitat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nombreuses espèces d'oiseaux viennent <w>peupler</w> les forêts dès le début du printemps."
                        },
                        {
                            "text": "Le gouvernement a encouragé les familles à <w>peupler</w> cette région isolée."
                        }
                    ],
                    "synonyms": [
                        "coloniser",
                        "habiter",
                        "occuper"
                    ],
                    "antonyms": [
