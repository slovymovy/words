                        "entry_id": "f5a7da79-b4a1-3ab0-b90b-daaa6fa4594d",
                        "glosses": [
                            "Having a bore with a smooth interior, i.e. one that has not been rifled."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7b249be4-6efc-403e-aff4-0847eef69820",
                                "sense_id": "d5a636c3-69ff-3429-aa1c-0cd398684ce4",
                                "text": "From what distance the smoothbore musket was able to fell a human target has been the source of debate for a long time."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b02e95cf-504b-46bf-a366-e3c71780e0a9",
                        "source_entry_id": "f5a7da79-b4a1-3ab0-b90b-daaa6fa4594d",
                        "source_sense_id": "d5a636c3-69ff-3429-aa1c-0cd398684ce4",
