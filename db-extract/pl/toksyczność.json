                        "translation_id": "d7cdd70a-ead7-422a-8d5a-e201b6954526",
                        "source_entry_id": "aac97816-0ae6-3aac-a57a-bf4642ea0996",
                        "source_sense_id": "642d8322-3182-3e73-90b1-9a686e5e9ec4",
                        "target_lang_word": "toxicity",
