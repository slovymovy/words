            {
                "entry_id": "237a333b-be09-3643-a31e-4366d4181567",
                "word": "bleusaille",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "20931bd1-e535-4dda-94d0-06d6c8343f87",
                        "entry_id": "237a333b-be09-3643-a31e-4366d4181567",
                        "tags": [
                            "plural"
                        ],
                        "form": "bleusailles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "44bc201a-22d3-3895-a2e0-f8a40eaa4f5d",
                        "entry_id": "237a333b-be09-3643-a31e-4366d4181567",
                        "glosses": [
                            "Ensemble des nouvelles recrues militaires, les bleus."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "20815c3a-bcb5-4072-abcf-ce797b76f33e",
                                "sense_id": "44bc201a-22d3-3895-a2e0-f8a40eaa4f5d",
                                "text": "La bleusaille est arrivée, on va bien rigoler."
                            },
                            {
                                "example_id": "979a55d6-f9ed-462c-bd4d-ed9421ad4e4c",
                                "sense_id": "44bc201a-22d3-3895-a2e0-f8a40eaa4f5d",
                                "text": "— En attendant, va-t-on enfin manger ? Y en a qu’pour lui, ce bleusaille…"
                            }
                        ]
                    },
                    {
                        "sense_id": "b25b25c9-5ba4-391c-8edb-308238576653",
                        "entry_id": "237a333b-be09-3643-a31e-4366d4181567",
                        "glosses": [
                            "Nouvelle recrue, bleu."
                        ],
                        "tags": [
                            "colloquial",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e5202623-af02-49d4-96e4-6678b0ac46f4",
                                "sense_id": "b25b25c9-5ba4-391c-8edb-308238576653",
                                "text": "Debout les bleusailles, rassemblement dans dix minutes."
                            },
                            {
                                "example_id": "fa796a2f-9c76-4a15-9ee4-9e199caad5fb",
                                "sense_id": "b25b25c9-5ba4-391c-8edb-308238576653",
                                "text": "Vous n’êtes pas de la bleusaille et moi non plus. Raison de plus pour nous entendre."
                            },
                            {
                                "example_id": "0820e35f-9370-4637-8dde-18531873e0a4",
                                "sense_id": "b25b25c9-5ba4-391c-8edb-308238576653",
                                "text": "— Te v’la, bleusaille ! D’puis l’temps que ton sacré père nous causait d’toi, vingt dieux !"
                            },
                            {
                                "example_id": "28ae7273-e27c-4b7f-a201-78e85d9c4c24",
                                "sense_id": "b25b25c9-5ba4-391c-8edb-308238576653",
                                "text": "Ne me prenez pas trop pour une bleusaille. En combat réel, je ne me défends pas trop mal."
                            },
                            {
                                "example_id": "ef2a4a8b-d8b7-4d74-a5cc-7c466d1f24ab",
                                "sense_id": "b25b25c9-5ba4-391c-8edb-308238576653",
                                "text": "Il était chez lui à Paris, il n'allait pas se faire semer comme une bleusaille."
                            }
                        ]
                    },
                    {
                        "sense_id": "38b99110-b9ff-3021-8b0a-1f130098b96a",
                        "entry_id": "237a333b-be09-3643-a31e-4366d4181567",
                        "glosses": [
                            "Période de préparation initiatique vécue par le nouvel étudiant belge, le bleu, avant le baptême estudiantin."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "72f48750-7f9d-4416-bff5-f61a979faa44",
                                "sense_id": "38b99110-b9ff-3021-8b0a-1f130098b96a",
                                "text": "Il peut y avoir plusieurs bleusailles avant un pré-baptême."
                            },
                            {
                                "example_id": "7a306da1-cc7b-4573-b7f0-9b92f2e37edd",
                                "sense_id": "38b99110-b9ff-3021-8b0a-1f130098b96a",
                                "text": "La bleusaille est un outil d’intégration formidable, elle permet le brassage des différentes générations d’étudiants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0d96157-edef-44c2-81bc-e9f1e91dce69",
                        "source_entry_id": "237a333b-be09-3643-a31e-4366d4181567",
