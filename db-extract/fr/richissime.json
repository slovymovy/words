                                        "entry_id": "ef9606cd-52d5-3d1a-97d7-2919415a7b86",
                                        "glosses": [
                                            "Very wealthy people, considered as a class."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de8346d5-0d0b-4b29-90e6-d6d9f0bacc6c",
                                                "sense_id": "2b7e11e3-5769-3444-92c9-f2470f1eb725",
                                                "text": "The trickle-down benefit of spending by the super-rich is insignificant in comparison to the insidious damage."
                                            },
                                            {
                                                "example_id": "6bab175a-27cd-4aee-9fc4-b0165060407f",
                                                "sense_id": "2b7e11e3-5769-3444-92c9-f2470f1eb725",
                                                "text": "In the ballroom of the five star Savoy hotel on the Strand in central London, the super-rich and their advisers were this week advised that they may soon need to watch out for people with “pitchforks and torches” unless they do more to use their fortunes to help the millions struggling with the cost of living crisis."
                                            }
                                        ]
                                    }
