        "fr-extract.jsonl": [
            {
                "entry_id": "cc0c0405-4488-3393-b14d-6f4cd7744237",
                "word": "pluralité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c6e1ec01-8140-47c6-9007-bbc56210a356",
                        "entry_id": "cc0c0405-4488-3393-b14d-6f4cd7744237",
                        "tags": [
                            "plural"
                        ],
                        "form": "pluralités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9bed5f3f-6c5c-3ca7-b6c5-3dbcdf0477e0",
                        "entry_id": "cc0c0405-4488-3393-b14d-6f4cd7744237",
                        "glosses": [
                            "Grand nombre, grande quantité, multiplicité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61f578d7-61d4-484e-ad98-3a6d13474355",
                                "sense_id": "9bed5f3f-6c5c-3ca7-b6c5-3dbcdf0477e0",
                                "text": "Le système de la pluralité des mondes."
                            },
                            {
                                "example_id": "2b549ad0-9f07-4d90-adc0-7aaf7d7da0a3",
                                "sense_id": "9bed5f3f-6c5c-3ca7-b6c5-3dbcdf0477e0",
                                "text": "La pluralité des suffrages."
                            },
                            {
                                "example_id": "4fa00b8d-2e04-4bd5-bdfc-982c3571f971",
                                "sense_id": "9bed5f3f-6c5c-3ca7-b6c5-3dbcdf0477e0",
                                "text": "Décider quelque chose à la pluralité des voix."
                            },
                            {
                                "example_id": "c353ef5f-0d21-4f14-b834-7dad2c734a82",
                                "sense_id": "9bed5f3f-6c5c-3ca7-b6c5-3dbcdf0477e0",
                                "text": "Si donc le darwinisme, pas plus que le lamarckisme, ne nous éclairent sur l’origine des callosités, quelle hypothèse explicative nous reste-t-il ? La mutationniste, qui rallie aujourd’hui la pluralité des savants."
                            },
                            {
                                "example_id": "b09d4a50-87d9-44c9-a709-2073e00b4975",
                                "sense_id": "9bed5f3f-6c5c-3ca7-b6c5-3dbcdf0477e0",
                                "text": "La pluralité des théories qui permettent de décrire la matière souligne le caractère contingent de celle-ci."
                            }
                        ]
                    },
                    {
                        "sense_id": "6c286f97-77ab-30ce-9396-f4c46ead64a0",
                        "entry_id": "cc0c0405-4488-3393-b14d-6f4cd7744237",
                        "glosses": [
                            "Majorité."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ab05f714-6d47-436a-8a07-516737082967",
                        "source_entry_id": "cc0c0405-4488-3393-b14d-6f4cd7744237",
                        "source_sense_description": "Grand nombre",
                        "target_lang_word": "plurality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plurality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd17d627-bebe-39b6-bd94-12f089597bdc",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "The state of being plural."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8bf6308d-b7a9-4a95-a466-8f9479e71c03",
                                                "sense_id": "fd17d627-bebe-39b6-bd94-12f089597bdc",
                                                "text": "Nominal plurality in Basque is originally exclusively marked on definite determiners and not on nouns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a4840ba-a652-3737-a072-46ec9bb1493c",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "The holding of multiple benefices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d05874a0-aef5-43df-a5b2-b5398a935caf",
                                                "sense_id": "7a4840ba-a652-3737-a072-46ec9bb1493c",
                                                "text": "It was the complaint and lamentation of Prelats, upon every least breath of a motion to remove pluralities, and distribute more equally Church revennu's, that then all learning would be for ever dasht and discourag'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f336dc22-e0e4-390b-a81a-5b0d2c5155a1",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "A state of being numerous."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ea6cf7e-8cb7-3faf-ab4b-61a5c2319ebf",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "A number or part of a whole which is greater than any other number or part, but not necessarily a majority."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a73069f7-667c-36de-89cd-0aff43f0bee3",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "A number of votes for a single candidate or position which is greater than the number of votes gained by any other single candidate or position voted for, but which is less than a majority of valid votes cast."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ecb77e83-2d6a-461c-952c-11c8e08f3873",
                                                "sense_id": "a73069f7-667c-36de-89cd-0aff43f0bee3",
                                                "text": "To repeal the tax (Question I), a 50 per cent majority vote is required. To keep the tax in its 1976 form (Question III), only a plurality of votes is required."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "782db0da-8f9b-3e07-9b49-9445a26347fd",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "A margin by which a number exceeds another number, especially of votes."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bcf0407b-1913-4c51-9938-a0b2628ffa1e",
                                                "sense_id": "782db0da-8f9b-3e07-9b49-9445a26347fd",
                                                "text": "Truman's total vote was 24,104,836. Dewey received 21,969,500;[…]. Truman won by a plurality of 2,135,336, but it was the first time since 1916 that a winner has failed to capture a majority of all votes cast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8772ffe-e1de-3862-a6b6-66f48499f1cb",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "A group of many entities: a large number."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc7b8411-c06f-479d-88c3-8eb8d27d55fa",
                                                "sense_id": "a8772ffe-e1de-3862-a6b6-66f48499f1cb",
                                                "text": "A plurality of ideas were put forth at the meeting, most of which were rejected out of hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15e71d98-4204-3d7a-9bb4-1564808c9c4b",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "A group composed of more than one entity."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "465a9a35-dc40-46fa-9d7d-950e389c5378",
                                                "sense_id": "15e71d98-4204-3d7a-9bb4-1564808c9c4b",
                                                "text": "The array is organized into a plurality of vertical (column) blocks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eee6d35-bb4c-317f-a0e5-44c36a425fef",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "Polygamy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ec96887f-6e5e-3db4-a0a4-6565e8943b5a",
                                        "entry_id": "22c0f45e-3667-3e67-9680-f1d0d19c7851",
                                        "glosses": [
                                            "Synonym of multiplicity (“the condition whereby a person displays or experiences multiple distinct personalities or selves in one body”)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4f78ecd-eaa2-4392-aab4-012b6c95d04c",
                                                "sense_id": "ec96887f-6e5e-3db4-a0a4-6565e8943b5a",
                                                "text": "In this paper I argue that hearing voices experiences and plurality are part of a broad, rich, and complex spectrum of human experience, […]"
                                            },
                                            {
                                                "example_id": "72d9cb8f-f1a9-49b6-8dcf-01e6ec6d75a8",
                                                "sense_id": "ec96887f-6e5e-3db4-a0a4-6565e8943b5a",
                                                "text": "Clinical psychology tends to lean towards early childhood trauma as an explanation for the development of plurality, but many members of the plurality community report experiencing a multiplicity of selves before, or even completely in the absence of, trauma."
                                            },
                                            {
                                                "example_id": "5d7c6e8d-7131-44b1-9173-2b278617b2a0",
                                                "sense_id": "ec96887f-6e5e-3db4-a0a4-6565e8943b5a",
                                                "text": "People often find it easiest to recognise plurality in themselves when they reflect on how they behave in different relationships or situations."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8213701c-038f-4435-ab3b-f0345c50d530",
                        "source_entry_id": "cc0c0405-4488-3393-b14d-6f4cd7744237",
