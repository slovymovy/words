    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20acb00c-b5c2-36fb-9de5-b4dd98e7eb03",
                    "sense_definition": "The chemical element (symbol C) with an atomic number of 6, found in all living things, charcoal, graphite, and diamonds.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All known life on Earth is based on <w>carbon</w> and its ability to form complex molecules.",
                            "target_lang_translations": {
                                "ru": "Вся известная жизнь на Земле основана на <w>углероде</w> и его способности образовывать сложные молекулы.",
                                "zh": "地球上所有已知的生命都基于<w>碳</w>及其形成复杂分子的能力。"
                            }
                        },
                        {
                            "text": "Diamonds are formed from pure <w>carbon</w> under extreme pressure deep underground.",
                            "target_lang_translations": {
                                "ru": "Алмазы образуются из чистого <w>углерода</w> под экстремальным давлением глубоко под землей.",
                                "zh": "钻石是在地下深处极高压力下由纯<w>碳</w>形成的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carbon atom",
                        "carbon cycle",
                        "carbon dating",
                        "activated carbon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Химический элемент (символ C) с атомным номером 6, содержащийся во всех живых организмах, древесном угле, графите и алмазах.",
                        "zh": "化学元素（符号C），原子序数为6，存在于所有生物、木炭、石墨和钻石中。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углерод",
                                "target_lang_sense_clarification": "химический элемент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碳",
                                "target_lang_sense_clarification": "化学元素"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5272e3f-7908-3ef8-b7af-adc1cc56d5fe",
                    "sense_definition": "Short for carbon dioxide or other carbon compounds, especially when referring to emissions that affect the global climate.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "co2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many countries are introducing a <w>carbon</w> tax to encourage companies to pollute less.",
                            "target_lang_translations": {
                                "ru": "Многие страны вводят <w>углеродный</w> налог, чтобы побудить компании меньше загрязнять окружающую среду.",
                                "zh": "许多国家正在引入<w>碳</w>税，以鼓励企业减少污染。"
                            }
                        },
                        {
                            "text": "We are trying to reduce our <w>carbon</w> footprint by driving less and recycling more.",
                            "target_lang_translations": {
                                "ru": "Мы пытаемся уменьшить свой <w>углеродный</w> след, меньше пользуясь автомобилем и больше перерабатывая отходы.",
                                "zh": "我们正试图通过减少开车和增加回收利用来降低我们的<w>碳</w>足迹。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carbon footprint",
                        "carbon neutral",
                        "carbon tax",
                        "carbon emissions",
                        "carbon capture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от углекислого газа или других углеродных соединений, особенно в контексте выбросов, влияющих на климат.",
                        "zh": "二氧化碳或其他碳化合物的简称，尤指影响全球气候的排放物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "углекислый газ",
                                "target_lang_sense_clarification": "газ (CO2)"
                            },
                            {
                                "target_lang_word": "углерод",
                                "target_lang_sense_clarification": "в контексте выбросов и экологии"
                            },
                            {
                                "target_lang_word": "углекислота",
                                "target_lang_sense_clarification": "разговорное название CO2"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碳",
                                "target_lang_sense_clarification": "指代碳排放或碳足迹"
                            },
                            {
                                "target_lang_word": "二氧化碳",
                                "target_lang_sense_clarification": "气体 (CO2)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "189f8a32-ffc4-33be-a7ed-8396808a869c",
                    "sense_definition": "Short for carbon fiber, a strong and lightweight material used in manufacturing high-performance equipment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "fiber",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Professional cyclists often prefer a bike frame made of <w>carbon</w> because it is very light.",
                            "target_lang_translations": {
                                "ru": "Профессиональные велосипедисты часто предпочитают раму из <w>карбона</w>, потому что она очень легкая.",
                                "zh": "职业自行车手通常更喜欢<w>碳</w>纤维车架，因为它非常轻。"
                            }
                        },
                        {
                            "text": "The new sports car features a body made largely of <w>carbon</w> to improve speed and handling.",
                            "target_lang_translations": {
                                "ru": "Кузов нового спорткара в значительной степени выполнен из <w>карбона</w> для улучшения скорости и управляемости.",
                                "zh": "这款新款跑车的车身主要由<w>碳</w>纤维制成，以提高速度和操控性。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carbon fiber",
                        "carbon frame"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращение от углеродного волокна (карбона), прочного и легкого материала.",
                        "zh": "碳纤维的简称，一种用于制造高性能设备的坚固轻质材料。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карбон",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "углеволокно",
                                "target_lang_sense_clarification": "материал"
                            },
                            {
                                "target_lang_word": "углепластик",
                                "target_lang_sense_clarification": "композитный материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "碳纤维",
                                "target_lang_sense_clarification": "材料"
                            },
                            {
                                "target_lang_word": "碳素",
                                "target_lang_sense_clarification": "常用于运动器材的材料称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cc090bac-a80f-391e-92a4-19fa1c04b240",
                    "sense_definition": "A black deposit of soot or burnt material, often found inside engines or on lamps.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "soot",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic had to clean the built-up <w>carbon</w> from the engine valves to make it run smoothly.",
                            "target_lang_translations": {
                                "ru": "Механику пришлось счищать накопившийся <w>нагар</w> с клапанов двигателя, чтобы он работал плавно.",
                                "zh": "技工必须清理发动机气门上堆积的<w>积碳</w>，以使其运行顺畅。"
                            }
                        },
                        {
                            "text": "Every week she wiped the black <w>carbon</w> from the glass of the oil lamp.",
                            "target_lang_translations": {
                                "ru": "Каждую неделю она стирала черную <w>копоть</w> со стекла масляной лампы.",
                                "zh": "她每周都会擦掉油灯玻璃上的黑色<w>煤烟</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "carbon buildup",
                        "carbon deposit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Черный налет сажи или нагара, часто образующийся внутри двигателей или на лампах.",
                        "zh": "燃烧产生的黑色沉积物或积垢，常出现在发动机内部或灯具上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нагар",
                                "target_lang_sense_clarification": "твердый осадок в механизмах"
                            },
                            {
                                "target_lang_word": "сажа",
                                "target_lang_sense_clarification": "черный налет"
                            },
                            {
                                "target_lang_word": "копоть",
                                "target_lang_sense_clarification": "осадок от дыма"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "积碳",
                                "target_lang_sense_clarification": "发动机内的沉积物"
                            },
                            {
                                "target_lang_word": "炭黑",
                                "target_lang_sense_clarification": "黑色沉积物"
                            },
                            {
                                "target_lang_word": "煤烟",
                                "target_lang_sense_clarification": "燃烧产生的烟垢"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f82141e-7714-3c10-93f6-003baf8d96b3",
                    "sense_definition": "A copy of a document made using carbon paper.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "copy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please keep the original contract and give the client a <w>carbon</w> for their records.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, оставьте оригинал договора себе, а клиенту дайте <w>копию</w> для архива.",
                                "zh": "请保留原始合同，并给客户一份<w>复写件</w>以供存档。"
                            }
                        },
                        {
                            "text": "He pressed down hard with his pen to ensure he was making a clear <w>carbon</w>.",
                            "target_lang_translations": {
                                "ru": "Он сильно давил ручкой, чтобы убедиться, что получается четкая <w>копия</w>.",
                                "zh": "他用力按压钢笔，以确保能留下一份清晰的<w>复写件</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "copy"
                    ],
                    "common_phrases": [
                        "carbon copy",
                        "carbon paper"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to older technology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Копия документа, сделанная с помощью копировальной бумаги.",
                        "zh": "使用复写纸制作的文件副本。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "копия",
                                "target_lang_sense_clarification": "документ"
                            },
                            {
                                "target_lang_word": "копирка",
                                "target_lang_sense_clarification": "копировальная бумага (разг.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "复写件",
                                "target_lang_sense_clarification": "文件副本"
                            },
                            {
                                "target_lang_word": "副本",
                                "target_lang_sense_clarification": "文件的复制品"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cfc1db97-b21b-3811-833c-685b1724f686",
                    "sense_definition": "To send a copy of an email or message to someone other than the main recipient.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "email",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When you send the report to the manager, please <w>carbon</w> me so I have a record of it.",
                            "target_lang_translations": {
                                "ru": "Когда будешь отправлять отчет менеджеру, пожалуйста, <w>поставь меня в копию</w>, чтобы у меня он тоже сохранился.",
                                "zh": "当你把报告发给经理时，请<w>抄送</w>给我，这样我也有记录。"
                            }
                        },
                        {
                            "text": "I will <w>carbon</w> the entire team on this announcement to keep everyone informed.",
                            "target_lang_translations": {
                                "ru": "Я <w>поставлю в копию</w> всю команду в этом объявлении, чтобы держать всех в курсе.",
                                "zh": "我会将此公告<w>抄送</w>给整个团队，以确保每个人都知情。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cc",
                        "copy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отправить копию электронного письма кому-то еще, помимо основного получателя.",
                        "zh": "将电子邮件或消息的副本发送给主要收件人以外的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поставить в копию",
                                "target_lang_sense_clarification": "действие с email"
                            },
                            {
                                "target_lang_word": "отправить копию",
                                "target_lang_sense_clarification": "переслать сообщение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抄送",
                                "target_lang_sense_clarification": "电子邮件功能"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f371a7af-2ff3-321c-9de4-c1eab267484f",
                    "sense_definition": "A place name used for several towns and communities in North America.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small village of <w>Carbon</w> during their trip through Alberta.",
                            "target_lang_translations": {
                                "ru": "Во время путешествия по Альберте они посетили небольшую деревню <w>Карбон</w>.",
                                "zh": "他们在穿越阿尔伯塔省的旅途中参观了卡本这个小村庄。"
                            }
                        },
                        {
                            "text": "The town of <w>Carbon</w> was originally founded as a mining community.",
                            "target_lang_translations": {
                                "ru": "Город <w>Карбон</w> был изначально основан как шахтерское поселение.",
                                "zh": "卡本镇最初是作为一个矿业社区建立的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название нескольких городов и населенных пунктов в Северной Америке.",
                        "zh": "北美几个城镇和社区的地名。"
                    },
                    "translations": {
