                                    },
                                    {
                                        "sense_id": "983ac356-e4e7-3a1c-9508-a620ba7e3202",
                                        "entry_id": "66763868-4dc5-3e11-bfad-9a31d6def198",
                                        "glosses": [
                                            "Cheval de chasse adapté en particulier au franchissement d’obstacles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "592c0104-38ee-4010-b063-cf8cde263a24",
                                                "sense_id": "983ac356-e4e7-3a1c-9508-a620ba7e3202",
                                                "text": "– C’est sans doute un demi-sang. On voit tout de suite qu’il a une grande sûreté dans les jambes. S’il était dressé sur l’obstacle, il ferait un très bon hunter."
                                            }
                                        ]
                                    }
