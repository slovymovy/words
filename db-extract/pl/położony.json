                    {
                        "sense_id": "aeb60692-d13c-312e-836d-3e9a7d6fbf54",
                        "entry_id": "19f0cce8-d53c-3339-8475-be0f9a270552",
                        "glosses": [
                            "znajdujący się, usytuowany w danym miejscu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416f389e-b9e4-4921-b5ba-0862c60ec64f",
                                "sense_id": "aeb60692-d13c-312e-836d-3e9a7d6fbf54",
                                "text": "Czy wiecie, gdzie znajduje się najniżej położony punkt w Polsce?"
                            },
                            {
                                "example_id": "15a8bfce-7d2a-4217-aa20-cf29a383eb55",
                                "sense_id": "aeb60692-d13c-312e-836d-3e9a7d6fbf54",
                                "text": "Zamek wieluński był wówczas obiektem złożonym z zamku właściwego oraz z położonego przy nim przygródka."
                            },
                            {
                                "example_id": "93c5f0ff-eab1-4a44-acf9-d52463eb8459",
                                "sense_id": "aeb60692-d13c-312e-836d-3e9a7d6fbf54",
                                "text": "Widziałam piękny zamek położony pośród zielonych wzgórz."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "47e288ce-8fc4-3402-ad74-a47f38760b0b",
