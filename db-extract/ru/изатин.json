                "senses": [
                    {
                        "sense_id": "c9357336-bc37-3884-a26b-c0a8a763f752",
                        "entry_id": "b2a6ff68-7f7e-3e96-9e54-e379a835b24f",
                        "glosses": [
                            "хим. индол-2,3-дион; органическое соединение, представляющее собой красные кристаллы, труднорастворимые в воде"
                        ],
