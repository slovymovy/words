                                                "sense_id": "e6244ed0-9d79-3d6f-af75-2b4120868bfb",
                                                "text": "L’admissibilité au baccalauréat, à la licence."
                                            },
                                            {
                                                "example_id": "e02b074b-eb96-4f1f-8cd5-2df3c892e099",
                                                "sense_id": "e6244ed0-9d79-3d6f-af75-2b4120868bfb",
                                                "text": "L’admissibilité reste acquise dans certains examens."
                                            }
