                                            {
                                                "example_id": "f69490e8-d813-4a17-9fee-cfa0877c002c",
                                                "sense_id": "c66c42b0-3c16-3cb3-9690-b6d39399f1ab",
                                                "text": "Je pris l'habitude, à l'imitation des goumiers et des bellahs, d'aller pisser accroupi, à flanc de dune, pour parer au risque de m’humidifier le saroual par vent tourbillonnant et parce qu'en terre d'Islam, ce besoin est à satisfaire discrètement."
                                            },
                                            {
                                                "example_id": "dc6cc5a1-d483-409a-8c44-5845ded5bbf0",
                                                "sense_id": "c66c42b0-3c16-3cb3-9690-b6d39399f1ab",
                                                "text": "En glissant vers le sud, ces vents se tropicalisent et s’humidifient sur la mer de Chine méridionale entraînant de fortes pluies sur les côtes est et nord de l’ensemble régional."
                                            }
                                        ]
