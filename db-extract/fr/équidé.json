                        "glosses": [
                            "Tout mammifère ongulé membre de la famille zoologique des Equidae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1901d5-d38a-4146-94b0-6fb66b52cbf8",
                                "sense_id": "1ed1fca0-1c72-392c-9a40-73b0b19f6dcb",
                                "text": "Pensez bien qu’à chaque fois qu’un équidé est indisponible, ce sont les autres qui assument sa charge de travail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88e11db9-ab04-4211-a261-b41827da49e8",
                        "source_entry_id": "4747b74f-8883-3a64-842b-2180630ff797",
                        "source_sense_id": "1ed1fca0-1c72-392c-9a40-73b0b19f6dcb",
                        "target_lang_word": "Pferd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pferd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a6f86d8d-3d85-35b7-b176-78753f106139",
                                        "entry_id": "54e24860-57bd-3c60-808a-6bc8e721a223",
                                        "glosses": [
                                            "ein Haustier, Nutztier und Reittier, das Hauspferd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a555823c-d36c-47b7-9a8c-76b29e87e58d",
                                                "sense_id": "a6f86d8d-3d85-35b7-b176-78753f106139",
                                                "text": "Das Pferd wiehert."
                                            },
                                            {
                                                "example_id": "7e8581a1-f300-4247-bf5b-a2c628e02f6b",
                                                "sense_id": "a6f86d8d-3d85-35b7-b176-78753f106139",
                                                "text": "„Ein Pferd, ein Pferd, mein Königreich für ein Pferd!“"
                                            },
                                            {
                                                "example_id": "c8938b30-29bb-4ee8-8361-5f794eb3d80d",
                                                "sense_id": "a6f86d8d-3d85-35b7-b176-78753f106139",
                                                "text": "„Da Martin immer noch fürchtete, sie könnten ihm sein Pferd abnehmen, denn bei allen Regimentern fehlte es an Pferden, bat er um Aufnahme in das Muratsche Reitercorps.“"
                                            },
                                            {
                                                "example_id": "32d30c1d-1835-442b-be3d-b728990a75ee",
                                                "sense_id": "a6f86d8d-3d85-35b7-b176-78753f106139",
                                                "text": "„Die Pferde waren nicht zu sehen, und man hörte nur, wie sie durch den unsichtbaren Schmutz stampften.“"
                                            },
                                            {
                                                "example_id": "46bbba8f-c114-4c36-9005-8c4bbe74c6a7",
                                                "sense_id": "a6f86d8d-3d85-35b7-b176-78753f106139",
                                                "text": "„Der Cowboy begegnet einem anderen, der in schwarzer Trauerkleidung auf seinem Pferd daherkommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ee5196f3-f541-3b0a-bd30-104001d499a7",
                                        "entry_id": "54e24860-57bd-3c60-808a-6bc8e721a223",
                                        "glosses": [
                                            "Tier aus der Familie (Equidae) beziehungsweise der Gattung der Pferde (Equus)"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "890b2a54-d24a-3868-bb7c-5471a869efbf",
                                        "entry_id": "54e24860-57bd-3c60-808a-6bc8e721a223",
                                        "glosses": [
                                            "eine Schachfigur; der Springer"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "508a63f6-22c2-4cd9-90b9-49ee4ccc238a",
                                                "sense_id": "890b2a54-d24a-3868-bb7c-5471a869efbf",
                                                "text": "„Zweig verstand nicht viel vom Schach, nannte den Springer schon mal ‚Pferd‘ und vielleicht rührte daher sein Misstrauen gegenüber dem Spiel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "755950dc-8b5a-3fee-9304-0af841a297cb",
                                        "entry_id": "54e24860-57bd-3c60-808a-6bc8e721a223",
                                        "glosses": [
                                            "ein Sportgerät im Turnsport"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "556992d5-0114-4319-be47-c997e8cdb9ca",
                                                "sense_id": "755950dc-8b5a-3fee-9304-0af841a297cb",
                                                "text": "Er ist gut am Pferd."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
