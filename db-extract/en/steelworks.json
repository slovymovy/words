                        "target_lang_word": "Stahlwerk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stahlwerk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                        "entry_id": "0e38579e-d0d3-3cd3-8746-38733d20fcc5",
                                        "glosses": [
                                            "ein Werk, das Stahl herstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "626ee860-42f8-4dd8-bccb-c4d5ffc4dc69",
                                                "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                                "text": "Das ehemalige Stahlwerk ist heute eine Ruine."
                                            },
                                            {
                                                "example_id": "f1572485-455c-42b2-bc11-7b51bbbc9a77",
                                                "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                                "text": "„Denn ein sehr großer Teil der CO₂-Einsparung in Rohrdorf geht schon jetzt auf eine geänderte Rezeptur mit einen höheren Anteil etwa von Hochofenschlacke aus Stahlwerken zurück.“"
                                            },
                                            {
                                                "example_id": "df92f94e-3fa6-4e79-9ca5-ce2a5d299795",
                                                "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                                "text": "„Puyi fühlte sich in seiner Rolle nicht ganz wohl, denn er hatte kaum anderes zu tun, als japanische Verordnungen zu unterzeichnen und Stahlwerke, Straßenbrücken und Eisenbahnlinien zu eröffnen.“"
                                            },
                                            {
                                                "example_id": "90ca6ff9-07a0-445d-aed3-fb8e78086c13",
                                                "sense_id": "e58875b4-d8b2-3034-acda-30620f4f1a57",
                                                "text": "„Großes Gewicht maßen die Sowjets Stahlwerken, der Sperrholzindustrie und Hydrieranlagen bei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
