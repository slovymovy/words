{
    "word_family": [
        "galaxy",
        "extragalactic",
        "intergalactic",
        "intragalactic"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "37dfa1c1-5735-3715-9457-3e8e53acdc04",
                    "sense_definition": "Relating to or concerning a galaxy or galaxies.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Telescopes captured images of a massive <w>galactic</w> collision occurring millions of light-years away.",
                            "target_lang_translations": {
                                "zh": "望远镜捕捉到了数百万光年外一场巨大的<w>星系</w>碰撞图像。"
                            }
                        },
                        {
                            "text": "Scientists observed clouds of dust swirling around the bright <w>galactic</w> center.",
                            "target_lang_translations": {
                                "zh": "科学家观测到了围绕明亮的<w>星系</w>中心盘旋的尘埃云。"
                            }
                        }
                    ],
                    "antonyms": [
                        "extragalactic"
                    ],
                    "common_phrases": [
                        "galactic center",
                        "galactic cluster",
                        "galactic system"
                    ],
                    "target_lang_definitions": {
                        "zh": "与星系有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "星系的",
                                "target_lang_sense_clarification": "泛指星系"
                            },
                            {
                                "target_lang_word": "星系",
                                "target_lang_sense_clarification": "作定语修饰名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3d452e77-972d-3f93-b0c9-f473b95c58e4",
                    "sense_definition": "Specifically relating to the Milky Way galaxy.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our solar system orbits the center of the <w>galactic</w> disk once every few hundred million years.",
                            "target_lang_translations": {
                                "zh": "我们的太阳系每隔数亿年绕<w>银河</w>盘中心公转一周。"
                            }
                        },
                        {
                            "text": "Her research focused primarily on <w>galactic</w> astronomy and the chemical evolution of the Milky Way.",
                            "target_lang_translations": {
                                "zh": "她的研究主要侧重于<w>银河系</w>天文学以及银河系的化学演化。"
                            }
                        }
                    ],
                    "synonyms": [
                        "Galactic"
                    ],
                    "antonyms": [
                        "extragalactic"
                    ],
                    "common_phrases": [
                        "galactic disk",
                        "galactic plane"
                    ],
                    "target_lang_definitions": {
                        "zh": "特指与银河系有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银河系的",
                                "target_lang_sense_clarification": "特指银河系"
                            },
                            {
                                "target_lang_word": "银河",
                                "target_lang_sense_clarification": "作定语修饰名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37faa743-be34-3763-9c8b-69eb5b2c5f45",
                    "sense_definition": "Enormous in size, extent, or significance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The financial mismanagement created a mess of <w>galactic</w> proportions for the new administration.",
                            "target_lang_translations": {
                                "zh": "财务管理不善给新一届政府留下了一个<w>极其巨大</w>的烂摊子。"
                            }
                        },
                        {
                            "text": "Winning the competition had a <w>galactic</w> impact on her emerging career as a classical pianist.",
                            "target_lang_translations": {
                                "zh": "赢得这次比赛对她作为古典钢琴家初露头角的职业生涯产生了<w>巨大</w>影响。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "galactic proportions",
                        "galactic impact"
                    ],
                    "target_lang_definitions": {
                        "zh": "规模、程度或重要性极其巨大的；天文数字般的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "巨大的",
                                "target_lang_sense_clarification": "规模或程度极大的"
                            },
                            {
                                "target_lang_word": "天文数字般的",
                                "target_lang_sense_clarification": "形容数量或规模极其庞大"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf69c62d-94fa-3ac7-8d0f-e8bb5b1ff70c",
                    "sense_definition": "Pertaining to milk or the secretion of milk.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Early medical texts occasionally referred to lactic substances using the term <w>galactic</w> acid.",
                            "target_lang_translations": {
                                "zh": "早期的医学文献偶尔会用“<w>乳</w>酸”这一术语来指代乳类物质。"
                            }
                        },
                        {
                            "text": "The biochemist analyzed the <w>galactic</w> secretions extracted during the mammalian study.",
                            "target_lang_translations": {
                                "zh": "生物化学家分析了哺乳动物研究过程中提取出的<w>乳汁</w>分泌物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "galactic acid"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic scientific terminology relating to milk."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（古旧或罕见生物学用语）乳汁的；催乳的或与泌乳有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "乳汁的",
                                "target_lang_sense_clarification": "与乳汁相关的"
                            },
                            {
                                "target_lang_word": "乳的",
                                "target_lang_sense_clarification": "古代生物或医学用语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c4c418c0-415d-3888-adbd-b7d9c57beeac",
                    "sense_definition": "A common language spoken throughout a galaxy, featured in various works of science fiction.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "fictional_name",
                    "examples": [
                        {
                            "text": "The traveler was relieved to discover that the alien merchant understood standard <w>Galactic</w>.",
                            "target_lang_translations": {
                                "zh": "旅行者欣慰地发现这位外星商人懂得标准<w>银河通用语</w>。"
                            }
                        },
                        {
                            "text": "Diplomats from across the star systems communicated almost exclusively in fluent <w>Galactic</w>.",
                            "target_lang_translations": {
                                "zh": "来自各个恒星系统的外交官几乎完全使用流利的<w>银河语</w>进行交流。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "speak Galactic",
                        "standard Galactic"
                    ],
                    "target_lang_definitions": {
                        "zh": "（科幻作品中的）银河共通语，星系通用语。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "银河通用语",
                                "target_lang_sense_clarification": "科幻设定中全银河流通的语言"
                            },
                            {
                                "target_lang_word": "银河语",
                                "target_lang_sense_clarification": "科幻设定中的银河系通用语言"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}