            {
                "entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                "word": "quitter",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d7b53621-6076-45d9-9bda-bacf5076abbf",
                        "entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                        "tags": [
                            "plural"
                        ],
                        "form": "quitters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "623d5940-2f80-3392-bc5e-f4d42b64d229",
                        "entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                        "glosses": [
                            "One who quits, as:",
                            "One who gives in."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c613c592-15ed-4801-8f64-ba9f1aa37e2d",
                                "sense_id": "623d5940-2f80-3392-bc5e-f4d42b64d229",
                                "text": "Winners never quit and quitters never win."
                            },
                            {
                                "example_id": "5fbd31d3-24fd-4b3e-acf6-bd346add9e2a",
                                "sense_id": "623d5940-2f80-3392-bc5e-f4d42b64d229",
                                "text": "Don't be a quitter — hang in there!"
                            },
                            {
                                "example_id": "45129757-2f9d-40c7-9a09-d3b40a76e4ba",
                                "sense_id": "623d5940-2f80-3392-bc5e-f4d42b64d229",
                                "text": "I have never been a quitter. To leave office before my term is completed is abhorrent to every instinct in my body. But as president, I must put the interests of America first."
                            },
                            {
                                "example_id": "c6fc26e2-0373-4143-9fbc-b6441daa8fa8",
                                "sense_id": "623d5940-2f80-3392-bc5e-f4d42b64d229",
                                "text": "Well, they underestimated Hartlepool, and they underestimated me because I am a fighter and not a quitter!"
                            }
                        ]
                    },
                    {
                        "sense_id": "5af8e0c7-912d-3d05-9997-376ce84d530a",
                        "entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                        "glosses": [
                            "One who quits, as:",
                            "One who succeeds in desisting from a vice, especially smoking, drinking, or drugging."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d1e200-e9b4-426d-aa36-8415ded0fd81",
                                "sense_id": "5af8e0c7-912d-3d05-9997-376ce84d530a",
                                "text": "Quitters are winners! If you can't quit on the first try, hang in there and try to quit again!"
                            }
                        ]
                    },
                    {
                        "sense_id": "767cd188-be91-3fa0-891b-6f33a6b0d043",
                        "entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                        "glosses": [
                            "A leaver."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e8b721e0-c6e6-3f45-851e-12d4e23a1917",
                        "entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                        "glosses": [
                            "A deliverer."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d15272cc-e30b-4f6d-a9c9-d39e876520b3",
                        "source_entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                        "source_sense_description": "one who quits",
                        "target_lang_word": "Aufgeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9caf1945-9efb-4e07-822c-12849ae71a84",
                        "source_entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                        "source_sense_description": "one who quits",
                        "target_lang_word": "Feigling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feigling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                        "entry_id": "68d08fb9-82ee-3a71-b31a-97dbe7378338",
                                        "glosses": [
                                            "furchtsame, ängstliche, risikoscheue Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ef2bf05-5c64-4b48-9be2-42eab284e81d",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "Sei kein solcher Feigling und sag deinem Chef endlich mal richtig die Meinung!"
                                            },
                                            {
                                                "example_id": "80b97be5-baa2-4700-9ea8-f667b9670c3b",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Wer eine Familie mit fünf Töchtern gründet, kann kein Feigling sein.“"
                                            },
                                            {
                                                "example_id": "8dcd235e-67cb-432f-ad58-cf295d7da7d0",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Anstatt seinen Leuten zu Hilfe zu kommen, drehte sich dieser jämmerliche Feigling plötzlich um und gab Fersengeld.“"
                                            },
                                            {
                                                "example_id": "3b0e40a9-db73-4956-a505-614ed72cb053",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "„Nun schämten sich die Moskowiter wohl, dass sie als Feiglinge bezeichnet wurden, und schämten sich, dass sie wegfuhren, fuhren aber trotzdem weg, weil sie wussten, dass es sein musste.“"
                                            },
                                            {
                                                "example_id": "9e39e1ca-6039-4809-8fbb-6bfd8778ba3c",
                                                "sense_id": "300dcb0f-a77d-32ff-bd68-d85110064d2c",
                                                "text": "(„Soll ich da mal rüberbalancieren?“) – „Tu doch, mach doch, Feigling!“ – (Mögliche Antwort:) „Lieber ein Feigling sein, als einem Doofen ein’n Gefallen tun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e9ccac3-53c6-4699-9cff-b4e1e5d14bcf",
                        "source_entry_id": "6d9552b1-b2f9-3b57-bee9-184b2add5409",
                        "source_sense_description": "one who quits",
                        "target_lang_word": "Schlappschwanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schlappschwanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                        "entry_id": "f1d31cf5-dc95-3081-917d-ad2ae1bae0b7",
                                        "glosses": [
                                            "willensschwacher, weichlicher, auch feiger Mensch"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fff96fc1-2b40-42c8-9a98-c35c6e4fbbbc",
                                                "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                                "text": "Du traust dich nicht, allein in den Keller zu gehen? Was bist du denn für ein Schlappschwanz?"
                                            },
                                            {
                                                "example_id": "d997a792-87e7-4951-a848-b5abb40abd39",
                                                "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                                "text": "„Sie nutzte die Gelegenheit, um sich über Luciens Theorien lustig zu machen, und nannte ihn sogar einen Schlappschwanz.“"
                                            },
                                            {
                                                "example_id": "7a931cef-6c17-4b56-ba5a-df7bf94a9d55",
                                                "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                                "text": "„Ansonsten ist Robert ein Schlappschwanz und tut auch gar nicht erst so, als ob er keiner wäre.“"
                                            },
                                            {
                                                "example_id": "939e0e2a-fe44-4233-bfe7-fc3822502dcd",
                                                "sense_id": "0cd9da75-51b6-3fd8-932a-8d529532af6e",
                                                "text": "„Der Autor, John Steinbeck, war ein Schlappschwanz gewesen, zu schissig, um etwas geschehen zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4393de51-7f16-36b9-97fc-fde358b18c8b",
                                        "entry_id": "f1d31cf5-dc95-3081-917d-ad2ae1bae0b7",
                                        "glosses": [
                                            "impotenter Mann, Liebhaber ohne Temperament"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "969d7b20-0761-4a25-874d-b85753257cce",
                                                "sense_id": "4393de51-7f16-36b9-97fc-fde358b18c8b",
                                                "text": "Erst hat er den ganzen Abend mit seinen Qualitäten als Liebhaber geprahlt und dann erweist er sich im Bett als echter Schlappschwanz."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
