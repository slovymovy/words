                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The convoy moved safely through the <swept> channel.",
                            "target_lang_translations": {
                                "ru": "Конвой безопасно прошел через <протраленный> канал.",
                                "zh": "车队安全地通过了<w>已扫雷的</w>航道。"
