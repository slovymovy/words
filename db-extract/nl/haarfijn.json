                ],
                "senses": [
                    {
                        "sense_id": "d98fb1c8-9a68-394c-8c5b-0020517bafae",
                        "entry_id": "ebde5277-5245-348c-a865-fdf280ca91be",
                        "glosses": [
                            "heel precies en nauwkeurig met alles rekening houdend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de8b8668-5cc0-4744-a8f4-04817d180b66",
                                "sense_id": "d98fb1c8-9a68-394c-8c5b-0020517bafae",
                                "text": "‘Als kind al besefte ik dat mijn opa anders was dan anderen, met dat vreselijke nummer op zijn arm. Ik voelde haarfijn aan dat het niet iets alledaags was. En nog iedere keer als ik hem opzoek word ik daarmee opnieuw geconfronteerd."
                            },
                            {
                                "example_id": "b917f953-7fa2-4b87-a9bd-f5fff008adde",
                                "sense_id": "d98fb1c8-9a68-394c-8c5b-0020517bafae",
                                "text": "Met de zalvende domineeswoorden dat zijn tafel voor iedereen is en dat iedereen daar zijn verhaal mag doen. Op een ding had de redactie niet gerekend: dat Douwes bleef zitten. Slim, vond ik. Want zo kon ze ons kijkers haarfijn uitleggen op welke schandalige wijze ze genaaid werd door Twan en zijn redactie."
                            }
                        ]
                    }
