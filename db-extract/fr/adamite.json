            {
                "entry_id": "5b36e691-5381-3862-b806-ccf780240c0e",
                "word": "adamite",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e26f3794-2f66-469e-92ea-4d6894d8b3e5",
                        "entry_id": "5b36e691-5381-3862-b806-ccf780240c0e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
