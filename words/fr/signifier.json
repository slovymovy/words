                {
                    "sense_id": "0697aef5-d8ee-31d2-b2e6-02efe4866237",
                    "sense_definition": "Être l'indice ou la marque de quelque chose ; donner à penser.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sens_linguistique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le ciel sombre ne <w>signifie</w> pas forcément qu'il va pleuvoir aujourd'hui.",
                            "target_lang_translations": {
                                "en": "Dark skies don't necessarily <w>mean</w> it's going to rain today.",
                                "ru": "Тёмное небо не обязательно <w>значит</w>, что сегодня будет дождь.",
                                "nl": "Een donkere lucht <w>betekent</w> niet per se dat het vandaag gaat regenen.",
                                "pl": "Ciemne niebo niekoniecznie <w>oznacza</w>, że dzisiaj będzie padać.",
                                "it": "Un cielo scuro non <w>significa</w> necessariamente che oggi pioverà.",
                                "cs": "Tmavá obloha nemusí nutně <w>nasvědčovat</w> tomu, že dnes bude pršet.",
                                "tr": "Karanlık bir gökyüzü, bugün mutlaka yağmur yağacağı anlamına <w>gelmez</w>.",
                                "es": "Un cielo oscuro no <w>significa</w> necesariamente que vaya a llover hoy.",
                                "zh": "天色暗沉并不一定<w>意味着</w>今天会下雨。",
                                "de": "Ein dunkler Himmel <w>bedeutet</w> nicht unbedingt, dass es heute regnen wird."
                            }
                        },
                        {
                            "text": "Son silence prolongé <w>signifie</w> sans doute qu'il n'est pas d'accord.",
                            "target_lang_translations": {
                                "en": "His prolonged silence probably <w>means</w> he doesn't agree.",
                                "ru": "Его затянувшееся молчание, вероятно, <w>значит</w>, что он не согласен.",
                                "nl": "Zijn langdurige stilte <w>betekent</w> waarschijnlijk dat hij het er niet mee eens is.",
                                "pl": "Jego przeciągające się milczenie zapewne <w>oznacza</w>, że się nie zgadza.",
                                "it": "Il suo lungo silenzio <w>significa</w> probabilmente che non è d'accordo.",
                                "cs": "Jeho dlouhé mlčení <w>nasvědčuje</w> tomu, že asi nesouhlasí.",
                                "tr": "Uzun süren sessizliği, büyük ihtimalle onun katılmadığı <w>anlamına geliyor</w>.",
                                "es": "Su silencio prolongado <w>significa</w> probablemente que no está de acuerdo.",
                                "zh": "他长时间的沉默很可能<w>表明</w>他不同意。",
                                "de": "Sein langes Schweigen <w>bedeutet</w> wohl, dass er nicht einverstanden ist."
                            }
                        }
