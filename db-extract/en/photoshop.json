                                                "sense_id": "d5833e0c-4e3a-3a6e-9aa1-46b54777a7ca",
                                                "text": "„Wir können deinen Vater doch photoshoppen.“"
                                            },
                                            {
                                                "example_id": "11a11e1f-94df-4a75-8c41-24d0753ffafc",
                                                "sense_id": "d5833e0c-4e3a-3a6e-9aa1-46b54777a7ca",
                                                "text": "„In einer Serie von Straßenszenen kontrastiert der in New York lebende Fotograf Natan Dvir photogeshoppte Werbewelten mit der weit weniger perfekten Realität der Passanten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
