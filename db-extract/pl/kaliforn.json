                        ]
                    },
                    {
                        "translation_id": "6bb9405c-5e3a-4ed1-b8cf-47f7419df60a",
                        "source_entry_id": "9e0c5bfc-b07f-3b7f-888f-b7caaca558f8",
                        "source_sense_id": "5c2449de-956b-349d-94ef-9d7270a3f987",
                        "target_lang_word": "калифорний",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "калифорний",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5001ddcb-3c2e-3f74-8bad-af6010047dbc",
                                        "entry_id": "4bd6f9c3-b277-357f-b7e8-80d066e1cf1b",
                                        "glosses": [
                                            "хим. химический элемент с атомным номером 98, обозначается химическим символом Cf, радиоактивный искусственно получаемый металл из ряда актиноидов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd5b9378-32e5-47f3-a4b0-1850933ee831",
                                                "sense_id": "5001ddcb-3c2e-3f74-8bad-af6010047dbc",
                                                "text": "Всего при его [Гиорсо] участии было открыто и синтезировано 12 новых элементов — америций, кюрий, берклий, калифорний, эйнштейний, фермий, менделевий, нобелий, лоуренсий, резерфордий, дубний, сиборгий."
                                            },
                                            {
                                                "example_id": "ca578c24-8a44-418f-95c4-16342de151d6",
                                                "sense_id": "5001ddcb-3c2e-3f74-8bad-af6010047dbc",
                                                "text": "Калифорний является самым дорогим в мире металлом. Радиоактивный химический элемент был искусственно получен в 1950 году в Калифорнийском университете Беркли. Процесс получения калифорния невероятно дорог. Но уникальные свойства элемента позволяют использовать его в нейтронно-активационном анализе, в сложнейших экспериментах по изучению деления ядер, в лучевой терапии опухолей."
                                            },
                                            {
                                                "example_id": "29271979-c7d6-4810-ba71-3640dc9108aa",
                                                "sense_id": "5001ddcb-3c2e-3f74-8bad-af6010047dbc",
                                                "text": "Калифорний — опасное и редкое радиоактивное вещество, используемое в ядерной физике и медицине."
                                            },
                                            {
                                                "example_id": "d52b9229-4d82-4d29-89e9-f7a11f5efeeb",
                                                "sense_id": "5001ddcb-3c2e-3f74-8bad-af6010047dbc",
                                                "text": "Хотя вполне логично предположить, что элемент, полученный в Университете Калифорнии в Беркли назван калифорнием в честь штата, в котором он был впервые получен, надо сказать, что для Глена Сиборга и его коллег придумать имя этому элементу оказалось непростым делом .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
