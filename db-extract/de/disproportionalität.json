                    {
                        "form_id": "60db436c-8f78-4f5d-88c1-efcef26a46d7",
                        "entry_id": "eaee5561-e65b-32d9-b210-a363aff139c6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Disproportionalitäten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cecf6c5b-635b-34e9-97db-2cf3adf06102",
                        "entry_id": "eaee5561-e65b-32d9-b210-a363aff139c6",
                        "glosses": [
                            "Eigenschaft, die aufzeigt, dass verschiedene verglichene Teile bei dem gleichen Kriterium eine unterschiedlich ausgeprägte (disproportionale) Ausprägung aufweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abdfe4f0-9d3e-47c0-abbc-887c68e0e1b9",
                                "sense_id": "cecf6c5b-635b-34e9-97db-2cf3adf06102",
                                "text": "„Zum Erfassen der Disproportionalität wird oftmals der sogenannte Gallagher-Index (G) herangezogen, der sich aus der Differenz des Stimmenanteils (vi) und des Sitzanteils (si) für jede im Parlament vertretene Partei ergibt.“"
                            },
                            {
                                "example_id": "01945f78-8205-409a-ba50-efd7a45326fb",
                                "sense_id": "cecf6c5b-635b-34e9-97db-2cf3adf06102",
                                "text": "„Im Einzelnen gilt: Disproportionalität, die bedingt, dass der Täter oder die in Gefahr befindliche ihm nahe stehende Person die Gefahr hinzunehmen hat, liegt nur dann vor, wenn ein besonders krasses Missverhältnis zwischen Art und Maß des diesen Personen drohenden Schadens einerseits und den mit der Notstandshandlung verbundenen Rechtseinbußen andererseits besteht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
