                "senses": [
                    {
                        "sense_id": "09d1fba7-83c9-377b-b1f8-8a6b58f636ce",
                        "entry_id": "3eeb613d-c1fc-3213-8492-48d40fc722f0",
                        "glosses": [
                            "Donner un caractère portugais à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ea7e8ed-fe60-43c7-a8a8-471fc52c093e",
                                "sense_id": "09d1fba7-83c9-377b-b1f8-8a6b58f636ce",
                                "text": "Sur quoi vint à passer ce folâtre de Chamilly, retour du Portugal, qui, lui ayant emprunté ces textes vibrants, prit sur lui de les féminiser d’abord, de les « couventiniser » ensuite, de les « portugaliser » enfin – pour finir par les livrer à Barbin qui en fit l’usage que l'on sait."
                            },
                            {
                                "example_id": "e00bff4a-68a7-47d4-a41b-d956ed9ae8bc",
                                "sense_id": "09d1fba7-83c9-377b-b1f8-8a6b58f636ce",
                                "text": "C’est étrange comme nous nous sommes rapidement sudaméricanisés alors que nous n’avions jamais vraiment réussi à nous portugaliser."
                            }
                        ]
                    }
