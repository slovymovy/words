                        "examples": [
                            {
                                "example_id": "0f45f510-24c2-45c7-84d6-22b6593edcf0",
                                "sense_id": "a789d46a-612d-36a3-8245-ebdc7fd70f1e",
                                "text": "Самодержец ― Отец, самодержец и Сын, также и Дух Святый, не Три самодержавных, а Один самодержавный Бог, неслиянный, нераздельный, неразлучный Бог в Трех Лицах."
                            }
