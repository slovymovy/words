                                            "psychology"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "180069fc-f21f-4dcc-bf09-b62ffb15490f",
                                                "sense_id": "8f672c6b-b9ac-3330-9399-7e9445633a28",
                                                "text": "Egocentryzm jest pojęciem z psychologii rozwojowej i nie trzeba mu w tym wypadku nadawać negatywnego znaczenia. Bez fazy egocentryzmu nie sposób skonstruować swojego Ja"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "3684c6d0-4608-386b-9323-1c0799ed0b08",
                                        "entry_id": "c9ead4a2-9683-3362-95aa-5e44f9eecde5",
                                        "glosses": [
                                            "przecenianie swojego znaczenia w świecie, postrzeganie siebie jako ośrodka wszystkiego, odbieranie wszystkich wydarzeń w stosunku do własnej osoby"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15c4130a-3e11-426a-9d42-416dd4735290",
                                                "sense_id": "3684c6d0-4608-386b-9323-1c0799ed0b08",
                                                "text": "Innych trapi wyłącznie troska o własne bezpieczeństwo. Każdą przeszkodę traktują oni jako zagrożenie osobistego bezpieczeństwa i osobistego prestiżu (…). Egocentryzm przybiera różne formy"
                                            },
                                            {
                                                "example_id": "6fd50a12-79db-40ab-9d74-5fd17014aac5",
                                                "sense_id": "3684c6d0-4608-386b-9323-1c0799ed0b08",
                                                "text": "Błędne koło, w jakim tkwi autorka świadectwa, nakręca tylko jej egocentryzm i skupienie się na sobie, na kochaniu tylko siebie, kochaniu swojego ciała, cieszeniu się swoją kobiecością itp."
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
