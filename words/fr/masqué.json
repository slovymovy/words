    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6580edad-9d16-3c71-8bc9-216ecb861b51",
                    "sense_definition": "Qui porte un masque sur le visage pour dissimuler son identité ou pour se protéger.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "dissimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un homme <w>masqué</w> est entré dans la banque avant d'exiger tout l'argent."
                        },
                        {
                            "text": "Pendant le festival, des comédiens <w>masqués</w> déambulaient silencieusement dans les ruelles."
                        }
                    ],
                    "antonyms": [
                        "démasqué"
                    ],
                    "common_phrases": [
                        "homme masqué",
                        "individu masqué"
                    ]
                },
                {
                    "sense_id": "c8c8fe14-281c-346f-8748-ef6a4d70c3b0",
                    "sense_definition": "Où les participants portent un masque et un déguisement, en parlant d'un bal ou d'une fête.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "festivite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a acheté une robe élégante pour assister à un grand bal <w>masqué</w> au château."
                        },
                        {
                            "text": "Le village organise chaque hiver une fête <w>masquée</w> très populaire auprès des enfants."
                        }
                    ],
                    "common_phrases": [
                        "bal masqué",
                        "fête masquée"
                    ]
                },
                {
                    "sense_id": "bdd9bc10-b729-3bb5-b75e-33d0e5505acd",
                    "sense_definition": "Dont la face ou la tête présente une couleur ou un dessin particulier évoquant un masque, en parlant d'un animal.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "apparence_animale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce canard <w>masqué</w> est facilement reconnaissable grâce aux plumes sombres autour de ses yeux."
                        },
                        {
                            "text": "Nous avons observé un passereau <w>masqué</w> perché sur une haute branche."
                        }
                    ]
                },
                {
                    "sense_id": "5fdcaa4a-2ef7-3ed1-8e14-3b5f60375af2",
                    "sense_definition": "Fermé, renfrogné ou hostile, en parlant de l'expression d'un visage.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle est restée le visage <w>masqué</w> par la colère après avoir entendu la mauvaise nouvelle."
                        },
                        {
                            "text": "Son attitude <w>masquée</w> et distante laissait deviner une rancune persistante."
                        }
                    ],
                    "synonyms": [
                        "renfrogné",
                        "sombre"
                    ],
                    "antonyms": [
                        "ouvert",
                        "radieux"
                    ],
                    "common_phrases": [
                        "visage masqué"
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9313fe1a-3e16-32dc-af75-62c44586efc1",
                    "sense_definition": "Participe passé masculin singulier du verbe <w>masquer</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le brouillard épais a <w>masqué</w> le sommet de la montagne toute la matinée."
                        },
                        {
                            "text": "Ce grand bâtiment moderne a entièrement <w>masqué</w> la vue sur la mer."
                        }
                    ],
                    "synonyms": [
