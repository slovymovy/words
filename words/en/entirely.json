                    "sense_id": "a6455878-13f0-3a11-a88e-14bbd393a07d",
                    "sense_definition": "To the full or entire extent.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is <w>entirely</w> up to you to decide where we go for dinner.",
                            "target_lang_translations": {
                                "ru": "Решение, куда мы пойдем ужинать, зависит <w>полностью</w> от тебя.",
                                "zh": "去哪儿吃晚饭由你<w>完全</w>决定。",
                                "pl": "To <w>całkowicie</w> od ciebie zależy, gdzie pójdziemy na kolację.",
                                "de": "Es liegt <w>völlig</w> bei dir zu entscheiden, wo wir zu Abend essen.",
                                "nl": "Het is <w>helemaal</w> aan jou om te beslissen waar we gaan eten.",
                                "fr": "C'est <w>entièrement</w> à toi de décider où nous allons dîner.",
                                "it": "Sta <w>completamente</w> a te decidere dove andare a cena.",
                                "cs": "Rozhodnutí, kam půjdeme na večeři, závisí <w>zcela</w> na tobě.",
                                "tr": "Akşam yemeği için nereye gideceğimize karar vermek <w>tamamen</w> sana bağlı.",
                                "es": "Depende <w>completamente</w> de ti decidir a dónde vamos a cenar."
                            }
                        },
                        {
                            "text": "I am not <w>entirely</w> sure if the shop is open today.",
                            "target_lang_translations": {
                                "ru": "Я не <w>совсем</w> уверен, открыт ли сегодня магазин.",
                                "zh": "我不<w>完全</w>确定今天商店是否营业。",
                                "pl": "Nie jestem <w>zupełnie</w> pewien, czy sklep jest dzisiaj otwarty.",
                                "de": "Ich bin mir nicht <w>ganz</w> sicher, ob das Geschäft heute geöffnet ist.",
                                "nl": "Ik ben er niet <w>helemaal</w> zeker van of de winkel vandaag open is.",
                                "fr": "Je ne suis pas <w>tout à fait</w> sûr que le magasin soit ouvert aujourd'hui.",
                                "it": "Non sono <w>del tutto</w> sicuro che il negozio sia aperto oggi.",
                                "cs": "Nejsem si <w>úplně</w> jistý, zda má obchod dnes otevřeno.",
                                "tr": "Dükkânın bugün açık olup olmadığından <w>pek</w> emin değilim.",
                                "es": "No estoy <w>del todo</w> seguro de si la tienda está abierta hoy."
                            }
                        }
                    ],
