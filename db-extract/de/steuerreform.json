                ],
                "senses": [
                    {
                        "sense_id": "b420836b-4d7c-3397-9d5e-1683e22096db",
                        "entry_id": "43b2cae4-3a8b-39ea-9edd-1c8dd69d41fe",
                        "glosses": [
                            "eine größere Änderung, eine Reform, des Steuersystems oder Steuerrechts eines Staats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dee6035c-4526-4e9c-a9dd-44613d217cb6",
                                "sense_id": "b420836b-4d7c-3397-9d5e-1683e22096db",
                                "text": "„Die schwarz-gelbe Koalition erwägt einem Zeitungsbericht zufolge eine Aufspaltung der im Koalitionsvertrag vereinbarten Steuerreform in zwei Teile.“"
                            },
                            {
                                "example_id": "eab51540-c2a5-4df2-a497-467192b01099",
                                "sense_id": "b420836b-4d7c-3397-9d5e-1683e22096db",
                                "text": "„Die beste Steuerreform wäre dann die, die nicht stattfände. Steuerreformen, die Ungleichbehandlungen beseitigen sollen, können selbst Ungerechtigkeiten bewirken.“"
                            },
                            {
                                "example_id": "76d01b33-f81d-4be6-92d8-ccfa23998a65",
                                "sense_id": "b420836b-4d7c-3397-9d5e-1683e22096db",
                                "text": "[Erbschaftssteuer:] „Heraus kam indes eine Steuerreform, bei der Firmenerben ihr Betriebsvermögen nach zehn Jahren steuerfrei versilbern können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
