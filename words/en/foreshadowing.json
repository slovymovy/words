{
    "word_family": [
        "foreshadow"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a7d3a31-5b62-3bb4-867f-efd98a22078e",
                    "sense_definition": "A literary device in which an author hints at or warns of events that will occur later in the story.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dark clouds gathering over the castle served as subtle <w>foreshadowing</w> of the impending tragedy.",
                            "target_lang_translations": {
                                "es": "Los nubarrones que se acumulaban sobre el castillo sirvieron como un sutil <w>presagio</w> de la inminente tragedia."
                            }
                        },
                        {
                            "text": "The roses blooming early was clever <w>foreshadowing</w> of the heroine's unexpected recovery.",
                            "target_lang_translations": {
                                "es": "El florecimiento temprano de las rosas fue una ingeniosa <w>prefiguración</w> de la inesperada recuperación de la heroína."
                            }
                        }
                    ],
                    "synonyms": [
                        "omen",
                        "premonition",
                        "forewarning"
                    ],
                    "common_phrases": [
                        "subtle foreshadowing",
                        "clever foreshadowing",
                        "heavy foreshadowing"
                    ],
                    "target_lang_definitions": {
                        "es": "Recurso literario en el que el autor insinúa o advierte sobre acontecimientos que sucederán más adelante en la historia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "prefiguración",
                                "target_lang_sense_clarification": "en literatura, anticipación de hechos futuros"
                            },
                            {
                                "target_lang_word": "presagio",
                                "target_lang_sense_clarification": "indicio o señal que anuncia algo por venir"
                            },
                            {
                                "target_lang_word": "anticipación",
                                "target_lang_sense_clarification": "recurso narrativo de adelantar acontecimientos"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f0f9de7f-042d-3406-a727-28ab6e4a7865",
                    "sense_definition": "Present participle and gerund of <w>foreshadow</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The writer began <w>foreshadowing</w> the hero's ultimate sacrifice early in the novel.",
                            "target_lang_translations": {
                                "es": "El escritor comenzó <w>a presagiar</w> el sacrificio final del héroe al principio de la novela."
                            }
                        },
                        {
                            "text": "By <w>foreshadowing</w> the storm in the opening chapter, the director built tension effectively.",
                            "target_lang_translations": {
                                "es": "Al <w>anticipar</w> la tormenta en el capítulo inicial, el director generó tensión eficazmente."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle and gerund"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Participio de presente y gerundio de foreshadow (prefigurar, presagiar o anticipar)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "prefigurando",
                                "target_lang_sense_clarification": "gerundio de prefigurar"
                            },
                            {
                                "target_lang_word": "presagiando",
                                "target_lang_sense_clarification": "gerundio de presagiar"
                            },
                            {
                                "target_lang_word": "anticipando",
                                "target_lang_sense_clarification": "gerundio de anticipar"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}