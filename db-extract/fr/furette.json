                "senses": [
                    {
                        "sense_id": "2b0e3755-8a26-3ae1-a6ad-f669230cd7d8",
                        "entry_id": "9a9dc808-1e01-37d7-a13b-8886e102e99d",
                        "glosses": [
                            "Femelle du furet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ba8d3e0-3550-46e0-8136-85ad0cb57776",
                                "sense_id": "2b0e3755-8a26-3ae1-a6ad-f669230cd7d8",
                                "text": "Le 19 janvier 1888, un chasseur du Havre nous adressait, aux fins d’autopsie, le cadavre d’une furette, qui avait succombé peu de temps après son mâle, en présentant comme lui des croûtes dans les oreilles."
                            },
                            {
                                "example_id": "394507fd-dd92-4cd7-86ca-49a20070f164",
                                "sense_id": "2b0e3755-8a26-3ae1-a6ad-f669230cd7d8",
                                "text": "Le furet qui rivalisait de fidélité avec le chien, et dont son maître ne parle qu’avec des larmes dans les yeux, était presque toujours une furette."
                            },
                            {
                                "example_id": "7a3e73d4-878c-44b8-9e31-c8951f2884ff",
                                "sense_id": "2b0e3755-8a26-3ae1-a6ad-f669230cd7d8",
                                "text": "Une furette a sept petits qu’elle mange aussitôt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ecc1aba-f9d0-407c-a575-7871e224ca9b",
                        "source_entry_id": "9a9dc808-1e01-37d7-a13b-8886e102e99d",
                        "source_sense_id": "2b0e3755-8a26-3ae1-a6ad-f669230cd7d8",
                        "target_lang_word": "jill",
                        "target_lang_code": "en",
