                "senses": [
                    {
                        "sense_id": "9e2ea3d9-bf10-34a4-bf8f-27113a06f622",
                        "entry_id": "2ea578dd-3358-31a7-97d4-ebce424f671d",
                        "glosses": [
                            "einfach gestalteter Raum auf einem Schiff, der für Andachten der Schiffsleute genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05ec4911-c6c1-4d04-b581-04b71d78aab9",
                                "sense_id": "9e2ea3d9-bf10-34a4-bf8f-27113a06f622",
                                "text": "„Malena selbst hatte sich vor seiner Rettung noch in die Schiffskapelle begeben, um Jesus anzuflehen, „so wenig Leute wie möglich sterben zu lassen“.“"
                            },
                            {
                                "example_id": "70626606-52f9-4eaf-8555-a3b3d909a0d9",
                                "sense_id": "9e2ea3d9-bf10-34a4-bf8f-27113a06f622",
                                "text": "„Wenn Sie von der Hostess zum Beispiel gebeten werden, sich für das Main Sitting in die Messe zu begeben, sollten Sie nicht die Schiffskapelle aufsuchen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e9d29203-8e0e-377b-b711-42a5bccd6f7a",
                        "entry_id": "2ea578dd-3358-31a7-97d4-ebce424f671d",
                        "glosses": [
                            "kleines, privates Musiker-Ensemble von Schiffsleuten, die Musik machen"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "9a3a7c8a-7665-4620-a6e0-c54d98410018",
                                "sense_id": "e9d29203-8e0e-377b-b711-42a5bccd6f7a",
                                "text": "„Als die Titanic unterging, soll die Schiffskapelle bis zum bitteren Ende gespielt haben.“"
                            },
                            {
                                "example_id": "bc42a925-802f-46fa-9388-5e463f276b8b",
                                "sense_id": "e9d29203-8e0e-377b-b711-42a5bccd6f7a",
                                "text": "„Am hörbarsten knüpft Halffter an Alban Bergs Opern an - bis hin zu einem symphonischen Satz, der die Sphären der alten und neuen Welt voneinander trennt, und bis zu der travestierenden Weise, in der er so etwas wie eine osteuropäische Nationalhymne in seinen Tonsatz integrierte, mit der die Schiffskapelle den Schachweltmeister Czentovic begrüßt.“"
                            },
                            {
                                "example_id": "0753e3a0-2ff2-48d7-b1f8-49bbef48ec0f",
                                "sense_id": "e9d29203-8e0e-377b-b711-42a5bccd6f7a",
                                "text": "„Die Violine von Wallace Hartley, dem Leiter der Schiffskapelle der Titanic, ist bei einer Auktion für 900.000 Britische Pfund versteigert worden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
