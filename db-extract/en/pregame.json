                "senses": [
                    {
                        "sense_id": "7fc40b44-8f40-3568-a48b-f6c2096b1b09",
                        "entry_id": "2c63045f-6a9f-3e90-9141-aaf916c02994",
                        "glosses": [
                            "To consume alcohol prior to an event."
                        ],
                        "tags": [
                            "intransitive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b9fe6181-4407-4eab-a090-0f73b96a1f44",
                                "sense_id": "7fc40b44-8f40-3568-a48b-f6c2096b1b09",
                                "text": "In some cases, pregaming is a precursor to the “real” drinking that will take place later that night at house parties or bars, but sometimes students pregame in order to get drunk before heading out to social activities[…]"
                            },
                            {
                                "example_id": "4979c2d3-bc32-4cf5-b4e4-14b3c6cf7d18",
                                "sense_id": "7fc40b44-8f40-3568-a48b-f6c2096b1b09",
                                "text": "After pregaming, Julia heads to the Kappa Alpha party, where she discovers an unopened bottle of vodka in the basement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9059b6a-029c-4fae-a38f-3bddcec19c87",
                        "source_entry_id": "2c63045f-6a9f-3e90-9141-aaf916c02994",
                        "source_sense_id": "7fc40b44-8f40-3568-a48b-f6c2096b1b09",
