{
    "word_family": [
        "seinen",
        "seingever",
        "seinpaal",
        "noodsein",
        "startsein"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b5aa9ac9-e514-3ca8-9fa8-06b038145270",
                    "sense_definition": "Een aanduiding, bericht of signaal dat aangeeft dat een actie mag beginnen of moet gebeuren.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eindelijk krijgt hij het <w>sein</w> om te beginnen met de werkzaamheden.",
                            "target_lang_translations": {
                                "en": "Finally he gets the <w>signal</w> to start the work.",
                                "ru": "Наконец он получает <w>сигнал</w> начать работу.",
                                "zh": "他终于收到了开始动工的<w>信号</w>。"
                            }
                        },
                        {
                            "text": "De scheidsrechter gaf het <w>sein</w> voor de start van de wedstrijd.",
                            "target_lang_translations": {
                                "en": "The referee gave the <w>signal</w> for the start of the match.",
                                "ru": "Судья дал <w>сигнал</w> к началу матча.",
                                "zh": "裁判发出了比赛开始的<w>信号</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "signaal",
                        "teken"
                    ],
                    "common_phrases": [
                        "het sein geven",
                        "wachten op het sein"
                    ],
                    "target_lang_definitions": {
                        "en": "An indication, message, or signal indicating that an action may start or must occur.",
                        "ru": "Указание, сообщение или сигнал, означающий, что действие может начаться или должно произойти.",
                        "zh": "表示某项行动可以开始或必须进行的指示、信息或信号。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "signal",
                                "target_lang_sense_clarification": "indication to start"
                            },
                            {
                                "target_lang_word": "cue",
                                "target_lang_sense_clarification": "prompt for action"
                            },
                            {
                                "target_lang_word": "sign",
                                "target_lang_sense_clarification": "indication"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "отмашка",
                                "target_lang_sense_clarification": "разрешение начать"
                            },
                            {
                                "target_lang_word": "знак",
                                "target_lang_sense_clarification": "условное обозначение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信号",
                                "target_lang_sense_clarification": "表示开始或行动的指示"
                            },
                            {
                                "target_lang_word": "指令",
                                "target_lang_sense_clarification": "指示行动的命令"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae190afd-fdf1-3059-a6c9-53d9167c6794",
                    "sense_definition": "Een installatie met lichten of borden langs een spoorweg die instructies geeft aan treinbestuurders.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het driehoekige groene <w>sein</w> gaf een maximumsnelheid voor het baanvlak aan.",
                            "target_lang_translations": {
                                "en": "The triangular green <w>signal</w> indicated a maximum speed for the track section.",
                                "ru": "Треугольный зеленый <w>сигнал</w> указывал максимальную скорость для участка пути.",
                                "zh": "三角形的绿色<w>信号机</w>指示了该区段的最高限速。"
                            }
                        },
                        {
                            "text": "De machinist moest direct remmen omdat het <w>sein</w> plotseling op rood sprong.",
                            "target_lang_translations": {
                                "en": "The train driver had to brake immediately because the <w>signal</w> suddenly turned red.",
                                "ru": "Машинист должен был немедленно затормозить, так как <w>сигнал</w> внезапно сменился на красный.",
                                "zh": "列车司机不得不立即刹车，因为<w>信号灯</w>突然变成了红灯。"
                            }
                        }
                    ],
                    "synonyms": [
                        "signaal"
                    ],
                    "common_phrases": [
                        "sein op rood",
                        "sein op groen",
                        "onveilig sein"
                    ],
                    "target_lang_definitions": {
                        "en": "An installation with lights or signs along a railway that gives instructions to train drivers.",
                        "ru": "Устройство с огнями или знаками вдоль железной дороги, дающее инструкции машинистам.",
                        "zh": "沿铁路线设置、向列车司机发出行驶指示的带灯光或标志的信号机装置。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "signal",
                                "target_lang_sense_clarification": "railway traffic light"
                            },
                            {
                                "target_lang_word": "railway signal",
                                "target_lang_sense_clarification": "technical term"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "железнодорожный термин"
                            },
                            {
                                "target_lang_word": "светофор",
                                "target_lang_sense_clarification": "световое устройство"
                            },
                            {
                                "target_lang_word": "семафор",
                                "target_lang_sense_clarification": "механическое устройство"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "信号机",
                                "target_lang_sense_clarification": "铁路信号装置"
                            },
                            {
                                "target_lang_word": "信号灯",
                                "target_lang_sense_clarification": "指示通行的灯光设备"
                            },
                            {
                                "target_lang_word": "信号",
                                "target_lang_sense_clarification": "铁路指示标志"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ac3d9d6-5de3-3a63-a65c-c14516a2dc96",
                    "sense_definition": "Een gebaar of beweging waarmee men iemand iets duidelijk maakt zonder woorden.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met zijn hoofd gaf hij het <w>sein</w> door te lopen naar de uitgang.",
                            "target_lang_translations": {
                                "en": "With his head he gave the <w>signal</w> to walk to the exit.",
                                "ru": "Кивком головы он дал <w>знак</w> идти к выходу.",
                                "zh": "他用点头<w>示意</w>大家朝出口走去。"
                            }
                        },
                        {
                            "text": "Hij gaf me een kort <w>sein</w> met zijn hand zodat ik wist dat ik kon komen.",
                            "target_lang_translations": {
                                "en": "He gave me a short <w>signal</w> with his hand so I knew I could come.",
                                "ru": "Он подал мне короткий <w>знак</w> рукой, чтобы я знал, что можно подходить.",
                                "zh": "他用手向我做了一个简短的<w>手势</w>，让我知道可以过去了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "teken"
                    ],
                    "common_phrases": [
                        "een sein geven"
                    ],
                    "target_lang_definitions": {
                        "en": "A gesture or movement used to communicate something without words.",
                        "ru": "Жест или движение, с помощью которого кому-то что-то объясняют без слов.",
                        "zh": "不用语言、仅通过手势或动作向他人传达意思的暗号或动作示意。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "signal",
                                "target_lang_sense_clarification": "communicative gesture"
                            },
                            {
                                "target_lang_word": "sign",
                                "target_lang_sense_clarification": "gesture"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "знак",
                                "target_lang_sense_clarification": "жест"
                            },
                            {
                                "target_lang_word": "сигнал",
                                "target_lang_sense_clarification": "условное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "示意",
                                "target_lang_sense_clarification": "动作暗示"
                            },
                            {
                                "target_lang_word": "暗号",
                                "target_lang_sense_clarification": "肢体或动作信号"
                            },
                            {
                                "target_lang_word": "手势",
                                "target_lang_sense_clarification": "手部动作示意"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6a620e93-8dd2-3411-81f9-9ec3dd6ad3b2",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>seinen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>sein</w> met mijn zaklamp naar de overkant van de rivier.",
                            "target_lang_translations": {
                                "en": "I <w>signal</w> with my flashlight to the other side of the river.",
                                "ru": "Я <w>сигналю</w> своим фонариком на другой берег реки.",
                                "zh": "我用手电筒向河对岸<w>发信号</w>。"
                            }
                        },
                        {
                            "text": "Als er gevaar dreigt, <w>sein</w> ik direct naar de meldkamer.",
                            "target_lang_translations": {
                                "en": "If danger threatens, I <w>signal</w> the control room immediately.",
                                "ru": "Если грозит опасность, я сразу <w>сообщаю</w> в диспетчерскую.",
                                "zh": "一旦出现危险，我立刻向控制调度室<w>发信号</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of <w>seinen</w>.",
                        "ru": "Форма первого лица единственного числа настоящего времени от глагола <w>seinen</w>.",
                        "zh": "动词 seinen（发信号、打信号）的第一人称单数现在时形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "signal",
                                "target_lang_sense_clarification": "to communicate by signal"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "сигналю",
                                "target_lang_sense_clarification": "подаю сигнал"
                            },
                            {
                                "target_lang_word": "сообщаю",
                                "target_lang_sense_clarification": "передаю информацию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发信号",
                                "target_lang_sense_clarification": "发出指示或信息"
                            },
                            {
                                "target_lang_word": "示意",
                                "target_lang_sense_clarification": "用动作或光线表示"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8782e5cd-781c-3992-9456-d37cb19e633e",
                    "sense_definition": "Gebiedende wijs van <w>seinen</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Sein</w> even als je veilig op je bestemming bent aangekomen.",
                            "target_lang_translations": {
                                "en": "<w>Signal</w> briefly when you have arrived safely at your destination.",
                                "ru": "<w>Дай знать</w>, когда благополучно прибудешь на место.",
                                "zh": "安全到达目的地后记得<w>打个招呼</w>。"
                            }
                        },
                        {
                            "text": "<w>Sein</w> de machinist dat hij toestemming heeft om te vertrekken.",
                            "target_lang_translations": {
                                "en": "<w>Signal</w> the driver that he has permission to depart.",
                                "ru": "<w>Подай сигнал</w> машинисту, что у него есть разрешение на отправление.",
                                "zh": "向司机<w>发信号</w>，通知他已被获准发车。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verb form"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative mood of <w>seinen</w>.",
                        "ru": "Повелительное наклонение от глагола <w>seinen</w>.",
                        "zh": "动词 seinen（发信号、通知）的祈使语气形式。"
                    },
                    "translations": {
