                        ]
                    },
                    {
                        "translation_id": "c0b87507-1cd9-4d39-a843-c74c4582f291",
                        "source_entry_id": "a8551caa-6ae0-3b00-b33d-6b187b5d2153",
                        "target_lang_word": "družstvo",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "družstvo",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "04eed720-e82e-3cce-af5f-2947df5b6cb5",
                                        "entry_id": "4f868294-d41d-3797-953f-32b055dbd00f",
                                        "glosses": [
                                            "skupina lidí tvořící jednu ze stran sportovního utkání, závodu, soutěže apod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c5b3b61-25dd-48fa-bc6e-4ba0254825dd",
                                                "sense_id": "04eed720-e82e-3cce-af5f-2947df5b6cb5",
                                                "text": "Olomoucké družstvo vyhrálo třetí set 25:19 a čtvrtý 25:17."
                                            },
                                            {
                                                "example_id": "25ea28cc-4e2e-45ad-96d5-be2ccdb0f216",
                                                "sense_id": "04eed720-e82e-3cce-af5f-2947df5b6cb5",
                                                "text": "Kategorii mladších žáků vyhrálo družstvo z Horního Slavkova, stejně jako skupinu starších žáků."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d549c8eb-1279-325c-a321-de8a0d75b614",
                                        "entry_id": "4f868294-d41d-3797-953f-32b055dbd00f",
                                        "glosses": [
                                            "společenství neuzavřeného počtu osob, které je založeno za účelem vzájemné podpory svých členů nebo třetích osob, případně za účelem podnikání"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a599e95e-71c2-40e4-a531-635594dc87fa",
                                                "sense_id": "d549c8eb-1279-325c-a321-de8a0d75b614",
                                                "text": "Družstvo může být zrušeno bez likvidace nebo s likvidací."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35bc5981-a722-366a-b478-ab109b34354e",
                                        "entry_id": "4f868294-d41d-3797-953f-32b055dbd00f",
                                        "glosses": [
                                            "(označeno na smazání) součást názvu (firmy) družstva (2)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "775696aa-4a41-4f96-b0f9-05f15398e7e3",
                                                "sense_id": "35bc5981-a722-366a-b478-ab109b34354e",
                                                "text": "Tiskové a stavební družstvo českých sociálních demokratů zakoupilo v Hybernské ulici bývalý palác Losyho a Kinských a adaptovalo jej pro potřeby strany."
                                            },
                                            {
                                                "example_id": "0ccc52d2-500e-4539-a5e0-ba1486a7ee15",
                                                "sense_id": "35bc5981-a722-366a-b478-ab109b34354e",
                                                "text": "Dvě stě tisíc korun rozdělí letos formou grantů Obchodní družstvo Konzum v Ústí nad Orlicí mezi deset vybraných občanských sdružení nacházejících se v regionu Orlickoústecka, Rychnovska a Náchodska."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52eb29f5-a60f-3bf7-ba83-562c95feb2b1",
                                        "entry_id": "4f868294-d41d-3797-953f-32b055dbd00f",
                                        "glosses": [
                                            "zkráceně jednotné zemědělské družstvo"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d173ad30-1edf-4dfe-8cce-755982de5ad5",
                                                "sense_id": "52eb29f5-a60f-3bf7-ba83-562c95feb2b1",
                                                "text": "Měli pole, dvě krávy, slepice a prasata. Koně odevzdali do družstva."
                                            }
                                        ]
                                    }
                                ]
