                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d86ed85-bea8-3363-b412-18162dc88a94",
                        "entry_id": "82c24534-42e1-382d-a26d-4591d8a20dc2",
                        "glosses": [
                            "An instance of vaunting; a boast."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147271b4-f989-4eb7-9ae9-661837d3010f",
                                "sense_id": "5d86ed85-bea8-3363-b412-18162dc88a94",
                                "text": "the spirits beneath, whom I seduced / with other promises and other vaunts"
                            },
                            {
                                "example_id": "08136d24-3631-4243-a302-fce97540af96",
                                "sense_id": "5d86ed85-bea8-3363-b412-18162dc88a94",
                                "text": "“In every vaunt you make,” she said, “I have my triumph. I single out in you the meanest man I know, the parasite and tool of the proud tyrant, that his wound may go the deeper, and may rankle more. Boast, and revenge me on him! […]”"
                            },
                            {
                                "example_id": "085b09c6-002a-494e-a40f-403faa514b2a",
                                "sense_id": "5d86ed85-bea8-3363-b412-18162dc88a94",
                                "text": "He has answered me back, vaunt for vaunt, rhetoric for rhetoric. He has lifted the only shield I cannot break, the shield of an impenetrable pomposity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95ce05ea-f87c-48ff-a22a-f8dd85db589e",
                        "source_entry_id": "82c24534-42e1-382d-a26d-4591d8a20dc2",
                        "source_sense_id": "5d86ed85-bea8-3363-b412-18162dc88a94",
                        "source_sense_description": "instance of vaunting",
                        "target_lang_word": "vantardise",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
