                "senses": [
                    {
                        "sense_id": "b5137fb9-7afd-3282-b3bd-0cba99b01f1c",
                        "entry_id": "d97514f0-71e0-3de8-bec9-7a75633803d3",
                        "glosses": [
                            "Officier municipal, magistrat en Angleterre et aux États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d446161f-8530-41fd-ab03-cd53a71b2f35",
                                "sense_id": "b5137fb9-7afd-3282-b3bd-0cba99b01f1c",
                                "text": "Il est parlé aussi dans les anciennes Archives des Anglois de l’Alderman du Roi, qui etoit comme un Intendant ou Juge de Province envoyé par le Roi pour rendre la justice."
                            },
                            {
                                "example_id": "d9fd9338-2f5b-4752-9059-78d17874cd91",
                                "sense_id": "b5137fb9-7afd-3282-b3bd-0cba99b01f1c",
                                "text": "Mais le lord-maire demanda si le messager Thompson est amené devant l'alderman Oliver."
                            },
                            {
                                "example_id": "8a40cffc-070e-40d0-b0fd-51bd9a138c8b",
                                "sense_id": "b5137fb9-7afd-3282-b3bd-0cba99b01f1c",
                                "text": "Je suis fils d'un notaire, alderman de sa ville."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2901e109-608d-45a2-98da-a70ba19859ab",
                        "source_entry_id": "d97514f0-71e0-3de8-bec9-7a75633803d3",
                        "source_sense_id": "b5137fb9-7afd-3282-b3bd-0cba99b01f1c",
                        "target_lang_word": "alderman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alderman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e570775-0306-30a2-85c7-e41f5968b0b7",
                                        "entry_id": "095e07e1-c7fe-3866-9fdc-0449d5f60fc6",
                                        "glosses": [
                                            "A member of a municipal legislative body in a city or town."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80dafe67-b92e-3779-80b3-a3fb1665f8c1",
                                        "entry_id": "095e07e1-c7fe-3866-9fdc-0449d5f60fc6",
                                        "glosses": [
                                            "A half-crown coin; its value, 30 pence."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44bafc12-4d8d-42a3-ad0e-ec9cd96db708",
                                                "sense_id": "80dafe67-b92e-3779-80b3-a3fb1665f8c1",
                                                "text": "The price of a case (five shillings piece bad) from the smasher is about one shilling; an alderman (two and sixpence) about sixpence; a peg (shilling) about threepence; a downer or sprat (sixpence) about twopence."
                                            },
                                            {
                                                "example_id": "06dbd465-4913-47b8-948d-9ce855bc6c93",
                                                "sense_id": "80dafe67-b92e-3779-80b3-a3fb1665f8c1",
                                                "text": "Half-a-crown is known as an alderman, half a bull, half a tusheroon, and a madza caroon; whilst a crown piece, or five shillings, may be called either a bull, or a caroon, or a cartwheel, or a coachwheel, or a thick-un, or a tusheroon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca52fe85-1644-33e6-b8e8-c1e747a07e93",
                                        "entry_id": "095e07e1-c7fe-3866-9fdc-0449d5f60fc6",
                                        "glosses": [
                                            "A long pipe for smoking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564640d9-239d-4001-be73-0c0c2e928236",
                                                "sense_id": "ca52fe85-1644-33e6-b8e8-c1e747a07e93",
                                                "text": "In one part of Cockaigne an amalgamation of these two last has lately taken place; and the pleasure experienced by the parishioners of Walbrook is unbounded when smoking an alderman and churchwarden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b782fcac-4f5c-3187-8e62-7c84a1a17e21",
                                        "entry_id": "095e07e1-c7fe-3866-9fdc-0449d5f60fc6",
                                        "glosses": [
                                            "A large, protruding, or swollen abdomen; a paunch, a potbelly."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32fc0957-953b-4cc6-851d-f65a884a9141",
                                                "sense_id": "b782fcac-4f5c-3187-8e62-7c84a1a17e21",
                                                "text": "He'd exercise, get the fat off, because if he let it go, he'd have too much on and maybe make his heart worse, and you looked like hell with an alderman. […] And she wouldn't want a guy who stuck out in front like a balloon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
