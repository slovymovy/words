{
    "word_family": [
        "lividity",
        "lividness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6f31bab7-45a9-303b-b51a-91da53840c33",
                    "sense_definition": "Extremely angry or furious.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "anger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was absolutely <w>livid</w> when she discovered that her car had been scratched.",
                            "target_lang_translations": {
                                "pl": "Była absolutnie <w>wściekła</w>, gdy odkryła, że jej samochód został porysowany."
                            }
                        },
                        {
                            "text": "The manager was <w>livid</w> about the poor sales results reported this quarter.",
                            "target_lang_translations": {
                                "pl": "Kierownik był <w>wściekły</w> z powodu słabych wyników sprzedaży zaraportowanych w tym kwartale."
                            }
                        }
                    ],
                    "synonyms": [
                        "furious",
                        "enraged",
                        "incensed",
                        "irate"
                    ],
                    "target_lang_definitions": {
                        "pl": "Bardzo zdenerwowany, wściekły, pełen gniewu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wściekły",
                                "target_lang_sense_clarification": "bardzo zdenerwowany, rozgniewany"
                            },
                            {
                                "target_lang_word": "wzburzony",
                                "target_lang_sense_clarification": "silnie poruszony gniewem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "593c60e1-f3c7-3b38-81c0-00f22b1664c5",
                    "sense_definition": "Having a dark, bluish or purplish appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bruise on his arm turned a <w>livid</w> shade of purple after the fall.",
                            "target_lang_translations": {
                                "pl": "Siniak na jego ramieniu przybrał <w>siny</w> odcień fioletu po upadku."
                            }
                        },
                        {
                            "text": "The cold wind left her skin looking <w>livid</w> and pale.",
                            "target_lang_translations": {
                                "pl": "Zimny wiatr sprawił, że jej skóra wyglądała na <w>siną</w> i bladą."
                            }
                        }
                    ],
                    "synonyms": [
                        "bluish",
                        "purplish"
                    ],
                    "target_lang_definitions": {
                        "pl": "Mający ciemny, niebieskawy lub purpurowy odcień (często o siniakach)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "siny",
                                "target_lang_sense_clarification": "o ciemnym, niebieskawym lub fioletowym zabarwieniu skóry"
                            },
                            {
                                "target_lang_word": "purpurowy",
                                "target_lang_sense_clarification": "o głębokim, ciemnofioletowym odcieniu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b250a09-d5de-32a5-8259-0b7c98e19af7",
                    "sense_definition": "Extremely pale or deathly white.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked <w>livid</w> with fear as he stared into the dark, empty hallway.",
                            "target_lang_translations": {
                                "pl": "Wyglądał na <w>trupio bladego</w> ze strachu, wpatrując się w ciemny, pusty korytarz."
                            }
                        },
                        {
                            "text": "The patient's face became <w>livid</w> as his health rapidly declined.",
                            "target_lang_translations": {
                                "pl": "Twarz pacjenta stała się <w>trupio blada</w>, gdy jego stan zdrowia gwałtownie się pogorszył."
                            }
                        }
                    ],
                    "synonyms": [
                        "pale",
                        "pallid",
                        "ashen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This usage is largely literary or archaic."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ekstremalnie blady, trupio biały."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "blady",
                                "target_lang_sense_clarification": "pozbawiony koloru, jasny"
                            },
                            {
                                "target_lang_word": "trupio blady",
                                "target_lang_sense_clarification": "ekstremalnie blady, jak u nieboszczyka"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}