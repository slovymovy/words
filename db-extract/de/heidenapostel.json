                ],
                "senses": [
                    {
                        "sense_id": "403e9982-3214-39b4-989e-b350cb4f6933",
                        "entry_id": "e43215e1-c76b-39b8-acc9-9a140c737b36",
                        "glosses": [
                            "historisch bedeutende Person, die bei Ethnien missioniert, welche nicht dem Judentum angehören"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "5049f6f5-2be2-46ce-a15b-1b48480388d7",
                                "sense_id": "403e9982-3214-39b4-989e-b350cb4f6933",
                                "text": "„Das paulinische Selbstzeugnis Gal 2 berichtete von Spannungen zwischen dem Heidenapostel und den Jerusalemern.“"
                            },
                            {
                                "example_id": "8b7ac262-cd0f-4bc6-9b98-43e56bcaef8d",
                                "sense_id": "403e9982-3214-39b4-989e-b350cb4f6933",
                                "text": "„Als unsere Vorfahren zum Christenthum übertraten, setzten sie zum Theil die Verehrung ihrer heidnischen Götter noch lange insgeheim fort; die Heidenapostel knüpften ihre Lehre auch wohl selbst an heidnische Vorstellungen und Gebräuche an, […].“"
                            },
                            {
                                "example_id": "69098c58-f911-4e19-ba68-2a26a2e1a11c",
                                "sense_id": "403e9982-3214-39b4-989e-b350cb4f6933",
                                "text": "„Ein unterirdischer Gang führt nordwärts zu einer Sandsteinklippe […], wo in einer Höhlung nahe am Einsiedlerbrunnen der Heidenapostel Dippold (Adalbert, Apostel der Preußen) gelebt und einen böhmischen Prinzen getauft haben soll.“"
                            },
                            {
                                "example_id": "9602e0ac-ffc2-466e-ad88-f90830e06cb7",
                                "sense_id": "403e9982-3214-39b4-989e-b350cb4f6933",
                                "text": "„Es gibt natürlich nur einen Weg der Erlösung, doch wurde das Evangelium ihm [Paulus] als dem Heidenapostel anvertraut, während z. B. Petrus es den Juden predigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
