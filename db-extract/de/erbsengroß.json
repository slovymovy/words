                "senses": [
                    {
                        "sense_id": "6576413f-f374-3fa4-be78-163afdc2dc69",
                        "entry_id": "797c6286-593f-3a1f-a621-5a9afe546f7c",
                        "glosses": [
                            "so groß wie eine Erbse, die Größe einer Erbse habend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a164760f-1758-4907-8db0-16c315eb3583",
                                "sense_id": "6576413f-f374-3fa4-be78-163afdc2dc69",
                                "text": "„›Zieh ausnahmsweise mal dein erbsengroßes Gehirn aus deinem Arsch und versuche, über deinen Tellerrand zu schauen.‹“"
                            },
                            {
                                "example_id": "71b5592e-3cba-4675-8a50-043466884732",
                                "sense_id": "6576413f-f374-3fa4-be78-163afdc2dc69",
                                "text": "„Kothaufen lagen neben den Spuren, und Glass ging in die Hocke, um die erbsengroßen Kügelchen zu berühren: noch warm.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
