                "senses": [
                    {
                        "sense_id": "2d0e0753-f765-304d-8b17-d0b45f59a5f8",
                        "entry_id": "b603e898-1985-3fce-9463-97b71c263fc0",
                        "glosses": [
                            "истор. связанный, соотносящийся по значению с существительными дань, данник"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d871408d-ef5c-4010-bdfe-5d259c7f1fd6",
                                "sense_id": "2d0e0753-f765-304d-8b17-d0b45f59a5f8",
                                "text": "Из всех известий Константина ясно вытекает, что он считает Русь народом туземным, а не пришлым; притом он весьма просто и естественно передает нам даннические отношения разных славянских племен к господствующему народу Русь."
                            },
                            {
                                "example_id": "ae5f8fdd-9993-4777-98f8-1366a919bb5d",
                                "sense_id": "2d0e0753-f765-304d-8b17-d0b45f59a5f8",
                                "text": "Наступила очередь и вятичской земли, дольше всех находившейся в даннической зависимости от Хазарии."
                            }
                        ]
                    }
