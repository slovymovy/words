                "senses": [
                    {
                        "sense_id": "12e507cf-e5ae-395f-b820-636c49985108",
                        "entry_id": "68464a8c-4b19-3153-ba47-77e0f8550139",
                        "glosses": [
                            "действие по значению гл. рассеять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cef6a87-ec03-43ef-8ef2-b04669e341f0",
                                "sense_id": "12e507cf-e5ae-395f-b820-636c49985108",
                                "text": "Рассеяние подозрений"
                            }
                        ]
                    },
                    {
                        "sense_id": "356efb20-d2e8-3e4c-87a8-a2fe087504bb",
                        "entry_id": "68464a8c-4b19-3153-ba47-77e0f8550139",
                        "glosses": [
                            "физ. или хим. результат такого действия; разброс характеристик"
                        ],
                        "tags": [
                            "часто -"
                        ],
                        "examples": [
                            {
                                "example_id": "9fd95679-7439-4760-8be9-49e8f5fbcd46",
                                "sense_id": "356efb20-d2e8-3e4c-87a8-a2fe087504bb",
                                "text": "Рассеяние света"
                            },
                            {
                                "example_id": "80ddefe7-23ea-422d-a7de-762de3144629",
                                "sense_id": "356efb20-d2e8-3e4c-87a8-a2fe087504bb",
                                "text": "Рассеяние энергии"
                            }
                        ]
                    },
                    {
                        "sense_id": "45d92222-faa8-3f30-a631-68cef0d5f15f",
                        "entry_id": "68464a8c-4b19-3153-ba47-77e0f8550139",
                        "glosses": [
                            "мн. ч., устар. развлечение, приятное препровождение времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05b63a47-855f-4ddf-84ba-b5c8b21ad8b6",
                                "sense_id": "45d92222-faa8-3f30-a631-68cef0d5f15f",
                                "text": "Сенатор был по характеру человек добрый и любивший рассеяния."
                            },
                            {
                                "example_id": "2b2aeea5-4e35-4162-9460-6fefc7b8fa3e",
                                "sense_id": "45d92222-faa8-3f30-a631-68cef0d5f15f",
                                "text": "Она недомогала и медики присоветывали ей как можно больше рассеяния."
                            }
                        ]
                    },
                    {
                        "sense_id": "79d9a045-b3c5-3f31-8def-ec1da3a37122",
                        "entry_id": "68464a8c-4b19-3153-ba47-77e0f8550139",
                        "glosses": [
                            "устар. то же, что рассеянность \\"
                        ],
                        "tags": [
                            "только ед. ч."
                        ],
                        "examples": [
                            {
                                "example_id": "25c824fb-6519-4376-bd27-6a7c319d8b0b",
                                "sense_id": "79d9a045-b3c5-3f31-8def-ec1da3a37122",
                                "text": "И Ленский пешкою ладью берет в рассеяньи свою."
                            }
                        ]
                    }
                ],
