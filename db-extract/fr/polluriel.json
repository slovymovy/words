                "word": "polluriel",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "fb92ff10-515d-447c-b4cf-7f8153e33503",
                        "entry_id": "eedd9a43-fd85-35a5-92ff-b7a15f6cf532",
                        "tags": [
                            "plural"
                        ],
