                            },
                            {
                                "target_word": "Barb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab0ba7fb-b7d8-3e27-ae17-7729b4f33bcc",
                                        "entry_id": "9e02f5a7-cd0a-3242-88b0-319f0d1cfa8f",
                                        "glosses": [
                                            "A fan of American rapper and singer Nicki Minaj."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900d5684-17f1-4483-a183-223948b0ed04",
                                                "sense_id": "ab0ba7fb-b7d8-3e27-ae17-7729b4f33bcc",
                                                "text": "Minaj is thrilled to be returning to her legion of Aussie Barbz this October in a brand new full-scale arena show."
                                            },
                                            {
                                                "example_id": "25d83a7c-49e0-4a9f-bb57-1f2f06ee9df4",
                                                "sense_id": "ab0ba7fb-b7d8-3e27-ae17-7729b4f33bcc",
                                                "text": "I’m not a Barb, but Nicki Minaj totally made me do a 180 on the whole hating-her-songs-and-general-vibe thing I had going on when I went to review her in concert."
                                            },
                                            {
                                                "example_id": "80c62a18-d7a9-49ca-9755-e9587278c6c6",
                                                "sense_id": "ab0ba7fb-b7d8-3e27-ae17-7729b4f33bcc",
                                                "text": "Lambs and Barbz, remain calm, but Mariah Carey is once again talking about her infamous feud with Nicki Minaj."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2b2c0599-529e-4a37-a4b3-0d2264d8b2ae",
                        "source_entry_id": "a0ca7d33-d0ef-312e-b9ce-45bd1ff31ac1",
                        "source_sense_id": "e0431d2e-b0b6-36b4-8eae-413736d58bad",
                        "target_lang_word": "Barbie",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Barbie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd419a93-2716-3838-a177-59dd83451e18",
                                        "entry_id": "c2d0487d-9061-3772-b15a-294482677277",
                                        "glosses": [
                                            "A diminutive of the female given name Barbara."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Barbie",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                        "entry_id": "e81e5bdc-68de-37d6-a554-907dc3cd3ebf",
                                        "glosses": [
                                            "A tall, slender female fashion doll."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7629cc7-2a59-4a96-bb93-a1a5d431c815",
                                                "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                                "text": "They discourage their young children from engaging in rough-and-tumble play. One mother said, “I like Hai-Mei quiet. I like her playing Barbies, writing, and singing.”"
                                            },
                                            {
                                                "example_id": "1b2dc67c-58fe-4e5d-b35e-7d8a880453ee",
                                                "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                                "text": "Everything short of the toe-to-toe Truth and Love that comes from real confrontation of individual consciousness is just playing with Barbie dolls."
                                            },
                                            {
                                                "example_id": "10c6aff4-2d65-4338-a185-9caee82a7a0a",
                                                "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                                "text": "Sarah, who is ten, says she doesn’t play with Barbies anymore, although she takes a certain scientific interest[…]."
                                            },
                                            {
                                                "example_id": "bc965b5f-ad5e-4c25-8847-05367185da34",
                                                "sense_id": "02118309-2513-3fb5-8267-55a6e5322694",
                                                "text": "Many of my feminist friends hate Barbie because they feel that she sends a terrible message to girls […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83b62ba0-6d2e-3553-8297-235826ec7c43",
                                        "entry_id": "e81e5bdc-68de-37d6-a554-907dc3cd3ebf",
                                        "glosses": [
                                            "A beautiful but stupid or shallow young woman."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
