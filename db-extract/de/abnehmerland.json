                        "examples": [
                            {
                                "example_id": "e8cbc943-7996-4ea2-96e5-d2def01ea9cf",
                                "sense_id": "3f25f99e-618c-324f-9ccf-fc4ece6d3f69",
                                "text": "Das klassische Abnehmerland für das Laubholz, in diesem Falle Fasseichenholz, ist Frankreich."
                            },
                            {
                                "example_id": "620abc8f-6f4e-47ca-86dc-72401be513f6",
                                "sense_id": "3f25f99e-618c-324f-9ccf-fc4ece6d3f69",
                                "text": "Liefer- und Abnehmerländer sind durch das Pipeline-Netz und langfristige Gaslieferverträge, derart aufeinander angewiesen, dass keine Seite die andere erpressen kann."
                            }
