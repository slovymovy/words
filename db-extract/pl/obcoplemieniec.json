                        ],
                        "examples": [
                            {
                                "example_id": "9c82bbb2-7340-4bc5-9d94-bc86dff983a6",
                                "sense_id": "d3ab8388-0eef-3d9b-b305-a86f1fd8b011",
                                "text": "Polska dla Polaków – jak to pogodzić z postawą obcoplemieńca, który po opuszczeniu getta działał w konspiracji, pisał antyhitlerowskie satyry, przeszedł przez obozy i łagrową poniewierkę, by wreszcie po andersowskim epizodzie znaleźć się w Londynie"
                            },
                            {
                                "example_id": "62271502-f2ac-4e01-99b6-9b2d098397a4",
                                "sense_id": "d3ab8388-0eef-3d9b-b305-a86f1fd8b011",
                                "text": ", s. 75, wyd. Iskry, Warszawa 2004.."
                            }
                        ],
