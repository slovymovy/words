{
    "word_family": [
        "commissioner",
        "commissionaire",
        "decommission",
        "recommission",
        "subcommission"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b48e7f6f-72e3-3e0c-abf7-7e3da8437785",
                    "sense_definition": "A group of people officially chosen to examine a problem, manage a specific area, or perform a specific duty.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "group_body",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government set up a <w>commission</w> to investigate the cause of the accident.",
                            "target_lang_translations": {
                                "ru": "Правительство создало <w>комиссию</w> для расследования причин аварии.",
                                "zh": "政府成立了一个<w>委员会</w>来调查事故原因。"
                            }
                        },
                        {
                            "text": "Members of the <w>commission</w> will vote on the new policy tomorrow.",
                            "target_lang_translations": {
                                "ru": "Члены <w>комиссии</w> проголосуют по новой политике завтра.",
                                "zh": "<w>委员会</w>成员将于明天对新政策进行投票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "committee"
                    ],
                    "common_phrases": [
                        "royal commission",
                        "election commission",
                        "european commission",
                        "independent commission"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, официально избранных для изучения проблемы, управления определенной сферой или выполнения конкретной обязанности.",
                        "zh": "一组被正式选出以调查问题、管理特定领域或履行特定职责的人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комиссия",
                                "target_lang_sense_clarification": "группа лиц"
                            },
                            {
                                "target_lang_word": "комитет",
                                "target_lang_sense_clarification": "орган управления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "委员会",
                                "target_lang_sense_clarification": "负责特定任务的组织"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3322aa99-55c3-3f39-a48f-88fb3ef266ca",
                    "sense_definition": "A payment made to an employee or agent for transacting business, usually calculated as a percentage of the value of the goods sold.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "payment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The real estate agent earns a significant <w>commission</w> on every house she sells.",
                            "target_lang_translations": {
                                "ru": "Агент по недвижимости зарабатывает значительные <w>комиссионные</w> с каждого проданного ею дома.",
                                "zh": "这位房地产经纪人每卖出一套房子都能赚取可观的<w>佣金</w>。"
                            }
                        },
                        {
                            "text": "Banks often charge a small <w>commission</w> when you exchange foreign currency.",
                            "target_lang_translations": {
                                "ru": "Банки часто взимают небольшую <w>комиссию</w> при обмене иностранной валюты.",
                                "zh": "当你兑换外币时，银行通常会收取少量<w>手续费</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sales commission",
                        "charge a commission",
                        "take a commission",
                        "commission fee"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плата, выплачиваемая сотруднику или агенту за совершение деловой операции, обычно рассчитываемая как процент от стоимости проданных товаров.",
                        "zh": "支付给员工或代理人以进行业务往来的款项，通常按所售商品价值的百分比计算。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комиссия",
                                "target_lang_sense_clarification": "сбор за услугу"
                            },
                            {
                                "target_lang_word": "комиссионные",
                                "target_lang_sense_clarification": "вознаграждение агента"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "佣金",
                                "target_lang_sense_clarification": "销售提成或服务费"
                            },
                            {
                                "target_lang_word": "手续费",
                                "target_lang_sense_clarification": "银行或机构收取的费用"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bdd346c8-d271-3451-bb43-8477b200be7d",
                    "sense_definition": "The act of doing something, especially something illegal or wrong.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "action_act",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police found evidence linking him to the <w>commission</w> of the crime.",
                            "target_lang_translations": {
                                "ru": "Полиция обнаружила улики, связывающие его с <w>совершением</w> преступления.",
                                "zh": "警方发现了将他与<w>实施</w>犯罪联系起来的证据。"
                            }
                        },
                        {
                            "text": "He felt great guilt over the <w>commission</w> of such a serious error.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал огромную вину за <w>совершение</w> такой серьезной ошибки.",
                                "zh": "他因<w>犯</w>下如此严重的错误而感到非常内疚。"
                            }
                        }
                    ],
                    "antonyms": [
                        "omission"
                    ],
                    "common_phrases": [
                        "commission of a crime",
                        "commission of an offense",
                        "commission of sin"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт совершения чего-либо, особенно чего-то незаконного или неправильного.",
                        "zh": "做某事的行为，尤指非法或错误的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "совершение",
                                "target_lang_sense_clarification": "действия, преступления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "实施",
                                "target_lang_sense_clarification": "指犯罪或错误行为的发生"
                            },
                            {
                                "target_lang_word": "犯",
                                "target_lang_sense_clarification": "指犯罪行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9fcecfc9-3a70-3ac9-8ba1-fd328d92184d",
                    "sense_definition": "An official rank or authority given to an officer in the armed forces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military_rank",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He resigned his <w>commission</w> in the navy to pursue a career in politics.",
                            "target_lang_translations": {
                                "ru": "Он отказался от своего <w>офицерского звания</w> во флоте, чтобы продолжить карьеру в политике.",
                                "zh": "他辞去了海军的<w>军官委任状</w>，转而投身政界。"
                            }
                        },
                        {
                            "text": "Receiving a <w>commission</w> is a proud moment for any young officer.",
                            "target_lang_translations": {
                                "ru": "Получение <w>офицерского звания</w> — гордый момент для любого молодого офицера.",
                                "zh": "获得<w>军衔</w>对任何年轻军官来说都是值得骄傲的时刻。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "officer's commission",
                        "resign commission",
                        "receive a commission"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное звание или полномочия, присваиваемые офицеру в вооруженных силах.",
                        "zh": "授予武装部队军官的正式军衔或权力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "офицерское звание",
                                "target_lang_sense_clarification": "военный чин"
                            },
                            {
                                "target_lang_word": "патент",
                                "target_lang_sense_clarification": "документ о звании (устар.)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "军官委任状",
                                "target_lang_sense_clarification": "授予军衔的正式文件"
                            },
                            {
                                "target_lang_word": "军衔",
                                "target_lang_sense_clarification": "军官的职位等级"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4866f092-388f-3d79-90b3-31068a0e3b96",
                    "sense_definition": "To formally arrange for someone to do a piece of work, such as writing a report or creating a work of art.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "order_work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum decided to <w>commission</w> a new sculpture for the entrance hall.",
                            "target_lang_translations": {
                                "ru": "Музей решил <w>заказать</w> новую скульптуру для вестибюля.",
                                "zh": "博物馆决定<w>委托</w>制作一座新的雕塑放在大厅入口处。"
                            }
                        },
                        {
                            "text": "We need to <w>commission</w> an expert to analyze the environmental impact.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>поручить</w> эксперту проанализировать воздействие на окружающую среду.",
                                "zh": "我们需要<w>委托</w>一位专家来分析环境影响。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "commission a study",
                        "commission a painting",
                        "commission a report"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально договориться с кем-либо о выполнении работы, например, написании отчета или создании произведения искусства.",
                        "zh": "正式安排某人完成某项工作，例如撰写报告或创作艺术品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заказывать",
                                "target_lang_sense_clarification": "работу, произведение искусства"
                            },
                            {
                                "target_lang_word": "делать заказ",
                                "target_lang_sense_clarification": "поручать работу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "委托",
                                "target_lang_sense_clarification": "正式交托任务"
                            },
                            {
                                "target_lang_word": "订购",
                                "target_lang_sense_clarification": "预定艺术品或服务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "23a7c446-1a12-37db-8aa4-0a15df0070cf",
                    "sense_definition": "To give someone the official authority or instruction to perform a task.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "authorize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king <w>commissioned</w> the explorer to find a new trade route to the east.",
                            "target_lang_translations": {
                                "ru": "Король <w>уполномочил</w> исследователя найти новый торговый путь на восток.",
                                "zh": "国王<w>授权</w>探险家去寻找一条通往东方的新贸易路线。"
                            }
                        },
                        {
                            "text": "She was <w>commissioned</w> to lead the investigation into the financial fraud.",
                            "target_lang_translations": {
                                "ru": "Ей <w>поручили</w> возглавить расследование финансового мошенничества.",
                                "zh": "她被<w>委派</w>负责领导对这起金融欺诈案的调查。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дать кому-либо официальные полномочия или инструкцию для выполнения задачи.",
                        "zh": "给予某人执行任务的正式权力或指示。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "уполномочивать",
                                "target_lang_sense_clarification": "наделять правами"
                            },
                            {
                                "target_lang_word": "поручать",
                                "target_lang_sense_clarification": "давать задание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "授权",
                                "target_lang_sense_clarification": "赋予权力"
                            },
                            {
                                "target_lang_word": "委派",
                                "target_lang_sense_clarification": "指派任务"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df3be753-c3ce-3104-8ece-ff12380c69b6",
                    "sense_definition": "To prepare equipment, such as a ship or machinery, for active service and verify it is working.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "activate_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The navy will <w>commission</w> the new aircraft carrier later this year.",
                            "target_lang_translations": {
                                "ru": "Военно-морской флот <w>введет в строй</w> новый авианосец в конце этого года.",
                                "zh": "海军将于今年晚些时候让这艘新航母<w>服役</w>。"
                            }
                        },
                        {
                            "text": "Engineers worked all week to <w>commission</w> the new power plant system.",
                            "target_lang_translations": {
                                "ru": "Инженеры работали всю неделю, чтобы <w>ввести в эксплуатацию</w> новую систему электростанции.",
                                "zh": "工程师们整整工作了一周，以使新的发电厂系统<w>投入使用</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "commission a ship",
                        "commission a system"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical or military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подготавливать оборудование, например корабль или механизмы, к активной службе и проверять его работоспособность.",
                        "zh": "为设备（如船舶或机械）投入使用做准备并验证其工作状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вводить в эксплуатацию",
                                "target_lang_sense_clarification": "оборудование, систему"
                            },
                            {
                                "target_lang_word": "вводить в строй",
                                "target_lang_sense_clarification": "корабль, объект"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "投入使用",
                                "target_lang_sense_clarification": "设备或系统开始运行"
                            },
                            {
                                "target_lang_word": "服役",
                                "target_lang_sense_clarification": "指舰船或军事装备"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}