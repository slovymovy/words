                        "examples": [
                            {
                                "example_id": "f7ec70d2-f3e8-4020-bad2-618f57041384",
                                "sense_id": "708dce1d-a157-33f4-8c63-3e058c6ebc20",
                                "text": "De Utrechtse bank wil zich vooral richten op de voedsel- en agrarische sector. Het autoleasebedrijf was wat dat betreft een vreemde eend in de bijt. Door de verkoop verbetert de financiële buffer van de Rabobank."
                            },
                            {
                                "example_id": "1fb43919-9f0b-403d-85a5-e02035fdd8c7",
                                "sense_id": "708dce1d-a157-33f4-8c63-3e058c6ebc20",
                                "text": "Mandemakers, bekend van de keukens, stapt in de wereld van autoleasing. De keukengigant heeft samen met de Van Mossel Groep een groot autoleasebedrijf opgericht."
                            }
