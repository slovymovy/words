    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a3656b82-c313-3b7e-a3be-28b7bf8371f1",
                    "sense_definition": "Containing salt; salty.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "salt_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>saline</w> water in the lake is not suitable for drinking.",
                            "target_lang_translations": {
                                "ru": "<w>Солёная</w> вода в озере не пригодна для питья."
                            }
                        },
                        {
                            "text": "Many plants cannot grow in such <w>saline</w> soil conditions.",
                            "target_lang_translations": {
                                "ru": "Многие растения не могут расти в таких <w>солончаковых</w> почвенных условиях."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saline water",
                        "saline soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий соль; солёный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солёный",
                                "target_lang_sense_clarification": "содержащий соль, имеющий вкус соли"
                            },
                            {
                                "target_lang_word": "соляной",
                                "target_lang_sense_clarification": "относящийся к соли, содержащий соль"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5199a44-43e2-3620-b454-ceee0d26030f",
                    "sense_definition": "Resembling salt in taste or appearance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "salt_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemical had a distinct <w>saline</w> taste that lingered on the tongue.",
                            "target_lang_translations": {
                                "ru": "Химикат имел отчетливый <w>солоноватый</w> привкус, который оставался на языке."
                            }
                        },
                        {
                            "text": "He noticed a <w>saline</w> crust forming on the surface of the dried mineral.",
                            "target_lang_translations": {
                                "ru": "Он заметил <w>солевую</w> корку, образующуюся на поверхности высушенного минерала."
                            }
                        }
                    ],
                    "common_phrases": [
                        "saline taste"
                    ],
                    "target_lang_definitions": {
                        "ru": "Напоминающий соль по вкусу или внешнему виду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "солоноватый",
                                "target_lang_sense_clarification": "имеющий привкус соли"
                            },
                            {
                                "target_lang_word": "солевой",
                                "target_lang_sense_clarification": "связанный с солью, имеющий признаки соли"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4394a40e-87ce-3360-bd0f-2c0d6774ed58",
                    "sense_definition": "Water containing dissolved salt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "salt_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor used <w>saline</w> to clean the wound carefully.",
                            "target_lang_translations": {
                                "ru": "Врач использовал <w>физраствор</w>, чтобы тщательно промыть рану."
                            }
                        },
                        {
                            "text": "Patients often receive <w>saline</w> through an intravenous drip in the hospital.",
                            "target_lang_translations": {
                                "ru": "Пациенты в больнице часто получают <w>физраствор</w> через капельницу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sterile saline",
                        "saline solution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вода, содержащая растворенную соль; часто используется в медицине как физраствор."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "физраствор",
                                "target_lang_sense_clarification": "физиологический раствор, используемый в медицине"
                            },
                            {
                                "target_lang_word": "солевой раствор",
                                "target_lang_sense_clarification": "водный раствор соли"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f4e330d-1049-35a6-a6d5-27b8014f7105",
                    "sense_definition": "A salt spring or a place where salt water is collected.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "salt_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient civilization built their settlement near a natural <w>saline</w>.",
                            "target_lang_translations": {
                                "ru": "Древняя цивилизация построила свое поселение рядом с природным <w>соляным источником</w>."
                            }
                        },
                        {
                            "text": "Workers gathered salt from the local <w>saline</w> during the dry season.",
                            "target_lang_translations": {
                                "ru": "Рабочие собирали соль в местной <w>солеварне</w> в сухой сезон."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Соляной источник или место, где добывают соль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соляной источник",
                                "target_lang_sense_clarification": "природный источник соленой воды"
                            },
                            {
                                "target_lang_word": "солеварня",
                                "target_lang_sense_clarification": "место, где добывают или выпаривают соль"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "816ab045-6b54-3850-84d5-3418e4997d30",
                    "sense_definition": "A city and township in Washtenaw County, Michigan.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place_names",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They decided to move to <w>Saline</w> for a quieter life.",
                            "target_lang_translations": {
                                "ru": "Они решили переехать в <w>Салин</w> ради более спокойной жизни."
