{
    "word_family": [
        "toughen",
        "toughness",
        "toughly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3c7e6a6b-bbb8-3892-a102-52b518bb41f3",
                    "sense_definition": "Difficult to do or deal with; demanding.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "difficult_situation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>tough</w> decision, but I think we made the right choice.",
                            "target_lang_translations": {
                                "ru": "Это было <w>трудное</w> решение, но я думаю, мы сделали правильный выбор.",
                                "zh": "这是一个<w>艰难</w>的决定，但我认为我们做出了正确的选择。"
                            }
                        },
                        {
                            "text": "He is going through a <w>tough</w> time at work right now.",
                            "target_lang_translations": {
                                "ru": "Он сейчас переживает <w>тяжёлые</w> времена на работе.",
                                "zh": "他现在在工作中正经历一段<w>艰难</w>的时期。"
                            }
                        }
                    ],
                    "synonyms": [
                        "difficult",
                        "hard",
                        "challenging"
                    ],
                    "antonyms": [
                        "easy",
                        "simple"
                    ],
                    "common_phrases": [
                        "tough decision",
                        "tough time",
                        "tough question",
                        "tough job"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудный для выполнения или преодоления; требующий больших усилий.",
                        "zh": "指难以完成或处理的；要求苛刻的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "трудный",
                                "target_lang_sense_clarification": "общая сложность"
                            },
                            {
                                "target_lang_word": "тяжёлый",
                                "target_lang_sense_clarification": "требующий значительных усилий или эмоционально сложный"
                            },
                            {
                                "target_lang_word": "сложный",
                                "target_lang_sense_clarification": "непростой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "困难",
                                "target_lang_sense_clarification": "指事情本身不容易"
                            },
                            {
                                "target_lang_word": "艰难",
                                "target_lang_sense_clarification": "指处境或过程艰苦"
                            },
                            {
                                "target_lang_word": "棘手",
                                "target_lang_sense_clarification": "指问题难以解决"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "badaaed9-9c23-3262-887a-55ed5fb7cd17",
                    "sense_definition": "Strong and durable; not easily broken or damaged.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_strength",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tent is made of <w>tough</w> material that can withstand the wind.",
                            "target_lang_translations": {
                                "ru": "Палатка сделана из <w>прочного</w> материала, который может выдержать ветер.",
                                "zh": "帐篷是用<w>坚固</w>的材料制成的，可以抵御风力。"
                            }
                        },
                        {
                            "text": "You need <w>tough</w> boots for hiking in these mountains.",
                            "target_lang_translations": {
                                "ru": "Для походов в этих горах тебе нужны <w>крепкие</w> ботинки.",
                                "zh": "在这山里徒步，你需要一双<w>结实</w>的靴子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strong",
                        "durable",
                        "sturdy",
                        "resilient",
                        "robust",
                        "hard-wearing"
                    ],
                    "antonyms": [
                        "fragile",
                        "weak",
                        "delicate"
                    ],
                    "common_phrases": [
                        "tough material",
                        "tough skin",
                        "tough plastic"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный и долговечный; нелегко ломающийся или повреждаемый.",
                        "zh": "坚固耐用；不易损坏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прочный",
                                "target_lang_sense_clarification": "о материале или конструкции"
                            },
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "надёжный, устойчивый"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚固",
                                "target_lang_sense_clarification": "指结构结实"
                            },
                            {
                                "target_lang_word": "耐用",
                                "target_lang_sense_clarification": "指经久耐用"
                            },
                            {
                                "target_lang_word": "结实",
                                "target_lang_sense_clarification": "指材质强韧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18a07b8c-cb1d-31a0-858e-c1f7f7bb2e27",
                    "sense_definition": "Difficult to cut or chew (used for food).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "food_texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The steak was so <w>tough</w> that I could hardly eat it.",
                            "target_lang_translations": {
                                "ru": "Стейк был таким <w>жёстким</w>, что я едва мог его есть.",
                                "zh": "这块牛排太<w>老</w>了，我几乎咬不动。"
                            }
                        },
                        {
                            "text": "If you cook the meat too long, it will become dry and <w>tough</w>.",
                            "target_lang_translations": {
                                "ru": "Если готовить мясо слишком долго, оно станет сухим и <w>жёстким</w>.",
                                "zh": "如果肉煮太久，就会变得又干又<w>硬</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chewy",
                        "leathery",
                        "rubbery",
                        "hard"
                    ],
                    "antonyms": [
                        "tender",
                        "soft"
                    ],
                    "common_phrases": [
                        "tough meat",
                        "tough steak"
                    ],
                    "target_lang_definitions": {
                        "ru": "Трудно режущийся или пережёвываемый (о еде).",
                        "zh": "指食物难以切开或咀嚼。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёсткий",
                                "target_lang_sense_clarification": "о мясе или других продуктах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "硬",
                                "target_lang_sense_clarification": "指口感坚硬"
                            },
                            {
                                "target_lang_word": "老",
                                "target_lang_sense_clarification": "指肉类烹饪过度导致难以咀嚼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c621e80-9f98-31d7-8f9c-4660af18bfa8",
                    "sense_definition": "Strict, severe, or firm in policy or attitude.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "strictness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced new <w>tough</w> measures to combat crime.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело новые <w>жёсткие</w> меры для борьбы с преступностью.",
                                "zh": "政府出台了新的<w>严厉</w>措施来打击犯罪。"
                            }
                        },
                        {
                            "text": "She is a <w>tough</w> boss who expects perfection from everyone.",
                            "target_lang_translations": {
                                "ru": "Она <w>строгий</w> начальник, который ожидает совершенства от каждого.",
                                "zh": "她是一位<w>严格</w>的老板，对每个人都要求完美。"
                            }
                        }
                    ],
                    "synonyms": [
                        "strict",
                        "severe",
                        "stern",
                        "harsh",
                        "firm"
                    ],
                    "antonyms": [
                        "lenient",
                        "soft",
                        "lax"
                    ],
                    "common_phrases": [
                        "tough on crime",
                        "tough love",
                        "get tough",
                        "tough stance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Строгий, суровый или непреклонный в политике или отношении.",
                        "zh": "在政策或态度上严格、严厉或坚定。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жёсткий",
                                "target_lang_sense_clarification": "о мерах, правилах или критике"
                            },
                            {
                                "target_lang_word": "суровый",
                                "target_lang_sense_clarification": "о характере или отношении"
                            },
                            {
                                "target_lang_word": "строгий",
                                "target_lang_sense_clarification": "требовательный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "严厉",
                                "target_lang_sense_clarification": "指态度或措施强硬"
                            },
                            {
                                "target_lang_word": "严格",
                                "target_lang_sense_clarification": "指要求高"
                            },
                            {
                                "target_lang_word": "强硬",
                                "target_lang_sense_clarification": "指立场坚定不妥协"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c32b43e6-6dd2-3144-99dc-97d90d66eeb3",
                    "sense_definition": "Physically or mentally strong; able to endure hardship.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "person_character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He acts like a <w>tough</w> guy, but he is actually very kind.",
                            "target_lang_translations": {
                                "ru": "Он ведёт себя как <w>крутой</w> парень, но на самом деле он очень добрый.",
                                "zh": "他表现得像个<w>强悍</w>的人，但实际上他非常善良。"
                            }
                        },
                        {
                            "text": "Only the <w>tough</w> soldiers could survive the training course.",
                            "target_lang_translations": {
                                "ru": "Только <w>выносливые</w> солдаты могли пережить этот курс подготовки.",
                                "zh": "只有<w>坚强</w>的士兵才能挺过这次训练课程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hardy",
                        "resilient",
                        "strong",
                        "robust"
                    ],
                    "antonyms": [
                        "weak",
                        "delicate",
                        "sensitive"
                    ],
                    "common_phrases": [
                        "tough guy",
                        "tough cookie",
                        "tough as nails"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физически или морально сильный; способный переносить невзгоды.",
                        "zh": "身体或精神上强壮；能够忍受艰苦。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойкий",
                                "target_lang_sense_clarification": "непоколебимый духом"
                            },
                            {
                                "target_lang_word": "выносливый",
                                "target_lang_sense_clarification": "физически сильный"
                            },
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "разговорное: уверенный в себе, сильный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚强",
                                "target_lang_sense_clarification": "指意志坚定"
                            },
                            {
                                "target_lang_word": "强悍",
                                "target_lang_sense_clarification": "指性格或体魄强硬"
                            },
                            {
                                "target_lang_word": "耐劳",
                                "target_lang_sense_clarification": "指能吃苦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9edeeb9b-ec4b-3b34-8313-617010010681",
                    "sense_definition": "Rough, violent, or prone to fighting.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He grew up in a <w>tough</w> neighborhood where fights were common.",
                            "target_lang_translations": {
                                "ru": "Он вырос в <w>опасном</w> районе, где драки были обычным делом.",
                                "zh": "他在一个<w>混乱</w>的街区长大，那里打架斗殴是常事。"
                            }
                        },
                        {
                            "text": "A group of <w>tough</w> boys stood on the corner looking for trouble.",
                            "target_lang_translations": {
                                "ru": "Группа <w>агрессивных</w> парней стояла на углу в поисках неприятностей.",
                                "zh": "一群<w>凶悍</w>的男孩站在街角寻衅滋事。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rough",
                        "rowdy",
                        "violent"
                    ],
                    "antonyms": [
                        "gentle",
                        "peaceful"
                    ],
                    "common_phrases": [
                        "tough neighborhood",
                        "tough crowd"
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый, агрессивный или склонный к насилию.",
                        "zh": "粗暴、暴力或容易引发冲突的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опасный",
                                "target_lang_sense_clarification": "представляющий угрозу"
                            },
                            {
                                "target_lang_word": "бандитский",
                                "target_lang_sense_clarification": "связанный с преступностью (о районе)"
                            },
                            {
                                "target_lang_word": "агрессивный",
                                "target_lang_sense_clarification": "склонный к дракам"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "混乱",
                                "target_lang_sense_clarification": "指治安不好的环境"
                            },
                            {
                                "target_lang_word": "凶悍",
                                "target_lang_sense_clarification": "指人性格暴戾"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "0db89f55-ca14-3cb7-8c2e-42a3beabb173",
                    "sense_definition": "Used to express a lack of sympathy for someone's problem.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unsympathetic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you missed the bus because you were late, that is just <w>tough</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты опоздал на автобус, потому что задержался, то тут уж <w>ничего не поделаешь</w>.",
                                "zh": "如果你因为迟到而错过了公交车，那也只能<w>没办法</w>了。"
                            }
                        },
                        {
                            "text": "It might seem unfair, but <w>tough</w> luck, those are the rules.",
                            "target_lang_translations": {
                                "ru": "Может показаться несправедливым, но <w>не повезло</w>, таковы правила.",
                                "zh": "这看起来可能不公平，但<w>活该</w>你倒霉，规矩就是这样。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tough luck",
                        "tough break"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as 'tough luck'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения отсутствия сочувствия к чьей-либо проблеме.",
                        "zh": "用于表示对某人的问题缺乏同情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "не повезло",
                                "target_lang_sense_clarification": "выражение сочувствия или сарказма"
                            },
                            {
                                "target_lang_word": "ничего не поделаешь",
                                "target_lang_sense_clarification": "смирение с ситуацией"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没办法",
                                "target_lang_sense_clarification": "表示无奈或不予同情"
                            },
                            {
                                "target_lang_word": "活该",
                                "target_lang_sense_clarification": "表示不值得同情"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1f4fe175-1b2f-3e3b-8210-2d124a23c36b",
                    "sense_definition": "A rough or violent person, often a criminal.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "person_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street was blocked by a gang of young <w>toughs</w>.",
                            "target_lang_translations": {
                                "ru": "Улица была заблокирована бандой молодых <w>хулиганов</w>.",
                                "zh": "街道被一群年轻的<w>流氓</w>堵住了。"
                            }
                        },
                        {
                            "text": "He hired a couple of <w>toughs</w> to guard the warehouse at night.",
                            "target_lang_translations": {
                                "ru": "Он нанял пару <w>головорезов</w>, чтобы охранять склад ночью.",
                                "zh": "他雇了几个<w>恶棍</w>在晚上看守仓库。"
                            }
                        }
                    ],
                    "synonyms": [
                        "thug",
                        "bully",
                        "ruffian",
                        "hooligan"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "somewhat old-fashioned in this specific noun usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубый или агрессивный человек, часто преступник.",
                        "zh": "粗暴或暴力的人，通常指罪犯。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хулиган",
                                "target_lang_sense_clarification": "нарушитель порядка"
                            },
                            {
                                "target_lang_word": "бандит",
                                "target_lang_sense_clarification": "преступник"
                            },
                            {
                                "target_lang_word": "головорез",
                                "target_lang_sense_clarification": "разговорное: опасный человек"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流氓",
                                "target_lang_sense_clarification": "指品行恶劣的人"
                            },
                            {
                                "target_lang_word": "恶棍",
                                "target_lang_sense_clarification": "指作恶多端的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6d5b9f07-f2be-344e-8e60-d0561cef3706",
                    "sense_definition": "To endure or withstand a difficult situation.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "endure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We just have to <w>tough</w> it out until the weather improves.",
                            "target_lang_translations": {
                                "ru": "Нам просто нужно <w>продержаться</w>, пока погода не улучшится.",
                                "zh": "我们只能<w>坚持</w>到天气好转为止。"
                            }
                        },
                        {
                            "text": "She decided to <w>tough</w> out the illness without taking any time off.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>перетерпеть</w> болезнь, не беря отгул.",
                                "zh": "她决定不请假，<w>挺过</w>这次生病。"
                            }
                        }
                    ],
                    "synonyms": [
                        "endure",
                        "withstand",
                        "brave"
                    ],
                    "antonyms": [
                        "quit",
                        "give up"
                    ],
                    "common_phrases": [
                        "tough it out"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "almost always used in the phrase 'tough it out'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вытерпеть или пережить трудную ситуацию.",
                        "zh": "忍受或挺过困难的处境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выдержать",
                                "target_lang_sense_clarification": "справиться с трудностями"
                            },
                            {
                                "target_lang_word": "перетерпеть",
                                "target_lang_sense_clarification": "пережить неприятности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "坚持",
                                "target_lang_sense_clarification": "指在困难中不放弃"
                            },
                            {
                                "target_lang_word": "挺过",
                                "target_lang_sense_clarification": "指熬过难关"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}