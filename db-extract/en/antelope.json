                        "glosses": [
                            "The pronghorn, Antilocapra americana."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "8ab9d007-bcd2-4628-a3b6-b2dda39463f7",
                                "sense_id": "9e6ae3a1-54e7-3d19-9ac5-a058e3cd5715",
                                "text": "Rarely antelopes are seen, but wolves, rabbits, and sundry ground squirrels abound."
                            },
                            {
                                "example_id": "62214c56-0ad4-4c21-8afe-292fb9e063d3",
                                "sense_id": "9e6ae3a1-54e7-3d19-9ac5-a058e3cd5715",
                                "text": "\"It reminds me of when I was hunting antelope in Colorado,\" he said to her."
                            }
                        ]
