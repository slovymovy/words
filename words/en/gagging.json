                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient experienced frequent <w>gaggings</w> during the medical examination.",
                            "target_lang_translations": {
                                "cs": "Pacient během lékařského vyšetření opakovaně <w>zažíval dávení</w>."
