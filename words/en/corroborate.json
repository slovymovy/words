{
    "word_family": [
        "corroboration",
        "corroborative",
        "corroborator",
        "corroboratory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9fbff597-c44d-35d9-a73e-b962c532a98f",
                    "sense_definition": "To confirm or support a statement, theory, or finding with additional evidence or testimony.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was able to <w>corroborate</w> the defendant's alibi by providing a time-stamped receipt.",
                            "target_lang_translations": {
                                "ru": "Свидетель смог <w>подтвердить</w> алиби подсудимого, предоставив чек с отметкой времени."
                            }
                        },
                        {
                            "text": "Recent scientific studies <w>corroborate</w> the evidence that regular exercise improves mental health.",
                            "target_lang_translations": {
                                "ru": "Недавние научные исследования <w>подкрепляют</w> доказательства того, что регулярные физические упражнения улучшают психическое здоровье."
                            }
                        }
                    ],
                    "synonyms": [
                        "confirm",
                        "verify",
                        "validate",
                        "substantiate",
                        "authenticate",
                        "uphold"
                    ],
                    "antonyms": [
                        "contradict",
                        "refute",
                        "disprove",
                        "rebut"
                    ],
                    "common_phrases": [
                        "corroborate the evidence",
                        "corroborate a story",
                        "corroborate the findings",
                        "corroborate the testimony"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подтверждать или подкреплять заявление, теорию или выводы дополнительными доказательствами или свидетельскими показаниями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтверждать",
                                "target_lang_sense_clarification": "заверять истинность высказывания или факта"
                            },
                            {
                                "target_lang_word": "подкреплять",
                                "target_lang_sense_clarification": "придавать весомость доказательствами"
                            },
                            {
                                "target_lang_word": "засвидетельствовать",
                                "target_lang_sense_clarification": "подтвердить достоверность как свидетель"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac5c5ddb-4d28-3928-9d28-fde7a087b5cb",
                    "sense_definition": "To make strong or to strengthen physically or mentally.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strengthening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor suggested a specific diet to <w>corroborate</w> the patient's weakened immune system.",
                            "target_lang_translations": {
                                "ru": "Врач предложил специальную диету, чтобы <w>укрепить</w> ослабленную иммунную систему пациента."
                            }
                        },
                        {
                            "text": "He sought to <w>corroborate</w> his resolve through daily meditation and discipline.",
                            "target_lang_translations": {
                                "ru": "Он стремился <w>поддержать</w> свою решимость с помощью ежедневной медитации и дисциплины."
                            }
                        }
                    ],
                    "synonyms": [
                        "strengthen",
                        "fortify",
                        "invigorate"
                    ],
                    "antonyms": [
                        "weaken",
                        "enfeeble"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense of physical strengthening is no longer in common usage."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать сильным или укреплять физически или ментально (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укреплять",
                                "target_lang_sense_clarification": "делать более сильным или стойким"
                            },
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "придавать силы организму или духу"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4a237d66-f4e4-3559-bf28-993b4e3b7606",
                    "sense_definition": "Having become strong or vigorous; strengthened.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "strengthening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener paid more attention to the sapling than to the <w>corroborate</w> oak tree.",
                            "target_lang_translations": {
                                "ru": "Садовник уделял больше внимания саженцу, чем <w>крепкому</w> дубу."
                            }
                        },
                        {
                            "text": "A <w>corroborate</w> mind is less likely to be swayed by popular opinion.",
                            "target_lang_translations": {
                                "ru": "<w>Окрепший</w> ум менее склонен поддаваться влиянию общественного мнения."
                            }
                        }
                    ],
                    "synonyms": [
                        "strong",
                        "vigorous",
                        "robust"
                    ],
                    "antonyms": [
                        "weak",
                        "frail"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "The adjective form is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ставший сильным или энергичным; укрепленный (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крепкий",
                                "target_lang_sense_clarification": "сильный и здоровый"
                            },
                            {
                                "target_lang_word": "окрепший",
                                "target_lang_sense_clarification": "ставший более сильным"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b8595054-f463-3b2f-8a5f-1bdba74ca8a2",
                    "sense_definition": "Being in a state of having been <w>corroborated</w>; confirmed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "confirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The facts, once <w>corroborate</w> by custom, were no longer questioned by the public.",
                            "target_lang_translations": {
                                "ru": "Факты, однажды <w>подтвержденные</w> обычаем, больше не подвергались сомнению общественностью."
                            }
                        },
                        {
                            "text": "He presented a <w>corroborate</w> account of the events to the committee.",
                            "target_lang_translations": {
                                "ru": "Он представил комитету <w>заверенный</w> отчет о событиях."
                            }
                        }
                    ],
                    "synonyms": [
                        "confirmed",
                        "verified"
                    ],
                    "antonyms": [
                        "unconfirmed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used as a past-participle adjective in older texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии подтвержденности; подтвержденный (архаизм)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подтвержденный",
                                "target_lang_sense_clarification": "доказанный или заверенный"
                            },
                            {
                                "target_lang_word": "узаконенный",
                                "target_lang_sense_clarification": "признанный обычаем или правом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}