                        "examples": [
                            {
                                "example_id": "b7375810-bea9-445a-b5b8-dbc68e91def1",
                                "sense_id": "4500177c-d516-3ea7-9845-8793f5bdc7b2",
                                "text": "Boterhammetje met asbest In drie ovens van Bakkersland, de grootste broodfabriek van Nederland, is de afgelopen jaren asbest vrijgekomen. Dat meldt het televisieprogramma Zembla vanavond. Minstens één keer is daarom een partij brood uit de handel gehaald. Bakkersland levert aan onder meer aan Albert Heijn en Jumbo. Onderzoekers weten overigens niet of het eten van asbest slecht is."
                            },
                            {
                                "example_id": "39abd069-dd44-4ef8-b99d-57148a8fcd54",
                                "sense_id": "4500177c-d516-3ea7-9845-8793f5bdc7b2",
                                "text": "\"Ze zeggen dat Afrikanen als huurlingen zijn gekomen om de Libiërs te vermoorden. We lopen hier groot gevaar\", zegt een Afrikaanse migrant in een broodfabriek."
                            }
                        ]
