                ],
                "senses": [
                    {
                        "sense_id": "af35a5e0-050f-3581-82e3-ea6c79e31ebf",
                        "entry_id": "74f7be75-cdd4-3338-9f71-d97e3762f51a",
                        "glosses": [
                            "Nom du valet de cœur, au jeu du reversi, et principale carte de ce jeu."
                        ],
                        "tags": [
                            "Cartes à jouer"
                        ],
                        "examples": [
                            {
                                "example_id": "b5f00ec6-cef7-4850-9667-8f6155c75c0e",
                                "sense_id": "af35a5e0-050f-3581-82e3-ea6c79e31ebf",
                                "text": "Forcer le quinola."
                            },
                            {
                                "example_id": "d167d0b6-e206-434e-bed0-a44c6e47e424",
                                "sense_id": "af35a5e0-050f-3581-82e3-ea6c79e31ebf",
                                "text": "Énéas d’Hélène la belle\nAvait, au jeu de la mérelle,\nAutres disent au quinola,\nGagné ces belles nippes-là,"
                            },
                            {
                                "example_id": "c9c6f105-b4b8-4b61-bcf6-c45b8347e1b8",
                                "sense_id": "af35a5e0-050f-3581-82e3-ea6c79e31ebf",
                                "text": "C’est un secours [le mot vapeurs] pour expliquer mille choses qui n’ont point de nom : notre ignorance s’en accommode comme d’un quinola à prime."
                            }
                        ]
                    },
                    {
                        "sense_id": "805bc830-8b17-3b68-9d1c-993b2e6eee73",
                        "entry_id": "74f7be75-cdd4-3338-9f71-d97e3762f51a",
                        "glosses": [
                            "Il s’est dit d’un valet de chambre ou d’un autre homme gagé qui mène une dame."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "047858e9-271e-4fde-bb52-796b35d2fcd8",
                                "sense_id": "805bc830-8b17-3b68-9d1c-993b2e6eee73",
                                "text": "Le généalogiste est payé pour cela : Il tire d’un héros le fils d’un quinola,"
                            },
                            {
                                "example_id": "76b26b81-dee4-4562-b42f-dc31acb9ecf2",
                                "sense_id": "805bc830-8b17-3b68-9d1c-993b2e6eee73",
                                "text": "Te souvient-il bien d’Alcala,\nQuand, Ganymède ou quinola,\nL’amour de certaine fruitière\nTe causa maints coups d’étrivière ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "8112d88b-0de1-377d-9d3c-77ad2a306d6c",
                        "entry_id": "74f7be75-cdd4-3338-9f71-d97e3762f51a",
                        "glosses": [
                            "Surnom du reversi."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4015aa59-adff-48f8-8470-a83d5d0df16c",
                                "sense_id": "8112d88b-0de1-377d-9d3c-77ad2a306d6c",
                                "text": "Jouer au quinola."
                            }
                        ]
                    }
