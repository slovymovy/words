                "senses": [
                    {
                        "sense_id": "7c97a8ab-8ef8-3569-ab97-c95ea4067a7b",
                        "entry_id": "0303fa89-4c7f-372c-8ef2-adc0be32197b",
                        "glosses": [
                            "einseitig geprägte Münze, die aus einem dünnen Silberblech besteht; das Stempelbild der Vorderseite erscheint auf der Rückseite vertieft; kommt in dem 12. Jahrhundert auf, und erreicht ihre größte Verbreitung im hohen Mittelalter"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a4c2d569-8d1a-4997-bd38-7172118af1d0",
                                "sense_id": "7c97a8ab-8ef8-3569-ab97-c95ea4067a7b",
                                "text": "Ein Hohlpfennig mit dem Münsterschen Balken."
                            },
                            {
                                "example_id": "31fe02b2-a020-45ba-ae2a-231218d100c5",
                                "sense_id": "7c97a8ab-8ef8-3569-ab97-c95ea4067a7b",
                                "text": "„Noch länger begnügten sich die norddeutschen Hansestädte mit einer kleinen Pfennigmünze, dem Hohlpfennig, der nur ein Viertel des Sterlings wert war.“"
                            }
                        ],
