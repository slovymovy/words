                        "sense_id": "ca99e62d-cac1-3e35-911c-71a004352b22",
                        "entry_id": "1c88aab5-2df5-308e-a232-e2c812725f05",
                        "glosses": [
                            "Écrit concernant un ou des jeux, en particulier, liste de jeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36e55dde-7126-4ce5-b227-6580ecb5cfdf",
                                "sense_id": "ca99e62d-cac1-3e35-911c-71a004352b22",
                                "text": "— Tout ce beau discours pour finalement faire sa petite pub, les businessmen n'ont pas de cœur.\nMalgré une profonde mélancolie envers la ludographie de l'auteur, Jean ne put s'empêcher de se le dire. […]. Une fois son abreuvage en informations et caféine terminé, il se mit en route."
                            }
                        ]
                    },
                    {
                        "sense_id": "b112b579-a1b8-3b6b-b151-a3439f551dd9",
                        "entry_id": "1c88aab5-2df5-308e-a232-e2c812725f05",
                        "glosses": [
                            "Ensemble des jeux produit par un éditeur ou par un auteur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8271ef9d-0dcc-4d1c-b542-54e22ebba104",
                                "sense_id": "b112b579-a1b8-3b6b-b151-a3439f551dd9",
                                "text": "Mélange de mécaniques issues des Sims et de la série des Theme, The Movies n'apparaît a priori pas comme un titre majeur dans la ludographie de Molyneux, et ce, d'autant plus qu'il n'y a participé qu'à la marge."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5ed6768-a7a7-476f-bd64-abd7dbd509e7",
                        "source_entry_id": "1c88aab5-2df5-308e-a232-e2c812725f05",
