                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f663a6a-e79c-4900-8b39-6b0d51d7cb0c",
                                "sense_id": "0fe2a61f-4798-32e4-9884-b1d27752f259",
                                "text": "Chcę, żebyś mi zaraz dał na misie głowę Jana Chrzciciela."
                            },
                            {
                                "example_id": "c947ab58-45b1-4f42-bbbe-3dafd8f9ecfe",
                                "sense_id": "0fe2a61f-4798-32e4-9884-b1d27752f259",
                                "text": "Zwiedziliśmy kościół pw. św. Jana Chrzciciela."
                            },
                            {
                                "example_id": "11fbf4e1-2fd5-4f66-8e6d-f8b8b8b06e65",
                                "sense_id": "0fe2a61f-4798-32e4-9884-b1d27752f259",
                                "text": "Byliśmy na grobie ks. Cybulskiego, mojego chrzciciela."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
