                ],
                "translations": [
                    {
                        "translation_id": "1fdd24ff-588b-408c-810f-b7082fa6f0a0",
                        "source_entry_id": "516c4538-a846-3861-a591-fe10e9177456",
                        "source_sense_id": "728c327f-6673-38c4-ba7c-d3f85f3956cb",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Krankhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "baa866de-01e6-4184-9e67-ba45712c9da0",
                        "source_entry_id": "516c4538-a846-3861-a591-fe10e9177456",
                        "source_sense_id": "728c327f-6673-38c4-ba7c-d3f85f3956cb",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Mangelhaftigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mangelhaftigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "52584f35-b2d9-3c7c-bf81-72e9480c72d9",
                                        "entry_id": "3821fac5-1054-3e11-b789-076a3a68a0cf",
                                        "glosses": [
                                            "Eigenschaft, Zustand, gewisse Mängel, Fehler, Unvollkommenheiten aufzuweisen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e470f6f5-5f9a-449d-a0c9-72aef3c6219f",
                                                "sense_id": "52584f35-b2d9-3c7c-bf81-72e9480c72d9",
                                                "text": "„Eine Berufung auf die Mangelhaftigkeit des Beschlusses ist nach Ablauf der Anfechtungsfrist nicht mehr möglich.“"
                                            },
                                            {
                                                "example_id": "198828aa-bc13-4eb9-bef0-f038a457c743",
                                                "sense_id": "52584f35-b2d9-3c7c-bf81-72e9480c72d9",
                                                "text": "„Nicht mangelhafte Minderheitsrechte schwächen die Opposition, sondern oppositionelle Mangelhaftigkeit.“"
                                            },
                                            {
                                                "example_id": "04eb0f4a-4921-44ec-9789-bc8874f47ac2",
                                                "sense_id": "52584f35-b2d9-3c7c-bf81-72e9480c72d9",
                                                "text": "„Die entblößten Politiker werden zum ‚Symbol der Mangelhaftigkeit der Republik‘, so der Historiker Mühlhausen.“"
                                            },
                                            {
                                                "example_id": "e71fb217-7f09-4ee9-9913-dd37180560a8",
                                                "sense_id": "52584f35-b2d9-3c7c-bf81-72e9480c72d9",
                                                "text": "„Im Ungenügen also an dem einen Dasein, das uns gegeben ist, an der Mangelhaftigkeit unserer Gefühle, der Begrenztheit der Wege, die uns offen stehen, sah der Mitgründer dieser Festspiele die Wurzel unserer Faszination für das Theater.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "18b915ce-22f1-37c3-aa5a-0ea96cab4747",
                                        "entry_id": "3821fac5-1054-3e11-b789-076a3a68a0cf",
                                        "glosses": [
                                            "etwas, das [1] hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac803a62-fac5-4230-ae04-514c46f0147c",
                                                "sense_id": "18b915ce-22f1-37c3-aa5a-0ea96cab4747",
                                                "text": "„‚Wir akzeptieren hier Menschen, Mangelhaftigkeiten und alles.‘“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8a66ccff-ea69-4115-8748-0b29815a2bce",
                        "source_entry_id": "516c4538-a846-3861-a591-fe10e9177456",
                        "source_sense_id": "728c327f-6673-38c4-ba7c-d3f85f3956cb",
                        "source_sense_description": "sdÜ",
                        "target_lang_word": "Schwäche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwäche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "mangelnde körperliche oder geistige Kraft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4057b4a-6120-4b59-895c-f424d19b1b53",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "Mich überkam plötzlich eine unerklärliche Schwäche in den Beinen."
                                            },
                                            {
                                                "example_id": "38775ebb-8556-4968-b538-df9495bfbd74",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Wobei ich eine klitzekleine Schwäche habe, die ich den Damen gern verschweige.“"
                                            },
                                            {
                                                "example_id": "6d99c57e-2a2d-4df2-a74c-807093a9b6a7",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Allgemeine Schwäche des Körpers und erhöhte Reizbarkeit des Nervensystems gesellen sich dazu.“"
                                            },
                                            {
                                                "example_id": "867dee60-c3ac-4dbb-aa75-25fae341ac8d",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "„Meine Schwäche ist wie weggeblasen.“"
                                            },
                                            {
                                                "example_id": "69ee443b-1417-461c-aed3-2dd30c8a8259",
                                                "sense_id": "819e2bf5-421e-3eae-bb34-97126db695f6",
                                                "text": "[Covid-19-Erkrankungen:] „Andere Genesene leiden unter einem Taubheitsgefühl, Schwäche und Gedächtniseinschränkungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bfe74d3-0a00-3352-9c54-fc41f4caba5a",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "charakterlicher Mangel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff8faae0-9017-4c24-8858-e56f63d34ea9",
                                                "sense_id": "5bfe74d3-0a00-3352-9c54-fc41f4caba5a",
                                                "text": "Mangelnder Einsatzwille ist keine Schwäche von ihm."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "45dd42d1-6602-3255-b38f-426ccae9eb59",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "besondere Neigung zu etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de28c156-b7e8-4512-b221-e7e364694eb3",
                                                "sense_id": "45dd42d1-6602-3255-b38f-426ccae9eb59",
                                                "text": "Er hat eine Schwäche für dunkle Schokolade."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                        "entry_id": "04e7b1a9-9ca6-32f4-ad09-3d60802a0e1f",
                                        "glosses": [
                                            "sachliche Unvollkommenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a97410-90d0-42ab-9170-41197bf05ba6",
                                                "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                                "text": "Die Literaturkritiker versuchen, die Schwächen literarischer Werke herauszufinden."
                                            },
                                            {
                                                "example_id": "8f4b0b50-764a-4d76-bec9-c288d966b321",
                                                "sense_id": "533b2f12-0f36-39c9-b0d1-4641f27f12fb",
                                                "text": "„Die Schwäche des E-Autos liegt darin, dass es so viel mehr mineralische Rohstoffe benötigt als die Verbrenner, darunter etliche kritische Materialien, die oft unter fragwürdigen Bedingungen abgebaut werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2567623e-dde4-4f8e-8c53-c4556e9167ae",
