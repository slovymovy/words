                        ],
                        "form": "den Handkuss"
                    },
                    {
                        "form_id": "2af2ef04-f70e-43d6-a949-a4cc81a1805b",
                        "entry_id": "7d75aa21-87c6-39dc-a766-550a5efb508e",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Handküsse"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                        "entry_id": "7d75aa21-87c6-39dc-a766-550a5efb508e",
                        "glosses": [
                            "das Küssen des Handrückens zur Begrüßung oder Verabschiedung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8353d861-3a74-4a47-851f-8f05a3194deb",
                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                "text": "Bisweilen begrüßte er die vornehmen Damen noch nach alter feiner Art mit einem Handkuss."
                            },
                            {
                                "example_id": "ea5e53e2-8ae6-4ed1-9440-e07714ee7682",
                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                "text": "Beim Handkuss dürfen die Lippen niemals die Hände der Frau direkt berühren."
                            },
                            {
                                "example_id": "12776a8f-aa37-4ef4-a91f-d9e62590f87f",
                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                "text": "Um einer Dame eine besondere Verehrung zu erweisen, kniet der Herr während des Handkusses vor ihr nieder."
                            },
                            {
                                "example_id": "a059355f-bae7-4428-b06d-7907d9c916c3",
                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                "text": "Heute ist der Handkuss eher selten geworden."
                            },
                            {
                                "example_id": "7b0126c9-8de9-455d-989c-1bf95eecf50c",
                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                "text": "Mit einem Handkuss verabschiedete sich der Herr von seiner Tanzpartnerin."
                            },
                            {
                                "example_id": "32c9dc3e-e492-4349-813e-978909efd241",
                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                "text": "„Als Thomas sich bemerkbar machen wollte, kam ein weiterer Mann auf sie zu, der sie mit Handkuss begrüßte.“"
                            },
                            {
                                "example_id": "196dac21-cd06-4322-be3c-5e4bad87bdab",
                                "sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
                                "text": "„Unter Scherzen über das Abenteuer und Handküssen sagte ich ihr, ich sei davon überzeugt, daß ich sie von ihrer Gewitterangst geheilt hätte, daß sie aber niemandem das Geheimnis verraten werde, wem sie diese Heilung verdanke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1872c6ca-9874-4c1d-a43e-dedaa34a70fc",
                        "source_entry_id": "7d75aa21-87c6-39dc-a766-550a5efb508e",
                        "source_sense_id": "7d078008-8521-3cd3-ab08-a7458dc3829b",
