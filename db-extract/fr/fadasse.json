        "fr-extract.jsonl": [
            {
                "entry_id": "32fbf651-9b96-3bd5-b86d-fcde69d8daf8",
                "word": "fadasse",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "520ad1fe-e0ea-44c9-890c-f81da08cbadd",
                        "entry_id": "32fbf651-9b96-3bd5-b86d-fcde69d8daf8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "fadasses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0352bd11-77cb-324e-80ab-2f16436a1b32",
                        "entry_id": "32fbf651-9b96-3bd5-b86d-fcde69d8daf8",
                        "glosses": [
                            "Qui donne une certaine impression de fadeur."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "511f0d40-4d3c-40f0-bced-4bae9f37655a",
                                "sense_id": "0352bd11-77cb-324e-80ab-2f16436a1b32",
                                "text": "Vois-tu, ma petite, il n’a connu que des femmes pâles, fadasses, comme elles sont toutes dans le Nord ; une fille brune, svelte, jeune comme moi, ça lui a réchauffé le cœur."
                            },
                            {
                                "example_id": "24a02dc5-e1bc-41af-9c57-bf1a04111999",
                                "sense_id": "0352bd11-77cb-324e-80ab-2f16436a1b32",
                                "text": "— Un de vous sait-il jouer du cornet à piston ? nous demanda le gros rougeaud.\n— Oui, moi, dit Mattia, mais je n’en ai pas.\n— Je vas aller vous en chercher un, parce que le violon c’est joli, mais c’est fadasse."
                            },
                            {
                                "example_id": "b48fb7f7-6ffe-484c-98bf-23fe7307f494",
                                "sense_id": "0352bd11-77cb-324e-80ab-2f16436a1b32",
                                "text": "Celui-là n’a pas de volonté du tout ; un gamin blond fadasse, à visage anguleux, incolore, qui reste où on le consigne sans oser décamper. Ni bon, ni méchant, il n’est pas sympathique ; il tortille un dos craintif de bas fonctionnaire ; ses jeux diffèrent de ceux des camarades ; tous ses gestes ont des crans d’arrêt : on dirait que la surveillance l’a aplati jusqu’à lui retirer du souffle, jusqu’à l’estropier."
                            },
                            {
                                "example_id": "f322b07a-4e89-4c4c-b6cc-353f4afb4b08",
                                "sense_id": "0352bd11-77cb-324e-80ab-2f16436a1b32",
                                "text": "Vous vous trouvez ici en face d’un personnage considérable, un officier vainqueur qui fut candidat à la Présidence de la République, et qui n’admettrait pas une de ces vérités tronquées, un de ces demi-mensonges, enfin je ne sais quelle affreuse potion fadasse et calmante à l’usage des faibles."
                            },
                            {
                                "example_id": "80114898-8b96-463e-851a-f5a50c11ce3b",
                                "sense_id": "0352bd11-77cb-324e-80ab-2f16436a1b32",
                                "text": "Vous êtes la friandise de choix au bout d’un long repas indigeste et fadasse."
                            },
                            {
                                "example_id": "2979cf84-2df9-442d-aaf5-1c2ec640325c",
                                "sense_id": "0352bd11-77cb-324e-80ab-2f16436a1b32",
                                "text": "Les ouvrages de dévotion fadasse abondent, et sont presque le seul aliment spirituel de Mathilde."
                            },
                            {
                                "example_id": "1a10f9e6-72b0-47c0-9f24-523acc06b4f5",
                                "sense_id": "0352bd11-77cb-324e-80ab-2f16436a1b32",
                                "text": "Il a validé le très fadasse discours de rentrée de la présidente à Brachay, lu sans conviction devant un public clairsemé et déprimé."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e9eb7d4-3452-3ca2-8d67-aa989bb92841",
                        "entry_id": "32fbf651-9b96-3bd5-b86d-fcde69d8daf8",
                        "glosses": [
                            "Féminin de fada : folle, stupide ou simple d'esprit."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "c78b2de2-e837-4afc-a802-da1e00744272",
                                "sense_id": "5e9eb7d4-3452-3ca2-8d67-aa989bb92841",
                                "text": "Elle est fadasse mais elle doit avoir des compétences sexuelles impressionnantes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6efc7f5-02df-4909-b47c-e78c1c06d806",
                        "source_entry_id": "32fbf651-9b96-3bd5-b86d-fcde69d8daf8",
