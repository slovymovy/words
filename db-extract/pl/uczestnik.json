                                        "glosses": [
                                            "One who participates."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d0a70c7-b5b9-4093-8774-e607663e36fb",
                                                "sense_id": "f55f70cc-d849-394f-837d-25ee881457b9",
                                                "text": "Near-synonyms: entrant, partaker"
                                            },
                                            {
                                                "example_id": "e113b384-13a4-4ee7-8f4f-30923fbb5984",
                                                "sense_id": "f55f70cc-d849-394f-837d-25ee881457b9",
                                                "text": "All participants must adhere to the rules of the competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "61ea281a-df78-3917-8e40-73ff19ee0104",
                                        "entry_id": "52e5e305-8928-39df-b19c-6e4c35de7f6e",
                                        "glosses": [
                                            "One who participates.",
                                            "A human subject in a scientific experiment, such as a clinical trial"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4d8ac0-ccb0-4a55-aac3-2d90a0f0aa59",
                                                "sense_id": "61ea281a-df78-3917-8e40-73ff19ee0104",
                                                "text": "a research participant"
                                            },
                                            {
                                                "example_id": "6164c156-067c-4d8d-bfcc-f2a1cfbfceb9",
                                                "sense_id": "61ea281a-df78-3917-8e40-73ff19ee0104",
                                                "text": "In this study, participants were randomly assigned to either a control arm or a treatment arm."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "participant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "afe2f8b3-74ed-3bc8-94d6-00d156b45b2e",
                                        "entry_id": "8861e24b-124c-3f2b-9759-48dc1f9b182d",
                                        "glosses": [
                                            "Sharing; participating; having a share of part."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6717d1f5-3db3-417a-abca-441933459016",
                                                "sense_id": "afe2f8b3-74ed-3bc8-94d6-00d156b45b2e",
                                                "text": "Therefore during the parliament he published his royal proclamation, offering pardon and grace of restitution to all such as had taken arms, or been participant of any attempts against him;"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a9dc60df-6490-4d8b-a234-bde99e30745d",
