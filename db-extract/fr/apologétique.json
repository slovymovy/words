        "fr-extract.jsonl": [
            {
                "entry_id": "877529bc-f9fb-380d-8fa5-a583f8def63d",
                "word": "apologétique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8d22a1a0-c0a2-456a-b618-2b99c89a6b9e",
                        "entry_id": "877529bc-f9fb-380d-8fa5-a583f8def63d",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "apologétiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                        "entry_id": "877529bc-f9fb-380d-8fa5-a583f8def63d",
                        "glosses": [
                            "Qui contient une apologie, défensif, justificatif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6f6b312-58bf-4610-9b04-5ca9126e6ead",
                                "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                "text": "Cette attitude violente parut soudainement décourager Jacques qui cependant entreprit un discours qui voulait être à la fois apologétique et pithiatique mais Dominique l’interrompit pour expliquer posément qu’elle n’acceptait d’hommages que platoniques et qu’il ne pouvait être question entre eux des viles et stercoraires réalisations de l’amour charnel."
                            },
                            {
                                "example_id": "3592eef4-e95f-4dc1-8814-96d5bc8bb9ad",
                                "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                "text": "L’idée d’écrire des romans apologétiques a quelque chose d’horrifiant à mes yeux. J’aimerais mieux ne plus jamais écrire que de fabriquer une œuvre d’imagination qui tende à prouver quoi que ce soit."
                            },
                            {
                                "example_id": "e18f95a7-c012-4c21-ac58-36b8e26882a3",
                                "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                "text": "Une étape des plus importantes dans cette direction est l’appel des radicaux à l’authenticité, le refus de la modernité, de l’islam apologétique moderniste et le retour de l’islam lui-même à la politique active."
                            },
                            {
                                "example_id": "e2cefbb0-8333-4c7d-889e-38767eebe404",
                                "sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                                "text": "Un Mémoire apologétique de sa conduite qu’il publia à cette occasion fut solidement réfuté par l’abbé Tharin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2dcdb2a9-cb5a-4150-8586-5e138658dc41",
                        "source_entry_id": "877529bc-f9fb-380d-8fa5-a583f8def63d",
                        "source_sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                        "source_sense_description": "Qui contient une apologie",
                        "target_lang_word": "apologetisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologetisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da23de1a-d632-3400-abe3-bbb721c16643",
                                        "entry_id": "4c317d5c-62e4-3cf9-843c-310554eb3c9a",
                                        "glosses": [
                                            "rechtfertigend, (sich) verteidigend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f5ad7b-7c27-4219-bdab-37074873d8ee",
                                                "sense_id": "da23de1a-d632-3400-abe3-bbb721c16643",
                                                "text": "Es muss möglich sein, über ein Wirtschaftssystem zu debattieren, ohne im Hintergrund – und sei es zu apologetischen Zwecken! – auf die Juden zu zeigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "63e5606e-6eaf-3a6b-92cb-246b51e452b3",
                                        "entry_id": "4c317d5c-62e4-3cf9-843c-310554eb3c9a",
                                        "glosses": [
                                            "die Apologetik (Rechtfertigung des Glaubens) betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b14b51f-7dec-4cb4-a11b-f108b5c8ebe1",
                                                "sense_id": "63e5606e-6eaf-3a6b-92cb-246b51e452b3",
                                                "text": "… Andernfalls gerät die Apologetik in zwei typische … Gefahren: „einmal, dass sie sich in ihrer Eigenart u. Funktion nicht mehr als theol. Disziplin versteht, zum andern in die Gefahr, dass sie jene Züge annimmt, die für eine “rein apologetische Einstellung„ geistesgeschichtlich und geistespolitisch typisch sind, wie z.B. ideologieverdächtige Kurzschlüssigkeit;“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aeb47133-84f9-4488-8c9c-a211a2d965c1",
                        "source_entry_id": "877529bc-f9fb-380d-8fa5-a583f8def63d",
                        "source_sense_id": "c1c5de2b-03f3-3bd8-9ad3-a07a446096e3",
                        "source_sense_description": "Qui contient une apologie",
                        "target_lang_word": "apologetic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "apologetic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8cd03ad5-84dd-3d9d-b7a3-e6c6d7e0f2ae",
                                        "entry_id": "eb8d155a-caec-3b19-b006-bc5ae76e6437",
                                        "glosses": [
                                            "Having the character of apology; regretfully excusing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4ac24a3-a629-4b72-b66a-855fefc9f71b",
                                                "sense_id": "8cd03ad5-84dd-3d9d-b7a3-e6c6d7e0f2ae",
                                                "text": "His tone was apologetic as he explained what had happened."
                                            },
                                            {
                                                "example_id": "05850a04-ffb0-48f0-a3cb-bd4ec63810e7",
                                                "sense_id": "8cd03ad5-84dd-3d9d-b7a3-e6c6d7e0f2ae",
                                                "text": "Very different was he, however, from the brusque and masterful professor of common sense who had taken over the case so confidently at Upper Norwood. His expression was downcast, and his bearing meek and even apologetic."
                                            },
                                            {
                                                "example_id": "9510ed37-95a1-4203-aa8b-1f67034658f5",
                                                "sense_id": "8cd03ad5-84dd-3d9d-b7a3-e6c6d7e0f2ae",
                                                "text": "Aberdeen Joint is a fine station. Its approach is a real approach, not an apologetic side-street; its granite building has a dignity in keeping with the famous city skyline it faces, [...]."
                                            },
                                            {
                                                "example_id": "ca870285-2394-4d94-9d24-8b319d750d9d",
                                                "sense_id": "8cd03ad5-84dd-3d9d-b7a3-e6c6d7e0f2ae",
                                                "text": "Scott, somewhat stunned and now worried that everybody might have opened fire at the U.S. destroyers (he presumably missed Laffey and Farenholt merrily blazing away with their own guns into the darkness), ordered all firing to cease after a couple of minutes. Helena, along with Boise, was already several hundred shells lighter, and both Boise and San Francisco herself actually kept firing, as their captains were utterly sure about their targets; San Franciscos captain was very apologetic' as he overruled Admiral Scott."
                                            },
                                            {
                                                "example_id": "16c25ced-c1d3-43cc-b648-a7ad0ff2dbb6",
                                                "sense_id": "8cd03ad5-84dd-3d9d-b7a3-e6c6d7e0f2ae",
                                                "text": "At Paisley, a station staff member politely but firmly asks why RAIL is taking so many photographs. The reply - that it's a magnificent station worthy of pictures - changes his demeanour and he's then very apologetic and says he \"has to ask\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "920b07a9-a2ea-39af-a19a-b25ff2e2256f",
                                        "entry_id": "eb8d155a-caec-3b19-b006-bc5ae76e6437",
                                        "glosses": [
                                            "Defending by words or arguments; said or written in defense."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
