                                        "glosses": [
                                            "The fur of an animal; the animal coat of its own fur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96582420-f716-437d-bbb2-46b539d174ea",
                                                "sense_id": "44ba73dd-f3ba-38ba-b5c4-c71cdd03775b",
                                                "text": "Rebecca found herself involuntarily holding her breath and a moment later she spotted the beautiful rusty fur coat of a fox emerging from the bushes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4c4dbc44-8395-4ec4-ad95-7a542f6f8c4e",
                        "source_entry_id": "37ae8ae3-83ac-3fec-9ef3-f4a07fe6c7a3",
                        "source_sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
