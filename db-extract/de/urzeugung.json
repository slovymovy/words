                "senses": [
                    {
                        "sense_id": "c5eb4acf-b2ec-3116-b124-81e21963ecc6",
                        "entry_id": "c478b50e-90a3-3661-a26d-2f0fe851eec2",
                        "glosses": [
                            "die Vorstellung einer elternlosen Entstehung von Lebewesen aus unbelebter Materie wie Schlamm oder ähnlichen Stoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cca47c91-a52a-4343-acbc-9dccf7ca1333",
                                "sense_id": "c5eb4acf-b2ec-3116-b124-81e21963ecc6",
                                "text": "Das Konzept der Urzeugung geht auf Aristoteles zurück und wurde erst im 19. Jahrhundert durch Louis Pasteur widerlegt."
                            },
                            {
                                "example_id": "12f675d7-db4e-4d66-b682-fb15e24947c9",
                                "sense_id": "c5eb4acf-b2ec-3116-b124-81e21963ecc6",
                                "text": "Die Urzeugung ist eine Hypothese der Entstehung des Lebens auf der Erde ohne einen göttlichen Schöpfungsakt."
                            },
                            {
                                "example_id": "10deadbb-5945-4334-9193-564a87d403a8",
                                "sense_id": "c5eb4acf-b2ec-3116-b124-81e21963ecc6",
                                "text": "„Die Herkunft der Lebewesen wurde mit Schöpfungsmythen erklärt, dazu gab es Vorstellungen über Urzeugung von Würmern, Fröschen, Kröten, Mäusen und anderem Getier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
