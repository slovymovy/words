                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Patronentasche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6a7df1a-777d-38f1-8adc-f0a7d9dcc468",
                                        "entry_id": "c03e7e28-693f-368b-b5a5-846b2feb02ac",
                                        "glosses": [
