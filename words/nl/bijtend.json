                    "sense_id": "70bc2920-9267-33c1-8405-863361251481",
                    "sense_definition": "zo scherp of agressief dat het weefsel of materiaal aantast of pijn veroorzaakt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_aantastend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Draag altijd beschermende handschoenen wanneer je met een <w>bijtend</w> zuur werkt.",
                            "target_lang_translations": {
                                "fr": "Portez toujours des gants de protection lorsque vous travaillez avec un acide <w>corrosif</w>."
                            }
                        },
                        {
                            "text": "Buiten waaide een <w>bijtende</w> kou die meteen door onze kleding heen drong.",
                            "target_lang_translations": {
                                "fr": "Dehors soufflait un froid <w>mordant</w> qui traversait immédiatement nos vêtements."
                            }
                        }
                    ],
                    "synonyms": [
                        "agressief",
                        "doordringend",
                        "inbijtend",
                        "invretend",
                        "prikkelend"
                    ],
                    "common_phrases": [
                        "bijtend zuur",
                        "bijtende kou"
                    ],
                    "target_lang_definitions": {
                        "fr": "tellement agressif ou piquant qu'il attaque la matière ou provoque une vive douleur"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "corrosif",
                                "target_lang_sense_clarification": "chimie ou matière"
                            },
                            {
