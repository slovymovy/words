    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e82d5980-d482-3588-80ce-6a37c4bb03c2",
                    "sense_definition": "Of or relating to human society, the interaction of the individual and the group, or the welfare of human beings as members of society.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "society_related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Unemployment is a major <w>social</w> problem that affects the whole country.",
                            "target_lang_translations": {
                                "ru": "Безработица — это серьезная <w>социа́льная</w> проблема, которая затрагивает всю страну.",
                                "zh": "失业是一个影响全国的重大<w>社会</w>问题。"
                            }
                        },
                        {
                            "text": "She is studying the <w>social</w> changes that occurred during the industrial revolution.",
                            "target_lang_translations": {
                                "ru": "Она изучает <w>социа́льные</w> изменения, произошедшие во время промышленной революции.",
                                "zh": "她正在研究工业革命期间发生的<w>社会</w>变革。"
                            }
                        }
                    ],
                    "synonyms": [
                        "societal",
                        "communal",
                        "collective",
                        "public"
                    ],
                    "common_phrases": [
                        "social issues",
                        "social worker",
                        "social science",
                        "social structure",
                        "social services"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к человеческому обществу, взаимодействию индивида и группы или благосостоянию людей.",
                        "zh": "与人类社会、个人与群体之间的互动，或作为社会成员的人类福祉有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "социа́льный",
                                "target_lang_sense_clarification": "относящийся к жизни людей в обществе"
                            },
                            {
                                "target_lang_word": "обще́ственный",
                                "target_lang_sense_clarification": "связанный с обществом, коллективный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社会",
                                "target_lang_sense_clarification": "与社会相关的"
                            },
                            {
                                "target_lang_word": "社会性",
                                "target_lang_sense_clarification": "涉及社会属性的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c50fe88a-c81c-3702-a1fa-e866edcf22b7",
                    "sense_definition": "Likely to seek or enjoy the company of others; friendly and extroverted.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "personality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "James is a very <w>social</w> guy who knows lots of people in town.",
                            "target_lang_translations": {
                                "ru": "Джеймс — очень <w>общи́тельный</w> парень, который знает много людей в городе.",
                                "zh": "詹姆斯是一个非常<w>善于交际</w>的人，他在城里认识很多人。"
                            }
                        },
                        {
                            "text": "I am feeling quite <w>social</w> today and would love to go to the party.",
                            "target_lang_translations": {
                                "ru": "Я сегодня довольно <w>общи́тельный</w> и с удовольствием пошел бы на вечеринку.",
                                "zh": "我今天很有<w>社交</w>兴致，很想去参加那个派对。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outgoing",
                        "friendly",
                        "extroverted",
                        "sociable"
                    ],
                    "antonyms": [
                        "antisocial",
                        "unsocial",
                        "asocial"
                    ],
                    "common_phrases": [
                        "social life",
                        "social butterfly",
                        "social skills"
                    ],
                    "target_lang_definitions": {
                        "ru": "Склонный искать или любить общество других; дружелюбный и открытый.",
                        "zh": "喜欢寻求或享受他人陪伴的；友好的、外向的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общи́тельный",
                                "target_lang_sense_clarification": "любящий общаться"
                            },
                            {
                                "target_lang_word": "коммуника́бельный",
                                "target_lang_sense_clarification": "легко устанавливающий контакты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "善于交际",
                                "target_lang_sense_clarification": "喜欢与人交往"
                            },
                            {
                                "target_lang_word": "外向",
                                "target_lang_sense_clarification": "性格开朗"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a1e7822-26ab-3adf-99cd-d49ffa4564e3",
                    "sense_definition": "Relating to social media applications, websites, or networks.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has developed a new <w>social</w> gaming platform for teenagers.",
                            "target_lang_translations": {
                                "ru": "Компания разработала новую <w>социа́льную</w> игровую платформу для подростков.",
                                "zh": "该公司开发了一个面向青少年的新型<w>社交</w>游戏平台。"
                            }
                        },
                        {
                            "text": "We need to improve our <w>social</w> strategy to reach more customers online.",
                            "target_lang_translations": {
                                "ru": "Нам нужно улучшить нашу <w>социа́льную</w> стратегию, чтобы охватить больше клиентов в интернете.",
                                "zh": "我们需要改进我们的<w>社交</w>策略，以在网上接触到更多的客户。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "social media",
                        "social network",
                        "social platform"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к приложениям, веб-сайтам или сетям социальных медиа.",
                        "zh": "与社交媒体应用、网站或网络有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "социа́льный",
                                "target_lang_sense_clarification": "относящийся к соцсетям"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "社交",
                                "target_lang_sense_clarification": "与社交网络相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9e1ddca-549c-3743-869e-13857af00f9b",
                    "sense_definition": "Living together in organized communities or groups (used especially of insects or animals).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ants are <w>social</w> insects that work together for the benefit of the colony.",
                            "target_lang_translations": {
                                "ru": "Муравьи — это <w>обще́ственные</w> насекомые, которые работают вместе на благо колонии.",
                                "zh": "蚂蚁是<w>群居</w>昆虫，它们为了蚁群的利益共同协作。"
                            }
                        },
                        {
                            "text": "Bees are known for their complex <w>social</w> structures and communication.",
                            "target_lang_translations": {
                                "ru": "Пчелы известны своими сложными <w>социа́льными</w> структурами и коммуникацией.",
                                "zh": "蜜蜂以其复杂的<w>社会性</w>结构和交流方式而闻名。"
                            }
                        }
                    ],
                    "synonyms": [
                        "communal"
                    ],
                    "common_phrases": [
                        "social insect",
                        "social animal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Живущие вместе в организованных сообществах или группах (о насекомых или животных).",
                        "zh": "生活在有组织的群体或社会中（尤指昆虫或动物）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обще́ственный",
                                "target_lang_sense_clarification": "живущий в сообществе (биол.)"
                            },
                            {
                                "target_lang_word": "социа́льный",
                                "target_lang_sense_clarification": "образующий сложные сообщества"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "群居",
                                "target_lang_sense_clarification": "生物学上成群生活"
                            },
                            {
                                "target_lang_word": "社会性",
                                "target_lang_sense_clarification": "具有复杂社会结构的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8036b013-9146-3564-9526-eebdc326217f",
                    "sense_definition": "A social media account, username, or profile.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can find the links to all their <w>socials</w> in the video description.",
                            "target_lang_translations": {
                                "ru": "Вы можете найти ссылки на все их <w>соцсе́ти</w> в описании видео.",
                                "zh": "你可以在视频描述中找到他们所有<w>社交账号</w>的链接。"
                            }
                        },
                        {
                            "text": "He decided to delete his <w>socials</w> to focus on his mental health.",
                            "target_lang_translations": {
                                "ru": "Он решил удалить свои <w>соцсе́ти</w>, чтобы сосредоточиться на своем психическом здоровье.",
                                "zh": "他决定注销自己的<w>社交账号</w>，以便专注于心理健康。"
                            }
