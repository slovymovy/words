        "fr-extract.jsonl": [
            {
                "entry_id": "9ea75988-e4f8-35f4-a27c-3d65cc80cef3",
                "word": "hypophyse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b30c02eb-107e-4c76-91f7-901bea1fba73",
                        "entry_id": "9ea75988-e4f8-35f4-a27c-3d65cc80cef3",
                        "tags": [
                            "plural"
                        ],
                        "form": "hypophyses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8c4745ef-e17d-3031-a86e-568cd2be89c6",
                        "entry_id": "9ea75988-e4f8-35f4-a27c-3d65cc80cef3",
                        "glosses": [
                            "Glande endocrine qui se trouve dans une petite cavité osseuse à la base du cerveau, la selle turcique."
                        ],
                        "tags": [
                            "Endocrinologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d2574b08-9133-47e6-abe4-25da2ba86e66",
                                "sense_id": "8c4745ef-e17d-3031-a86e-568cd2be89c6",
                                "text": "Ce traitement met en ménopause artificielle car il supprime l’ovulation directement au niveau de l’hypophyse."
                            },
                            {
                                "example_id": "4d21a043-6c16-463f-a4dc-766f5d77a059",
                                "sense_id": "8c4745ef-e17d-3031-a86e-568cd2be89c6",
                                "text": "On a découvert un test dit à la dexamétazone, qui est positif si on est déprimé, en ce sens que l’hypophyse ne répond plus."
                            },
                            {
                                "example_id": "8925a3a5-aa76-4759-823e-454f9393e4ca",
                                "sense_id": "8c4745ef-e17d-3031-a86e-568cd2be89c6",
                                "text": "Né en 1761, Charles Byrne était atteint de gigantisme, en raison d’une tumeur bénigne de l’hypophyse non diagnostiquée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "969838ea-306f-480b-a295-db07251e407f",
                        "source_entry_id": "9ea75988-e4f8-35f4-a27c-3d65cc80cef3",
                        "source_sense_id": "8c4745ef-e17d-3031-a86e-568cd2be89c6",
                        "target_lang_word": "Hypophyse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypophyse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2b5ba4c-4f54-30e9-ab61-514b699a5ea0",
                                        "entry_id": "a06c584d-82f0-3f23-b177-eaa1714a039f",
                                        "glosses": [
                                            "Anatomie, Physiologie: eine Hormondrüse, der eine zentrale übergeordnete Rolle bei der Regulation des endokrinen Systems im Körper zukommt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1bad86c-14b8-4f92-919e-29f46150f3d4",
                                                "sense_id": "e2b5ba4c-4f54-30e9-ab61-514b699a5ea0",
                                                "text": "„Die Hypophyse wird über vier Arterien mit Blut gespeist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c33aa0f-97c8-3db7-8bb9-b3d94e72d4c8",
                                        "entry_id": "a06c584d-82f0-3f23-b177-eaa1714a039f",
                                        "glosses": [
                                            "wenigzelliges Verbindungsgewebe zwischen Suspensor und Embryo, im reifen Samen ist sie meist nicht mehr zu erkennen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e39a5c7-243d-4e46-9bf4-14f12dd0f968",
                                                "sense_id": "3c33aa0f-97c8-3db7-8bb9-b3d94e72d4c8",
                                                "text": "„Gleichzeitig differenziert sich an der Anheftungsstelle des Embryos am Suspensor eine Zelle, die sogenannte Hypophyse, deren Abkömmlinge sich am Aufbau der Wurzel und der Wurzelhaube beteiligen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "029655f7-f594-4204-95b8-fe08fe2e22bd",
                        "source_entry_id": "9ea75988-e4f8-35f4-a27c-3d65cc80cef3",
                        "source_sense_id": "8c4745ef-e17d-3031-a86e-568cd2be89c6",
