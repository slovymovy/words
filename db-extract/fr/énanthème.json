                "senses": [
                    {
                        "sense_id": "12463706-a6ef-38bf-bb4c-551802d4d73d",
                        "entry_id": "7d3db4cc-1859-313f-a660-e8c85b8ab680",
                        "glosses": [
                            "Éruption rouge se situant sur la membrane muqueuse à l'intérieur d’une cavité naturelle, la cavité buccale par exemple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dad509ed-eb6b-4239-91d0-9690dcb4cffb",
                                "sense_id": "12463706-a6ef-38bf-bb4c-551802d4d73d",
                                "text": "De nombreuses maladies infectieuses s’accompagnent d’érythème buccal le plus souvent sans spécificité, à l’exception de la rougeole où l’énanthème est un des signes diagnostiques les plus précoces et les plus spécifiques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8fff182f-b2f6-4a4c-a55e-f1828bdd5ca7",
                        "source_entry_id": "7d3db4cc-1859-313f-a660-e8c85b8ab680",
                        "source_sense_id": "12463706-a6ef-38bf-bb4c-551802d4d73d",
                        "target_lang_word": "Enanthem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enanthem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4d958852-1bbd-31b7-bb71-650dfdbc98f6",
                                        "entry_id": "3fcfd6ad-6571-3c5f-adea-2e044d3c61f9",
                                        "glosses": [
                                            "Ausschlag auf der Mundschleimhaut, der einem Exanthem der äußeren Haut entspricht"
                                        ],
                                        "tags": [
                                            "Dermatologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca10048f-150f-43e0-a0df-623896498ec4",
                                                "sense_id": "4d958852-1bbd-31b7-bb71-650dfdbc98f6",
                                                "text": "Ein Patient mit Masern kann sowohl an Enanthemen als auch an Exanthemen leiden."
                                            },
                                            {
                                                "example_id": "9630dcf6-83a0-4a06-bb79-7c7dba5aba7b",
                                                "sense_id": "4d958852-1bbd-31b7-bb71-650dfdbc98f6",
                                                "text": "Ein Enanthem manifestiert sich in den Schleimhäuten entlang der natürlichen Höhlen, vor allem im Mund- und Rachenraum."
                                            },
                                            {
                                                "example_id": "64b8beb4-be2e-4aa9-9439-df76ec36bcad",
                                                "sense_id": "4d958852-1bbd-31b7-bb71-650dfdbc98f6",
                                                "text": "Gekennzeichnet ist Scharlach durch ein Enanthem im Rachen, das charakteristischerweise eine Himbeerzunge und ein feinfleckiges Exanthem aufweist, das beginnend am Thorax in der Folge den ganzen Körper befällt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
