                                "target_senses": [
                                    {
                                        "sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                                        "entry_id": "ecd0b76f-a8a3-3a7c-8e08-772905fecf89",
                                        "glosses": [
                                            "Femme très âgée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fc6e64f-1f3a-4fe5-9f8d-d168952f6b1d",
                                                "sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                                                "text": "La mort brillait par son absence : décéder, ce n’était pas mourir, la métamorphose de cette vieillarde en dalle funéraire ne me déplaisait pas."
                                            },
                                            {
                                                "example_id": "7d9ac1f9-24d3-4365-9d52-725d3a0c26b7",
                                                "sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                                                "text": "Au beau milieu de cette conversation, le berger revint accompagné d’une vieillarde qui n’avait pas perdu tous les attraits de sa jeunesse. La vieillarde nous salua et nous lui rendîmes le salut."
                                            },
                                            {
                                                "example_id": "0b998cb6-fe22-41d3-b366-65b599caea9f",
                                                "sense_id": "aa9a140b-7eb0-3586-9b77-b9dc9f307d9f",
                                                "text": "Sur une petite chaise roulante, un garçon de douze ans, beau comme un cœur ; derrière lui, sa mère, une jeune femme de trente-cinq ans, que l'épuisement avait changé en vieillarde avec des yeux d'enfant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf53a551-b605-4a83-8351-32270166010e",
                        "source_entry_id": "6dacb0bf-f15c-36e1-bb19-b0c0f9810d46",
                        "source_sense_id": "8c366af4-2d10-33f8-ba15-816b5fe11c44",
                        "source_sense_description": "sehr alte Frau",
                        "target_lang_word": "vieille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vieille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "405cdea1-14c9-3583-93a4-ae9a3ba12164",
                                        "entry_id": "7683356d-f91f-31aa-a545-cf0c4f22bae3",
                                        "glosses": [
                                            "Femme âgée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2510cb6f-9bbd-4faf-aa30-f39a75d9d5e9",
                                                "sense_id": "405cdea1-14c9-3583-93a4-ae9a3ba12164",
                                                "text": "Une petite vieille."
                                            },
                                            {
                                                "example_id": "84776ee3-59d7-4d8b-b96f-c20abc0d01d1",
                                                "sense_id": "405cdea1-14c9-3583-93a4-ae9a3ba12164",
                                                "text": "Elle n’a pas trente ans, et elle pense déjà comme une vieille."
                                            },
                                            {
                                                "example_id": "4cade15f-1444-4b29-b328-a69ce3b89307",
                                                "sense_id": "405cdea1-14c9-3583-93a4-ae9a3ba12164",
                                                "text": "La vieille répondit par un ricanement et un geste qui signifiait que sa vie n’avait plus aucune importance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53f9a6a6-6a07-33d1-baa2-fd79a2783edd",
                                        "entry_id": "7683356d-f91f-31aa-a545-cf0c4f22bae3",
                                        "glosses": [
                                            "Se dit de ce qui est ancien, suranné."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c9572eb-2ced-404c-9b2f-29616b79ca15",
                                                "sense_id": "53f9a6a6-6a07-33d1-baa2-fd79a2783edd",
                                                "text": "Un vieux de la vieille : une personne de la vieille école."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d71a094-a0b6-3452-b953-a32f5b7d2b08",
                                        "entry_id": "7683356d-f91f-31aa-a545-cf0c4f22bae3",
                                        "glosses": [
                                            "Mère."
                                        ],
                                        "tags": [
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3113abcf-7c6d-4154-b2bc-27297d16c272",
                                                "sense_id": "7d71a094-a0b6-3452-b953-a32f5b7d2b08",
                                                "text": "Ma vieille a regardé la télé hier."
                                            },
                                            {
                                                "example_id": "b6121f0b-a9c7-4800-b2c2-2823355a2f65",
                                                "sense_id": "7d71a094-a0b6-3452-b953-a32f5b7d2b08",
                                                "text": "Peut-être aussi, un peu, parce que juste à ce moment-là Jojo Vapaille en avait plein le cul de sa vieille et qu’il arrêtait pas de parler de se barrer au diable chercher du boulot et vivre sa vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f0c322f-8de6-3ac8-bf66-d5357f278d33",
                                        "entry_id": "7683356d-f91f-31aa-a545-cf0c4f22bae3",
                                        "glosses": [
                                            "Compagne, épouse."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b73edc2-82eb-4c3f-ac58-179bc9045257",
                                                "sense_id": "9f0c322f-8de6-3ac8-bf66-d5357f278d33",
                                                "text": "L’intendant, trouvant coupé le fil du téléphone, avait dépêché sa vieille au village pour alerter la gendarmerie."
                                            },
                                            {
                                                "example_id": "d0f2c804-6c43-4eee-a54a-3e8598e2bf80",
                                                "sense_id": "9f0c322f-8de6-3ac8-bf66-d5357f278d33",
                                                "text": "Est-ce qu’il va lui aussi se laisser tomber là et crever avec sa vieille sur cette saloperie de terre ?"
                                            },
                                            {
                                                "example_id": "b478284c-390d-4f7c-8a18-5945a712da66",
                                                "sense_id": "9f0c322f-8de6-3ac8-bf66-d5357f278d33",
                                                "text": "Le père ne s’est levé qu’au moment où l’on emportait le corps. Il a ôté sa casquette, et il a murmuré :\n— Ma pauvre vieille… Ma pauvre vieille…"
                                            },
                                            {
                                                "example_id": "7ffa3310-9bb4-4e4b-8d0c-4cb0bfdc8d3f",
                                                "sense_id": "9f0c322f-8de6-3ac8-bf66-d5357f278d33",
                                                "text": "Je reste à Koumac avec ma vieille."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vieille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61304504-1d54-32a6-b585-e9f72da3833f",
                                        "entry_id": "f9a19c13-4066-3d98-af4e-32b9f8e68194",
                                        "glosses": [
                                            "Nom donné à des espèces de poissons osseux marins, moins trapus que les mérous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b34a25ec-795c-4507-a129-87c2dbd80970",
                                                "sense_id": "61304504-1d54-32a6-b585-e9f72da3833f",
                                                "text": "— Combien de caisses ?\n— Cinq de soles, vingt de vieilles et de vieux… On fera deux belles tables de turbots et autant de barbues…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vieille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e4c3c54e-86da-3161-8f8c-9aecbe4c124e",
                                        "entry_id": "dc006cbf-8b67-3f05-9730-28bf94727e67",
                                        "glosses": [
                                            "Féminin singulier de vieux."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6e55fc0-8241-4dc6-a397-32ad5eb85477",
                                                "sense_id": "e4c3c54e-86da-3161-8f8c-9aecbe4c124e",
                                                "text": "J’avais acheté une vieille 4L dont les cardans exténués rendaient d’inquiétants sons de castagnettes et je roulais des journées entières sur des routes où la mort guettait à chaque virage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce1ba37e-a6b6-4411-8d88-f3433b415230",
                        "source_entry_id": "6dacb0bf-f15c-36e1-bb19-b0c0f9810d46",
