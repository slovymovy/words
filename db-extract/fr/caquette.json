                                        "examples": [
                                            {
                                                "example_id": "5db2c629-0e5c-4f9c-a80b-f4e9d5f18272",
                                                "sense_id": "d9ebc5cf-702d-37ad-9900-fececf25e60d",
                                                "text": "Unser Kleiner kriegt einen Kasten Bausteine zu Weihnachten."
                                            },
                                            {
                                                "example_id": "c1f612dd-39c2-4453-a520-87c2add5f22e",
                                                "sense_id": "d9ebc5cf-702d-37ad-9900-fececf25e60d",
                                                "text": "„Harper rückte ein wenig auf dem Kasten herum, auf dem er saß, und Roberts und Curtis warfen sich verstohlene Blicke zu.“"
                                            },
                                            {
                                                "example_id": "79b060a5-871d-4aac-829d-4248be002ba6",
                                                "sense_id": "d9ebc5cf-702d-37ad-9900-fececf25e60d",
                                                "text": "„An der Vorderseite des Kastens befand sich ein dicker und breiter Schließhaken in Form eines sitzenden Buddhas.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6179f660-272c-3f29-8adc-1fbf94d5deca",
                                        "entry_id": "b5a0d74a-5a96-393f-95c2-8a71221697d4",
                                        "glosses": [
                                            "offener Behälter zum Transport von Flaschen"
                                        ],
                                        "tags": [],
                                        "examples": [
