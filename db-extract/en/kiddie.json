                                    {
                                        "sense_id": "dfb38a57-88ce-3655-b487-9a4d378d1dca",
                                        "entry_id": "e2f7cf94-bf43-3fe7-ae62-3bdf1a8b3c9d",
                                        "glosses": [
                                            "πολύ μικρό παιδί"
