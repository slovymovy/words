                "senses": [
                    {
                        "sense_id": "5f0daf60-85c9-3b8f-a3eb-44d7b6d01680",
                        "entry_id": "2ea3113c-7270-3bb9-8adf-c65680de7a2c",
                        "glosses": [
                            "Gestell in Form einer verkleinerten Weihnachtspyramide, die mithilfe einer Räucherkerze oder einer anderen Substanz feinen Rauch abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e566747d-650d-49c8-83cc-03268b74f766",
                                "sense_id": "5f0daf60-85c9-3b8f-a3eb-44d7b6d01680",
                                "text": "„Ich entzündete ein paar Räucherpyramiden aus Sandelholzpulver und mit Zitronell-Öl parfümierte Kerzen, von deren Gerüchen Mücken sich angeblich fernhalten.“"
                            },
                            {
                                "example_id": "50f3a01a-ebdc-4047-8991-4bf5ccbad6d3",
                                "sense_id": "5f0daf60-85c9-3b8f-a3eb-44d7b6d01680",
                                "text": "„Auf diversen Schälchen glommen Räucherpyramiden und Stäbchen um die Wette, deren wohltuendes Aroma wie ein Schwarm bunter Schmetterlinge durch den Raum glitt.“"
                            },
                            {
                                "example_id": "e055d2fe-ec54-4876-b1ca-ae0274c24d8f",
                                "sense_id": "5f0daf60-85c9-3b8f-a3eb-44d7b6d01680",
                                "text": "„Ich erinnere mich noch eines Verkaufstandes, der während der Messe unter dem obersten Laubenbogen an der Kramgasse Sonnseite stand, wo kleine Räucherpyramiden zahlreiche Liebhaber fanden.“"
                            },
                            {
                                "example_id": "d40031b1-a912-4da2-b659-24264b109f06",
                                "sense_id": "5f0daf60-85c9-3b8f-a3eb-44d7b6d01680",
                                "text": "„Im Innern des geschlossenen Körpers zünden die Schüler eine Räucherpyramide an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
