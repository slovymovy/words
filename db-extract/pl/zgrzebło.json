                    {
                        "translation_id": "00dad433-505e-4b6b-979e-a2bc5e74a830",
                        "source_entry_id": "791dc524-be8e-3ecf-a37a-ea2c546c9f6f",
                        "source_sense_id": "64f4bf3f-894c-3eb0-a752-9d8e316474bb",
                        "target_lang_word": "étrille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "étrille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b77bdacb-366d-3c65-922a-3291a253a8a7",
                                        "entry_id": "8d0836e9-f878-3673-9f23-06d3caefc7b7",
                                        "glosses": [
                                            "Racloir avec lequel on gratte et nettoie la peau et le poil des chevaux, des mulets, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207f00d8-5c9f-4970-8cfa-e59b25784a12",
                                                "sense_id": "b77bdacb-366d-3c65-922a-3291a253a8a7",
                                                "text": "Les bons effets du pansage sont parfaitement démontrés par la physiologie. Cette science nous apprend que la répercussion produite par l’étrille sur la peau, a des effets marqués sur les animaux."
                                            },
                                            {
                                                "example_id": "c3fd2760-d47a-4352-958e-932aabd85f1a",
                                                "sense_id": "b77bdacb-366d-3c65-922a-3291a253a8a7",
                                                "text": "Ce n’était point une linition douce, une fomentation onctueuse, mais un massage vigoureux, pratiqué à bras raccourcis, et qui rappelait plutôt les éraillures de l’étrille que les caresses de la main."
                                            },
                                            {
                                                "example_id": "a9db9135-af85-4b2b-b9ae-f6ab78ebbe28",
                                                "sense_id": "b77bdacb-366d-3c65-922a-3291a253a8a7",
                                                "text": "Une femme ne se rase pas, tandis que cet hybride avait recours au rasoir, et assez rarement sans doute, car son menton ressemblait à une étrille."
                                            },
                                            {
                                                "example_id": "23485e1a-ce35-44cd-af83-fb7def4f300c",
                                                "sense_id": "b77bdacb-366d-3c65-922a-3291a253a8a7",
                                                "text": "Le cheval de la jeune femme était également très robuste quoique plus fin. Il allait aussi plus au fond des choses. Il se pavana un peu sous l’étrille et fit quelques bonnes manières à la main qui le soignait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6205320-eeba-3b6e-9f30-dc4cd2a250e0",
                                        "entry_id": "8d0836e9-f878-3673-9f23-06d3caefc7b7",
                                        "glosses": [
                                            "Espèce de crabe de la famille des macropipidés, à pattes postérieures aplaties en palettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd48d68b-35e8-4533-8e73-825827d7fbb4",
                                                "sense_id": "a6205320-eeba-3b6e-9f30-dc4cd2a250e0",
                                                "text": "L’étrille est très commune dans la zone de balancement des marées mais peut se rencontrer jusqu’à 50 mètres de profondeur."
                                            },
                                            {
                                                "example_id": "65c486b4-84d4-4b97-af4e-ca63f9413fc1",
                                                "sense_id": "a6205320-eeba-3b6e-9f30-dc4cd2a250e0",
                                                "text": "L’étrille doit son nom courant à sa carapace qui se termine au-dessus de ses yeux par une ligne de piquants rappelant l’outil avec lequel on carde la laine ou on soigne la robe des chevaux."
                                            },
                                            {
                                                "example_id": "77d3c256-f0a5-4295-9e69-ae98b894a2d9",
                                                "sense_id": "a6205320-eeba-3b6e-9f30-dc4cd2a250e0",
                                                "text": "On privilégiera les abords de la Cotinière, sur Oléron, pour les étrilles, les oursins, les bigorneaux et les patelles."
                                            }
                                        ]
                                    }
                                ]
                            },
