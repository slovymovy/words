                                        "entry_id": "087cbb78-d5c9-371b-a5ed-18716e9c9d97",
                                        "glosses": [
                                            "Plante vivace à rhizome, à longue floraison blanche ou rosée hivernale (d’où son autre nom de rose de Noël), originaire d’Europe centrale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4431acd6-c414-4f8b-9725-b70676dd6fe4",
                                                "sense_id": "30da68e8-47d7-32e9-87cf-1aff8a046ba3",
                                                "text": "L’Hellébore noir est commun dans la France méridionale."
                                            },
                                            {
                                                "example_id": "7843deb3-8d1a-474b-a1ff-9a3d6ea950dc",
                                                "sense_id": "30da68e8-47d7-32e9-87cf-1aff8a046ba3",
                                                "text": "L’hellébore noir est une plante vivace rhizomateuse à longue floraison. Ses fleurs sont blanches, ce sont ses racines qui sont noires."
                                            },
                                            {
                                                "example_id": "01e1f945-01ce-484d-94e1-3cee9e6a9718",
                                                "sense_id": "30da68e8-47d7-32e9-87cf-1aff8a046ba3",
                                                "text": "Ce n’est pas la fleur du rosier mais c’est une des plantes vivaces qui fleurissent en hiver. Sa fleur est blanche mais on l’appelle l’hellébore noir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
