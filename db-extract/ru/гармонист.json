                    {
                        "form_id": "03f09728-532d-4894-91e4-12fe4b079c85",
                        "entry_id": "3c84cbe7-d4c6-33d7-9fb0-b0c20a85f3c5",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "гармони́стах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d16f6dc3-d3a6-3659-acee-0c729224c410",
                        "entry_id": "3c84cbe7-d4c6-33d7-9fb0-b0c20a85f3c5",
                        "glosses": [
                            "тот, кто играет на гармони или на гармошке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ee3df12-ce52-4e3e-9dc3-21b45ecc38ee",
                                "sense_id": "d16f6dc3-d3a6-3659-acee-0c729224c410",
                                "text": "Под гармошку веселей // Песенки поются! // Только плохо: гармонисты // Больно задаются!"
                            },
                            {
                                "example_id": "6342381d-5299-45f2-9972-e5a01990ce6c",
                                "sense_id": "d16f6dc3-d3a6-3659-acee-0c729224c410",
                                "text": "Поиграй, гармонист, // Поиграй, золотой! // А я тебя, гармонист, // Не оставлю сиротой!"
                            },
                            {
                                "example_id": "a456241c-bcb5-4324-aac0-578a2585724d",
                                "sense_id": "d16f6dc3-d3a6-3659-acee-0c729224c410",
                                "text": "Гармонисту за игру, // За игру кипучую — // Два солёных огурца, // Картошку рассыпучую!"
                            },
                            {
                                "example_id": "b72202f5-92e0-4b28-bf3c-b371e101adfc",
                                "sense_id": "d16f6dc3-d3a6-3659-acee-0c729224c410",
                                "text": "Гармонист пошёл на низ, — // Мы ему покланялись! // Наши низкие поклоны // Ему не понравились!"
                            }
                        ]
                    },
                    {
                        "sense_id": "42fca2c7-ad9f-3f62-a317-6055514bfadd",
                        "entry_id": "3c84cbe7-d4c6-33d7-9fb0-b0c20a85f3c5",
                        "glosses": [
                            "музыкант, играющий на гармони"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a65f5148-eea2-47bc-8327-063331327907",
                                "sense_id": "42fca2c7-ad9f-3f62-a317-6055514bfadd",
                                "text": "Так приехал в Грозный превосходный пандурист Султан Самбиев, отличный скрипач Джамалдин Абиев, а впоследствии, когда в оркестр были введены гармоники, и даровитый гармонист Димаев."
                            }
                        ]
                    }
                ],
