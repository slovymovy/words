{
    "word_family": [
        "narcosis",
        "narcotize",
        "narcotism"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f6d40072-87de-315b-906f-592b1fd533b9",
                    "sense_definition": "A drug that reduces pain and induces sleep, often referring to illegal substances or opiates.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed <w>narcotics</w> to help manage the patient's severe chronic pain.",
                            "target_lang_translations": {
                                "zh": "医生开了<w>麻醉剂</w>来帮助控制病人严重的慢性疼痛。"
                            }
                        },
                        {
                            "text": "Police are working hard to stop the illegal trade of <w>narcotics</w> in the city.",
                            "target_lang_translations": {
                                "zh": "警方正在努力制止城内非法的<w>毒品</w>交易。"
                            }
                        }
                    ],
                    "synonyms": [
                        "narcotics"
                    ],
                    "common_phrases": [
                        "illegal narcotics",
                        "prescribe narcotics"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种能减轻疼痛并诱导睡眠的药物，通常指非法物质或鸦片类药物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "麻醉剂",
                                "target_lang_sense_clarification": "指具有镇痛和催眠作用的药物。"
                            },
                            {
                                "target_lang_word": "毒品",
                                "target_lang_sense_clarification": "侧重于指非法使用的成瘾性物质。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "71119cf4-b5cb-3f84-9168-883ca0701abb",
                    "sense_definition": "Any substance that has a numbing or soothing effect on the body or mind.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soothing music acted as a <w>narcotic</w> for his restless and anxious mind.",
                            "target_lang_translations": {
                                "zh": "舒缓的音乐对他焦躁不安的心灵起到了<w>镇静剂</w>的作用。"
                            }
                        },
                        {
                            "text": "She sought a <w>narcotic</w> to dull the sharp pain of her recent loss.",
                            "target_lang_translations": {
                                "zh": "她寻求一种<w>镇静剂</w>来减轻近期遭受丧亲之痛带来的剧烈痛苦。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "任何对身体或精神具有麻痹或镇静作用的物质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "镇静剂",
                                "target_lang_sense_clarification": "指能使人平静或麻木的物质。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5650a471-aac9-3442-9960-842e46cbf594",
                    "sense_definition": "Having the effect of inducing sleep or causing a state of numbness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>narcotic</w> effect of the medication made it difficult for him to stay awake.",
                            "target_lang_translations": {
                                "zh": "这种药物的<w>麻醉</w>效果使他难以保持清醒。"
                            }
                        },
                        {
                            "text": "Some plants have <w>narcotic</w> properties that can be dangerous if ingested.",
                            "target_lang_translations": {
                                "zh": "有些植物具有<w>麻醉</w>特性，误食可能会有危险。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "narcotic effect"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有诱导睡眠或导致麻木状态的效果的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "麻醉的",
                                "target_lang_sense_clarification": "形容具有麻痹或催眠效果的。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a99c563-b81e-37b8-9b12-be6f6bad01a9",
                    "sense_definition": "Relating to or involving the use of narcotics.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "drug",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police launched a new <w>narcotic</w> investigation to dismantle the local drug ring.",
                            "target_lang_translations": {
                                "zh": "警方发起了一项新的<w>毒品</w>调查，以捣毁当地的贩毒团伙。"
                            }
                        },
                        {
                            "text": "He was arrested for violating <w>narcotic</w> laws during the undercover operation.",
                            "target_lang_translations": {
                                "zh": "他在卧底行动中因违反<w>毒品</w>相关法律而被捕。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "narcotic investigation",
                        "narcotic laws"
                    ],
                    "target_lang_definitions": {
                        "zh": "与麻醉剂或毒品有关的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "毒品的",
                                "target_lang_sense_clarification": "用于修饰与毒品相关的法律或调查。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}