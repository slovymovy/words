                "senses": [
                    {
                        "sense_id": "05196aaa-f2ce-3fb2-b672-759393b5516d",
                        "entry_id": "56c0cc38-ead7-3020-b0da-b499ca807631",
                        "glosses": [
                            "Bruchstück aus Metall, welches bei der Detonation einer Bombe abgesprengt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2568989a-808a-46b7-a716-ae1a7caee2cc",
                                "sense_id": "05196aaa-f2ce-3fb2-b672-759393b5516d",
                                "text": "„Den Angaben zufolge geht aus Satellitenbildern hervor, dass in der Provinz Saada, einer Hochburg der Huthis im Norden des Landes, Bombensplitter auf einer landwirtschaftlichen Fläche wenige Hundert Meter von bewohntem Gebiet niedergegangen seien.“"
                            },
                            {
                                "example_id": "dffca1e3-dc97-4a3b-83c7-3835d3a0702e",
                                "sense_id": "05196aaa-f2ce-3fb2-b672-759393b5516d",
                                "text": "„Der hat kein Fenster, durch das Bombensplitter eindringen können.“"
                            },
                            {
                                "example_id": "fd1ec109-a57c-4afd-8e64-333e12c46123",
                                "sense_id": "05196aaa-f2ce-3fb2-b672-759393b5516d",
                                "text": "„Das Schlüsselbild zeigt ein elfjähriges Mädchen, das beim Spielen durch Bombensplitter verletzt wurde.“"
                            },
                            {
                                "example_id": "9b0dc2bf-46d3-4d67-8aa5-68841b9d2ce6",
                                "sense_id": "05196aaa-f2ce-3fb2-b672-759393b5516d",
                                "text": "„ \"Auf jeden Fall hätte das Opfer Bombensplitter in Gesicht und Brust.\"“"
                            },
                            {
                                "example_id": "2b30edbf-5652-4eff-9e1c-32b1cb5676dc",
                                "sense_id": "05196aaa-f2ce-3fb2-b672-759393b5516d",
                                "text": "„Polizeipräsident Wilhelm Schmidbauer sagte, \"messerscharfe Bombensplitter\" seien noch in einer Entfernung von 300 Metern gefunden worden.“"
                            },
                            {
                                "example_id": "803a35fa-a257-4a31-b639-f5b487a7b22e",
                                "sense_id": "05196aaa-f2ce-3fb2-b672-759393b5516d",
                                "text": "Von meinen Eltern weiß ich, was Krieg bedeutet: Mein Vater zeigte mir die Bombensplitter, die im Kleiderschrank im Schlafzimmer seiner Eltern stecken geblieben waren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
