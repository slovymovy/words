                        "glosses": [
                            "Confection de matelas."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48c55eaf-3e60-4c25-a819-b22519441fcc",
                                "sense_id": "c27bcdb6-246a-32e9-b7ec-71c5620b0ac0",
                                "text": "Les vêtements ne pouvant être réemployés en l’état sont coupés en chiffons d’essuyage ou sont défibrés pour la matelasserie, l'automobile ou la fabrication d’un isolant phonique et thermique de qualité, utilisé dans le bâtiment."
                            },
                            {
                                "example_id": "2ac667a8-a002-48b8-a052-1877e35ce9b9",
                                "sense_id": "c27bcdb6-246a-32e9-b7ec-71c5620b0ac0",
                                "text": "Trois marchés semblent parfaitement adaptés à ces laines : la matelasserie, le textile d’ameublement et le tapis ou la moquette."
                            },
                            {
                                "example_id": "85164643-fac0-43a5-93a8-ac603f400f55",
                                "sense_id": "c27bcdb6-246a-32e9-b7ec-71c5620b0ac0",
                                "text": "- Tu peux m’expliquer ce que tu fais dans ce plumard ?\n- Je me suis fait draguer.\n- Ça t’arrive souvent ?\n- Quand les mecs sont gentils.\n- Tu dois en connaître un rayon sur la matelasserie française !"
                            }
                        ]
                    }
