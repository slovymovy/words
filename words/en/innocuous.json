    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2173259d-a0f7-3500-b2ac-e67ff6e38d20",
                    "sense_definition": "Not causing any harm or injury.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "harmless",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spider looked scary, but it was actually <w>innocuous</w>.",
                            "target_lang_translations": {
                                "pl": "Pająk wyglądał groźnie, ale w rzeczywistości był <w>nieszkodliwy</w>."
                            }
                        },
                        {
                            "text": "Most of the chemicals in the garden are <w>innocuous</w> to humans.",
                            "target_lang_translations": {
                                "pl": "Większość chemikaliów w ogrodzie jest <w>nieszkodliwa</w> dla ludzi."
                            }
                        }
                    ],
                    "synonyms": [
                        "harmless",
                        "nontoxic",
                        "undamaging"
                    ],
                    "antonyms": [
                        "harmful",
                        "noxious",
                        "poisonous",
                        "toxic"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nieszkodliwy, niepowodujący żadnych obrażeń ani szkód."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nieszkodliwy",
                                "target_lang_sense_clarification": "taki, który nie wyrządza krzywdy ani szkody"
                            },
                            {
                                "target_lang_word": "niegroźny",
                                "target_lang_sense_clarification": "taki, który nie stanowi zagrożenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "026db8c9-7207-3757-ab78-03ffd09bfa03",
                    "sense_definition": "Not likely to offend or provoke anyone.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "inoffensive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They discussed <w>innocuous</w> topics like the weather during dinner.",
                            "target_lang_translations": {
                                "pl": "Podczas kolacji omawiali <w>niewinne</w> tematy, takie jak pogoda."
                            }
                        },
                        {
                            "text": "His <w>innocuous</w> comment was not meant to upset anyone.",
                            "target_lang_translations": {
                                "pl": "Jego <w>niewinny</w> komentarz nie miał nikogo urazić."
                            }
                        }
                    ],
                    "synonyms": [
                        "uncontroversial"
                    ],
                    "common_phrases": [
                        "innocuous comment",
                        "innocuous remark"
                    ],
                    "target_lang_definitions": {
                        "pl": "Taki, który nie budzi kontrowersji, nie obraża ani nie prowokuje nikogo."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niewinny",
                                "target_lang_sense_clarification": "taki, który nie ma złych intencji i nie jest obraźliwy"
                            },
                            {
                                "target_lang_word": "neutralny",
                                "target_lang_sense_clarification": "taki, który nie wywołuje emocji ani sprzeciwu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
