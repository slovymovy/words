                                            {
                                                "example_id": "758bcb07-de31-4277-9735-d8a4159ebab3",
                                                "sense_id": "bc1f7993-78ba-3d80-ad6c-7e4719ee4a97",
                                                "text": "The relationship between a hairstylist and a client can be far more than simply somebody to cut and shape hair, which is why Tennessee is the latest state to require cosmetologists to complete training on how to recognize and respond to signs of domestic abuse."
                                            },
                                            {
                                                "example_id": "c0e4abf9-0bbf-4e07-9252-d6a719445510",
                                                "sense_id": "bc1f7993-78ba-3d80-ad6c-7e4719ee4a97",
                                                "text": "We spoke to Ford and other hairstylists over 40 about what to expect from these changes and how to treat them. Read on for the experts’ tips for helping your hair age gracefully."
                                            }
