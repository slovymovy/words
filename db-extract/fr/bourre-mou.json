                "senses": [
                    {
                        "sense_id": "29eeffd7-6656-382a-880f-62ffe7af25d7",
                        "entry_id": "f0a61176-882e-3c28-bfe4-564a114862ca",
                        "glosses": [
                            "Contre-vérité, mensonge, invention."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "6c57abb8-75c4-4dc7-8b5f-9edca43c8a37",
                                "sense_id": "29eeffd7-6656-382a-880f-62ffe7af25d7",
                                "text": "J’ai été demander au capitaine une permission que j’avais droit, et j’ui montre une lettre comme quoi ma tante était décédée prochainement. « C’est un bourre-mou », qu’i m’dit."
                            },
                            {
                                "example_id": "a7c5b281-2c2d-4e3d-ac93-605250f2b66d",
                                "sense_id": "29eeffd7-6656-382a-880f-62ffe7af25d7",
                                "text": "En Amérique j’allais pas assez vite, que tu disais… En Afrique, c’est la chaleur qui me crevait… Ici, je suis pas assez intelligent… Enfin partout il y a quelque chose que j’ai en plus ou en moins… Mais tout ça je m’en rends compte, c’est du “bourre-mou” ! Ah ! si j’avais du pognon !… Tout le monde me trouverait bien gentil ici… là-bas…"
                            },
                            {
                                "example_id": "b5e0e87f-f268-433e-85d1-e371b0aba472",
                                "sense_id": "29eeffd7-6656-382a-880f-62ffe7af25d7",
                                "text": "C’est une belle partie de bourre-mou, entre chicandiers de qualité, qui se livre entre ces quatre murs !"
                            },
                            {
                                "example_id": "a733c70f-636d-48c7-a457-b463a7706310",
                                "sense_id": "29eeffd7-6656-382a-880f-62ffe7af25d7",
                                "text": "La voie était ouverte au simple massacre bestial, au nom des grands bourre-mous patriotards et vengeurs."
                            },
                            {
                                "example_id": "4da296fa-ecc0-42e1-8ad4-e2f3bdca41a8",
                                "sense_id": "29eeffd7-6656-382a-880f-62ffe7af25d7",
                                "text": "Celine Voyage au bout de la nuit (edition Folio Page 380: 'Mais c'est pas vrai, c'est du bouurre-mou...')."
                            }
                        ]
                    }
