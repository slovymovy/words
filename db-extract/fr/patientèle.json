                "senses": [
                    {
                        "sense_id": "c386eede-0ee3-30de-94e4-44635266cadf",
                        "entry_id": "a3134e65-6f0a-3858-8dd3-afd0d97c4f42",
                        "glosses": [
                            "Ensemble des personnes qui consultent un médecin, un infirmier, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75db953e-673e-4eda-9531-789d1b4a7398",
                                "sense_id": "c386eede-0ee3-30de-94e4-44635266cadf",
                                "text": "Lorsque l’on n’est pas contractuellement propriétaire de sa patientèle (remplaçant, assistant…) lors du départ, une clause de non réinstallation est prévue, de manière à ce que la patientèle que l’on vous avait mis à disposition temporairement dans certains cas ne vous suive pas."
                            },
                            {
                                "example_id": "0dedd9c7-53b9-4911-9a31-a25cf9887f94",
                                "sense_id": "c386eede-0ee3-30de-94e4-44635266cadf",
                                "text": "La patientèle de l’unité de crise et d’urgence psychiatrique est spécifique à la fois par l’intensité de sa détresse émotionnelle et par une symptomatologie qui défie toute description."
                            },
                            {
                                "example_id": "e3acefdd-0774-4370-be75-f04d4992b87c",
                                "sense_id": "c386eede-0ee3-30de-94e4-44635266cadf",
                                "text": "En quelques mois, le docteur Robinson a séduit une patientèle fidèle, qui apprécie son dévouement et sa compétence."
                            }
                        ]
                    }
                ],
