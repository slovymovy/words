                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27cb0f27-183e-3cfb-8ac5-1cd1fe42805f",
                                        "entry_id": "aba27808-1399-3898-9bcc-d631832d5373",
                                        "glosses": [
                                            "Approximate, almost."
