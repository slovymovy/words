                                    {
                                        "sense_id": "d04edfea-768e-361c-8808-5fa3bfcb4709",
                                        "entry_id": "17b65cfc-2a27-3198-8703-ed4488adf4cf",
                                        "glosses": [
                                            "schlechte Laune habend; missmutig"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3cacaff7-4a96-4379-a8dd-5f46ce6dee06",
                                                "sense_id": "d04edfea-768e-361c-8808-5fa3bfcb4709",
                                                "text": "Die Frau, welche gehofft hatte einen guten Absatz zu finden, gab ihm was er verlangte, gieng [sic!] aber ganz ärgerlich und brummig fort."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b92975a-c091-4404-9f03-c76cd7f9ab26",
                        "source_entry_id": "5cc536a2-a867-33b6-b46c-62f6d1dcff3f",
                        "source_sense_id": "8b5b98a1-629f-39a7-9127-00c05f82c564",
                        "target_lang_word": "grouchy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grouchy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "88498e7b-5a4f-3bbd-bf1d-5fe170b9b6db",
                                        "entry_id": "00253f74-2bbf-3419-b471-d01dcba324d1",
                                        "glosses": [
                                            "Irritable; easily upset; angry; tending to complain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "489f850b-e298-4a9a-99c6-5ef696aa8bda",
                                                "sense_id": "88498e7b-5a4f-3bbd-bf1d-5fe170b9b6db",
                                                "text": "His boss gets grouchy when deadlines draw near."
                                            },
                                            {
                                                "example_id": "b7d9069f-8835-4bf9-9669-d6a38e96031f",
                                                "sense_id": "88498e7b-5a4f-3bbd-bf1d-5fe170b9b6db",
                                                "text": "Not that young Pat had a nasty temper, or was grouchy as his father had feared."
                                            },
                                            {
                                                "example_id": "d9bf344d-0b15-4f05-9ba4-5a3a997371be",
                                                "sense_id": "88498e7b-5a4f-3bbd-bf1d-5fe170b9b6db",
                                                "text": "He went in to mumble that he was \"sorry, didn't mean to be grouchy,\" and to inquire as to her interest in movies."
                                            },
                                            {
                                                "example_id": "dff0362f-9ad3-4146-a795-b4e1f1d4302d",
                                                "sense_id": "88498e7b-5a4f-3bbd-bf1d-5fe170b9b6db",
                                                "text": "In Berlin I once heard Susie Clemens—ill-fated, talented girl, who died so young—say to her father: \"Grouchy again! They do say that you can be funny when company is around—too bad that you don't consider Henry Fisher company.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b80a3a0-f08b-4036-833c-2cc1fba2079e",
                        "source_entry_id": "5cc536a2-a867-33b6-b46c-62f6d1dcff3f",
                        "source_sense_id": "8b5b98a1-629f-39a7-9127-00c05f82c564",
                        "target_lang_word": "grumpy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grumpy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "beab090a-1b99-3bed-a36a-e2b3a778e110",
                                        "entry_id": "dab07343-330f-3bb6-903e-857c8de1d423",
                                        "glosses": [
                                            "Dissatisfied and irritable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95b602a0-d204-4f68-871d-645e0ed90376",
                                                "sense_id": "beab090a-1b99-3bed-a36a-e2b3a778e110",
                                                "text": "The old man was grumpy because he couldn’t find his glasses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grumpy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7cdfa94b-e0de-3cad-b21d-26a342f74fae",
                                        "entry_id": "c728d379-36d1-3c2b-80df-bb962116dd46",
                                        "glosses": [
                                            "A dissatisfied and irritable person."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efb0495-0932-4fe5-9f20-0e3ec57c95b0",
                                                "sense_id": "7cdfa94b-e0de-3cad-b21d-26a342f74fae",
                                                "text": "\"Bunch of grumpies, always scowling and muttering,\" complained the new employee.\n\"Dear me, I'm afraid you'll find the same type of people here,\" the foreman responded."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
