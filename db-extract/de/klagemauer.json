                "senses": [
                    {
                        "sense_id": "d00d4f4b-c926-3c5b-9f36-b7d28f142e79",
                        "entry_id": "8be0eb1b-8b62-3693-8306-7fd283a95f82",
                        "glosses": [
                            "(jüdische) Gebetsstätte in Jerusalem am Tempelberg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d609b43-fe4d-4353-96bf-79f429642834",
                                "sense_id": "d00d4f4b-c926-3c5b-9f36-b7d28f142e79",
                                "text": "An der Klagemauer beten nicht nur die orthodoxen Juden."
                            },
                            {
                                "example_id": "072f47af-8e4f-461a-9e71-e419affc5c5a",
                                "sense_id": "d00d4f4b-c926-3c5b-9f36-b7d28f142e79",
                                "text": "„Der Zugang zur jüdischen Klagemauer führte zwar durch Sicherheitsschleusen, stand aber jedermann jederzeit frei, sofern er eine Kippa trug.“"
                            },
                            {
                                "example_id": "d4f0554c-80d5-4303-9a85-8af6e60be02f",
                                "sense_id": "d00d4f4b-c926-3c5b-9f36-b7d28f142e79",
                                "text": "„Helena näherte sich der Klagemauer mit kleinen, unsicheren Schritten.“"
                            },
                            {
                                "example_id": "b0d05a3e-eeb3-4231-836c-5ec38aee6c5f",
                                "sense_id": "d00d4f4b-c926-3c5b-9f36-b7d28f142e79",
                                "text": "„An der Klagemauer standen Juden und weinten, alte Juden und junge Juden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
