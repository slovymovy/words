                                                "sense_id": "f92ffc31-44de-3f2b-88f0-de8199aa5ce4",
                                                "text": "Der Chor gab noch zwei Dreingaben."
                                            },
                                            {
                                                "example_id": "2020aaa2-7516-4316-80bd-456fc9c18ee3",
                                                "sense_id": "f92ffc31-44de-3f2b-88f0-de8199aa5ce4",
                                                "text": "Ich verspreche dir eine Kette als Dreingabe."
                                            },
                                            {
                                                "example_id": "20b76a7e-2272-4b05-8f9c-1886404a763b",
                                                "sense_id": "f92ffc31-44de-3f2b-88f0-de8199aa5ce4",
                                                "text": "„Darum mache ich mich auf die Suche und finde auch bald den Bauern, der zum Tausch bereit ist – mit dem Versprechen als Dreingabe, eine kleine Milchkanne allabendlich zu füllen.“"
                                            },
                                            {
                                                "example_id": "f5087c56-1c6d-4fef-af57-3541b2718304",
                                                "sense_id": "f92ffc31-44de-3f2b-88f0-de8199aa5ce4",
                                                "text": "„Ein Gutshof mit Torfproduktion ist keine schlechte Dreingabe.“"
                                            }
