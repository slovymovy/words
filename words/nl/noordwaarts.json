                    "sense_id": "04868df7-cef3-3c32-9763-fae61d36e3b7",
                    "sense_definition": "in een noordelijke richting, naar het noorden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "richting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vogels vliegen in het voorjaar altijd <w>noordwaarts</w> om te gaan broeden.",
                            "target_lang_translations": {
                                "en": "The birds always fly <w>northwards</w> in the spring to go and breed.",
                                "ru": "Весной птицы всегда летят <w>на север</w>, чтобы вывести потомство."
                            }
                        },
                        {
                            "text": "We moeten de <w>noordwaarts</w> stromende rivier volgen om bij het kamp te komen.",
                            "target_lang_translations": {
                                "en": "We must follow the <w>northward</w> flowing river to reach the camp.",
                                "ru": "Нам нужно следовать вдоль текущей <w>на север</w> реки, чтобы добраться до лагеря."
                            }
                        }
                    ],
                    "synonyms": [
                        "noordelijk"
                    ],
                    "antonyms": [
                        "zuidwaarts"
                    ],
                    "common_phrases": [
                        "noordwaarts stromende rivier",
                        "noordwaarts vliegen"
                    ],
                    "target_lang_definitions": {
                        "en": "in a northerly direction, towards the north",
                        "ru": "в северном направлении, на север"
                    },
                    "translations": {
