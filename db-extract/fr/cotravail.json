                        "entry_id": "704ea40a-02a9-384b-91ca-343f53077db5",
                        "glosses": [
                            "Mode de travail consistant, pour des professionnels indépendants, à partager espace, poste de travail, expérience ou compétences."
                        ],
                        "tags": [
                            "Travail",
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "f1f210c5-f62a-4ff5-8ee6-c79a7e85ee18",
                                "sense_id": "db5b208b-59eb-301a-96ac-cd4bdcefb69b",
                                "text": "Les lieux de cotravail ne font pas la joie que des jeunes pousses et petites technos. IBM l’a confirmé il y a quelques années en s’installant, jusqu’en 2020, à une adresse new-yorkaise de WeWork."
                            }
                        ]
                    }
