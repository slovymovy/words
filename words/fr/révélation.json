            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99a6ce80-59c4-3c79-a1d7-caabdc02e951",
                    "sense_definition": "Information tenue secrète ou ignorée qui est soudainement dévoilée au public.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "divulgation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a publié des <w>révélations</w> choquantes sur ce scandale financier."
                        },
                        {
                            "text": "Elle a décidé de faire des <w>révélations</w> à la police pour aider l'enquête."
                        }
                    ],
                    "common_phrases": [
                        "faire des révélations",
                        "révélations fracassantes"
                    ]
                },
                {
                    "sense_id": "7d465dca-10c2-3dbf-a02b-5c417dd48277",
                    "sense_definition": "Manifestation soudaine d'un talent exceptionnel qui se fait connaître du public.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "talent",
                    "name_type": "no",
                    "examples": [
