{
    "word_family": [
        "paneling",
        "panelling",
        "panelist",
        "empanel",
        "impaneled"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0c5d9935-a034-3acc-bd42-d68a7788cbc9",
                    "sense_definition": "A group of people gathered to judge, interview, or discuss a specific topic, often in public or for a broadcast.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "group_of_people",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>panel</w> of experts discussed the impact of climate change on global agriculture.",
                            "target_lang_translations": {
                                "ru": "<w>Группа</w> экспертов обсудила влияние изменения климата на мировое сельское хозяйство.",
                                "zh": "专家<w>小组</w>讨论了气候变化对全球农业的影响。"
                            }
                        },
                        {
                            "text": "Today's <w>panel</w> includes several famous authors who will answer questions from the audience.",
                            "target_lang_translations": {
                                "ru": "В сегодняшнюю <w>комиссию</w> входят несколько известных авторов, которые ответят на вопросы аудитории.",
                                "zh": "今天的<w>座谈嘉宾</w>包括几位著名作家，他们将回答观众的提问。"
                            }
                        }
                    ],
                    "synonyms": [
                        "committee",
                        "board",
                        "jury",
                        "group"
                    ],
                    "common_phrases": [
                        "expert panel",
                        "panel discussion",
                        "panel members"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, собранная для судейства, интервью или обсуждения определенной темы, часто публично или для трансляции.",
                        "zh": "一组被召集起来进行评判、面试或讨论特定话题的人，通常是在公开场合或为了广播节目。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комиссия",
                                "target_lang_sense_clarification": "группа лиц со специальными полномочиями"
                            },
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "экспертов или специалистов"
                            },
                            {
                                "target_lang_word": "комитет",
                                "target_lang_sense_clarification": "коллегиальный орган"
                            },
                            {
                                "target_lang_word": "форум",
                                "target_lang_sense_clarification": "представительное собрание для обсуждения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "专家组",
                                "target_lang_sense_clarification": "由专家组成的讨论或评判小组"
                            },
                            {
                                "target_lang_word": "委员会",
                                "target_lang_sense_clarification": "负责特定任务的团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "37cb6506-0983-3150-8da0-b67f5e767141",
                    "sense_definition": "A rectangular section of a surface, such as a wall, door, or vehicle body, that is distinct from its surroundings.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_section",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The carpenter carefully installed the wooden <w>panel</w> on the office wall.",
                            "target_lang_translations": {
                                "ru": "Плотник аккуратно установил деревянную <w>панель</w> на стену офиса.",
                                "zh": "木匠小心地将木<w>板</w>安装在办公室墙上。"
                            }
                        },
                        {
                            "text": "He noticed a small hidden <w>panel</w> behind the painting in the library.",
                            "target_lang_translations": {
                                "ru": "Он заметил маленькую скрытую <w>панель</w> за картиной в библиотеке.",
                                "zh": "他注意到书房画作后面有一块隐藏的小<w>暗板</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "section",
                        "slab",
                        "pane",
                        "board"
                    ],
                    "common_phrases": [
                        "door panel",
                        "wall panel",
                        "control panel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямоугольная секция поверхности, такой как стена, дверь или кузов автомобиля, которая выделяется на фоне окружения.",
                        "zh": "表面上的一块矩形部分，如墙壁、门或车身，与周围环境有所区别。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "панель",
                                "target_lang_sense_clarification": "плоская деталь отделки или конструкции"
                            },
                            {
                                "target_lang_word": "щит",
                                "target_lang_sense_clarification": "плоская пластина или секция"
                            },
                            {
                                "target_lang_word": "секция",
                                "target_lang_sense_clarification": "часть поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面板",
                                "target_lang_sense_clarification": "平坦的装饰或结构部件"
                            },
                            {
                                "target_lang_word": "镶板",
                                "target_lang_sense_clarification": "用于墙面或门上的木质或金属板"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be94a0c-9f19-3821-9fd7-c8f11619c9bb",
                    "sense_definition": "A specific area or window within a computer interface that contains tools, settings, or information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "interface_element",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can change your password by accessing the user <w>panel</w> in the settings menu.",
                            "target_lang_translations": {
                                "ru": "Вы можете изменить пароль, перейдя в пользовательскую <w>панель</w> в меню настроек.",
                                "zh": "你可以通过访问设置菜单中的用户<w>面板</w>来更改密码。"
                            }
                        },
                        {
                            "text": "The admin <w>panel</w> allows the website owner to manage all registered users.",
                            "target_lang_translations": {
                                "ru": "Админ-<w>панель</w> позволяет владельцу сайта управлять всеми зарегистрированными пользователями.",
                                "zh": "管理<w>后台</w>允许网站所有者管理所有注册用户。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dashboard",
                        "interface",
                        "console"
                    ],
                    "common_phrases": [
                        "admin panel",
                        "control panel",
                        "side panel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Определенная область или окно в компьютерном интерфейсе, содержащее инструменты, настройки или информацию.",
                        "zh": "计算机界面中包含工具、设置或信息的特定区域或窗口。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "панель",
                                "target_lang_sense_clarification": "элемент интерфейса (например, панель управления)"
                            },
                            {
                                "target_lang_word": "консоль",
                                "target_lang_sense_clarification": "окно управления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "面板",
                                "target_lang_sense_clarification": "软件界面中的功能区域"
                            },
                            {
                                "target_lang_word": "控制台",
                                "target_lang_sense_clarification": "用于管理和设置的界面窗口"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "115ab931-c3b2-331d-9130-9b4a4dd151af",
                    "sense_definition": "An individual frame or drawing within a comic strip or graphic novel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "media_section",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist spent hours drawing the final <w>panel</w> of the comic book.",
                            "target_lang_translations": {
                                "ru": "Художник потратил часы на рисование последнего <w>кадра</w> комикса.",
                                "zh": "艺术家花了几个小时绘制漫画书的最后一<w>格</w>。"
                            }
                        },
                        {
                            "text": "In the last <w>panel</w> of the strip, the character finally realizes the truth.",
                            "target_lang_translations": {
                                "ru": "В последнем <w>кадре</w> стрипа персонаж наконец осознает правду.",
                                "zh": "在连环画的最后一<w>分镜</w>里，角色终于意识到了真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "frame",
                        "box",
                        "cell"
                    ],
                    "common_phrases": [
                        "comic panel",
                        "final panel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отдельный кадр или рисунок внутри комикса или графического романа.",
                        "zh": "连环画或漫画书中的单个画面或绘图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кадр",
                                "target_lang_sense_clarification": "отдельное изображение в комиксе"
                            },
                            {
                                "target_lang_word": "панель",
                                "target_lang_sense_clarification": "структурная единица комикса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分镜",
                                "target_lang_sense_clarification": "漫画中的单个画面"
                            },
                            {
                                "target_lang_word": "画格",
                                "target_lang_sense_clarification": "漫画书中的格子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46b798c4-10ec-3517-bbb0-4689efbd8ea4",
                    "sense_definition": "A set of medical tests or laboratory assays performed together to diagnose a condition.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical_testing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor ordered a full blood <w>panel</w> to check for any underlying health issues.",
                            "target_lang_translations": {
                                "ru": "Врач назначил полный <w>анализ</w> крови, чтобы проверить наличие скрытых проблем со здоровьем.",
                                "zh": "医生开了一份全面的血液<w>检查组合</w>，以排查潜在的健康问题。"
                            }
                        },
                        {
                            "text": "A lipid <w>panel</w> measures different types of cholesterol in your bloodstream.",
                            "target_lang_translations": {
                                "ru": "Липидный <w>профиль</w> измеряет различные типы холестерина в вашем кровотоке.",
                                "zh": "血脂<w>检查组合</w>可以测量血液中不同类型的胆固醇。"
                            }
                        }
                    ],
                    "synonyms": [
                        "battery",
                        "set",
                        "series"
                    ],
                    "common_phrases": [
                        "blood panel",
                        "lipid panel",
                        "test panel"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "medical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор медицинских тестов или лабораторных анализов, проводимых вместе для диагностики состояния.",
                        "zh": "为诊断某种疾病而共同进行的一组医学检查或实验室化验。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "комплекс",
                                "target_lang_sense_clarification": "набор анализов"
                            },
                            {
                                "target_lang_word": "профиль",
                                "target_lang_sense_clarification": "группа лабораторных исследований"
                            },
                            {
                                "target_lang_word": "панель",
                                "target_lang_sense_clarification": "медицинский тест на группу показателей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "检查组合",
                                "target_lang_sense_clarification": "一组相关的医学化验"
                            },
                            {
                                "target_lang_word": "化验项目",
                                "target_lang_sense_clarification": "一组实验室检测指标"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0c9da6c-aa01-3732-81cc-2f8f4ee09aa1",
                    "sense_definition": "The entire group of people selected to serve as a jury in a court of law.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge addressed the jury <w>panel</w> before the trial began.",
                            "target_lang_translations": {
                                "ru": "Судья обратился к <w>составу</w> присяжных перед началом процесса.",
                                "zh": "审判开始前，法官向<w>陪审团</w>发表了讲话。"
                            }
                        },
                        {
                            "text": "It took several days to select a fair <w>panel</w> for the high-profile case.",
                            "target_lang_translations": {
                                "ru": "Потребовалось несколько дней, чтобы отобрать беспристрастную <w>коллегию</w> для этого громкого дела.",
                                "zh": "为这起备受瞩目的案件挑选一个公正的<w>陪审团</w>花费了好几天。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jury"
                    ],
                    "common_phrases": [
                        "jury panel",
                        "panel of jurors"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вся группа людей, отобранных для исполнения обязанностей присяжных в суде.",
                        "zh": "在法庭上被选出担任陪审员的整组人员。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "состав",
                                "target_lang_sense_clarification": "группа присяжных заседателей"
                            },
                            {
                                "target_lang_word": "коллегия",
                                "target_lang_sense_clarification": "присяжных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陪审团",
                                "target_lang_sense_clarification": "法庭上的陪审员群体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d5ae22c-7d20-3f26-ac30-d008c5018030",
                    "sense_definition": "A thin, flat piece of wood used as a surface for painting instead of canvas.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "art_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many Renaissance masterpieces were painted on a wooden <w>panel</w> rather than cloth.",
                            "target_lang_translations": {
                                "ru": "Многие шедевры Ренессанса были написаны на деревянной <w>доске</w>, а не на холсте.",
                                "zh": "许多文艺复兴时期的杰作都画在木质<w>画板</w>上，而不是画在布上。"
                            }
                        },
                        {
                            "text": "The museum restored an ancient <w>panel</w> that had begun to crack over time.",
                            "target_lang_translations": {
                                "ru": "Музей отреставрировал старинную <w>панель</w>, которая со временем начала трескаться.",
                                "zh": "博物馆修复了一块随着时间推移开始开裂的古代<w>画板</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "board",
                        "slab"
                    ],
                    "common_phrases": [
                        "wood panel",
                        "oak panel"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тонкий плоский кусок дерева, используемый в качестве поверхности для живописи вместо холста.",
                        "zh": "一种薄而平的木板，用作绘画表面，代替画布。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доска",
                                "target_lang_sense_clarification": "деревянная основа для живописи"
                            },
                            {
                                "target_lang_word": "панель",
                                "target_lang_sense_clarification": "деревянный планшет художника"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "画板",
                                "target_lang_sense_clarification": "用于绘画的木质底板"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b212331b-53a7-38fc-a80b-a0956c2f34f5",
                    "sense_definition": "To cover or decorate a wall or room with flat sections of wood or other material.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>panel</w> the library with dark oak to give it a classic look.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>обшить</w> библиотеку темным дубом, чтобы придать ей классический вид.",
                                "zh": "他们决定用深色橡木<w>镶嵌</w>书房，使其呈现出古典风格。"
                            }
                        },
                        {
                            "text": "The workers will <w>panel</w> the walls of the conference room tomorrow.",
                            "target_lang_translations": {
                                "ru": "Завтра рабочие будут <w>отделывать</w> стены конференц-зала панелями.",
                                "zh": "工人们明天将为会议室的墙壁<w>安装护墙板</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cover",
                        "wainscot",
                        "clad"
                    ],
                    "common_phrases": [
                        "panel a room",
                        "panel the walls"
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать или декорировать стену или комнату плоскими секциями из дерева или другого материала.",
                        "zh": "用木板或其他材料的平坦部分覆盖或装饰墙壁或房间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обшивать",
                                "target_lang_sense_clarification": "панелями или досками"
                            },
                            {
                                "target_lang_word": "отделывать",
                                "target_lang_sense_clarification": "стеновыми панелями"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镶嵌",
                                "target_lang_sense_clarification": "用板材覆盖墙面"
                            },
                            {
                                "target_lang_word": "装贴",
                                "target_lang_sense_clarification": "安装装饰性板材"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ac79dfe-ce5a-3020-94f3-420e48f4395b",
                    "sense_definition": "To officially enter names onto a list of people summoned for jury duty.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "legal_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sheriff was responsible to <w>panel</w> the citizens for the upcoming court session.",
                            "target_lang_translations": {
                                "ru": "Шериф был ответственен за то, чтобы <w>включить</w> граждан в список присяжных для предстоящего судебного заседания.",
                                "zh": "警长负责为即将到来的庭审<w>选定</w>公民担任陪审员。"
                            }
                        },
                        {
                            "text": "The court clerk began to <w>panel</w> the jurors for the criminal trial.",
                            "target_lang_translations": {
                                "ru": "Секретарь суда начал <w>формировать</w> список присяжных для уголовного процесса.",
                                "zh": "法庭书记员开始为刑事审判<w>组建</w>陪审团。"
                            }
                        }
                    ],
                    "synonyms": [
                        "empanel",
                        "list",
                        "enroll"
                    ],
                    "common_phrases": [
                        "panel a jury"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально вносить имена в список лиц, вызванных для исполнения обязанностей присяжных.",
                        "zh": "正式将姓名列入被传唤担任陪审员的人员名单。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "формировать",
                                "target_lang_sense_clarification": "список присяжных"
                            },
                            {
                                "target_lang_word": "составлять",
                                "target_lang_sense_clarification": "список заседателей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "选定",
                                "target_lang_sense_clarification": "确定陪审员名单"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}