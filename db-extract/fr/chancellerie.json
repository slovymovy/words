                "senses": [
                    {
                        "sense_id": "2eec2dae-2786-3555-a93c-4b910f96ddb3",
                        "entry_id": "65fd5893-33a3-3e8d-9508-fc8567aee904",
                        "glosses": [
                            "Lieu où l’on scelle certains actes avec le sceau de l’État."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b55c5799-d004-384b-af0e-3849ce57cbe8",
                        "entry_id": "65fd5893-33a3-3e8d-9508-fc8567aee904",
                        "glosses": [
                            "Administration dirigée par un chancelier."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "b1f2ea16-a67b-42d1-b43a-0ffd5a1f8e4e",
                                "sense_id": "b55c5799-d004-384b-af0e-3849ce57cbe8",
                                "text": "Si le paiement est fait à l’étranger en monnaie étrangère, il est effectué, sous le contrôle de l’autorité consulaire, au taux de change fixé pour les opérations de chancellerie."
                            }
                        ]
                    },
                    {
                        "sense_id": "91bfc55f-8b5f-3109-8596-c05e2b71dd3e",
                        "entry_id": "65fd5893-33a3-3e8d-9508-fc8567aee904",
                        "glosses": [
                            "Nom donné aux ambassades ou au ministère des Affaires étrangères d'un pays."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec5cf55e-279e-40a5-8e45-83c5e6d2f18e",
                        "source_entry_id": "65fd5893-33a3-3e8d-9508-fc8567aee904",
                        "target_lang_word": "Kanzlei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanzlei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "14186c3c-70cf-3af3-8aaa-5851a20210ed",
                                        "entry_id": "0aac936e-86dd-322f-9be3-73d78b8e425b",
                                        "glosses": [
                                            "Büro einer Behörde, eines Rechtsanwalts oder eines Notars"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae03f667-781b-45c4-8ec0-6447ff2558cf",
                                                "sense_id": "14186c3c-70cf-3af3-8aaa-5851a20210ed",
                                                "text": "Er betreibt seine Kanzlei gemeinsam mit zwei Kollegen."
                                            },
                                            {
                                                "example_id": "c8504ce3-2263-4221-be48-5c5bc660fe48",
                                                "sense_id": "14186c3c-70cf-3af3-8aaa-5851a20210ed",
                                                "text": "„Mitte der achtziger Jahre des 15. Jahrhunderts übernahm er als Protonotar die Leitung der städtischen Kanzlei in Erfurt.“"
                                            },
                                            {
                                                "example_id": "de5792fa-a5fc-4993-ad49-f44f1d07448a",
                                                "sense_id": "14186c3c-70cf-3af3-8aaa-5851a20210ed",
                                                "text": "„Gegen Mitternacht landeten wir in der Kanzlei seines Vaters, wo wir auf einem weißen Ledersofa miteinander schliefen.“"
                                            },
                                            {
                                                "example_id": "e1d5474d-2502-4d96-8f54-f08623fd4702",
                                                "sense_id": "14186c3c-70cf-3af3-8aaa-5851a20210ed",
                                                "text": "„Vor allem in den neu eroberten Territorien Österreichs und Russlands sprachen die alteingesessenen lokalen Eliten eine andere Sprache als der Hof oder die Kanzlei der Hauptstadt.“"
                                            },
                                            {
                                                "example_id": "c2522ea0-cbec-468d-a0d0-25a0cbb390f9",
                                                "sense_id": "14186c3c-70cf-3af3-8aaa-5851a20210ed",
                                                "text": "„Am nächsten Morgen ging ich zu meinem Advokaten und hörte, daß meine Eingabe bereits in der Kanzlei des Untersuchungsrichters war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "275d180b-92fd-4d52-a2c2-f15f003284be",
                        "source_entry_id": "65fd5893-33a3-3e8d-9508-fc8567aee904",
                        "target_lang_word": "Kanzleramt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kanzleramt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9167ef14-7fc9-3d72-b4f7-dbdd7931190a",
                                        "entry_id": "51f002e2-03ed-3a65-9990-4085a17f26d3",
                                        "glosses": [
                                            "Behörde, die einem Kanzler untersteht oder die diesen in seinen Aufgaben unterstützt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8ae8eb4-4c9d-4d1b-887e-e8afe408cc07",
                                                "sense_id": "9167ef14-7fc9-3d72-b4f7-dbdd7931190a",
                                                "text": "Die Mitarbeiter im Kanzleramt sind vor allem für die Informationspolitik des Kanzlers zuständig."
                                            },
                                            {
                                                "example_id": "5177ad69-028c-48f6-bf35-9152a55de47a",
                                                "sense_id": "9167ef14-7fc9-3d72-b4f7-dbdd7931190a",
                                                "text": "„Eigentlich müsste er jetzt zum Frühstück mit den Ministerkollegen der SPD, danach ins Kanzleramt zur Kabinettssitzung.“"
                                            },
                                            {
                                                "example_id": "e3f67980-ce27-402a-b9f6-d481b83a1ed0",
                                                "sense_id": "9167ef14-7fc9-3d72-b4f7-dbdd7931190a",
                                                "text": "„Vor dem Kanzleramt wird eine Protestaktion der Femen-Frauengruppe gewaltsam aufgelöst.“"
                                            },
                                            {
                                                "example_id": "f65041b3-cfb1-40c3-80e5-4f2bdbce4f1e",
                                                "sense_id": "9167ef14-7fc9-3d72-b4f7-dbdd7931190a",
                                                "text": "„Und so energisch wie Schulz hat seit dem jungen Gerhard Schröder kein Sozialdemokrat mehr an den Toren des Kanzleramts gerüttelt.“"
                                            },
                                            {
                                                "example_id": "09c63e96-9345-4241-af39-4146f8175eca",
                                                "sense_id": "9167ef14-7fc9-3d72-b4f7-dbdd7931190a",
                                                "text": "„Für den Tag der offenen Tür hat das Kanzleramt hinten im Garten eine Ruhezone mit Speisen und Getränken vorgesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "34f5db99-46c9-36ac-a5d0-f3a6fc87efa2",
                                        "entry_id": "51f002e2-03ed-3a65-9990-4085a17f26d3",
                                        "glosses": [
                                            "Amt eines Kanzlers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2445864f-cae6-4640-9439-f7319f81eb8c",
                                                "sense_id": "34f5db99-46c9-36ac-a5d0-f3a6fc87efa2",
                                                "text": "Sowohl im Norddeutschen Bund als auch im Deutschen Kaiserreich hatte Otto von Bismarck ein Kanzleramt inne."
                                            },
                                            {
                                                "example_id": "1f53d26c-6859-489f-87f7-853cdc84b154",
                                                "sense_id": "34f5db99-46c9-36ac-a5d0-f3a6fc87efa2",
                                                "text": "„Der aber wurde von einem nach der Macht gierenden Gerhard Schröder aus dem Kanzleramt gekegelt, weil man seiner müde war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a35a42df-86b3-37bb-8144-447ba11ffb00",
                                        "entry_id": "51f002e2-03ed-3a65-9990-4085a17f26d3",
                                        "glosses": [
                                            "Gebäude zu [1] und/oder [2]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cc55332-55c6-4ba6-a0f7-98480b2438d8",
                                                "sense_id": "a35a42df-86b3-37bb-8144-447ba11ffb00",
                                                "text": "„Die Franzosen hängen sehr am Élysée-Palast, der ihnen ihre lange Geschichte erzählt. Ich will damit nicht sagen, dass das Kanzleramt die Deutschen kaltlässt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
