                        "glosses": [
                            "Sprachfamilie, die von den Ureinwohnern Nordamerikas gesprochen wird"
                        ],
                        "tags": [
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "0f0dabbf-2666-4881-888d-dabd4a8a9ea2",
                                "sense_id": "184f2b1b-e88e-3adf-8c30-12e91bb1de30",
                                "text": "„In den Algonkin-Sprachen werden Menschen und Dinge entweder als »Lebewesen« oder »Nichtlebewesen« angesehen, etwa so, wie sie im Deutschen als entweder »männlich«, »weiblich« oder »sächlich« erscheinen[.]“"
                            }
                        ],
