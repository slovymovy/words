                ],
                "senses": [
                    {
                        "sense_id": "48bc44c5-db79-31e2-a89e-086b37c4aebf",
                        "entry_id": "5be1815f-f058-3770-86fd-5b4817baf88c",
                        "glosses": [
                            "Faire perdre son caractère bunkerisé à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa10ad5e-e2f2-4898-8a95-03a9071062b6",
                                "sense_id": "48bc44c5-db79-31e2-a89e-086b37c4aebf",
                                "text": "La nouvelle directrice de la communication, Marie-Emmanuelle Assidon, veut \" débunkeriser \" la maison."
                            },
                            {
                                "example_id": "2ed381fb-14e3-4918-ba8b-773c31b1b1bc",
                                "sense_id": "48bc44c5-db79-31e2-a89e-086b37c4aebf",
                                "text": "Débunkerisé, sans ses douleurs, ses traumatismes et ses exclusions, redevenu de dimension humaine, Club-des-Pins est finalement une plage comme les autres."
                            },
                            {
                                "example_id": "7f8b553e-d3c6-40a3-b70c-329915d9741d",
                                "sense_id": "48bc44c5-db79-31e2-a89e-086b37c4aebf",
                                "text": "Une fois élu, le président de la République lui avait donné une mission de taille : \"débunkeriser l'Élysée\"."
                            }
                        ]
                    }
                ],
