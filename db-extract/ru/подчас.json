                    },
                    {
                        "translation_id": "3328a0a4-2b47-4bca-be07-661c3626ef82",
                        "source_entry_id": "f7a72ed9-19e2-38b1-bca1-1915f9eed7cf",
                        "source_sense_id": "385708b9-c46c-37b8-a589-678964357407",
                        "target_lang_word": "alguna que otra vez",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4930d296-3cca-4a2b-8767-dde087e373d0",
                        "source_entry_id": "f7a72ed9-19e2-38b1-bca1-1915f9eed7cf",
                        "source_sense_id": "385708b9-c46c-37b8-a589-678964357407",
                        "target_lang_word": "parfois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parfois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                        "entry_id": "41dffee8-437e-34ff-ad5d-84cef587bbe6",
                                        "glosses": [
                                            "Quelquefois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce081a8c-286e-4270-83d3-b7f029e8e1b1",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Le père Cotton craignait si peu que ses pénitentes le quittassent, qu’au contraire il leur conseillait d’aller parfois aux autres confesseurs : […]."
                                            },
                                            {
                                                "example_id": "4ef2ee3f-fde7-4796-a1ce-b4a736fe910a",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Cependant, au milieu de la chaussée, des nègres se poursuivaient à coup de boules de neige et parfois, une de ces boules, manquant son but, s’écrasait contre une devanture ; […]."
                                            },
                                            {
                                                "example_id": "b2db85de-7479-4225-93cb-22067e2785ae",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "La masse des véhicules s’avançait dans un grondement […], puis s’arrêtait, bloquée parfois pendant trois heures."
                                            },
                                            {
                                                "example_id": "5944037f-7ca8-4524-b30b-a6df107b8daa",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Ce n'était pas la première fois que des boîtes de singe entraient dans la maison ; parfois des soldats nous en donnaient, mais jamais nous n’en avions rapporté autant."
                                            },
                                            {
                                                "example_id": "888e0b6c-f0b3-4cbd-84bf-92fe41361b15",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "[…], et je me rendis compte que même à Göttingen il pleuvait parfois, les gens pouvaient être maussades, […]."
                                            },
                                            {
                                                "example_id": "2b5829e1-297e-471c-aebc-40ea7d62e048",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Parfois voulues, parfois subies, les migrations introduisent un mode d’organisation réticulaire dans le pavage territorial, d’autant qu’on constate que leur fonctionnement est de plus en plus de type diasporique."
                                            },
                                            {
                                                "example_id": "e82a3c43-c0dc-4408-9e06-fe1da33def02",
                                                "sense_id": "787db53d-2124-31d7-8a9e-d9b9e4494f61",
                                                "text": "Les cinquante titres récupèrent et déroutent, avec un zeste d’ironie et, parfois, avec un léger effet captieux, le lexique sur la pandémie de COVID-19, le vocabulaire et les syntagmes titrés dans les journaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b2695ab-ccbf-4b2d-a38e-40e2aa7c4ad1",
                        "source_entry_id": "f7a72ed9-19e2-38b1-bca1-1915f9eed7cf",
                        "source_sense_id": "385708b9-c46c-37b8-a589-678964357407",
                        "target_lang_word": "de temps en temps",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "de temps en temps",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "22c3bb51-7776-3ce1-b90a-8541fab65b91",
                                        "entry_id": "5c7a0c5d-34dd-33a0-b45c-af89bd05f159",
                                        "glosses": [
                                            "De fois à autre ; quelquefois."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb7f4aec-7f1f-4af6-a58e-e7d0830f32fc",
                                                "sense_id": "22c3bb51-7776-3ce1-b90a-8541fab65b91",
                                                "text": "On laisse digérer pendant une heure puis on chauffe à 40°C en agitant de temps en temps."
                                            },
                                            {
                                                "example_id": "bfb606a5-da97-420d-80a9-eefbed5c99b1",
                                                "sense_id": "22c3bb51-7776-3ce1-b90a-8541fab65b91",
                                                "text": "De temps en temps, un requin paraissait à la surface avec son cortège habituel de rémoras parasites et de poissons-pilotes."
                                            },
                                            {
                                                "example_id": "42cbdfc9-afe9-4d6c-9458-40ceaa544608",
                                                "sense_id": "22c3bb51-7776-3ce1-b90a-8541fab65b91",
                                                "text": "Il tirait sur une magnifique pipe en merisier de Montaigu, adroitement culottée, renâclant de temps en temps sa fumée par les narines."
                                            },
                                            {
                                                "example_id": "c474d1cb-699c-493b-8424-ecd586c468e1",
                                                "sense_id": "22c3bb51-7776-3ce1-b90a-8541fab65b91",
                                                "text": "De temps en temps, des hommes et des femmes s’engouffraient dans l’entrée obscure, secouaient leurs manteaux ou leurs imperméables et escaladaient vivement l’escalier étroit et raide ; on percevait leurs voix lorsqu’ils échangeaient quelques mots avec le surveillant-concierge qui devait être posté au premier étage."
                                            },
                                            {
                                                "example_id": "ea24147b-ec91-48a5-a097-2f0257aeef77",
                                                "sense_id": "22c3bb51-7776-3ce1-b90a-8541fab65b91",
                                                "text": "Puisqu'il ne faut jamais mentir, alors il faut mentir de temps en temps : l'obligation d'être véridique à tout prix contraint à mentir quand la vérité elle-même est plus fallacieuse que le mensonge."
                                            },
                                            {
                                                "example_id": "97637cec-30ba-4320-8e59-0c970d9bc1a3",
                                                "sense_id": "22c3bb51-7776-3ce1-b90a-8541fab65b91",
                                                "text": "De temps en temps, quand mes paupières étaient sur le point de se fermer, je m’arrêtais pour fumer une demi-cigarette, marcher un peu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
