                                        "entry_id": "4fc3cbf0-d200-3274-a600-c097dd4955f2",
                                        "glosses": [
                                            "To agree."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8deeedcf-506d-42e1-94ff-c75eeac8797c",
                                                "sense_id": "54866d58-bf04-39fa-a84c-5752c16f8fa7",
                                                "text": "Besides, even if you don't vibe with his subject matter, he is a style king of West Coast, down-tempo gangsta-pimp music."
                                            },
