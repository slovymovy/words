                                "target_senses": [
                                    {
                                        "sense_id": "895dbbb1-b03f-3e57-9c74-3d57977a9405",
                                        "entry_id": "b256a562-2811-336c-8831-8236f91128a2",
                                        "glosses": [
                                            "kreisfreie Stadt in Sachsen, Deutschland, Hauptstadt des Freistaates Sachsen, ehemalige Hauptstadt und Residenzstadt des Kurfürstentums Sachsen, des Königreiches Sachsen-Polen, des Königreiches Sachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a695ef9-7062-4216-9038-9b5f3d80bdbf",
                                                "sense_id": "895dbbb1-b03f-3e57-9c74-3d57977a9405",
                                                "text": "Ziehst Du bald wieder nach Dresden zurück?"
                                            },
                                            {
                                                "example_id": "7d5ba09a-213b-4af6-a0fc-cd5590ad73d3",
                                                "sense_id": "895dbbb1-b03f-3e57-9c74-3d57977a9405",
                                                "text": "Ich bin in Dresden geboren."
                                            },
                                            {
                                                "example_id": "8845b75d-2449-4036-acf7-3e71aabb693b",
                                                "sense_id": "895dbbb1-b03f-3e57-9c74-3d57977a9405",
                                                "text": "Wir haben in Dresden unseren Urlaub verbracht."
                                            },
                                            {
                                                "example_id": "09057dfd-6acf-4f16-aa9d-d7a48ff76f9e",
                                                "sense_id": "895dbbb1-b03f-3e57-9c74-3d57977a9405",
                                                "text": "Nach Dresden führen viele Wege."
                                            },
                                            {
                                                "example_id": "4b5cb813-e6a5-4317-a859-7c1eae04b648",
                                                "sense_id": "895dbbb1-b03f-3e57-9c74-3d57977a9405",
                                                "text": "Dresden liegt auf der Nordhalbkugel."
                                            },
                                            {
                                                "example_id": "66e703fb-413d-405d-aba9-d04023c6575d",
                                                "sense_id": "895dbbb1-b03f-3e57-9c74-3d57977a9405",
                                                "text": "In Dresden gibt es eine Trabrennbahn."
                                            },
                                            {
                                                "example_id": "0d272f07-a8ac-427b-85b2-1bbf7f0b33dc",
                                                "sense_id": "895dbbb1-b03f-3e57-9c74-3d57977a9405",
                                                "text": "„Mit ihren zwanzig Jahren hatte sie Breslau noch nie verlassen und war wohl neugierig, wie die übrige Welt aussah; es mußte sehr reizvoll für sie sein, mit Dresden zu beginnen.“"
                                            }
                                        ],
