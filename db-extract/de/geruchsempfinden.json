                "senses": [
                    {
                        "sense_id": "30e4a84f-2d2e-3bf8-aed8-d8845c550758",
                        "entry_id": "10051c4a-6578-3b36-b016-c2f8d7d9a0fd",
                        "glosses": [
                            "durch Geruch hervorgerufenes Gefühl; emotionsbedingtes, feines, realistisches Gespür in sich selbst, zu einer Sache oder Ding"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce416d38-4dc7-497a-adb2-185625e84d7c",
                                "sense_id": "30e4a84f-2d2e-3bf8-aed8-d8845c550758",
                                "text": "„Das Steroid Androstenon aus menschlichem Schweiß rief unterschiedliche Geruchsempfindungen hervor, die über „schweißartig, urinartig“ oder „geruchlos“ bis hin zu „süß, blumenhaft“ reichten.“"
                            },
                            {
                                "example_id": "b58af7a4-cb6d-43f4-80e5-b41a7770cc18",
                                "sense_id": "30e4a84f-2d2e-3bf8-aed8-d8845c550758",
                                "text": "„Das erhöhte Geruchsempfinden von schwangeren Frauen wurde in einer schwedischen Studie getestet.“"
                            },
                            {
                                "example_id": "f82f2269-e1c2-4536-976a-e9d1387c3c66",
                                "sense_id": "30e4a84f-2d2e-3bf8-aed8-d8845c550758",
                                "text": "„Es kann aber auch sein, dass sich im Verlauf der Erkrankung das Geschmacks- und Geruchsempfinden so sehr verändert, dass bestimmte Lebensmittel einfach nicht mehr gegessen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d914281f-75e9-36d8-99c4-d3472364e992",
                        "entry_id": "10051c4a-6578-3b36-b016-c2f8d7d9a0fd",
                        "glosses": [
                            "vorahnendes Gefühl zu einem wahrgenommen Geruch; unausgesprochene Ahnung zu einer Sache oder Dingen; Geruchsvorahnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "710ea14b-9638-46bc-a4a4-909275438cd6",
                                "sense_id": "d914281f-75e9-36d8-99c4-d3472364e992",
                                "text": "Am vermeintlichen Tatort war meine Geruchsempfindung sehr intensiv, und mir schwahnte, das hier etwas am verwesen war."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
