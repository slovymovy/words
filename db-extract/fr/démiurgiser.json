                "senses": [
                    {
                        "sense_id": "cd3cae4e-cd2b-37d9-bcb3-f62a35cfd3e9",
                        "entry_id": "f228e1ec-b0ee-3884-9ee8-c09b8b964266",
                        "glosses": [
                            "Donner un caractère démiurgique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a64f1e8-27fb-43f0-8052-6c947e703243",
                                "sense_id": "cd3cae4e-cd2b-37d9-bcb3-f62a35cfd3e9",
                                "text": "En profondeur (au niveau de la conscience non-thétique) il s’atteint comme liberté qui se prête et se fait démiurgique en se laissant démiurgiser."
                            },
                            {
                                "example_id": "812e3f7f-1d6e-4589-bb02-3de16f7b8732",
                                "sense_id": "cd3cae4e-cd2b-37d9-bcb3-f62a35cfd3e9",
                                "text": "Jana Kluge démiurgise ainsi les éléments de nos bruyants discours après les avoir quasiment concassés."
                            },
                            {
                                "example_id": "61ecf4c2-4060-4090-8954-5af05d279c6e",
                                "sense_id": "cd3cae4e-cd2b-37d9-bcb3-f62a35cfd3e9",
                                "text": "Et l'une des essences de base pour \"démiurgiser\" (sorry, Mister Platon !), vous l'avez compris, c'est l'imagination !"
                            }
                        ]
                    }
