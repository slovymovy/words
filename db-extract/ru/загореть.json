                ],
                "senses": [
                    {
                        "sense_id": "b5901253-4747-3c05-b909-22e41f8dc637",
                        "entry_id": "1e70f62d-711e-3206-9fa9-409211f58325",
                        "glosses": [
                            "приобрести загар, смуглый цвет кожи под действием солнечных лучей"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d922926e-b588-499d-a2de-0333b1deaef5",
                        "source_entry_id": "1e70f62d-711e-3206-9fa9-409211f58325",
                        "source_sense_id": "b5901253-4747-3c05-b909-22e41f8dc637",
                        "target_lang_word": "bronzer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bronzer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "026b8780-2d2b-3b94-9628-59f97df6deb0",
                                        "entry_id": "758a296d-88cd-3460-9bc2-46fb06b109d0",
                                        "glosses": [
                                            "Rendre dur et résistant comme le bronze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebbeb6a0-0279-49fc-8c39-0456a63e1589",
                                                "sense_id": "026b8780-2d2b-3b94-9628-59f97df6deb0",
                                                "text": "Bronzer un canon de fusil, des boucles, des boutons d’acier, etc., leur donner, par le moyen du feu, une couleur bleuâtre qui sert à les préserver de la rouille."
                                            },
                                            {
                                                "example_id": "ba62427b-7bce-4005-9d5c-599602e668b5",
                                                "sense_id": "026b8780-2d2b-3b94-9628-59f97df6deb0",
                                                "text": "Le malheur a bronzé son cœur. Son cœur s’est bronzé."
                                            },
                                            {
                                                "example_id": "e859182b-97b2-4e63-9155-734ddfebc0ee",
                                                "sense_id": "026b8780-2d2b-3b94-9628-59f97df6deb0",
                                                "text": "Le temps ne produisit pas sur elle l’effet qu’il produisit sur moi. Elle ne se bronza pas au danger, affronté chaque nuit."
                                            },
                                            {
                                                "example_id": "2621340a-a31f-4005-a497-e033aa92a813",
                                                "sense_id": "026b8780-2d2b-3b94-9628-59f97df6deb0",
                                                "text": "En vivant et en voyant les hommes, il faut que le cœur se brise ou se bronze"
                                            },
                                            {
                                                "example_id": "1100e831-b08f-4883-848c-1d384fa3e16d",
                                                "sense_id": "026b8780-2d2b-3b94-9628-59f97df6deb0",
                                                "text": "Nous avons trouvé dans plusieurs Papiers-publics , une note concernant le deuil à porter à l'occasion de la mort du feu Roi ; il sera de 7 mois; on portera les grandes pleureuses pendant le premier, & les petites pendant le second: les hommes prendront l'habit de drap sans boutons, burat, étamine ou voile; manchetes de baptiste à ourlet plat, la cravate, bas de laine, souliers bronzés, boucles noires, épée bronzée, garnie de crêpe. Les femmes prendront la robe de fleuret, papeline, ras de St Maur, taffetas de Tours sans lustre, garnie de la même étofe, ourlée ou de crêpe, d'étamine de soie & gaze de laine, aussi ourlée; les barbes plates, les manchetes & le fichu de crêpe blanc, ourlés; la coëfe noire, les bas & les gans de soie noire, les souliers & les boucles bronzés, éventail de crêpe noir. On promet de publier huit jours avant la fin de cette époque , le bulletin de la seconde."
                                            },
                                            {
                                                "example_id": "1bba21f2-17c7-4ee5-a18a-770bb9ca5077",
                                                "sense_id": "026b8780-2d2b-3b94-9628-59f97df6deb0",
                                                "text": "Qu’il fera enjoint aux Menuisiers d’observer les anciennes Ordonnances , & que défenses leur feront faites d’entreprendre aucunes figures plus haute de six pouces de baffe taille, prise dedans du choix de leur bois, & ne pourront peindre, bronzer, ni appliquer, & mouler sur quelque besogne que ce soit, autrement que suivant les Arrests, Jugemens & Sentences obtenues à l’encontre d’eux."
                                            },
                                            {
                                                "example_id": "4778b7a6-ca8d-4d00-bb9f-9e345a726e4b",
                                                "sense_id": "026b8780-2d2b-3b94-9628-59f97df6deb0",
                                                "text": "on appelle Marroquin du Levant ou de Barbarie, les peaux de Bouc qui viennent d'Afrique, & qu'on passè en noir à Rouen ; & on appelle du Marroquin bronzé celui qui n'est point grenu, qui est noir, & dont on fait des souliers de deüil: on dit aussi du veau bronzé, quand il est passe en noir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "407295ab-c682-3245-a5eb-4e0555686e1b",
                                        "entry_id": "758a296d-88cd-3460-9bc2-46fb06b109d0",
                                        "glosses": [
                                            "Peindre en couleur de bronze."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfc65db9-d07b-48b2-9df3-64557998a015",
                                                "sense_id": "407295ab-c682-3245-a5eb-4e0555686e1b",
                                                "text": "Bronzer une statue, un vase.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91a9e01b-5e9c-3190-827a-d8072de0caff",
                                        "entry_id": "758a296d-88cd-3460-9bc2-46fb06b109d0",
                                        "glosses": [
                                            "Donner une couleur hâlée à."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f45f78d-f225-4a09-8fdf-48a3976f78ea",
                                                "sense_id": "91a9e01b-5e9c-3190-827a-d8072de0caff",
                                                "text": "Le soleil l’a bronzé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0eb8d5a-5bf8-3b85-9d39-df00074a0b42",
                                        "entry_id": "758a296d-88cd-3460-9bc2-46fb06b109d0",
                                        "glosses": [
                                            "ou Se hâler au soleil."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7a415b7-9528-4b3e-a0cb-b858d2fc42b5",
                                                "sense_id": "d0eb8d5a-5bf8-3b85-9d39-df00074a0b42",
                                                "text": "Ils sont allés bronzer."
                                            },
                                            {
                                                "example_id": "a3207e89-d9b1-49f9-979d-b7c4675c4500",
                                                "sense_id": "d0eb8d5a-5bf8-3b85-9d39-df00074a0b42",
                                                "text": "Car la mode, c’est aussi les millions de tonnes de crèmes, poudres, laits, lotions, maquillages, démaquillants, prémaquillants, produits à se peindre, à se bronzer, à ôter la peinture, à s’oindre, à s’enduire, à se désenduire, à se pommader, à se friser, à s’onduler, à se défriser, à nourrir les cheveux, les laver, les traiter, les dépelliculer, les blondir, les faire briller, les remplir de reflets, les décolorer, les recolorer, les soigner, les faire respirer, les faire pousser, repousser, ôter les duvets superflus, maigrir, mincir, grandir, développer les seins, gommer les hanches, affiner la taille, avaler l’estomac, fondre les kilos en trop, exalter le buste, renforcer les appas défaillants…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bronzer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "670baec4-0362-338c-abdd-22ee46258516",
                                        "entry_id": "abba04ee-31fa-3184-8554-432aebe5bbb9",
                                        "glosses": [
                                            "Produit de maquillage destiné à simuler le bronzage."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4bd1267-21fe-4289-a2e7-5264a5b4f0c0",
                                                "sense_id": "670baec4-0362-338c-abdd-22ee46258516",
                                                "text": "Appliquer un bronzer permet d'avoir l'air bronzé sans subir les méfaits du soleil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
