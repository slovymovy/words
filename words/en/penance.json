                    "frequency": "Low",
                    "semantic_group_id": "remorse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>penance</w> was evident in his tearful apology."
                        },
                        {
                            "text": "True <w>penance</w> requires a change of heart."
