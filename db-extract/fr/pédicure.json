                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4c7b5b6e-452c-4c7d-92a2-87063cda408b",
                        "entry_id": "09a09358-6496-3060-9df0-815765a819b5",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "pédicures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cda85e51-0ea0-35fc-b13d-208a54a4d64b",
                        "entry_id": "09a09358-6496-3060-9df0-815765a819b5",
                        "glosses": [
                            "Praticien qui soigne les pieds, qui en extirpe ou réduit les cors, les durillons et qui intervient également sur les ongles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8a51807-b12f-4dac-9b2a-c3ee70ae98ec",
                                "sense_id": "cda85e51-0ea0-35fc-b13d-208a54a4d64b",
                                "text": "Un pédicure, auteur d’un traité de corporistique, qui vous fait vos cors par abonnement, et qui, si les républicains triomphent pendant six mois, deviendra certainement immortel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bcbbd5cf-e7d8-4744-94ed-272a8aeab4a6",
                        "source_entry_id": "09a09358-6496-3060-9df0-815765a819b5",
                        "source_sense_id": "cda85e51-0ea0-35fc-b13d-208a54a4d64b",
                        "target_lang_word": "Fußarzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "68c211bb-a933-414a-8137-6c53b49bd3c8",
                        "source_entry_id": "09a09358-6496-3060-9df0-815765a819b5",
                        "source_sense_id": "cda85e51-0ea0-35fc-b13d-208a54a4d64b",
                        "target_lang_word": "Fußpfleger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußpfleger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                        "entry_id": "f25fb0db-d08a-35f2-857a-4ba85b1b3ae5",
                                        "glosses": [
                                            "Person, die beruflich die Füße von Kunden reinigt und pflegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed3702f5-73bd-4264-8521-65656dda33eb",
                                                "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                                "text": "„Er ist Podologe – das ist die offizielle Bezeichnung für Medizinische Fußpfleger.“"
                                            },
                                            {
                                                "example_id": "db9bc98b-74e2-450d-a5bc-d9047a42bafc",
                                                "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                                "text": "„Als Fußpfleger beherrschen Sie unterschiedliche Methoden der Pflege bzw. Korrekturmaßnahmen am Fuß.“"
                                            },
                                            {
                                                "example_id": "c842020b-c398-46ce-ab92-3925d120e3d1",
                                                "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                                "text": "„Als Fußpfleger weiß ich, daß viele Fußkrankheiten auch ohne aufwendige Medikamente oder Operationen zu heilen sind.“"
                                            },
                                            {
                                                "example_id": "343f8d86-ffa1-4a4b-b35e-46ce780f5d14",
                                                "sense_id": "069a0e06-5939-3467-9a3b-76bbc9f6417b",
                                                "text": "„So verlockend eine Fußpflege im Altenheim auch sein mag, kann sie doch sehr viel Stress und Ärger mit sich bringen. Es kann leicht vorkommen, dass die Pflegedienstleitung den Fußpflegern das Leben sehr schwer macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3c495a7-8930-4070-91ef-07279276438c",
                        "source_entry_id": "09a09358-6496-3060-9df0-815765a819b5",
                        "source_sense_id": "cda85e51-0ea0-35fc-b13d-208a54a4d64b",
                        "target_lang_word": "Fußpflegerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußpflegerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "964bbfe1-e72d-31fc-b754-ace0be14d08b",
                                        "entry_id": "5a0e16bb-3d66-37f3-bf94-4e91cf2711aa",
                                        "glosses": [
                                            "weibliche Person, die beruflich die Füße von Kunden reinigt und pflegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e02bae0-832b-4c96-9e4b-1c16e6d83f7d",
                                                "sense_id": "964bbfe1-e72d-31fc-b754-ace0be14d08b",
                                                "text": "„Die Schriftstellerin Katja Oskamp ist auch Fußpflegerin und momentan weder das eine noch das andere.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc527200-7c0a-4ffc-b1d2-4f81abae6a2c",
                        "source_entry_id": "09a09358-6496-3060-9df0-815765a819b5",
                        "source_sense_id": "cda85e51-0ea0-35fc-b13d-208a54a4d64b",
                        "target_lang_word": "chiropodist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chiropodist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6f57da81-10c9-3303-af13-8ce4567a95b0",
                                        "entry_id": "d2677345-c65c-3762-a53a-34aba630a6f7",
                                        "glosses": [
                                            "A practitioner of chiropody."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fe6a119-91b4-4e21-b35b-518edfda2595",
                                                "sense_id": "6f57da81-10c9-3303-af13-8ce4567a95b0",
                                                "text": "A chiropodist says, as long as people are fools enough to abuse their feet, the prospect for his employment is good."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1d2b874-9245-48f5-a321-69007cb20ecf",
                        "source_entry_id": "09a09358-6496-3060-9df0-815765a819b5",
                        "source_sense_id": "cda85e51-0ea0-35fc-b13d-208a54a4d64b",
                        "target_lang_word": "podiatrist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "podiatrist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                        "entry_id": "daafe358-a03b-3926-97eb-2087344e3650",
                                        "glosses": [
                                            "A health care practitioner who specializes in the diagnosis and treatment of foot ailments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77fde215-06b9-4fa2-9ef0-06cab4c11e30",
                                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                                "text": "I visited my podiatrist to get a new pair of orthopedic inserts for my sneakers."
                                            },
                                            {
                                                "example_id": "4ab19f91-f9fd-4589-9fe8-7aa539bca75e",
                                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                                "text": "Dr. Larry Braunstein, a podiatrist who died in 2007, often told the story of providing Donald Trump with the diagnosis of bone spurs in his heels so he could be exempt from military service, his two daughters – Dr. Elysa Braunstein and Sharon Kessel – told the New York Times."
                                            },
                                            {
                                                "example_id": "6fbd054c-4049-4931-810d-3452887dfe3d",
                                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                                "text": "To better help you in your quest, we asked multiple podiatrists and seasoned long-distance walkers exactly what to look for when selecting the best walking shoes."
                                            },
                                            {
                                                "example_id": "5252c4e2-a8b1-4523-b432-f2d222599b6d",
                                                "sense_id": "5d201234-c3ea-356b-adb9-c08735388a24",
                                                "text": "The subcommittee, which is chaired by Ohio Republican Rep. Brad Wenstrup, a podiatrist, will hold a markup session for the report Wednesday before submitting it to the congressional record."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ff02bc6-6499-4ec4-811a-469adc8a335b",
                        "source_entry_id": "09a09358-6496-3060-9df0-815765a819b5",
