                    },
                    {
                        "translation_id": "73c7e366-1ccc-4b21-8ab4-c754a4bedb17",
                        "source_entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
                        "source_sense_description": "four dimensional continuum",
                        "target_lang_word": "ruimtetijd",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruimtetijd",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "34fccd00-26c4-3e84-a635-445287b3ff19",
                                        "entry_id": "d34c25f3-8365-395d-85c8-415fdd0bd525",
                                        "glosses": [
                                            "de beschrijving van het heelal waarbij ruimte en tijd onlosmakelijk met elkaar verbonden zijn tot één geheel van een 4-dimensionale structuur"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09631812-6fa0-4c00-b3b1-8a42aeddb426",
                                                "sense_id": "34fccd00-26c4-3e84-a635-445287b3ff19",
                                                "text": "Opnieuw hebben wetenschappers rimpelingen in de ruimtetijd waargenomen. Deze zogenoemde zwaartekrachtsgolven zijn de overblijfselen van het samensmelten van zwarte gaten."
                                            },
                                            {
                                                "example_id": "4053b0fc-59cd-4840-8023-a10ff50532b6",
                                                "sense_id": "34fccd00-26c4-3e84-a635-445287b3ff19",
                                                "text": "Zwaartekrachtgolven zijn rimpelingen in de ruimtetijd. Albert Einstein voorspelde het bestaan ervan al in zijn algemene relativiteitstheorie aan het begin van de vorige eeuw. In februari van dit jaar werd bekendgemaakt dat wetenschappers voor het eerst een sequentie zwaartekrachtgolven hadden waargenomen."
                                            },
                                            {
                                                "example_id": "8bd3d5a4-5846-4c13-ade5-62437b2c4ceb",
                                                "sense_id": "34fccd00-26c4-3e84-a635-445287b3ff19",
                                                "text": "En weer wordt het genie van Albert Einstein bevestigd. De rimpelingen in de ruimtetijd die hij een eeuw geleden voorspelde in zijn algemene relativiteitstheorie, zijn voor het eerst waargenomen. Dat is bekendgemaakt op gelijktijdige persconferenties in Washington, Pisa en Amsterdam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "586079cf-93bf-47e4-a5f5-28d6eab9d3bf",
                        "source_entry_id": "78db9c86-f4a2-3bfb-946b-29691be826c5",
