                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8a1d3c2-0be6-4640-8ad9-22aa7056dcb5",
                                                "sense_id": "11766a22-6ede-3174-b05d-302d77231da8",
                                                "text": "„Der absolute Betrag der Determinante einer 2-reihigen Matrix kann interpretiert werden als Flächeninhalt des Parallelogramms, das von den Vektoren aufgespannt wird, die aus den Spaltenmatrizen der Matrix gebildet werden.“"
                                            }
