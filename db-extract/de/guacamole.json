                        "source_sense_id": "d81294cd-5ec1-3d35-8567-c3b2346b6341",
                        "source_sense_description": "Gastronomie, mexikanische Küche: kalte Soße auf der Basis von Avocados",
                        "target_lang_word": "guacamole",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "guacamole",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10ddd62e-88ca-38b8-92c2-f5369e87d7bd",
                                        "entry_id": "8c00515a-c263-31ca-8d38-126abcb7b897",
                                        "glosses": [
                                            "An avocado-based greenish dip with onions, tomato, and spices, common to Mexican cuisine and often served with tortilla chips."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0580fbb9-311e-47a8-b2d0-69bdca0f8706",
                                                "sense_id": "10ddd62e-88ca-38b8-92c2-f5369e87d7bd",
                                                "text": "Typical Mexican food is prepared here according to ancient recipes and served in orthodox sequence, that is, guacamole at the beginning and frijoles at the end."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
