    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "325af7e3-c4e7-32fd-84f9-9bb5760b1262",
                "word": "elliptic",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "25495c7e-e404-3343-8a8b-316b0b9786a0",
                        "entry_id": "325af7e3-c4e7-32fd-84f9-9bb5760b1262",
                        "glosses": [
                            "Of or pertaining to an ellipse."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "d2120180-cb5a-40a2-badc-eede8916aa94",
                                "sense_id": "25495c7e-e404-3343-8a8b-316b0b9786a0",
                                "text": "Novv ſince the Planets move in Elliptick Orbits, in one of vvhoſe foci the Sun is, and by a Radius from the Sun deſcribe equal Area's in equal Times, vvhich no other Lavv of a Circulating Fluid, but the Harmonical Circulation can Account for, vve muſt find out a Lavv for the Paracentrical Motion, that may make the Orbits Elliptick."
                            },
                            {
                                "example_id": "2a883cd7-4e66-43a6-b38e-493dc351699d",
                                "sense_id": "25495c7e-e404-3343-8a8b-316b0b9786a0",
                                "text": "In this chapter, the history of solving elliptic problems by direct marching methods is reviewed."
                            }
                        ]
                    },
                    {
                        "sense_id": "35b2bfb6-4815-3b70-bcab-1c740314fd68",
                        "entry_id": "325af7e3-c4e7-32fd-84f9-9bb5760b1262",
                        "glosses": [
                            "Of or pertaining to a broad field of mathematics that originates from the problem of calculating arc lengths of an ellipse."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e63a9365-7a70-41d7-988b-1065c60879c2",
                                "sense_id": "35b2bfb6-4815-3b70-bcab-1c740314fd68",
                                "text": "elliptic integral"
                            },
                            {
                                "example_id": "d9f4f270-a694-4bcd-a3de-81f8495ca196",
                                "sense_id": "35b2bfb6-4815-3b70-bcab-1c740314fd68",
                                "text": "elliptic function"
                            },
                            {
                                "example_id": "ba8b7ea6-bd01-40c4-a013-d1d4be2e5c98",
                                "sense_id": "35b2bfb6-4815-3b70-bcab-1c740314fd68",
                                "text": "elliptic curve"
                            }
                        ]
                    },
                    {
                        "sense_id": "7b6252d9-97f6-314f-a06d-5b9884d30c25",
                        "entry_id": "325af7e3-c4e7-32fd-84f9-9bb5760b1262",
                        "glosses": [
                            "That has coefficients satisfying a condition analogous to the condition for the general equation for a conic section to be of an ellipse."
                        ],
                        "tags": [
                            "in-compounds",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "779e8187-325c-4e4e-be35-f73d7281f3ef",
