                        ],
                        "examples": [
                            {
                                "example_id": "f6d9cd34-6103-4a55-b0d3-88791104c313",
                                "sense_id": "9b95baf0-8d81-3460-897f-a7e87959e3db",
                                "text": "Wit dużo jeździ po Azji, wszyscy mają go za wojażera."
                            }
                        ],
