                ],
                "senses": [
                    {
                        "sense_id": "074221a3-4cb7-3fd3-909b-2a6030c67320",
                        "entry_id": "fec4de5f-b003-3cf6-a1e2-6f70919e6bb2",
                        "glosses": [
                            "Sachverhalt, bei dem die Polizei wegen eines verübten Mordes ermittelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e149df5c-1c14-4741-9d18-307ad7b89250",
                                "sense_id": "074221a3-4cb7-3fd3-909b-2a6030c67320",
                                "text": "Der Mordfall konnte zu den Akten gelegt werden, da der Täter überführt wurde."
                            },
                            {
                                "example_id": "bc65569f-0bd2-4752-a1fc-58b5e61a447d",
                                "sense_id": "074221a3-4cb7-3fd3-909b-2a6030c67320",
                                "text": "„Dieser Mordfall deutet eindeutig auf das sexuell oder antisexuell begründete Rachemotiv hin, das in der Schmidthals-Analyse Vorrang hat.“"
                            },
                            {
                                "example_id": "87d8ab02-edfe-4bf6-a233-9f0ab3e76b85",
                                "sense_id": "074221a3-4cb7-3fd3-909b-2a6030c67320",
                                "text": "„Gerade Mordfälle mit sektiererischem Hintergrund werden häufig juristisch nicht verfolgt.“"
                            },
                            {
                                "example_id": "cba2fd12-1624-49d0-b41a-ce028c80d5f5",
                                "sense_id": "074221a3-4cb7-3fd3-909b-2a6030c67320",
                                "text": "„Wir hatten bei der ersten Betrachtung des Mordfalls nicht beachtet, dass die Aussage auch unwahr sein kann.“"
                            },
                            {
                                "example_id": "cf4dfdd0-bad8-40f9-8bbc-bc6c7f4c7960",
                                "sense_id": "074221a3-4cb7-3fd3-909b-2a6030c67320",
                                "text": "„Woher sollten sie auch wissen, dass dieser Wagen womöglich Teil der Ermittlungen in einem Mordfall war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
