                    },
                    {
                        "translation_id": "2f286b70-3907-45c0-b453-52c4ad8f563f",
                        "source_entry_id": "eb834988-4d45-3e38-9f36-266d87f4720c",
                        "source_sense_id": "b47ffc60-ed1b-3f70-837c-837acdf3038f",
                        "target_lang_word": "Schwester",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwester",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d623442-2dfe-32b9-b306-39a0cf352a93",
                                        "entry_id": "4c2bfc50-a5ad-36af-ba77-a7a6759b5fed",
                                        "glosses": [
                                            "weibliches Kind derselben Eltern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "baa6399c-1a27-4f8e-a758-65d7b7a1f6d1",
                                                "sense_id": "0d623442-2dfe-32b9-b306-39a0cf352a93",
                                                "text": "Meine Schwester geht in die 8. Klasse."
                                            },
                                            {
                                                "example_id": "94bbd29c-a9e1-4056-aa87-0ecf0cce0911",
                                                "sense_id": "0d623442-2dfe-32b9-b306-39a0cf352a93",
                                                "text": "„Der kleine Bruder half der großen Schwester.“"
                                            },
                                            {
                                                "example_id": "5b587006-05dd-4b9f-892f-c57fc6ac5489",
                                                "sense_id": "0d623442-2dfe-32b9-b306-39a0cf352a93",
                                                "text": "„Über meine Familie weiß ich nichts außer dem, was mir meine eigenen Kindheitserinnerungen und die Berichte meiner Schwester verraten.“"
                                            },
                                            {
                                                "example_id": "4172a40a-c9c2-42cb-9452-1597cd2da065",
                                                "sense_id": "0d623442-2dfe-32b9-b306-39a0cf352a93",
                                                "text": "„Er hatte eine recht liebenswerte Schwester, und eine zweite, die das Ordensgelübde abgelegt hatte, erschien mir wie ein Wunder.“"
                                            },
                                            {
                                                "example_id": "831e0ba7-983d-4ecb-b5fd-cb1412e620e7",
                                                "sense_id": "0d623442-2dfe-32b9-b306-39a0cf352a93",
                                                "text": "„Rita ist zum Geburtstag einer Schulfreundin eingeladen und hat ihre kleine Schwester mitgebracht, weil die Mutter berufstätig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "249de9c9-6851-3ce1-b086-015b1e460a0b",
                                        "entry_id": "4c2bfc50-a5ad-36af-ba77-a7a6759b5fed",
                                        "glosses": [
                                            "Krankenschwester"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b8590dd-d257-4489-88e8-8bcb48d83acd",
                                                "sense_id": "249de9c9-6851-3ce1-b086-015b1e460a0b",
                                                "text": "„Die Schwester legt die Hand wieder zurück: ganz ruhig liegen.“"
                                            },
                                            {
                                                "example_id": "b684c8dc-ed78-4098-94c8-2391647adace",
                                                "sense_id": "249de9c9-6851-3ce1-b086-015b1e460a0b",
                                                "text": "Rufen Sie bitte die Schwester!"
                                            },
                                            {
                                                "example_id": "0794c4ee-065c-4da5-8bb9-073a1d571b73",
                                                "sense_id": "249de9c9-6851-3ce1-b086-015b1e460a0b",
                                                "text": "„Nach einigen Zigarettenlängen kam die Schwester wieder herein und bat ihn, ihr ins Gästehaus zu folgen.“"
                                            },
                                            {
                                                "example_id": "8d3353e4-f040-4503-86b8-3e18e50af51a",
                                                "sense_id": "249de9c9-6851-3ce1-b086-015b1e460a0b",
                                                "text": "„Der fröhliche Greis wird von der kräftigen Schwester vorübergeführt.“"
                                            },
                                            {
                                                "example_id": "bd0f6d59-3319-42c2-be10-f0d049db5f42",
                                                "sense_id": "249de9c9-6851-3ce1-b086-015b1e460a0b",
                                                "text": "„Nach der üblichen Wartezeit bekam er ein Einzelzimmer, wo eine Schwester ihm half, die Papiere auszufüllen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "070c1d3c-c1ee-3f8d-a058-d158789c4cc0",
                                        "entry_id": "4c2bfc50-a5ad-36af-ba77-a7a6759b5fed",
                                        "glosses": [
                                            "weibliche Person, die ihr Leben innerhalb der Kirche Gott gewidmet hat, einem Orden angehört"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2a0fc60-ced4-4fa1-aea1-47ea5bc38475",
                                                "sense_id": "070c1d3c-c1ee-3f8d-a058-d158789c4cc0",
                                                "text": "Schwester Marta wird den Religionsunterricht halten."
                                            },
                                            {
                                                "example_id": "6d345a5c-9706-4cd5-86db-3134e5384ef8",
                                                "sense_id": "070c1d3c-c1ee-3f8d-a058-d158789c4cc0",
                                                "text": "„Sie kritzelten in seine Schulhefte, und Schwester Angelika schlug ihn dafür mit dem Lineal.“"
                                            },
                                            {
                                                "example_id": "b5df1915-780d-4e80-bd46-91f104cdd50b",
                                                "sense_id": "070c1d3c-c1ee-3f8d-a058-d158789c4cc0",
                                                "text": "„Zu diesem Zeitpunkt lebte seine Tochter, Schwester Maria Celeste, nicht mehr.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0e7b8b26-7b53-380d-af75-8de1d44cadbf",
                                        "entry_id": "4c2bfc50-a5ad-36af-ba77-a7a6759b5fed",
                                        "glosses": [
                                            "weibliche Person, der man sich im Geiste verbunden fühlt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "775f6994-9da5-43f8-a3bd-236dfc615e91",
                                                "sense_id": "0e7b8b26-7b53-380d-af75-8de1d44cadbf",
                                                "text": "Schwestern, heute wird gefeiert! Ladies Night bei Hermine."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "d8ca9797-6002-386b-ac37-9ef0ba3a9c81",
