                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1fa9c07-5a41-415d-88eb-323aa94f1364",
                                                "sense_id": "b47234f5-de30-30ac-a52d-ee1002455d1e",
                                                "text": "Po čtyřicítce už tomu sportu zas tak moc nedal.",
                                                "translation": "Od svých čtyřiceti let věku se již méně věnoval sportu."
                                            },
                                            {
                                                "example_id": "94146e18-198e-4bb6-ba10-b148e3b527d4",
                                                "sense_id": "b47234f5-de30-30ac-a52d-ee1002455d1e",
                                                "text": "čtyřicítka – pokoj (číslo čtyřicet), stůl v restauraci (číslo čtyřicet), tramvaj (číslo čtyřicet), (čtyřicetimilimetrový) klíč, (čtyřicetiampérový) jistič, (čtyřicetikilometrový) závod, závodník (se startovním číslem čtyřicet) atd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "378cac5e-a010-38b7-93af-35397ce0ed41",
                                        "entry_id": "d4467c03-bd01-332d-8100-9c3b1b040f00",
                                        "glosses": [
                                            "(většinou mn.) teplota těla přesahující čtyřicet stupňů Celsia"
                                        ],
                                        "tags": [
