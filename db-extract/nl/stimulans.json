                "senses": [
                    {
                        "sense_id": "6c38398f-3f8e-39c8-9524-8fc9a72170c2",
                        "entry_id": "b259dce5-db09-3aba-aee4-eb051a8611bf",
                        "glosses": [
                            "krachtige aanzet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d210e96d-5171-43a3-bee8-957b7b90d926",
                                "sense_id": "6c38398f-3f8e-39c8-9524-8fc9a72170c2",
                                "text": "Zij had nét even die stimulans nodig om door te gaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ade4622-f8c2-3963-b9cf-69a3f46da080",
                        "entry_id": "b259dce5-db09-3aba-aee4-eb051a8611bf",
                        "glosses": [
                            "opwekkend middel\\nVanaf de tweede helft van de 20e eeuw is in deze betekenis alleen de meervoudsvorm nog gangbaar."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61e6e077-9733-4b6f-96fb-5378c2ca8233",
                        "source_entry_id": "b259dce5-db09-3aba-aee4-eb051a8611bf",
                        "source_sense_id": "6c38398f-3f8e-39c8-9524-8fc9a72170c2",
                        "source_sense_description": "krachtige aanzet",
                        "target_lang_word": "Stimulans",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stimulans",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71f189b5-a843-3a3a-bbe5-ced1e32c31da",
                                        "entry_id": "1888b6e3-0472-37d7-87c9-d295ae997853",
                                        "glosses": [
                                            "anregendes Mittel, anregende Arznei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb8282b-886f-486c-928a-d54bdfa4053c",
                                                "sense_id": "71f189b5-a843-3a3a-bbe5-ced1e32c31da",
                                                "text": "„Die Ehe ist bestenfalls ein verlässliches Stimulans für die Erregungen, die heimliche Seitensprünge bereithalten.“"
                                            },
                                            {
                                                "example_id": "adc8d14d-5d3b-46ee-8a4d-ddbde6cb3858",
                                                "sense_id": "71f189b5-a843-3a3a-bbe5-ced1e32c31da",
                                                "text": "„Jünger sucht kein Narkotikum, um zeitweilig den totalen Austritt aus einer als unbefriedigend empfundenen Welt zu erlangen, sondern ein Stimulans zur Steigerung der dichterischen Produktion und Erweiterung seiner Sensibilität.“"
                                            },
                                            {
                                                "example_id": "04108941-b174-4059-8cbc-a0b64f939df3",
                                                "sense_id": "71f189b5-a843-3a3a-bbe5-ced1e32c31da",
                                                "text": "„Es wäre doch eine nette Überraschung, wenn der Gatte als Stimulans für die Genesung das fertige Buch mit seinem Namen auf dem Titelblatt bald in Händen hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "193c20b2-6a2d-4ab1-95bc-3c7abed5f22d",
                        "source_entry_id": "b259dce5-db09-3aba-aee4-eb051a8611bf",
                        "source_sense_id": "6c38398f-3f8e-39c8-9524-8fc9a72170c2",
                        "source_sense_description": "krachtige aanzet",
                        "target_lang_word": "stimulus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "An external phenomenon that has an influence on a system, by triggering or modifying an internal phenomenon; for example, a spur or incentive that drives a person to take action or change behaviour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1673c75e-91ac-4454-824f-7fc119abce87",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "an economic stimulus"
                                            },
                                            {
                                                "example_id": "d5c0027f-fc3b-4f67-9864-2013335786f1",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "From the beginning of the show to the end, vanity is the sole stimulus and reward of action—vanity, that never looks beyond the present."
                                            },
                                            {
                                                "example_id": "d64d9582-1846-4e54-aa5e-dab35f68a905",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "Democrats, meanwhile, point out that Republicans seem to have made a conscious decision, beginning with the stimulus, to oppose anything the president put forward, dooming any chance of renewed cooperation between the parties."
                                            },
                                            {
                                                "example_id": "6b812202-831b-45d8-b904-b384f02a7332",
                                                "sense_id": "4b3abdfa-2f84-3c04-a275-8f46e77aff28",
                                                "text": "respond to a stimulus"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "Something external that elicits or influences a physiological or psychological activity or response, or that affects any of the sensory apparatuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7eb9862-11e9-433b-8433-c72738f4fe1d",
                                                "sense_id": "5427ca45-0fe6-3428-913f-9503dc3012ae",
                                                "text": "Even light nonpainful stimuli can provoke or exacerbate spontaneous pain; this is not limited to tactile, thermal, or vibratory stimuli, because auditory, visual, olfactory, and visceral stimuli also may be problematic."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                        "entry_id": "15979d7b-48ef-31f3-97ca-c3c32a1348a1",
                                        "glosses": [
                                            "A stinging part on the body of a plant or insect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "747203e2-52c2-446e-a3bb-9339dd948f48",
                                                "sense_id": "b2a781a5-e371-3aa2-a6f8-0436bc1927ff",
                                                "text": "Many plants, like many animals, are furnished with arms for their protection; these are either aculei, prickles […]; or stimuli, stings, as in the nettles, which are armed with a venomous fluid for the annoyance of naked animals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d37cdc21-59b2-4924-bab3-02d7f096a618",
                        "source_entry_id": "b259dce5-db09-3aba-aee4-eb051a8611bf",
                        "source_sense_id": "6c38398f-3f8e-39c8-9524-8fc9a72170c2",
                        "source_sense_description": "krachtige aanzet",
                        "target_lang_word": "stimulant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stimulant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                                        "entry_id": "07d89689-366a-318a-9ad9-1b11725854cc",
                                        "glosses": [
                                            "Qui excite, qui aiguillonne l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dbc320c-04e7-49c2-9b51-8f1f917e1186",
                                                "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                                                "text": "L’émulation est un stimulant qu’il faut employer à propos et avec précaution."
                                            },
                                            {
                                                "example_id": "9f7b5da8-ae63-41e0-adc0-5ffe157df238",
                                                "sense_id": "1e579dc9-d084-3ccf-ad98-47003312d49b",
                                                "text": "Il est assez porté à agir de la sorte, il n’a pas besoin de stimulants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64af943e-8d8d-31df-8763-07c1e52c5a4d",
                                        "entry_id": "07d89689-366a-318a-9ad9-1b11725854cc",
                                        "glosses": [
                                            "Ce qui est propre à exciter les fonctions organiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3db8b17f-389e-493c-99c2-618afd827221",
                                                "sense_id": "64af943e-8d8d-31df-8763-07c1e52c5a4d",
                                                "text": "Il fournit également des glucides, dont certains, spécifiques à certaines espèces (shiitake et pleurotes), sont reconnus pour leur action stimulante du système immunitaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stimulant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9cf096d8-0e0b-3863-b79c-92b0cd9df767",
                                        "entry_id": "5064b394-d103-3afd-bdfe-860cc583d486",
                                        "glosses": [
                                            "Produit stimulant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98b9d1d9-4ab5-4f28-aa7d-bbe61e4beccf",
                                                "sense_id": "9cf096d8-0e0b-3863-b79c-92b0cd9df767",
                                                "text": "Avant leurs matchs, les joueurs russes ont sniffé de l’ammoniaque, un stimulant de l’oxygénation du sang reconnu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996dec57-00e3-3cdb-804f-a20a361f0a6d",
                                        "entry_id": "5064b394-d103-3afd-bdfe-860cc583d486",
                                        "glosses": [
                                            "Action stimulante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bee7299-58b3-43a4-b653-5779c2b8fa66",
                                                "sense_id": "996dec57-00e3-3cdb-804f-a20a361f0a6d",
                                                "text": "Si le cheval n’a pas de l’âme, à chaque enjambée du garçon il est aiguillonné par la houssine ou le bâton qui agit adroitement, quand toutefois ce stimulant n’est pas remplacé par le claquement du fouet, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stimulant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f326d4d-2db7-3adc-b3f1-e46e6ac89bbf",
                                        "entry_id": "1a8824c0-5c43-3d0f-b52f-007f8e2c48ea",
                                        "glosses": [
                                            "Participe présent de stimuler."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ffd4b3d-8684-4d94-b583-f43ef112bde9",
                                                "sense_id": "8f326d4d-2db7-3adc-b3f1-e46e6ac89bbf",
                                                "text": "Notre objectif est de décommoditiser le cacao tout en stimulant l'accès au marché aux petits producteurs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
