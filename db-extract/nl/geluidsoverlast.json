                            "Nederland"
                        ],
                        "examples": [
                            {
                                "example_id": "cbe6f9c8-be48-4391-9fd0-29f1fbda0281",
                                "sense_id": "80dba96a-7df3-315b-9468-0ca0fc7bb305",
                                "text": "De darkstores, die sinds vorig jaar plotseling op allerlei plekken verschenen, zijn de gemeente Amsterdam een doorn in het oog. In januari bepaalde het college dat nieuwe darkstores voorlopig niet meer zijn toegestaan, na klachten uit buurten over geblokkeerde stoepen, geluidsoverlast en onveilige verkeerssituaties."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8f07c02-ea4a-344a-81e9-87b2d5193bc4",
                        "entry_id": "085cd6b8-b949-3c54-81ec-686a4f57e8ec",
                        "glosses": [
                            "verstoring door lawaai",
                            "mate van voor de bevolking door omgevingslawaai veroorzaakte hinder als bepaald met veldonderzoek"
                        ],
                        "tags": [
                            "België"
                        ],
                        "examples": [
                            {
                                "example_id": "7a243fe0-218c-43c9-a42e-a8f2939bfc53",
                                "sense_id": "a8f07c02-ea4a-344a-81e9-87b2d5193bc4",
                                "text": "Het luidruchtige studentenfeest veroorzaakte veel geluidsoverlast in de wijde omgeving."
                            }
                        ]
                    }
