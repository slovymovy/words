                    },
                    {
                        "translation_id": "6d1c6918-b9b8-46b2-be29-d15786a2005c",
                        "source_entry_id": "383a31ab-8daf-3dbc-93e6-77387943e65a",
                        "source_sense_description": "недовольное бормотанье человека",
                        "target_lang_word": "Knurren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knurren",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15455c76-e3ad-3e47-9e90-82302ceecdba",
                                        "entry_id": "84157c1f-de5f-35e0-a3e7-3781aaf33cd3",
                                        "glosses": [
                                            "knurrendes Geräusch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4e2b00e-e5b1-43e6-afea-2b21a8324094",
                                                "sense_id": "15455c76-e3ad-3e47-9e90-82302ceecdba",
                                                "text": "„Abends glommen ihre Augen am Rand des Feuerscheins, wanderten hin und her; als die Männer im kühlen Dämmer des nächsten Morgens loszogen, hörten sie hinter sich die Tiere das Lager nach Fleischresten durchstöbern, hörten das wütende Knurren, das Zuschnappen der Fänge.“"
                                            },
                                            {
                                                "example_id": "e592e1e0-4ecd-4951-a093-bf8be2a754ae",
                                                "sense_id": "15455c76-e3ad-3e47-9e90-82302ceecdba",
                                                "text": "„Zwischendurch vernahmen sie das Röhren einer von den Voormis gehetzten Basilisken-Gemse und einmal sogar das mörderische Knurren eines gestellten und besiegten Säbelzahntigers.“"
                                            },
                                            {
                                                "example_id": "f91426ff-a5e4-4fdc-b1a7-bc8b6237f565",
                                                "sense_id": "15455c76-e3ad-3e47-9e90-82302ceecdba",
                                                "text": "„Duffy Deeter hatte bereits zu einer Antwort angesetzt, aber nur ein oder zwei Worte herausgebracht, als aus dem Schatten hinter ihnen ein tiefes gutturales Knurren erklang und eine mächtige Gestalt aus der Dunkelheit trat, einen Dreipunktestand einnahm und ›Position!‹ schrie.“"
                                            },
                                            {
                                                "example_id": "2098a984-7517-4066-9ef5-282d80059014",
                                                "sense_id": "15455c76-e3ad-3e47-9e90-82302ceecdba",
                                                "text": "„Erst da hörte CJ das lang gezogene tiefe Knurren.“"
                                            },
                                            {
                                                "example_id": "4ed46d01-5fdf-42a0-87ff-b300f265a0f8",
                                                "sense_id": "15455c76-e3ad-3e47-9e90-82302ceecdba",
                                                "text": "„›Wer ist da?‹ fragte Sartaj, obwohl er das raue Knurren sofort erkannt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
