                "senses": [
                    {
                        "sense_id": "8e6c3889-67e9-3ee4-b135-5b737fe670cf",
                        "entry_id": "577cfed3-8ccf-3a78-89f1-f116aed91e63",
                        "glosses": [
                            "Kombination aus sechs richtigen Gewinnzahlen im Lotto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50577f97-10ce-48be-b9d1-9b0b2a44815a",
                                "sense_id": "8e6c3889-67e9-3ee4-b135-5b737fe670cf",
                                "text": "Nach seinem Sechser im Lotto war er Millionär."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f3711b11-3ca1-34c8-9e94-5f6eb5af9ad0",
                        "entry_id": "577cfed3-8ccf-3a78-89f1-f116aed91e63",
                        "glosses": [
                            "defensiv ausgerichtete Spielposition vor der Abwehrkette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "587e502f-b025-4cc9-80ed-8bc7623717d3",
                                "sense_id": "f3711b11-3ca1-34c8-9e94-5f6eb5af9ad0",
                                "text": "Der Sechser des deutschen Meisters erzielte beim Heimspiel zwei Tore."
                            },
                            {
                                "example_id": "78ccfb36-a271-4fdd-bc23-49527b3acee2",
                                "sense_id": "f3711b11-3ca1-34c8-9e94-5f6eb5af9ad0",
                                "text": "„Der Sechser ist eigentlich ein normaler Mittelfeldspieler, der aber die Aufgabe des Vorstoppers aus früheren Zeiten übernimmt.“"
                            },
                            {
                                "example_id": "5a97d4a9-ea81-4149-90d5-482f9cea2bbc",
                                "sense_id": "f3711b11-3ca1-34c8-9e94-5f6eb5af9ad0",
                                "text": "„Dabei hat der \"Sechser\" nicht nur defensive Aufgaben. Er fungiert als Bindeglied zwischen Abwehr und Mittelfeld und als strategischer Ballverteiler im Spielaufbau.“"
                            },
                            {
                                "example_id": "860915ab-3457-4b92-8dfb-7a167572b1e1",
                                "sense_id": "f3711b11-3ca1-34c8-9e94-5f6eb5af9ad0",
                                "text": "„Oft ist der \"Sechser\" ein sehr erfahrener, umsichtiger Spieler.“"
                            },
                            {
                                "example_id": "9cdfaef0-1462-446f-896e-3dbd0f6835e7",
                                "sense_id": "f3711b11-3ca1-34c8-9e94-5f6eb5af9ad0",
                                "text": "„Ex-Profi Jamie Carragher vom FC Liverpool hat einmal gesagt, dass ein Verein für einen \"Sechser\" nicht so viel Geld ausgeben sollte.“"
                            },
                            {
                                "example_id": "f1959e6e-3e3b-42a2-95b3-b70aed3a1a08",
                                "sense_id": "f3711b11-3ca1-34c8-9e94-5f6eb5af9ad0",
                                "text": "„Trainer Ralf Kellermann setzte sie defensiver ein: mal als linke Außenverteidigerin, mal als Sechser, mal auf der Zehn.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ecbb4cf8-5f46-314f-8539-f1234da81a49",
                        "entry_id": "577cfed3-8ccf-3a78-89f1-f116aed91e63",
