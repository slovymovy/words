                        "examples": [
                            {
                                "example_id": "1eaa6ed8-b874-405e-a6a7-df4aab59ca06",
                                "sense_id": "6bcf06c8-01db-3244-9924-acc04a3bbaca",
                                "text": "De onderdrukking, gevangenzetting en mishandelingen van Oeigoeren door de Chinese overheid moet veel strenger veroordeeld worden. Dat vindt een meerderheid in de Tweede Kamer. Partijen vinden dat moet worden nagedacht over hardere sancties en roepen het kabinet op te kijken wat mogelijk is."
                            },
                            {
                                "example_id": "25099a8c-e921-44fc-bcdf-9036bdaa3560",
                                "sense_id": "6bcf06c8-01db-3244-9924-acc04a3bbaca",
                                "text": "Ankara is kwaad dat campagnebijeenkomsten van Turkse politici in Duitsland verboden zijn. Berlijn heeft gezegd dat Turkse politici mogen komen mits ze open zijn over hun bedoelingen. Duitsland is ook verontwaardigd over de gevangenzetting van een Turks-Duitse journalist in Turkije."
                            },
                            {
                                "example_id": "f664f36e-3bbe-4720-97e8-233197da2a81",
                                "sense_id": "6bcf06c8-01db-3244-9924-acc04a3bbaca",
                                "text": "Zijn ouders wilden een klacht indienen. Maar na een bezoek van wat veiligheidsmensen en een kortstondige gevangenzetting van zijn vader, verklaarden de ouders dat hun zoon goed was behandeld."
                            }
                        ]
