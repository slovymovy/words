{
    "word_family": [
        "schuiven",
        "opschuiving",
        "verschuiven",
        "uitschuiven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "00aa5541-6e5c-3e89-bedd-c75ddfbfb8c4",
                    "sense_definition": "van plaats veranderen door over een oppervlak te glijden, of plaatsmaken door opzij te gaan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verplaatsen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je een stukje <w>opschuiven</w> zodat ik er ook nog bij kan zitten?",
                            "target_lang_translations": {
                                "en": "Can you <w>scoot over</w> a bit so I can sit down too?"
                            }
                        },
                        {
                            "text": "We moesten de zware bank een klein stukje <w>opschuiven</w> om de deur te openen.",
                            "target_lang_translations": {
                                "en": "We had to <w>shift</w> the heavy sofa a little bit to open the door."
                            }
                        }
                    ],
                    "synonyms": [
                        "verschuiven",
                        "verplaatsen",
                        "opzijgaan"
                    ],
                    "common_phrases": [
                        "een stukje opschuiven",
                        "op de bank opschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To change position by sliding over a surface, or to make room by moving aside"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "move up",
                                "target_lang_sense_clarification": "to make room for someone else"
                            },
                            {
                                "target_lang_word": "scoot over",
                                "target_lang_sense_clarification": "to slide along a seat to make space"
                            },
                            {
                                "target_lang_word": "shift",
                                "target_lang_sense_clarification": "to move an object slightly"
                            },
                            {
                                "target_lang_word": "budge",
                                "target_lang_sense_clarification": "to move slightly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c23170bc-9e6f-3c3d-8c8d-b3faa78d5800",
                    "sense_definition": "naar een later tijdstip verplaatsen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitstellen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We moeten de vergadering helaas een week <w>opschuiven</w> vanwege de vakantie.",
                            "target_lang_translations": {
                                "en": "Unfortunately, we have to <w>push back</w> the meeting by a week because of the holidays."
                            }
                        },
                        {
                            "text": "Zij <w>schoof</w> haar plannen <w>op</w> toen ze hoorde dat er storm op komst was.",
                            "target_lang_translations": {
                                "en": "She <w>postponed</w> her plans when she heard a storm was coming."
                            }
                        }
                    ],
                    "synonyms": [
                        "uitstellen",
                        "verschuiven",
                        "verdagen"
                    ],
                    "antonyms": [
                        "vervroegen"
                    ],
                    "common_phrases": [
                        "een week opschuiven",
                        "de datum opschuiven"
                    ],
                    "target_lang_definitions": {
                        "en": "To move or reschedule to a later time"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "postpone",
                                "target_lang_sense_clarification": "to delay an event to a later date"
                            },
                            {
                                "target_lang_word": "push back",
                                "target_lang_sense_clarification": "to reschedule to a later time"
                            },
                            {
                                "target_lang_word": "delay",
                                "target_lang_sense_clarification": "to make something happen later than planned"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}