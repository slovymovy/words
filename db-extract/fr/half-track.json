                        "sense_id": "866f479a-5f3d-3170-846d-a1e9aa22b3b7",
                        "entry_id": "e7e3195c-91f5-3e4f-8ae3-a7d4bb3afc0d",
                        "glosses": [
                            "Autochenille."
