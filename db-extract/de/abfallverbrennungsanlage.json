                        "sense_id": "181808f7-7807-3533-9fee-9f0178b6caea",
                        "entry_id": "bca6950a-2297-3e54-afdc-2bdbb1053451",
                        "glosses": [
                            "technische Einrichtung zur Verbrennung von Abfall – verbunden mit der Nutzung der dabei entstehenden Energie"
                        ],
                        "tags": [
