                                "example_id": "69125085-a498-4cf7-822e-e603bc904581",
                                "sense_id": "6898f5d5-c2d7-3874-9c9c-3bac79c99cde",
                                "text": "„Professor Franz W. Wagner lehrt Betriebswirtschaftliche Steuerlehre an der Universität Tübingen.“"
                            },
                            {
                                "example_id": "2d63722d-239c-4b72-a534-fd8c4d0b540c",
                                "sense_id": "6898f5d5-c2d7-3874-9c9c-3bac79c99cde",
                                "text": "„Die Unterscheidung zwischen direkten und indirekten Steuern ist die wohl am weitesten verbreitete Einteilung der Besteuerungsformen. Schon seit Jahrhunderten gebräuchlich, ist sie ebenso lange umstritten in Steuerlehre und Finanzwissenschaft.“"
                            }
