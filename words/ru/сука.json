{
    "word_family": [
        "сучка",
        "сучара",
        "сучий",
        "сукин"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b0965bba-619b-373b-8d75-1a970432b623",
                    "sense_definition": "Сварливая, скандальная или неприятная женщина (грубое ругательство).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта <w>сука</w> снова устроила скандал на пустом месте.",
                            "target_lang_translations": {
                                "en": "That <w>bitch</w> made a scene out of nothing again.",
                                "de": "Dieses <w>Miststück</w> hat schon wieder aus heiterem Himmel einen Streit angefangen."
                            }
                        },
                        {
                            "text": "Он назвал её <w>сукой</w> и хлопнул дверью.",
                            "target_lang_translations": {
                                "en": "He called her a <w>bitch</w> and slammed the door.",
                                "de": "Er nannte sie ein <w>Miststück</w> und knallte die Tür zu."
                            }
                        }
                    ],
                    "synonyms": [
                        "стерва"
                    ],
                    "common_phrases": [
                        "редкая сука",
                        "продажная сука"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "грубое, вульгарное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A quarrelsome, scandalous, or unpleasant woman (offensive slur).",
                        "de": "Eine streitsüchtige, skandalöse oder unangenehme Frau (beleidigendes Schimpfwort)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bitch",
                                "target_lang_sense_clarification": "offensive term for a woman"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Miststück",
                                "target_lang_sense_clarification": "beleidigende Bezeichnung für eine Frau"
                            },
                            {
                                "target_lang_word": "Zicke",
                                "target_lang_sense_clarification": "abwertend für eine zickige oder unangenehme Frau"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9aad45d0-d5b0-3076-8429-4500ad5c7d8f",
                    "sense_definition": "Подлый, негодный человек; негодяй (используется по отношению к любому полу).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "insult",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Верни мне деньги, <w>сука</w>!",
                            "target_lang_translations": {
                                "en": "Give me back my money, <w>bitch</w>!",
                                "de": "Gib mir mein Geld zurück, du <w>Arschloch</w>!"
                            }
                        },
                        {
                            "text": "Какой же он <w>сука</w>, что так поступил с нами.",
                            "target_lang_translations": {
                                "en": "What a <w>scumbag</w> he is for treating us like that.",
                                "de": "Was für ein <w>Mistkerl</w> er ist, dass er so mit uns umgegangen ist."
                            }
                        }
                    ],
                    "synonyms": [
                        "мерзавец",
                        "мразь",
                        "негодяй",
                        "сволочь",
                        "подлец",
                        "гад"
                    ],
                    "common_phrases": [
                        "сука буду"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "грубое, бранное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A vile, worthless person; a scoundrel (used for any gender).",
                        "de": "Ein niederträchtiger, wertloser Mensch; ein Schurke (geschlechtsneutral verwendet)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scumbag",
                                "target_lang_sense_clarification": "despicable person"
                            },
                            {
                                "target_lang_word": "bastard",
                                "target_lang_sense_clarification": "unpleasant person"
                            },
                            {
                                "target_lang_word": "bitch",
                                "target_lang_sense_clarification": "general insult"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Mistkerl",
                                "target_lang_sense_clarification": "allgemeine Beleidigung für eine verabscheuungswürdige Person"
                            },
                            {
                                "target_lang_word": "Arschloch",
                                "target_lang_sense_clarification": "sehr vulgäre Bezeichnung für eine unangenehme Person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2741fdce-44ed-32be-86c5-d9bc269ea0c4",
                    "sense_definition": "Самка собаки или других животных семейства псовых.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У соседей ощенилась охотничья <w>сука</w>.",
                            "target_lang_translations": {
                                "en": "The neighbors' hunting <w>bitch</w> has whelped.",
                                "de": "Die Jagd-<w>Hündin</w> der Nachbarn hat geworfen."
                            }
                        },
                        {
                            "text": "Эту породистую <w>суку</w> готовят к выставке.",
                            "target_lang_translations": {
                                "en": "This purebred <w>bitch</w> is being prepared for the show.",
                                "de": "Diese Rasse-<w>Hündin</w> wird für die Ausstellung vorbereitet."
                            }
                        }
                    ],
                    "synonyms": [
                        "сучка",
                        "собака"
                    ],
                    "antonyms": [
                        "кобель"
                    ],
                    "common_phrases": [
                        "племенная сука"
                    ],
                    "target_lang_definitions": {
                        "en": "A female dog or other canine.",
                        "de": "Ein weiblicher Hund."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bitch",
                                "target_lang_sense_clarification": "female dog"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Hündin",
                                "target_lang_sense_clarification": "weiblicher Hund"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56c5459d-c7e1-3c7f-a7ba-68e00cfe586a",
                    "sense_definition": "Предатель в криминальной среде; заключённый, сотрудничающий с администрацией тюрьмы.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "prison_slang",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В камере все знали, что он <w>сука</w>.",
                            "target_lang_translations": {
                                "en": "Everyone in the cell knew he was a <w>snitch</w>.",
                                "de": "In der Zelle wussten alle, dass er eine <w>Petze</w> ist."
                            }
                        },
                        {
                            "text": "Этой <w>суке</w> воры уже вынесли приговор.",
                            "target_lang_translations": {
                                "en": "The thieves have already passed sentence on that <w>rat</w>.",
                                "de": "Die Diebe haben über diese <w>Verräter</w> bereits ein Urteil gefällt."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "криминальный жаргон"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A traitor in the criminal world; a prisoner cooperating with prison administration.",
                        "de": "Ein Verräter im kriminellen Milieu; ein Gefangener, der mit der Gefängnisverwaltung kooperiert."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "snitch",
                                "target_lang_sense_clarification": "informer"
                            },
                            {
                                "target_lang_word": "rat",
                                "target_lang_sense_clarification": "traitor"
                            },
                            {
                                "target_lang_word": "stool pigeon",
                                "target_lang_sense_clarification": "informer"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Verräter",
                                "target_lang_sense_clarification": "jemand, der Informationen weitergibt"
                            },
                            {
                                "target_lang_word": "Petze",
                                "target_lang_sense_clarification": "umgangssprachlich für jemanden, der andere verpfeift"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "3d9c47a6-e795-3565-a11c-9bf4bf47d9ca",
                    "sense_definition": "Грубое восклицание, выражающее досаду, гнев, боль или удивление.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "expletive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Где, <w>сука</w>, мои ключи?",
                            "target_lang_translations": {
                                "en": "Where the <w>fuck</w> are my keys?",
                                "de": "Wo, <w>verdammt</w>, sind meine Schlüssel?"
                            }
                        },
                        {
                            "text": "Почему, <w>сука</w>, ничего не работает?",
                            "target_lang_translations": {
                                "en": "Why the <w>fuck</w> doesn't anything work?",
                                "de": "Warum, <w>verdammt</w>, funktioniert hier nichts?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "да сука",
                        "вот сука"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "грубое, вульгарное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A rude exclamation expressing annoyance, anger, pain, or surprise.",
                        "de": "Ein grober Ausruf, der Ärger, Wut, Schmerz oder Überraschung ausdrückt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fuck",
                                "target_lang_sense_clarification": "vulgar exclamation"
                            },
                            {
                                "target_lang_word": "shit",
                                "target_lang_sense_clarification": "expression of anger"
                            },
                            {
                                "target_lang_word": "damn it",
                                "target_lang_sense_clarification": "expression of annoyance"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Verdammt",
                                "target_lang_sense_clarification": "Ausdruck von Ärger oder Frustration"
                            },
                            {
                                "target_lang_word": "Scheiße",
                                "target_lang_sense_clarification": "vulgärer Ausruf bei Wut oder Missgeschick"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6a9b6cf6-3a73-3693-b47d-17f230896e79",
                    "sense_definition": "Форма родительного падежа единственного числа существительного <w>сук</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "С этого старого <w>сука</w> упали все листья.",
                            "target_lang_translations": {
                                "en": "All the leaves have fallen from this old <w>bough</w>.",
                                "de": "Von diesem alten <w>Astes</w> sind alle Blätter gefallen."
                            }
                        },
                        {
                            "text": "На дереве не осталось ни одного <w>сука</w>.",
                            "target_lang_translations": {
                                "en": "There wasn't a single <w>branch</w> left on the tree.",
                                "de": "Am Baum war kein einziger <w>Ast</w> mehr übrig."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Genitive singular form of the noun <w>сук</w> (bough).",
                        "de": "Genitiv Singular des Substantivs Ast (bough)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bough",
                                "target_lang_sense_clarification": "tree branch"
                            },
                            {
                                "target_lang_word": "branch",
                                "target_lang_sense_clarification": "limb of a tree"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Astes",
                                "target_lang_sense_clarification": "Genitivform von Ast"
                            }
                        ]
                    }
                }
            ]
        },
        {
