                "senses": [
                    {
                        "sense_id": "10a5f4d3-d6cc-327e-9b5d-7eac3b795dd8",
                        "entry_id": "d0affa4e-ccaa-3237-b889-82c652671b1c",
                        "glosses": [
                            "техн. колонка для частичной конденсации в абсорбционных холодильных машинах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "147afa04-5674-4f89-a274-b0885f093abf",
                                "sense_id": "10a5f4d3-d6cc-327e-9b5d-7eac3b795dd8",
                                "text": "Смесь направляют в дефлегматор, где большая часть азота конденсируется, и содержание неона и гелия в смеси повышается до 35-45 %."
                            }
                        ]
                    },
                    {
                        "sense_id": "50407f5a-6440-3ddd-a929-6bdc45733e88",
                        "entry_id": "d0affa4e-ccaa-3237-b889-82c652671b1c",
                        "glosses": [
                            "техн. приспособление для разделения жидкостей при фракционной перегонке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3adf63b8-1c26-4fae-9f76-5b9b4fcc5ca5",
                                "sense_id": "50407f5a-6440-3ddd-a929-6bdc45733e88",
                                "text": "Спирт выделяют в ректификационной колонне с дефлегматором."
                            }
                        ]
                    }
                ],
