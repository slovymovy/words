                        "examples": [
                            {
                                "example_id": "d7774c41-1fb5-4b33-bbde-84a482eaf606",
                                "sense_id": "2a398e9f-48e1-37eb-a347-f77eeef87d5e",
                                "text": "Al Habsi, so outstanding at Arsenal on Saturday, somehow scrambled the ball off the line, but only as far as Agbonlahor, who gleefully nodded home his first Premier League goal since last April."
                            },
                            {
                                "example_id": "226e3b64-69ad-4d8c-bb94-6bfcd218da91",
                                "sense_id": "2a398e9f-48e1-37eb-a347-f77eeef87d5e",
                                "text": "Of course, the game that was ruining workplace productivity and infrastructure wasn’t innocent Tetris or the nationalistic Wolfenstein 3D—it was a game in which an ultraviolent marine gleefully murdered demons on a satanic Mars."
                            },
                            {
                                "example_id": "8931859b-9404-4543-84c4-8e59a0aaee39",
                                "sense_id": "2a398e9f-48e1-37eb-a347-f77eeef87d5e",
                                "text": "After refusing to sit down, [Democratic Rep. Al Green of Texas] was escorted out of the House chamber, as some Republican lawmakers gleefully chanted “sha-nah-nah-nah, hey hey hey, goodbye.”"
                            }
                        ]
                    }
