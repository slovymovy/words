                    {
                        "sense_id": "afec4bb5-50a0-3b1c-8c8d-596e218836b8",
                        "entry_id": "d13cd08d-4e58-39fa-980d-1ce017d9eb19",
                        "glosses": [
                            "Celui qui crée quelque chose en collaboration avec d’autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58149d5d-693a-4f7d-b570-9e314374347c",
                                "sense_id": "afec4bb5-50a0-3b1c-8c8d-596e218836b8",
                                "text": "Avec Ecomobicoin, « un validateur devient éligible en effectuant une action vertueuse, comme se déplacer à pied ou à vélo », explique son co-créateur Pascal Lafourcade, docteur en informatique et maître de conférences à l’université Clermont-Auvergne."
                            },
                            {
                                "example_id": "0a5f183f-56be-4156-a0d3-c45f67aa37d4",
                                "sense_id": "afec4bb5-50a0-3b1c-8c8d-596e218836b8",
                                "text": "Les co-créateurs et/ou co-investisseurs mobilisent toutes leurs ressources pour anticiper les éventuels aléas sur la route des entrepreneurs."
                            },
                            {
                                "example_id": "760402ba-9e0a-4bc5-93d1-51c402537eba",
                                "sense_id": "afec4bb5-50a0-3b1c-8c8d-596e218836b8",
                                "text": "Notre série ne porte pas sur la catastrophe écologique, mais sur l’activisme, explique l’autre co-créateur Jonas Weydemann."
                            }
                        ]
                    }
