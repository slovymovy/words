                        "form": "der Genialität"
                    },
                    {
                        "form_id": "a7b6e85d-8ef2-4b9f-874c-688e1567df4c",
                        "entry_id": "0c9821dd-1ae7-36d0-8082-3d945aebfd4c",
                        "tags": [
