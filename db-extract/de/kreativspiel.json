                "senses": [
                    {
                        "sense_id": "843dd5b7-7b36-3524-b511-3a50c5b8306e",
                        "entry_id": "2804d3c2-269c-3940-b944-8f0746a9a359",
                        "glosses": [
                            "Spielgeschehen, bei dem Einfallsreichtum und schöpferische Qualitäten gefordert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1d9bea-b37b-42cc-afb5-0ba6591e6f23",
                                "sense_id": "843dd5b7-7b36-3524-b511-3a50c5b8306e",
                                "text": "„In diesem Konzept kommt den Kreativspielen eine hohe Bedeutung zu.“"
                            },
                            {
                                "example_id": "ba3faf83-c424-4674-978b-f555146789f6",
                                "sense_id": "843dd5b7-7b36-3524-b511-3a50c5b8306e",
                                "text": "„Auffällig war erneut die Abhängigkeit des Kreativspiels der Berliner von der Lust und Laune des Brasilianers.“"
                            },
                            {
                                "example_id": "597a00c0-4c99-4407-9ffb-ef75b92e9144",
                                "sense_id": "843dd5b7-7b36-3524-b511-3a50c5b8306e",
                                "text": "„Nesta gar wird zu den seltenen Verteidigern gezählt, die auch dem Kreativspiel zu Impulsen verhelfen können.“"
                            },
                            {
                                "example_id": "33da1822-7b76-4c5c-a550-8a2f67b9b1ac",
                                "sense_id": "843dd5b7-7b36-3524-b511-3a50c5b8306e",
                                "text": "„Es bedeutet für uns eine Qualitätssteigerung, weil er ein Spieler ist, der mit seiner Technik, seiner Übersicht belebende Elemente ins Kreativspiel unserer Mannschaft bringt, schwärmte Löw über den 25-Jährigen, der nach der WM 2014 auch die EM in Frankreich aus Verletzungsgründen verpasst hatte.“"
                            },
                            {
                                "example_id": "c7017fb4-80fa-4597-8234-b53110e48cab",
                                "sense_id": "843dd5b7-7b36-3524-b511-3a50c5b8306e",
                                "text": "„Die Griechen konzentrierten sich darauf, das Kreativspiel des Teams von Dick Advocaat zu unterbinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
