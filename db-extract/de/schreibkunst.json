                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43c68523-f70b-4b0b-83de-3559ed741ceb",
                                "sense_id": "3bbade08-31cc-34fb-85ad-918e378e075c",
                                "text": "„Sehr selten beherrscht ein Laie die Schreibkunst.“"
                            },
                            {
                                "example_id": "7c8e2276-cd11-4737-bd66-05201301b72b",
                                "sense_id": "3bbade08-31cc-34fb-85ad-918e378e075c",
                                "text": "„Das Amt des Stadtschreibers verlangte also zunächst die Kenntnis der lateinischen Muster und die Beherrschung der lateinischen Schreibkunst.“"
                            },
                            {
                                "example_id": "3e58c6d7-8654-4ecf-bd56-c7530798d65a",
                                "sense_id": "3bbade08-31cc-34fb-85ad-918e378e075c",
                                "text": "„Die Schreibkunst ist eine heilige Kunst, sogar das Papier, auf dem geschrieben wird, ist heilig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
