{
    "word_family": [
        "shimmer",
        "shimmery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8e4a67b8-f1e5-3bb0-ae1f-61f5be61742b",
                    "sense_definition": "The present participle and gerund of <w>shimmer</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shimmering_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sunlight was <w>shimmering</w> on the surface of the lake during the afternoon.",
                            "target_lang_translations": {
                                "ru": "Днем солнечный свет <w>мерцал</w> на поверхности озера.",
                                "es": "La luz del sol <w>brillaba</w> sobre la superficie del lago durante la tarde."
                            }
                        },
                        {
                            "text": "She noticed the <w>shimmering</w> light reflecting off the glass buildings in the city.",
                            "target_lang_translations": {
                                "ru": "Она заметила <w>мерцающий</w> свет, отражающийся от стеклянных зданий в городе.",
                                "es": "Notó la luz <w>centelleante</w> que se reflejaba en los edificios de cristal de la ciudad."
                            }
                        }
                    ],
                    "synonyms": [
                        "glistening",
                        "glimmering",
                        "twinkling",
                        "sparkling",
                        "gleaming"
                    ],
                    "common_phrases": [
                        "shimmering light",
                        "shimmering water",
                        "shimmering heat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола «shimmer» (мерцать, переливаться).",
                        "es": "Participio de presente o adjetivo que describe algo que brilla con una luz suave, trémula o vacilante."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцающий",
                                "target_lang_sense_clarification": "о свете или отражении"
                            },
                            {
                                "target_lang_word": "переливающийся",
                                "target_lang_sense_clarification": "о поверхности воды или ткани"
                            },
                            {
                                "target_lang_word": "блестящий",
                                "target_lang_sense_clarification": "мягким, неровным светом"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brillante",
                                "target_lang_sense_clarification": "que despide o refleja luz"
                            },
                            {
                                "target_lang_word": "reluciente",
                                "target_lang_sense_clarification": "que brilla intensamente o destella"
                            },
                            {
                                "target_lang_word": "centelleante",
                                "target_lang_sense_clarification": "que emite destellos intermitentes o trémulos"
                            },
                            {
                                "target_lang_word": "resplandeciente",
                                "target_lang_sense_clarification": "que resplandece o despide luz"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ad1c876-8b4c-384c-98c2-7de42daa54d5",
                    "sense_definition": "A soft, unsteady gleam or glimmer of light.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "light_phenomenon",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The faint <w>shimmering</w> of the stars was barely visible through the thick clouds.",
                            "target_lang_translations": {
                                "ru": "Слабое <w>мерцание</w> звезд было едва заметно сквозь густые облака.",
                                "es": "El tenue <w>centelleo</w> de las estrellas apenas era visible a través de las densas nubes."
                            }
                        },
                        {
                            "text": "We watched the <w>shimmering</w> of the distant city lights from the mountain top.",
                            "target_lang_translations": {
                                "ru": "С вершины горы мы наблюдали за <w>мерцанием</w> далеких огней города.",
                                "es": "Observamos el <w>brillo</w> de las lejanas luces de la ciudad desde la cima de la montaña."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimmer",
                        "gleam",
                        "sparkle"
                    ],
                    "antonyms": [
                        "darkness"
                    ],
                    "common_phrases": [
                        "faint shimmering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий, неустойчивый отблеск или мерцание света.",
                        "es": "Brillo suave, tenue o trémulo de una luz."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцание",
                                "target_lang_sense_clarification": "процесс или явление слабого света"
                            },
                            {
                                "target_lang_word": "отблеск",
                                "target_lang_sense_clarification": "слабое отражение света"
                            },
                            {
                                "target_lang_word": "переливы",
                                "target_lang_sense_clarification": "игра света на поверхности"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "brillo",
                                "target_lang_sense_clarification": "luz reflejada o emitida de manera tenue"
                            },
                            {
                                "target_lang_word": "centelleo",
                                "target_lang_sense_clarification": "destello suave e intermitente de luz"
                            },
                            {
                                "target_lang_word": "destello",
                                "target_lang_sense_clarification": "resplandor breve o vacilante"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}