                "senses": [
                    {
                        "sense_id": "195e456c-0503-31ec-8b7e-7de967c1cf64",
                        "entry_id": "9c29cd59-b1e2-3040-b54f-29664ecf8644",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e005bfa-1f0c-44e2-9ccd-560b9e83a80c",
                                "sense_id": "195e456c-0503-31ec-8b7e-7de967c1cf64",
                                "text": "Frau Brückle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bcd44152-24bf-42e0-b062-023617524a02",
                                "sense_id": "195e456c-0503-31ec-8b7e-7de967c1cf64",
                                "text": "Herr Brückle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "8365d303-0438-41d6-8bff-8ac7938d7ed1",
                                "sense_id": "195e456c-0503-31ec-8b7e-7de967c1cf64",
                                "text": "Die Brückles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "191845f1-1a58-4084-bde5-bdc1034454d8",
                                "sense_id": "195e456c-0503-31ec-8b7e-7de967c1cf64",
                                "text": "Der Brückle trägt nie die Pullover, die die Brückle ihm strickt."
                            },
                            {
                                "example_id": "e9353151-4c91-4c83-bcd2-61dc89c19c5f",
                                "sense_id": "195e456c-0503-31ec-8b7e-7de967c1cf64",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Brückle kommt, geht der Herr Brückle.“"
                            },
                            {
                                "example_id": "924e8621-765e-4cdb-a572-d1a30a4486b7",
                                "sense_id": "195e456c-0503-31ec-8b7e-7de967c1cf64",
                                "text": "Brückle kommt und geht."
                            },
                            {
                                "example_id": "3541056c-0388-44f2-8915-38df65a625bb",
                                "sense_id": "195e456c-0503-31ec-8b7e-7de967c1cf64",
                                "text": "Brückles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
