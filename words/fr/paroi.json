    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "99d49637-5a8d-35c5-9bda-66088e1ab318",
                    "sense_definition": "Cloison ou surface intérieure verticale délimitant une pièce ou un espace fermé.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "construction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'humidité a laissé de vilaines traces sombres sur la <w>paroi</w> nord de la chambre."
                        },
                        {
                            "text": "Il s'est appuyé contre la <w>paroi</w> pour reprendre son souffle après avoir monté l'escalier."
                        }
                    ],
                    "synonyms": [
                        "cloison",
                        "mur"
                    ],
                    "common_phrases": [
                        "contre la paroi",
                        "paroi de douche"
                    ]
                },
                {
                    "sense_id": "8f6d4124-ef89-3e8b-9cb9-2f3bb6213216",
                    "sense_definition": "Surface qui forme le côté intérieur ou extérieur d'un objet creux, d'un récipient ou d'un conduit.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des gouttelettes d'eau se forment rapidement sur les <w>parois</w> du verre froid."
                        },
                        {
                            "text": "Le liquide épais adhère aux <w>parois</w> du tube pendant toute l'expérience."
                        }
                    ],
                    "synonyms": [
                        "bord",
                        "flanc"
                    ],
                    "common_phrases": [
                        "parois du vase",
                        "parois internes"
                    ]
                },
                {
                    "sense_id": "23d85d15-f3c0-30c3-8057-4f12a21f6696",
                    "sense_definition": "Face rocheuse très abrupte ou verticale d'une montagne, d'une falaise ou d'une gorge.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geographie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les alpinistes ont escaladé une <w>paroi</w> rocheuse particulièrement difficile ce matin."
                        },
                        {
                            "text": "Le guide nous a conseillé d'éviter cette <w>paroi</w> abrupte à cause des chutes de pierres."
                        }
                    ],
                    "synonyms": [
                        "falaise",
                        "escarpement"
                    ],
                    "common_phrases": [
                        "paroi rocheuse",
                        "paroi abrupte",
                        "paroi d'escalade"
                    ]
                },
                {
                    "sense_id": "98e7c6ae-89b3-34f1-a7af-e346bc42c8b6",
                    "sense_definition": "Structure mince ou tissu délimitant un organe creux, une cavité anatomique ou une cellule.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une inflammation aiguë de la <w>paroi</w> intestinale peut provoquer de vives douleurs."
                        },
                        {
                            "text": "Les cellules végétales possèdent une <w>paroi</w> rigide qui protège leur structure interne."
                        }
                    ],
                    "synonyms": [
                        "membrane",
                        "enveloppe"
                    ],
                    "common_phrases": [
                        "paroi cellulaire",
                        "paroi abdominale",
                        "paroi intestinale"
                    ]
                }
            ]
        }
    ]
