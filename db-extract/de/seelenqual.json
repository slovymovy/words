                        "examples": [
                            {
                                "example_id": "28fa2f22-0839-4629-927d-93a7a8ff223e",
                                "sense_id": "3e44d752-60a4-3d30-a38f-489eff2c3917",
                                "text": "„Der Traum der makellosen Haut hat über die Jahrhunderte Seelenqualen erzeugt, vor allem aber auch körperliche Pein.“"
                            },
                            {
                                "example_id": "2b4be5f2-cd58-4b49-824e-50c020845d6e",
                                "sense_id": "3e44d752-60a4-3d30-a38f-489eff2c3917",
                                "text": "„Gesegnet sei Andrejew dafür, daß er sein blendendes Talent zu diesem Werk benutzt hat – es wird ihm nicht geringe Seelenqual bereitet haben.“"
                            }
                        ],
