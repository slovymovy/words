                {
                    "sense_id": "c6d33a70-0039-3173-ab51-542a1e78635a",
                    "sense_definition": "A female given name taken from the name of the month.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "“Hi, <w>January</w>!” Lynn calls. “Happy birthday!”",
                            "target_lang_translations": {
                                "ru": "— Привет, <w>Дженьюари</w>! — крикнула Линн. — С днем рождения!",
                                "nl": "“Hoi, <w>January</w>!” roept Lynn. “Gefeliciteerd met je verjaardag!”",
                                "pl": "– Cześć, <w>January</w>! – woła Lynn. – Wszystkiego najlepszego!",
                                "de": "„Hallo, <w>January</w>!“, ruft Lynn. „Alles Gute zum Geburtstag!“",
                                "fr": "« Salut, <w>January</w> ! » appelle Lynn. « Joyeux anniversaire ! »",
                                "it": "«Ciao, <w>January</w>!» chiama Lynn. «Buon compleanno!»",
                                "cs": "„Ahoj, <w>January</w>!“ volá Lynn. „Všechno nejlepší k narozeninám!“",
                                "tr": "“Merhaba <w>January</w>!” diye seslendi Lynn. “İyi ki doğdun!”",
                                "es": "—¡Hola, <w>January</w>! —llama Lynn—. ¡Feliz cumpleaños!",
                                "zh": "“嗨，<w>詹纽瑞</w>！”琳喊道，“生日快乐！”"
                            }
                        },
                        {
                            "text": "She named her daughter <w>January</w> because she was born in the winter.",
                            "target_lang_translations": {
                                "ru": "Она назвала дочь <w>Дженьюари</w>, потому что та родилась зимой.",
                                "nl": "Ze noemde haar dochter <w>January</w> omdat ze in de winter geboren was.",
                                "pl": "Nazwała swoją córkę <w>January</w>, ponieważ urodziła się zimą.",
                                "de": "Sie nannte ihre Tochter <w>January</w>, weil sie im Winter geboren wurde.",
                                "fr": "Elle a appelé sa fille <w>January</w> parce qu'elle est née en hiver.",
                                "it": "Ha chiamato sua figlia <w>January</w> perché è nata in inverno.",
                                "cs": "Pojmenovala svou dceru <w>January</w>, protože se narodila v zimě.",
                                "tr": "Kızına kışın doğduğu için <w>January</w> adını verdi.",
                                "es": "Llamó a su hija <w>January</w> porque nació en invierno.",
                                "zh": "她给女儿取名叫<w>詹纽瑞</w>，因为她出生在冬天。"
                            }
                        }
