                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1214caa0-044c-43e9-a1f2-9231bbfad174",
                                                "sense_id": "ae429bee-695b-3fdf-b888-e56ed744c1a1",
                                                "text": "Por mí fue traído el Jhesu a la cruz,\npor mí son peleas e todo ruido,\ne todo el mundo por mí es rebolvido,\ntan bien castellano como andaluz."
                                            },
                                            {
                                                "example_id": "1def6ed8-843d-4533-b642-8d9f0a21b12a",
                                                "sense_id": "ae429bee-695b-3fdf-b888-e56ed744c1a1",
                                                "text": "¡Qué cosa es ver en nuestra Salamanca la diferencia de los vizcaínos y andaluces y de los extremeños y castellanos y de los portugueses y toledanos, con ser todos de una nación y reino!"
                                            }
                                        ],
