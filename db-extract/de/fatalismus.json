                    },
                    {
                        "translation_id": "2b456244-b11f-4a12-9535-9660984845c2",
                        "source_entry_id": "2170b7b8-a50c-3c54-9c80-8eb5e1929d14",
                        "source_sense_id": "0615e786-95b0-3c86-b236-d8989c62b2e4",
                        "source_sense_description": "Weltanschauung, die alle Geschehnisse dem Schicksal zuordnet",
                        "target_lang_word": "фатализм",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фатализм",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "151f4fa7-1a44-36b9-9bcf-40440e85b49c",
                                        "entry_id": "22009477-1db6-3765-a8d2-1c9df2549111",
                                        "glosses": [
                                            "книжн., филос. мировоззрение, рассматривающее каждое событие как неотвратимую реализацию изначального предопределения, исключающего свободный выбор и случайность; вера в неотвратимость судьбы, предопределение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a98d04-53f5-4815-9000-6cfd02e2a323",
                                                "sense_id": "151f4fa7-1a44-36b9-9bcf-40440e85b49c",
                                                "text": "Фатализм есть учение или взгляд, не допускающий возможности влияния личных усилий на ход событий."
                                            },
                                            {
                                                "example_id": "449c609a-7871-4020-8ae6-0d901dfd81ab",
                                                "sense_id": "151f4fa7-1a44-36b9-9bcf-40440e85b49c",
                                                "text": "Проблема фатализма переживала момент философской актуализации в период конфликты между романтическим волюнтаризмом и историческим детерминизмом в европейской и русской философии 1830-1840-х гг."
                                            },
                                            {
                                                "example_id": "823fb364-bd87-497f-9ccd-27e3d7f053fc",
                                                "sense_id": "151f4fa7-1a44-36b9-9bcf-40440e85b49c",
                                                "text": "Верить фатализму ― значит не признавать ни греха, ни добродетели, значит сознаваться, что мы бездушные игрушки какой-то неведомой нам силы, что мы цветы на потоке жизни или перекати-поле, носимое по прихоти ветров!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
