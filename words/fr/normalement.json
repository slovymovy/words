                    "semantic_group_id": "conformite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la réparation, la machine fonctionne de nouveau tout à fait <w>normalement</w>.",
                            "target_lang_translations": {
                                "en": "After the repair, the machine is once again working completely <w>normally</w>.",
                                "ru": "После ремонта аппарат снова работает совершенно <w>нормально</w>.",
                                "de": "Nach der Reparatur funktioniert die Maschine wieder völlig <w>normal</w>.",
                                "es": "Tras la reparación, la máquina vuelve a funcionar <w>normalmente</w> por completo.",
                                "zh": "修理之后，机器又完全<w>正常</w>运转了。"
                            }
                        },
                        {
                            "text": "Le médecin a confirmé que le cœur du patient battait <w>normalement</w> sans complication.",
                            "target_lang_translations": {
                                "en": "The doctor confirmed that the patient's heart was beating <w>normally</w> without complications.",
                                "ru": "Врач подтвердил, что сердце пациента билось <w>нормально</w>, без осложнений.",
                                "de": "Der Arzt bestätigte, dass das Herz des Patienten ohne Komplikationen <w>normal</w> schlug.",
                                "es": "El médico confirmó que el corazón del paciente latía <w>normalmente</w> sin complicaciones.",
                                "zh": "医生证实，病人的心脏<w>正常</w>跳动，没有出现并发症。"
                            }
                        }
                    ],
                    "antonyms": [
                        "anormalement"
                    ],
                    "common_phrases": [
                        "fonctionner normalement"
                    ],
                    "target_lang_definitions": {
                        "en": "In a normal, regular or rule-compliant way.",
                        "ru": "Обычным образом, без отклонений от нормы и в соответствии с правилами.",
                        "de": "Auf normale, regelmäßige oder den Regeln entsprechende Weise.",
                        "es": "Indica que algo se hace o funciona de manera normal, regular o conforme a las reglas.",
                        "zh": "以正常、有规律或符合规则的方式进行。"
