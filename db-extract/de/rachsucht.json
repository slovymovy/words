                "senses": [
                    {
                        "sense_id": "b4d286be-81d2-398e-82f5-8ce77547b878",
                        "entry_id": "e55578af-4684-3930-91b5-a5f9792367c9",
                        "glosses": [
                            "heftiges Verlangen nach Rache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c16ef5a-d071-4f1a-ba9f-d2c7ef1e3645",
                                "sense_id": "b4d286be-81d2-398e-82f5-8ce77547b878",
                                "text": "„Die Strafe eines Täters, der mit einer verständlichen Rachsucht gehandelt hat, könnte nach der Rechtsfolgenlösung wohl gemindert werden, jedoch hängt die tatrichterliche, philosophische Einschätzung der Tat bezüglich deren allgemeiner Verständlichkeit damoklesschwertartig über dem Strafmaß.“"
                            },
                            {
                                "example_id": "67d6fada-9664-4433-90eb-8fb9016e8666",
                                "sense_id": "b4d286be-81d2-398e-82f5-8ce77547b878",
                                "text": "„Zweifellos war Steve [J]obs von beispiellosem Ehrgeiz ebenso getrieben wie von Rachsucht, Neid und einer an Größenwahnsinn grenzenden Eitelkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "95902026-3822-4513-826a-8de9eb41cf24",
                        "source_entry_id": "e55578af-4684-3930-91b5-a5f9792367c9",
                        "source_sense_id": "b4d286be-81d2-398e-82f5-8ce77547b878",
                        "source_sense_description": "heftiges Verlangen nach Rache",
                        "target_lang_word": "vindictiveness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vindictiveness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a1087ed-62a0-3673-8d09-4231b5e370d3",
                                        "entry_id": "534b800c-3cec-3159-9219-e79caab91b26",
                                        "glosses": [
                                            "The condition of being vindictive; a malevolent desire for revenge."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "962658de-06f3-4b20-a493-bf34e76e2249",
                                                "sense_id": "5a1087ed-62a0-3673-8d09-4231b5e370d3",
                                                "text": "Lord Avonleigh was an angry rather than a vindictive man. Vindictiveness requires more energy of character than he possessed. Indeed, it may be questioned whether he would of himself have taken the violent measures of the preceding evening."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2ba3c4a-3c9b-45cd-802a-b9e07d5a3d9c",
                        "source_entry_id": "e55578af-4684-3930-91b5-a5f9792367c9",
                        "source_sense_id": "b4d286be-81d2-398e-82f5-8ce77547b878",
                        "source_sense_description": "heftiges Verlangen nach Rache",
                        "target_lang_word": "vengefulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vengefulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                                        "entry_id": "e6d36d6f-bbbe-3fb7-a656-3783d9a33323",
                                        "glosses": [
                                            "The state or quality of being vengeful"
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "552ac0e5-d378-459c-ab4f-74885585490a",
                                                "sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                                                "text": "The vengefulness of the king was legendary."
                                            },
                                            {
                                                "example_id": "3a170bce-862d-4a5b-914a-5696e5171a1a",
                                                "sense_id": "0db16c64-9299-3257-bd69-5139af94ae46",
                                                "text": "To this day his reason has never recovered from that shock; a wild nightmare of vengefulness has possessed him ever since, and he has almost bankrupted his native ingenuities in inventing pains and miseries and humiliations and heartbreaks wherewith to embitter the brief lives of Adam's descendants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
