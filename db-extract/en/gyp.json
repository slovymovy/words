            {
                "entry_id": "18e5e9b9-cbe9-376a-8c37-715b1476bcf2",
                "word": "gyp",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3041f694-615b-4cc5-a378-a2fe8a3aa925",
                        "entry_id": "18e5e9b9-cbe9-376a-8c37-715b1476bcf2",
                        "tags": [
                            "plural"
                        ],
                        "form": "gyps"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7c35038a-8253-30c4-a686-ebafd8c5df19",
                        "entry_id": "18e5e9b9-cbe9-376a-8c37-715b1476bcf2",
                        "glosses": [
                            "A domestic servant, generally male, who would attend upon (usually several) students, brushing their clothes, carrying parcels, waiting at parties and other tasks; generally equivalent to a scout in the historical sense at Oxford University or a skip at Trinity College, Dublin."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "ac826c0a-959d-43b7-83f3-1f7b604b7381",
                                "sense_id": "7c35038a-8253-30c4-a686-ebafd8c5df19",
                                "text": "All was neglect. The outer door of this room, which was open, was nearly on a level with the Quadrangle — some coats and trousers and boots were upon the ebony table and a \"gyp\" was brushing away at them just within the door — in wet weather he performed these functions entirely within the library, as innocent of the incongruity of his position as my guide himself."
                            },
                            {
                                "example_id": "632e9dd4-0eaa-4b87-839d-79470e5d6994",
                                "sense_id": "7c35038a-8253-30c4-a686-ebafd8c5df19",
                                "text": "'Why, what is the matter with you, John?' I asked of the gyp who waited on Vincey and myself."
                            },
                            {
                                "example_id": "801347c2-ced2-4532-b6a7-f5cccde3287e",
                                "sense_id": "7c35038a-8253-30c4-a686-ebafd8c5df19",
                                "text": "Had he acted discourteously to his bedmaker or his gyp, he would have minded just as much … ."
                            }
                        ]
                    },
                    {
                        "sense_id": "a76e3d7d-7309-3087-a7fb-34e5c936387e",
                        "entry_id": "18e5e9b9-cbe9-376a-8c37-715b1476bcf2",
                        "glosses": [
                            "The room in which such college servants work."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "00e63ec2-58be-324a-be8f-f03b2e3c0525",
                        "entry_id": "18e5e9b9-cbe9-376a-8c37-715b1476bcf2",
                        "glosses": [
                            "A small kitchen for use by college students."
                        ],
                        "tags": [],
                        "examples": []
                    }
