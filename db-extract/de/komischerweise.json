        "fr-extract.jsonl": [
            {
                "entry_id": "7e50857b-c643-3c6c-8048-1ad25ee1aefd",
                "word": "komischerweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d5d8f780-830f-3d87-be5f-5496dfb75d6e",
                        "entry_id": "7e50857b-c643-3c6c-8048-1ad25ee1aefd",
                        "glosses": [
                            "Curieusement, bizarrement. → voir seltsamerweise et merkwürdigerweise"
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "34f9a1fe-18f0-43c0-b109-88357173c845",
                                "sense_id": "d5d8f780-830f-3d87-be5f-5496dfb75d6e",
                                "text": "Das war ein sehr gutes Essen, das komischerweise gar nicht teuer war. - C’était un très bon repas qui curieusement n’était vraiment pas cher."
                            },
                            {
                                "example_id": "85aa73cd-e785-4365-8d6b-15b34184a69c",
                                "sense_id": "d5d8f780-830f-3d87-be5f-5496dfb75d6e",
                                "text": "Komischerweise trafen wir uns nie wieder. - Curieusement, nous ne nous sommes jamais revus."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
        "it-extract.jsonl": [],
        "de-extract.jsonl": [
            {
                "entry_id": "892429ff-a5a7-3493-85c9-e3383fa57a15",
                "word": "komischerweise",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "39f1b323-80b9-3094-99d5-c98d4be5e221",
                        "entry_id": "892429ff-a5a7-3493-85c9-e3383fa57a15",
                        "glosses": [
                            "auf eine Art und Weise, die komisch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06a13454-2884-4680-a5f1-60626a955cd2",
                                "sense_id": "39f1b323-80b9-3094-99d5-c98d4be5e221",
                                "text": "„Der lacht Sie aus, und zwar laut. Ob sich das alles lohnt, ist eine berechtigte Frage, doch komischerweise taucht sie immer nur bei Sanierungsmaßnahmen auf, nie woanders. Etwa bei Autos.“"
                            },
                            {
                                "example_id": "ddcc336e-a9e4-49e0-ad74-5323c5aed069",
                                "sense_id": "39f1b323-80b9-3094-99d5-c98d4be5e221",
                                "text": "„Meistens seine Form. Der Großmaulfrosch erzählt von seinen phänomenalen Bestzeiten: zehn Kilometer klar unter 40 Minuten, Marathon in weniger als drei Stunden - komischerweise bei Rennen, deren Ergebnisse nicht im Netz zu finden sind.“"
                            },
                            {
                                "example_id": "5650ff88-0bac-4fcb-9469-88609c547563",
                                "sense_id": "39f1b323-80b9-3094-99d5-c98d4be5e221",
                                "text": "„Nach dem sehr guten Essen, für das wir komischerweise sehr viel mehr Zeit brauchten als sonst für das Essen, fragte uns die Kellnerin noch, ob wir ein Dessert wünschten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1673582f-1565-4358-8571-33c8466edd9f",
                        "source_entry_id": "892429ff-a5a7-3493-85c9-e3383fa57a15",
                        "source_sense_id": "39f1b323-80b9-3094-99d5-c98d4be5e221",
                        "source_sense_description": "auf eine Art und Weise, die komisch ist",
                        "target_lang_word": "bizarrely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bizarrely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                        "entry_id": "fe91e4fe-e306-3bd1-8674-442c3e2d9486",
                                        "glosses": [
                                            "In a bizarre manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e272a523-4bd2-4cf1-8619-540875f4e09e",
                                                "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                                "text": "And, placed discreetly among these commonplaces, a few pieces of genuine quality, bizarrely distinguished by craftsmanship from the vulgar products of the machine."
                                            },
                                            {
                                                "example_id": "9e614c58-225f-4d12-af2d-979dd7cdda78",
                                                "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                                "text": "The forms can be bizarrely funny when blown up to fill a canvas, as in \"Supergastrico Compensado\" (the artist prefers that his often punning titles remain untranslated), whose eroticized digestive systems have an appealing decorative flair."
                                            },
                                            {
                                                "example_id": "e6cb6d3b-cf38-4651-8987-aa7e606d37c9",
                                                "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                                "text": "The White House said Wednesday that President Obama had dismissed a government agency’s internal watchdog because he was incompetent and had behaved bizarrely, disputing accusations that he was fired because he had uncovered embarrassing problems in the AmeriCorps program."
                                            },
                                            {
                                                "example_id": "732c90be-be21-4d18-9f66-06eb1ed074c0",
                                                "sense_id": "e8426e6a-7184-3bd6-97ed-5e3ef8bb8bff",
                                                "text": "[...] his 'crime' was discovered, was summoned to see the headmaster, Sir Arthur fforde. It could potentially have been a flogging offence, but the headmaster, bizarrely, offered him a glass of nonalcoholic sherry. It no doubt helped that fforde, like [...]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05c4c81f-7cf6-432b-a383-074695fd72e8",
                        "source_entry_id": "892429ff-a5a7-3493-85c9-e3383fa57a15",
