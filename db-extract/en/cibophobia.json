                        "glosses": [
                            "The fear of, or aversion to, eating or food."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5933b993-9d7b-4666-91dc-a7ea4eab3c5e",
                                "sense_id": "e7473f3e-7192-30bd-9e5d-a975a75f3995",
                                "text": "The pain pattern is so intimately related to the ingestion of food that the patient will reduce the size of meals, become reluctant to eat, and even develop frank cibophobia."
                            },
                            {
                                "example_id": "5c1d0aa7-e85d-4fc8-9a69-0ace54c66dfd",
                                "sense_id": "e7473f3e-7192-30bd-9e5d-a975a75f3995",
                                "text": "Cibophobia differs from anorexia since appetite may persist but the pearson fears eating because of some associated or subsequent discomfort."
                            },
                            {
                                "example_id": "685b6504-cc51-44e4-8e38-b8fc50fefdc3",
                                "sense_id": "e7473f3e-7192-30bd-9e5d-a975a75f3995",
                                "text": "This condition arises from cheese-related trauma (I'll leave it up to you to imagine what this might entail) and it's often considered a subcategory of cibophobia."
                            }
                        ]
                    }
