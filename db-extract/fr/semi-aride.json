                "senses": [
                    {
                        "sense_id": "bea9c6d5-d43f-3daf-9a11-e6bffdb40c1f",
                        "entry_id": "bfb83b8e-72f5-35b5-9e65-cb7052c57219",
                        "glosses": [
                            "Qualifie un climat ou un milieu présentant une aridité modérée, intermédiaire entre aride et subhumide, caractérisé par de faibles précipitations annuelles, souvent concentrées sur une courte période, et une forte évapotranspiration limitant la végétation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f933b0f1-b75f-41c5-a70a-fd8495c896c2",
                                "sense_id": "bea9c6d5-d43f-3daf-9a11-e6bffdb40c1f",
                                "text": "Le climat semi-aride régne dans la zone subdésertique, caractérisée par une saison sèche s’étendant sur la plus grande partie de l’année et une saison « humide », avec de faibles précipitations."
                            },
                            {
                                "example_id": "61ebbf02-c9ef-402d-9866-de69b08817a3",
                                "sense_id": "bea9c6d5-d43f-3daf-9a11-e6bffdb40c1f",
                                "text": "On s’achemine vers un climat semi-aride."
                            }
                        ]
                    }
                ],
