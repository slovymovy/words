                        "glosses": [
                            "Light or fitful sleep; a nap that is easily interrupted."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "22b9a735-f1bb-4b8f-b28a-62e68958cf3d",
                                "sense_id": "4de10639-f918-38af-a4a7-57b4fb702271",
                                "text": "This was Gabriel Varden's state as, nodding in his dog sleep, and leaving his horse to pursue a road with which he was well acquainted, he got over the ground unconsciously, and drew nearer and nearer home."
                            },
                            {
                                "example_id": "0d9407a8-a172-40f0-a31a-83f261e83d48",
                                "sense_id": "4de10639-f918-38af-a4a7-57b4fb702271",
                                "text": "[M]any of the convicts made up for their lack of rest by snatching a dog-sleep in the bared bunks."
                            }
                        ]
                    },
                    {
                        "sense_id": "db777ce2-08bd-3275-84d7-4835ff42598a",
                        "entry_id": "61ee74ce-c60b-387d-af1f-d4d042631bc8",
                        "glosses": [
                            "Feigned sleep."
                        ],
                        "tags": [
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "12ed0e02-cf1e-4772-a4e7-e4ed2d83f0a0",
                                "sense_id": "db777ce2-08bd-3275-84d7-4835ff42598a",
                                "text": "Juvenal, indeed, mentions a drowsy husband, who raised an estate by snoring, but then he is represented to have slept what the common people call dog's sleep"
                            }
                        ]
                    }
