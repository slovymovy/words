                {
                    "sense_id": "4e593e29-b6ef-39a0-8c53-7725ee7f97d4",
                    "sense_definition": "een speciaal, feestelijk uiterlijk of versiering van een object of plaats",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "uiterlijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de kerstperiode krijgt de hele binnenstad een schitterend <w>feestgewaad</w> van lichtjes.",
                            "target_lang_translations": {
                                "en": "During the Christmas period, the entire city center is adorned in a brilliant <w>festive garb</w> of lights."
                            }
                        },
                        {
                            "text": "Onder meer de piramides in Egypte, de Parijse Eiffeltoren en de Chinese Muur kregen een <w>feestgewaad</w> in de kleur van de VN.",
                            "target_lang_translations": {
                                "en": "Among others, the pyramids in Egypt, the Parisian Eiffel Tower, and the Great Wall of China received a <w>festive array</w> in the color of the UN."
                            }
                        }
                    ],
                    "synonyms": [
                        "feesttooi"
                    ],
                    "common_phrases": [
                        "een feestgewaad krijgen"
                    ],
