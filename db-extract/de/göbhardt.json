                ],
                "senses": [
                    {
                        "sense_id": "c032b10e-f647-3cde-9fa0-9a0f475e5cba",
                        "entry_id": "af0b3556-244c-36f8-ab45-40ac5d94d575",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664f3508-1a84-40e1-af82-3160a200062f",
                                "sense_id": "c032b10e-f647-3cde-9fa0-9a0f475e5cba",
                                "text": "Frau Göbhardt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ad33b28e-f217-40ed-98d2-502ed0adee70",
                                "sense_id": "c032b10e-f647-3cde-9fa0-9a0f475e5cba",
                                "text": "Herr Göbhardt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9ffee225-2703-429b-930b-819ec3b1f702",
                                "sense_id": "c032b10e-f647-3cde-9fa0-9a0f475e5cba",
                                "text": "Die Göbhardts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "1795ec07-e884-484a-aa8e-1931d3730ab9",
                                "sense_id": "c032b10e-f647-3cde-9fa0-9a0f475e5cba",
                                "text": "Der Göbhardt trägt nie die Schals, die die Göbhardt ihm strickt."
                            },
                            {
                                "example_id": "6b88493a-245c-47d6-b629-99679268b120",
                                "sense_id": "c032b10e-f647-3cde-9fa0-9a0f475e5cba",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Göbhardt kommt, geht der Herr Göbhardt.“"
                            },
                            {
                                "example_id": "2f3d4d48-4b12-4532-9ce3-b00fea0f755a",
                                "sense_id": "c032b10e-f647-3cde-9fa0-9a0f475e5cba",
                                "text": "Göbhardt kommt und geht."
                            },
                            {
                                "example_id": "e307e825-c800-447b-8a92-3bb4fc57b857",
                                "sense_id": "c032b10e-f647-3cde-9fa0-9a0f475e5cba",
                                "text": "Göbhardts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
