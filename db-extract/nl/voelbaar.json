                        "examples": [
                            {
                                "example_id": "26e56a48-456b-4f77-9270-cedb6dac961c",
                                "sense_id": "eaad8fc1-e596-3ead-bb13-981e4619b9f8",
                                "text": "Na verloop van tijd waren er steeds meer voelbare effecten van de bezuinigingen."
                            },
                            {
                                "example_id": "2f116561-7f10-47fc-aa21-e2f4d487d3dc",
                                "sense_id": "eaad8fc1-e596-3ead-bb13-981e4619b9f8",
                                "text": "Helaas was de herfst hier ook voelbaar: dagenlang liep ik door de stromende regen, iets wat ik vier maanden niet had meegemaakt in Californië en Oregon."
                            }
                        ]
                    }
