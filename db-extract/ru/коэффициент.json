                "senses": [
                    {
                        "sense_id": "f4970d4b-f232-33e3-9a4e-df4addb0326a",
                        "entry_id": "44e8a6c6-b44a-3cd4-917d-09c8ce071c93",
                        "glosses": [
                            "показатель, фактор, параметр, представляющий отношение двух однородно исчисленных величин"
                        ],
                        "tags": [],
