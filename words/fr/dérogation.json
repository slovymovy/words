{
    "word_family": [
        "déroger",
        "dérogatoire"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "368d5763-6a3a-3943-b730-473f2f5cc9b3",
                    "sense_definition": "Autorisation exceptionnelle accordée de ne pas respecter une règle ou une obligation légale habituelle.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dispense",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants peuvent demander une <w>dérogation</w> pour s'inscrire après la date limite officielle."
                        },
                        {
                            "text": "Le préfet a accordé une <w>dérogation</w> spéciale pour ouvrir les commerces ce dimanche."
                        }
                    ],
                    "synonyms": [
                        "dispense",
                        "exemption"
                    ],
                    "common_phrases": [
                        "demander une dérogation",
                        "obtenir une dérogation",
                        "par dérogation"
                    ]
                },
                {
                    "sense_id": "59e3933c-de59-3c4b-b145-94ffa04a1411",
                    "sense_definition": "Action de s'écarter d'une règle, d'un usage, d'un droit ou d'un principe établi.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "transgression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette mesure constitue une <w>dérogation</w> flagrante aux principes fondamentaux de notre institution."
                        },
                        {
                            "text": "Le règlement intérieur doit être appliqué sans la moindre <w>dérogation</w> possible."
                        }
                    ],
                    "synonyms": [
                        "entorse",
                        "infraction"
                    ],
                    "antonyms": [
                        "conformité",
                        "respect"
                    ],
                    "common_phrases": [
                        "dérogation aux usages",
                        "sans dérogation"
                    ]
                },
                {
                    "sense_id": "73c8792c-78ba-3671-ab6e-0039af29a230",
                    "sense_definition": "Modification ou annulation partielle d'une loi ou d'une disposition légale par un texte ultérieur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "modification_legale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le nouvel article voté par l'assemblée introduit une <w>dérogation</w> explicite à la loi précédente."
                        },
                        {
                            "text": "Cette clause contractuelle emporte une <w>dérogation</w> formelle aux traités internationaux en vigueur."
                        }
                    ],
                    "synonyms": [
                        "abrogation"
                    ],
                    "common_phrases": [
                        "dérogation à la loi"
                    ]
                }
            ]
        }
    ]
}