                        "entry_id": "a7aac54e-e5af-3c7e-900b-4034ed74a79a",
                        "glosses": [
                            "Animal à coquille."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0fada1-ef28-4450-9345-92df63765996",
                                "sense_id": "506dc933-e43a-378a-b8d7-b613703b01af",
                                "text": "Les huîtres, les moules, les escargots sont des testacés."
                            },
                            {
                                "example_id": "25a1bf3e-0234-4fba-9d5e-21bd3b152fc3",
                                "sense_id": "506dc933-e43a-378a-b8d7-b613703b01af",
                                "text": "Mes yeux avides y cherchaient des merveilles. […] Ils eussent voulu voir ces nombreux habitants dont la plupart sont encore inconnus et le seront toujours ; ces poissons de toute espèce, ces testacés sans nombre qui ne s’élèvent jamais au niveau des mers."
                            },
                            {
                                "example_id": "2945cf19-fb33-47b4-a928-d8c0a39d3391",
                                "sense_id": "506dc933-e43a-378a-b8d7-b613703b01af",
                                "text": "Et, téméraires que vous êtes, vous venez nous parler des femmes, absolument comme vous pourriez parler, si la faim vous avait faits naturalistes, de testacés, de mammifères, d’ovipares ou de fossiles !"
                            }
                        ]
                    }
