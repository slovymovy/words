                "senses": [
                    {
                        "sense_id": "4ca0d715-da29-348e-a8ca-f3bce594f03b",
                        "entry_id": "7bfc7287-3a1e-352b-bc42-7fb090d19ebb",
                        "glosses": [
                            "brine; pickle"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18892f95-9ab0-4356-bd81-bea859e46b40",
                                "sense_id": "4ca0d715-da29-348e-a8ca-f3bce594f03b",
                                "text": "Похме́лье лу́чше всего́ лечи́ть огуре́чным и́ли капу́стным рассо́лом",
                                "translation": "Pickled cucumber brine or sauerkraut brine are the best cures for a hangover.",
                                "english": "Pickled cucumber brine or sauerkraut brine are the best cures for a hangover."
                            },
                            {
                                "example_id": "8dbaea46-be1b-42be-a0f4-9b945e3ccc14",
                                "sense_id": "4ca0d715-da29-348e-a8ca-f3bce594f03b",
                                "text": "Федька стоит с подносом. Рожа его, как всегда с утра, помята и нелепа. На подносе традиционное для похмельного утра: стакан белого квасу, рюмка водки, полстакана капустного рассола.",
                                "translation": "Fedka is holding a tray. His face is creased and lopsided as it is every morning. He’s carrying a traditional hangover assortment: a glass of white kvass, a jigger of vodka, a half-cup of marinated cabbage juice.",
                                "english": "Fedka is holding a tray. His face is creased and lopsided as it is every morning. He’s carrying a traditional hangover assortment: a glass of white kvass, a jigger of vodka, a half-cup of marinated cabbage juice."
                            }
                        ]
                    }
