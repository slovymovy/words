                ],
                "senses": [
                    {
                        "sense_id": "a08d1ce1-a516-3768-a3b3-c52f8f170514",
                        "entry_id": "4e2f7626-6790-3389-99f6-c0cf22699df5",
                        "glosses": [
                            "Celle qui affecte l’élégance dans sa toilette et dans ses manières."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7f9cfae-33a4-4ad1-a330-b44174b57db1",
                                "sense_id": "a08d1ce1-a516-3768-a3b3-c52f8f170514",
                                "text": "À cette époque, le Jardin Turc fut le rendez-vous des élégants et élégantes du Marais, du faubourg Saint-Antoine et lieux circonvoisins."
                            },
                            {
                                "example_id": "64e98f71-68fa-4e7d-a4a5-fb47ff24cb74",
                                "sense_id": "a08d1ce1-a516-3768-a3b3-c52f8f170514",
                                "text": "Dans la Rome du Iᵉʳ siècle , les élégantes de la société aisée étaient très friandes des objets exotiques de luxe, et tout particulièrement des étoffes de soie, dont l’origine unique était le lieu appelé par les Romains pays de Sèvres, c’est-à-dire la Chine."
                            }
                        ]
                    },
                    {
                        "sense_id": "f7274732-64c8-351d-97d6-37c40dd65b80",
                        "entry_id": "4e2f7626-6790-3389-99f6-c0cf22699df5",
                        "glosses": [
                            "Autre nom donné au cyclostome élégant (Pomatias elegans)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2847a027-7dfc-49f4-8fe9-c57304c9c938",
                                "sense_id": "f7274732-64c8-351d-97d6-37c40dd65b80",
                                "text": "Le cyclostome élégant est appelé également élégante striée (Pomatia elegans)."
                            }
                        ]
                    }
