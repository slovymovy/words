                        "glosses": [
                            "сверхъестественное существо (в арабской и мусульманской культуре)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cbfab27-c9c0-4e85-98cd-5436ab0cb4a3",
                                "sense_id": "4c0520a2-0df1-34b1-918b-3b4b2e939087",
                                "text": "Отношение ифрита к детям можно было кратко охарактеризовать одним словом - педофобия."
                            }
                        ]
                    }
                ],
                "translations": [
