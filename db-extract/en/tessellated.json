                        "examples": [
                            {
                                "example_id": "ccfca17d-2d0d-445d-b6d9-9cf1ffd0df7a",
                                "sense_id": "36acc0d7-7bb3-369d-bd1a-5ee9c4c6ff5d",
                                "text": "The bat and the owl made it their home, the spider wove its dreary tapestry, the grass made its way through the tessellated floors, the moss grew over the untrodden pavement, and the ivy—the fragile and creeping ivy—was now the chief support of the battlements which it had overrun."
                            },
                            {
                                "example_id": "6248779b-1399-4eed-b985-eea90c671596",
                                "sense_id": "36acc0d7-7bb3-369d-bd1a-5ee9c4c6ff5d",
                                "text": "The floor of the chamber was tesselated, of marble and green tourmaline, and on every square of tourmaline was carven the image of a fish: […]"
                            }
                        ]
                    }
