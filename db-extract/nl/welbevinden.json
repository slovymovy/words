        "nl-extract.jsonl": [
            {
                "entry_id": "d9729f91-4e52-324d-b079-666c9894c291",
                "word": "welbevinden",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b5362915-59cf-38bd-9a3d-9f2c1345e583",
                        "entry_id": "d9729f91-4e52-324d-b079-666c9894c291",
                        "glosses": [
                            "een staat van goede lichamelijke en geestelijke gezondheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8b9a723-8de2-4aab-97d4-5b030e1cb679",
                                "sense_id": "b5362915-59cf-38bd-9a3d-9f2c1345e583",
                                "text": "De vorsers stelden vast dat degene die meer rust verlangt, minder goed scoort in het persoonlijk welbevinden. Een ’blikseminslag’ in hun leven – een doorgemaakte ernstige ziekte, een andere schokkende ervaring – doet mensen veranderen: 53 procent wil het liefst in de natuur zijn, 52,1 procent hunkert naar alleen zijn, ruim 40 procent herstelt van een ’trauma’ door naar muziek te luisteren of juist door niets te doen."
                            },
                            {
                                "example_id": "cdca6773-00ec-436b-a97d-967567e4f22c",
                                "sense_id": "b5362915-59cf-38bd-9a3d-9f2c1345e583",
                                "text": "Onderzoek van de Universiteit Twente wees uit dat de Geluksroute in Almelo leidde tot minder medicijngebruik en artsenbezoek bij een kwart van de deelnemers. Daarnaast ervoeren zeven op de tien deelnemers meer plezier in hun leven en nam het welbevinden bij alle deelnemers met 40 procent toe."
                            }
                        ]
                    },
                    {
                        "sense_id": "f14606f9-320d-32c2-97f2-5eca70a0408e",
                        "entry_id": "d9729f91-4e52-324d-b079-666c9894c291",
                        "glosses": [
                            "goedkeuring; impliciete of stilzwijgende toestemming"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "95a85420-630f-482a-ba06-53d43a878c81",
                                "sense_id": "f14606f9-320d-32c2-97f2-5eca70a0408e",
                                "text": "Ik ga daar, met uw welbevinden, nog even dieper op in."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "518db74a-5b1a-4679-bcfb-63dd324f597d",
                        "source_entry_id": "d9729f91-4e52-324d-b079-666c9894c291",
