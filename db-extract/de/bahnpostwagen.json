                ],
                "senses": [
                    {
                        "sense_id": "1d701342-3d31-3578-b846-ca64ab825888",
                        "entry_id": "fd72c0f4-3aff-37be-b0a2-b225aa993a07",
                        "glosses": [
                            "Wagen der Eisenbahn für die Bahnpost"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4f6aaac1-2d51-4dac-861b-138d15a72d79",
                                "sense_id": "1d701342-3d31-3578-b846-ca64ab825888",
                                "text": "„Für den Dienst als »Bahnposten« wurden Mitarbeiter speziell geschult, um nicht nur einen reibungslosen Ablauf beim Be- und Entladen der Bahnpostwagen zu gewährleisten, sondern auch auf alle Eventualitäten gefasst zu sein.“"
                            },
                            {
                                "example_id": "b0cb288d-d77d-4079-8513-3ee7fc375811",
                                "sense_id": "1d701342-3d31-3578-b846-ca64ab825888",
                                "text": "„Daneben mussten aber auch der am Bahnpostwagen angebrachte Briefkasten geleert und die ihm entnommenen Briefe und Karten mit dem Bahnpoststempel bedruckt werden.“"
                            },
                            {
                                "example_id": "ee04519d-4f41-4511-b812-3ead7cfb62ee",
                                "sense_id": "1d701342-3d31-3578-b846-ca64ab825888",
                                "text": "„So wurden in vielen Ländern spezielle Bahnpostwagen gebaut, in denen Postbeamte die Verarbeitung der Postsendungen verrichteten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
