                ],
                "senses": [
                    {
                        "sense_id": "7cbad4fe-d4d1-37eb-9a03-9d3618c524f6",
                        "entry_id": "a944f1a0-9fd9-3096-9d8c-4c83eb008adb",
                        "glosses": [
                            "mengsel van koolwaterstoffen met een hoog kookpunt tussen de 200 ᵒC en 350 ᵒC (gemiddelde ketenlengte van 8 - 21 C atomen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16a55b0e-7bf6-45a4-bf9e-da0a4594fdb0",
                                "sense_id": "7cbad4fe-d4d1-37eb-9a03-9d3618c524f6",
                                "text": "In de bunkersector wordt gasolie en stookolie geproduceerd, verwerkt, verhandeld, opgeslagen en vervoerd. Hier gaan grote bedragen in om. In de betreffende havens zijn tientallen bedrijven actief als producent, in de opslag of als leverancier. Rotterdam is de op twee na grootste bunkerhaven ter wereld."
                            },
                            {
                                "example_id": "85a4e8c4-0542-4f9d-b9a7-85f015d16d13",
                                "sense_id": "7cbad4fe-d4d1-37eb-9a03-9d3618c524f6",
                                "text": "De Ternsund arriveert het komende weekend al bij Vopak Botlek in Rotterdam om nafta over te slaan. Daarna vaart ze naar de Willem Alexanderterminal. Daar zal de bunkering, ofwel het tanken, plaatsvinden. Dat duurt ongeveer drie dagen, onder andere omdat de Ternsund nu nog op gasolie vaart."
                            }
                        ]
                    }
