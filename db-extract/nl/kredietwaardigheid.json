                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "The quality or state of being able; capacity to do or of doing something; having the necessary power."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96d87197-55cb-4d6a-94b9-63098eb06a89",
                                                "sense_id": "24e82e24-e3a7-3b5e-bd35-97012fdf804b",
                                                "text": "This phone has the ability to have its software upgraded wirelessly."
                                            },
                                            {
                                                "example_id": "21929b69-5d1b-47c0-a5ba-81afa954078c",
                                                "sense_id": "24e82e24-e3a7-3b5e-bd35-97012fdf804b",
                                                "text": "This wood has the ability to fight off insects, fungus, and mold for a considerable time."
                                            },
                                            {
                                                "example_id": "8e2e4aee-ec4c-402f-bce4-5cd4576218ff",
                                                "sense_id": "24e82e24-e3a7-3b5e-bd35-97012fdf804b",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0e75d3-bbd7-3c5f-9115-d78cd41b1efc",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "The legal wherewithal to act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cac8025e-50bd-4815-b9b4-48c901b28379",
                                                "sense_id": "ff0e75d3-bbd7-3c5f-9115-d78cd41b1efc",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them, which is then licensed to related businesses in high-tax countries, is often assumed to be the preserve of high-tech companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d242e59d-7324-3369-819f-1e55468343e3",
                                        "entry_id": "8acf1eaa-83c5-3f4d-8b7a-cd8f04183d1d",
                                        "glosses": [
                                            "Physical power."
                                        ],
                                        "tags": [
                                            "countable",
