                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6c1f6d9-63b6-4f33-a739-c6d0708a137b",
                                                "sense_id": "6027bfee-fa83-35ee-9d91-1bf2b1e393be",
                                                "text": "Kiedy człowiek postępuje z absolutną bezinteresownością — jak to robi pan Owsiak — pojawiają się natychmiast zastępy podejrzliwych, którzy oskarżają go o wszelkiego rodzaju potworności."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
