                ],
                "senses": [
                    {
                        "sense_id": "e255ab5d-fd52-35ed-aad3-213bb289f865",
                        "entry_id": "f199a72a-18bd-38cf-a26e-3e29665d7a60",
                        "glosses": [
                            "Relatif à l’argent ; qui consiste en argent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799529cb-c3fa-4885-8883-080d74f3b668",
                                "sense_id": "e255ab5d-fd52-35ed-aad3-213bb289f865",
                                "text": "Il est des cas où la satisfaction pécuniaire est demandée par la nature même du délit : il est d'autres cas où c'est la seule que les circonstances permettent."
                            },
                            {
                                "example_id": "1afbd973-54c3-43f5-8fd6-2e71b0281a94",
                                "sense_id": "e255ab5d-fd52-35ed-aad3-213bb289f865",
                                "text": "Ce pauvre homme, sans moyens pécuniaires, premier clerc depuis dix ans, atteignait alors à l’âge de quarante ans et se voyait clerc pour le reste de ses jours."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e0c826d-e7e9-47ae-bba6-bd230c20f482",
                        "source_entry_id": "f199a72a-18bd-38cf-a26e-3e29665d7a60",
                        "source_sense_id": "e255ab5d-fd52-35ed-aad3-213bb289f865",
                        "target_lang_word": "pekuniär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pekuniär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                        "entry_id": "ca440d2c-b8b7-3f96-b011-6f13edcbee5c",
                                        "glosses": [
                                            "auf Geld bezogen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c0d331b-1fb6-4273-a74e-76d60dd19b8e",
                                                "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                                "text": "Er lebt in guten/schlechten pekuniären Verhältnissen."
                                            },
                                            {
                                                "example_id": "0db6f64a-3239-44e8-bd1f-178a2e8980df",
                                                "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                                "text": "Seine pekuniäre Lage ist gut."
                                            },
                                            {
                                                "example_id": "8df13cb7-8e0d-4321-b871-09dbf6facce2",
                                                "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                                "text": "„Was die beiden Jungunternehmer zu körperlicher Eigeninitiative zwang, denn eine professionelle Beseitigung der verkeimten Hinterlassenschaft hätte zu solch immensen zusätzlichen pekuniären Belastungen geführt, dass sich ihr Finanzierungsplan über Nacht in ein Horoskop verwandelt hätte.“"
                                            },
                                            {
                                                "example_id": "d3a484db-3c87-4b7f-8132-4a4464b9171a",
                                                "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                                "text": "„So kam es, daß Grete Erber sich bald nach der Hochzeit regelmäßig bei Recha einfand, um mit ihrer Hilfe der pekuniären Nöte Herr zu werden, die sie peinigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b1b42eb1-4f69-40ac-9f68-a2dd05b81e97",
                        "source_entry_id": "f199a72a-18bd-38cf-a26e-3e29665d7a60",
                        "source_sense_id": "e255ab5d-fd52-35ed-aad3-213bb289f865",
                        "target_lang_word": "pecuniary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pecuniary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00a4565e-2d27-3bb1-b41c-cb24f6caf764",
                                        "entry_id": "3efd1202-509f-34b8-a8c9-de3dd2d5ad4f",
                                        "glosses": [
                                            "Of, or relating to, money; monetary, financial."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eee333f-c4c2-4a85-872f-fb58faaf4a94",
                                                "sense_id": "00a4565e-2d27-3bb1-b41c-cb24f6caf764",
                                                "text": "Perhaps the reader will suppose after this that the doctor had some pecuniary interest of his own in arranging the squire's loans; or, at any rate, he will think that the squire must have thought so."
                                            },
                                            {
                                                "example_id": "932da834-6cae-400d-ae72-112ce292d7b7",
                                                "sense_id": "00a4565e-2d27-3bb1-b41c-cb24f6caf764",
                                                "text": "The views of philosophers, with few exceptions, have coincided with the pecuniary interests of their class."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
