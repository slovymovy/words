                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to shave off the thick <w>growth</w> of beard on his chin.",
                            "target_lang_translations": {
                                "ru": "Он решил сбрить густую <w>растительность</w> на подбородке.",
                                "pl": "Postanowił zgolić gęsty <w>zarost</w> na brodzie.",
                                "zh": "他决定刮掉下巴上浓密的<w>胡须</w>。"
                            }
                        },
                        {
                            "text": "The old stone wall was hidden under a dense <w>growth</w> of ivy.",
                            "target_lang_translations": {
                                "ru": "Старая каменная стена была скрыта под густой <w>порослью</w> плюща.",
                                "pl": "Stary kamienny mur był ukryty pod gęstą <w>warstwą</w> bluszczu.",
                                "zh": "古老的石墙隐藏在茂密的<w>常春藤</w>下。"
                            }
