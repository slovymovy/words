                "senses": [
                    {
                        "sense_id": "f9c77d17-d212-3025-878f-1493aa0771ef",
                        "entry_id": "3de9acc8-2928-3fe5-9403-e9f46c7d258b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "713f6796-aedd-4684-ae3a-1255d7ab8be5",
                                "sense_id": "f9c77d17-d212-3025-878f-1493aa0771ef",
                                "text": "Frau Becherle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "86999d6a-d59d-45b0-b2dd-ef2b2e0b8ede",
                                "sense_id": "f9c77d17-d212-3025-878f-1493aa0771ef",
                                "text": "Herr Becherle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c0ddcc5e-23da-423b-901d-2e53688859c2",
                                "sense_id": "f9c77d17-d212-3025-878f-1493aa0771ef",
                                "text": "Die Becherles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7100c63a-9b1a-46d9-838c-49f19f3540d8",
                                "sense_id": "f9c77d17-d212-3025-878f-1493aa0771ef",
                                "text": "Der Becherle trägt nie die Schals, die die Becherle ihm strickt."
                            },
                            {
                                "example_id": "c43dbb33-20c8-4c13-b84b-646c944d1c9c",
                                "sense_id": "f9c77d17-d212-3025-878f-1493aa0771ef",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Becherle kommt, geht der Herr Becherle.“"
                            },
                            {
                                "example_id": "f63711e8-5d46-4cc6-9efc-5b849293a6b2",
                                "sense_id": "f9c77d17-d212-3025-878f-1493aa0771ef",
                                "text": "Becherle kommt und geht."
                            },
                            {
                                "example_id": "b3f0fb7e-6398-4b3e-bf90-dfa11cd9be11",
                                "sense_id": "f9c77d17-d212-3025-878f-1493aa0771ef",
                                "text": "Becherles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
