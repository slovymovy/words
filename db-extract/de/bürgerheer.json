                "senses": [
                    {
                        "sense_id": "e4f63401-d0a8-3507-a374-7d7274384afe",
                        "entry_id": "a43ab78a-ec53-33cd-864f-f6528701d8d4",
                        "glosses": [
                            "Streitkraft, die erst im Bedarfsfall aufgestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d243c2fc-2bbe-46f8-b73b-13e9f9153713",
                                "sense_id": "e4f63401-d0a8-3507-a374-7d7274384afe",
                                "text": "„Sicher bestand der Hauptgrund für diese Veränderung in der Umorganisation vom Söldnerheer über das stehende Heer zum Bürgerheer.“"
                            },
                            {
                                "example_id": "4736632d-def7-4321-8167-c8f2dbb95e96",
                                "sense_id": "e4f63401-d0a8-3507-a374-7d7274384afe",
                                "text": "„Wo diese Überlegenheit nicht gegeben ist, fliehen sie als erste, während ein Bürgerheer den Tod einer Rettung durch Flucht vorzieht.“"
                            },
                            {
                                "example_id": "20b4d8eb-66cf-4a4c-a897-a76b9b3833a6",
                                "sense_id": "e4f63401-d0a8-3507-a374-7d7274384afe",
                                "text": "„Die Ratsherren gaben den Befehl zum Abmarsch, und das Bürgerheer von Barcelona setzte sich in Bewegung.“"
                            },
                            {
                                "example_id": "0b624090-b527-4623-a796-bd3eebad0e1e",
                                "sense_id": "e4f63401-d0a8-3507-a374-7d7274384afe",
                                "text": "„Es sollte ferner die Landwehr, die als Bürgerheer 1849 revoltiert hatte, zugunsten der Linie vermindert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
