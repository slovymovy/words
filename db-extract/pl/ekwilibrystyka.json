                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6cbfdf5-8fe8-4e26-a7dc-6c5912167ec7",
                                "sense_id": "62542c3f-4157-39f2-9cc3-b93bd17ee093",
                                "text": "Cała ekwilibrystyka tego wykładu stanie nam w oczach dopiero, gdy skonstatujemy, że…"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
