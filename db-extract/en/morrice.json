                        "glosses": [
                            "A morris dance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "059eb78a-4b31-464e-88df-ad7e316c45be",
                                "sense_id": "f2419ed2-40d2-3d7a-90ac-e0eb9fedad38",
                                "text": "The sounds and seas, with all their finny drove,\nNow to the moon in wavering morrice move;\nAnd on the tawny sands and shelves\nTrip the pert fairies and the dapper elves."
                            },
                            {
                                "example_id": "c26dad39-6680-4667-b5e8-1f355b45bd8b",
                                "sense_id": "f2419ed2-40d2-3d7a-90ac-e0eb9fedad38",
                                "text": "Across the page the symbols moved in grave morrice, in the mummery of their letters, wearing quaint caps of squares and cubes."
                            }
                        ]
                    }
                ],
