                        "glosses": [
                            "een sportwedstrijd die deel is van competitie (een reeks wedstrijden die samen ook weer één wedstrijd vormen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa9fa25d-3a2f-4443-9631-c4386b3df577",
                                "sense_id": "7acccd0c-4b9b-3aee-ae7f-cae8924d7968",
                                "text": "Het spelen van een competitiewedstrijd zonder politie is de gemeente Tilburg en Willem II zo goed bevallen dat ze dat zaterdag nog eens doen. Tegen Excelsior zullen alleen stewards in het stadion van de Brabantse voetbalclub zijn. Dat is de uitkomst van overleg van burgemeester Peter Noordanus met Willem II en supportersgroepen van de club."
                            },
                            {
                                "example_id": "00078ccc-6a5a-410f-8172-1eba3de60995",
                                "sense_id": "7acccd0c-4b9b-3aee-ae7f-cae8924d7968",
                                "text": "Drienerlo heeft het restant van de competitiewedstrijd tegen Kloosterhaar niet weten om te zetten in een overwinning."
                            }
                        ]
                    }
