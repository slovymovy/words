                "senses": [
                    {
                        "sense_id": "cdfeee73-d8b5-31e2-a7ba-5ef3bbfdab3b",
                        "entry_id": "7facd01c-6823-3d7f-abf0-36b0e398cedc",
                        "glosses": [
                            "zwykle okrągła, murowana budowla stanowiąca element średniowiecznego budownictwa obronnego, wysunięta przed linię murów i połączona z bramą miejską"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "813949f0-433d-4d8f-8669-6b2452fec43a",
                                "sense_id": "cdfeee73-d8b5-31e2-a7ba-5ef3bbfdab3b",
                                "text": "Rozwinięciem barbakanów były stosowane od XVI wieku raweliny."
                            },
                            {
                                "example_id": "04baacb8-d938-4d4e-a2b9-8972de8b448b",
                                "sense_id": "cdfeee73-d8b5-31e2-a7ba-5ef3bbfdab3b",
                                "text": "Rekonstrukcję warszawskiego barbakanu wykonano na podstawie rycin."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "319b5cd8-518c-4334-956d-f729b15fb987",
                        "source_entry_id": "7facd01c-6823-3d7f-abf0-36b0e398cedc",
                        "source_sense_id": "cdfeee73-d8b5-31e2-a7ba-5ef3bbfdab3b",
                        "target_lang_word": "barbican",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "barbican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1116c8b4-dbfb-3ecf-ae7d-0d97a5cf416b",
                                        "entry_id": "0f7542f5-5bae-32e6-972b-3bba80d4d8da",
                                        "glosses": [
                                            "A tower at the entrance to a castle or fortified town."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "543ead85-f064-4aee-b899-8ed13354ee94",
                                                "sense_id": "1116c8b4-dbfb-3ecf-ae7d-0d97a5cf416b",
                                                "text": "The stone part of the drawbridge with its barbican and the bartizans of the gatehouse are in good repair. […] There was a large hidden trapdoor in the floor of the barbican, which would let them into the moat after all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11f601fa-1660-3f08-bd3f-fe20398c5bfb",
                                        "entry_id": "0f7542f5-5bae-32e6-972b-3bba80d4d8da",
                                        "glosses": [
                                            "A fortress at the end of a bridge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ffb4cac-c9fe-3b4b-9a50-5dcf20a328ec",
                                        "entry_id": "0f7542f5-5bae-32e6-972b-3bba80d4d8da",
                                        "glosses": [
                                            "An opening in the wall of a fortress through which the guns are levelled; a narrow loophole through which arrows and other missiles may be shot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d47e1a13-e04f-49b1-a22c-2276efdc3963",
                                                "sense_id": "1ffb4cac-c9fe-3b4b-9a50-5dcf20a328ec",
                                                "text": "Two shafts of soft daylight fell across the flagged floor from the high barbacans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2fd7317-c1b2-3ba3-bdaf-67918a85d1ec",
                                        "entry_id": "0f7542f5-5bae-32e6-972b-3bba80d4d8da",
                                        "glosses": [
                                            "A temporary wooden tower built for defensive purposes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e6dfa9c-69b4-4495-8266-1bf0b70fb52e",
                        "source_entry_id": "7facd01c-6823-3d7f-abf0-36b0e398cedc",
                        "source_sense_id": "cdfeee73-d8b5-31e2-a7ba-5ef3bbfdab3b",
