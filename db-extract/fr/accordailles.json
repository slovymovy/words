                "senses": [
                    {
                        "sense_id": "36a557ba-a1a3-3e58-a8ab-c1afc9683d1b",
                        "entry_id": "aaee8ea1-cd57-36a4-a5fe-096887a3769b",
                        "glosses": [
                            "Verlobung"
                        ],
                        "tags": [],
                        "examples": [],
