                "senses": [
                    {
                        "sense_id": "d6560234-674e-32e2-82cd-547581d9f062",
                        "entry_id": "6b46f8c8-5591-33b4-8dc2-7f6177296359",
                        "glosses": [
                            "getrocknete Weinbeere der Rebsorte Korinthiaki, der sogenannten Korinther Traube"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1f78927-7e8a-4e01-8d48-b13bcbc0816b",
                                "sense_id": "d6560234-674e-32e2-82cd-547581d9f062",
                                "text": "Korinthen haben keine Kerne, sind schwarz und sehr klein."
                            },
                            {
                                "example_id": "591a9971-0146-4e61-93a2-cbc7d479fee1",
                                "sense_id": "d6560234-674e-32e2-82cd-547581d9f062",
                                "text": "„Seine Handelsgüter waren Baumwolle, Leinwand, Rosinen, die man Korinthen nennt, Öle und ausgezeichnete Weine.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
