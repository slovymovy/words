                    "frequency": "High",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>client</w> attend son tour à la caisse pour payer ses achats."
                        },
                        {
                            "text": "Ce magasin offre une réduction spéciale pour chaque nouveau <w>client</w>."
                        }
                    ],
                    "synonyms": [
