{
    "word_family": [
        "captive",
        "captivity",
        "captivation",
        "captivator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4b1fc600-f3df-3101-a219-6fffb7bc6084",
                    "sense_definition": "To attract and hold someone's attention and interest; to charm or fascinate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "attract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker <w>captivated</w> the audience with her incredible stories of travel.",
                            "target_lang_translations": {
                                "zh": "演讲者用她不可思议的旅行故事<w>迷住</w>了听众。"
                            }
                        },
                        {
                            "text": "Her beautiful smile <w>captivates</w> everyone she meets.",
                            "target_lang_translations": {
                                "zh": "她美丽的笑容<w>迷住</w>了她遇到的每一个人。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enchant",
                        "enamour"
                    ],
                    "common_phrases": [
                        "captivate the audience",
                        "captivate the imagination"
                    ],
                    "target_lang_definitions": {
                        "zh": "吸引并保持某人的注意力或兴趣；使着迷或入迷。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "迷住",
                                "target_lang_sense_clarification": "指因魅力或吸引力而使人入迷。"
                            },
                            {
                                "target_lang_word": "吸引",
                                "target_lang_sense_clarification": "指引起兴趣或关注。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "868c4e52-ee31-3f21-91d3-c0ddfaeded69",
                    "sense_definition": "To take someone or something as a prisoner; to capture.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy forces sought to <w>captivate</w> the soldiers during the night raid.",
                            "target_lang_translations": {
                                "zh": "敌军试图在夜袭中<w>俘虏</w>这些士兵。"
                            }
                        },
                        {
                            "text": "The hunters tried to <w>captivate</w> the wild animal without causing it any harm.",
                            "target_lang_translations": {
                                "zh": "猎人们试图在不伤害野生动物的情况下将其<w>捕获</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "将某人或某物作为囚犯扣押；俘虏。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "俘虏",
                                "target_lang_sense_clarification": "指在战争中抓获敌人。"
                            },
                            {
                                "target_lang_word": "捕获",
                                "target_lang_sense_clarification": "指抓获动物或人。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0851005a-8142-36e5-acb3-2904be38e8ec",
                    "sense_definition": "To control or dominate the mind or judgment of someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to let his own biases <w>captivate</w> his judgment during the trial.",
                            "target_lang_translations": {
                                "zh": "他拒绝让自己的偏见在审判中<w>左右</w>他的判断。"
                            }
                        },
                        {
                            "text": "The ideology <w>captivated</w> the minds of the youth for many years.",
                            "target_lang_translations": {
                                "zh": "这种意识形态多年来一直<w>控制</w>着年轻人的思想。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely archaic in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "控制或支配某人的思想或判断。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "控制",
                                "target_lang_sense_clarification": "指对思想或判断施加支配力。"
                            },
                            {
                                "target_lang_word": "左右",
                                "target_lang_sense_clarification": "指影响或支配人的判断。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2f506760-4c9c-34bb-b9e0-203822fa0eac",
                    "sense_definition": "Being a <w>captive</w>; taken prisoner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>captivate</w> soldiers were finally released after the peace treaty was signed.",
                            "target_lang_translations": {
                                "zh": "和平条约签署后，那些<w>被俘的</w>士兵终于被释放了。"
                            }
                        },
                        {
                            "text": "Many <w>captivate</w> people were held in the fortress during the long war.",
                            "target_lang_translations": {
                                "zh": "在漫长的战争期间，许多<w>被俘的</w>人被关押在堡垒中。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "处于被囚禁状态；被俘虏的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "被俘的",
                                "target_lang_sense_clarification": "指在战争中被抓获的。"
                            },
                            {
                                "target_lang_word": "囚禁的",
                                "target_lang_sense_clarification": "指失去自由被关押的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}