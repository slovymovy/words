                "senses": [
                    {
                        "sense_id": "0f00c34a-9892-308e-a40e-af7863f8ecf2",
                        "entry_id": "531737f1-5425-3acb-8746-cfe5a5a233c6",
                        "glosses": [
                            "A divinity of Vedic culture, hypostasis of friendship and one-half of the dvandva (compound divinity) Varuna-Mitra."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c26b7c9-d676-4968-92da-08255c189eda",
                                "sense_id": "0f00c34a-9892-308e-a40e-af7863f8ecf2",
                                "text": "[In post-Vedic India], Vedic Mitra practically disappears and Varuna is relegated to a subsidiary position"
                            }
                        ]
                    },
                    {
                        "sense_id": "8151dc5b-cc57-3627-a4b4-25c4ed6d8ecf",
                        "entry_id": "531737f1-5425-3acb-8746-cfe5a5a233c6",
                        "glosses": [
                            "A deity invoked in the Hurrian Mitanni of ca. 1400 BC."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "8b9b98fa-db82-482c-ae65-06a3835b7faa",
                                "sense_id": "8151dc5b-cc57-3627-a4b4-25c4ed6d8ecf",
                                "text": "when about 1350 B.C. a treaty was concluded between the king of Mittanni [...] and the Hittite ruler [...], the former calls upon the gods Mitra, Indra, Varuna, and the Nâsatya as guarantors of his sworn obligations."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d1b3827-f2e0-3d33-8521-df85f8357f16",
                        "entry_id": "531737f1-5425-3acb-8746-cfe5a5a233c6",
                        "glosses": [
                            "Alternative form of Mithra (“Iranian deity”)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "19f33cf8-246b-47a0-adc2-acfea7adb828",
                                "sense_id": "6d1b3827-f2e0-3d33-8521-df85f8357f16",
                                "text": "As the Avestan Mitra had a luminous character, so had the Vedic Mitra."
                            },
                            {
                                "example_id": "5fbe2464-f69a-4799-8f64-140a43f33fcb",
                                "sense_id": "6d1b3827-f2e0-3d33-8521-df85f8357f16",
                                "text": "We cannot account for Roman Mithras in terms borrowed from Persian Mitra."
                            }
                        ]
                    }
