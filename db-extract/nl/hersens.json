                                "sense_id": "620eb3cd-0ef2-38b4-9c97-d248a6c38052",
                                "text": "Ik hou wel van een vrouw met een beetje hersens."
                            }
                        ]
                    },
                    {
                        "sense_id": "49137405-490c-37c5-a05b-ca982c8bba90",
                        "entry_id": "2b0c90be-c6c6-3295-801c-4881eea239a0",
                        "glosses": [
                            "lichaamsdeel waar het brein in zit"
                        ],
                        "tags": [
                            "metonymisch"
                        ],
                        "examples": [
                            {
                                "example_id": "5ef8bc09-14a0-477c-8a0c-1301e199177f",
                                "sense_id": "49137405-490c-37c5-a05b-ca982c8bba90",
                                "text": "Wanneer het angstige dier in een hoek is gedreven, slaat een man met een stok zijn hersens in."
                            }
                        ]
                    }
