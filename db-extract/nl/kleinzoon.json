                                "target_senses": [
                                    {
                                        "sense_id": "52e1090a-6ca8-322f-b5eb-031f3c93c2f0",
                                        "entry_id": "b9a9f1bf-dcee-3420-a886-a02f6d58b594",
                                        "glosses": [
                                            "A son of one's child."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7285c6e-50ea-49ae-87cb-be5c84f35965",
                                                "sense_id": "52e1090a-6ca8-322f-b5eb-031f3c93c2f0",
                                                "text": "Three days after his young grandsons died in a fire police said was set by their father, Chuck Cox on Wednesday still was coming to grips with what happened."
                                            },
                                            {
                                                "example_id": "0bab1b1a-dcf2-4164-85ae-898df9c5a4a5",
                                                "sense_id": "52e1090a-6ca8-322f-b5eb-031f3c93c2f0",
                                                "text": "She’s now a great-grandmother with three sons, a grandson and two great-grandchildren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f690816-9a2b-4daf-8fb3-514e993e29e0",
                        "source_entry_id": "d49827ad-64df-3766-abfc-44c541962131",
                        "source_sense_id": "e0fd6df8-0311-3cf9-835d-ef6a0a9b5ebb",
                        "source_sense_description": "een zoon van iemands kind, een mannelijk kleinkind",
                        "target_lang_word": "Enkel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Enkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5cedd217-4f52-3cc3-9b53-fff3f0036f1f",
                                        "entry_id": "f78e0521-7aa9-3d14-bf30-42ab307fcb50",
                                        "glosses": [
                                            "(männliches) Kind des eigenen Sohnes oder der eigenen Tochter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c083ca95-63fb-449e-91be-8ecd0b44f46c",
                                                "sense_id": "5cedd217-4f52-3cc3-9b53-fff3f0036f1f",
                                                "text": "Mein Enkel geht noch zur Schule."
                                            },
                                            {
                                                "example_id": "3e574fff-3bc6-482a-82f9-e33d6ab860ae",
                                                "sense_id": "5cedd217-4f52-3cc3-9b53-fff3f0036f1f",
                                                "text": "„In einer der ältesten hauste die alte Maruschka mit Kindern und Enkeln, ein verhutzeltes, zitteriges Weiblein.“"
                                            },
                                            {
                                                "example_id": "8619b4c6-8167-4bf7-99e7-a61ee5a62055",
                                                "sense_id": "5cedd217-4f52-3cc3-9b53-fff3f0036f1f",
                                                "text": "„Manchmal ging er mit seinem Enkel spazieren.“"
                                            },
                                            {
                                                "example_id": "f8462dcf-6336-4e89-a209-17dc778be1a5",
                                                "sense_id": "5cedd217-4f52-3cc3-9b53-fff3f0036f1f",
                                                "text": "„Plötzlich kommt wie aus dem Nichts eine riesige Welle heran und überspült genau die Stelle, an der ihr Enkel spielt.“"
                                            },
                                            {
                                                "example_id": "660e3db5-96d1-42b1-82ff-e5c255ca3ef4",
                                                "sense_id": "5cedd217-4f52-3cc3-9b53-fff3f0036f1f",
                                                "text": "„Der Großvater geht mit seinem Enkel an einem Sommertag über eine Wiese.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "691dc96c-cdfb-3cdb-a767-b71e453cee0e",
                                        "entry_id": "f78e0521-7aa9-3d14-bf30-42ab307fcb50",
                                        "glosses": [
                                            "männlicher Nachfahre der zweiten Generation, der von einer anderen Person abstammt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50bf6808-f22f-473e-a634-836940743e0d",
                                                "sense_id": "691dc96c-cdfb-3cdb-a767-b71e453cee0e",
                                                "text": "In die Kinder investiert man, und die Enkel sind die Rendite."
                                            },
                                            {
                                                "example_id": "8ed12c2e-0aa4-4d94-ae34-90c2a0f667e3",
                                                "sense_id": "691dc96c-cdfb-3cdb-a767-b71e453cee0e",
                                                "text": "„Die Verachtung, die Friedrich der Große unserer Literatur angedeihen ließ, muß sogar uns Enkel noch verdrießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Enkel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f00504de-0c7a-3aa4-9738-9ede52c55ac6",
                                        "entry_id": "81f02195-5df1-3c5a-9c41-08799902b6ea",
                                        "glosses": [
                                            "der am Fußansatz befindliche vorspringende Knochen"
                                        ],
                                        "tags": [
                                            "landschaftlich,",
                                            "besonders ostoberdeutsch",
                                            "westmitteldeutsch",
                                            "norddeutsch sowie Südafrika (KwaZulu-Natal)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9c2976f-ea96-49a2-9c84-ea5270b5b34c",
                                                "sense_id": "f00504de-0c7a-3aa4-9738-9ede52c55ac6",
                                                "text": "„Er hat sich den Enkel verstaucht.“"
                                            },
                                            {
                                                "example_id": "7c61740d-a403-4e25-8409-54c7bf3d6710",
                                                "sense_id": "f00504de-0c7a-3aa4-9738-9ede52c55ac6",
                                                "text": "„Der rechte Fuß knickte um und ich hatte den Enkel gebrochen. Aus, vorbei! Wieder ein paar Wochen Spital.“"
                                            },
                                            {
                                                "example_id": "c7645568-ac63-4bb9-ac11-88efcd6bbc60",
                                                "sense_id": "f00504de-0c7a-3aa4-9738-9ede52c55ac6",
                                                "text": "„Beim Schorren verknackst’ ich mir den Enkel und immer, wenn ich Schlittschuh laufen lernte, kam Tauwetter, und die Tannen auf der Schloßteichbahn standen schräg übergekippt, wie lebensmüde Romanheldinnen, im Wasser, in dem die Bänke schwammen.“"
                                            },
                                            {
                                                "example_id": "b2c59384-dd3e-42cc-b3d7-33c391218160",
                                                "sense_id": "f00504de-0c7a-3aa4-9738-9ede52c55ac6",
                                                "text": "„Das Mädchen war ganz in das Zelt hereingekommen und betrachtete den schwarzen Mann, der so ruhig schlief mit geschwollenen Handgelenken und blutigen Enkeln in den eisernen Fesseln, und sein dichtes Haar und der mächtige Bart waren verfilzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "77ef0f97-bbd5-3fc9-bab8-518bb03512f3",
                                        "entry_id": "81f02195-5df1-3c5a-9c41-08799902b6ea",
                                        "glosses": [
                                            "das den Fuß mit dem Unterschenkel verbindende Gelenk"
                                        ],
                                        "tags": [
                                            "Südafrika (KwaZulu-Natal)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c4dcace2-c4e0-4542-a92e-985027d1645e",
                                                "sense_id": "77ef0f97-bbd5-3fc9-bab8-518bb03512f3",
                                                "text": "„Er hat sich den Enkel verstaucht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "421bfaf7-f1a2-4f63-bafc-1616549ca178",
                        "source_entry_id": "d49827ad-64df-3766-abfc-44c541962131",
                        "source_sense_id": "e0fd6df8-0311-3cf9-835d-ef6a0a9b5ebb",
