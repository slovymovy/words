                        "cross_references": [
                            {
                                "target_word": "Arbeitsverhältnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bed4f26d-6f50-378a-bbfe-48757fc51440",
                                        "entry_id": "b10823c1-af42-3e3f-9148-89f0de30f01f",
                                        "glosses": [
                                            "rechtliche Beziehung zwischen Arbeitgeber und Arbeitnehmer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ff12df9-e806-4972-8e33-188f7ceaf7d4",
                                                "sense_id": "bed4f26d-6f50-378a-bbfe-48757fc51440",
                                                "text": "„Nicht zuletzt wegen solcher fragwürdiger Behauptungen engagierten sich viele Frauen aus den städtischen Mittel- und Oberschichten lieber gemeinnützig und ohne Lohn als in regulären Arbeitsverhältnissen.“"
                                            },
                                            {
                                                "example_id": "7ac0f1a4-3ed2-46e9-bef1-5cfba2a39ee4",
                                                "sense_id": "bed4f26d-6f50-378a-bbfe-48757fc51440",
                                                "text": "„Bei jeder Beendigung des Arbeitsverhältnisses, unabhängig vom Kündigungsgrund, wird [in Italien] eine Abfindung gezahlt.“"
                                            },
                                            {
                                                "example_id": "a139bd60-da44-4b7f-b230-850d5a8527e3",
                                                "sense_id": "bed4f26d-6f50-378a-bbfe-48757fc51440",
                                                "text": "„Laut diesem Gesetz [Mutterschutzgesetz] müssen [werdende] Mütter, die in einem Arbeitsverhältnis stehen, sechs Wochen vor der Geburt zu Hause bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f6078a1-519d-38a3-9561-8dcfd13eeb75",
                                        "entry_id": "b10823c1-af42-3e3f-9148-89f0de30f01f",
                                        "glosses": [
                                            "Gesamtheit der Umstände, unter denen die Arbeit geleistet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e87c16c-0d18-4668-804d-995db449b2e6",
                                                "sense_id": "6f6078a1-519d-38a3-9561-8dcfd13eeb75",
                                                "text": "„Heine schildert demgegenüber die bedrückende Realität der unmenschlichen Arbeitsverhältnisse unter Tage, die alles andere als eine »freudige Erhebung« oder himmlische Erleuchtung bedeuten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
