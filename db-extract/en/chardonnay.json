                        "entry_id": "355ad4d1-92e0-3cec-823c-e71c986678b6",
                        "glosses": [
                            "A variety of wine made from this grape."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1cf9d2e7-d936-4f98-8c13-0639c59a730d",
                        "source_entry_id": "355ad4d1-92e0-3cec-823c-e71c986678b6",
                        "source_sense_description": "grape",
                        "target_lang_word": "chardonnay",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chardonnay",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "90b1870a-9b58-38ec-aa27-f15a3662cb7e",
                                        "entry_id": "7375e169-6151-36d3-a3b1-90098a292ed4",
                                        "glosses": [
                                            "Cépage originaire de Bourgogne, donnant du raisin blanc."
                                        ],
                                        "tags": [
                                            "Viticulture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13889894-3458-4afb-a8ae-e437cf2a9535",
                                                "sense_id": "90b1870a-9b58-38ec-aa27-f15a3662cb7e",
                                                "text": "Elle parle du métier de vigneron et de son petit vignoble situé en grande partie sur Villenauxe, planté de chardonnay, de pinot noir sur le terroir de Bethon et de pinot meunier sur Dormans."
                                            },
                                            {
                                                "example_id": "f97976fa-fa04-48d5-a04b-de15d04d0984",
                                                "sense_id": "90b1870a-9b58-38ec-aa27-f15a3662cb7e",
                                                "text": "D’où l’idée des viticulteurs du Beaujolais de reconvertir leur cépage phare, le gamay, pour faire du crémant de Bourgogne, de changer le beaujolais blanc en bourgogne blanc, tous deux étant produits avec du chardonnay, et de replanter leurs vignes avec du pinot noir pour récolter des bourgognes rouges."
                                            },
                                            {
                                                "example_id": "575d1229-72dc-43aa-a433-1297c28b7f41",
                                                "sense_id": "90b1870a-9b58-38ec-aa27-f15a3662cb7e",
                                                "text": "Comme cela a été observé chez le cabernet sauvignon et le cabernet franc (Wolf et al, 1991), la vitesse de la perte de la tolérance au froid des bourgeons varie selon la nature du cépage : le pinot noir se désendurcit plus rapidement que le chardonnay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f374d9b-29c9-3ce9-ab3b-56f11f7b6ef8",
                                        "entry_id": "7375e169-6151-36d3-a3b1-90098a292ed4",
                                        "glosses": [
                                            "Vin produit à partir de ce cépage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9146607-a4cd-4b71-ad23-81465b5a960f",
                                                "sense_id": "8f374d9b-29c9-3ce9-ab3b-56f11f7b6ef8",
                                                "text": "Il écrasa un bâillement et ouvrit son frigo pour y découvrir une bouteille de chardonnay déjà bien entamée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
