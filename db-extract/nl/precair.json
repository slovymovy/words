                    {
                        "translation_id": "bfa7a6bd-a945-49ce-8b04-1abe89e48653",
                        "source_entry_id": "946b96ec-10c2-30b0-8249-d6f12ab31f68",
                        "target_lang_word": "uncertain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "uncertain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34402d70-aa80-3705-8b6b-7df533885474",
                                        "entry_id": "c7d3eed9-341a-3dfb-9d84-e605b829c973",
                                        "glosses": [
                                            "Not certain; unsure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c53fc0e-ec65-41fa-8bc5-9268350a38b3",
                                                "sense_id": "34402d70-aa80-3705-8b6b-7df533885474",
                                                "text": "Conſider man without the protection and conduct of a ſuperior Being, and he is ſecure of nothing that he enjoys in this world, and uncertain of every thing that he hopes for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95ed60a-3a1f-3b89-9335-4b27ac00a21d",
                                        "entry_id": "c7d3eed9-341a-3dfb-9d84-e605b829c973",
                                        "glosses": [
                                            "Not known for certain; questionable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd93db85-92b6-48b7-be7b-0f60768595bf",
                                                "sense_id": "c95ed60a-3a1f-3b89-9335-4b27ac00a21d",
                                                "text": "Tomorrow's weather is uncertain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56709425-0970-36e0-819c-1f046e9b4c7e",
                                        "entry_id": "c7d3eed9-341a-3dfb-9d84-e605b829c973",
                                        "glosses": [
                                            "Not yet determined; undecided."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "981b8e6f-64fb-31fb-8a7b-149afee25da6",
                                        "entry_id": "c7d3eed9-341a-3dfb-9d84-e605b829c973",
                                        "glosses": [
                                            "Variable and subject to change."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "12800fa6-96eb-3aa2-ae9c-d1d8217ee8b5",
                                        "entry_id": "c7d3eed9-341a-3dfb-9d84-e605b829c973",
                                        "glosses": [
                                            "Fitful or unsteady."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7380afb-8a8e-4b9f-93df-b8f23265bdac",
                                                "sense_id": "12800fa6-96eb-3aa2-ae9c-d1d8217ee8b5",
                                                "text": "Turning back, then, toward the basement staircase, she began to grope her way through blinding darkness, but had taken only a few uncertain steps when, of a sudden, she stopped short and for a little stood like a stricken thing, quite motionless save that she quaked to her very marrow in the grasp of a great and enervating fear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31c48e4d-c2b6-3593-8ea7-1db0a07741d8",
                                        "entry_id": "c7d3eed9-341a-3dfb-9d84-e605b829c973",
                                        "glosses": [
                                            "Unpredictable or capricious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "841d7e3d-47b0-4424-8d91-bd6e7eae1d39",
                                                "sense_id": "31c48e4d-c2b6-3593-8ea7-1db0a07741d8",
                                                "text": "O, woman! in our hours of ease, / Uncertain, coy, and hard to please, / And variable as the shade / By the light quivering aspen made; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "uncertain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5971628a-3dec-35a5-9867-f139ee417eac",
                                        "entry_id": "5df731f8-827b-3a79-b260-39774e27134a",
                                        "glosses": [
                                            "Something uncertain."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only",
                                            "with-definite-article"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12980bfb-d76f-4d3b-b267-a60a3c6e7826",
                                                "sense_id": "5971628a-3dec-35a5-9867-f139ee417eac",
                                                "text": "Thinking about the uncertain refines our perception of the certain, and generally this takes place in a framework in which the uncertain is the future and the certain is the present."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0659a75f-00c4-4ffc-8da6-9dbb2f77fccd",
                        "source_entry_id": "946b96ec-10c2-30b0-8249-d6f12ab31f68",
                        "target_lang_word": "précaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "précaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5550c4de-b750-34e9-bb84-eb23b48e6871",
                                        "entry_id": "e5ce16d8-2e01-3193-a5e6-668ad6467cb1",
                                        "glosses": [
                                            "Qui ne s’exerce que par une tolérance qui peut cesser, par une permission révocable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3538436-83fd-4d9a-a3f5-c88e28672f53",
                                                "sense_id": "5550c4de-b750-34e9-bb84-eb23b48e6871",
                                                "text": "Autorité précaire. — Pouvoir précaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "487b78ac-7e5c-37a8-bf31-3657c9bd9d7b",
                                        "entry_id": "e5ce16d8-2e01-3193-a5e6-668ad6467cb1",
                                        "glosses": [
                                            "Qui est instable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d8ec65-5103-44f2-a99f-e724477c8ed1",
                                                "sense_id": "487b78ac-7e5c-37a8-bf31-3657c9bd9d7b",
                                                "text": "Trois mètres de long, deux de large, le lit qui occupe la moitié de l’espace, un radiateur électrique en équilibre précaire contre le mur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf8f49f0-7fc9-32ee-b329-221c40098253",
                                        "entry_id": "e5ce16d8-2e01-3193-a5e6-668ad6467cb1",
                                        "glosses": [
                                            "Qui est incertain, éphémère."
                                        ],
                                        "tags": [
                                            "analogy",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fed04935-0cc4-4153-aa28-b596d9dfc2aa",
                                                "sense_id": "bf8f49f0-7fc9-32ee-b329-221c40098253",
                                                "text": "Ainsi, depuis son entrée au Bonheur des Dames, elle était surtout blessée par le sort précaire des commis."
                                            },
                                            {
                                                "example_id": "a1359f7f-e05f-4521-953d-66b8eeb5e492",
                                                "sense_id": "bf8f49f0-7fc9-32ee-b329-221c40098253",
                                                "text": "Il est à peine besoin de faire remarquer que, vu la quantité de taxes et redevances auxquelles on les assujettissait […], les juifs se trouvaient dans une situation matérielle précaire."
                                            },
                                            {
                                                "example_id": "d5ab8a4e-4c9b-4d83-b6a0-f41b80fe9caf",
                                                "sense_id": "bf8f49f0-7fc9-32ee-b329-221c40098253",
                                                "text": "Dire que le français au Québec n’est pas en position précaire serait une absurdité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "précaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6dba585-03b9-3f59-91d5-24d2fdb97e8f",
                                        "entry_id": "424b752c-f527-3c58-9ed3-0962d26616a9",
                                        "glosses": [
                                            "Ce dont on ne jouit, dont on n’a l’usage que par une concession toujours révocable au gré de celui qui l’a faite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18961ae2-d1c6-480d-8bd4-9eb80615b183",
                                                "sense_id": "b6dba585-03b9-3f59-91d5-24d2fdb97e8f",
                                                "text": "Il ne jouit de cette terre que par précaire, qu’à titre de précaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "981197cb-a701-30c8-a5fc-8ba4d0e18634",
                                        "entry_id": "424b752c-f527-3c58-9ed3-0962d26616a9",
                                        "glosses": [
                                            "Personne ayant un statut social précaire (absence de revenus, irrégularité des revenus, précarité de l’emploi, sans domicile fixe, etc.)."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f63311a-c39e-4647-9505-b8d78c3a6dad",
                                                "sense_id": "981197cb-a701-30c8-a5fc-8ba4d0e18634",
                                                "text": "Je suis étudiant, chômeur ou précaire et souhaite m’abonner pour un an et règle la somme de 21 euros."
                                            },
                                            {
                                                "example_id": "2d308871-660d-4582-97ed-f008c58ea438",
                                                "sense_id": "981197cb-a701-30c8-a5fc-8ba4d0e18634",
                                                "text": "Les sans-travail et les précaires ne sont pas que les protagonistes auxquels l’actualité ne cesse de nous ramener."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
