            {
                "entry_id": "c35e1d51-03ba-3e8e-8fb5-57990c9efbed",
                "word": "masticatoire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "67fdc2bb-6e41-42f8-9ddb-b7d8eb74c2fe",
                        "entry_id": "c35e1d51-03ba-3e8e-8fb5-57990c9efbed",
                        "tags": [
                            "plural"
                        ],
                        "form": "masticatoires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28a3aff5-2d5f-3b71-a368-3a24cf07f896",
                        "entry_id": "c35e1d51-03ba-3e8e-8fb5-57990c9efbed",
                        "glosses": [
                            "Sorte de médicament simple ou composé que l’on mâche pour exciter l’excrétion de la salive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae10b7cb-48d8-4db5-9a5d-b806902c5125",
                                "sense_id": "28a3aff5-2d5f-3b71-a368-3a24cf07f896",
                                "text": "Le pyrèthre, le bétel, le tabac sont des masticatoires."
                            },
                            {
                                "example_id": "cb486858-fb53-4aad-af95-6b66b09890c1",
                                "sense_id": "28a3aff5-2d5f-3b71-a368-3a24cf07f896",
                                "text": "User de masticatoires."
                            },
                            {
                                "example_id": "accc6188-46d2-4022-afeb-c5a9c114930e",
                                "sense_id": "28a3aff5-2d5f-3b71-a368-3a24cf07f896",
                                "text": "Ils sont destinés à être mis en contact avec la muqueuse buccale afin d’activer la salivation et d’y faire pénétrer le produit amalgamé au masticatoire."
                            }
                        ]
                    },
                    {
                        "sense_id": "22c6e8d1-a0a8-399e-90cc-7db78f3e0028",
                        "entry_id": "c35e1d51-03ba-3e8e-8fb5-57990c9efbed",
                        "glosses": [
                            "Moyen de produire une idée de façon machinale."
                        ],
                        "tags": [
                            "figuratively",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "62df4966-b5e3-4f98-abb5-271a82ff92a7",
                                "sense_id": "22c6e8d1-a0a8-399e-90cc-7db78f3e0028",
                                "text": "Ces maître mots tiennent lieu de masticatoires de la pensée autorisée …. — (Marc Chevrier, « La morne prose », Argument, XXVI, 1, automne-hiver 2023-2024, page 176)"
                            }
                        ]
                    }
                ],
