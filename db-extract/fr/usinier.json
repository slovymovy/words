                    },
                    {
                        "form_id": "197fba19-85fe-49f3-bb0a-6f80d8989b14",
                        "entry_id": "0f18f13a-7b1b-3f46-b31a-0e93ddfd92c1",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "usinières"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c9bc66b2-7f6e-32ba-bd76-b27cf1a57583",
                        "entry_id": "0f18f13a-7b1b-3f46-b31a-0e93ddfd92c1",
                        "glosses": [
                            "Relatif aux usines ou à leur activité, industriel ou fabriqué industriellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fac142a8-a91b-4352-9901-b8251a5783ad",
                                "sense_id": "c9bc66b2-7f6e-32ba-bd76-b27cf1a57583",
                                "text": "La vie usinière de la région est en crise."
                            }
                        ]
                    },
                    {
                        "sense_id": "84b57f2d-5af4-30d9-93e3-c34b928076c6",
                        "entry_id": "0f18f13a-7b1b-3f46-b31a-0e93ddfd92c1",
                        "glosses": [
                            "Où il y a des usines."
                        ],
                        "tags": [
                            "En parlant d’un lieu"
                        ],
                        "examples": [
                            {
                                "example_id": "957f62a4-631f-4a89-9301-cc2b2a615f48",
                                "sense_id": "84b57f2d-5af4-30d9-93e3-c34b928076c6",
                                "text": "Les sites usiniers renaissent les uns après les autres."
                            },
                            {
                                "example_id": "eb7ae408-cd48-4042-ba69-3640cc1ee42a",
                                "sense_id": "84b57f2d-5af4-30d9-93e3-c34b928076c6",
                                "text": "Deux ou trois barquettes amarrées se balancent sur l’eau : on les emprunte pour passer sur l’autre bord quand on veut se rendre à l’Abbaye du Val Saint-Lambert, que n’entoure pas encore, bien entendu, l’immense complexe usinier d’aujourd’hui."
                            },
                            {
                                "example_id": "041e481c-b5f4-4d29-b7db-f421bed71b56",
                                "sense_id": "84b57f2d-5af4-30d9-93e3-c34b928076c6",
                                "text": "Son goût archaïque – qui me touche – pour la propriété foncière l’empêche au moins de trop participer au démarrage industriel ; il a vu d’assez près les régions usinières pour ne pas savoir que mieux vaut peiner en plein air derrière l’unique cheval que suffoquer dans la poussière des filatures."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "18a91320-df52-32d1-a529-54c84247c7a0",
                "word": "usinier",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f0eda710-f725-474d-ae5b-b84e5bbaa8f4",
                        "entry_id": "18a91320-df52-32d1-a529-54c84247c7a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "usiniers"
                    },
                    {
                        "form_id": "4c25a27a-4a3d-4894-ac67-b81762e22ba8",
                        "entry_id": "18a91320-df52-32d1-a529-54c84247c7a0",
                        "tags": [
                            "feminine"
                        ],
                        "form": "usinière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef3813cf-0a96-37eb-b9b8-0a2035c8dd1b",
                        "entry_id": "18a91320-df52-32d1-a529-54c84247c7a0",
                        "glosses": [
                            "Celui qui exploite une usine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3439f7bb-b0d9-4373-b20f-49c6d3d62129",
                                "sense_id": "ef3813cf-0a96-37eb-b9b8-0a2035c8dd1b",
                                "text": "— Tiens ! il paraît qu’on a découvert parmi les décombres, sous le porche de l’hôtel Duvillard, un outil, un poinçon, sur le manche duquel se trouvait un nom, Grandidier, celui d’un usinier connu."
                            },
                            {
                                "example_id": "f7ac5d02-216b-453b-83f2-64a597d399bb",
                                "sense_id": "ef3813cf-0a96-37eb-b9b8-0a2035c8dd1b",
                                "text": "On parlerait de la pêche, des relations avec les usiniers qui étaient de plus en plus tendues, et aussi des syndicats de marins qui commençaient à devenir inquiétants."
                            }
                        ]
                    },
                    {
                        "sense_id": "278e2c8d-a7d2-3628-ad4d-d139c5dca0c0",
                        "entry_id": "18a91320-df52-32d1-a529-54c84247c7a0",
                        "glosses": [
                            "Ouvrier d'usine."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "3cacdaeb-a136-4c43-9336-8aad522479f3",
                                "sense_id": "278e2c8d-a7d2-3628-ad4d-d139c5dca0c0",
                                "text": "On a travaillé à qui mieux mieux : nos usiniers dans les ateliers, où je n'ai voulu laisser entrer aucun étranger une fois les machines et les engrenages montés ; les ouvriers terrassiers et les étrangers ont rangé en dehors."
                            }
                        ]
                    },
                    {
                        "sense_id": "86c9518b-43f1-3a65-ad68-ee544b90a565",
                        "entry_id": "18a91320-df52-32d1-a529-54c84247c7a0",
                        "glosses": [
                            "Représentant d'une usine (notamment de transformation de poisson) en quête de matière première."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5514155f-ecfd-47b5-a523-6cde816bc103",
                                "sense_id": "86c9518b-43f1-3a65-ad68-ee544b90a565",
                                "text": "– Vous êtes les premiers pour la criée! a hurlé le vieux.\nLes usinières se pressaient déjà sur le quai. …\n– Je vais à terre pour les usinières. Tu viens mon neveu?\nNon de la tête. Trop de monde sur le quai. Des commises d'usines, des touristes rêvant de vrai poisson, des habitants en quête d'un beau bar ou d'un jeune thon."
                            }
                        ]
                    },
                    {
                        "sense_id": "218468b4-f58d-3f21-ba90-6aa2376ad25c",
                        "entry_id": "18a91320-df52-32d1-a529-54c84247c7a0",
                        "glosses": [
                            "Propriétaire, directeur d’une sucrerie."
                        ],
                        "tags": [
                            "Par restriction de sens"
                        ],
                        "examples": [
                            {
                                "example_id": "d4d82cbe-1f7d-46f0-98a3-6e899eb3d757",
                                "sense_id": "218468b4-f58d-3f21-ba90-6aa2376ad25c",
                                "text": "Avant 1969, les rapports entre l’usinier et les producteurs de cannes étaient très simples : le planteur était propriétaire de ses cannes et également des sous-produits. L’usinier était un façonnier qui se faisait payer pour son travail d’extraction de sucre, mais il n’était pas propriétaire des sous-produits."
                            }
                        ]
                    }
                ],
