                "senses": [
                    {
                        "sense_id": "dcdc6429-01a5-383b-9659-8760308b7cfd",
                        "entry_id": "9ba564fc-301b-3d60-9809-a244354a1829",
                        "glosses": [
                            "Behörde, die eine Besatzungsmacht in dem von ihr besetzten Gebiet aufgestellt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "799ae88d-6d1a-41ae-a439-ad013a52e340",
                                "sense_id": "dcdc6429-01a5-383b-9659-8760308b7cfd",
                                "text": "„Die Besatzungsbehörden wiesen sie aufs Neue in Lager ein – in Hunderte von Sammellagern, aus denen sie so bald wie möglich in ihre Heimatländer geschafft werden sollten.“"
                            },
                            {
                                "example_id": "d16dcea1-b377-496d-961e-61b51024382d",
                                "sense_id": "dcdc6429-01a5-383b-9659-8760308b7cfd",
                                "text": "„Gedichte Benns in einer von Weyl geplanten Zeitschrift können nicht erscheinen – die französische Besatzungsbehörde untersagt es, einem Einspruch Alfred Döblins folgend, der sich gegen Benns Gedichte gewandt hatte, die Zeitschrift erscheint ohne sie.“"
                            },
                            {
                                "example_id": "5c9fa051-6e83-4e21-b0fe-276b560a745c",
                                "sense_id": "dcdc6429-01a5-383b-9659-8760308b7cfd",
                                "text": "„Amro ist in den letzten Jahren immer wieder von Siedlern verletzt und von den israelischen Besatzungsbehörden verhaftet und eingeschüchtert worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
