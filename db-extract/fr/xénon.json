        "fr-extract.jsonl": [
            {
                "entry_id": "dce0fee8-1a7d-3a29-a6b3-702c3433b707",
                "word": "xénon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "da880888-04f9-3636-8504-5391c92728dc",
                        "entry_id": "dce0fee8-1a7d-3a29-a6b3-702c3433b707",
                        "glosses": [
                            "Élément chimique de numéro atomique 54 et de symbole Xe qui fait partie des gaz nobles."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b272ce0-f8c7-4502-8ba5-0562057b05c0",
                                "sense_id": "da880888-04f9-3636-8504-5391c92728dc",
                                "text": "Le xénon présente divers isotopes parmi lesquels nous retiendrons le ¹³⁰Xe, un isotope stable et non radiogénique, et le ¹²⁹Xe qui est un isotope du xénon produit par la désintégration radioactive de l’iode 129 (¹²⁹I), isotope contenu dans les supernova qui ont contribué à la formation de la planète Terre."
                            }
                        ]
                    },
                    {
                        "sense_id": "89456dc1-056a-3def-8d75-c5546674ad9a",
                        "entry_id": "dce0fee8-1a7d-3a29-a6b3-702c3433b707",
                        "glosses": [
                            "Gaz monoatomique de cet élément (Xe) incolore, inodore et peu réactif."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "0f321223-2e24-43e2-b0c0-1f0cf8580981",
                                "sense_id": "89456dc1-056a-3def-8d75-c5546674ad9a",
                                "text": "Un journal parisien signalait que Ramsay avait « découvert cinq nouveaux gaz dans l’atmosphère en moins de cinq ans : l’argon, l’hélium, le néon, le krypton et le xénon »."
                            },
                            {
                                "example_id": "c82b865a-8d9d-40b9-92a6-b353098af61c",
                                "sense_id": "89456dc1-056a-3def-8d75-c5546674ad9a",
                                "text": "Les savants comprirent que le xénon perturbait la réaction en chaîne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ab34eca-0069-493f-8908-3219a919077d",
                        "source_entry_id": "dce0fee8-1a7d-3a29-a6b3-702c3433b707",
                        "target_lang_word": "Xenon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Xenon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                        "entry_id": "bb4e1ffe-598d-386a-b643-96950802f3d5",
                                        "glosses": [
                                            "geruch- und farbloses Edelgas, das beispielsweise als Narkotikum oder als Füllgas in Leuchtmitteln Anwendung findet"
                                        ],
                                        "tags": [
                                            "Ordnungszahl 54"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bfa755b-5303-4b8a-a54a-59cad346fd73",
                                                "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                                "text": "Als Füllung in Gasentladungsröhren erzeugt Xenon violettes Licht."
                                            },
                                            {
                                                "example_id": "76682d1e-39b5-4ec9-ad53-9570756fb49d",
                                                "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                                "text": "„Den Beweis eines Atomtests liefern erst radioaktive Spaltprodukte oder freigesetztes Xenon.“"
                                            },
                                            {
                                                "example_id": "34d3a3bb-b818-4437-bab7-392237af0959",
                                                "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                                "text": "„Als Treibstoff wird meist Xenon verwendet, keine schweren Tanks sind mehr nötig, das Gas reicht aus.“"
                                            },
                                            {
                                                "example_id": "fbec94f3-e775-44d6-8de6-cd335133da5d",
                                                "sense_id": "2d6e3f9f-1ebe-347c-b655-395c9560b6d3",
                                                "text": "„Nach der Entdeckung des Xenons hat Tepco Borsäure-Lösung mit dem Kühlwasser in den Reaktor eingeleitet, um eine Kettenreaktion aufzuhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
