                                            {
                                                "example_id": "699502ec-2558-4b81-93b8-23325e169477",
                                                "sense_id": "a0d3d514-b7bb-37c0-8d20-d115131d60dd",
                                                "text": "Die Afghanin wurde 1910 geboren und verstarb 1999."
                                            },
                                            {
                                                "example_id": "a92e4905-0eaf-4489-8e1d-2dc2c7b341fe",
                                                "sense_id": "a0d3d514-b7bb-37c0-8d20-d115131d60dd",
                                                "text": "„Sogar die Mannequins in den Schaufenstern dürfen keine Gesichter mehr zeigen. Manche Afghaninnen sehen darin ihre eigene Situation gespiegelt.“"
