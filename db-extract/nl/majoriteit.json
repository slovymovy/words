                "translations": [
                    {
                        "translation_id": "2400080b-025b-46ee-b86f-31ed5c45e06c",
                        "source_entry_id": "43ec5d65-de8e-39b0-b980-23fb2b467f14",
                        "source_sense_id": "10f07f45-234b-3728-ba88-3fcf91d5b376",
                        "target_lang_word": "majority",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majority",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3f9e2c82-26b0-3140-adb2-0e2d9d9f06a4",
                                        "entry_id": "233f956d-d7c1-368d-b307-7c5ddd3ab91c",
                                        "glosses": [
                                            "More than half (50%) of some group."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "558fb907-36fb-475a-a669-59b07f9ef700",
                                                "sense_id": "3f9e2c82-26b0-3140-adb2-0e2d9d9f06a4",
                                                "text": "The majority agreed that the new proposal was the best."
                                            },
                                            {
                                                "example_id": "596f9318-5899-4d51-a219-7013586d10aa",
                                                "sense_id": "3f9e2c82-26b0-3140-adb2-0e2d9d9f06a4",
                                                "text": "Those opposing the building plans were in the majority, so the building project was canceled."
                                            },
                                            {
                                                "example_id": "7a765110-77fb-46f1-a234-d9281b8f2fe6",
                                                "sense_id": "3f9e2c82-26b0-3140-adb2-0e2d9d9f06a4",
                                                "text": "The person having the greatest number of votes for President, shall be the President, if such number be a majority of the whole number of Electors appointed; and if no person have such majority, then from the persons having the highest numbers not exceeding three on the list of those voted for as President, the House of Representatives shall choose immediately, by ballot, the President. But in choosing the President, the votes shall be taken by states, the representation from each state having one vote; a quorum for this purpose shall consist of a member or members from two-thirds of the states, and a majority of all the states shall be necessary to a choice."
                                            },
                                            {
                                                "example_id": "5c3ea91a-e8e3-41be-87fe-52628afe9446",
                                                "sense_id": "3f9e2c82-26b0-3140-adb2-0e2d9d9f06a4",
                                                "text": "But in 1912 the American people gave the Democrats another opportunity, and under the leadership of Woodrow Wilson we swept the country from sea to sea. At the end of that historic contest we had the Presidency, the Senate by a working majority, and the House by an overwhelming majority."
                                            },
                                            {
                                                "example_id": "baba54d2-a10a-4ee2-8612-468e40aed638",
                                                "sense_id": "3f9e2c82-26b0-3140-adb2-0e2d9d9f06a4",
                                                "text": "They and the airline itself described an internal process that requires multiple departments to manually redesign the airline’s schedule – a system that works “the vast majority of the time,” Southwest said in a statement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1081e90b-507b-3044-b67e-78d1a8c84403",
                                        "entry_id": "233f956d-d7c1-368d-b307-7c5ddd3ab91c",
                                        "glosses": [
                                            "In a parliament or legislature, the difference in seats between the ruling party and the opposition; (UK) in an election, the difference in votes between the winning candidate and the second-place candidate, or between the winning candidate and all of the other candidates combined."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43200f3b-de29-49aa-b863-48bbfc4337e4",
                                                "sense_id": "1081e90b-507b-3044-b67e-78d1a8c84403",
                                                "text": "The ruling party had a narrow three-seat majority in the legislature."
                                            },
                                            {
                                                "example_id": "fe2ffdbc-0424-47cb-b1a0-c52a0f3c26bd",
                                                "sense_id": "1081e90b-507b-3044-b67e-78d1a8c84403",
                                                "text": "The winner with 53% had a 6% majority over the loser with 47%."
                                            },
                                            {
                                                "example_id": "76010ac3-e1af-4add-b682-2b0ee2619819",
                                                "sense_id": "1081e90b-507b-3044-b67e-78d1a8c84403",
                                                "text": "Now, there is talk of Democrats potentially being locked out of a Senate majority for a time to come because of trends in the electorate. […] This shouldn’t be surprising. As political analyst Sean Trende posited in the book “The Lost Majority,” history is filled with examples of majorities falling apart and the parties coming in and out of power."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "523b9777-c839-3286-8615-362a3aa4e506",
                                        "entry_id": "233f956d-d7c1-368d-b307-7c5ddd3ab91c",
                                        "glosses": [
                                            "Legal adulthood, age of majority."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "167c3982-d764-4edf-bf6d-d19cf4a0a6d9",
                                                "sense_id": "523b9777-c839-3286-8615-362a3aa4e506",
                                                "text": "By the time I reached my majority, I had already been around the world twice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40180e5c-8b9e-3e10-b8c1-b321b51f12d2",
                                        "entry_id": "233f956d-d7c1-368d-b307-7c5ddd3ab91c",
                                        "glosses": [
                                            "The office held by a member of the armed forces in the rank of major."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db83b6b9-bbdc-41d9-b851-bba5d40174bd",
                                                "sense_id": "40180e5c-8b9e-3e10-b8c1-b321b51f12d2",
                                                "text": "On receiving the news of his promotion, Charles Snodgrass said he was delighted to be entering his majority."
                                            },
                                            {
                                                "example_id": "a24b633f-9768-40ff-8641-ea4fcb2de8e9",
                                                "sense_id": "40180e5c-8b9e-3e10-b8c1-b321b51f12d2",
                                                "text": "He was a captain before he went to the front, and following the Argonne battles he got his majority and the command of the divisional machine-guns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4c54086-d427-3166-a241-e6d26d405091",
                                        "entry_id": "233f956d-d7c1-368d-b307-7c5ddd3ab91c",
                                        "glosses": [
                                            "Ancestors; ancestry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b971c5da-9bcd-4a08-a182-4ee3f6ebf0f1",
                                                "sense_id": "c4c54086-d427-3166-a241-e6d26d405091",
                                                "text": "Of evil parents an evil generation, a posterity not unlike their majority; of mischievous progenitors, a venomous and destructive progeny."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "31178a6a-e6cf-4547-8f01-d116946d443c",
                        "source_entry_id": "43ec5d65-de8e-39b0-b980-23fb2b467f14",
                        "source_sense_id": "10f07f45-234b-3728-ba88-3fcf91d5b376",
                        "target_lang_word": "majorité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "majorité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c4bcec4f-5682-3b5d-bb22-554ffe0a4eeb",
                                        "entry_id": "71a804b2-c52f-350f-b468-1b3d9049ea61",
                                        "glosses": [
                                            "Groupe des votants ou des suffrages plus nombreux que les autres, soit majorité absolue ou majorité relative."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e4c585d-1445-4af1-a122-b6b6df99be1a",
                                                "sense_id": "c4bcec4f-5682-3b5d-bb22-554ffe0a4eeb",
                                                "text": "Le roi et les privilégiés auraient voulu que les états délibérassent comme en 1614, c’est-à-dire « par ordre ». Les privilégiés auraient eu immanquablement la majorité et les états auraient été incapables d’opérer aucune réforme sérieuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a365248c-1f33-3a09-9994-ca558911f16c",
                                        "entry_id": "71a804b2-c52f-350f-b468-1b3d9049ea61",
                                        "glosses": [
                                            "Parti qui, dans une assemblée, réunit ordinairement le plus grand nombre de suffrages."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47cb9ea2-fc7d-4900-b24d-f9c2dee14a48",
                                                "sense_id": "a365248c-1f33-3a09-9994-ca558911f16c",
                                                "text": "L’opposition assistait avec une sorte de pitié narquoise à l’affolement de la majorité."
                                            },
                                            {
                                                "example_id": "457099b0-5f1e-48c1-9036-d62bfb3f9422",
                                                "sense_id": "a365248c-1f33-3a09-9994-ca558911f16c",
                                                "text": "Cette transformation générale de la société ne se fera pas par la prise du pouvoir d’État par une majorité de gauche ; elle suppose une myriade de luttes locales et globales."
                                            },
                                            {
                                                "example_id": "cf8ccfbf-c37e-46db-b41d-eeae339ad625",
                                                "sense_id": "a365248c-1f33-3a09-9994-ca558911f16c",
                                                "text": "À la tête d’un commando ultraresserré à l’Élysée, patron d’une majorité pléthorique à l’Assemblée nationale, il a cru bon de gouverner seul."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7f53fd0-7d25-3900-958f-b4b8511015e7",
                                        "entry_id": "71a804b2-c52f-350f-b468-1b3d9049ea61",
                                        "glosses": [
                                            "Le plus grand nombre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d7f5079-4e2c-471b-a28b-859209994953",
                                                "sense_id": "c7f53fd0-7d25-3900-958f-b4b8511015e7",
                                                "text": "Au nom de la bien-pensance, des groupes et des partis politiques instillent des interdits qui chamboulent notre démocratie alors que la voix des minorités devient plus tonitruante que celle de la majorité."
                                            },
                                            {
                                                "example_id": "292d3312-1633-4ffe-9bf4-8ca5592e5951",
                                                "sense_id": "c7f53fd0-7d25-3900-958f-b4b8511015e7",
                                                "text": "La fauconnerie est donc un sport assez coûteux et, la majorité des gros turbans marocains étant trop indolents pour chasser, elle tend à disparaître."
                                            },
                                            {
                                                "example_id": "927225a7-b785-41c7-bc4e-23fa26b21df7",
                                                "sense_id": "c7f53fd0-7d25-3900-958f-b4b8511015e7",
                                                "text": "[…] ; l’affaire Dreyfus nous a montré que l’immense majorité des officiers et des prêtres concevait toujours la justice à la manière de l’Ancien Régime […]."
                                            },
                                            {
                                                "example_id": "1cfe8dd6-ac4b-4e91-a2f8-d87aad67c238",
                                                "sense_id": "c7f53fd0-7d25-3900-958f-b4b8511015e7",
                                                "text": "L’internationalisme sentimental d’avant 1914 n’a pas résisté au choc des nations. Dans tous les pays en guerre, socialistes et syndicalistes, dans leur grande majorité, ont participé à la défense nationale."
                                            },
                                            {
                                                "example_id": "faa416ab-8064-4a36-bdd2-330c327f50e2",
                                                "sense_id": "c7f53fd0-7d25-3900-958f-b4b8511015e7",
                                                "text": "La poussière constitue un risque pour les voies respiratoires, d’autant qu’une majorité de salariés ne porte pas de masque ou porte un masque insuffisamment protecteur ou encombrant : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4e791b1-7ff5-3a37-8fa1-17408d43598d",
                                        "entry_id": "71a804b2-c52f-350f-b468-1b3d9049ea61",
                                        "glosses": [
                                            "État de celui qui est majeur. Majorité civile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a4f72e3-2382-4574-8fba-2950cd6f7b68",
                                                "sense_id": "a4e791b1-7ff5-3a37-8fa1-17408d43598d",
                                                "text": "La majorité pour être électeur est fixée en France à 18 ans et pour être éligible à 25 ans."
                                            },
                                            {
                                                "example_id": "8b901ab1-2d0e-4bfa-9eb8-041ffb9c3326",
                                                "sense_id": "a4e791b1-7ff5-3a37-8fa1-17408d43598d",
                                                "text": "Il a atteint l’âge de majorité, ou de sa majorité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f017ae0c-f60d-32a5-93f4-4e3f28eb1a8e",
                                        "entry_id": "71a804b2-c52f-350f-b468-1b3d9049ea61",
                                        "glosses": [
                                            "Pluralité des individus dans un pays, dans un groupement."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a95c5c7e-c7ba-4ff9-990e-5f4efb2bcd05",
                                                "sense_id": "f017ae0c-f60d-32a5-93f4-4e3f28eb1a8e",
                                                "text": "La majorité des Français professe la religion catholique."
                                            },
                                            {
                                                "example_id": "a258f51f-987f-41d5-931c-23b6a60ec668",
                                                "sense_id": "f017ae0c-f60d-32a5-93f4-4e3f28eb1a8e",
                                                "text": "Les élèves de cette classe sont en majorité travailleurs."
                                            },
                                            {
                                                "example_id": "14fa9dcf-6b9a-4f8e-8aa9-4c2e71a1d3dc",
                                                "sense_id": "f017ae0c-f60d-32a5-93f4-4e3f28eb1a8e",
                                                "text": "La majorité du peuple a voté pour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb6f77c-4f64-33ea-88c9-8836d6e55e27",
                                        "entry_id": "71a804b2-c52f-350f-b468-1b3d9049ea61",
                                        "glosses": [
                                            "Résidence de l’état-major dans un port."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
