                        "form": "die Fachlichkeit"
                    },
                    {
                        "form_id": "bb8f002a-ab72-44c1-9d31-31e108b3c047",
                        "entry_id": "3c674909-973c-3006-ade4-915dd7650507",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fachlichkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ab104039-e7f5-3e84-9209-f6b6ba2a7678",
                        "entry_id": "3c674909-973c-3006-ade4-915dd7650507",
                        "glosses": [
                            "alle Elemente der sprachlichen und der nichtsprachlichen Ausdrucksform, die in der Kommunikation verwendet werden, um Sachverhalte oder Gegenstände eines bestimmten Fach- oder Wissensgebietes zu beschreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34dd84bd-f84b-4bec-8f87-94596df87b9d",
                                "sense_id": "ab104039-e7f5-3e84-9209-f6b6ba2a7678",
                                "text": "„Fachlichkeit ist insofern mehr als Fachwissen, als es für einen Lehrer eben nicht reicht, Erkenntnisse der Fachwissenschaft zu wissen oder auch anwenden zu können.“"
                            },
                            {
                                "example_id": "c9d0d1c9-6db1-451e-9c3d-969a99deb4ca",
                                "sense_id": "ab104039-e7f5-3e84-9209-f6b6ba2a7678",
                                "text": "„Dabei verlieren wir immer mal wieder aus den Augen, dass das Entscheidende für den Erfolg unserer Software nicht die Technik, sondern die Fachlichkeit ist.“"
                            },
                            {
                                "example_id": "689c48fc-408b-42b9-b8ad-f986434a2b22",
                                "sense_id": "ab104039-e7f5-3e84-9209-f6b6ba2a7678",
                                "text": "„Zuallererst muss es Ziel dieser Arbeit sein, die Frage zu klären, was der Terminus Fachlichkeit überhaupt bedeutet - bzw. im Rahmen dieser Studie bedeuten soll - und was die spezifische Fachlichkeit des Geschichtsunterrichts umfasst, um dadurch die Basis dieser Studie zu schaffen.“"
                            },
                            {
                                "example_id": "f007e603-fc00-4177-b140-0404321628bc",
                                "sense_id": "ab104039-e7f5-3e84-9209-f6b6ba2a7678",
                                "text": "„Was ist mit der Ableitung Fachlichkeit (von Fach und fachlich) gemeint, die zwar systematisch bildbar ist, sich aber in kaum einem Wörterbuch zur deutschen Sprache findet? Ich verwende diese Bezeichnung, um den engeren Terminus Fachsprache vermeiden zu können, der sich nur auf rein sprachliche Vermittlung von Fachlichem bezieht.“"
                            },
                            {
                                "example_id": "e7d9e84d-ff12-400d-bf9f-3b9d1322c5fd",
                                "sense_id": "ab104039-e7f5-3e84-9209-f6b6ba2a7678",
                                "text": "„Anfang der 70er Jahre wurde versucht, eine neue Fachlichkeit zu etablieren, die zeitlich etwa mit der Einführung des Diplom- Studienganges für Pädagogik (1969) und der Umwandlung von Fachschulen bzw. der Einrichtung von Fachhochschulen (seit 1971) zusammenfällt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6cb2ec45-fba5-4c75-92b8-e4f979eb3f50",
                        "source_entry_id": "3c674909-973c-3006-ade4-915dd7650507",
                        "source_sense_id": "ab104039-e7f5-3e84-9209-f6b6ba2a7678",
                        "target_lang_word": "métier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8a25d6ad-cc38-3613-89b5-ad6f5cd55cea",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Activité impliquant l’acquisition d’un savoir-faire particulier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26d32abb-ede5-46da-810f-6408f537cdca",
                                                "sense_id": "8a25d6ad-cc38-3613-89b5-ad6f5cd55cea",
                                                "text": "Les marchands nomades, notamment, cherchent à circonvenir par tous les moyens, tous ceux faisant métier de vérifier les animaux."
                                            },
                                            {
                                                "example_id": "e1d8185c-7bd8-4b47-a2b8-d65bdd1fa17a",
                                                "sense_id": "8a25d6ad-cc38-3613-89b5-ad6f5cd55cea",
                                                "text": "Bert effleura successivement un bon nombre de métiers : il fut groom dans un magasin de nouveautés et chez un médecin, garçon de pharmacie, apprenti plombier, griffonneur d’adresses, garçon laitier, « golf caddie », et enfin aide-mécanicien chez un loueur et réparateur de bicyclettes."
                                            },
                                            {
                                                "example_id": "b13fb9f1-415b-4a36-ab88-5ea4442f84be",
                                                "sense_id": "8a25d6ad-cc38-3613-89b5-ad6f5cd55cea",
                                                "text": "[…] et si le bon sens n’a jamais proféré cette absurdité monstrueuse qu’il n’y a pas de sot métier, il est bien forcé de reconnaître qu’un métier, si sot soit-il, on est bien forcé de l’exercer pour gagner sa vie, quand on n’en a pas d’autre."
                                            },
                                            {
                                                "example_id": "68b8475b-2d7c-41cd-87f8-0e158ce04158",
                                                "sense_id": "8a25d6ad-cc38-3613-89b5-ad6f5cd55cea",
                                                "text": "[…] les docteurs du Talmud ne donnaient-ils pas eux-mêmes l’exemple en exerçant, pour assurer leur gagne-pain, les métiers les plus humbles, tels que forgerons, ou savetier, ou fabricant d’épingles, etc. […] ?"
                                            },
                                            {
                                                "example_id": "2eb0a11d-cc31-4c6f-b14c-78411380a746",
                                                "sense_id": "8a25d6ad-cc38-3613-89b5-ad6f5cd55cea",
                                                "text": "Tout métier qui ne fait pas oublier le travail est un esclavage. La vie alors n'est plus une existence."
                                            },
                                            {
                                                "example_id": "f337b313-f6b4-4325-a944-ba30c45cda9e",
                                                "sense_id": "8a25d6ad-cc38-3613-89b5-ad6f5cd55cea",
                                                "text": "La justice française vient de trancher : des commerciaux de la société Ricard ont le droit de se plaindre de l’alcoolisme consubstantiel à l’exercice de leur métier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c144c71f-26cc-3ee6-87b2-ab98e501b163",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Domaine d’activité d’une entreprise."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a325369-f4a5-4813-a1f3-26abe014f8e8",
                                                "sense_id": "c144c71f-26cc-3ee6-87b2-ab98e501b163",
                                                "text": "Le métier de cette industrie est l’aéronautique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8238695d-728a-35b3-bc94-b7262ed71b9d",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "S’emploie quelquefois par opposition au mot art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "024a3a40-9a02-4a84-9b1f-df769fc9a678",
                                                "sense_id": "8238695d-728a-35b3-bc94-b7262ed71b9d",
                                                "text": "C’est faire d’un art un métier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad260161-0760-3d51-a305-ba7e3e0e61b4",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Habileté technique, expérience d’un art."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab43443-1471-40a4-8cca-c1f133120257",
                                                "sense_id": "ad260161-0760-3d51-a305-ba7e3e0e61b4",
                                                "text": "Avoir du métier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b77fecb6-421d-3ca4-89e0-d8b0238331b5",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Fait de faire habituellement quelque chose dans des vues intéressées, en faire une sorte de trafic."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa978e9d-4392-4c57-add8-daa79770cfa9",
                                                "sense_id": "b77fecb6-421d-3ca4-89e0-d8b0238331b5",
                                                "text": "C’est un bon métier que celui de prophète, mais à la condition d’y éviter les trop grosses bourdes et de ne pas montrer aux simples mortels combien est peu sensible parfois l’écart entre une prédiction et une bévue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "36eb4623-f0b5-3086-9f0f-144b33c876a0",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Mauvaise habitude."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7833b4df-01d7-414c-9285-33f270a0b4d0",
                                                "sense_id": "36eb4623-f0b5-3086-9f0f-144b33c876a0",
                                                "text": "Le métier de coquette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65ebadc2-2526-3f31-871c-93cdc5c4f708",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Activité malhonnête ou répréhensible."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77606246-bcda-4ef8-8378-091384b81afc",
                                                "sense_id": "65ebadc2-2526-3f31-871c-93cdc5c4f708",
                                                "text": "La plupart de ces messieurs que tu vois là, autour de nous, s’enorgueillissent de casiers judiciaires confortables… Ils sortent de prison ou vont y entrer. Ce sont les risques du métier. Mais le métier a du bon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4433db2f-6ac4-3b7f-ba1c-d968eb4cc039",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Mécanisme, dispositif qui sert à certaines fabrications, à certains ouvrages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9293e287-68af-44d4-9075-20cd3db10562",
                                                "sense_id": "4433db2f-6ac4-3b7f-ba1c-d968eb4cc039",
                                                "text": "Cette femme, cet ange restait toujours là, assise devant un métier à tapisserie, et chaque fois qu’elle tirait son aiguille elle regardait Lambert en exprimant un sentiment triste et doux."
                                            },
                                            {
                                                "example_id": "d8a45c2b-2c2d-4c77-9836-bcb203bbc0d9",
                                                "sense_id": "4433db2f-6ac4-3b7f-ba1c-d968eb4cc039",
                                                "text": "Entre cette table et la marquise, une grande et belle jeune fille travaillait, assise devant un métier à tapisserie sur lequel se penchait et d’où s’éloignait alternativement sa tête […]"
                                            },
                                            {
                                                "example_id": "e0eb8259-70d9-4353-9c57-b553eb6d80c9",
                                                "sense_id": "4433db2f-6ac4-3b7f-ba1c-d968eb4cc039",
                                                "text": "[…] ses deux garçons étaient tisserands, et dans ce vieux nid on entendait grincer les métiers et siffler les navettes du matin au soir."
                                            },
                                            {
                                                "example_id": "220b576a-a09e-45ac-bbe2-5d685f5f1278",
                                                "sense_id": "4433db2f-6ac4-3b7f-ba1c-d968eb4cc039",
                                                "text": "Toutes les pièces du linge et des vêtements sont tissées au métier par la candidate […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5432acd-a2ea-3690-9ca7-19dc3e9b90bd",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Pour les productions de l’esprit, désigne un en-cours."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "37d4e1b3-3fc0-4826-8320-6d2f89eb708a",
                                                "sense_id": "a5432acd-a2ea-3690-9ca7-19dc3e9b90bd",
                                                "text": "Il a un roman sur le métier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddcd3970-77eb-3f94-af60-694f68182d38",
                                        "entry_id": "ca9e5ff4-2d30-3df5-9607-b759df071721",
                                        "glosses": [
                                            "Activité pratiquée par une unité de pêche et définie, au minimum, par une combinaison entre engin de pêche, espèce cible et zone d’activité."
                                        ],
