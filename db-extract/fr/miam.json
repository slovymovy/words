                "senses": [
                    {
                        "sense_id": "2a879cc5-405a-3456-8446-7583a85d6872",
                        "entry_id": "54df2727-f4ec-35bc-a256-b5f03b9282c1",
                        "glosses": [
                            "Onomatopée exprimant la délectation de boire ou de manger, voulant dire que quelque chose est très appétissant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4083db2-6a54-4bec-835c-62e230bd3a92",
                                "sense_id": "2a879cc5-405a-3456-8446-7583a85d6872",
                                "text": "C’est le can’, le cannibale,\nQui croqu’ra l’hori, qui croqu’ra l’hora,\nQui croqu’ra l’horizontale.\nMmiam ! mmiam ! mmiam ! mmiam ! mmiam !"
                            },
                            {
                                "example_id": "7609ad2d-e436-45d9-92da-ccc873f94267",
                                "sense_id": "2a879cc5-405a-3456-8446-7583a85d6872",
                                "text": "Une chose est sûre, c’est la présence de l’umami dans vos plats qui vous fera dire \"miam !\" jusqu’à la dernière bouchée !"
                            },
                            {
                                "example_id": "34acd3c3-5ab4-4698-9b62-73891cca6b71",
                                "sense_id": "2a879cc5-405a-3456-8446-7583a85d6872",
                                "text": "Je regardais Claude en poussant des miam de satisfaction et en frottant ma main contre mon ventre."
                            }
                        ]
                    },
                    {
                        "sense_id": "1cebd103-ffc9-355a-bf98-50d007c764b0",
                        "entry_id": "54df2727-f4ec-35bc-a256-b5f03b9282c1",
                        "glosses": [
                            "Onomatopée exprimant l’envie de manger."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3102da45-79f3-4183-9975-ad0925f6dc01",
                                "sense_id": "1cebd103-ffc9-355a-bf98-50d007c764b0",
                                "text": "L’idiot s’est apaisé, il ne hurle plus ; ses gros yeux hébétés fixés sur sa femme, il fait le simulacre de manger : Miam-miam-miam."
                            }
                        ]
                    }
                ],
