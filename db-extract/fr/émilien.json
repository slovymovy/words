            {
                "entry_id": "9dcda3d8-2573-3edf-85a7-91dbab5a2966",
                "word": "Émilien",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6141b92b-b9d1-3929-b2cb-28155be7dbf8",
                        "entry_id": "9dcda3d8-2573-3edf-85a7-91dbab5a2966",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a718791-255d-4e6b-9aa7-e7103d80fb01",
                                "sense_id": "6141b92b-b9d1-3929-b2cb-28155be7dbf8",
                                "text": "Il répondait au plaisant nom d’Émilien Brochet."
                            },
                            {
                                "example_id": "481641e1-6cad-42c6-afb9-a84a07f96596",
                                "sense_id": "6141b92b-b9d1-3929-b2cb-28155be7dbf8",
                                "text": "Le Tricolore Émilien Jacquelin s’est, lui, classé troisième de la poursuite masculine, derrière les deux Norvégiens Johannes Boe, toujours intouchable, et Sturla Laegreid."
                            },
                            {
                                "example_id": "80876dc6-d9bd-4803-b9a8-3b4a128dd4e1",
                                "sense_id": "6141b92b-b9d1-3929-b2cb-28155be7dbf8",
                                "text": "Émilien Jacquelin, qui s’élançait avec quarante-trois secondes de retard, n’a pas pu le rattraper et finit même troisième, dépassé par l’autre Norvégien en feu, Sturla Holm Lægreid."
                            },
                            {
                                "example_id": "240e1880-48df-4399-83ac-d93abd13a1e5",
                                "sense_id": "6141b92b-b9d1-3929-b2cb-28155be7dbf8",
                                "text": "Sitôt parti, il est déjà de retour. Émilien, 22 ans, champion du monde incontesté des participations gagnantes à un jeu télévisé en solo, attendra encore un peu avant de se reposer."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8cfae02a-2ca6-45da-939c-48650cbf601a",
                        "source_entry_id": "9dcda3d8-2573-3edf-85a7-91dbab5a2966",
                        "source_sense_id": "6141b92b-b9d1-3929-b2cb-28155be7dbf8",
                        "target_lang_word": "Emilian",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Emilian",
