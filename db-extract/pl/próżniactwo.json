                "translations": [
                    {
                        "translation_id": "6c929f5b-5458-4fa9-8162-b5f7bb70a5f9",
                        "source_entry_id": "7b7d130d-c4d9-3d93-b3c8-ec161cbb352e",
                        "source_sense_id": "ea69fd24-55d8-306c-a19c-c545323fa1e0",
                        "target_lang_word": "oisiveté",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oisiveté",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bb0aa64c-a47f-37f0-9eed-3f77f05d0e80",
                                        "entry_id": "1d6328cd-0821-3efe-a87e-0bf01a3906fb",
                                        "glosses": [
                                            "État, habitude d’une personne qui est oisive, qui ne fait rien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "334fb38e-21d4-4eee-acad-8a1646907a01",
                                                "sense_id": "bb0aa64c-a47f-37f0-9eed-3f77f05d0e80",
                                                "text": "Peut-être voulez-vous seulement occuper votre oisiveté de province par le spectacle des sottises que peut faire un poète ?"
                                            },
                                            {
                                                "example_id": "55c6cb72-fb42-4894-996d-c85281d76fe5",
                                                "sense_id": "bb0aa64c-a47f-37f0-9eed-3f77f05d0e80",
                                                "text": "Rien ne choque tant les pauvres gens que l’oisiveté des riches ou de ceux qu’ils croient riches."
                                            },
                                            {
                                                "example_id": "d27eea39-8c76-42c8-aab0-ac7fab21cdd3",
                                                "sense_id": "bb0aa64c-a47f-37f0-9eed-3f77f05d0e80",
                                                "text": "[…] il ne voulait pas cependant négliger ses autres occupations et nourrir dans la paresse une vingtaine de bandits qui d’un moment à l’autre, poussés par l’oisiveté, pouvaient lui jouer un mauvais tour."
                                            },
                                            {
                                                "example_id": "f5394868-3d1b-4035-8bcf-d0a1d7ebd9ca",
                                                "sense_id": "bb0aa64c-a47f-37f0-9eed-3f77f05d0e80",
                                                "text": "Autre motif d’orgueil, que d’être citoyen ! Cela consiste pour les pauvres à soutenir et à conserver les riches dans leur puissance et leur oisiveté. Ils y doivent travailler devant la majestueuse égalité des lois, qui interdit au riche comme au pauvre de coucher sous les ponts, de mendier dans les rues et de voler du pain."
                                            },
                                            {
                                                "example_id": "69d80a15-a189-4116-bdde-ba1540c78560",
                                                "sense_id": "bb0aa64c-a47f-37f0-9eed-3f77f05d0e80",
                                                "text": "[…] le gros Léon, qui avait épousé une femme riche, ne faisait rien, ses trois mille francs de rente lui permettant l’oisiveté."
                                            },
                                            {
                                                "example_id": "078d6de6-ae1d-408f-bd44-b18b9af0e067",
                                                "sense_id": "bb0aa64c-a47f-37f0-9eed-3f77f05d0e80",
                                                "text": "Seuls, l’allumeur de l’unique réverbère du pôle Nord, et son confrère de l’unique réverbère du pôle Sud, menaient des vies d’oisiveté et de nonchalance : ils travaillaient deux fois par an."
                                            },
                                            {
                                                "example_id": "0ab69fe9-1281-405f-8fc0-2ab486f92142",
                                                "sense_id": "bb0aa64c-a47f-37f0-9eed-3f77f05d0e80",
                                                "text": "[…] il avait cette grâce aristocratique d’une race qui vit noblement puisque son labeur est un jeu, un luxe de son oisiveté."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0be6105-b3ce-4ce7-aae2-4962f759dc67",
                        "source_entry_id": "7b7d130d-c4d9-3d93-b3c8-ec161cbb352e",
