                                "target_senses": [
                                    {
                                        "sense_id": "db4f3e58-d2c0-34ca-aeae-bc0255947ca2",
                                        "entry_id": "139af14e-a2b8-3889-94e3-74204c96d4f9",
                                        "glosses": [
                                            "Sitz der päpstlichen Regierung oder einer bischöflichen Verwaltung, einschließlich des päpstlichen Gerichtshofes"
                                        ],
                                        "tags": [
                                            "Katholizismus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56a5d3e3-a95c-45e5-a708-10f2622af43c",
                                                "sense_id": "db4f3e58-d2c0-34ca-aeae-bc0255947ca2",
                                                "text": "„Nach dem Vorbild der Kurie hatten sich im Laufe des Mittelalters auf allen Bereichen des öffentlichen Lebens feste Formen der Schriftlichkeit herausgebildet: Schriftformen der Mitteilung und Vereinbarung, des Gesuchs und der Verfügung.“"
                                            },
                                            {
                                                "example_id": "9659b19d-d23b-4181-b2d6-a1a4e76d43b5",
                                                "sense_id": "db4f3e58-d2c0-34ca-aeae-bc0255947ca2",
                                                "text": "„Für die Würde des Erzbischofs und Kurfürsten von Mainz zahlte Albrecht 14000 Dukaten an die römische Kurie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fb708a18-c245-3892-958d-86145c6edd9e",
                                        "entry_id": "139af14e-a2b8-3889-94e3-74204c96d4f9",
                                        "glosses": [
                                            "Einteilung der patrizischen Geschlechter und auch Versammlungsort des Senats im alten Rom"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b347f8b-f380-426b-a4e4-ecd010cacdbe",
                                                "sense_id": "fb708a18-c245-3892-958d-86145c6edd9e",
                                                "text": "Jede der drei Tribus der Patrizier wurden in 10 Kurien eingeteilt."
                                            },
                                            {
                                                "example_id": "90b39f37-98d7-47f2-8d73-0d91baf486db",
                                                "sense_id": "fb708a18-c245-3892-958d-86145c6edd9e",
                                                "text": "Hier trafen sich die Kurien, um ihre Angelegenheiten zu besprechen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
