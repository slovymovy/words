                ],
                "senses": [
                    {
                        "sense_id": "5f1bb854-bce0-3f98-a0f8-97934dcfba9b",
                        "entry_id": "916f82a2-f2cd-39fc-a7a6-fecf6c0903cb",
                        "glosses": [
                            "Centaure ayant un corps de taureau."
                        ],
                        "tags": [
                            "Mythologie grecque"
                        ],
                        "examples": [
                            {
                                "example_id": "c285d008-2e43-451c-8e19-540f2d40c882",
                                "sense_id": "5f1bb854-bce0-3f98-a0f8-97934dcfba9b",
                                "text": "Je vis des créatures d’eau, des femmes à la chevelure d’écume, peut-être était-ce les Néréides, car elles devaient être bien cinquante, montées dans un immense vaisseau au bois cousu d’or, auquel était fixé à la proue un bucentaure."
                            }
                        ]
                    },
                    {
                        "sense_id": "4269e05c-0f20-362f-8464-e06e7c42da2a",
                        "entry_id": "916f82a2-f2cd-39fc-a7a6-fecf6c0903cb",
                        "glosses": [
                            "Vaisseau, originellement vénitien, orné à la proue d’une représentation d’un bucentaure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "458b721b-bab3-4f61-ba5a-0602a3f8888c",
                                "sense_id": "4269e05c-0f20-362f-8464-e06e7c42da2a",
                                "text": "Tout à coup, devant le rouge palais des Foscari, dans la courbe du canal, un grand bucentaure s’enflamma comme une tour qui s’incendie."
                            }
                        ]
                    }
                ],
