                        "examples": [
                            {
                                "example_id": "dd7c77cc-1420-4bb7-afa9-3e1fa3ddca33",
                                "sense_id": "1fd50518-b361-3290-9822-68820ef9165e",
                                "text": "Je me rappelle avoir vu La Bataille, L’Occident, Les Mystères de New York, Les Misérables, Salammbô, et plein de films de Tom Mix, le roi des cowboys…"
                            },
                            {
                                "example_id": "2a8ef3eb-9870-4d99-aab2-6f0dcb836968",
                                "sense_id": "1fd50518-b361-3290-9822-68820ef9165e",
                                "text": "Dans un autre registre, Tom Cruise, encore lui, a inspiré Pascal, aujourd’hui « flair bartender dans un bar londonien après avoir vu Cocktail », sorti en 1988."
                            },
                            {
                                "example_id": "08aaa429-2c35-49f9-8f02-a834b54a3d18",
                                "sense_id": "1fd50518-b361-3290-9822-68820ef9165e",
                                "text": "La top model Gisele Bündchen n’a pas assisté au premier match à domicile de son mari, Tom Brady, le quaterback de Tampa Bay."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
