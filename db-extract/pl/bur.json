                    {
                        "sense_id": "553ecf56-448c-3d05-802f-3916595d8baa",
                        "entry_id": "8e7e0539-ca7d-3b2f-bd70-37f0456b587f",
                        "glosses": [
                            "członek germańskiego plemienia mieszkającego w starożytności na terenie Czech lub Polski"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa5f955-fb60-482e-85be-5d290adb2671",
                                "sense_id": "553ecf56-448c-3d05-802f-3916595d8baa",
                                "text": "U źródeł Wisły Klaudiusz Ptolemeusz umieszcza Burów, których uznaje za jedno z plemion lugijskich."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
