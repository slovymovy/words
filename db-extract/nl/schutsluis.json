                                                "example_id": "3f27adb2-238c-4844-b82f-d10b509de0dd",
                                                "sense_id": "e13b2d7b-b0e4-3650-b580-c08177eb6437",
                                                "text": "Les quelques milles qui séparent Cristobal de Gatun furent vite franchis et les portes de la grande écluse triple s’ouvrirent devant moi."
                                            },
                                            {
                                                "example_id": "966681f9-62f8-494c-9e89-5ac68ae7b1b3",
                                                "sense_id": "e13b2d7b-b0e4-3650-b580-c08177eb6437",
                                                "text": "Autrefois le Lot était une voie navigable : ses écluses, ses relais faisaient vivre un peuple de mariniers. On a déclassé le Lot."
                                            },
                                            {
                                                "example_id": "bbab8d2a-db58-4119-824c-f72cbd0dd5db",
                                                "sense_id": "e13b2d7b-b0e4-3650-b580-c08177eb6437",
                                                "text": "Un castor seul travaillait en ce moment sur la principale écluse ; mais bientôt cinq autres parurent apportant des morceaux de bois, de la vase et des broussailles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "835a8028-bcce-3e88-a65c-4582dde8304c",
                                        "entry_id": "cba2bf12-e994-348c-9f2a-7d6d5fcfbf0a",
                                        "glosses": [
                                            "Porte qui se hausse et se baisse ou qui s’ouvre et se ferme dans ces sortes de clôtures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69194fd7-a6af-4cde-aa7e-96b4b48f7ebb",
                                                "sense_id": "835a8028-bcce-3e88-a65c-4582dde8304c",
                                                "text": "Lever, baisser l’écluse ou les écluses. - Fermer, ouvrir, lâcher les écluses. - L’eau passe par-dessus les écluses, a entraîné les écluses."
                                            },
                                            {
                                                "example_id": "2479a1f1-1ef2-4d48-a1b9-0cc8e418cb07",
                                                "sense_id": "835a8028-bcce-3e88-a65c-4582dde8304c",
                                                "text": "Lâcher les écluses de son éloquence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fae5341a-dafc-31da-a180-235bf1ce09f1",
                                        "entry_id": "cba2bf12-e994-348c-9f2a-7d6d5fcfbf0a",
                                        "glosses": [
                                            "Dispositif de rétrécissement d'une chaussée."
                                        ],
                                        "tags": [
                                            "Voirie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
