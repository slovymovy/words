                "senses": [
                    {
                        "sense_id": "b7bc0a2f-c141-397d-a27a-f21d7b959c0e",
                        "entry_id": "351f42f0-dba4-337d-a862-d504e7e8b8bd",
                        "glosses": [
                            "kurze Erzählung, die in Form einer Reihe von Bildern oder Zeichnungen dargestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5490ae41-d800-479a-8e56-edaf1cc01649",
                                "sense_id": "b7bc0a2f-c141-397d-a27a-f21d7b959c0e",
                                "text": "„Da hat der Urvater des Comics und der sich selbst bewegenden Bildergeschichte eine so grausige innere Kamera eingestellt, dass die Bilder zu tanzen, zu kreisen, sich als unheimliche Spirale zu drehen beginnen.“"
                            },
                            {
                                "example_id": "15f8c5eb-412d-4dc2-82fb-c75b038fa5e3",
                                "sense_id": "b7bc0a2f-c141-397d-a27a-f21d7b959c0e",
                                "text": "Hier kannst du deine eigene Bildergeschichte mit einem Drachen, einer Burg und einem weiblichen Ritter schreiben."
                            },
                            {
                                "example_id": "dc8ef5e7-f15f-4959-b758-30a9235ed24e",
                                "sense_id": "b7bc0a2f-c141-397d-a27a-f21d7b959c0e",
                                "text": "„Buschs Ruhm beruht hauptsächlich auf seinen Bildergeschichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b4140cbb-866d-4c9f-8fc3-0d1b353d9ed9",
                        "source_entry_id": "351f42f0-dba4-337d-a862-d504e7e8b8bd",
                        "source_sense_id": "b7bc0a2f-c141-397d-a27a-f21d7b959c0e",
                        "source_sense_description": "kurze Erzählung, die in Form einer Reihe von Bildern oder Zeichnungen dargestellt ist",
                        "target_lang_word": "bande dessinée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bande dessinée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cf8ed282-dd50-3eee-9984-125757a95410",
                                        "entry_id": "9827126d-7b6d-3df3-a7ac-cb65a61ac6f8",
                                        "glosses": [
                                            "Œuvre utilisant des images fixes non purement photographiques, généralement des dessins, articulées dans une visée narrative."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4b9e23b-6f66-419d-b6af-4bfab751adc4",
                                                "sense_id": "cf8ed282-dd50-3eee-9984-125757a95410",
                                                "text": "C'est sous la forme d'une bande dessinée de Jean-Louis Tripp que la ville de Moissy-Cramayel a choisi de faire connaître au public les nouveaux locaux de sa médiathèque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74143aaf-0aea-3076-9914-3da7bb3e5d13",
                                        "entry_id": "9827126d-7b6d-3df3-a7ac-cb65a61ac6f8",
                                        "glosses": [
                                            "L’album contenant une bande dessinée."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ceb61ad-30d2-441b-aff5-7bc6a75d3e3a",
                                                "sense_id": "74143aaf-0aea-3076-9914-3da7bb3e5d13",
                                                "text": "Quand tu l’auras finie, tu pourras me prêter ta bande dessinée ?"
                                            },
                                            {
                                                "example_id": "8d1a3a91-cefa-4734-bcc8-638836247085",
                                                "sense_id": "74143aaf-0aea-3076-9914-3da7bb3e5d13",
                                                "text": "Le monde de la bande dessinée est bien plus cruel qu'il n'y paraît : un nombre hallucinant d'albums afflue dans les bouclards chaque mois, et bien rares sont les titres qui parviennent à s'imposer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
