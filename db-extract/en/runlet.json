                ],
                "translations": [
                    {
                        "translation_id": "4d78220f-19ae-4861-9314-07bbde3f4f6e",
                        "source_entry_id": "15d7790b-765a-3e2c-bd6c-ff406bba65de",
                        "source_sense_id": "7edd6cc6-a62a-395e-8670-67ac0a307c76",
                        "source_sense_description": "Flüsschen",
                        "target_lang_word": "Flüsschen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flüsschen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ccd9c346-af9c-3769-bf1b-34e365fc358e",
                                        "entry_id": "b3257b9a-6aec-3f07-affa-4b62ddf17b88",
                                        "glosses": [
                                            "kleiner Fluss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4e1b9ba-501a-4fea-b91d-bc0efa68a17e",
                                                "sense_id": "ccd9c346-af9c-3769-bf1b-34e365fc358e",
                                                "text": "Unsere stampfenden Schuhe werden vom Rauschen eines Flüsschens begleitet."
                                            },
                                            {
                                                "example_id": "b3f44b40-6d37-4a7a-850d-4d50e276065a",
                                                "sense_id": "ccd9c346-af9c-3769-bf1b-34e365fc358e",
                                                "text": "„D[am]it beginnt die planmäßige Peuplierung und systematische Anlage der Fabrikstadt an den Flüßchen Lódka und Jasien.“"
                                            },
                                            {
                                                "example_id": "a46aa1aa-0e2f-48b6-9e8c-b0fb9aece724",
                                                "sense_id": "ccd9c346-af9c-3769-bf1b-34e365fc358e",
                                                "text": "„Still ist es, still, wir hören das Flüßchen murmeln, am anderen Ufer ein schlafendes Dorf.“"
                                            },
                                            {
                                                "example_id": "d30c393e-b767-4292-948a-b21e5ba75968",
                                                "sense_id": "ccd9c346-af9c-3769-bf1b-34e365fc358e",
                                                "text": "„Die Papierfabriken am Flüsschen Wipper verpachtete Bismarck an Geschäftsleute aus einer nahe gelegenen Stadt.“"
                                            },
                                            {
                                                "example_id": "b250f779-fa5f-4c24-abf9-c8bd40a38762",
                                                "sense_id": "ccd9c346-af9c-3769-bf1b-34e365fc358e",
                                                "text": "„Sie hörte lautes Gerede von ein paar Fischern drüben bei den Bootshäusern, und als sie stehen blieb, hörte sie auch, wie die Enten und Eiderenten an der Mündung des Flüsschens erwachten.“"
                                            },
                                            {
                                                "example_id": "294b641f-7d1e-45a5-9da9-7694f6284006",
                                                "sense_id": "ccd9c346-af9c-3769-bf1b-34e365fc358e",
                                                "text": "„Mehr als 2000 junge Männer standen sich an der Tollense gegenüber, einem Flüsschen, das noch immer im gleichen Bett durch saftig grünes Land mäandert wie vor 3000 Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
