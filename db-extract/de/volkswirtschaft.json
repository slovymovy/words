                ],
                "senses": [
                    {
                        "sense_id": "aecfb81b-6e23-386d-a606-1445fddc704b",
                        "entry_id": "360adb41-6404-3099-8c3e-4a2885df1dd1",
                        "glosses": [
                            "die Gesamtwirtschaft eines Staats oder Staatenbunds"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7bcf9ba-4853-4aca-b936-853ebc559f96",
                                "sense_id": "aecfb81b-6e23-386d-a606-1445fddc704b",
                                "text": "Italien ist die drittgrößte Volkswirtschaft in der Eurozone."
                            },
                            {
                                "example_id": "f0fca0af-d3a3-4a19-aaa3-d5ca056dc34a",
                                "sense_id": "aecfb81b-6e23-386d-a606-1445fddc704b",
                                "text": "„Wir haben gesehen, dass die heutigen Volkswirtschaften dadurch gekennzeichnet sind, dass es in ihnen viele Möglichkeiten gibt, Arbeit durch Kapital zu substituieren.“"
                            },
                            {
                                "example_id": "538a0589-fb9d-4744-9905-7f9e0bced321",
                                "sense_id": "aecfb81b-6e23-386d-a606-1445fddc704b",
                                "text": "„Für die deutsche Volkswirtschaft waren die Kolonien in der Südsee von Anfang an bedeutungslos.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "60458caa-a3c7-3265-94f5-d2493afd30fe",
                        "entry_id": "360adb41-6404-3099-8c3e-4a2885df1dd1",
                        "glosses": [
                            "Volkswirtschaftslehre"
                        ],
                        "tags": [
                            "no-plural",
                            "short-form"
                        ],
                        "examples": [
                            {
                                "example_id": "86fe2677-3077-44a3-b170-70d8c361a1ee",
                                "sense_id": "60458caa-a3c7-3265-94f5-d2493afd30fe",
                                "text": "Ich möchte nach der Schule Volkswirtschaft studieren."
                            },
                            {
                                "example_id": "3a40270b-288d-4bfa-8b34-e018dad70e98",
                                "sense_id": "60458caa-a3c7-3265-94f5-d2493afd30fe",
                                "text": "„Auch für Hans Meyer wurde nach dem Studium der Volkswirtschaft eine Weltreise zum Initialerlebnis.“"
                            },
                            {
                                "example_id": "9b70255e-92fa-445f-b502-2f25855892a4",
                                "sense_id": "60458caa-a3c7-3265-94f5-d2493afd30fe",
                                "text": "„Ursprünglich wollte er Mikrobiologie studieren, ist aber am Numerus clausus gescheitert und hat dann einfach Volkswirtschaft studiert und während des ganzen Studiums das Compendium der Volkswirtschaft als Raubdruck gesucht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
