                    "frequency": "Middle",
                    "semantic_group_id": "justice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le conducteur <w>condamné</w> pour excès de vitesse a perdu son permis de conduire."
                        },
                        {
