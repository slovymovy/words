                "senses": [
                    {
                        "sense_id": "aab6df83-4525-3409-89a1-6e2b0f605a31",
                        "entry_id": "734f2c2d-799d-3600-9719-4b71d2c6395c",
                        "glosses": [
                            "Benachrichtigung über die Bedrohung durch Raketen beziehungsweise über einen möglichen Raketenangriff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d385d24b-8846-4a90-aef8-01c6f6fe8b54",
                                "sense_id": "aab6df83-4525-3409-89a1-6e2b0f605a31",
                                "text": "„Der Einsatz von Satelliten zur Raketenwarnung, Nachrichtenübermittlung, Wetterbeobachtung, Navigation und Aufklärung habe nach eigenem Bekunden die Kampfkraft der integrierten Streitkräfte der USA gestärkt.“"
                            },
                            {
                                "example_id": "5bf8ab37-0ff4-49f9-ad7e-de57c7541939",
                                "sense_id": "aab6df83-4525-3409-89a1-6e2b0f605a31",
                                "text": "„Für das Bundeswehrcamp in Kundus wurde am Nachmittag vorübergehend Raketenwarnung ausgerufen, ohne dass es zu einem Angriff kam.“"
                            },
                            {
                                "example_id": "44fa3690-c91b-48d3-ac70-f79e9cc00918",
                                "sense_id": "aab6df83-4525-3409-89a1-6e2b0f605a31",
                                "text": "„In der Stadt und den umliegenden Siedlungen müsse man bei einer Raketenwarnung manchmal schon innerhalb von zehn Sekunden im Bunker sein.“"
                            },
                            {
                                "example_id": "5eda671b-ec4c-4570-9feb-dbafb4516c98",
                                "sense_id": "aab6df83-4525-3409-89a1-6e2b0f605a31",
                                "text": "„Trotz Raketenwarnungen haben sich allein 50.000 Menschen über die Pessach-Feiertage in die Negev-Wüste begeben.“"
                            },
                            {
                                "example_id": "5a368534-0542-4f0c-bfe6-08efa8e85544",
                                "sense_id": "aab6df83-4525-3409-89a1-6e2b0f605a31",
                                "text": "„Mit einer gewollten Dramatik berichten unsere Medien, daß den israelischen Bürgern nach einer Raketenwarnung manchmal nur fünfzehn Sekunden Zeit blieben, einen Bunker zu erreichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
