                    },
                    {
                        "translation_id": "16558e08-1d57-4493-8204-a19eb31826c1",
                        "source_entry_id": "f4f0e210-8a00-33f5-8cc8-a29d5e486387",
                        "source_sense_id": "20378b47-8275-30bc-8649-552343de91ff",
                        "target_lang_word": "bocca di caricamento",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4e47b8d1-d688-497d-8682-d29a52258254",
                        "source_entry_id": "f4f0e210-8a00-33f5-8cc8-a29d5e486387",
                        "source_sense_id": "20378b47-8275-30bc-8649-552343de91ff",
                        "target_lang_word": "Gicht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gicht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a3e51db0-b8d6-3d67-9d13-63075f13afae",
                                        "entry_id": "9d100681-6245-343d-8041-294a3493d2b1",
                                        "glosses": [
                                            "Störung des Purinstoffwechsels mit vermehrter Harnsäurebildung und Ablagerung von Harnsäuresalzen in den Gelenken"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "420f7420-b344-4876-a28a-30967b5f5c20",
                                                "sense_id": "a3e51db0-b8d6-3d67-9d13-63075f13afae",
                                                "text": "Er leidet an Gicht."
                                            },
                                            {
                                                "example_id": "70007367-bfc8-4344-b832-e91533802d98",
                                                "sense_id": "a3e51db0-b8d6-3d67-9d13-63075f13afae",
                                                "text": "„Aber es konnte genausogut die Gicht sein und die Furcht vor den eigenen Schmerzen.“"
                                            },
                                            {
                                                "example_id": "f60bf841-f843-4f78-8fe1-eeb86c6fe104",
                                                "sense_id": "a3e51db0-b8d6-3d67-9d13-63075f13afae",
                                                "text": "„Dieser Senator, der auf alles außer auf sich selbst verzichtet hatte, hegte trotz seines Alters und seiner Gicht eine verliebte Neigung.“"
                                            },
                                            {
                                                "example_id": "fba95154-8745-497e-8ad2-db79b71933ce",
                                                "sense_id": "a3e51db0-b8d6-3d67-9d13-63075f13afae",
                                                "text": "„Von der Gicht gezeichnet, mit offenen Wunden an den Füßen und lange Zeit unfähig, das Haus zu verlassen, arbeitet er aus der riesigen Materialfülle dreißigjähriger Sammelarbeit die Annalen der Welfischen Geschichte, die unter seiner Feder bis zum Jahre 1005 fortschreiten.“"
                                            },
                                            {
                                                "example_id": "37247a51-cb58-4bec-adf6-04c96dd6d87f",
                                                "sense_id": "a3e51db0-b8d6-3d67-9d13-63075f13afae",
                                                "text": "„Sie setzte sich auf das Steinpflaster nieder vor den Fenstern des Bischofs, saß so mit ihren von Gicht gekrümmten Beinen, und der Kopf sank auf die Brust herab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5fcb0aae-6e7b-3711-988d-7976c4ea5fe2",
                                        "entry_id": "9d100681-6245-343d-8041-294a3493d2b1",
                                        "glosses": [
                                            "oberer Teil des Hochofens"
                                        ],
                                        "tags": [
                                            "Hüttenwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d854caf-6dfd-44ee-9667-bd0723ecfabd",
                                                "sense_id": "5fcb0aae-6e7b-3711-988d-7976c4ea5fe2",
                                                "text": "Durch die Gicht, die Öffnung am oberen Schachtende, wird der Hochofen beschickt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "effbb1ac-80a9-4dfd-a041-153b6d26ccf8",
                        "source_entry_id": "f4f0e210-8a00-33f5-8cc8-a29d5e486387",
                        "source_sense_id": "20378b47-8275-30bc-8649-552343de91ff",
                        "target_lang_word": "gueulard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gueulard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b4d8c07-2d7f-3e64-a184-b92397b08a3f",
                                        "entry_id": "a5269329-6b84-3bb9-9650-9928193d61ae",
                                        "glosses": [
                                            "Cheval qui tient la bouche ouverte pour ne pas recevoir le mors."
                                        ],
                                        "tags": [
                                            "Manège"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dea4e339-fe90-4641-9c15-74dd52e9dc9f",
                                                "sense_id": "6b4d8c07-2d7f-3e64-a184-b92397b08a3f",
                                                "text": "Cheval gueulard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3daa14b2-db7f-3310-b088-426bb82ff42c",
                                        "entry_id": "a5269329-6b84-3bb9-9650-9928193d61ae",
                                        "glosses": [
                                            "Qui donne souvent et facilement de la voix."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9306dfcc-4e5d-499a-b7ce-a89f16676270",
                                                "sense_id": "3daa14b2-db7f-3310-b088-426bb82ff42c",
                                                "text": "En rentrant, il allait raconter ça à Courtebaisse, son compagnon de chaîne, un gros rougeaud gueulard, avec qui il s’attrapait pendant leurs sept heures de vie commune."
                                            },
                                            {
                                                "example_id": "137511f0-5586-43e1-9469-bae4c4868ca0",
                                                "sense_id": "3daa14b2-db7f-3310-b088-426bb82ff42c",
                                                "text": "Tandis que je continuais à crier, il dit à Ja..... : « Bon Dieu, qu’il est gueulard ! Foutez-lui un bâillon ! » Roulant ma chemise en boule, Ja..... me l’enfonça dans la bouche et le supplice recommença."
                                            },
                                            {
                                                "example_id": "a7fa0f1e-1c80-4308-af0e-c392aee55045",
                                                "sense_id": "3daa14b2-db7f-3310-b088-426bb82ff42c",
                                                "text": "En ouvrant la fenêtre, il se réappropria en une inspiration la France tout entière : celle de son enfance, accueillante et gueularde, crasseuse et distinguée, fille aînée de l’Église le dimanche, et bouffeuse de curés le lundi. Laïque au lit et religieuse dans ses pâtisseries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1e12831-2794-3218-a4a4-ea1ef8b85d76",
                                        "entry_id": "a5269329-6b84-3bb9-9650-9928193d61ae",
                                        "glosses": [
                                            "Criard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ba91905-1ca0-423e-bc45-3d94ce2d96a8",
                                                "sense_id": "c1e12831-2794-3218-a4a4-ea1ef8b85d76",
                                                "text": "Elle prit son sac sur le pageot couvert de cretonne gueularde et fila en claquant la porte."
                                            },
                                            {
                                                "example_id": "cb0a1a2f-6f2a-412a-bafd-a246173fb0b1",
                                                "sense_id": "c1e12831-2794-3218-a4a4-ea1ef8b85d76",
                                                "text": "Et plus haut, joyeusement gueulards, les chromos de M. Hugo d’Alési groupent quelques mules aux pieds légers dans des montagnes évidemment thermales, installent sur les routes auverpines de grands bœufs blancs tachés de ce que vous savez, et, sous d'obligeants clairs de lune, agenouillent des Bretons échappés du Pardon de Ploërmel aux seuils d'églises dont le roman-gothique tire sur la Renaissance…"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gueulard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97668fd5-6b9b-3d56-9d40-f1847fd9386d",
                                        "entry_id": "8fec7c38-311e-38c7-9240-af76981f2739",
                                        "glosses": [
                                            "Personne qui pousse la gourmandise à l’excès."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4641387d-99c3-381d-ba79-03fa3db20b97",
                                        "entry_id": "8fec7c38-311e-38c7-9240-af76981f2739",
                                        "glosses": [
                                            "Personne qui gueule."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da79e86d-f64a-48f1-9905-139c7b3986ce",
                                                "sense_id": "4641387d-99c3-381d-ba79-03fa3db20b97",
                                                "text": "D’ailleurs, les dissidences s’effacent devant la gravité des événements, et ceux mêmes qu’on a traités de gueulards sont recherchés, à cette heure, par les doctrinaires en quête d’hommes d’action.\nC’est bon, les gueulards, devant les régiments muets et hésitants. Ce sont les indisciplinés qui font plier la discipline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76f44c70-77b2-3255-a5ff-c4fd4b90cce9",
                                        "entry_id": "8fec7c38-311e-38c7-9240-af76981f2739",
                                        "glosses": [
                                            "Porte-voix dont le tube était extensible à volonté, et qui servait à communiquer d'un bateau à un autre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7e92bef-48ca-4631-9eda-8e6490f29fbc",
                                                "sense_id": "76f44c70-77b2-3255-a5ff-c4fd4b90cce9",
                                                "text": "À une trentaine de mètres du galion, le capitaine du port se tenait près des feux de proue. — Identifiez-vous ! cria-t-il dans un gueulard — Le Bénéfice doré, de Tal Verrar ! répondit quelqu’un au milieu du pont. —"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc7ce666-c74e-3603-b784-39e447361aab",
                                        "entry_id": "8fec7c38-311e-38c7-9240-af76981f2739",
                                        "glosses": [
                                            "Alarme en cas d’effraction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "gueulard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b618269-1a6e-3f2c-bbad-c84bfc42ac22",
                                        "entry_id": "c4789817-5452-3a91-812b-a8fbd3d825d3",
                                        "glosses": [
                                            "Ouverture d’un haut fourneau par laquelle on entonne le charbon et le minerai."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98d6850c-e61d-47ef-9124-503cf3e4af0f",
                                                "sense_id": "6b618269-1a6e-3f2c-bbad-c84bfc42ac22",
                                                "text": "On laissa descendre le fourneau jusqu'à 7 ou 8 mètres du niveau du gueulard, puis on le remplit, d'abord d'une charge blanche à 4500 kil. de coke mêlé de laitier réfractaire en pierrailles, puis de charges à même dose de coke, 2700 de mine et 600 kil. de laitier."
                                            },
                                            {
                                                "example_id": "2984a3d5-8960-4fde-b22f-b9fdc7cd29e3",
                                                "sense_id": "6b618269-1a6e-3f2c-bbad-c84bfc42ac22",
                                                "text": "Sous le gueulard, la terre se muait en fonte à 1800°C, dans un déchaînement de chaleur qui occasionnait des morts et des fiertés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "459dbaa3-e697-319d-a0c8-b7dd1f781c62",
                                        "entry_id": "c4789817-5452-3a91-812b-a8fbd3d825d3",
                                        "glosses": [
                                            "Bouche d’un égout."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ecf3615e-4eb1-30e9-bde0-de10d288b0a7",
                                        "entry_id": "c4789817-5452-3a91-812b-a8fbd3d825d3",
                                        "glosses": [
                                            "Four à bois, pièce en métal par laquelle passe la flamme de chauffe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "283bd01d-f476-41d5-bbfa-d982089b9872",
                                                "sense_id": "ecf3615e-4eb1-30e9-bde0-de10d288b0a7",
                                                "text": "Les flammes du gueulard et le gros soleil plombant sur le jardin ont laissé dans sa poitrine un feu qui dévore le peu d’air que sa gorge laisse pénétrer à chaque appel désespéré de ses bronches irritées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b44fa2a-4e3c-3f9f-a1d9-4eda3da0e150",
                                        "entry_id": "c4789817-5452-3a91-812b-a8fbd3d825d3",
                                        "glosses": [
                                            "Buire en forme de casque renversé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d261499-cce9-4ffb-b21d-35f4fdd8b450",
                                                "sense_id": "5b44fa2a-4e3c-3f9f-a1d9-4eda3da0e150",
                                                "text": "Un gueulard en porcelaine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "02f7bf71-eba9-30a5-9583-8854f7f2ba3d",
                                        "entry_id": "c4789817-5452-3a91-812b-a8fbd3d825d3",
                                        "glosses": [
                                            "Arme à feu à canon évasé."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a03ca61-a07d-437c-905c-bee7a9bcdbbf",
                                                "sense_id": "02f7bf71-eba9-30a5-9583-8854f7f2ba3d",
                                                "text": "« A quoi sert ce tuyau que vous avez là ?…\n— Ce tuyau n’est pas un tuyau.\n— Est-ce donc un gueulard ? »\nEt le berger entendait par là une sorte de vieux pistolet à canon évasé.\n« Non, dit le juif, c’est une lunette. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
