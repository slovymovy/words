                "word": "demi-teinte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c7896aae-9ed5-4acf-9bcd-af34f2ea370e",
                        "entry_id": "8f8290ee-51c4-3ed5-8681-ff831f4a85e5",
                        "tags": [
