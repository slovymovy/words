                    },
                    {
                        "translation_id": "ca33610d-38a3-45ff-9612-49a7b4bc17b4",
                        "source_entry_id": "700f34b7-1b59-3442-8564-2713f51e5f5f",
                        "source_sense_id": "03b8b263-5350-33cc-8fca-ddcc87a6ac1d",
                        "source_sense_description": "member of the subtribe Australopithecina",
                        "target_lang_word": "australopiteco",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "australopiteco",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "67f750dc-a0a2-32e3-ba0e-bb45a45b1182",
                                        "entry_id": "85ae3342-7d97-3381-b95c-50279083488b",
                                        "glosses": [
                                            "gênero de hominídeo (Australopithecus, espécies incluem A. garhi, A. africanus, A. sediba, A. afarensis, A. anamensis, A. bahrelghazali e A. deyiremeda) que viveu no leste e sul da África durante o Plioceno e o Pleistoceno Inferior (de 4,2 milhões até cerca de 1,9 milhões atrás), considerado um dos ancestrais do gênero Homo (que inclui os humanos modernos, em relação ao qual tinha um cérebro 35% menor e trinta e dois dentes como estes), media de 1,2 a 1,4 m de altura, tinha bipedalismo desenvolvido e presume-se que seu corpo era totalmente cobertos de pelos, mais parecidos com chimpanzés e bonobos"
                                        ],
                                        "tags": [
                                            "Paleontologia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "434418ed-795d-43c7-8b87-26a71d43a7e0",
                                                "sense_id": "67f750dc-a0a2-32e3-ba0e-bb45a45b1182",
                                                "text": "O paleontólogo francês Yves Coppens, um dos \"pais\" do australopiteco Lucy, cuja descoberta aprofundou o conhecimento sobre as origens da humanidade, morreu nesta quarta-feira, aos 87 anos."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
