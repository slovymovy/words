                        "entry_id": "d6d82942-0436-395c-8851-2de11e15cbb9",
                        "glosses": [
                            "Extrême susceptibilité ou méfiance."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "e5ea49d8-e2aa-4b11-9dbb-b0c5da340a80",
                                "sense_id": "884e3f98-5709-30e0-9775-0d6a2953a46c",
                                "text": "Halte à la parano !\nClimat de défiance, théorie du complot… Au boulot, dans le couple ou entre amis, nous sommes tous gagnés par une ambiance de suspicion ! D’où vient ce climat de parano ? Etes-vous contaminé ? Comment gérer un méfiant chronique ?"
                            }
                        ]
                    }
