                "senses": [
                    {
                        "sense_id": "3310d775-792e-32f2-8500-fc98494a3109",
                        "entry_id": "42fc885a-1d40-375c-846b-7bb775b46013",
                        "glosses": [
                            "durch das Geruchsorgan wahrgenommener typisch feiner Geruch von dunklem Wildfleisch oder aber bereits beginnender Verwesungsgeruch bei starkem Geruch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc384689-4fdb-48d8-b575-09bf9ceb4b1d",
                                "sense_id": "3310d775-792e-32f2-8500-fc98494a3109",
                                "text": "„Ein Zeichen von unsachgemäßer Lagerung oder Verarbeitung ist hingegen starker Wildgeruch und -geschmack, von dem vor allem früher Wildgerichte überzogen waren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8429b7a8-e8bc-3d6a-945b-ac4f7dc8e84c",
                        "entry_id": "42fc885a-1d40-375c-846b-7bb775b46013",
                        "glosses": [
                            "wahrnehmbarer Geruch nach Wild, der als Spur für einen Jagdhund oder eine Raubtier dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b94feb1a-d882-4e62-9598-9c99512718b4",
                                "sense_id": "8429b7a8-e8bc-3d6a-945b-ac4f7dc8e84c",
                                "text": "„Ein sandiger Feldweg führt schnurgerade zum Weiher, links und rechts vom Weg weite Gemüsefelder mit viel Ablenkung durch Wildgeruch.“"
                            },
                            {
                                "example_id": "0b92b525-e8e0-42fe-be27-550032c3464f",
                                "sense_id": "8429b7a8-e8bc-3d6a-945b-ac4f7dc8e84c",
                                "text": "„Sein Jagdinstinkt wurde durch genetische Auslese modifiziert: womit er durch den Wildgeruch von seiner Arbeit nicht abgelenkt wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8a78e273-86c3-3444-a938-72aaf52aafab",
                        "entry_id": "42fc885a-1d40-375c-846b-7bb775b46013",
                        "glosses": [
                            "Eigengeruch bei Wildtieren; Geruchsstoffe die von Drüsen abgegeben werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d46186a-83b6-472c-b69c-7dd35cbeeec7",
                                "sense_id": "8a78e273-86c3-3444-a938-72aaf52aafab",
                                "text": "„Beim Rüden sind die Stinkdrüsen stark ausgebildet, so dass ein männliches Frettchen einen strengen Wildgeruch verbreitet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
