                        ],
                        "form": "ajoutes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "baa133bb-2de9-323d-931a-4e3aaa83dbc6",
                        "entry_id": "5acb8a4f-dc3d-3f99-884b-dfb564fa20e4",
                        "glosses": [
                            "Annexe, supplément, quelque chose que l’on rajoute après coup."
                        ],
                        "tags": [
                            "Belgique",
                            "Picardie",
                            "Nord-Pas-de-Calais"
                        ],
                        "examples": [
                            {
                                "example_id": "ca40ffce-d466-4eb8-825e-8cd8ffcf699f",
                                "sense_id": "baa133bb-2de9-323d-931a-4e3aaa83dbc6",
                                "text": "Il y a des ajoutes à mettre à ce texte."
                            },
                            {
                                "example_id": "1592328b-bd03-409c-8d76-509cee965b0f",
                                "sense_id": "baa133bb-2de9-323d-931a-4e3aaa83dbc6",
                                "text": "Nous devons encore faire des ajoutes à cette maison."
                            },
                            {
                                "example_id": "c74a7f1a-0302-4f10-a43a-c17bb34c3b04",
                                "sense_id": "baa133bb-2de9-323d-931a-4e3aaa83dbc6",
                                "text": "Cette ajoute du XVIᵉ siècle rompt l’unité de la façade, mais elle en fait ressortir en même temps les dimensions et l’étrange disposition."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
