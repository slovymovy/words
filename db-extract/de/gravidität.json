                "senses": [
                    {
                        "sense_id": "d9c6d80c-942d-3363-aab8-33744d1ebfdc",
                        "entry_id": "b8d9694e-0c58-30fa-8ba9-29987b4bcde0",
                        "glosses": [
                            "Zustand einer Frau von der Empfängnis bis zur Geburt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8bd79499-8a4a-4df0-b6a7-09a2804b393e",
                                "sense_id": "d9c6d80c-942d-3363-aab8-33744d1ebfdc",
                                "text": "„Aber heute kann ich Ihnen nur die Mitteilung machen, dass Sie in die Gravidität geraten sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "985f761b-c8f3-3381-a299-83fff5248c61",
                        "entry_id": "b8d9694e-0c58-30fa-8ba9-29987b4bcde0",
                        "glosses": [
                            "Zustand eines weiblichen Tiers von der Empfängnis bis zur Geburt"
                        ],
                        "tags": [
                            "Veterinärmedizin"
                        ],
                        "examples": [
                            {
                                "example_id": "e55c3123-d883-4750-891a-cf2e8bb64bc0",
                                "sense_id": "985f761b-c8f3-3381-a299-83fff5248c61",
                                "text": "„Als Trächtigkeit oder Gravidität bezeichnet man das Austragen der Nachkommen in der Gebärmutter bei weiblichen lebendgebärenden Tieren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "10df806d-6dc3-4536-98ae-54a7819eb672",
                        "source_entry_id": "b8d9694e-0c58-30fa-8ba9-29987b4bcde0",
                        "source_sense_id": "d9c6d80c-942d-3363-aab8-33744d1ebfdc",
                        "source_sense_description": "Medizin: Zustand einer Frau von der Empfängnis bis zur Geburt",
                        "target_lang_word": "pregnancy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pregnancy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09b64bf6-1227-3706-8650-4daa267350e2",
                                        "entry_id": "c8244267-da72-3509-a559-ea18d5187948",
                                        "glosses": [
                                            "The condition of being pregnant; an instance of this."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cda46db-58ba-4d6e-b373-f8ba12258a2c",
                                                "sense_id": "09b64bf6-1227-3706-8650-4daa267350e2",
                                                "text": "News that the duchess is in the \"very early stages\" of pregnancy with the third-in-line to the throne was officially released after she was taken to the King Edward VII hospital in central London, suffering from hyperemesis gravidarun, very acute morning sickness."
                                            },
                                            {
                                                "example_id": "b2b1b7fe-c8dc-4d9f-aaf4-22603daa0719",
                                                "sense_id": "09b64bf6-1227-3706-8650-4daa267350e2",
                                                "text": "Viable non-malformed singleton pregnancies were selected for cerebellar measurements; transcerebellar diameter, (TCD), left and right cerebellar diameters (LCD, RCD)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc875bae-8cde-32ee-9a52-c9a2ca127fb5",
                                        "entry_id": "c8244267-da72-3509-a559-ea18d5187948",
                                        "glosses": [
                                            "The period of time this condition prevails."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "203f0162-573f-3c0c-93d4-65b75fc89fbf",
                                        "entry_id": "c8244267-da72-3509-a559-ea18d5187948",
                                        "glosses": [
                                            "The progression of stages from conception to birth."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "26091586-a86a-4d21-9dd1-62f492f5bfca",
                        "source_entry_id": "b8d9694e-0c58-30fa-8ba9-29987b4bcde0",
                        "source_sense_id": "d9c6d80c-942d-3363-aab8-33744d1ebfdc",
                        "source_sense_description": "Medizin: Zustand einer Frau von der Empfängnis bis zur Geburt",
                        "target_lang_word": "gravidité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gravidité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "763df2f6-b7d1-314a-9b6f-b6b50a2608d0",
                                        "entry_id": "6d31f51d-3ec6-314a-acb6-2988f6c46cd9",
                                        "glosses": [
                                            "État de l'utérus, de la femelle gravide ; grossesse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21aeb7b1-5592-4e88-9bba-e1c31b8eedb2",
                                                "sense_id": "763df2f6-b7d1-314a-9b6f-b6b50a2608d0",
                                                "text": "La grande majorité des biches sont gravides chaque année. En outre, la gravidité des bichettes semblent en forte augmentation. Les causes de ce phénomène sont liées aux ressources alimentaires du milieu de vie : […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f77807e-68e6-4e5d-9d08-4fd561939d4b",
                        "source_entry_id": "b8d9694e-0c58-30fa-8ba9-29987b4bcde0",
                        "source_sense_id": "d9c6d80c-942d-3363-aab8-33744d1ebfdc",
                        "source_sense_description": "Medizin: Zustand einer Frau von der Empfängnis bis zur Geburt",
                        "target_lang_word": "беременность",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "беременность",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "85aa5874-2574-386c-b7f6-be802cf425c4",
                                        "entry_id": "3302e893-2a5a-3d67-a5db-a10536da7139",
                                        "glosses": [
                                            "биол. физиологический процесс развития плода [3] из оплодотворённой яйцеклетки в организме женщины или самки некоторых животных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c07b565-b527-460c-a526-a943b9a0f674",
                                                "sense_id": "85aa5874-2574-386c-b7f6-be802cf425c4",
                                                "text": "При оплодотворении яйцеклетка внедряется (имплантируется) в подготовленную слизистую оболочку — начинается беременность."
                                            },
                                            {
                                                "example_id": "12472127-95f9-4723-88fa-f3096beb80d3",
                                                "sense_id": "85aa5874-2574-386c-b7f6-be802cf425c4",
                                                "text": "Именно морские коньки этого вида (их длина — 14 сантиметров) окрашены особенно пёстро, да ещё и разрисованы в крапинку или полоску. Их ближайшие родичи, колюшка и игла-рыба, выглядят вполне обычно и потому не так привлекательны. Как протекает беременность у самцов? Даже сейчас зоологи затрудняются сказать, сколько всего видов морских коньков насчитывается."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0469af82-fc99-36ab-b93a-4f9c83afa4b6",
                                        "entry_id": "3302e893-2a5a-3d67-a5db-a10536da7139",
                                        "glosses": [
                                            "физиол. состояние по значению прил. беременный; состояние женщины, самки некоторых животных в период такого процесса с момента оплодотворения до родов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1007f1ae-eeba-490d-b6cd-ecec1f719c31",
                                                "sense_id": "0469af82-fc99-36ab-b93a-4f9c83afa4b6",
                                                "text": "Она замолчала, как будто находя неприличным говорить при Пьере про свою беременность, тогда как в этом и состояла сущность дела."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
