{
    "word_family": [
        "benignly",
        "benignity",
        "benignancy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f3a7b63c-6625-3b19-9764-a47ab42d6986",
                    "sense_definition": "Not posing any serious threat to health; not cancerous or aggressive.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "medical status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor confirmed that the growth was a <w>benign</w> tumor and required no further treatment.",
                            "target_lang_translations": {
                                "ru": "Врач подтвердил, что новообразование было <w>доброкачественной</w> опухолью и не требовало дальнейшего лечения."
                            }
                        },
                        {
                            "text": "Patients are often relieved to learn that their condition is <w>benign</w> rather than life-threatening.",
                            "target_lang_translations": {
                                "ru": "Пациенты часто испытывают облегчение, узнав, что их состояние <w>доброкачественное</w>, а не опасное для жизни."
                            }
                        }
                    ],
                    "synonyms": [
                        "non-malignant"
                    ],
                    "antonyms": [
                        "malignant"
                    ],
                    "common_phrases": [
                        "benign tumor",
                        "benign condition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не представляющий серьезной угрозы для здоровья; не раковый или не агрессивный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доброкачественный",
                                "target_lang_sense_clarification": "опухоль или заболевание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e10c2ff1-b51e-3af6-8a40-04b7e15943f4",
                    "sense_definition": "Kind, gentle, and well-meaning in disposition or manner.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "personality traits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man had a <w>benign</w> smile that immediately put the nervous children at ease.",
                            "target_lang_translations": {
                                "ru": "У старика была <w>добрая</w> улыбка, которая сразу успокоила нервничающих детей."
                            }
                        },
                        {
                            "text": "Under his <w>benign</w> influence, the once hostile department began to work together harmoniously.",
                            "target_lang_translations": {
                                "ru": "Под его <w>благотворным</w> влиянием некогда враждебный отдел начал работать слаженно."
                            }
                        }
                    ],
                    "antonyms": [
                        "malign"
                    ],
                    "common_phrases": [
                        "benign smile",
                        "benign influence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Добрый, мягкий и благожелательный по характеру или манере поведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добрый",
                                "target_lang_sense_clarification": "о человеке или улыбке"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "о характере или влиянии"
                            },
                            {
                                "target_lang_word": "благожелательный",
                                "target_lang_sense_clarification": "настроенный к другим"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43208439-2da0-39a7-8cc6-dd9d263bc182",
                    "sense_definition": "Mild and favorable, especially in regards to weather or climate.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "environmental conditions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The island enjoys a <w>benign</w> climate that allows tropical plants to thrive all year round.",
                            "target_lang_translations": {
                                "ru": "На острове <w>благоприятный</w> климат, который позволяет тропическим растениям процветать круглый год."
                            }
                        },
                        {
                            "text": "Sailors welcomed the <w>benign</w> weather after weeks of battling fierce storms at sea.",
                            "target_lang_translations": {
                                "ru": "Моряки приветствовали <w>мягкую</w> погоду после недель борьбы с яростными штормами в море."
                            }
                        }
                    ],
                    "common_phrases": [
                        "benign climate",
                        "benign conditions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий и благоприятный, особенно в отношении погоды или климата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "благоприятный",
                                "target_lang_sense_clarification": "о климате или условиях"
                            },
                            {
                                "target_lang_word": "мягкий",
                                "target_lang_sense_clarification": "о погоде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07106950-e94b-39e8-8e74-c53adba6c8b6",
                    "sense_definition": "Not harmful or damaging to the environment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "environmental conditions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is switching to an ozone-<w>benign</w> refrigerant to reduce its ecological footprint.",
                            "target_lang_translations": {
                                "ru": "Компания переходит на озоно-<w>безопасный</w> хладагент, чтобы уменьшить свой экологический след."
                            }
                        },
                        {
                            "text": "Finding environmentally <w>benign</w> alternatives to plastic remains a major challenge for scientists.",
                            "target_lang_translations": {
                                "ru": "Поиск экологически <w>безвредных</w> альтернатив пластику остается серьезной задачей для ученых."
                            }
                        }
                    ],
                    "common_phrases": [
                        "environmentally benign",
                        "ozone-benign"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не вредный и не наносящий ущерба окружающей среде."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безвредный",
                                "target_lang_sense_clarification": "для экологии"
                            },
                            {
                                "target_lang_word": "безопасный",
                                "target_lang_sense_clarification": "для окружающей среды"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}