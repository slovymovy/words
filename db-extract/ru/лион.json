                                        "entry_id": "374c7431-a2f4-334e-97bb-f8801ee8cacd",
                                        "glosses": [
                                            "The third largest city in France; the capital of Auvergne-Rhône-Alpes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a1e3640-c562-4425-98e2-f3206c96784d",
                                                "sense_id": "2fc3d408-01c1-3996-a28a-1e1b548ab1df",
                                                "text": "Lyon was not a very cheerful town at night. It was a big, heavy, solid-money town, probably fine if you had money and liked that sort of town. For years I had heard about the wonderful chicken in the restaurants there, but we had eaten mutton instead."
                                            }
                                        ]
                                    },
