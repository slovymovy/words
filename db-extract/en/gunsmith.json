                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c74a7601-b2a9-4745-80cf-62b88e4bce5f",
                                                "sense_id": "2b94104d-68d6-318e-9774-a93faf89f4cf",
                                                "text": "In Ferlach werden seit dem Jahr 1878 Büchsenmacher ausgebildet."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "178869ca-b126-394c-98e6-a28b8f52ed22",
                                        "entry_id": "e8cf6a4a-c77d-3872-89f5-eff07392f25c",
                                        "glosses": [
                                            "Vater eines neugeborenen Mädchens; Vater, der nur Töchter gezeugt hat"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2006fbf-b8d5-42f2-9598-1d56642771de",
                                                "sense_id": "178869ca-b126-394c-98e6-a28b8f52ed22",
                                                "text": "„Mein Vater bezeichnete sich selbst, nach meiner Geburt und der enttäuschenden Feststellung, daß ich ein lebendgeborenes Mädchen war, als Büchsenmacher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d531dbf5-c272-4d54-8a3e-723321343de4",
                        "source_entry_id": "0a1d99de-2419-3558-82a4-a13e9417df35",
