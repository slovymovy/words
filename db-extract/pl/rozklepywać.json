                                                "text": "Es müssen noch Löcher in den Stoff ausgeschlagen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"6b\""
                                    },
                                    {
                                        "sense_id": "6dad9365-c693-30ef-a888-288f95c0b28b",
                                        "entry_id": "767edf01-f777-3f91-8097-cad7dd20d72a",
                                        "glosses": [
                                            "etwas nicht entgegennehmen, ablehnen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "781b4ab0-544e-456f-8358-d317b6500bb2",
                                                "sense_id": "6dad9365-c693-30ef-a888-288f95c0b28b",
                                                "text": "Ich kann Julianes Gunst einfach nicht gewinnen. Jedes Geschenk, das ich ihr machen will, schlägt sie aus."
                                            },
                                            {
                                                "example_id": "1a39fcd5-4aec-4b41-9570-ef87dea3bc61",
                                                "sense_id": "6dad9365-c693-30ef-a888-288f95c0b28b",
                                                "text": "Obwohl ich ihm gern geholfen hätte, konnte ich nicht anders, als Peters Bitten auszuschlagen."
                                            },
                                            {
                                                "example_id": "cee82486-bb4a-4f17-b308-f4b66daa0b9b",
                                                "sense_id": "6dad9365-c693-30ef-a888-288f95c0b28b",
                                                "text": "„Von da an konnte sie sich Film- und Fernsehrollen aussuchen, zwei Hollywood-Angebote schlug sie jedoch aus.“"
                                            }
                                        ],
