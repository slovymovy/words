                                "example_id": "ac1b0ca4-9175-47e5-a7a1-47e72612b790",
                                "sense_id": "afce61c2-93e4-3987-90f9-1142857874cc",
                                "text": "Overal primitieve kunst met zwaargeschapen figuren, en op de bank kleurrijke Afrikaanse doeken."
