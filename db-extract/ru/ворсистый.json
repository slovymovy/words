                                                "sense_id": "01d6f61b-c94d-323e-9d08-5406edab9604",
                                                "text": "Er hatte haarige, ungewaschene Füße."
                                            },
                                            {
                                                "example_id": "f19bf920-f59a-4e29-a753-1e090b2d8469",
                                                "sense_id": "01d6f61b-c94d-323e-9d08-5406edab9604",
                                                "text": "„Der Anblick einer haarigen Spinne, die sich auf einem Palmenstamm sonnte,erfüllte ihn mit Schrecken und Glück.“"
                                            },
                                            {
                                                "example_id": "51fb39f2-5573-48e2-bd3f-a2ad0da06161",
                                                "sense_id": "01d6f61b-c94d-323e-9d08-5406edab9604",
                                                "text": "„Am Anfang sei der Mensch ebenso haarig wie der haarigste Affe gewesen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d658815f-a93b-3c88-a8ed-312d4ecf98a4",
