                "senses": [
                    {
                        "sense_id": "49fd1a41-ab1a-3fba-824d-8c85ee162b0e",
                        "entry_id": "c7abe795-6f6e-3e21-8a45-eca9d94d9d28",
                        "glosses": [
                            "leitende (geistliche) Funktionsträgerin einer evangelischen Synode"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "408d383e-76f9-4393-aa5e-50f9ae2f913d",
                                "sense_id": "49fd1a41-ab1a-3fba-824d-8c85ee162b0e",
                                "text": "„Die Präses der Synode der Evangelischen Kirche in Deutschland (EKD), Anna-Nicole Heinrich, forderte ebenfalls eine zügige und sichere Verteilung.“"
                            },
                            {
                                "example_id": "0f0ff77b-2854-431a-aea9-eb8f36bbc2eb",
                                "sense_id": "49fd1a41-ab1a-3fba-824d-8c85ee162b0e",
                                "text": "„Predigt und Liturgie hielten als Vertreter der christlichen Konfessionen der Kölner Kardinal Rainer Maria Woelki und die Präses der Evangelischen Kirche von Westfalen, Annette Kurschus, sowie der griechisch-orthodoxe Metropolit von Deutschland Augoustinos Lambardakis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
