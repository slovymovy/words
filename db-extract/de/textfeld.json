                "senses": [
                    {
                        "sense_id": "7455fedc-de31-369b-a56f-f89ceab5d988",
                        "entry_id": "9952673b-17f3-3fc6-836c-0694143239b2",
                        "glosses": [
                            "grafisches Element, in das sich Text eintragen lässt"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "d4349e02-1029-45af-82e4-67fe408da87a",
                                "sense_id": "7455fedc-de31-369b-a56f-f89ceab5d988",
                                "text": "„Textfelder sind das meistgenutzte Steuerelement in Formularen und Berichten.“"
                            },
                            {
                                "example_id": "7ea3fca1-539b-422f-92d1-1142e477cdc2",
                                "sense_id": "7455fedc-de31-369b-a56f-f89ceab5d988",
                                "text": "„Bei der Tastatureingabe in ein Textfeld kann es sinnvoll sein, von vornherein bestimmte Zeichen auszuschließen oder zuzulassen.“"
                            },
                            {
                                "example_id": "31182138-5fdd-469f-85bf-f2eab6821d84",
                                "sense_id": "7455fedc-de31-369b-a56f-f89ceab5d988",
                                "text": "„In der linken oberen Ecke taucht ein 100 Pixel breites und 20 Pixel hohes Textfeld mit gelbem Hintergrund auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
