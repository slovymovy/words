                ],
                "senses": [
                    {
                        "sense_id": "fb9e908b-6b5e-30c2-b7e9-0078c19beb3d",
                        "entry_id": "39d0d348-9e95-3035-82dd-fdb061de05c0",
                        "glosses": [
                            "The northern side of a building, street, area etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "15c592f5-a97b-4cba-b5fe-bf6b1cffb565",
                                "sense_id": "fb9e908b-6b5e-30c2-b7e9-0078c19beb3d",
                                "text": "It consists of three stories with two gables both on the south- and northsides."
                            },
                            {
                                "example_id": "9aa97e18-8a19-4c9b-9eb9-ca25092d490a",
                                "sense_id": "fb9e908b-6b5e-30c2-b7e9-0078c19beb3d",
                                "text": "The retail section had two divisions - the southside and the northside - with Grafton Street being the main shopping street of the southside, and Henry Street and Moore Street the flagships of the northside."
                            },
                            {
                                "example_id": "f5617eb2-fb21-4464-96dc-b161dfc7e286",
                                "sense_id": "fb9e908b-6b5e-30c2-b7e9-0078c19beb3d",
                                "text": "Alderman Joseph Greenstein, a member of the Minneapolis Qty Council representing the northside, published a ten-point proposal for improving the northside area."
                            },
                            {
                                "example_id": "fa634e87-77c2-40f4-83b8-c09e326d3143",
                                "sense_id": "fb9e908b-6b5e-30c2-b7e9-0078c19beb3d",
                                "text": "First, it is the access point to the northside of the famous Nauset Cut."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6201c9ae-6a80-4958-8aca-c62ee3e06c76",
                        "source_entry_id": "39d0d348-9e95-3035-82dd-fdb061de05c0",
                        "source_sense_id": "fb9e908b-6b5e-30c2-b7e9-0078c19beb3d",
                        "source_sense_description": "the northern side of a building, street, area, etc.",
                        "target_lang_word": "noordkant",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "noordkant",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b89adf7f-316a-3a30-b7de-bf7899788019",
                                        "entry_id": "9dc9a242-a22a-33eb-b603-829aec636058",
                                        "glosses": [
                                            "de kant die in het noorden gelegen is."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "732a4ed5-6eb2-4f95-9c60-4eee2e292260",
                                                "sense_id": "b89adf7f-316a-3a30-b7de-bf7899788019",
                                                "text": "Aan de noordkant van de stad ligt een groot bos."
                                            },
                                            {
                                                "example_id": "23e7c67f-2766-4d60-bb8f-d815bcbcd5cb",
                                                "sense_id": "b89adf7f-316a-3a30-b7de-bf7899788019",
                                                "text": "Het Giro-peloton neemt de befaamde berg vanaf de noordkant. Nooit eerder in de wielergeschiedenis eindigde een etappe op de Galibier, nadat de renners de col vanaf de noordzijde hadden beklommen."
                                            },
                                            {
                                                "example_id": "9f68a010-3416-45ae-9a29-e7117ff65e0f",
                                                "sense_id": "b89adf7f-316a-3a30-b7de-bf7899788019",
                                                "text": "Het Grand Hotel was al in 1893 klaar, het sanatorium tien jaar later, aan de zuidkant van de spoorweg werden grote villa's gebouwd, de huizen van de arbeiders kwamen aan de noordkant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
