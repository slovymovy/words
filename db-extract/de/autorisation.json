                "translations": [
                    {
                        "translation_id": "cf0758a0-f968-4a7a-908d-3ea6ffaf9615",
                        "source_entry_id": "704a1d15-ac29-3100-b6b0-f44d087861af",
                        "source_sense_id": "0ef415d2-2002-3452-9407-2d4ea27caa4e",
                        "source_sense_description": "Erteilung einer Vollmacht oder Befugnis",
                        "target_lang_word": "authorization",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "authorization",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                        "entry_id": "df57cc17-28cf-3254-8bde-aaa8469e4096",
                                        "glosses": [
                                            "An act of authorizing."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8f375f1-762b-4f4c-b01f-8cb632167e11",
                                                "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                                "text": "Our proposal thus envisages a new procedure for the authorization of experimental program"
                                            },
                                            {
                                                "example_id": "06da4cc9-4f25-4d6d-b4d2-5cc7eca36085",
                                                "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                                "text": "His authorization of decapitation targeting is incompatible with his theory of limited war"
                                            },
                                            {
                                                "example_id": "7307111a-49a5-4ca1-a82a-c7cb07eed43b",
                                                "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                                "text": "Its purpose is to govern the authorization of credit institutions and the provision of financial services throughout the EC."
                                            },
                                            {
                                                "example_id": "6e5b42fa-3c06-418d-915f-6f2a34adc22b",
                                                "sense_id": "540ca18b-c4a8-341c-93b6-c164074a34aa",
                                                "text": "She pushed buttons at a new, small oval kind of telescreen, quickly gathering together the high-level authorizations it had taken hours of preparation to collect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23348603-c12c-3837-abbe-22c169ad3ea8",
                                        "entry_id": "df57cc17-28cf-3254-8bde-aaa8469e4096",
                                        "glosses": [
                                            "The state of being authorized to do something or to be somewhere; formally granted permission."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50ffdb3d-6ced-4865-b4f8-05cffabe97e0",
                                                "sense_id": "23348603-c12c-3837-abbe-22c169ad3ea8",
                                                "text": "I've got authorization. Call the office and you'll see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071263c4-2f1c-34dd-bbfd-37cdce32af88",
                                        "entry_id": "df57cc17-28cf-3254-8bde-aaa8469e4096",
                                        "glosses": [
                                            "A document giving formal sanction, permission or warrant."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90b1587-bb20-4306-924a-aaaddce04f46",
                                                "sense_id": "071263c4-2f1c-34dd-bbfd-37cdce32af88",
                                                "text": "Can I see your authorization?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21f07119-3fbe-3349-af34-9bdb84cb5862",
                                        "entry_id": "df57cc17-28cf-3254-8bde-aaa8469e4096",
                                        "glosses": [
                                            "Permission, possibly limited, to spend funds for a specific budgetary purpose."
                                        ],
                                        "tags": [
                                            "British",
                                            "English",
                                            "Oxford",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff3c0633-eb64-4f11-8633-c4b7d60cca00",
                                                "sense_id": "21f07119-3fbe-3349-af34-9bdb84cb5862",
                                                "text": "We've had the authorization for years, but we've never gotten an appropriation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
