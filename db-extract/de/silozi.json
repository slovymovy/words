                ],
                "senses": [
                    {
                        "sense_id": "0e0e1ded-2e55-33d9-821d-72b782736985",
                        "entry_id": "960b329f-fe28-3bbb-bed1-b94bbd40a12b",
                        "glosses": [
                            "eine in Sambia und Simbabwe vom Volk der Lozi gesprochene Bantusprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "058811c5-2169-40a2-8b2d-0c9b0b0e45ad",
                                "sense_id": "0e0e1ded-2e55-33d9-821d-72b782736985",
                                "text": "Hast Du in Afrika auch Silozi gelernt?"
                            },
                            {
                                "example_id": "d6292d5c-3122-450f-ae2c-d0b7074231bd",
                                "sense_id": "0e0e1ded-2e55-33d9-821d-72b782736985",
                                "text": "Die Hauptstämme (Massubia und Mafwe) sind mit denen in Zambia verwandt, Silozi ist nach wie vor Lingua franca."
                            },
                            {
                                "example_id": "6827cb02-8e00-4f52-91c9-7e9cb668e32e",
                                "sense_id": "0e0e1ded-2e55-33d9-821d-72b782736985",
                                "text": "„Das A-Programm wird außer in Englisch und kurzen Sendungen in Chitonga und Silozi nur noch in Chibemba und Chinyanja gebracht[…]“"
                            },
                            {
                                "example_id": "1878ddbf-cf9a-4aad-99f0-f6bdba741590",
                                "sense_id": "0e0e1ded-2e55-33d9-821d-72b782736985",
                                "text": "„Diesen Angaben entspricht, daß die zweimal im Monat erscheinende Lokalzeitung ‚Liseli‘, geschrieben in Silozi und Englisch, von 5 Befragten regelmäßig und von weiteren 20 (17 %) ‚gelegentlich‘ gelesen wird.“"
                            },
                            {
                                "example_id": "c8ea5ea3-5947-4ebd-9a6a-b4fbe5724e24",
                                "sense_id": "0e0e1ded-2e55-33d9-821d-72b782736985",
                                "text": "„Allerdings heißt es auch, Ungerechtigkeiten würden ausgeglichen, unter denen Deutsch und Afrikaans im Unterricht und täglichen Gebrauch bevorzugt worden seien gegenüber anderen Sprachen wie Damara/Nama, Kuangari, Otjiherero, Oshiwambo, Silozi und anderen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
