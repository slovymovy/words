                            {
                                "target_word": "Hakka",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46267401-7693-3dcb-b6b9-70a3470f80ca",
                                        "entry_id": "608c4987-2b71-3336-be29-d2945eb66738",
                                        "glosses": [
                                            "A Chinese language mainly spoken in the south-eastern part of mainland China (Fujian, Jiangxi, Guangdong and Guangxi), Taiwan, Hong Kong, and by the Chinese minorities in Southeast Asia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cf6aa63-8af3-4481-a47b-cca5835cb164",
                                                "sense_id": "46267401-7693-3dcb-b6b9-70a3470f80ca",
                                                "text": "The first county centre gone through, that of Tsengcheng, was full of new construction. After it, the language on the road right on into the Meihsien prefecture was Hakka."
                                            },
                                            {
                                                "example_id": "dbe9bc4b-abec-4e8e-85a1-8c127718a193",
                                                "sense_id": "46267401-7693-3dcb-b6b9-70a3470f80ca",
                                                "text": "We passed through a large Hakka town (Hakka is a Chinese language, one of the three official languages in Taiwan; more on that in later posts) and then began to pitch and roll through a series of white-knuckling switchbacks up Hsinchu County Road 22."
                                            },
                                            {
                                                "example_id": "e8a906f8-7e68-495f-852f-68d9b1526175",
                                                "sense_id": "46267401-7693-3dcb-b6b9-70a3470f80ca",
                                                "text": "As a mainland China national, the counter for our trial was fluent in English, Putonghua, and the Sichuan dialect, and was familiar with a number of other major Chinese languages such as Cantonese and Hakka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
