{
    "word_family": [
        "laten",
        "overlaat",
        "overblijven"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cc48b633-05f5-3b51-8bb4-575a6f8124b9",
                    "sense_definition": "iets niet volledig gebruiken of consumeren, zodat er een deel overblijft",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "overblijven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je alsjeblieft een klein beetje kaas voor mij <w>overlaten</w>?",
                            "target_lang_translations": {
                                "en": "Could you please <w>leave</w> a little bit of cheese for me?"
                            }
                        },
                        {
                            "text": "We moeten wat tijd <w>overlaten</w> om na de presentatie vragen te kunnen stellen.",
                            "target_lang_translations": {
                                "en": "We need to <w>leave</w> some time to be able to ask questions after the presentation."
                            }
                        }
                    ],
                    "synonyms": [
                        "overhouden",
                        "bewaren"
                    ],
                    "antonyms": [
                        "opmaken",
                        "verbruiken"
                    ],
                    "common_phrases": [
                        "tijd overlaten",
                        "wat eten overlaten"
                    ],
                    "target_lang_definitions": {
                        "en": "to not use or consume something completely, so that a part remains"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave",
                                "target_lang_sense_clarification": "to not finish or use all of something"
                            },
                            {
                                "target_lang_word": "save",
                                "target_lang_sense_clarification": "to keep a portion for later use"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "024f1744-e6b2-3a9f-9e3e-fb2e49ee1e51",
                    "sense_definition": "een taak of verantwoordelijkheid aan iemand anders toevertrouwen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "toevertrouwen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt de reparatie van de auto beter aan de vakman <w>overlaten</w>.",
                            "target_lang_translations": {
                                "en": "You'd better <w>leave</w> the car repair to the professional."
                            }
                        },
                        {
                            "text": "Ik zal de beslissing over het nieuwe project aan mijn manager <w>overlaten</w>.",
                            "target_lang_translations": {
                                "en": "I will <w>leave</w> the decision about the new project to my manager."
                            }
                        }
                    ],
                    "synonyms": [
                        "toevertrouwen",
                        "delegeren"
                    ],
                    "antonyms": [
                        "zelf doen"
                    ],
                    "common_phrases": [
                        "aan iemand overlaten",
                        "aan het toeval overlaten"
                    ],
                    "target_lang_definitions": {
                        "en": "to entrust a task or responsibility to someone else"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave to",
                                "target_lang_sense_clarification": "to let someone else handle a task"
                            },
                            {
                                "target_lang_word": "delegate",
                                "target_lang_sense_clarification": "to assign a responsibility to another person"
                            },
                            {
                                "target_lang_word": "entrust",
                                "target_lang_sense_clarification": "to put something into someone's care"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3a6cc49-01c5-333e-becb-ed8291995d14",
                    "sense_definition": "iemand of iets in een bepaalde toestand laten zonder hulp of controle",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verlaten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is wreed om een gewond dier aan zijn lot <w>over te laten</w>.",
                            "target_lang_translations": {
                                "en": "It is cruel to <w>leave</w> a wounded animal to its fate."
                            }
                        },
                        {
                            "text": "De kwaliteit van het schilderwerk bleef helaas veel te wensen <w>overlaten</w>.",
                            "target_lang_translations": {
                                "en": "Unfortunately, the quality of the paintwork <w>left</w> much to be desired."
                            }
                        }
                    ],
                    "synonyms": [
                        "verlaten",
                        "achterlaten"
                    ],
                    "common_phrases": [
                        "aan zijn lot overlaten",
                        "te wensen overlaten"
                    ],
                    "target_lang_definitions": {
                        "en": "to leave someone or something in a certain state without help or control"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "leave to",
                                "target_lang_sense_clarification": "to abandon someone to a specific fate or condition"
                            },
                            {
                                "target_lang_word": "leave much to be desired",
                                "target_lang_sense_clarification": "idiom meaning something is not good enough"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d0bd1550-d90e-3ced-a5ca-338885b3a56c",
                    "sense_definition": "meervoud van het zelfstandig naamwoord <w>overlaat</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "waterbeheer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude <w>overlaten</w> in de dijk werden vroeger gebruikt om overtollig water af te voeren.",
                            "target_lang_translations": {
                                "en": "The old <w>spillways</w> in the dike were used in the past to drain excess water."
                            }
                        },
                        {
                            "text": "Tijdens de inspectie werden de verschillende <w>overlaten</w> gecontroleerd op schade.",
                            "target_lang_translations": {
                                "en": "During the inspection, the various <w>overflows</w> were checked for damage."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural of overlaat"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "plural of the noun 'overlaat', referring to a structure for discharging excess water"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "spillways",
                                "target_lang_sense_clarification": "structures used to provide the controlled release of flows from a dam"
                            },
                            {
                                "target_lang_word": "overflows",
                                "target_lang_sense_clarification": "passages for surplus water"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}