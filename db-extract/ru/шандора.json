                "translations": [
                    {
                        "translation_id": "829f14a8-6790-4e00-9ea2-dfdb32c08dcc",
                        "source_entry_id": "4d901698-cafc-3237-a19e-24e1322d469e",
                        "target_lang_word": "stoplog",
