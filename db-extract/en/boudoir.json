                "senses": [
                    {
                        "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                        "entry_id": "717bb79b-eff8-3783-8110-0780264a5a2d",
                        "glosses": [
                            "A woman's private sitting room, dressing room, or bedroom."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6aa4864-6384-44c6-97c6-6a7e55abca6a",
                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                "text": "The Duchesse's boudoir was fitted up in a style of luxury utterly different from anything before familiar to the Carraras."
                            },
                            {
                                "example_id": "3c441425-878f-4a60-8239-3118cea6129a",
                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                "text": "Dorcas, faithful to her “young gentlemen,” denied strenuously that it could have been John’s voice she heard, and resolutely declared, in the teeth of everything, that it was Mr. Inglethorp who had been in the boudoir with her mistress."
                            },
                            {
                                "example_id": "3ace259c-de67-4f17-8a3b-aaf04785986d",
                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                "text": "I found her in her boudoir getting outside a dish of tea and a crumpet."
                            }
                        ]
                    }
                ],
