                                "target_senses": [
                                    {
                                        "sense_id": "b36e1cfd-a009-39fa-8ffa-418d4c3b99ed",
                                        "entry_id": "10c82010-af4a-34d9-9026-d9ea40a6beea",
                                        "glosses": [
                                            "Nom de famille français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ebbdb5e-2185-48fe-b9ce-ce83a1600bb1",
                                                "sense_id": "b36e1cfd-a009-39fa-8ffa-418d4c3b99ed",
                                                "text": "« J’ai remarqué qu’ils parlent plus, qu’ils se cherchent, qu’ils reprennent des idées des écologistes », analyse aussi Alexandre Florentin, du groupe écologistes de Paris."
                                            }
                                        ]
