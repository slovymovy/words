                        "examples": [
                            {
                                "example_id": "8e5f28f9-5724-43bd-b95a-97d279c73cab",
                                "sense_id": "07b7eda3-f8c1-32a2-af60-4fa5ace6466a",
                                "text": "Mandred leunde met zijn hoofd tegen het glas, met halfgeloken ogen."
                            },
                            {
                                "example_id": "bd2c9a4c-78df-442f-8029-cd4967628875",
                                "sense_id": "07b7eda3-f8c1-32a2-af60-4fa5ace6466a",
                                "text": "Voor beide mannen moet die eerste aanblik inderdaad merkwaardig zijn geweest, want uiterlijk leken ze griezelig veel op elkaar. Beiden waren lang, mager en kaal. Beiden hadden halfgeloken blauwe ogen, geen van beiden droeg een bril (hoewel Minor buitengewoon bijziend was). Dr. Minor heeft een beetje een haviksneus, die van dr. Murray is fijner, meer adelaarsachtig. Minor heeft het voorkomen van een vriendelijke oom; dat van Murray lijkt er veel op, maar met een spoor van de strengheid die heel goed het onderscheid zou kunnen betekenen tussen een Schot uit de laaglanden en een yankee uit Connecticut."
                            }
                        ]
                    }
