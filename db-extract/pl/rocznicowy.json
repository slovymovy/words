                        "source_entry_id": "5c0809e8-7981-3d31-8906-bee564e8e22c",
                        "source_sense_id": "e6b3672d-d2ea-332b-909d-66f46f092946",
                        "target_lang_word": "anniversary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anniversary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "26bb1f99-46cb-3f0e-aeb0-7a87680151cb",
                                        "entry_id": "417b9f76-5893-301d-b6ae-d1802f36c979",
                                        "glosses": [
                                            "A day that is an exact number of years (to the day) since a given significant event occurred. Often preceded by an ordinal number indicating the number of years."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4804d594-bf56-4330-8884-d0338052b2e9",
                                                "sense_id": "26bb1f99-46cb-3f0e-aeb0-7a87680151cb",
                                                "text": "Today is the fiftieth anniversary of the end of the war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93ad141b-8092-3835-a92e-4642294c746e",
                                        "entry_id": "417b9f76-5893-301d-b6ae-d1802f36c979",
                                        "glosses": [
                                            "A day that is an exact number of years (to the day) since a given significant event occurred. Often preceded by an ordinal number indicating the number of years.",
                                            "Such a day that commemorates a wedding."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b68ea38-3ad0-4efb-90bf-9df586956c7d",
                                                "sense_id": "93ad141b-8092-3835-a92e-4642294c746e",
                                                "text": "We are celebrating our tenth anniversary today."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d583f23-76d8-31ca-809a-c17cebfa071e",
                                        "entry_id": "417b9f76-5893-301d-b6ae-d1802f36c979",
                                        "glosses": [
                                            "A day subsequent in time to a given event by some significant period other than a year (especially as prefixed by the amount of time in question)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d62c9b33-f89d-4ecc-9d11-d2c2b367bf44",
                                                "sense_id": "1d583f23-76d8-31ca-809a-c17cebfa071e",
                                                "text": "The occasion was the six-month anniversary of the Aug. 8 coup that brought General Óscar Humberto Mejía Victores to power."
                                            },
                                            {
                                                "example_id": "77081441-456d-4203-8685-e0367ee10ed0",
                                                "sense_id": "1d583f23-76d8-31ca-809a-c17cebfa071e",
                                                "text": "In a thinly veiled threat to Saddam Hussein, President George Bush marked the six-month anniversary of September 11th by reiterating America's commitment to prevent rogue countries obtaining weapons of mass destruction."
                                            },
                                            {
                                                "example_id": "8a35911d-9956-4008-bf06-a9c0668e5044",
                                                "sense_id": "1d583f23-76d8-31ca-809a-c17cebfa071e",
                                                "text": "Jonathon proposed to his [Jess's] mom on their three-month anniversary of meeting and married her on their fourth."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
