                        "sense_id": "aebaa8c7-ff5c-3334-8a18-b29f5407b678",
                        "entry_id": "23b2090a-ce2e-3a9d-8f67-643afc87c164",
                        "glosses": [
                            "een meerhoekige of ronde toren ter verdediging aangebracht op de hoeken van een gebouw bijvoorbeeld bij een burcht, stadsmuur of stadspoort"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "831135dd-0a42-45a7-a32c-8f4fc694d231",
                                "sense_id": "aebaa8c7-ff5c-3334-8a18-b29f5407b678",
                                "text": "Pikzwart rees de hoektoren op tegen de laatste, groene nagloed van de dag."
                            },
                            {
                                "example_id": "562f1a34-4e17-4546-85e3-78a924bd6d3c",
                                "sense_id": "aebaa8c7-ff5c-3334-8a18-b29f5407b678",
                                "text": "Het gebouw van de Eerste Kamer ligt aan de Hofvijver en stamt uit het midden van de vijftiende eeuw. Aanvankelijk waren er vooral woningen gevestigd. Prins Maurits was ooit bewoner van het pand, net als de latere stadhouder Willem II. Maurits gaf opdracht om de hoektoren aan de rand van de Hofvijver te bouwen, die de Mauritstoren is gaan heten."
                            }
                        ]
                    }
                ],
