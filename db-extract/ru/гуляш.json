                        ],
                        "form": "гуляша́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                        "entry_id": "462af944-8867-3307-97d9-6b5a4d1ffe0f",
                        "glosses": [
                            "кулин. кушанье, приготовленное из кусочков мяса, ту́шенных в соусе с пряностями"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f867ed6b-5161-4495-920c-0729edcbcbf9",
                                "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                "text": "Наконец мы добрались до ресторана и заказали себе гуляш и масляш. Первое — какое-то национальное мясное кушанье пополам с красным перцем, а второе — приторное венгерское вино."
                            },
                            {
                                "example_id": "a535a06c-226f-4c90-912b-047fa4446555",
                                "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                "text": "Гуляш подать с жареным или отварным картофелем, посыпав мелко нарезанной зеленью петрушки или укропом."
                            },
                            {
                                "example_id": "94cb7001-1a63-4033-8d2d-c66b73551e00",
                                "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                "text": "Женщины деловито едят гуляш из телятины."
                            },
                            {
                                "example_id": "9809e0f4-3fe0-4789-932e-279af7ed0dbe",
                                "sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
                                "text": ".. мы возвратились из столовой, захватив с собой в котелке гречневую кашу с гуляшом на ужин."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0dbccbe-f892-4d9f-addf-149c5f5d518a",
                        "source_entry_id": "462af944-8867-3307-97d9-6b5a4d1ffe0f",
                        "source_sense_id": "dad3d731-d769-35f3-9bf3-5ead5825d9cd",
