            {
                "entry_id": "c40459a7-b263-3484-b8c1-1dc6d2972d22",
                "word": "gréement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "984f1bd3-cd6b-46c4-9d1d-64fdf7ef68b1",
                        "entry_id": "c40459a7-b263-3484-b8c1-1dc6d2972d22",
                        "tags": [
                            "plural"
                        ],
                        "form": "gréements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f47cba12-19cf-3da2-8df8-35fd88d74af4",
                        "entry_id": "c40459a7-b263-3484-b8c1-1dc6d2972d22",
                        "glosses": [
                            "Action de gréer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de448632-afa4-49f4-bc0a-0a2a04b1a91a",
                                "sense_id": "f47cba12-19cf-3da2-8df8-35fd88d74af4",
                                "text": "Le gréement d’un yacht, d’une goélette, d’un navire."
                            }
                        ]
                    },
                    {
                        "sense_id": "5b8f62cf-5cea-34e7-bd18-e030f6231599",
                        "entry_id": "c40459a7-b263-3484-b8c1-1dc6d2972d22",
                        "glosses": [
                            "Ensemble des choses qui servent à gréer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29b73fdf-0b75-4694-a1da-1a097ad8699b",
                                "sense_id": "5b8f62cf-5cea-34e7-bd18-e030f6231599",
                                "text": "Mac Nap et ses hommes travaillaient assidûment à la lueur de résines enflammées, pendant que les autres s'occupaient du gréement dans les magasins de la factorerie."
                            },
                            {
                                "example_id": "c0be1b40-f153-4f3e-9bac-0a1d781623ba",
                                "sense_id": "5b8f62cf-5cea-34e7-bd18-e030f6231599",
                                "text": "Le thermomètre est descendu à -6°; tout le gréement était couvert de givre et de glace que je dus casser en montant dans la mâture."
                            },
                            {
                                "example_id": "773ab0fe-ed3f-4b84-a674-ea0c4374846f",
                                "sense_id": "5b8f62cf-5cea-34e7-bd18-e030f6231599",
                                "text": "L'énorme rouf construit sur l’embarcation et son gréement, démontraient l'inexpérience totale que son propriétaire avait des choses de la mer."
                            },
                            {
                                "example_id": "6afa262d-48a8-4fd5-93b4-b247bb132832",
                                "sense_id": "5b8f62cf-5cea-34e7-bd18-e030f6231599",
                                "text": "Il entendit le cri indigné d’une mouette, le fracas d’une vague s’affalant sur le rivage, le clapotis de l’eau, les gréements des navires qui claquaient dans le vent."
                            }
                        ]
                    },
                    {
                        "sense_id": "f6454462-bfb8-3477-95da-95d6c6261615",
                        "entry_id": "c40459a7-b263-3484-b8c1-1dc6d2972d22",
                        "glosses": [
                            "Type de mâture et voilure d'un navire à voile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cdc447c8-36fd-4b55-aef7-54521909cded",
                                "sense_id": "f6454462-bfb8-3477-95da-95d6c6261615",
                                "text": "Un vieux gréement (gréement traditionnel ou à l'ancienne), un gréement aurique, un gréement au tiers, etc."
                            },
                            {
                                "example_id": "02f4b14e-36ab-4ff2-b456-66770ab213a0",
                                "sense_id": "f6454462-bfb8-3477-95da-95d6c6261615",
                                "text": "– Quel est son gréement ?\n– Que voulez-vous dire ?\n– Est-il gréé en goélette franche, en cotre, en dundee ? A-t-il ou n’a-t-il pas de spinnaker ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52a716cc-fab2-44bf-85ad-c803e8b4b9a6",
                        "source_entry_id": "c40459a7-b263-3484-b8c1-1dc6d2972d22",
                        "source_sense_id": "5b8f62cf-5cea-34e7-bd18-e030f6231599",
                        "source_sense_description": "Ensemble des choses qui servent à gréer",
                        "target_lang_word": "Takelage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Takelage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                        "entry_id": "75f57904-f352-3260-b10e-fbdeb5f37679",
                                        "glosses": [
                                            "die gesamte Segeleinrichtung eines Schiffes, bestehend aus Masten, Segeln und Tauwerk"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3eced7f1-774b-4d3e-a8d4-a733ec176fb6",
                                                "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                                "text": "„Stenge nennt man den festen, aus Metallrohr oder früher auch aus Massivholz bestehenden, Teil der Takelage auf einem Segelschiff oder Segelboot, der die Verlängerung des Mastes oberhalb der ersten Saling bildet.“"
                                            },
                                            {
                                                "example_id": "29c5f8af-7a65-43b8-bef4-12b97ef7cbeb",
                                                "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                                "text": "„Er jagte die Mannschaft in die Takelage, befahl Segel zu setzen, in den Wind zu drehen und die auffrischende Brise auszunutzen.“"
                                            },
                                            {
                                                "example_id": "4fd2811c-d630-4655-96e8-792f2c54e239",
                                                "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                                "text": "„Bald begann ich die Takelage der Brigg aufzuentern und zu den Masttopps aufzusteigen.“"
                                            },
                                            {
                                                "example_id": "fd43661f-34f5-4f42-8f0d-b48e10daa850",
                                                "sense_id": "0b97a2a4-6342-338c-8387-07bfa53e76cf",
                                                "text": "„Bald war die Takelage komplett, lange vor dem Schiff selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa2b70a6-7776-4a9f-8567-e8655d541fac",
                        "source_entry_id": "c40459a7-b263-3484-b8c1-1dc6d2972d22",
                        "source_sense_id": "5b8f62cf-5cea-34e7-bd18-e030f6231599",
                        "source_sense_description": "Ensemble des choses qui servent à gréer",
                        "target_lang_word": "rigging",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rigging",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57279318-5ec9-3311-b251-bbf46da4a54b",
                                        "entry_id": "9619aacd-fedd-367a-bdb5-cb4822afbb1c",
                                        "glosses": [
                                            "Dress; tackle; especially (nautical), the ropes, chains, etc., that support the masts and spars of a sailing vessel, and serve as purchases for adjusting the sails, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e53e8f71-aacc-49ec-8fa3-2f68478fadff",
                                                "sense_id": "57279318-5ec9-3311-b251-bbf46da4a54b",
                                                "text": "The moon was full and shone down on us through the masts and rigging of an old fishing wreck, which had been grounded just off the beach where we were sitting."
                                            },
                                            {
                                                "example_id": "84b540e5-e418-46e2-9e44-4d27fc06f415",
                                                "sense_id": "57279318-5ec9-3311-b251-bbf46da4a54b",
                                                "text": "For a time the apostis glowed like a forge; gradually it dimmed and went out, and our ship resumed a more conventional position, though the wind still screamed in the rigging and the clouds scudded under us like flecks of foam in a mill race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "060a8924-f7df-3556-9900-c71256f92821",
                                        "entry_id": "9619aacd-fedd-367a-bdb5-cb4822afbb1c",
                                        "glosses": [
                                            "Similar supporting material used for construction work, or in film, theater, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f0330ba-7002-439d-84a4-306a627124f4",
                                                "sense_id": "060a8924-f7df-3556-9900-c71256f92821",
                                                "text": "[…]or even, daring, spent the night up some pole in a lineman's tent like caterpillars, swung among a web of telephone wires, living in the very copper rigging and secular miracle of communication, untroubled by the dumb voltages flickering their miles, the night long, in the thousands of unheard messages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b32fba-8e52-32f5-83d6-2e379d39682d",
                                        "entry_id": "9619aacd-fedd-367a-bdb5-cb4822afbb1c",
                                        "glosses": [
                                            "The shiplike mechanical components and weaponry attached to a shipgirl."
                                        ],
                                        "tags": [
                                            "Japanese",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4efc6423-cb65-463a-9aa4-a941cc38dac8",
                                                "sense_id": "86b32fba-8e52-32f5-83d6-2e379d39682d",
                                                "text": "Max Factory presents a figma of Nagato Kai-II from \"Kantai Collection -KanColle-\"! Her rigging has been carefully recreated in figma form, featuring loads of articulation to create perfect poses!"
                                            }
                                        ]
                                    }
                                ]
                            },
