                "senses": [
                    {
                        "sense_id": "daac504f-156f-3164-bedd-9d48c8e81bb4",
                        "entry_id": "ad01c0b0-2549-320c-9c68-9de4e9c5d115",
                        "glosses": [
                            "die äußere, feste, undurchsichtige Hülle des Augapfels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cdb5b8c-8c82-433a-9e75-dbeb38109873",
                                "sense_id": "daac504f-156f-3164-bedd-9d48c8e81bb4",
                                "text": "„Wie dieses, ist das Wirbeltierauge ein Linsenange, dessen Netzhaut etwa drei Viertel einer Kugel bildet und von einer widerstandsfähigen Sklera gestützt wird; die Linse wird etwa an ihrem Äquator von ihrem Tragapparat umfaßt; vor der Linse eine Iris mit erweiterungsfähiger Pupille und eine gewölbte durchsichtige Hornhaut.“"
                            },
                            {
                                "example_id": "f2e8e15a-be70-4d72-bcbb-324d00b08998",
                                "sense_id": "daac504f-156f-3164-bedd-9d48c8e81bb4",
                                "text": "Die Sklera „ist an ihrer Außenfläche von einer dünnen, elastischen, gefäßhaltigen Haut, der Episklera, überzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f13eb720-728b-45ec-b53e-7b061b5d305e",
                        "source_entry_id": "ad01c0b0-2549-320c-9c68-9de4e9c5d115",
                        "source_sense_id": "daac504f-156f-3164-bedd-9d48c8e81bb4",
                        "source_sense_description": "Anatomie: die äußere, feste, undurchsichtige Hülle des Augapfels",
                        "target_lang_word": "sclère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sclère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7a3dc107-2115-3da7-8a6a-259c347fac15",
                                        "entry_id": "6b9adb3d-405f-3a3e-8fea-19f509b6a52d",
                                        "glosses": [
                                            "Membrane blanche et opaque, résistante, de nature conjonctive, qui forme le blanc de l’œil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10332914-bcbd-4c32-8152-e9c41f4812a0",
                                                "sense_id": "7a3dc107-2115-3da7-8a6a-259c347fac15",
                                                "text": "Ils réussirent à démontrer de manière magistrale que la condition nécessaire et suffisante à cette activation inconsciente de l’amygdale cérébrale par un visage effrayé se résumait à la taille du « blanc des yeux » : la sclère ! — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 51)"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
