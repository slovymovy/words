{
    "word_family": [
        "grijp",
        "grijper",
        "greep",
        "aangrijpend"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b50cb421-2c78-3019-8508-5d01c1d920a2",
                    "sense_definition": "Iets plotseling vastpakken.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_vastpakken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>greep</w> de leuning <w>aan</w> om niet te vallen.",
                            "target_lang_translations": {
                                "en": "He <w>grabbed</w> the railing to avoid falling."
                            }
                        },
                        {
                            "text": "De drenkeling <w>greep</w> de reddingsboei <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The drowning person <w>clutched</w> the lifebuoy."
                            }
                        }
                    ],
                    "synonyms": [
                        "vastpakken",
                        "grijpen"
                    ],
                    "common_phrases": [
                        "de kans aangrijpen"
                    ],
                    "target_lang_definitions": {
                        "en": "To grab or seize something suddenly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to grab",
                                "target_lang_sense_clarification": "to seize something suddenly with one's hand"
                            },
                            {
                                "target_lang_word": "to clutch",
                                "target_lang_sense_clarification": "to grasp something tightly, often due to fear or need"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "997e65ab-6d51-3841-bad6-552eb9384d6a",
                    "sense_definition": "Een kans of gelegenheid benutten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "benutten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>greep</w> de kans <w>aan</w> om in het buitenland te studeren.",
                            "target_lang_translations": {
                                "en": "She <w>seized</w> the opportunity to study abroad."
                            }
                        },
                        {
                            "text": "Hij <w>greep</w> de gelegenheid <w>aan</w> om zijn excuses aan te bieden.",
                            "target_lang_translations": {
                                "en": "He <w>took advantage of</w> the occasion to offer his apologies."
                            }
                        }
                    ],
                    "synonyms": [
                        "benutten",
                        "gebruiken"
                    ],
                    "common_phrases": [
                        "de kans aangrijpen"
                    ],
                    "target_lang_definitions": {
                        "en": "To make use of an opportunity or occasion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to seize",
                                "target_lang_sense_clarification": "to take an opportunity eagerly and decisively"
                            },
                            {
                                "target_lang_word": "to take advantage of",
                                "target_lang_sense_clarification": "to make good use of an opportunity"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dd40318f-2b50-31b9-a2ab-5be64fab6905",
                    "sense_definition": "Iemand emotioneel diep raken of ontroeren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotioneel_raken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het trieste nieuws <w>greep</w> de hele familie erg <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The sad news <w>affected</w> the whole family deeply."
                            }
                        },
                        {
                            "text": "Het verhaal over het ongeluk <w>greep</w> haar diep <w>aan</w>.",
                            "target_lang_translations": {
                                "en": "The story about the accident <w>moved</w> her deeply."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontroeren",
                        "raken"
                    ],
                    "target_lang_definitions": {
                        "en": "To affect someone deeply in an emotional way."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to affect deeply",
                                "target_lang_sense_clarification": "to have a strong emotional impact on someone"
                            },
                            {
                                "target_lang_word": "to move",
                                "target_lang_sense_clarification": "to cause someone to feel strong emotions"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d7959911-bec8-3e82-9589-a8ba94ceb7cd",
                    "sense_definition": "Een aanval uitvoeren op een vijand.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "aanvallen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het leger <w>greep</w> de vijandelijke stellingen <w>aan</w> bij zonsopgang.",
                            "target_lang_translations": {
                                "en": "The army <w>attacked</w> the enemy positions at sunrise."
                            }
                        },
                        {
                            "text": "De troepen <w>grepen</w> de stad <w>aan</w> vanuit het noorden.",
                            "target_lang_translations": {
                                "en": "The troops <w>assaulted</w> the city from the north."
                            }
                        }
                    ],
                    "synonyms": [
                        "aanvallen",
                        "bestormen"
                    ],
                    "antonyms": [
                        "verdedigen"
                    ],
                    "target_lang_definitions": {
                        "en": "To launch an attack on an enemy."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to attack",
                                "target_lang_sense_clarification": "to take aggressive action against an enemy"
                            },
                            {
                                "target_lang_word": "to assault",
                                "target_lang_sense_clarification": "to make a physical attack on a position"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}