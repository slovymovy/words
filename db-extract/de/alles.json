            {
                "entry_id": "b6ae4071-6fe3-30a0-a63f-78d6a4014f16",
                "word": "alles",
                "pos": "pron",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "ccd5cdde-f45d-41c4-b826-740f1dd8bd19",
                        "entry_id": "b6ae4071-6fe3-30a0-a63f-78d6a4014f16",
                        "tags": [],
                        "form": "alles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "70f11fe2-3970-3f98-b6ab-bdfe94e39214",
                        "entry_id": "b6ae4071-6fe3-30a0-a63f-78d6a4014f16",
                        "glosses": [
                            "όλα, τα πάντα"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d099c38-405d-419c-8206-8f0963cc1a6b",
                                "sense_id": "70f11fe2-3970-3f98-b6ab-bdfe94e39214",
                                "text": "Es ist alles eine Frage der Perspektive.\n Όλα είναι θέμα οπτικής γωνίας."
                            },
                            {
                                "example_id": "004b764e-8a4f-48a9-9084-6f41c9324ba8",
                                "sense_id": "70f11fe2-3970-3f98-b6ab-bdfe94e39214",
                                "text": "Wir können alles. Außer Hochdeutsch.\n Μπορούμε να κάνουμε τα πάντα. Εκτός από τα Κεντρικά Γερμανικά.\n — Ένα διαφημιστικό σλόγκαν του ομόσπονδου κρατιδίου της Βάδης-Βυρτεμβέργης."
                            },
                            {
                                "example_id": "0b73e765-f092-457b-9d6c-0c51f2cc96a2",
                                "sense_id": "70f11fe2-3970-3f98-b6ab-bdfe94e39214",
                                "text": "Dieses Büchlein ist alles, was mir von meinem Vater geblieben ist.\n Αυτό το βιβλιαράκι είναι το μόνο που μου έχει μείνει από τον πατέρα μου."
                            },
                            {
                                "example_id": "0140f6a9-e2aa-493b-9fe8-55deea70f039",
                                "sense_id": "70f11fe2-3970-3f98-b6ab-bdfe94e39214",
                                "text": "Der Urspung alles Schönen liegt in der Poesie.\n Η πηγή κάθε όμορφου βρίσκεται στην ποίηση."
                            },
                            {
                                "example_id": "c850f2c4-5a8a-429c-b9a1-7f1a3cb2ea08",
                                "sense_id": "70f11fe2-3970-3f98-b6ab-bdfe94e39214",
                                "text": "Mit Gewalt kriegt man alles kaputt.\n Με τη βία τα καταστρέφεις όλα."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
