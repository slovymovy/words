{
    "word_family": [
        "rave",
        "raver"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16f458a0-90c8-35c6-b36a-e2b1444a73bf",
                    "sense_definition": "Wild, incoherent, or irrational talk.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irrational_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoner's <w>ravings</w> were dismissed by the judge as the product of a disturbed mind.",
                            "target_lang_translations": {
                                "cs": "Vězňovo <w>blouznění</w> soudce odmítl jako produkt narušené mysli."
                            }
                        },
                        {
                            "text": "Do not pay attention to the <w>ravings</w> of that angry man on the street corner.",
                            "target_lang_translations": {
                                "cs": "Nevěnuj pozornost <w>žvástům</w> toho rozzuřeného muže na rohu ulice."
                            }
                        }
                    ],
                    "synonyms": [
                        "babble",
                        "gibberish"
                    ],
                    "target_lang_definitions": {
                        "cs": "Divoká, nesouvislá nebo iracionální řeč."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "blouznění",
                                "target_lang_sense_clarification": "nesouvislé mluvení v horečce nebo šílenství"
                            },
                            {
                                "target_lang_word": "žvásty",
                                "target_lang_sense_clarification": "nesmyslné nebo iracionální řeči"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cf3eabaf-87d5-3e8d-b716-6a82a894ac4d",
                    "sense_definition": "Talking in a wild, irrational, or delirious manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irrational_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The patient was <w>raving</w> about strange creatures in the room while he had a high fever.",
                            "target_lang_translations": {
                                "cs": "Pacient v horečce <w>blouznil</w> o podivných tvorech v pokoji."
                            }
                        },
                        {
                            "text": "He was <w>raving</w> so loudly that the neighbors called the police to check on him.",
                            "target_lang_translations": {
                                "cs": "Tak hlasitě <w>křičel nesmysly</w>, že sousedé zavolali policii, aby ho zkontrolovala."
                            }
                        }
                    ],
                    "synonyms": [
                        "delirious",
                        "irrational"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mluvící divokým, iracionálním nebo blouznivým způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "blouznící",
                                "target_lang_sense_clarification": "mluvící z cesty v důsledku nemoci či šílenství"
                            },
                            {
                                "target_lang_word": "šílený",
                                "target_lang_sense_clarification": "jednající nebo mluvící iracionálně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d6fc178-89ff-317b-a8db-b1206bdb83bf",
                    "sense_definition": "Used to emphasize that someone or something is an extreme example of a particular type.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emphasis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is a <w>raving</w> beauty who attracts attention wherever she goes.",
                            "target_lang_translations": {
                                "cs": "Je to <w>naprostá</w> krasavice, která přitahuje pozornost, kamkoli přijde."
                            }
                        },
                        {
                            "text": "He is a <w>raving</w> lunatic who believes the earth is flat.",
                            "target_lang_translations": {
                                "cs": "Je to <w>naprostý</w> šílenec, který věří, že země je placatá."
                            }
                        }
                    ],
                    "synonyms": [
                        "complete",
                        "absolute"
                    ],
                    "common_phrases": [
                        "raving beauty",
                        "raving lunatic"
                    ],
                    "target_lang_definitions": {
                        "cs": "Používá se pro zdůraznění, že někdo nebo něco je extrémním příkladem určitého typu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "naprostý",
                                "target_lang_sense_clarification": "zdůraznění vlastnosti (např. naprostý šílenec)"
                            },
                            {
                                "target_lang_word": "úplný",
                                "target_lang_sense_clarification": "zdůraznění míry vlastnosti"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ef3a9f0c-2dd5-3bb2-a6a5-303abd01b29b",
                    "sense_definition": "In an incoherent or wild manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "irrational_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The man was found wandering the streets, stark <w>raving</w> mad.",
                            "target_lang_translations": {
                                "cs": "Muž byl nalezen, jak bloumá ulicemi, <w>naprosto</w> šílený."
                            }
                        },
                        {
                            "text": "He was <w>raving</w> mad after hearing the terrible news about his business.",
                            "target_lang_translations": {
                                "cs": "Poté, co slyšel hrozné zprávy o svém podnikání, byl <w>naprosto</w> šílený vzteky."
                            }
                        }
                    ],
                    "synonyms": [
                        "incoherently"
                    ],
                    "common_phrases": [
                        "stark raving mad"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nesouvislým nebo divokým způsobem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "naprosto",
                                "target_lang_sense_clarification": "používá se ve spojení 'naprosto šílený'"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "85dd0f96-627d-32a4-9a73-582e8d8e85d1",
                    "sense_definition": "The present participle and gerund of <w>rave</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "irrational_speech",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>raving</w> about how much she enjoyed the new movie.",
                            "target_lang_translations": {
                                "cs": "Nadšeně <w>vychvalovala</w>, jak moc se jí ten nový film líbil."
                            }
                        },
                        {
                            "text": "Stop <w>raving</w> about your problems and try to find a solution.",
                            "target_lang_translations": {
                                "cs": "Přestaň <w>neustále dokola mluvit</w> o svých problémech a zkus najít řešení."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Přítomné příčestí a gerundium slovesa 'rave' (nadšeně mluvit nebo blouznit)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nadšeně mluvící",
                                "target_lang_sense_clarification": "mluvící o něčem s velkým nadšením"
                            },
                            {
                                "target_lang_word": "blouznící",
                                "target_lang_sense_clarification": "mluvící nesmysly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}