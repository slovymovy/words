                            {
                                "target_word": "disrepute",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e57fb013-d1df-35ec-a638-f6167c6134a5",
                                        "entry_id": "9f17e73a-6ef3-3aa8-b144-8f074c25aafb",
                                        "glosses": [
                                            "Loss or want of reputation; ill character."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c47e9aa-67d6-4aea-b9bd-99eeaf354be2",
                                                "sense_id": "e57fb013-d1df-35ec-a638-f6167c6134a5",
                                                "text": "Herbarium material does not, indeed, allow one to extrapolate safely: what you see is what you get; what you get is classical alpha-taxonomy which is, very largely and for sound reasons, in disrepute today."
                                            },
                                            {
                                                "example_id": "69af1bf5-bd33-48d8-9474-181c1ba10d4a",
                                                "sense_id": "e57fb013-d1df-35ec-a638-f6167c6134a5",
                                                "text": "The belief in astrology was almost universal in the middle of the seventeenth century; it began to waver and become doubtful towards the close of that period, and in the beginning of the eighteenth the art fell into general disrepute, and even under general ridicule."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d85c9578-31b3-4f0d-a26f-8592a7be490b",
                        "source_entry_id": "985de2e5-a284-379c-86d0-2358b2762e42",
                        "source_sense_id": "36fdbc44-cd6c-3367-bb21-ab9c50305b4f",
                        "source_sense_description": "meist in einer festen Wendung (siehe unten): schlechter Ruf, schlechtes Renommee",
                        "target_lang_word": "opprobre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opprobre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f140771-ee5d-3fcc-82ba-b9d6f4c2677a",
                                        "entry_id": "1218e406-94f5-364e-add9-cc81ee445c83",
                                        "glosses": [
                                            "Très grande honte publique ; déshonneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8de1d181-1419-44b1-9cf0-21b7394d78bd",
                                                "sense_id": "3f140771-ee5d-3fcc-82ba-b9d6f4c2677a",
                                                "text": "Car c’est pour toi que je porte l’opprobre, Que la honte couvre mon visage."
                                            },
                                            {
                                                "example_id": "d0edafd3-8529-4f2f-a0c3-0256a80c1568",
                                                "sense_id": "3f140771-ee5d-3fcc-82ba-b9d6f4c2677a",
                                                "text": "C’est un opprobre pour le lion de pleurer face au renard."
                                            },
                                            {
                                                "example_id": "d19145a0-5827-401d-b279-e4b03a2981d9",
                                                "sense_id": "3f140771-ee5d-3fcc-82ba-b9d6f4c2677a",
                                                "text": "La plus terrible de toutes les peines pour l’homme social, c’est l’opprobre, c’est l’accablant témoignage de l’exécration publique."
                                            },
                                            {
                                                "example_id": "abd7fce6-70ac-42f0-b51c-2c2a5301cc8c",
                                                "sense_id": "3f140771-ee5d-3fcc-82ba-b9d6f4c2677a",
                                                "text": "Tremblez, tyrans et vous perfides\nL’opprobre de tous les partis"
                                            },
                                            {
                                                "example_id": "45bc9d5e-8373-4ca5-ab6c-a4ce43c86d98",
                                                "sense_id": "3f140771-ee5d-3fcc-82ba-b9d6f4c2677a",
                                                "text": "Que ce travail, haï des mères, soit maudit !\n Maudit comme le vice où l’on s’abâtardit,\n Maudit comme l’opprobre et comme le blasphème !"
                                            },
                                            {
                                                "example_id": "d2f8aea8-6eae-438a-9b55-a56f421f852d",
                                                "sense_id": "3f140771-ee5d-3fcc-82ba-b9d6f4c2677a",
                                                "text": "Un peuple se lavait de l’opprobre d'une autocratie réductrice. Un pays ravalait sa façade dans l'espoir têtu que sa rage de vivre debout allait éclater sur son nouveau visage."
                                            },
                                            {
                                                "example_id": "108592ad-227a-4888-8c8d-dbd73d91de6b",
                                                "sense_id": "3f140771-ee5d-3fcc-82ba-b9d6f4c2677a",
                                                "text": "Après la publication du livre, un nouveau référé fut diligenté par ces mêmes associations afin d’obtenir qu’un encart ou une bande signale le fait qu’il faisait l’objet de l’opprobre de la communauté musulmane."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3e54a26-5905-3e32-98a9-bab548914d8d",
                                        "entry_id": "1218e406-94f5-364e-add9-cc81ee445c83",
                                        "glosses": [
                                            "État d’abjection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7f61c3d-4ce5-4b32-aee8-bf53c9f3d006",
                                                "sense_id": "c3e54a26-5905-3e32-98a9-bab548914d8d",
                                                "text": "La vie est un opprobre, et la mort un devoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fbb0655-e02a-37c2-a196-624d4524e1e5",
                                        "entry_id": "1218e406-94f5-364e-add9-cc81ee445c83",
                                        "glosses": [
                                            "Le génocide suscite indéniablement une opprobre particulière car il vise l’oblitération physique de groupes humains. — (Dictionnaire Reverso, s. d.)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de0efa9d-9db2-3141-8243-051ec023178a",
                                        "entry_id": "1218e406-94f5-364e-add9-cc81ee445c83",
                                        "glosses": [
                                            "Cela a commencé par une attaque de Jean-Luc Mélenchon, associant Valeurs Actuelles et l’hebdomadaire Marianne dans une même opprobre. — (Daniel Schneidermann, “Le journalisme selon Natacha Polony”, Gazette n° 671, 16 septembre 2020)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f54dfd71-765f-4144-9502-817a0a68ea4d",
                        "source_entry_id": "985de2e5-a284-379c-86d0-2358b2762e42",
                        "source_sense_id": "36fdbc44-cd6c-3367-bb21-ab9c50305b4f",
                        "source_sense_description": "meist in einer festen Wendung (siehe unten): schlechter Ruf, schlechtes Renommee",
                        "target_lang_word": "déshonneur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "déshonneur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b8f8441-9809-321a-bba7-fd9290044e75",
                                        "entry_id": "d52d2b90-1459-3a47-86d1-738f10690a30",
                                        "glosses": [
                                            "Perte de l’honneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a70e3a-1b9d-4e20-ab43-ca6534bc08b4",
                                                "sense_id": "8b8f8441-9809-321a-bba7-fd9290044e75",
                                                "text": "Hantés par des idées de déshonneur, d'attentat à la dignité du nom et autres sornettes ridicules, se croyant de grands criminels et ne voyant à leur situation aucune issue, ces petits étourdis seraient bien capables de se suicider."
                                            },
                                            {
                                                "example_id": "2b90c6e0-da38-469f-aa1e-5ee5f92e95b6",
                                                "sense_id": "8b8f8441-9809-321a-bba7-fd9290044e75",
                                                "text": "[…], il lui représenta donc charitablement qu’il aurait grand tort de ne pas profiter de l’occasion qui lui était offerte pour faire marcher un salaud de richard qui jetait sans scrupules le déshonneur et la misère dans les familles pauvres, mais honorables."
                                            },
                                            {
                                                "example_id": "f19997b2-7503-44aa-8754-35f22d906f9c",
                                                "sense_id": "8b8f8441-9809-321a-bba7-fd9290044e75",
                                                "text": "La mère envoya de l’argent, mais elle joignit à son envoi un flacon de chloroforme en lui recommandant de le boire pour échapper au déshonneur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f1240be-57fb-4d23-afca-64c42dd4efc2",
                        "source_entry_id": "985de2e5-a284-379c-86d0-2358b2762e42",
                        "source_sense_id": "36fdbc44-cd6c-3367-bb21-ab9c50305b4f",
                        "source_sense_description": "meist in einer festen Wendung (siehe unten): schlechter Ruf, schlechtes Renommee",
                        "target_lang_word": "infamie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infamie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d07e66de-11f3-3f6b-b007-6611394ed03d",
                                        "entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                                        "glosses": [
                                            "Flétrissure imprimée à l’honneur, à la réputation, soit par la loi, soit par l’opinion publique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01c0a694-4a6b-4e1f-ada4-3dd345c4076d",
                                                "sense_id": "d07e66de-11f3-3f6b-b007-6611394ed03d",
                                                "text": "Je ne souffrirai jamais, dit le baron, une telle bassesse de sa part, et une telle insolence de la vôtre ; cette infamie ne me sera jamais reprochée : les enfants de ma sœur ne pourraient entrer dans les chapitres d’Allemagne. Non, jamais ma sœur n’épousera qu’un baron de l’empire."
                                            },
                                            {
                                                "example_id": "8e0f508c-9c79-43f0-8b22-2320a3a77f1a",
                                                "sense_id": "d07e66de-11f3-3f6b-b007-6611394ed03d",
                                                "text": "Comment concilier la passion immodérée des Romains pour les combats du cirque, et l’infamie dont ils couvraient les instrumens de ces cruels spectacles, les arénaires, bestiaires, gladiateurs ?"
                                            },
                                            {
                                                "example_id": "4ba97f1b-3916-4bc9-8a57-d5c36891c88d",
                                                "sense_id": "d07e66de-11f3-3f6b-b007-6611394ed03d",
                                                "text": "Je sais tout ce que le cœur humain peut contenir de lâchetés, d’infamies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b315f62-4581-380a-b0f5-c1ffc9ff2128",
                                        "entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                                        "glosses": [
                                            "Caractère déshonorant, honteux, vil, d’une chose, d’un acte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b86036-17eb-42db-a8d0-610d7eb380f6",
                                                "sense_id": "8b315f62-4581-380a-b0f5-c1ffc9ff2128",
                                                "text": "Si tu ne cesses tes remontrances, répondirent les habitants de Sodome, nous te bannirons de notre ville. — J’ai votre crime en horreur, reprit Loth. Seigneur, préserve-moi, préserve ma famille de leur infamie."
                                            },
                                            {
                                                "example_id": "6cb476e5-e538-4484-99c5-7eacc2b5cdb3",
                                                "sense_id": "8b315f62-4581-380a-b0f5-c1ffc9ff2128",
                                                "text": "Je dévoilerai l’infamie de sa conduite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f47d56c1-c7e5-3f69-b81d-3c90cb9efa90",
                                        "entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                                        "glosses": [
                                            "Action déshonorante ou honteuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cb052e5-8d22-4349-b14e-29ccc659aeea",
                                                "sense_id": "f47d56c1-c7e5-3f69-b81d-3c90cb9efa90",
                                                "text": "La Louve, cette péripatéticienne de la rue Pierre-Lescot, épousera son Martial et en aura beaucoup d'enfants. Il suffit d'avoir fait quelque infamie pendable et d'avoir rencontré M. Rodolphe de Gérolslein pour se remettre à flot."
                                            },
                                            {
                                                "example_id": "19b92b52-6d54-42d7-b645-f4557c9cb799",
                                                "sense_id": "f47d56c1-c7e5-3f69-b81d-3c90cb9efa90",
                                                "text": "Je n’étais pas loin de verser des pleurs sur ma propre infamie, en songeant que j’étais là à m’amuser et à boire avec des singes, quand mon compagnon se morfondait sur la paille, dans une cage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ba3addf-c8df-3166-88df-e3437cff0fea",
                                        "entry_id": "2fae9352-cdaa-3952-b539-e8d9a6fe69be",
                                        "glosses": [
                                            "Parole injurieuse à l’honneur, à la réputation."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11086bd8-ef13-420d-9e5a-2563c2251ddb",
                                                "sense_id": "8ba3addf-c8df-3166-88df-e3437cff0fea",
                                                "text": "Il faudra donc que nous passions pour honnêtes les impiétés et les infamies dont sont pleines les comédies de Molière."
                                            },
                                            {
                                                "example_id": "a6fe6f15-05e7-4ee1-bd75-a83505056852",
                                                "sense_id": "8ba3addf-c8df-3166-88df-e3437cff0fea",
                                                "text": "Il lui a dit mille infamies, toutes les infamies imaginables."
                                            },
                                            {
                                                "example_id": "06c3199c-0b2a-40ea-a1cc-eb103bbdadb9",
                                                "sense_id": "8ba3addf-c8df-3166-88df-e3437cff0fea",
                                                "text": "Après l’attaque japonaise du 6 décembre 1941 sur Pearl Harbor prononcé par Roosevelt : « ce jour est un jour d’infamie »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
