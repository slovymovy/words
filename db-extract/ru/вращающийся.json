                "senses": [
                    {
                        "sense_id": "e968c527-f616-3723-a584-75906f2c616f",
                        "entry_id": "dddbbc78-628e-3382-9b32-62a7503579c5",
                        "glosses": [
                            "действ. прич. наст. вр. от вращаться"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "b54707a3-eb50-434f-9e59-0bd8af8dd71e",
                                "sense_id": "e968c527-f616-3723-a584-75906f2c616f",
                                "text": "И смерчик ― этот невысокий столбик пыли, вращающийся вокруг своей оси, ― создаёт ощущение законченной неподвижной формы."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
