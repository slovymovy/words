                    },
                    {
                        "form_id": "bdde4c4f-d5b5-4c79-b176-38bfaf0343b1",
                        "entry_id": "ed6db042-b025-31d0-9f1a-5a602298dcf2",
                        "tags": [
                            "feminine"
                        ],
                        "form": "purificatrice"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b3c353dc-6410-3c8a-9d45-6bea5102909f",
                        "entry_id": "ed6db042-b025-31d0-9f1a-5a602298dcf2",
                        "glosses": [
                            "Celui qui purifie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce5b4a8c-0439-4c82-b697-913ad4c3e516",
                                "sense_id": "b3c353dc-6410-3c8a-9d45-6bea5102909f",
                                "text": "Nul doute que le dieu pur, Apollon, ne s’entoure surtout de purificateurs. Le sang d’un monstre l’a souillé. Il lui faut, à lui comme à un être mortel, des cérémonies expiatoires."
                            }
                        ]
                    },
                    {
                        "sense_id": "67b03599-010e-3043-90d6-38bf9524f39d",
                        "entry_id": "ed6db042-b025-31d0-9f1a-5a602298dcf2",
                        "glosses": [
                            "Appareil ou outil qui sert à purifier l’air ou l’eau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3d46f85-8c5e-4001-810f-ec0920c64ca6",
                                "sense_id": "67b03599-010e-3043-90d6-38bf9524f39d",
                                "text": "L’emploi d’un purificateur d’air est controversé. L'efficacité de cet appareil serait proportionnelle à son coût. Le filtre doit être gardé propre."
                            },
                            {
                                "example_id": "aae2bcf3-1ec3-4f2e-a86c-fef9cd58015d",
                                "sense_id": "67b03599-010e-3043-90d6-38bf9524f39d",
                                "text": "En effet et conformément à ce qui avait été annoncé, le purificateur d'eau mis au point par sa société avait effectivement la propriété d'éliminer le chlore et les particules en suspension pouvant se trouver même dans l'eau potable."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7541ce77-19f3-446e-8b13-38d2dff02f79",
                        "source_entry_id": "ed6db042-b025-31d0-9f1a-5a602298dcf2",
