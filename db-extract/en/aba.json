                        "entry_id": "894f6fad-d15b-3c9b-a540-540468531f90",
                        "glosses": [
                            "A coarse, often striped, felted fabric from the Middle East, woven from goat or camel hair."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "d1585f1c-9a93-3160-a6d0-c36163989172",
                        "entry_id": "894f6fad-d15b-3c9b-a540-540468531f90",
                        "glosses": [
                            "A loose-fitting sleeveless garment, made from aba or silk, worn by Arabs."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "551b0970-fdb1-4337-b91d-5318d5323e45",
                                "sense_id": "d1585f1c-9a93-3160-a6d0-c36163989172",
                                "text": "'A pale mauve abba such as you buy in the East.'"
                            },
                            {
                                "example_id": "b5a16a53-a649-440c-aec5-ddc03a49314d",
                                "sense_id": "d1585f1c-9a93-3160-a6d0-c36163989172",
                                "text": "Here Nessim would sit night after night in the winter, dressed in his old rust-coloured abba, staring gravely at Betelgeuse, or hovering over books of calculations for all the world like a medieval soothsayer."
                            }
                        ]
                    },
                    {
                        "sense_id": "17df2f10-c1fb-3c27-823b-338923f98fe2",
                        "entry_id": "894f6fad-d15b-3c9b-a540-540468531f90",
                        "glosses": [
                            "An outer garment made of the above, very simple in form, worn by the Arabs of the desert. The illustration shows such an aba, made of two breadths of stuff sewed together to make an oblong about four by nine feet."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "caece177-5eb8-3845-b2b4-01f9facc8196",
                        "entry_id": "894f6fad-d15b-3c9b-a540-540468531f90",
                        "glosses": [
                            "Such a garment that is specific to women."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1ba2abd2-c7b1-4dff-96fa-c37df5ca4ab3",
                                "sense_id": "caece177-5eb8-3845-b2b4-01f9facc8196",
                                "text": "Holonym: hijab"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "411f5f34-c3bb-4b66-b876-7fd162f51785",
                        "source_entry_id": "894f6fad-d15b-3c9b-a540-540468531f90",
                        "source_sense_description": "loose-fitting sleeveless garment, made from aba or silk",
                        "target_lang_word": "abaya",
