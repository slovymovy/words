                        "source_entry_id": "bfb164df-8217-3f69-ae0e-0e5e1a039b5c",
                        "source_sense_id": "f9dc61d1-ad65-3d3c-a9c4-c1f554e0ce14",
                        "source_sense_description": "approach to psychology focusing on behavior",
                        "target_lang_word": "behaviorisme",
                        "target_lang_code": "nl",
