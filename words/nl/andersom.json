                {
                    "sense_id": "b1e46259-2545-3bfc-875d-f95eb337b408",
                    "sense_definition": "Precies het tegenovergestelde van wat gezegd of verwacht is.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "reversal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is niet zo dat hij een hekel aan haar heeft, eerder <w>andersom</w>.",
                            "target_lang_translations": {
                                "en": "It is not that he dislikes her, rather <w>the other way around</w>.",
                                "ru": "Не то чтобы он её ненавидит, скорее <w>наоборот</w>.",
                                "pl": "To nie jest tak, że on jej nie lubi, raczej <w>odwrotnie</w>.",
                                "de": "Es ist nicht so, dass er sie nicht mag, eher <w>umgekehrt</w>.",
                                "fr": "Ce n'est pas qu'il ne l'aime pas, c'est plutôt <w>l'inverse</w>.",
                                "it": "Non è che lui non la sopporti, è piuttosto <w>il contrario</w>.",
                                "cs": "Není to tak, že by ji neměl rád, spíše <w>naopak</w>.",
                                "tr": "Ondan nefret ettiği değil, daha çok <w>tam tersi</w>.",
                                "es": "No es que él le tenga manía a ella, más bien es <w>al revés</w>.",
                                "zh": "并不是他讨厌她，情况恰恰<w>相反</w>。"
                            }
                        },
                        {
                            "text": "Zij helpt haar buren vaak met boodschappen doen, en <w>andersom</w> helpen zij haar in de tuin.",
                            "target_lang_translations": {
                                "en": "She often helps her neighbors with groceries, and <w>vice versa</w> they help her in the garden.",
                                "ru": "Она часто помогает соседям с покупками, и <w>наоборот</w>, они помогают ей в саду.",
                                "pl": "Ona często pomaga sąsiadom w zakupach, a <w>odwrotnie</w> oni pomagają jej w ogrodzie.",
                                "de": "Sie hilft ihren Nachbarn oft beim Einkaufen und <w>umgekehrt</w> helfen sie ihr im Garten.",
                                "fr": "Elle aide souvent ses voisins à faire les courses, et <w>vice versa</w>, ils l'aident dans le jardin.",
                                "it": "Lei aiuta spesso i vicini a fare la spesa e, <w>viceversa</w>, loro aiutano lei in giardino.",
                                "cs": "Ona často pomáhá sousedům s nákupy a <w>naopak</w> oni pomáhají jí na zahradě.",
                                "tr": "O sık sık komşularına alışverişte yardım eder, <w>karşılıklı olarak</w> onlar da ona bahçede yardım ederler.",
                                "es": "Ella suele ayudar a sus vecinos con la compra, y <w>viceversa</w>, ellos la ayudan a ella en el jardín.",
                                "zh": "她经常帮邻居买东西，<w>反之亦然</w>，他们也会帮她打理花园。"
                            }
                        }
