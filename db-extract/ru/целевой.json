                        "examples": [
                            {
                                "example_id": "ac0de7bc-1842-4b1e-b68c-8d548af82992",
                                "sense_id": "ca4ed783-9c57-372e-a22a-eec1235e939e",
                                "text": "Целевой аванс."
                            },
                            {
                                "example_id": "f88929e8-34ac-4c02-a239-09eeb4269c19",
                                "sense_id": "ca4ed783-9c57-372e-a22a-eec1235e939e",
                                "text": "Целевая ссуда."
                            },
                            {
                                "example_id": "ed29ca49-6612-43e8-9851-e77f9caa5f35",
                                "sense_id": "ca4ed783-9c57-372e-a22a-eec1235e939e",
                                "text": "У нас есть на это деньги, единственные целевые деньги за всю жизнь, не растранжиренные на разные возникающие дела."
                            }
                        ]
                    },
