                "senses": [
                    {
                        "sense_id": "2a431d97-0b74-310f-bcd7-d14fabe59424",
                        "entry_id": "987f442d-6980-3819-ab8c-2b99b8ac6a45",
                        "glosses": [
                            "Situation, die unübersichtlich ist und deshalb eine Orientierung erheblich erschwert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4684c293-55e1-493a-856f-4e0f9c53a86b",
                                "sense_id": "2a431d97-0b74-310f-bcd7-d14fabe59424",
                                "text": "In der Wirrnis des Großstadtverkehrs kann man leicht die Orientierung verlieren."
                            },
                            {
                                "example_id": "a78c259c-3549-415d-a4e3-9606329537af",
                                "sense_id": "2a431d97-0b74-310f-bcd7-d14fabe59424",
                                "text": "„Eine Autodroschke fährt die Invalidenstraße hinauf, schiebt sich langsam durch eine Wirrnis von Fußgängern und Elektrischen, erreicht den freieren Platz vor dem Bahnhof und eilt, wie erlöst hupend, über die Auffahrt am Stettiner Bahnhof.“"
                            },
                            {
                                "example_id": "4acbeb0a-50a2-4563-9aba-03aff1af092e",
                                "sense_id": "2a431d97-0b74-310f-bcd7-d14fabe59424",
                                "text": "„Im Kaleidoskop ihrer Schilderungen spiegelt sich die Wirrnis einer Zeit, die als »Stunde Null« in der Erinnerung derer gespeichert ist, die sie durchlebt haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8253f2e0-bf18-38a0-aace-4e6924fa9e76",
                        "entry_id": "987f442d-6980-3819-ab8c-2b99b8ac6a45",
                        "glosses": [
                            "geistiger Zustand der Orientierungslosigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b40993f-9763-4ead-aef8-d44276fdb985",
                                "sense_id": "8253f2e0-bf18-38a0-aace-4e6924fa9e76",
                                "text": "In seinem Kopf machte sich eine große Wirrnis breit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
