            {
                "entry_id": "f7780113-ddd7-34e4-b181-e633a7a41bd6",
                "word": "biffe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f0b482b1-df59-4f5b-bc0b-e40a88e91513",
                        "entry_id": "f7780113-ddd7-34e4-b181-e633a7a41bd6",
                        "tags": [
                            "plural"
                        ],
                        "form": "biffes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a6d301b-1fdb-37e1-9f45-79b5201d59c3",
                        "entry_id": "f7780113-ddd7-34e4-b181-e633a7a41bd6",
                        "glosses": [
                            "Activité des chiffonniers, récupération d’objets jetés."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "62e2d3e1-e6a3-4a7b-bd32-c7dc34077933",
                                "sense_id": "9a6d301b-1fdb-37e1-9f45-79b5201d59c3",
                                "text": "Théoriquement, la biffe est interdite aux éboueurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "b93ca051-39e8-3b3f-b7c3-daf29c512907",
                        "entry_id": "f7780113-ddd7-34e4-b181-e633a7a41bd6",
                        "glosses": [
                            "Infanterie de ligne. → voir biffin."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "3ab26c4f-6f13-4227-b199-00a21a33361b",
                                "sense_id": "b93ca051-39e8-3b3f-b7c3-daf29c512907",
                                "text": "On l’a trouvé dans la biffe en 1914, on l’a trouvé dans la Résistance. Et on l’a même trouvé ensuite pour en flétrir publiquement les excès."
                            },
                            {
                                "example_id": "0f893914-3af4-4c1e-9251-ac5dfbeb561d",
                                "sense_id": "b93ca051-39e8-3b3f-b7c3-daf29c512907",
                                "text": "Ça sait te manier les décisions et les contre-ordres, et la cavalerie, les tringlots, l’artillerie, le génie, les crapouillots, les avions, tout l’armement, quoi, et faire bousiller proprement la biffe à l’heure H, en quantité industrielle. La biffe boche, comme de juste !"
                            },
                            {
                                "example_id": "497cddfe-e03a-4d7b-a5cb-09f66a1376ea",
                                "sense_id": "b93ca051-39e8-3b3f-b7c3-daf29c512907",
                                "text": "A preuve que les margis d’artillerie qui acceptent de passer dans la biffe, on les nomme tout de suite sous-lieutenants…"
                            }
                        ]
                    },
                    {
                        "sense_id": "59763c1a-e350-341f-ad93-6052d9ef38eb",
                        "entry_id": "f7780113-ddd7-34e4-b181-e633a7a41bd6",
                        "glosses": [
                            "Division d’infanterie."
                        ],
                        "tags": [
                            "ellipsis",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "4617f4c4-f1ae-4425-9d33-e36b2975647c",
                                "sense_id": "59763c1a-e350-341f-ad93-6052d9ef38eb",
                                "text": "Il était écrit dessus, à la plume sergent major pour remplir les blancs, que le colonel Durafour, commandant la 8ᵉ Région militaire l’invitait à rejoindre son corps. Son corps à Toul. 4ᵉ Biffe. Dans les plus brefs délais."
                            }
                        ]
                    },
                    {
                        "sense_id": "104830aa-5502-3f66-93d8-585f2297303c",
                        "entry_id": "f7780113-ddd7-34e4-b181-e633a7a41bd6",
                        "glosses": [
                            "Pierre précieuse contrefaite."
                        ],
