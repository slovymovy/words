                "senses": [
                    {
                        "sense_id": "d748cd44-6059-3c91-8d45-bbced3778ac3",
                        "entry_id": "b157c981-7b6c-3b07-8f6b-fa8298bc60d4",
                        "glosses": [
                            "The natural state of a person or thing; quality; character or worth."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3c5f2b07-ebdb-4e98-93ef-cee918488343",
                                "sense_id": "d748cd44-6059-3c91-8d45-bbced3778ac3",
                                "text": "The importance of which may be fully and plainly rendered thus; that since nothing in the Universe stands possessed of a Real or True Nature, i.e. doth constantly and invariately hold the precise Quale, or Suchness of their particular Entity, to Eternity; […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "013d95c1-a003-3466-8745-458438aeb829",
                        "entry_id": "b157c981-7b6c-3b07-8f6b-fa8298bc60d4",
                        "glosses": [
                            "Existence per se."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "e361b094-ff67-4e4d-a62d-51cb6586b4cf",
                                "sense_id": "013d95c1-a003-3466-8745-458438aeb829",
                                "text": "ca. 1928, Hans Driesch, \"Philosophy of Nature\", in, 1928, Edward Leroy Schaub, ed., Philosophy Today: Essays on Recent Developments in the Field of Philosophy, page 431,\nThe same relation may prevail between the suchness of willing in men and the realization of that willing."
                            },
                            {
                                "example_id": "2e17c19d-0433-46ea-9c4d-e24dea88baba",
                                "sense_id": "013d95c1-a003-3466-8745-458438aeb829",
                                "text": "1955, J. D. Salinger, \"Franny\", in, 1961, Franny and Zooey, 1991 LB Books edition, page 22,\nWithout any apparent regard for the suchness of her environment, she sat down."
                            },
                            {
                                "example_id": "987a51bc-629f-440a-9e62-75aae518efb2",
                                "sense_id": "013d95c1-a003-3466-8745-458438aeb829",
                                "text": "Rather than give an answer, you have to section the tangerine and invite the questioner to have a taste. Doing this, you allow him or her to enter the suchness of the tangerine without any verbal or conceptual description."
                            }
                        ]
                    }
                ],
