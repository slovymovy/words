                ],
                "senses": [
                    {
                        "sense_id": "b64bffa5-0ccd-3265-9a68-73ffd3e932e3",
                        "entry_id": "ad3f29b7-fc67-3e21-a2ee-14fcbba75c47",
                        "glosses": [
                            "Reise, beispielsweise zur Erholung, auf die Kanaren (einer Inselgruppe im Atlantik vor Westafrika, die zu Spanien gehört)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c12e2fc-3a62-4c15-9700-7ca5204853d4",
                                "sense_id": "b64bffa5-0ccd-3265-9a68-73ffd3e932e3",
                                "text": "Lass uns zum Flughafen fahren, einfach einen Kanarenurlaub buchen und eine Woche ausspannen."
                            },
                            {
                                "example_id": "71249b9f-de6e-487b-8624-ea2f4697322c",
                                "sense_id": "b64bffa5-0ccd-3265-9a68-73ffd3e932e3",
                                "text": "„Allein unter Deutschen – Bayerische Volksmusik, Schnitzel zum Abendessen und rundherum nur nackte Deutsche. Für zwei Briten entwickelte sich der Kanarenurlaub zum Alptraum. Jetzt wollen die beiden ihr Geld zurück.“"
                            },
                            {
                                "example_id": "00e58c52-3ba2-4d29-ae48-ccf256374671",
                                "sense_id": "b64bffa5-0ccd-3265-9a68-73ffd3e932e3",
                                "text": "„Nur schnell vorbei an den Medienleuten. Nein, der brandenburgische SPD-Regierungschef, vom einwöchigen Kanarenurlaub sonnengebräunt, aber trotzdem sichtlich angegriffen, hat keine Lust auf Journalistenfragen.“"
                            },
                            {
                                "example_id": "1343a720-61e9-4c6e-9f9e-3ca97a3ff596",
                                "sense_id": "b64bffa5-0ccd-3265-9a68-73ffd3e932e3",
                                "text": "Sammeln Sie am Strand Herzmuscheln und packen Sie noch eine Handvoll schwarzen Lavasand ein. Das ganze in einem Glas drapiert auf dem Schreibtisch ist eine wunderschöne Erinnerung an den Kanarenurlaub."
                            },
                            {
                                "example_id": "be5d4813-6ab2-4eb0-82df-1303b30b5d28",
                                "sense_id": "b64bffa5-0ccd-3265-9a68-73ffd3e932e3",
                                "text": "[Coronapandemie 2020:] „Am Montag war ich mir sicher, zwischen klopapierraffenden Idioten zu leben, die eine Revolte anfangen werden, wenn ihr Kanarenurlaub platzt.“"
                            },
                            {
                                "example_id": "c2030187-b4e9-491d-8776-ab27062f82bd",
                                "sense_id": "b64bffa5-0ccd-3265-9a68-73ffd3e932e3",
                                "text": "„Wieder drängelte sich der Kanarenurlaub in sein Gedächtnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
