        "fr-extract.jsonl": [
            {
                "entry_id": "f6e74fc0-a238-3d8d-a7bf-9114743fbb5e",
                "word": "arrière-pensée",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "18772e79-3098-4aa7-b2da-45fd25c1232b",
                        "entry_id": "f6e74fc0-a238-3d8d-a7bf-9114743fbb5e",
                        "tags": [
                            "plural"
                        ],
                        "form": "arrière-pensées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                        "entry_id": "f6e74fc0-a238-3d8d-a7bf-9114743fbb5e",
                        "glosses": [
                            "Pensée que l’on tient secrète, intention que l’on cache, tandis qu’on en manifeste une autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "def0ce17-9be9-48ff-93f3-2e0fe0e7a757",
                                "sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                                "text": "Une lettre comme celle que je tiens, écrite par une jeune fille, une vraie jeune fille, sans arrière-pensée, avec enthousiasme…"
                            },
                            {
                                "example_id": "93009b7c-ffc9-4d69-884b-a7d1fcd3f3c1",
                                "sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                                "text": "Cette triste réflexion, […], fut le dernier calcul de sa diplomatie expirante. Dès lors il n'eut plus d'arrière-pensées, devint le jouet de son amour […]."
                            },
                            {
                                "example_id": "684319d3-99c4-43ca-9ae4-955590980b48",
                                "sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                                "text": "Les coups ne m'ont jamais rien fait. Au contraire, je leur dois de m'être créé tout jeune une philosophie qui me permet aujourd'hui d'apprécier de suite et sans arrière-pensée les bons et les mauvais moments."
                            },
                            {
                                "example_id": "19350beb-d137-401f-b15a-a6bb152db5e8",
                                "sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                                "text": "Toutefois, si un magnanime sentiment de fraternité s'imposait sincèrement et définitivement, sans arrière-pensée, à tous les esprits européens, alors nous n'aurions pas à nous inquiéter du cosmopolitisme marseillais, intéressant embryon de la civilisation future."
                            },
                            {
                                "example_id": "2e131c68-f1c5-440a-9781-680eccb1c6c3",
                                "sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                                "text": "Sa générosité n'est pas faiblesse ; son obligeance ne dépasse pas les obligations normales et naturelles ; aucune arrière-pensée en son comportement."
                            },
                            {
                                "example_id": "289e85f7-d8ac-4c92-b6bf-36d2a145ad22",
                                "sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                                "text": "19 avril 42 – Le présent emplit tout le champ de l’existence et c’est dans ce cas seulement qu’on peut vivre sans arrière-pensée. L’arrière-pensée est toujours une mauvaise pensée."
                            },
                            {
                                "example_id": "1dc6ed8a-24ef-49ee-a4e5-cf9ee856e2ad",
                                "sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                                "text": "Au nom de la lutte contre la haine, on en viendra même à traquer les arrière-pensées. (...). Tout cela rappelle l’Allemagne de l’Est et la Stasi. Je ne crois pas exagérer en disant cela. La lutte contre les « propos haineux » est le nouveau masque du totalitarisme."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e464812e-af80-45ed-8742-1411d7d86f61",
                        "source_entry_id": "f6e74fc0-a238-3d8d-a7bf-9114743fbb5e",
                        "source_sense_id": "388d7aa9-2e8a-32fa-a1bd-4ddfaa73acb5",
                        "target_lang_word": "ulterior motive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ulterior motive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "95af197d-1b40-39cf-aca8-95756e181e7c",
                                        "entry_id": "752969fa-642a-3e2c-af37-5698065cb52d",
                                        "glosses": [
                                            "An alternative or extrinsic reason for doing something, especially when concealed or when differing from the stated or apparent reason."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9054c08d-6b0c-4a2a-aee6-a31923d7676e",
                                                "sense_id": "95af197d-1b40-39cf-aca8-95756e181e7c",
                                                "text": "There lurks no bribe in the smell and beauty of the flower. Its charm has no ulterior motive."
                                            },
                                            {
                                                "example_id": "95bd6e98-2b5c-4a22-baf4-2b0d169eb92c",
                                                "sense_id": "95af197d-1b40-39cf-aca8-95756e181e7c",
                                                "text": "The poet is a man without a profit or any other kind of ulterior motive."
                                            },
                                            {
                                                "example_id": "14a8173d-beb5-4966-aafa-ee6852a828e0",
                                                "sense_id": "95af197d-1b40-39cf-aca8-95756e181e7c",
                                                "text": "I have an ulterior motive, of course. I want a progress report on the catalog. You've been so mysterious about the whole thing, people are starting to talk."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0862146-a151-42e6-80ca-eb4c84dda994",
                        "source_entry_id": "f6e74fc0-a238-3d8d-a7bf-9114743fbb5e",
