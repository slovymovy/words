                        "examples": [
                            {
                                "example_id": "311caf6c-0d65-46ac-b13a-886a73bdc105",
                                "sense_id": "e4550aaf-d01e-34c0-af2e-0d672f1279dd",
                                "text": "❬…❭ Я — твой мираж, заплакавший росой, // Ты — над природой молодая Геба, // Светлеешь самородною красой // В миражами заплакавшее небо."
                            }
                        ]
                    }
                ],
