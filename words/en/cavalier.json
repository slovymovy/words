        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8386ff78-8066-3d88-99df-d16004060254",
                    "sense_definition": "to act in a gallant, dashing, or attentive manner toward someone, especially a woman",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent the entire evening <w>cavaliering</w> the guests and ensuring everyone had a drink.",
                            "target_lang_translations": {
                                "ru": "Он провел весь вечер, <w>ухаживая</w> за гостями и следя за тем, чтобы у всех были напитки."
                            }
                        },
                        {
                            "text": "The young officer was seen <w>cavaliering</w> the lady across the ballroom.",
                            "target_lang_translations": {
                                "ru": "Видели, как молодой офицер <w>сопровождал</w> даму через бальный зал."
                            }
                        }
                    ],
                    "traits": [
