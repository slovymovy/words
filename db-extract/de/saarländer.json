                "translations": [
                    {
                        "translation_id": "fd574f2c-ffe5-40b2-a9ff-d5cce7f5337e",
                        "source_entry_id": "31c6027c-bcca-3d47-ac04-14aaf30f42ce",
                        "source_sense_id": "5941990a-499f-3b8a-9e57-4101909e714e",
                        "source_sense_description": "aus dem Saarland stammend, diesem zuzurechnen, in der Art und Weise des Saarlandes",
                        "target_lang_word": "Saarland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Saarland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1d343cd4-9b7b-3598-a264-ff636bd41bec",
                                        "entry_id": "b3e090c8-bbc3-3d85-b395-0554e82d3fe5",
                                        "glosses": [
                                            "A state of modern Germany."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80f5e99b-4660-42df-9fca-77511bdd7224",
                                                "sense_id": "1d343cd4-9b7b-3598-a264-ff636bd41bec",
                                                "text": "This was, even more strikingly, his attitude towards French actions in the Saarland. The Saar Landtag had approved in November 1947 a constitution instituting a monetary and customs union with France […]"
                                            },
                                            {
                                                "example_id": "a4afbb0d-63e1-40fd-9c58-7d001c00e4cf",
                                                "sense_id": "1d343cd4-9b7b-3598-a264-ff636bd41bec",
                                                "text": "The most famous sight in Saarland is the Saarschleife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8f54be66-b1f0-4217-866a-9a5f95299996",
                        "source_entry_id": "31c6027c-bcca-3d47-ac04-14aaf30f42ce",
                        "source_sense_id": "5941990a-499f-3b8a-9e57-4101909e714e",
                        "source_sense_description": "aus dem Saarland stammend, diesem zuzurechnen, in der Art und Weise des Saarlandes",
                        "target_lang_word": "sarrois",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarrois",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e5fd3c8-7b8a-39f7-b0b1-5171d48c3b29",
                                        "entry_id": "d9d9171a-d59f-3638-936f-6f62e2015897",
                                        "glosses": [
                                            "Relatif à la Sarre, rivière de France et d’Allemagne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "35c7b372-8fc2-36cf-a1bc-0e5741308cbf",
                                        "entry_id": "d9d9171a-d59f-3638-936f-6f62e2015897",
                                        "glosses": [
                                            "Relatif à la Sarre, rivière de Bretagne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bfb19069-efc3-3c38-8b40-39dd18241a92",
                                        "entry_id": "d9d9171a-d59f-3638-936f-6f62e2015897",
                                        "glosses": [
                                            "Relatif à la Sarre, successivement ancienne province française de l’Ancien Régime (1675-1697), ancien département français (de 1797 à 1815), mandat de la Société des Nations (1920-1935), protectorat français (1947–1957) et enfin land de la République fédérale d’Allemagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62a8e08f-9c63-4350-a96f-12ce5d5f8ef6",
                                                "sense_id": "bfb19069-efc3-3c38-8b40-39dd18241a92",
                                                "text": "Tout échange monétaire est délicat : il serait bon de faire coïncider l’introduction du saarmark, et plus encore l’introduction du franc, avec une amélioration des conditions matérielles et politiques de la vie sarroise."
                                            },
                                            {
                                                "example_id": "4e3d8bab-7167-41ce-b925-410b63cce885",
                                                "sense_id": "bfb19069-efc3-3c38-8b40-39dd18241a92",
                                                "text": "– Vous vous souvenez du jour de l’accident ? dit-elle tout en se demandant quel accent avait la gouvernante : souabe, saxon, sarrois ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "107427ef-229c-3245-87da-5acd4c3e357d",
                                        "entry_id": "d9d9171a-d59f-3638-936f-6f62e2015897",
                                        "glosses": [
                                            "Relatif à Sarre, commune d’Italie de la province d’Aoste dans la région de la Vallée d’Aoste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
