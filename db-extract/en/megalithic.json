                        "glosses": [
                            "Of or pertaining to megaliths, to the people who made them, or to the period when they were made."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "551801ce-19a9-4811-8114-82c4ba34c608",
                        "source_entry_id": "027e27ee-2951-30b3-bf38-3b912be90452",
                        "source_sense_id": "2d7d7890-81e4-3694-a982-65dc2be4d9a6",
                        "source_sense_description": "of or pertaining to megaliths",
                        "target_lang_word": "mégalithique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mégalithique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "db0f7237-dd17-3c60-bd6f-fc68c822fff7",
                                        "entry_id": "76826f7f-09de-35e9-a998-e0d7e7486d1a",
                                        "glosses": [
                                            "Relatif aux mégalithes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c7dafd1-7b29-4573-9b4b-b6cd87310b85",
                                                "sense_id": "db0f7237-dd17-3c60-bd6f-fc68c822fff7",
                                                "text": "L'aspect actuel d'un monument mégalithique se dressant sur un monticule a donné à Schumacher et Karge la fausse impression que les dolmens furent construits au-dessus des tumulus."
                                            },
                                            {
                                                "example_id": "8a169693-623a-4f5f-8f7b-763f195739bd",
                                                "sense_id": "db0f7237-dd17-3c60-bd6f-fc68c822fff7",
                                                "text": "La position de la tête est originale puisqu'elle est inclinée vers l'épaule droite, cette amorce de mouvement étant unique dans la statuaire mégalithique corse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c78bc85-0af3-3003-9e07-aa1d18f9ccc4",
                                        "entry_id": "76826f7f-09de-35e9-a998-e0d7e7486d1a",
                                        "glosses": [
                                            "Relatif à la civilisation mégalithique, à l’ère mégalithique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d872fd-9b9e-44ed-a0aa-5b4485b29520",
                                                "sense_id": "3c78bc85-0af3-3003-9e07-aa1d18f9ccc4",
                                                "text": "La civilisation mégalithique, qui succède à celle des cavernes, a surtout pour caractère saillant les grands monuments connus sous le nom de dolmens, allées couvertes, menhirs."
                                            },
                                            {
                                                "example_id": "f01d5689-c84a-4f6a-beaa-4e35aea225a5",
                                                "sense_id": "3c78bc85-0af3-3003-9e07-aa1d18f9ccc4",
                                                "text": "Une sépulture mégalithique a aussi été explorée au lieu dit le cimetière des Anglais, commune de Vauréal, près Pontoise, Seine-et-Oise, par M. A. de Caix de Saint-Aymour."
                                            },
                                            {
                                                "example_id": "4f1cb640-b7c5-4ef6-a177-1471acc3b4ed",
                                                "sense_id": "3c78bc85-0af3-3003-9e07-aa1d18f9ccc4",
                                                "text": "Le dolmen de Nuisy (Marne). — Il existe, sur le territoire de Saint-Quentin-le-Verger, près du hameau de Nuisy, un monument de l'époque mégalithique sur lequel nous serions heureux d'appeler l'attention des savants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
