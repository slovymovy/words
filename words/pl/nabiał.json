                    "frequency": "High",
                    "semantic_group_id": "jedzenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W tym sklepie <w>nabiał</w> znajduje się w lodówkach po prawej stronie.",
                            "target_lang_translations": {
                                "ru": "В этом магазине <w>молочные продукты</w> находятся в холодильниках справа."
                            }
                        },
                        {
                            "text": "Lekarz zalecił mi ograniczyć świeży <w>nabiał</w> ze względu na nietolerancję laktozy.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал мне ограничить свежую <w>молочку</w> из-за непереносимости лактозы."
                            }
                        }
                    ],
                    "common_phrases": [
