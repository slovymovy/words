            {
                "entry_id": "d90ed656-8049-3d38-967a-b8f065e85bab",
                "word": "milquetoast",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6c131f5a-756f-4f65-9dbf-e2769fa9e616",
                        "entry_id": "d90ed656-8049-3d38-967a-b8f065e85bab",
