                                "target_senses": [
                                    {
                                        "sense_id": "6e48e42d-88ed-379e-b35b-c07076ae3eb6",
                                        "entry_id": "013d6bf4-a1cb-329f-b2e6-a1e5302e1870",
                                        "glosses": [
                                            "zweitgrößtes Instrument der Familie der Streichinstrumente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc2d8e9-d863-443a-a215-25ca810b69e1",
                                                "sense_id": "6e48e42d-88ed-379e-b35b-c07076ae3eb6",
                                                "text": "„Die Geige oder das Cello muss auf den Spieler persönlich eingestellt werden.“"
                                            },
                                            {
                                                "example_id": "0db1eed9-a650-4429-811f-997afb334aa4",
                                                "sense_id": "6e48e42d-88ed-379e-b35b-c07076ae3eb6",
                                                "text": "„Bis Celli, Cellisten, Koffer, Kisten, Taschen in den zugeteilten Stockwerken sind, ist die Zeit gekommen, bis zu der wieder alles unten sein muss, um die Proben pünktlich zu erreichen.“"
                                            },
                                            {
                                                "example_id": "34405e95-faca-492e-9084-d2a29291d32e",
                                                "sense_id": "6e48e42d-88ed-379e-b35b-c07076ae3eb6",
                                                "text": "„Die menschliche Stimme des Cellos, das im Klang jedes andere Instrument übertrifft, ging mir zu Herzen, wenn Henriette es spielte, und sie wußte es.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
