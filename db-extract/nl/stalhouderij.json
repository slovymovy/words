        "nl-extract.jsonl": [
            {
                "entry_id": "7825268a-b385-36d2-992f-7c9bd788e813",
                "word": "stalhouderij",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "b2ebd27d-4096-44d6-83ce-53e037fbb078",
                        "entry_id": "7825268a-b385-36d2-992f-7c9bd788e813",
                        "tags": [
                            "plural"
                        ],
                        "form": "stalhouderijen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "37f06812-9dd6-30a3-84cf-6be6f58c9c5c",
                        "entry_id": "7825268a-b385-36d2-992f-7c9bd788e813",
                        "glosses": [
                            "bedrijf dat paarden houdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b81f2b8-7b8f-488f-8a4a-15e2ab1e9de7",
                                "sense_id": "37f06812-9dd6-30a3-84cf-6be6f58c9c5c",
                                "text": "Zeg aan de stalhouderij dat zij een paar paarden voor ons rijtuig moeten brengen, zei hij."
                            },
                            {
                                "example_id": "e62f9691-b50f-4709-b275-70e0c3501fda",
                                "sense_id": "37f06812-9dd6-30a3-84cf-6be6f58c9c5c",
                                "text": ",,Die hitte is voor de paarden niet te doen\", zegt Kristine Schouwink, van de gelijknamige stalhouderij die al sinds jaar en dag de plezierritjes verzorgt. De tochten per paardentram vervallen in ieder geval donderdag. ,,En als het niet afkoelt, en daar lijkt het niet op, dan rijden we zaterdag ook niet\", zegt Schouwink. Donderdag worden temperaturen van tegen de veertig graden voorspeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f500cc64-9732-488b-a6a1-69f81087f654",
                        "source_entry_id": "7825268a-b385-36d2-992f-7c9bd788e813",
                        "source_sense_id": "37f06812-9dd6-30a3-84cf-6be6f58c9c5c",
                        "source_sense_description": "bedrijf dat paarden houdt",
                        "target_lang_word": "livery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "livery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a686a72f-5626-3767-9873-904395b5e7fa",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "Any distinctive identifying uniform worn by a group, such as the uniform worn by chauffeurs and male servants."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2495fb9-6608-4e6b-8476-8e182a836d10",
                                                "sense_id": "a686a72f-5626-3767-9873-904395b5e7fa",
                                                "text": "And while the moralist, who is holding forth on the cover ( an accurate portrait of your humble servant), professes to wear neither gown nor bands, but only the very same long-eared livery in which his congregation is arrayed: yet, look you, one is bound to speak the truth as far as one knows it, whether one mounts a cap and bells or a shovel hat; and a deal of disagreeable matter must come out in the course of such an undertaking."
                                            },
                                            {
                                                "example_id": "09cf934d-33f7-44dd-81b6-dc908dd85466",
                                                "sense_id": "a686a72f-5626-3767-9873-904395b5e7fa",
                                                "text": "“I don't know how you and the ‘head,’ as you call him, will get on, but I do know that if you call my duds a ‘livery’ again there'll be trouble. It's bad enough to go around togged out like a life saver on a drill day, but I can stand that 'cause I'm paid for it. What I won't stand is to have them togs called a livery. […]”"
                                            },
                                            {
                                                "example_id": "6f2efae0-dfbc-471d-8c59-85d691963460",
                                                "sense_id": "a686a72f-5626-3767-9873-904395b5e7fa",
                                                "text": "By wearing livery, the brewers publicly expressed guild association and solidarity."
                                            },
                                            {
                                                "example_id": "225834d6-eaaa-45e3-a9e8-1c1287de1dbe",
                                                "sense_id": "a686a72f-5626-3767-9873-904395b5e7fa",
                                                "text": "The 35-year-old must adore this ground as this was his sixth strike in total here: four of these were previously in Manchester City livery, the other in that of Wolfsburg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1813c8bc-6df8-38ff-9aba-13e55ea4b162",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "The whole body of liverymen, members of livery companies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ac08687-374b-3646-bbad-ea1803648384",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "The paint scheme of a vehicle or fleet of vehicles."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49c493bd-3cf8-4463-991c-996d370a867c",
                                                "sense_id": "3ac08687-374b-3646-bbad-ea1803648384",
                                                "text": "The airline's new livery received a mixed reaction from the press."
                                            },
                                            {
                                                "example_id": "773534f7-9339-47a2-9dac-cb6aec9dfb5c",
                                                "sense_id": "3ac08687-374b-3646-bbad-ea1803648384",
                                                "text": "The glass fibre body has the advantage of lightness and obviates the need for painting as the material is self-coloured in the standard B.R. maroon livery."
                                            },
                                            {
                                                "example_id": "4d86adc7-4581-4b96-ac12-90c972e2a1ee",
                                                "sense_id": "3ac08687-374b-3646-bbad-ea1803648384",
                                                "text": "The roads were jammed with matatu minibuses sporting cartoonish liveries, and trucks billowing black smoke into the dazzling African light."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfbd96f2-5ddd-39eb-b9cc-ed38d8b53e2a",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "A taxicab or limousine."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fae4eeca-a836-3374-9504-a3c98acd3153",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "The delivery of property from one owner to the next."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a0d997f-5aaa-39d9-9ca5-8d25d79fda70",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "The writ by which property is obtained."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "64093362-d70c-3ca9-a1ef-8aa099abc441",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "The rental of horses or carriages; the rental of canoes; the care and/or boarding of horses for money."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c38d187d-945a-4d6b-b54c-5d2c783cd625",
                                                "sense_id": "64093362-d70c-3ca9-a1ef-8aa099abc441",
                                                "text": "[…] Pegasus does not stand at livery even at the largest establishment in Moorfields."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1927e9ed-f8f6-39b0-9313-36de4dc4b4cf",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "A stable that keeps horses or carriages for rental."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff735d9c-daf6-392d-800f-efca6fc23c86",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "An allowance of food; a ration, as given out to a family, to servants, to horses, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f70bfcc7-e09a-42e6-b0f7-fcac0db766f2",
                                                "sense_id": "ff735d9c-daf6-392d-800f-efca6fc23c86",
                                                "text": "The emperor's officers every night went through the town from house to house whereat any English gentleman did repast or lodge, and served their liveries for all night: first, the officers brought into the house a cast of fine manchet [white bread], and of silver two great post, and white wine, and sugar."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5370bd81-1990-3e5b-a653-f6231275e5dc",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "Release from wardship; deliverance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b92f2f3-32c8-4031-9f2b-4970dddfc493",
                                                "sense_id": "5370bd81-1990-3e5b-a653-f6231275e5dc",
                                                "text": "It concerned them first to sue out their livery from the unjust wardship of his encroaching prerogative."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49490a9c-4b71-3064-a569-6ac956465e9c",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "A low grade of wool."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d92c427-350d-397a-b12d-03e87be2b7f9",
                                        "entry_id": "4705204f-a6c5-3f3f-bb46-e7908036dc39",
                                        "glosses": [
                                            "Outward markings, fittings or appearance"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "841408f1-eb3e-4d6d-a68a-01b891b27320",
                                                "sense_id": "5d92c427-350d-397a-b12d-03e87be2b7f9",
                                                "text": "When forty winters shall beseige thy brow,\ndig deep trenches in thy beauty's field,\nThy youth's proud livery, so gazed on now,\nWill be a tatter'd weed, of small worth held:"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "livery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "261f1822-3b4a-3df2-aafc-cd7dee43a09e",
                                        "entry_id": "20668588-3313-39ea-b183-666912d218d3",
                                        "glosses": [
                                            "To clothe."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1dc92d5c-cda3-4e38-ade2-1131d153de2c",
                                                "sense_id": "261f1822-3b4a-3df2-aafc-cd7dee43a09e",
                                                "text": "He liveried his servants in the most modest of clothing."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "livery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5e5d208-a3ee-3292-9f69-62deb202101f",
                                        "entry_id": "66c10d58-b131-3ede-8f2f-6f5f8a4a66b6",
                                        "glosses": [
                                            "Like liver."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e3a18c7f-0b95-45d4-9cfc-167603d2c793",
                                                "sense_id": "b5e5d208-a3ee-3292-9f69-62deb202101f",
                                                "text": "We are happy for the chopped mushrooms within the warm goose liver paté, for the coarse, highly seasoned wedge has a robust livery flavour the 'shrooms manage to ease."
                                            },
                                            {
                                                "example_id": "1dd0b9b1-4e18-4935-a268-2d2822e47161",
                                                "sense_id": "b5e5d208-a3ee-3292-9f69-62deb202101f",
                                                "text": "A second test was similar, but we brought the internal temperature up to 130 degrees; the texture was chewy, the meat tasted livery, and had not melted."
                                            },
                                            {
                                                "example_id": "426bc071-cf93-48f2-b4ab-c3468d007048",
                                                "sense_id": "b5e5d208-a3ee-3292-9f69-62deb202101f",
                                                "text": "Sulfur-containing compounds (thiols, sulfides, thiazoles, sulfur-substituted furans) can interact with carbonyl compounds to produce a livery flavor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5919b2e2-7c0e-3d64-9aaa-2e44171ae4c6",
                                        "entry_id": "66c10d58-b131-3ede-8f2f-6f5f8a4a66b6",
                                        "glosses": [
                                            "Queasy, liverish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12c61fbc-2134-4824-a67e-313b8516842b",
                                                "sense_id": "5919b2e2-7c0e-3d64-9aaa-2e44171ae4c6",
                                                "text": "He woke feeling livery, and aware that he had overslept the morning."
                                            },
                                            {
                                                "example_id": "bb95c05c-0d32-4435-a279-22ff8024f847",
                                                "sense_id": "5919b2e2-7c0e-3d64-9aaa-2e44171ae4c6",
                                                "text": "The biliousness and livery feeling will disappear and the feeling of joy and happiness will be the reward."
                                            },
                                            {
                                                "example_id": "ffcd9ac4-c6be-4ee9-932f-993c4d5fde5a",
                                                "sense_id": "5919b2e2-7c0e-3d64-9aaa-2e44171ae4c6",
                                                "text": "He felt fresh and buoyant. When he was young, and had taken a siesta, he had felt livery for a couple of hours afterwards, with a tongue like a chicken run"
                                            },
                                            {
                                                "example_id": "b27a9b51-e583-48fd-9e57-14c394f2a0b2",
                                                "sense_id": "5919b2e2-7c0e-3d64-9aaa-2e44171ae4c6",
                                                "text": "To like everyone and to be happy with anyone was a virtue and its own reward, but I realized now that for weeks I had been feeling livery, impatient, restless."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
