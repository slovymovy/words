                                "target_lang_word": "moribundo",
                                "target_lang_sense_clarification": "dicho de la luz o el brillo que se apaga"
                            },
                            {
                                "target_lang_word": "declinante",
                                "target_lang_sense_clarification": "luz, fuerza o intensidad que disminuye"
                            },
                            {
                                "target_lang_word": "borroso",
                                "target_lang_sense_clarification": "recuerdo que pierde claridad"
                            }
                        ],
                        "zh": [
