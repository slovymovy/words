                "senses": [
                    {
                        "sense_id": "4c99c380-5739-37f3-bc5b-e1c13f1524a3",
                        "entry_id": "8d19925a-6950-3b39-b108-138abb11f5d0",
                        "glosses": [
                            "Rebellion des berberischen Volksstamms der Tuareg gegen die Unterdrückung durch die Regierungen von Mali und Niger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04a32d46-31e3-4d18-8d20-3da0725e4006",
                                "sense_id": "4c99c380-5739-37f3-bc5b-e1c13f1524a3",
                                "text": "„Vor mehr als einem Jahrzehnt kam es zu einem Tuareg-Aufstand, bei dem die Gruppe einen eigenen Staat forderte.“"
                            },
                            {
                                "example_id": "8b6b093e-ab89-4c07-8cf1-7fc339ef87ed",
                                "sense_id": "4c99c380-5739-37f3-bc5b-e1c13f1524a3",
                                "text": "„Höhepunkt dieses Konfliktes war der Tuareg-Aufstand von 2012, als die Befreiungsbewegung MNLA (Nationale Bewegung zur Befreiung des Azawad) mit ihrem Verbündeten, der islamistischen Terrororganisation Ansar Dine, den Norden Malis eroberte und den Tuareg-Staat Azawad ausrief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
