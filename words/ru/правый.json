                {
                    "sense_id": "c83c290c-939f-3d4f-ba75-a712b466ad6f",
                    "sense_definition": "Находящийся с той стороны тела, которая противоположна сердцу; противоположный левому.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В школе меня учили писать <w>правой</w> рукой.",
                            "target_lang_translations": {
                                "en": "In school, I was taught to write with my <w>right</w> hand.",
                                "it": "A scuola mi hanno insegnato a scrivere con la mano <w>destra</w>."
                            }
                        },
                        {
                            "text": "Магазин находится на <w>правой</w> стороне улицы.",
                            "target_lang_translations": {
                                "en": "The store is located on the <w>right</w> side of the street.",
                                "it": "Il negozio si trova sul lato <w>destro</w> della strada."
                            }
                        },
                        {
                            "text": "У него сильно болело <w>правое</w> плечо.",
                            "target_lang_translations": {
                                "en": "His <w>right</w> shoulder hurt badly.",
                                "it": "Gli faceva molto male la spalla <w>destra</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "левый"
                    ],
                    "common_phrases": [
                        "правая рука",
                        "правая сторона",
                        "правый берег",
                        "на правой стороне"
                    ],
                    "target_lang_definitions": {
                        "en": "Located on the side of the body opposite the heart; opposite of left.",
                        "it": "Situato sul lato del corpo opposto al cuore; opposto a sinistro."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "right",
                                "target_lang_sense_clarification": "direction/side"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "destro",
                                "target_lang_sense_clarification": "direzione o lato"
                            }
                        ]
                    }
