                "senses": [
                    {
                        "sense_id": "039bb1e2-9045-333b-b167-92d9484981df",
                        "entry_id": "c9aa5bf9-bbb4-3d89-b43c-d002c8c452f6",
                        "glosses": [
                            "Goutte qui pend au nez."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "968874bb-c9d5-42f1-8398-1729333199a2",
                                "sense_id": "039bb1e2-9045-333b-b167-92d9484981df",
                                "text": "Avoir la roupie au nez."
                            },
                            {
                                "example_id": "6f762fe3-489d-4bc2-ac0a-5e246233dc13",
                                "sense_id": "039bb1e2-9045-333b-b167-92d9484981df",
                                "text": "Il lui coule perpétuellement du nez une roupie qu’il recueille dans un mouchoir rouge, grand comme un drap."
                            }
                        ]
                    },
                    {
                        "sense_id": "e154e164-b01c-3872-a6ef-1938a6f59e54",
                        "entry_id": "c9aa5bf9-bbb4-3d89-b43c-d002c8c452f6",
                        "glosses": [
                            "Goutte."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "40e39590-2f77-45bc-8ea4-b3d5036af335",
                                "sense_id": "e154e164-b01c-3872-a6ef-1938a6f59e54",
                                "text": "Les murs ruisselaient d’humidité, secrétaient des roupies, distillaient des gouttes de café noir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07faf41f-efe1-4207-9cc8-5dc63cb7793d",
                        "source_entry_id": "c9aa5bf9-bbb4-3d89-b43c-d002c8c452f6",
                        "target_lang_word": "snot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "994a3472-a298-3a9d-972d-5b01cc62ebec",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "Mucus, especially mucus from the nose."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa36b87-e889-4ac2-97cb-57ff89ff708a",
                                                "sense_id": "994a3472-a298-3a9d-972d-5b01cc62ebec",
                                                "text": "Once, I remember, the little fair-haired boy had a choking fit at dinner, and a stream of snot ran out of his nose on to his plate in a way horrible to see."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ca7ca02-069d-33db-b389-36ccda399252",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "A contemptible child."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e6c6859-c81b-49e7-8b44-d88430e60804",
                                                "sense_id": "5ca7ca02-069d-33db-b389-36ccda399252",
                                                "text": "With no warning a gang of little snots — none larger or older than I was — threw me to the ground, pulled my knickers below my knees — without any explanation, and allowed me to get up."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a32d859a-ce0a-3909-acc2-1d2d73dad2e7",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "A mean fellow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2fc5f90-f2fb-3e97-83c7-aa2d1d7f65ad",
                                        "entry_id": "4b9e0177-e076-38b1-ae99-c4a3da477add",
                                        "glosses": [
                                            "The flamed out wick of a candle."
                                        ],
                                        "tags": [
                                            "Northern-England",
