                "senses": [
                    {
                        "sense_id": "bb36f3b5-18cd-3291-aeb1-faee1c3be629",
                        "entry_id": "c9b8cbc1-828a-32ca-a5e1-bd69fab93e12",
                        "glosses": [
                            "Donner un caractère infernal à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d517cdd6-92c3-4288-961d-f7304fc980b6",
                                "sense_id": "bb36f3b5-18cd-3291-aeb1-faee1c3be629",
                                "text": "Est-ce humaniser les rapports humains, ou les infernaliser ?"
                            },
                            {
                                "example_id": "9b304e2a-05b5-47c0-9f15-08ae80293578",
                                "sense_id": "bb36f3b5-18cd-3291-aeb1-faee1c3be629",
                                "text": "Le christianisme, au moins pendant les premiers siècles et la barbarisation médiévale, ne parvint pas à infernaliser complètement sa vision de l’au-delà."
                            },
                            {
                                "example_id": "aebc7717-46fc-417e-ab20-71a24dfc14bf",
                                "sense_id": "bb36f3b5-18cd-3291-aeb1-faee1c3be629",
                                "text": "Mustapha Niasse, Tanor Dieng et les autres vont tout faire pour lui infernaliser la vie."
                            }
                        ]
                    }
                ],
