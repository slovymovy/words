{
    "word_family": [
        "Konsequenz",
        "Inkonsequenz",
        "inkonsequent",
        "konsequenterweise"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f009d722-7ae0-3659-830e-bb081e875563",
                    "sense_definition": "ein Ziel oder einen Plan fest und ohne Abweichung verfolgend; entschlossen und beharrlich handelnd",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "verhalten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er verfolgte seine beruflichen Pläne stets sehr <w>konsequent</w> und erreichte schließlich seine Ziele.",
                            "target_lang_translations": {
                                "en": "He always pursued his career plans very <w>consistently</w> and eventually reached his goals."
                            }
                        },
                        {
                            "text": "Eltern sollten bei wichtigen Regeln verlässlich bleiben und diese auch im Alltag <w>konsequent</w> einhalten.",
                            "target_lang_translations": {
                                "en": "Parents should remain reliable regarding important rules and enforce them <w>consistently</w> in everyday life."
                            }
                        }
                    ],
                    "synonyms": [
                        "beharrlich",
                        "zielstrebig",
                        "entschlossen"
                    ],
                    "antonyms": [
                        "inkonsequent"
                    ],
                    "common_phrases": [
                        "ein Ziel konsequent verfolgen",
                        "eine konsequente Haltung"
                    ],
                    "target_lang_definitions": {
                        "en": "firmly and persistently pursuing a goal or plan without deviating; acting decisively and consistently"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consistent",
                                "target_lang_sense_clarification": "unwavering in actions, rules, or behavior"
                            },
                            {
                                "target_lang_word": "resolute",
                                "target_lang_sense_clarification": "determined and steadfast in pursuing a course"
                            },
                            {
                                "target_lang_word": "rigorous",
                                "target_lang_sense_clarification": "strictly adhering to a plan or principles"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67a37665-e0ba-3162-a162-d3a1e1c87e81",
                    "sense_definition": "logisch folgerichtig aufgebaut und frei von Widersprüchen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "logik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seine Argumentation im Vortrag war vollkommen <w>konsequent</w> und überzeugte alle Anwesenden.",
                            "target_lang_translations": {
                                "en": "His argumentation during the presentation was completely <w>coherent</w> and convinced everyone present."
                            }
                        },
                        {
                            "text": "Das neue Gesetz ist die <w>konsequente</w> Fortführung der bisherigen Reformen des Staates.",
                            "target_lang_translations": {
                                "en": "The new law is the <w>logical</w> continuation of the state's previous reforms."
                            }
                        }
                    ],
                    "synonyms": [
                        "folgerichtig",
                        "logisch",
                        "schlüssig"
                    ],
                    "antonyms": [
                        "inkonsequent"
                    ],
                    "common_phrases": [
                        "eine konsequente Fortführung",
                        "die konsequente Umsetzung"
                    ],
                    "target_lang_definitions": {
                        "en": "logically coherent, consistent, and free of contradictions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "consistent",
                                "target_lang_sense_clarification": "free of internal contradiction or discrepancy"
                            },
                            {
                                "target_lang_word": "logical",
                                "target_lang_sense_clarification": "rationally structured and following naturally"
                            },
                            {
                                "target_lang_word": "consequential",
                                "target_lang_sense_clarification": "following as a natural result or logical continuation"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}