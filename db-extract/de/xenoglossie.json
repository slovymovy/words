                    {
                        "sense_id": "7b428cf0-6abc-3166-b87d-262c462b6949",
                        "entry_id": "7b29dc8e-1a3a-3d08-bf34-ce4e113f3433",
                        "glosses": [
                            "„unbewusstes Reden in einer unbekannten Fremdsprache“"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dff22a1-a673-4cf8-8790-4058ac0e6baa",
                                "sense_id": "7b428cf0-6abc-3166-b87d-262c462b6949",
                                "text": "Xenoglossie ist ein Phänomen, das der aus religiösen Kontexten bekannten Glossolalie eng verwandt ist."
                            },
                            {
                                "example_id": "ebf3dc7b-7f47-4b10-81a5-815aad69408c",
                                "sense_id": "7b428cf0-6abc-3166-b87d-262c462b6949",
                                "text": "„Xenoglossie wird das Reden in einer nie erlernten oder gehörten Sprache genannt und ist nicht mit → Zungenrede (Glossolalie) zu verwechseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
