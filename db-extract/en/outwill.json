                        "glosses": [
                            "To surpass in force of will."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "640b17b0-ae32-4551-bc49-a6a6ec4f13eb",
                                "sense_id": "85543376-271a-35c1-90a0-66c9992f0fdd",
                                "text": "Many times a whole audience will not only be crowded into a small room, but are noisy disbelievers, call it all a humbug, distract the mind of the magnetizer, and added to these, absolutely outwill the magnetizer, in their wish to bring odium upon the science, and carry their points and gain their ends."
                            },
                            {
                                "example_id": "68dff6e6-de05-4e93-b69f-9bf4850be541",
                                "sense_id": "85543376-271a-35c1-90a0-66c9992f0fdd",
                                "text": "Even if not, Somali resolve would have still remained strong enough during World War I to outwill the British."
                            }
                        ]
                    }
