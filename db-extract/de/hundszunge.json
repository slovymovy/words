                                            {
                                                "example_id": "af83f29c-73ac-47ec-a14d-cb2516bbd480",
                                                "sense_id": "86bf0046-3140-37fd-9941-c26e4be311ac",
                                                "text": "On a des Noires depuis longtemps, des grises (des Maghrébines) depuis longtemps aussi et puis toute l'Europe de l'est qui déferle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
