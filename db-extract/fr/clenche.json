                ],
                "senses": [
                    {
                        "sense_id": "ffa88f76-481c-39eb-87dc-22c9dba343a4",
                        "entry_id": "73f79eb6-eb23-3195-94e7-a41ad16fe7db",
                        "glosses": [
                            "Partie d'une ancienne serrure, la clenche est une barre de métal qui pivote autour d'un axe située à son extrémité, l'autre bout dépassant de la porte se bloque dans le mentonnet. On soulève la clenche grâce au poucier."
                        ],
                        "tags": [
                            "Serrurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "b88bb703-f1c4-4af7-bd41-80bd62592a95",
                                "sense_id": "ffa88f76-481c-39eb-87dc-22c9dba343a4",
                                "text": "Connaissant bien les habitudes de mère Barberin, je savais que la porte ne serait fermée qu’à la clenche et que nous pourrions entrer dans la maison."
                            },
                            {
                                "example_id": "6e54b436-e3e3-408f-a3dd-a04387338bbc",
                                "sense_id": "ffa88f76-481c-39eb-87dc-22c9dba343a4",
                                "text": "Un bruit de clenche les fit sursauter : l’infirmière avait ouvert la porte du pavillon."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e975c5c-8af0-3f35-8abc-3fce51ead8ea",
                        "entry_id": "73f79eb6-eb23-3195-94e7-a41ad16fe7db",
                        "glosses": [
                            "Petit levier faisant bascule sur lequel on appuie pour lever le loquet d’une porte, C'est le poucier."
                        ],
                        "tags": [
                            "Canada",
                            "Est de la France"
                        ],
                        "examples": [
                            {
                                "example_id": "35a4455b-5584-4c83-bdf4-edbd47cd0960",
                                "sense_id": "5e975c5c-8af0-3f35-8abc-3fce51ead8ea",
                                "text": "Tourner la clenche."
                            }
                        ]
                    },
                    {
                        "sense_id": "86f60362-1ace-3e3c-ac4a-cae174c5c98b",
                        "entry_id": "73f79eb6-eb23-3195-94e7-a41ad16fe7db",
                        "glosses": [
                            "Petit levier sur lequel on appuie pour chasser l'eau du réservoir vers la cuvette des toilettes."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "be6969e8-2b02-3621-808a-e6a1e6abade0",
                        "entry_id": "73f79eb6-eb23-3195-94e7-a41ad16fe7db",
                        "glosses": [
                            "Poignée de porte, bec-de-cane."
                        ],
                        "tags": [
                            "Belgique",
                            "Nord et Est de la France",
                            "Normandie…"
                        ],
                        "examples": [
                            {
                                "example_id": "9347857c-a27b-4fc8-8f48-1a80d23089e1",
                                "sense_id": "be6969e8-2b02-3621-808a-e6a1e6abade0",
                                "text": "Avant même que Zwakh ait pu poser la main sur la clenche, la porte d’entrée s’ouvrit de l’intérieur et un costaud à cheveux noirs gominés nous reçut avec des courbettes."
                            },
                            {
                                "example_id": "1e697e6b-86f0-4d40-a488-8a75fea48674",
                                "sense_id": "be6969e8-2b02-3621-808a-e6a1e6abade0",
                                "text": "La clenche de la porte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3e833f09-0521-4eeb-a42c-ac58b0813e33",
                        "source_entry_id": "73f79eb6-eb23-3195-94e7-a41ad16fe7db",
                        "source_sense_description": "levier",
                        "target_lang_word": "Klinke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Klinke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                        "entry_id": "6b5f21a5-8c64-337c-a347-f451ebcef7cf",
                                        "glosses": [
                                            "Hebel zum Öffnen einer Tür durch Verschieben eines Riegels"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83abf42c-616c-45da-b829-f02a9396a160",
                                                "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                                "text": "Sie drückte vorsichtig die Klinke herunter."
                                            },
                                            {
                                                "example_id": "376cc51a-1240-4cab-97e1-3c4d2f313bb4",
                                                "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                                "text": "„Er drückte die Klinke mit der rechten Hand nach unten, legte seine linke Hand unterstützend darauf und zog ruckartig.“"
                                            },
                                            {
                                                "example_id": "c590dc8d-b17c-442a-a505-564cf165dec7",
                                                "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                                "text": "„Und kaum hatte der Offizier die Klinke wieder losgelassen, als Mawra Kusminitschna kehrt machte und mit ihren schnellen Greisinnenschritten über den Hof zu dem weiter hinten liegenden Nebenhause ging, in dem sie ihr Zimmer hatte.“"
                                            },
                                            {
                                                "example_id": "1010f638-1790-44db-a8a2-d09a5aee1268",
                                                "sense_id": "c7d5781c-4c96-3de3-9b85-c7e073d5a37d",
                                                "text": "„Ich drücke die Klinke des Ladens nieder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4c045b93-339b-3986-95ad-0264e66514b7",
                                        "entry_id": "6b5f21a5-8c64-337c-a347-f451ebcef7cf",
                                        "glosses": [
                                            "Maschinenteil, das eine bestimmte Bewegung hemmt"
