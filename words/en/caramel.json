{
    "word_family": [
        "caramelize",
        "caramelization",
        "caramelized"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ac328cdf-e271-3482-90e6-d274c13a9197",
                    "sense_definition": "A smooth, sweet food made by heating sugar until it melts and turns brown, often used as a sauce or flavoring.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love the taste of salted <w>caramel</w> ice cream.",
                            "target_lang_translations": {
                                "ru": "Я обожаю вкус мороженого с солёной <w>карамелью</w>.",
                                "zh": "我喜欢海盐<w>焦糖</w>冰淇淋的味道。"
                            }
                        },
                        {
                            "text": "You need to heat the sugar slowly to make the <w>caramel</w> without burning it.",
                            "target_lang_translations": {
                                "ru": "Нужно медленно нагревать сахар, чтобы приготовить <w>карамель</w>, не пережарив её.",
                                "zh": "你需要慢慢加热糖，这样才能做出<w>焦糖</w>而不会把它烧焦。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "salted caramel",
                        "caramel sauce",
                        "crème caramel",
                        "caramel apple"
                    ],
                    "target_lang_definitions": {
                        "ru": "Гладкая сладкая масса, получаемая нагреванием сахара до коричневого цвета, часто используется как соус или добавка.",
                        "zh": "通过加热糖使其融化并变成棕色而制成的光滑甜味食品，常作为酱汁或调味品使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карамель",
                                "target_lang_sense_clarification": "жжёный сахар, сладость"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦糖",
                                "target_lang_sense_clarification": "作为调味品或酱汁的焦糖"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0ea67b20-4ccf-3f18-8ff0-ae02cc69b728",
                    "sense_definition": "A small, individual piece of chewy candy made from cooked sugar.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She offered me a sticky <w>caramel</w> from the jar on her desk.",
                            "target_lang_translations": {
                                "ru": "Она предложила мне липкую <w>карамель</w> из банки на её столе.",
                                "zh": "她从桌上的罐子里拿出一块粘粘的<w>焦糖糖果</w>给我。"
                            }
                        },
                        {
                            "text": "The dentist told him to avoid eating chewy <w>caramels</w> to protect his fillings.",
                            "target_lang_translations": {
                                "ru": "Стоматолог велел ему не есть жевательную <w>карамель</w>, чтобы сберечь пломбы.",
                                "zh": "牙医告诉他为了保护补牙处，要避免吃耐嚼的<w>太妃糖</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chewy caramel",
                        "bag of caramels"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая отдельная жевательная конфета из вареного сахара.",
                        "zh": "一种由煮熟的糖制成的小块耐嚼糖果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карамель",
                                "target_lang_sense_clarification": "конфета"
                            },
                            {
                                "target_lang_word": "ириска",
                                "target_lang_sense_clarification": "мягкая конфета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦糖糖果",
                                "target_lang_sense_clarification": "作为糖果的焦糖"
                            },
                            {
                                "target_lang_word": "太妃糖",
                                "target_lang_sense_clarification": "口感相似的耐嚼糖果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9a771b1-ec3a-371e-a500-e04be6967565",
                    "sense_definition": "A light yellowish-brown color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The walls were painted in a warm <w>caramel</w> that made the room feel cozy.",
                            "target_lang_translations": {
                                "ru": "Стены были выкрашены в теплый цвет <w>карамели</w>, что делало комнату уютной.",
                                "zh": "墙壁被漆成了温暖的<w>焦糖色</w>，让房间感觉很温馨。"
                            }
                        },
                        {
                            "text": "She bought a leather bag in a rich <w>caramel</w> to match her boots.",
                            "target_lang_translations": {
                                "ru": "Она купила кожаную сумку насыщенного цвета <w>карамели</w> под свои сапоги.",
                                "zh": "她买了一个浓郁<w>焦糖色</w>的皮包来搭配她的靴子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amber",
                        "golden-brown"
                    ],
                    "common_phrases": [
                        "caramel shade",
                        "caramel tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светлый желтовато-коричневый цвет.",
                        "zh": "一种浅黄褐色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "карамельный цвет",
                                "target_lang_sense_clarification": "оттенок"
                            },
                            {
                                "target_lang_word": "цвет карамели",
                                "target_lang_sense_clarification": "оттенок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "焦糖色",
                                "target_lang_sense_clarification": "颜色名称"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ace78b66-2b96-30c1-bad4-a1b9309a069a",
                    "sense_definition": "Having a light yellowish-brown color.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has beautiful <w>caramel</w> eyes that catch the sunlight.",
                            "target_lang_translations": {
                                "ru": "У него красивые <w>карамельные</w> глаза, которые ловят солнечный свет.",
                                "zh": "他有一双美丽的<w>焦糖色</w>眼睛，在阳光下闪闪发光。"
                            }
                        },
                        {
                            "text": "The coat is available in black, navy, and <w>caramel</w> colors.",
                            "target_lang_translations": {
                                "ru": "Пальто доступно в черном, темно-синем и <w>карамельном</w> цветах.",
                                "zh": "这件外套有黑色、藏青色和<w>焦糖色</w>可选。"
                            }
                        }
                    ],
                    "synonyms": [
                        "amber",
                        "golden-brown"
                    ],
                    "common_phrases": [
                        "caramel skin",
                        "caramel hair",
                        "caramel color"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий светлый желтовато-коричневый цвет.",
                        "zh": "具有浅黄褐色的。"
                    },
                    "translations": {
