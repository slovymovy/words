                            {
                                "example_id": "8380663c-b196-4b58-bee5-8eaddb8c320a",
                                "sense_id": "a8e812a0-db79-3a8a-8b15-1e1a7e5bceb0",
                                "text": "This separation between a “Merchant right” and a “Brahmin left” is visible in nearly all Western democracies",
