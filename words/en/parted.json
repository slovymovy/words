                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crowd <w>parted</w> to let the ambulance pass through the street.",
                            "target_lang_translations": {
                                "ru": "Толпа <w>раздвинулась</w>, чтобы пропустить машину скорой помощи по улице."
                            }
