                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "paradisiacal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                                        "entry_id": "1b53f422-c6b9-32aa-82cc-baeaf2787199",
                                        "glosses": [
                                            "Of or resembling paradise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08a6b158-2f4b-4019-b7a7-c12e543f7fc8",
                                                "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                                                "text": "I read and re-read her letter, and some softened feelings stole into my heart, and dared to whisper paradisiacal dreams of love and joy; but the apple was already eaten, and the angel's arm bared to drive me from all hope."
                                            },
                                            {
                                                "example_id": "8c744525-2bda-45e1-96e5-27244713ea59",
                                                "sense_id": "57eff6ad-8397-3a28-b087-65bd8c8a1d9b",
                                                "text": "We believe in the literal gathering of Israel and in the restoration of the Ten Tribes; that Zion (the New Jerusalem) will be built upon the American continent; that Christ will reign personally upon the earth; and, that the earth will be renewed and receive its paradisiacal glory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f6107286-8e01-4698-a815-fa6604b5f9ae",
                        "source_entry_id": "edead3e2-8e76-36af-8459-68ad6f2e366d",
                        "target_lang_word": "heavenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "heavenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85f89e87-7d59-3bc1-a209-f12347b7d83a",
                                        "entry_id": "d1442812-591a-3456-8ed9-4334a8e6bd69",
                                        "glosses": [
                                            "Of or pertaining to the heaven believed in by many religions."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bcdf9616-b6c9-3040-9218-329a37b10c4b",
                                        "entry_id": "d1442812-591a-3456-8ed9-4334a8e6bd69",
                                        "glosses": [
                                            "Synonym of celestial: of or pertaining to the heavens, the sky regarded as the realm of the sun, moon, planets, and stars."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91176922-9671-3d7d-9a2e-5480dd7a7468",
                                        "entry_id": "d1442812-591a-3456-8ed9-4334a8e6bd69",
                                        "glosses": [
                                            "Of or pertaining to the kingdom of God."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4484548b-c0d3-4893-8961-d96da82a6bae",
                                                "sense_id": "91176922-9671-3d7d-9a2e-5480dd7a7468",
                                                "text": "1817, Charles Phillips (author-editor), Speech in the Case of O′Mullan v. M′Korkill, The Speeches of Charles Phillips, page 131,\nNo doubt, you have all personally considered — no doubt, you have all personally experienced, that of all the blessings which it has pleased Providence to allow us to cultivate, there is not one which breathes a purer fragrance, or bears an heavenlier aspect than education."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a801a69-c50f-3830-ac6d-a522dca92e94",
                                        "entry_id": "d1442812-591a-3456-8ed9-4334a8e6bd69",
                                        "glosses": [
                                            "Strongly or sublimely beautiful or pleasurable."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "047e5a20-64c0-44e0-8c00-51ff147c4be7",
                                                "sense_id": "7a801a69-c50f-3830-ac6d-a522dca92e94",
                                                "text": "Oh, please continue giving me a massage—it's absolutely heavenly."
                                            },
                                            {
                                                "example_id": "87e73bb3-f18e-4198-bf18-20f0c708196e",
                                                "sense_id": "7a801a69-c50f-3830-ac6d-a522dca92e94",
                                                "text": "So he flew down and got that acorn, and fetched it up and dropped it in, and was just tilting his head back, with the heavenliest smile on his face, when all of a sudden he was paralyzed into a listening attitude and that smile faded gradually out of his countenance like breath off’n a razor, and the queerest look of surprise took its place."
                                            },
                                            {
                                                "example_id": "f1630884-71e6-41dd-85a9-588f0dadb87b",
                                                "sense_id": "7a801a69-c50f-3830-ac6d-a522dca92e94",
                                                "text": "Everything is wonderful / Being here is heavenly"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "heavenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "65f854ea-9874-31ca-a7d6-8869fafd1bb7",
                                        "entry_id": "498c8b5f-df09-3451-9169-8baef5ff8e40",
                                        "glosses": [
                                            "In a manner like that of heaven; by the influence or agency of heaven; divinely, miraculously."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa112b03-7f8e-4689-bc35-f178c6b6feb0",
                                                "sense_id": "65f854ea-9874-31ca-a7d6-8869fafd1bb7",
                                                "text": "by night [she] saw that God in her armes, saying moreover unto her, that the next day, the first man she met withall, should heavenly pay her her wages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b19e05de-99c3-31ff-8425-366242836148",
                                        "entry_id": "498c8b5f-df09-3451-9169-8baef5ff8e40",
                                        "glosses": [
                                            "To a degree such as to elicit great pleasure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92bf44cc-4d24-49bd-9ba9-68e794d3b75e",
                                                "sense_id": "b19e05de-99c3-31ff-8425-366242836148",
                                                "text": "Then, we taste the refried beans and the rice, and they are so heavenly delicious."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
