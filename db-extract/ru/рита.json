                                    {
                                        "sense_id": "ce87fe6c-c0b3-3438-8c3d-9597aded3cc6",
                                        "entry_id": "22d1731f-001f-3c61-864e-cef2a6397444",
                                        "glosses": [
                                            "A female given name from the Romance languages, Italian, or Spanish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
