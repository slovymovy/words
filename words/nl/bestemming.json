                {
                    "sense_id": "8523230e-0431-307b-8f4c-52baaa310d88",
                    "sense_definition": "het doel of de functie die iets in de toekomst zal hebben",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "doel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente heeft een nieuwe <w>bestemming</w> voor het oude schoolgebouw gevonden.",
                            "target_lang_translations": {
                                "en": "The municipality has found a new <w>purpose</w> for the old school building.",
                                "ru": "Муниципалитет нашел новое <w>назначение</w> для старого здания школы."
                            }
                        },
                        {
                            "text": "De <w>bestemming</w> van dit terrein is veranderd van industrie naar woningbouw.",
                            "target_lang_translations": {
                                "en": "The <w>zoning</w> of this site has changed from industrial to residential.",
                                "ru": "<w>Целевое использование</w> этого участка изменилось с промышленного на жилую застройку."
                            }
                        }
                    ],
