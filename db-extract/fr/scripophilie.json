                    {
                        "sense_id": "090459fe-7845-3c7f-bc0a-f9b6b914a015",
                        "entry_id": "2816c9d0-7bef-37ce-ad18-5db66e6dbc2a",
                        "glosses": [
                            "Collection des anciens titres de bourse et des actions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "443d64ae-6d52-4248-b3c4-f41108fc3703",
                                "sense_id": "090459fe-7845-3c7f-bc0a-f9b6b914a015",
                                "text": "Après la scripophilie qui glorifie les mauvaises « actions », la billetophilie est en train de naître."
                            },
                            {
                                "example_id": "6da99120-888d-43f1-93cb-64357b38be4c",
                                "sense_id": "090459fe-7845-3c7f-bc0a-f9b6b914a015",
                                "text": "Les grandes spécialités comme la scripophilie (collection d’actions et de titres anciens), les cartes postales et affiches de cinéma ou les poupées font l’objet de dispersions régulières dans les salles de vente."
                            },
                            {
                                "example_id": "7c81697c-0592-4433-8e00-43282bf47d9d",
                                "sense_id": "090459fe-7845-3c7f-bc0a-f9b6b914a015",
                                "text": "Dans le domaine de la numismatique, un nouveau secteur s’est ouvert aux amateurs de billets de banque avec plusieurs ventes à Drouot et l’ouverture, pour la première fois à Paris, d’un Salon du billet de banque et du papier monnaie organisé par l’expert numismate Alain Weil. Après la scripophilie (actions périmées), la billetophilie est née."
                            }
                        ]
                    }
