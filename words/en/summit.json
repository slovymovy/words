{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "473c3225-939d-3795-9f74-2cf6dceada08",
                    "sense_definition": "The highest point of a hill or mountain.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It took us six hours to reach the <w>summit</w> of the mountain.",
                            "target_lang_translations": {
                                "ru": "Нам потребовалось шесть часов, чтобы добраться до <w>вершины</w> горы.",
                                "tr": "Dağın <w>zirvesine</w> ulaşmamız altı saatimizi aldı."
                            }
                        },
                        {
                            "text": "Snow covers the <w>summit</w> throughout the entire year.",
                            "target_lang_translations": {
                                "ru": "Снег покрывает <w>вершину</w> круглый год.",
                                "tr": "Kar, tüm yıl boyunca <w>zirveyi</w> kaplar."
                            }
                        }
                    ],
                    "synonyms": [
                        "peak",
                        "top",
                        "apex",
                        "crest",
                        "pinnacle",
                        "vertex",
                        "crown"
                    ],
                    "antonyms": [
                        "base"
                    ],
                    "common_phrases": [
                        "reach the summit",
                        "mountain summit",
                        "snow-capped summit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Самая высокая точка холма или горы.",
                        "tr": "Bir tepenin veya dağın en yüksek noktası."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "географическая"
                            },
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "острая вершина"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zirve",
                                "target_lang_sense_clarification": "coğrafi yüksek nokta"
                            },
                            {
                                "target_lang_word": "doruk",
                                "target_lang_sense_clarification": "dağ tepesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b710a0b4-3b45-3dfc-8d5f-d237f4867a35",
                    "sense_definition": "An official meeting or gathering of leaders of governments to discuss important matters.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president attended a <w>summit</w> on climate change in Paris.",
                            "target_lang_translations": {
                                "ru": "Президент посетил <w>саммит</w> по изменению климата в Париже.",
                                "tr": "Başkan, Paris'te iklim değişikliği üzerine yapılan bir <w>zirveye</w> katıldı."
                            }
                        },
                        {
                            "text": "Leaders from twenty countries arrived for the economic <w>summit</w>.",
                            "target_lang_translations": {
                                "ru": "Лидеры двадцати стран прибыли на экономический <w>саммит</w>.",
                                "tr": "Yirmi ülkeden liderler ekonomik <w>zirve</w> için geldi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hold a summit",
                        "attend a summit",
                        "emergency summit",
                        "global summit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальная встреча глав правительств для обсуждения важных вопросов.",
                        "tr": "Hükümet liderlerinin önemli konuları görüşmek üzere yaptığı resmi toplantı veya bir araya gelme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "саммит",
                                "target_lang_sense_clarification": "встреча лидеров"
                            },
                            {
                                "target_lang_word": "встреча на высшем уровне",
                                "target_lang_sense_clarification": "официальное название"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zirve",
                                "target_lang_sense_clarification": "liderler toplantısı"
                            },
                            {
                                "target_lang_word": "zirve toplantısı",
                                "target_lang_sense_clarification": "üst düzey görüşme"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "861444f4-4f97-3fd3-98b1-a3fdcc135d22",
                    "sense_definition": "The highest level of achievement, success, or development.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_peak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winning the gold medal was the <w>summit</w> of her athletic career.",
                            "target_lang_translations": {
                                "ru": "Завоевание золотой медали стало <w>вершиной</w> её спортивной карьеры.",
                                "tr": "Altın madalya kazanmak, onun spor kariyerinin <w>zirvesiydi</w>."
                            }
                        },
                        {
                            "text": "The band reached the <w>summit</w> of their popularity in the nineties.",
                            "target_lang_translations": {
                                "ru": "Группа достигла <w>пика</w> своей популярности в девяностые.",
                                "tr": "Grup, popülerliklerinin <w>zirvesine</w> doksanlarda ulaştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "acme",
                        "zenith",
                        "apex",
                        "pinnacle",
                        "apogee",
                        "height"
                    ],
                    "antonyms": [
                        "nadir"
                    ],
                    "common_phrases": [
                        "summit of success",
                        "summit of ambition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высшая ступень достижений, успеха или развития.",
                        "tr": "Başarı, gelişim veya bir durumun ulaştığı en üst düzey."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вершина",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "пик",
                                "target_lang_sense_clarification": "максимальный уровень"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zirve",
                                "target_lang_sense_clarification": "en yüksek seviye"
                            },
                            {
                                "target_lang_word": "doruk noktası",
                                "target_lang_sense_clarification": "başarının tepe noktası"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5300dacb-34f2-30d9-a141-c4771b96a27f",
                    "sense_definition": "To climb to the top of a mountain.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_top",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many climbers have <w>summited</w> Everest, but it remains a dangerous challenge.",
                            "target_lang_translations": {
                                "ru": "Многие альпинисты <w>покорили</w> Эверест, но это остаётся опасной задачей.",
                                "tr": "Birçok dağcı Everest'in <w>zirvesine tırmandı</w>, ancak bu tehlikeli bir zorluk olmaya devam ediyor."
                            }
                        },
                        {
                            "text": "They plan to <w>summit</w> the peak before noon to avoid the storm.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>взойти на</w> вершину до полудня, чтобы избежать шторма.",
                                "tr": "Fırtınadan kaçınmak için öğleden önce <w>zirve yapmayı</w> planlıyorlar."
                            }
                        }
                    ],
                    "synonyms": [
                        "surmount"
                    ],
                    "common_phrases": [
                        "summit a mountain",
                        "successfully summit"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подняться на вершину горы.",
                        "tr": "Bir dağın zirvesine tırmanmak, zirve yapmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "покорять вершину",
                                "target_lang_sense_clarification": "достигать верха"
                            },
                            {
                                "target_lang_word": "восходить",
                                "target_lang_sense_clarification": "подниматься"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zirveye tırmanmak",
                                "target_lang_sense_clarification": "dağın tepesine çıkmak"
                            },
                            {
                                "target_lang_word": "zirve yapmak",
                                "target_lang_sense_clarification": "tırmanışı tamamlamak"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce874ebe-bd68-3ff4-8375-f704bb7ea254",
                    "sense_definition": "To attend an official meeting of leaders.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "political_meeting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomats have been <w>summiting</w> all week to resolve the crisis.",
                            "target_lang_translations": {
                                "ru": "Дипломаты всю неделю <w>проводили встречи на высшем уровне</w>, чтобы разрешить кризис.",
                                "tr": "Diplomatlar krizi çözmek için bütün hafta <w>zirve toplantıları düzenliyorlar</w>."
                            }
                        },
                        {
                            "text": "The two presidents <w>summited</w> in a neutral country to discuss peace.",
                            "target_lang_translations": {
                                "ru": "Два президента <w>встретились на саммите</w> в нейтральной стране, чтобы обсудить мир.",
                                "tr": "İki başkan barışı görüşmek için tarafsız bir ülkede <w>zirvede bir araya geldi</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Участвовать в официальной встрече лидеров.",
                        "tr": "Liderlerin katıldığı resmi bir zirve toplantısına katılmak."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "участвовать в саммите",
                                "target_lang_sense_clarification": "принимать участие"
                            },
                            {
                                "target_lang_word": "встречаться на высшем уровне",
                                "target_lang_sense_clarification": "проводить переговоры"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "zirve toplantısı yapmak",
                                "target_lang_sense_clarification": "üst düzey görüşmek"
                            }
                        ]
                    }
                }
            ]
        },
        {
