                    },
                    {
                        "translation_id": "79294a12-1bf5-40aa-bcac-5ae76c146641",
                        "source_entry_id": "184ea666-33dd-3050-bbec-f0138fe7507d",
                        "source_sense_id": "01c54068-a028-3894-a8a2-ca88dfc714c2",
                        "target_lang_word": "swarf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab2136e9-60cb-3e8b-aa93-aff3a7f3207b",
                                        "entry_id": "834bcbef-d909-3802-9b8d-a1ddf6211e28",
                                        "glosses": [
                                            "The waste chips or shavings from an abrasive activity, such as metalworking, a saw cutting wood, or the use of a grindstone or whetstone."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c95711a-1270-4b75-8e22-d357d1e989d0",
                                                "sense_id": "ab2136e9-60cb-3e8b-aa93-aff3a7f3207b",
                                                "text": "Filings of iron, called Swarf, the barrel — — 0 [shillings] 2 [pence]"
                                            },
                                            {
                                                "example_id": "61cbd379-4582-4d36-89b9-ff138d302607",
                                                "sense_id": "ab2136e9-60cb-3e8b-aa93-aff3a7f3207b",
                                                "text": "The softest and almost the cleanest iron for turning for cotton and other machinery is made from wrought iron swarf (or turnings). Sometimes the swarf is worked by itself, but commonly a ball is made of good swarf, and while hot, fine swarf is thrown into the furnace, and the ball is rolled about so that the swarf adheres to it, and it is then taken to the hammer."
                                            },
                                            {
                                                "example_id": "bb6c3116-c4c1-441d-8a0c-cb7a2a15e18d",
                                                "sense_id": "ab2136e9-60cb-3e8b-aa93-aff3a7f3207b",
                                                "text": "As sandpaper is pushed across wood, the abrasive grains dig into the surface and cut out minute shavings, which are called swarf in industry jargon."
                                            },
                                            {
                                                "example_id": "b056228f-d249-4e1a-a863-2d8c37893cf4",
                                                "sense_id": "ab2136e9-60cb-3e8b-aa93-aff3a7f3207b",
                                                "text": "Turning of the internal features of horn antennas is an operation where particular attention must be paid to swarf control. Techniques such as the use of extreme flood coolant, interrupting the feed to break swarf, and regular withdrawals of the tool to clear the working area may be necessary, particular on CNC [computer numerical control] machines where the operator has no \"feel\" or sight of the process."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "067ae8d9-850e-3d19-978c-6650f840a259",
                                        "entry_id": "834bcbef-d909-3802-9b8d-a1ddf6211e28",
                                        "glosses": [
                                            "A particular waste chip or shaving."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09d4a4a9-0e9f-4e58-92d0-12ebd1cf1413",
                                                "sense_id": "067ae8d9-850e-3d19-978c-6650f840a259",
                                                "text": "These swarfs, especially if they are of the tin bronze type, can usually be re-melted, after passing over a magnetic separator, by adding a small percentage to each charge of the alloy issued to the foundry for melting."
                                            },
                                            {
                                                "example_id": "5c0faed6-ff2a-4416-95b1-c9d8081fa90b",
                                                "sense_id": "067ae8d9-850e-3d19-978c-6650f840a259",
                                                "text": "Harrogate looked at the ground. A black swarf packed with small parts in a greasy mosaic."
                                            },
                                            {
                                                "example_id": "3a00345e-491a-4f42-9ec2-08e43823847d",
                                                "sense_id": "067ae8d9-850e-3d19-978c-6650f840a259",
                                                "text": "When the uncut swarf thickness increases beyond the minimum swarf thickness, the elastic deformation phenomena decrease significantly and the entire depth of cut is removed as a swarf as shown in Fig. 9.9c."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3c9cf4a-ba70-345f-ba30-55c225358af2",
                                        "entry_id": "482b24bc-af4b-3e40-acd4-cf4cfd046096",
                                        "glosses": [
                                            "To grind down."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "269a0021-fb65-482c-80c4-3cac906385e4",
                                                "sense_id": "a3c9cf4a-ba70-345f-ba30-55c225358af2",
                                                "text": "A machine for swarfing the joining edges of parts or sub-assemblies having compound angle surfaces is announced by the Rockford Machine Tool Co., Rockford, 111."
                                            },
                                            {
                                                "example_id": "00f21546-f536-4007-95a3-64aa781ec2cb",
                                                "sense_id": "a3c9cf4a-ba70-345f-ba30-55c225358af2",
                                                "text": "Hydraulic mill is used for swarfing the joining edges of parts or sub-assemblies with compound surfaces."
                                            },
                                            {
                                                "example_id": "038ebd45-6fe1-4345-9056-f054eda3caf0",
                                                "sense_id": "a3c9cf4a-ba70-345f-ba30-55c225358af2",
                                                "text": "This weakend^([sic – meaning weakened]) layer is swarfed off by rubbing of chip, consequently, severe cratering is manifested on tool face after total cutting time Tc. However, the whole interacted layer is not swarfed off, and the influence of thin residual layer is ignored at the theoretical analysis."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "57083723-abb1-3d67-9bf1-9d955f11b8e1",
                                        "entry_id": "04a961d2-6ceb-381b-bb5e-3b3980e3e56a",
                                        "glosses": [
                                            "To grow languid; to faint."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "766dd453-8453-4b7f-acb4-c5fe478f5baf",
                                                "sense_id": "57083723-abb1-3d67-9bf1-9d955f11b8e1",
                                                "text": "Meg, rinnin like a flae in blanket, / Her coats upon a lang nail hanket, / That gart her coup the creels [i.e., fall head over heels] an' ſqueel, / \"Ah! Sirce, I'm gruppet by a de'il!\" / An' as ſhe near the threſhold lay, / Wae's me! ſhe near hand ſwarf'd away!"
                                            },
                                            {
                                                "example_id": "aa3da0aa-09e7-415c-95c8-0ede8d21d855",
                                                "sense_id": "57083723-abb1-3d67-9bf1-9d955f11b8e1",
                                                "text": "Moreover, the evil reputation of the master, and his strange and doubtful end, or at least, sudden disappearance, prevented any, excepting the most desperate of men, to seek any advice or opinion from the servant; wherefore, the poor vermin was likely at first to swarf for very hunger."
                                            },
                                            {
                                                "example_id": "49330a00-47f3-49a9-8635-05a243c85c6c",
                                                "sense_id": "57083723-abb1-3d67-9bf1-9d955f11b8e1",
                                                "text": "But afore her volumes fell into my hauns, my soul had been frichtened by a' kinds of traditionary terrors, and mony hunder times hae I maist swarfed wi' fear in lonesome spats in muirs and woods, at midnicht, when no a leevin thing was movin but mysel and the great moon."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "swarf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5bf7ab9a-104d-39c6-910f-309dd36a9464",
                                        "entry_id": "a432b122-6c81-386b-a062-e4aecc83af70",
                                        "glosses": [
                                            "A faint or swoon."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aed74224-7788-4c99-ac49-b509fbba11bc",
                                                "sense_id": "5bf7ab9a-104d-39c6-910f-309dd36a9464",
                                                "text": "And when they had ſo continued feaſting for a ſhort time, they had been ſo ſerved before, and the food was ſo rare and excellent, that they fell into a ſwarf, and cried out, Cant[icle of Canticles] ii. 4, 5. 'He hath brought me into the banqueting-houſe, and his banner over me was love. O ſtay me with flaggons, comfort me with apples, for I am ſick of love.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
