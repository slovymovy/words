                        "form": "индюка́х"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ca26db64-d422-3b2f-9a23-1a02d22425a6",
                        "entry_id": "0e9710a7-9b4f-37b7-be06-d4860ab798de",
                        "glosses": [
                            "самец индейки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f7e3cfe-cf46-4085-81aa-82311f4be083",
                                "sense_id": "ca26db64-d422-3b2f-9a23-1a02d22425a6",
                                "text": "Индюк, распустив хвост и чертя крыльями землю, надменно […] кружил вокруг тонкошеих индюшек."
                            },
                            {
                                "example_id": "2a9381d0-cf90-4847-af01-383e937d1b00",
                                "sense_id": "ca26db64-d422-3b2f-9a23-1a02d22425a6",
                                "text": "Индюк завидовал Гусям, / Что могут плавать там и сям."
                            },
                            {
                                "example_id": "40342c98-8508-49b9-a2f2-574e831412dd",
                                "sense_id": "ca26db64-d422-3b2f-9a23-1a02d22425a6",
                                "text": "— Цып! Цып! Цып! — раздался её голос. Озарённая солнцем, […] она стояла посреди зелёного двора… и со всех сторон к ней бежали куры, петухи, поспешали, как-бы стесняясь своей тяжеловатой неловкости, индюки."
                            }
                        ]
                    },
                    {
                        "sense_id": "886ace4f-2b14-3b54-9425-32a460c4747d",
                        "entry_id": "0e9710a7-9b4f-37b7-be06-d4860ab798de",
                        "glosses": [
                            "перен., разг., бран. о глупом, заносчивом, надменном человеке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cf57ef3-1b56-486d-b1b3-b7a6255ed068",
                                "sense_id": "886ace4f-2b14-3b54-9425-32a460c4747d",
                                "text": "— Только мне неудивительно, как это вы курс кончили, образование получили, а вместо того, чтобы этого индюка наставлять, руку его держите."
                            },
                            {
                                "example_id": "3eea5fc5-09b2-4062-9ae5-adc835c52732",
                                "sense_id": "886ace4f-2b14-3b54-9425-32a460c4747d",
                                "text": "Индюк — одно из выражений Паустовского. Это о тех, что чванливы и глупы, как индюки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8132f2be-456e-4acd-af4e-8adc949d6a52",
                        "source_entry_id": "0e9710a7-9b4f-37b7-be06-d4860ab798de",
                        "source_sense_description": "Птица",
                        "target_lang_word": "turkey",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "turkey",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79d602d7-8c60-3d39-9215-83f1932ef67b",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "The guinea fowl (family Numididae)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50cdc18f-68f5-32f0-b4b6-ffc37f9fbac2",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A bird in the genus Meleagris with a fan-shaped tail and wattled neck, especially the wild turkey (Meleagris gallopavo, now domesticated)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bf925f3-f201-4099-b719-6756220c0809",
                                                "sense_id": "50cdc18f-68f5-32f0-b4b6-ffc37f9fbac2",
                                                "text": "It was a Turkey! He never could have stood upon his legs, that bird. He would have snapped 'em short off in a minute, like sticks of sealing-wax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6150f3e-212e-3f8f-8c66-ee004f6dc24c",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "The flesh or meat of this bird eaten as food."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "10001443-1e57-472e-8050-f7be426fd681",
                                                "sense_id": "a6150f3e-212e-3f8f-8c66-ee004f6dc24c",
                                                "text": "All week after Thanksgiving, I had turkey sandwiches for lunch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "480c6b9d-24e9-3716-8bad-c13aaf463490",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "With a distinguishing word: a bird resembling the Meleagris gallopavo (for example, the brush turkey or bush turkey (Alectura lathami), and the water turkey (Anhinga anhinga))."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3fa5ed3d-704b-3ee9-a6bb-c161a029342c",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "An act of throwing three strikes in a row."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a7d1d00-783e-3475-b51c-9a4c5c8a01de",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A patient feigning symptoms; a person faking illness or injury; a malingerer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f1703700-c920-402d-be36-038215b776f6",
                                                "sense_id": "4a7d1d00-783e-3475-b51c-9a4c5c8a01de",
                                                "text": "Mumford (1970) noted that the terms ‘crock’, ‘gomer’, and ‘turkey’, were sometimes utilized by interns to designate different types of undesirable patients, and sometimes used synonymously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e4c4088-dec1-375d-b483-a053983f6a5c",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A pack carried by a lumberman; a bindle; also, a large travel bag, a suitcase."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "US",
                                            "countable",
                                            "dated",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "42eeddf3-fc67-3f30-bed6-3fbf3201a0e0",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A failure."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be5b39b-f26a-4f52-9f7c-b4a917b36e4e",
                                                "sense_id": "42eeddf3-fc67-3f30-bed6-3fbf3201a0e0",
                                                "text": "That film was a turkey."
                                            },
                                            {
                                                "example_id": "3caf3bb0-34c8-4861-91f2-5a065471472d",
                                                "sense_id": "42eeddf3-fc67-3f30-bed6-3fbf3201a0e0",
                                                "text": "And despite the gross incompetence of Hemmings' direction, the ludicrous script, and the heavy-handed acting, there remains a stellar reason to see and enjoy Just a Gigolo: David Bowie. David Bowie is a great actor, and not even this turkey can obscure that fact."
                                            },
                                            {
                                                "example_id": "b2ef1ec4-6679-4ed3-bc4d-38071446ebcb",
                                                "sense_id": "42eeddf3-fc67-3f30-bed6-3fbf3201a0e0",
                                                "text": "There were a few turkeys. In the rush to present a futuristic vision, the railways' heritage was largely forgotten and we ended up with new stations at Euston and at Coventry, its brash sidekick which I particularly loathe, although (of course) it won design awards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b837eac-2711-3c61-9565-cbb74b6fb8e4",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A foolish or inept person."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "derogatory",
                                            "mildly",
                                            "slang",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee63ab55-7dbf-496e-ab2a-9a5c962781cd",
                                                "sense_id": "2b837eac-2711-3c61-9565-cbb74b6fb8e4",
                                                "text": "The turkey cut in front of me and then berated me for running into him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "916056bb-d042-35df-8dfe-7f57e7fa13ca",
                                        "entry_id": "53bfc023-d994-32e1-8ed5-ecb1e7853b33",
                                        "glosses": [
                                            "A prostitute."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
