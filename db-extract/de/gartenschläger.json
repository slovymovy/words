                "senses": [
                    {
                        "sense_id": "8882fe95-955c-30fe-9b16-1b8fe5c0f401",
                        "entry_id": "80e33988-bcf8-3853-aeed-d439375a3db1",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75d6f210-0158-46d1-80ec-e4fbd36b5e99",
                                "sense_id": "8882fe95-955c-30fe-9b16-1b8fe5c0f401",
                                "text": "Die Gartenschlägers fahren heute nach Kassel."
                            },
                            {
                                "example_id": "179cc9eb-4036-4191-8360-8dcef399c6df",
                                "sense_id": "8882fe95-955c-30fe-9b16-1b8fe5c0f401",
                                "text": "Der Gartenschläger trägt nie die Schals, die die Gartenschläger ihm strickt."
                            },
                            {
                                "example_id": "a6e4e059-d52d-49f0-ad3b-a136042757bb",
                                "sense_id": "8882fe95-955c-30fe-9b16-1b8fe5c0f401",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gartenschläger kommt, geht der Herr Gartenschläger.“"
                            },
                            {
                                "example_id": "9a818843-138c-4a44-9af6-d4de6493ddfe",
                                "sense_id": "8882fe95-955c-30fe-9b16-1b8fe5c0f401",
                                "text": "Gartenschläger kommt und geht."
                            },
                            {
                                "example_id": "80a7aa58-dd5e-4e8d-abb0-7334d9a39459",
                                "sense_id": "8882fe95-955c-30fe-9b16-1b8fe5c0f401",
                                "text": "Gartenschlägers kamen, sahen und siegten."
                            },
                            {
                                "example_id": "f75bba54-5913-4516-a20b-a351e3bae39b",
                                "sense_id": "8882fe95-955c-30fe-9b16-1b8fe5c0f401",
                                "text": "Frau Gartenschläger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6af6f1db-5d31-4d60-9f85-795dd04931a4",
                                "sense_id": "8882fe95-955c-30fe-9b16-1b8fe5c0f401",
                                "text": "Herr Gartenschläger wollte uns kein Interview geben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
