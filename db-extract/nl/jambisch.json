                                "target_senses": [
                                    {
                                        "sense_id": "f9d90422-a068-3928-afc4-74213f97db3c",
                                        "entry_id": "a989b965-491f-3c9e-8825-7c79576e0f58",
                                        "glosses": [
                                            "Qui est composé d’ïambes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f623065-0510-4da7-b242-6fcec214472d",
                                                "sense_id": "f9d90422-a068-3928-afc4-74213f97db3c",
                                                "text": "Après Archiloque, de Paros, qui vivait dans le septième siècle avant J. C. , et qui fut l'inventeur du vers ïambique, on doit citer Slésichore , d'Himère en Sicile, qui florissait environ 570 ans avant J. C."
                                            },
                                            {
                                                "example_id": "d12143ca-f94b-491e-98a6-58b47efea4f8",
                                                "sense_id": "f9d90422-a068-3928-afc4-74213f97db3c",
                                                "text": "Il [Henry Céard] a longtemps vécu au bord de la mer bretonne, il y a écrit un livre amer et fulgurant ; mais les rythmes et les embruns de l’Océan, pénétrant en lui à son insu, l’ont emporté jusqu’au vers ïambique de quatorze pieds, avec, au sommet, l’écume déferlante."
                                            }
                                        ]
                                    }
