                "senses": [
                    {
                        "sense_id": "6966798a-33b7-3bb0-bc7d-cc74d459c9ff",
                        "entry_id": "6cbd2634-d8c6-3897-8a2a-a43b21206f7a",
                        "glosses": [
                            "von Abfall abgetrenntes Stoffgemisch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ba17fb8-9db6-4d84-9bdb-5b0da8e45ea3",
                                "sense_id": "6966798a-33b7-3bb0-bc7d-cc74d459c9ff",
                                "text": "„Das Syngas-Verfahren ist nur eines der derzeit entwickelten Verfahren für die Verwertung dieser Abfallfraktion – andere Unternehmen forschen zum Beispiel an biotechnischen Verfahren, den Müll zu Ethanol zu vergären.“"
                            },
                            {
                                "example_id": "45040058-6b03-41a9-8d4a-5af5849d951b",
                                "sense_id": "6966798a-33b7-3bb0-bc7d-cc74d459c9ff",
                                "text": "„In der menschlichen Konsumgesellschaft kommt der Rückgewinnung von Rohstoffen aus Abfall wachsende Bedeutung zu […] Voraussetzung ist eine möglichst gute Trennung der Abfallfraktionen.“"
                            },
                            {
                                "example_id": "bcad3241-b68c-4fd3-94e8-ba0c51e3b372",
                                "sense_id": "6966798a-33b7-3bb0-bc7d-cc74d459c9ff",
                                "text": "„Verpackte Lebensmittelabfälle seien grundsätzlich jeweils von der Verpackung und nach den jeweiligen Abfallfraktionen getrennt zu sammeln und zu befördern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
