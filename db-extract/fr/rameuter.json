                "senses": [
                    {
                        "sense_id": "a55bb7ab-71c1-3f67-a35b-7ac3cb3baacf",
                        "entry_id": "e11a973d-4bd8-304e-86a1-7edf96f6db99",
                        "glosses": [
                            "Ramener les chiens en meute, en arrêtant ceux qui vont trop en avant."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "186adec3-aa9e-3edd-99f8-aa8e1bb3c23a",
                        "entry_id": "e11a973d-4bd8-304e-86a1-7edf96f6db99",
                        "glosses": [
                            "Rappeler ses comparses pour faire un mauvais coup."
                        ],
                        "tags": [
                            "familiar",
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0da2b5ef-b7bd-45c7-b893-87a8e8aa32d6",
                                "sense_id": "186adec3-aa9e-3edd-99f8-aa8e1bb3c23a",
                                "text": "Couvert de sang et d'hématomes dans la rue, il a refusé de suivre les fonctionnaires de la brigade anticriminalité et a rameuté le voisinage"
                            }
                        ]
                    },
                    {
                        "sense_id": "8eb99ff7-66d6-32b5-af7b-058624499294",
                        "entry_id": "e11a973d-4bd8-304e-86a1-7edf96f6db99",
                        "glosses": [
                            "Faire revenir des gens, rappeler."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cad044ed-202d-424f-aac4-0b0fd517dfc6",
                                "sense_id": "8eb99ff7-66d6-32b5-af7b-058624499294",
                                "text": "Réélu, le maire de Baie-Comeau devra rameuter les jeunes pour sauver la ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "39dba02e-b82c-3065-93a8-35b41b95c024",
                        "entry_id": "e11a973d-4bd8-304e-86a1-7edf96f6db99",
                        "glosses": [
                            "Venir en meute, en groupe."
                        ],
