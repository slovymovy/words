        "fr-extract.jsonl": [
            {
                "entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                "word": "sagement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                        "entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                        "glosses": [
                            "D’une manière sage, prudente, avisée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a70bc707-ee30-4c23-996b-fd98fecc3091",
                                "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                                "text": "Il s’est toujours conduit sagement. — Vous parlez sagement. — Il a sagement mené sa barque. —Il a toujours vécu sagement."
                            },
                            {
                                "example_id": "136b5e18-91ad-4039-8eae-cc0191cf0b1c",
                                "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                                "text": "Là, en dehors du bruit et du remue-ménage de la basse-cour, dans l’isolement, l’ombre et le silence, les glousses demeuraient sagement sur leurs œufs pendant les vingt-et-un jours de l’incubation."
                            },
                            {
                                "example_id": "fc57a402-b74f-4f24-baba-4036d5dee2c3",
                                "sense_id": "7410cfad-ec8d-3c70-86a8-2091d71ed222",
                                "text": "Tu bosses le temps qu'il faut, bien sagement et je nous vois dans un beau petit appart à Georgetown."
                            }
                        ]
                    },
                    {
                        "sense_id": "8ab7d28c-b691-34be-82e6-7402a6318996",
                        "entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                        "glosses": [
                            "Sans faire de bruit, sans distraire les autres sin faire de bêtises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fccab03f-ac89-4cd6-a3ab-ed0e06d05ea7",
                                "sense_id": "8ab7d28c-b691-34be-82e6-7402a6318996",
                                "text": "Un groupe d’enfants y jouait à la dînette dans un petit coin aménagé en cuisine, en mini-cuisine plus exactement, avec mini-gazinière, mini-réfrigérateur, mini-table et mini-chaises ; d’autres assemblaient des cubes de plastique de toutes les couleurs ; certains dessinaient sagement, assis à leur pupitre."
                            }
                        ]
                    },
                    {
                        "sense_id": "c3ba8a27-758e-3a10-a074-a87e7948927f",
                        "entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                        "glosses": [
                            "Avec correction et sans originalité, en parlant de la manière d'exécuter un ouvrage d'art."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "c2325563-ba36-4661-ad63-843660aff5d3",
                                "sense_id": "c3ba8a27-758e-3a10-a074-a87e7948927f",
                                "text": "Un livre écrit sagement, un tableau peint sagement ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c399efbf-11d1-47d7-9afe-b8623f0ac915",
                        "source_entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                        "target_lang_word": "with wisdom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "7f7160db-a8e7-42e8-b084-564411eb49c5",
                        "source_entry_id": "e1cafb43-8edd-35c0-ab4e-6e313b49a170",
                        "target_lang_word": "wisely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wisely",
