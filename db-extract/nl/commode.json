                                    },
                                    {
                                        "sense_id": "d55f280b-eda0-3c67-a3a4-21ae927d5a56",
                                        "entry_id": "a78f8d15-165f-3fdc-99f1-2a7c6c012d85",
                                        "glosses": [
                                            "A chair containing a chamber pot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8a62051d-2511-491f-9996-c741672f52f2",
                                                "sense_id": "d55f280b-eda0-3c67-a3a4-21ae927d5a56",
                                                "text": "Changing bandages and emptying the commode doesn’t exactly create a sexy environment, but we never talk about doctors’ appointments or heart problems when we’re in our room – we preserve that little bit of space for ourselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be3a0f76-6864-3a21-9baa-105168f07113",
                                        "entry_id": "a78f8d15-165f-3fdc-99f1-2a7c6c012d85",
                                        "glosses": [
                                            "A toilet."
                                        ],
                                        "tags": [
                                            "South-Asia",
                                            "US",
                                            "euphemistic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9f69af1-cceb-37eb-b9e1-d8e0f56374dd",
                                        "entry_id": "a78f8d15-165f-3fdc-99f1-2a7c6c012d85",
                                        "glosses": [
                                            "A kind of woman's headdress, raising the hair and fore part of the cap to a great height."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17b382af-2aa6-4901-8316-2fe16faae4cb",
                                                "sense_id": "a9f69af1-cceb-37eb-b9e1-d8e0f56374dd",
                                                "text": "Then at the Play-Houſe ye ogle the Boxes, and dop and bovv to thoſe you do not knovv, as vvell as thoſe you do. […] You nuzzle your Noſes into their Hoods and Commodes, […]"
                                            },
                                            {
                                                "example_id": "76a500ab-b886-4af4-bfda-961346f1f16f",
                                                "sense_id": "a9f69af1-cceb-37eb-b9e1-d8e0f56374dd",
                                                "text": "Now under high Commodes with Looks Erect,\nBare-fac’d devours in gawdy Colours deck."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15fd807f-ce5c-41d1-b828-401f82819d12",
                        "source_entry_id": "56076196-9793-35c2-a175-334b487958a4",
