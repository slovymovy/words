    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4c9c0e57-8044-3be9-ad1b-9af96810a08b",
                    "sense_definition": "Feeling or expressing sincere regret, remorse, or sorrow for one's sins or offenses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "remorse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He looked genuinely <w>contrite</w> when he apologized for breaking the family heirloom.",
                            "target_lang_translations": {
                                "es": "Parecía sinceramente <w>contrito</w> cuando se disculpó por romper la reliquia familiar."
                            }
                        },
                        {
                            "text": "Her <w>contrite</w> tone convinced the committee to give her another chance.",
                            "target_lang_translations": {
                                "es": "Su tono <w>arrepentido</w> convenció al comité de darle otra oportunidad."
                            }
                        }
                    ],
                    "synonyms": [
                        "apologetic",
                        "guilt-ridden",
                        "penitent",
                        "remorseful",
                        "repentant"
                    ],
                    "antonyms": [
                        "attrite"
                    ],
                    "common_phrases": [
                        "contrite heart",
                        "contrite apology"
                    ],
                    "target_lang_definitions": {
                        "es": "Que siente o manifiesta un sincero arrepentimiento, remordimiento o pena por sus faltas o pecados."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "contrito",
                                "target_lang_sense_clarification": "arrepentido con profundo pesar o compunción"
                            },
                            {
                                "target_lang_word": "arrepentido",
                                "target_lang_sense_clarification": "que lamenta haber hecho algo malo"
                            },
                            {
                                "target_lang_word": "compungido",
                                "target_lang_sense_clarification": "apenado o afligido por culpa"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "47daa549-f316-3557-946e-40c235585104",
                    "sense_definition": "Thoroughly bruised, crushed, or broken into small pieces.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_damage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient rocks lay <w>contrite</w> beneath centuries of heavy glacial movement.",
                            "target_lang_translations": {
                                "es": "Las antiguas rocas yacían <w>trituradas</w> bajo siglos de pesado movimiento glaciar."
                            }
                        },
                        {
                            "text": "The grains became completely <w>contrite</w> under the heavy stone pestle.",
                            "target_lang_translations": {
                                "es": "Los granos quedaron completamente <w>machacados</w> bajo el pesado mazo de piedra."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or obsolete literal meaning."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Completamente magullado, aplastado o desmenuzado en pedazos pequeños (sentido arcaico o literal)."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "triturado",
                                "target_lang_sense_clarification": "deshecho o pulverizado"
                            },
                            {
                                "target_lang_word": "machacado",
                                "target_lang_sense_clarification": "aplastado o golpeado intensamente"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9545d21d-d12c-3a99-9645-014e954cb86d",
                    "sense_definition": "A person who is contrite or feels deep penitence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "remorse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest offered comfort and guidance to the humble <w>contrite</w>.",
                            "target_lang_translations": {
                                "es": "El sacerdote ofreció consuelo y guía al humilde <w>penitente</w>."
                            }
                        },
                        {
                            "text": "Several <w>contrites</w> gathered at the altar seeking forgiveness for their misdeeds.",
                            "target_lang_translations": {
                                "es": "Varios <w>penitentes</w> se reunieron ante el altar en busca de perdón por sus malas acciones."
                            }
                        }
                    ],
                    "synonyms": [
                        "penitent"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used as a noun in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Persona que siente una profunda contrición o penitencia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "penitente",
                                "target_lang_sense_clarification": "persona que se arrepiente y pide perdón"
                            },
                            {
                                "target_lang_word": "contrito",
                                "target_lang_sense_clarification": "individuo afligido por sus pecados"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}