                            "plural"
                        ],
                        "form": "enviers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a3febaae-4af9-3752-9159-0114da639553",
                        "entry_id": "e3fe9640-0cbf-32eb-8b43-cf447b70c2f4",
                        "glosses": [
                            "One who envies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dbc8e42-0294-488f-8523-66926d3a27c1",
                                "sense_id": "a3febaae-4af9-3752-9159-0114da639553",
                                "text": "There was a period, when the enviers of Bernadotte, taking advantage of this kind of popularity which he had obtained, represented him to the Directory as a man dangerous to liberty[…]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceace403-2d15-4904-8adc-1eec7119fe46",
                        "source_entry_id": "e3fe9640-0cbf-32eb-8b43-cf447b70c2f4",
                        "source_sense_id": "a3febaae-4af9-3752-9159-0114da639553",
                        "source_sense_description": "one who envies",
                        "target_lang_word": "envieux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "envieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                        "entry_id": "a2b4ee87-781d-3218-88c6-bd261575d273",
                                        "glosses": [
                                            "Qui a de l’envie, qui est sujet à l’envie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ab5048-261e-4c2c-b69b-bd636be3a774",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "Il est envieux de ma bonne fortune."
                                            },
                                            {
                                                "example_id": "bc3112e2-b08c-4872-b9cf-4adc4fe3f37f",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "Envieux du bien d’autrui."
                                            },
                                            {
                                                "example_id": "7191c727-e314-49d7-8631-62e92a6cf79d",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "Un esprit envieux."
                                            },
                                            {
                                                "example_id": "98daf1e8-bed7-44ef-a717-854b8d80afa3",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "Un regard envieux."
                                            },
                                            {
                                                "example_id": "6eca1694-c51b-416c-bfa2-ecb6c6c72288",
                                                "sense_id": "85c12913-20d8-367b-8f5f-d11cc5248440",
                                                "text": "– Pourquoi être envieuse ? Je comprends pas qu’on soit envieuse du moment qu’on a sa part… pas vrai, Rose ?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "envieux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                        "entry_id": "c190dc56-9b11-386e-b0c8-739babf08c6f",
                                        "glosses": [
                                            "Personne qui envie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af0f4e6-d84d-4dc1-a6f8-3d9dbd7902ba",
                                                "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                                "text": "Un envieux n’a jamais de repos."
                                            },
                                            {
                                                "example_id": "a7653817-4e22-4e6e-9ea1-c1c07174eed2",
                                                "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                                "text": "Les envieux sont injustes."
                                            },
                                            {
                                                "example_id": "2b8fa4f6-9af7-4e97-ba64-2b094a60ed20",
                                                "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                                "text": "En dépit des envieux."
                                            },
                                            {
                                                "example_id": "e2cdb10b-11ab-4c08-8a25-8a0c0c034199",
                                                "sense_id": "24bd0c04-8884-3710-b05b-900e3f70cc8f",
                                                "text": "Et alors lorsqu’un choix est ainsi ratifié par toute une Nation, que peuvent valoir les cris de quelques envieux ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "37065a02-5808-4c83-9e72-0612fd458bb4",
                        "source_entry_id": "e3fe9640-0cbf-32eb-8b43-cf447b70c2f4",
                        "source_sense_id": "a3febaae-4af9-3752-9159-0114da639553",
                        "source_sense_description": "one who envies",
                        "target_lang_word": "envieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "envieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd102ab6-01ca-3943-acfe-032c5ad7307e",
                                        "entry_id": "90fc5a9f-a578-3ed5-bcb6-3724bc3e3230",
                                        "glosses": [
                                            "Féminin singulier de envieux."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54f4d669-35d1-4e63-83e3-47818025d140",
                                                "sense_id": "dd102ab6-01ca-3943-acfe-032c5ad7307e",
                                                "text": "Dites une femme orgueilleuse, avare, envieuse, gourmande, colère et paresseuse, sa réputation demeure. Dites-la amoureuse, elle est déshonorée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "envieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e5cc34c0-0dd4-39da-9b91-318d4d35b096",
                                        "entry_id": "7a977b79-8eae-384b-a29c-f37a6e1795be",
                                        "glosses": [
                                            "Personne qui envie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ffbd39f-1e64-4781-a202-b695715cd041",
                                                "sense_id": "e5cc34c0-0dd4-39da-9b91-318d4d35b096",
                                                "text": "Dans le mariage, lorsque la première épouse n’est pas morte, elle est présentée comme une jalouse, une envieuse face à la jeune épouse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
