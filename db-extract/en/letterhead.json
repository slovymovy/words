                        "entry_id": "4ad1262d-72aa-3f3c-ad68-b90d8cc4bfe3",
                        "glosses": [
                            "A portion of text at the top of a letter, identifying the sender and often giving their address etc., used for formal correspondence."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
