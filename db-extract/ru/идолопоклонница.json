                    {
                        "translation_id": "3a6e8e89-d8f1-4536-8b8f-847b6548f9b5",
                        "source_entry_id": "5f1558ac-c948-3be4-b260-562495dd3b19",
                        "source_sense_id": "90ff579a-92eb-3199-871c-662519299cfa",
                        "target_lang_word": "Götzendienerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Götzendienerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b32af4e-8f08-3aa9-8782-cdd0ff159956",
                                        "entry_id": "205f4d0c-6000-3951-9180-3b9f8c43c9fa",
                                        "glosses": [
                                            "weibliches Person, die einem Götzen dient"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b58199-774d-4e23-8877-265d8b876d5f",
                                                "sense_id": "4b32af4e-8f08-3aa9-8782-cdd0ff159956",
                                                "text": "„Beim Läuten des Weckers hob sie wie eine Götzendienerin ihre Augen zum dritten Himmel, um Mutter und Sohn zu danken, daß sie ihr so reichlich gelohnt hatten, was sie an Opfern gebracht hatte, als sie mir ihre Liebe gestand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
