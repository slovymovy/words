                        "glosses": [
                            "диал., рег. (казаки-некрасовцы) то же, что договор"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e677b1b8-614e-49fd-9f8c-15d14e762308",
                                "sense_id": "0a7e6ac5-81e8-3edf-a1b7-d8d96990aa0d",
                                "text": "С турками у нас был кондрат."
                            }
                        ]
                    }
