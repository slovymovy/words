                ],
                "senses": [
                    {
                        "sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                        "entry_id": "55fcb9fe-1883-35bb-96fc-4d2d97c0e46b",
                        "glosses": [
                            "(oft pedantische) Person, die im Büro arbeitet, Büroarbeit leistet"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "c408bc82-a30d-4fd5-b7bd-2c7ca4956d89",
                                "sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                                "text": "„Mein Schwager, dieser analytische Bürohengst, hatte einfach viel zu häufig recht.“"
                            },
                            {
                                "example_id": "a8eafdd8-8317-466f-9d8f-9c9942377f7a",
                                "sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                                "text": "„Ich fühle mich dann wie ein Bürohengst, der für das Schreiben von Gedichten bezahlt wird.“"
                            },
                            {
                                "example_id": "6dccb9f8-830b-4522-9748-5d6f6a328288",
                                "sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                                "text": "„Dass der Präsident ein griesgrämiger Bürohengst ist, der nur an seinem Schreibtisch sitzt und sich vor jungen Frauen fürchtet.“"
                            },
                            {
                                "example_id": "83be2220-d9ec-484e-b58c-8e8702f4545d",
                                "sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                                "text": "„Beinahe hätte er das unscheinbare Schriftstück sogar übersehen, das irgendein besonders genauer Bürohengst beim Digitalisieren der Akte eingescannt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e22ba73f-0b9d-46a8-9a75-549b2b27dee6",
                        "source_entry_id": "55fcb9fe-1883-35bb-96fc-4d2d97c0e46b",
                        "source_sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                        "source_sense_description": "umgangssprachlich, abwertend: (oft pedantische) Person, die im Büro arbeitet, Büroarbeit leistet",
                        "target_lang_word": "pencil pusher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pencil pusher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "485fb3ad-ce4a-3feb-9b8f-f235baed4017",
                                        "entry_id": "486da011-ccb3-3998-bbf9-3ecec4e80d2b",
                                        "glosses": [
                                            "One who does routine office work; someone involved mainly in paperwork."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bfe56e52-257a-4b18-a28a-c05c336a5d60",
                                                "sense_id": "485fb3ad-ce4a-3feb-9b8f-f235baed4017",
                                                "text": "“[…] I don't have her creative genius or her version. I'm a numbers man, like my father. A pencil pusher, as Amanda said.” With no balls, he added silently."
                                            },
                                            {
                                                "example_id": "85aa0212-be78-4d7c-9b36-7b4b588241bd",
                                                "sense_id": "485fb3ad-ce4a-3feb-9b8f-f235baed4017",
                                                "text": "The internal investigator for the Macon Police Department had the dour, lifeless personality of a career pencil pusher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f3800849-8160-44dc-879f-1f50be9a5477",
                        "source_entry_id": "55fcb9fe-1883-35bb-96fc-4d2d97c0e46b",
                        "source_sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
                        "source_sense_description": "umgangssprachlich, abwertend: (oft pedantische) Person, die im Büro arbeitet, Büroarbeit leistet",
                        "target_lang_word": "pen-pusher",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pen-pusher",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ec405466-bf33-3561-916a-9eb521e52be4",
                                        "entry_id": "2f295066-b20f-3121-a533-c579482e5822",
                                        "glosses": [
                                            "A person who performs routine office work, involving mainly paperwork."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a30bf10a-b1c1-411a-9559-3b812856f212",
                                                "sense_id": "ec405466-bf33-3561-916a-9eb521e52be4",
                                                "text": "A pen-pusher in a Sixth ave. office said a coal miner is paid well. I asked him if he ever dug coal. Oh no!"
                                            },
                                            {
                                                "example_id": "e6350375-14c8-4444-9685-a959f7808842",
                                                "sense_id": "ec405466-bf33-3561-916a-9eb521e52be4",
                                                "text": "\"I had to prove to people who were unimportant, who'd never achieved anything in their lives—the administrator, the pen-pusher—that I could fight.\""
                                            },
                                            {
                                                "example_id": "af8722d8-40a6-4d26-ae30-8f998564cf21",
                                                "sense_id": "ec405466-bf33-3561-916a-9eb521e52be4",
                                                "text": "Investors may have a lopsided view of the company’s reputation simply because an uncaring pen pusher in the finance department responded lethargically to an investor’s query."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2b1ad26-63ba-4b6a-b304-ed7819e13677",
                        "source_entry_id": "55fcb9fe-1883-35bb-96fc-4d2d97c0e46b",
                        "source_sense_id": "228e9eb9-2cab-3325-9819-4cd5789bfadb",
