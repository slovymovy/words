                        "examples": [
                            {
                                "example_id": "51f5e65b-f69a-45d4-ab5b-05bbb204418d",
                                "sense_id": "0cb618ea-0017-31c0-97d5-bde9997f2359",
                                "text": "La radio avait repris son train-train de musiquettes."
                            },
                            {
                                "example_id": "82a72318-32ca-431b-9afb-dbcad35c7986",
                                "sense_id": "0cb618ea-0017-31c0-97d5-bde9997f2359",
                                "text": "Une horde d’anciens combattants, drapeaux et musiquette en avant, remontaient les Champs-Elysées pour aller donner du feu à leur malheureux pote."
                            },
                            {
                                "example_id": "323bef96-78c1-43c5-bd6b-db5eef3f6eed",
                                "sense_id": "0cb618ea-0017-31c0-97d5-bde9997f2359",
                                "text": "Pour rester dans la note, les bracelets envoient leur musiquette de danse macabre."
                            },
                            {
                                "example_id": "bacb1aa4-88e1-4a10-8fc8-459f36c1836b",
                                "sense_id": "0cb618ea-0017-31c0-97d5-bde9997f2359",
                                "text": "Une musiquette lointaine jouait dans son oreille pour l’avertir qu’elle était toujours en ligne avec le standard."
                            }
                        ]
                    }
                ],
