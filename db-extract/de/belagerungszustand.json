                    },
                    {
                        "form_id": "1402c77a-b64f-4970-ba94-f344dcef59ad",
                        "entry_id": "4986d088-b581-3151-86bb-3fdf07242898",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Belagerungszustände"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1dcfa935-2709-33ec-b2a1-01267bc5804c",
                        "entry_id": "4986d088-b581-3151-86bb-3fdf07242898",
                        "glosses": [
                            "Ausnahmesituation, vor allem in Kriegssituationen, wobei die Möglichkeiten und Rechte der Betroffenen eingeschränkt sind und die Obrigkeit/das Militär zusätzliche Rechte hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30df2ebe-c5bf-4698-8327-d36b80be7d2d",
                                "sense_id": "1dcfa935-2709-33ec-b2a1-01267bc5804c",
                                "text": "„Bald muß man auch Leipzig verlassen, wo der Belagerungszustand erklärt worden ist.“"
                            },
                            {
                                "example_id": "6b19341c-1cba-447f-a082-637e793badb3",
                                "sense_id": "1dcfa935-2709-33ec-b2a1-01267bc5804c",
                                "text": "„Da beschloß Rougon, der öffentliche Ausrufer solle, von einem Trommler begleitet, in den Straßen verkünden, daß die Stadt im Belagerungszustande sei; wer sie verlasse, könne nicht zurückkehren.“"
                            },
                            {
                                "example_id": "495383f3-6780-4e7a-8ff9-d160ff3a732e",
                                "sense_id": "1dcfa935-2709-33ec-b2a1-01267bc5804c",
                                "text": "„Vor dem Eingang standen Schützenpanzer mit hakennasigen, blau uniformierten Elitesoldaten der jordanischen Armee – als befände das Gebäude sich im Belagerungszustand.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "debfb618-f4cb-4f92-973f-54b0237ea799",
                        "source_entry_id": "4986d088-b581-3151-86bb-3fdf07242898",
                        "source_sense_id": "1dcfa935-2709-33ec-b2a1-01267bc5804c",
                        "source_sense_description": "Ausnahmesituation, vor allem in Kriegssituationen, mit eingeschränkten Rechten der Betroffenen",
                        "target_lang_word": "état de siège",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "état de siège",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "eafcb733-a9ff-31d6-bd88-94d7e1e15046",
                                        "entry_id": "040cd5b4-4aec-3805-a6f6-75c18bbf85ce",
                                        "glosses": [
                                            "État où se trouve une place de guerre lorsque, par suite de son investissement, tous les pouvoirs sont remis entre les mains de l’autorité militaire victorieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ad6e163-e505-4604-a626-0807fe61d695",
                                                "sense_id": "eafcb733-a9ff-31d6-bd88-94d7e1e15046",
                                                "text": "La ville a été mise en état de siège."
                                            },
                                            {
                                                "example_id": "b56da8dc-3397-40c9-bf25-b0d3b7a543db",
                                                "sense_id": "eafcb733-a9ff-31d6-bd88-94d7e1e15046",
                                                "text": "L’état de la France ressemble à l’état de siège ; à chaque instant la liberté de l’individu est sacrifiée à l’État."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "614e0cd6-1e9b-366d-9242-8716fa06587f",
                                        "entry_id": "040cd5b4-4aec-3805-a6f6-75c18bbf85ce",
                                        "glosses": [
                                            "Il se dit en temps de paix des mesures de sûreté, prises en vue du maintien de l’ordre, qui suspend momentanément l’effet des lois ordinaires et remet tous les pouvoirs entre les mains de l’autorité militaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92ee7ea1-1174-48f9-884b-813693c6ef47",
                                                "sense_id": "614e0cd6-1e9b-366d-9242-8716fa06587f",
                                                "text": "Proclamer l’état de siège."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c493f60e-b5cf-304a-83bf-1372776edd3f",
                                        "entry_id": "040cd5b4-4aec-3805-a6f6-75c18bbf85ce",
                                        "glosses": [
                                            "Situation exceptionnelle rendue nécessaire par des conditions particulières."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a9b7740-bf3f-4ad4-b24e-73d0139a6478",
                                                "sense_id": "c493f60e-b5cf-304a-83bf-1372776edd3f",
                                                "text": "Nous fûmes tous habillés de neuf. Grande affaire et qui mit en état de siège l’appartement à peine installé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
