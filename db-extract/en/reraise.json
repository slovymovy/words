                                "example_id": "622efa81-29db-42ab-9cea-b8e80533548a",
                                "sense_id": "d51036e4-dc3c-39e2-a319-3437941225ba",
                                "text": "I have reraised these points here because we now have at least this piece of theoretical apparatus to work with..."
                            },
