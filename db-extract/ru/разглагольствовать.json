                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "06e05284-4e64-3629-9318-da001ceae708",
                                        "entry_id": "82df9f98-e717-3d18-a005-e07ef135cf34",
                                        "glosses": [
                                            "Discuter sans fin, inutilement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c93242e-8260-40a2-9f5e-f6180b38f7c9",
                                                "sense_id": "06e05284-4e64-3629-9318-da001ceae708",
                                                "text": "Oui, madame Cummings, je vais me reposer. Je palabre, comme vous dites, je divague, je ne sais plus distinguer le vrai du faux."
                                            }
                                        ]
