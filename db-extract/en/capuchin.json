                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ccf95e8-60bf-4882-ba87-a6754700f269",
                                                "sense_id": "5494296e-0114-3966-872b-f8e9605152cc",
                                                "text": "„Die Kapuziner betreuen seither die Wallfahrt zur Heiligen Kapelle mit dem Gnadenbild Unserer Lieben Frau in Altötting.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "845f33cc-b781-38e5-88ac-eab3b873eb0d",
                                        "entry_id": "ac0a24c0-5fea-3955-add8-6c7eaafbf784",
                                        "glosses": [
                                            "einzelnes Mitglied dieser Ordensgemeinschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d653370-b5a3-4c48-a512-e6c5c2f1e90e",
                                                "sense_id": "845f33cc-b781-38e5-88ac-eab3b873eb0d",
                                                "text": "„Ich sah, wie ein Kapuziner mit vier Totengräbern hereinkam.“"
                                            },
                                            {
                                                "example_id": "b76c7451-c470-42ee-9115-f68f922d4c51",
                                                "sense_id": "845f33cc-b781-38e5-88ac-eab3b873eb0d",
                                                "text": "„Ich konnte mir nicht denken, was ein Kapuziner mir unter vier Augen zu sagen haben sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cc7d39ae-9926-3b0a-9703-4ed1e557d092",
                                        "entry_id": "ac0a24c0-5fea-3955-add8-6c7eaafbf784",
                                        "glosses": [
                                            "Kaffeegetränk mit etwas Milch"
                                        ],
                                        "tags": [
                                            "Austrian German"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0680dc71-40b5-4a44-bbdd-72a7b14737a4",
                                                "sense_id": "cc7d39ae-9926-3b0a-9703-4ed1e557d092",
                                                "text": "„Aus dem Kapuziner entstand in Italien der Cappuccino.“"
                                            },
                                            {
                                                "example_id": "f8e7696e-fc1e-4980-b647-530928d84e07",
                                                "sense_id": "cc7d39ae-9926-3b0a-9703-4ed1e557d092",
                                                "text": "„Mizzi brachte die Kapuziner und eine ganze Platte frischer Spezialitäten.“"
                                            }
                                        ],
