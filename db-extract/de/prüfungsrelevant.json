                    {
                        "form_id": "d4601535-2cab-49a9-9478-7199d18f6577",
                        "entry_id": "895fa9c7-7952-3812-b296-9330ffd1e06b",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind prüfungsrelevant"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                        "entry_id": "895fa9c7-7952-3812-b296-9330ffd1e06b",
                        "glosses": [
                            "wichtig/von Bedeutung für das Bestehen einer Prüfung (beispielsweise einer Sprachprüfung, einer Klausur in der Schule/Universität, einer mündlichen Prüfung)"
                        ],
                        "tags": [
                            "Bildungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "5a926870-9353-40a7-987b-68cfad402198",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "[Abitur in Niedersachsen:] „Starre Fächerkombinationen sollen […] wegfallen und es soll gerade im vierten Schulhalbjahr weniger Klausuren in prüfungsrelevanten Fächern geben.“"
                            },
                            {
                                "example_id": "f9f500de-0471-473a-bb6b-4a23f736e29a",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "„Neben den prüfungsrelevanten Fächern werden den Studenten noch weitere Lerninhalte vermittelt, unter anderem: […].“"
                            },
                            {
                                "example_id": "88fd7a90-de39-4429-be1f-b02c2c7a14dd",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "„In meine Vorlesung „Gesellschaftsrecht“ kommen aktuell 200 bis 300 Studierende, weil das prüfungsrelevanter Stoff ist. In meiner Vorlesung „Recht der Nachhaltigen Wirtschaft“ sind wir nur zu acht.“"
                            },
                            {
                                "example_id": "3c715ace-423c-4dc3-b0d8-eba58d01680d",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "„[…] sie hat angefangen, sich mit ihrem Opa über die NS-Zeit zu unterhalten, was den prüfungsrelevanten Stoff anschaulicher macht.“"
                            },
                            {
                                "example_id": "e1a1bb97-83f1-4722-8a0e-66471e950134",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "»Die DVDs dienen nicht der Freizeitgestaltung unserer Schülerinnen und Schüler. Wir schaffen DVDs zu unterrichts- oder prüfungsrelevanten Themen an«, erklärt Michael Hunger."
                            },
                            {
                                "example_id": "501c3943-1cec-4406-ac9f-49293e301623",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "„Faust, Woyzeck, Effi Briest – im Deutschunterricht scheint der Literaturkanon sich kaum zu verändern. […] Eine Auswahl weiterer prüfungsrelevanter Werke schlägt das Institut zur Qualitätssicherung im Bildungswesen (IQB) vor.“"
                            },
                            {
                                "example_id": "0c6c602d-8bb1-4d15-8630-eb7de0cdcb86",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "„Bei Studien- oder Abschlussarbeiten, die sie als prüfungsrelevante Leistungen in Ihrem Studium abgeben, müssen Sie die Quellen der verwendeten Abbildungen vollständig angeben.“"
                            },
                            {
                                "example_id": "d262d1f9-3085-4f9c-8001-6397ea57c736",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "„Bislang gibt es im Freistaat [Anmerkung: Bayern] für Kinder mit Dyskalkulie noch keinen sogenannten Nachteilsausgleich oder den Notenschutz, bei dem auf eine prüfungsrelevante Leistung verzichtet wird.“"
                            },
                            {
                                "example_id": "cc7fee99-5371-482f-998d-73eea9611795",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "„Neben dem prüfungsrelevanten Steuerrecht erhalten die Studierenden einen Einblick in weitere Rechtsgebiete, wie dem Bürgerlichen Recht, Wertpapierrecht und Handelsrecht.“"
                            },
                            {
                                "example_id": "3c9a57f7-ca6d-4820-b0bd-83da30d169d6",
                                "sense_id": "4ad3897c-ee1a-3e69-bd34-ccd0ec0b504c",
                                "text": "„Nutzen Sie Ihre Vorlesungs- und Übungsmitschriften, der Stoff aus Vorlesungen und Übungen ist prüfungsrelevant, außerdem haben Sie die Unterlagen über Blackboard, die wir Ihnen zur Verfügung gestellt haben“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
