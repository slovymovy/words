                                "target_senses": [
                                    {
                                        "sense_id": "bf5b0d86-c708-3ce6-b796-fa29f37885b2",
                                        "entry_id": "b66e296a-aabf-3e98-ad4d-5489bfb1c0ae",
                                        "glosses": [
                                            "Beneath the clavicle."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef5c98f0-ca1c-46ac-9803-fa932f44471a",
                                                "sense_id": "bf5b0d86-c708-3ce6-b796-fa29f37885b2",
                                                "text": "The 31-year-old man presented with swelling in the right subclavicular region."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df6c84a8-0f7b-4fae-b209-3d6fa7fa69f1",
                        "source_entry_id": "6fcfeb6a-96c8-3c2d-adab-38a193c97909",
                        "source_sense_id": "b433b2f8-047e-3a5d-986a-67eac5c7140a",
