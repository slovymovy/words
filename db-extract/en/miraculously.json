                "senses": [
                    {
                        "sense_id": "4a29ebce-e93b-39a6-99c5-b86f106b92f5",
                        "entry_id": "0e80813c-9b97-3cde-b75d-104dcd1ddda2",
                        "glosses": [
                            "In a miraculous manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff0dcc4b-fc25-4c4a-8115-f2b416bae023",
                                "sense_id": "4a29ebce-e93b-39a6-99c5-b86f106b92f5",
                                "text": "When he woke for the second time he saw me, and began to question me as to what had happened, but I had to put him off as best I could till the morrow, when he awoke almost miraculously better."
                            },
                            {
                                "example_id": "7c822698-7fc7-4ed9-b5b6-fcb0085b1f66",
                                "sense_id": "4a29ebce-e93b-39a6-99c5-b86f106b92f5",
                                "text": "Almost miraculously, [risk-neutral valuation] finesses the problem that we know hardly anything about the risk aversion of the buyers and sellers of options."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a8be930-ecf1-4371-8ba9-6b7ab5cbe50d",
                        "source_entry_id": "0e80813c-9b97-3cde-b75d-104dcd1ddda2",
                        "source_sense_id": "4a29ebce-e93b-39a6-99c5-b86f106b92f5",
                        "source_sense_description": "in a miraculous manner",
                        "target_lang_word": "miraculeusement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "miraculeusement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14d1097f-0129-32bb-872e-8f0f52597749",
                                        "entry_id": "5259e367-3940-3a71-b4bd-fc0a7b097869",
                                        "glosses": [
                                            "D’une façon miraculeuse, par miracle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d243674a-dfc6-4280-a340-a9c7b78a0b47",
                                                "sense_id": "14d1097f-0129-32bb-872e-8f0f52597749",
                                                "text": "Daniel fut jeté dans la fosse aux lions, et il en fut miraculeusement délivré."
                                            },
                                            {
                                                "example_id": "0c2dce72-7f64-45b4-8bdf-1e9e7f5494db",
                                                "sense_id": "14d1097f-0129-32bb-872e-8f0f52597749",
                                                "text": "[…]; perdu dans l'Arctique pendant trois ans il est miraculeusement sauvé avec son seul compagnon par un phoquier norvégien."
                                            },
                                            {
                                                "example_id": "be71d010-ffa7-4665-8e93-b8960366af27",
                                                "sense_id": "14d1097f-0129-32bb-872e-8f0f52597749",
                                                "text": "Zéphyrin Camélinat sortira miraculeusement indemne de la Semaine sanglante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26750967-ca7c-360e-8f40-24685b929095",
                                        "entry_id": "5259e367-3940-3a71-b4bd-fc0a7b097869",
                                        "glosses": [
                                            "D’une façon extraordinaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efc98b1b-9543-47d4-afb1-fbe68b6028f9",
                                                "sense_id": "26750967-ca7c-360e-8f40-24685b929095",
                                                "text": "Un trône indignement renversé et miraculeusement rétabli."
                                            },
                                            {
                                                "example_id": "37e55119-199c-416a-88e5-fba63c0f2fe4",
                                                "sense_id": "26750967-ca7c-360e-8f40-24685b929095",
                                                "text": "Dans l'intérieur, qui paraissait impraticable, des routes se sont miraculeusement ouvertes, parcourues aussitôt par des automobiles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
