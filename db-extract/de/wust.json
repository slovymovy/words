                ],
                "senses": [
                    {
                        "sense_id": "324684b8-42f2-3af6-a68f-065afbb90d03",
                        "entry_id": "8a67d7bd-ad29-3f22-bf6f-a1e8528a73ef",
                        "glosses": [
                            "eine große Menge ungeordneter, unübersichtlicher Dinge"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "0114b55e-1480-4e35-8999-85a30ad494ef",
                                "sense_id": "324684b8-42f2-3af6-a68f-065afbb90d03",
                                "text": "In seinem Arbeitszimmer fand sich ein Wust von Zeitungsausschnitten aus längst vergangenen Tagen."
                            },
                            {
                                "example_id": "06f982d5-e754-4b6a-b01d-3e9b3003f902",
                                "sense_id": "324684b8-42f2-3af6-a68f-065afbb90d03",
                                "text": "„Doch solche Tricks waren eine kleine Erleichterung für römische Leser, die sich ja dann im zweiten, regional gegliederten Teil des Büchleins durch einen Wust bizarrer Stammes- und Ortsnamen kämpfen mussten.“"
                            },
                            {
                                "example_id": "cc9ce199-f814-4974-aa8f-8e5d76364143",
                                "sense_id": "324684b8-42f2-3af6-a68f-065afbb90d03",
                                "text": "„Die schmale Hinterlassenschaft des Toten nahm den kleinsten Raum ein unter meinem eigenen Wust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "52afee62-b92a-4333-8b33-d83f2aaf1ba6",
                        "source_entry_id": "8a67d7bd-ad29-3f22-bf6f-a1e8528a73ef",
                        "source_sense_id": "324684b8-42f2-3af6-a68f-065afbb90d03",
                        "source_sense_description": "abwertend: eine große Menge ungeordneter, unübersichtlicher Dinge",
                        "target_lang_word": "clutter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clutter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "857532e2-c227-3016-9c13-dd223931f3be",
                                        "entry_id": "2a0db4a6-b30d-37c0-b62b-6f448a012baf",
                                        "glosses": [
                                            "A confused disordered jumble of things."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01ba0efa-bbcb-405a-be34-8fa9e887c943",
                                                "sense_id": "857532e2-c227-3016-9c13-dd223931f3be",
                                                "text": "He saw what a Clutter there was with Huge, Over-grown Pots, Pans, and Spits."
                                            },
                                            {
                                                "example_id": "3d8648eb-1416-44bb-b8a6-8ac07fd7e29e",
                                                "sense_id": "857532e2-c227-3016-9c13-dd223931f3be",
                                                "text": "Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d74ad5e6-3fe7-3aa9-87da-9614bb6adf78",
                                        "entry_id": "2a0db4a6-b30d-37c0-b62b-6f448a012baf",
                                        "glosses": [
                                            "Background echoes, from clouds etc., on a radar or sonar screen."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "728f1b8d-6c4a-3087-8cda-95c1f7177e7d",
                                        "entry_id": "2a0db4a6-b30d-37c0-b62b-6f448a012baf",
                                        "glosses": [
                                            "Alternative form of clowder (“collective noun for cats”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cac32589-a31e-40b7-94cd-79f52d59a5cd",
                                                "sense_id": "728f1b8d-6c4a-3087-8cda-95c1f7177e7d",
                                                "text": "Organizing ghost stories is like herding a clutter of cats: the phenomenon resists organization and classification."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e19c2a60-718c-366b-998d-0f9a6b0b31b1",
                                        "entry_id": "2a0db4a6-b30d-37c0-b62b-6f448a012baf",
                                        "glosses": [
                                            "Clatter; confused noise."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62c473fc-8cc7-47e9-a3d4-78fbe2a821df",
                                                "sense_id": "e19c2a60-718c-366b-998d-0f9a6b0b31b1",
                                                "text": "October 14 1718, John Arbuthnot, letter to Jonathan Swift\nI hardly heard a word of news or politicks, except a little clutter about sending some impertinent presidents du parliament to prison"
                                            },
                                            {
                                                "example_id": "4d97fadd-c7b6-41c6-9efb-2cbf793c47ea",
                                                "sense_id": "e19c2a60-718c-366b-998d-0f9a6b0b31b1",
                                                "text": "It was then you might have heard a clutter: pots, pans and pitchers, mugs, jugs and jordens, all put themselves in motion at once[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bde54f7-94c4-3a8d-82d3-1cbbf7963937",
                                        "entry_id": "2a0db4a6-b30d-37c0-b62b-6f448a012baf",
                                        "glosses": [
                                            "A Sperner family."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "clutter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3992987-acbf-3a19-9237-101ea6c1ca2b",
                                        "entry_id": "fc177f9d-8876-3998-b4bb-6f952efbbd58",
                                        "glosses": [
                                            "To fill something with clutter."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e1cb7c7-bce1-46d0-a02b-a06b5c18252d",
                                                "sense_id": "b3992987-acbf-3a19-9237-101ea6c1ca2b",
                                                "text": "That means about $165 billion was spent not on drumming up business, but on annoying people, creating landfill and cluttering spam filters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc7d419b-adfd-3218-9aa5-43a810fa424c",
                                        "entry_id": "fc177f9d-8876-3998-b4bb-6f952efbbd58",
                                        "glosses": [
                                            "To clot or coagulate, like blood."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b2a9c1-3fed-47ed-b5ef-b632d1c2b8af",
                                                "sense_id": "dc7d419b-adfd-3218-9aa5-43a810fa424c",
                                                "text": "It battereth and cluttereth into knots and balls"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4073921-5c4f-3d71-97f5-644c63b1768c",
                                        "entry_id": "fc177f9d-8876-3998-b4bb-6f952efbbd58",
                                        "glosses": [
                                            "To make a confused noise; to bustle."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "addfcf8b-9fc4-4256-a059-4b86b69e58d5",
                                                "sense_id": "f4073921-5c4f-3d71-97f5-644c63b1768c",
                                                "text": "It [the goose] clutter'd here, it chuckled there; / It stirr'd the old wife's mettle: / She shifted in her elbow-chair, / And hurl'd the pan and kettle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da250494-66f9-3efa-ba30-51b69f74ca4e",
                                        "entry_id": "fc177f9d-8876-3998-b4bb-6f952efbbd58",
                                        "glosses": [
                                            "To utter words hurriedly, especially (but not exclusively) as a speech disorder (compare cluttering)."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12933709-b36f-44cf-bc96-5043036ed5bb",
                        "source_entry_id": "8a67d7bd-ad29-3f22-bf6f-a1e8528a73ef",
                        "source_sense_id": "324684b8-42f2-3af6-a68f-065afbb90d03",
                        "source_sense_description": "abwertend: eine große Menge ungeordneter, unübersichtlicher Dinge",
                        "target_lang_word": "fatras",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatras",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e37a39b5-567c-3c4c-a899-9649f50b49c5",
                                        "entry_id": "fc6544f8-0d04-3045-9fcb-9494fce288f3",
                                        "glosses": [
                                            "Amas confus de plusieurs choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b896a31-d3f2-468d-9617-d133536f7ce3",
                                                "sense_id": "e37a39b5-567c-3c4c-a899-9649f50b49c5",
                                                "text": "Une seule vérité dans le fatras de complots tout à fait impossibles sous un régime policier perfectionné : que tout le vieux parti haïssait Staline, […]."
                                            },
                                            {
                                                "example_id": "e431253a-ad1a-4f69-8070-7509d44d773a",
                                                "sense_id": "e37a39b5-567c-3c4c-a899-9649f50b49c5",
                                                "text": "L’histoire ne m’intéressait pas. À part l’ouvrage de Vaulabelle sur les deux Restaurations, les mémoires, récits, chroniques qu’on m’avait fait lire m’avaient paru, comme les cours de Mademoiselle Gontran, un fatras d’anecdotes sans signification."
                                            },
                                            {
                                                "example_id": "00bfb6f5-c319-4526-bc73-949739abd38a",
                                                "sense_id": "e37a39b5-567c-3c4c-a899-9649f50b49c5",
                                                "text": "[…] c'est ainsi que ce fatras de producteurs, nageurs, dentistes, agents immobiliers, juristes de studios (de cinéma), pourvoyeurs de coke, marchands d’automobile-z-allemandes, exilés au soleil, voyaient le top de l’Éducation supérieure : Harvard Business School pour les affaires, Harvard School of Law pour le droit, Harvard University pour les indécis."
                                            },
                                            {
                                                "example_id": "7a2d7f90-dbc8-4a52-bab5-4311970e4e41",
                                                "sense_id": "e37a39b5-567c-3c4c-a899-9649f50b49c5",
                                                "text": "Autour d’eux, un fatras de poutres d’acier. Des dizaines de bétonnières en file indienne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
