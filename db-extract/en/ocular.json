                    }
                ],
                "senses": [
                    {
                        "sense_id": "d9944de1-a7e2-3ffd-ad7a-9b1870caed52",
                        "entry_id": "c9705d2c-d470-3024-bd1f-3ddb1ca72eff",
                        "glosses": [
                            "Of, or relating to the eye, or the sense of sight"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b970667-f1ba-4b83-8449-dab3a8b2317a",
                                "sense_id": "d9944de1-a7e2-3ffd-ad7a-9b1870caed52",
                                "text": "The medication may have adverse ocular side effects."
                            },
                            {
                                "example_id": "cf882059-3d05-47b0-86f3-d0b72f9a4cb4",
                                "sense_id": "d9944de1-a7e2-3ffd-ad7a-9b1870caed52",
                                "text": "It took some time after he lost his eye for him to receive his ocular prosthesis."
                            },
                            {
                                "example_id": "b8f1b4a6-0d1a-42a4-b562-92b496799516",
                                "sense_id": "d9944de1-a7e2-3ffd-ad7a-9b1870caed52",
                                "text": "The eyes of men converse as much as their tongues, with the advantage, that the ocular dialect needs no dictionary, but is understood all the world over."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ff0d86f-81c2-330d-9ab1-7e2dd8f8f120",
                        "entry_id": "c9705d2c-d470-3024-bd1f-3ddb1ca72eff",
                        "glosses": [
                            "Resembling the eye."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1e5c79f-1a51-4b99-b335-46efbae8cfe4",
                                "sense_id": "7ff0d86f-81c2-330d-9ab1-7e2dd8f8f120",
                                "text": "ocular markings on the wings of a butterfly"
                            }
                        ]
                    },
                    {
                        "sense_id": "d542ed5f-e09a-3f26-b89b-8970f511317a",
                        "entry_id": "c9705d2c-d470-3024-bd1f-3ddb1ca72eff",
                        "glosses": [
                            "Seen by, or seeing with, the eye; visual."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96a742b4-9f14-41ca-92a4-48dfe787d06b",
                                "sense_id": "d542ed5f-e09a-3f26-b89b-8970f511317a",
                                "text": "Villain, be sure thou prove my love a whore,\nBe sure of it; give me the ocular proof:\nOr by the worth of man’s eternal soul,\nThou hadst been better have been born a dog\nThan answer my waked wrath!"
                            },
                            {
                                "example_id": "2761936e-ad4f-4438-9f4f-422b4def6d98",
                                "sense_id": "d542ed5f-e09a-3f26-b89b-8970f511317a",
                                "text": "For as Thomas was an ocular Witness of Christ’s Death and Burial, so were the other Disciples of his Resurrection; having actually seen him after he was risen."
                            },
                            {
                                "example_id": "e4d54ba2-d19d-470f-b120-94a7c22dd7a9",
                                "sense_id": "d542ed5f-e09a-3f26-b89b-8970f511317a",
                                "text": "[…] I should have been apt to think, that the young gentlewomen and Mr. Lovelace were of longer acquaintance than yesterday. For he, by stealth, as it were, cast glances sometimes at them, which they returned; and, on my ocular notice, their eyes fell, as I may say, under my eye, as if they could not stand its examination."
                            },
                            {
                                "example_id": "b2622e71-d3ec-47a5-835c-eb82e0bc93b1",
                                "sense_id": "d542ed5f-e09a-3f26-b89b-8970f511317a",
                                "text": "Captain Lincoln proceeded to relate some of the strange fables and fantasies, which, as it was impossible to refute them by ocular demonstration, had grown to be articles of popular belief, in reference to this old picture."
                            },
                            {
                                "example_id": "837f50f2-c841-4548-83f4-ef631a017c2c",
                                "sense_id": "d542ed5f-e09a-3f26-b89b-8970f511317a",
                                "text": "Suddenly starting from a proposition, exactly and sharply defined, in terms of utmost simplicity and clearness, he rejected the forms of customary logic, and by a crystalline process of accretion, built up his ocular demonstrations in forms of gloomiest and ghastliest grandeur, […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acbac4a6-cd29-490c-a03b-635646f0d99b",
                        "source_entry_id": "c9705d2c-d470-3024-bd1f-3ddb1ca72eff",
                        "source_sense_description": "of or relating to the eye",
                        "target_lang_word": "oční",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oční",
