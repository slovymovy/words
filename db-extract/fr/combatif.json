                ],
                "senses": [
                    {
                        "sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                        "entry_id": "8bb096c3-627f-3527-8017-1c4776ae3e00",
                        "glosses": [
                            "Qui porte au combat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fd9e29f-ec91-4d0d-bc87-83db8c260ed5",
                                "sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                                "text": "Instinct combatif."
                            },
                            {
                                "example_id": "73d43a7b-0192-45ec-b2a6-27474dde5d6e",
                                "sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                                "text": "Humeur combative."
                            },
                            {
                                "example_id": "02d4a41a-7130-43c3-b301-982f74ae0c4d",
                                "sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                                "text": "On n’est vraiment combatif, je dirais peut-être révolutionnaire, que dans la mesure où on vous « marche sur les pieds »."
                            }
                        ]
                    },
                    {
                        "sense_id": "3287dab3-4939-31f7-9ca7-74a9d4102156",
                        "entry_id": "8bb096c3-627f-3527-8017-1c4776ae3e00",
                        "glosses": [
                            "Relatif au combat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d711b58-f3f0-45b9-ac74-e3780c393ec8",
                                "sense_id": "3287dab3-4939-31f7-9ca7-74a9d4102156",
                                "text": "La mystique combative demeure comme un organe vestigiaire. Les mâles se transmettent l’idée que l’homme doit avoir du courage, qu’il ne doit pas craindre la mort et que, pour être vraiment digne du sexe masculin, il faut même rechercher le danger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a5af65b3-5bce-48ed-9421-00d4bbe680a0",
                        "source_entry_id": "8bb096c3-627f-3527-8017-1c4776ae3e00",
                        "source_sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                        "source_sense_description": "Qui porte au combat",
                        "target_lang_word": "kämpferisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kämpferisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb7430ac-2ae2-3a73-bbf1-d4c16f71fbab",
                                        "entry_id": "0481930f-4008-3ca1-920c-ff91b6570852",
                                        "glosses": [
                                            "den Kampf betreffend, zum Kämpfen bereit, voller Kampfgeist"
                                        ],
                                        "tags": [
                                            "Kampfsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36d43d24-7398-424e-8cf9-d5ad404d8a89",
                                                "sense_id": "eb7430ac-2ae2-3a73-bbf1-d4c16f71fbab",
                                                "text": "„Dieses japanische Schwert wurde in der Zeit zwischen 1890 und 1930 gefertigt. Aber nicht mehr als kämpferisches Werkzeug eines Samurai, sondern als originelles Mitbringsel eines Japan-Touristen.“"
                                            },
                                            {
                                                "example_id": "556b1003-938c-4143-992f-d0be04e28dfc",
                                                "sense_id": "eb7430ac-2ae2-3a73-bbf1-d4c16f71fbab",
                                                "text": "„Tierfilmer Günter Goldmann begleitet eine Wildschweinrotte über ein Jahr, zeigt seltene Verhaltensweisen von den kleinen Frischlingen im Frühling bis zu den großen, kämpferischen Keilern im Herbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                        "entry_id": "0481930f-4008-3ca1-920c-ff91b6570852",
                                        "glosses": [
                                            "mit einer hohen Bereitschaft, voller Energie, voller Einsatzfreude"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78068127-229f-4f25-82ab-07f68c7c6fed",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "„[…] Spitzenkandidat Olaf Scholz gibt sich kämpferisch: \"Ich will Kanzler werden, das ist es, worum es geht«, […]“"
                                            },
                                            {
                                                "example_id": "c3c3279e-e1bd-4e4d-b3a9-af3122f41a82",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "„Seine Regierung und seine Demokratische Partei werden sich dem Vorgehen der Republikaner entschieden entgegenstellen, sagte der Präsident in seiner kämpferischen Rede.“"
                                            },
                                            {
                                                "example_id": "d259b76c-a65d-46a2-bcaa-4c2261b0b59e",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "„Doch bereits 2016 stellte die US-Tageszeitung \"Politico\" fest, dass die Tea-Party-Bewegung im Grunde tot sei, auch weil einige ihrer Ideen und ihr kämpferischer Politikstil Eingang in den Mainstream der Republikanischen Partei gefunden hätten.“"
                                            },
                                            {
                                                "example_id": "10c9149d-9251-470a-9a65-3ca9bd2f75d7",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "„»Die feministischen Magazine sind mir zu kämpferisch, auch wenn sie ihre Berechtigung haben. […].«“"
                                            },
                                            {
                                                "example_id": "ab726c5b-b3c1-4dbd-85fb-95e9da3bfe7f",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "[NSU-Prozess:] „Die Nebenkläger beenden ihre Plädoyers mit einem kämpferischen Schlusswort von Yvonne Boulgarides, der Witwe des 2005 ermordeten Theodoros Boulgarides und deren Anwalt.“"
                                            },
                                            {
                                                "example_id": "8be85e82-580f-450b-a7a6-455c7af6465e",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "„Ihr ist ein berührendes Erinnerungsbuch gelungen über ihre Flucht aus dem Iran im Kindesalter […]. Zugleich ist es ein kämpferischer Aufruf, die Würde der Millionen Menschen auf der Flucht endlich anzuerkennen und vor allem: dieser Anerkennung auch Taten folgen zu lassen.“"
                                            },
                                            {
                                                "example_id": "313470f8-8505-4d42-8e37-f872ff8ee5b9",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "[Zur Sängerin Mireille Matthieu:] „[…] den Achtundsechzigern […] war sie zu hausbacken, zu freundlich zu allen, zu wenig kämpferisch […].“"
                                            },
                                            {
                                                "example_id": "0abd4f39-899d-4d1a-b5d1-05f36a54edf1",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "[Fußball:] „Mit einer kämpferisch starken Leistung zieht Tschechien ins Viertelfinale ein.“"
                                            },
                                            {
                                                "example_id": "c33cfa36-0bb6-4c62-8622-7d2da97a97b7",
                                                "sense_id": "c68f6d4d-6312-3312-95d0-43150a207a86",
                                                "text": "[Eishockey:] „Deutschland hielt kämpferisch gegen das läuferisch beste Team der Gruppe B gut mit und dessen Offensive in Schach. Die wenigen Chancen der USA machte Felix Brückmann zunichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0bcfba4f-e32c-49dd-a417-37c1fe3f6882",
                        "source_entry_id": "8bb096c3-627f-3527-8017-1c4776ae3e00",
                        "source_sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                        "source_sense_description": "Qui porte au combat",
                        "target_lang_word": "kampfeslustig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kampfeslustig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "192b9a1c-dcf5-3feb-bd72-2474dbaf54f7",
                                        "entry_id": "b152fa00-ca3c-32ab-8ae4-0fcde2b7b999",
                                        "glosses": [
                                            "Kampf, Streit oder eine Auseinandersetzung suchend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "431d50f1-75a1-4c29-8e6c-df4ad7d6a761",
                                                "sense_id": "192b9a1c-dcf5-3feb-bd72-2474dbaf54f7",
                                                "text": "„Onesikritos, der Befehlshaber seiner [Alexanders des Großen] Flotte, hat geschrieben, daß es dort [Taprobane=Sri Lanka] größere und kampfeslustigere Elefanten gebe als in Indien; …“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57a20432-be2f-4e01-a240-9a3000f8677c",
                        "source_entry_id": "8bb096c3-627f-3527-8017-1c4776ae3e00",
                        "source_sense_id": "d616900c-7a08-3087-8edc-83b8952e6831",
                        "source_sense_description": "Qui porte au combat",
                        "target_lang_word": "combative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "combative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ecaebc24-efa9-32db-a0a9-19b9cc5e8cf5",
                                        "entry_id": "08eebe20-dbaf-38bc-bd98-6e97a2ec3b32",
                                        "glosses": [
                                            "Given to fighting; disposed to engage in combat; pugnacious."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "514cef25-6a36-4468-8a30-513fce8835f1",
                                                "sense_id": "ecaebc24-efa9-32db-a0a9-19b9cc5e8cf5",
                                                "text": "Their combative conduct leads to many problems."
                                            },
                                            {
                                                "example_id": "eab74242-9cf2-4989-9733-d4bbe494ec08",
                                                "sense_id": "ecaebc24-efa9-32db-a0a9-19b9cc5e8cf5",
                                                "text": "He finds, not “demigods” but “a combative group of exhausted, drunken, broken, petty, partisan, scheming, squabbling, bloviating, sensory-deprived, underoxygenated, fed-up, talked-out, overheated delegates so distraught they threatened violence, secession."
                                            },
                                            {
                                                "example_id": "4ec12ef3-6dbd-4562-bee2-afdebfbd591f",
                                                "sense_id": "ecaebc24-efa9-32db-a0a9-19b9cc5e8cf5",
                                                "text": "Salvation arrived - as it so often has in this nerve-shredding campaign - through Dykes, the combative striker."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
