                "senses": [
                    {
                        "sense_id": "f4c29455-4aae-3566-8c4c-2834a097a8bd",
                        "entry_id": "90d17ca9-8a4d-3b48-8131-1bcb7098cc5d",
                        "glosses": [
                            "kobieta, która coś ma, posiada"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09580bee-3bd6-4ffe-97c7-06edf53989d1",
                                "sense_id": "f4c29455-4aae-3566-8c4c-2834a097a8bd",
                                "text": "Rzeczywiście stopy miała drobniutkie, ostro zakończone, jak kopytka, gdyż nogi były od dzieciństwa pokaleczone. W Chinach służy to za dowód wysokiego pochodzenia lub bogactwa i jest najwięcej cenione. Lecz podróżnik, zwiedzający kraj, ukryty przed światem za wielkim murem, omyliłby się niezawodnie, gdyby wszystkie posiadaczki „złotych lilij“ uważał za arystokratki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92f650ca-ea4c-4e60-b771-b664a6a1c693",
                        "source_entry_id": "90d17ca9-8a4d-3b48-8131-1bcb7098cc5d",
                        "source_sense_id": "f4c29455-4aae-3566-8c4c-2834a097a8bd",
                        "target_lang_word": "Besitzerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Besitzerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                        "entry_id": "325cfe21-3d38-357e-9f2b-0aa46dcbeb02",
                                        "glosses": [
                                            "weibliche Person, die etwas in ihrem Besitz hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81a92702-be1c-4da7-9da1-3722458d9e8f",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin des Geschäftes umarmte mich zum Abschied und gab mir wieder drei Schillerlocken mit.“"
                                            },
                                            {
                                                "example_id": "4f809061-d331-410a-8de8-3274aca7f639",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Nach vielem Hin und Her mit der Besitzerin hatte ich es geschafft, dass im Gästehaus eine Klimaanlage eingebaut wurde.“"
                                            },
                                            {
                                                "example_id": "e7fdbdcf-0cc5-4e7c-8d99-cf6bc58a43bb",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Die Besitzerin führte sie in einen Raum hinter dem Laden, der abgeblendet war.“"
                                            },
                                            {
                                                "example_id": "7904b344-faeb-4c40-8529-67f59b32efe5",
                                                "sense_id": "0e5e6109-fdf6-3837-b9c6-3524155de65f",
                                                "text": "„Eine Woche später waren sie stolze Besitzerinnen eines kleinen blauen Citroën.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
