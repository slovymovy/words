                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nonmetal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f6420c22-8b22-3735-968f-7f462c91fc87",
                                        "entry_id": "49eda531-9323-377f-b179-f35d958cd861",
                                        "glosses": [
                                            "An element, such as phosphorus or chlorine, that does not have the chemical or physical properties of a metal."
                                        ],
                                        "tags": [],
