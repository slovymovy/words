                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fa474ca7-6ccd-4907-a0ed-8cbf737db5b1",
                        "source_entry_id": "eb1d38f5-4543-3731-9620-2eb877e8bb19",
                        "source_sense_description": "variety of Persian spoken in Afghanistan",
                        "target_lang_word": "dari",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d014298e-636d-387f-800f-73d6a2f872ff",
                                        "entry_id": "2d7552e5-8dfd-3ffc-9a92-3f5017b41817",
                                        "glosses": [
                                            "Dialecte oriental du persan, parlé en Afghanistan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b96d9ed-ac80-4608-85e8-77b3b720163d",
                                                "sense_id": "d014298e-636d-387f-800f-73d6a2f872ff",
                                                "text": "Le dari était la langue officielle des cours ghaznévides, samanides et timourides de Samarcande et d’Hérat, ainsi que des Grands Moghols de l’Inde."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dari",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5fe8b1d1-8f73-3e46-b299-432a7f6bab79",
                                        "entry_id": "37960bdb-83c3-3f59-a87a-ec4239026604",
                                        "glosses": [
                                            "Graine de sorgho."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5763a13-c9f5-4200-882f-f50eebd4983a",
                                                "sense_id": "5fe8b1d1-8f73-3e46-b299-432a7f6bab79",
                                                "text": "Les graines de Dari, nom sous lequel on nous a remis le produit, sont celles du Sorgho vulgaire, Sorghum vulgare. Willd.; …."
                                            },
                                            {
                                                "example_id": "5038809f-3316-4ed2-855b-b8ab55a1133c",
                                                "sense_id": "5fe8b1d1-8f73-3e46-b299-432a7f6bab79",
                                                "text": "Le rendement en alcool du maïs et du dari est alors égal à celui du seigle, …"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed3262ec-a2c4-47de-9536-cc98b9903d65",
                        "source_entry_id": "eb1d38f5-4543-3731-9620-2eb877e8bb19",
                        "source_sense_description": "variety of Persian spoken in Afghanistan",
                        "target_lang_word": "Dari",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dari",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7e32bd94-1d15-3765-b574-6b877900dcb8",
                                        "entry_id": "63ec1f94-5d4c-3c25-8995-b68f5dcbec7e",
                                        "glosses": [
                                            "die Form der persischen Sprache, die in Afghanistan gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfade198-f46d-4aa3-acd7-21975ec6ef0d",
                                                "sense_id": "7e32bd94-1d15-3765-b574-6b877900dcb8",
                                                "text": "„Die gesprochene Sprache ist Dari, wobei hier der so genannte Herati-Dialekt verbreitet ist[.]“"
                                            },
                                            {
                                                "example_id": "05230b3b-2deb-46cb-b1c4-5e5da153d7ac",
                                                "sense_id": "7e32bd94-1d15-3765-b574-6b877900dcb8",
                                                "text": "„Täglich speist sie eine zwölfminütige Nachrichtensendung aus Berlin in den Landessprachen Dari und Paschtu ins Programm. Damit soll in diesem Jahr Schluß sein, und die Afghanen müssen ihre eigenen Nachrichten machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4544eb25-da11-3353-991c-bcf5e00c0ae5",
                                        "entry_id": "63ec1f94-5d4c-3c25-8995-b68f5dcbec7e",
                                        "glosses": [
                                            "die geschriebene Form der persischen Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d9a3d03-cfa6-4f14-a3b4-eb053e4cba92",
                                                "sense_id": "4544eb25-da11-3353-991c-bcf5e00c0ae5",
                                                "text": "„Er [Rudaki] war der erste Dichter des Dari, d. h. Hofsprache, des Neupersischen, der für seine Dichtung von einer bestimmten Reimordnung Gebrauch machte, die als Dari-Reimordnung in die Geschichte eingegangen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dari",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3eec7d10-ac46-3f4c-b7c6-582ac6ffb42f",
                                        "entry_id": "0b0d638d-bc91-319b-86b9-58c8b7e80eb1",
                                        "glosses": [
                                            "einfacher Webteppich aus Südasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe3c4150-eb1d-47c3-adad-ac4510babf21",
                                                "sense_id": "3eec7d10-ac46-3f4c-b7c6-582ac6ffb42f",
                                                "text": "„Bald war der lange Raum mit den Doppelreihen dünner blauer Daris entlang der beiden Längswände gefegt, sauber und ordentlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
