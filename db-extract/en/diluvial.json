                    {
                        "translation_id": "8bfb396a-7885-4b9e-b10b-f386c61a4d33",
                        "source_entry_id": "075bdc53-2194-36c6-8b56-b8658bdfc0b1",
                        "source_sense_description": "Relating to a flood",
