                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b0c98a3-73cd-33bd-a750-e7d48da8d3dc",
                        "entry_id": "e6bb73cb-1525-3475-9ef0-33920a820bc3",
                        "glosses": [
                            "Action de bourrer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f3c528e-6eb7-4c8e-8cd3-328687f1fa3d",
                                "sense_id": "6b0c98a3-73cd-33bd-a750-e7d48da8d3dc",
                                "text": "Le bourrage de sa bouche avec de la sciure de bois a fait craquer la peau et l’a même fait éclater sur le côté gauche."
                            },
                            {
                                "example_id": "4f07c9e3-144f-4cfb-a3fb-0e948ab6ba4e",
                                "sense_id": "6b0c98a3-73cd-33bd-a750-e7d48da8d3dc",
                                "text": "Il y a généralement un boutefeu par poste ayant à sa charge le minage, la surveillance de l'aérage et la tenue d'un rapport donnant à la maîtrise du quartier les renseignements relatifs à la durée de la foration, du bourrage, du scrapage."
                            }
                        ]
                    },
                    {
                        "sense_id": "ef889bcc-4d77-3fe6-ace4-467dabeb1dbf",
                        "entry_id": "e6bb73cb-1525-3475-9ef0-33920a820bc3",
                        "glosses": [
                            "Bourrage papier."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "5fd9fa3a-61d7-43c7-aad5-8e0f4c3149e9",
                                "sense_id": "ef889bcc-4d77-3fe6-ace4-467dabeb1dbf",
                                "text": "Stallman ne pouvait rien aux bourrages mécaniques, mais il put programmer un morceau de code sur le PDP-11, vérifiant périodiquement l’imprimante et envoyant les rapports de bourrage à l’ordinateur central."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6c7c801-4e5c-3957-8d84-bc03b1ceccd7",
                        "entry_id": "e6bb73cb-1525-3475-9ef0-33920a820bc3",
                        "glosses": [
                            "Action qui consiste, pour un commissaire-priseur, à faire croire à un acheteur qu'il y a dans la salle une enchère supérieure à la sienne. On dit aussi bourrer dans le vide."
                        ],
                        "tags": [],
                        "examples": []
                    }
