{
    "word_family": [
        "stinky",
        "stinker",
        "stinking"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2924a025-35f8-38c9-8be5-5c955f2e56b8",
                    "sense_definition": "To have a strong bad smell.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bad smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not take out the garbage soon, the whole kitchen will <w>stink</w>.",
                            "target_lang_translations": {
                                "ru": "Если ты скоро не вынесешь мусор, вся кухня будет <w>вонять</w>.",
                                "zh": "如果你不快点把垃圾倒掉，整个厨房都会<w>发臭</w>。"
                            }
                        },
                        {
                            "text": "His old gym clothes <w>stink</w> like rotten eggs after the long workout.",
                            "target_lang_translations": {
                                "ru": "Его старая спортивная форма после долгой тренировки <w>воняет</w> тухлыми яйцами.",
                                "zh": "他那件旧运动服在长时间锻炼后<w>臭</w>得像臭鸡蛋一样。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pong",
                        "reek",
                        "smell"
                    ],
                    "common_phrases": [
                        "stink like",
                        "stink of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь сильный неприятный запах.",
                        "zh": "散发出强烈的难闻气味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонять",
                                "target_lang_sense_clarification": "разговорное, о неприятном запахе"
                            },
                            {
                                "target_lang_word": "смердеть",
                                "target_lang_sense_clarification": "книжное, испускать сильное зловоние"
                            },
                            {
                                "target_lang_word": "дурно пахнуть",
                                "target_lang_sense_clarification": "более нейтральное выражение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发臭",
                                "target_lang_sense_clarification": "散发出难闻的气味"
                            },
                            {
                                "target_lang_word": "有臭味",
                                "target_lang_sense_clarification": "带有令人不悦的气味"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9f318c5-e23e-3ca9-8427-700adec07b21",
                    "sense_definition": "To be greatly inferior; to perform badly.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "inferiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I really <w>stink</w> at playing chess, so I usually lose every game.",
                            "target_lang_translations": {
                                "ru": "Я правда <w>никуда не гожусь</w> в шахматах, поэтому обычно проигрываю каждую партию.",
                                "zh": "我下棋真的很<w>烂</w>，所以我通常每局都输。"
                            }
                        },
                        {
                            "text": "That new movie <w>stinks</w> and I did not even stay for the end.",
                            "target_lang_translations": {
                                "ru": "Тот новый фильм — <w>полный отстой</w>, я даже не остался до конца.",
                                "zh": "那部新电影<w>烂</w>透了，我甚至没看完就走了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "suck",
                        "blow"
                    ],
                    "common_phrases": [
                        "stink at"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to describe poor quality"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быть очень плохим в чем-либо; скверно исполнять что-либо.",
                        "zh": "表现极差；质量非常低劣。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "быть полным отстоем",
                                "target_lang_sense_clarification": "сленг, о низком качестве"
                            },
                            {
                                "target_lang_word": "никуда не годиться",
                                "target_lang_sense_clarification": "о плохом качестве или исполнении"
                            },
                            {
                                "target_lang_word": "плохо получаться",
                                "target_lang_sense_clarification": "об отсутствии навыков"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很烂",
                                "target_lang_sense_clarification": "口语，形容质量极差"
                            },
                            {
                                "target_lang_word": "水平很差",
                                "target_lang_sense_clarification": "形容某人能力不足"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9593e10b-bd4e-3d83-a03d-2e633d7579bb",
                    "sense_definition": "To give an impression of dishonesty, untruth, or sin.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "suspicion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Something <w>stinks</w> about the politician's excuses regarding the missing funds.",
                            "target_lang_translations": {
                                "ru": "Оправдания политика насчет пропавших средств чем-то <w>попахивают</w>.",
                                "zh": "关于失踪资金，这位政客的借口听起来<w>有猫腻</w>。"
                            }
                        },
                        {
                            "text": "The whole business deal <w>stinks</w> of corruption and secret agreements.",
                            "target_lang_translations": {
                                "ru": "Вся эта деловая сделка <w>несет</w> коррупцией и тайными соглашениями.",
                                "zh": "整个商业交易都<w>透着</w>腐败和秘密协议的臭味。"
                            }
                        }
                    ],
                    "synonyms": [
                        "be fishy"
                    ],
                    "common_phrases": [
                        "stinks of corruption"
                    ],
                    "target_lang_definitions": {
                        "ru": "Производить впечатление нечестности, лжи или порочности.",
                        "zh": "给人一种不诚实、虚假或邪恶的印象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попахивать",
                                "target_lang_sense_clarification": "переносное, вызывать подозрения"
                            },
                            {
                                "target_lang_word": "дурно пахнуть",
                                "target_lang_sense_clarification": "переносное, о сомнительной ситуации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有猫腻",
                                "target_lang_sense_clarification": "口语，指事情有可疑之处"
                            },
                            {
                                "target_lang_word": "可疑",
                                "target_lang_sense_clarification": "令人怀疑"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f79b94d2-e290-3d75-ae37-1cbad1b6c40d",
                    "sense_definition": "To cause to stink; to affect by a stink.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bad smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The smoke from the factory began to <w>stink</w> the entire neighborhood.",
                            "target_lang_translations": {
                                "ru": "Дым с завода начал <w>отравлять вонью</w> весь район.",
                                "zh": "工厂排出的烟雾开始把整个社区<w>弄臭</w>了。"
                            }
                        },
                        {
                            "text": "He managed to <w>stink</w> the room up by leaving his wet boots inside.",
                            "target_lang_translations": {
                                "ru": "Он умудрился <w>завонять</w> всю комнату, оставив внутри свои мокрые ботинки.",
                                "zh": "他把湿靴子留在屋里，把整个房间都<w>弄臭</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stink up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заставить что-либо плохо пахнуть; наполнить вонью.",
                        "zh": "使某处充满臭味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "завонять",
                                "target_lang_sense_clarification": "наполнить помещение запахом"
                            },
                            {
                                "target_lang_word": "пропахнуть",
                                "target_lang_sense_clarification": "пропитать неприятным запахом"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄臭",
                                "target_lang_sense_clarification": "使环境充满难闻气味"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ebd7dbd-ac56-3c07-8af2-f8ae78ee2812",
                    "sense_definition": "A strong bad smell.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bad smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is a terrible <w>stink</w> coming from the refrigerator.",
                            "target_lang_translations": {
                                "ru": "Из холодильника доносится ужасная <w>вонь</w>.",
                                "zh": "冰箱里传出一股可怕的<w>臭味</w>。"
                            }
                        },
                        {
                            "text": "The <w>stink</w> of the garbage was overwhelming in the summer heat.",
                            "target_lang_translations": {
                                "ru": "<w>Зловоние</w> от мусора было невыносимым в летнюю жару.",
                                "zh": "夏日炎炎，垃圾的<w>恶臭</w>令人难以忍受。"
                            }
                        }
                    ],
                    "synonyms": [
                        "odour",
                        "odor",
                        "pong",
                        "reek",
                        "smell",
                        "stench"
                    ],
                    "common_phrases": [
                        "awful stink",
                        "terrible stink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильный неприятный запах.",
                        "zh": "强烈的难闻气味。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонь",
                                "target_lang_sense_clarification": "сильный неприятный запах"
                            },
                            {
                                "target_lang_word": "зловоние",
                                "target_lang_sense_clarification": "очень сильный, тошнотворный запах"
                            },
                            {
                                "target_lang_word": "смрад",
                                "target_lang_sense_clarification": "удушливая вонь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "臭味",
                                "target_lang_sense_clarification": "难闻的气味"
                            },
                            {
                                "target_lang_word": "恶臭",
                                "target_lang_sense_clarification": "极度难闻的气味"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ccbb6b6-ad4b-300b-b5c6-8b1a73d1999a",
                    "sense_definition": "A complaint or objection.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "complaint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you do not make a <w>stink</w> about the problem, nothing will be done.",
                            "target_lang_translations": {
                                "ru": "Если ты не <w>поднимешь шум</w> из-за этой проблемы, ничего не будет сделано.",
                                "zh": "如果你不对这个问题<w>闹事</w>，什么都不会得到解决。"
                            }
                        },
                        {
                            "text": "She raised a big <w>stink</w> when she found out her flight was canceled.",
                            "target_lang_translations": {
                                "ru": "Она <w>устроила большой скандал</w>, когда узнала, что её рейс отменили.",
                                "zh": "当她发现航班被取消时，她<w>大吵大闹</w>了一场。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a stink",
                        "raise a stink"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in phrases about complaining"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жалоба, протест или скандал.",
                        "zh": "抱怨、抗议或引发的骚动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шум",
                                "target_lang_sense_clarification": "в значении скандала или протеста"
                            },
                            {
                                "target_lang_word": "вонь",
                                "target_lang_sense_clarification": "сленг, в значении возмущения"
                            },
                            {
                                "target_lang_word": "скандал",
                                "target_lang_sense_clarification": "публичное выражение недовольства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闹事",
                                "target_lang_sense_clarification": "因不满而引发骚动"
                            },
                            {
                                "target_lang_word": "大吵大闹",
                                "target_lang_sense_clarification": "公开表达强烈不满"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "911f5e07-06de-3d22-be5d-a88747b4b1ad",
                    "sense_definition": "Bad-smelling, stinky.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bad smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The air in the old basement was damp and <w>stink</w>.",
                            "target_lang_translations": {
                                "ru": "Воздух в старом подвале был сырым и <w>вонючим</w>.",
                                "zh": "旧地下室里的空气潮湿且<w>发臭</w>。"
                            }
                        },
                        {
                            "text": "He spent hours in a <w>stink</w> morgue during his medical training.",
                            "target_lang_translations": {
                                "ru": "Он проводил часы в <w>зловонном</w> морге во время медицинского обучения.",
                                "zh": "他在医学培训期间，在<w>恶臭</w>的停尸房里待了几个小时。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "often found in Caribbean or specific dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохо пахнущий, вонючий.",
                        "zh": "散发臭味的，难闻的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонючий",
                                "target_lang_sense_clarification": "имеющий дурной запах"
                            },
                            {
                                "target_lang_word": "зловонный",
                                "target_lang_sense_clarification": "очень плохо пахнущий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "臭的",
                                "target_lang_sense_clarification": "有难闻气味的"
                            },
                            {
                                "target_lang_word": "恶臭的",
                                "target_lang_sense_clarification": "极度难闻的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d8491c1-26c2-31cc-82e2-4020b79dd51d",
                    "sense_definition": "Bad; inferior; worthless.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "inferiority",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concert was <w>stink</w> and we left after the first three songs.",
                            "target_lang_translations": {
                                "ru": "Концерт был <w>паршивым</w>, и мы ушли после первых трех песен.",
                                "zh": "那场音乐会太<w>烂</w>了，我们听了前三首歌就走了。"
                            }
                        },
                        {
                            "text": "That was a <w>stink</w> movie that wasted everyone's time.",
                            "target_lang_translations": {
                                "ru": "Это был <w>дерьмовый</w> фильм, который зря потратил время каждого.",
                                "zh": "那是一部<w>烂</w>片，浪费了大家的时间。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage meaning bad"
                        },
                        {
                            "trait_type": "regional",
                            "comment": "common in New Zealand and Australian slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плохой, низкокачественный, никчемный.",
                        "zh": "糟糕的；低劣的；毫无价值的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паршивый",
                                "target_lang_sense_clarification": "очень плохого качества"
                            },
                            {
                                "target_lang_word": "дерьмовый",
                                "target_lang_sense_clarification": "грубый сленг, никчемный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "烂",
                                "target_lang_sense_clarification": "质量极差"
                            },
                            {
                                "target_lang_word": "糟糕的",
                                "target_lang_sense_clarification": "品质低劣"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}