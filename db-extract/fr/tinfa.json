                        "glosses": [
                            "Sigle de trans, femmes, intersexes, non binaires et agenres, utilisé pour désigner soit les personnes qui ne sont pas des hommes cis soit celles qui ont été assignées femme à la naissance."
                        ],
                        "tags": [
                            "Transitude",
                            "LGBTQ",
                            "Suisse"
                        ],
                        "examples": [
                            {
