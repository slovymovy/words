                "senses": [
                    {
                        "sense_id": "687fb63a-eca1-39e4-9f53-a3df844d4ab7",
                        "entry_id": "028a75bc-ea01-3616-990d-662f2a7a0bff",
                        "glosses": [
                            "verzameling van veelal uitleenbare muziekopnamen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee0f69ec-e77d-4537-a7b9-3538032dc55f",
                                "sense_id": "687fb63a-eca1-39e4-9f53-a3df844d4ab7",
                                "text": "In de bibliotheek kun je naast een verzameling boeken ook een discotheek vinden waar je platen en cd's kunt lenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "f67d9e13-0a6c-3cc2-bc14-3ad93e16e059",
                        "entry_id": "028a75bc-ea01-3616-990d-662f2a7a0bff",
                        "glosses": [
                            "uitgaansgelegenheid waar wordt gedanst op popmuziek, disco [1]"
                        ],
                        "tags": [
                            "horeca"
                        ],
                        "examples": [
                            {
                                "example_id": "30ee91ca-6f32-4507-bfe4-9486d1d99a24",
                                "sense_id": "f67d9e13-0a6c-3cc2-bc14-3ad93e16e059",
                                "text": "Zullen we naar de discotheek gaan om te dansen?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e24d243a-d97d-442c-8d0b-566999cebae1",
                        "source_entry_id": "028a75bc-ea01-3616-990d-662f2a7a0bff",
                        "target_lang_word": "discotheque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "discotheque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e69adc7-4baa-346d-9716-13c014400a6a",
                                        "entry_id": "5760f753-fd5a-333a-9999-3e247fb891f1",
                                        "glosses": [
                                            "A nightclub where dancing takes place."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4efc6115-e066-49c4-bbc7-35314eab74c8",
                        "source_entry_id": "028a75bc-ea01-3616-990d-662f2a7a0bff",
                        "target_lang_word": "disco",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "disco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "24af2a55-7884-3f85-aadb-f1b8ef8398f3",
                                        "entry_id": "b05e8c6b-231f-3b79-baea-60375d07a6ed",
                                        "glosses": [
                                            "Clipping of discotheque (“nightclub for dancing”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "clipping",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d51e07a-60de-41d4-9535-5422d63390fc",
                                                "sense_id": "24af2a55-7884-3f85-aadb-f1b8ef8398f3",
                                                "text": "Burn down the disco / Hang the blessed DJ / Because the music that they constantly play / It says nothing to me about my life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b8d7f56-b047-33c6-962d-4a06f8625b98",
                                        "entry_id": "b05e8c6b-231f-3b79-baea-60375d07a6ed",
                                        "glosses": [
                                            "A genre of dance music that was popular in the 1970s, characterized by elements of soul music with a strong Latin-American beat and often accompanied by pulsating lights."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fa0da41-9265-4123-9d4b-f9b640d16dfd",
                                                "sense_id": "9b8d7f56-b047-33c6-962d-4a06f8625b98",
                                                "text": "And black music became a hot commodity in the form of disco, its lyrics and rhythm laced with a palpable (even ethnic) amiguity, helping people dance and escape their concerns. Even the cry of “burn, baby, burn”, a popular chant during many a 1960s urban rebellion, was co-opted by the times, becoming the chorus for the 1977 dance hit “Disco Inferno.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1ff09ab-7db1-3448-949a-62ac99510a82",
                                        "entry_id": "b05e8c6b-231f-3b79-baea-60375d07a6ed",
                                        "glosses": [
                                            "A dance, a social gathering where dancing is the main activity."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "disco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bb302ec-2c1a-310d-954c-32c925e1de3e",
                                        "entry_id": "f230e18f-c92a-33eb-8052-df17cec15485",
                                        "glosses": [
                                            "To dance disco-style dances."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78e7a58d-dd7c-4716-a03c-15d084e60e15",
                                                "sense_id": "8bb302ec-2c1a-310d-954c-32c925e1de3e",
                                                "text": "The cause of his ill health is left a little obscure, and no wonder, because shortly before his dreadful deathbed scene he's well enough to join the women in a wild night of disco dancing. You have not lived until you've seen Martin Landau discoing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a483ba37-86cb-3d59-aa0e-ede8b87be230",
                                        "entry_id": "f230e18f-c92a-33eb-8052-df17cec15485",
                                        "glosses": [
                                            "To go to discotheques."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cd9337a-3c84-48c5-93b9-f919cb031f56",
                                                "sense_id": "a483ba37-86cb-3d59-aa0e-ede8b87be230",
                                                "text": "Learning that a discoing sex appeal has returned to the runways is a little like hearing that Barbra Streisand and Barry Gibb are reuniting."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disco",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f777178-b2bb-3e86-9425-1655340420e2",
                                        "entry_id": "26b006da-ede8-3e8d-910c-7548d07228c7",
                                        "glosses": [
                                            "discovery (pre-trial phase in which evidence is gathered)"
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68524012-46dc-4a26-b302-44a2063994ae",
                                                "sense_id": "8f777178-b2bb-3e86-9425-1655340420e2",
                                                "text": "You don't need to worry about these details at the complaint stage, we can get them in disco."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fec7d82e-798f-3074-82f1-8f65c8b6d5b6",
                                        "entry_id": "26b006da-ede8-3e8d-910c-7548d07228c7",
                                        "glosses": [
                                            "discovery (materials revealed to the opposing party during the pre-trial phase in which evidence is gathered)"
                                        ],
                                        "tags": [
                                            "US",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e5fc17d-e0cb-4050-8aa8-51f669bf720d",
                                                "sense_id": "fec7d82e-798f-3074-82f1-8f65c8b6d5b6",
                                                "text": "Has the disco come in from the defendants yet? We sent them requests almost six weeks ago."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
