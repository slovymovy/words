        "nl-extract.jsonl": [
            {
                "entry_id": "b999b8f4-5222-3b40-861b-1ab09ee715cf",
                "word": "volstorten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fc4fe7b1-5eee-3f92-a211-55cf6c4e82ec",
                        "entry_id": "b999b8f4-5222-3b40-861b-1ab09ee715cf",
                        "glosses": [
                            "helemaal vol gooien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bdf7ef7-f529-4ee9-9590-d65c69cec7d0",
                                "sense_id": "fc4fe7b1-5eee-3f92-a211-55cf6c4e82ec",
                                "text": "Er zijn diverse maatregelen in de woning genomen, waaronder het volstorten van de kruipruimte met zand. De oorzaak van de te hoge concentratie is vooralsnog onbekend."
                            },
                            {
                                "example_id": "ff3c06c9-66ee-4f3d-92c0-c573c3677486",
                                "sense_id": "fc4fe7b1-5eee-3f92-a211-55cf6c4e82ec",
                                "text": "De Butchart-tuinen zijn het ultieme voorbeeld van succesvolle landwinning. Het land was in 1904 uitgeput na jarenlang extensief gebruik door Portland Cement. Jennie Butchart, de vrouw van de eigenaar van dat bedrijf, liet het land daarop volstorten met aarde afkomstig van nabijgelegen boerderijen."
                            }
                        ]
                    },
                    {
                        "sense_id": "dd8b2d50-1dfd-3582-a442-f5fa1eade16c",
                        "entry_id": "b999b8f4-5222-3b40-861b-1ab09ee715cf",
                        "glosses": [
                            "zoveel betalen dat het benodigde kapitaal bijeengebracht is"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6cc1d19-4203-479e-98ef-3e84c4461a28",
                        "source_entry_id": "b999b8f4-5222-3b40-861b-1ab09ee715cf",
                        "source_sense_id": "fc4fe7b1-5eee-3f92-a211-55cf6c4e82ec",
                        "source_sense_description": "helemaal vol gooien",
                        "target_lang_word": "fill in",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fill in",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a76f4ea-00be-3562-a697-0b62308178e0",
                                        "entry_id": "9ddf8d46-5801-3744-92d3-430b5c00bcda",
                                        "glosses": [
                                            "To fill; to replace material that is absent or has been removed."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afa64f40-f7cc-4182-88a1-3cb63da0ebc3",
                                                "sense_id": "0a76f4ea-00be-3562-a697-0b62308178e0",
                                                "text": "After you're done laying the pipe, fill in the trench."
                                            },
                                            {
                                                "example_id": "5f6e5334-f1a9-4dfe-ba0b-27074ee1c284",
                                                "sense_id": "0a76f4ea-00be-3562-a697-0b62308178e0",
                                                "text": "Typically for the 'get-on-with-it' era, the railway and military worked like demons to restore the vital rail link. The crater was rapidly filled in and the earth tamped solid, the wreckage was removed by breakdown trains, new rails and sleepers were rushed forward by willing hands, and US Army bulldozers piled in. By 2020 on the same day, both tracks were open for traffic again where there had been a gaping pit just hours before."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63573e91-fa13-310b-bbd6-77dd51165f58",
                                        "entry_id": "9ddf8d46-5801-3744-92d3-430b5c00bcda",
                                        "glosses": [
                                            "To inform somebody, especially to supply someone missing or missed information."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22df5bd1-cb4d-434c-95c1-94cd45d22391",
                                                "sense_id": "63573e91-fa13-310b-bbd6-77dd51165f58",
                                                "text": "If you know anything about this, maybe you can fill me in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5976a333-c220-38a2-95aa-d2b80d0659a6",
                                        "entry_id": "9ddf8d46-5801-3744-92d3-430b5c00bcda",
                                        "glosses": [
                                            "To substitute for somebody or something."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1463a302-8c73-4f97-a39a-c3d085e5fc94",
                                                "sense_id": "5976a333-c220-38a2-95aa-d2b80d0659a6",
                                                "text": "He can't go on vacation very often because there is nobody to fill in for him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be5a76b4-225b-30f8-ba64-1aa4b1325af0",
                                        "entry_id": "9ddf8d46-5801-3744-92d3-430b5c00bcda",
                                        "glosses": [
                                            "To complete a form or questionnaire with requested information."
                                        ],
                                        "tags": [
                                            "British",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afcde0f8-7d62-45c6-94d1-f02ec0ee7256",
                                                "sense_id": "be5a76b4-225b-30f8-ba64-1aa4b1325af0",
                                                "text": "I've gotten a form that is to be filled in in ink."
                                            },
                                            {
                                                "example_id": "cd42ad4b-7456-434f-a4cc-868f80808b32",
                                                "sense_id": "be5a76b4-225b-30f8-ba64-1aa4b1325af0",
                                                "text": "The findings emerged from questionnaires filled in by 2,211 staff in 145 wards of 55 hospitals in England and Wales and 105 observations of care of dementia patients. Two-thirds of staff said they had not had enough training to provide proper care, 50% said they had not been trained how to communicate properly with such patients and 54% had not been told how to handle challenging or aggressive behaviour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e377808-87f9-38a3-8bcf-dae25737823a",
                                        "entry_id": "9ddf8d46-5801-3744-92d3-430b5c00bcda",
                                        "glosses": [
                                            "To beat up; to physically assault."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a995229-7f68-43dc-b13b-4b5a5166ddc8",
                                                "sense_id": "6e377808-87f9-38a3-8bcf-dae25737823a",
                                                "text": "Talk to me like that again and I'll fill you in!"
                                            },
                                            {
                                                "example_id": "ea36cb59-3c54-465a-a1ad-bbd2766a59b6",
                                                "sense_id": "6e377808-87f9-38a3-8bcf-dae25737823a",
                                                "text": "It's just a rumour that was spread around town\nSomebody said that someone got filled in\nFor saying that people get killed in\nThe result of this shipbuilding"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5d24d308-9b0f-4e29-9ff1-f66838bc4a1f",
                        "source_entry_id": "b999b8f4-5222-3b40-861b-1ab09ee715cf",
