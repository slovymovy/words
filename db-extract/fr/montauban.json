                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2164af3-dc66-3f4f-a61a-8fafa116de60",
                        "entry_id": "132e408f-e926-3923-9207-324304e5c750",
                        "glosses": [
                            "Commune, ville et chef-lieu de département français, situé dans le département du Tarn-et-Garonne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ff1ef6-89d8-4e15-aed5-fb07e3ec2365",
                                "sense_id": "a2164af3-dc66-3f4f-a61a-8fafa116de60",
                                "text": "C’était en 1850 que Leroi, un jeune professeur venu de Paris, tombé au lycée de Montauban, avec des idées ardentes, républicain passionné, avait épousé Agathe Dagnan, la dernière des cinq filles d’une pauvre famille protestante, originaire des Cévennes."
                            },
                            {
                                "example_id": "5eb384cb-d53a-49ae-9c63-25f472d6574f",
                                "sense_id": "a2164af3-dc66-3f4f-a61a-8fafa116de60",
                                "text": "Pendant cinq siècles, sous la direction de ses capitouls et de ses consuls, Montauban fut une courageuse petite démocratie autonome."
                            },
                            {
                                "example_id": "d6f94ef1-cba3-41a8-bf30-5cb8406f0c4c",
                                "sense_id": "a2164af3-dc66-3f4f-a61a-8fafa116de60",
                                "text": "Je sais que c’est un équilibre, réagit Soraya Belkadi, entraîneure de Montauban [D2], mais il devrait y avoir un geste plus important."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5286dbf-83e4-328b-a582-aff9381c6389",
                        "entry_id": "132e408f-e926-3923-9207-324304e5c750",
                        "glosses": [
                            "Ancien nom de la commune française Montauban-de-Bretagne."
                        ],
