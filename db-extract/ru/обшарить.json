                    {
                        "form_id": "9bd90538-e488-4756-aec6-c3117dcfc123",
                        "entry_id": "3e2bc356-dec9-32f5-b7e2-5452f6b6c4f0",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "обша́ривши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8d192795-82b9-330c-9d66-d94eaeb4a42c",
                        "entry_id": "3e2bc356-dec9-32f5-b7e2-5452f6b6c4f0",
                        "glosses": [
                            "обыскать, тщательно ощупывая, роясь везде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e102f4ae-4940-4211-a1ec-4c51e6d0f2e5",
                                "sense_id": "8d192795-82b9-330c-9d66-d94eaeb4a42c",
                                "text": "Вор обшарит, хоть стены оставит, а огонь и те приберёт."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff08acdf-aa8e-487e-9d24-b4740d4c0688",
                        "source_entry_id": "3e2bc356-dec9-32f5-b7e2-5452f6b6c4f0",
                        "source_sense_id": "8d192795-82b9-330c-9d66-d94eaeb4a42c",
                        "target_lang_word": "rummage",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rummage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40e9db77-16a0-3c11-9115-b3ac11c9cbc3",
                                        "entry_id": "72bd6a47-4d5b-31d8-b776-85108a0cc57b",
                                        "glosses": [
                                            "To arrange (cargo, goods, etc.) in the hold of a ship; to move or rearrange such goods."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "47ec687d-1ea7-303d-858f-589986327dd9",
                                        "entry_id": "72bd6a47-4d5b-31d8-b776-85108a0cc57b",
                                        "glosses": [
                                            "To search a vessel for smuggled goods."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19263f2e-dffa-4dd4-87c5-6a10c8222277",
                                                "sense_id": "47ec687d-1ea7-303d-858f-589986327dd9",
                                                "text": "After the long voyage, the customs officers rummaged the ship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                                        "entry_id": "72bd6a47-4d5b-31d8-b776-85108a0cc57b",
                                        "glosses": [
                                            "To search something thoroughly and with disregard for the way in which things were arranged."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53f4d932-b99e-4e4e-8b49-464c9a895fe5",
                                                "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                                                "text": "The burglars rummaged the entire house for cash and jewellery."
                                            },
                                            {
                                                "example_id": "01194f4b-0328-460a-9506-d78c4fbf6737",
                                                "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                                                "text": "She rummaged her purse in search of the keys."
                                            },
                                            {
                                                "example_id": "b00ffcfc-ff1e-46d2-8efa-f6887a2ede8a",
                                                "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                                                "text": "He[…]searcheth his pockets, and taketh his keys, and so rummageth all his closets and trunks."
                                            },
                                            {
                                                "example_id": "250e1794-72b1-4455-9c43-c0687cdba63c",
                                                "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                                                "text": "What schoolboy of us has not rummaged his Greek dictionary in vain for a satisfactory account!"
                                            },
                                            {
                                                "example_id": "1c8e58d5-10c0-4302-87b1-b92abdc31959",
                                                "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                                                "text": "British journalists shun complete respectability, feeling a duty to be ready to savage the mighty, or rummage through their bins. Elsewhere in Europe, government contracts and subsidies ensure that press barons will only defy the mighty so far."
                                            },
                                            {
                                                "example_id": "5441fcb0-b309-4788-80d0-69f7755a56fa",
                                                "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                                                "text": "She rummaged in the drawers trying to find the missing sock."
                                            },
                                            {
                                                "example_id": "996ab0e2-5e62-4589-9d2a-f8fe209f5bce",
                                                "sense_id": "69e44097-08a2-3eaf-8534-6486e5b956de",
                                                "text": "Philander went into the next room[…]and came back with a salt mackerel that dripped brine like a rainstorm. Then he put the coffee pot on the stove and rummaged out a loaf of dry bread and some hardtack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eff8396-4760-3550-8812-22acca6fc058",
                                        "entry_id": "72bd6a47-4d5b-31d8-b776-85108a0cc57b",
                                        "glosses": [
                                            "To search something thoroughly and with disregard for the way in which things were arranged.",
                                            "To hastily search for something in a confined space and among many items by carelessly turning things over or pushing things aside; dig through carelessly."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "rummage",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3304977-712f-3ddb-93d2-796612650311",
                                        "entry_id": "644a23f7-004a-3651-b652-9bda96730783",
                                        "glosses": [
                                            "A thorough search, usually resulting in disorder."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c5c594c-cca7-4447-9809-3ca0fc6c0614",
                                                "sense_id": "c3304977-712f-3ddb-93d2-796612650311",
                                                "text": "Have a rummage through the attic and see if you can find anything worth selling."
                                            },
                                            {
                                                "example_id": "43bd6eab-6613-4fe6-9039-5d394a13d662",
                                                "sense_id": "c3304977-712f-3ddb-93d2-796612650311",
                                                "text": "He has made such a general rummage and reform in the office of matrimony."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a18f798-6707-3075-8c61-85909c3c8f9b",
                                        "entry_id": "644a23f7-004a-3651-b652-9bda96730783",
                                        "glosses": [
                                            "Commotion; disturbance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d37a6f68-f819-3af1-9038-416e4ebeae15",
                                        "entry_id": "644a23f7-004a-3651-b652-9bda96730783",
                                        "glosses": [
                                            "A disorganized collection of miscellaneous objects; a jumble."
                                        ],
                                        "tags": [
