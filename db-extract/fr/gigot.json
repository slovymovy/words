                                                "sense_id": "80dd776c-53dc-39ff-9a39-471167ed3713",
                                                "text": "So ein Schlegel vom Reh ist ein ausgesprochen leckerer Sonntagsbraten."
                                            },
                                            {
                                                "example_id": "d0d9337d-ed3f-4916-9655-8b595faaffec",
                                                "sense_id": "80dd776c-53dc-39ff-9a39-471167ed3713",
                                                "text": "„Ich bekomme also meinen knusprigen Schlegel ohne jedes Beiwerk in einem nackten Papptellerchen serviert und setze mich auf einen Barhocker neben dem hohen Gartentisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
