    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76d52b14-2846-350b-8841-8b710e15ef8e",
                    "sense_definition": "informatie proberen te vinden in een naslagwerk, database of lijst",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "informatie_vinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kun je de vertaling van dit woord <w>opzoeken</w> in het woordenboek?",
                            "target_lang_translations": {
                                "en": "Can you <w>look up</w> the translation of this word in the dictionary?",
                                "ru": "Ты можешь <w>посмотреть</w> перевод этого слова в словаре?"
                            }
                        },
                        {
                            "text": "Ik moet even het adres van het restaurant op internet <w>opzoeken</w>.",
                            "target_lang_translations": {
                                "en": "I need to <w>look up</w> the restaurant's address on the internet.",
                                "ru": "Мне нужно <w>найти</w> адрес ресторана в интернете."
                            }
                        }
                    ],
                    "synonyms": [
                        "nazoeken",
                        "raadplegen"
                    ],
                    "common_phrases": [
                        "een woord opzoeken",
                        "informatie opzoeken",
                        "op internet opzoeken"
                    ],
                    "target_lang_definitions": {
                        "en": "to try to find information in a reference work, database, or list",
                        "ru": "попытаться найти информацию в справочнике, базе данных или списке"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "look up",
                                "target_lang_sense_clarification": "information in a book or database"
                            },
                            {
                                "target_lang_word": "search for",
                                "target_lang_sense_clarification": "specific data or information"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "посмотреть",
                                "target_lang_sense_clarification": "информацию в словаре или списке"
                            },
                            {
                                "target_lang_word": "искать",
                                "target_lang_sense_clarification": "информацию в базе данных или интернете"
                            },
                            {
                                "target_lang_word": "проверить",
                                "target_lang_sense_clarification": "данные в источнике"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04600e16-3b6d-3fe2-a645-83187c4b9b34",
                    "sense_definition": "naar iemand toe gaan om die persoon te ontmoeten of te spreken",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bezoeken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>zocht</w> mijn zieke moeder <w>op</w> in het ziekenhuis.",
                            "target_lang_translations": {
                                "en": "I <w>visited</w> my sick mother in the hospital.",
                                "ru": "Я <w>навестил</w> свою больную маму в больнице."
                            }
                        },
                        {
                            "text": "Zal ik je morgenmiddag even thuis <w>opzoeken</w> voor een kopje koffie?",
                            "target_lang_translations": {
                                "en": "Shall I <w>look</w> you <w>up</w> at home tomorrow afternoon for a cup of coffee?",
                                "ru": "Мне <w>зайти</w> к тебе завтра днем домой на чашечку кофе?"
                            }
                        }
                    ],
                    "synonyms": [
                        "bezoeken",
                        "langsgaan"
                    ],
                    "common_phrases": [
                        "iemand gaan opzoeken",
                        "vrienden opzoeken"
                    ],
                    "target_lang_definitions": {
                        "en": "to go to someone in order to meet or speak with them",
                        "ru": "пойти к кому-то, чтобы встретиться или поговорить"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "visit",
                                "target_lang_sense_clarification": "to go see a person"
                            },
                            {
                                "target_lang_word": "look up",
                                "target_lang_sense_clarification": "to pay someone a visit (informal)"
                            },
                            {
                                "target_lang_word": "go to see",
                                "target_lang_sense_clarification": "to visit someone"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "навестить",
                                "target_lang_sense_clarification": "кого-то дома или в больнице"
                            },
                            {
                                "target_lang_word": "зайти",
                                "target_lang_sense_clarification": "к кому-то в гости"
                            },
                            {
                                "target_lang_word": "проведать",
                                "target_lang_sense_clarification": "больного или близкого человека"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7162b59-44af-37ab-8ed5-b34c5863a998",
                    "sense_definition": "moeite doen om iets of een bepaalde plek te vinden",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vinden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moest ik in dit open landschap mijn tent opzetten of de veiligheid van de bomen <w>opzoeken</w>?",
                            "target_lang_translations": {
                                "en": "Should I pitch my tent in this open landscape or <w>seek out</w> the safety of the trees?",
                                "ru": "Должен ли я был поставить палатку на этом открытом месте или <w>поискать</w> защиты среди деревьев?"
                            }
                        },
                        {
                            "text": "De toeristen wilden de rust van de natuur <w>opzoeken</w> ver weg van de stad.",
                            "target_lang_translations": {
                                "en": "The tourists wanted to <w>seek out</w> the peace of nature far away from the city.",
                                "ru": "Туристы хотели <w>найти</w> покой на природе вдали от города."
                            }
                        }
                    ],
                    "synonyms": [
                        "zoeken",
                        "trachten te vinden"
                    ],
                    "antonyms": [
                        "vermijden",
                        "ontwijken"
                    ],
                    "common_phrases": [
                        "de koelte opzoeken",
                        "de grens opzoeken"
                    ],
                    "target_lang_definitions": {
                        "en": "to make an effort to find something or a specific place, often for comfort or safety",
                        "ru": "прилагать усилия, чтобы найти определенное место или состояние (например, безопасность или прохладу)"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "seek out",
                                "target_lang_sense_clarification": "to look for a specific place or condition"
                            },
                            {
                                "target_lang_word": "look for",
                                "target_lang_sense_clarification": "to search for a location or environment"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "искать",
                                "target_lang_sense_clarification": "подходящее место или условия"
                            },
                            {
                                "target_lang_word": "стремиться",
                                "target_lang_sense_clarification": "к определенной обстановке"
                            },
                            {
                                "target_lang_word": "находить",
                                "target_lang_sense_clarification": "укрытие или покой"
                            }
                        ]
                    }
                }
            ]
        }
