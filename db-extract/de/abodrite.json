                        "entry_id": "d7ffe69c-e229-3e0e-98a6-364600b75008",
                        "glosses": [
                            "Angehöriger des mittelalterlichen, slawischen, gleichnamigen Stammesverbandes, der vor allem im heutigen Gebiet Mecklenburg und Holstein siedelte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0cb5a39-5f39-4370-b586-e32194eed4ce",
                                "sense_id": "02c7393e-e668-337a-8a20-cff0b4207260",
                                "text": "„Diese Gemeinschaft äußerte sich auch in der gemeinsamen Gegnerschaft gegenüber den Abodriten.“"
                            },
                            {
                                "example_id": "f2eba131-982f-44ef-9f50-5b9a63dd36a7",
                                "sense_id": "02c7393e-e668-337a-8a20-cff0b4207260",
                                "text": "„Endlich ein Abodrite, der genau in Vlads Feindbild passte.“"
                            }
                        ],
