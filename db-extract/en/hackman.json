                        "glosses": [
                            "The driver of a hack (a carriage, cab, or taxi)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a09b941-7e0b-488d-a8c3-0df46a8d53d7",
                                "sense_id": "1b588e2c-4234-3591-be13-44cedfa64d34",
                                "text": "But he makes all his calculations with the nicest precision, and goes darting in and out among a Broadway confusion of busy craft with the easy confidence of the educated hackman."
                            },
                            {
                                "example_id": "94e4c876-1c72-470f-a345-f065ac5220a5",
                                "sense_id": "1b588e2c-4234-3591-be13-44cedfa64d34",
                                "text": "He did not engage the services of any hackman or professional guide."
                            },
                            {
                                "example_id": "fbf6b918-405c-4af1-8b22-18c1788c80b9",
                                "sense_id": "1b588e2c-4234-3591-be13-44cedfa64d34",
                                "text": "The hackman had taken him to the house where Jones was lying."
                            }
                        ]
                    }
