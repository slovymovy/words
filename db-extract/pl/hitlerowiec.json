                "senses": [
                    {
                        "sense_id": "b448859d-2391-399b-9650-87a76d255bcf",
                        "entry_id": "30a5b62d-0d7e-32b9-baa0-cb2969fa7e57",
                        "glosses": [
                            "nazista"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "53c8bdd0-252d-4edc-84f2-d6ab38579e94",
                                "sense_id": "b448859d-2391-399b-9650-87a76d255bcf",
                                "text": "Hitlerowcy w odwet za zamach na dowódcę SS rozstrzelali stu zakładników."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bafe15ab-aff6-4ac9-b555-e6119c540ff8",
                        "source_entry_id": "30a5b62d-0d7e-32b9-baa0-cb2969fa7e57",
                        "source_sense_id": "b448859d-2391-399b-9650-87a76d255bcf",
                        "target_lang_word": "Hitlerian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hitlerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                        "entry_id": "5525d266-93d1-3977-88a1-0fece8f1968d",
                                        "glosses": [
                                            "Of, relating to, or resembling Hitler (the German chancellor) or his actions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55df26b1-dca1-4bdc-ac04-bc11b00e3576",
                                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                                "text": "of Hitlerian proportions"
                                            },
                                            {
                                                "example_id": "50cace55-9493-4c27-8d78-281cbdecff78",
                                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                                "text": "[He had] an almost Hitlerian cowlick on his pale brow."
                                            },
                                            {
                                                "example_id": "eb480831-8b41-4754-82e8-398cff97ad77",
                                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                                "text": "Cambodia was subjected to a genocide of Hitlerian proportions."
                                            },
                                            {
                                                "example_id": "ee63b843-8153-4459-94c4-d6357dc02466",
                                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                                "text": "Unable to contain his excitement, Foyʼs voice rose two octaves and took on a Hitlerian fervor."
                                            },
                                            {
                                                "example_id": "5e3719d9-9b0e-4909-a13f-6b8f1eb4489f",
                                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                                "text": "War is war — but we need to understand how wrong it is to see the temporary triumph of fascist villainy as the destruction, once and for all, of the German people and the inauguration of an eternal kingdom of Hitlerian darkness."
                                            },
                                            {
                                                "example_id": "3988ea48-4079-40b7-9a3d-48e58000df9c",
                                                "sense_id": "b4abb047-6226-34ca-addd-04546f7f0519",
                                                "text": "Hitlerian occupation authorities had been preparing action against Polish underground very carefully."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Hitlerian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "702d0250-9217-378b-accc-5664fbf81524",
                                        "entry_id": "003670c1-30fd-3a35-a0ad-9f3dbb2ed553",
                                        "glosses": [
                                            "A supporter of Hitler or his policies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1662b19b-786b-470c-bfe3-52a99ce3b163",
                                                "sense_id": "702d0250-9217-378b-accc-5664fbf81524",
                                                "text": "Since a German Communist state existed, a state peaceful and democratic by definition, it became more difficult to speak of crimes committed by Germans in general. Poles were confronted with a kind of \"Marxization\" of the German problem that had to be resolved in terms of classes: in the east were the good Germans because they were progressive; in the west, the bad Germsans, reactionaries, heirs of Nazism, even more-or-less camouflaged Hitlerians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2479a909-69be-4a32-9cdd-789668884cab",
                        "source_entry_id": "30a5b62d-0d7e-32b9-baa0-cb2969fa7e57",
                        "source_sense_id": "b448859d-2391-399b-9650-87a76d255bcf",
                        "target_lang_word": "hitlerovec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "fcffafa8-22a7-4133-bab7-57b2d6d1c025",
                        "source_entry_id": "30a5b62d-0d7e-32b9-baa0-cb2969fa7e57",
                        "source_sense_id": "b448859d-2391-399b-9650-87a76d255bcf",
                        "target_lang_word": "hitlérien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hitlérien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4aa3fb48-34a7-3c23-8a0e-82e9778ce3e1",
                                        "entry_id": "8522c619-fe42-32d1-8299-a7eaaf365449",
                                        "glosses": [
                                            "Qui se rapporte à Adolf Hitler, son régime ou sa doctrine."
                                        ],
                                        "tags": [
                                            "Nazism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0a51bb38-c4da-4efe-8bc2-e8899f8758cb",
                                                "sense_id": "4aa3fb48-34a7-3c23-8a0e-82e9778ce3e1",
                                                "text": "Et voilà que je me rappelle les cortèges de gueux qu’on menait en musique, le 1ᵉʳ mai, à Tempelhof, jurer fidélité au Führer. Avec quelle joie, avec quelle foi elles clamaient le Horst-Wessel-Lied, l’hymne hitlérien, ces gueules blêmes."
                                            },
                                            {
                                                "example_id": "a7ea8866-5e4a-42aa-b780-f53d8602e39f",
                                                "sense_id": "4aa3fb48-34a7-3c23-8a0e-82e9778ce3e1",
                                                "text": "M. Litvinoff dénonce au Conseil le péril hitlérien : « L'Allemagne, comme le montre Mein Kampf, vise à dominer le continent. »"
                                            },
                                            {
                                                "example_id": "97c17472-2a42-49b1-9aab-94189b05ea56",
                                                "sense_id": "4aa3fb48-34a7-3c23-8a0e-82e9778ce3e1",
                                                "text": "Leur sympathie pour le corporatisme, tel qu’avait tenté de l’établir le gouvernement Pétain sur le modèle de l’Italie fasciste et du Reich hitlérien, et qui, soumettant le travailleur au règne unique des traditions et des coutumes, c’est à dire de l’habitude, tend à ruiner en lui tout exercice de la liberté et de la raison."
                                            },
                                            {
                                                "example_id": "c81175b1-aca4-4d53-86f2-ace0a6b80154",
                                                "sense_id": "4aa3fb48-34a7-3c23-8a0e-82e9778ce3e1",
                                                "text": "Il portait sans complexe une petite moustache hitlérienne et était tout le temps au garde-à-vous devant moi. En m’ouvrant la portière, il ôtait sa casquette, joignait et claquait militairement les talons en hurlant un « Zu Befehl, Herr Lanzmann »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "hitlérien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6d5a08ba-cfdc-364b-99d7-a57f29f669db",
                                        "entry_id": "c233a295-9856-3a17-b5ba-f11c3e2cbe92",
                                        "glosses": [
                                            "Partisan d'Adolf Hitler."
                                        ],
                                        "tags": [
                                            "Nazism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8712cd6e-d188-4caa-8353-24c7e82e0d5a",
                                                "sense_id": "6d5a08ba-cfdc-364b-99d7-a57f29f669db",
                                                "text": "Mon hitlérien de province cherche le terme qui exprimerait sa pensée. Soit qu’il ne le trouve pas, soit qu’il n’ose dire une parole trop grandiose, il se tait. J’en ai l’impression très nette : en le poussant un peu on lui ferait avouer qu’il voit dans Hitler une nouvelle incarnation du Christ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cd86f43-6a1a-358f-81c2-0e8fce76fcda",
                                        "entry_id": "c233a295-9856-3a17-b5ba-f11c3e2cbe92",
                                        "glosses": [
                                            "Soldat ou milicien au service de l'Allemagne nazie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "181cc655-eb5f-4f75-a158-0b175da7f54c",
                                                "sense_id": "6cd86f43-6a1a-358f-81c2-0e8fce76fcda",
                                                "text": "L’offensive désespérée des hitlériens ne leur apporta pas plus de succès le 12 novembre. Les attaques furent repoussées sur tous les secteurs du front. Les pertes des hitlériens durant ces deux jours de combat furent colossales et se chiffrent par milliers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74be672b-ed29-4e8f-bed9-c1d66fb630e2",
                        "source_entry_id": "30a5b62d-0d7e-32b9-baa0-cb2969fa7e57",
                        "source_sense_id": "b448859d-2391-399b-9650-87a76d255bcf",
                        "target_lang_word": "hitleriano",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hitleriano",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "754989a7-da41-3a86-9fdd-dd440b1d3eb4",
                                        "entry_id": "9f1cc4c5-dc9b-322a-a0a7-3e2d9b7538ce",
                                        "glosses": [
                                            "Que pertenece o concierne a Adolf Hitler (general alemán)."
                                        ],
                                        "tags": [
                                            "noun"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afb49ba4-ff89-4f60-b77a-be4d963dfc83",
                                                "sense_id": "754989a7-da41-3a86-9fdd-dd440b1d3eb4",
                                                "text": "Entonces, Becker aterrizó en la Universidad Estatal de San Francisco, donde logró mantener su trabajo por más de un año. Pero cuando las protestas estudiantiles explotaron en contra de la Guerra de Vietnam, la universidad llamó a la Guardia Nacional y las cosas se pusieron violentas. Cuando Becker apoyó a los estudiantes y condenó públicamente las acciones del decano (una vez más, acusándolo de ser hitleriano y demás), de nuevo lo corrieron sin demora."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1db48f9d-3d54-425a-827a-2fb31c80807d",
                        "source_entry_id": "30a5b62d-0d7e-32b9-baa0-cb2969fa7e57",
