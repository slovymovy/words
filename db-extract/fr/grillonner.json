                                "example_id": "c9c74a9c-d2b1-4cec-8862-f6254a966928",
                                "sense_id": "fa4dd958-929c-32b0-b000-bd55d8b092e5",
                                "text": "Grillons jacasses ! Vous n’arrêtiez pas de grillonner."
                            }
                        ]
