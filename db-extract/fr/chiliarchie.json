                                "sense_id": "ec58855e-b33e-3a03-a78f-0e43acdb812c",
                                "text": "Quatre chiliarchies formaient la petite phalange, huit la demi-phalange, et seize la phalange entière."
                            },
                            {
                                "example_id": "c6df446e-d82d-41ff-8cea-86cfd50c5d29",
                                "sense_id": "ec58855e-b33e-3a03-a78f-0e43acdb812c",
                                "text": "Il voulut que sa chiliarchie continuât à être appelée « la chiliarchie d’Hephaestion » et conservât le fanion personnel adopté par celui-ci."
                            }
                        ]
                    }
