                            {
                                "example_id": "6dffac9f-af7d-4453-b56e-bea9bcfd5024",
                                "sense_id": "1090377d-77f7-3f98-8cfd-0705be27d6de",
                                "text": "Jakie właściwości chemiczne ma frans?"
