                                "example_id": "72d662f9-7d03-4afe-bcc9-5c1e014a954a",
                                "sense_id": "eb665739-0a71-3b99-affc-eb2364ff846a",
                                "text": "De zelfredzaamheid van die jongen is gelukkig groot."
                            }
