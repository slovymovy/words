                        ],
                        "form": "гугни́вее"
                    },
                    {
                        "form_id": "28ad1358-7c60-4134-bc44-8aae8b9cd144",
                        "entry_id": "c78cc29f-ef81-3c2a-8c6a-60cc61052218",
                        "tags": [
