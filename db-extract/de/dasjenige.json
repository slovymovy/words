                ],
                "senses": [
                    {
                        "sense_id": "6774615f-87db-362b-ad5e-dc2615d21bcd",
                        "entry_id": "f99dae03-d8ab-316e-bf8b-0f528ce80a0c",
                        "glosses": [
                            "Nominativ Singular Neutrum des Demonstrativpronomens derjenige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a51112e0-1468-480a-b680-39ab4a00f90e",
                                "sense_id": "6774615f-87db-362b-ad5e-dc2615d21bcd",
                                "text": "„Dadurch ist dasjenige zum Elemente des Daseins oder zur Form der Gegenständlichkeit für das Bewußtsein geworden, was das Wesen selbst ist; nämlich der Begriff“. (Quelle: Georg Wilhelm Friedrich Hegel - VIII Das absolute Wissen (1))"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2b31cf87-2f17-32c7-bd13-e953bb674d0c",
                        "entry_id": "f99dae03-d8ab-316e-bf8b-0f528ce80a0c",
                        "glosses": [
                            "Akkusativ Singular Neutrum des Demonstrativpronomens derjenige."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e28e9f4-b9a6-48ec-a8e2-b14f842461b9",
                                "sense_id": "2b31cf87-2f17-32c7-bd13-e953bb674d0c",
                                "text": "„Das trieb mich an, der Sache auf eigenem Wege nachzuspüren und dasjenige zu finden, was allen Pflanzen ohne Unterschied gemein wäre, und so entdeckte ich das Gesetz der Metamorphose“. (Quelle: Johann Peter Eckermann - Gespräche mit Goethe in den letzten Jahren seines Lebens / I. Teil, 1.2.1827)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
