                        "examples": [
                            {
                                "example_id": "49365e47-dcb4-4ccd-9503-2979e8b21f97",
                                "sense_id": "2ed734c1-4ea8-38fb-a306-c35f4b4ecb7f",
                                "text": "Le chapeau de soie, trois : les galetiers, formant la coiffe ou la galette; les monteurs, appliquant la peluche de soie sur la galette, les tournuriers, achevant le chapeau en lui donnant sa tournure."
                            },
                            {
                                "example_id": "1605ee4a-a5fb-4209-8b8a-6037470f9ecd",
                                "sense_id": "2ed734c1-4ea8-38fb-a306-c35f4b4ecb7f",
                                "text": "Ainsi monté, le chapeau est remis au tournurier qui le bride, c'est-à-dire plie l'extrémité du bord chauffé au fourneau, ou passe un fer sur un molleton humide posé sur le bord."
                            }
                        ]
