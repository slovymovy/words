                        "glosses": [
                            "Débarrasser d'une fibrose, éliminer les tissus fibreux pathologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e29c0466-9d52-4caa-953b-8ce49fad244e",
                                "sense_id": "f40f81f8-b133-345d-8383-439958b47880",
                                "text": "Aussi appelé « technique de Jacquet-Leroy », le pincer-relâcher permet de défibroser ainsi que de stimuler la circulation sanguine et la peau en activant la production cellulaire."
                            },
                            {
                                "example_id": "327a5081-be98-439d-a2eb-8b143afeffe0",
                                "sense_id": "f40f81f8-b133-345d-8383-439958b47880",
                                "text": "Elles ont pour effet de défibroser le corps glandulaire, de relâcher et de faire circuler les sécrétions parotidiennes dans le canal de Sténon."
                            },
                            {
                                "example_id": "0aafe5a1-5cb7-40ce-8895-4b7801ae1956",
                                "sense_id": "f40f81f8-b133-345d-8383-439958b47880",
                                "text": "PÉTRISSAGE Malaxage des muscles avec les paumes. Détend les muscles, stimule la circulation sanguine, défibrose les tissus."
                            }
                        ]
