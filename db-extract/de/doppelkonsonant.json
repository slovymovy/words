                        "form": "die Doppelkonsonanten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef20cb3e-47e9-30da-b930-fb2e251aecc7",
                        "entry_id": "2aa9b694-1736-366a-b501-2f4b24060f6b",
                        "glosses": [
                            "doppelt geschriebener Konsonantenbuchstabe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d6fa76c-04e5-4f07-9a23-8ca75e4b5d8c",
                                "sense_id": "ef20cb3e-47e9-30da-b930-fb2e251aecc7",
                                "text": "„Die Maskilim, die Aufklärer, fügten Doppelkonsonanten und sogar das Dehnungs-h aus dem Neuhochdeutschen in die jiddische Schreibweise ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff7d070f-17bb-35f5-8590-760e25d55884",
                        "entry_id": "2aa9b694-1736-366a-b501-2f4b24060f6b",
                        "glosses": [
                            "doppelt gesprochener Konsonant"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7e86c73-5379-496c-b6fe-1630d8909025",
                                "sense_id": "ff7d070f-17bb-35f5-8590-760e25d55884",
                                "text": "„Steht der Doppelkonsonant zwischen zwei Vokalen und ist der vorausgehende Vokal ungespannt und betont, so ergibt sich ein Silbengelenk.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "007a4eaa-621a-31c0-9893-15c8233dcc04",
                        "entry_id": "2aa9b694-1736-366a-b501-2f4b24060f6b",
                        "glosses": [
                            "Kombination von zwei unterschiedlichen Konsonanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af46867a-26c8-4919-b89e-794d5a75b9f6",
                                "sense_id": "007a4eaa-621a-31c0-9893-15c8233dcc04",
                                "text": "„Ferner entspricht diese Phonetik nicht dem Ortsnamen Beuvray: Da der lateinische Doppelkonsonant /fr/ im Französischen erhalten wurde, sollte das lateinische Wort «Beffray» ergeben haben. Der französische Doppelkonsonant /vr/ wurde mit hoher Wahrscheinlichkeit von /br/ oder /pr/ abgeleitet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
