                    "frequency": "Middle",
                    "semantic_group_id": "luminosite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les grands rideaux épais viennent <w>assombrir</w> le salon pendant les heures chaudes de l'après-midi."
                        },
                        {
                            "text": "Ces vieux arbres devant la fenêtre <w>assombrissent</w> notre cuisine toute la journée."
                        }
