                },
                {
                    "sense_id": "00276d90-a948-33d3-9dc6-cd09e7328ac8",
                    "sense_definition": "iets ervaren, ondergaan of genieten van een abstracte toestand",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ervaring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij heeft het succes van zijn harde werk niet meer mogen <w>smaken</w>.",
                            "target_lang_translations": {
                                "en": "He was no longer able to <w>taste</w> the success of his hard work.",
                                "ru": "Ему не довелось больше <w>вкусить</w> успех своего тяжелого труда."
