                    {
                        "sense_id": "729339dd-0108-3998-b257-79e04eb506f6",
                        "entry_id": "f3f67b5b-e6ce-3b06-9a9b-5af2391242a7",
                        "glosses": [
                            "geul voor waterafvoer die langs een verharde weg loopt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c8f11a-52d7-4a82-933e-d9d1ef259917",
                                "sense_id": "729339dd-0108-3998-b257-79e04eb506f6",
                                "text": "Volgens Rik Dubois dringt een mentaliteitsverandering zich op. “We moeten de mensen bewust maken om hun woonomgeving proper te houden. Daarbij denk ik aan de afvoerputjes, de straatgoten, de voetpaden, het zwerfvuil en de kleine groenzones. Moesten we dat al kunnen teweegbrengen en bereiken, dan het heeft het gemeentepersoneel meer tijd en de handen vrij om het gemeentelijk patrimonium te onderhouden.”"
                            },
                            {
                                "example_id": "bd258645-4cd7-4c72-b6ac-13a755339664",
                                "sense_id": "729339dd-0108-3998-b257-79e04eb506f6",
                                "text": "Consternatie gisteren aan de Neptunusstraat in Enschede, waar een voorbijganger een slang in de straatgoot zag zonnen."
                            }
                        ]
                    }
