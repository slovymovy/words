                    {
                        "translation_id": "9a5074c5-834a-43ee-8f10-dc50cf6bdadc",
                        "source_entry_id": "e7024a3b-bc10-370e-a938-83124ebd9c0a",
                        "source_sense_description": "несправедливо причинённое огорчение, оскорбление",
                        "target_lang_word": "Kränkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kränkung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "248e8860-1138-3e5f-950d-02b74779acba",
                                        "entry_id": "427c507d-b4bd-32ca-a626-fcfc3ce8da45",
                                        "glosses": [
                                            "die Verletzung eines anderen Menschen in seiner Ehre, seinen Gefühlen oder seinem Selbstbewusstsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62abd253-68a3-4130-b441-002e922469d3",
                                                "sense_id": "248e8860-1138-3e5f-950d-02b74779acba",
                                                "text": "Den Vorwurf der Faulheit empfand er als Kränkung."
                                            },
                                            {
                                                "example_id": "85c94f5e-8f15-463a-9acb-b017660fe49e",
                                                "sense_id": "248e8860-1138-3e5f-950d-02b74779acba",
                                                "text": "„Eine Beleidigung kann auch auf einem Missverständnis beruhen, während eine Beschimpfung nicht missverstanden werden kann - die Kränkung ist beabsichtigt.“"
                                            },
                                            {
                                                "example_id": "49c936d6-02f1-492e-aef8-d8c51d5d32cc",
                                                "sense_id": "248e8860-1138-3e5f-950d-02b74779acba",
                                                "text": "„Die Zeit der Rassentrennung und Entwürdigung, der fortlaufenden Kränkungen müsse endlich vorbei sein.“"
                                            },
                                            {
                                                "example_id": "9b10ea52-8687-4314-9f95-5340356b7f4e",
                                                "sense_id": "248e8860-1138-3e5f-950d-02b74779acba",
                                                "text": "„Die meisten zwischenmenschlichen Konflikte werden durch Kränkungen ausgelöst.“"
                                            },
                                            {
                                                "example_id": "35009a11-d1df-4d37-a386-b2787c336a5c",
                                                "sense_id": "248e8860-1138-3e5f-950d-02b74779acba",
                                                "text": "„Alpatytsch verschluckte die Kränkung, segelte hastig hinter Rostow her und begann ihm wieder auseinanderzusetzen, wie die Dinge lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68d6d549-dde1-46ad-8bfb-bfa785244642",
                        "source_entry_id": "e7024a3b-bc10-370e-a938-83124ebd9c0a",
