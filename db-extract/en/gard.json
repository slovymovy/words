                "senses": [
                    {
                        "sense_id": "ec85d957-e716-3652-bcb9-95fe293eb270",
                        "entry_id": "b9ed3432-f770-3cdd-bd7c-a8461cab8b10",
                        "glosses": [
                            "A department of Occitania, France."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "5fd63874-7bc5-3eb1-a695-49a536d323e9",
                        "entry_id": "b9ed3432-f770-3cdd-bd7c-a8461cab8b10",
                        "glosses": [
                            "A right tributary of the Rhône flowing through the departments of Lozère and Gard, in southern France."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a42e163-3cfe-4414-b0af-759b391954e5",
                        "source_entry_id": "b9ed3432-f770-3cdd-bd7c-a8461cab8b10",
                        "source_sense_description": "department of France",
                        "target_lang_word": "Gard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83ba7441-670d-3b46-8456-ca9634016e2b",
                                        "entry_id": "92ff861b-d115-31ac-b412-180e1885ef42",
                                        "glosses": [
                                            "Rivière française qui prend sa source dans le haut des Cévennes et se jette dans le Rhône."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd38e4ad-4ab5-4a2d-8e50-fd4f7532deb0",
                                                "sense_id": "83ba7441-670d-3b46-8456-ca9634016e2b",
                                                "text": "A l’inverse du Vidourle supérieur ou du Gard inférieur qui se perdent chaque été pour résurger à de grosses sources karstiques (M. Ricolvi 19G8; G. Farre 1972 b), la Cèze disparait rarement totalement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56c2022c-981b-3cd8-9fe6-fcfc2132b227",
                                        "entry_id": "92ff861b-d115-31ac-b412-180e1885ef42",
                                        "glosses": [
                                            "Département français de la région administrative Occitanie, portant le numéro 30."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "631e51a7-54da-4719-8fd7-35d571e72d58",
                                                "sense_id": "56c2022c-981b-3cd8-9fe6-fcfc2132b227",
                                                "text": "En l'an VIII, le département du Gard fut partagé en quatre arrondissements de sous-préfectures: Alais, Nimes, Uzès et le Vigan."
                                            },
                                            {
                                                "example_id": "f0f85d83-ca8a-412c-beee-6ea92ab54629",
                                                "sense_id": "56c2022c-981b-3cd8-9fe6-fcfc2132b227",
                                                "text": "La faune liasienne de l'Aveyron montre en général un faciès côtier. Mais déjà, dans le Gard, se manifestent les caractères de mer profonde, caractères qui se poursuivent dans les Bouches-du-Rhône et le Var."
                                            },
                                            {
                                                "example_id": "23f1558c-8c51-43e6-b87f-f0558dc81fca",
                                                "sense_id": "56c2022c-981b-3cd8-9fe6-fcfc2132b227",
                                                "text": "L’élevage des vers à soie « ne paie plus ». Voilà pourquoi, aujourd’hui, dans le Gard, on arrache les mûriers : on les remplace imprudemment par des vignes…"
                                            },
                                            {
                                                "example_id": "d95a33f2-7399-4c01-9b72-52707ce7794f",
                                                "sense_id": "56c2022c-981b-3cd8-9fe6-fcfc2132b227",
                                                "text": "Les gendarmes du peloton motorisé de Nîmes ont fait une drôle de rencontre, à Sernhac (Gard)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
