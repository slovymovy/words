    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d82e7742-3cc5-3625-bd75-aa1eb28d5afc",
                    "sense_definition": "Een harig insect uit het geslacht Bombus dat behoort tot de bijen, bekend om zijn zachte gezoem.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "insecten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er vliegt een grote, harige <w>hommel</w> rond de bloemen in de tuin.",
                            "target_lang_translations": {
                                "en": "There is a large, hairy <w>bumblebee</w> flying around the flowers in the garden."
                            }
                        },
                        {
                            "text": "In de lente zie je vaak een <w>hommel</w> op zoek naar nectar.",
                            "target_lang_translations": {
                                "en": "In spring, you often see a <w>bumblebee</w> searching for nectar."
                            }
                        }
                    ],
                    "synonyms": [
                        "hommelbij"
                    ],
                    "common_phrases": [
                        "een harige hommel",
                        "zoemende hommel"
                    ],
                    "target_lang_definitions": {
                        "en": "A hairy insect of the genus Bombus belonging to the bees, known for its soft buzzing sound."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bumblebee",
                                "target_lang_sense_clarification": "large hairy bee of the genus Bombus"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00a269fc-cad3-3a11-bb96-80adfb2f858e",
                    "sense_definition": "Een mannelijke bij of hommel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "insecten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>hommel</w> heeft in dit geval geen angel en kan dus niet steken.",
                            "target_lang_translations": {
                                "en": "The <w>drone</w> has no stinger in this case and therefore cannot sting."
                            }
                        },
                        {
                            "text": "In de imkerij wordt de mannelijke bij vaak aangeduid als dar of <w>hommel</w>.",
                            "target_lang_translations": {
                                "en": "In beekeeping, the male bee is often referred to as a <w>drone</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "dar"
                    ],
                    "target_lang_definitions": {
                        "en": "A male bee or bumblebee."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drone",
                                "target_lang_sense_clarification": "male bee"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1806917f-6849-35da-ab85-505d6bef9c3a",
                    "sense_definition": "Een traditioneel snaarinstrument of volksinstrument dat verwant is aan de vlier of doedelzak.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muziekinstrumenten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De muzikant speelde een oud volksliedje op een houten <w>hommel</w>.",
                            "target_lang_translations": {
                                "en": "The musician played an old folk song on a wooden <w>hummel</w>."
                            }
                        },
                        {
                            "text": "In het museum staat een historische <w>hommel</w> tentoongesteld.",
                            "target_lang_translations": {
                                "en": "A historical <w>hummel</w> is on display in the museum."
                            }
                        }
                    ],
                    "target_lang_definitions": {
