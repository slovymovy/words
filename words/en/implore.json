                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "begging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The refugees <w>implored</w> the government for immediate humanitarian aid and protection."
                        },
                        {
                            "text": "She <w>implored</w> his forgiveness after realizing the gravity of her mistake."
                        }
                    ],
                    "synonyms": [
