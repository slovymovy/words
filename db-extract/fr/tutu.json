                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f89fb9d-aa23-4764-9e7d-63f56ab1bfce",
                                                "sense_id": "3def5eed-0ba8-3a8d-b0ea-67d67fa04a97",
                                                "text": "Wczoraj kupiłem paczkę gum."
                                            }
                                        ],
