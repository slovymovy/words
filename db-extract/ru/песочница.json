                                            "US",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sandbox",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f9122880-3ba4-3044-9483-2c1b90478b65",
                                        "entry_id": "00cad06f-66a8-36f5-b720-5f5b03281d42",
                                        "glosses": [
                                            "To restrict (a program, etc.) by placing it in a sandbox."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1de3485f-b6e3-4479-bf1c-94819343ed1c",
                                                "sense_id": "f9122880-3ba4-3044-9483-2c1b90478b65",
                                                "text": "Although you can use standard JavaScript and AJAX in sandboxed iframe pages to your heart's content, the Facebook Platform places restrictions over the amount of scripting capabilities you can add to the more tightly integrated FBML pages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ee8f5e5-8376-38fa-9ae3-050fddf41f31",
                                        "entry_id": "00cad06f-66a8-36f5-b720-5f5b03281d42",
                                        "glosses": [
                                            "To brainstorm; to prototype."
                                        ],
                                        "tags": [
