                        "sense_id": "25efe69a-10d6-37f9-b583-8ed8f7abed25",
                        "entry_id": "bbe3ca16-dc21-3d9d-952f-a0f560d32d4f",
                        "glosses": [
                            "zeker een doel voor ogen hebbend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50905693-fd06-43a6-bc98-9daedeed7bdf",
                                "sense_id": "25efe69a-10d6-37f9-b583-8ed8f7abed25",
                                "text": "De vastbesloten landen van de Arabische Liga lieten zich door het veto niet van de wijs brengen."
                            },
                            {
                                "example_id": "8ae05ffb-6b24-4629-80a9-a5a4abaa01f3",
                                "sense_id": "25efe69a-10d6-37f9-b583-8ed8f7abed25",
                                "text": "Niemand had ooit gezien wie die linten om de bomen bond - Adrián was blijkbaar een van hen geweest - maar dat er mensen bestonden die vastbesloten waren om die bomen ermee te tooien, wees op een onderstroom van opstandigheid, een verlangen om de boel op zijn kop te zetten."
                            }
                        ]
                    }
