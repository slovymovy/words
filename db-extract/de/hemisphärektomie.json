                                                "example_id": "257d8f91-923b-453a-a678-824110bba7b3",
                                                "sense_id": "f301ca3c-72ab-3635-9a58-e05733b7b961",
                                                "text": "So Lacy's parents had brought her to Johns Hopkins for a hemispherectomy, which is probably the most radical procedure in neurosurgery."
                                            }
