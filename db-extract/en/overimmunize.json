                        "sense_id": "7b4f812a-e370-3928-9790-c8e9880ceb95",
                        "entry_id": "87d4bf9a-35fa-3538-90f6-6c6de9f616d2",
                        "glosses": [
                            "To provide with more immunizations than is necessary."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be51b8a5-9e06-4980-a5e9-b3ceafbe76c1",
                                "sense_id": "7b4f812a-e370-3928-9790-c8e9880ceb95",
                                "text": "Those who tend, from ignorance, to underimmunize would readily follow such schedules; those who tend to overimmunize would quickly adopt proper standards, lest medical and lay persons criticize them."
                            },
                            {
                                "example_id": "29f58f02-7388-41d1-8a09-72ccc502ec72",
                                "sense_id": "7b4f812a-e370-3928-9790-c8e9880ceb95",
                                "text": "It is up to the caregiver to decide, but it is better to overimmunize a child than to underimmunize."
                            }
                        ]
                    }
                ],
