{
    "word_family": [
        "veering"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3c20ba68-59d7-3118-8c6a-91c6291770e8",
                    "sense_definition": "To change direction or course suddenly; to swerve.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "change of direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car slid on the ice and <w>veered</w> out of control toward the ditch.",
                            "target_lang_translations": {
                                "ru": "Машина заскользила на льду и неуправляемо <w>понеслась</w> в сторону кювета.",
                                "de": "Das Auto rutschte auf dem Eis und <w>scherte</w> unkontrolliert in Richtung Graben aus."
                            }
                        },
                        {
                            "text": "The conversation <w>veered</w> off course when someone mentioned the controversial new policy.",
                            "target_lang_translations": {
                                "ru": "Разговор <w>отклонился</w> от темы, когда кто-то упомянул спорную новую политику.",
                                "de": "Das Gespräch <w>kam</w> vom Kurs <w>ab</w>, als jemand die umstrittene neue Politik erwähnte."
                            }
                        }
                    ],
                    "synonyms": [
                        "swerve",
                        "deviate",
                        "diverge",
                        "sheer",
                        "turn",
                        "drift"
                    ],
                    "common_phrases": [
                        "veered off course",
                        "veered out of control"
                    ],
                    "target_lang_definitions": {
                        "ru": "Резко изменить направление или курс; отклониться в сторону.",
                        "de": "Plötzlich die Richtung oder den Kurs ändern; ausscheren."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свернуть",
                                "target_lang_sense_clarification": "резко изменить направление"
                            },
                            {
                                "target_lang_word": "отклониться",
                                "target_lang_sense_clarification": "от курса или темы"
                            },
                            {
                                "target_lang_word": "занести",
                                "target_lang_sense_clarification": "о транспортном средстве"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "ausscheren",
                                "target_lang_sense_clarification": "aus einer Spur oder Formation ausbrechen"
                            },
                            {
                                "target_lang_word": "abdrehen",
                                "target_lang_sense_clarification": "bogenförmig die Richtung ändern"
                            },
                            {
                                "target_lang_word": "abkommen",
                                "target_lang_sense_clarification": "vom Kurs oder Weg abweichen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0dbdf5e5-1ba8-3501-8605-b71bb11f0a46",
                    "sense_definition": "To turn or change position.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "change of direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cyclist had to <w>veer</w> sharply to avoid hitting the pedestrian.",
                            "target_lang_translations": {
                                "ru": "Велосипедисту пришлось резко <w>свернуть</w>, чтобы не сбить пешехода.",
                                "de": "Der Radfahrer musste scharf <w>abdrehen</w>, um den Fußgänger nicht zu treffen."
                            }
                        },
                        {
                            "text": "Public opinion began to <w>veer</w> in favor of the new environmental regulations.",
                            "target_lang_translations": {
                                "ru": "Общественное мнение начало <w>склоняться</w> в пользу новых экологических норм.",
                                "de": "Die öffentliche Meinung begann, zugunsten der neuen Umweltvorschriften zu <w>drehen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "turn",
                        "swing"
                    ],
                    "common_phrases": [
                        "veer sharply"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повернуть или изменить положение (в том числе метафорически).",
                        "de": "Drehen oder die Position verändern (auch metaphorisch)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворачивать",
                                "target_lang_sense_clarification": "менять направление движения"
                            },
                            {
                                "target_lang_word": "меняться",
                                "target_lang_sense_clarification": "о мнении или ситуации"
                            },
                            {
                                "target_lang_word": "склоняться",
                                "target_lang_sense_clarification": "к определенному мнению"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "drehen",
                                "target_lang_sense_clarification": "die Richtung ändern"
                            },
                            {
                                "target_lang_word": "einschwenken",
                                "target_lang_sense_clarification": "sich einer Meinung oder Richtung anschließen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f3e404bf-61c4-31c5-8105-232a52dbf08f",
                    "sense_definition": "Of the wind, to shift in a clockwise direction in the Northern Hemisphere.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "meteorological movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor noticed the wind <w>veer</w> to the west as the storm approached.",
                            "target_lang_translations": {
                                "ru": "Моряк заметил, как ветер <w>повернул</w> на запад с приближением шторма.",
                                "de": "Der Seemann bemerkte, wie der Wind mit Annäherung des Sturms nach Westen <w>rechtdrehte</w>."
                            }
                        },
                        {
                            "text": "Meteorologists predicted the wind would <w>veer</w> during the afternoon hours.",
                            "target_lang_translations": {
                                "ru": "Метеорологи предсказали, что направление ветра <w>изменится</w> в послеобеденные часы.",
                                "de": "Meteorologen sagten voraus, dass der Wind in den Nachmittagsstunden <w>rechtdrehen</w> würde."
                            }
                        }
                    ],
                    "antonyms": [
                        "back"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О ветре: менять направление по часовой стрелке (в Северном полушарии).",
                        "de": "Vom Wind: im Uhrzeigersinn die Richtung ändern."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворачивать",
                                "target_lang_sense_clarification": "о ветре по часовой стрелке"
                            },
                            {
                                "target_lang_word": "меняться",
                                "target_lang_sense_clarification": "о направлении ветра"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "rechtdrehen",
                                "target_lang_sense_clarification": "meteorologischer Fachbegriff für Winddrehung im Uhrzeigersinn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99bcde25-ee67-3262-8339-1245790b5e69",
                    "sense_definition": "To let out a rope or sail-line; to allow a sheet to run out.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical actions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain ordered the crew to <w>veer</w> the mainsheet to catch the breeze.",
                            "target_lang_translations": {
                                "ru": "Капитан приказал команде <w>потравливать</w> грота-шкот, чтобы поймать ветер.",
                                "de": "Der Kapitän befahl der Besatzung, das Großschot zu <w>fieren</w>, um die Brise einzufangen."
                            }
                        },
                        {
                            "text": "You must <w>veer</w> out more cable to ensure the anchor holds firmly.",
                            "target_lang_translations": {
                                "ru": "Нужно <w>вытравить</w> больше каната, чтобы якорь держался крепко.",
                                "de": "Sie müssen mehr Kette <w>fieren</w>, damit der Anker sicher hält."
                            }
                        }
                    ],
                    "common_phrases": [
                        "veer out"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "nautical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Травить или выпускать канат или шкот; давать тросу свободно выходить.",
                        "de": "Ein Seil oder eine Leine ausgeben; ein Tau locker lassen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "травить",
                                "target_lang_sense_clarification": "выпускать трос или канат"
                            },
                            {
                                "target_lang_word": "вытравливать",
                                "target_lang_sense_clarification": "постепенно отпускать канат"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "fieren",
                                "target_lang_sense_clarification": "nautischer Fachbegriff für das Ausgeben von Tauwerk"
                            },
                            {
                                "target_lang_word": "ausrauschen lassen",
                                "target_lang_sense_clarification": "ein Seil schnell freigeben"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2481f708-e832-3b02-b872-379a538e83bd",
                    "sense_definition": "A sudden turn or swerve; an instance of changing direction.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "change of direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot made a sudden <w>veer</w> to avoid the flock of birds.",
                            "target_lang_translations": {
                                "ru": "Пилот совершил резкий <w>поворот</w>, чтобы избежать столкновения со стаей птиц.",
                                "de": "Der Pilot machte einen plötzlichen <w>Richtungswechsel</w>, um dem Vogelschwarm auszuweichen."
                            }
                        },
                        {
                            "text": "A sharp <w>veer</w> in the wind direction indicated that the weather was changing.",
                            "target_lang_translations": {
                                "ru": "Резкое <w>изменение</w> направления ветра указывало на то, что погода меняется.",
                                "de": "Ein scharfer <w>Schwenk</w> in der Windrichtung deutete darauf hin, dass sich das Wetter änderte."
                            }
                        }
                    ],
                    "synonyms": [
                        "turn",
                        "swerve",
                        "shift"
                    ],
                    "common_phrases": [
                        "sudden veer"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапный поворот или отклонение; случай изменения направления.",
                        "de": "Ein plötzlicher Richtungswechsel oder ein Schwenk."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поворот",
                                "target_lang_sense_clarification": "резкое изменение направления"
                            },
                            {
                                "target_lang_word": "отклонение",
                                "target_lang_sense_clarification": "от заданного курса"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Richtungswechsel",
                                "target_lang_sense_clarification": "allgemeine Änderung der Richtung"
                            },
                            {
                                "target_lang_word": "Schwenk",
                                "target_lang_sense_clarification": "plötzliche Drehbewegung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a425f64-57a2-37c0-af56-31395dd81065",
                    "sense_definition": "A piglet or a heifer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "animals",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some local parishes, the farmers still refer to a young heifer as a <w>veer</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых местных приходах фермеры до сих пор называют молодую телку <w>вир</w>.",
                                "de": "In einigen lokalen Gemeinden bezeichnen die Bauern eine junge Färse immer noch als <w>Veer</w>."
                            }
                        },
                        {
                            "text": "The old man complained about the <w>veer</w> eating up all his fresh grass.",
                            "target_lang_translations": {
                                "ru": "Старик жаловался, что этот <w>поросенок</w> съедает всю его свежую траву.",
                                "de": "Der alte Mann beschwerte sich darüber, dass das <w>Ferkel</w> sein ganzes frisches Gras auffraß."
                            }
                        }
                    ],
                    "synonyms": [
                        "piglet",
                        "heifer"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "West Country English"
                        },
                        {
                            "trait_type": "dialectal",
                            "comment": "used in specific parishes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Поросенок или молодая корова (телка).",
                        "de": "Ein Ferkel oder eine junge Kuh (Färse)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поросенок",
                                "target_lang_sense_clarification": "диалектное значение"
                            },
                            {
                                "target_lang_word": "телка",
                                "target_lang_sense_clarification": "молодая корова"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ferkel",
                                "target_lang_sense_clarification": "junges Schwein"
                            },
                            {
                                "target_lang_word": "Färse",
                                "target_lang_sense_clarification": "junges weibliches Rind"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}