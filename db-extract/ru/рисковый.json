                "senses": [
                    {
                        "sense_id": "2b7eebe3-5e34-3c55-bc30-33aebb5ae49b",
                        "entry_id": "ddb56ba7-e3ae-369c-ba15-e9960a78a59c",
                        "glosses": [
                            "разг. содержащий в себе риск, сопряжённый с опасностью; рискованный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f07dfac-a78a-4c49-af69-83de9a52520a",
                                "sense_id": "2b7eebe3-5e34-3c55-bc30-33aebb5ae49b",
                                "text": "Горные лыжи ― самый рисковый и красивый вид олимпийской программы."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3dbebe8-7734-3e7e-b354-4d633f0bd38e",
                        "entry_id": "ddb56ba7-e3ae-369c-ba15-e9960a78a59c",
                        "glosses": [
                            "разг. смело идущий на риск, способный рисковать (о человеке)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a619d11-a824-4f81-867a-bf569061551d",
                                "sense_id": "f3dbebe8-7734-3e7e-b354-4d633f0bd38e",
                                "text": "― А что, если он попросту рисковый игрок?"
                            }
                        ]
                    },
                    {
                        "sense_id": "5b60bec9-5108-3100-957f-ca3fd5e5babf",
                        "entry_id": "ddb56ba7-e3ae-369c-ba15-e9960a78a59c",
                        "glosses": [
                            "спец. предусматривающий риск, возможные убытки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f5f7b69-c18c-49a1-8b9c-059c13cbd6da",
                                "sense_id": "5b60bec9-5108-3100-957f-ca3fd5e5babf",
                                "text": "По рисковым видам страхования выплаты составляют 6-40 % в зависимости от вида."
                            }
                        ]
                    }
