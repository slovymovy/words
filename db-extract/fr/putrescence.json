                        "glosses": [
                            "État de ce qui est putrescent, de ce qui se décompose et pourrit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "304572d2-b835-491e-a3ae-4c02f07bfdca",
                                "sense_id": "90ba79d3-d093-33c6-b8e8-edc956e1074c",
                                "text": "Lors de l’autopsie, à l’ouverture, on trouve un épanchement de sérosités très âcres dans le thorax et l’abdomen, tous les viscères livides et dans un état de putrescence avancée."
                            },
                            {
                                "example_id": "2ca75de8-e532-4c4f-adb9-5e5f2677a028",
                                "sense_id": "90ba79d3-d093-33c6-b8e8-edc956e1074c",
                                "text": "Des frissons secouaient ses membres décharnés et faisaient pour un instant lever l’essaim de mouches collé à sa plaie en putrescence."
                            }
                        ]
                    }
                ],
