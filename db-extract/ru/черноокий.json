                ],
                "senses": [
                    {
                        "sense_id": "678195d3-588c-3302-8609-c75a93f6f698",
                        "entry_id": "2ea0cfb0-3431-3e44-a98c-9063574a61b1",
                        "glosses": [
                            "поэт. имеющий очи тёмно-карего цвета"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73db037e-5966-48e4-b283-739debf3471a",
                                "sense_id": "678195d3-588c-3302-8609-c75a93f6f698",
                                "text": "По кровлям, как тени, пляшут армянки черноокие под звуки бубнов"
                            },
                            {
                                "example_id": "549f8fd1-b3f9-4b21-a842-1ed1822b3578",
                                "sense_id": "678195d3-588c-3302-8609-c75a93f6f698",
                                "text": "Он поставил ее карточку на видное место и подолгу любовался милыми чертами своей смуглой, черноокой красавицы."
                            }
                        ]
                    },
                    {
                        "sense_id": "953e0284-e64e-35b7-a8c0-819b040153f9",
                        "entry_id": "2ea0cfb0-3431-3e44-a98c-9063574a61b1",
                        "glosses": [
                            "субстантивир., поэт. тот, у кого тёмно-карие очи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5250d0ce-50a4-4852-a87e-134e826c0d0a",
                                "sense_id": "953e0284-e64e-35b7-a8c0-819b040153f9",
                                "text": "Черноокая далеко // В пышном тереме своем"
                            },
                            {
                                "example_id": "7aa0aa5c-c5fb-4d51-8621-5e972970d49a",
                                "sense_id": "953e0284-e64e-35b7-a8c0-819b040153f9",
                                "text": "Полюби меня, черноокая! Ты звезда души беззакатная!"
                            }
                        ]
                    }
                ],
