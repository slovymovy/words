                ],
                "senses": [
                    {
                        "sense_id": "3bb71ead-dae4-3beb-a450-f6a2e2d0f6d9",
                        "entry_id": "1eb98e0a-631f-398d-86ab-c2031d6d834d",
                        "glosses": [
                            "Apporter la rédemption à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b592067-20bf-4cac-ab41-e08c09e18fbb",
                                "sense_id": "3bb71ead-dae4-3beb-a450-f6a2e2d0f6d9",
                                "text": "En mourant sur la croix, au Golgotha, le Christ s’est uni à la terre qu’il a fécondée de son sang ; et c’est ce sang qui doit rédempter l’humanité."
                            },
                            {
                                "example_id": "c3f4db91-d3ac-4953-bfcd-795eb76cc1e1",
                                "sense_id": "3bb71ead-dae4-3beb-a450-f6a2e2d0f6d9",
                                "text": "[…] mais ils ne purent échapper à cette loi qui veut que les philosophes les rédemptent par une charitable affection."
                            }
                        ]
                    },
                    {
                        "sense_id": "005de269-360d-39c1-b6e3-ed0f6e129119",
                        "entry_id": "1eb98e0a-631f-398d-86ab-c2031d6d834d",
                        "glosses": [
                            "Obtenir rédemption, se racheter."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "06f41fea-b0d3-4395-b3d3-38892523e33f",
                                "sense_id": "005de269-360d-39c1-b6e3-ed0f6e129119",
                                "text": "Les Chevaliers de la Mort le sont généralement devenu par choix, même s'ils disent vouloir se rédempter maintenant."
                            }
                        ]
                    }
                ],
