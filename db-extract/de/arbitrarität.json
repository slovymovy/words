                "senses": [
                    {
                        "sense_id": "215b969a-4673-3b2f-b211-e40ea756ba52",
                        "entry_id": "7cbf4af1-9c11-3446-b4c3-385c9f42ae9b",
                        "glosses": [
                            "Willkürlichkeit im Verhältnis zwischen den beiden Seiten eines sprachlichen Zeichens: man kann von der Form des Zeichens (signifiant) nicht auf seine Bedeutung (signifié) schließen."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b94b014c-071a-433c-80e4-5e73c10fbbe4",
                                "sense_id": "215b969a-4673-3b2f-b211-e40ea756ba52",
                                "text": "Zwischen der Form eines Zeichens und seiner Bedeutung herrscht oft Arbitrarität; die Form des Wortes \"Tisch\" z.B. sagt nichts über die Bedeutung des Wortes aus. Anders bei Wörtern wie \"Kuckuck\": hier lässt die Lautform des Wortes auf das gemeinte Tier schließen."
                            },
                            {
                                "example_id": "3915bb8b-6892-492b-a239-afc26e310da0",
                                "sense_id": "215b969a-4673-3b2f-b211-e40ea756ba52",
                                "text": "„Innerhalb eines Sprachsystems wird aber diese grundsätzliche Willkürlichkeit (Arbitrarität) des Verhältnisses von Ausdrucks- und Inhaltsseite beschränkt durch die (stillschweigende) Übereinkunft (Konvention) der Sprecher, bestimmte Ausdrucksseiten mit bestimmten Inhalten zu verbinden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
