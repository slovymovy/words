                "senses": [
                    {
                        "sense_id": "cd22068f-e981-39dc-a5d1-b571de99ba03",
                        "entry_id": "08b4e354-dbc8-3e2e-8a26-c688516729f0",
                        "glosses": [
                            "egal, einerlei, gleichgültig"
                        ],
                        "tags": [
                            "oft mit nachfolgendem Interrogativpronomen",
                            "das einen Gliedsatz einleitet"
                        ],
                        "examples": [
                            {
                                "example_id": "e265aebf-7f38-4032-81fc-f4d930a5450b",
                                "sense_id": "cd22068f-e981-39dc-a5d1-b571de99ba03",
                                "text": "Gleichviel wer mit mir kommt, ich werde nach Warschau reisen."
                            },
                            {
                                "example_id": "1f02bd08-ee43-4f0a-91cd-4d87b9d15b63",
                                "sense_id": "cd22068f-e981-39dc-a5d1-b571de99ba03",
                                "text": "Es muss nun eine Entscheidung getroffen werden, gleichviel von wem."
                            },
                            {
                                "example_id": "5e99a22a-b636-4e28-b70d-b264d9a41899",
                                "sense_id": "cd22068f-e981-39dc-a5d1-b571de99ba03",
                                "text": "Wir müssen noch für die Gäste einkaufen gehen, gleichviel ob nun zwei oder drei Personen erscheinen."
                            },
                            {
                                "example_id": "1e08daba-5c76-4b29-9df7-4c278a800620",
                                "sense_id": "cd22068f-e981-39dc-a5d1-b571de99ba03",
                                "text": "Die Feuerwehr braucht neue Einsatzkräfte, gleichviel ob Männer oder Frauen."
                            },
                            {
                                "example_id": "b4f08015-3266-417c-85b4-1a20cf2efd17",
                                "sense_id": "cd22068f-e981-39dc-a5d1-b571de99ba03",
                                "text": "Melde dich bei mir, gleichviel zu welcher Zeit."
                            },
                            {
                                "example_id": "f27dee34-3ec4-4d54-a008-4aa4d0c39ff8",
                                "sense_id": "cd22068f-e981-39dc-a5d1-b571de99ba03",
                                "text": "Ich möchte Nathalie das Collier schenken, gleichviel was es kostet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
