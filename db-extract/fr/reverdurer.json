                "senses": [
                    {
                        "sense_id": "8fda6c07-3c2d-3829-a69b-83fdf3ec0f95",
                        "entry_id": "31a1adc0-4270-3bbf-9936-ff351ac12949",
                        "glosses": [
                            "Verdurer à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a71b968e-a013-4ca8-a5e5-001cdbcde080",
                                "sense_id": "8fda6c07-3c2d-3829-a69b-83fdf3ec0f95",
                                "text": "Il faut par exemple reverdurer les berges, consolider les ruines, sécuriser les voiries, trouver un dispositif pour épurer les eaux des égouts venant de Buzenol."
                            },
                            {
                                "example_id": "eecf1f3f-1c34-4039-8840-064ec284c079",
                                "sense_id": "8fda6c07-3c2d-3829-a69b-83fdf3ec0f95",
                                "text": "C’est TELLEMENT une bonne idée que de reverdurer notre monde, que dis-je notre UNIVERS."
                            },
                            {
                                "example_id": "54fe8471-7925-4582-aa4f-8abe92780971",
                                "sense_id": "8fda6c07-3c2d-3829-a69b-83fdf3ec0f95",
                                "text": "Il faut alors reverdurer ou reminéraliser la place différemment et on ne laisse pas d'accès aux voitures !"
                            }
                        ]
                    }
