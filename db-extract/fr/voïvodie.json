                                        "examples": [
                                            {
                                                "example_id": "b18630f1-ad7b-4bd3-a593-aeaf31e9642d",
                                                "sense_id": "9e8c6a71-5545-3c36-a590-8115fa659395",
                                                "text": "Wzorem polskim wprowadzono na Litwie właściwej podział administracyjny, ustanawiając dwa województwa – wileńskie i trockie – oraz dwie takie same kasztelanie."
                                            },
                                            {
                                                "example_id": "e3c70330-241b-4531-b06d-09337c145a21",
                                                "sense_id": "9e8c6a71-5545-3c36-a590-8115fa659395",
                                                "text": "Jak co roku jeleniogórzanie zebrali się na Placu Ratuszowym, by pożegnać stary rok, tym razem pożegnali również województwo."
                                            },
                                            {
                                                "example_id": "1e40f8f4-c553-4e3e-9d27-06fb6102c3be",
                                                "sense_id": "9e8c6a71-5545-3c36-a590-8115fa659395",
                                                "text": "Aktualnie w Polsce jest 16 (= szesnaście) województw."
                                            }
