                                        "sense_id": "9ac6a6fd-77e7-37cd-aec6-6d09d22038f8",
                                        "entry_id": "e6058131-c9bc-326e-865e-e86c00ae9871",
                                        "glosses": [
                                            "also; moreover; too."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16e71ec2-34d5-4e30-96b6-db38af43a97e",
                                                "sense_id": "9ac6a6fd-77e7-37cd-aec6-6d09d22038f8",
                                                "text": "Margaret enjoys playing tennis on Saturdays, Jeremy likewise."
                                            },
                                            {
                                                "example_id": "8366428b-5231-40e9-83bd-aae488beecde",
                                                "sense_id": "9ac6a6fd-77e7-37cd-aec6-6d09d22038f8",
                                                "text": "\"But it looks like the kid ain't got no appetite to git well, for they misses him from the tent in the night and finds him rootin' in the grass, and likewise a drizzle fallin'. 'G'wan,' he says, 'lemme go and die like I wanter. He said I was a liar and a fake'—McGuire says—'and I was playin' sick. Lemme alone.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe1a8389-0f57-3dab-94b5-71653cecbb42",
                                        "entry_id": "e6058131-c9bc-326e-865e-e86c00ae9871",
                                        "glosses": [
                                            "The same to you; used as a response."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bea8a1bd-e0d4-4cda-a765-b8c46b964f73",
                                                "sense_id": "fe1a8389-0f57-3dab-94b5-71653cecbb42",
                                                "text": "It was very nice meeting you, Samantha. ― Likewise, Mr Thompson."
                                            },
                                            {
                                                "example_id": "53e8df2d-164c-42ac-887e-e52b56f16d60",
                                                "sense_id": "fe1a8389-0f57-3dab-94b5-71653cecbb42",
                                                "text": "‘Let me know if you need any help.’ ‘Likewise.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
