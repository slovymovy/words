                        "examples": [
                            {
                                "example_id": "91cd827b-2aa5-4b20-a5e1-6f43bdc58e01",
                                "sense_id": "34a1e46f-b258-3175-b10d-4a9c0f9e94af",
                                "text": "Ta płyta była w moim środowisku tak niezbędnym atrybutem dojrzewania jak trądzik i masturbacja."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
