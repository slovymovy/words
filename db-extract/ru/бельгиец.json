                    {
                        "translation_id": "d261a69b-3133-43d9-819d-c4263c1f0ccf",
                        "source_entry_id": "d2b98f84-5467-31cf-ad00-f4564afef738",
                        "source_sense_id": "78e1b941-e06e-37b9-b7cb-5d4391ea8f33",
                        "target_lang_word": "Belgier",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belgier",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bbfb470-f3d9-3705-b28e-5a0d1b531c35",
                                        "entry_id": "8486b0ee-2f38-376d-abca-bf783e3ef017",
                                        "glosses": [
                                            "Staatsbürger von Belgien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9489f5e-1cdb-4fa5-b1cb-c82dbe72e79f",
                                                "sense_id": "4bbfb470-f3d9-3705-b28e-5a0d1b531c35",
                                                "text": "„Der Belgier hat zu Hause eine Ausbildung als Gartenbauer und Forstwirt mit Abitur abgelegt sowie Fertigkeiten als Hufschmied erworben.“"
                                            },
                                            {
                                                "example_id": "601a7fed-d611-468c-a748-df1bbbd72851",
                                                "sense_id": "4bbfb470-f3d9-3705-b28e-5a0d1b531c35",
                                                "text": "„Mit einer Solofahrt über die letzten 15 Kilometer hat der Belgier Tom Boonen zum dritten Mal den Pavés-Klassiker Paris-Roubaix gewonnen.“"
                                            },
                                            {
                                                "example_id": "cad6601b-401e-41f9-87ea-b7215166bc88",
                                                "sense_id": "4bbfb470-f3d9-3705-b28e-5a0d1b531c35",
                                                "text": "„Der Österreicher Arnold Schönberg komponierte 1911 sein atonales Melodram für eine weibliche Sprechstimme und fünf Musiker, basierend auf dem gleichnamigen Gedichtzyklus des Belgiers Albert Giraud über die Figur des tragischen Clowns.“"
                                            },
                                            {
                                                "example_id": "0fa69ff0-5315-4ea0-a394-306fd8bf0f2c",
                                                "sense_id": "4bbfb470-f3d9-3705-b28e-5a0d1b531c35",
                                                "text": "„Diese Gewißheit nahmen wir Deutschen mit nach Hause, zugleich die schöne Erfahrung, daß es unter der in Straßburg versammelten Jugend, unter all den Franzosen, Engländern, Belgiern, Holländern, Schweizern, keine Aversion gegen uns junge Deutsche gab, es gab nur eine echte Kameradschaft.“"
                                            },
                                            {
                                                "example_id": "46c494b1-7cfe-4b4f-9ba1-aab418b51c00",
                                                "sense_id": "4bbfb470-f3d9-3705-b28e-5a0d1b531c35",
                                                "text": "„1945 erboxte sich Cerdan den verwaisten Titel eines Europameisters durch einen Blitzsieg über den Belgier Fouquet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3e67f9f0-9b1b-3877-a4d9-7755df0ba6e5",
                                        "entry_id": "8486b0ee-2f38-376d-abca-bf783e3ef017",
                                        "glosses": [
                                            "Belgisches Kaltblut, eine Pferderasse"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "215affb0-3440-4ad0-bc84-a01bf1b4d142",
                                                "sense_id": "3e67f9f0-9b1b-3877-a4d9-7755df0ba6e5",
                                                "text": "„Der Belgier gehört zu den ältesten bekannten Rassen. Seine Ursprünge führen auf einen schweren, beweglichen Pferdetyp der Römerzeit zurück.“"
                                            },
                                            {
                                                "example_id": "381f200c-0b81-4db6-9dc5-03a85d71cbf8",
                                                "sense_id": "3e67f9f0-9b1b-3877-a4d9-7755df0ba6e5",
                                                "text": "Sally und Ewald bewirtschaften ihr Waldstück noch mit zwei Belgiern als Rückepferden."
                                            },
                                            {
                                                "example_id": "1f93d199-a229-4f45-b9a0-9f9a91ac115f",
                                                "sense_id": "3e67f9f0-9b1b-3877-a4d9-7755df0ba6e5",
                                                "text": "Herrn Möbius machte die Trakehnerzucht vor einigen Jahren keine rechte Freude mehr. Deshalb ist er auf Belgier umgestiegen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be8da850-7293-4c3f-95c1-a61f310ccd31",
                        "source_entry_id": "d2b98f84-5467-31cf-ad00-f4564afef738",
                        "source_sense_id": "78e1b941-e06e-37b9-b7cb-5d4391ea8f33",
                        "target_lang_word": "Belg",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belg",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "406974f8-8844-3a4b-bf9e-828c71065561",
                                        "entry_id": "d7c31259-02c0-38fc-a905-84278a6213f4",
                                        "glosses": [
                                            "een staatsburger van België"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8125eec-dca3-4dcd-a606-3cfa6ccba15b",
                                                "sense_id": "406974f8-8844-3a4b-bf9e-828c71065561",
                                                "text": "De Belgische overheid begint dit najaar een nieuwe vaccinatiecampagne tegen COVID-19. Alle volwassen Belgen kunnen als ze dat willen een tweede boosterprik tegen het virus krijgen, hebben de Belgische ministers van Volksgezondheid besloten. Wel zijn eerst de risicogroepen en het zorgpersoneel aan de beurt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9aab3e2-e616-4592-aad5-5d828ff42276",
                        "source_entry_id": "d2b98f84-5467-31cf-ad00-f4564afef738",
                        "source_sense_id": "78e1b941-e06e-37b9-b7cb-5d4391ea8f33",
                        "target_lang_word": "Belg",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belg",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "71754df3-f51a-32a3-b651-8ffcb2a6fb3b",
                                        "entry_id": "3485fbaf-d799-3103-8f78-4d5ef005491e",
                                        "glosses": [
                                            "obywatel Belgii"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d36e4967-ea4a-487a-83ff-c1c4bd50a2df",
                                                "sense_id": "71754df3-f51a-32a3-b651-8ffcb2a6fb3b",
                                                "text": "Coraz mniej liczni obywatele Belgii uważają się za Belgów."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c662a207-06a6-48da-8470-3152caf89269",
                        "source_entry_id": "d2b98f84-5467-31cf-ad00-f4564afef738",
                        "source_sense_id": "78e1b941-e06e-37b9-b7cb-5d4391ea8f33",
                        "target_lang_word": "Belge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Belge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c42c8b-fdb4-36e4-a7bd-762c0aa7c45f",
                                        "entry_id": "a1789181-45c2-339a-a0b7-2f942ef0b389",
                                        "glosses": [
                                            "Habitant ou habitante de la Gaule belgique."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "141d46c2-aced-4e38-bbe6-026fd3d42238",
                                                "sense_id": "c6c42c8b-fdb4-36e4-a7bd-762c0aa7c45f",
                                                "text": "Les Belges tenaient un rang très-distingué parmi les Gaulois, dont la puissance était alors très étendue. Ceux-ci remplissaient tout le monde connu du fracas de leurs armes ; leurs bandes aventureuses étaient partout."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "62f90ec6-921f-388d-b988-3248c7f88a58",
                                        "entry_id": "a1789181-45c2-339a-a0b7-2f942ef0b389",
                                        "glosses": [
                                            "Personne qui habite la Belgique ou en est originaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97dd3996-fc87-467c-9612-53fad8c291ef",
                                                "sense_id": "62f90ec6-921f-388d-b988-3248c7f88a58",
                                                "text": "Le Belge, autant que j’en ai pu juger en deux ans et demi de séjour à Bruxelles, n’aime ni les idées toutes faites, ni les attitudes convenues, ni les énumérations de vérités premières. Wallon ou Flamand, il tient à penser par lui-même et il rejette l’opinion imposée. J’ajoute que c’est là sa grande force et son grand attrait."
                                            },
                                            {
                                                "example_id": "56e0b068-edcc-4e2f-8da9-84d332ed0fa3",
                                                "sense_id": "62f90ec6-921f-388d-b988-3248c7f88a58",
                                                "text": "Il affirme ainsi sa puissance, un peu par défi contre ceux de Vencimont ou de Vinemme, des Belges qui viennent se vanter en France de leurs forces pour enjôler les filles."
                                            },
                                            {
                                                "example_id": "99917bca-e5ad-4916-84b9-27940b2aef77",
                                                "sense_id": "62f90ec6-921f-388d-b988-3248c7f88a58",
                                                "text": "Dans une lettre à Louis-Philippe, son beau-père, il écrit les mots suivants : « Les seuls véritables Belges de cœur et d'âme sont nos bons catholiques, le reste est un salami de cosmopolites \"fit for nothing\"; eux peuvent donc exprimer leur allégresse au grand Opéra par des jeux et des danses […]."
                                            },
                                            {
                                                "example_id": "c0210f43-609e-472c-b295-8d7e22726be3",
                                                "sense_id": "62f90ec6-921f-388d-b988-3248c7f88a58",
                                                "text": "Il y avait presque autant de Belgique que de Belges, à tout moins autant d’États que de villages, et de législations que de franchises."
                                            },
                                            {
                                                "example_id": "2c30fa04-230f-463c-8903-5b0157b79f57",
                                                "sense_id": "62f90ec6-921f-388d-b988-3248c7f88a58",
                                                "text": "Moi je voudrais un Belge sur la lune pour y planter nos belles couleurs."
                                            },
                                            {
                                                "example_id": "e7e5bff6-7e11-4ba1-b899-5a926cbdea40",
                                                "sense_id": "62f90ec6-921f-388d-b988-3248c7f88a58",
                                                "text": "Être ou connaître un Belge, aller à Bruxelles ou à Gand en Thalys, s’y retrouver dans nos bières d’abbaye, fait dorénavant partie des musts. Même l’humour, sur les ondes des radios françaises, est aux mains des Belges."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34942d01-34ac-377b-868b-ae5dd482bda0",
                                        "entry_id": "a1789181-45c2-339a-a0b7-2f942ef0b389",
                                        "glosses": [
                                            "Personne à l’accent caractéristique, naïve et stupide."
                                        ],
                                        "tags": [
                                            "Stéréotype"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2736928b-a9da-4ddd-b0df-2f9110ad24de",
                                                "sense_id": "34942d01-34ac-377b-868b-ae5dd482bda0",
                                                "text": "Les blagues belges sont basées sur le principe que celui qui énonce et celui qui écoute la blague savent que « Belge » signifie à peu de chose près « imbécile ». Les « histoires belges » sont donc apparentées aux « histoires de fous »."
                                            }
                                        ]
                                    }
                                ]
                            },
