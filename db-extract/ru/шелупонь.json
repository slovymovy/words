                    {
                        "translation_id": "0d2d34d8-1c4d-49e8-91e8-3d9068602d52",
                        "source_entry_id": "c33167fa-ae62-34c4-b36d-f5920521fc69",
                        "source_sense_description": "незначительные люди",
                        "target_lang_word": "Gesindel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gesindel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fb4f4d64-e955-3133-b853-5635b5abbdef",
                                        "entry_id": "8bb3f28f-0690-3d40-aadd-c5e4a6f374ea",
                                        "glosses": [
                                            "heruntergekommene, kriminelle Menschen"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3520e26-44c7-487c-8ff6-adeedf61931a",
                                                "sense_id": "fb4f4d64-e955-3133-b853-5635b5abbdef",
                                                "text": "Überall spürte man nach den Brennern, überall sah man ihre Spuren, viele Haufen Gesindel wurden gefangen, peinlich verhört und gerichtet. (Gustav Freytag, Bilder aus der deutschen Vergangenheit, Kapitel 26, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "83830152-5d09-40d1-803f-33aab75df4de",
                                                "sense_id": "fb4f4d64-e955-3133-b853-5635b5abbdef",
                                                "text": "Damals war gar viel herrenloses Gesindel im Lande, das unstet lebte und so gut als möglich vom Raube. (Jeremias Gotthelf, Kurt von Koppigen, z.n. Projekt Gutenberg)"
                                            },
                                            {
                                                "example_id": "03640a45-b719-4eb0-8f24-22c63601edfd",
                                                "sense_id": "fb4f4d64-e955-3133-b853-5635b5abbdef",
                                                "text": "„Martin bekam die Erlaubnis, das Gotteshaus zu betreten, doch sollte er eine Waffe mitnehmen, um sich zu schützen, denn es lagerte dort allerlei Gesindel.“"
                                            },
                                            {
                                                "example_id": "7bd53cab-30a1-4c56-a79e-f90da842dd83",
                                                "sense_id": "fb4f4d64-e955-3133-b853-5635b5abbdef",
                                                "text": "„Nach diesem Auftritt wagte das Gesindel im Saal nicht mehr, mich anzublicken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "70e76361-f47d-4326-b639-e8632005a5e4",
                        "source_entry_id": "c33167fa-ae62-34c4-b36d-f5920521fc69",
                        "source_sense_description": "незначительные люди",
                        "target_lang_word": "canaille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "canaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b556c6ed-9370-3c2b-82a8-75906d09d9ca",
                                        "entry_id": "48cb92a1-206b-35b5-b566-035b00d9dd55",
                                        "glosses": [
                                            "Vile populace."
                                        ],
                                        "tags": [
                                            "collective",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c77f3b0-0c8f-4fbe-9c09-6fc188645375",
                                                "sense_id": "b556c6ed-9370-3c2b-82a8-75906d09d9ca",
                                                "text": "Le Philosophe Dumarsais, […] , donnait à un jeune Seigneur des leçons de Grammaire Française. Celui-ci n'entendant pas toute la fine Métaphysique de son Maître, s'impatiente & prononce avec une espèce de courroux: « Fichtre, je n'en viendrai jamais à bout ». Du Marsais lui répond du ton le plus phlegmatique: « Monsieur, ce mot n'est pas Français : on dit F .. mais il n'y a que la Canaille qui s'en sert »."
                                            },
                                            {
                                                "example_id": "4dbbc5c8-a03e-43ec-a6a3-c1763193276d",
                                                "sense_id": "b556c6ed-9370-3c2b-82a8-75906d09d9ca",
                                                "text": "J’aurai aussi à vous parler du caractère singulier du peuple de ce pays. La canaille est ici intelligente, spirituelle, remplie d’imagination, et les classes élevées me paraissent au-dessous des habitués d’estaminet et de roulette de Paris."
                                            },
                                            {
                                                "example_id": "2b179745-938d-45e5-bdd6-c9f1ebcd24ab",
                                                "sense_id": "b556c6ed-9370-3c2b-82a8-75906d09d9ca",
                                                "text": "Je vois dans le naturalisme un synchronisme du suffrage universel, et le protagonisme antiesthétique de la canaille : l’écrivain fait sa cour à la rue, comme jadis au roi."
                                            },
                                            {
                                                "example_id": "8e2c0288-b5d9-499f-96d3-5a58a0268407",
                                                "sense_id": "b556c6ed-9370-3c2b-82a8-75906d09d9ca",
                                                "text": "C’est une des joies de la canaille que de voir un homme de quelque valeur réduit à partager son sort. Elle s’acharnera à lui maintenir la tête dans le purin où elle barbote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4e3d4a7-f959-3a77-bf01-c0ecb7d53ec9",
                                        "entry_id": "48cb92a1-206b-35b5-b566-035b00d9dd55",
                                        "glosses": [
                                            "Gens de toutes conditions auxquels on veut témoigner du mépris."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "note": "Dans ce cas il peut s’appliquer à une seule personne",
                                        "examples": [
                                            {
                                                "example_id": "5e4fd789-0602-46cc-9fa3-cedfb4d6ec51",
                                                "sense_id": "d4e3d4a7-f959-3a77-bf01-c0ecb7d53ec9",
                                                "text": "Il s’est conduit comme une vile canaille."
                                            },
                                            {
                                                "example_id": "79b3b65a-a62b-413d-b7e7-1d1bbffc1a08",
                                                "sense_id": "d4e3d4a7-f959-3a77-bf01-c0ecb7d53ec9",
                                                "text": "Vous n’êtes qu’une canaille."
                                            },
                                            {
                                                "example_id": "e22b5a46-edd3-44ea-a0f9-6ce6c0669270",
                                                "sense_id": "d4e3d4a7-f959-3a77-bf01-c0ecb7d53ec9",
                                                "text": "Ces canailles de domestiques me laissent toujours seul."
                                            },
                                            {
                                                "example_id": "d4735143-61d7-4f37-b2b8-8667b27aefb6",
                                                "sense_id": "d4e3d4a7-f959-3a77-bf01-c0ecb7d53ec9",
                                                "text": "Et j’y allais d’autant plus de bon cœur à l’appeler canaille, ce pauvre M. Guizot, que, dans ma tête, je le confondais avec un grand coquin de sergent de ville qui se tenait au coin de la rue de l’Orillon et me faisait toujours des misères, par rapport à ma charrette de copeaux…"
                                            },
                                            {
                                                "example_id": "4c94db42-4f7d-40b3-9dd6-e5a6ef6cb792",
                                                "sense_id": "d4e3d4a7-f959-3a77-bf01-c0ecb7d53ec9",
                                                "text": "Elle se campa devant son homme et lui rugit à la face :\n— Brigand, canaille, gouilland, voleur, soulaud ! Tout le répertoire y passa."
                                            },
                                            {
                                                "example_id": "213704b0-a710-4f73-9273-a6e02f41d427",
                                                "sense_id": "d4e3d4a7-f959-3a77-bf01-c0ecb7d53ec9",
                                                "text": "On te mettra dans une tombe, vieille canaille,\n Et moi j’irai faire la bombe, vieille canaille,\n À coup de petits verres d’eau de vie, la plus belle cuite de ma vie,\nSera pour tes funérailles, vieille canaille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcf084d3-456e-3c48-90df-1a544bdb4100",
                                        "entry_id": "48cb92a1-206b-35b5-b566-035b00d9dd55",
                                        "glosses": [
                                            "Enfant turbulent, remuant."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5913447b-07da-423e-9e34-34fddba52f06",
                                                "sense_id": "dcf084d3-456e-3c48-90df-1a544bdb4100",
                                                "text": "Ces petites canailles m’en font voir de toutes les couleurs"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "canaille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                                        "entry_id": "14b640a8-2c5e-3225-978b-a852c39f165e",
                                        "glosses": [
                                            "Populacier, vulgaire, polisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a2ffb1-2853-4c5b-8450-01113a44cdf4",
                                                "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                                                "text": "— Plus un état est canaille, plus il y faut de probité, dit sentencieusement Fromenteau, je suis à celui qui me paye le plus."
                                            },
                                            {
                                                "example_id": "01af8f3f-6ded-4b01-b297-e94fc0b9740b",
                                                "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                                                "text": "Il fumait par petites aspirations comme un enfant qui craint de se brûler, puis il tenait ça en essayant des airs canailles."
                                            },
                                            {
                                                "example_id": "3dc8d826-231e-44fa-84b7-72632074bee5",
                                                "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                                                "text": "Pontagnac. — (À part.) C’est un peu canaille ce que j’ai fait là,… mais bah ! j’ai une excuse, c’est pour avoir sa femme."
                                            },
                                            {
                                                "example_id": "1e50f2ef-12b8-4806-a3e3-d3f2f2f2dec6",
                                                "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                                                "text": "On se partageait des surprises où il y avait des bonbons, des devises, et des chapeaux de papier fin aux formes bizarres ; mitres d’évêques, bicornes de gendarmes et casques de pompiers. Les demoiselles de la compagnie les piquaient sur leurs coiffures, et cela leur donnait un petit air canaille."
                                            },
                                            {
                                                "example_id": "95380bd4-a848-47b0-bf19-9516103fa70d",
                                                "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                                                "text": "On se serait cru chez un grand seigneur d’autrefois, n’eussent été l’allure vulgaire et les éclats de voix canailles qui attestent chez notre amphitryon un muflisme inégalable."
                                            },
                                            {
                                                "example_id": "80b6b3c6-bb94-4047-8087-022364c59d46",
                                                "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                                                "text": "Une commère dont la chemise très courte cachait mal les rondeurs, m’accueillit et, me poussant dans une pièce quasiment obscure, me confia d’un air canaille."
                                            },
                                            {
                                                "example_id": "e41ce8de-a40e-4f12-a4fa-eabfce4b7d3f",
                                                "sense_id": "4cf76493-3fb5-34b9-9ecb-1d41772c6e50",
                                                "text": "Elle agaçait les habitués, amateurs de servantes accortes, aux défensives un peu canailles, aux vives reparties."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
