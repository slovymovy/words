                    {
                        "sense_id": "01e238d6-379b-376f-9878-6c32cdddbbec",
                        "entry_id": "b558bcaa-857f-3d90-b84c-12762a7cb21e",
                        "glosses": [
                            "boonvormige bonbon gevuld met Jamaica Rum met een omhulsel van chocolade en suiker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6677cc2-d1df-47c0-be5f-a36cdecd8b9b",
                                "sense_id": "01e238d6-379b-376f-9878-6c32cdddbbec",
                                "text": "Ging het om mijn grootmoeder, zij kende inderdaad alleen Jamaica. Maar dat kwam doordat het een merk rumbonen was die zij zich op haar verjaardag bij voorkeur liet schenken."
                            },
                            {
                                "example_id": "3931932a-e768-434d-8a45-0f5c00b75649",
                                "sense_id": "01e238d6-379b-376f-9878-6c32cdddbbec",
                                "text": "\"Nou, ik was natuurlijk nog jong en woonde thuis, dus twee gulden ging naar mijn ouders en van de andere vijftig cent kocht ik rumbonen en pinda's. De pinda's waren voor m'n schoonouders. En ik bracht de zaterdagavond door met mijn meisje en de rumbonen.\""
                            }
                        ]
                    }
