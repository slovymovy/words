                                "target_senses": [
                                    {
                                        "sense_id": "abb5222a-7452-3104-b5c9-a9bb6d4da664",
                                        "entry_id": "8a1e79f5-07b5-3d6b-b504-25690e1b3477",
                                        "glosses": [
                                            "Partie législative du Talmud qui définit les règles de conduite civiles et religieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56543bd4-ae63-45a4-890c-1ec02240535b",
                                                "sense_id": "abb5222a-7452-3104-b5c9-a9bb6d4da664",
                                                "text": "Une autre manière de décrire la Aggada est de rappeler que le Talmud s’organise suivant deux axes : Aggada et Halakha. La Halakha s’occupe du juridique, des règles de vie civiles et religieuses, donc de tout ce qu’un individu doit savoir pour accorder sa démarche singulière à la vie en communauté. Et ce qui n’est pas Halakha dans le Talmud relève de l'univers de la Aggada."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d334982e-a488-3940-afbc-0821abbf2d63",
                                        "entry_id": "8a1e79f5-07b5-3d6b-b504-25690e1b3477",
                                        "glosses": [
                                            "Loi religieuse juive."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c47941bf-3cb2-4b63-89f6-eaf22dbb7ed6",
                        "source_entry_id": "18ff825a-f846-3651-8c85-45a681fc02ad",
                        "source_sense_id": "97b41e11-5f6c-347e-b2f0-3f28719a2326",
