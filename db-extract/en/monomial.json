                        "entry_id": "be566a80-c2ee-3717-892b-924fcae4c7d5",
                        "glosses": [
                            "A single term consisting of a product of numbers and variables with positive integer exponents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5a4bc3b-6741-40ad-9a90-9050ece9d06b",
                                "sense_id": "7a8fcdba-16d2-3c87-a0a6-4dafc1c9c002",
                                "text": "5x²y is a monomial"
                            }
                        ]
