                        "entry_id": "e026e29b-843e-3e48-b48b-009c28681049",
                        "glosses": [
                            "Processus de création d’un peuple ou d’une ethnie à partir d’un ou plusieurs peuples."
                        ],
                        "tags": [],
                        "examples": [
