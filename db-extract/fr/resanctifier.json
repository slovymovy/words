                "senses": [
                    {
                        "sense_id": "16ed3b76-6ea9-32d1-b919-857e34ebc652",
                        "entry_id": "514a615e-c100-3203-ab08-67290ce27749",
                        "glosses": [
                            "Sanctifier à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e65eccb-7398-42ff-9471-c3cc0d0fb989",
                                "sense_id": "16ed3b76-6ea9-32d1-b919-857e34ebc652",
                                "text": "Suffit-il de déshonorer la vertu bourgeoise pour resanctifier l'amour?"
                            },
                            {
                                "example_id": "a42da05b-da9f-4274-8c35-f2f7c8af58ad",
                                "sense_id": "16ed3b76-6ea9-32d1-b919-857e34ebc652",
                                "text": "Il s'agissait là, en quelque sorte, de resanctifier la Bible dont une lecture trop littérale eût paru altérer la sainteté."
                            },
                            {
                                "example_id": "6ca1d959-8eeb-49be-9e33-510cfc19ba35",
                                "sense_id": "16ed3b76-6ea9-32d1-b919-857e34ebc652",
                                "text": "Et le Saint-Esprit lui dit à son tour : « Je viens pour te sanctifier et te resanctifier."
                            }
                        ]
                    }
                ],
