                ],
                "senses": [
                    {
                        "sense_id": "e0e12593-e7c0-32cb-b6e7-f2c8f2e1549e",
                        "entry_id": "7838d4d0-d6ab-3b22-91cc-5f59462b61d8",
                        "glosses": [
                            "głębokie miejsce w otwartym zbiorniku wodnym"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "2e5ffab9-ee14-45f8-9b9c-2daa15f71d52",
                                "sense_id": "e0e12593-e7c0-32cb-b6e7-f2c8f2e1549e",
                                "text": "Za to, że zamyślili wymordować dzieci świętych - / kiedy to jedno Dziecię porzucone zostało i uratowane - / za karę zabrałeś im mnóstwo ich dzieci / i wygubiłeś ich razem w burzliwej topieli"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "43412fb9-0055-396c-b11f-e5cf6cead259",
                        "entry_id": "7838d4d0-d6ab-3b22-91cc-5f59462b61d8",
                        "glosses": [
                            "miejsce wzburzenia się wody"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "58c93075-3aee-4e7b-bded-2323b635c949",
                                "sense_id": "43412fb9-0055-396c-b11f-e5cf6cead259",
                                "text": "I jak fala morska zaleje wybrzeże, a cofając się zostawia na piasku porosty, małże i rozmaite szczątki pokruszone w topieli, tak każda z tych szwedzkich fal odpływając zostawiała po sobie trupy rozrzucone tu i ówdzie po pochyłości"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
