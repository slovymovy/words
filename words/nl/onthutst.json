    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3ae54035-a24d-3641-a839-b2e769790a0b",
                    "sense_definition": "in de war gebracht door schrik, verbazing of verontwaardiging; hevig van streek",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De burgemeester reageerde zichtbaar <w>onthutst</w> op het onverwachte nieuws.",
                            "target_lang_translations": {
                                "fr": "Le maire a réagi de manière visiblement <w>consternée</w> face à cette nouvelle inattendue."
                            }
                        },
                        {
                            "text": "Zij keken elkaar <w>onthutst</w> aan toen ze de schade aan het gebouw zagen.",
                            "target_lang_translations": {
                                "fr": "Ils se sont regardés, <w>déconcertés</w>, en voyant les dégâts subis par le bâtiment."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontzet"
                    ],
                    "common_phrases": [
                        "onthutst reageren",
                        "zich onthutst tonen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Déconcerté, troublé ou indigné par la peur, la surprise ou l'incompréhension ; consterné ou bouleversé"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "consterné",
                                "target_lang_sense_clarification": "abattu ou indigné par un événement facheux"
                            },
                            {
                                "target_lang_word": "déconcerté",
                                "target_lang_sense_clarification": "déstabilisé et surpris"
                            },
                            {
                                "target_lang_word": "ébahi",
                                "target_lang_sense_clarification": "frappé de stupeur ou d'étonnement"
                            },
                            {
                                "target_lang_word": "interdit",
                                "target_lang_sense_clarification": "resté sans voix sous le coup de la surprise"
                            }
                        ]
                    }
                }
            ]
        },
        {
