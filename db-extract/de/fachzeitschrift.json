                    {
                        "sense_id": "ef3ccdfd-6658-3a87-b21d-5cac6ae8f985",
                        "entry_id": "f992017d-743e-3aeb-a7e9-71b2eae0bbb1",
                        "glosses": [
                            "специальный журнал"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e50c2ac1-fe9c-4cfd-9b2b-7125bd2bec27",
                                "sense_id": "ef3ccdfd-6658-3a87-b21d-5cac6ae8f985",
                                "text": "Er zitierte in seiner Hausarbeit aus einer Fachzeitschrift.",
                                "translation": "Он приводил в своей домашней работе цитаты из специализированного журнала."
                            },
                            {
                                "example_id": "2e6b22ae-70c0-4dc8-abee-1250e086a423",
                                "sense_id": "ef3ccdfd-6658-3a87-b21d-5cac6ae8f985",
                                "text": "Um sich in der Wissenschaft einen Namen zu machen, muss man in angesehenen Fachzeitschriften publizieren.",
                                "translation": "Чтобы сделать себе имя в науке, нужно публиковаться в авторитетных специальных журналах."
                            }
                        ]
                    }
                ],
