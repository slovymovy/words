                "senses": [
                    {
                        "sense_id": "3aae6f72-e304-3345-9eeb-37389f8cfa4b",
                        "entry_id": "256337a1-3b01-3806-9937-8ade54e07f8b",
                        "glosses": [
                            "Zone où des consignes de protection spéciales sont données pour protéger les élevages de volailles, en cas d’influenza aviaire détecté dans la faune sauvage."
                        ],
                        "tags": [
                            "France"
                        ],
                        "examples": [
                            {
                                "example_id": "1ce2d4ef-13f9-470e-ae99-3ad8748315cb",
                                "sense_id": "3aae6f72-e304-3345-9eeb-37389f8cfa4b",
                                "text": "En réponse, la préfecture met en place des zones de contrôle temporaire (ZCT) dans lesquelles les éleveurs de volaille sont invités à maintenir leurs bêtes à l’abri."
                            },
                            {
                                "example_id": "63eb6edd-9127-477a-bd06-1307e4368931",
                                "sense_id": "3aae6f72-e304-3345-9eeb-37389f8cfa4b",
                                "text": "En baie de Morlaix, le foyer trouvé sur le château du Taureau incite à la mise en place d’une ZCT recouvrant Taulé, Saint-Pol-de-Léon, Henvic, Carantec, Plouezoc’h et Plougasnou."
                            },
                            {
                                "example_id": "79d34c51-8dcb-4e53-9d33-09c6b91ef9cc",
                                "sense_id": "3aae6f72-e304-3345-9eeb-37389f8cfa4b",
                                "text": "Une zone de contrôle temporaire (ZCT) est prise lorsqu’un cas d’influenza aviaire est détecté dans la faune sauvage, dans un rayon de 20 km."
                            }
                        ]
                    }
