                    },
                    {
                        "translation_id": "f2cf0fa4-f739-4ec8-8df4-6eea0bd12c6d",
                        "source_entry_id": "0fb5af78-137d-3e77-8cd0-f707b710cfde",
                        "source_sense_description": "absence of the sense of pain",
                        "target_lang_word": "analgie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "analgie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "17e17757-bb3a-34cb-9e5c-8139067c4650",
                                        "entry_id": "c9d4b408-2e14-36a0-bf8d-03766b93e8ac",
                                        "glosses": [
                                            "Insensibilité à la douleur physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5037455c-a53d-4cbd-9827-b0e7d9445ff2",
                                                "sense_id": "17e17757-bb3a-34cb-9e5c-8139067c4650",
                                                "text": "Appliqués ainsi pendant une opération, quelle qu’en soit la durée, ces rayons provoquent une analgie postopératoire remarquable, un état de bien-être qui frappe l’entourage, une facilité de mobilisation qui rend aisé de lever l’opéré."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20297ee4-7a8b-4ebf-a6d0-b7cf9c20f02a",
                        "source_entry_id": "0fb5af78-137d-3e77-8cd0-f707b710cfde",
                        "source_sense_description": "absence of the sense of pain",
                        "target_lang_word": "Analgesie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Analgesie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71009d77-f8ca-39eb-9bbe-362aa3033554",
                                        "entry_id": "13edc388-2081-3046-9c87-9fb578374d64",
                                        "glosses": [
                                            "künstlich hervorgerufener (zum Beispiel durch Analgetika) oder krankheitsbedingter Zustand, in dem gar kein oder nur verminderter Schmerz wahrgenommen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5864ef8d-450b-46af-804f-0b6536660796",
                                                "sense_id": "71009d77-f8ca-39eb-9bbe-362aa3033554",
                                                "text": "„Bei Streß schüttet das Gehirn Opioide aus, die bestimmte Schmerz-Relais-Neuronen im Mesencephalon in ihrer Aktivität dämpfen. Folge: Analgesie.“"
                                            },
                                            {
                                                "example_id": "62651dca-2fd4-42b8-bcc4-8224908942fa",
                                                "sense_id": "71009d77-f8ca-39eb-9bbe-362aa3033554",
                                                "text": "„Als wichtigste Ziele einer Allgemeinanästhesie gelten heute: eine starke allgemeine Beruhigung und Stressabschirmung (medizinisch: Sedierung); Bewusstseinsverlust (fachlich Hypnose genannt); Bewegungs- oder Reglosigkeit, dabei auch fehlende Muskelreaktionen auf Reize (Immobilisierung); Schmerzunempfindlichkeit (Analgesie); Aussetzen des Gedächtnisses (Amnesie).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
