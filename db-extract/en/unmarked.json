        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "45547a40-c329-3353-ba29-7aab3e379a59",
                "word": "unmarked",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9dced34a-a113-3e98-b268-dfc0a18d1282",
                        "entry_id": "45547a40-c329-3353-ba29-7aab3e379a59",
                        "glosses": [
                            "Not bearing identification."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "9090c8d5-0676-43a0-b0f0-9a76466f8409",
                                "sense_id": "9dced34a-a113-3e98-b268-dfc0a18d1282",
                                "text": "an unmarked highway patrol vehicle"
                            },
                            {
                                "example_id": "327daf4f-50d9-4ea6-b823-33ac53894171",
                                "sense_id": "9dced34a-a113-3e98-b268-dfc0a18d1282",
                                "text": "My mother died when I could not have been more than eight or nine years old, on one of old master's farms in Tuckahoe, in the neighborhood of Hillsborough. Her grave is, as the grave of the dead at sea, unmarked, and without stone or stake."
                            },
                            {
                                "example_id": "af654d65-356c-4684-a9f9-370f0eab6a0f",
                                "sense_id": "9dced34a-a113-3e98-b268-dfc0a18d1282",
                                "text": "The “little green men”—faces covered, wearing unmarked olive uniforms, speaking Russian and using Russian weapons—have played a significant role in both the occupation of Crimea and the civil war in eastern Ukraine.¹⁹⁶"
                            }
                        ]
                    },
                    {
                        "sense_id": "dddee45b-9f03-39fc-a4b8-8cc39a84c251",
                        "entry_id": "45547a40-c329-3353-ba29-7aab3e379a59",
                        "glosses": [
                            "Free from blemishes."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "980580bb-8814-39c7-93b5-8edefbb9637e",
                        "entry_id": "45547a40-c329-3353-ba29-7aab3e379a59",
                        "glosses": [
                            "Not noticed."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5e84870e-e686-3b57-99a5-f53399f41a58",
                        "entry_id": "45547a40-c329-3353-ba29-7aab3e379a59",
                        "glosses": [
                            "Not marked, not closely followed by a defensive player."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "da2f3f38-f233-47e5-973d-4a5bc7bf830f",
                                "sense_id": "5e84870e-e686-3b57-99a5-f53399f41a58",
                                "text": "Bale worked Bozovic again as he was left unmarked in the Montenegro area but could not get enough power on his header from a looping cross."
                            }
                        ]
                    },
                    {
                        "sense_id": "fb13feef-f267-32f1-a616-21c7a2d8003f",
                        "entry_id": "45547a40-c329-3353-ba29-7aab3e379a59",
                        "glosses": [
                            "Not having been marked, or assigned a score."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "c4e3ef1a-f974-4261-b7d4-0a05e3f70912",
                                "sense_id": "fb13feef-f267-32f1-a616-21c7a2d8003f",
                                "text": "The teacher sat down to a pile of unmarked work."
                            }
                        ]
                    },
                    {
                        "sense_id": "53d65df3-a0d9-3cfd-9886-d0345d4df391",
                        "entry_id": "45547a40-c329-3353-ba29-7aab3e379a59",
                        "glosses": [
                            "Not marked; not standing out as unusual."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "6afcff7d-da2b-4801-bf29-f0706709cb61",
                                "sense_id": "53d65df3-a0d9-3cfd-9886-d0345d4df391",
                                "text": "The use of that word in that context was unmarked."
                            }
                        ]
                    }
                ],
