                                "target_senses": [
                                    {
                                        "sense_id": "41adb48b-f531-37d4-9ee9-512266e424b6",
                                        "entry_id": "ec151364-7281-323b-b75e-2b0120d21503",
                                        "glosses": [
                                            "A person who draws caricatures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05cc8a8-d682-47f8-a120-b2478d8f0180",
                                                "sense_id": "41adb48b-f531-37d4-9ee9-512266e424b6",
                                                "text": "But, the power of the caricaturist lies in exhibiting with increased ugliness personal and natural defects . . ."
                                            }
