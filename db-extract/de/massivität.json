                ],
                "senses": [
                    {
                        "sense_id": "ee9a961f-7ccf-3b94-8326-548a8bed5025",
                        "entry_id": "6292814b-232b-374b-af2c-372d50c63935",
                        "glosses": [
                            "Eigenschaft, die dichte, kompakte (massive) Wuchtigkeit zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f2ffc90-4a31-496c-bfec-ba009ecab2d2",
                                "sense_id": "ee9a961f-7ccf-3b94-8326-548a8bed5025",
                                "text": "„Trotz der Massivität der verwendeten Baumaterialien erhielt das gottesdienstliche Geschehen auf diese Weise etwas unverhofft Immaterielles.“"
                            },
                            {
                                "example_id": "262788dd-e2c3-40f2-9c86-2313f36d81bb",
                                "sense_id": "ee9a961f-7ccf-3b94-8326-548a8bed5025",
                                "text": "„Die Massivität, mit der es nun aus seinen Refugien hinaus in die Straßen und Bürgersteige drängte, machte jede Hoffnung zunichte, es könnte im Laufe des Winters auf mysteriöse Weise zu einem harmlosen Stadtgras mutiert sein wie seinerzeit die Wasserpest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b5e663e-9cc2-3bea-b796-295ebcac29b7",
                        "entry_id": "6292814b-232b-374b-af2c-372d50c63935",
                        "glosses": [
                            "Eigenschaft, die scharfe, vehemente (massive) Intensität zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "197b60b0-ab82-4489-80d5-0e6e4a9bfa67",
                                "sense_id": "6b5e663e-9cc2-3bea-b796-295ebcac29b7",
                                "text": "„Die Massivität, mit der es nun aus seinen Refugien hinaus in die Straßen und Bürgersteige drängte, machte jede Hoffnung zunichte, es könnte im Laufe des Winters auf mysteriöse Weise zu einem harmlosen Stadtgras mutiert sein wie seinerzeit die Wasserpest.“"
                            },
                            {
                                "example_id": "57da2599-8b13-46c0-8b2a-d5b8eb0c7946",
                                "sense_id": "6b5e663e-9cc2-3bea-b796-295ebcac29b7",
                                "text": "„Das hohe Maß an Irritation, die die Thesen Khorchides verbandsseitig ausgelöst haben, zeigt sich an der Massivität der geäußerten Kritik, die auf drei Ebenen vorgetragen wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
