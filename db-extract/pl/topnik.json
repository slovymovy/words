                ],
                "senses": [
                    {
                        "sense_id": "095b47b5-8f96-3993-89f3-72400b71d048",
                        "entry_id": "38f87ced-d335-3142-98bd-a555493095b3",
                        "glosses": [
                            "substancja ułatwiająca lutowanie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bab9220-152c-4a29-956e-545601c3ac9f",
                                "sense_id": "095b47b5-8f96-3993-89f3-72400b71d048",
                                "text": "Wieża, zwana gichtą, służyła do wyciągania za pomocą ręcznego dźwigu wsadu – czyli darniowej rudy żelaza, węgla drzewnego i topników – na sporą wysokość, aby zasypać nim zbudowany w pobliżu cylindryczny wielki piec."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0bcd4723-0124-4ca0-9cce-b843e58bc068",
                        "source_entry_id": "38f87ced-d335-3142-98bd-a555493095b3",
                        "source_sense_id": "095b47b5-8f96-3993-89f3-72400b71d048",
                        "target_lang_word": "flux",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flux",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e4bf46ed-e82a-3a3a-9b42-6b68d7a2d489",
                                        "entry_id": "84cd7260-4854-3eb3-b83e-6886c5551c6b",
                                        "glosses": [
                                            "The act of flowing; a continuous moving on or passing by, as of a flowing stream."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d131db39-e7a3-423b-b3ea-0fe7dbd72c12",
                                                "sense_id": "e4bf46ed-e82a-3a3a-9b42-6b68d7a2d489",
                                                "text": "By […]the perpetual Flux of the Liquids, a great part of the Liquids is thrown out of the Body."
                                            },
                                            {
                                                "example_id": "aa72215c-f3ad-4401-a73f-afe0a999a670",
                                                "sense_id": "e4bf46ed-e82a-3a3a-9b42-6b68d7a2d489",
                                                "text": "1991, Mann, H., Fyfe, W., Tazaki, K., & Kerrich, R., Biological Accumulation of Different Chemical Elements by Microorganisms from Yellowstone National Park, USA. Mechanisms And Phylogeny Of Mineralization In Biological Systems, 357-362.\nInvestigation of the silica budget for the Upper and Lower Geyser Basins of Yellowstone National Park by Truesdell et al. suggest that the present fluxes of hotspring water and thermal energy may have been continuous for at least the past 10,000 yr."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84eff19b-f5c9-35b0-a018-042eff37aee0",
                                        "entry_id": "84cd7260-4854-3eb3-b83e-6886c5551c6b",
                                        "glosses": [
                                            "A state of ongoing change."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c48e794-88fb-43e5-a86c-9a088aa2ca6f",
                                                "sense_id": "84eff19b-f5c9-35b0-a018-042eff37aee0",
                                                "text": "The schedule is in flux at the moment."
                                            },
                                            {
                                                "example_id": "95caca98-4732-4bc5-9cad-6320134aca4d",
                                                "sense_id": "84eff19b-f5c9-35b0-a018-042eff37aee0",
                                                "text": "Languages, like our bodies, are in a continual flux."
                                            },
                                            {
                                                "example_id": "e9ff0e1b-a0b2-4d88-a228-9700b2c97617",
                                                "sense_id": "84eff19b-f5c9-35b0-a018-042eff37aee0",
                                                "text": "Her image has escaped the flux of things, / And that same infant beauty that she wore / Is fixed upon her now forevermore."
                                            },
                                            {
                                                "example_id": "e08b4d20-353c-43ea-bf61-61822d1259a9",
                                                "sense_id": "84eff19b-f5c9-35b0-a018-042eff37aee0",
                                                "text": "Darwin recognized that just as the features of the inorganic world—deltas, river valleys, mountain chains—were brought into being by gradual change, the organic world similarly was subject to constant flux."
                                            },
                                            {
                                                "example_id": "53a1780e-f1c7-416d-8b76-27ff29ce2e86",
                                                "sense_id": "84eff19b-f5c9-35b0-a018-042eff37aee0",
                                                "text": "[…] her eldest son, now King Charles III, has assumed the monarch’s role[…]as the anchor of a nation’s identity in troubled times of change and flux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ec901ce-0ed0-301d-8946-333b7ab6c15b",
                                        "entry_id": "84cd7260-4854-3eb3-b83e-6886c5551c6b",
                                        "glosses": [
                                            "A chemical agent for cleaning metal prior to soldering or welding."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9e60450-d2c6-41ae-8a57-bace16a1d44e",
                                                "sense_id": "2ec901ce-0ed0-301d-8946-333b7ab6c15b",
                                                "text": "It is important to use flux when soldering or oxides on the metal will prevent a good bond."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c33b10a9-9c00-39f8-a25e-1c632e12661e",
                                        "entry_id": "84cd7260-4854-3eb3-b83e-6886c5551c6b",
                                        "glosses": [
                                            "The rate of transfer of energy (or another physical quantity), especially an electric or magnetic field, through a given surface."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce6155c4-30cc-4d38-a7d5-4123d94f719c",
                                                "sense_id": "c33b10a9-9c00-39f8-a25e-1c632e12661e",
                                                "text": "That high a neutron flux would be lethal in seconds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a552a8f-e099-34a3-84a2-141c571607a7",
                                        "entry_id": "84cd7260-4854-3eb3-b83e-6886c5551c6b",
                                        "glosses": [
                                            "A disease which causes diarrhea, especially dysentery."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc133ea-0c0f-461f-a62c-204cddb37ee0",
                                                "sense_id": "4a552a8f-e099-34a3-84a2-141c571607a7",
                                                "text": "The next year vvas calamitous, bringing ſtrange fluxes upon men, and murren upon Cattel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "15e7f511-90de-3ed8-8125-1b205c990524",
                                        "entry_id": "84cd7260-4854-3eb3-b83e-6886c5551c6b",
                                        "glosses": [
                                            "Diarrhea or other fluid discharge from the body."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a2df4679-5572-3678-94a1-0e66066788da",
                                        "entry_id": "84cd7260-4854-3eb3-b83e-6886c5551c6b",
                                        "glosses": [
                                            "The state of being liquid through heat; fusion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
