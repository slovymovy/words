                    }
                ],
                "senses": [
                    {
                        "sense_id": "bac9fcdf-1898-3418-9683-3aaf960d0b48",
                        "entry_id": "f788e31f-9d6b-3ca8-86ec-8540a2148a8d",
                        "glosses": [
                            "een met een stuwdam kunstmatig in standgehouden waterreservoir, dat dient als buffer voor de constante levering van waterkracht aan een energiecentrale"
                        ],
                        "tags": [
                            "waterbeheer"
                        ],
                        "examples": [
                            {
                                "example_id": "baf9886e-9ae1-4d6f-ba50-902a4711d95f",
                                "sense_id": "bac9fcdf-1898-3418-9683-3aaf960d0b48",
                                "text": "Bij grote sluizen wordt ook wel een stuwmeer als buffer benut om het waterverlies bij het sluizen aan te vullen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5fd8d5ce-4d57-48c4-a9a3-13ca77148f55",
                        "source_entry_id": "f788e31f-9d6b-3ca8-86ec-8540a2148a8d",
                        "source_sense_id": "bac9fcdf-1898-3418-9683-3aaf960d0b48",
                        "source_sense_description": "kunstmatig meer",
                        "target_lang_word": "Stausee",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stausee",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "acc996dd-d4c7-32e6-bfed-741f3b83369e",
                                        "entry_id": "9d5a5b7b-79c0-3440-8ce6-128b3b467290",
                                        "glosses": [
                                            "ein See, der mit Hilfe einer Talsperre erzeugt wird, um Wasser zu sammeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee186c85-133b-4c8f-a32e-1ea73bcdd322",
                                                "sense_id": "acc996dd-d4c7-32e6-bfed-741f3b83369e",
                                                "text": "Mit dem Wasser des Stausees werden riesige Turbinen angetrieben, um Strom zu erzeugen."
                                            },
                                            {
                                                "example_id": "a863f03f-8cfd-460d-8272-35db58e38d12",
                                                "sense_id": "acc996dd-d4c7-32e6-bfed-741f3b83369e",
                                                "text": "„Kennzeichnend für diese einzigartige Naturlandschaft sind die zahlreichen Bäche, Flüsse, Stauseen sowie die großflächigen Laubwälder mit ihrer seltenen Flora und Fauna.“"
                                            },
                                            {
                                                "example_id": "626a85ad-300f-4a42-8675-6fd0679aae46",
                                                "sense_id": "acc996dd-d4c7-32e6-bfed-741f3b83369e",
                                                "text": "„Das Volk der Pare fischt im Stausee, aus dem der Fluss entspringt.“"
                                            },
                                            {
                                                "example_id": "608da615-82e9-4ccb-a80a-659e7f1dd5b7",
                                                "sense_id": "acc996dd-d4c7-32e6-bfed-741f3b83369e",
                                                "text": "„Für Wasserkraftwerke werden Stauseen errichtet, die riesige Ökosysteme zerstören, und für Energiesparlampen muss in China hochgiftiges Quecksilber abgebaut werden.“"
                                            },
                                            {
                                                "example_id": "1419560b-e0b1-4bd7-b705-506a7ff98160",
                                                "sense_id": "acc996dd-d4c7-32e6-bfed-741f3b83369e",
                                                "text": "„Es war schon dunkel, als die Götzlacker mit ihren fertig gepackten Wagen die Böschung hinunter zum Stausee fuhren, wo sie sich sammeln sollten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f64e724-0062-4a82-8da7-87f29e58526a",
                        "source_entry_id": "f788e31f-9d6b-3ca8-86ec-8540a2148a8d",
                        "source_sense_id": "bac9fcdf-1898-3418-9683-3aaf960d0b48",
