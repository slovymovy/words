                ],
                "senses": [
                    {
                        "sense_id": "5816bf40-dd27-3947-a0ff-3bb8c3faf542",
                        "entry_id": "a035718e-d883-3ebe-ac8e-32bc8d04a950",
                        "glosses": [
                            "Anzahl von Staaten, die als zusammengehörig wahrgenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91ef5bca-0871-4a49-a8c6-0731ec76ad10",
                                "sense_id": "5816bf40-dd27-3947-a0ff-3bb8c3faf542",
                                "text": "„Führt ein Staat oder eine Staatengruppe Maßnahmen zur Abwendung von Menschenrechtsverletzungen ohne ein Mandat des Sicherheitsrates der Vereinten Nationen durch, so werden zwei Fallgruppen der humanitären Intervention unterschieden.“"
                            },
                            {
                                "example_id": "c1988482-89c6-43d6-bb2d-cfdc450a2d9e",
                                "sense_id": "5816bf40-dd27-3947-a0ff-3bb8c3faf542",
                                "text": "„Die Schengener Staatengruppe entwickelte ihre eigenen Vorstellungen neben der Europäischen Union, da diese außer Stande war, Dynamik und Bewegung in die Verhandlungen zu involvieren.“"
                            },
                            {
                                "example_id": "515013c1-fd37-4dd5-bb38-888c71623ef4",
                                "sense_id": "5816bf40-dd27-3947-a0ff-3bb8c3faf542",
                                "text": "„Ihren großen Reichtum und den unerhört raschen wirtschaftlichen Aufschwung der lezten Jahrzehnte verdankt die Union dieser Staatengruppe.“"
                            },
                            {
                                "example_id": "58a22c20-b3f9-49d4-bb35-1f22aec2db60",
                                "sense_id": "5816bf40-dd27-3947-a0ff-3bb8c3faf542",
                                "text": "„Zusätzlich zu dieser Aufteilung untergliedert der Internationale Währungsfonds (IWF) die erste Staatengruppe in EU-Beitrittsstaaten, die Baltischen Staaten und ‚Andere Südosteuropäische Staaten‘.“"
                            },
                            {
                                "example_id": "5fe01f5c-f704-4c36-8c3e-68b46ee17d59",
                                "sense_id": "5816bf40-dd27-3947-a0ff-3bb8c3faf542",
                                "text": "„Jeder Staat, und ebenso jede in einem gemeinsamen politischen Bewußtsein sich als Einheit fühlende Staatengruppe benötigt eine Grundstruktur des Unbezweifelten, um den von dieser nicht berührten Zweifel gewähren lassen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
