                "senses": [
                    {
                        "sense_id": "077eedb5-696f-3bf0-9d49-c94bcc78aa8d",
                        "entry_id": "ba8cff95-9bd4-3433-9578-3c80904032ed",
                        "glosses": [
                            "meist erbliche Anomalie der Netzhaut, bei der Farben falsch wahrgenommen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0dc2b55-dee3-4f93-ad01-b5f7dc5a02bd",
                                "sense_id": "077eedb5-696f-3bf0-9d49-c94bcc78aa8d",
                                "text": "„Der Jagderfolg blieb ihm aber manchmal auch aufgrund seiner rot-grün Farbfehlsichtigkeit versagt.“"
                            },
                            {
                                "example_id": "6789abbf-0811-4a6a-8f91-e3664917573b",
                                "sense_id": "077eedb5-696f-3bf0-9d49-c94bcc78aa8d",
                                "text": "„Durch die Wahl von Farbe und Symbolform für diese Markierung sollte die Grafik auch für Menschen mit Farbfehlsichtigkeit lesbar sein.“"
                            },
                            {
                                "example_id": "fb68d818-7646-43d0-a925-aa1dbf52d7c4",
                                "sense_id": "077eedb5-696f-3bf0-9d49-c94bcc78aa8d",
                                "text": "„Es gibt verschiedene Formen der Farbfehlsichtigkeit, nämlich Anopien (Farbblindheiten) und Anomalien (Farbschwächen).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
