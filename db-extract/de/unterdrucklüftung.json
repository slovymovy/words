                "senses": [
                    {
                        "sense_id": "bafbc347-831d-3096-80a3-1eacafbc83ee",
                        "entry_id": "23e7d1d7-2afc-34c4-9416-eb0472e33da6",
                        "glosses": [
                            "Entsorgung von Luft aus einem Raum/System durch niedrigen Luftdruck"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "f7dc297c-a36e-4c67-9ee5-5a1f2359fb0b",
                                "sense_id": "bafbc347-831d-3096-80a3-1eacafbc83ee",
                                "text": "„Die Unterdrucklüftung kommt am öftesten zum Einsatz.“"
                            },
                            {
                                "example_id": "edc9a1ed-30e0-41b9-a783-678ce9a33721",
                                "sense_id": "bafbc347-831d-3096-80a3-1eacafbc83ee",
                                "text": "„Eine Unterdrucklüftung ist eine lüftungstechnische Anlage, die in einem bestimmten Gebäudeteil einen Unterdruck erzeugt.“"
                            },
                            {
                                "example_id": "cb5d878b-1487-40ab-8896-921a1e5e92d6",
                                "sense_id": "bafbc347-831d-3096-80a3-1eacafbc83ee",
                                "text": "„Für das Funktionieren einer Unterdrucklüftung ist es unbedingt notwendig, dass in den Stallraum keine Falschluft angesaugt werden kann.“"
                            },
                            {
                                "example_id": "33ae0529-376e-41e3-a91d-6ac30fd9c958",
                                "sense_id": "bafbc347-831d-3096-80a3-1eacafbc83ee",
                                "text": "„Bei der Unterdrucklüftung werden die Brandgase aus dem Haus gesaugt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
