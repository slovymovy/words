{
    "word_family": [
        "wrinkle",
        "wrinkly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ba77d37b-328e-3a41-8ea7-9f8ca6521759",
                    "sense_definition": "Having many small lines or folds on the surface, especially on skin or fabric.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "texture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man had a <w>wrinkled</w> face from years of smiling in the sun.",
                            "target_lang_translations": {
                                "it": "Il vecchio aveva il volto <w>raggrinzito</w> da anni di sorrisi al sole."
                            }
                        },
                        {
                            "text": "She pulled her <w>wrinkled</w> shirt out of the suitcase and tried to smooth it.",
                            "target_lang_translations": {
                                "it": "Ha tirato fuori la camicia <w>stropicciata</w> dalla valigia e ha cercato di lisciarla."
                            }
                        }
                    ],
                    "synonyms": [
                        "creased",
                        "wrinkly"
                    ],
                    "antonyms": [
                        "unwrinkled",
                        "wrinkle-free"
                    ],
                    "common_phrases": [
                        "wrinkled skin",
                        "wrinkled clothes"
                    ],
                    "target_lang_definitions": {
                        "it": "Che presenta molte piccole linee o pieghe sulla superficie, specialmente sulla pelle o sui tessuti."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "raggrinzito",
                                "target_lang_sense_clarification": "riferito a pelle o tessuti che presentano pieghe"
                            },
                            {
                                "target_lang_word": "grinzoso",
                                "target_lang_sense_clarification": "che ha molte rughe o grinze"
                            },
                            {
                                "target_lang_word": "avvizzito",
                                "target_lang_sense_clarification": "riferito a pelle o frutti che hanno perso freschezza"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7eed4ebd-f4a7-3ef6-bf7d-c572af058647",
                    "sense_definition": "Past tense and past participle of <w>wrinkle</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>wrinkled</w> his nose when he smelled the sour milk.",
                            "target_lang_translations": {
                                "it": "Ha <w>arricciato</w> il naso quando ha sentito l'odore del latte acido."
                            }
                        },
                        {
                            "text": "She <w>wrinkled</w> the paper in her hand while she was nervous.",
                            "target_lang_translations": {
                                "it": "Ha <w>accartocciato</w> il foglio in mano mentre era nervosa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "grammatical form"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Tempo passato e participio passato del verbo raggrinzire."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "raggrinzito",
                                "target_lang_sense_clarification": "forma verbale di raggrinzire"
                            },
                            {
                                "target_lang_word": "corrugato",
                                "target_lang_sense_clarification": "forma verbale di corrugare, spesso usato per la fronte o il naso"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}