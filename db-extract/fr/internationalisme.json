        "fr-extract.jsonl": [
            {
                "entry_id": "d9d2a87f-6461-3540-8543-7a366c3e89f9",
                "word": "internationalisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1e425123-c44a-4327-a1be-0f662c66c815",
                        "entry_id": "d9d2a87f-6461-3540-8543-7a366c3e89f9",
                        "tags": [
                            "plural"
                        ],
                        "form": "internationalismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a05291e-6b22-378f-8232-baba0f745326",
                        "entry_id": "d9d2a87f-6461-3540-8543-7a366c3e89f9",
                        "glosses": [
                            "Caractère, état de ce qui est international."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63903b1e-ad9b-461b-a790-123b5d9ff209",
                                "sense_id": "1a05291e-6b22-378f-8232-baba0f745326",
                                "text": "Pierre songeait à cet internationalisme, à ce cosmopolitisme, au vol d'étrangers qui, de plus en plus dense, s'abat sur Paris."
                            }
                        ]
                    },
                    {
                        "sense_id": "a54e44b7-0cb9-3d27-8ce2-a6bd7dce7216",
                        "entry_id": "d9d2a87f-6461-3540-8543-7a366c3e89f9",
                        "glosses": [
                            "Codification du droit des gens et arbitrage international ^([JO])."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "813a0f36-69b9-42b1-9b18-ddd0d1cd07ff",
                                "sense_id": "a54e44b7-0cb9-3d27-8ce2-a6bd7dce7216",
                                "text": "L’internationalisme […] qui était un système d'égalité politique et sociale et de temporelle justice et de mutuelle liberté entre les peuples est devenu entre leurs mains [de Herr et Lavisse] une sorte de vague cosmopolitisme bourgeois vicieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "ae43c33e-241e-378e-b598-6f493ff20609",
                        "entry_id": "d9d2a87f-6461-3540-8543-7a366c3e89f9",
                        "glosses": [
                            "Doctrine humanitaire des relations entre les peuples sans distinction de patrie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c4bb36b-92e9-49d4-9fe4-1cf43cfc6bdb",
                                "sense_id": "ae43c33e-241e-378e-b598-6f493ff20609",
                                "text": "L’internationalisme est un article de foi en l’honneur duquel les plus modérés se déclarent prêts à prononcer les serments les plus solennels ; mais le patriotisme impose aussi des devoirs sacrés."
                            },
                            {
                                "example_id": "0d08a234-41ef-4f5c-b646-a784fb286103",
                                "sense_id": "ae43c33e-241e-378e-b598-6f493ff20609",
                                "text": "L’internationalisme sentimental d’avant 1914 n'a pas résisté au choc des nations. Dans tous les pays en guerre, socialistes et syndicalistes, dans leur grande majorité, ont participé à la défense nationale."
                            },
                            {
                                "example_id": "0244a477-9518-4119-b524-36707491b8ef",
                                "sense_id": "ae43c33e-241e-378e-b598-6f493ff20609",
                                "text": "Il ne s’explique pas comment Floréal, pourtant élevé dans le culte de l’internationalisme prolétarien, peut s’acoquiner avec des va-t-en-guerre manipulés par le grand capital."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "26a55f0d-46ef-4a39-8310-85e551259769",
                        "source_entry_id": "d9d2a87f-6461-3540-8543-7a366c3e89f9",
                        "target_lang_word": "Internationalismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Internationalismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                        "entry_id": "7433e9ca-84b0-3674-9bde-df977e523155",
                                        "glosses": [
                                            "Wort, das in gleicher/ähnlicher Form und Bedeutung zugleich in mehreren Sprachen verbreitet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "558363fb-4a50-4601-8188-f006a9dbee55",
                                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                                "text": "„Zudem bildet sich eine wachsende Zahl sogenannter Internationalismen heraus, die, weil sie die Kommunikation erleichtern können, eigentlich willkommen sein müßten.“"
                                            },
                                            {
                                                "example_id": "95e3d82d-ddf1-4862-a2ef-a45b743d92b2",
                                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                                "text": "„Durch vergleichende Lexikonanalyse habe ich einen ersten Bestand der Internationalismen erarbeitet: demnach erreichen die gleichen Wortschätze im Deutschen, Englischen und Französischen eine Zahl von 3500 Wörtern, und zwar auf der Basis von einbändigen standardsprachlichen Wörterbüchern.“"
                                            },
                                            {
                                                "example_id": "1cd49cb7-8de0-4c92-9ed1-7c65fc9ba962",
                                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                                "text": "„Wörter, die in alle wichtigen Kultursprachen entlehnt worden sind, nennen wir Internationalismen (man sagt auch Europäismen) und ähnliches)…“"
                                            },
                                            {
                                                "example_id": "96a485a3-f046-4c88-9b3f-cd83f4b23de5",
                                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                                "text": "„Abschließend sollte vielleicht noch darauf hingewiesen werden, daß diese Textproben relativ viele Internationalismen enthalten.“"
                                            },
                                            {
                                                "example_id": "c2be04e5-4677-4db3-ae0a-6a321b340d00",
                                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                                "text": "„Anglizismen sind zunehmend als Internationalismen anzusehen.“"
                                            },
                                            {
                                                "example_id": "e6e552f7-58b3-4e5b-9d0c-66f6c5b990d6",
                                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                                "text": "„Ein Internationalismus ist in vielen Sprachen der Erde vorhanden, hat überall gleiche oder sehr ähnliche Bedeutung und gleiche oder ähnliche Aussprache.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3ee8be9d-6900-34a8-87f4-adde86b14e3b",
                                        "entry_id": "7433e9ca-84b0-3674-9bde-df977e523155",
                                        "glosses": [
                                            "internationale Ausrichtung politischer Maßnahmen, politischen Denkens"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcb1560a-53b4-4597-b69f-3901ffd8bd12",
                        "source_entry_id": "d9d2a87f-6461-3540-8543-7a366c3e89f9",
                        "target_lang_word": "internationalism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
