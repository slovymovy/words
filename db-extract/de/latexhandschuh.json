                    {
                        "sense_id": "0f680337-18e2-3a9f-a929-9bdc0bc5d96d",
                        "entry_id": "8a3619a1-2df5-36f4-b984-d35143aafe63",
                        "glosses": [
                            "aus Latex bestehender Handschuh"
