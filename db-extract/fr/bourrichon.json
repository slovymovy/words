                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e31c4e28-407a-432e-8bb6-81f483899454",
                                                "sense_id": "ec37de51-6ba0-3efa-96e1-27c6d650352a",
                                                "text": "„Ik heb inmiddels heel wat verlopen koppies zien binnenkomen”, aldus De Boer woensdagmiddag rond vier uur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede4d0ec-d9db-39ea-a1c3-f75c838676a0",
