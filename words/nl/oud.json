                    "semantic_group_id": "age_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die stoel is al heel <w>oud</w>, hij was nog van mijn grootvader.",
                            "target_lang_translations": {
                                "en": "That chair is already very <w>old</w>; it used to belong to my grandfather.",
                                "ru": "Этот стул уже очень <w>старый</w>, он был ещё у моего дедушки.",
                                "pl": "To krzesło jest już bardzo <w>stare</w>, należało jeszcze do mojego dziadka.",
                                "de": "Dieser Stuhl ist schon sehr <w>alt</w>, er gehörte noch meinem Großvater.",
                                "fr": "Cette chaise est déjà très <w>vieille</w>, elle appartenait encore à mon grand-père.",
                                "it": "Quella sedia è già molto <w>vecchia</w>, era ancora di mio nonno.",
                                "cs": "Ta židle už je velmi <w>stará</w>, byla ještě mého dědečka.",
                                "tr": "O sandalye zaten çok <w>eski</w>, dedemden kalmıştı.",
                                "es": "Esa silla ya es muy <w>vieja</w>, era de mi abuelo."
                            }
                        },
                        {
                            "text": "We wonen in een mooi <w>oud</w> huis in het centrum.",
                            "target_lang_translations": {
                                "en": "We live in a beautiful <w>old</w> house in the center.",
                                "ru": "Мы живём в красивом <w>старом</w> доме в центре.",
                                "pl": "Mieszkamy w pięknym <w>starym</w> domu w centrum.",
                                "de": "Wir wohnen in einem schönen <w>alten</w> Haus im Zentrum.",
                                "fr": "Nous habitons dans une belle maison <w>ancienne</w> dans le centre.",
                                "it": "Abitiamo in una bella casa <w>vecchia</w> in centro.",
                                "cs": "Bydlíme v krásném <w>starém</w> domě v centru.",
                                "tr": "Merkezde güzel, <w>eski</w> bir evde yaşıyoruz.",
                                "es": "Vivimos en una hermosa casa <w>antigua</w> en el centro."
                            }
