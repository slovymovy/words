                    "sense_definition": "Frequently visited or used by customers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shopkeeper ran a well <w>accustomed</w> establishment near the main market square.",
