                "senses": [
                    {
                        "sense_id": "7694802e-2b52-3009-8be1-7a9c5d253c09",
                        "entry_id": "020fb6c7-f571-3c8d-b87f-b056ce13be8c",
                        "glosses": [
                            "Chauve-souris appartenant à une famille caractérisée par une tête rappelant celle du renard, une alimentation végétale (frugivore pour les plus grandes espèces, nectarivore pour les plus petites), une queue réduite ou absente."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1e7318c-c024-4a5a-9204-0928f564db8c",
                                "sense_id": "7694802e-2b52-3009-8be1-7a9c5d253c09",
                                "text": "Dans les climats tropicaux et subtropicaux on trouve des chiroptères de grande taille et à tête de renard comme les roussettes ou les renards-volants, appartenant à la famille de ptéropodidés."
                            },
                            {
                                "example_id": "f18fc152-e800-4298-b636-bc6f198e5f9d",
                                "sense_id": "7694802e-2b52-3009-8be1-7a9c5d253c09",
                                "text": "Deux espèces se distinguent : le ptéropodidé Hypsignatus monstrosus d’Afrique dont le mâle a une tête énorme en forme de marteau … tandis que la femelle a une petite tête allongée comme la plupart des ptéropodidés."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dad6c928-1990-4dcc-a52c-f4fa3336d9bb",
                        "source_entry_id": "020fb6c7-f571-3c8d-b87f-b056ce13be8c",
                        "source_sense_id": "7694802e-2b52-3009-8be1-7a9c5d253c09",
