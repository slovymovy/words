                                    {
                                        "sense_id": "f5acfa63-f99f-3538-9130-c44ad36ec29d",
                                        "entry_id": "ed66a776-4e09-319b-97ff-e8ecd29782c6",
                                        "glosses": [
                                            "in Zurückgezogenheit lebend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2fe10cea-6fc4-4c62-9ede-daddc5d2ca55",
                                                "sense_id": "f5acfa63-f99f-3538-9130-c44ad36ec29d",
                                                "text": "Den Winter über lebte er auf der Insel eremitisch."
                                            },
                                            {
                                                "example_id": "617e113a-53c8-4159-80c1-bac0ec62226d",
                                                "sense_id": "f5acfa63-f99f-3538-9130-c44ad36ec29d",
                                                "text": "Diese an die Praxis der älteren Eremitenorden erinnernden Gewohnheiten lassen vermuten, daß im Mutterhaus nicht nur eine konservative Verfassungsform, sondern auch eine stärker eremitisch ausgerichtete Lebensordnung beibehalten wurde."
                                            }
                                        ],
