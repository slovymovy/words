                    },
                    {
                        "translation_id": "4c3d16a9-84d8-4d1a-a428-d7c259b3a90f",
                        "source_entry_id": "804df432-fd59-3ddb-94ea-a7454beb96a4",
                        "source_sense_description": "Réflexions laborieuses, méditations",
                        "target_lang_word": "hersenspinsel",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hersenspinsel",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b47828d4-c6e6-3052-b265-2914ffc0e725",
                                        "entry_id": "9c737dd9-f223-34d5-aa98-078f0a1c3703",
                                        "glosses": [
                                            "een gedachte die niet op de werkelijkheid gebaseerd hoeft te zijn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a917f7b-f9ef-4fe4-95d8-299339284ed3",
                                                "sense_id": "b47828d4-c6e6-3052-b265-2914ffc0e725",
                                                "text": "En ze weet niet eens of Sander echt verliefd op haar is, of dat ze het zich maar verbeeldt. Als ze nog even doorgaat denkt ze nog dat het allemaal hersenspinsels zijn. Ze moet hem zien. En Heike wil ze ook spreken. Gelukkig is ze niet meer kwaad op Indra."
                                            },
                                            {
                                                "example_id": "53741057-5826-4c7c-9baf-a90ab21cff3f",
                                                "sense_id": "b47828d4-c6e6-3052-b265-2914ffc0e725",
                                                "text": "Ook fantaseert hij over buitenaards leven. Hij stelt dat aliens niet per se intelligent hoeven te zijn, waarbij hij een inmiddels behoorlijk racistisch klinkende vergelijking maakt: `De inwoners van de recent ontdekte landen kunnen we nauwelijks mensen noemen; het zijn meer dieren met een — zeer i mperfecte menselijke vorm, maar bijna zonder menselijke rede.' Zelfs in futuristische hersenspinsels over ruimtereizen klinkt de koloniale tijdgeest door."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6e93ac5-b62e-4938-8d61-459143da902d",
                        "source_entry_id": "804df432-fd59-3ddb-94ea-a7454beb96a4",
