                ],
                "senses": [
                    {
                        "sense_id": "ab12d0cb-87a6-3a79-8438-6c8ef71657e5",
                        "entry_id": "ad438d15-2524-3cc8-b33c-7df9dceacdbf",
                        "glosses": [
                            "kantoor dat zich bezighoudt met de bezorging van post en vaak ook andere diensten levert zoals bankzaken, kaartverkoop, etc"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59f9bf05-a6de-4473-84ad-622ac981220d",
                                "sense_id": "ab12d0cb-87a6-3a79-8438-6c8ef71657e5",
                                "text": "Met mijn boodschappenlijst voor de komende maand in de aanslag stortte ik me op de schappen en na anderhalf uur duwde ik twee volle winkelwagens de supermarkt uit richting het postkantoor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13341b6f-4cd3-426a-a1bb-4723a6fdaf6a",
                        "source_entry_id": "ad438d15-2524-3cc8-b33c-7df9dceacdbf",
                        "source_sense_id": "ab12d0cb-87a6-3a79-8438-6c8ef71657e5",
                        "source_sense_description": "kantoor dat zich bezighoudt met de bezorging van post en vaak ook andere diensten levert zoals bankzaken, kaartverkoop, etc",
                        "target_lang_word": "Postamt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Postamt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                        "entry_id": "30585712-0102-32be-9d1b-3c01f214c88b",
                                        "glosses": [
                                            "einzelne Geschäftsstelle bzw. Dienststelle der Post"
                                        ],
                                        "tags": [
                                            "früher"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b6ad32d-6bf6-4dbc-9740-3b011c33baaa",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "Ich muss das Paket heute noch zum Postamt bringen."
                                            },
                                            {
                                                "example_id": "6682349e-178b-4c67-8910-f3beb6cb5460",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "„In einer Ecke des Postamtes stand ein kleiner Kiosk mit der Aufschrift »Volksapotheke«.“"
                                            },
                                            {
                                                "example_id": "fad05087-909f-44d2-9cfd-ac636f618aa3",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "„Und immer wenn ich einen von ihnen treffe, wenn sie auf dem Postamt vor oder hinter mir in der Schlange stehen, dann quatsche ich sie an.“"
                                            },
                                            {
                                                "example_id": "c1234235-d23b-4808-8f59-c6f21fbd54b8",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "„Die Postverwaltung der Regierung weigerte sich, dieses Unternehmen anzuerkennen, und Franklin ließ es durch ein eigenes Postamt ersetzen.“"
                                            },
                                            {
                                                "example_id": "dedf89e7-0861-461b-b726-2ef7b7bfb219",
                                                "sense_id": "2eaf52db-387e-3e43-abf1-b86af7143310",
                                                "text": "„In Frankfurt befand sich außer dem hessen-casselschen Postamt um 1705 ein darmstädtisches Postamt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed961586-8c46-41fd-a50d-15b3c3164e2c",
                        "source_entry_id": "ad438d15-2524-3cc8-b33c-7df9dceacdbf",
                        "source_sense_id": "ab12d0cb-87a6-3a79-8438-6c8ef71657e5",
                        "source_sense_description": "kantoor dat zich bezighoudt met de bezorging van post en vaak ook andere diensten levert zoals bankzaken, kaartverkoop, etc",
                        "target_lang_word": "post office",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "post office",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2c47242d-8db8-3591-9be7-092e37e84c55",
                                        "entry_id": "64821770-5126-3093-87dd-5c2815bd2290",
                                        "glosses": [
                                            "A place (building, office, shop, or counter) concerned with the business of delivering letters, post or mail and selling stamps, etc."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f767428-f233-471f-85fd-a85acd1dcbaf",
                                                "sense_id": "2c47242d-8db8-3591-9be7-092e37e84c55",
                                                "text": "We were over the border here, into Northern Ireland, and the post office had a very English atmosphere. It was pleasant, too, much as we enjoyed the hospitality of the Republic, to be buying stamps with the Queen's head on them, and to be posting our cards in a red pillar-box, instead of a green one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c1b74e3-1d60-30a5-bbc5-7a4d3285ce57",
                                        "entry_id": "64821770-5126-3093-87dd-5c2815bd2290",
                                        "glosses": [
                                            "An organization that delivers letters."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf4f261-2331-49cc-b507-9dc6a9278476",
                                                "sense_id": "5c1b74e3-1d60-30a5-bbc5-7a4d3285ce57",
                                                "text": "“The post-office is a wonderful establishment!” said she.—“The regularity and despatch of it! If one thinks of all that it has to do, and all that it does so well, it is really astonishing!”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3adb3291-e860-3c19-8083-b2d9ee4e0375",
                                        "entry_id": "64821770-5126-3093-87dd-5c2815bd2290",
                                        "glosses": [
                                            "A party game involving the exchange of kisses."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
