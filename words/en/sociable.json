                },
                {
                    "sense_id": "0b34f8c4-1905-311e-b4a2-3baae20efb14",
                    "sense_definition": "Friendly and no longer hostile.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long conflict, the leaders finally met in a more <w>sociable</w> mood.",
                            "target_lang_translations": {
                                "ru": "После долгого конфликта лидеры наконец встретились в более <w>миролюбивом</w> настроении."
                            }
