                ],
                "senses": [
                    {
                        "sense_id": "3d590a18-fb7e-3ff2-81ea-b2fa3bf4f077",
                        "entry_id": "cbdd2f74-a273-359e-8178-3c3c4a281e3b",
                        "glosses": [
                            "Geschäft, das Handel betreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "648b9813-e444-4d01-8ff3-49c5554b0705",
                                "sense_id": "3d590a18-fb7e-3ff2-81ea-b2fa3bf4f077",
                                "text": "„Der Ältere hatte sein Erbteil erhalten, lebte in Saloniki, betrieb dort ein Handelsgeschäft und war zu Reichtum gelangt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85dcb496-2db2-39a5-b9ee-9e06301fc6bb",
                        "entry_id": "cbdd2f74-a273-359e-8178-3c3c4a281e3b",
                        "glosses": [
                            "Aktion, die darin besteht, Handel (Kauf, Verkauf) zu betreiben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a971556-2f4c-422a-bf08-f67461660cbe",
                                "sense_id": "85dcb496-2db2-39a5-b9ee-9e06301fc6bb",
                                "text": "„Der deutsche Strommarkt wurde bis vor wenigen Tagen durch gefährliche Handelsgeschäfte in die Nähe eines Zusammenbruchs gebracht.“"
                            },
                            {
                                "example_id": "ed32002c-31d9-4e2b-bc32-c8a876268058",
                                "sense_id": "85dcb496-2db2-39a5-b9ee-9e06301fc6bb",
                                "text": "„Handelsgeschäfte sind alle Geschäfte eines Kaufmanns, die zum Betriebe seines Handelsgewerbes gehören.“"
                            },
                            {
                                "example_id": "b0fd226a-25ca-45da-8ba0-f8b99bd6e3cc",
                                "sense_id": "85dcb496-2db2-39a5-b9ee-9e06301fc6bb",
                                "text": "„Ebenso anrüchig wie der Geldverleih war das Handelsgeschäft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
