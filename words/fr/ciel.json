{
    "word_family": [
        "arc-en-ciel",
        "gratte-ciel",
        "céleste"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f8a8c514-d696-3a31-b8d6-be6b78b36a53",
                    "sense_definition": "Voûte céleste visible au-dessus de la Terre, où apparaissent les astres et les nuages.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>ciel</w> bleu d'été illuminait la plage dès les premières heures de la matinée."
                        },
                        {
                            "text": "La nuit était si claire que le <w>ciel</w> étoilé semblait briller de mille feux."
                        }
                    ],
                    "synonyms": [
                        "azur",
                        "firmament",
                        "voûte"
                    ],
                    "antonyms": [
                        "sol",
                        "terre"
                    ],
                    "common_phrases": [
                        "ciel bleu",
                        "ciel couvert",
                        "ciel étoilé",
                        "à ciel ouvert"
                    ]
                },
                {
                    "sense_id": "c1f72384-9b5e-3f9a-a529-b242913220c1",
                    "sense_definition": "Demeure de Dieu, des anges et séjour éternel des bienheureux après la mort.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans leurs prières, les fidèles espèrent que les âmes des défunts montent au <w>ciel</w>."
                        },
                        {
                            "text": "Les croyants espèrent trouver la paix éternelle au <w>ciel</w> après leur vie terrestre."
                        }
                    ],
                    "antonyms": [
                        "terre"
                    ],
                    "common_phrases": [
                        "monter au ciel"
                    ]
                },
                {
                    "sense_id": "d950795a-661a-3fe5-84bd-91a73b16899c",
                    "sense_definition": "La puissance divine personnifiée, la Providence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Espérons que le <w>Ciel</w> entende nos prières et accorde enfin la paix à notre peuple."
                        },
                        {
                            "text": "Le <w>Ciel</w> a voulu que nous arrivions à temps pour éviter cette terrible catastrophe."
                        }
                    ],
                    "common_phrases": [
                        "grâce au ciel",
                        "juste ciel"
                    ]
                },
                {
                    "sense_id": "f61de78e-dc32-3e09-913a-d3304d3176b0",
                    "sense_definition": "Climat propre à un pays ou région considérée par son atmosphère.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après sa retraite, il a choisi de vivre sous d'autres <w>cieux</w> au bord de la mer."
                        },
                        {
                            "text": "Cette plante tropicale a beaucoup de mal à s'adapter sous un tel <w>ciel</w> hivernal."
                        }
                    ],
                    "common_phrases": [
                        "changer de ciel",
                        "sous d'autres cieux"
                    ]
                },
                {
                    "sense_id": "6e76e378-dd69-302b-9389-a894cdab6fd1",
                    "sense_definition": "Châssis ou armature fixé au-dessus d'un lit pour y suspendre des tentures ou des rideaux.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La chambre d'amis abrite un magnifique meuble ancien surmonté d'un <w>ciel</w> en dentelle blanche."
                        },
                        {
                            "text": "Elle a confectionné un élégant <w>ciel</w> de lit pour décorer la chambre de sa fille."
                        }
                    ],
                    "synonyms": [
                        "ciel de lit",
                        "dais"
                    ],
                    "common_phrases": [
                        "ciel de lit"
                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "129d4247-af90-342f-b0a7-e2b087d4331f",
                    "sense_definition": "Exclamation servant à exprimer l'étonnement, l'inquiétude, l'effroi ou l'indignation.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ciel</w> ! Comment as-tu pu oublier un rendez-vous aussi important pour notre projet commun ?"
                        },
                        {
                            "text": "<w>Ciel</w> ! Que vois-je à travers la brume qui s'avance vers le village endormi ?"
                        }
                    ],
                    "common_phrases": [
                        "juste ciel"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "af6e73f6-9bc4-3a4f-a59c-447306963ebf",
                    "sense_definition": "D'une couleur bleu clair évoquant celle d'un temps ensoleillé sans nuages.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle portait une superbe robe en soie d'un ton <w>ciel</w> parfaitement assorti à ses yeux."
                        },
                        {
                            "text": "Pour la tapisserie du salon, ils ont choisi une nuance <w>ciel</w> particulièrement reposante."
                        }
                    ],
                    "synonyms": [
                        "bleu ciel"
                    ],
                    "common_phrases": [
                        "bleu ciel"
                    ]
                }
            ]
        }
    ]
}