{
    "word_family": [
        "candor",
        "candidly",
        "candidness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b677e470-9490-3c1c-85fa-f37bb59b91ec",
                    "sense_definition": "Straightforward, open, and sincere in expression.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "honesty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would appreciate your <w>candid</w> opinion on this matter even if it is difficult to hear.",
                            "target_lang_translations": {
                                "ru": "Я был бы признателен за ваше <w>откровенное</w> мнение по этому вопросу, даже если его будет трудно услышать.",
                                "pl": "Doceniłbym twoją <w>szczerą</w> opinię w tej sprawie, nawet jeśli trudno byłoby ją usłyszeć."
                            }
                        },
                        {
                            "text": "The CEO was praised for being <w>candid</w> about the company's financial struggles during the meeting.",
                            "target_lang_translations": {
                                "ru": "Генерального директора похвалили за то, что он был <w>честен</w> в отношении финансовых трудностей компании во время встречи.",
                                "pl": "Prezes został pochwalony za bycie <w>otwartym</w> w kwestii problemów finansowych firmy podczas spotkania."
                            }
                        }
                    ],
                    "synonyms": [
                        "frank",
                        "sincere",
                        "straightforward",
                        "unreserved"
                    ],
                    "antonyms": [
                        "evasive",
                        "insincere",
                        "guarded"
                    ],
                    "common_phrases": [
                        "candid opinion",
                        "candid conversation",
                        "candid feedback"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прямолинейный, открытый и искренний в выражении своих мыслей.",
                        "pl": "Bezpośredni, otwarty i szczery w wyrażaniu swoich myśli."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "откровенный",
                                "target_lang_sense_clarification": "искренний и прямой"
                            },
                            {
                                "target_lang_word": "искренний",
                                "target_lang_sense_clarification": "выражающий подлинные чувства"
                            },
                            {
                                "target_lang_word": "прямой",
                                "target_lang_sense_clarification": "говорящий правду без утайки"
                            },
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "правдивый"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "szczery",
                                "target_lang_sense_clarification": "wyrażający prawdziwe uczucia"
                            },
                            {
                                "target_lang_word": "otwarty",
                                "target_lang_sense_clarification": "mówiący bez ogródek"
                            },
                            {
                                "target_lang_word": "bezpośredni",
                                "target_lang_sense_clarification": "mówiący prawdę prosto w oczy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dde8fc77-7bb4-367c-b14d-02c1a54a0fa0",
                    "sense_definition": "Not posed or rehearsed; captured naturally without the subject's knowledge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer managed to capture a <w>candid</w> moment of the couple laughing together.",
                            "target_lang_translations": {
                                "ru": "Фотографу удалось запечатлеть <w>естественный</w> момент, когда пара смеялась вместе.",
                                "pl": "Fotografowi udało się uchwycić <w>niepozowany</w> moment, w którym para śmiała się razem."
                            }
                        },
                        {
                            "text": "She prefers a <w>candid</w> shot over a formal portrait because it feels more authentic.",
                            "target_lang_translations": {
                                "ru": "Она предпочитает <w>непостановочный</w> снимок официальному портрету, потому что он кажется более подлинным.",
                                "pl": "Woli <w>zdjęcie sytuacyjne</w> od formalnego portretu, ponieważ wydaje się ono bardziej autentyczne."
                            }
                        }
                    ],
                    "synonyms": [
                        "unposed",
                        "spontaneous",
                        "natural"
                    ],
                    "antonyms": [
                        "posed",
                        "staged",
                        "rehearsed"
                    ],
                    "common_phrases": [
                        "candid shot",
                        "candid photo",
                        "candid moment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непостановочный или нерепетированный; запечатленный естественно, без ведома объекта съемки.",
                        "pl": "Niepozowany lub nieprzygotowany; uchwycony w sposób naturalny, bez wiedzy fotografowanej osoby."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непостановочный",
                                "target_lang_sense_clarification": "о фотографии или моменте"
                            },
                            {
                                "target_lang_word": "естественный",
                                "target_lang_sense_clarification": "непринужденный"
                            },
                            {
                                "target_lang_word": "спонтанный",
                                "target_lang_sense_clarification": "незапланированный"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepozowany",
                                "target_lang_sense_clarification": "o zdjęciu lub momencie"
                            },
                            {
                                "target_lang_word": "naturalny",
                                "target_lang_sense_clarification": "spontaniczny, niewymuszony"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "58872ba4-b45f-3dbe-97b9-286ed06beeab",
                    "sense_definition": "Impartial and free from prejudice or bias.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "impartiality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee provided a <w>candid</w> assessment of the project's potential for success.",
                            "target_lang_translations": {
                                "ru": "Комитет представил <w>беспристрастную</w> оценку потенциала успеха проекта.",
                                "pl": "Komitet przedstawił <w>bezstronną</w> ocenę potencjału sukcesu projektu."
                            }
                        },
                        {
                            "text": "It is difficult to find a <w>candid</w> judgment in such a politically charged environment.",
                            "target_lang_translations": {
                                "ru": "Трудно найти <w>непредвзятое</w> суждение в такой политически накаленной обстановке.",
                                "pl": "Trudno o <w>obiektywny</w> osąd w tak naładowanym politycznie środowisku."
                            }
                        }
                    ],
                    "synonyms": [
                        "impartial",
                        "unbiased",
                        "unprejudiced",
                        "objective",
                        "dispassionate"
                    ],
                    "antonyms": [
                        "biased",
                        "prejudiced",
                        "partial"
                    ],
                    "common_phrases": [
                        "candid judgment",
                        "candid assessment"
                    ],
                    "target_lang_definitions": {
                        "ru": "Беспристрастный и свободный от предубеждений или предвзятости.",
                        "pl": "Bezstronny i wolny od uprzedzeń lub stronniczości."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "беспристрастный",
                                "target_lang_sense_clarification": "объективный"
                            },
                            {
                                "target_lang_word": "непредвзятый",
                                "target_lang_sense_clarification": "без заранее сложившегося мнения"
                            },
                            {
                                "target_lang_word": "объективный",
                                "target_lang_sense_clarification": "основанный на фактах"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "bezstronny",
                                "target_lang_sense_clarification": "obiektywny"
                            },
                            {
                                "target_lang_word": "obiektywny",
                                "target_lang_sense_clarification": "oparty na faktach, nie na emocjach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cae710d5-f233-3e59-9185-9dc82e892081",
                    "sense_definition": "Characterized by a bright or pure white color.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "color",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poet described the <w>candid</w> lilies blooming in the moonlight.",
                            "target_lang_translations": {
                                "ru": "Поэт описал <w>белоснежные</w> лилии, цветущие в лунном свете.",
                                "pl": "Poeta opisał <w>śnieżnobiałe</w> lilie kwitnące w świetle księżyca."
                            }
                        },
                        {
                            "text": "The ancient marble statues retained a <w>candid</w> glow despite the passage of centuries.",
                            "target_lang_translations": {
                                "ru": "Древние мраморные статуи сохранили <w>сияющую</w> белизну, несмотря на прошедшие века.",
                                "pl": "Starożytne marmurowe posągi zachowały <w>lśniąco biały</w> blask mimo upływu wieków."
                            }
                        }
                    ],
                    "synonyms": [
                        "white",
                        "bright",
                        "snowy"
                    ],
                    "antonyms": [
                        "dark",
                        "black"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used primarily in older literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Характеризующийся ярким или чистым белым цветом.",
                        "pl": "Charakteryzujący się jasnym lub czystym białym kolorem."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "белоснежный",
                                "target_lang_sense_clarification": "чисто-белый"
                            },
                            {
                                "target_lang_word": "сияющий",
                                "target_lang_sense_clarification": "ярко-белый"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "śnieżnobiały",
                                "target_lang_sense_clarification": "czysto biały"
                            },
                            {
                                "target_lang_word": "lśniąco biały",
                                "target_lang_sense_clarification": "o bardzo jasnym odcieniu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f79e8b3c-5a20-3891-a43a-5f380b99e67e",
                    "sense_definition": "A spontaneous or unposed photograph.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "photography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wedding album was filled with beautiful <w>candids</w> of the guests dancing.",
                            "target_lang_translations": {
                                "ru": "Свадебный альбом был полон прекрасных <w>случайных снимков</w> танцующих гостей.",
                                "pl": "Album ślubny był pełen pięknych <w>zdjęć sytuacyjnych</w> tańczących gości."
                            }
                        },
                        {
                            "text": "He is famous for taking <w>candids</w> that reveal the true personality of his subjects.",
                            "target_lang_translations": {
                                "ru": "Он знаменит тем, что делает <w>живые фото</w>, раскрывающие истинную личность его героев.",
                                "pl": "Jest znany z robienia <w>naturalnych zdjęć</w>, które ujawniają prawdziwą osobowość fotografowanych osób."
                            }
                        }
                    ],
                    "synonyms": [
                        "snapshot"
                    ],
                    "antonyms": [
                        "portrait"
                    ],
                    "common_phrases": [
                        "collection of candids"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спонтанная или непостановочная фотография.",
                        "pl": "Spontaniczna lub niepozowana fotografia."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "случайный снимок",
                                "target_lang_sense_clarification": "непостановочное фото"
                            },
                            {
                                "target_lang_word": "живое фото",
                                "target_lang_sense_clarification": "естественный кадр"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zdjęcie sytuacyjne",
                                "target_lang_sense_clarification": "niepozowane ujęcie"
                            },
                            {
                                "target_lang_word": "fotografia reporterska",
                                "target_lang_sense_clarification": "naturalne ujęcie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}