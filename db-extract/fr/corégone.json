                        "target_lang_word": "сиг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сиг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "40f13304-2afc-359b-afaf-8e5458d202b8",
                                        "entry_id": "44dab48d-4370-3cdf-a58d-9a0a491feaec",
                                        "glosses": [
                                            "устар. прыг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c16aa8b-867f-4946-b4cc-f607e55a1856",
                                                "sense_id": "40f13304-2afc-359b-afaf-8e5458d202b8",
                                                "text": "Шага два сделал, ― она сиг через барана!"
                                            },
                                            {
                                                "example_id": "f64cd416-3203-444a-b397-252c7046de24",
                                                "sense_id": "40f13304-2afc-359b-afaf-8e5458d202b8",
                                                "text": "Бросились, конечно, все по сараям, а в этот самый момент мои босячки сгрудились ― сиг через забор, и тёку."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "сиг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "1fac6840-aa59-3e59-a77c-eddcc85a3763",
                                        "entry_id": "e18bf1b6-e766-3de4-8100-d2426f224dc8",
                                        "glosses": [
                                            "форма родительного падежа единственного числа существительного сига"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "сиг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c6edf383-7326-3070-90ae-9476434dc8fe",
                                        "entry_id": "46c4cb60-0daf-358b-a8bd-662a2737e414",
                                        "glosses": [
                                            "ихтиол. северная пресноводная промысловая рыба семейства лососёвых (Coregonus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b1fb32-1af1-447e-baa2-48f6724262c6",
                                                "sense_id": "c6edf383-7326-3070-90ae-9476434dc8fe",
                                                "text": "― Сиг не может на крючок пойматься, сигов сетью ловят."
                                            },
                                            {
                                                "example_id": "c955190b-a034-4200-8530-750f811cacbd",
                                                "sense_id": "c6edf383-7326-3070-90ae-9476434dc8fe",
                                                "text": "В озере водятся довольно разнообразные рыбы: окунь, щука, сорога, сиг, язь."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c9619d7-ae99-3079-a393-1d0bd9e642ea",
                                        "entry_id": "46c4cb60-0daf-358b-a8bd-662a2737e414",
                                        "glosses": [
                                            "кулин., гастрон. мясо такой рыбы, употребляемое в пищу; также кушанье из такого мяса"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c82caae-99aa-4c26-8371-11f47eef820c",
                                                "sense_id": "4c9619d7-ae99-3079-a393-1d0bd9e642ea",
                                                "text": "Когда приготовляется пирог с сигом, то из отрезанной головы, хвоста и вынутых костей можно сварить 1-2 стакана хорошей ухи к завтраку."
                                            },
                                            {
                                                "example_id": "cf113d2d-13a5-449b-9e2e-0336f8d7c862",
                                                "sense_id": "4c9619d7-ae99-3079-a393-1d0bd9e642ea",
                                                "text": "Громадный жирный копчёный сиг, бледно-розовая сёмга, нарезанная тонкими ломтями, белые грибы в соусе, сосиски, ветчина покрывали стол."
                                            }
