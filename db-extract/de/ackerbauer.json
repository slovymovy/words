                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb1996c1-abf2-4167-b349-612830fd2baf",
                        "source_entry_id": "c5aab100-9320-3ae8-a356-20ef2488ad8c",
                        "source_sense_id": "fdce8190-546c-341d-99a2-e23ffa7bbfc9",
                        "source_sense_description": "Bauer, der Feldfrüchte anbaut",
                        "target_lang_word": "земледелец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "земледелец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6c758d96-9e41-3356-ae07-c779b1320604",
                                        "entry_id": "44fba57f-3bf5-3010-aad0-62d59513158c",
                                        "glosses": [
                                            "человек, занимающийся сельским хозяйством, обрабатывая землю и выращивая полезные растения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76f45c03-7d19-4b54-b4dd-87a0d6cbf11f",
                                                "sense_id": "6c758d96-9e41-3356-ae07-c779b1320604",
                                                "text": "Но друг мой, ведая, что высшая власть недостаточна в силах своих на претворение мнений мгновенно, начертал путь по временным законоположениям к постепенному освобождению земледельцев в России."
                                            },
                                            {
                                                "example_id": "2461ddaa-1b37-43f5-a1e6-4511382a9aca",
                                                "sense_id": "6c758d96-9e41-3356-ae07-c779b1320604",
                                                "text": "Земледельцы и доднесь между нами рабы; мы в них не познаем сограждан нам равных, забыли в них человека."
                                            },
                                            {
                                                "example_id": "fa52fe4c-33ae-474b-827a-52de0ec24bad",
                                                "sense_id": "6c758d96-9e41-3356-ae07-c779b1320604",
                                                "text": "Современный земледелец уже стремится теперь сам сделать себе почву и не зависеть ни от засух, ни даже, до некоторой степени, от климата, так как можно согревать вокруг молодого растения и воздух и почву."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
