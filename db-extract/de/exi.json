                "senses": [
                    {
                        "sense_id": "0db7246d-dd74-3a52-8964-d32a3e5f1266",
                        "entry_id": "360b9ce9-a39b-37e8-899d-4ca6336850ef",
                        "glosses": [
                            "A member of a German existentialist youth subculture in the 1960s."
                        ],
                        "tags": [
                            "historical",
                            "informal",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "352e0572-0db1-4285-a3fe-ff9046f4b504",
                                "sense_id": "0db7246d-dd74-3a52-8964-d32a3e5f1266",
                                "text": "Die Gruppe hatte sich diesen Abend vorgenommen, \"Exis\" (bürgerliche Nichtrocker) zu \"ticken\"."
                            },
                            {
                                "example_id": "9ae8e670-b062-4279-8360-a7c7831b7950",
                                "sense_id": "0db7246d-dd74-3a52-8964-d32a3e5f1266",
                                "text": "Dieses Leben drehte sich natürlich auch um die in der Elterngeneration verhasste Rockmusik, um Rebellion und vor allen Dingen um Abgrenzung zu den \"Exis\", den Existentialisten – zur Not auch mit Körpereinsatz. \"Exis\" besuchten meist die Oberschule, hörten Jazz und lasen Camus. Mit der Zeit wurde \"Exi\" jedoch zu einem Sammelbegriff für all jene, die nicht dem Rockermilieu angehörten."
                            }
                        ]
                    }
