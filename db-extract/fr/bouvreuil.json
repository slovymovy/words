        "fr-extract.jsonl": [
            {
                "entry_id": "e7cb8c1b-86e2-30e7-be0d-160d8646b576",
                "word": "bouvreuil",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dc592225-0c99-4936-9675-1b259380bd57",
                        "entry_id": "e7cb8c1b-86e2-30e7-be0d-160d8646b576",
                        "tags": [
                            "plural"
                        ],
                        "form": "bouvreuils"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "348ebab1-b0de-30ae-a561-3d2e491ad13a",
                        "entry_id": "e7cb8c1b-86e2-30e7-be0d-160d8646b576",
                        "glosses": [
                            "Petit passereau d'Eurasie ou des Açores, voisin des pinsons, au bec gros et court, dont le plumage est de plusieurs couleurs (ailes et queue noires, croupion blanc), et qui chante assez agréablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aedd8830-e37b-439d-9b3e-f8bb3fd95bca",
                                "sense_id": "348ebab1-b0de-30ae-a561-3d2e491ad13a",
                                "text": "Et mon amie au chardonneret était difforme, et mon amie au bouvreuil était phtisique."
                            },
                            {
                                "example_id": "9d36fd63-15ef-476f-8f4d-733d1d5f1d52",
                                "sense_id": "348ebab1-b0de-30ae-a561-3d2e491ad13a",
                                "text": "Pour la vie… comme deux bouvreuils ! ajoute en souriant la dugazon, qui n’a point oublié que ces oiseaux sont cités pour la fidélité de leurs amours."
                            },
                            {
                                "example_id": "ab59f556-ea96-4c0a-9390-67454a12e114",
                                "sense_id": "348ebab1-b0de-30ae-a561-3d2e491ad13a",
                                "text": "Alors que ces jeunes oiseaux ne peuvent pas apprendre des chants qui sont très différents de celui de leur espèce, d’autres oiseaux, comme le bouvreuil, peuvent apprendre le chant d’espèces très différentes."
                            },
                            {
                                "example_id": "6bdd4153-1deb-43f5-a172-1c7c4e957723",
                                "sense_id": "348ebab1-b0de-30ae-a561-3d2e491ad13a",
                                "text": "Dans la pénombre, sous les branches des grands conifères, le passage des petits amoureux inquiète la mésange noire, le bec-croisé et le bouvreuil."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "07c65b15-a95e-4773-acc4-5ec30853253a",
                        "source_entry_id": "e7cb8c1b-86e2-30e7-be0d-160d8646b576",
                        "source_sense_id": "348ebab1-b0de-30ae-a561-3d2e491ad13a",
                        "target_lang_word": "Gimpel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gimpel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d69d651-a3c9-3e0e-912c-8ec651ae577c",
                                        "entry_id": "7a5c32e9-b062-3e2f-9858-58f887c45ab3",
                                        "glosses": [
                                            "Vogelart aus der Familie der Finken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5e12d84-a36d-4622-9a15-d0446fe52b5a",
                                                "sense_id": "2d69d651-a3c9-3e0e-912c-8ec651ae577c",
                                                "text": "Der Gimpel saß auf einem Zweig und flötete eine schöne Melodie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9a0e0a92-c72a-3052-ae3c-73d203e09687",
                                        "entry_id": "7a5c32e9-b062-3e2f-9858-58f887c45ab3",
                                        "glosses": [
                                            "einfältiger Mensch"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e29df0b6-b38c-4b25-9d73-accd38c4eea5",
                                                "sense_id": "9a0e0a92-c72a-3052-ae3c-73d203e09687",
                                                "text": "So einfältig kann nur ein Gimpel sein."
                                            },
                                            {
                                                "example_id": "82238b18-cfa9-45ec-8dc2-d3c58d5efb50",
                                                "sense_id": "9a0e0a92-c72a-3052-ae3c-73d203e09687",
                                                "text": "Diesem Schwindler konnte nur ein Gimpel auf den Leim gehen."
                                            },
                                            {
                                                "example_id": "051c8737-6d07-4660-987c-15f38fc4702f",
                                                "sense_id": "9a0e0a92-c72a-3052-ae3c-73d203e09687",
                                                "text": "„Ich wollte nicht, daß sie mich für einen Gimpel hielt; außerdem war sie eine Frau, für die man hunderttausend Scudi gezahlt hatte und die einen denkenden Menschen reizen mußte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a56486cc-b739-30c1-a832-3b902dfab4f3",
                                        "entry_id": "7a5c32e9-b062-3e2f-9858-58f887c45ab3",
                                        "glosses": [
                                            "knollige rote Nase"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e81e06d3-8daf-40e2-8c8c-976478cf9f59",
                                                "sense_id": "a56486cc-b739-30c1-a832-3b902dfab4f3",
                                                "text": "Er ist ein Säufer, sieh nur im Gesicht seinen mächtigen Gimpel."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2a174412-f44d-338a-babb-d1a504689501",
                                        "entry_id": "7a5c32e9-b062-3e2f-9858-58f887c45ab3",
                                        "glosses": [
                                            "Bräutigam, Werber, Brautwerber"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74d36c66-e32f-460f-a96f-29ded35a21cc",
                                                "sense_id": "2a174412-f44d-338a-babb-d1a504689501",
                                                "text": "Der Gimpel ist schon wieder auf der Suche nach einem Mädchen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "a5c6e41c-73af-30fd-98da-01778b0b79ec",
                                        "entry_id": "7a5c32e9-b062-3e2f-9858-58f887c45ab3",
                                        "glosses": [
                                            "Gymnasiast"
                                        ],
                                        "tags": [
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79998b5c-4882-4019-becd-e5a27906879f",
                                                "sense_id": "a5c6e41c-73af-30fd-98da-01778b0b79ec",
                                                "text": "Hat es der Gimpel auch endlich zum Abitur geschafft."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
