                ],
                "senses": [
                    {
                        "sense_id": "239aeec8-8b41-3c70-a1ff-529321ad5979",
                        "entry_id": "02cbc05a-0dc2-3d52-8272-13d5773f4c45",
                        "glosses": [
                            "kleines Dorf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab172b9c-fa55-4c9e-8b29-164e11a7e87b",
                                "sense_id": "239aeec8-8b41-3c70-a1ff-529321ad5979",
                                "text": "Wir haben in einem urigen Dörfchen Ferien gemacht."
                            },
                            {
                                "example_id": "5d08deb7-857a-42a7-8c5d-b91301f418d6",
                                "sense_id": "239aeec8-8b41-3c70-a1ff-529321ad5979",
                                "text": "„Das Dörfchen ist von Feldern umgeben.“"
                            },
                            {
                                "example_id": "3de4a7a0-0cc5-402c-9d67-d73256f3282d",
                                "sense_id": "239aeec8-8b41-3c70-a1ff-529321ad5979",
                                "text": "„Am Abend des Tages, an dem wir Sir George Prevost begegneten, gingen wir durch ein Dörfchen und übernachteten direkt dahinter.“"
                            },
                            {
                                "example_id": "4813715f-d0f2-4ba8-89b8-1fa298b5c94a",
                                "sense_id": "239aeec8-8b41-3c70-a1ff-529321ad5979",
                                "text": "„Rechterhand, jenseits einer steilen Schlucht sah man ein kleines Dörfchen und ein bescheidenes Herrenhaus mit zerstörten Dächern.“"
                            },
                            {
                                "example_id": "50766270-e29f-4b25-aee9-b5ea32ca5b3d",
                                "sense_id": "239aeec8-8b41-3c70-a1ff-529321ad5979",
                                "text": "„Die außerordentliche Reinlichkeit des Dörfchens war nicht weniger bemerkenswert und trug viel dazu bei, den günstigen Eindruck zu vermehren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
