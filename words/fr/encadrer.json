                    "sense_id": "2ad0940d-393d-3162-8752-6d65b941904b",
                    "sense_definition": "Mettre un tableau, une photographie ou une estampe dans un cadre.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "J'ai choisi une belle affiche et je vais la faire <w>encadrer</w> pour mon salon."
                        },
                        {
                            "text": "Elle a soigneusement <w>encadré</w> le premier dessin de sa petite fille."
                        }
                    ],
                    "common_phrases": [
                        "faire encadrer une photo",
                        "faire encadrer un tableau"
                    ]
                },
                {
                    "sense_id": "b2d6a3c4-ee62-3ac2-aaac-6727b63a2075",
                    "sense_definition": "Guider, diriger ou surveiller un groupe de personnes pour veiller à son bon fonctionnement.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Trois animateurs expérimentés suffisent pour <w>encadrer</w> les enfants pendant cette sortie."
                        },
                        {
                            "text": "Ce professeur réputé <w>encadre</w> plusieurs doctorants dans leurs travaux de recherche."
                        }
                    ],
                    "common_phrases": [
