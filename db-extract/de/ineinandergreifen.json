                ],
                "senses": [
                    {
                        "sense_id": "5842d6d5-c176-3491-ac29-bfb1b754c3cf",
                        "entry_id": "9b6b3b2c-49c5-3488-9a67-1cebca6dc26c",
                        "glosses": [
                            "sich durch Bewegung miteinander so verbinden, dass eine neue Funktion entsteht (beispielsweise Zahnräder zu einer Unter-/Übersetzung, einem Getriebe oder einer Uhr)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9329445-19f5-4286-8854-170d70212ca4",
                                "sense_id": "5842d6d5-c176-3491-ac29-bfb1b754c3cf",
                                "text": "„Lässt man verschieden große Zahnräder ineinandergreifen, so kann man damit die Drehzahl und die übertragene Kraft verändern.“"
                            },
                            {
                                "example_id": "1ddebf7c-e843-4841-a62c-2ca18ed70ca9",
                                "sense_id": "5842d6d5-c176-3491-ac29-bfb1b754c3cf",
                                "text": "„Ein Falzziegel ist ein Dachziegel mit einer sogenannten Verfalzung (Rippen und Nuten), mit der die Ziegel nur an ihren Rändern ineinandergreifen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                        "entry_id": "9b6b3b2c-49c5-3488-9a67-1cebca6dc26c",
                        "glosses": [
                            "gegenseitig/wechselseitig aufeinander wirken"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "1a8d8c7c-2e61-4421-94cd-835b068496f5",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "Vieles muss für eine funktionierende und pünktliche Bahn ineinandergreifen: Züge, Stellwerke, Stromproduktion, Personal- und Wartungspläne etc. etc."
                            },
                            {
                                "example_id": "bb507122-ba29-4d35-8b4b-5255cd8f11f0",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "Die Autoren beschreiben, wie die pakistanische Außen- und Innenpolitik ineinandergreifen […]."
                            },
                            {
                                "example_id": "c45d6fa2-5e35-4797-a4e3-68e425250550",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "„Wie viele Rädchen und Faktoren [für die Verfügbarkeit von Waren im Supermarkt] da ineinandergreifen – Einkauf, Logistik, Warenverfügbarkeit, Marketing – versteht man erst, wenn man in der Branche arbeitet.“"
                            },
                            {
                                "example_id": "8d7ae7d3-5907-41ec-a408-b4e2dc4f9bd1",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "Stefan Aust […] baut jetzt auch WeltN24 um. Bis zu 50 Stellen fallen weg. Print, Online und Fernsehen sollen künftig besser ineinandergreifen."
                            },
                            {
                                "example_id": "13268a83-3cb2-4623-b7ca-eec2ddc82087",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "Die Gefahren […] lauern in der Art und Weise, wie die Komponenten eines Systems ineinandergreifen."
                            },
                            {
                                "example_id": "309ab048-5dd6-482c-9b0e-47da2f936df0",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "Das neue Tunesien: das große Experiment. Die erste Demokratie in einem arabischen Staat. Ein Muster in der arabischen Welt, ein Vorbild dafür, wie islamische Werte und demokratische Regeln ineinandergreifen können – so sieht Präsident Marzouki sein Land."
                            },
                            {
                                "example_id": "a66cf4da-bd0f-4638-9ff9-02efc7349de5",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "[TV-Serien:] […] Die Fabel wird nicht mehr im Loop und auch nicht linear erzählt, sondern zahlreiche Vor- und Rückblenden sorgen dafür, dass Vergangenheit und Gegenwart ineinandergreifen."
                            },
                            {
                                "example_id": "8ed6ac5b-f18d-475f-b7c3-208cf2e4d300",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "Ungläubig blickt der Erzähler auf seine Jugend zurück, in der jüdisches und amerikanisches Leben reibungslos ineinandergriffen […]"
                            },
                            {
                                "example_id": "a4a2d7fc-6750-4b36-b0ed-bda86124ba79",
                                "sense_id": "3365b735-8c48-3506-a507-d8ec666d99c9",
                                "text": "[Es] gibt bis heute zwar das schöne Wort vom vernetzten Ansatz, aber kein umfassendes Konzept, wie man Diplomatie, militärische Möglichkeiten und friedenserhaltende Instrumente so verbindet, dass sie ineinandergreifen und nicht immer wieder gegeneinander ausgespielt zu werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
