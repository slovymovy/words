                "senses": [
                    {
                        "sense_id": "3311ce62-db00-31d9-a279-d033b0d52858",
                        "entry_id": "8c2a25cb-779d-3b62-aa74-2e28086af89f",
                        "glosses": [
                            "iranische Sprache, die vor allem in Pakistan, aber auch in Teilen des Irans sowie Afghanistans vom Volk der Belutschen gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e4f2fd-35bc-4f1b-bf56-7ba66910a96d",
                                "sense_id": "3311ce62-db00-31d9-a279-d033b0d52858",
                                "text": "„[…] im Jahr 1990 ist eine Kommission zusammengetreten, um eine Standardisierung des Baluchi, das vormals in der dem Baluchi ähnlichen persischen Schrift geschrieben wurde bzw. auch noch weiterhin wird, vorzunehmen.“"
                            },
                            {
                                "example_id": "36954dd8-88e1-4d86-a3c3-6416e57f7222",
                                "sense_id": "3311ce62-db00-31d9-a279-d033b0d52858",
                                "text": "„Die Verständigung – wie hier in ländlichen Gegenden – erfolgt fast ausnahmslos über Zeichensprache, da wir ebenso wenig Urdu oder Baluchi verstehen, wie die Einheimischen mit Englisch vertraut sind.“"
                            },
                            {
                                "example_id": "7ee84a70-df7d-463c-911a-25ca683e358e",
                                "sense_id": "3311ce62-db00-31d9-a279-d033b0d52858",
                                "text": "„Die sog. Regionalsprachen Punjabi, Sindhi, Pashtu und Baluchi gehen fließend ineinander über, es gibt viele mehrsprachige Gebiete;“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4562748c-bf8e-4bbd-8408-3648b887b6e0",
