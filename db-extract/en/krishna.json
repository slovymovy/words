                                "target_senses": [
                                    {
                                        "sense_id": "b6d1913f-68ac-38f2-ba03-408b4a73017d",
                                        "entry_id": "5a862f20-e9b8-3a92-9cc5-ee08992bcff5",
                                        "glosses": [
                                            "Divinité importante de l’hindouisme, huitième avatar (incarnation) de Vishnou, divinité suprême à l’origine de toutes les autres, instructeur universel."
                                        ],
                                        "tags": [
                                            "Divinité"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e47f675d-530a-4558-a28a-b78bf78eadc7",
                                                "sense_id": "b6d1913f-68ac-38f2-ba03-408b4a73017d",
                                                "text": "Dans le Mahabharata, poème épique de l’Inde ancienne, il est raconté que Krishna fut blessé à la guerre, en combattant contre le roi Shishupal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a0734b1-97e0-44ad-898d-cbf1c2f7242b",
                        "source_entry_id": "3a288aa2-3bb3-3c33-9da9-83b8c77b9ec2",
                        "source_sense_description": "avatar",
                        "target_lang_word": "Krishna",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krishna",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cede623f-0aa1-3535-9905-9ed177704f82",
                                        "entry_id": "db773a45-0843-3370-a09f-a7f5826574b4",
                                        "glosses": [
                                            "Inkarnation (Avatar) des hinduistischen Gottes Vishnu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a2e675d-37ef-4c0f-98ae-484db7f32950",
                                                "sense_id": "cede623f-0aa1-3535-9905-9ed177704f82",
                                                "text": "Für seine Anhänger ist Krishna die Manifestation des Höchsten."
                                            },
                                            {
                                                "example_id": "7e06711c-e017-4f77-8a79-6dc191072bc8",
                                                "sense_id": "cede623f-0aa1-3535-9905-9ed177704f82",
                                                "text": "„Hier wurde ein Verwandter Krishnas geboren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3929ad0b-4a57-4920-b972-1a9cec6f1686",
                        "source_entry_id": "3a288aa2-3bb3-3c33-9da9-83b8c77b9ec2",
                        "source_sense_description": "avatar",
                        "target_lang_word": "Kryszna",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kryszna",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "7f89e209-7cf9-3277-8aa2-e8a7817bec09",
                                        "entry_id": "20471822-0d4f-3ddc-aff0-2d53e800bd04",
                                        "glosses": [
                                            "Bóg w hinduizmie, ósmy awatar Wisznu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e8982ed-ec2f-4b9a-ba31-6f9ea0402637",
                                                "sense_id": "7f89e209-7cf9-3277-8aa2-e8a7817bec09",
                                                "text": "U krysznaitów Kryszna należy do panteonu bóstw hinduizmu. Jest jednym z wcieleń i imion boga Wisznu. Był i pozostał uosobieniem piękna oraz dobra."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5fbcd1ff-2d5e-46d2-b6a2-b096c8dfadc9",
                        "source_entry_id": "3a288aa2-3bb3-3c33-9da9-83b8c77b9ec2",
                        "source_sense_description": "avatar",
                        "target_lang_word": "Кри́шна",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Кри́шна",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "6847eb19-3818-329f-9cd4-52f0599d0a0b",
                                        "entry_id": "cdc578c5-f39b-306f-b16a-835b82345dd8",
                                        "glosses": [
                                            "религ. божество в индуизме, почитаемое как одно из воплощений (аватар) бога Вишну"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99be2da7-cdca-46a7-92b1-028bc65cf8bf",
                                                "sense_id": "6847eb19-3818-329f-9cd4-52f0599d0a0b",
                                                "text": "В «Бхагавадгите» — религиозно-философском наставлении Кришны (земное воплощение бога Вишну) Арджуне — эпическому герою — в момент перед началом битвы двух враждующих кланов, в драматические минуты, когда перед героем встаёт во всей беспощадной обнажённости вопрос о жизни и смерти, о смысле и сути бытия, Кришна объясняет различие между истинным бытием и земным миром."
                                            },
                                            {
                                                "example_id": "574491b9-b327-4df7-8326-5478862c047b",
                                                "sense_id": "6847eb19-3818-329f-9cd4-52f0599d0a0b",
                                                "text": "Седьмой аватарой считается раджа Рама, герой эпоса «Рамаяна», восьмой аватарой был Кришна, который участвовал в борьбе арийских племен, а девятой аватарой считается Будда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00e695f1-5030-33ac-8142-531be0e02996",
                                        "entry_id": "cdc578c5-f39b-306f-b16a-835b82345dd8",
                                        "glosses": [
                                            "мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b127ecd6-3201-4507-8bae-17d865a2e4a0",
                                                "sense_id": "00e695f1-5030-33ac-8142-531be0e02996",
                                                "text": "Между тем этот раджа, Кришна Бахадур, очень чисто говорит по-английски."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d783d64-d44b-3861-bca0-423d67fbb83a",
                                        "entry_id": "cdc578c5-f39b-306f-b16a-835b82345dd8",
                                        "glosses": [
                                            "фамилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6099f74-7f24-4591-a9b5-a498808aa6ff",
                                                "sense_id": "9d783d64-d44b-3861-bca0-423d67fbb83a",
                                                "text": "Безумный поэт Дивана (артист Манмохан Кришна) читает нараспев прекрасные стихи, написанные Сардаром Джафри."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc3a633f-92d0-3f60-ad9c-52515d244633",
                                        "entry_id": "cdc578c5-f39b-306f-b16a-835b82345dd8",
                                        "glosses": [
                                            "геогр. название реки на юго-востоке полуострова Индостан"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe6fd08-959f-45ff-b4d7-a3a2a7ad1078",
                                                "sense_id": "cc3a633f-92d0-3f60-ad9c-52515d244633",
                                                "text": "Река Кришна впадает в Бенгальский залив Индийского океана."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
