                "senses": [
                    {
                        "sense_id": "adb987f6-a48f-3d91-8234-bce4d7ff9930",
                        "entry_id": "dc198541-e449-3ead-bca1-faa49fb63497",
                        "glosses": [
                            "Prénom féminin français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a9585fe-63e1-4d5e-9bae-26368b26e6f3",
                                "sense_id": "adb987f6-a48f-3d91-8234-bce4d7ff9930",
                                "text": "Il l’entraîna, il fallut que Jacques s’approchât, saluât Séverine, gênée, souriante de son air d’enfant peureux."
                            },
                            {
                                "example_id": "809bc78c-46cd-43de-b54c-887379a8066e",
                                "sense_id": "adb987f6-a48f-3d91-8234-bce4d7ff9930",
                                "text": "Séverine Le Prigent-Coatmellec, infirmière et pratiquante de yoga depuis vingt-cinq ans, reprend la suite des cours de hatha yoga de sa professeur, Marie-Catherine Beuzit, à la salle communale de Penzé, à partir du 12 septembre 2022."
                            },
                            {
                                "example_id": "856a0393-3052-4794-8842-609d5ef54e6b",
                                "sense_id": "adb987f6-a48f-3d91-8234-bce4d7ff9930",
                                "text": "« Bien sûr que je vais gâter notre Poupette, car elle fait partie de notre famille », assure Séverine, qui a répondu à notre appel à témoignages."
                            }
                        ]
                    }
