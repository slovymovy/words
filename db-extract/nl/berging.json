                        "examples": [
                            {
                                "example_id": "ad253214-ab0a-43da-bb69-2afda3a88988",
                                "sense_id": "fecf8ae0-0bea-3bf8-a7bf-abcf1f31bcc9",
                                "text": "We hadden de caravan voor de winter in de berging gezet."
                            },
                            {
                                "example_id": "5b355b24-79a5-470e-b14c-dcc830d62b5b",
                                "sense_id": "fecf8ae0-0bea-3bf8-a7bf-abcf1f31bcc9",
                                "text": "Meedogenloos laat hij zijn ex-fiets wegroesten voor mijn huis. Elke keer als ik onderweg door e-bikers word ingehaald, stel ik me hún ex-fiets voor. Afgedankt en alleen, ergens in een berging of voortuin, alsof ze geen dienst meer deden."
                            }
                        ]
                    }
                ],
