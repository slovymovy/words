                        "cross_references": [
                            {
                                "target_word": "whose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "073ae5b8-54f1-38f7-94ef-bb55295a25a8",
                                        "entry_id": "3465146b-5885-36d6-bfe3-a4720c5c76e4",
                                        "glosses": [
                                            "Of whom, belonging to whom; which person's or people's."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2d0b695-975d-4201-b1b8-35bf109fef69",
                                                "sense_id": "073ae5b8-54f1-38f7-94ef-bb55295a25a8",
                                                "text": "Whose (wallet) is this?"
                                            },
                                            {
                                                "example_id": "31b7802d-b295-4f3b-9e87-cfbd9e9c5ffb",
                                                "sense_id": "073ae5b8-54f1-38f7-94ef-bb55295a25a8",
                                                "text": "We should buy a house. ~ With whose money?"
                                            },
                                            {
                                                "example_id": "bc1e3e9d-4c21-44d4-b4dd-ce349e43a9cc",
                                                "sense_id": "073ae5b8-54f1-38f7-94ef-bb55295a25a8",
                                                "text": "For whose benefit are you acting.?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "252afa10-5344-36b4-a4f7-21b1c6da6bbb",
                                        "entry_id": "3465146b-5885-36d6-bfe3-a4720c5c76e4",
                                        "glosses": [
                                            "Of whom, belonging to whom."
                                        ],
                                        "tags": [
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec34f077-7c29-4754-a445-47d1ec3df5fa",
                                                "sense_id": "252afa10-5344-36b4-a4f7-21b1c6da6bbb",
                                                "text": "This is the man whose dog caused the accident."
                                            },
                                            {
                                                "example_id": "badf3381-7a3d-47c3-851f-2543fc4a39f3",
                                                "sense_id": "252afa10-5344-36b4-a4f7-21b1c6da6bbb",
                                                "text": "Venus, whose sister is Serena, won the latest championship."
                                            },
                                            {
                                                "example_id": "6f60b789-4c0f-442f-b833-918fb52acf1b",
                                                "sense_id": "252afa10-5344-36b4-a4f7-21b1c6da6bbb",
                                                "text": "I dedicate this award to my parents, without whose help I wouldn't have made it this far."
                                            },
                                            {
                                                "example_id": "20ec27f0-e645-4b62-8bfa-86275dcdc78c",
                                                "sense_id": "252afa10-5344-36b4-a4f7-21b1c6da6bbb",
                                                "text": "The victim was a youngster, both of whose eyes were missing."
                                            },
                                            {
                                                "example_id": "821b7118-7abb-4046-a8c9-4ecfe79a0441",
                                                "sense_id": "252afa10-5344-36b4-a4f7-21b1c6da6bbb",
                                                "text": "He asked whose the umbrella was."
                                            },
                                            {
                                                "example_id": "d6fd6110-ca0a-4db0-b5d4-ac92eab09752",
                                                "sense_id": "252afa10-5344-36b4-a4f7-21b1c6da6bbb",
                                                "text": "The most rapid and most seductive transition in all human nature is that which attends the palliation of a ravenous appetite.[…]Can those harmless but refined fellow-diners be the selfish cads whose gluttony and personal appearance so raised your contemptuous wrath on your arrival?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e43905ff-defc-352b-a773-b39e54cc209e",
                                        "entry_id": "3465146b-5885-36d6-bfe3-a4720c5c76e4",
                                        "glosses": [
                                            "Of which, belonging to which."
                                        ],
                                        "tags": [
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e38e59c-ce8c-414d-9fc7-d402974713d8",
                                                "sense_id": "e43905ff-defc-352b-a773-b39e54cc209e",
                                                "text": "We saw several houses whose roofs were falling off."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "whose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9604e800-cf8c-32b7-9965-5615aa31c8b5",
                                        "entry_id": "df838524-4d9c-3d72-9892-207895c51ec5",
                                        "glosses": [
                                            "That or those of whom or belonging to whom."
                                        ],
                                        "tags": [
                                            "interrogative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b2d36d-e34a-43c6-876b-8b42b8847c46",
                                                "sense_id": "9604e800-cf8c-32b7-9965-5615aa31c8b5",
                                                "text": "Several people have lost their suitcases. Whose have you found?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7260c6b1-b35a-3ff3-9fec-512f8aa82d38",
                                        "entry_id": "df838524-4d9c-3d72-9892-207895c51ec5",
                                        "glosses": [
                                            "That or those of whom or belonging to whom."
                                        ],
                                        "tags": [
                                            "relative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b031b13c-e1a9-44fd-a0d3-c6b5397f80ca",
                                                "sense_id": "7260c6b1-b35a-3ff3-9fec-512f8aa82d38",
                                                "text": "This car is blocking the way, but Mr Smith, whose it is, will be here shortly."
                                            },
                                            {
                                                "example_id": "869e1a99-3cbd-4ba2-993a-0cf31f8ec20a",
                                                "sense_id": "7260c6b1-b35a-3ff3-9fec-512f8aa82d38",
                                                "text": "For there stood by me this night the angel of God, whose I am, and whom I serve,"
                                            },
                                            {
                                                "example_id": "7d9ae853-4cf8-48a0-921f-c1228dcdc72d",
                                                "sense_id": "7260c6b1-b35a-3ff3-9fec-512f8aa82d38",
                                                "text": "If he starts it on another man's lands, and kills it there, it belongs to the owner of the land; but if he start game on one man's lands, and pursue it to those of another, and kill it there, it is neither the property of the man on whose lands it is started, nor of him on whose it is killed, but belongs to the killer."
                                            },
                                            {
                                                "example_id": "46222054-7777-41ed-8c70-ceb2bb122bb0",
                                                "sense_id": "7260c6b1-b35a-3ff3-9fec-512f8aa82d38",
                                                "text": "The notes on authors are extremely brilliant and incisive, not always in good perspective and sometimes freaky in their wit, as, for instance, the reference to Mrs. Holmes, of whose books it is said, \"The secret of their long popularity has never been divulged by their readers,\" and Mrs. Harris, of whose it is said, \"To a lively mind they should be conducive of profound sleep,\" which, whatever its faults, is by no means true of \"Rutledge.\""
                                            }
                                        ]
                                    }
                                ]
                            },
