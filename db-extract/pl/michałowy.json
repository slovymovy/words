                        "examples": [
                            {
                                "example_id": "ffc76b13-dcdc-4aad-a178-3e75d21e2a15",
                                "sense_id": "9578c2bb-8ecd-30fa-b3d5-c7efe1ec6de9",
                                "text": "Przed Michałowym domem rosną dwa rosochate orzechy."
                            },
                            {
                                "example_id": "ef5c6ea9-3348-497b-a5b8-fd64064cef5b",
                                "sense_id": "9578c2bb-8ecd-30fa-b3d5-c7efe1ec6de9",
                                "text": "Sąsiadował z Michałową zagrodą z jednej strony i z Maciejowym polem z drugiej."
                            },
                            {
                                "example_id": "c1b09083-6a21-4960-9657-282dec4c5a5e",
                                "sense_id": "9578c2bb-8ecd-30fa-b3d5-c7efe1ec6de9",
                                "text": "Michałowi synowie wyrośli na dorodnych mężczyzn."
                            }
                        ],
