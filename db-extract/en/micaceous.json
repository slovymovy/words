                "senses": [
                    {
                        "sense_id": "9fb99f8d-03c2-3ba3-9a23-d0ae63efd6d4",
                        "entry_id": "eb9f4a85-68eb-3c53-9fa2-c8e12c4c9d92",
                        "glosses": [
                            "Of, pertaining to, consisting of, containing or resembling mica."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08b45386-6393-4f75-9c02-31da487a4d01",
                                "sense_id": "9fb99f8d-03c2-3ba3-9a23-d0ae63efd6d4",
                                "text": "Apart from the two or three bird masks, the only other zoomorphic mask was a wolf frontlet of cedar decorated in micaceous black paint with dentalium teeth, dentalium being an important form of wealth with some of the attributes of a currency."
                            },
                            {
                                "example_id": "f23394de-e4df-4741-9530-eff56a6ddeb7",
                                "sense_id": "9fb99f8d-03c2-3ba3-9a23-d0ae63efd6d4",
                                "text": "Formation of alteration minerals in the host rock during deformation within the shear zone is indicated by the parallel foliation within the secondary micaceous minerals and the unmineralized host schist."
                            },
                            {
                                "example_id": "16915c87-e2ea-4b94-b340-d2145af51a12",
                                "sense_id": "9fb99f8d-03c2-3ba3-9a23-d0ae63efd6d4",
                                "text": "In AD 1500, it would appear, the Apache and Pueblo micaceous pottery traditions were separate, if not independent, developments, and thus both Felipe Ortega and Sharon Dryflower Reyna may be correct."
                            }
                        ]
                    },
                    {
                        "sense_id": "8531e1bd-2ade-3de3-b2aa-f50cabc33e10",
                        "entry_id": "eb9f4a85-68eb-3c53-9fa2-c8e12c4c9d92",
                        "glosses": [
                            "sparkling; brilliant"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d000c751-b3c9-4e16-b9e6-ab17346b794b",
                                "sense_id": "8531e1bd-2ade-3de3-b2aa-f50cabc33e10",
                                "text": "The book review was a micaceous example of perfection."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "330e6f3b-85a2-46bb-aa0e-2477cbb0df72",
                        "source_entry_id": "eb9f4a85-68eb-3c53-9fa2-c8e12c4c9d92",
                        "source_sense_description": "of, pertaining to, consisting of, containing or resembling mica",
                        "target_lang_word": "micacé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "micacé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4dbe5ad6-76fe-3f20-bb64-bc7c60351fc4",
                                        "entry_id": "bfec138c-8844-30af-b515-5216e266d445",
                                        "glosses": [
                                            "Qui est de la nature du mica, qui contient du mica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3df477cb-785e-4361-a4e6-abfbd44af261",
                                                "sense_id": "4dbe5ad6-76fe-3f20-bb64-bc7c60351fc4",
                                                "text": "D’énormes pilastres gris de souris, d’un granit à gros grains micacés comme du sel de cuisine, montent jusqu’aux voûtes peintes à fresque, dont les tons azurés et vaporeux se lient mal avec la couleur froide et pauvre de l’architecture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ec5c34e-85eb-33bd-8038-c1a9e6ea5919",
                                        "entry_id": "bfec138c-8844-30af-b515-5216e266d445",
                                        "glosses": [
                                            "Qui a l’aspect brillant ou pailleté du mica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65acc6eb-7194-4d33-82c5-c7346f39d2b7",
                                                "sense_id": "6ec5c34e-85eb-33bd-8038-c1a9e6ea5919",
                                                "text": "Le coprin micacé croît sous feuillus et sous conifères, en troupes parfois très denses à proximité des souches en voie de pourrissement […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b324b96c-cd2d-3645-8cf0-c95578c18457",
                                        "entry_id": "bfec138c-8844-30af-b515-5216e266d445",
                                        "glosses": [
                                            "Qui a l’aspect brillant ou pailleté du mica."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "848b4ae8-7395-46b9-9737-eacb38c9b2cd",
                                                "sense_id": "b324b96c-cd2d-3645-8cf0-c95578c18457",
                                                "text": "« … Une longue galerie ouverte et ensoleillée, des lits de repos, ton vieux mari couché, emmailloté de couvertures, une atmosphère micacée et brillante, d’une sonorité qui blesse d’abord et qui charme ensuite… un soleil dépouillé et trompeur, froid et doré comme un vin de montagne… »"
                                            },
                                            {
                                                "example_id": "6b335891-8479-44ee-9d58-f565f371e7d1",
                                                "sense_id": "b324b96c-cd2d-3645-8cf0-c95578c18457",
                                                "text": "« Sido » n’avait point sa pareille pour feuilleter, en les comptant, les pelures micacées des oignons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
