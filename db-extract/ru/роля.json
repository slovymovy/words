                            {
                                "example_id": "60559b35-10f3-423d-8c61-a48c0f41e44d",
                                "sense_id": "1ee0ce5a-b7f0-3476-bc8f-f797840bbc8c",
                                "text": "12/23-го поутру был я с визитом у своих банкиров, из коих один в Лейпциге играет первую ролю по своему богатству."
                            },
                            {
                                "example_id": "508bf31d-a8f0-4d34-95f5-8f40dd32a67e",
                                "sense_id": "1ee0ce5a-b7f0-3476-bc8f-f797840bbc8c",
                                "text": "В роле Иоанна есть три главных вида."
                            }
                        ]
                    }
