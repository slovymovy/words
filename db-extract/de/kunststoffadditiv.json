                ],
                "senses": [
                    {
                        "sense_id": "52b148bb-7a47-3a54-99b2-9cecac549926",
                        "entry_id": "3bf95cae-9f61-3e78-9615-7336cd9fd364",
                        "glosses": [
                            "Zusatzstoff in Polymeren zur Abschwächung unerwünschter oder zur Verstärkung erwünschter Eigenschaften"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "837bbb6d-a801-4bf2-9088-e5c1b335b05f",
                                "sense_id": "52b148bb-7a47-3a54-99b2-9cecac549926",
                                "text": "Kunststoffadditive werden den Polymeren in der Regel bei der Kunststoffverarbeitung beigemengt."
                            },
                            {
                                "example_id": "2f372370-561f-4849-8e16-49b148b7282d",
                                "sense_id": "52b148bb-7a47-3a54-99b2-9cecac549926",
                                "text": "„Die in Wesseling produzierten Kunststoffadditive werden als Verarbeitungshilfen oder zur Erhöhung der Schlagfestigkeit von PVC und technischen Kunststoffen eingesetzt.“"
                            },
                            {
                                "example_id": "6dee154a-c811-4caa-89a3-2d3095e2f4d7",
                                "sense_id": "52b148bb-7a47-3a54-99b2-9cecac549926",
                                "text": "„Verarbeitungseigenschaften, mechanische Eigenschaften und die Qualität des Kunststoffes werden durch die Verwendung von BYK Kunststoffadditiven positiv beeinflusst.“"
                            },
                            {
                                "example_id": "8963386b-d28a-413e-a5ed-830ee00f08fe",
                                "sense_id": "52b148bb-7a47-3a54-99b2-9cecac549926",
                                "text": "„Eine Kernkompetenz der MCC-Aktivitäten liegt im Bereich der Kunststoffadditive.“"
                            },
                            {
                                "example_id": "719295df-6419-4768-86c8-029c953b3af5",
                                "sense_id": "52b148bb-7a47-3a54-99b2-9cecac549926",
                                "text": "„Ein drittes reibungsminderndes Kunststoffadditiv im Portfolio des Distributors ist der pulverförmige Schmierstoff Molybdändisulfid (MoS2) von Sumico, Japan, der sich vor allem für Kunststoff/Metall-Paarungen eignet, weil er sich in die Oberfläche des metallischen Gegenlaufpartners einarbeitet und diese glättet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
