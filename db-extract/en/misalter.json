                "senses": [
                    {
                        "sense_id": "a37a3cdd-05a8-3b83-852e-b586213db0f9",
                        "entry_id": "9f98c687-0b2d-3b16-a5b0-e3258d80463e",
                        "glosses": [
                            "To make a change that leaves (something) worse than before."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8f46eed1-9372-4fe4-8c0c-45816141220e",
                                "sense_id": "a37a3cdd-05a8-3b83-852e-b586213db0f9",
                                "text": "These are all, besides those which I fore-specified, which have so \"misaltered\" the liturgy, that it can no more be known to be itself than the strangely-disguised dames which were mentioned in doctor Hall's reproof."
                            },
                            {
                                "example_id": "4fef526a-d724-4c6c-97ea-e4c848787cdf",
                                "sense_id": "a37a3cdd-05a8-3b83-852e-b586213db0f9",
                                "text": "The tailors were busily at work for the men ; fitting and misfitting, altering and misaltering, and making clothes in every possible way except the right one, for right the clothes of man will never be so long as ever they are intended to fit."
                            },
                            {
                                "example_id": "54f3e924-fb27-49f9-a97e-ce3555ca8204",
                                "sense_id": "a37a3cdd-05a8-3b83-852e-b586213db0f9",
                                "text": "A misaltered line is one not altered correctly."
                            }
                        ]
                    }
                ],
