                                        "tags": [
                                            "Marine nationale française"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a39f65f8-e86d-42d6-8c86-194268c0cc59",
                                                "sense_id": "ad1e468d-2752-352d-976c-ec52db37c8eb",
                                                "text": "Le bosco, un vieux second maître, jaillit de l’obscurité, gnome hilare."
                                            }
                                        ]
                                    }
                                ]
