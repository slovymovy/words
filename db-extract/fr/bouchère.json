                                        "entry_id": "d5064f5a-20dd-398e-9ad0-687335f69c99",
                                        "glosses": [
                                            "Frau, die sich mit dem Schlachten von Tieren und der Zubereitung des Fleisches für die Nahrung beschäftigt"
                                        ],
                                        "tags": [
                                            "nord- und mitteldeutsch",
                                            "österreichisch; Berufsbezeichnung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53c73485-89f7-4570-b1ef-c3c638a6b33d",
                                                "sense_id": "f191391e-fe3d-34fb-bcab-7065c0dd3c96",
                                                "text": "Fleisch- und Wurstwaren kaufen wir bei unserer Fleischerin."
                                            },
                                            {
                                                "example_id": "5cd905ef-4d12-4ead-88f9-31aeccb28c2a",
                                                "sense_id": "f191391e-fe3d-34fb-bcab-7065c0dd3c96",
                                                "text": "„Die Schüsseln selbst stehen auf langen mit feinen, weißen Tüchern bedeckten Tischen, hinter denen die zierlich angezogene Fleischerin ihren Platz hat.“"
                                            },
                                            {
                                                "example_id": "fb5e728e-d4ac-48f5-b8fe-e799ab7e8b5b",
                                                "sense_id": "f191391e-fe3d-34fb-bcab-7065c0dd3c96",
                                                "text": "Ulrike Piwonka ist die einzige Metzgerin in Berlin, die die Gesellen- und die Meisterprüfung auf einen Schlag gemacht hat."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
