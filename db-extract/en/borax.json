    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "5bba64b5-b176-3887-941e-86d196c11e24",
                "word": "borax",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "edd5daa6-360b-4e45-8fc7-6a9d7d11532c",
                        "entry_id": "5bba64b5-b176-3887-941e-86d196c11e24",
                        "tags": [
                            "plural"
                        ],
                        "form": "boraxes"
                    },
                    {
                        "form_id": "e1f18350-e82c-438a-b76c-39a36e4eac16",
                        "entry_id": "5bba64b5-b176-3887-941e-86d196c11e24",
                        "tags": [
                            "plural"
                        ],
                        "form": "boraces"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "075c0c8e-543e-317a-82fe-7c054f4c7c7a",
                        "entry_id": "5bba64b5-b176-3887-941e-86d196c11e24",
                        "glosses": [
                            "A white or gray/grey crystalline salt, with a slight alkaline taste, used as a flux, in soldering metals, making enamels, fixing colors/colours on porcelain, and as a soap, etc."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "7f0182f5-7b20-4f60-b14e-17040557cc5e",
                                "sense_id": "075c0c8e-543e-317a-82fe-7c054f4c7c7a",
                                "text": "“The best way to clean the machine is to put a pound of borax and a gallon of vinegar in the machine and run the longest, hottest cycle you have,” he says."
                            }
                        ]
                    },
                    {
                        "sense_id": "3905a625-715b-31d9-8db7-111db4e08bd9",
                        "entry_id": "5bba64b5-b176-3887-941e-86d196c11e24",
                        "glosses": [
                            "The sodium salt of boric acid, Na₂B₄O₇, either anhydrous or with 5 or 10 molecules of water of crystallization; sodium tetraborate."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "094d8e9b-e8b6-32e9-be79-3e739f663a25",
                        "entry_id": "5bba64b5-b176-3887-941e-86d196c11e24",
                        "glosses": [
                            "Cheap or tawdry furniture or other works of industrial design."
                        ],
                        "tags": [
                            "attributive",
                            "sometimes",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a7e5957d-37d0-4a0f-a3ec-279b6ef789e9",
                                "sense_id": "094d8e9b-e8b6-32e9-be79-3e739f663a25",
                                "text": "Furniture isn't made to last thirty years or longer because they took a survey and found that young homemakers like to throw their furniture out and bring in all new, color-coded borax every seven years."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9265d92f-f3e5-4137-aa70-ec2eda873113",
                        "source_entry_id": "5bba64b5-b176-3887-941e-86d196c11e24",
                        "source_sense_description": "crystalline salt",
                        "target_lang_word": "borax",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "borax",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "627e1ebc-7cc8-34b0-8ee9-aead04c2f216",
                                        "entry_id": "812c9087-be3b-30dd-8237-f7a886ba0d27",
                                        "glosses": [
                                            "Tétraborate de sodium hydraté, de formule Na₂B₄O₇·10H₂O. Utilisé pour faciliter la fusion des métaux , comme retardateur de flamme, insecticide et fongicide. On l’a longtemps employé en médecine comme désinfectant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26037d96-df22-461c-a3a1-6ae99ebbef83",
                                                "sense_id": "627e1ebc-7cc8-34b0-8ee9-aead04c2f216",
                                                "text": "Le borax s'est rencontré dans l'île de Ceylan, dans la Tartarie méridionale , en Transylvanie, aux environs d'Halberstad , et en Basse-Saxe. On le trouve très-abondamment dans plusieurs lacs de l'Inde."
                                            },
                                            {
                                                "example_id": "85c7274a-1ca3-4358-8577-d4e970abbbf8",
                                                "sense_id": "627e1ebc-7cc8-34b0-8ee9-aead04c2f216",
                                                "text": "Près de lui, Régine la belle chimiste s’égaye. Sous ses doigts de fée, les dix kilos de pure sont devenus vingt, par l’adlonction de cinq kilos de lactose et cinq de borax."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6033c5e2-23ba-3d8e-a821-cd886d59e1fa",
                                        "entry_id": "812c9087-be3b-30dd-8237-f7a886ba0d27",
                                        "glosses": [
                                            "Minéral composé de tétraborate de sodium hydraté, il cristallise dans le système monoclinique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "859663fa-fc51-47ed-a1c2-84faa3847598",
                                                "sense_id": "6033c5e2-23ba-3d8e-a821-cd886d59e1fa",
                                                "text": "On eut d'abord quelque peine à donner aux cristaux de borax artificiel la grosseur et l'aspect de ceux du borax de Hollande ; le premier, cependant, était en réalité plus beau et plus pur que le second."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
