                        "source_entry_id": "e5ac6d10-9fd6-3044-bc0d-fe6e9501edad",
                        "source_sense_id": "72ff415f-1505-30bc-8d2f-cbd4262234f9",
                        "target_lang_word": "kantien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kantien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce7d6a45-2751-3023-b7cd-43e62278da78",
                                        "entry_id": "c243c60b-2595-39da-970b-f141d06ec48d",
                                        "glosses": [
                                            "Qui découle ou s’apparente à la pensée de Kant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c6fcbc2-4891-4106-b466-15da842746c6",
                                                "sense_id": "ce7d6a45-2751-3023-b7cd-43e62278da78",
                                                "text": "Hier, en France, il fallait être humanitaire, kantien, philosémite. Actuellement, la mode, chez nous, penche vers un christianisme édulcoré."
                                            },
                                            {
                                                "example_id": "b06fd91f-4c75-4abc-b12d-c6017c6a6918",
                                                "sense_id": "ce7d6a45-2751-3023-b7cd-43e62278da78",
                                                "text": "Guillaume met en garde la fonctionnaire que je suis contre le respect absolu de la légalité et l'exigence kantienne d'universaliser son action quelles qu'en soient les circonstances."
                                            },
                                            {
                                                "example_id": "aa5d8a34-f62d-4fc7-a9a8-3a09c23b66a0",
                                                "sense_id": "ce7d6a45-2751-3023-b7cd-43e62278da78",
                                                "text": "– Faut te faire une raison », dit Gabriel dont les propos se nuançaient parfois d’un thomisme légèrement kantien.\nEt, passant sur le plan de la cosubjectivité, il ajouta :\n « Et puis faut se grouiller : Charles attend. »"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "kantien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e734f64-d1e3-340e-b5e5-9320437b0615",
                                        "entry_id": "7b15552b-b1dc-30f0-ba12-ddfc0119d721",
                                        "glosses": [
                                            "Adepte de la pensée de Kant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0456525b-0c0b-4322-b0cf-68d13da03cf6",
                                                "sense_id": "3e734f64-d1e3-340e-b5e5-9320437b0615",
                                                "text": "[…], le philosophe croise des civils allemands qui regardent les captifs comme “une quasi-humanité, une bande de singes”. Seul un chien aboie gaiement devant le cortège : Bobby. Pour lui, écrit Levinas, “nous fûmes des hommes”, des fins en soi ; c’est pourquoi le canidé lui apparaît comme “le dernier kantien de l’Allemagne nazie”."
                                            }
                                        ]
                                    }
                                ]
