                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f3b017eb-95c0-4e82-bfb2-fb24a13da2bd",
                                "sense_id": "c241dc9b-96d2-3774-a280-e07a1146f060",
                                "text": "De schuldencrisis werd door velen als een beangstigende zaak ervaren en dat deed het vertrouwen op de markten allerminst versterken."
                            },
                            {
                                "example_id": "eeac2d3a-69bb-4789-b659-efefa470e8a2",
                                "sense_id": "c241dc9b-96d2-3774-a280-e07a1146f060",
                                "text": "Als lezer zult u zich nu ongetwijfeld afvragen hoe deze misstanden in onze moderne maatschappij in ’s hemelsnaam mogelijk zijn. Het antwoord hierop is zowel simpel als beangstigend: geld."
                            }
                        ]
                    }
