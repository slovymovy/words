                        "glosses": [
                            "Se tranquilliser soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2981baea-918f-44c7-a8a3-a43233aed33c",
                                "sense_id": "daf8f3b9-6aef-3487-b939-7c085cb867a9",
                                "text": "A contrario ceux dont le rassasiement excède les bornes de l’indispensable commettent l’erreur de s’auto-tranquilliser pour détourner de la vérité leur regard (ibid., p. 1007)."
                            },
                            {
                                "example_id": "3a32e8e2-2e2f-459a-af60-112fcad60dec",
                                "sense_id": "daf8f3b9-6aef-3487-b939-7c085cb867a9",
                                "text": "Nous avons besoin de ces deux facultés: pouvoir s’auto-alarmer et s’auto-tranquilliser."
                            }
                        ]
