                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1aa03387-a294-4dc9-bc3c-ab44ea79bef9",
                        "source_entry_id": "4f406d14-59f1-3da0-93b4-a4019e126b6d",
                        "source_sense_id": "1048a269-be6c-3193-90f6-4e6f8c0d1914",
