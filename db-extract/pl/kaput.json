                                    {
                                        "sense_id": "0a172939-8b0d-38c8-92a7-2a620d39a69c",
                                        "entry_id": "a21c377d-de9c-3a7a-8151-163e5afdcddb",
                                        "glosses": [
                                            "Out of order; not working."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "005a58e2-ffdc-449b-bb73-b7668096b0b7",
                                                "sense_id": "0a172939-8b0d-38c8-92a7-2a620d39a69c",
                                                "text": "My car went kaput."
                                            },
                                            {
                                                "example_id": "26e72d6b-51a0-4186-ab4e-ad089c671eec",
                                                "sense_id": "0a172939-8b0d-38c8-92a7-2a620d39a69c",
                                                "text": "His career is kaput."
                                            },
                                            {
                                                "example_id": "5e466198-71da-4b3e-8723-43626e281442",
                                                "sense_id": "0a172939-8b0d-38c8-92a7-2a620d39a69c",
                                                "text": "Her marriage went kaput."
                                            },
                                            {
                                                "example_id": "c939a3c1-1e12-4e33-aba1-9284e4dd39bb",
                                                "sense_id": "0a172939-8b0d-38c8-92a7-2a620d39a69c",
                                                "text": "German propaganda loudspeaker: […] The Statue of Liberty is KAPUT.\n Captain Miller: \"The Statue of Liberty is kaput\" – huh, that's disconcerting."
                                            },
                                            {
                                                "example_id": "e5d94504-0261-4169-a9e3-fdd38b936c56",
                                                "sense_id": "0a172939-8b0d-38c8-92a7-2a620d39a69c",
                                                "text": "In the book, his conclusion is simple: capitalism is kaput, celebrity charity won’t plug holes, revolution is the only solution. Yet it also feels like a bit of a cop-out: he insists all this can be achieved through love, peace and understanding."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "302f9627-ff03-4422-9d45-2180c5ed44a4",
                        "source_entry_id": "2205e0e2-6799-329a-86e8-c343ac5df1e8",
                        "source_sense_id": "2d424d87-1b2e-304f-94ea-3fb5a7cc6f92",
                        "target_lang_word": "kaputt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kaputt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbe80581-2412-3c0f-9235-5db8032705d4",
                                        "entry_id": "5ac1bcc8-beac-3e3a-81ed-0dbe6db21370",
                                        "glosses": [
                                            "in einem schadhaften oder funktionslosen Zustand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a72ad227-cade-4cd9-95bc-9bc9582640f5",
                                                "sense_id": "bbe80581-2412-3c0f-9235-5db8032705d4",
                                                "text": "Die Waschmaschine, die ich eben als „neuwertig“ gekauft habe, ist leider kaputt."
                                            },
                                            {
                                                "example_id": "d19daf2e-f383-4d56-8c2a-346fda202d32",
                                                "sense_id": "bbe80581-2412-3c0f-9235-5db8032705d4",
                                                "text": "Viele Firmen bauen in ihre Produkte \"Sollbruchstellen\" ein: Das Gerät geht nach relativ kurzer Zeit kaputt, der Kunde muss ein neues kaufen."
                                            },
                                            {
                                                "example_id": "1888c51a-69fc-49fa-8c37-61717031261d",
                                                "sense_id": "bbe80581-2412-3c0f-9235-5db8032705d4",
                                                "text": "„Mein einziger Sport-BH ist kaputt, und da die Dessous-Geschäfte momentan geschlossen haben und der Versandhandel nicht liefert, werde ich auch in Zukunft ohne auskommen müssen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7dd26208-b03f-320b-9a81-9e94421dff7e",
                                        "entry_id": "5ac1bcc8-beac-3e3a-81ed-0dbe6db21370",
                                        "glosses": [
                                            "körperlich oder seelisch erschöpft"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf0b140-bc54-4ff2-8508-775b95eccceb",
                                                "sense_id": "7dd26208-b03f-320b-9a81-9e94421dff7e",
                                                "text": "Nach den 42 Kilometern war ich kaputt wie nie zuvor."
                                            },
                                            {
                                                "example_id": "285a5265-58b1-407e-a326-189528d03129",
                                                "sense_id": "7dd26208-b03f-320b-9a81-9e94421dff7e",
                                                "text": "\"Der Eindruck des Holocaust und des Weltkrieges auf die deutschen Juden, die nach Südafrika emigrierten, war derart gewaltig, dass sie emotional erschöpft waren und sich deshalb nicht an politischen Aktivitäten gegen die Apartheid beteiligten\", sagt Newman und erinnert sich an seinen eigenen Vater, der aus Deutschland geflohen ist: \"Danach war er emotional kaputt\"."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b3004d36-f7a1-3199-8297-b78f6fa5ba04",
                                        "entry_id": "5ac1bcc8-beac-3e3a-81ed-0dbe6db21370",
                                        "glosses": [
                                            "menschlich am Ende; wirtschaftlich ruiniert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53bd5e58-ccaf-480d-82db-65d753dd73c6",
                                                "sense_id": "b3004d36-f7a1-3199-8297-b78f6fa5ba04",
                                                "text": "Hier triffst du nur kaputte Typen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "183f8a44-0e47-391c-ae6c-d7f0e85b436f",
                                        "entry_id": "5ac1bcc8-beac-3e3a-81ed-0dbe6db21370",
                                        "glosses": [
                                            "völlig zerrüttet, zerstört"
                                        ],
                                        "tags": [
                                            "Ehe",
                                            "zwischenmenschliche Beziehung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf819437-704d-4d61-a44f-1ab396c6f68d",
                                                "sense_id": "183f8a44-0e47-391c-ae6c-d7f0e85b436f",
                                                "text": "Sie führen eine kaputte Ehe."
                                            },
                                            {
                                                "example_id": "be267ba3-9cb4-4001-acc0-3f58283755e3",
                                                "sense_id": "183f8a44-0e47-391c-ae6c-d7f0e85b436f",
                                                "text": "Die Beziehung ist kaputt gegangen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
