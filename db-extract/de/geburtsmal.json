                "senses": [
                    {
                        "sense_id": "3588af72-5da3-3c89-89ee-e86a96dd1483",
                        "entry_id": "44ab0cc7-939d-3df8-9626-c875f6587bd0",
                        "glosses": [
                            "kleiner, brauner oder schwarzer Fleck auf der Haut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e008cee-c44b-4c7a-9790-4b0ef3324496",
                                "sense_id": "3588af72-5da3-3c89-89ee-e86a96dd1483",
                                "text": "„Ihr fielen die durchweichten schweren Kleider ins Auge, die schiefen Schultern und ein großes fast dreieckiges Mal auf ihrer linken Wange – vermutlich ein Geburtsmal.“"
                            },
                            {
                                "example_id": "49bfa74a-cdc9-4f6b-9d79-4dbec11fd483",
                                "sense_id": "3588af72-5da3-3c89-89ee-e86a96dd1483",
                                "text": "„Die Haut hatte die Farbe von gebleichten Knochen, mit Ausnahme des Bereichs, der von einem weinroten Geburtsmal eingenommen wurde, das am Haaransatz über dem linken Auge begann und sich über die Wange bis zur Oberlippe hinunterzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
