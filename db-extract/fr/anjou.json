                    {
                        "sense_id": "bede2c6b-3b9e-332e-8b35-de921b92be80",
                        "entry_id": "7549e7fd-7bb4-3097-9942-1bba02545d15",
                        "glosses": [
                            "Ancienne province française comprenant une partie de la région actuelle Pays de la Loire."
                        ],
                        "tags": [
                            "toponymic"
                        ],
                        "examples": [
                            {
                                "example_id": "501648a9-106b-465b-b2dd-ea292dfe009c",
                                "sense_id": "bede2c6b-3b9e-332e-8b35-de921b92be80",
                                "text": "La mort d’Aliénor à Fontevraud semble avoir été l’ultime verrou, autant psychologique que politique, qui retenait l’expansion capétienne : deux ans plus tard, Philippe Auguste conquiert la Normandie et, en 1206, l’Anjou."
                            },
                            {
                                "example_id": "2e600beb-8a53-4254-8a87-fb3dde32356f",
                                "sense_id": "bede2c6b-3b9e-332e-8b35-de921b92be80",
                                "text": "L’Anjou regroupe Maine-et-Loire, sud de la Mayenne, sud de la Sarthe, nord de la Vienne, etc., capitale Angers."
                            }
                        ]
                    },
