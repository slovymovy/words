            {
                "entry_id": "94ddad2f-8014-3076-a7e9-f645b9a92dbd",
                "word": "palatalization",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "2db4def6-4649-4350-8ce9-f6e5ca11a924",
                        "entry_id": "94ddad2f-8014-3076-a7e9-f645b9a92dbd",
                        "tags": [
                            "plural"
                        ],
                        "form": "palatalizations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "088d2d77-212f-3e1c-bc32-9512e9f481c0",
                        "entry_id": "94ddad2f-8014-3076-a7e9-f645b9a92dbd",
                        "glosses": [
                            "The state or quality of being palatalized, of pronouncing a sound with the tongue against the palate of the mouth that normally is not."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4b78e8eb-8992-4438-a61a-c8181bb1aa6c",
                                "sense_id": "088d2d77-212f-3e1c-bc32-9512e9f481c0",
                                "text": "The word \"nature\" is commonly pronounced with a palatalization of the letter t to sound like ch."
                            }
                        ]
                    },
                    {
                        "sense_id": "7cabb0e8-4ce6-3380-9bdf-c5405518742e",
                        "entry_id": "94ddad2f-8014-3076-a7e9-f645b9a92dbd",
                        "glosses": [
                            "An instance of pronunciation in which a sound is palatalized."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "313b9957-f9b9-413d-8ffe-1349fba82d3d",
                        "source_entry_id": "94ddad2f-8014-3076-a7e9-f645b9a92dbd",
                        "source_sense_description": "state",
                        "target_lang_word": "palatalisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "palatalisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d15dd3ba-e35e-31f2-9921-3008e16f342a",
                                        "entry_id": "2548f2c3-0e79-324d-bc01-da68f650820c",
                                        "glosses": [
                                            "Modification phonétique dans laquelle un son est produit par une partie plus à l’avant du palais dur que celle utilisée pour le son d’origine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f5d33ed-2c70-4474-a556-3e9089811f20",
                                                "sense_id": "d15dd3ba-e35e-31f2-9921-3008e16f342a",
                                                "text": "La palatalisation d’une consonne, occlusive ou spirante, est l’effet d’un renforcement articulatoire, se traduisant évidemment par une élévation de la langue (muscle élévateurs) ; plus ce renforcement sera énergique, plus cette élévation tendra à s’effectuer à l’endroit le plus élevé, qui est sensiblement à l’aplomb vertical du lieu d’articulation du yod."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29a863b1-183b-4c72-9017-8e43844bb342",
