                                "target_senses": [
                                    {
                                        "sense_id": "c23dc9c3-d0ce-3d77-abde-ce16f97bf6df",
                                        "entry_id": "bf874498-bc04-3ea8-b0a6-a8836aff44d6",
                                        "glosses": [
                                            "A mixture of a metal and a metal oxide capable of producing a thermite reaction, such as aluminium metal and ferric oxide; used in incendiary devices."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e2c5826-a5aa-4e18-8a3c-0b17145cb42c",
                        "source_entry_id": "c198338a-698b-39d1-b8ef-edaffeb79f79",
                        "source_sense_id": "6cec9ab2-b8b4-31dc-8b8a-3ac011c6afe8",
                        "source_sense_description": "Gemisch aus Aluminium und Eisenoxid",
                        "target_lang_word": "thermite",
                        "target_lang_code": "fr",
