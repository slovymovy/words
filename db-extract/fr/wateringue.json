                "senses": [
                    {
                        "sense_id": "36cf7d04-4a23-31d1-9b3f-d9950b66fba4",
                        "entry_id": "d3c00b23-a303-38c4-90e8-c8b5e7dae8cf",
                        "glosses": [
                            "Poldérisation, travaux d’assèchement des terres situées au-dessous du niveau de la mer ; réseau de canaux de drainage (→ voir watergang) mis en place dans le cadre de ces travaux."
                        ],
                        "tags": [
                            "Hydraulique"
                        ],
                        "examples": [
                            {
                                "example_id": "1b3792f2-a4b8-486e-8dc3-05221a83f52c",
                                "sense_id": "36cf7d04-4a23-31d1-9b3f-d9950b66fba4",
                                "text": "Un pays plat, cette terre à blé, à betteraves et à pâturages, coupée de rigoles, de canaux, de watringues […] qui s’étend de Gand à l’embouchure de l’Escaut, et que coupe la frontière hollandaise."
                            },
                            {
                                "example_id": "9f313011-00d5-427e-a7a7-82fa17bb66b1",
                                "sense_id": "36cf7d04-4a23-31d1-9b3f-d9950b66fba4",
                                "text": "Aussi ingénieuses que fragiles, les wateringues sont surtout connues en Belgique et aux Pays-Bas. En France, ce système couvre le triangle Calais - Dunkerque - Saint-Omer, afin de protéger les quelque 450 000 habitants des crues des fleuves Aa et Liane."
                            }
                        ]
                    },
                    {
                        "sense_id": "8633835e-d2c5-37f7-afdd-f88640b227d0",
                        "entry_id": "d3c00b23-a303-38c4-90e8-c8b5e7dae8cf",
                        "glosses": [
                            "Association de propriétaires assurant les frais communs des travaux d’assèchement des terres et l’entretien des canaux de drainage."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "7e30ea11-93a9-4007-acb7-e9bd879b3851",
                                "sense_id": "8633835e-d2c5-37f7-afdd-f88640b227d0",
                                "text": "Le drainage [dans la Plaine maritime belge] est organisé par les wateringues."
                            }
                        ]
                    }
