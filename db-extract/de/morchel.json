                "senses": [
                    {
                        "sense_id": "fdb1cf06-ef11-3a57-9488-87f8c026bda1",
                        "entry_id": "0ef2d699-579a-33db-b946-b84c3e7e648f",
                        "glosses": [
                            "Pilz (mit mehreren Arten, darunter auch Speisepilze)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbe5c98e-e44c-4b0a-841d-4dff4a77ab89",
                                "sense_id": "fdb1cf06-ef11-3a57-9488-87f8c026bda1",
                                "text": "„Zur Vorspeise im traditionellen Värdshuset Lindgården in der Altstadt von Visby werden ein bunter Salat mit Eierschwammerl und geröstetem Elchschinken, außerdem marinierter Gotland-Lachs mit einem milden Senfdressing und Morcheln serviert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4192c33d-b485-46d6-aa2f-2d9f2c4a05d2",
                        "source_entry_id": "0ef2d699-579a-33db-b946-b84c3e7e648f",
                        "source_sense_id": "fdb1cf06-ef11-3a57-9488-87f8c026bda1",
                        "source_sense_description": "Biologie: Pilz (mit mehreren Arten, darunter auch Speisepilze)",
                        "target_lang_word": "morel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6388d7d0-9394-3b05-bf39-89e8564f5083",
                                        "entry_id": "818ca008-2c11-3047-ba00-5c3a202d2e48",
                                        "glosses": [
                                            "A true morel; any of several fungi in the genus Morchella, the upper part of which is covered with a reticulated and pitted hymenium."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "morel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30cd740d-2a24-3f2f-981f-6615c7427c6d",
                                        "entry_id": "6061dcd9-4451-3649-808a-1306eeafa845",
                                        "glosses": [
                                            "Synonym of morello (“type of cherry”)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82226a7-2be1-45a9-878c-4850db20b90e",
                                                "sense_id": "30cd740d-2a24-3f2f-981f-6615c7427c6d",
                                                "text": "The insects which injure the morel cherry-trees so much in Pennsylvania, I perceive, here occasionally act in the same way upon the branches of the wild cherry […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "693c28e4-8778-308c-ad6b-fcc51e9f8e45",
                                        "entry_id": "6061dcd9-4451-3649-808a-1306eeafa845",
                                        "glosses": [
                                            "Certain plants or genera Solanum, Atropa, and Aralia, with dark, cherry-like berries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5de34316-93f6-46f9-a7f8-94c3c3aad3aa",
                                                "sense_id": "693c28e4-8778-308c-ad6b-fcc51e9f8e45",
                                                "text": "It exists in both these plants, but whilst the leaves of the last one contain it in some quantity, none is found in those of the morel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3356779-c9b5-4b27-a72e-c5c7396cf621",
                        "source_entry_id": "0ef2d699-579a-33db-b946-b84c3e7e648f",
                        "source_sense_id": "fdb1cf06-ef11-3a57-9488-87f8c026bda1",
                        "source_sense_description": "Biologie: Pilz (mit mehreren Arten, darunter auch Speisepilze)",
                        "target_lang_word": "morille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "morille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "08f6296f-020c-3135-9833-3d4e5a1902f3",
                                        "entry_id": "db9fda4d-1cb3-3af7-a86e-6680eb363efa",
                                        "glosses": [
                                            "Champignon dont le chapeau a des cavités en alvéoles, au pied lisse et creux, sans anneau, qui pousse au printemps, et qui est comestible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cec36f1-ba08-4531-a2a6-e2cb0aceb28b",
                                                "sense_id": "08f6296f-020c-3135-9833-3d4e5a1902f3",
                                                "text": "Morille jaune."
                                            },
                                            {
                                                "example_id": "11610572-99ff-4d9c-9d3a-7f3cb67882f2",
                                                "sense_id": "08f6296f-020c-3135-9833-3d4e5a1902f3",
                                                "text": "Morille fraîche."
                                            },
                                            {
                                                "example_id": "c10a37de-995e-4a0f-80fe-8d72c15ec5e6",
                                                "sense_id": "08f6296f-020c-3135-9833-3d4e5a1902f3",
                                                "text": "Il ne faut pas confondre les morilles avec les mortelles gyromitres."
                                            },
                                            {
                                                "example_id": "37f9c589-d97b-4951-926d-cfbd10f8e5e8",
                                                "sense_id": "08f6296f-020c-3135-9833-3d4e5a1902f3",
                                                "text": "Il constate que la truffe contient deux fois plus de matières azotées et d’éléments minéraux que la morille et quatre fois plus que le champignon de couche."
                                            },
                                            {
                                                "example_id": "f8914ba9-fc0f-4a32-8889-bf4a4c376e8a",
                                                "sense_id": "08f6296f-020c-3135-9833-3d4e5a1902f3",
                                                "text": "D’autres ne se consomment que jeunes, comme le bolet orangé… ou ne seront comestibles que bien cuits : bolet granulé, armillaire couleur de miel, russule olivacée, shiitakes, morilles, etc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "morille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fe6d9b3-4bb6-3709-b169-3f2ae56a9cda",
                                        "entry_id": "57a5be1f-5460-356b-bb63-f8747d3965f1",
                                        "glosses": [
                                            "Type de caroncule écailleuse que l’on retrouve à la base du bec, sur le front et autour de l’œil de certaines races de pigeons d’élevage (e.g. bagadais, carriers de Perse, etc.), ou chez plusieurs genres de passereaux (e.g. pririts, bagadais, bias, etc. )"
                                        ],
                                        "tags": [
                                            "Colombophilie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec94cf38-71c0-4dd5-89e5-f215249f789d",
                                                "sense_id": "1fe6d9b3-4bb6-3709-b169-3f2ae56a9cda",
                                                "text": "Le Pigeon Turc, Columba carunculata (Col. turcica des auteurs), présente, autour des yeux, un large ruban caronculeux, qui va rejoindre la base du bec ; ses narines sont surmontées d’une très-grosse morille; le rouge, le jaune, le bleuâtre, se montrent sur toutes ces excroissances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "420c7995-6723-3f16-b4b5-6f4fcdff95bf",
                                        "entry_id": "57a5be1f-5460-356b-bb63-f8747d3965f1",
                                        "glosses": [
                                            "Sorte d’outil à main en laiton servant à serrer un taraud, un foret, une fraise, etc., au moyen d’un écrou de serrage ajusté à une pince de type mandrin fixée au bout d’un manche."
                                        ],
