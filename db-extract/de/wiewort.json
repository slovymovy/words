                "senses": [
                    {
                        "sense_id": "675280f0-58ad-341d-b63b-f13846c37c0e",
                        "entry_id": "57f32832-d97d-319e-b89c-f2fd02e1faf2",
                        "glosses": [
                            "deutsche Bezeichnung für Adjektiv; Wortart, welche die Beschaffenheit, den Zustand oder eine Beziehung einer Person, eines Dinges oder einer Sache beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d07172-1c78-41cc-aed5-c6dbea89202b",
                                "sense_id": "675280f0-58ad-341d-b63b-f13846c37c0e",
                                "text": "Der schnelle Läufer. Wiewort in attributiver Verwendung"
                            },
                            {
                                "example_id": "e6e3e7ff-5318-48b2-84bc-0d2e0ff20f36",
                                "sense_id": "675280f0-58ad-341d-b63b-f13846c37c0e",
                                "text": "Der Läufer ist schnell. Wiewort in prädikativer Verwendung"
                            },
                            {
                                "example_id": "0ea01ed1-ad9e-413f-8ab6-d7d6059d83f8",
                                "sense_id": "675280f0-58ad-341d-b63b-f13846c37c0e",
                                "text": "Der Mann läuft schnell. Wiewort in Verwendung als adverbiale Bestimmung"
                            },
                            {
                                "example_id": "4d9a41bb-0215-4c49-b398-c3b62abfe871",
                                "sense_id": "675280f0-58ad-341d-b63b-f13846c37c0e",
                                "text": "Der deutsche Begriff Wiewort bezieht sich darauf, dass man mit \"wie\" nach ihnen fragen kann."
                            }
                        ],
