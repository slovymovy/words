                "senses": [
                    {
                        "sense_id": "aeef6ba2-0cbc-3e12-ab6b-668214885a10",
                        "entry_id": "6e972d29-4d8f-3c65-876b-06f1176c420e",
                        "glosses": [
                            "Lehre von der Bedeutung der Wörter und anderer Einheiten"
                        ],
                        "tags": [
                            "Linguistik/Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "046d73b0-453d-4ffc-b066-51ed99665bc6",
                                "sense_id": "aeef6ba2-0cbc-3e12-ab6b-668214885a10",
                                "text": "„Die Semantik, auch Bedeutungslehre genannt, hat ihre Wurzeln in der Antike, insbesondere in der griechischen Philosophie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "92272edc-68bf-3878-821a-edf15dffa3d3",
                        "entry_id": "6e972d29-4d8f-3c65-876b-06f1176c420e",
                        "glosses": [
                            "die Lehre von der Bedeutung von einfachen und komplexen sprachlichen Zeichen, also Morphemen, Wörtern, Sätzen et cetera"
                        ],
                        "tags": [
                            "Linguistik/Sprachwissenschaft",
                            "speziell Semantik"
                        ],
                        "examples": [
                            {
                                "example_id": "06e922a4-5bc2-4390-8efc-29d3ed4c532d",
                                "sense_id": "92272edc-68bf-3878-821a-edf15dffa3d3",
                                "text": "„Im Bereich der Wortsemantik wird dieser Komplementarität durch die Unterscheidung von Onomasiologie (Bezeichnungslehre) und Semasiologie (Bedeutungslehre) Rechnung getragen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2d3b5bd2-4329-4d44-90eb-2ac3f9c3e5db",
