                "senses": [
                    {
                        "sense_id": "b4150867-3398-37ef-9458-4e0d8a17979c",
                        "entry_id": "b4ecb540-59c8-311b-9041-0baac07ff943",
                        "glosses": [
                            "тот, кто заикается, страдает заиканием"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2221f0c5-864f-414d-9162-4c4ca36cea24",
                                "sense_id": "b4150867-3398-37ef-9458-4e0d8a17979c",
                                "text": "Их навело на это воспоминание об одном свидетеле, который стал заикой и поседел, по его словам, благодаря какой-то страшной минуте."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "de12927a-1183-4c0f-a469-124d02921b0a",
