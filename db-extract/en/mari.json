                    {
                        "sense_id": "5cc06424-00c1-3ef3-9b54-1de481ab69f5",
                        "entry_id": "aaa29224-282e-3068-b63f-073fb5c5cf06",
                        "glosses": [
                            "A female given name from Japanese."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "117a6cce-0f19-4cbf-9f7a-8800a34a743d",
                                "sense_id": "5cc06424-00c1-3ef3-9b54-1de481ab69f5",
                                "text": "Our colleague, Mari Takahashi Parker (1993), compared schools in the United States and in Japan. She found that in the United States, principals tended to feel the weight of just about everything on their shoulders."
                            },
                            {
                                "example_id": "cce6c704-6c17-4844-94b2-b717f6d49995",
                                "sense_id": "5cc06424-00c1-3ef3-9b54-1de481ab69f5",
                                "text": "He hopped across and went to lift Mari, but she shook her head and jumped over [by] herself."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
