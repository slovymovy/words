                                                "example_id": "a41c5214-cfb1-41d5-a354-fb8b592e9b7f",
                                                "sense_id": "fe212963-1e1f-389e-bac1-9475e8be4a11",
                                                "text": "We'll take the scrap to the smelter and get some money for it."
                                            }
