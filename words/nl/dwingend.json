                            }
                        },
                        {
                            "text": "Het behalen van voldoende studiepunten is een <w>dwingende</w> voorwaarde om door te mogen naar het tweede jaar.",
                            "target_lang_translations": {
                                "en": "Obtaining sufficient credits is a <w>mandatory</w> requirement to proceed to the second year."
                            }
                        }
