                "senses": [
                    {
                        "sense_id": "9edf0948-2780-3104-836f-b5df9e25d7d3",
                        "entry_id": "6ca1d436-5b03-3601-90a8-11e806d9bc58",
                        "glosses": [
                            "A manufacturer of weapons, especially of guns."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "753f1569-1359-3f7f-8d6f-9bd7c5f723e2",
                        "entry_id": "6ca1d436-5b03-3601-90a8-11e806d9bc58",
                        "glosses": [
                            "A military specialist in charge of the upkeep of small arms etc."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "84f0928b-94b3-4e7f-9417-02c7fa5b2d97",
                                "sense_id": "753f1569-1359-3f7f-8d6f-9bd7c5f723e2",
                                "text": "The squadron ground crews and armourers set high standards."
                            },
                            {
                                "example_id": "f11e75b0-11be-4af1-baa1-01b7c10e0fb4",
                                "sense_id": "753f1569-1359-3f7f-8d6f-9bd7c5f723e2",
                                "text": "Hannah Gutierrez-Reed, who was in charge of weapons on set as the movie’s armorer and who was also charged with involuntary manslaughter, also had that responsibility, the prosecutors said, as did Dave Halls, the first assistant director, who reached a plea agreement."
                            }
                        ]
                    },
                    {
                        "sense_id": "b9c4e694-b61a-3884-bc31-63a781eed408",
                        "entry_id": "6ca1d436-5b03-3601-90a8-11e806d9bc58",
                        "glosses": [
                            "Someone who makes or repairs armor."
                        ],
                        "tags": [
                            "US",
                            "historical"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "643e4e99-b18f-41e2-a2ae-15ccf6de8d17",
                        "source_entry_id": "6ca1d436-5b03-3601-90a8-11e806d9bc58",
                        "source_sense_description": "manufacturer of weapons",
                        "target_lang_word": "Waffenschmied",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waffenschmied",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57ce27f7-5780-3701-ba38-bf5c559fa47c",
                                        "entry_id": "c30f80e1-686c-3ce0-9324-2d2f0c23b109",
                                        "glosses": [
                                            "Person, die Klingen, Helme, Panzerhemden, Rüstungen (Harnische), Schilde und Feuerwaffen anfertigt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76bc5ecf-f60b-4fd9-831b-a06667ac2fe7",
                                                "sense_id": "57ce27f7-5780-3701-ba38-bf5c559fa47c",
                                                "text": "„Ein Waffenschmied stellt Waffen her, also Dinge, die den höchsten möglichen Belastungen bei minimalem Eigengewicht ausgesetzt sind.“"
                                            },
                                            {
                                                "example_id": "83ed2714-f70b-4b8d-ad40-5c22023dac02",
                                                "sense_id": "57ce27f7-5780-3701-ba38-bf5c559fa47c",
                                                "text": "„Im Dreißigjährigen Krieg haben die Waffenschmiede in Nürnberg Waffen an alle Kriegsparteien geliefert, selbst an die eigenen Feinde, aber immerhin mit Profit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b13d34b-fcea-4122-9f62-a8653c1b2d44",
                        "source_entry_id": "6ca1d436-5b03-3601-90a8-11e806d9bc58",
                        "source_sense_description": "manufacturer of weapons",
                        "target_lang_word": "Büchsenmacher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Büchsenmacher",
