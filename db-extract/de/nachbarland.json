                        ],
                        "form": "das Nachbarland"
                    },
                    {
                        "form_id": "243db254-a981-47f6-9935-701021abc5de",
                        "entry_id": "ec394f88-324e-3d93-a7f0-9d196619cde8",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Nachbarländer"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                        "entry_id": "ec394f88-324e-3d93-a7f0-9d196619cde8",
                        "glosses": [
                            "Staat, der mit einem anderen eine Staatsgrenze teilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74639fd1-79a8-4800-899b-625c6facbfb5",
                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                "text": "Deutschland hat neun Nachbarländer."
                            },
                            {
                                "example_id": "488d1eaa-e05c-4e40-acba-4c3ef3cff96d",
                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                "text": "„Mit solchen und ähnlichen wüsten Drohungen versucht Pjöngjang regelmäßig, sein Nachbarland Südkorea und dessen Verbündete - besonders die USA - einzuschüchtern.“"
                            },
                            {
                                "example_id": "70d0b5c4-0dc6-4361-87a9-fefcd0673f16",
                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                "text": "„Zu den Statistiken aus den Nachbarländern sei angemerkt, dass sie nicht alle vergebenen Vornamen berücksichtigen, sondern nur die Erstnamen beziehungsweise einen Vornamen.“"
                            },
                            {
                                "example_id": "02e28dc4-b080-4a53-8397-2bda6787e3e5",
                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                "text": "„Die Reaktion der Nordvietnamesen bestand darin, dass sie ihre Bemühungen intensivierten, das Nachbarland zu infiltrieren und die kommunistische Bewegung des Landes […] zu schulen.“"
                            },
                            {
                                "example_id": "2059ac58-312c-44ba-a90b-a782c66175d0",
                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                "text": "„Er floh aus dem Nachbarland Eritrea vor dem folternden Diktator Isayas Afewerki.“"
                            },
                            {
                                "example_id": "73f9164a-67b7-4bc0-8c9f-92c591d0591b",
                                "sense_id": "3020a926-ca61-3c8e-9638-767f9ebd4840",
                                "text": "„Seit der Gründung Pakistans nutzte Afghanistan die Paschtunistan-Frage, um in regelmäßigen Abständen die Selbstbestimmung der Paschtunen im Nachbarland zu fordern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
