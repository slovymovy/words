{
    "word_family": [
        "tempt",
        "temptation",
        "tempter",
        "temptress",
        "temptingly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5019085c-658d-36ee-bae8-5349397e2e1f",
                    "sense_definition": "Attractive, appealing, or enticing, making you want to do or have something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chocolate cake on the counter looked incredibly <w>tempting</w> after a long day of work.",
                            "target_lang_translations": {
                                "ru": "Шоколадный торт на прилавке выглядел невероятно <w>соблазнительно</w> после долгого рабочего дня.",
                                "pl": "Ciasto czekoladowe na blacie wyglądało niewiarygodnie <w>kusząco</w> po długim dniu pracy."
                            }
                        },
                        {
                            "text": "It is a <w>tempting</w> offer, but I need to think about the long-term consequences before accepting.",
                            "target_lang_translations": {
                                "ru": "Это <w>заманчивое</w> предложение, но мне нужно подумать о долгосрочных последствиях, прежде чем соглашаться.",
                                "pl": "To <w>kusząca</w> oferta, ale muszę pomyśleć o długoterminowych konsekwencjach przed jej przyjęciem."
                            }
                        }
                    ],
                    "synonyms": [
                        "appealing",
                        "attractive",
                        "inviting",
                        "enticing"
                    ],
                    "common_phrases": [
                        "tempting offer",
                        "tempting prospect"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательный, заманчивый или соблазнительный, вызывающий желание сделать что-то или обладать чем-то.",
                        "pl": "Atrakcyjny, nęcący lub kuszący, sprawiający, że chce się coś zrobić lub posiąść."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблазнительный",
                                "target_lang_sense_clarification": "вызывающий сильное желание"
                            },
                            {
                                "target_lang_word": "заманчивый",
                                "target_lang_sense_clarification": "привлекательный, обещающий выгоду или удовольствие"
                            },
                            {
                                "target_lang_word": "привлекательный",
                                "target_lang_sense_clarification": "вызывающий интерес"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kuszący",
                                "target_lang_sense_clarification": "atrakcyjny, trudny do odrzucenia"
                            },
                            {
                                "target_lang_word": "nęcący",
                                "target_lang_sense_clarification": "pociągający, wzbudzający pożądanie"
                            },
                            {
                                "target_lang_word": "kusicielski",
                                "target_lang_sense_clarification": "pełen pokusy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "076f3858-5080-3cc0-bbbf-32a34bdf3a26",
                    "sense_definition": "Seductive, alluring, or highly inviting in a physical or romantic way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appealing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>tempting</w> perfume that lingered in the room long after she had left.",
                            "target_lang_translations": {
                                "ru": "На ней были <w>соблазнительные</w> духи, аромат которых оставался в комнате еще долго после ее ухода.",
                                "pl": "Użyła <w>uwodzicielskich</w> perfum, które unosiły się w pokoju jeszcze długo po jej wyjściu."
                            }
                        },
                        {
                            "text": "His low, <w>tempting</w> voice made it very difficult for her to focus on the conversation.",
                            "target_lang_translations": {
                                "ru": "Его тихий, <w>манящий</w> голос мешал ей сосредоточиться на разговоре.",
                                "pl": "Jego niski, <w>kusicielski</w> głos bardzo utrudniał jej skupienie się na rozmowie."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tempting look",
                        "tempting smile"
                    ],
                    "target_lang_definitions": {
                        "ru": "Соблазнительный, манящий или очень привлекательный в физическом или романтическом плане.",
                        "pl": "Uwodzicielski, pociągający lub nęcący pod względem fizycznym lub romantycznym."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "соблазнительный",
                                "target_lang_sense_clarification": "физически или романтически привлекательный"
                            },
                            {
                                "target_lang_word": "манящий",
                                "target_lang_sense_clarification": "притягивающий, увлекающий"
                            },
                            {
                                "target_lang_word": "привлекательный",
                                "target_lang_sense_clarification": "располагающий к себе"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kusicielski",
                                "target_lang_sense_clarification": "uwodzicielski, zmysłowy"
                            },
                            {
                                "target_lang_word": "uwodzicielski",
                                "target_lang_sense_clarification": "działający na zmysły"
                            },
                            {
                                "target_lang_word": "kuszący",
                                "target_lang_sense_clarification": "seksowny, pociągający"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f030e579-f522-337b-ba35-ea904e325c8e",
                    "sense_definition": "Present participle and gerund of <w>tempt</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Are you <w>tempting</w> me to break my diet with those delicious cookies?",
                            "target_lang_translations": {
                                "ru": "Ты что, <w>искушаешь</w> меня нарушить диету этими вкусными печеньями?",
                                "pl": "Czy ty mnie <w>kosisz</w> tymi pysznymi ciastkami, żebym złamał dietę?"
                            }
                        },
                        {
                            "text": "By leaving his keys in the car, he was actively <w>tempting</w> fate.",
                            "target_lang_translations": {
                                "ru": "Оставив ключи в машине, он активно <w>испытывал</w> судьбу.",
                                "pl": "Zostawiając kluczyki w samochodzie, z premedytacją <w>kusił</w> los."
                            }
                        }
                    ],
                    "common_phrases": [
                        "tempting fate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола tempt (искушать, соблазнять).",
                        "pl": "Imiesłów czasu teraźniejszego od czasownika 'tempt' (kusić, nęcić)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искушающий",
                                "target_lang_sense_clarification": "подталкивающий к чему-то запретному"
                            },
                            {
                                "target_lang_word": "соблазняющий",
                                "target_lang_sense_clarification": "привлекающий, манящий сделать что-то"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kuszony",
                                "target_lang_sense_clarification": "będący obiektem kuszenia"
                            },
                            {
                                "target_lang_word": "kuszący",
                                "target_lang_sense_clarification": "ten, który kusi; nęcący"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "87cd7a12-2897-3199-bb66-3421a7794fc9",
                    "sense_definition": "The act of subjecting somebody to temptation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old texts warn against the <w>temptings</w> of the material world.",
                            "target_lang_translations": {
                                "ru": "Древние тексты предостерегают от <w>соблазнов</w> материального мира.",
                                "pl": "Dawne pisma przestrzegają przed <w>pokusami</w> świata materialnego."
                            }
                        },
                        {
                            "text": "He resisted the constant <w>temptings</w> of his peers to skip school.",
                            "target_lang_translations": {
                                "ru": "Он сопротивлялся постоянным <w>подстрекательствам</w> сверстников прогулять школу.",
                                "pl": "Opierał się nieustannemu <w>kuszeniu</w> ze strony rówieśników, by iść na wagary."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Mainly found in older religious or literary texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по подверганию кого-либо искушению; соблазнение.",
                        "pl": "Wystawianie kogoś na pokusę; kuszenie, nakłanianie do czegoś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искушение",
                                "target_lang_sense_clarification": "процесс или попытка ввести во грех/соблазн"
                            },
                            {
                                "target_lang_word": "соблазны",
                                "target_lang_sense_clarification": "притягательные вещи или действия, сбивающие с пути"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "kuszenie",
                                "target_lang_sense_clarification": "akt wystawiania na pokusę"
                            },
                            {
                                "target_lang_word": "pokusa",
                                "target_lang_sense_clarification": "to, co nęci i sprowadza na złą drogę"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}