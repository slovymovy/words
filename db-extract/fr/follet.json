            {
                "entry_id": "6aa60a5f-fa3a-3df8-b25f-7008c930969c",
                "word": "follet",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "50600639-af78-4ad4-b5de-904303d18952",
                        "entry_id": "6aa60a5f-fa3a-3df8-b25f-7008c930969c",
                        "tags": [
                            "plural"
                        ],
                        "form": "follets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1653c392-e289-31f4-bf27-4f2c6e9006ed",
                        "entry_id": "6aa60a5f-fa3a-3df8-b25f-7008c930969c",
                        "glosses": [
                            "Sorte de lutin familier qui, selon le préjugé populaire, est plus malin que malfaisant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4443c3f-a2dd-4e62-8ab6-5a1b1c6139aa",
                                "sense_id": "1653c392-e289-31f4-bf27-4f2c6e9006ed",
                                "text": "Un follet qui tressait la crinière des chevaux et qui les pansait pendant la nuit."
                            },
                            {
                                "example_id": "6d1f0854-c6e9-4240-86c3-23a271ce3d31",
                                "sense_id": "1653c392-e289-31f4-bf27-4f2c6e9006ed",
                                "text": "Ici, tu peux boire, parler ou dormir sans terreur, car les follets sont nos amis."
                            },
                            {
                                "example_id": "501ce8ad-7caa-47fd-83fb-40132f18dd92",
                                "sense_id": "1653c392-e289-31f4-bf27-4f2c6e9006ed",
                                "text": "Elle avait eu, dès son enfance, l’esprit trop nourri de croyances merveilleuses, pour ne pas compter sur la connaissance que sa mère lui avait donnée à l’effet de repousser les méchants fadets et les follets pernicieux."
                            }
                        ]
                    },
                    {
                        "sense_id": "84a740d8-b460-36d3-ad6f-fff28daef9c2",
                        "entry_id": "6aa60a5f-fa3a-3df8-b25f-7008c930969c",
                        "glosses": [
                            "Feu follet."
                        ],
                        "tags": [
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "7a7b48d7-6503-4790-b4c4-ca8ecf624fc7",
                                "sense_id": "84a740d8-b460-36d3-ad6f-fff28daef9c2",
                                "text": "La malheureuse lanterne semblait un follet, tant elle s'éloignait rapidement, et tant elle sautait en s'éloignant; […]."
                            }
                        ]
                    }
                ],
