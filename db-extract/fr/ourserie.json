                        "glosses": [
                            "Caractère, acte d’une personne qui vit comme un ours."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2196c4d4-b150-4d59-ba30-f3a8244d3bcc",
                                "sense_id": "01055287-1caa-30ac-a01a-d2b6a7668012",
                                "text": "Je me promets bien que je te ferai repentir de tes ourseries."
                            },
                            {
                                "example_id": "7981203f-d90a-4dc1-a7bc-7a8d8df9cdb6",
                                "sense_id": "01055287-1caa-30ac-a01a-d2b6a7668012",
                                "text": "Becque était un faux ours et un pessimiste en carton-pâte, au lieu que, chez Janvier de la Motte, l’ourserie et le désespoir étaient fonciers."
                            },
                            {
                                "example_id": "7e5cecb9-8a2c-41d5-8485-c86a30a477fa",
                                "sense_id": "01055287-1caa-30ac-a01a-d2b6a7668012",
                                "text": "La sauvagerie, l’ourserie, l’horreur des gens du monde, le goût maladif de la solitude, ce sont des symptômes connus du mal romantique."
                            }
                        ]
                    },
                    {
                        "sense_id": "16c30650-301d-3a70-9e37-6c86224fd947",
                        "entry_id": "67476188-6859-3181-9b46-124921b123eb",
                        "glosses": [
                            "Vilain tour, mauvaise badinerie, taquinerie."
                        ],
