                                            {
                                                "example_id": "b1cd8369-2e11-481d-a327-ae1643b9cb4f",
                                                "sense_id": "3594498d-27d2-352d-babb-fa39011064b7",
                                                "text": "Ce dernier est le seul bassin d’Almérie dont les ressources hydriques sont considérées excédentaires."
                                            },
                                            {
                                                "example_id": "316f1763-6825-4a14-9e6f-29ca483868f2",
                                                "sense_id": "3594498d-27d2-352d-babb-fa39011064b7",
                                                "text": "Joseph est accusé, à la suite d’une incursion des troupes du prince d’Almérie, d’avoir projeté de destituer le sultant Bâdîs pour livrer la ville à al Mu’tasim d’Almérie, la révolte populaire éclate."
                                            },
                                            {
                                                "example_id": "ed8c4a87-459f-487e-96ca-5534e2b7618c",
                                                "sense_id": "3594498d-27d2-352d-babb-fa39011064b7",
                                                "text": "L’Andalousie et l’Université d’Almérie pourraient se convertir en un centre de liaison pour cette recherche internationale et pluridisciplinaire."
                                            },
                                            {
                                                "example_id": "a8152dae-e986-4106-8761-ef74255f7759",
                                                "sense_id": "3594498d-27d2-352d-babb-fa39011064b7",
                                                "text": "Il réunit une première collection de préhistoire catalane, créée par le naturaliste Martorell et Peña, une collection de préhistoire de la province d’Almérie, donnée par Louis et Henri Siret, et d’autres objets qui restèrent à Barcelone à la suite de l’Exposition."
                                            }
