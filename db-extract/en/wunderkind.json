    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "27ca70f6-06e4-360a-8cd5-27b5247fc3ff",
                "word": "wunderkind",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "72c1e8d3-0399-44bd-8442-e9f075341383",
                        "entry_id": "27ca70f6-06e4-360a-8cd5-27b5247fc3ff",
                        "tags": [
                            "plural"
                        ],
                        "form": "wunderkinder"
                    },
                    {
                        "form_id": "527b2bc0-cc83-4984-ac83-19864877de29",
                        "entry_id": "27ca70f6-06e4-360a-8cd5-27b5247fc3ff",
                        "tags": [
                            "plural"
                        ],
                        "form": "wunderkinds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "04403853-94e7-32b0-ac2d-960b6b507370",
                        "entry_id": "27ca70f6-06e4-360a-8cd5-27b5247fc3ff",
                        "glosses": [
                            "A child prodigy; a wonderchild."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a0ed0ac3-ecd6-3aa2-89a9-b59c1462bfcf",
                        "entry_id": "27ca70f6-06e4-360a-8cd5-27b5247fc3ff",
                        "glosses": [
                            "A highly talented or gifted individual, especially one who is successful at a young age."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "515f0d04-78c1-4d16-92c4-08879be21dd5",
                                "sense_id": "a0ed0ac3-ecd6-3aa2-89a9-b59c1462bfcf",
                                "text": "Harriet Pappenheim, a psychotherapist at Park Avenue Relationship Consultants who wrote “For Richer or Poorer,” a 2006 book on money in marriage, said that the repercussions could be acute for Wall Street wunderkinds who define their identities through their job titles and the size of their bonuses."
                            },
                            {
                                "example_id": "25650dbb-a54d-4c23-a887-d72fc1715d1b",
                                "sense_id": "a0ed0ac3-ecd6-3aa2-89a9-b59c1462bfcf",
                                "text": "The downfall of Austria’s onetime political Wunderkind put a spotlight on the cozy, sometimes corrupt, relationship between right-wing populists and parts of the news media."
                            },
                            {
                                "example_id": "a993a3f2-5ed4-45fe-9df5-b42f9146b937",
                                "sense_id": "a0ed0ac3-ecd6-3aa2-89a9-b59c1462bfcf",
                                "text": "When the verdict comes down, the transformation of the wunderkind founder of Theranos from black-clad genius to besuited milquetoast will be an integral part of the story."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ac214d5-9678-4e76-9f95-ae59950c26a2",
                        "source_entry_id": "27ca70f6-06e4-360a-8cd5-27b5247fc3ff",
                        "source_sense_description": "highly talented individual who is successful at a young age",
                        "target_lang_word": "Wunderkind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wunderkind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                        "entry_id": "f2d8f21b-1a38-3a4e-8cc4-9a610175cc02",
                                        "glosses": [
                                            "Kind mit außergewöhnlichen Fähigkeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9676a5f7-c231-4b6f-a211-d75bc10a2e34",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "Mozart war ein musikalisches Wunderkind."
                                            },
                                            {
                                                "example_id": "c7deee01-3e50-455f-b633-6ee48059d5c2",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "„Mit zehn galt er als musikalisches Wunderkind.“"
                                            },
                                            {
                                                "example_id": "ab517510-ce9a-4d72-8781-df25a94ed94d",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "„Alf Bertini war zu einem mittelgroßen Jüngling herangewachsen, der sich nach wie vor für ein Wunderkind hielt.“"
                                            },
                                            {
                                                "example_id": "9a86d560-c264-4b60-b0ac-571c13bd7b55",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "„Das Wunderkind Clara spielte den Gästen auf dem Klavier vor und beeindruckte dabei nicht nur Robert Schumann.“"
                                            },
                                            {
                                                "example_id": "3ffeb7c1-22fa-450b-a826-84efba03ebf8",
                                                "sense_id": "6d34f30d-ba7c-33e0-b0ef-852f4c2e0fb1",
                                                "text": "„Sein Ruf als Wunderkind blieb ihm lange erhalten, die Stadt Chemnitz erteilte ihm mit 17 gar einen öffentlichen Auftrag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ef6b4f8-d08c-4197-80b5-50230c882749",
                        "source_entry_id": "27ca70f6-06e4-360a-8cd5-27b5247fc3ff",
