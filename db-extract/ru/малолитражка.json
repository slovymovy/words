                    {
                        "translation_id": "98b4375c-8dcf-40e2-898b-6b999a3256ce",
                        "source_entry_id": "65681e4a-20f9-3ba2-af16-f29025d23b7c",
                        "source_sense_id": "79b19cec-9082-32af-87ed-fab482f07481",
                        "target_lang_word": "Kleinwagen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinwagen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74e00b40-25dd-3a20-979d-962c4263d156",
                                        "entry_id": "0cbee469-f5bb-3d9f-9be0-82741101dfb3",
                                        "glosses": [
                                            "kleines, aber vollwertiges Automobil mit erschwinglichem Neupreis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "017d9a17-d35a-4c85-a53b-621371e7e4d5",
                                                "sense_id": "74e00b40-25dd-3a20-979d-962c4263d156",
                                                "text": "Ich brauche kein großes Auto, ein schicker Kleinwagen reicht mir vollkommen."
                                            },
                                            {
                                                "example_id": "2d7c4d47-ff83-4d6d-a26d-af2daddeb9f1",
                                                "sense_id": "74e00b40-25dd-3a20-979d-962c4263d156",
                                                "text": "„Meine Mutter blickte dem grünen Kleinwagen meines Vaters nach, mit dem er losgefahren war, als er gesehen hatte, dass sich die Tür öffnet.“"
                                            },
                                            {
                                                "example_id": "32a70af7-e510-4c0f-8ce0-c37919ed9392",
                                                "sense_id": "74e00b40-25dd-3a20-979d-962c4263d156",
                                                "text": "„In diesem Moment wusste ich nicht, ob meine Mitfahrt eine gute Idee gewesen war – um Ben mit meinen warnenden Achtung-Rufen das Leben zu retten – oder eine fürchterliche, weil wir unweigerlich mit diesem britischen Kleinwagen eine tödliche Massenkollision auslösen würden .“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
