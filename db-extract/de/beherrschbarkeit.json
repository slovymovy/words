                    {
                        "sense_id": "1591b845-e28f-3d39-ae6c-bfb4bcc86767",
                        "entry_id": "c9893559-9a18-3265-8d1e-046972bfb837",
                        "glosses": [
                            "die Möglichkeit, etwas oder jemanden zu beherrschen oder beherrschbar zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cd63b96-d066-43b7-8f50-347c2ea99b36",
                                "sense_id": "1591b845-e28f-3d39-ae6c-bfb4bcc86767",
                                "text": "„Im neuen Gerät lassen sich nun Rätsel des Verkehrswesens mit unerreichter Genauigkeit studieren - von den Wirkungen diverser Drogen bis zur Beherrschbarkeit futuristischer Steuertechnik.“"
                            },
                            {
                                "example_id": "15d878f8-f9e4-4fbc-b712-57aae6f81db8",
                                "sense_id": "1591b845-e28f-3d39-ae6c-bfb4bcc86767",
                                "text": "„Die Angst kommt nicht von ungefähr: \"Die Beherrschbarkeit und Kontrolle der Systeme wird immer schwieriger\", sagt Peter Zoche vom Fraunhofer-Institut für Systemtechnik und Innovationsforschung (ISI).“"
                            },
                            {
                                "example_id": "f0d20ad8-12c2-4d12-b53f-172ac5792bd0",
                                "sense_id": "1591b845-e28f-3d39-ae6c-bfb4bcc86767",
                                "text": "„Das Schiffswrack wurde zum Denkmal des Menschheitstraums vom Luxus und von der Beherrschbarkeit jeder Technik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
