                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a94a57f3-8ea4-30f8-8ece-23e29f494180",
                        "entry_id": "3d13a423-0ea4-35b8-af08-6754d303810b",
                        "glosses": [
                            "без эмоций, не испытывая и не проявляя чувств"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad9584eb-3997-46bf-ba06-97fbb57600f0",
                                "sense_id": "a94a57f3-8ea4-30f8-8ece-23e29f494180",
                                "text": "Мы уже думали, подох ты, — равнодушно и незло сказал бесконвойный, стоявший на крыльце больничного барака."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4bb3bf0e-ecea-4d51-a64c-e5d0774bba69",
                        "source_entry_id": "3d13a423-0ea4-35b8-af08-6754d303810b",
                        "source_sense_id": "a94a57f3-8ea4-30f8-8ece-23e29f494180",
                        "target_lang_word": "with indifference",
