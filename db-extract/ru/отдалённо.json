        "ru-extract.jsonl": [
            {
                "entry_id": "8480ebe7-fa12-3890-8634-7a1ac4779cf7",
                "word": "отдалённо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c14fb8a2-ceb9-3f86-ad3b-33bd70f14e55",
                        "entry_id": "8480ebe7-fa12-3890-8634-7a1ac4779cf7",
                        "glosses": [
                            "наречие к отдалённый; на большом расстоянии, с большого расстояния"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "78879420-a6cf-40db-9f50-4787cb612b19",
                                "sense_id": "c14fb8a2-ceb9-3f86-ad3b-33bd70f14e55",
                                "text": "...Никифор Ишутин, присоединяясь к роте своей, шел отдаленно за нею с поля сражения."
                            },
                            {
                                "example_id": "d6f101e1-43b8-47e5-95e4-cdf5a52e7597",
                                "sense_id": "c14fb8a2-ceb9-3f86-ad3b-33bd70f14e55",
                                "text": "Гулко, отдаленно, нереально отозвался голос ведущей."
                            }
                        ]
                    },
                    {
                        "sense_id": "83672622-157f-35eb-a596-abe2011d3dab",
                        "entry_id": "8480ebe7-fa12-3890-8634-7a1ac4779cf7",
                        "glosses": [
                            "перен. не имея прямой, непосредственной связи с кем-либо или с чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbc0a4fa-1976-4381-a4e3-34d897a20f01",
                                "sense_id": "83672622-157f-35eb-a596-abe2011d3dab",
                                "text": "Кстати, ни один палач никогда не заикнется о чем-то, что как-то отдаленно связано с его ремеслом."
                            }
                        ]
                    },
                    {
                        "sense_id": "26b590bc-daf4-3265-8f3e-77a83728b112",
                        "entry_id": "8480ebe7-fa12-3890-8634-7a1ac4779cf7",
                        "glosses": [
                            "лишь отчасти напоминая кого-либо или что-либо (о сходстве)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba0fdd26-041b-479f-88bf-06c953ac81c7",
                                "sense_id": "26b590bc-daf4-3265-8f3e-77a83728b112",
                                "text": "Один был отдаленно похож на колокол, другой на трезубец, третий на веер."
                            }
                        ]
                    },
                    {
                        "sense_id": "d44aac37-ae70-3d4d-8e6d-91c5554ed700",
                        "entry_id": "8480ebe7-fa12-3890-8634-7a1ac4779cf7",
                        "glosses": [
                            "не будучи связанным кровным родством, состоя в дальнем родстве с кем-либо"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3255f3f0-c953-4770-83c8-8d942b90ce3a",
                        "source_entry_id": "8480ebe7-fa12-3890-8634-7a1ac4779cf7",
                        "source_sense_description": "на большом расстоянии, с большого расстояния",
                        "target_lang_word": "remotely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "remotely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64768825-72b0-3b5b-b86b-00fe39656d91",
                                        "entry_id": "c209a6c3-581a-39ea-ac5c-82e461b3c8d8",
                                        "glosses": [
                                            "At a distance, far away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59d094a-1308-41c6-9c2b-b3557ef17415",
                                                "sense_id": "64768825-72b0-3b5b-b86b-00fe39656d91",
                                                "text": "“We have an accommodation and an acceptance that people will work from home one to two days a week,” says McConnell. But some people work remotely more than others, and she’s empowered her management team to make decisions that work for their direct reports."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f56e899-83fc-36f6-b7ec-cb46f621ec8b",
                                        "entry_id": "c209a6c3-581a-39ea-ac5c-82e461b3c8d8",
                                        "glosses": [
                                            "Not much; scarcely; hardly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
