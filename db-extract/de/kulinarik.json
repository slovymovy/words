                                "target_senses": [
                                    {
                                        "sense_id": "80306562-08d3-30bf-aeef-52475979358e",
                                        "entry_id": "f79cc486-d87d-385f-a346-30dbcc3ec566",
                                        "glosses": [
                                            "A characteristic manner or style of preparing food, often associated with a place of origin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f339a3e3-9ac5-4bd2-82a9-ee5b3f5a4439",
                                                "sense_id": "80306562-08d3-30bf-aeef-52475979358e",
                                                "text": "French cuisine is considered to be one of the world's most refined and elegant styles of cooking."
                                            },
                                            {
                                                "example_id": "203342fe-d552-44ad-aa62-6d4705aaf39d",
                                                "sense_id": "80306562-08d3-30bf-aeef-52475979358e",
                                                "text": "The restaurant is noted for its excellent cuisine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8ef336a-cee1-30b2-9253-2eb4abc71e7b",
                                        "entry_id": "f79cc486-d87d-385f-a346-30dbcc3ec566",
                                        "glosses": [
                                            "The food prepared using such style."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3a90304-f17e-4a63-81cd-8403992d0a8a",
                                                "sense_id": "c8ef336a-cee1-30b2-9253-2eb4abc71e7b",
                                                "text": "For example, salsa and pico de gallo from Mexican cuisine sometimes include fruits like peach, mango or pineapple, balancing hot peppers like habanero or jalapeño with their sweetness. […] Cookbooks covering cuisines that feature swicy flavor profiles are a great place to start."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16132f73-8fad-3fd3-8459-948b0c631c96",
                                        "entry_id": "f79cc486-d87d-385f-a346-30dbcc3ec566",
                                        "glosses": [
                                            "Synonym of culinary art: The art of preparing food in general."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ed79fc44-d544-3895-994a-6cca2c2fbd7c",
                                        "entry_id": "f79cc486-d87d-385f-a346-30dbcc3ec566",
                                        "glosses": [
                                            "A kitchen or cooking department."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8c2be35-b023-4af7-83eb-178ac4d0cda7",
                        "source_entry_id": "03db88a5-36b3-3a83-905f-70424ecdb75f",
                        "source_sense_id": "6d8ef790-fd6e-32cc-b738-0a9172c0f701",
                        "source_sense_description": "Kunst der kreativen oder traditionellen Zubereitung von Lebensmitteln",
                        "target_lang_word": "cuisine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuisine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a200ccc7-dc45-39ea-8ce7-0d416f7e9d4b",
                                        "entry_id": "3096f025-ebe3-368a-af4f-02e7b1c3d431",
                                        "glosses": [
                                            "Pièce où l’on prépare et fait cuire les aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a95420cd-8001-47b9-a41f-25818572de70",
                                                "sense_id": "a200ccc7-dc45-39ea-8ce7-0d416f7e9d4b",
                                                "text": "Zaheira disparut vers la cuisine, revint avec des plats alléchants, disposa gentiment l’eau et le pain sur la table."
                                            },
                                            {
                                                "example_id": "3939dbf7-df1f-4a09-8037-55f63a4b4774",
                                                "sense_id": "a200ccc7-dc45-39ea-8ce7-0d416f7e9d4b",
                                                "text": "Gaspard vit avec joie la femme poser une soupière fumante sur la table de la cuisine."
                                            },
                                            {
                                                "example_id": "6be9a081-83b8-4a7c-bf61-8472f8f2a4e4",
                                                "sense_id": "a200ccc7-dc45-39ea-8ce7-0d416f7e9d4b",
                                                "text": "Après avoir calculé le temps nécessaire pour sortir de la cuisine et venir tirer le cordon placé sous la porte, il resonna encore de manière à produire un carillon très significatif."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d106293d-60a3-36df-a962-d1d137a4c5c7",
                                        "entry_id": "3096f025-ebe3-368a-af4f-02e7b1c3d431",
                                        "glosses": [
                                            "Ensemble du personnel travaillant dans cette pièce à l’élaboration des plats."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e4aaa745-0872-3ae2-ba3d-4296280306a8",
                                        "entry_id": "3096f025-ebe3-368a-af4f-02e7b1c3d431",
                                        "glosses": [
                                            "Ensemble d’ustensiles servant à préparer les aliments et qu’on peut transporter d’un lieu dans un autre."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ab4c91c-0516-494c-a803-c0b818a16ec7",
                                                "sense_id": "e4aaa745-0872-3ae2-ba3d-4296280306a8",
                                                "text": "La poussière de craie donnait soif et cet automne était chaud. Je me souviens d’avoir bu un jour peut-être dix quarts de bouillon brûlant pris à la cuisine roulante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39d503f8-360f-356c-b64b-67ddbad5f49d",
                                        "entry_id": "3096f025-ebe3-368a-af4f-02e7b1c3d431",
                                        "glosses": [
                                            "Ordinaire d’une maison, repas qu’on y prépare habituellement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18f8337b-f770-4a06-8a22-a7996a7ff4e4",
                                                "sense_id": "39d503f8-360f-356c-b64b-67ddbad5f49d",
                                                "text": "Cela intéressait vivement notre maître d’hôtel pourtant, car le voici ceint de son blanc tablier, la mine souriante, la bouche en cœur, le visage jambonné par la chaleur des fourneaux et venant connaître notre opinion sur sa cuisine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a533189-5629-3d1a-bb7b-6436f29e02be",
                                        "entry_id": "3096f025-ebe3-368a-af4f-02e7b1c3d431",
                                        "glosses": [
                                            "Action de préparer à manger."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2c37351-b2c1-4917-bb4d-d4008afe5ff1",
                                                "sense_id": "4a533189-5629-3d1a-bb7b-6436f29e02be",
                                                "text": "Mais avec un petit poële net, propre, chauffé par l’électricité et pourvu de thermomètres, avec des températures absolument contrôlables et des écrans protecteurs, la cuisine pourrait devenir une distraction et un amusement même pour les dames âgées ou valétudinaires."
                                            },
                                            {
                                                "example_id": "26a8527c-487c-4d79-8feb-0df9f57ee896",
                                                "sense_id": "4a533189-5629-3d1a-bb7b-6436f29e02be",
                                                "text": "Il me quitte ; il doit acheter du jambon et du vinaigre, car les officiers l’ont naturellement chargé de leur cuisine, comme ils en chargent immanquablement tout professeur, tout prêtre, tout poète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "19c310ad-ba32-3377-8d1e-3412131f735e",
                                        "entry_id": "3096f025-ebe3-368a-af4f-02e7b1c3d431",
                                        "glosses": [
                                            "Art d’apprêter les mets, les aliments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e270dc-e7cc-4a3d-a8fd-08de86f8afbb",
                                                "sense_id": "19c310ad-ba32-3377-8d1e-3412131f735e",
                                                "text": "Ils étaient parfaitement d’accord, surtout sur la nécessité d’appeler toute la pharmacie de la nature au secours de la cuisine. Piments, poudres anglaises, safraniques, substances coloniales, poussières exotiques, tout leur eût semblé bon, voire le musc et l’encens."
                                            },
                                            {
                                                "example_id": "7a40ea03-25e1-4863-ac69-a4cca259142d",
                                                "sense_id": "19c310ad-ba32-3377-8d1e-3412131f735e",
                                                "text": "C’est chez la veuve Thorsdal que j’appris à savourer les délices de la cuisine islandaise. Le dîner se composait invariablement de poisson bouilli."
                                            },
                                            {
                                                "example_id": "c5f023e0-8afb-40e7-a0fb-beb7c37d5f34",
                                                "sense_id": "19c310ad-ba32-3377-8d1e-3412131f735e",
                                                "text": "Au début du XXᵉ siècle, la papesse de la cuisine bourgeoise, la célèbre madame Saint-Ange, écrira avec émotion, à propos d'un plat traditionnel dans les bonnes familles : « […]. »"
                                            },
                                            {
                                                "example_id": "f94ec37a-2b16-4449-a242-baa30f1b7710",
                                                "sense_id": "19c310ad-ba32-3377-8d1e-3412131f735e",
                                                "text": "Fierté des maîtresses de maison formées aux traditions familiales, la blanquette est, révérence gardée, à la cuisine française ce que Molière est au théâtre."
                                            },
                                            {
                                                "example_id": "848e5163-6fd6-4958-bf99-d041f1a2290d",
                                                "sense_id": "19c310ad-ba32-3377-8d1e-3412131f735e",
                                                "text": "La cuisine française, ça me semble vieux et prétentieux, alors que la cuisine japonaise, ça a l’air… eh bien, ni jeune ni vieux. Éternel et divin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c1998689-572f-31cb-9971-ecff6cf38e74",
                                        "entry_id": "3096f025-ebe3-368a-af4f-02e7b1c3d431",
                                        "glosses": [
                                            "Manœuvre ; intrigue."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3e1f3ddc-a69c-4d05-ab35-57a69302101d",
                                                "sense_id": "c1998689-572f-31cb-9971-ecff6cf38e74",
                                                "text": "La cuisine électorale, parlementaire."
                                            },
                                            {
                                                "example_id": "fdaab9f4-bdfc-40ae-b11b-81b7aa5949d6",
                                                "sense_id": "c1998689-572f-31cb-9971-ecff6cf38e74",
                                                "text": "Lorenzo. – Je connais la vie, et c’est une vilaine cuisine, sois-en persuadé."
                                            },
                                            {
                                                "example_id": "e24ce7a9-5700-452a-8cad-76e5271bedf9",
                                                "sense_id": "c1998689-572f-31cb-9971-ecff6cf38e74",
                                                "text": "De même que la jeune femme s’est écartée, un peu écœurée, du tapis vert, de même Michel, pour ces quelques visites avortées, a l’impression de s’être sali les mains à la cuisine littéraire parisienne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cuisine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "91b3074f-096e-3b2f-a278-dcfb57735c66",
                                        "entry_id": "2b4e110c-4779-3c61-918a-44fe53d8e9a2",
                                        "glosses": [
                                            "Première personne du singulier de l’indicatif présent de cuisiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5a1d2901-e4a3-49b8-ae83-794128554151",
                                                "sense_id": "91b3074f-096e-3b2f-a278-dcfb57735c66",
                                                "text": "Je suis boulimique, j’absorbe des tonnes de bonbons, je cuisine plein de gâteaux, des puddings, des fars bretons, des gâteaux de riz, plus c’est compact, plus je me gave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85a5713d-ef1d-34a8-854a-b5a1c95b6987",
                                        "entry_id": "2b4e110c-4779-3c61-918a-44fe53d8e9a2",
                                        "glosses": [
                                            "Troisième personne du singulier de l’indicatif présent de cuisiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2f1fe0-b137-4fd1-9403-086b8c1f1a15",
                                                "sense_id": "85a5713d-ef1d-34a8-854a-b5a1c95b6987",
                                                "text": "Je voulais échapper au réveillon chez ma belle-fille, autant dire à un calvaire, elle cuisine avec ses pieds, même une dinde s’autocuirait mieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ccbf1bb-8bfe-3cad-a712-6606b8b3d178",
                                        "entry_id": "2b4e110c-4779-3c61-918a-44fe53d8e9a2",
                                        "glosses": [
                                            "Première personne du singulier du subjonctif présent de cuisiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "99478258-6c83-30e6-8160-f2bb4d70c321",
                                        "entry_id": "2b4e110c-4779-3c61-918a-44fe53d8e9a2",
                                        "glosses": [
                                            "Troisième personne du singulier du subjonctif présent de cuisiner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
