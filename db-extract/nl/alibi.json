                    {
                        "sense_id": "6e54df98-6ec1-33a9-a395-b29d021189d3",
                        "entry_id": "0517a9a3-cfd7-3dd8-80f3-ad40a3c4d238",
                        "glosses": [
                            "het kunnen aantonen dat men elders was tijdens het zich voltrekken van een misdaad, waardoor men uitgesloten kan worden van beschuldiging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ebb49ab-80bd-4bec-a257-8f065130d85b",
                                "sense_id": "6e54df98-6ec1-33a9-a395-b29d021189d3",
                                "text": "Aan zijn alibi kan niet getornd worden."
                            }
                        ]
                    },
                    {
                        "sense_id": "07305f85-e4bb-333a-8cec-07dc705afb02",
                        "entry_id": "0517a9a3-cfd7-3dd8-80f3-ad40a3c4d238",
