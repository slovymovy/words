                        "entry_id": "3259342a-ad30-3fa5-abf7-978af51d94a2",
                        "glosses": [
                            "An erroneous estimate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d6e454d4-a46f-4673-a34a-c7227b04d560",
                                "sense_id": "7bb0ced7-082d-3255-a9ba-b1acc71d3ddb",
                                "text": "This was due not to pro-German sympathies but to a plain misestimate (not confined to him) of the real relative strengths of the various political forces."
                            },
                            {
                                "example_id": "e6d1f28a-7ffb-4905-9547-5ac020762540",
                                "sense_id": "7bb0ced7-082d-3255-a9ba-b1acc71d3ddb",
                                "text": "To illustrate the nature of this problem, a misestimate of 0.01 on a favorite whose true winning probability is 0.20 is, in percentage terms, quite small compared to a misestimate of 0.01 on a long shot whose true winning probability is 0.04."
                            }
                        ]
                    }
                ],
