                    {
                        "sense_id": "e64c0adf-e894-3f47-8467-88197bc7ceab",
                        "entry_id": "c65fecf4-96ea-336c-bb03-0857fcde8069",
                        "glosses": [
                            "Raum zur Aufbewahrung kleiner Ausstattungsgegenstände [1] für theatrale Aufführungen"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "5f064e28-5e60-426c-b045-ef421244bcd5",
                                "sense_id": "e64c0adf-e894-3f47-8467-88197bc7ceab",
                                "text": "„Ich geh in die Requisite, helfe Louis beim Fertigstellen von einem Bühnenbild.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "27d7c942-9621-3bc7-bf8a-441be0de4000",
                        "entry_id": "c65fecf4-96ea-336c-bb03-0857fcde8069",
                        "glosses": [
                            "Abteilung zur Verwaltung kleiner Ausstattungsgegenstände [1] für theatrale Aufführungen"
                        ],
                        "tags": [
                            "Theater"
                        ],
                        "examples": [
                            {
                                "example_id": "017a8b51-552c-4476-acf5-eee75d62d504",
                                "sense_id": "27d7c942-9621-3bc7-bf8a-441be0de4000",
                                "text": "„So ähnlich war es zuvor dem Leiter der Requisite, dem Bühnenmeister und sogar der Souffleuse ergangen, die in ihrem dunklen Winkel beinahe unsichtbar war.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
