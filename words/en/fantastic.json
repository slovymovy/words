                    "frequency": "Middle",
                    "semantic_group_id": "unbelievable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company made <w>fantastic</w> claims about their product that turned out to be false.",
                            "target_lang_translations": {
                                "ru": "Компания делала <w>невероятные</w> заявления о своем продукте, которые оказались ложными."
                            }
                        },
                        {
                            "text": "It seems <w>fantastic</w> to suggest that the entire project could be finished in one day.",
                            "target_lang_translations": {
                                "ru": "Предположение о том, что весь проект можно завершить за один день, кажется <w>неправдоподобным</w>."
                            }
