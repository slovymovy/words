            {
                "entry_id": "521c1431-4a8d-3d2c-80c3-0361ba1035d3",
                "word": "MHO",
                "pos": "phrase",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a7d22731-3426-3b2f-a18d-dd4ddcf3501e",
                        "entry_id": "521c1431-4a8d-3d2c-80c3-0361ba1035d3",
                        "glosses": [
                            "Initialism of my honest/humble opinion."
                        ],
                        "tags": [
                            "Internet",
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "6c84bc06-0663-4608-a63d-5ba832ae4e37",
                                "sense_id": "a7d22731-3426-3b2f-a18d-dd4ddcf3501e",
                                "text": "However, I was only in town for a few days...so it's only a short-term observation. Just MHO. No offense meant to any T-town natives."
                            },
                            {
                                "example_id": "3268b4f2-e0fd-46a6-a2ce-528f83029c50",
                                "sense_id": "a7d22731-3426-3b2f-a18d-dd4ddcf3501e",
                                "text": "I have no problems with anyone playing a system that they like, EVER! I personally may not like it, but that's MHO, but if other people enjoy it, fine, they can play it."
                            },
                            {
                                "example_id": "8e6c65e5-c969-47ac-a7e4-de08e3ddc710",
                                "sense_id": "a7d22731-3426-3b2f-a18d-dd4ddcf3501e",
                                "text": "Course, obviously they are not the only ones. Some people that irrationally hate the military as a whole *might* just qualify as well. (MHO of course)"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
