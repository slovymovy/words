                                    {
                                        "sense_id": "8265e7c3-7f30-3da6-90ca-99e3e1916f9c",
                                        "entry_id": "077a108f-0413-3663-b441-e6f68523b869",
                                        "glosses": [
                                            "vielfache Schüsse durch Gewehre"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56c4364d-fe54-4f7d-927a-1f8b3d0a8921",
                                                "sense_id": "8265e7c3-7f30-3da6-90ca-99e3e1916f9c",
                                                "text": "„Vorn hatte das Gewehrfeuer fast ganz aufgehört.“"
                                            },
                                            {
                                                "example_id": "2d56063b-0996-417f-b48f-70c622d890ba",
                                                "sense_id": "8265e7c3-7f30-3da6-90ca-99e3e1916f9c",
                                                "text": "„Doch kein feindlicher Soldat trat ihnen entgegen, kein Gewehrfeuer zwang sie, Deckung zu suchen.“"
                                            },
                                            {
                                                "example_id": "edc94edb-df5d-4df4-ba56-f72abd1da9e7",
                                                "sense_id": "8265e7c3-7f30-3da6-90ca-99e3e1916f9c",
                                                "text": "„Unten im Tal, an der Stelle, wo die Parlamentäre herübergekommen waren, erscholl Gewehrfeuer.“"
                                            },
                                            {
                                                "example_id": "a606f597-78a4-4987-8e26-ee39b5d607c4",
                                                "sense_id": "8265e7c3-7f30-3da6-90ca-99e3e1916f9c",
                                                "text": "„Aufgeweckt durch fernes Gewehrfeuer, verkürzten wir uns manchmal die endlose Nacht mit Kartenspielen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "56da9895-32c2-4537-b1b8-cb45226e9c11",
                        "source_entry_id": "b87ebd41-a329-3fe1-b517-7bf571a12f3b",
