                                        "entry_id": "ca7436c1-020c-3e0c-8a01-218cbb305aa3",
                                        "glosses": [
                                            "A basic wooden shingle made from split logs, traditionally used for roofing etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e681cab3-491e-3a90-92a1-f334e2b42926",
                                        "entry_id": "ca7436c1-020c-3e0c-8a01-218cbb305aa3",
                                        "glosses": [
                                            "Instant, second. (Especially in two shakes.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f23af36a-4304-4e81-bcba-b1fd7b67789d",
                                                "sense_id": "e681cab3-491e-3a90-92a1-f334e2b42926",
                                                "text": "“And do you realize that in a few shakes I've got to show up at dinner and have Mrs Cream being very, very kind to me? It hurts the pride of the Woosters, Jeeves.”"
