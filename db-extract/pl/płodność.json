                    {
                        "translation_id": "ebb414fc-31fc-4c7d-a3ff-06115d1a876e",
                        "source_entry_id": "478637f8-7cb3-36e9-af07-19bf9369a883",
                        "source_sense_id": "1531e06d-6477-30ba-9ac3-4c638cce8fcc",
                        "target_lang_word": "Fruchtbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fruchtbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af8e99ea-cec8-3441-a074-71e8f2d44f45",
                                        "entry_id": "95d8c299-d239-332d-a495-80118e38b0c4",
                                        "glosses": [
                                            "Fähigkeit, sich fortzupflanzen; Eigenschaft, ertragreich zu sein, viel hervorzubringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8252973f-87fe-43bb-ab9a-ee3c6da599c6",
                                                "sense_id": "af8e99ea-cec8-3441-a074-71e8f2d44f45",
                                                "text": "„Außerdem gebe es Hinweise, so der Mediziner, dass sich andauernder Stress negativ auf die Fruchtbarkeit von Männern auswirke.“"
                                            },
                                            {
                                                "example_id": "d3d356fa-b604-44a4-b8f4-293bd870dc48",
                                                "sense_id": "af8e99ea-cec8-3441-a074-71e8f2d44f45",
                                                "text": "„Annie Francé-Harrar war Biologin und ihr Forschungsschwerpunkt war Fruchtbarkeit von Böden.“"
                                            },
                                            {
                                                "example_id": "fa8c8cd1-9cb5-43c6-8629-8dbb8c73e79e",
                                                "sense_id": "af8e99ea-cec8-3441-a074-71e8f2d44f45",
                                                "text": "„Bereits die Römer sahen den Hasen als Zeichen der Fruchtbarkeit an, weil er sich so schnell fortpflanzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
