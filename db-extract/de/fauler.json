                ],
                "senses": [
                    {
                        "sense_id": "3ab86d80-7bda-378a-a1f3-a26dddb68ce3",
                        "entry_id": "3c370c43-b9d0-34de-a92f-0d4505cbbbe4",
                        "glosses": [
                            "Person, die faul ist, also nichts tut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8431421b-9b8a-4698-a26a-361784a1e380",
                                "sense_id": "3ab86d80-7bda-378a-a1f3-a26dddb68ce3",
                                "text": "„Die Stiftung Warentest setzt dem ein eigenes Buch entgegen: „Geldanlage für Faule“.“"
                            },
                            {
                                "example_id": "d78e4954-f6b5-4110-a3d4-a6e167a6c8ab",
                                "sense_id": "3ab86d80-7bda-378a-a1f3-a26dddb68ce3",
                                "text": "„Die erklärte Auffassung des FDP-Chefs ist: \"Wir müssen die Schwachen schützen vor den Starken, aber auch vor den Faulen.\"“"
                            },
                            {
                                "example_id": "c14d79ed-d74e-47ab-ac07-a7339d7b4190",
                                "sense_id": "3ab86d80-7bda-378a-a1f3-a26dddb68ce3",
                                "text": "„Ich fahre Zug. […] Ich muss nur schauen und gelegentlich umsteigen. Das ist Wintersport für Faule und umweltschonend auch noch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
