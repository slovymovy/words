                                        "entry_id": "8ec6891c-1089-30c1-a3e6-6c3544055d44",
                                        "glosses": [
                                            "een vorm van Japanse dichtkunst, geschreven in drie regels waarvan de eerste regel 5, de tweede regel 7 en de derde regel weer 5 lettergrepen telt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018dcb2c-aeea-4c28-b35c-d9ff856ef354",
                                                "sense_id": "fbc925f2-122f-3c97-b1ab-c4b3dd668162",
                                                "text": "De huidige en tevens eerste voorzitter van de Europese Raad, de voormalige premier van België, Herman Van Rompuy, is een bekend liefhebber en schrijver van haiku, die op zijn website te vinden zijn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
