                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc49390c-d4fd-4493-b252-f57a889de9f2",
                        "source_entry_id": "5bf4d0b6-017b-3f0a-99b4-bd9270103d66",
                        "source_sense_id": "5b3b2567-c703-350b-8bd9-4e58cfff7d04",
                        "target_lang_word": "pěnice",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "b935ec80-a969-417e-a719-f33295c9c48e",
                        "source_entry_id": "5bf4d0b6-017b-3f0a-99b4-bd9270103d66",
                        "source_sense_id": "5b3b2567-c703-350b-8bd9-4e58cfff7d04",
                        "target_lang_word": "fauvette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fauvette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2fb7af6-bedc-3dfc-b13d-9573a148325d",
                                        "entry_id": "1bc32bf4-041a-33e5-a8cb-d814ad1ab3d2",
                                        "glosses": [
                                            "Petit oiseau passereau insectivore et chanteur à bec court, tête souvent bombée et queue étroite, parfois redressée. Au sens strict, les fauvettes sont les 18 espèces du genre Sylvia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da87f841-8f82-4e38-9498-d4bce8f901f4",
                                                "sense_id": "f2fb7af6-bedc-3dfc-b13d-9573a148325d",
                                                "text": "Soit pour des mésanges, des fauvettes, des becs fins comme les hirondelles : ça détruit la vermine!"
                                            },
                                            {
                                                "example_id": "cdf76906-6e82-4010-baad-62b155007370",
                                                "sense_id": "f2fb7af6-bedc-3dfc-b13d-9573a148325d",
                                                "text": "Comme pour tous les passereaux insectivores, la migration des fauvettes se déroule de nuit, avec un départ environ une heure après le coucher du soleil et s’arrête peu avant l’aube, vers 5-6 heures du matin."
                                            },
                                            {
                                                "example_id": "620b4ec8-0d4f-44b8-a34e-087cbb239546",
                                                "sense_id": "f2fb7af6-bedc-3dfc-b13d-9573a148325d",
                                                "text": "Avec elles, je me fais l'effet d'être dans une ménagerie, sauf que mes fauves sont des vieilles fauvettes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a0ddd11-fdb0-3757-adad-c907e0a74cce",
                                        "entry_id": "1bc32bf4-041a-33e5-a8cb-d814ad1ab3d2",
                                        "glosses": [
                                            "Nom sous lequel ont été longtemps mais erronément désignées les parulines à cause de la ressemblance de leurs mœurs et de leur apparence générale, en dépit de leur appartenance à une famille complètement différente (i.e. celle des parulidés)."
                                        ],
                                        "tags": [
                                            "Canada"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b41f450a-6fb6-4adb-bc9a-904205d5fbfb",
                                                "sense_id": "3a0ddd11-fdb0-3757-adad-c907e0a74cce",
                                                "text": "Comme élément générique, paruline est attesté depuis Ouellet et Gosselin (1983), où il a été introduit pour remplacer fauvette dans la désignation de tous les Embérizidés de la sous-famille néarctique des Parulinés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5ae712a8-8826-4d34-accf-5b119cbe8bd4",
                        "source_entry_id": "5bf4d0b6-017b-3f0a-99b4-bd9270103d66",
