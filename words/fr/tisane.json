    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b314e4a6-f383-3d9a-bdaa-bf5e90884afa",
                    "sense_definition": "Boisson obtenue par infusion ou décoction de plantes végétales, souvent consommée pour ses vertus apaisantes ou digestives.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "boisson",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soir, elle prépare toujours une <w>tisane</w> chaude pour faciliter son sommeil."
                        },
                        {
                            "text": "Après un repas copieux, une bonne <w>tisane</w> à la menthe est très agréable."
                        }
                    ],
                    "synonyms": [
                        "infusion"
                    ],
                    "common_phrases": [
                        "tisane à la menthe",
                        "tisane de camomille"
                    ]
                },
                {
                    "sense_id": "9bb47ec9-2ab7-3c4b-a044-fb12731105f9",
                    "sense_definition": "Raclée, volée de coups reçue ou donnée lors d'une bagarre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune homme s'est bagarré à la sortie du bar et a pris une sacrée <w>tisane</w>."
                        },
                        {
                            "text": "Il menaçait tout le quartier jusqu'à ce que quelqu'un vienne lui flanquer une <w>tisane</w>."
                        }
                    ],
                    "common_phrases": [
                        "foutre une tisane"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "registre argotique"
                        }
                    ]
                },
                {
                    "sense_id": "d7ac1a73-e300-3b77-916f-f39a8a9c9f69",
                    "sense_definition": "Paroles doucereuses ou vaines consolations destinées à apaiser sans résoudre le fond du problème.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "consolation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Face à son désespoir immense, ses proches évitèrent de lui servir de vaines <w>tisanes</w>."
                        },
                        {
                            "text": "Il réclamait des mesures d'urgence et rejetait les habituelles <w>tisanes</w> de l'administration."
                        }
                    ]
                },
                {
                    "sense_id": "9787068d-5fbe-39ca-9357-f64b0cb61e9f",
                    "sense_definition": "Carburant ou essence pour faire fonctionner un véhicule à moteur.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "carburant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le réservoir est presque à sec, il faut vite remettre un peu de <w>tisane</w> pour continuer."
                        },
                        {
                            "text": "Avec toute la <w>tisane</w> que consomme ce vieux camion, le voyage va coûter cher."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "terme argotique"
                        }
                    ]
                }
            ]
        }
