                "translations": [
                    {
                        "translation_id": "61b1c0ae-4e79-4dd3-9058-78be9fc36c2c",
                        "source_entry_id": "256d6076-f521-3c67-9851-d3bb23018fc3",
                        "source_sense_description": "a lens, especially one of a pair",
                        "target_lang_word": "ли́нза",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ли́нза",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d54f93fa-b97d-316e-8f45-37b091956f44",
                                        "entry_id": "12512380-d142-3899-89cf-f6c0a1e4c3e0",
                                        "glosses": [
                                            "опт. прозрачное тело, ограниченное выпуклыми и вогнутыми поверхностями (одна поверхность может быть плоской) и преобразующее форму светового пучка; также изделие из прозрачного материала с такими свойствами, используемое в очках, как лупа и как деталь в оптических приборах"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "45bb4f46-9f06-4002-8d52-14e4520fe878",
                                                "sense_id": "d54f93fa-b97d-316e-8f45-37b091956f44",
                                                "text": "Линзы могут комбинироваться друг с другом для построения сложных оптических систем."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "985da1ee-0e55-3519-869e-c0dbcd1c2587",
                                        "entry_id": "12512380-d142-3899-89cf-f6c0a1e4c3e0",
                                        "glosses": [
                                            "геол. чечевицеобразная форма залегания горных пород, округлое или овальное тело с уменьшением мощности по краям"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "566e6f75-7c2e-45db-bf4c-8511b861cd3f",
                                                "sense_id": "985da1ee-0e55-3519-869e-c0dbcd1c2587",
                                                "text": "В вечной мерзлоте нередки ледяные линзы, залегающие на относительно небольшой глубине."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e7f642b-4aa0-3894-b991-662cd97b3ec7",
                                        "entry_id": "12512380-d142-3899-89cf-f6c0a1e4c3e0",
                                        "glosses": [
                                            "физ. область пространства с полем, отклоняющим лучи или частицы определённого типа подобно оптической линзе [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbb2264b-08f0-4a94-85f5-4b1661c4ee3f",
                                                "sense_id": "3e7f642b-4aa0-3894-b991-662cd97b3ec7",
                                                "text": "Гравитационная линза."
                                            },
                                            {
                                                "example_id": "0a4189fd-c32c-4bd2-82e0-89d86c399468",
                                                "sense_id": "3e7f642b-4aa0-3894-b991-662cd97b3ec7",
                                                "text": "Магнитная линза."
                                            },
                                            {
                                                "example_id": "899e082b-b177-4db6-a2c1-e56570d9b960",
                                                "sense_id": "3e7f642b-4aa0-3894-b991-662cd97b3ec7",
                                                "text": "Электростатическая линза."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0ed3f3a4-61c6-4713-98a4-08731283957c",
                        "source_entry_id": "256d6076-f521-3c67-9851-d3bb23018fc3",
                        "source_sense_description": "a monocle",
