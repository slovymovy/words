{
    "word_family": [
        "forthrightness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e7a88d3-ed64-37bb-ba3f-be555b6578b7",
                    "sense_definition": "Straightforward and honest in manner or speech; not evasive.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "honest_communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witness was considered credible thanks to her <w>forthright</w> answers during the trial.",
                            "target_lang_translations": {
                                "nl": "De getuige werd als geloofwaardig beschouwd dankzij haar <w>openhartige</w> antwoorden tijdens de rechtszaak."
                            }
                        },
                        {
                            "text": "She gave a <w>forthright</w> assessment of the company's current financial situation.",
                            "target_lang_translations": {
                                "nl": "Ze gaf een <w>onverbloemde</w> beoordeling van de huidige financiële situatie van het bedrijf."
                            }
                        }
                    ],
                    "synonyms": [
                        "candid",
                        "direct",
                        "frank"
                    ],
                    "antonyms": [
                        "evasive",
                        "deceitful"
                    ],
                    "common_phrases": [
                        "forthright manner",
                        "forthright answer"
                    ],
                    "target_lang_definitions": {
                        "nl": "Eerlijk en direct in gedrag of spraak; niet ontwijkend."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "recht voor zijn raap",
                                "target_lang_sense_clarification": "Zeer direct en zonder omwegen."
                            },
                            {
                                "target_lang_word": "openhartig",
                                "target_lang_sense_clarification": "Eerlijk en oprecht in communicatie."
                            },
                            {
                                "target_lang_word": "direct",
                                "target_lang_sense_clarification": "Zonder aarzeling of omwegen."
                            }
                        ]
