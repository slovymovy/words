                "senses": [
                    {
                        "sense_id": "44e4f875-17c2-3e31-8f20-05c5e5e858d4",
                        "entry_id": "2a4633f9-5634-33db-a584-47c93113df92",
                        "glosses": [
                            "gestandaariseerd bord met aanwijzingen voor mensen in het verkeer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf916098-4c94-453c-b1c9-ec770e2b018b",
                                "sense_id": "44e4f875-17c2-3e31-8f20-05c5e5e858d4",
                                "text": "De gemeente Amsterdam wil snel van staatssecretaris Jetta Klijnsma (Sociale Zaken, PvdA) horen of bijstandsgerechtigden in de hoofdstad mogen meedoen aan speciale experimenten. Klijnsma had eerder laten weten dat dit niet kan, omdat Amsterdam zijn werklozen eerst moest verplichten om een zogenoemde ‘tegenprestatie’ te leveren, zoals verkeersborden schoonmaken of koffie schenken in een zorginstelling."
                            },
                            {
                                "example_id": "1486d3a8-34b6-4d1c-a91f-1f15c1786f04",
                                "sense_id": "44e4f875-17c2-3e31-8f20-05c5e5e858d4",
                                "text": "Automobilisten zeggen langzamer te rijden bij een verkeersbord met een tekening van Dick Bruna. Dat blijkt uit een enquête van de Stichting Wetenschappelijk Onderzoek Verkeersveiligheid (SWOV), in opdracht van de Metropoolregio Rotterdam Den Haag."
                            },
                            {
                                "example_id": "a3030d31-1ace-4e93-8ddb-d0a1f8ab57aa",
                                "sense_id": "44e4f875-17c2-3e31-8f20-05c5e5e858d4",
                                "text": "Daarachter ontvouwde zich het tweede deel van het plein, als een verborgen surprise, geflankeerd door het onwereldse dogepaleis, dat leek te zweven met twee breekbaar ogende, opengewerkte benedenverdiepingen onder een stoere, middeleeuwse bovenbouw, en de twee zuilen waarachter het plaveisel zonder muurtje, hek, verkeersbord of waarschuwing overging in het water van Canal Grande, de lagune en de open zee."
                            }
                        ]
                    }
                ],
