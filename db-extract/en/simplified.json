                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d43097e-a867-4fcd-a864-71f749346d9f",
                                "sense_id": "0ce24cc7-19e5-399b-9d8b-5952ede97f00",
                                "text": "With punctuality nosediving and both overcrowding and cancellations on the rise, a new simplified timetable was introduced in December amid threats from the Mayor that he would ask the Secretary of State for Transport to strip Abellio of the franchise."
                            }
                        ]
                    },
