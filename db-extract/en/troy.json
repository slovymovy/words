                                    {
                                        "sense_id": "4a9a8b2f-995b-32c3-9584-75efc87d13f0",
                                        "entry_id": "a6a030f6-7de3-3b67-bffb-5c22e7b288fb",
                                        "glosses": [
                                            "Cité légendaire de la mythologie grecque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01356ec-2953-410f-8c5e-3f747aa2231e",
                                                "sense_id": "4a9a8b2f-995b-32c3-9584-75efc87d13f0",
                                                "text": "Fille d’Hécube et de Priam, respectivement reine et roi de Troie, Polyxène interroge Achille, le colérique guerrier grec, au sujet du sacrifice de sa propre personne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c000ea-229d-3104-adbe-8ea052a9fa33",
                                        "entry_id": "a6a030f6-7de3-3b67-bffb-5c22e7b288fb",
                                        "glosses": [
                                            "Guerre de Troie."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c278bc0-4e31-4970-8dd1-47040cf4bb65",
                                                "sense_id": "f7c000ea-229d-3104-adbe-8ea052a9fa33",
                                                "text": "Depuis Troie, personne n’est dupe : on tue pour tuer, on brûle pour brûler, on ne doute pas de trouver ensuite une légitimation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c54feb3-c651-4b19-81d8-7586d23f5e4b",
