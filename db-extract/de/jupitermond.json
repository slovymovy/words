                "senses": [
                    {
                        "sense_id": "1a1e855b-973d-3eb8-babf-162d622d6f46",
                        "entry_id": "bd77e15f-85eb-30ec-ae5c-91d8732faf05",
                        "glosses": [
                            "Himmelskörper (Mond), der den Planeten Jupiter umkreist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb442295-ce5b-4680-a3aa-2a7dd2b9b294",
                                "sense_id": "1a1e855b-973d-3eb8-babf-162d622d6f46",
                                "text": "Die vier größten Jupitermonde wurden durch Galileo Galilei entdeckt."
                            },
                            {
                                "example_id": "5f80d9fe-b7f6-4459-b848-5ad44deaf237",
                                "sense_id": "1a1e855b-973d-3eb8-babf-162d622d6f46",
                                "text": "„Er ist der kleinste Planet des Sonnensystems und mit einem Durchmesser von 4.878 Kilometern nur wenig größer als der Erdmond – und kleiner als Jupitermond Ganymed und Saturnmond Titan.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
