    "entries": [
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "accdfc55-6fa2-3f14-b020-0c792ad1a13c",
                    "sense_definition": "Wykrzyknienie wyrażające silne emocje, takie jak zdenerwowanie, zdziwienie, przerażenie lub zachwyt.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "emotions_exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Boże</w>! Ależ on schudł!",
                            "target_lang_translations": {
                                "ru": "<w>Боже</w>! Как же он похудел!",
                                "nl": "<w>Mijn God</w>! Wat is hij afgevallen!"
                            }
                        },
                        {
                            "text": "O <w>Boże</w>, zupełnie zapomniałem o twoich urodzinach.",
                            "target_lang_translations": {
                                "ru": "О <w>Боже</w>, я совсем забыл про твой день рождения.",
                                "nl": "O <w>God</w>, ik ben je verjaardag helemaal vergeten."
                            }
                        }
                    ],
                    "synonyms": [
                        "Jezu",
                        "Jezus Maria",
                        "Matko Boska",
                        "rany",
                        "olaboga."
                    ],
                    "common_phrases": [
                        "o mój Boże",
                        "Boże drogi",
                        "daj Boże",
                        "broń Boże",
                        "szczęść Boże"
                    ],
                    "target_lang_definitions": {
                        "ru": "Восклицание, выражающее сильные эмоции: раздражение, удивление, испуг или восторг.",
                        "nl": "Uitroep van sterke emotie, zoals frustratie, verbazing, angst of vreugde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Боже",
                                "target_lang_sense_clarification": "междометие"
                            },
                            {
                                "target_lang_word": "Господи",
                                "target_lang_sense_clarification": "междометие"
                            },
                            {
                                "target_lang_word": "Боже мой",
                                "target_lang_sense_clarification": "фраза"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "God",
                                "target_lang_sense_clarification": "tussenwerpsel"
                            },
                            {
                                "target_lang_word": "Mijn God",
                                "target_lang_sense_clarification": "uitroep"
                            },
                            {
                                "target_lang_word": "Lieve hemel",
                                "target_lang_sense_clarification": "uitroep"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e5657737-08e0-3f93-9878-44812b24076f",
                    "sense_definition": "Forma wołacza liczby pojedynczej rzeczownika <w>Bóg</w>, używana w bezpośrednim zwrocie do Boga.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religious_address",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wysłuchaj mojej modlitwy, <w>Boże</w>.",
                            "target_lang_translations": {
                                "ru": "Услышь мою молитву, <w>Боже</w>.",
                                "nl": "Verhoor mijn gebed, <w>God</w>."
                            }
                        },
                        {
                            "text": "Dziękuję Ci, <w>Boże</w>, za wszystkie otrzymane łaski.",
                            "target_lang_translations": {
                                "ru": "Благодарю Тебя, <w>Боже</w>, за все полученные милости.",
                                "nl": "Ik dank U, <w>God</w>, voor alle ontvangen genade."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Wielki Boże"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "wołacz (vocative)"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Звательная форма слова «Бог», используемая при прямом обращении к Богу.",
                        "nl": "Aanspreekvorm (vocatief) van God, gebruikt wanneer men zich rechtstreeks tot God wendt."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Боже",
                                "target_lang_sense_clarification": "обращение"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "God",
                                "target_lang_sense_clarification": "aanspreekvorm"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d4781eb3-7cb2-3495-a3e0-594a2a54016d",
                    "sense_definition": "Forma fleksyjna (rodzaj nijaki, liczba pojedyncza lub mianownik liczby mnogiej) przymiotnika <w>boży</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "adjective_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To było prawdziwe zrządzenie <w>boże</w>.",
                            "target_lang_translations": {
                                "ru": "Это было настоящее <w>божье</w> провидение.",
                                "nl": "Dat was een ware <w>goddelijke</w> beskikking."
                            }
                        },
                        {
                            "text": "Wszystkie stworzenia <w>boże</w> zasługują na szacunek.",
                            "target_lang_translations": {
                                "ru": "Все создания <w>божьи</w> заслуживают уважения.",
                                "nl": "Alle <w>Gods</w> schepselen verdienen respect."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Boże Narodzenie",
                        "Boże Ciało",
                        "krówki boże",
                        "pole boże"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "inflection"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма прилагательного «boży» (божий): средний род единственного числа или именительный падеж множественного числа.",
                        "nl": "Buigingsvorm van het bijvoeglijk naamwoord dat betrekking heeft op God (Gods, goddelijk)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "божье",
                                "target_lang_sense_clarification": "средний род"
                            },
                            {
                                "target_lang_word": "божьи",
                                "target_lang_sense_clarification": "множественное число"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "goddelijk",
                                "target_lang_sense_clarification": "bijvoeglijk naamwoord"
                            },
                            {
                                "target_lang_word": "Gods",
                                "target_lang_sense_clarification": "bezit van God"
                            }
                        ]
                    }
                }
            ]
        }
