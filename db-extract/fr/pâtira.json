                "senses": [
                    {
                        "sense_id": "8d5b2d85-f9b5-3005-9cee-36326c402468",
                        "entry_id": "c011f2ad-b0bd-3882-8015-b17f403b18e6",
                        "glosses": [
                            "Souffre-douleur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61089c68-491b-45b2-81c1-f5dfe7ff727b",
                                "sense_id": "8d5b2d85-f9b5-3005-9cee-36326c402468",
                                "text": "On voyait là : Javelas, « l’homme aux bouillons, » le patito de mademoiselle Gourganson, le pâtira, le souffre-douleur de l’atelier, un méridional naïf, un gobeur avalant tout, et qu’on avait décidé de promener son chapeau gris la nuit en lui affirmant que le clair de lune était le meilleur blanchisseur des castors."
                            },
                            {
                                "example_id": "04d69337-1b76-4102-99cd-c674925a10e6",
                                "sense_id": "8d5b2d85-f9b5-3005-9cee-36326c402468",
                                "text": "Marion était le pâtira des ouvrières blanchisseuses. Il y avait là jeunesse, force et beauté ; elle était vieillotte, débile, laide et maladive."
                            }
                        ]
                    },
                    {
                        "sense_id": "d795a9f7-b3c3-38ae-98ac-4debcf90ea7d",
                        "entry_id": "c011f2ad-b0bd-3882-8015-b17f403b18e6",
                        "glosses": [
