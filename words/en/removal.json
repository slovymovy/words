{
    "word_family": [
        "remove",
        "removable",
        "remover"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dccd5c3e-4e26-345d-9cf1-2d9ce98d8669",
                    "sense_definition": "The process of taking something away or the state of being taken away.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>removal</w> of the old furniture took all afternoon.",
                            "target_lang_translations": {
                                "ru": "<w>Вывоз</w> старой мебели занял весь день.",
                                "fr": "L'<w>enlèvement</w> des vieux meubles a pris tout l'après-midi."
                            }
                        },
                        {
                            "text": "Laser hair <w>removal</w> is becoming very popular.",
                            "target_lang_translations": {
                                "ru": "Лазерное <w>удаление</w> волос становится очень популярным.",
                                "fr": "L'<w>épilation</w> laser devient très populaire."
                            }
                        }
                    ],
                    "synonyms": [
                        "subtraction"
                    ],
                    "antonyms": [
                        "addition"
                    ],
                    "common_phrases": [
                        "stain removal",
                        "hair removal",
                        "waste removal",
                        "snow removal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс удаления, изъятия чего-либо или состояние, когда что-то убрано.",
                        "fr": "Le processus de prendre quelque chose ou l'état d'être retiré."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "удаление",
                                "target_lang_sense_clarification": "общее значение; извлечение или стирание"
                            },
                            {
                                "target_lang_word": "устранение",
                                "target_lang_sense_clarification": "избавление от чего-либо нежелательного"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "enlèvement",
                                "target_lang_sense_clarification": "action d'enlever ou de retirer quelque chose"
                            },
                            {
                                "target_lang_word": "élimination",
                                "target_lang_sense_clarification": "action de supprimer ou d'écarter quelque chose"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5c85d34c-b839-3660-bcc4-7cbfa19e25f2",
                    "sense_definition": "The act of forcing someone to leave a job or official position.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His <w>removal</w> from the committee surprised everyone.",
                            "target_lang_translations": {
                                "ru": "Его <w>исключение</w> из комитета всех удивило.",
                                "fr": "Son <w>renvoi</w> du comité a surpris tout le monde."
                            }
                        },
                        {
                            "text": "The president faced threats of <w>removal</w> from office.",
                            "target_lang_translations": {
                                "ru": "Президент столкнулся с угрозами <w>отстранения</w> от должности.",
                                "fr": "Le président a fait face à des menaces de <w>destitution</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "removal from office",
                        "removal from power"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт принуждения кого-либо покинуть работу или официальную должность.",
                        "fr": "L'acte de forcer quelqu'un à quitter un emploi ou une fonction officielle."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отстранение",
                                "target_lang_sense_clarification": "лишение полномочий или должности"
                            },
                            {
                                "target_lang_word": "смещение",
                                "target_lang_sense_clarification": "снятие с высокого поста"
                            },
                            {
                                "target_lang_word": "увольнение",
                                "target_lang_sense_clarification": "прекращение трудовых отношений"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "destitution",
                                "target_lang_sense_clarification": "renvoi officiel d'une personne de ses fonctions"
                            },
                            {
                                "target_lang_word": "renvoi",
                                "target_lang_sense_clarification": "action de congédier quelqu'un"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ac933c3-34ad-35b6-80b3-68588d0c6918",
                    "sense_definition": "The act of moving a home or business to a new location.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hired a <w>removal</w> company to help us move house.",
                            "target_lang_translations": {
                                "ru": "Мы наняли компанию по <w>перевозке</w> вещей, чтобы помочь нам с переездом.",
                                "fr": "Nous avons engagé une entreprise de <w>déménagement</w> pour nous aider à changer de maison."
                            }
                        },
                        {
                            "text": "The <w>removal</w> of the headquarters to a new city was costly.",
                            "target_lang_translations": {
                                "ru": "<w>Перенос</w> штаб-квартиры в новый город обошелся дорого.",
                                "fr": "Le <w>déménagement</w> du siège social vers une nouvelle ville a été coûteux."
                            }
                        }
                    ],
                    "synonyms": [
                        "relocation",
                        "move"
                    ],
                    "common_phrases": [
                        "removal company",
                        "removal van",
                        "furniture removal"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переезд дома или бизнеса на новое место.",
                        "fr": "L'acte de déplacer un domicile ou une entreprise vers un nouvel emplacement."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переезд",
                                "target_lang_sense_clarification": "смена места жительства или нахождения"
                            },
                            {
                                "target_lang_word": "перевозка",
                                "target_lang_sense_clarification": "транспортировка вещей при переезде"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "déménagement",
                                "target_lang_sense_clarification": "action de changer de lieu de résidence ou de locaux"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ef3f921-45c0-382c-bb37-f30a708549a2",
                    "sense_definition": "A ritual in which a coffin is taken to a church the evening before the funeral.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>removal</w> will take place at the church this evening.",
                            "target_lang_translations": {
                                "ru": "<w>Вынос тела</w> состоится в церкви сегодня вечером.",
                                "fr": "La <w>levée de corps</w> aura lieu à l'église ce soir."
                            }
                        },
                        {
                            "text": "Family members gathered for the <w>removal</w> before the funeral mass.",
                            "target_lang_translations": {
                                "ru": "Члены семьи собрались на <w>вынос тела</w> перед заупокойной мессой.",
                                "fr": "Les membres de la famille se sont réunis pour la <w>levée de corps</w> avant la messe de funérailles."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритуал доставки гроба в церковь накануне похорон.",
                        "fr": "Un rituel où un cercueil est transporté vers une église la veille des funérailles."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вынос тела",
                                "target_lang_sense_clarification": "ритуальное перемещение покойного"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "levée de corps",
                                "target_lang_sense_clarification": "cérémonie rituelle de transport du défunt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05a31eb-14aa-3a50-b4e4-005f2de5cc28",
                    "sense_definition": "The killing of a person, often used as a euphemism.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy was ordered to carry out the <w>removal</w> of the target.",
                            "target_lang_translations": {
                                "ru": "Шпиону было приказано осуществить <w>устранение</w> цели.",
                                "fr": "L'espion a reçu l'ordre de procéder à l'<w>élimination</w> de la cible."
                            }
                        },
                        {
                            "text": "They discussed the <w>removal</w> of the witness in secret.",
                            "target_lang_translations": {
                                "ru": "Они тайно обсуждали <w>устранение</w> свидетеля.",
                                "fr": "Ils ont discuté en secret de l'<w>élimination</w> du témoin."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Убийство человека, часто используется как эвфемизм.",
                        "fr": "Le meurtre d'une personne, souvent utilisé comme euphémisme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "устранение",
                                "target_lang_sense_clarification": "физическое уничтожение (эвфемизм)"
                            },
                            {
                                "target_lang_word": "ликвидация",
                                "target_lang_sense_clarification": "убийство (спецслужбы, криминал)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "élimination",
                                "target_lang_sense_clarification": "euphémisme pour désigner un meurtre"
                            },
                            {
                                "target_lang_word": "liquidation",
                                "target_lang_sense_clarification": "terme souvent utilisé dans un contexte criminel ou d'espionnage"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}