                        "glosses": [
                            "Qui peut être empoisonné."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "344fa489-fd9a-4710-b593-747a0a73d77a",
                                "sense_id": "9df9b994-0fd4-35a9-a7b9-91f2f5502ac3",
                                "text": "On me mande aussi que deux personnages du pays ont comploté de m’empoisonner dans du vin de liqueur. Je n’en bois point, et je ne me tiens pas pour empoisonnable."
                            },
                            {
                                "example_id": "991bf7f9-f17c-4f4e-98ea-7151d00cff33",
                                "sense_id": "9df9b994-0fd4-35a9-a7b9-91f2f5502ac3",
                                "text": "Alors les animaux affaiblis et languissants deviennent plus facilement empoisonnables par des poisons qui altèrent les liquides et moins facilement empoisonnables par ceux qui agissent sur le système nerveux."
                            }
                        ]
                    }
