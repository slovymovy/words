{
    "word_family": [
        "wyłamywać",
        "wyłamanie",
        "odłamać",
        "złamać",
        "łamać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b4ef49f3-b55d-3d26-be0f-3a8cf0ab0716",
                    "sense_definition": "otworzyć lub usunąć coś siłą, łamiąc zamek, zawiasy albo konstrukcję",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fizyczne naruszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Złodziej bez trudu <w>wyłamał</w> zamek w starych drzwiach do piwnicy.",
                            "target_lang_translations": {
                                "ru": "Вор без труда <w>взломал</w> замок в старой двери подвала."
                            }
                        },
                        {
                            "text": "Strażacy musieli <w>wyłamać</w> kratę w oknie, aby uratować uwięzionych ludzi.",
                            "target_lang_translations": {
                                "ru": "Пожарным пришлось <w>выломать</w> решётку на окне, чтобы спасти заблокированных людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozbić",
                        "sforsować"
                    ],
                    "common_phrases": [
                        "wyłamać drzwi",
                        "wyłamać zamek"
                    ],
                    "target_lang_definitions": {
                        "ru": "открыть или убрать что-либо силой, сломав замок, петли или конструкцию"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "взломать",
                                "target_lang_sense_clarification": "силой открыть замок, дверь"
                            },
                            {
                                "target_lang_word": "выломать",
                                "target_lang_sense_clarification": "сломать и вынуть или разрушить препятствие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fce6d95a-3e48-3ecf-8312-669ef50973d3",
                    "sense_definition": "oderwać lub odczepić coś za pomocą zginania lub łamania",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "fizyczne naruszenie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Silny wiatr nagle <w>wyłamał</w> grubą gałąź rosnącego pod oknem dębu.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер внезапно <w>отломал</w> толстую ветку дуба, растущего под окном."
                            }
                        },
                        {
                            "text": "Podczas prac ogrodowych przypadkowo <w>wyłamał</w> młody pęd rzadkiego krzewu.",
                            "target_lang_translations": {
                                "ru": "Во время работы в саду он случайно <w>отломал</w> молодой побег редкого кустарника."
                            }
                        }
                    ],
                    "synonyms": [
                        "odłamać",
                        "ułamać"
                    ],
                    "common_phrases": [
                        "wyłamać gałąź"
                    ],
                    "target_lang_definitions": {
                        "ru": "оторвать или отделить что-либо сгибанием или обламыванием"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отломать",
                                "target_lang_sense_clarification": "ветку, часть предмета"
                            },
                            {
                                "target_lang_word": "выломать",
                                "target_lang_sense_clarification": "с корнем или силой сломать часть чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1b2f1ad-3861-30fd-8269-23b363c89be9",
                    "sense_definition": "postąpić niezgodnie z powszechnie przyjętymi regułami, normami lub decyzją grupy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "przenośne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeden z posłów <w>wyłamał</w> się z dyscypliny partyjnej podczas ważnego głosowania.",
                            "target_lang_translations": {
                                "ru": "Один из депутатов <w>нарушил</w> партийную дисциплину во время важного голосования."
                            }
                        },
                        {
                            "text": "Nikt nie chciał się <w>wyłamać</w> ze wspólnego porozumienia dotyczącego podziału obowiązków.",
                            "target_lang_translations": {
                                "ru": "Никто не хотел <w>отступать</w> от общего соглашения о распределении обязанностей."
                            }
                        }
                    ],
                    "synonyms": [
                        "odstąpić",
                        "sprzeniewierzyć się"
                    ],
                    "antonyms": [
                        "podporządkować się"
                    ],
                    "common_phrases": [
                        "wyłamać się ze schematu",
                        "wyłamać się z dyscypliny"
                    ],
                    "target_lang_definitions": {
                        "ru": "поступить вопреки общепринятым правилам, нормам или решению группы (wyłamać się)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выбиться",
                                "target_lang_sense_clarification": "из общих рамок, рядов"
                            },
                            {
                                "target_lang_word": "отколоться",
                                "target_lang_sense_clarification": "от группы, коллектива"
                            },
                            {
                                "target_lang_word": "нарушить",
                                "target_lang_sense_clarification": "дисциплину, единство"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}