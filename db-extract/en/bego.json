                "senses": [
                    {
                        "sense_id": "a95dbe80-9034-35d1-9e81-4ff644ec919e",
                        "entry_id": "7b40c584-7eb6-3af8-837b-a018be217004",
                        "glosses": [
                            "To go about; encompass; surround; beset, surround with hostile intent; to overrun."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0c17a0d5-f50a-46de-947c-5a4c615aebc8",
                                "sense_id": "a95dbe80-9034-35d1-9e81-4ff644ec919e",
                                "text": "Thy prysemen ar sore begone and put undir, for they ar oversette with Sarazens mo than fyve hondred."
                            },
                            {
                                "example_id": "3cc29360-1aa8-43f2-9280-156946f3c5d9",
                                "sense_id": "a95dbe80-9034-35d1-9e81-4ff644ec919e",
                                "text": "False love, I bego, I bego. Ere something still worse come down."
                            }
                        ]
                    },
                    {
                        "sense_id": "a19bbdce-765c-3bf0-9ac9-5de32f9a5ddf",
                        "entry_id": "7b40c584-7eb6-3af8-837b-a018be217004",
                        "glosses": [
                            "To clothe, dress."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "96411f67-f864-3640-ad75-987ff902a38a",
                        "entry_id": "7b40c584-7eb6-3af8-837b-a018be217004",
                        "glosses": [
                            "To affect, usually as a good or bad influence, or as a circumstance."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a61db40-180b-46c7-bc50-a55f011e1e6f",
                                "sense_id": "96411f67-f864-3640-ad75-987ff902a38a",
                                "text": "He was woe begone."
                            }
                        ]
                    }
                ],
