            {
                "entry_id": "ef62fe55-f130-3846-9a93-77e18a1d47bf",
                "word": "Swiftie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "be8e9164-9ca9-47cb-8f51-676ab11658d1",
                        "entry_id": "ef62fe55-f130-3846-9a93-77e18a1d47bf",
                        "tags": [
                            "plural"
                        ],
                        "form": "Swifties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ec5f2982-6d6d-3c41-9f48-9ea141102fea",
                        "entry_id": "ef62fe55-f130-3846-9a93-77e18a1d47bf",
                        "glosses": [
                            "An enthusiastic fan of American singer-songwriter and actress Taylor Swift."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "f2af12e5-3d80-4148-a7a0-b8b4de6ce1ad",
                                "sense_id": "ec5f2982-6d6d-3c41-9f48-9ea141102fea",
                                "text": "Today was the day, and it hadn't fully hit me till that very moment when the doors opened and I was rushing to the front of the stage and standing amongst the thousands of fellow Swifties."
                            },
                            {
                                "example_id": "6c209c5c-e3a4-4626-916b-34af03df6953",
                                "sense_id": "ec5f2982-6d6d-3c41-9f48-9ea141102fea",
                                "text": "Even for devoted Swifties, it's hard to deny that her surrealist nightmare of a Grammy performance was a definite miscalculation."
                            },
                            {
                                "example_id": "3eb9cd6d-95fd-4522-b28f-e76a096ec7ac",
                                "sense_id": "ec5f2982-6d6d-3c41-9f48-9ea141102fea",
                                "text": "“RED” makes you think of Taylor Swift, so maybe we can get some confused Swifties to buy our album."
                            },
                            {
                                "example_id": "bfb16c17-47d6-4ff6-84ab-8cc75366241a",
                                "sense_id": "ec5f2982-6d6d-3c41-9f48-9ea141102fea",
                                "text": "Fresh off a frantic election cycle, the former Fetterman campaign social media producer — and dedicated Swiftie — takes time to shake it off."
                            }
                        ]
                    }
                ],
