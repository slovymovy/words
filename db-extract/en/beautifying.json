                    {
                        "sense_id": "92c2046e-66de-3444-9155-acdc097c89f3",
                        "entry_id": "1f49e924-6c18-3b4c-b586-745f5e8c0540",
                        "glosses": [
                            "That beautifies; tending to make beautiful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "826305b4-6999-4f1d-86fc-75bdf0654a22",
                                "sense_id": "92c2046e-66de-3444-9155-acdc097c89f3",
                                "text": "When thou present’st me, Gellia, with an Hare,\nMarcus, thou say’st, ’twill make the seven Days fair.\nIf Hare be such a beautifying Meat,\nThou ne’er of one in all thy Life didst eat."
                            },
                            {
                                "example_id": "d9913bb0-81d6-42bc-bc50-515a6ec763fc",
                                "sense_id": "92c2046e-66de-3444-9155-acdc097c89f3",
                                "text": "It evidently surpassed his majesty’s comprehension how any sober-minded and sensible individual could entertain the least possible objection to so beautifying an operation [i.e. being tattooed]."
                            },
                            {
                                "example_id": "97210578-764e-4799-b8f1-8505e0749b5d",
                                "sense_id": "92c2046e-66de-3444-9155-acdc097c89f3",
                                "text": "[…] I have found exercise far more beautifying than any surgical face-lift."
                            }
                        ]
                    }
