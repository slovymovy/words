        "fr-extract.jsonl": [
            {
                "entry_id": "be594aab-366d-30d5-9367-47824609c4ec",
                "word": "assortiment",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "18d5a4e9-0ce5-4abd-b4fa-9a6c5da4b0b6",
                        "entry_id": "be594aab-366d-30d5-9367-47824609c4ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "assortiments"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2d597925-d155-3ed6-b099-88777e1fe31b",
                        "entry_id": "be594aab-366d-30d5-9367-47824609c4ec",
                        "glosses": [
                            "Convenance de plusieurs choses qui ont rapport entre elles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab5e716d-1bb9-4bb8-8a8e-d206b7b6333c",
                                "sense_id": "2d597925-d155-3ed6-b099-88777e1fe31b",
                                "text": "L’assortiment de ces couleurs est agréable, bien entendu. L’assortiment de ces meubles est de fort bon goût. Un bel assortiment de fleurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "1403fef8-8c6f-3aed-add3-e15b72a11530",
                        "entry_id": "be594aab-366d-30d5-9367-47824609c4ec",
                        "glosses": [
                            "Assemblage complet de certaines choses qui vont ordinairement ensemble."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36da6993-cdc8-4688-854f-6b0688f3bedd",
                                "sense_id": "1403fef8-8c6f-3aed-add3-e15b72a11530",
                                "text": "Pour Mam j’ai le cadeau idéal : la mallette de toilette Mappin en cuir, avec assortiment de flacons, de boîtes, brosses, ustensiles à ongles, etc."
                            },
                            {
                                "example_id": "ff331972-8b7f-4773-867e-4e91fc26d644",
                                "sense_id": "1403fef8-8c6f-3aed-add3-e15b72a11530",
                                "text": "Le regard de Joni se porta immédiatement sur le panier à couverts, mais elle ne vit rien d’inhabituel dans l’assortiment de fourchettes, de cuillères et de couteaux de table."
                            }
                        ]
                    },
                    {
                        "sense_id": "4852abbc-ce30-314e-a33f-6c9a410f31d7",
                        "entry_id": "be594aab-366d-30d5-9367-47824609c4ec",
                        "glosses": [
                            "Supplément de différentes sortes de caractères servant à compléter une fonte dans la proportion requise pour le genre de composition auquel on la destine."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "7c9e683b-d9b8-34ba-bb90-2f73502c3cb8",
                        "entry_id": "be594aab-366d-30d5-9367-47824609c4ec",
                        "glosses": [
                            "Liste de tous les produits ou références proposés à la vente à un moment donné par un point de vente à sa clientèle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7acd9357-823f-4ee4-a658-a7dcc936c01a",
                                "sense_id": "7c9e683b-d9b8-34ba-bb90-2f73502c3cb8",
                                "text": "Aux poutres, et dans un ordre admirable, pendaient d'opulentes fourrures, dont pareil assortiment ne se fût pas rencontré aux plus enviables étalages de Regent-Street ou de la Perspective-Niewski."
                            },
                            {
                                "example_id": "77ca2a72-8a67-4bb3-9f4d-688872d7989b",
                                "sense_id": "7c9e683b-d9b8-34ba-bb90-2f73502c3cb8",
                                "text": "On est vraiment de l’autre côté des Pyrénées. Un petit café noir. Café negro. Il y a tout un assortiment de biscuits collants, de pâtisseries compactes, d’étouffe-chrétiens emballés sous cellophane, conditionnés."
                            },
                            {
                                "example_id": "11710d39-3d39-41df-b700-7f7a218de5d2",
                                "sense_id": "7c9e683b-d9b8-34ba-bb90-2f73502c3cb8",
                                "text": "assortiment de couleurs : toutes les couleurs nécessaires à un peintre."
                            }
                        ]
                    },
                    {
                        "sense_id": "6f767d10-73f0-3bc2-901b-b8fb87ee7c5d",
                        "entry_id": "be594aab-366d-30d5-9367-47824609c4ec",
                        "glosses": [
                            "Ensemble de variétés de charcuterie, en particulier de rondelles de saucissons en tranche."
                        ],
                        "tags": [
                            "Alsace"
                        ],
                        "examples": [
                            {
                                "example_id": "80c735c7-273b-4b2e-871a-b6405de2b964",
                                "sense_id": "6f767d10-73f0-3bc2-901b-b8fb87ee7c5d",
                                "text": "La saucisse à la pistache fait partie de l’assortiment de grosses saucisses à trancher que l’on aime acheter chez le charcutier en Alsace."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "613b9f6c-da58-4c52-bd67-15daa64f68a8",
                        "source_entry_id": "be594aab-366d-30d5-9367-47824609c4ec",
                        "target_lang_word": "assortment",
