                "senses": [
                    {
                        "sense_id": "7ddf4cb8-59ee-3592-ac33-032e5f28f69b",
                        "entry_id": "11d8ca27-9ee2-343c-82bb-765cfbcf5e9f",
                        "glosses": [
                            "meist junger, grober Mensch, der aus einer ländlichen Region kommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f12581f1-ad96-47f5-9fec-97e9e0c1b348",
                                "sense_id": "7ddf4cb8-59ee-3592-ac33-032e5f28f69b",
                                "text": "„Die Bauernlümmel standen blöde herum und wußten nicht, was sie mit einem jungen Mann anfangen sollten, der friedlich aussah und sein Hab und Gut auf diese Weise verteilte.“"
                            },
                            {
                                "example_id": "7a51dcfc-c38b-49e5-949e-fe642ea4f8e2",
                                "sense_id": "7ddf4cb8-59ee-3592-ac33-032e5f28f69b",
                                "text": "„Ihr könnt vor dem Spiegel herumstolzieren, bis ihr schwarz werdet, ihr bleibt trotzdem Bauernlümmel!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
