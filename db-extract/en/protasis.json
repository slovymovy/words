                                    {
                                        "sense_id": "14f97d1e-d421-30f1-a07a-1aabd4b8a388",
                                        "entry_id": "9b83c915-b32f-32b9-8b0a-1557cc5c9303",
                                        "glosses": [
                                            "Proposition conditionnelle utilisée dans l’art divinatoire sumérien, elle impliquait une conséquence nommée apodose."
                                        ],
                                        "tags": [
                                            "Divination"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ad81353a-c708-41f8-b964-86f257311ea1",
                                                "sense_id": "14f97d1e-d421-30f1-a07a-1aabd4b8a388",
                                                "text": "Le devin prédit que si telle chose se passe (protase), alors il adviendra telle autre chose (apodose)."
                                            }
                                        ]
