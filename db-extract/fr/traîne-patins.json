                            {
                                "example_id": "c8f49c12-d01d-45da-bfb5-408eb6ebcfa2",
                                "sense_id": "0e1790e5-8c5e-3a04-8e02-26fccfc9512c",
                                "text": "Oh mon cher maître, je vous en prie, hein ! Entre le baron Édouard et un traîne-patins comme Éric, il y a une marge."
                            },
                            {
                                "example_id": "69a5283b-09a1-4b23-8854-e45b7ff5f41f",
                                "sense_id": "0e1790e5-8c5e-3a04-8e02-26fccfc9512c",
                                "text": "Sur les hauts tabourets de cuir clouté se tenaient les habituels traîne-patins du week-end, avec leurs journaux de turf, leurs mots d’esprit à voix haute et leurs mentons pas rasés sur des chemises sans cravate."
                            }
                        ]
