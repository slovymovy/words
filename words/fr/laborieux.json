                    "frequency": "Middle",
                    "semantic_group_id": "difficulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une <w>laborieuse</w> journée de négociations, les ministres ont enfin trouvé un accord."
                        },
