                                "example_id": "a8fbb529-aa75-444b-82dd-3679d7ff3be4",
                                "sense_id": "ede3030f-4ba1-3883-b320-21d8aa020360",
                                "text": "Il est souvent très arrogant, Luis Enrique, et s'embrouille facilement avec ces joueurs. Son arrogance est maladive."
                            }
                        ]
