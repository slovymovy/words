                "senses": [
                    {
                        "sense_id": "d981096d-f3a8-343d-9646-372fe15c919d",
                        "entry_id": "a7b565d0-a42c-3f0c-82dd-526358d3af86",
                        "glosses": [
                            "wnęka w masie skalnej, której ściany obrośnięte są minerałem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "272fd3d1-05a0-453a-ab59-dfef89e1a94b",
                                "sense_id": "d981096d-f3a8-343d-9646-372fe15c919d",
                                "text": "Albo krasnoludy przebiły się do wielkiej geody, albo bardzo starannie wyłożyły ściany i strop jaskini kryształami kwarcu tak, by każda powierzchnia odbijała światło dwóch niedużych świec płonących na kolumnach pośrodku piaszczystego podłoża"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
