                        "glosses": [
                            "A public spectacle, in Spain and some other Latin countries, in which a person baits and often kills a bull."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fba3a319-f4a1-4374-907f-fd228f49a5c2",
                        "source_entry_id": "f3ff1fd0-ef99-3c7e-a584-97da621a6907",
                        "source_sense_id": "4fa9e816-bf3f-30f0-9c68-a09e949cfd7b",
