                        "glosses": [
                            "dotyczący rodzaju układu przepływu płynów w urządzeniach przepływowych, m.in. wymiennikach ciepła, w którym płyny poruszają się równolegle do siebie w przeciwnym kierunku"
                        ],
                        "tags": [],
                        "examples": [
