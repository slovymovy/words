                ],
                "senses": [
                    {
                        "sense_id": "0139636d-a3b9-313a-818a-1f11d5475444",
                        "entry_id": "b60442b1-d603-3fb3-acc9-94f9a08e6cf1",
                        "glosses": [
                            "физ. одна тысячная ампера"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0ecc324-9e81-4abe-8ffe-437af633844c",
                                "sense_id": "0139636d-a3b9-313a-818a-1f11d5475444",
                                "text": "Если больше 3 миллиампер ― троллейбус снимается с маршрута"
                            },
                            {
                                "example_id": "ef1f0cb2-b48c-4a31-8519-d2d7e07d6975",
                                "sense_id": "0139636d-a3b9-313a-818a-1f11d5475444",
                                "text": "Один фотопреобразователь (пластинка кремния или арсенида галлия размером с двухкопеечную монету) на солнечном свету развивает напряжение 0,5 вольта и может давать ток силой 30-40 миллиампер."
                            },
                            {
                                "example_id": "748a958a-b688-4c44-b28c-fa512cac2878",
                                "sense_id": "0139636d-a3b9-313a-818a-1f11d5475444",
                                "text": "Вторичный ток ― около 1 миллиампера при 1.000.000 вольт."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f7b511c-cec8-4888-bdf0-6f987cb5a8c7",
                        "source_entry_id": "b60442b1-d603-3fb3-acc9-94f9a08e6cf1",
