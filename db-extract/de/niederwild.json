                ],
                "senses": [
                    {
                        "sense_id": "bb407e68-f203-3ae0-8b20-df958b965937",
                        "entry_id": "2f6a371a-4b1a-3c49-ad01-277125d898bb",
                        "glosses": [
                            "Gruppe von Tieren, auf die Jagd gemacht wird und die nicht zum Hochwild (zum Beispiel Schalenwild, aber nicht Reh, das zum Niederwild zählt) gehören"
                        ],
                        "tags": [
                            "Jägersprache"
                        ],
                        "examples": [
                            {
                                "example_id": "1dbf2abb-20f5-4334-9884-9cff5a400eb9",
                                "sense_id": "bb407e68-f203-3ae0-8b20-df958b965937",
                                "text": "„Fälschlicherweise wird das Rehwild immer mal wieder zum Hochwild gezählt, es gehört aber heute zum Niederwild.“"
                            },
                            {
                                "example_id": "ded98160-3b57-4144-8940-a5013be5bc1c",
                                "sense_id": "bb407e68-f203-3ae0-8b20-df958b965937",
                                "text": "Niederwild heißt weder Niederwild, weil es sich dabei um kleine Tiere handelt, noch weil es sich in der Ebene, statt zum Beispiel im Gebirge, aufhält."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
