                        "examples": [
                            {
                                "example_id": "010632b9-2229-488e-979d-713ffe329a56",
                                "sense_id": "170b001d-9283-3423-ad28-f6a997b77e9d",
                                "text": "Er is volop gelegenheid om antilopen waar te nemen in het Krugerpark."
                            },
                            {
                                "example_id": "13960e3f-f937-4aa1-b229-7136005e6c14",
                                "sense_id": "170b001d-9283-3423-ad28-f6a997b77e9d",
                                "text": "In de Baptistenkerk aan de Hoofdweg zijn deze woensdagmorgen de groepen 6, 7 en 8 van de basisscholen De Blokstoeke en De Fontein bijeen. Want het is Dankdag voor Gewas en Arbeid. En waar in grote delen van Nederland deze christelijke feestdag een vrijwel onbekend fenomeen is geworden, wordt er hier in Westerhaar volop aandacht aan besteed."
                            },
                            {
                                "example_id": "bc1bd984-c4d4-417e-9025-564dafb3681d",
                                "sense_id": "170b001d-9283-3423-ad28-f6a997b77e9d",
                                "text": "De kinderen hadden meer dan genoeg aanspraak met alle hippies om zich heen en leken volop te genieten van het avontuur."
                            }
                        ]
                    }
                ],
