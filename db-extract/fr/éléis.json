                        "entry_id": "a0cf742d-361d-3af0-90ad-4165ac1bcd35",
                        "glosses": [
                            "Palmier à huile du genre Elaeis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e9ab1e7-32e5-4630-8cb1-5e5f0f32cb86",
                                "sense_id": "25d7b0b6-aebb-3fb5-b6c3-5f2e69c8fd9b",
                                "text": "Le nom éléis est une adaptation en français du nom de genre de ce palmier, Elaeis, du grec elaiêeis « huileux », dérivé de elaion « huile (d’olive à l’origine) », lui-même de elaia « olive »."
                            },
                            {
                                "example_id": "37c3cf2f-9178-466f-aad4-9a763c1b5652",
                                "sense_id": "25d7b0b6-aebb-3fb5-b6c3-5f2e69c8fd9b",
                                "text": "Ce sont des bananiers des arengas des oréodoxes des euterpes des aréquiers des lataniers des caryotes des éléis."
                            }
                        ]
                    }
