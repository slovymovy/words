                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "horticulture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jardinier utilise une serre chauffée pour <w>forcer</w> ces plantes délicates en hiver."
                        },
                        {
                            "text": "Les horticulteurs ont coutume de <w>forcer</w> les bulbes de tulipes pour les fêtes."
                        }
