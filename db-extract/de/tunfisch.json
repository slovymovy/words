                ],
                "senses": [
                    {
                        "sense_id": "b418573d-f8fb-3e94-ba41-deac393fbea8",
                        "entry_id": "2f853a36-70fa-3806-842d-a863de6d1d5e",
                        "glosses": [
                            "großer und schneller Meeresfisch; Thunnus"
                        ],
                        "tags": [
                            "wissenschaftlicher Name"
                        ],
                        "examples": [
                            {
                                "example_id": "8a8a5dfa-9b30-4fd4-9bbf-fd4d1b4fddea",
                                "sense_id": "b418573d-f8fb-3e94-ba41-deac393fbea8",
                                "text": "„In den vergangenen 50 Jahren ist der Fang bevorzugter Nahrungsfische wie Kabeljau, Tunfisch, Schellfisch und Flunder im Nordatlantik um mehr als die Hälfte zurückgegangen.“"
                            },
                            {
                                "example_id": "4ca54cbf-9bca-4d08-a7a9-62817c5241ab",
                                "sense_id": "b418573d-f8fb-3e94-ba41-deac393fbea8",
                                "text": "„Die zwei bis fünf Meter langen und bis zu 350 kg schweren Tunfische zogen an der dalmatinischen Küste nordwärts und an der italienischen Küste wieder südwärts. Die Ankunft der Tunfische verrieten zuerst Begleitvögel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
