                        "examples": [
                            {
                                "example_id": "b849ad2f-1a01-4374-9000-0ee1580aaec5",
                                "sense_id": "09c56680-db86-3736-be29-900af6fda6e3",
                                "text": "Het toezicht op het vangen van eenden bij pluimveehouderijen moet beter. Daarvoor pleit de Nederlandse Vakbond Pluimveehouders naar aanleiding van schokkende undercoverbeelden van dierenactivisten van Animal Rights."
                            }
                        ]
                    },
                    {
                        "sense_id": "cdfdd864-0dd3-37f5-b21c-231520f9c4eb",
                        "entry_id": "d3267ceb-d041-32f3-8ee0-9435b88b52f6",
                        "glosses": [
                            "tak van veeteelt waarbij vogels gehouden worden"
                        ],
                        "tags": [
                            "veeteelt"
                        ],
                        "examples": [
                            {
                                "example_id": "8c08731f-688d-4575-baa5-3589ef8676fd",
                                "sense_id": "cdfdd864-0dd3-37f5-b21c-231520f9c4eb",
                                "text": "Op last van de autoriteiten werden duizenden kippen geruimd. Ook werden miljoenen eieren vernietigd en kwam de verkoop van eieren stil te liggen. De schade voor de pluimveehouderij liep in de tientallen miljoenen euro's."
                            }
                        ]
                    }
