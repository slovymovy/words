    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "28d9c3cf-4221-3209-9723-82069dfbeedd",
                "word": "Valentine's",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                        "entry_id": "28d9c3cf-4221-3209-9723-82069dfbeedd",
                        "glosses": [
                            "Ellipsis of Valentine's Day."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "ellipsis"
                        ],
                        "examples": [
                            {
                                "example_id": "79531ce0-a3f2-4092-a76e-d45a357e8f20",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "Samantha pressed the garish Valentine’s card to her still flushed cheek one more time, for it had been a particularly long time since she had received the last gift."
                            },
                            {
                                "example_id": "a40623c9-50c6-4160-aa42-cb0ae5e4e4b0",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "A small dot of blood, red as a Valentine’s rose, bloomed against her alabaster skin."
                            },
                            {
                                "example_id": "a0e518c6-146a-47dc-bdfe-0bb0b9ec9b1e",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "Specialty Candies, a popular choice for all occasions, is offering a Valentine’s basket that is the perfect choice for your sweetheart."
                            },
                            {
                                "example_id": "53961c2e-b973-42a1-b20c-a6fbe6f61f5b",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "I only regret that I will miss / You in my arms and a Valentine’s kiss. / I have only kissed you once my dear / But that kiss can’t be compared / To all the others I’ve had in years. / You have a nice Valentine’s Day / I’ll be thinking of you / And all the others we’ll go through!"
                            },
                            {
                                "example_id": "ac7056be-270f-4339-806b-01eaddf47d6e",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "“No, I’m taking them. Her wedding rings, her Valentine’s ring, and the necklace I gave her. I’m keeping those.” / “Valentine’s ring?” / “Yeah, that one right there,” Terry smiled. “Randy gave that to her one year for Valentine’ Day. […]”"
                            },
                            {
                                "example_id": "2eafd127-efa7-4b04-b14b-44064ca309e1",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "Jemma is surprised to hear her name called and she shyly walks towards the outstreched hand wielding the plastic Valentine’s rose."
                            },
                            {
                                "example_id": "033a44a7-a3e7-4270-a154-029fcdd0e420",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "Now we come to the Valentine’s present. The Valentine’s present is not just a card that says “I Love You” or a beautiful bouquet of flowers, but a gift that expresses all the above messages without a word."
                            },
                            {
                                "example_id": "2b721a95-400f-42fc-8361-17218b264f28",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "IT TOOK A month for Francis to come up with the perfect Valentine’s gift, and a week to wrap it. What he couldn’t muster in words, he hoped the present would convey. / He put his heart into the Valentine’s gift."
                            },
                            {
                                "example_id": "139918df-75ef-4b8d-8311-c2a9c99cdd35",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "At one point I plucked up the courage to say, ‘So Megs was going on about her Valentine’s rose from Cameron yesterday.’"
                            },
                            {
                                "example_id": "e9d4d912-cf75-4958-95ec-1c3e7bbbc425",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "I glance at the clock above the door. Cooper is already six hours late delivering the Valentine’s flowers."
                            },
                            {
                                "example_id": "0db5f8d3-3d59-417c-955d-6e65e4ee6848",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "As Emily watched, he wrote something in a Valentine’s card, then slipped it into a red envelope, licked the flap, and sealed it."
                            },
                            {
                                "example_id": "6e29477d-a97f-4af1-bfce-4bbe4764bced",
                                "sense_id": "2e2d4fe0-b653-3c1e-9c1e-bfe4206b68ee",
                                "text": "Kumquat changes its lineup of coffees monthly, including additions of restrained, calibrated coffee drinks. For February, the shop introduced a Valentine’s-themed concoction: the Ruby Marocchino espresso mixed with hot chocolate ganache and pineberry syrup."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c9b04af-5565-3364-9dd4-2113a3ff05f2",
                        "entry_id": "28d9c3cf-4221-3209-9723-82069dfbeedd",
                        "glosses": [
                            "Used other than figuratively or idiomatically: see Valentine, -'s."
