    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ce984238-6085-3173-8ff7-43beb9b1334e",
                    "sense_definition": "So strong or intense that it is difficult to resist, ignore, or withstand.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intense_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was an <w>overpowering</w> smell of fresh paint in the room.",
                            "target_lang_translations": {
                                "ru": "В комнате стоял <w>невыносимый</w> запах свежей краски.",
                                "it": "C'era un odore <w>insopportabile</w> di vernice fresca nella stanza."
                            }
                        },
                        {
                            "text": "She felt an <w>overpowering</w> urge to tell him the truth immediately.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала <w>непреодолимое</w> желание немедленно рассказать ему правду.",
                                "it": "Sentì un <w>irresistibile</w> impulso di dirgli subito la verità."
                            }
                        }
                    ],
                    "synonyms": [
                        "overwhelming",
                        "intense",
                        "unbearable",
                        "irresistible",
                        "compelling"
                    ],
                    "antonyms": [
                        "weak",
                        "mild",
                        "faint",
                        "gentle"
                    ],
                    "common_phrases": [
                        "overpowering smell",
                        "overpowering urge",
                        "overpowering sense",
                        "overpowering stench"
                    ],
                    "target_lang_definitions": {
                        "ru": "Настолько сильный или интенсивный, что ему трудно сопротивляться, игнорировать или выдерживать.",
                        "it": "Così forte o intenso da risultare difficile da resistere, ignorare o sopportare."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непреодолимый",
                                "target_lang_sense_clarification": "о желании, влечении"
                            },
                            {
                                "target_lang_word": "невыносимый",
                                "target_lang_sense_clarification": "о запахе, жаре, физическом ощущении"
                            },
                            {
                                "target_lang_word": "подавляющий",
                                "target_lang_sense_clarification": "об общем воздействии или превосходстве"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "schiacciante",
