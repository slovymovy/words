                                            {
                                                "example_id": "98de944c-8d26-4603-8df3-608dbb461efc",
                                                "sense_id": "5ce01ea2-ee9d-35f5-bb49-7a4564caf2ee",
                                                "text": "Schicke mir doch einen Screenshot von deinem Desktop."
                                            },
                                            {
                                                "example_id": "3e793ac9-d496-4288-8184-8a3f22a39f6a",
                                                "sense_id": "5ce01ea2-ee9d-35f5-bb49-7a4564caf2ee",
                                                "text": "„Ich scrollte durch Hunderte von Fotos, Screenshots und Videos.“"
                                            }
