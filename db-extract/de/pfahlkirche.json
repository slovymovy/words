                ],
                "senses": [
                    {
                        "sense_id": "57167beb-d96b-3757-8211-863dd4515b6d",
                        "entry_id": "b51a25cf-f4f6-3cf7-9f73-2e45369c838f",
                        "glosses": [
                            "ein Versammlungsgebäude einer Glaubensgemeinschaft; Holzgebäude, mit senkrechten Pfeilern bis ins Erdreich, das zum Abhalten von Ritualen vorgesehen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20f52e8b-9bee-4ea4-b1c3-51156666b9b4",
                                "sense_id": "57167beb-d96b-3757-8211-863dd4515b6d",
                                "text": "„Archäologische Ausgrabungen wiesen 1980-81 Spuren einer Pfahlkirche aus frühchristlicher Zeit, vermutlich aus dem 11. Jahrhundert, nach. Snorre Snurlarsons „Heimskringla“ zufolge wurde das Christentum im Gudbrandsdal 1021 durch König Olav Haraldsson (998 – 1030) eingeführt.“"
                            },
                            {
                                "example_id": "2e0609fe-4915-4a31-8ff5-3f6dee9950a3",
                                "sense_id": "57167beb-d96b-3757-8211-863dd4515b6d",
                                "text": "„Ob es sich bei allen Kirchen, die Adam von Bremen und das Västgöta lagen nennen, um Stabkirchen handelt, ist nicht sicher, da zwischen dem 10. und dem 12. Jahrhundert auch Stolpkyrkor und Pallisadkyrkor (Pfahlkirchen und Palisadenkirchen) erbaut wurden.“"
                            },
                            {
                                "example_id": "5a7b22d8-24eb-44c3-b9db-04fa17eb6daf",
                                "sense_id": "57167beb-d96b-3757-8211-863dd4515b6d",
                                "text": "„Im 12. Jahrhundert muss an dieser Stelle allerdings schon mal eine Pfahlkirche gestanden haben.“"
                            },
                            {
                                "example_id": "b4e851dd-01eb-4fa0-a40c-15b21a823683",
                                "sense_id": "57167beb-d96b-3757-8211-863dd4515b6d",
                                "text": "„Ob in dieser Zeit eine kleine Holzkirche (Pfahlkirche) hier entstand, können wir nur erahnen.“"
                            },
                            {
                                "example_id": "deaa19b8-6199-4c5e-90b1-41bdfc4f162f",
                                "sense_id": "57167beb-d96b-3757-8211-863dd4515b6d",
                                "text": "„Allerdings stand schon früher auf diesem Areal eine frühere Pfahlkirche aus dem 11. Jahrhundert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
