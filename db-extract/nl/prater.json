                        "target_lang_word": "parlant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "parlant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "55b08d3e-cca2-3c01-b55c-f03082ef47f2",
                                        "entry_id": "73ebf360-b212-309b-9d3d-2c1ffe251168",
                                        "glosses": [
                                            "Qui parle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97d07b3d-6f36-4e02-a91e-f6b443bb8e83",
                                                "sense_id": "55b08d3e-cca2-3c01-b55c-f03082ef47f2",
                                                "text": "L’homme est la seule créature parlante."
                                            },
                                            {
                                                "example_id": "b9043411-00dc-4be0-a153-272ff21cde37",
                                                "sense_id": "55b08d3e-cca2-3c01-b55c-f03082ef47f2",
                                                "text": "Horloge parlante."
                                            },
                                            {
                                                "example_id": "a8f8efe3-020d-4072-8290-b026fc1e1c18",
                                                "sense_id": "55b08d3e-cca2-3c01-b55c-f03082ef47f2",
                                                "text": "Machine parlante, Toute machine qui, comme le phonographe, reproduit la voix humaine."
                                            },
                                            {
                                                "example_id": "bc1f4762-ce19-49b7-a3b8-e52e1fdd302e",
                                                "sense_id": "55b08d3e-cca2-3c01-b55c-f03082ef47f2",
                                                "text": "Nous considérons alors que les relations intersubjectives sont indispensables au retour dans la vie du sujet « chosifié » par le traumatisme, et que c’est par la restauration des liens interpersonnels que celui-ci retrouvera sa place au sein de la communauté des êtres vivants en étant repositionné comme être parlant et pensant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1b02a0e-0c3e-3aee-8850-566938a97514",
                                        "entry_id": "73ebf360-b212-309b-9d3d-2c1ffe251168",
                                        "glosses": [
                                            "Qui aime à parler, qui parle d'abondance, bavard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5224d203-a2ce-4c1b-8569-8b572be63729",
                                                "sense_id": "f1b02a0e-0c3e-3aee-8850-566938a97514",
                                                "text": "Cet homme est très parlant, est peu parlant, Il parle volontiers, il parle rarement."
                                            },
                                            {
                                                "example_id": "e521f682-a3a1-4e0c-96d6-22a5ffd776cc",
                                                "sense_id": "f1b02a0e-0c3e-3aee-8850-566938a97514",
                                                "text": "Autant l'ambassadeur était réservé et taciturne, par habitude professionnelle, autant la comtesse était vive, parlante et sémillante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbab75d8-61c4-3579-984d-1e9dce2ba615",
                                        "entry_id": "73ebf360-b212-309b-9d3d-2c1ffe251168",
                                        "glosses": [
                                            "Qui reproduit les paroles des personnages."
                                        ],
                                        "tags": [
                                            "Cinématographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3c6b9a2-6a3e-40e4-bceb-d44024aa1215",
                                                "sense_id": "dbab75d8-61c4-3579-984d-1e9dce2ba615",
                                                "text": "— Et les films parlants ! C’est quèqu’chose ! On entend tout, un verre qu’on remue, le bruit de la sonnette, le téléphone, les soupirs de la femme, tout…"
                                            },
                                            {
                                                "example_id": "5972b75c-1006-4f66-88e2-64236742dfc2",
                                                "sense_id": "dbab75d8-61c4-3579-984d-1e9dce2ba615",
                                                "text": "C’était pas longtemps après le moment où le cinéma, plof, était devenu parlant. Du jour au lendemain, toutes les salles avaient dû s’équiper pour projeter des films parlants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc63cd37-675c-3663-a50a-9631a5f9fa4e",
                                        "entry_id": "73ebf360-b212-309b-9d3d-2c1ffe251168",
                                        "glosses": [
                                            "Qui est très ressemblant, très expressif."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6736a67c-d094-473c-ba81-255ff58da7c6",
                                                "sense_id": "cc63cd37-675c-3663-a50a-9631a5f9fa4e",
                                                "text": "Ce portrait est parlant."
                                            },
                                            {
                                                "example_id": "fc638118-5b77-44ce-9014-ca47d4376385",
                                                "sense_id": "cc63cd37-675c-3663-a50a-9631a5f9fa4e",
                                                "text": "Il a une physionomie parlante."
                                            },
                                            {
                                                "example_id": "57c90681-7f18-4b03-969e-1c23dc59801b",
                                                "sense_id": "cc63cd37-675c-3663-a50a-9631a5f9fa4e",
                                                "text": "Des regards, des gestes parlants, Des regards, des gestes expressifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebbced58-9a8b-3a90-829f-b2c66e1b5820",
                                        "entry_id": "73ebf360-b212-309b-9d3d-2c1ffe251168",
                                        "glosses": [
                                            "Qui signifie beaucoup, sans commentaire nécessaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4770162-f72e-4efd-8803-fb31ac60f7e9",
                                                "sense_id": "ebbced58-9a8b-3a90-829f-b2c66e1b5820",
                                                "text": "Car au Carrefour, c'est à peine 5 à 7 % des produits récoltés et des aliments récupérés qui se retrouvent dans le compost. Une statistique parlante."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "parlant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
