                                "ru": "Она всегда <w>одевается</w> по последней моде."
                            }
                        },
                        {
                            "text": "In dit bedrijf is het de gewoonte om je zakelijk te <w>kleden</w>.",
                            "target_lang_translations": {
                                "en": "In this company, it is customary to <w>dress</w> professionally.",
                                "ru": "В этой компании принято <w>одеваться</w> в деловом стиле."
                            }
                        }
                    ],
                    "common_phrases": [
                        "volgens de mode kleden",
                        "stijlvol kleden"
                    ],
                    "target_lang_definitions": {
