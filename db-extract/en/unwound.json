                        "sense_id": "6f50bc2e-f99c-3271-947f-ecf2496ffc16",
                        "entry_id": "b8050b0f-ecdd-375e-8d56-74fdc936a4c8",
                        "glosses": [
                            "to make (someone’s) wounds go away, to heal"
                        ],
                        "tags": [
                            "rare",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "9f2cd7c7-8c18-476c-9af4-82b8c41a99c0",
                                "sense_id": "6f50bc2e-f99c-3271-947f-ecf2496ffc16",
                                "text": "The time travelling episode offers us restored wholeness of many kinds, ranging from physical (the ‘unwounding’ of wounded men) to spiritual and metaphysical (our transcending the tragedy of before and after)."
                            },
                            {
                                "example_id": "a2a3aaf9-d8dc-4086-8fe1-59535f7aec8f",
                                "sense_id": "6f50bc2e-f99c-3271-947f-ecf2496ffc16",
                                "text": "\"When I'm wounded, I go after people hard and I try to unwound myself,\" Trump said in a much-anticipated interview with Fox News' Megyn Kelly that aired Tuesday night on Fox."
                            }
                        ]
                    }
