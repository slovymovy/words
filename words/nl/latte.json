{
    "word_family": [
        "latten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "afbfc60d-2bf5-354a-b91d-43c9a5d92035",
                    "sense_definition": "koffiedrank met veel warme melk en een shot espresso, verkorting van latte macchiato",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "koffie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik bestel meestal een warme <w>latte</w> met havermelk in dit café.",
                            "target_lang_translations": {
                                "it": "Di solito ordino un <w>latte macchiato</w> caldo con latte d'avena in questo bar."
                            }
                        },
                        {
                            "text": "Wil je een espresso of drink je liever een <w>latte</w> vanochtend?",
                            "target_lang_translations": {
                                "it": "Vuoi un espresso o preferisci prendere un <w>caffellatte</w> stamattina?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "warme latte",
                        "latte macchiato"
                    ],
                    "target_lang_definitions": {
                        "it": "bevanda a base di caffè con molto latte caldo e uno shot di espresso, abbreviazione di latte macchiato o caffellatte"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "latte macchiato",
                                "target_lang_sense_clarification": "bevanda al caffè con latte montato"
                            },
                            {
                                "target_lang_word": "caffellatte",
                                "target_lang_sense_clarification": "caffè con latte caldo"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5f906364-4e24-345e-a0db-bfcbbf9b81f1",
                    "sense_definition": "enkelvoud verleden tijd van <w>latten</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "latten_verleden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman <w>latte</w> het hele plafond zorgvuldig af voordat hij de gipsplaten bevestigde.",
                            "target_lang_translations": {
                                "it": "Il falegname <w>listellò</w> con cura l'intero soffitto prima di fissare i pannelli di cartongesso."
                            }
                        },
                        {
                            "text": "Vroeger <w>latte</w> hij de wanden altijd zelf bij elke verbouwing in zijn huis.",
                            "target_lang_translations": {
                                "it": "In passato <w>listellava</w> sempre lui stesso le pareti durante ogni ristrutturazione della sua casa."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "verleden tijd"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "passato singolare di 'latten' (listellare, posizionare listelli di legno)"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "listellava",
                                "target_lang_sense_clarification": "applicava listelli di legno"
                            },
                            {
                                "target_lang_word": "listellò",
                                "target_lang_sense_clarification": "ha applicato listelli di legno"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dcf14596-dbde-3ea5-a660-a66c5c96de3d",
                    "sense_definition": "aanvoegende wijs van <w>latten</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "latten_conjunctief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het voorschrift eiste dat men het plafond volgens de regels der kunst <w>latte</w>.",
                            "target_lang_translations": {
                                "it": "La norma richiedeva che si <w>listellasse</w> il soffitto a regola d'arte."
                            }
                        },
                        {
                            "text": "Men verlangde dat hij het houten raamwerk direct <w>latte</w> om vertraging te voorkomen.",
                            "target_lang_translations": {
                                "it": "Si pretendeva che egli <w>listellasse</w> direttamente l'intelaiatura di legno per evitare ritardi."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "aanvoegende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "congiuntivo di 'latten' (listellare)"
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "listellasse",
                                "target_lang_sense_clarification": "congiuntivo imperfetto di listellare"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}