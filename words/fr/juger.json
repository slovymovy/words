                    "sense_id": "851920be-153c-32bc-a9a6-f4e5ebde2e70",
                    "sense_definition": "Considérer, estimer que quelque chose présente telle caractéristique ou telle qualité.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "opinion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La direction a <w>jugé</w> nécessaire de reporter la réunion à la semaine suivante.",
                            "target_lang_translations": {
                                "en": "Management <w>considered</w> it necessary to postpone the meeting until the following week.",
                                "ru": "Руководство <w>сочло</w> нужным перенести совещание на следующую неделю.",
                                "nl": "De directie <w>achtte</w> het nodig de vergadering uit te stellen tot de week erna.",
                                "de": "Die Geschäftsleitung <w>hielt</w> es für nötig, die Besprechung auf die folgende Woche zu verschieben.",
                                "pl": "Kierownictwo <w>uznało</w> za konieczne przełożenie spotkania na następny tydzień.",
                                "it": "La direzione ha <w>ritenuto</w> necessario rinviare la riunione alla settimana successiva.",
                                "cs": "Vedení <w>považovalo</w> za nutné přesunout schůzku na následující týden.",
                                "tr": "Yönetim toplantıyı önümüzdeki haftaya ertelemeyi <w>gerekli gördü</w>.",
                                "es": "La dirección <w>consideró</w> necesario aplazar la reunión a la semana siguiente.",
                                "zh": "管理层<w>认为</w>有必要把会议推迟到下周。"
                            }
                        },
                        {
                            "text": "Elle a <w>jugé</w> bon de prévenir ses collègues avant de prendre une décision.",
                            "target_lang_translations": {
                                "en": "She <w>deemed</w> it wise to warn her colleagues before making a decision.",
                                "ru": "Она <w>сочла</w> разумным предупредить коллег, прежде чем принять решение.",
                                "nl": "Zij <w>vond</w> het verstandig haar collega's te waarschuwen voordat ze een besluit nam.",
                                "de": "Sie <w>hielt</w> es für klug, ihre Kollegen vorzuwarnen, bevor sie eine Entscheidung traf.",
                                "pl": "Uznała za stosowne uprzedzić współpracowników, zanim podjęła decyzję.",
                                "it": "Ha <w>ritenuto</w> opportuno avvertire i colleghi prima di prendere una decisione.",
                                "cs": "<w>Považovala</w> za vhodné upozornit kolegy dřív, než se rozhodla.",
                                "tr": "Karar vermeden önce meslektaşlarını uyarmayı <w>uygun buldu</w>.",
                                "es": "Ella <w>consideró</w> oportuno avisar a sus compañeros antes de tomar una decisión.",
                                "zh": "她<w>觉得</w>在做决定之前先提醒一下同事比较妥当。"
                            }
                        }
                    ],
