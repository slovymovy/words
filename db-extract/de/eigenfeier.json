                "senses": [
                    {
                        "sense_id": "134483ad-8776-3dd0-91eb-f975f122cc3f",
                        "entry_id": "e179da64-da7d-3aa7-9760-98b8e0c23ce3",
                        "glosses": [
                            "liturgische Gewichtung eines Tages (also als Hochfest, Fest, gebotener Gedenktag oder nichtgebotener Gedenktag), die nur in einem Bistum oder einer Ordensgemeinschaft gilt"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "46aaabdd-a12c-40dc-8f2b-0ce87fe9e5df",
                                "sense_id": "134483ad-8776-3dd0-91eb-f975f122cc3f",
                                "text": "Der 22. März ist im Erzbistum Berlin ein nichtgebotener Gedenktag des seligen Clemens August Kardinal Graf von Galen (Bischof von Münster); dies ist eine Eigenfeier."
                            },
                            {
                                "example_id": "f3f7f332-63fc-4be0-ab95-7a77921de9c0",
                                "sense_id": "134483ad-8776-3dd0-91eb-f975f122cc3f",
                                "text": "Eine „Eigenfeier ist ein nur in einer bestimmten Diözese oder einer Ordensgemeinschaft begangenes, oder in diesem Bereich gegenüber der Weltkirche aufgewertetes liturgisches Fest, z. B. das von Lokalheiligen.“"
                            },
                            {
                                "example_id": "3003b47a-f900-4ac5-889f-65c51face798",
                                "sense_id": "134483ad-8776-3dd0-91eb-f975f122cc3f",
                                "text": "„Die neue Ausgabe der Trierer Eigenfeiern soll dafür sorgen, dass die Feste und Gedenktage der Heiligen und Seligen der Trierischen Kirche auch in Zukunft in der Messfeier oder auch in Wort-Gottes-Feiern mit den passenden Gebeten und Lesungen gefeiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
