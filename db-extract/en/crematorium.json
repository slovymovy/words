                                        "sense_id": "9d786608-bc43-312a-ad34-8f71c1e5b3c3",
                                        "entry_id": "9ee2f6cc-72f5-3a16-8980-5e7d7657b157",
                                        "glosses": [
                                            "Qui a rapport à la crémation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c08db47-98e2-4cf0-899b-3402b0fdd331",
                                                "sense_id": "9d786608-bc43-312a-ad34-8f71c1e5b3c3",
                                                "text": "Orné du croissant, les cheveux tressés, recouvert d’une peau d’éléphant, paré d’un collier de cobras et enduit de cendres provenant du champ crématoire, Shiva fit appeler l’un de ses Gana et lui dit : « Je m’en vais faire le tour du monde. Dis à notre Taureau sacré de se tenir prêt »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "crématoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9a33f8e0-fe3d-3df2-b53e-eaaf9c38ce5b",
                                        "entry_id": "0b3c1d4a-79d1-328c-8648-de4c0e66b261",
                                        "glosses": [
                                            "Crématorium."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c9ed782-74fb-4d66-8752-e1ece6eb7ccd",
                                                "sense_id": "9a33f8e0-fe3d-3df2-b53e-eaaf9c38ce5b",
                                                "text": "Le crématoire de Milan, construit aux frais et par un legs du chevalier A. Keller, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "902dbccb-d755-4a73-9558-86faa0fdf398",
                        "source_entry_id": "61241cff-fed1-3630-bd5e-b88db1574b3d",
                        "source_sense_id": "f1e66701-6a96-3173-be65-89630284feb0",
                        "source_sense_description": "place where dead bodies are cremated",
                        "target_lang_word": "Krematorium",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krematorium",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "34d72bee-3d52-3f7b-9dfe-44c54b902217",
                                        "entry_id": "a2681917-ca27-39fc-91bd-553b0a4dd0aa",
                                        "glosses": [
                                            "Anlage, in der Leichen der Verbrennung zugeführt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abd7a6b-fd04-4f92-abc2-076b42237bfd",
                                                "sense_id": "34d72bee-3d52-3f7b-9dfe-44c54b902217",
                                                "text": "Die Aufbahrungsräume des Krematoriums sind äußerst geschmackvoll eingerichtet."
                                            },
                                            {
                                                "example_id": "4d3b453f-5666-49df-b8d0-0cf2b0918bf2",
                                                "sense_id": "34d72bee-3d52-3f7b-9dfe-44c54b902217",
                                                "text": "Das Krematorium steht in unmittelbarer Nähe zum Friedhof."
                                            },
                                            {
                                                "example_id": "633209de-85bf-41f4-8ade-c7c3cd539b8d",
                                                "sense_id": "34d72bee-3d52-3f7b-9dfe-44c54b902217",
                                                "text": "„Kurz hinter der schottischen Grenze parkten sie den Bücherbus hinter einem stillgelegten Krematorium, zogen sich ihre Verkleidungen an und gingen auf eine Kirmes, die man an der Grenze zu einem Nationalpark aufgestellt hatte.“"
                                            },
                                            {
                                                "example_id": "9c1ec306-7374-4d22-893d-d9b3e006c41a",
                                                "sense_id": "34d72bee-3d52-3f7b-9dfe-44c54b902217",
                                                "text": "[KZ Bergen-Belden Januar bis April 1945:] „Das kleine Krematorium reicht längst nicht mehr aus, um alle Leichen zu verbrennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
