                    {
                        "sense_id": "4ca96e14-433a-385c-9dfd-fd93f868bba5",
                        "entry_id": "adf4accc-7ac5-366e-ad7c-197dc615bae3",
                        "glosses": [
                            "dirty, filthy, disgusting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d228ce0-2b56-40f9-a00e-f8f5b626fc54",
                                "sense_id": "4ca96e14-433a-385c-9dfd-fd93f868bba5",
                                "text": "De gootsteen ziet er goor uit.",
                                "translation": "The sink looks filthy.",
                                "english": "The sink looks filthy."
                            },
                            {
                                "example_id": "7b029e1a-06c4-4b0c-a17e-53295bbdb0e3",
                                "sense_id": "4ca96e14-433a-385c-9dfd-fd93f868bba5",
                                "text": "De vreemde man maakte gore opmerkingen naar voorbijgangers.",
                                "translation": "The strange man made filthy remarks to passers-by.",
                                "english": "The strange man made filthy remarks to passers-by."
                            },
                            {
                                "example_id": "4c496f65-90dd-49e8-9955-24fb2f240c02",
                                "sense_id": "4ca96e14-433a-385c-9dfd-fd93f868bba5",
                                "text": "Het gore lef!",
                                "translation": "The utter gall!",
                                "english": "The utter gall!"
                            }
                        ]
                    }
