                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0fab6e6d-db10-3222-8972-dcee7d5aa98e",
                        "entry_id": "a53716ec-c62c-313a-ba64-f1ee56688a21",
                        "glosses": [
                            "Of or pertaining to the breast, or chest."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b252d274-50ca-4d26-95b5-9a231a176501",
                                "sense_id": "0fab6e6d-db10-3222-8972-dcee7d5aa98e",
                                "text": "the pectoral muscles"
                            },
                            {
                                "example_id": "f647836d-52fd-4035-839f-a6cbf6bc2f42",
                                "sense_id": "0fab6e6d-db10-3222-8972-dcee7d5aa98e",
                                "text": "Clad in red robes and a gold pectoral cross, Agostini finally lowered his gaze as he crossed the marble floor."
                            },
                            {
                                "example_id": "046fadbb-06d9-4724-9988-d6a8d2389720",
                                "sense_id": "0fab6e6d-db10-3222-8972-dcee7d5aa98e",
                                "text": "... footballers, fashionable Counsel, corrupt parliamentarians, glistening Under Secretaries from helpful Whitehall Ministries, Greek shipowners, cockney hairdressers, unlisted maharajahs, drunk magistrates, venal mayors, ruling princes of countries that have ceased to exist, prelates in suède boots and pectoral crosses..."
                            }
                        ]
                    },
                    {
                        "sense_id": "f06106e0-d0ed-3180-beeb-00a287fe5f83",
                        "entry_id": "a53716ec-c62c-313a-ba64-f1ee56688a21",
                        "glosses": [
                            "Relating to, or good for, diseases of the chest or lungs."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "7f467f47-3e74-41ab-a376-879ce3af6eb3",
                                "sense_id": "f06106e0-d0ed-3180-beeb-00a287fe5f83",
                                "text": "But, in general, a few days' confinement, abstinence from flesh meat, and frequent sippings of some tepid pectoral drink, sufficed for the cure."
                            }
                        ]
                    },
                    {
                        "sense_id": "e17982aa-2e1e-3fc8-8713-047f1cb0ae88",
                        "entry_id": "a53716ec-c62c-313a-ba64-f1ee56688a21",
                        "glosses": [
                            "Having the breast conspicuously colored."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "eae39dfd-2472-4eec-96fb-9b0ffcacf8de",
                                "sense_id": "e17982aa-2e1e-3fc8-8713-047f1cb0ae88",
                                "text": "the pectoral sandpiper"
                            }
                        ]
                    }
                ],
