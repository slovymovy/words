        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7002228-8464-366f-91c4-081210ab4c09",
                    "sense_definition": "The profession or practice of providing care for the sick and infirm.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "healthcare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to pursue a career in <w>nursing</w> after volunteering at the local clinic.",
                            "target_lang_translations": {
                                "ru": "Она решила сделать карьеру в <w>сестринском деле</w> после волонтерства в местной клинике."
                            }
                        },
                        {
                            "text": "The hospital is facing a shortage of qualified <w>nursing</w> staff this year.",
                            "target_lang_translations": {
                                "ru": "В этом году больница столкнулась с нехваткой квалифицированного <w>медсестринского</w> персонала."
                            }
                        }
                    ],
                    "synonyms": [
                        "healthcare",
                        "medical care"
                    ],
                    "common_phrases": [
                        "nursing staff",
                        "nursing home",
                        "nursing degree"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессия или практика оказания помощи больным и немощным."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сестринское дело",
                                "target_lang_sense_clarification": "медицинская специальность"
                            },
                            {
                                "target_lang_word": "уход",
                                "target_lang_sense_clarification": "за больными"
                            },
                            {
                                "target_lang_word": "медсестринское дело",
                                "target_lang_sense_clarification": "профессиональная деятельность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7433fdee-2a3f-3893-94cd-483539e1f71a",
                    "sense_definition": "The act of suckling or breastfeeding an infant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor discussed the benefits of <w>nursing</w> for both the mother and the child.",
                            "target_lang_translations": {
                                "ru": "Врач обсудил пользу <w>кормления грудью</w> как для матери, так и для ребенка."
                            }
                        },
                        {
                            "text": "A quiet environment can make <w>nursing</w> a much more relaxing experience.",
                            "target_lang_translations": {
                                "ru": "Спокойная обстановка может сделать <w>кормление</w> гораздо более расслабляющим процессом."
                            }
                        }
                    ],
                    "synonyms": [
                        "breastfeeding",
                        "lactation",
                        "suckling"
                    ],
                    "common_phrases": [
                        "nursing mother",
                        "nursing bra"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт кормления младенца грудью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кормление грудью",
                                "target_lang_sense_clarification": "процесс"
                            },
                            {
                                "target_lang_word": "грудное вскармливание",
                                "target_lang_sense_clarification": "медицинский термин"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d13dbae5-e07f-3c53-9736-f21725da2db1",
                    "sense_definition": "Relating to the profession or duties of a nurse.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "healthcare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>nursing</w> staff worked overtime to ensure all patients were comfortable.",
                            "target_lang_translations": {
                                "ru": "<w>Сестринский</w> персонал работал сверхурочно, чтобы обеспечить комфорт всем пациентам."
                            }
                        },
                        {
                            "text": "He wore his <w>nursing</w> uniform with pride every day at the hospital.",
                            "target_lang_translations": {
                                "ru": "Он с гордостью носил свою <w>медсестринскую</w> форму каждый день в больнице."
                            }
                        }
                    ],
                    "synonyms": [
                        "medical"
                    ],
                    "common_phrases": [
                        "nursing care",
                        "nursing duties"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к профессии или обязанностям медицинской сестры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сестринский",
                                "target_lang_sense_clarification": "относящийся к медсестрам"
                            },
                            {
                                "target_lang_word": "медсестринский",
                                "target_lang_sense_clarification": "профессиональный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97b348d1-6e10-3973-b950-af5ba0c22b51",
                    "sense_definition": "In the state of suckling young or lactating.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "biological_care",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>nursing</w> bear stayed close to her cubs to protect them from predators.",
                            "target_lang_translations": {
                                "ru": "<w>Кормящая</w> медведица держалась рядом со своими медвежатами, чтобы защитить их от хищников."
                            }
                        },
                        {
                            "text": "A <w>nursing</w> mother requires extra calories to maintain her energy levels.",
                            "target_lang_translations": {
                                "ru": "<w>Кормящей</w> матери требуются дополнительные калории для поддержания уровня энергии."
                            }
                        }
                    ],
                    "synonyms": [
                        "lactating",
                        "suckling"
                    ],
                    "common_phrases": [
                        "nursing female"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся в состоянии вскармливания потомства или лактации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кормящая",
                                "target_lang_sense_clarification": "о матери или животном"
                            }
                        ]
                    }
                }
            ]
        },
