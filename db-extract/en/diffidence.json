    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "f18952ce-cffd-36c6-b1ae-4fd752f24382",
                "word": "diffidence",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ca6f17cb-e38a-4cab-879e-8d8d8876f78b",
                        "entry_id": "f18952ce-cffd-36c6-b1ae-4fd752f24382",
                        "tags": [
                            "plural"
                        ],
                        "form": "diffidences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "df249f98-6080-38f3-82c0-2a5349f6efc0",
                        "entry_id": "f18952ce-cffd-36c6-b1ae-4fd752f24382",
                        "glosses": [
                            "The state of being diffident, timid or shy; reticence or self-effacement."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1e6a1753-2c7c-461f-b660-7e98c87d2161",
                                "sense_id": "df249f98-6080-38f3-82c0-2a5349f6efc0",
                                "text": "Without scruple—without apology—without much apparent diffidence, Mr. Elton, the lover of Harriet, was professing himself her lover."
                            },
                            {
                                "example_id": "926fa0b3-3371-4949-ab0f-e5c32fb07862",
                                "sense_id": "df249f98-6080-38f3-82c0-2a5349f6efc0",
                                "text": "I have the same diffidence in my feelings that most public speakers have, and am apt to think that others can speak better and more edifying than I can."
                            },
                            {
                                "example_id": "5d06cf26-704a-46f5-9e5d-11efa3874d34",
                                "sense_id": "df249f98-6080-38f3-82c0-2a5349f6efc0",
                                "text": "\"I was passing by,\" he began to stammer, trembling with his diffidence, \"I—happened to be passing along this way, and so—er—as I was passing this way, I says to myself, says I, 'I'll just stop into the shop a minute.'"
                            },
                            {
                                "example_id": "2ad5572e-a259-4357-b272-31689437ad2d",
                                "sense_id": "df249f98-6080-38f3-82c0-2a5349f6efc0",
                                "text": "And Rick with unwonted diffidence had accepted his exclusion. Now with the same diffidence he came, looking trim and loving and mysteriously humble."
                            }
                        ]
                    },
                    {
                        "sense_id": "25d1b5b3-55b2-3ad8-9c2e-a43ae2d64472",
                        "entry_id": "f18952ce-cffd-36c6-b1ae-4fd752f24382",
                        "glosses": [
                            "Mistrust, distrust, lack of confidence in someone or something."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cbade3f9-cd1d-4105-9a33-ff76786b0423",
                                "sense_id": "25d1b5b3-55b2-3ad8-9c2e-a43ae2d64472",
                                "text": "[Charles, King of France]: We have been guided by thee hitherto,\nAnd of thy cunning had no diffidence:\nOne sudden foil shall never breed distrust."
                            },
                            {
                                "example_id": "3322fd54-2ddc-429b-a3d2-f4c28a4a3e15",
                                "sense_id": "25d1b5b3-55b2-3ad8-9c2e-a43ae2d64472",
                                "text": "[...] [H]ee had brought the Parliment into ſo juſt a diffidence of him, as that they durſt not leave the Public Armes to his diſpoſal [...]"
                            },
                            {
                                "example_id": "a6c6490c-e1bd-4067-90fe-4e86649ffdca",
                                "sense_id": "25d1b5b3-55b2-3ad8-9c2e-a43ae2d64472",
                                "text": "I have no diffidence of your abilities—only be constant to one roguery at a time"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c2dfde2-d279-428e-91bc-bf18b3942091",
                        "source_entry_id": "f18952ce-cffd-36c6-b1ae-4fd752f24382",
