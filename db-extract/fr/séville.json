                    {
                        "sense_id": "580151c3-9757-305b-806b-c9e0e2709b0e",
                        "entry_id": "910419d2-b790-37f6-976d-6203940d91b1",
                        "glosses": [
                            "Commune et ville d’Espagne, chef-lieu de la province du même nom et capitale de l’Andalousie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a596360-3cf6-417e-8b28-ff0a0c321825",
                                "sense_id": "580151c3-9757-305b-806b-c9e0e2709b0e",
                                "text": "Dès aujourd’hui, Bordeaux et Mont-de-Marsan cesseront de singer Séville et Cadix."
                            },
                            {
                                "example_id": "505e145f-0097-4f86-9fd0-e35e5496925f",
                                "sense_id": "580151c3-9757-305b-806b-c9e0e2709b0e",
                                "text": "Au tournoi de Séville, Nicolas Moreno de Alboran est resté dix minutes de trop dans les vestiaires pour se changer à la fin du deuxième set."
                            },
                            {
                                "example_id": "46952a3c-86c2-446f-bce8-f481cdae780d",
                                "sense_id": "580151c3-9757-305b-806b-c9e0e2709b0e",
                                "text": "Celui-ci a été écarté par la direction du Séville FC et remplacé par Jorge Sampaoli, qui a quitté l’Olympique de Marseille cet été, a annoncé le club dans un communiqué, jeudi."
                            }
                        ]
                    },
