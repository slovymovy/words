                                        "glosses": [
                                            "samice orla"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86c04985-6130-3d21-8a37-89e0f5e9c5af",
                                        "entry_id": "c7a58ee4-3c40-376f-a66e-1fb05bbc2b98",
                                        "glosses": [
                                            "vyobrazení orlice (1) na erbu, znaku apod."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31a45473-0f13-40b3-8558-14a224a8ca70",
                                                "sense_id": "86c04985-6130-3d21-8a37-89e0f5e9c5af",
                                                "text": "Po panu Soběslavovi z Miletínka zbyl nám štít z r. 1459, na němž vedlé jeho znaku šachovaného v pravé polovici ještě černá orlice Žerotínů českých na stříbrném štítě a řebřík pánů z Choustníka se nalézají."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
