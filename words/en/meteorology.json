{
    "word_family": [
        "meteorological",
        "meteorologist"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4efe450b-e440-392a-b923-39741171c9b3",
                    "sense_definition": "The scientific study of the atmosphere and its phenomena, particularly weather and weather forecasting.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to study <w>meteorology</w> because she was fascinated by how storms form.",
                            "target_lang_translations": {
                                "zh": "她决定学习<w>气象学</w>，因为她对风暴的形成方式非常着迷。"
                            }
                        },
                        {
                            "text": "Modern <w>meteorology</w> relies on advanced satellite data to provide accurate weather forecasts.",
                            "target_lang_translations": {
                                "zh": "现代<w>气象学</w>依靠先进的卫星数据来提供准确的天气预报。"
                            }
                        }
                    ],
                    "synonyms": [
                        "meteorology"
                    ],
                    "common_phrases": [
                        "study meteorology",
                        "modern meteorology"
                    ],
                    "target_lang_definitions": {
                        "zh": "研究大气层及其现象，特别是天气和天气预报的科学。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "气象学",
                                "target_lang_sense_clarification": "研究大气现象和天气预报的科学学科。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4398f7e1-8718-3bea-a095-65506383ac79",
                    "sense_definition": "The atmospheric conditions or phenomena characteristic of a specific region or time period.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local <w>meteorology</w> of the valley makes it prone to heavy fog during the winter months.",
                            "target_lang_translations": {
                                "zh": "该山谷的局部<w>气象条件</w>使其在冬季月份容易出现大雾。"
                            }
                        },
                        {
                            "text": "Researchers analyzed the <w>meteorology</w> of the region to understand the impact of climate change.",
                            "target_lang_translations": {
                                "zh": "研究人员分析了该地区的<w>气象特征</w>，以了解气候变化的影响。"
                            }
                        }
                    ],
                    "synonyms": [
                        "weatherlore"
                    ],
                    "common_phrases": [
                        "regional meteorology"
                    ],
                    "target_lang_definitions": {
                        "zh": "特定地区或特定时期的大气状况或现象。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "气象条件",
                                "target_lang_sense_clarification": "指特定区域内的大气环境状况。"
                            },
                            {
                                "target_lang_word": "气象特征",
                                "target_lang_sense_clarification": "指特定地区表现出的气象规律或特点。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}