                "senses": [
                    {
                        "sense_id": "080b6f57-8585-32f1-bd5c-c910e1a960b5",
                        "entry_id": "88b46756-5e8c-3ef8-836b-04cdc7f788c1",
                        "glosses": [
                            "Verletzung am Schädel"
