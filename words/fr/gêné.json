        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1eb0393a-5d18-3d55-ae2c-56cef6832160",
                    "sense_definition": "Qui éprouve de l'embarras, de la honte ou du malaise face à une situation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "embarras",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a eu un sourire <w>gêné</w> quand il s'est rendu compte de son erreur."
                        },
                        {
                            "text": "Après sa gaffe, un silence <w>gêné</w> est tombé sur toute la pièce."
                        }
                    ],
                    "common_phrases": [
                        "un sourire gêné",
                        "un silence gêné",
                        "avoir l'air gêné"
                    ]
                },
                {
                    "sense_id": "1f1b9892-74c8-38b5-ac38-c5c2d68b8e3e",
                    "sense_definition": "Qui manifeste de la timidité, qui manque d'aisance dans les relations avec les autres.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "embarras",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant est particulièrement <w>gêné</w> lorsqu'il doit parler devant des inconnus."
                        },
                        {
                            "text": "Elle restait <w>gênée</w> au fond de la salle au lieu de participer aux discussions."
                        }
                    ],
                    "synonyms": [
                        "timide"
                    ]
                },
                {
                    "sense_id": "d7f5b947-2155-333c-9b6d-2c76e059ef7e",
                    "sense_definition": "Qui manque d'argent pour honorer ses dépenses ou ses dettes, qui connaît des embarras financiers.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je suis un peu <w>gêné</w> financièrement ce mois-ci à cause de réparations imprévues."
                        },
                        {
                            "text": "Il a dû emprunter une petite somme car sa famille était temporairement <w>gênée</w>."
                        }
                    ],
                    "common_phrases": [
                        "être un peu gêné"
                    ]
                }
            ]
        },
        {
