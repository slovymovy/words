    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "73758308-4e96-3b86-9721-9a1675de82e9",
                    "sense_definition": "Having a small distance from one side to the other, especially compared to length.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dimensions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bus was too wide to fit through the <w>narrow</w> street.",
                            "target_lang_translations": {
                                "ru": "Автобус был слишком широким, чтобы проехать по <w>узкой</w> улице.",
                                "nl": "De bus was te breed om door de <w>smalle</w> straat te passen."
                            }
                        },
                        {
                            "text": "We walked along a <w>narrow</w> path through the forest.",
                            "target_lang_translations": {
                                "ru": "Мы шли по <w>узкой</w> тропинке через лес.",
                                "nl": "We liepen over een <w>smal</w> pad door het bos."
                            }
                        }
                    ],
                    "synonyms": [
                        "thin",
                        "slender",
                        "tight"
                    ],
                    "antonyms": [
                        "wide",
                        "broad"
                    ],
                    "common_phrases": [
                        "narrow street",
                        "narrow road",
                        "narrow path",
                        "narrow gap"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий малую ширину; небольшое расстояние от одной стороны до другой.",
                        "nl": "Met een geringe breedte; een kleine afstand van de ene kant naar de andere."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "у́зкий",
                                "target_lang_sense_clarification": "о размере"
                            },
                            {
                                "target_lang_word": "те́сный",
                                "target_lang_sense_clarification": "о пространстве"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "smal",
                                "target_lang_sense_clarification": "over de breedte"
                            },
                            {
                                "target_lang_word": "nauw",
                                "target_lang_sense_clarification": "over een krappe ruimte"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d00d412-04e0-314b-afb2-e6b0c0d01625",
                    "sense_definition": "Achieved or won by a very small amount or margin.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "margin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team celebrated their <w>narrow</w> victory over the champions.",
                            "target_lang_translations": {
                                "ru": "Команда праздновала свою <w>трудную</w> победу над чемпионами.",
                                "nl": "Het team vierde hun <w>nipte</w> overwinning op de kampioenen."
                            }
                        },
                        {
                            "text": "He had a <w>narrow</w> escape when the tree fell right behind him.",
                            "target_lang_translations": {
                                "ru": "Он <w>едва</w> спасся, когда дерево упало прямо позади него.",
                                "nl": "Hij ontsnapte <w>ternauwernood</w> toen de boom vlak achter hem omviel."
                            }
                        }
                    ],
                    "synonyms": [
                        "close",
                        "tight"
                    ],
                    "common_phrases": [
                        "narrow escape",
                        "narrow margin",
                        "narrow victory",
                        "narrow majority"
                    ],
                    "target_lang_definitions": {
                        "ru": "Достигнутый с трудом или с очень небольшим перевесом.",
                        "nl": "Behaald of gewonnen met een zeer klein verschil of marge."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минима́льный",
                                "target_lang_sense_clarification": "о преимуществе"
                            },
                            {
                                "target_lang_word": "едва́ заме́тный",
                                "target_lang_sense_clarification": "о разнице"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "nipt",
                                "target_lang_sense_clarification": "over een overwinning of ontsnapping"
                            },
                            {
                                "target_lang_word": "krap",
                                "target_lang_sense_clarification": "met een kleine marge"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "35ec5f20-6400-3fbe-bcb0-60da7e634d81",
                    "sense_definition": "Limited in extent, variety, or scope; not including many things.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "limited",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The study focused on a <w>narrow</w> range of topics.",
                            "target_lang_translations": {
                                "ru": "Исследование было сосредоточено на <w>узком</w> круге тем.",
                                "nl": "Het onderzoek richtte zich op een <w>beperkt</w> aantal onderwerpen."
                            }
                        },
                        {
                            "text": "His experience is confined to a very <w>narrow</w> field of expertise.",
                            "target_lang_translations": {
                                "ru": "Его опыт ограничивается очень <w>узкой</w> областью знаний.",
                                "nl": "Zijn ervaring is beperkt tot een zeer <w>smal</w> vakgebied."
                            }
                        }
                    ],
                    "antonyms": [
                        "broad",
                        "wide"
                    ],
                    "common_phrases": [
                        "narrow range",
                        "narrow focus",
                        "narrow sense"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограниченный по охвату, разнообразию или содержанию.",
                        "nl": "Beperkt in omvang, verscheidenheid of reikwijdte; niet veel dingen omvattend."
