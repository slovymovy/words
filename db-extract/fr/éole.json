                "forms": [],
                "senses": [
                    {
                        "sense_id": "d49d1e63-8f15-31c1-9147-afe1712c7951",
                        "entry_id": "ca4fca21-1f46-3024-857a-0a5310e70a88",
                        "glosses": [
                            "Maître et régisseur des vents dans la mythologie grecque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03df584e-599b-4ddb-99ee-7719fbd55379",
                                "sense_id": "d49d1e63-8f15-31c1-9147-afe1712c7951",
                                "text": "Dans une vaste caverne, Éole tient enchaînés et emprisonnés les vents, qui s’efforcent de fuir, ainsi que les tempêtes bruyantes."
                            },
                            {
                                "example_id": "97e6de85-bc60-4847-8930-18c8ee858cc2",
                                "sense_id": "d49d1e63-8f15-31c1-9147-afe1712c7951",
                                "text": "Aussi Rodolphe s’emporta en imprécations furibondes contre Éole et toute sa famille le brise-tout."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92f21390-2eb0-4c98-9474-da542b9d552b",
                        "source_entry_id": "ca4fca21-1f46-3024-857a-0a5310e70a88",
                        "source_sense_id": "d49d1e63-8f15-31c1-9147-afe1712c7951",
                        "source_sense_description": "Divinité grecque",
