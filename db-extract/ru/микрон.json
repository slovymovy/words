                                            {
                                                "example_id": "634af56e-60cd-4b86-9514-697f08cc0887",
                                                "sense_id": "ddb77187-8399-360a-9454-6d95e12897cb",
                                                "text": "Holonyms: millimetre < centimetre < decimetre < metre < kilometre < megametre < gigametre < terametre < petametre"
                                            },
                                            {
                                                "example_id": "5a99edaf-cb82-481e-a40f-e17a118bc93a",
                                                "sense_id": "ddb77187-8399-360a-9454-6d95e12897cb",
                                                "text": "Meronyms: picometre < nanometre"
                                            }
