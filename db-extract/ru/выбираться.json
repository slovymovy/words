                            "past"
                        ],
                        "form": "выбира́вшись"
                    },
                    {
                        "form_id": "7967043c-4662-436d-8e70-e6fe56fce007",
                        "entry_id": "663f97df-00dc-3ca0-a209-22e67052e510",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… выбира́ться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "994d9f82-6c0d-3bb0-9f55-42de06609cb2",
                        "entry_id": "663f97df-00dc-3ca0-a209-22e67052e510",
                        "glosses": [
                            "выходить, выезжать откуда-либо (из тесноты, из неудобного места)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c6a1ce6-ce92-4ae2-9aaa-4096d761ba88",
                                "sense_id": "994d9f82-6c0d-3bb0-9f55-42de06609cb2",
                                "text": "Выбираться из болота на хорошую дорогу."
                            },
                            {
                                "example_id": "f8ed9896-aa0e-446d-b0fb-cc00957625c0",
                                "sense_id": "994d9f82-6c0d-3bb0-9f55-42de06609cb2",
                                "text": "Выбираться из леса в поле."
                            }
                        ]
                    },
                    {
                        "sense_id": "709abe45-8c3b-38a7-8aa0-6e4ebf3db3dc",
                        "entry_id": "663f97df-00dc-3ca0-a209-22e67052e510",
                        "glosses": [
                            "перен., разг., фам. освобождаться, выпутываться (из затруднительного положения), находить выход из какой-либо ситуации"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1b73d0c-de96-4100-809e-1d71bfb19d6c",
                                "sense_id": "709abe45-8c3b-38a7-8aa0-6e4ebf3db3dc",
                                "text": "Выбираться из долгов."
                            }
                        ]
                    },
                    {
                        "sense_id": "986014e3-6f8f-3b4a-9ec6-5b572c4f544d",
                        "entry_id": "663f97df-00dc-3ca0-a209-22e67052e510",
                        "glosses": [
                            "фам. покидать помещение, квартиру, забирая с собою пожитки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4da266cb-1222-4b0d-902a-6e3cc9faf049",
                                "sense_id": "986014e3-6f8f-3b4a-9ec6-5b572c4f544d",
                                "text": "Надо выбираться из холодной квартиры."
                            }
                        ]
                    },
                    {
                        "sense_id": "473401aa-e7a1-3cbb-bad0-87cd4cc614c7",
                        "entry_id": "663f97df-00dc-3ca0-a209-22e67052e510",
                        "glosses": [
                            "разг. с трудом находить возможность пойти, отправиться куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24fe7f22-3cab-4a6d-b511-0eaf2faf01bb",
                                "sense_id": "473401aa-e7a1-3cbb-bad0-87cd4cc614c7",
                                "text": "Так занят, что не чаще 3—4 раз в год в театр выбирается."
                            },
                            {
                                "example_id": "b1b55301-8b5a-4614-bdd1-51d207f6f570",
                                "sense_id": "473401aa-e7a1-3cbb-bad0-87cd4cc614c7",
                                "text": "Профессор, большую часть времени проводивший в глубине квартиры, в кабинете, откуда раздавался слабый и неритмичный стук пишущей машинки, несколько раз в день выбирался на кухню, с неопределённой улыбкой пил слабый чай, съедая бутерброд с колбасным сыром, и, с удовольствием послушав разного небезынтересного разговору, удалялся снова в кабинет."
                            }
                        ]
                    },
                    {
                        "sense_id": "c8fb5df3-7878-36c9-8755-8f98ea45cc93",
                        "entry_id": "663f97df-00dc-3ca0-a209-22e67052e510",
                        "glosses": [
                            "страд. к выбирать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "dc4cc4e5-63b8-448b-9923-57eb264137b4",
                                "sense_id": "c8fb5df3-7878-36c9-8755-8f98ea45cc93",
                                "text": "Председатель выбирается присутствующими из своей среды."
                            },
                            {
                                "example_id": "2690684d-cfd9-4bd4-9afe-f717275156ff",
                                "sense_id": "c8fb5df3-7878-36c9-8755-8f98ea45cc93",
                                "text": "Крестьянин, который плоше всех в деревне, выбирается обыкновенно пасти стадо, потому что немного надобно ума пасти скотину."
                            }
                        ]
                    }
                ],
