                "senses": [
                    {
                        "sense_id": "a6be7f58-d500-328f-9165-ce0466b43367",
                        "entry_id": "8b64d83e-4a9c-3da4-9360-a1c88d77c585",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de rephysicaliser (physicaliser à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f24b8cee-578c-4d9e-a185-b7df5c1c45b5",
                                "sense_id": "a6be7f58-d500-328f-9165-ce0466b43367",
                                "text": "Et s’il faut parler d’âme ou d’esprit, comme il arrive à Bachelard d’en parler au long de sa carrière, il convient de re-physicaliser l’âme et/ou l’esprit, autant que de magnifier les matières."
                            },
                            {
                                "example_id": "efc7c082-ec33-45e2-9a68-5a90a5bafd00",
                                "sense_id": "a6be7f58-d500-328f-9165-ce0466b43367",
                                "text": "Des écritures mathématiques se font axiomatiser, c’est-à-dire re-stratifier, re-sémiotiser ; des flux matériels se font re-physicaliser."
                            }
                        ]
                    }
                ],
