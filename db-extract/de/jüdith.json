                ],
                "senses": [
                    {
                        "sense_id": "0dfe817b-269b-3abc-8a42-4109575e22fe",
                        "entry_id": "f3cac0a6-4ac7-3682-8b40-d6bfe3e93e96",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fdb3c4c-bc02-489a-9dcc-dba7d47d0315",
                                "sense_id": "0dfe817b-269b-3abc-8a42-4109575e22fe",
                                "text": "Frau Jüdith ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d74b758c-dca9-4fbd-b654-27e07cc0d763",
                                "sense_id": "0dfe817b-269b-3abc-8a42-4109575e22fe",
                                "text": "Herr Jüdith wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "85ab03f5-f6ef-4635-8f87-f22a745f1cee",
                                "sense_id": "0dfe817b-269b-3abc-8a42-4109575e22fe",
                                "text": "Die Jüdiths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d3513d2e-4df1-4328-af52-c905eb8f4c3e",
                                "sense_id": "0dfe817b-269b-3abc-8a42-4109575e22fe",
                                "text": "Der Jüdith trägt nie die Schals, die die Jüdith ihm strickt."
                            },
                            {
                                "example_id": "d82284e6-a3b6-4732-9660-9c7d349bf047",
                                "sense_id": "0dfe817b-269b-3abc-8a42-4109575e22fe",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jüdith kommt, geht der Herr Jüdith.“"
                            },
                            {
                                "example_id": "a138b560-80b9-402c-ac7b-0a33451d7469",
                                "sense_id": "0dfe817b-269b-3abc-8a42-4109575e22fe",
                                "text": "Jüdith kommt und geht."
                            },
                            {
                                "example_id": "ca042ec7-9d61-4f7b-a828-1f0e91f88734",
                                "sense_id": "0dfe817b-269b-3abc-8a42-4109575e22fe",
                                "text": "Jüdiths kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
