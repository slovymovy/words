                "senses": [
                    {
                        "sense_id": "8c8fc63e-f13e-3f6c-a09e-a041c7c18bfc",
                        "entry_id": "1c45f15e-5c11-3431-8cfa-9e8b9698ff6b",
                        "glosses": [
                            "een bedrijf dat zich toelegt op het brouwen van bier"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f445f6d-0443-46ba-8cf7-27c8a039d107",
                                "sense_id": "8c8fc63e-f13e-3f6c-a09e-a041c7c18bfc",
                                "text": "België kent een groot aantal brouwerijen."
                            },
                            {
                                "example_id": "9b9d78e2-14a6-4123-b7e4-0aeb4deed9a9",
                                "sense_id": "8c8fc63e-f13e-3f6c-a09e-a041c7c18bfc",
                                "text": "En dan heb je nog de kosten op de trail zelf: eten, de resupplypostpakketkosten, hostel- en motelkosten enzovoort. Je bent hier al met al tussen 2.500 euro tot 4.500 euro aan kwijt. Verder tikten de IPA-craft biertjes uit de lokale brouwerijen ook aardig aan."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46075c32-62e0-4e68-8adc-e5d8c17599d2",
                        "source_entry_id": "1c45f15e-5c11-3431-8cfa-9e8b9698ff6b",
                        "source_sense_id": "8c8fc63e-f13e-3f6c-a09e-a041c7c18bfc",
                        "source_sense_description": "een bedrijf dat zich toelegt op het brouwen van bier",
                        "target_lang_word": "Brauerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Brauerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "de734ad2-a4e9-3c6b-b013-7665c3975e84",
                                        "entry_id": "c963a30a-7390-3c18-947a-a9d8e4f0d448",
                                        "glosses": [
                                            "Unternehmen, das Bier oder andere Gärgetränke (zum Beispiel Limonade) braut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "013f7c95-1bfa-4e23-a86f-08c52422e8e3",
                                                "sense_id": "de734ad2-a4e9-3c6b-b013-7665c3975e84",
                                                "text": "Es gibt verschiedene Typen von Brauereien, die unterschiedliche Sorten Bier nach verschiedenen Verfahren mit unterschiedlichem Automatisierungsgrad herstellen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "76e53888-b5d6-3ebd-af45-38430cd30b8f",
                                        "entry_id": "c963a30a-7390-3c18-947a-a9d8e4f0d448",
                                        "glosses": [
                                            "Gebäude, in dem Bier oder andere Gärgetränke gebraut werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce01f15e-5eb8-4795-8ab7-3678cb4af2ee",
                                                "sense_id": "76e53888-b5d6-3ebd-af45-38430cd30b8f",
                                                "text": "Bei einer Führung konnten die Besucher einen Blick in die alte Brauerei mit ihren großen kupfernen Sudkesseln werfen."
                                            },
                                            {
                                                "example_id": "77b67f8f-847b-42e1-a388-b6dbf4d0c97b",
                                                "sense_id": "76e53888-b5d6-3ebd-af45-38430cd30b8f",
                                                "text": "„Später beherbergte das Haus eine koschere Schlachterei, überstand die Bombardements und wurde 1959 abgerissen, um für die Erweiterung einer Brauerei in der Nähe Platz zu machen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2ae70705-d889-3459-adfd-4062df49c7c8",
                                        "entry_id": "c963a30a-7390-3c18-947a-a9d8e4f0d448",
                                        "glosses": [
                                            "Prozess, Herstellung von Bier oder anderen Gärgetränken"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
