                    {
                        "translation_id": "90a8c380-bca6-4d42-9c7c-e91078eb5908",
                        "source_entry_id": "f2cbe753-0e04-3f15-8b4c-1569f1ecc38a",
                        "source_sense_id": "687614dd-fa7d-3394-ad33-832bcdc9b30d",
                        "target_lang_word": "pince à épiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pince à épiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                        "entry_id": "6eb8859c-0635-368a-aa6c-5cdd24f5d534",
                                        "glosses": [
                                            "Pince manuelle dont les branches font ressort et servant à enlever les poils ou à effectuer un travail de précision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33ba5ef6-e9fa-46c4-9e07-cee6ee8ff4b5",
                                                "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                                "text": "La pince à épiler demeure néanmoins utile entre deux séances d’épilations à la cire."
                                            },
                                            {
                                                "example_id": "4bcd2ad6-e74c-45ca-9088-b75d001c4e94",
                                                "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                                "text": "Par désœuvrement, elle prit une pince à épiler dans son sac sur la table de nuit, s’arracha un poil sur le mollet en grimaçant, remit la pince dans son sac, regarda Dobbs, se redressa d'un coup, reprit la pince à épiler, arracha un poil sur le nez de Dobbs…"
                                            },
                                            {
                                                "example_id": "fa025fad-9720-4d71-987c-1d550b3efe5f",
                                                "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                                "text": "Le prélèvement se fera avec une pince à épiler par prélèvement direct des cheveux cassés fluorescents ou avec un grattoir en raclant la zone alopécique et en faisant ainsi tomber les cheveux."
                                            },
                                            {
                                                "example_id": "19ed5fe3-222d-48b5-b859-cd9e948027d8",
                                                "sense_id": "e3e17717-3631-3f34-a593-fd6eac375bbb",
                                                "text": "Nous collons un premier tenon à la pince à épiler et attendons son séchage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4ee6e8a-a3ad-4bf6-b16c-c111b446e67b",
                        "source_entry_id": "f2cbe753-0e04-3f15-8b4c-1569f1ecc38a",
                        "source_sense_id": "687614dd-fa7d-3394-ad33-832bcdc9b30d",
                        "target_lang_word": "Pinzette",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pinzette",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                        "entry_id": "89bcb9a6-a80b-34b7-978c-b24927f96faf",
                                        "glosses": [
                                            "Instrument, das zum Greifen und Halten kleiner Gegenstände benutzt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbf6e3b1-c803-46de-9646-e215c244139e",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "Die kleinen Bauteile kann man nur mit Hilfe einer Pinzette greifen."
                                            },
                                            {
                                                "example_id": "54808e26-2c2f-4e63-991c-25f9fc868c3f",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "Mit einer kleinen Pinzette zupfen sich Frauen störende Haare aus dem Gesicht."
                                            },
                                            {
                                                "example_id": "f73ba36c-869f-43a7-ae89-f70a716226f4",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "„Immer wieder rutscht die Pinzette ab oder ich kriege das Insekt nicht richtig am Kopf zu fassen.“"
                                            },
                                            {
                                                "example_id": "390a63fb-4887-4edf-8714-f4cb0c0fabdf",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "„Mit einer Pinzette faßte er eine Ecke von Herrn Puntareras' Konterfei, über der sich kein Stempel befand und hob sie äußerst vorsichtig einen Millimeter hoch.“"
                                            },
                                            {
                                                "example_id": "b04b0995-24ef-4b8d-a060-7059f93c540b",
                                                "sense_id": "051c5e7b-4b52-33d8-a958-1d683b925982",
                                                "text": "„Er knackt die Scheren mit einem Nußknacker und zieht das Fleisch mit einer gebogenen Pinzette heraus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae2ff4f3-4e90-4d23-b049-2c241b56df7f",
