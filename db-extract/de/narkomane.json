                                    },
                                    {
                                        "sense_id": "7fbbfdca-ee5c-3b00-810e-d928683faeb2",
                                        "entry_id": "3c4addc1-21ad-34da-8453-04bd2cc6edb7",
                                        "glosses": [
                                            "To devote (one's mind, talent etc.) to a given activity, occupation, thing etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
