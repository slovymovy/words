                        "glosses": [
                            "Relatif à l’évolution."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a27c44d-09e9-4329-955b-65beb3d54bcd",
                                "sense_id": "6fe9471d-698e-355d-973a-e367978ef0f5",
                                "text": "Les grottes de Mulu sont importantes pour les caractéristiques classiques de la géomorphologie souterraine qui illustrent une histoire évolutionnaire de plus de 1,5 million d’années. (UNESCO)"
                            }
                        ]
                    }
