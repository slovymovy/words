                                        "entry_id": "c51ed6b9-17f0-35a6-9ced-fcc585ad38b8",
                                        "glosses": [
                                            "устройство для видеосъёмки, преобразующее изображение в электрический сигнал"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
