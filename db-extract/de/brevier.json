                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4a8a6b2f-6eab-30b7-bbf0-811c84e54327",
                        "entry_id": "773debe1-aa30-3170-b9a1-202b4e1f4d99",
                        "glosses": [
                            "kurze Sammlung wichtiger Stellen aus den Werken eines Dichters"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ba8918b5-66bb-494f-a3ee-61a73adcfb86",
                                "sense_id": "4a8a6b2f-6eab-30b7-bbf0-811c84e54327",
                                "text": "Ich muss für die Schule noch ein Brevier zusammenstellen."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ec651822-2bd0-357d-b1d4-a54213733b3c",
                        "entry_id": "773debe1-aa30-3170-b9a1-202b4e1f4d99",
                        "glosses": [
                            "kurzer, praktischer Leitfaden"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "ffdba124-0996-42a2-a96c-028e4ff41e13",
                                "sense_id": "ec651822-2bd0-357d-b1d4-a54213733b3c",
                                "text": "Das hier ist ein Brevier für gutes Benehmen."
                            },
                            {
                                "example_id": "d95bd763-a20a-4f18-9fd1-9d8c6fbf6b62",
                                "sense_id": "ec651822-2bd0-357d-b1d4-a54213733b3c",
                                "text": "„Das Laoner Brevier war eine Sammlung von praktischen Verhaltungsmaßregeln auf der Flucht und von Erfahrungen, die von den Emigranten auf der Via Dolorosa untereinander weitergegeben wurden.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
