                "senses": [
                    {
                        "sense_id": "d25497cb-ee67-325a-a3c0-d8b5b4e8cdc9",
                        "entry_id": "557585bb-e25e-35d4-ba36-7da12ae8965b",
                        "glosses": [
                            "Celui qui évangélise un pays, une région."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c89a6481-13c6-4e3c-8689-04719d026b09",
                                "sense_id": "d25497cb-ee67-325a-a3c0-d8b5b4e8cdc9",
                                "text": "Les Jésuites furent les évangélisateurs de la Chine."
                            },
                            {
                                "example_id": "6c86c90d-0fd4-4746-a3f8-3182b2783ddb",
                                "sense_id": "d25497cb-ee67-325a-a3c0-d8b5b4e8cdc9",
                                "text": "C’est certainement une réponse à l’attente de Rimbert qui a été un évangélisateur zélé et dont la carrière a été entièrement liée au développement des missions vers le nord et l’est de l’Europe."
                            }
                        ]
                    },
                    {
                        "sense_id": "89f76510-e184-3e4d-8411-73d29f0f944c",
                        "entry_id": "557585bb-e25e-35d4-ba36-7da12ae8965b",
                        "glosses": [
                            "Dans la Chrétienté, ce mot signifie : Prédicateur de l’évangile ou bonne nouvelle ; porteur d’un bon message. Le terme grec euaggélistês (évangélisateur) est étroitement apparenté au mot euaggélion, qui signifie “ bonne nouvelle ” ou “ évangile ”."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
