                        "entry_id": "decab44f-77dc-33e2-b160-32548a1ba2fc",
                        "glosses": [
                            "der mit Fenstern versehene Wandabschnitt einer Basilika über den Arkaden des Mittelschiffes"
                        ],
                        "tags": [
                            "Kunstgeschichte"
                        ],
                        "examples": [
                            {
                                "example_id": "8f7e20d6-1acb-4283-a842-17cd9bfb87aa",
                                "sense_id": "b3b2530d-05e7-3956-b9c7-a2680c860d4f",
                                "text": "Die Sonne strahlt wunderbar durch den Obergaden in die Kirche."
                            }
                        ],
                        "sense_index_json": "\"1\""
