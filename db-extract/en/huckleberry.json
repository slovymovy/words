    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "6d50d194-1d08-3ed0-9ec6-6eb186ac05a2",
                "word": "huckleberry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3b544603-4ba9-4853-a3fb-053ce0d657e7",
                        "entry_id": "6d50d194-1d08-3ed0-9ec6-6eb186ac05a2",
                        "tags": [
                            "plural"
                        ],
                        "form": "huckleberries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7add1ff0-e7e4-3290-bc13-f75725d6dfa0",
                        "entry_id": "6d50d194-1d08-3ed0-9ec6-6eb186ac05a2",
                        "glosses": [
                            "A small round fruit of a dark blue or red color, of several plants in the related genera Vaccinium and Gaylussacia."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78be41b6-b8af-4bfd-9aea-fbea0541d0c2",
                                "sense_id": "7add1ff0-e7e4-3290-bc13-f75725d6dfa0",
                                "text": "I stumbled along through the young pines and huckleberry bushes. Pretty soon I struck into a sort of path that, I cal'lated, might lead to the road I was hunting for. It twisted and turned, and, the first thing I knew, made a sudden bend around a bunch of bayberry scrub and opened out into a big clear space like a lawn."
                            }
                        ]
                    },
                    {
                        "sense_id": "e159a6e8-ce23-3b7d-933a-ad2ce86c8a94",
                        "entry_id": "6d50d194-1d08-3ed0-9ec6-6eb186ac05a2",
                        "glosses": [
                            "A shrub growing this fruit."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "4e397cd2-5a2c-3ec2-9165-94c65a4a2f5b",
                        "entry_id": "6d50d194-1d08-3ed0-9ec6-6eb186ac05a2",
                        "glosses": [
                            "A small amount, a short distance, as in the phrase huckleberry above a persimmon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26eeaa6b-0093-4c57-b238-c60ca51c65ed",
                                "sense_id": "4e397cd2-5a2c-3ec2-9165-94c65a4a2f5b",
                                "text": "Porter preferred prose to poetry. Prose seemed to him to be a concrete, practical form of expression. But poetry, as he informed a poet who signed his name “Evergreen,” was “a huckleberry beyond us.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "ff2c6d08-4285-31e7-9c60-c913692a5d20",
                        "entry_id": "6d50d194-1d08-3ed0-9ec6-6eb186ac05a2",
                        "glosses": [
                            "A person of little consequence."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7f21a717-cfa4-3bf7-a699-78019dbf392f",
                        "entry_id": "6d50d194-1d08-3ed0-9ec6-6eb186ac05a2",
                        "glosses": [
                            "The person one is looking for; the right person for the job."
                        ],
                        "tags": [
                            "US",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "af0f632d-ffcd-4704-8525-172af45ced7a",
                                "sense_id": "7f21a717-cfa4-3bf7-a699-78019dbf392f",
                                "text": "I'm your huckleberry."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
