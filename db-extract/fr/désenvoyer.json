                        "glosses": [
                            "Faire en sorte que quelque chose qui a été envoyé ne le soit plus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "463654d4-9f2b-48ef-8add-9db2c8d15e06",
                                "sense_id": "db006157-e7f8-3fcb-99e5-39d2e5226155",
                                "text": "Même moi, je ne peux pas désenvoyer des trucs, effacer des contenus, défaire."
                            },
                            {
                                "example_id": "96c85c91-065b-4af8-95bf-252e976685dc",
                                "sense_id": "db006157-e7f8-3fcb-99e5-39d2e5226155",
                                "text": "On peut « désenvoyer » un mail ?"
                            },
                            {
                                "example_id": "68033d1a-2c95-46a5-a73d-3aba3957c4ea",
                                "sense_id": "db006157-e7f8-3fcb-99e5-39d2e5226155",
                                "text": "Facebook pourrait vous permettre de «désenvoyer» des messages gênants."
                            },
                            {
                                "example_id": "de08f980-bce7-468c-80b7-788a10a7699a",
                                "sense_id": "db006157-e7f8-3fcb-99e5-39d2e5226155",
                                "text": "Techniquement, la fonction de désenvoi de Gmail ne désenvoie pas réellement votre email. Ce qu’elle fait en réalité, c’est retarder l’envoi de votre message de quelques secondes, vous donnant la possibilité d’annuler l’envoi pendant que l’horloge tourne."
                            },
                            {
                                "example_id": "fad39ca7-e146-4727-bc8d-19df183401d3",
                                "sense_id": "db006157-e7f8-3fcb-99e5-39d2e5226155",
                                "text": "Il va bientôt être possible de « désenvoyer » un message sur Messenger."
                            }
