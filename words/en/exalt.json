    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f4aedc55-2a8e-3d18-8a52-fa6f826ef1e3",
                    "sense_definition": "To praise, revere, or hold someone or something in high esteem.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "praise_elevate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir sang traditional hymns to <w>exalt</w> the glory of God."
                        },
                        {
                            "text": "His poetry was composed to <w>exalt</w> the virtues of peace and tolerance."
                        }
                    ],
                    "antonyms": [
                        "abase",
                        "demean"
                    ],
                    "common_phrases": [
                        "exalt the virtues",
                        "exalt the name of"
                    ]
                },
                {
                    "sense_id": "1b127fbd-02ba-3132-a7c5-38dc4b9d8cdd",
                    "sense_definition": "To elevate someone or something to a higher rank, status, or position.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "praise_elevate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden military victory served to <w>exalt</w> him to supreme commander."
                        },
                        {
                            "text": "She was <w>exalted</w> to the position of chief executive after years of hard work."
                        }
                    ],
                    "synonyms": [
                        "upgrade"
                    ],
                    "antonyms": [
                        "abase",
                        "demean"
                    ],
                    "common_phrases": [
                        "exalt to the rank",
                        "exalt to a position"
                    ]
                },
                {
                    "sense_id": "1d6d4124-8fcd-303d-a567-0fdfc695fae1",
                    "sense_definition": "To fill someone with intense happiness, elation, or the joy of success.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The unexpected triumph seemed to <w>exalt</w> his spirit after months of despair."
                        },
                        {
                            "text": "Listening to the majestic music would invariably <w>exalt</w> her mind."
                        }
                    ]
                },
                {
                    "sense_id": "53cd094d-30b5-3f43-bb09-ca5510a390ac",
                    "sense_definition": "To refine, purify, or elevate in quality or nature.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Alchemists believed that prolonged heat would <w>exalt</w> base elements into pure essence."
                        },
                        {
                            "text": "The distillation process was designed to <w>exalt</w> the medicinal properties of the plant."
                        }
