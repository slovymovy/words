        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "02ee10a2-b60e-3ca2-b526-87324bc10226",
                    "sense_definition": "Done or shown openly; plainly apparent and not concealed or secret.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "open_apparent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician faced severe criticism after making several <w>overt</w> threats against the press.",
                            "target_lang_translations": {
                                "ru": "Политик столкнулся с жёсткой критикой после того, как высказал несколько <w>открытых</w> угроз в адрес прессы."
                            }
                        },
                        {
                            "text": "There was an <w>overt</w> act of hostility when the troops crossed the recognized border.",
                            "target_lang_translations": {
                                "ru": "Пересечение войсками признанной границы стало <w>явным</w> актом враждебности."
                            }
                        }
                    ],
                    "synonyms": [
                        "manifest",
                        "open",
                        "patent",
                        "plain",
                        "unconcealed"
                    ],
                    "antonyms": [
                        "covert",
                        "hidden",
                        "nonovert"
                    ],
                    "common_phrases": [
                        "overt act",
                        "overt hostility",
                        "overt discrimination"
                    ],
                    "target_lang_definitions": {
