                                "example_id": "1d5e1335-c73f-4382-bb8e-0ee6cd68731c",
                                "sense_id": "f637c099-3cd1-3a31-ba95-d52dbf0e2dda",
                                "text": "The clumping of hobnailed boots on the gravel outside proclaimed the approach of Manning. John looked questioningly at Poirot."
                            },
