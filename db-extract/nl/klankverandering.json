                        "entry_id": "5ef6d070-6c96-3775-9f3a-fe8983a3cc07",
                        "glosses": [
                            "het verschijnsel dat een klank in een taal in de loop van de tijd vervangen wordt door een andere klank"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1976155-6bf5-47f5-9b0d-99e10d36c317",
                                "sense_id": "c809c0e1-2a2a-3423-adde-cd5118b13ba1",
                                "text": "In het Oudnederlands is een klankverandering opgetreden waarbij een /f/ voor een /t/ in een /x/ veranderde, waardoor we nu het woord lucht hebben in plaats van luft."
                            }
                        ]
                    }
                ],
