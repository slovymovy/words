                        "translation_id": "02411834-49c8-4b32-aa37-ffa1a6d6da24",
                        "source_entry_id": "18707fa5-269b-3a7f-91b1-30e7399b0f0d",
                        "source_sense_id": "d71d2188-ad80-395d-abe0-fc440dceeee3",
