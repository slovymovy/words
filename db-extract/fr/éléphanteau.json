                    {
                        "translation_id": "c7aedad0-c964-4d43-bd21-27ebb75e0c42",
                        "source_entry_id": "fcb22e35-7050-36c6-ad02-84569b056f10",
                        "source_sense_id": "1b901024-2519-3752-9c18-e9c9b7d8eca9",
                        "target_lang_word": "calf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
