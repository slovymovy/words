                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Dood</w> die vlieg voordat hij op het eten landt!",
                            "target_lang_translations": {
