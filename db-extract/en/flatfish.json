                                        "glosses": [
                                            "Poisson de mer au corps fortement aplati comme la sole et la limande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1053776-c9b5-4dc0-b3a3-a27ba47451e5",
                                                "sense_id": "f6a2a8e4-bf29-3439-97ea-9ada388880d2",
                                                "text": "Il s’attaque pratiquement à tout ce qu’il rencontre: la morue, l’aiglefin, la merluche, le hareng, le capelan, et tous les autres poissons plats qui vivent comme lui sur le fond de la mer."
                                            },
                                            {
                                                "example_id": "1ba10088-82cf-436d-a4ad-59165e89a66e",
                                                "sense_id": "f6a2a8e4-bf29-3439-97ea-9ada388880d2",
                                                "text": "Pascal Laffarque, chercheur en écologie marine à l’Ifremer, cite le cas de la plie, un poisson plat de la mer du Nord, affecté par la dégradation des fonds marins."
                                            }
                                        ]
                                    }
                                ]
                            }
