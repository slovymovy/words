                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af9ddb3e-49a0-4a11-b888-4253fe92089a",
                                "sense_id": "61c4d644-99c4-3582-9ccb-10ca64c835de",
                                "text": "Après la naissance de Paul, qui fut mis en nourrice dans un village voisin, c’étaient, chaque dimanche, de joyeuses promenades pour aller embrasser le cher petitou."
                            },
                            {
                                "example_id": "45be75f7-7555-4b50-98f8-fe00419e55d5",
                                "sense_id": "61c4d644-99c4-3582-9ccb-10ca64c835de",
                                "text": "Durant la semaine, j’ai appris qu’après avoir attaqué, sans le tuer, un enfant à Saint-Chély-d'Apcher, le 18 mars, la Dévorante aurait égorgé un petitou de dix ans à Aumont, deux jours plus tard, le mercredi avant les Rameaux."
                            }
                        ]
                    }
