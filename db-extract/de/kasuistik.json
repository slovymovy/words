                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "c75559d6-2c6d-4ec4-818a-5658498422d6",
                        "entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "die Kasuistik"
                    },
                    {
                        "form_id": "1452a1b1-ad6e-4702-9529-a8541cdd171f",
                        "entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Kasuistik"
                    },
                    {
                        "form_id": "dc9d9573-8cd9-4f97-ba12-cdadc4096102",
                        "entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Kasuistik"
                    },
                    {
                        "form_id": "58f1ad8e-4e68-43fb-b3cf-972fe1be045c",
                        "entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Kasuistik"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "524b0a5e-5262-3060-b8b9-f13902fe18f2",
                        "entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
                        "glosses": [
                            "die Darstellung von speziellen Einzelfällen"
                        ],
                        "tags": [
                            "Moraltheologie"
                        ],
                        "examples": [
                            {
                                "example_id": "e69bd60a-f814-4667-b778-eb38165b6b3a",
                                "sense_id": "524b0a5e-5262-3060-b8b9-f13902fe18f2",
                                "text": "„Die evangelische Ethik sieht in der Kasuistik die Gefahr eines grundsätzlichen Missverständnisses der Grundfrage sittlichen Verhaltens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "31b2e080-780f-387a-a757-89a35172e972",
                        "entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
                        "glosses": [
                            "die spezielle Beschreibung seltener Krankheitsfälle oder eigentümlicher Verlaufsformen von Krankheiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "435f3b16-ea70-445e-b7e8-4fbc88e45962",
                                "sense_id": "31b2e080-780f-387a-a757-89a35172e972",
                                "text": "„Hier veröffentlichen wir eine Auswahl an Kasuistiken und Fallbeschreibungen. Weitere aktuelle Kasuistiken aus der Via medici und anderen Zeitschriften können Sie als Via medici-Abonnent bei Via exklusiv lesen!“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "39be18d2-a3d4-37e7-89c4-53f05223232e",
                        "entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
                        "glosses": [
                            "Haarspalterei, Spitzfindigkeit"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "8c5ad038-15f0-4e23-b85f-83c55a3c9ca7",
                                "sense_id": "39be18d2-a3d4-37e7-89c4-53f05223232e",
                                "text": "„Daß eine völlige Verblendung, Vernunftverfinsterung des Intellekts wie der breiteren Volksschichten, wie sie der Staat verkörpert, nicht leicht zu beseitigen ist, wird klar, wenn man sich all die Massen von Irrtümern, Vorurteilen, philosophischen Hirngespinsten und sophistischer Kasuistik (Wortverdreherei, Haarspalterei) vergegenwärtigt, gegen die wir in unserer Arbeit anzukämpfen haben, ehe wir sie zum Abschluß bringen können.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11a81b69-f490-4169-9c92-f66f36b48bd6",
                        "source_entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
                        "source_sense_id": "524b0a5e-5262-3060-b8b9-f13902fe18f2",
                        "source_sense_description": "Recht, Moraltheologie: die Darstellung von speziellen Einzelfällen",
                        "target_lang_word": "casuistry",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "casuistry",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "520810c2-73d7-3e4b-8a52-98e1ee699159",
                                        "entry_id": "12767125-3458-32b1-89d4-446ed170cc88",
                                        "glosses": [
                                            "The process of answering practical questions via interpretation of rules, or of cases that illustrate such rules, especially in ethics; case-based reasoning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87e040ee-a8ae-4863-b540-a012818ab8c2",
                                                "sense_id": "520810c2-73d7-3e4b-8a52-98e1ee699159",
                                                "text": "Cages for Gnats, and Chains to Yoak a Flea; Dry'd Butterflies, and Tomes of Caſuiſtry"
                                            },
                                            {
                                                "example_id": "00474b9d-9659-4186-94ec-452fe4ba4e9f",
                                                "sense_id": "520810c2-73d7-3e4b-8a52-98e1ee699159",
                                                "text": "The letters of Margarita were all that the fondest lover could desire, the eye of a poet linger on, but they did not contain the casuistry which could lead Glentworth to renounce a faith which he had now been led to examine in a manner he had certainly never done before."
                                            },
                                            {
                                                "example_id": "5f5efb0d-09f3-4bb5-afef-7572145e129f",
                                                "sense_id": "520810c2-73d7-3e4b-8a52-98e1ee699159",
                                                "text": "And yet it would seem that the whole analysis he had made, his attempt to find a moral solution to the problem, was complete. His casuistry had been honed to a razor’s edge, and he could no longer think of any objections."
                                            },
                                            {
                                                "example_id": "94dece04-c018-4053-b4dd-c87fad86058f",
                                                "sense_id": "520810c2-73d7-3e4b-8a52-98e1ee699159",
                                                "text": "“And if you lose?” Diana enunciated, through a thin grin. She meant to extract casuistry’s penalty in advance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ac18f6c-d899-39b6-b5c0-582b30e1138b",
                                        "entry_id": "12767125-3458-32b1-89d4-446ed170cc88",
                                        "glosses": [
                                            "A specious argument designed to defend an action or feeling."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b45fb92-3844-4da6-a1f6-689bf53a6f33",
                                                "sense_id": "9ac18f6c-d899-39b6-b5c0-582b30e1138b",
                                                "text": "I felt it was hopeless to argue against casuistry of this nature, which, if it were carried to its logical conclusion, would absolutely destroy all morality, as we understand it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "539116da-b142-48b1-9dcc-f4383666840f",
                        "source_entry_id": "13ac965d-88d6-3ea1-a655-f03322edec18",
