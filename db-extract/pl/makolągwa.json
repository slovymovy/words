                "translations": [
                    {
                        "translation_id": "c93b27a9-24a5-4d60-9eba-252b57ade218",
                        "source_entry_id": "7241de4c-fe96-3d56-8a10-fda2079d49b0",
                        "source_sense_id": "3f0c891f-d69a-3726-b3ef-eba524a7088b",
                        "target_lang_word": "linnet",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linnet",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "38789845-ceb0-3dab-bc49-a8a4a5071f61",
                                        "entry_id": "1b25e9dc-9953-3886-bf49-9cda1a27c134",
                                        "glosses": [
                                            "A small passerine bird, the common linnet (Linaria cannabina, syn. Carduelis cannabina), in the finch family Fringillidae, native to Europe, western Asia, and north Africa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "958027e8-d6af-4a1d-baff-bd9ae30a2ea0",
                                                "sense_id": "38789845-ceb0-3dab-bc49-a8a4a5071f61",
                                                "text": "⁠I do but sing because I must,\nAnd pipe but as the linnets sing:\nAnd unto one her note is gay,\n⁠For now her little ones have ranged;\n⁠And unto one her note is changed,\nBecause her brood is stol’n away."
                                            },
                                            {
                                                "example_id": "ccb0ec6e-328e-416e-986a-26f77e62277b",
                                                "sense_id": "38789845-ceb0-3dab-bc49-a8a4a5071f61",
                                                "text": "I heard a linnet courting\nHis lady in the spring […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac450e52-79c8-3254-8122-599bc1434606",
                                        "entry_id": "1b25e9dc-9953-3886-bf49-9cda1a27c134",
                                        "glosses": [
                                            "A house finch (Haemorhous mexicanus), of North America."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "daa7a8ce-ab76-4497-9c11-2bb9af7dd0f4",
                        "source_entry_id": "7241de4c-fe96-3d56-8a10-fda2079d49b0",
                        "source_sense_id": "3f0c891f-d69a-3726-b3ef-eba524a7088b",
                        "target_lang_word": "linotte mélodieuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "linotte mélodieuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb1e91b6-296e-3fe6-84cf-7e547c8c1726",
                                        "entry_id": "e5059ffe-84a0-3a7a-9746-2b0834622987",
                                        "glosses": [
                                            "Espèce de petit oiseau passereau d’Eurasie et du nord de l’Afrique, voisin des pinsons, brun, à la poitrine rosée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3f50013-92f6-4030-938b-17770874dbea",
                                                "sense_id": "cb1e91b6-296e-3fe6-84cf-7e547c8c1726",
                                                "text": "En avril 1902, tandis que reparaissent l’hirondelle de cheminée et la linotte mélodieuse, qu’on entend le bruant proyer et que fleurissent l’arabette et l’ancolie, les ruches s’activent pour la miellée de printemps et l’ouvrier fait grève."
                                            },
                                            {
                                                "example_id": "d8320f3e-5cbf-4ff5-bb71-67292b189b12",
                                                "sense_id": "cb1e91b6-296e-3fe6-84cf-7e547c8c1726",
                                                "text": "Un couple de linottes mélodieuses est arrivé dans mon jardin haut, le mâle est dans sa livrée rouge sur la poitrine et ses chants sont très beaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
