                        "glosses": [
                            "Territoire gouverné par un ethnarque; dignité dʼethnarque."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "36f83c4d-0920-4a45-8e76-459743b7f38c",
                                "sense_id": "b908582a-89fd-3f73-b18b-a6c595f232e0",
                                "text": "Archélaüs ne fut pas plutôt en possession de son ethnarchie, quʼil fit peser sur le peuple la tyrannie la plus effrayante."
                            },
                            {
                                "example_id": "a47d54d8-4be8-441a-9bbe-6060fa8a28d4",
                                "sense_id": "b908582a-89fd-3f73-b18b-a6c595f232e0",
                                "text": "Deux ans plus tard, Archélaüs dont les Juifs se plaignaient des cruautés était destitué et exilé en Gaule. Son ethnarchie devint la province de Judée et fut confiée à un procurateur."
                            }
                        ]
                    }
