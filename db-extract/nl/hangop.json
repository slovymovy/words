                ],
                "senses": [
                    {
                        "sense_id": "134c15e0-4632-37f9-b001-0b64537d350f",
                        "entry_id": "6262ce9b-2448-3cfa-bbb4-35f20347cf5a",
                        "glosses": [
                            "uitgelekte karnemelk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6f5b657-0f4f-4e92-802a-4ea8990f549c",
                                "sense_id": "134c15e0-4632-37f9-b001-0b64537d350f",
                                "text": "Een ‘Rondje Tubbergen’ als dessert. Eigen wortelkoek met wortelkoekijs, advocaatmousse en hangop met stoofpeer. De advocaat is van de Boderie en de hangop van ’t Hoepel. In ’t Oale Roadhoes van Ruud Droste geniet u afsluitend van koffie met een huisgemaakte brownie."
                            },
                            {
                                "example_id": "a73e868b-4501-4055-ae6e-f554b6300bd1",
                                "sense_id": "134c15e0-4632-37f9-b001-0b64537d350f",
                                "text": "Coquille met een tartaar van gamba’s en een hangop van limoen en gember is uw voorgerecht, dat met een broodje en gezouten boter wordt geserveerd. De aanbevolen wijn is een fruitige Sauvigon Blanc 2017 van het Chileense wijnhuis Yelcho."
                            }
                        ]
                    },
                    {
                        "sense_id": "a13a0050-3bcb-3606-aeb7-901eaed54c05",
                        "entry_id": "6262ce9b-2448-3cfa-bbb4-35f20347cf5a",
                        "glosses": [
                            "uitgelekte volle yoghurt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "045bac11-6d55-4d33-8c6f-c2de74a26e84",
                                "sense_id": "a13a0050-3bcb-3606-aeb7-901eaed54c05",
                                "text": "Stork!-bezoekers krijgen voor de voorstelling voor 55 euro groentesoep met vlees, eiersalade met brood, een stoofpotje met kip en hangop (yoghurt). De zegsman benadrukt dat ‘t Lansink de jubileumvoorstellingen steunt."
                            }
                        ]
                    }
