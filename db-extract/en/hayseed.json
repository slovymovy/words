                        "tags": [
                            "comparative"
                        ],
                        "form": "more hayseed"
                    },
                    {
                        "form_id": "9b97d7d7-434f-4872-9e20-65cde2da5610",
                        "entry_id": "131dfe5a-0c3f-3d95-8727-e44ccb0cc94f",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most hayseed"
