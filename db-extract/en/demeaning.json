                            {
                                "target_word": "vernederend",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "64e96c38-f723-317c-91b8-6dbc5937b68b",
                                        "entry_id": "e64ad171-0866-3092-9559-1665a3f5df04",
                                        "glosses": [
                                            "van iets dat het je eer aantast"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86d6d3e5-a044-4777-8091-a57aa10f5675",
                                                "sense_id": "64e96c38-f723-317c-91b8-6dbc5937b68b",
                                                "text": "Naar schatting 13 op de 1.000 kinderen in Nederland worden mishandeld. Dat kan met lichamelijk geweld, maar ook door verwaarlozing, vernedering of het eisen van onhaalbare prestaties."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79c0fc38-7d48-3047-8d53-16a062d887eb",
                                        "entry_id": "e64ad171-0866-3092-9559-1665a3f5df04",
                                        "glosses": [
                                            "van iets dat je er klein en minderwaardig door wordt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3821c5c3-a4f3-4156-86b9-1825262c32fe",
                                                "sense_id": "79c0fc38-7d48-3047-8d53-16a062d887eb",
                                                "text": "Hun huis werd na „vernederende onderhandelingen” met gaswinner NAM gesloopt en nu wachten ze in een kapotte huurwoning op vervangende nieuwbouw."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8413a1fe-869d-4db6-acf8-13c05e1fab58",
                        "source_entry_id": "04906d01-0d29-3bf8-81d8-f7d5c48ed491",
                        "source_sense_id": "e5eba1ca-7aa4-3fb1-a6f6-51e25780232f",
                        "source_sense_description": "that degrades",
                        "target_lang_word": "dégradant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dégradant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4acd6ba6-99b4-3fc7-a617-edbf0f4f1419",
                                        "entry_id": "2fa76dd6-08f9-3f83-9c40-bba4ec79218a",
                                        "glosses": [
                                            "Qui dégrade moralement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb10ff3a-0190-487a-befb-0e3de55cba53",
                                                "sense_id": "4acd6ba6-99b4-3fc7-a617-edbf0f4f1419",
                                                "text": "Tous les partisans du président sortant ne sont pas des extrémistes ou des individus violents qui cautionnent le spectacle dégradant de la semaine dernière."
                                            },
                                            {
                                                "example_id": "da4669f9-4abb-4b55-94ca-1de459773b94",
                                                "sense_id": "4acd6ba6-99b4-3fc7-a617-edbf0f4f1419",
                                                "text": "Une action dégradante. - Des habitudes dégradantes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dégradant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5329c3a-76c5-3446-937e-2c601fd2f449",
                                        "entry_id": "a9c62215-8321-30c5-b31c-1b1a793b947c",
                                        "glosses": [
                                            "Participe présent de dégrader."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3fbdfa-af8a-44a3-a0f1-9da6b0b39fb8",
                                                "sense_id": "d5329c3a-76c5-3446-937e-2c601fd2f449",
                                                "text": "Il en détermine les multiples aspects sensibles et curieux : il les fait viroter devant les yeux de manière à réveiller le jeu de mille facettes, non point sous une clarté capable de brusquement éblouir, mais sous une lumière atténuée, dégradant l’échelle mystérieuse des ombres, suffisante cependant pour faire chatoyer dans une fuite de reflets la vie secrète que chaque objet porte en lui."
                                            },
                                            {
                                                "example_id": "006359cc-cc72-435b-9477-d8eca5e420e3",
                                                "sense_id": "d5329c3a-76c5-3446-937e-2c601fd2f449",
                                                "text": "À gauche, la savane, aux herbes hautes et drues, forme un camaïeu de verts, aux valeurs se dégradant du vert nil au vert d’eau, aux arêtes coupantes comme des rasoirs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84a49cea-6a1f-4a04-9402-c46a06f08991",
                        "source_entry_id": "04906d01-0d29-3bf8-81d8-f7d5c48ed491",
                        "source_sense_id": "e5eba1ca-7aa4-3fb1-a6f6-51e25780232f",
                        "source_sense_description": "that degrades",
                        "target_lang_word": "avilissant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avilissant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5717628-84d4-35f6-a9db-022e76dca765",
                                        "entry_id": "d06bc169-0f2f-3928-acf2-56b7da019b7f",
                                        "glosses": [
                                            "Qui avilit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc175c18-0c28-4a47-a287-84101dc0afc0",
                                                "sense_id": "d5717628-84d4-35f6-a9db-022e76dca765",
                                                "text": "Refuser ces informations à un ancien président est sans précédent. C’est une insulte avilissante pour Trump."
                                            },
                                            {
                                                "example_id": "5b163911-238a-4860-84ef-f75c996b6ec5",
                                                "sense_id": "d5717628-84d4-35f6-a9db-022e76dca765",
                                                "text": "Invoquer votre pitié, répondit la belle juive, d’une voix que l’émotion faisait trembler, serait, je le sens bien, aussi inutile qu’avilissant […]"
                                            },
                                            {
                                                "example_id": "f2e768a3-b72a-484f-88ee-0fdf9bef6f4b",
                                                "sense_id": "d5717628-84d4-35f6-a9db-022e76dca765",
                                                "text": "Puisqu’il existe une responsabilité d’outre-tombe, faites-nous connaître sa forme. Irons-nous en paradis, en enfer, en purgatoire, ou éprouverons-nous quelqu’une des transformations avilissantes ou glorifiantes dont il est parlé dans d’autres religions ? Pour connaître la forme de la responsabilité d’outre-tombe, il faudrait que je reconnusse les formes ou du moins quelques-unes des formes que Dieu peut donner à sa volonté en dehors de ce monde, c’est-à-dire que je fusse plus qu’un homme, et alors vous ne me comprendriez pas."
                                            },
                                            {
                                                "example_id": "ea33e61d-6a84-441a-a765-352a59ed45b5",
                                                "sense_id": "d5717628-84d4-35f6-a9db-022e76dca765",
                                                "text": "Paméla, qui avait cinq ans de plus que sa sœur, consacrait de grands efforts à lui épargner toute douleur et à la préserver de tout contact avilissant."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "avilissant",
                                "target_lang_code": "fr",
                                "target_senses": [
