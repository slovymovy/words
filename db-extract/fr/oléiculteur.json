                "senses": [
                    {
                        "sense_id": "fe4a24eb-5f0b-3685-979a-3cf4d06ddeed",
                        "entry_id": "6a3864d8-6ec0-3522-ae76-94040650f0d2",
                        "glosses": [
                            "Personne qui pratique l’oléiculture, qui cultive des oléagineux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72851eef-4298-482f-997d-325ef54accd3",
                                "sense_id": "fe4a24eb-5f0b-3685-979a-3cf4d06ddeed",
                                "text": "Les Italiens, les Maltais, les Grecs du port les regarderaient passer en silence ; les grands oléiculteurs, tout de blanc vêtus, avec leurs lunettes à monture d’or, marchant à pas lents dans la rue du Bey, suivis de leur chaouch, passeraient à côté d’eux sans les voir."
                            },
                            {
                                "example_id": "bbead89c-dcf1-4e03-91a9-9944415f8e2f",
                                "sense_id": "fe4a24eb-5f0b-3685-979a-3cf4d06ddeed",
                                "text": "On fera ici la différence entre I’oléiculteur et l’oléifacteur. Le premier, qui cultive, n’est généralement pas l’oléifacteur qui, lui, traite l’huile."
                            }
                        ]
                    }
