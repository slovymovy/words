                "senses": [
                    {
                        "sense_id": "7bc8ccfe-e073-3306-9025-7dceef7d76f9",
                        "entry_id": "f57077ad-0907-3a51-a385-7917689f5b60",
                        "glosses": [
                            "medicijn tegen slapeloosheid en misselijkheid dat ernstige afwijkingen kan veroorzaken bij ongeboren kinderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7bf0941-6808-4c23-9dfc-cc5f40fb33ff",
                                "sense_id": "7bc8ccfe-e073-3306-9025-7dceef7d76f9",
                                "text": "De fabrikant van het middel softenon, waardoor ruim 50 jaar geleden wereldwijd 10.000 baby's misvormd zijn geboren, heeft voor het eerst excuses aangeboden. Topman Harald Stock van de Grünenthal Group uit het Duitse Aken deed dat bij de onthulling vrijdag van een standbeeld voor de slachtoffers in het nabijgelegen Stolberg."
                            },
                            {
                                "example_id": "8dd826a7-c16a-41ec-9636-4d6470b1ee3a",
                                "sense_id": "7bc8ccfe-e073-3306-9025-7dceef7d76f9",
                                "text": "De onzekerheid van het nut van sommige uitvindingen wordt gedemonstreerd door de niet-verwachte neveneffecten die de softenon bleek te hebben, toen er misvormde kinderen werden geboren."
                            },
                            {
                                "example_id": "9e30154b-beb6-4f44-8ab4-357c8e4c00f5",
                                "sense_id": "7bc8ccfe-e073-3306-9025-7dceef7d76f9",
                                "text": "Dr. Frances Oldham Kelsey, wereldwijd geëerd om haar leidende rol in het thalidomide-drama (in Nederland bekend onder de merknaam Softenon) is op 101-jarige leeftijd overleden. De Canadese arts slaagde erin het medicijn uit de VS te weren, ondanks grote druk van de farmaceutische industrie."
                            }
                        ]
                    }
                ],
