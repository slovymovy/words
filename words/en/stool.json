{
    "word_family": [
        "footstool",
        "stool-pigeon",
        "stooling"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ff6778a3-89dc-3654-b655-f73bf727d1ad",
                    "sense_definition": "A seat for one person that typically has no back or armrests.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat on a high <w>stool</w> at the kitchen counter while eating her breakfast.",
                            "target_lang_translations": {
                                "ru": "Она сидела на высоком <w>табурете</w> у кухонной стойки, пока завтракала.",
                                "zh": "她吃早餐时坐在厨房台面旁的一张高<w>凳子</w>上。"
                            }
                        },
                        {
                            "text": "The artist preferred to sit on a wooden <w>stool</w> while working on the painting.",
                            "target_lang_translations": {
                                "ru": "Художник предпочитал сидеть на деревянной <w>табуретке</w>, работая над картиной.",
                                "zh": "这位艺术家在作画时更喜欢坐在木<w>凳子</w>上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bar stool",
                        "wooden stool",
                        "kitchen stool",
                        "step stool"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сиденье для одного человека, обычно без спинки и подлокотников.",
                        "zh": "一种没有靠背或扶手的单人坐具。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "табурет",
                                "target_lang_sense_clarification": "мебельное изделие без спинки"
                            },
                            {
                                "target_lang_word": "табуретка",
                                "target_lang_sense_clarification": "разговорное название табурета"
                            },
                            {
                                "target_lang_word": "барный стул",
                                "target_lang_sense_clarification": "высокий стул для стойки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "凳子",
                                "target_lang_sense_clarification": "通用的无靠背坐具"
                            },
                            {
                                "target_lang_word": "高脚凳",
                                "target_lang_sense_clarification": "常用于吧台或厨房的高凳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9ce0297-11a9-3cc0-95a8-e8a75ee6372f",
                    "sense_definition": "Feces or excrement, often used in a medical context.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor asked the patient to provide a <w>stool</w> sample for further testing.",
                            "target_lang_translations": {
                                "ru": "Врач попросил пациента предоставить образец <w>стула</w> для дальнейшего анализа.",
                                "zh": "医生要求病人提供一份<w>粪便</w>样本以作进一步检查。"
                            }
                        },
                        {
                            "text": "Changes in <w>stool</w> color can sometimes indicate a change in your diet or health.",
                            "target_lang_translations": {
                                "ru": "Изменения цвета <w>кала</w> иногда могут указывать на изменения в диете или состоянии здоровья.",
                                "zh": "<w>大便</w>颜色的变化有时可能预示着饮食或健康状况的改变。"
                            }
                        }
                    ],
                    "synonyms": [
                        "feces",
                        "excrement",
                        "faeces",
                        "fecal matter",
                        "waste"
                    ],
                    "common_phrases": [
                        "stool sample",
                        "soft stools",
                        "loose stools",
                        "bloody stool"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in medical or formal contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фекалии или экскременты, часто используется в медицинском контексте.",
                        "zh": "粪便或排泄物，常用于医学语境。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стул",
                                "target_lang_sense_clarification": "медицинский термин для опорожнения кишечника"
                            },
                            {
                                "target_lang_word": "кал",
                                "target_lang_sense_clarification": "продукты жизнедеятельности"
                            },
                            {
                                "target_lang_word": "экскременты",
                                "target_lang_sense_clarification": "формальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大便",
                                "target_lang_sense_clarification": "通俗的排泄物称呼"
                            },
                            {
                                "target_lang_word": "粪便",
                                "target_lang_sense_clarification": "医学或正式语境下的称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "563ece70-26d8-3130-bb6f-9b55f7c3323a",
                    "sense_definition": "A seat used for urination and defecation, such as a commode or chamber pot.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "furniture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the historical museum, we saw an old wooden <w>stool</w> used as a portable toilet.",
                            "target_lang_translations": {
                                "ru": "В историческом музее мы видели старый деревянный <w>стульчак</w>, использовавшийся как переносной туалет.",
                                "zh": "在历史博物馆里，我们看到了一个用作移动厕所的旧木制<w>便桶</w>。"
                            }
                        },
                        {
                            "text": "The patient was too weak to walk, so they placed a commode <w>stool</w> by the bed.",
                            "target_lang_translations": {
                                "ru": "Пациент был слишком слаб, чтобы ходить, поэтому у кровати поставили <w>кресло-туалет</w>.",
                                "zh": "病人虚弱得无法行走，所以他们在床边放置了一个<w>坐便器</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "commode",
                        "chamber pot",
                        "potty-chair"
                    ],
                    "common_phrases": [
                        "close stool"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly used for historical or medical commodes"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сиденье, используемое для мочеиспускания и дефекации, например, судно или ночной горшок.",
                        "zh": "用于排泄的坐具，如便桶或马桶。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стульчак",
                                "target_lang_sense_clarification": "сиденье унитаза или переносного туалета"
                            },
                            {
                                "target_lang_word": "кресло-туалет",
                                "target_lang_sense_clarification": "медицинское приспособление"
                            },
                            {
                                "target_lang_word": "ночной стул",
                                "target_lang_sense_clarification": "устаревшее название коммода"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "便桶",
                                "target_lang_sense_clarification": "旧式或移动式排泄容器"
                            },
                            {
                                "target_lang_word": "坐便器",
                                "target_lang_sense_clarification": "现代医疗护理用的移动式马桶"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "daf36f63-1fca-3d68-8988-5c094e84a768",
                    "sense_definition": "A plant base or tree stump that has been cut back to the ground to encourage new shoots.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diameter of a <w>stool</w> is directly related to its age in a managed coppice.",
                            "target_lang_translations": {
                                "ru": "Диаметр <w>пня</w> напрямую связан с его возрастом в управляемом лесу.",
                                "zh": "在经营性矮林中，<w>伐桩</w>的直径与其树龄直接相关。"
                            }
                        },
                        {
                            "text": "New growth emerged quickly from the <w>stool</w> after the hazel tree was cut.",
                            "target_lang_translations": {
                                "ru": "После того как лещину срубили, из <w>основания</w> быстро появились новые побеги.",
                                "zh": "榛树被砍伐后，新芽迅速从<w>树桩</w>上长了出来。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stool bed"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in forestry and botany"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основание растения или пень, обрезанный до уровня земли для стимуляции роста новых побегов.",
                        "zh": "植物的基部或被砍伐至贴近地面的树桩，旨在促进新枝生长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пень",
                                "target_lang_sense_clarification": "основание срубленного дерева"
                            },
                            {
                                "target_lang_word": "маточный куст",
                                "target_lang_sense_clarification": "в садоводстве для размножения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "树桩",
                                "target_lang_sense_clarification": "砍伐后留下的基部"
                            },
                            {
                                "target_lang_word": "伐桩",
                                "target_lang_sense_clarification": "林业中用于萌芽更新的基部"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32e1da38-c536-34c3-adf6-0f2688fb13b1",
                    "sense_definition": "To discharge feces from the body.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse noted that the infant had not <w>stooled</w> in over twenty-four hours.",
                            "target_lang_translations": {
                                "ru": "Медсестра отметила, что у младенца не было <w>стула</w> более двадцати четырех часов.",
                                "zh": "护士记录到，这名婴儿已经超过二十四小时没有<w>排便</w>了。"
                            }
                        },
                        {
                            "text": "It is normal for breast-fed babies to <w>stool</w> after every feeding.",
                            "target_lang_translations": {
                                "ru": "Для младенцев на грудном вскармливании нормально <w>испражняться</w> после каждого кормления.",
                                "zh": "母乳喂养的婴儿在每次喂奶后<w>排便</w>是正常的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "defecate"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "primarily used in medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять фекалии из организма (испражняться).",
                        "zh": "排出粪便。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "иметь стул",
                                "target_lang_sense_clarification": "медицинское выражение"
                            },
                            {
                                "target_lang_word": "испражняться",
                                "target_lang_sense_clarification": "формальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "排便",
                                "target_lang_sense_clarification": "医学或正式用语"
                            },
                            {
                                "target_lang_word": "解大便",
                                "target_lang_sense_clarification": "日常口语"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77d06259-3511-3b29-8133-48292d66f553",
                    "sense_definition": "To cut a plant back to ground level to stimulate the growth of new shoots.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener decided to <w>stool</w> the shrubs to maintain their vigor and control their height.",
                            "target_lang_translations": {
                                "ru": "Садовник решил <w>обрезать на пень</w> кустарники, чтобы сохранить их силу и контролировать высоту.",
                                "zh": "园丁决定对灌木进行<w>平茬</w>，以保持其活力并控制高度。"
                            }
                        },
                        {
                            "text": "Plants that generate many small stems are often <w>stooled</w> rather than pollarded.",
                            "target_lang_translations": {
                                "ru": "Растения, дающие много мелких стеблей, часто <w>сажают на пень</w>, а не обрезают крону.",
                                "zh": "容易长出许多细小枝干的植物通常会被<w>平茬</w>，而不是进行截顶修剪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coppice"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in horticulture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обрезать растение до уровня земли, чтобы стимулировать рост новых побегов.",
                        "zh": "将植物砍伐至贴近地面，以刺激新枝生长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обрезать на пень",
                                "target_lang_sense_clarification": "садоводческий прием"
                            },
                            {
                                "target_lang_word": "сажать на пень",
                                "target_lang_sense_clarification": "технический термин в лесоводстве"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "平茬",
                                "target_lang_sense_clarification": "林业和园艺术语"
                            },
                            {
                                "target_lang_word": "截干",
                                "target_lang_sense_clarification": "园艺中修剪至基部的做法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}