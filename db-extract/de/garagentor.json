                ],
                "senses": [
                    {
                        "sense_id": "be08e7e8-cd54-360d-aef2-66378bf44b17",
                        "entry_id": "e7b5deb9-39da-3abc-b678-c4fc8881c12a",
                        "glosses": [
                            "Tor, das zum Verschließen einer Garage dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6dd8d463-c0f4-4a2d-879d-58ab8075dd1b",
                                "sense_id": "be08e7e8-cd54-360d-aef2-66378bf44b17",
                                "text": "Heute morgen habe ich gesehen, wie jemand mit voller Wucht gegen ein Garagentor gefahren ist."
                            },
                            {
                                "example_id": "9ff9519b-0a5d-4011-b6ab-5e3de45a1539",
                                "sense_id": "be08e7e8-cd54-360d-aef2-66378bf44b17",
                                "text": "„Stattdessen wartete er nach Feierabend vorm Garagentor.“"
                            },
                            {
                                "example_id": "9e52cd38-8b0f-46f0-b74b-62cdc856d8d4",
                                "sense_id": "be08e7e8-cd54-360d-aef2-66378bf44b17",
                                "text": "„Es hatte aufgehört zu regnen, und das Garagentor stand offen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6e489d6d-04b1-4599-98b9-bf8184ada415",
                        "source_entry_id": "e7b5deb9-39da-3abc-b678-c4fc8881c12a",
                        "source_sense_id": "be08e7e8-cd54-360d-aef2-66378bf44b17",
                        "source_sense_description": "Tor, das zum Verschließen einer Garage dient",
                        "target_lang_word": "garage door",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garage door",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "75440f87-8f61-3fbb-8e78-fb94344e1a5c",
                                        "entry_id": "790fefe3-7169-3ae5-a50e-f00c1b195dd3",
                                        "glosses": [
                                            "The large door on a garage which a car can come in through."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b836ef0-d7d1-4d13-8a35-c82ae77d04f2",
                                                "sense_id": "75440f87-8f61-3fbb-8e78-fb94344e1a5c",
                                                "text": "garage door opener"
                                            },
                                            {
                                                "example_id": "23096308-6287-4f3a-88a2-5bbfbd7dfedf",
                                                "sense_id": "75440f87-8f61-3fbb-8e78-fb94344e1a5c",
                                                "text": "From many years’ experience with automobiles, I have known the manner of signaling by horn to the garage keeper or elevator man the desire to enter the building. As many garages are located in residence districts, this is truly a very annoying custom and should be stopped. To overcome this nuisance a handy electric push button could be mounted on posts on either side of the runway, about five feet high, so that they could be easily reached as the car approaches the garage door. These posts could be placed near the curb, and two are recommended to serve cars with left or right side drive."
                                            },
                                            {
                                                "example_id": "92eb9f09-c58c-494b-94a6-e5a59145792d",
                                                "sense_id": "75440f87-8f61-3fbb-8e78-fb94344e1a5c",
                                                "text": "Door guards are a detail that can be added readily to almost any garage door for the purpose of protecting the door from being broken off the hinges or for the protection that is afforded the customers of the garage. The simplest form of these are inclined slides for warding off the front or rear wheels of the entering car."
                                            },
                                            {
                                                "example_id": "309bdfba-8047-45db-b6a3-fe54c3eeb3db",
                                                "sense_id": "75440f87-8f61-3fbb-8e78-fb94344e1a5c",
                                                "text": "The \"Overhead Door\" is the garage door that can be opened or closed at a touch every day in the year—regardless of the weather. It is the garage door that opens UP Completely Out of the Way. In short, it is the modern door for the modern garage—in step with the times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d96dcf05-ee82-32f3-9acd-51980fc3b425",
                                        "entry_id": "790fefe3-7169-3ae5-a50e-f00c1b195dd3",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see garage, door (a door for people to enter or exit a garage)"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c7a3108-4b78-47e8-b1d1-0226790c366f",
                        "source_entry_id": "e7b5deb9-39da-3abc-b678-c4fc8881c12a",
