                        "glosses": [
                            "Appropriate to, or in the way of, a soldier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b35de363-5113-462f-ac4b-05955409b8aa",
                                "sense_id": "4b8189e6-d49e-3044-909f-7f23fe0f30c8",
                                "text": "His soldierly demeanour stood him good stead in civilian life when vicissitudes would assail him."
                            },
                            {
                                "example_id": "3caafea4-ed8b-4c7f-8353-bb08cae33abd",
                                "sense_id": "4b8189e6-d49e-3044-909f-7f23fe0f30c8",
                                "text": "People of unalterable ideas still insisted upon calling him \"Sergeant\" when they met him, which was in some degree owing to his having still retained the well-shaped moustache of his military days, and the soldierly bearing inseparable from his form."
                            }
                        ]
                    }
