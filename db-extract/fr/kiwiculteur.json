                        "examples": [
                            {
                                "example_id": "3913dfdb-b446-46c1-9f7d-35f03a1da362",
                                "sense_id": "20e850d5-d660-3cc4-8cc5-ae89102c8c2d",
                                "text": "Dans ces conditions, le kiwiculteur aura tout intérêt à employer les services d’un apiculteur compétent en matière de pollinisation pour élaborer une stratégie de pollinisation adaptée à son verger."
                            },
                            {
