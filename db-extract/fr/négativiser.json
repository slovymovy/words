                "senses": [
                    {
                        "sense_id": "498e4e4c-9243-3ab7-87af-4ee5bc14ae5d",
                        "entry_id": "18de0f0a-5eef-3755-bf69-a9a3ee6ee137",
                        "glosses": [
                            "Donner un caractère négatif à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04d22d89-918a-45ac-bd02-4e8f78bf6ff4",
                                "sense_id": "498e4e4c-9243-3ab7-87af-4ee5bc14ae5d",
                                "text": "Et c'est vrai aussi puisque tu poses la question que le manque comme la douleur fait tout négativiser, on se sent vraiment rejeté etc."
                            },
                            {
                                "example_id": "405860a5-1d15-4afd-8632-1a6d4db3b60f",
                                "sense_id": "498e4e4c-9243-3ab7-87af-4ee5bc14ae5d",
                                "text": "Il a relativisé l'événement, au lieu de négativiser, comme vous..."
                            },
                            {
                                "example_id": "85c6fa09-2a32-4339-9377-8baf18cad350",
                                "sense_id": "498e4e4c-9243-3ab7-87af-4ee5bc14ae5d",
                                "text": "Mais, déjà, l'idéalisme des philosophes grecs a commencé à « négativiser » le sens de ce mot."
                            }
                        ]
                    }
