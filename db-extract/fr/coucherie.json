                                                "example_id": "47035847-e0ba-4a2e-bd56-755b695668b9",
                                                "sense_id": "b2232ee6-cdbc-3301-bb1c-e7af7e8983c2",
                                                "text": "Kilian hat schon wieder irgendeine Bettgeschichte laufen."
