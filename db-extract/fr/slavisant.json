                                "sense_id": "f8f553b7-147f-3b5a-9de1-926e4ba6bfab",
                                "text": "Il est un peu slavisant sur les bords.",
                                "translation": "It is a bit Slavic around the edges.",
                                "english": "It is a bit Slavic around the edges."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dce5406-8036-3a93-8162-6228fb31f37e",
                        "entry_id": "485b5755-afcc-3ab7-8bf7-fa1007ab5ab5",
