                ],
                "senses": [
                    {
                        "sense_id": "153d142b-05e2-38ec-9df5-faca28c10e24",
                        "entry_id": "35465dfa-0cf1-34ec-8d33-f35c189e169b",
                        "glosses": [
                            "Auquel on a accordé beaucoup de temps, d'intérêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3c8e91e-6ff9-4d58-beba-f980aa9f0b2c",
                                "sense_id": "153d142b-05e2-38ec-9df5-faca28c10e24",
                                "text": "Style travaillé."
                            },
                            {
                                "example_id": "f41f6cd5-5563-4d31-b336-078f3ee2e902",
                                "sense_id": "153d142b-05e2-38ec-9df5-faca28c10e24",
                                "text": "Ouvrage bien travaillé."
                            },
                            {
                                "example_id": "3a0d794e-a8e4-4762-9e14-e95f3d519f2a",
                                "sense_id": "153d142b-05e2-38ec-9df5-faca28c10e24",
                                "text": "Un homme travaillé de la fièvre, de la goutte, de la pierre."
                            },
                            {
                                "example_id": "1ae7824a-ef68-4b4a-9d86-c4a01065b361",
                                "sense_id": "153d142b-05e2-38ec-9df5-faca28c10e24",
                                "text": "Un cheval trop travaillé."
                            },
                            {
                                "example_id": "0a0d5a12-f5b8-4ec9-977f-2fb71bce234f",
                                "sense_id": "153d142b-05e2-38ec-9df5-faca28c10e24",
                                "text": "Ce cheval a les jambes travaillées. Il a les jambes fatiguées, ruinées par le travail."
                            },
                            {
                                "example_id": "f79e6ce1-9fbd-45d3-9d44-9fd8376d44f6",
                                "sense_id": "153d142b-05e2-38ec-9df5-faca28c10e24",
                                "text": "Elle avait fait le voyage avec son mari, qui voulait revoir, dans l’Aisne, ses électeurs travaillés par les socialistes."
                            },
                            {
                                "example_id": "de57a513-26b9-4388-a7ca-9f6f9796c503",
                                "sense_id": "153d142b-05e2-38ec-9df5-faca28c10e24",
                                "text": "De plus en plus travaillé par la faim, j’ai fait, hier, une vaste commande de choux à la crème à la fameuse pâtisserie indiquée par Tommy Dorsey."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
