                        "examples": [
                            {
                                "example_id": "f894863f-e4fa-4f2a-aa43-17d9f9e08ac1",
                                "sense_id": "6003fe8c-2aee-31b7-8e72-adc05b60397a",
                                "text": "Depuis vingt-cinq ans, la planète Jordi Savall occupe une telle place dans la galaxie baroque qu’on oublie parfois que le gambiste n’a enregistré son premier disque qu’en 1975, après dix ans de travail solitaire et un studieux exil à Bâle, en Suisse, où il étudie puis enseigne à Académie de musique ancienne."
                            }
                        ]
                    }
