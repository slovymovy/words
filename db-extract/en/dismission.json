                        "sense_id": "d41abc91-f03b-36a8-a459-0c56ef5a0e93",
                        "entry_id": "1c60b5e9-2df2-35fb-96d7-0327d3bae6bf",
                        "glosses": [
                            "Removal from office; termination of employment or services, or position in ones affections."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ac0c079d-a6c9-4fb6-8e3e-4ec5a1b3787e",
                                "sense_id": "d41abc91-f03b-36a8-a459-0c56ef5a0e93",
                                "text": "I told her […] that her dismission was intended for an indignity to me; that I was very sorry to be obliged to part with her, and hoped she would meet with as good a service."
                            },
                            {
                                "example_id": "1aedc0f0-353b-4564-9830-c44f0b675f79",
                                "sense_id": "d41abc91-f03b-36a8-a459-0c56ef5a0e93",
                                "text": "Fairservice looked very blank at this demand, justly considering it as a presage to approaching dismission."
                            },
                            {
                                "example_id": "c3c53edd-733c-4b97-a11a-f26091d7738c",
                                "sense_id": "d41abc91-f03b-36a8-a459-0c56ef5a0e93",
                                "text": "[…]and if, upon finding his hopes with regard to Rosilia frustrated, she should be so fortunate as once again to bring him to renew his addresses to herself, how great would be her triumph in then giving him his final dismission."
                            }
                        ]
