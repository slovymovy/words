        "fr-extract.jsonl": [
            {
                "entry_id": "bb324c1c-1223-3925-8f82-e5407d6c98ba",
                "word": "dûment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c1f6b83a-cfa5-4bb2-a2e9-fde0f27921f2",
                        "entry_id": "bb324c1c-1223-3925-8f82-e5407d6c98ba",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "dument"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a9a374cc-5407-3e1f-aa27-7b1ddd0bfc74",
                        "entry_id": "bb324c1c-1223-3925-8f82-e5407d6c98ba",
                        "glosses": [
                            "Selon la raison, selon le droit, selon les formes."
                        ],
                        "tags": [
                            "Administration"
                        ],
                        "examples": [
                            {
                                "example_id": "2bcb6399-41bc-4ec6-a8e7-7a17e11d7eb5",
                                "sense_id": "a9a374cc-5407-3e1f-aa27-7b1ddd0bfc74",
                                "text": "Mais là où les mérites transcendants de l’oreille pour l’identification apparaissent le plus nettement, c’est quand il s’agit d’affirmer solennellement en justice que telle ancienne photographie « est bien et dûment applicable à tel sujet ici présent »."
                            },
                            {
                                "example_id": "3a46b7aa-08d0-4e67-8ed5-c4089cf37179",
                                "sense_id": "a9a374cc-5407-3e1f-aa27-7b1ddd0bfc74",
                                "text": "Cette même procédure peut également être mise en œuvre à la demande du cabinet du Premier ministre ou, en cas d’urgence dûment justifiée, à l’initiative du ministère porteur du texte."
                            }
                        ]
                    },
                    {
                        "sense_id": "eea7ff4b-fd17-3f34-9319-b1f2f4d292b6",
                        "entry_id": "bb324c1c-1223-3925-8f82-e5407d6c98ba",
                        "glosses": [
                            "Dans le langage général, mais souvent avec une nuance de moquerie, de badinage : « comme il faut, d’une façon due, convenable »."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "593f272a-bd14-4589-b8f9-ed9b844a5ac3",
                                "sense_id": "eea7ff4b-fd17-3f34-9319-b1f2f4d292b6",
                                "text": "Un personnage dûment atteint de cocuage."
                            },
                            {
                                "example_id": "0356593a-c111-4c90-b0a2-13ef2fe7a6d9",
                                "sense_id": "eea7ff4b-fd17-3f34-9319-b1f2f4d292b6",
                                "text": "Notre défunt était en carrosse porté, bien et dûment empaqueté."
                            },
                            {
                                "example_id": "49820bfa-a8d8-4a47-a92b-0354b3d39df2",
                                "sense_id": "eea7ff4b-fd17-3f34-9319-b1f2f4d292b6",
                                "text": "L’Angleterre le pleura dûment. Elle n’avait pu lui offrir le voyage en Italie ; elle lui accorda un tombeau à Westminster."
                            },
                            {
                                "example_id": "e42ced23-b5e9-479d-ab20-17506dbef8f1",
                                "sense_id": "eea7ff4b-fd17-3f34-9319-b1f2f4d292b6",
                                "text": "Le leader syndical jugera aussi le gouvernement sur la rapidité avec laquelle il présentera un texte dûment rédigé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48ad4fb8-2085-4b43-921f-5d773952b8d0",
                        "source_entry_id": "bb324c1c-1223-3925-8f82-e5407d6c98ba",
                        "target_lang_word": "ordnungsgemäß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ordnungsgemäß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "caa55411-9d81-33be-bf11-39f977bcadcb",
                                        "entry_id": "e840db45-edfb-3a62-9c9f-f707fdaf70bd",
                                        "glosses": [
                                            "einer bestimmten Ordnung entsprechend, den einschlägigen Vorgaben entsprechend, wie vorgesehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c51618cc-a06c-4777-8c0f-f2c0adadf09c",
                                                "sense_id": "caa55411-9d81-33be-bf11-39f977bcadcb",
                                                "text": "Die Grundsätze ordnungsgemäßer Buchführung (GoB) beruhen auf geschriebenen und ungeschriebenen Regeln zur Buchführung und Bilanzierung, die sich aus der Wissenschaft und Praxis, aus der Rechtsprechung sowie Empfehlungen von Wirtschaftsverbänden ergeben und entwickelt haben."
                                            },
                                            {
                                                "example_id": "d3eecd80-93ff-4c11-a5fd-70ca0416aa32",
                                                "sense_id": "caa55411-9d81-33be-bf11-39f977bcadcb",
                                                "text": "„Die Lufttemperatur stand in einem ordnungsgemäßen Verhältnis zur mittleren Jahrestemperatur, zur Temperatur des kältesten wie des wärmsten Monats und zur aperiodischen monatlichen Temperaturschwankung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "384ee350-1031-4c35-a190-9b19f198244e",
