                    {
                        "translation_id": "6c869922-ad77-4ab2-9cda-db1dc8c9016e",
                        "source_entry_id": "35bf685c-e2c6-3705-a7e2-94813ef64ed4",
                        "source_sense_id": "31b0a81c-12f0-3d67-a8f8-73a106ee15ba",
                        "source_sense_description": "langwerpige, op de bodem levende zoetwatervis, Lota lota",
                        "target_lang_word": "Aalquappe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aalquappe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ca68c302-0da8-3376-ad58-e5a76f437735",
                                        "entry_id": "2b45be5d-aa14-3799-b755-87c3ca51ec7b",
                                        "glosses": [
                                            "ein Knochenfisch aus der Familie der Quappen"
                                        ],
                                        "tags": [
                                            "nordostdeutsch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f682dba-d601-4b62-84f1-9924215eb6b4",
                                                "sense_id": "ca68c302-0da8-3376-ad58-e5a76f437735",
                                                "text": "Die Aalquappe lebt im Süßwasser."
                                            },
                                            {
                                                "example_id": "b578cbf4-60b7-435f-b069-7560a68d6b49",
                                                "sense_id": "ca68c302-0da8-3376-ad58-e5a76f437735",
                                                "text": "„Man sollte es nicht für möglich halten: es hat was gebissen. Ja, ich habe eine Aalquappe gefangen. Ein glibbriges Ding mit dem Kopf eines arg verbitterten Junggesellen, kahl und ganz freudlos, aber: mit wunderbar opalisierenden Froschkönigaugen.“"
                                            },
                                            {
                                                "example_id": "cdd96be6-8016-4ebf-ae68-32543bdc411f",
                                                "sense_id": "ca68c302-0da8-3376-ad58-e5a76f437735",
                                                "text": "„Nur Barsche zählen heute. Kleine Maränen, Zander oder Weißfische lassen sie für die Möwen liegen. Hechte gibt es jetzt nur wenige, Aalquappen fressen ohnehin erst abends.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c512b50-2ed1-3286-96ab-f4b36e4884bd",
                                        "entry_id": "2b45be5d-aa14-3799-b755-87c3ca51ec7b",
                                        "glosses": [
                                            "Aalmutter"
                                        ],
                                        "tags": [
                                            "vor allem norddeutsch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fe53c88-8db0-4b9d-a3f6-b3ae5a734011",
                                                "sense_id": "3c512b50-2ed1-3286-96ab-f4b36e4884bd",
                                                "text": "Die im Meer lebenden Aalmuttern werden nach Adelung und anderen auch als Aalquappen bezeichnet, was auf einer Verwechslung der Bezeichnung beruhen muss, denn die Aalquappen sind im Gegensatz zu den marinen Aalmuttern reine Süßwasserfische."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
