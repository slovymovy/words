                "senses": [
                    {
                        "sense_id": "d62b77ee-648b-37c7-8e2f-332a149d3944",
                        "entry_id": "f1323964-332a-318d-82ca-b10e681aa72b",
                        "glosses": [
                            "to love each other"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "f43a618d-18fe-3244-bc5b-224383f0e1c6",
                        "entry_id": "f1323964-332a-318d-82ca-b10e681aa72b",
                        "glosses": [
                            "to love"
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "f8ea49d5-f37b-4026-8dfb-14b2bd16dbe2",
                                "sense_id": "f43a618d-18fe-3244-bc5b-224383f0e1c6",
                                "text": "Лю́ди рожда́лись, люби́лись, умира́ли и вновь нарожда́лись ...",
                                "translation": "People were born, loved, died and were born again ...",
                                "english": "People were born, loved, died and were born again ..."
                            }
                        ]
                    },
                    {
                        "sense_id": "d700be6a-8ab3-3fd8-809b-e2461c34ed57",
                        "entry_id": "f1323964-332a-318d-82ca-b10e681aa72b",
                        "glosses": [
                            "there is loving [with dative ‘by someone’] (idiomatically translated as English love with the dative object as the subject)"
                        ],
                        "tags": [
                            "impersonal"
                        ],
                        "examples": [
                            {
                                "example_id": "ed8b255a-6c72-406d-bf0b-e96c1e8d26a7",
                                "sense_id": "d700be6a-8ab3-3fd8-809b-e2461c34ed57",
                                "text": "Люби́ меня́, бу́дем сча́стливы, пока́ нам лю́бится и счастливится ...",
                                "translation": "Love me, let's be happy, as long as we love and are happy ...",
                                "english": "Love me, let's be happy, as long as we love and are happy ..."
                            }
                        ]
                    },
