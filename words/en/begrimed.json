    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "1cf750d2-8f99-389a-a046-2d59835af50d",
                    "sense_definition": "Deeply soiled, blackened, or covered with dirt and grime.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dirty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The miners emerged from the underground tunnels with sweat running down their <w>begrimed</w> faces.",
                            "target_lang_translations": {
                                "nl": "De mijnwerkers kwamen uit de ondergrondse tunnels terwijl het zweet over hun <w>beroete</w> gezichten liep."
                            }
                        },
                        {
                            "text": "Years of heavy industrial smoke had left the brick buildings thoroughly <w>begrimed</w>.",
                            "target_lang_translations": {
                                "nl": "Jaren van zware industriële rook hadden de bakstenen gebouwen volkomen <w>besmeurd</w> achtergelaten."
                            }
                        }
                    ],
                    "synonyms": [
                        "grimy",
                        "soiled",
                        "besmirched",
                        "blackened"
                    ],
                    "antonyms": [
                        "clean",
                        "spotless",
                        "immaculate"
                    ],
                    "common_phrases": [
                        "begrimed hands",
                        "begrimed face"
                    ],
                    "target_lang_definitions": {
                        "nl": "Erg vuil, zwart geworden of bedekt met ingetrokken vuil en roet."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "beroet",
                                "target_lang_sense_clarification": "bedekt met roet"
                            },
                            {
                                "target_lang_word": "besmeurd",
                                "target_lang_sense_clarification": "vies gemaakt met een vettige of donkere substantie"
                            },
                            {
                                "target_lang_word": "vuil",
                                "target_lang_sense_clarification": "sterk verontreinigd"
                            },
                            {
                                "target_lang_word": "ingesmeerd",
                                "target_lang_sense_clarification": "bedekt met vuil of zwarte aanslag"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8376730d-5848-3805-9dde-b73a46097e2b",
                    "sense_definition": "simple past and past participle of <w>begrime</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "dirty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soot and coal dust <w>begrimed</w> the workers' clothing during the long shift.",
                            "target_lang_translations": {
                                "nl": "Roet en kolenstof <w>besmeurden</w> de kleding van de arbeiders tijdens de lange dienst."
                            }
                        },
                        {
                            "text": "The engine oil had completely <w>begrimed</w> the mechanic's apron.",
                            "target_lang_translations": {
                                "nl": "De motorolie had het schort van de mecanicien volledig <w>bezoedeld</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "verleden tijd en voltooid deelwoord van begrime (bevuilen, beroeten)"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "besmeurde",
                                "target_lang_sense_clarification": "verleden tijd van besmeuren"
                            },
                            {
                                "target_lang_word": "beroette",
                                "target_lang_sense_clarification": "verleden tijd van beroeten"
                            },
                            {
                                "target_lang_word": "bevuilde",
                                "target_lang_sense_clarification": "verleden tijd van bevuilen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
