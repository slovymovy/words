                        ],
                        "examples": [
                            {
                                "example_id": "f88b4109-5b5d-4460-8bee-9570a61a28bc",
                                "sense_id": "5e29e3a4-5a39-3fd3-8802-715b86f86722",
                                "text": "Der Mensch hat in seinen Körperzellen einen zweifachen Chromosomensatz, der sich aus 46 Chromosomen zusammensetzt."
                            },
                            {
                                "example_id": "b3eb94c5-8ffe-425a-98f6-41824e2b8ef4",
                                "sense_id": "5e29e3a4-5a39-3fd3-8802-715b86f86722",
                                "text": "Die Keimzellen des Menschen besitzen einen einfachen Chromosomensatz mit 23 Chromosomen."
                            }
                        ]
                    }
                ],
