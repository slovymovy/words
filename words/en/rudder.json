{
    "word_family": [
        "ruddery"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "94d8ec7f-9ab1-366b-92d6-ebf9b161d129",
                    "sense_definition": "A flat piece of wood or metal at the back of a boat or ship used for steering.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "steering_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The captain turned the wheel to move the <w>rudder</w> and change the ship's direction.",
                            "target_lang_translations": {
                                "ru": "Капитан повернул штурвал, чтобы привести в движение <w>руль</w> и изменить направление движения корабля."
                            }
                        },
                        {
                            "text": "Strong waves hit the <w>rudder</w> and made it difficult to keep the boat on course.",
                            "target_lang_translations": {
                                "ru": "Сильные волны ударяли в <w>руль</w>, из-за чего было трудно удерживать лодку на курсе."
                            }
                        }
                    ],
                    "synonyms": [
                        "helm"
                    ],
                    "common_phrases": [
                        "ship rudder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоская деталь из дерева или металла в задней части судна или корабля, используемая для управления направлением движения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руль",
                                "target_lang_sense_clarification": "основной термин для устройства управления судном"
                            },
                            {
                                "target_lang_word": "корми́ло",
                                "target_lang_sense_clarification": "устаревшее или поэтическое название руля судна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef6c335d-b4c6-3d8e-b95c-8979b330ef00",
                    "sense_definition": "A movable part on the tail of an aircraft used to control its direction.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "steering_device",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pilot pushed the left pedal to move the <w>rudder</w> and turn the plane.",
                            "target_lang_translations": {
                                "ru": "Пилот нажал на левую педаль, чтобы отклонить <w>руль направления</w> и повернуть самолет."
                            }
                        },
                        {
                            "text": "Damage to the <w>rudder</w> made it impossible for the pilot to steer the aircraft safely.",
                            "target_lang_translations": {
                                "ru": "Повреждение <w>руля направления</w> сделало невозможным безопасное управление самолетом."
                            }
                        }
                    ],
                    "common_phrases": [
                        "aircraft rudder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подвижная часть на хвосте самолета, используемая для управления его направлением."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "руль направления",
                                "target_lang_sense_clarification": "авиационный термин для вертикального руля"
                            },
                            {
                                "target_lang_word": "руль поворота",
                                "target_lang_sense_clarification": "синоним руля направления в авиации"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "941d633c-f23b-3cd0-87dc-33fb8747c5d4",
                    "sense_definition": "Something that acts as a guide or provides direction for a process or activity.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His strong moral values served as a <w>rudder</w> throughout his difficult career.",
                            "target_lang_translations": {
                                "ru": "Его твердые моральные принципы служили ему <w>ориентиром</w> на протяжении всей его сложной карьеры."
                            }
                        },
                        {
                            "text": "The new policy acts as a <w>rudder</w> for the company's future development.",
                            "target_lang_translations": {
                                "ru": "Новая политика служит <w>руководством</w> для будущего развития компании."
                            }
                        }
                    ],
                    "synonyms": [
                        "guide",
                        "governor"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что служит ориентиром или направляет какой-либо процесс или деятельность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ориентир",
                                "target_lang_sense_clarification": "в значении направляющего фактора"
                            },
                            {
                                "target_lang_word": "руководство",
                                "target_lang_sense_clarification": "в значении направляющего принципа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "526c2139-0cd4-389a-a86c-31d9616594d3",
                    "sense_definition": "A tool used for sifting or separating materials.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old farmer used a <w>rudder</w> to separate the grain from the chaff.",
                            "target_lang_translations": {
                                "ru": "Старый фермер использовал <w>решето</w>, чтобы отделить зерно от мякины."
                            }
                        },
                        {
                            "text": "In ancient times, a <w>rudder</w> was essential for cleaning harvested crops.",
                            "target_lang_translations": {
                                "ru": "В древние времена <w>сито</w> было необходимо для очистки собранного урожая."
                            }
                        }
                    ],
                    "synonyms": [
                        "sieve",
                        "riddle"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This term for a sieve is no longer in common use."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Инструмент, используемый для просеивания или отделения материалов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "решето",
                                "target_lang_sense_clarification": "инструмент для просеивания"
                            },
                            {
                                "target_lang_word": "сито",
                                "target_lang_sense_clarification": "инструмент для отделения мелких частиц"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5cdad2a5-bf06-3d44-8aa9-447cf524312f",
                    "sense_definition": "The tail of an otter.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The otter used its powerful <w>rudder</w> to propel itself through the water.",
                            "target_lang_translations": {
                                "ru": "Выдра использовала свой мощный <w>хвост</w>, чтобы двигаться в воде."
                            }
                        },
                        {
                            "text": "As the otter dived, its <w>rudder</w> disappeared beneath the surface of the river.",
                            "target_lang_translations": {
                                "ru": "Когда выдра нырнула, её <w>хвост</w> скрылся под поверхностью реки."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Хвост выдры."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвост",
                                "target_lang_sense_clarification": "анатомическая часть тела животного"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}