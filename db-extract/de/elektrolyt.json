                "senses": [
                    {
                        "sense_id": "f6ed4646-0d84-3b75-81d0-06a5ca6f58c5",
                        "entry_id": "64406b2d-2743-3c6c-8dac-7d0ff1e8ffa2",
                        "glosses": [
                            "Électrolyte, milieu liquide (ou solide) comportant des ions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b10c646-16b3-4704-bd68-12815d80a3aa",
                                "sense_id": "f6ed4646-0d84-3b75-81d0-06a5ca6f58c5",
                                "text": "Die Interstitialflüssigkeit im Körper ist ein Elektrolyt.",
                                "translation": "Le liquide intersticiel dans le corps est un électrolyte."
                            },
                            {
                                "example_id": "9a2c0c43-fef6-4fff-90bd-77e312188ee3",
                                "sense_id": "f6ed4646-0d84-3b75-81d0-06a5ca6f58c5",
                                "text": "Bei Durchfall verliert der Körper Flüssigkeit und Salze (Elektrolyte). Wichtig ist, diesen Verlust auszugleichen.",
                                "translation": "En cas de diarrhée, le corps perd des liquides et des sels minéraux (électrolytes). Il est important de compenser cette perte."
                            }
                        ]
                    }
                ],
                "translations": [],
