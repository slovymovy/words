                        ],
                        "form": "die Wärmewende"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                        "entry_id": "1c5797d9-bd03-38f5-a196-5f7da7d7802d",
                        "glosses": [
                            "grundlegende Umstellung der Wärmeerzeugung bei Gebäuden so, dass diese (nahezu) emissionsfrei wird"
                        ],
                        "tags": [
                            "Energie",
                            "Umwelt"
                        ],
                        "examples": [
                            {
                                "example_id": "5e32239a-dd64-4b47-a5e9-9c03ab3a9cb3",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "[Schlagzeile:] „Wärmewende? Sofort!“"
                            },
                            {
                                "example_id": "ada723ad-cf23-4e41-98d2-381b3b83a119",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "[Schlagzeile:] „Dämmen für die Wärmewende“"
                            },
                            {
                                "example_id": "4e80fb82-b7de-4a98-a237-da1462140e1c",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Wie schaffen wir die Wärmewende?“"
                            },
                            {
                                "example_id": "3187e00a-3fa3-490e-a3dd-2f0ad2bb7e4d",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "Wir werden die Wärmewende nicht schaffen, wenn wir die Nahwärmenetze nicht ausbauen. Beispiel Dänemark: dort sind 65% der Haushalte an ein Wärmenetz angeschlossen."
                            },
                            {
                                "example_id": "dc13e6ce-f99e-46b6-80cd-11ffe3769461",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Die neuen Klimaziele der Bundesregierung verlangen ein hohes Tempo bei der Wärmewende: Laut der im Mai 2021 beschlossenen Novelle des Klimaschutzgesetzes muss Deutschland jedes Jahr 5,5 Millionen Tonnen CO₂ im Gebäudebereich einsparen.“"
                            },
                            {
                                "example_id": "c53e7441-c5ed-4597-9775-1718c049ea11",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Wie aber wird aus dem Sorgenkind der Energiewende eine sozialgerechte Wärmewende?“"
                            },
                            {
                                "example_id": "4a829bfa-7a34-4833-85f0-79dd2b624e25",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„»Ich bin überzeugt, wir werden die Wärmewende nur stemmen, wenn wir entsprechende Förderprogramme aufsetzen.«“"
                            },
                            {
                                "example_id": "ec8d8382-91b5-4780-b9fe-526dac0fae60",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Die Wärmewende wird die Stadtwerke im Land mindestens sechs Milliarden Euro kosten, damit rechnet der Schleswig-Holsteinische Verband für Energie- und Wasserwirtschaft.“"
                            },
                            {
                                "example_id": "b0225e7a-2ea1-411d-9a92-45597ecfc916",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Er betonte die zentrale Rolle der Akteure auf der kommunalen Ebene für das Gelingen der Wärmewende: »Der Schlüssel liegt in den Kommunen.«“"
                            },
                            {
                                "example_id": "fb3749e8-eb28-4d5b-8486-2fb516d0fa46",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Nach der Strom- kommt die Wärmewende: Überall im Land müssen Versorger auf klimaneutrale Quellen umstellen. Doch es gibt zahlreiche Hürden.“"
                            },
                            {
                                "example_id": "169a500d-f036-4b14-9ede-37fa8218401e",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Probleme beim Bau eines Fernwärmetunnels unter der Elbe kosten Hamburg Zeit auf dem Weg zur Wärmewende.“"
                            },
                            {
                                "example_id": "4fa325ad-1446-4673-8b2e-4c7c1a5d67ea",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Geothermie für Wärmewende entscheidend – Fernwärme ist für die Wärmewende, also den Umstieg auf erneuerbare Wärmeversorgung, entscheidend.“"
                            },
                            {
                                "example_id": "22059ed6-7979-4232-90b8-28babc970e8c",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Wenn es um die Wärmewende geht, haben Betreiber von Gasnetzen kein Interesse aus Gas auszusteigen.“"
                            },
                            {
                                "example_id": "154e780e-adc2-4f77-8d69-57bb93fa0668",
                                "sense_id": "d1335612-46a8-32a6-9350-e3f9f038b499",
                                "text": "„Als Grund für den steigenden Strombedarf nennen die Betreiber den geplanten Verzicht auf Kohle, Öl und Erdgas. So sind mit der angestrebten Verkehrs- und Wärmewende zwei große Bereiche zunehmend auf Strom statt fossile Energieträger angewiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
