                        "examples": [
                            {
                                "example_id": "1d535f6c-853e-47db-a8e6-6faf718c1211",
                                "sense_id": "2083077d-af00-3ded-951d-2ee8f420b927",
                                "text": "„Ratlos stand ich noch immer vor dem Postschalter.“"
                            },
                            {
                                "example_id": "282e0f0d-3270-47ca-aa8b-01fe0c1eec80",
                                "sense_id": "2083077d-af00-3ded-951d-2ee8f420b927",
                                "text": "„Am 1. Mai 1851 kamen in Baden erstmals Briefmarken an die Postschalter.“"
                            },
                            {
                                "example_id": "7f2f6419-5ab0-4c48-a2ab-2c8c72410408",
                                "sense_id": "2083077d-af00-3ded-951d-2ee8f420b927",
                                "text": "„Des Morgens gab es großes Gedränge am Postschalter, und die Vorsteherin wäre nicht zu Rande gekommen ohne den Hauptmann, der ihr zuweilen half.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
