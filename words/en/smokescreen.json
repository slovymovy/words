    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "904db0c4-b9ae-37f8-b560-fae780045cbd",
                    "sense_definition": "A cloud of smoke created to hide the movement of troops or ships during a battle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The navy ships released a thick <w>smokescreen</w> to protect themselves from enemy fire."
                        },
                        {
                            "text": "Troops advanced under the cover of a dense <w>smokescreen</w> during the military exercise."
                        }
                    ],
                    "synonyms": [
                        "cover",
                        "screen"
                    ],
                    "common_phrases": [
                        "create a smokescreen",
                        "lay a smokescreen"
                    ]
                },
                {
                    "sense_id": "a07be60c-132e-324d-8112-5d3ecd686f0f",
                    "sense_definition": "Something used to hide the truth or distract people from the real situation.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's announcement was just a <w>smokescreen</w> to hide their financial problems."
                        },
                        {
                            "text": "His angry outburst was a <w>smokescreen</w> to avoid answering the difficult question."
                        }
                    ],
                    "synonyms": [
                        "distraction",
                        "cover-up",
                        "pretext"
                    ],
                    "common_phrases": [
                        "use as a smokescreen"
                    ]
                }
            ]
        }
    ]
