                        "examples": [
                            {
                                "example_id": "068cf710-79ee-423f-8aa5-ada55e2f1f84",
                                "sense_id": "50923f42-04db-3dec-b2f8-630b192dbee0",
                                "text": "„Monatelang hatten sie in Erdhöhlen gelebt, waren abgemagert und unterkühlt.“"
                            },
                            {
                                "example_id": "cef38c75-f3b7-4d96-a260-a9850a092084",
                                "sense_id": "50923f42-04db-3dec-b2f8-630b192dbee0",
                                "text": "„Wir mssen unser Pulver trocken halten, entschied Korporal Albrecht und befahl, den Munitionskarren in eine Erdhöhle zu schieben.“"
                            }
                        ],
