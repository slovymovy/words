                {
                    "sense_id": "027fd572-3bd4-30b3-ac8e-c3fba8f69e0b",
                    "sense_definition": "De oorsprong of bron van iets, vaak gebruikt om een bedrijf aan te duiden dat andere bedrijven bezit.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_source",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>moeder</w> bepaalt het beleid voor alle internationale vestigingen.",
