{
    "word_family": [
        "stunner",
        "stunning",
        "stunningly",
        "unstunned"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "304022dd-6c53-3bee-a9c8-719178e3bd35",
                    "sense_definition": "To shock or surprise someone greatly, often leaving them momentarily unable to react.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden news of his resignation <w>stunned</w> the entire office.",
                            "target_lang_translations": {
                                "ru": "Внезапная новость о его отставке <w>ошеломила</w> весь офис."
                            }
                        },
                        {
                            "text": "She was <w>stunned</w> into silence by the sheer beauty of the mountain range.",
                            "target_lang_translations": {
                                "ru": "Она <w>онемела от изумления</w> перед чистой красотой горного хребта."
                            }
                        }
                    ],
                    "synonyms": [
                        "daze"
                    ],
                    "common_phrases": [
                        "stunned into silence",
                        "stunned by the news"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно шокировать или удивить кого-либо, часто оставляя их на мгновение неспособными реагировать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошеломить",
                                "target_lang_sense_clarification": "привести в замешательство неожиданностью"
                            },
                            {
                                "target_lang_word": "потрясти",
                                "target_lang_sense_clarification": "вызвать чрезвычайно сильные эмоции"
                            },
                            {
                                "target_lang_word": "оглушить",
                                "target_lang_sense_clarification": "сильнейшим образом поразить новостью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2ea6fc5-fee8-3347-b2b7-9419db71ad04",
                    "sense_definition": "To knock someone unconscious or into a state of disorientation, typically by a blow to the head.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "incapacitate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer managed to <w>stun</w> his opponent with a powerful left hook.",
                            "target_lang_translations": {
                                "ru": "Боксеру удалось <w>оглушить</w> соперника мощным левым хуком."
                            }
                        },
                        {
                            "text": "Police used a taser to <w>stun</w> the suspect before making an arrest.",
                            "target_lang_translations": {
                                "ru": "Полиция использовала электрошокер, чтобы <w>обездвижить</w> подозреваемого перед арестом."
                            }
                        }
                    ],
                    "synonyms": [
                        "daze"
                    ],
                    "common_phrases": [
                        "stun the prey",
                        "stun with a blow"
                    ],
                    "target_lang_definitions": {
                        "ru": "Привести кого-либо в бессознательное состояние или состояние дезориентации, обычно ударом по голове."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оглушить",
                                "target_lang_sense_clarification": "ударом привести в состояние беспамятства"
                            },
                            {
                                "target_lang_word": "ошеломить",
                                "target_lang_sense_clarification": "физически дезориентировать ударом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b01a2aa-1ed8-3d56-b9b3-49f03c14d0c8",
                    "sense_definition": "In cue sports, to hit the cue ball so that it slides without topspin or backspin.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "billiards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You need to <w>stun</w> the ball perfectly to keep it from rolling into the pocket.",
                            "target_lang_translations": {
                                "ru": "Вам нужно идеально <w>ударить без вращения</w>, чтобы шар не закатился в лузу."
                            }
                        },
                        {
                            "text": "He decided to <w>stun</w> the cue ball to get a better angle for the next shot.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>выполнить стоп-удар</w>, чтобы получить лучший угол для следующего хода."
                            }
                        }
                    ],
                    "common_phrases": [
                        "stun the cue ball"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in billiards/snooker"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В бильярде: ударить по битку так, чтобы он скользил без верхнего или нижнего вращения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бить без вращения",
                                "target_lang_sense_clarification": "технический прием в бильярде"
                            },
                            {
                                "target_lang_word": "стоп-удар",
                                "target_lang_sense_clarification": "удар, при котором шар останавливается"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7758dd52-bcc4-3d56-b69b-144aaaf170e9",
                    "sense_definition": "To confiscate equipment from a soldier as a punishment for their negligence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military_punishment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sergeant threatened to <w>stun</w> any rifle left unattended during the drill.",
                            "target_lang_translations": {
                                "ru": "Сержант пригрозил <w>конфисковать</w> любую винтовку, оставленную без присмотра во время учений."
                            }
                        },
                        {
                            "text": "He learned his lesson after the officer had to <w>stun</w> his gear.",
                            "target_lang_translations": {
                                "ru": "Он усвоил урок после того, как офицеру пришлось <w>изъять</w> его снаряжение."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Конфисковать снаряжение у солдата в качестве наказания за халатность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изымать снаряжение",
                                "target_lang_sense_clarification": "военное наказание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c93cc4bb-6c53-38b2-8120-80b5251dbb66",
                    "sense_definition": "A physical blow or a psychological shock that causes a state of confusion or helplessness.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy <w>stun</w> from the fall left him gasping for air on the ground.",
                            "target_lang_translations": {
                                "ru": "Сильное <w>оглушение</w> от падения заставило его хватать ртом воздух на земле."
                            }
                        },
                        {
                            "text": "The news of the accident was a massive <w>stun</w> to the entire family.",
                            "target_lang_translations": {
                                "ru": "Новость об аварии стала огромным <w>потрясением</w> для всей семьи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "a heavy stun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Физический удар или психологический шок, вызывающий состояние замешательства или беспомощности."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ошеломление",
                                "target_lang_sense_clarification": "состояние крайнего удивления или шока"
                            },
                            {
                                "target_lang_word": "шок",
                                "target_lang_sense_clarification": "сильное потрясение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "79ffdd00-94ea-35da-8b1c-54ca1cc16cf9",
                    "sense_definition": "A setting on a weapon designed to incapacitate without causing permanent injury or death.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "weaponry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officer kept his phaser on <w>stun</w> to avoid hurting the intruder.",
                            "target_lang_translations": {
                                "ru": "Офицер держал свой фазер в режиме <w>оглушения</w>, чтобы не ранить нарушителя."
                            }
                        },
                        {
                            "text": "Make sure the device is set to <w>stun</w> before you approach the animal.",
                            "target_lang_translations": {
                                "ru": "Убедитесь, что устройство настроено на <w>парализацию</w>, прежде чем приближаться к животному."
                            }
                        }
                    ],
                    "common_phrases": [
                        "set to stun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Режим оружия, предназначенный для выведения из строя без нанесения необратимых травм или смерти."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оглушение",
                                "target_lang_sense_clarification": "режим несмертельного оружия"
                            },
                            {
                                "target_lang_word": "парализация",
                                "target_lang_sense_clarification": "временное обездвиживание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b10da79-7229-3c9e-aec4-f4bf5e66d1f9",
                    "sense_definition": "The effect on a cue ball when it is hit without any spin, causing it to slide.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "billiards",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player used a lot of <w>stun</w> to control the position of the white ball.",
                            "target_lang_translations": {
                                "ru": "Игрок использовал сильный <w>стант</w>, чтобы контролировать положение белого шара."
                            }
                        },
                        {
                            "text": "Achieving the right amount of <w>stun</w> requires a very precise strike.",
                            "target_lang_translations": {
                                "ru": "Достижение нужной степени <w>скольжения</w> требует очень точного удара."
                            }
                        }
                    ],
                    "common_phrases": [
                        "apply some stun"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in billiards/snooker"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Эффект, возникающий при ударе по битку без вращения, заставляющий его скользить."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стант",
                                "target_lang_sense_clarification": "скольжение шара в бильярде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d603b25-130f-3b6b-ae21-da04bc8ddbbd",
                    "sense_definition": "A person who is perceived to be unintelligent or slow to understand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was acting like a total <w>stun</w> when he couldn't solve the simple puzzle.",
                            "target_lang_translations": {
                                "ru": "Он вел себя как полный <w>тупица</w>, когда не смог решить простую головоломку."
                            }
                        },
                        {
                            "text": "Don't be such a <w>stun</w> and pay attention to the instructions.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>тормозом</w> и внимательно слушай инструкции."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "derogatory"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который воспринимается как глупый или соображающий медленно."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тугодум",
                                "target_lang_sense_clarification": "медленно соображающий человек"
                            },
                            {
                                "target_lang_word": "тормоз",
                                "target_lang_sense_clarification": "сленг, медлительный человек"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}