                ],
                "senses": [
                    {
                        "sense_id": "71ff3ef0-1d0b-3466-9ca1-c6f2ab97acb8",
                        "entry_id": "d909512c-efc8-39c8-92a3-43ebb4589d41",
                        "glosses": [
                            "Verb, das die Abgabe oder Verbreitung von etwas beschreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "564c2805-f039-4467-87e4-8f784588c743",
                                "sense_id": "71ff3ef0-1d0b-3466-9ca1-c6f2ab97acb8",
                                "text": "„Zudem wird noch ein kurzer Einblick in die semantische Komplexität bestimmter Verbgruppen (z.B. Emissionsverben) gegeben.“"
                            },
                            {
                                "example_id": "f26cd20a-9462-4353-81f3-53b1403ed9c1",
                                "sense_id": "71ff3ef0-1d0b-3466-9ca1-c6f2ab97acb8",
                                "text": "„Eine korpusbasierte Pilotstudie, in dessen Mittelpunkt eine Argumentstrukturmuster- und Argumentrealisierungsmusteranalyse (Engelberg 2014) steht, soll daher quantitative und qualitative Information zu unterschiedlichen Aspekten einiger ausgewählter Emissionsverben (u.a. Geruchsverben, Geräuschverben) liefern, um Rückschlüsse bezüglich des Lexikalisierungsgrades der entsprechenden direktiven Musteranstellen zu können (Engelberg 2009, Goscher 2011, Meliss 2012).“"
                            },
                            {
                                "example_id": "7c5de181-9885-493f-9283-f43df0fc6859",
                                "sense_id": "71ff3ef0-1d0b-3466-9ca1-c6f2ab97acb8",
                                "text": "„Die Emissionsverben sind alle denominal, wobei das Nomen, von dem sie deriviert sind, den Stoff spezifiziert, der abgesondert wird.“"
                            },
                            {
                                "example_id": "1a9556ea-6af8-434a-930a-b926a0c955a2",
                                "sense_id": "71ff3ef0-1d0b-3466-9ca1-c6f2ab97acb8",
                                "text": "„In weiteren 29 Beispielen kookkurriert die -ment-Nominalisierung mit einem Emissionsverb wie pousser (‘ausstoßen’, 7x) émettre (‘von sich geben’, 7x) o.ä., welches zur Bezeichnung des Emissionsprozesses dient […].“"
                            },
                            {
                                "example_id": "d0e9114a-a245-4976-8d95-c7efd3d5f420",
                                "sense_id": "71ff3ef0-1d0b-3466-9ca1-c6f2ab97acb8",
                                "text": "Die Belegung der V-Position ist lediglich an die Bedingung gebunden, dass V kein Kopulaverb und kein Emissionsverb (im Sinne von Konstruktionstyp 4) sein darf."
                            },
                            {
                                "example_id": "3b5467ae-e3a7-49fc-86aa-7221691120c7",
                                "sense_id": "71ff3ef0-1d0b-3466-9ca1-c6f2ab97acb8",
                                "text": "Die sogenannten Emissionsverben wie schmecken oder riechen erlauben eine Objektprädikation, in der sich also das Adjektiv auf das Objekt des Satzes bezieht, zum Beispiel „der Kaffee schmeckt gut“."
                            },
                            {
                                "example_id": "25d0a20b-370f-4ecb-b3e6-4eb2d24ca1bc",
                                "sense_id": "71ff3ef0-1d0b-3466-9ca1-c6f2ab97acb8",
                                "text": "„Riechen“ als Wahrnehmungverb bedeutet einen Geruch aufnehmen, „riechen“ als Emissionsverb, dass etwas einen bestimmten Duft verbreitet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
