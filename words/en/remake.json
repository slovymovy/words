    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5416f7f4-3627-3944-9cf9-9927c3d3babf",
                    "sense_definition": "A new, especially updated, version of a film, video game, or similar work.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "media_version",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I haven't seen the original film, but the <w>remake</w> was great.",
                            "target_lang_translations": {
                                "ru": "Я не видел оригинальный фильм, но <w>римейк</w> был отличным.",
                                "zh": "我没看过原版电影，但这部<w>翻拍版</w>很棒。",
                                "es": "No he visto la película original, pero el <w>remake</w> fue genial."
                            }
                        },
                        {
                            "text": "Critics often compare the <w>remake</w> to the classic original.",
                            "target_lang_translations": {
                                "ru": "Критики часто сравнивают <w>римейк</w> с классическим оригиналом.",
                                "zh": "评论家经常将这部<w>翻拍版</w>与经典原版进行比较。",
                                "es": "Los críticos a menudo comparan el <w>remake</w> con el clásico original."
                            }
                        }
                    ],
                    "synonyms": [
                        "reboot"
                    ],
                    "common_phrases": [
                        "film remake",
                        "horror remake",
                        "cheap remake"
                    ],
                    "target_lang_definitions": {
                        "ru": "Новая, обычно обновленная версия фильма, видеоигры или подобного произведения.",
                        "zh": "电影、电子游戏或类似作品的翻拍版或重制版。",
                        "es": "Una versión nueva, especialmente actualizada, de una película, videojuego u obra similar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "римейк",
