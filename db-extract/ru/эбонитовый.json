                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99645258-d34d-497f-9ae5-24fed87811bd",
                                "sense_id": "77081082-6565-3c39-852a-4e0dfa843531",
                                "text": "Для этого опыта нам потребовался эбонитовый стержень."
                            }
                        ]
                    },
                    {
                        "sense_id": "726e70eb-284e-3086-bde5-b62296be4ac1",
                        "entry_id": "bf823161-9c5f-3019-a152-a5d7132e642d",
                        "glosses": [
                            "очень чёрный"
                        ],
                        "tags": [
                            "цвет:"
                        ],
                        "examples": [
                            {
                                "example_id": "8ce565d7-0330-4a24-9a63-3981220d402b",
                                "sense_id": "726e70eb-284e-3086-bde5-b62296be4ac1",
                                "text": "У неё были две короткохвостые шиншиллы: одна эбонитовая, а другая — бежевая."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
