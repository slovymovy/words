                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nadie",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "ed8b041e-494b-3407-bbc8-0ae66939e1ff",
                                        "entry_id": "a5fcf136-025f-358e-b95f-ae0af064058f",
                                        "glosses": [
                                            "Ninguna persona."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77c7c86e-424b-4ad3-918c-5ab334847f76",
                                                "sense_id": "ed8b041e-494b-3407-bbc8-0ae66939e1ff",
                                                "text": "No quiero que nadie vaya a mi fiesta; prefiero estar con ustedes."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "nadie",
