                "senses": [
                    {
                        "sense_id": "54039134-4223-328c-957c-04608b337510",
                        "entry_id": "fcbbb3d9-4f49-3beb-931a-8e84ce320769",
                        "glosses": [
                            "höchstes Gericht neben dem Reichskammergericht im Heiligen Römischen Reich Deutscher Nation"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0743d045-bc10-4531-919a-4bbabf3ae9c1",
                                "sense_id": "54039134-4223-328c-957c-04608b337510",
                                "text": "„Der Reichshofrat als ordentliches Gericht entwickelte sich aus einem Verwaltungskollegium des Kaisers zur Bearbeitung der am kaiserlichen Hof anfallenden Rechtssachen und behielt die Funktion eines beratenden Gremiums bis zuletzt inne, wobei die Regierungstätigkeit zugunsten der Rechtsprechung zurückging.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7070de72-d4b0-413a-a079-7804f139fc35",
                        "source_entry_id": "fcbbb3d9-4f49-3beb-931a-8e84ce320769",
                        "source_sense_id": "54039134-4223-328c-957c-04608b337510",
                        "source_sense_description": "höchstes Gericht neben dem Reichskammergericht im Heiligen Römischen Reich Deutscher Nation",
                        "target_lang_word": "conseiller aulique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "conseiller aulique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d41c82f5-dd14-3a71-be0f-8c4251a87468",
                                        "entry_id": "dc132dca-94b8-3f72-a03c-96119fcbe496",
                                        "glosses": [
                                            "Membre d’un conseil aulique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df686264-093a-446e-af3e-d5882c922ff0",
                                                "sense_id": "d41c82f5-dd14-3a71-be0f-8c4251a87468",
                                                "text": "Après le départ des Schwanthaler, il y eut dans Munich comme une épidémie de scandales. On vit successivement une chanoinesse enlever un baryton, le doyen de l’Institut épouser une danseuse, un conseiller aulique faire sauter la coupe, le couvent des dames nobles fermé pour tapage nocturne…"
                                            },
                                            {
                                                "example_id": "f7ecca62-a112-4f40-85b7-b0cae5b778f6",
                                                "sense_id": "d41c82f5-dd14-3a71-be0f-8c4251a87468",
                                                "text": "Le conseiller aulique Behrens n'était nullement le propriétaire et le tenancier de l'établissement"
                                            },
                                            {
                                                "example_id": "1b55c9f5-691c-44c6-95ed-19d31117d1b4",
                                                "sense_id": "d41c82f5-dd14-3a71-be0f-8c4251a87468",
                                                "text": "On frappa. La bonne entra et annonça que le concierge de la Schreyvogelgasse venait chercher le Docteur pour le conduire chez le Conseiller aulique qui était de nouveau très mal"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
