    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b3f9d1db-f9ec-3bdd-82f5-f217cc988896",
                "word": "wynd",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "fe9d7468-176b-42e7-9a9a-ab21358679db",
                        "entry_id": "b3f9d1db-f9ec-3bdd-82f5-f217cc988896",
                        "tags": [
                            "plural"
                        ],
                        "form": "wynds"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5b41d5a6-9da3-3592-9b41-32221a5c057f",
                        "entry_id": "b3f9d1db-f9ec-3bdd-82f5-f217cc988896",
                        "glosses": [
                            "A narrow lane, alley or path, especially one between houses."
                        ],
                        "tags": [
                            "Northumbria",
                            "Scotland"
                        ],
                        "examples": [
                            {
                                "example_id": "97623120-5f85-4f18-9e1d-b1e3dc468684",
                                "sense_id": "5b41d5a6-9da3-3592-9b41-32221a5c057f",
                                "text": "Fortune favoured us, and we got home without meeting a soul. Once we saw a man, who seemed not quite sober, passing along a street in front of us; but we hid in a door till he had disappeared up an opening such as there are here, steep little closes, or wynds, as they call them in Scotland."
                            },
                            {
                                "example_id": "af37611f-4440-41c4-ade2-b38c279cf0ce",
                                "sense_id": "5b41d5a6-9da3-3592-9b41-32221a5c057f",
                                "text": "He flew through the moonlight streets, clattering over cobbles, darting down narrow alleys and up twisty wynds, racing to his love."
                            },
                            {
                                "example_id": "cf2ec9aa-5916-4196-a849-f02327b7ae79",
                                "sense_id": "5b41d5a6-9da3-3592-9b41-32221a5c057f",
                                "text": "Stirling's called an Edinburgh mini-me: the same winding wynds, the same historic core, castle, looming romantic hills. Only a lot cheaper."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e813180-d89f-3454-a92a-4746d5f7d1dd",
                        "entry_id": "b3f9d1db-f9ec-3bdd-82f5-f217cc988896",
                        "glosses": [
                            "A stack of hay."
                        ],
                        "tags": [
                            "Ireland",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "649704f2-94e5-40cd-b4b6-645f93f47673",
                                "sense_id": "7e813180-d89f-3454-a92a-4746d5f7d1dd",
                                "text": "This was then used as the base for the cocks of hay, or wyndes as we called them. […] A piece of hay with its ends firmly embedded in the base of the wynde was wound around the hay twine and knotted with it. The ball of twine was then thrown across the wynde and tied at the other side in the same way, and this process was repeated crossways."
                            }
                        ]
                    }
                ],
