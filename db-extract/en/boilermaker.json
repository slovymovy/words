                                                "example_id": "911ceb10-3a9e-4b3c-968f-06764bfbc843",
                                                "sense_id": "29dfd3eb-81b2-352e-ba4e-5828f552a5d3",
                                                "text": "L’industrie chaudronnière."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
