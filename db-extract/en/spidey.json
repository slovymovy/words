                    {
                        "sense_id": "c3849753-c8db-337a-8804-676cc0b6beda",
                        "entry_id": "1a2f726e-23bb-3508-872b-c6a5e382b828",
                        "glosses": [
                            "The fictional superhero Spider-Man."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "836531c7-f148-4364-ae43-2e5c0671396b",
                                "sense_id": "c3849753-c8db-337a-8804-676cc0b6beda",
                                "text": "Seven months later he reappeared in his own comic book, The Amazing Spider-Man. In the 16 years since, Spidey (as his fans call him) has become the country's most popular superhero, appearing in 300 daily newspapers."
                            },
                            {
                                "example_id": "8c23f85d-f801-4591-ba33-c122facefaff",
                                "sense_id": "c3849753-c8db-337a-8804-676cc0b6beda",
                                "text": "In the closet Marvin found his sea shell collection, baseball cards, a stack of Spidey comic books, a jar of dead flies he had forgotten about, a paper bag filled with pine cones, and five cans of mud from Lake Washington."
                            },
                            {
                                "example_id": "76e559e6-7cbc-4499-8218-590f4d17b6c0",
                                "sense_id": "c3849753-c8db-337a-8804-676cc0b6beda",
                                "text": "Only Spider-Man's spidey powers can get us out of this!"
                            },
                            {
                                "example_id": "266036ad-21ea-4adc-ad35-db12c542c239",
                                "sense_id": "c3849753-c8db-337a-8804-676cc0b6beda",
                                "text": "[H]e's also written a Spidey short story (“Arms and the Man” in 1997's Untold Tales of Spider-Man) and a Spidey novel (Down These Mean Streets in 2005)."
                            }
                        ]
                    }
