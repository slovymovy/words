                "senses": [
                    {
                        "sense_id": "99e1c0de-b491-3085-bd42-c7fbb41a2599",
                        "entry_id": "ec130465-1e9b-3276-b6b8-d22d5fdc6d24",
                        "glosses": [
                            "geleedpotige met drie paar poten en geen, één of twee paar vleugels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "72138cde-2086-417b-8627-6405fe2fd953",
                                "sense_id": "99e1c0de-b491-3085-bd42-c7fbb41a2599",
                                "text": "Kabinet wil dat Nederlanders vaker insecten eten"
                            },
                            {
                                "example_id": "e66e1b4a-4d0c-42c2-b97a-a6b0ab8c9714",
                                "sense_id": "99e1c0de-b491-3085-bd42-c7fbb41a2599",
                                "text": "Ik filterde zo snel mogelijk een liter water voor mijn avondmaal en zocht een wat hogerop gelegen plek in de hoop daar wat minder last van de insecten te hebben."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef0236c7-3ff8-4c4e-b494-f1a2ae825ff2",
                        "source_entry_id": "ec130465-1e9b-3276-b6b8-d22d5fdc6d24",
                        "source_sense_id": "99e1c0de-b491-3085-bd42-c7fbb41a2599",
                        "source_sense_description": "geleedpotige met drie paar poten en geen, één of twee paar vleugels",
                        "target_lang_word": "Insekt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Insekt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "53a3dba6-fe90-33b7-a4c6-020428c0f581",
                                        "entry_id": "6ca9beeb-b7dc-3b4a-b6aa-30367d7a2c20",
                                        "glosses": [
                                            "mehrzelliges, gliederfüßiges Tier mit sechs Beinen (im erwachsenen Zustand)"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b23b7ab-2892-47a8-817f-1ff501bd6073",
                                                "sense_id": "53a3dba6-fe90-33b7-a4c6-020428c0f581",
                                                "text": "Ein Käfer ist ebenso wie eine Libelle ein Insekt."
                                            },
                                            {
                                                "example_id": "9e649cd8-dfb6-4374-af3e-2f728019017b",
                                                "sense_id": "53a3dba6-fe90-33b7-a4c6-020428c0f581",
                                                "text": "„In einer Höhe von etwa 1.000 m trifft man Insekten und Vögel, für die die Luft der reinste Highway ist.“"
                                            },
                                            {
                                                "example_id": "fb9ecc67-3a5c-45fd-b635-680bc4a9a0ba",
                                                "sense_id": "53a3dba6-fe90-33b7-a4c6-020428c0f581",
                                                "text": "„Wernicke macht eine Bewegung, als scheuche er ein Insekt fort.“"
                                            },
                                            {
                                                "example_id": "c8a7936a-5ae5-4789-9350-39e3641863ec",
                                                "sense_id": "53a3dba6-fe90-33b7-a4c6-020428c0f581",
                                                "text": "„Ich habe auch die Insekten und die Fliegen und die Mücken bemerkt.“"
                                            },
                                            {
                                                "example_id": "bee62043-f38c-4cab-bcbe-5609f95f9b5d",
                                                "sense_id": "53a3dba6-fe90-33b7-a4c6-020428c0f581",
                                                "text": "„Inzwischen war es später Nachmittag, das Licht golden, die Luft warm und stehend, die Insekten träge und beschwert von Pollenstaub.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "96035b48-c7ad-49dd-90f6-f4b60157f347",
                        "source_entry_id": "ec130465-1e9b-3276-b6b8-d22d5fdc6d24",
                        "source_sense_id": "99e1c0de-b491-3085-bd42-c7fbb41a2599",
                        "source_sense_description": "geleedpotige met drie paar poten en geen, één of twee paar vleugels",
                        "target_lang_word": "insect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2441a982-629a-3b45-b0ad-81376035873c",
                                        "entry_id": "c33a5e31-d9eb-34e9-94df-602035901453",
                                        "glosses": [
                                            "An arthropod (in the Insecta class) characterized by six legs, up to four wings, and a chitinous exoskeleton."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc1ac6bf-67bd-4246-a261-a5a856680d5f",
                                                "sense_id": "2441a982-629a-3b45-b0ad-81376035873c",
                                                "text": "Our shed has several insect infestions, including ants, yellowjackets, and wasps."
                                            },
                                            {
                                                "example_id": "fcdefed4-fe49-48ce-847c-34c67c6a6292",
                                                "sense_id": "2441a982-629a-3b45-b0ad-81376035873c",
                                                "text": "Nonetheless, some insect prey take advantage of clutter by hiding in it. Earless ghost swift moths become “invisible” to echolocating bats by forming mating clusters close (less than half a meter) above vegetation and effectively blending into the clutter of echoes that the bat receives from the leaves and stems around them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5f2afb0-d3fd-3632-801f-c9dc14167943",
                                        "entry_id": "c33a5e31-d9eb-34e9-94df-602035901453",
                                        "glosses": [
                                            "Any small arthropod similar to an insect, including spiders, centipedes, millipedes, etc."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "542c147a-9caf-4fa9-b99d-034b94dd427a",
                                                "sense_id": "c5f2afb0-d3fd-3632-801f-c9dc14167943",
                                                "text": "The swamp is swarming with every sort of insect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "549f62e3-249e-37e2-9657-71bf38003763",
                                        "entry_id": "c33a5e31-d9eb-34e9-94df-602035901453",
                                        "glosses": [
                                            "A contemptible or powerless person."
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e94ae7e1-1fdd-4cff-9397-5e11a8561d68",
                                                "sense_id": "549f62e3-249e-37e2-9657-71bf38003763",
                                                "text": "The manager’s assistant was the worst sort of insect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8fa2892-d733-4f87-9474-678e33e7c93d",
                        "source_entry_id": "ec130465-1e9b-3276-b6b8-d22d5fdc6d24",
                        "source_sense_id": "99e1c0de-b491-3085-bd42-c7fbb41a2599",
                        "source_sense_description": "geleedpotige met drie paar poten en geen, één of twee paar vleugels",
                        "target_lang_word": "insecte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insecte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1be5097e-cfc7-3b4c-8ae3-7ac4ee143d43",
                                        "entry_id": "7fe58b8f-04cb-3703-a50e-1ecc6f6ace23",
                                        "glosses": [
                                            "Petit animal invertébré, arthropode dont l'adulte est constitué de trois parties (tête, thorax, abdomen) protégées par un exosquelette de chitine et possédant au moins une paire d’yeux composés, une paire d’antennes, trois paires de pattes articulées et deux paires d’ailes parfois atrophiées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29342ef8-ee68-412b-8a3a-9673d0da0474",
                                                "sense_id": "1be5097e-cfc7-3b4c-8ae3-7ac4ee143d43",
                                                "text": "C’est ainsi que parmi les insectes nous trouvons beaucoup d’espèces d’animaux comme la punaise qui exhalent une odeur fétide."
                                            },
                                            {
                                                "example_id": "4a5c57b8-2e98-4cae-8a90-07de0bba40d0",
                                                "sense_id": "1be5097e-cfc7-3b4c-8ae3-7ac4ee143d43",
                                                "text": "Une autre condition pour la formation des graines est que la pollinisation qui assure la fécondation puisse se produire. Or il arrive souvent que la pollinisation doive être effectuée par un insecte (quelquefois oiseau, mollusque…) déterminé. Dans ce cas l’aire de l’insecte pollinisateur limite celle de la plante."
                                            },
                                            {
                                                "example_id": "0b4cd5ca-cc34-40bb-943a-1d678b922b81",
                                                "sense_id": "1be5097e-cfc7-3b4c-8ae3-7ac4ee143d43",
                                                "text": "Les bouillies et les poudres à base de S.P.C. et de D.D.T. ont une action ovicide très nette et sont, de ce fait, utilisées dans la lutte contre de nombreux insectes et particulièrement contre l’anthonome du poirier et celui du pommier."
                                            },
                                            {
                                                "example_id": "c7848c0c-3463-454b-97c8-0268f2666a3d",
                                                "sense_id": "1be5097e-cfc7-3b4c-8ae3-7ac4ee143d43",
                                                "text": "Le cycle de l’insecte est de trois semaines. La lutte peut se faire par voie chimique (oxydéméton-méthyl, malation, parathion) mais elle est coûteuse."
                                            },
                                            {
                                                "example_id": "a8fdb987-e35b-4958-a10c-a58ed89bc15e",
                                                "sense_id": "1be5097e-cfc7-3b4c-8ae3-7ac4ee143d43",
                                                "text": "La start-up Innovafeed s'apprête à inaugurer, à Nesle dans la Somme, la plus grande usine d’insectes du monde. Un site qui doit permettre à la start-up de s'imposer comme le leader de la protéine d’insectes pour l’alimentation animale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "120baf8d-9df2-3e39-83f3-fb1f8110e944",
                                        "entry_id": "7fe58b8f-04cb-3703-a50e-1ecc6f6ace23",
                                        "glosses": [
                                            "Imago de cet animal, c'est-à-dire l'adulte anciennement considéré comme linsecte parfait."
                                        ],
                                        "tags": [
                                            "specifically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72aa4f7-1254-4612-9c3c-91ef0f4580fa",
                                                "sense_id": "120baf8d-9df2-3e39-83f3-fb1f8110e944",
                                                "text": "Ce sont les larves des pucerons […]. Complètement développées, ces larves deviennent de jolis insectes, pourvus de quatre ailes diaphanes, presque deux fois plus longues et plus larges que le corps entier, et soutenues par quelques rares nervures."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "77c5daf4-9aae-3745-8663-8d5a69411b26",
                                        "entry_id": "7fe58b8f-04cb-3703-a50e-1ecc6f6ace23",
                                        "glosses": [
                                            "(Par extension) (familier) Toutes espèces d'arthropodes, incluant les araignées, les tiques, les mille-pattes, les collemboles, etc... Note : Cet usage est considéré comme fautif par les biologistes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60682cdc-0e62-4ccc-ad7a-6055ea3494e4",
                                                "sense_id": "77c5daf4-9aae-3745-8663-8d5a69411b26",
                                                "text": "Mais quel est donc cet insecte de nos jardins qui permet de se débarrasser des punaises de lit ? Focus ! … Il s’agit des araignées crabes (genre Thanatus), des prédateurs naturels des punaises de lit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
