                                "ru": "В этом сборнике есть <w>новелла</w> на каждый вечер недели.",
                                "zh": "这个合集里收录了够一周每晚阅读的<w>短篇小说</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткая история или рассказ, часто входящий в сборник.",
                        "zh": "短篇故事或寓言，通常是合集的一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новелла",
                                "target_lang_sense_clarification": "короткий рассказ"
                            },
                            {
                                "target_lang_word": "рассказ",
                                "target_lang_sense_clarification": "литературное произведение"
                            }
                        ],
