                ],
                "senses": [
                    {
                        "sense_id": "b585d08c-5a51-3b76-ad38-7377e43662d7",
                        "entry_id": "7f6439e9-bd02-3d56-bb6c-67cbc0659ac7",
                        "glosses": [
                            "Zahl, die durch ihr Ausmaß Erschrecken auslöst; Gebrauch mitunter motiviert durch Zweifel an der Richtigkeit der Zahlenangabe"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "5c6dfb4e-75c2-47a5-b8d9-84daa87d8183",
                                "sense_id": "b585d08c-5a51-3b76-ad38-7377e43662d7",
                                "text": "Die Horrorzahl von über 5 Millionen Arbeitslosen ist erschreckend und erschütternd."
                            },
                            {
                                "example_id": "dce8bb4e-9904-4f89-9598-90eefa8268ae",
                                "sense_id": "b585d08c-5a51-3b76-ad38-7377e43662d7",
                                "text": "„6,7 Prozent Rückgang der Wirtschaftsleistung […] hinter diesen Prozentangaben verbergen sich wahre Horrorzahlen: Sie sagen nämlich aus, dass in Deutschland im Vergleich zum Vorjahreszeitraum im Inland Waren und Dienstleistungen im Wert von über 30 Milliarden Euro weniger hergestellt und verkauft wurden.“",
                                "translation": "Zahl erzeugt, um zu erschrecken (Konnotation der Unrichtigkeit):"
                            },
                            {
                                "example_id": "bb216e5c-5233-445d-aad9-d5845c3d25a4",
                                "sense_id": "b585d08c-5a51-3b76-ad38-7377e43662d7",
                                "text": "[COVID-19-Pandemie:] „Täglich werden wir mit neuen Horrorzahlen über die Fortentwicklung der Pandemie erschreckt.“"
                            },
                            {
                                "example_id": "57b12d27-7cd1-4dfc-8a64-5349c40707e7",
                                "sense_id": "b585d08c-5a51-3b76-ad38-7377e43662d7",
                                "text": "„Täglich fliegen uns neue Horrorzahlen um die Ohren und niemand erklärt, wie sich diese Werte zusammensetzen.“"
                            },
                            {
                                "example_id": "adc09c48-905f-4ff3-b074-0fdaf358bb7e",
                                "sense_id": "b585d08c-5a51-3b76-ad38-7377e43662d7",
                                "text": "Die Horrorzahl von 500.000 Behandlungsfehlern pro Jahr ist aus der Luft gegriffen."
                            },
                            {
                                "example_id": "5c08544a-0de6-4bea-82d2-23bf334f0907",
                                "sense_id": "b585d08c-5a51-3b76-ad38-7377e43662d7",
                                "text": "Die genannte Horrorzahl würde keiner empirischen Überprüfung standhalten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
