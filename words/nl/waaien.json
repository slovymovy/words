                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De wind <w>waait</w> uit het noorden en brengt koude lucht mee.",
                            "target_lang_translations": {
                                "en": "The wind <w>blows</w> from the north and brings cold air with it.",
                                "ru": "Ветер <w>дует</w> с севера и несёт с собой холодный воздух.",
                                "pl": "Wiatr <w>wieje</w> z północy i przynosi zimne powietrze.",
                                "de": "Der Wind <w>weht</w> aus dem Norden und bringt kalte Luft mit.",
                                "fr": "Le vent <w>souffle</w> du nord et apporte de l'air froid.",
                                "it": "Il vento <w>soffia</w> da nord e porta aria fredda.",
                                "cs": "Vítr <w>fouká</w> ze severu a přináší studený vzduch.",
                                "tr": "Rüzgâr kuzeyden <w>esiyor</w> ve beraberinde soğuk hava getiriyor.",
                                "es": "El viento <w>sopla</w> del norte y trae aire frío.",
                                "zh": "风从北方<w>吹</w>来，带来了冷空气。"
                            }
                        },
                        {
                            "text": "Er <w>waait</w> een frisse zeewind over het strand.",
                            "target_lang_translations": {
                                "en": "A fresh sea breeze <w>blows</w> across the beach.",
                                "ru": "Над пляжем <w>веет</w> свежий морской бриз.",
                                "pl": "Nad plażą <w>wieje</w> rześki morski wiatr.",
                                "de": "Es <w>weht</w> ein frischer Seewind über den Strand.",
                                "fr": "Une brise marine fraîche <w>souffle</w> sur la plage.",
                                "it": "Sulla spiaggia <w>spira</w> una fresca brezza marina.",
                                "cs": "Přes pláž <w>věje</w> svěží mořský vítr.",
                                "tr": "Kumsalın üzerinden serin bir deniz meltemi <w>esiyor</w>.",
                                "es": "<w>Sopla</w> una brisa marina fresca sobre la playa.",
                                "zh": "一阵清凉的海风<w>吹拂</w>过沙滩。"
                            }
                        }
