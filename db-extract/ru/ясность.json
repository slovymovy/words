                "senses": [
                    {
                        "sense_id": "b50a05a2-c90d-3c31-bbbe-ba4e3088557b",
                        "entry_id": "f8a526b5-a8e2-3ee7-a2c4-7182d1599fd3",
                        "glosses": [
                            "clarity, lucidity"
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1af7b043-6275-460a-bc0d-0642180edf6f",
                                "sense_id": "b50a05a2-c90d-3c31-bbbe-ba4e3088557b",
                                "text": "я́сность мы́сли",
                                "translation": "lucidity of mind",
                                "english": "lucidity of mind"
                            },
                            {
                                "example_id": "78472fa0-e559-4a27-a6fb-e5c2e897d421",
                                "sense_id": "b50a05a2-c90d-3c31-bbbe-ba4e3088557b",
                                "text": "я́сность це́ли",
                                "translation": "clarity of aim",
                                "english": "clarity of aim"
                            },
                            {
                                "example_id": "3e30b55f-d054-49c8-9bd7-4b05f9d56914",
                                "sense_id": "b50a05a2-c90d-3c31-bbbe-ba4e3088557b",
                                "text": "внести́ я́сность",
                                "translation": "to make things clear; to put things right",
                                "english": "to make things clear; to put things right"
                            },
                            {
                                "example_id": "fac104f0-b078-46a9-9b1a-52d36ac956dc",
                                "sense_id": "b50a05a2-c90d-3c31-bbbe-ba4e3088557b",
                                "text": "для/ра́ди я́сности",
                                "translation": "for clarity's sake",
                                "english": "for clarity's sake"
                            },
                            {
                                "example_id": "acfd41a8-f88f-4b63-8ae1-787d31e6e76b",
                                "sense_id": "b50a05a2-c90d-3c31-bbbe-ba4e3088557b",
                                "text": "замнём для я́сности",
                                "translation": "let's give this topic a rest",
                                "english": "let's give this topic a rest"
                            },
                            {
                                "example_id": "416062f3-0965-408f-89be-e239f96e7b32",
                                "sense_id": "b50a05a2-c90d-3c31-bbbe-ba4e3088557b",
                                "text": "Мне стало невыразимо тошно от такой ясности мышления, и я чувствовал, что если буду молчать ещё, то наверное заплачу…",
                                "translation": "The clearness of this line of thought was inexpressibly sad and painful to me, and I felt that if I kept silence any longer I was really bound to weep. . . .",
                                "english": "The clearness of this line of thought was inexpressibly sad and painful to me, and I felt that if I kept silence any longer I was really bound to weep. . . ."
                            }
                        ]
                    }
                ],
