                "senses": [
                    {
                        "sense_id": "153d36c1-a83a-38dd-816d-0942275cb5d0",
                        "entry_id": "5b42a124-6bcf-3fd0-b41d-c0e40e2f63a4",
                        "glosses": [
                            "Poupée."
                        ],
                        "tags": [
                            "childish"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a05aefb3-a7ed-3606-ad74-1e441d103c90",
                        "entry_id": "5b42a124-6bcf-3fd0-b41d-c0e40e2f63a4",
                        "glosses": [
                            "Jeune femme ou jeune fille, généralement jolie."
                        ],
                        "tags": [
                            "dated",
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "225ba360-883c-4c84-a923-fe36bbd56860",
                                "sense_id": "a05aefb3-a7ed-3606-ad74-1e441d103c90",
                                "text": "Je sais que le tabac, c’est mauvais pour la voix,\nOn dit que l’alcool c’est pas bon pour le foie,\nQuant aux petites pépées, c’est fatal pour le cœur,\n[…]"
                            },
                            {
                                "example_id": "68ef17c2-13f9-486b-84f9-d68c1c41c798",
                                "sense_id": "a05aefb3-a7ed-3606-ad74-1e441d103c90",
                                "text": "Dans son portrait du secrétaire général, un journaliste a écrit une comparaison qui donne à réfléchir malgré sa méchanceté gratuite : il serait fasciné par le PR comme par un voyou accompagné d’une spectaculaire pépée."
                            },
                            {
                                "example_id": "8cc57603-804c-4cc6-864b-d54d4cc348ba",
                                "sense_id": "a05aefb3-a7ed-3606-ad74-1e441d103c90",
                                "text": "Xavier Dupont de Ligonnès est mort depuis bien longtemps. Mais soutenir cette thèse, dans cette affaire, c’est sûr, c’est moins vendeur que de l’imaginer avec une pépée, un cigare au coin du bec, quelque part sous les cocotiers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7f65c8b4-d8d4-40ff-ab7e-012fd796cafb",
                        "source_entry_id": "5b42a124-6bcf-3fd0-b41d-c0e40e2f63a4",
                        "target_lang_word": "Biene",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biene",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c020f8f6-186d-3b1b-8e1a-84ef706c1d36",
                                        "entry_id": "e70f5ae6-9e54-34f9-bd26-a39bb794b051",
                                        "glosses": [
                                            "behaartes, fliegendes Insekt aus der Ordnung der Hautflügler;"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea86be21-c42c-453a-955a-41b6bafe2c46",
                                                "sense_id": "c020f8f6-186d-3b1b-8e1a-84ef706c1d36",
                                                "text": "Die Bienen fliegen von einer Blüte zur nächsten, um den darin enthaltenen Nektar zu sammeln."
                                            },
                                            {
                                                "example_id": "d5f68854-49b7-4136-baf5-e919c03f73fd",
                                                "sense_id": "c020f8f6-186d-3b1b-8e1a-84ef706c1d36",
                                                "text": "„Ab der Sommersonnenwende produzieren die Bienen weniger, sie fangen schon an, sich auf den Winter vorzubereiten.“"
                                            },
                                            {
                                                "example_id": "3ac62d96-fac3-4fc8-a970-7a15528d3f78",
                                                "sense_id": "c020f8f6-186d-3b1b-8e1a-84ef706c1d36",
                                                "text": "„Es gibt keine Stechmücken, aber auch keine Bienen und somit keinen färöischen Honig.“"
                                            },
                                            {
                                                "example_id": "b317ae0a-5540-4d47-b749-b7dc633b70bd",
                                                "sense_id": "c020f8f6-186d-3b1b-8e1a-84ef706c1d36",
                                                "text": "„Bei der Jungfernzeugung (Parthogenese) entwickeln sich auch unbefruchtete Eier (z.B. bei den Bienen und Blattläusen).“"
                                            },
                                            {
                                                "example_id": "7ab0b99b-a63c-473f-8701-e78a729bc6c1",
                                                "sense_id": "c020f8f6-186d-3b1b-8e1a-84ef706c1d36",
                                                "text": "„Das Aus- und Einfliegen der Bienen ist doch anders als in lebendigen Stöcken, und dem Imker fällt es auf, dass der Geruch und die Geräusche doch nicht die gleichen sind.“"
                                            },
                                            {
                                                "example_id": "6d77ad76-6536-45b2-a21c-59cc9023c1ad",
                                                "sense_id": "c020f8f6-186d-3b1b-8e1a-84ef706c1d36",
                                                "text": "„[…] als gute Nahrungsquellen für Bienen gelten die beiden Lavendelarten Lavandula angustifolia (Echter Lavendel) und Lavandula stoechas (Schopflavendel).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "fe67b213-5210-3cc2-9160-914af707a12a",
                                        "entry_id": "e70f5ae6-9e54-34f9-bd26-a39bb794b051",
                                        "glosses": [
                                            "behaartes, fliegendes Insekt aus der Ordnung der Hautflügler;",
                                            "speziell die westliche Honigbiene"
                                        ],
                                        "tags": [
                                            "Apis mellifera"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "dd9d89e0-c4c5-3a90-8c2c-914b5068cc70",
                                        "entry_id": "e70f5ae6-9e54-34f9-bd26-a39bb794b051",
                                        "glosses": [
                                            "behaartes, fliegendes Insekt aus der Ordnung der Hautflügler;",
                                            "andere Arten der Apiformes"
                                        ],
                                        "tags": [],
