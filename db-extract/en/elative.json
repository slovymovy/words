                    {
                        "translation_id": "5a892171-b010-4b0f-8135-cc76fb05a155",
                        "source_entry_id": "8d5c6f6a-611d-3e3c-9096-e95b381a4412",
                        "source_sense_id": "0dcad79a-ba6e-3c5f-96a8-cf084114b77b",
                        "source_sense_description": "elative case of a noun",
                        "target_lang_word": "Elativ",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elativ",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6a8227c4-64ac-3b9f-b90f-3740f2df5286",
                                        "entry_id": "e6a6a953-0b99-35a3-a85e-5898921752ff",
                                        "glosses": [
                                            "absolut höchste Stufe der Steigerung der Adjektive; der Elativ wird im Deutschen durch den absoluten Superlativ oder besonders durch Adverbien ausgedrückt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd6e0ab4-7d72-4d4b-9574-268d18138d0b",
                                                "sense_id": "6a8227c4-64ac-3b9f-b90f-3740f2df5286",
                                                "text": "In „Hans ist ein äußerst großer Junge“ drückt das adverbiell verwendete Adjektiv äußerst den Elativ aus. Statt „äußerst“ kommen für den Elativ auch weitere Wörter wie „extrem“, \"sehr\", „unübertrefflich“ in Frage."
                                            },
                                            {
                                                "example_id": "630a0a3f-1584-41c1-8eed-1831ef9fd8b5",
                                                "sense_id": "6a8227c4-64ac-3b9f-b90f-3740f2df5286",
                                                "text": "„Der Elativ ist also nicht eine eigene Komparationsform des Adjektivs, sondern eine besondere Gebrauchsweise des Superlativs.“"
                                            },
                                            {
                                                "example_id": "25a074df-7b1e-4b52-bd60-135acbaa70dc",
                                                "sense_id": "6a8227c4-64ac-3b9f-b90f-3740f2df5286",
                                                "text": "„Bei den Adjektiven sind die verschiedenen Steigerungsformen zu beachten: der Positiv (die Normalform), der Komparativ (die Steigerungsform) und der Superlativ (die Höchststufe, die außerhalb von Vergleichen Elativ genannt wird).“"
                                            },
                                            {
                                                "example_id": "cbcf6b68-e32d-43d9-b4d0-e6a05f501f8d",
                                                "sense_id": "6a8227c4-64ac-3b9f-b90f-3740f2df5286",
                                                "text": "„Das letztere ist der sogenannte Elativ.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
