                "translations": [
                    {
                        "translation_id": "26fb2e87-d7ea-4bb6-822a-1a60e7b12805",
                        "source_entry_id": "52e33c15-2500-3832-8ede-3661ecefab57",
                        "target_lang_word": "stroll",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stroll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c0a62f85-1b82-3b14-8a5e-dac3d66bffe9",
                                        "entry_id": "47cd2028-92ae-3a86-9a49-1745ae836469",
                                        "glosses": [
                                            "A wandering on foot; an idle and leisurely walk; a ramble; a saunter."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cfb3832f-f14e-36fd-af53-230cb1dd4727",
                                        "entry_id": "47cd2028-92ae-3a86-9a49-1745ae836469",
                                        "glosses": [
                                            "A dance of the 1950s in which dancers leisurely stepped, cross-stepped, and dipped at the knee to the beat of the music."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "stroll",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a89d09d7-ecdf-3602-b674-dc09ab8b5473",
                                        "entry_id": "57418d12-5cd8-37c7-bd4f-dbd6dcc63e2a",
                                        "glosses": [
                                            "To wander on foot; to ramble idly or leisurely; to rove."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5eb7e8-ca83-4724-b947-737433a9fb45",
                                                "sense_id": "a89d09d7-ecdf-3602-b674-dc09ab8b5473",
                                                "text": "In Ancient Times, as Story tells, / The Saints would often leave their Cells, / And ſtrole about, but hide their Quality, / To try good Peoples Hoſpitality."
                                            },
                                            {
                                                "example_id": "51d15b08-4b98-4edc-b4d0-0f43c0998cdc",
                                                "sense_id": "a89d09d7-ecdf-3602-b674-dc09ab8b5473",
                                                "text": "The turmoil went on—no rest, no peace. [...] It was nearly eleven o'clock now, and he strolled out again. In the little fair created by the costers' barrows the evening only seemed beginning; and the naphtha flares made one's eyes ache, the men's voices grated harshly, and the girls' faces saddened one."
                                            },
                                            {
                                                "example_id": "d84f9a38-35a7-4642-96c6-513cfc59e322",
                                                "sense_id": "a89d09d7-ecdf-3602-b674-dc09ab8b5473",
                                                "text": "Look around you, all you see are sympathetic eyes\nStroll around the grounds until you feel at home"
                                            },
                                            {
                                                "example_id": "538a04a5-2429-4dd5-9019-4eb12ab94ae9",
                                                "sense_id": "a89d09d7-ecdf-3602-b674-dc09ab8b5473",
                                                "text": "More often than not, the best restaurants are found by strolling rather than scrolling."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c47308bb-21b0-3978-8edf-cf81a0d3a907",
                                        "entry_id": "57418d12-5cd8-37c7-bd4f-dbd6dcc63e2a",
                                        "glosses": [
                                            "To go somewhere with ease."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1d629e16-a9b4-47fb-a89b-458875f0bc19",
                                                "sense_id": "c47308bb-21b0-3978-8edf-cf81a0d3a907",
                                                "text": "[A] delighted shout from the children swung him toward the door again. His sister, Mrs. Gerard, stood there in carriage gown and sables, radiant with surprise. \"Phil! You! Exactly like you, Philip, to come strolling in from the antipodes—dear fellow!\" recovering from the fraternal embrace and holding both lapels of his coat in her gloved hands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b2c372b-f585-359b-899f-7985fccbb17b",
                                        "entry_id": "57418d12-5cd8-37c7-bd4f-dbd6dcc63e2a",
                                        "glosses": [
                                            "To walk the streets as a prostitute."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04fc5412-c500-4144-9faf-90520167428b",
                                                "sense_id": "1b2c372b-f585-359b-899f-7985fccbb17b",
                                                "text": "\"Nammers?\" She'd told him before of some Vietnamese gang pressuring her to stroll for them. / \"Don't even ask. You don't want to know.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf4d2106-37d1-3d1f-babb-e670e21dc391",
                                        "entry_id": "57418d12-5cd8-37c7-bd4f-dbd6dcc63e2a",
                                        "glosses": [
                                            "To do, obtain, or achieve something in a casual and effortless way."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f130d55f-2da7-46ee-aeb8-8c0c097351e5",
                                                "sense_id": "bf4d2106-37d1-3d1f-babb-e670e21dc391",
                                                "text": "My daughter strolled through the exam."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fcd93e85-ae17-4140-96bf-37d2068775f4",
                        "source_entry_id": "52e33c15-2500-3832-8ede-3661ecefab57",
                        "target_lang_word": "promenade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promenade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aebb61a3-b014-3257-8ee9-e2aa596ac373",
                                        "entry_id": "4fbc3589-6411-3b4c-9f8a-dafd3f18e266",
                                        "glosses": [
                                            "A prom (dance)."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0751fc8-27be-32d6-bd94-1bc3276067bb",
                                        "entry_id": "4fbc3589-6411-3b4c-9f8a-dafd3f18e266",
                                        "glosses": [
                                            "A walk taken for pleasure, display, or exercise; a stroll."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b0f5bac-f720-4416-8217-8f7af82bb133",
                                                "sense_id": "d0751fc8-27be-32d6-bd94-1bc3276067bb",
                                                "text": "they told him to think no more of the matter , and to try his fortune in another promenade"
                                            },
                                            {
                                                "example_id": "72fd72ed-a962-4480-9aee-0cb93641169a",
                                                "sense_id": "d0751fc8-27be-32d6-bd94-1bc3276067bb",
                                                "text": "His morning promenade."
                                            },
                                            {
                                                "example_id": "6516fb0a-e835-42bc-b1e8-58f8cab7d2c2",
                                                "sense_id": "d0751fc8-27be-32d6-bd94-1bc3276067bb",
                                                "text": "Down in the arena, though, it was business as semi-normal with the band members making their traditional promenade through the crowd to a small in-the-round stage with a colourful player piano taking up most of the room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa574feb-7d20-37b7-b97b-27a5852d465d",
                                        "entry_id": "4fbc3589-6411-3b4c-9f8a-dafd3f18e266",
                                        "glosses": [
                                            "A place where one takes a walk for leisurely pleasure, or for exercise, especially a terrace by the seaside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9299ac39-1f0a-4488-9a8a-8176977acdf9",
                                                "sense_id": "aa574feb-7d20-37b7-b97b-27a5852d465d",
                                                "text": "The present dream in particular scarcely left any room for doubt, since the place where my patient fell was the Graben, a part of Vienna notorious as a promenade for prostitutes."
                                            },
                                            {
                                                "example_id": "84d258eb-d275-44eb-98e1-fc946c07921a",
                                                "sense_id": "aa574feb-7d20-37b7-b97b-27a5852d465d",
                                                "text": "By one o'clock the place was choc-a-bloc. […] The restaurant was packed, and the promenade between the two main courts and the subsidiary courts was thronged with healthy-looking youngish people, drawn to the Mecca of tennis from all parts of the country."
                                            },
                                            {
                                                "example_id": "3730029a-e4a0-45d4-a637-3183efac4913",
                                                "sense_id": "aa574feb-7d20-37b7-b97b-27a5852d465d",
                                                "text": "Haussmann’s remodelling brought about the boulevards, the building lots, the promenades and street planting that remain inimitably characteristic of Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98b8d289-1e86-37b3-8a6f-6dd7c3711921",
                                        "entry_id": "4fbc3589-6411-3b4c-9f8a-dafd3f18e266",
                                        "glosses": [
                                            "A dance motion consisting of a walk, done while square dancing."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "promenade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ca92d97-64e7-3374-bf27-686b9c502b92",
                                        "entry_id": "06a3b8c0-ef87-3db8-bf0f-54214d3de770",
                                        "glosses": [
                                            "To walk for amusement, show, or exercise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8784629-4c57-476f-8e77-a0df6dcab6ab",
                                                "sense_id": "0ca92d97-64e7-3374-bf27-686b9c502b92",
                                                "text": "\"The times are changed,\" said De Joinville, in a low tone to Francesca, \"since Mademoiselle promenaded the terraces of the Louvre, with her fan ornamented with bunches of straw tied with blue riband, and half Paris shouting at the sight.\""
                                            },
                                            {
                                                "example_id": "6e93cd4b-aafc-4493-9fff-a7068b175823",
                                                "sense_id": "0ca92d97-64e7-3374-bf27-686b9c502b92",
                                                "text": "“It is time again for Staten Island's annual puppy parade.” “Which is always a barking good time. Here's hoping we have some nice weather for these promenading pooches.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "33d904cd-9cf6-3744-8388-6c163a0fdf2e",
                                        "entry_id": "06a3b8c0-ef87-3db8-bf0f-54214d3de770",
                                        "glosses": [
                                            "To perform the stylized walk of a square dance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ab8e1981-defa-4d66-b963-3864a4d70db9",
