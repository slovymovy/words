                "entry_id": "28e8a840-c3d4-36bc-b3f7-4b213fb361a6",
                "word": "KKP",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a147c7b9-341f-3085-a29e-63a7fee8a66e",
                        "entry_id": "28e8a840-c3d4-36bc-b3f7-4b213fb361a6",
                        "glosses": [
                            "Kaufkraftparität"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e19fe0cc-a3e0-4dd3-b4bc-e5e632968167",
                                "sense_id": "a147c7b9-341f-3085-a29e-63a7fee8a66e",
                                "text": "Das Wachstum in den Schwellenländern, die nach KKP rund 45 Prozent des Welt-Bruttoinlandsprodukt (rund 37 Prozent in Dollar gemessen) ausmachen, sollten um 4,5 Prozent wachsen, die Industrieländer um rund 1,5 Prozent."
                            },
                            {
                                "example_id": "e1e8add9-a362-4796-b8a7-aaf7f1263022",
                                "sense_id": "a147c7b9-341f-3085-a29e-63a7fee8a66e",
                                "text": "Im Jahr 1990 nahm die Schweiz zum ersten Mal an den KKP-Untersuchungen der OECD teil."
                            },
                            {
                                "example_id": "e54e69d5-ba17-498c-8ae3-7e94e5fd9f14",
                                "sense_id": "a147c7b9-341f-3085-a29e-63a7fee8a66e",
                                "text": "Zunächst werden zwischen den Ländern Kaufkraftparitäten (KKP) ermittelt, die die internationalen Preis-Relationen für einen fixierten Warenkorb widerspiegeln."
                            },
                            {
                                "example_id": "287fd814-5a2c-4bfe-a3ff-c275ea05e405",
                                "sense_id": "a147c7b9-341f-3085-a29e-63a7fee8a66e",
                                "text": "Diese KKP werden dann der Umrechnung vergleichbarer Daten des BIP und seiner Komponenten zugrundegelegt."
                            },
                            {
                                "example_id": "e4c911ce-5eda-4f17-b145-0e472f266848",
                                "sense_id": "a147c7b9-341f-3085-a29e-63a7fee8a66e",
                                "text": "Schließlich treten die KKP an die Stelle der offiziellen Wechselkurse, die von vielen externen Faktoren beeinflußt werden und daher für diese Vergleichszwecke wenig geeignet wären."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
