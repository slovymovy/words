                        "tags": [],
                        "examples": [
                            {
                                "example_id": "223aab56-8586-4a23-87a5-c88ba9b72bad",
                                "sense_id": "1b9624e4-452b-3123-98ee-455fe1452faf",
                                "text": "Brandaanslagen waren er ook in Sauerland en in de plaats Itzehoe ten noorden van Hamburg. In Sauerland werden drie molotovcocktails naar een huis gegooid en in Itzehoe werd een raam van een moskee ingeslagen en brandgesticht bij een Turkse groentezaak. Een voorbijganger waarschuwde de bewoners in het pand boven de winkel dat er brand was. De politie heeft nog geen arrestaties verricht."
                            },
                            {
                                "example_id": "2bd48b48-49c5-413a-934a-4fc8191421d1",
                                "sense_id": "1b9624e4-452b-3123-98ee-455fe1452faf",
                                "text": "De twee prinsessen kwamen met een paar klasgenootjes uit school toen ze langs de groentezaak liepen en wat meenamen, staat in een ongedateerde brief die wordt aangehaald in het boek."
                            }
                        ]
                    }
