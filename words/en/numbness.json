{
    "word_family": [
        "numb",
        "numbly"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "876381cb-4132-3390-b7e3-b970e8ec4312",
                    "sense_definition": "A lack of physical feeling or sensation in a part of the body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cold weather caused a temporary <w>numbness</w> in my fingers.",
                            "target_lang_translations": {
                                "ru": "Из-за холодной погоды у меня появилось временное <w>онемение</w> пальцев."
                            }
                        },
                        {
                            "text": "She reported a sudden <w>numbness</w> in her leg after sitting for too long.",
                            "target_lang_translations": {
                                "ru": "Она пожаловалась на внезапное <w>онемение</w> в ноге после того, как долго просидела."
                            }
                        }
                    ],
                    "synonyms": [
                        "hypoesthesia"
                    ],
                    "common_phrases": [
                        "temporary numbness",
                        "sudden numbness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отсутствие физической чувствительности или осязания в какой-либо части тела."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "онемение",
                                "target_lang_sense_clarification": "общее состояние потери чувствительности"
                            },
                            {
                                "target_lang_word": "оцепенение",
                                "target_lang_sense_clarification": "состояние потери подвижности и чувствительности"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ca707b03-a476-39b1-ab33-563cb91abca8",
                    "sense_definition": "A state of being unable to feel or express emotions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotional_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt a strange <w>numbness</w> after hearing the tragic news.",
                            "target_lang_translations": {
                                "ru": "Он почувствовал странное <w>оцепенение</w> после того, как услышал трагические новости."
                            }
                        },
                        {
                            "text": "The deep <w>numbness</w> in her heart made it difficult to talk about her grief.",
                            "target_lang_translations": {
                                "ru": "Глубокое <w>оцепенение</w> в её сердце мешало ей говорить о своём горе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "emotional numbness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние неспособности чувствовать или выражать эмоции."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оцепенение",
                                "target_lang_sense_clarification": "психологическое состояние ступора или нечувствительности"
                            },
                            {
                                "target_lang_word": "бесчувственность",
                                "target_lang_sense_clarification": "отсутствие эмоционального отклика"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}