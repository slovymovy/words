                "senses": [
                    {
                        "sense_id": "fd104ec7-9ed9-36f6-ac0d-31138b088e38",
                        "entry_id": "296eacd1-8d6c-3d8c-8393-0e5d717c4620",
                        "glosses": [
                            "durch äußere Einflüsse ausgelöstes, schwer bis gar nicht kontrollierbares Würgen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90898ff0-8849-47ce-8c6a-8ade6cdfe0d0",
                                "sense_id": "fd104ec7-9ed9-36f6-ac0d-31138b088e38",
                                "text": "„Er unterdrückte mühsam den Würgereflex und presste mit einer Hand seine Schutzmaske fester an.“"
                            },
                            {
                                "example_id": "3bb5bb90-3e61-4adf-bddb-7ddd87ee53c3",
                                "sense_id": "fd104ec7-9ed9-36f6-ac0d-31138b088e38",
                                "text": "„›Sie wollen wissen, wie eng wir sind und ob wir unseren Würgereflex unterdrücken können. Das sind alles Audrücke aus dem Bordellgeschäft auf dem Floß.‹“"
                            },
                            {
                                "example_id": "02580eef-d650-4a8d-a4d6-2a08118ca639",
                                "sense_id": "fd104ec7-9ed9-36f6-ac0d-31138b088e38",
                                "text": "„Der widerlich süße Geruch überwältigte ihn beinahe, so dass er schlucken musste, um den Würgereflex zu unterdrücken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
