                        "glosses": [
                            "Feeling wrath; very angry, furious."
                        ],
                        "tags": [
                            "US"
                        ],
                        "examples": [
                            {
                                "example_id": "1b442154-2d6a-4f51-bc50-08faec38190a",
                                "sense_id": "b007b7fb-ef1e-314b-8bc5-1d10b49d693e",
                                "text": "When I got there, the old lady appeared to be mighty wrathy; and when I broached the subject, she looked at me as savage as a meat axe."
                            },
                            {
                                "example_id": "0a463407-074e-4a5b-97fc-17415020faf5",
                                "sense_id": "b007b7fb-ef1e-314b-8bc5-1d10b49d693e",
                                "text": "Sometimes the wrathy owner of the missing horses undertook to recover them himself."
                            },
                            {
                                "example_id": "1fc35c1c-b9f4-45d0-be05-8f201c428c00",
                                "sense_id": "b007b7fb-ef1e-314b-8bc5-1d10b49d693e",
                                "text": "There is a sin that is my favorite. It's one I indulge in several times a day. I kinda like — I really kinda like — wrath. And I am feeling wrathy today."
                            }
                        ]
                    }
