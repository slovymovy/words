                "senses": [
                    {
                        "sense_id": "57707582-0d37-3d99-a8bf-d470f4fac99b",
                        "entry_id": "a7a11121-fa94-321a-9258-92c2707642fe",
                        "glosses": [
                            "Endroit pour le dépôt sélectif des déchets encombrants ou susceptibles d'être recyclés."
                        ],
                        "tags": [
                            "Belgique"
                        ],
                        "examples": [
                            {
                                "example_id": "80545e04-f398-49ef-a67c-e18a4b006082",
                                "sense_id": "57707582-0d37-3d99-a8bf-d470f4fac99b",
                                "text": "On disait « Parc à conteneurs ». On le dit toujours dans d’autres coins de Wallonie. Mais à Liège, l’intercommunale de gestion des déchets Intradel a décidé de les appeler « Recyparcs », pour « marquer les esprits sur le fait qu’ils ne sont pas des dépotoirs publics, mais représentent un maillon essentiel de la chaîne de recyclage », explique Roger Croughs, directeur d’Intradel."
                            },
                            {
                                "example_id": "3f367b82-f516-4dcc-ba1c-7f13ec4b0846",
                                "sense_id": "57707582-0d37-3d99-a8bf-d470f4fac99b",
                                "text": "Dans les circonstances actuelles de déconfinement progressif, les recyparcs adaptent leurs modalités d'accueil."
                            }
                        ]
                    }
