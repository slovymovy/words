                            {
                                "target_lang_word": "возбуждённый",
                                "target_lang_sense_clarification": "взволнованный, находящийся в сильном возбуждении"
                            },
                            {
                                "target_lang_word": "пылкий",
                                "target_lang_sense_clarification": "страстный, эмоциональный"
                            }
                        ]
                    }
                }
            ]
        },
        {
