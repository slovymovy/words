                "senses": [
                    {
                        "sense_id": "89954c76-06f4-3a37-9bc7-c5511e00b694",
                        "entry_id": "038d24d9-8518-302e-884c-dd1af98c2cc4",
                        "glosses": [
                            "Éradiquer les chats d’un lieu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c2cd0b0-fdff-4fa6-8354-6c18c54d40d3",
                                "sense_id": "89954c76-06f4-3a37-9bc7-c5511e00b694",
                                "text": "Du 3 au 16 mai, Chenil-Service va donc « déchatiser » le lycée."
                            },
                            {
                                "example_id": "4addcb2c-ddf9-4c51-9c66-dd0588d8645d",
                                "sense_id": "89954c76-06f4-3a37-9bc7-c5511e00b694",
                                "text": "Madame, vous envisagez de faire déchatiser un quartier de votre commune."
                            },
                            {
                                "example_id": "b9421e3b-22ed-4ebb-acc0-1fe811505ada",
                                "sense_id": "89954c76-06f4-3a37-9bc7-c5511e00b694",
                                "text": "Suite à des plaintes, ils vont faire déchatiser ma ville."
                            }
                        ]
                    },
                    {
                        "sense_id": "d65ac057-3b9b-3946-a87b-e11a828ea53d",
                        "entry_id": "038d24d9-8518-302e-884c-dd1af98c2cc4",
                        "glosses": [
                            "Perdre son caractère de chat."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "5f086a10-9375-4f55-9bae-2e098c767ef6",
                                "sense_id": "d65ac057-3b9b-3946-a87b-e11a828ea53d",
                                "text": "Eh bien, on est généralement d’accord, en psychologie, pour dire que l’homme en question améliore sa situation (s’humanise, si l’on veut, ou se déchatise) lorsqu’il (re-)prend conscience de soi."
                            }
                        ]
                    }
