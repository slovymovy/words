            {
                "entry_id": "f7168efd-7ae7-3255-8308-c6fc3d248c30",
                "word": "Mirza",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "6d7271fd-9810-33b1-a4e8-9893f8a9a674",
                        "entry_id": "f7168efd-7ae7-3255-8308-c6fc3d248c30",
                        "glosses": [
                            "Nom de chienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79a9209c-144e-4f94-b65e-1d6a7f4b1fc3",
                                "sense_id": "6d7271fd-9810-33b1-a4e8-9893f8a9a674",
                                "text": "Juste sur son chemin, au milieu de la cour, un tas d'enfants, ceux de la maison et ceux des voisins, attroupés autour de la loge de la chienne Mirza, contemplaient curieusement quelque chose, avec une attention concentrée et muette."
                            },
                            {
                                "example_id": "94cf12ee-9922-4982-9d39-e70db5af82f4",
                                "sense_id": "6d7271fd-9810-33b1-a4e8-9893f8a9a674",
                                "text": "Z’avez pas vu Mirza ?\nOh la la la la la\" — (extrait du refrain de la chanson « Mirza », du chanteur Nino Ferrer, 1965)"
                            },
                            {
                                "example_id": "8ba75e1f-a7df-48d8-ac54-2e4e0eac9c43",
                                "sense_id": "6d7271fd-9810-33b1-a4e8-9893f8a9a674",
                                "text": "AIEAIEAIE! Et Mirza qui est dehors! Avec grand-père…"
                            }
                        ]
                    },
                    {
                        "sense_id": "09ab6804-9746-34c3-9f9f-a01dbab901e9",
                        "entry_id": "f7168efd-7ae7-3255-8308-c6fc3d248c30",
                        "glosses": [
                            "Surnom de la toison pubienne ; → voir chatte."
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "4ea18e52-3b5f-4692-991b-d9d26fde68d6",
                                "sense_id": "09ab6804-9746-34c3-9f9f-a01dbab901e9",
                                "text": "10 août 1940 – Flora est entrée en clinique hier. On lui a rasé Mirza."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "cab2f1a5-22d6-3469-b274-438d5f7fc20b",
                "word": "mirza",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b26c266c-1ebb-4d16-9c4d-fe27a65aed1c",
                        "entry_id": "cab2f1a5-22d6-3469-b274-438d5f7fc20b",
                        "tags": [
                            "plural"
                        ],
                        "form": "mirzas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8cd53848-9a0e-3239-872a-5f4ff1885c31",
                        "entry_id": "cab2f1a5-22d6-3469-b274-438d5f7fc20b",
                        "glosses": [
                            "Noble, personnage, monsieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89efbf10-092e-410f-b3d1-d60c6680e740",
                                "sense_id": "8cd53848-9a0e-3239-872a-5f4ff1885c31",
                                "text": "Il était fils unique d’un mirza du pays ; c’est comme qui dirait marquis parmi nous, ou baron chez les Allemands."
                            }
                        ]
                    },
                    {
                        "sense_id": "0d2a038b-0101-3d49-8f9d-3ce5419b0395",
                        "entry_id": "cab2f1a5-22d6-3469-b274-438d5f7fc20b",
                        "glosses": [
                            "Pendentif d’oreilles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b073a515-9f63-458e-96ad-8f2072827edc",
                                "sense_id": "0d2a038b-0101-3d49-8f9d-3ce5419b0395",
                                "text": "Elle met à son oreille des mirzas d’émeraudes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d72f90f5-25f2-4fb1-8575-4b55d04ff1f4",
                        "source_entry_id": "cab2f1a5-22d6-3469-b274-438d5f7fc20b",
                        "target_lang_word": "mirza",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mirza",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5efb4913-20f2-3b70-9f29-acb44d3a026b",
                                        "entry_id": "cb794b20-c5f9-334f-8ac3-47ea8b2d8cfc",
                                        "glosses": [
                                            "An educated man in India or Iran (Persia); an official, a clerk."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "581be9cb-d069-4cf6-ad02-c43598a372e4",
                                                "sense_id": "5efb4913-20f2-3b70-9f29-acb44d3a026b",
                                                "text": "The same success attended the other mirzas and emirs in their excursions."
                                            },
                                            {
                                                "example_id": "f42363c2-594f-41fb-9167-9dc4a01dab70",
                                                "sense_id": "5efb4913-20f2-3b70-9f29-acb44d3a026b",
                                                "text": "This he presented to the Khan of Puhra, who called upon his mirza, or clerk, to read it aloud."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "88cf69de-3314-4b8c-88bc-07a5dbdb2a38",
                        "source_entry_id": "cab2f1a5-22d6-3469-b274-438d5f7fc20b",
                        "target_lang_word": "mirza",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
