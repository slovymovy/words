                                        "entry_id": "5435442b-3836-38b5-8cb0-94dedfd7502c",
                                        "glosses": [
                                            "A unit of force equal to the weight, on earth (subject to standard gravity at 9.80665 m/s²), of a mass of one kilogram; equal to 9.80665 newtons. Symbol kgf or kg_f."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25957b26-c51a-467a-90d4-ae83f08202ef",
                                                "sense_id": "23f5c261-c293-3636-a07c-1c910a5e638c",
                                                "text": "A mass of one hyl gets accelerated at a rate of one meter per square second by a force of one kilogram-force (namely, 9.80665 N)."
                                            }
                                        ]
                                    }
                                ]
                            }
