                                    {
                                        "sense_id": "c8d1a4c2-65bc-3c85-aae9-ada0cba65be6",
                                        "entry_id": "25d9889e-ba68-3b2b-b971-37d682b6a946",
                                        "glosses": [
                                            "mit Liebe erfüllt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "029590e6-7c1b-4fa6-a951-2ed34ead56de",
                                                "sense_id": "c8d1a4c2-65bc-3c85-aae9-ada0cba65be6",
                                                "text": "„Ja, ich fiel ihr zu Füßen, umschlang liebend ihre Knie und küßte sie ihr voll Zärtlichkeit und Dankbarkeit.“"
                                            },
                                            {
                                                "example_id": "dfc3ba74-11da-43c6-a6f6-53ba2a4997c2",
                                                "sense_id": "c8d1a4c2-65bc-3c85-aae9-ada0cba65be6",
                                                "text": "„Dein Dich innig liebender Gerrit“"
                                            },
                                            {
                                                "example_id": "92811aa8-6fa3-411f-9b08-98934b84db9d",
                                                "sense_id": "c8d1a4c2-65bc-3c85-aae9-ada0cba65be6",
                                                "text": "„Aber ich werde meine junge Frau glücklich machen – denn meine Frau ist ein Engel – und ich habe ein liebendes Herz ... ja, ich schwöre, ich habe ein liebendes Herz – und wer da behaupten wollte, daß hier unter meiner Weste kein liebendes Herz schlägt, dem möchte ich meine Brust aufreißen –«“"
                                            },
                                            {
                                                "example_id": "97f31d80-9eba-45b9-b643-fe3e9ea88e82",
                                                "sense_id": "c8d1a4c2-65bc-3c85-aae9-ada0cba65be6",
                                                "text": "„Editha wird ohne Zweifel mein getreues, liebendes Weib, das jede Ungebühr gegen den Gatten schmerzlich empfindet.“"
                                            },
                                            {
                                                "example_id": "ec950798-2137-43f3-87a7-e78a6a1333fb",
                                                "sense_id": "c8d1a4c2-65bc-3c85-aae9-ada0cba65be6",
                                                "text": "„Ich weiß nicht warum. Ein liebendes Frauenherz handelt eben nicht nach Gründen und Gesetzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
