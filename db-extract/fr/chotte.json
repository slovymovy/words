                "senses": [
                    {
                        "sense_id": "c938f759-476a-335c-8bda-8a76007c2bb0",
                        "entry_id": "198cda6a-7821-3835-85e2-694d0c14308a",
                        "glosses": [
                            "Endroit où l’on se met à l’abri en cas de fortes pluies ou de neige."
                        ],
                        "tags": [
                            "Suisse romande"
                        ],
                        "examples": [
                            {
                                "example_id": "38c1b7ed-c0df-4c91-b900-6a5c25c1d55d",
                                "sense_id": "c938f759-476a-335c-8bda-8a76007c2bb0",
                                "text": "Il n’est point pressé de conquérir les sommets. Si le temps menace, il n’attend pas l’averse, il redescend à l’auberge où il se met à la chotte."
                            },
                            {
                                "example_id": "dae3947e-c9d7-4637-92cf-8969f4e450cd",
                                "sense_id": "c938f759-476a-335c-8bda-8a76007c2bb0",
                                "text": "Quant à être à la chotte, c’est être à l’abri d’un couvert."
                            }
                        ]
                    },
                    {
                        "sense_id": "95c71484-d7e8-379f-a0ba-139dc28c4382",
                        "entry_id": "198cda6a-7821-3835-85e2-694d0c14308a",
                        "glosses": [
                            "Dans le Jura, sapin isolé au milieu d'une prairie."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1f626f5c-0b40-4b55-8c00-b4bbb22ae7ad",
                                "sense_id": "95c71484-d7e8-379f-a0ba-139dc28c4382",
                                "text": "Dans un pâturage, le sapin solitaire est appelé une chotte. En cas de pluie, il sert d’abri aux gens qui passent à proximité, ou au bétail."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d30c3db-5f70-37c6-9581-3d713e222f19",
                        "entry_id": "198cda6a-7821-3835-85e2-694d0c14308a",
                        "glosses": [
                            "Abri d’alpage, chalet assez rudimentaire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "8653b6ce-306d-4da9-8205-934ee42e325d",
                                "sense_id": "3d30c3db-5f70-37c6-9581-3d713e222f19",
                                "text": "Ce soir ce serait la fête au chalet. Jusque tard dans la nuit, les chants animeraient la vieille chotte."
                            }
                        ]
                    }
                ],
