                        "cross_references": [
                            {
                                "target_word": "hot wash",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a0ac3e97-b37b-395e-a2a6-ee62d97d5149",
                                        "entry_id": "20dd9d0a-ea65-30a8-ab62-eff44f73f912",
                                        "glosses": [
                                            "Alternative form of hotwash."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0979288-242b-446f-a90b-132d79ff073a",
                                                "sense_id": "a0ac3e97-b37b-395e-a2a6-ee62d97d5149",
                                                "text": "Everyone is accustomed to taking time to do a \"hot wash,\" which happens during the action, or a \"cold wash,\" which is done immediately after the action is completed."
                                            },
                                            {
                                                "example_id": "092c2878-996c-44fc-aa89-57cca8bcb5a4",
                                                "sense_id": "a0ac3e97-b37b-395e-a2a6-ee62d97d5149",
                                                "text": "A debrief (for facilitators or controllers/evaluators) and/or hot wash (for players) should occur following both discussion- and operations-based exercises."
                                            },
                                            {
                                                "example_id": "bcbb3433-fb6c-434b-a54b-5f7320ada9f1",
                                                "sense_id": "a0ac3e97-b37b-395e-a2a6-ee62d97d5149",
                                                "text": "In the “hot wash” meeting after the exercise the participants agreed that cellular phones would be excluded from all future exercises and actual responses to prevent this limitation of information (Edwards and Goodrich, 2006)."
                                            },
                                            {
                                                "example_id": "d8835497-5391-422a-bfe9-3d19c2883210",
                                                "sense_id": "a0ac3e97-b37b-395e-a2a6-ee62d97d5149",
                                                "text": "Key postevent activities include debriefing, hot wash, and evaluation (USDHS, 2013)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d639087b-5513-377d-b3fe-66140e38535f",
                                        "entry_id": "20dd9d0a-ea65-30a8-ab62-eff44f73f912",
                                        "glosses": [
                                            "The act of washing laundry in hot water, or the setting on a washing machine for such a wash."
                                        ],
