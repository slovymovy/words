                ],
                "senses": [
                    {
                        "sense_id": "63224cdd-34da-3cee-b847-497f3465ffc8",
                        "entry_id": "985fff54-5942-30d3-abec-f3ba512a823d",
                        "glosses": [
                            "begeisterter Läufer; Person, die mit großer Begeisterung regelmäßig/oft läuft"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "7b97933e-2f93-4a5e-87ff-428bcab985c6",
                                "sense_id": "63224cdd-34da-3cee-b847-497f3465ffc8",
                                "text": "„Nun warten die Laufenthusiasten wie auch die Organisatoren mit den rund 250 ehrenamtlichen Helferinnen und Helfer nur noch auf den Startschuss am kommenden Sonntagnachmittag !“"
                            },
                            {
                                "example_id": "bb38adb4-9148-4679-bc5d-07e376caae64",
                                "sense_id": "63224cdd-34da-3cee-b847-497f3465ffc8",
                                "text": "„Über 40.000 Laufenthusiasten wollen an Israels größtem Sportereignis des Jahres teilnehmen.“"
                            },
                            {
                                "example_id": "4059cde3-91d4-41fe-b41d-a7b25c57f9d7",
                                "sense_id": "63224cdd-34da-3cee-b847-497f3465ffc8",
                                "text": "„Mit zehn beschilderten Strecken zwischen 4,9 und 16,1 Kilometern bietet der Laufpark Holzkirchen ein attraktives Angebot für Laufenthusiasten und Freizeitsportler.“"
                            },
                            {
                                "example_id": "d6d5dad6-1fa1-4abe-8fc9-22ff1f569184",
                                "sense_id": "63224cdd-34da-3cee-b847-497f3465ffc8",
                                "text": "„Es war ein kleiner Schockmoment für die Perleberger Laufenthusiasten, als die langjährige Laufleiterin Steffi Diete im Dezember bekanntgab, dass sie die Aufgabe abgeben will – ganz kurz stand der Lauf für 2023 auf der Kippe.“"
                            },
                            {
                                "example_id": "0a751970-4244-4e26-83dc-17b38c3f5176",
                                "sense_id": "63224cdd-34da-3cee-b847-497f3465ffc8",
                                "text": "„Bei Kärnten Läuft steht nicht nur der sportliche Wettkampf im Vordergrund, vielmehr wird dem nationalen und internationalen Laufenthusiasten und Bewegungsinteressierten drei Tage lang ein buntes und lockeres Rundum-Programm in der erlebnisorientierten Running City, der Veranstaltungslocation, geboten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
