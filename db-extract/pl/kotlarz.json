                                            {
                                                "example_id": "cb900e4a-0215-4b10-8a88-9b2b49baca61",
                                                "sense_id": "e453a0f7-96f7-3a50-bd09-a4b263bab0af",
                                                "text": "Eastleigh Locomotive Works: Layout and functions of shops [...] Coppersmiths: Preparation of boiler tubes and copper pipework."
                                            }
                                        ]
