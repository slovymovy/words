                    {
                        "sense_id": "0ce88ba0-93f6-3ee0-898a-c37638fb9774",
                        "entry_id": "93bd4d32-e1d9-3cd1-a89b-ff3d9be751ef",
                        "glosses": [
                            "een beschieting of bombardement waarbij een gebied volledig bedekt wordt met bominslagen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a02b8441-22c5-4263-8e96-26455964a71e",
                                "sense_id": "0ce88ba0-93f6-3ee0-898a-c37638fb9774",
                                "text": "Hij legt uit wat napalm is en iets wat een bommentapijt heet en dit klinkt allemaal heel anders dan in de verhalen die ik eerder over oorlog heb gehoord."
                            },
                            {
                                "example_id": "e8d922ae-c0c7-4a39-a876-adbe1a37470e",
                                "sense_id": "0ce88ba0-93f6-3ee0-898a-c37638fb9774",
                                "text": "“Dat was een wonderlijk moment. Een herfstdag met een stevige wind. Ik liep rond, was op zoek om te zien wat ik zou fotograferen. Op gegeven moment vielen de eikels als een bommentapijt naar beneden, iedere seconde viel er wel een. Het was mooi om te zien hoe ze in het water vielen en die kringen maakten. Toen heb ik twee uur non-stop als een sportfotograaf vallende eikels gefotografeerd, totdat ik dacht: ‘nu heb ik hem'.\""
                            }
                        ]
                    }
