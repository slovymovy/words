                                "target_senses": [
                                    {
                                        "sense_id": "f0ca2de6-edbc-3495-ad22-f6d8f6d584a5",
                                        "entry_id": "43bbf042-7807-3672-a80b-3eeb3a14a00a",
                                        "glosses": [
                                            "Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e86f926-08da-452f-80f5-2b3ac85d50af",
                                                "sense_id": "f0ca2de6-edbc-3495-ad22-f6d8f6d584a5",
                                                "text": "Die Wolfram hat schon wieder die Musik so laut."
                                            },
                                            {
                                                "example_id": "02fbd134-2715-489f-9749-2587ae954840",
                                                "sense_id": "f0ca2de6-edbc-3495-ad22-f6d8f6d584a5",
                                                "text": "Mit den Wolframs sollte man sich nicht anlegen."
                                            }
                                        ],
