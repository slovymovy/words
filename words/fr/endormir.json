            "senses": [
                {
                    "sense_id": "fe1f6661-4f29-33ee-8911-b099523af15d",
                    "sense_definition": "Commencer à dormir, sombrer dans le sommeil.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Fatigué après cette longue journée d'école, l'enfant s'<w>endort</w> très vite dans son lit."
                        },
                        {
                            "text": "Elle lit quelques pages chaque soir avant de s'<w>endormir</w> profondément."
                        }
                    ],
                    "synonyms": [
                        "s'assoupir"
                    ],
                    "antonyms": [
                        "se réveiller"
                    ],
                    "common_phrases": [
                        "s'endormir profondément",
                        "s'endormir comme un bébé"
                    ]
                },
                {
                    "sense_id": "97c34612-4f68-365e-92a8-42f127ec9001",
                    "sense_definition": "Faire entrer quelqu'un dans le sommeil en le berçant ou en lui racontant une histoire.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le père chante une douce berceuse pour <w>endormir</w> son bébé le soir."
                        },
                        {
                            "text": "Cette musique calme aide les parents à <w>endormir</w> un enfant agité."
                        }
                    ],
                    "synonyms": [
                        "bercer"
                    ],
                    "antonyms": [
                        "réveiller"
                    ],
                    "common_phrases": [
                        "endormir un enfant",
                        "endormir le bébé"
                    ]
                },
                {
                    "sense_id": "95240246-0b52-3d72-b6eb-53af862b5238",
                    "sense_definition": "Ennuyer ou lasser quelqu'un au point de provoquer l'envie de dormir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ennui",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce discours monotone risque d'<w>endormir</w> son auditoire avant la fin de la séance."
                        },
                        {
                            "text": "Le film était si lent et ennuyeux qu'il m'<w>endormait</w> complètement."
