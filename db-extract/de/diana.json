                    {
                        "translation_id": "11f899e8-77b0-4059-b349-35cbc2823892",
                        "source_entry_id": "4b5f54d4-0ed5-37d8-bba5-975c19834da4",
                        "source_sense_id": "dfbc6f89-084e-3b27-841c-ab3f3be98641",
