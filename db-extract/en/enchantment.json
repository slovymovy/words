                    {
                        "translation_id": "62bf21fd-3b8c-4606-8211-571ebe8ad26c",
                        "source_entry_id": "acd0bd21-86ba-3561-a9d8-661529144192",
                        "source_sense_description": "something that enchants",
                        "target_lang_word": "Zauber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zauber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9adf410-13a0-3dc3-ad98-f3df0987051c",
                                        "entry_id": "55657284-855f-3271-bfa3-806b1d230cf1",
                                        "glosses": [
                                            "übernatürliche Wirkung, magische Manipulation, die nicht den Naturgesetzen unterliegt; unerklärlicher Vorgang"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39cd04ff-8e10-4818-a977-40d37d3a8080",
                                                "sense_id": "e9adf410-13a0-3dc3-ad98-f3df0987051c",
                                                "text": "Es kam uns vor wie ein Zauber."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "e83f4ce8-fadc-38cf-8662-e4d9eb3ee601",
                                        "entry_id": "55657284-855f-3271-bfa3-806b1d230cf1",
                                        "glosses": [
                                            "Reiz, Faszination"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60f2b2d4-8181-46ae-88b7-b63b95395d9f",
                                                "sense_id": "e83f4ce8-fadc-38cf-8662-e4d9eb3ee601",
                                                "text": "Weihnachten hat für uns seinen Zauber noch nicht verloren."
                                            },
                                            {
                                                "example_id": "107bb66a-acf8-4d31-a9aa-0471a652435a",
                                                "sense_id": "e83f4ce8-fadc-38cf-8662-e4d9eb3ee601",
                                                "text": "„Deine Zauber binden wieder, was die Mode streng geteilt.“"
                                            },
                                            {
                                                "example_id": "5d1a3578-3aae-49d2-a5c2-53654dd696cb",
                                                "sense_id": "e83f4ce8-fadc-38cf-8662-e4d9eb3ee601",
                                                "text": "„Feinzart, unmerklich ist ihr Zauber, den dennoch jeder Empfindende an sich erfährt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "34d1b391-f5e5-39ee-bc1c-2bdcb939750c",
                                        "entry_id": "55657284-855f-3271-bfa3-806b1d230cf1",
                                        "glosses": [
                                            "Unsinn"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49fbc094-0b78-4975-898e-5d5698162928",
                                                "sense_id": "34d1b391-f5e5-39ee-bc1c-2bdcb939750c",
                                                "text": "Lass den Zauber endlich sein! Mach keinen Zauber!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a915a3d4-92b5-4832-81db-aa43f74ebeeb",
                        "source_entry_id": "acd0bd21-86ba-3561-a9d8-661529144192",
                        "source_sense_description": "something that enchants",
                        "target_lang_word": "ма́гия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ма́гия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ca4c4d52-4f11-3314-a3e6-0304e07a23de",
                                        "entry_id": "f11ed653-0e71-3857-b4b4-f2b2965c9d05",
                                        "glosses": [
                                            "совокупность обрядов, действий, слов, связанных с верой в способность человека — мага, волшебника, колдуна — с помощью чудодейственных сил воздействовать на людей, животных и явления природы; колдовство, волшебство, чародейство"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1fc9470e-03fa-4f3b-9654-d23f700e489b",
                                                "sense_id": "ca4c4d52-4f11-3314-a3e6-0304e07a23de",
                                                "text": "Персидская магия действовала, опираясь на знание мнимых чудесных свойств предметов, особенно драгоценных камней; её остаток — поныне существующее поверье о «счастливых камнях на каждый месяц»; Египет был особенно силён своими заклинаниями, его чудодеи кичились знанием подлинных имён всех демонов — мы знаем, ведь они были настоящими «имяславцами»."
                                            },
                                            {
                                                "example_id": "d3574bcc-b53b-49d0-9aaf-a5604c2b1db2",
                                                "sense_id": "ca4c4d52-4f11-3314-a3e6-0304e07a23de",
                                                "text": "◆ Магия предшествовала науке и эмпирическим, опытным путём сделала немало важных открытий: гипноз, внушение и психотерапия, лекарственные травы — всё это ведь известно с незапамятной древности."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5448d70-f576-3acf-a63a-83a4c6e38042",
                                        "entry_id": "f11ed653-0e71-3857-b4b4-f2b2965c9d05",
                                        "glosses": [
                                            "перен. необыкновенная сила воздействия на кого-либо"
                                        ],
                                        "tags": [
                                            "с доп.: чего. и без доп."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "584c598b-547b-414e-8b7d-9ee449816482",
                                                "sense_id": "b5448d70-f576-3acf-a63a-83a4c6e38042",
                                                "text": "У Боттичелли, у Леонардо, столь разных, есть магия обаяния."
                                            },
                                            {
                                                "example_id": "eac840e1-1f50-4391-8eff-1f5f0bd43467",
                                                "sense_id": "b5448d70-f576-3acf-a63a-83a4c6e38042",
                                                "text": "Магия какая-то в каждой вещи Сологуба, даже в более слабой."
                                            },
                                            {
                                                "example_id": "5597c333-668c-4e91-a43c-a1557cb7d771",
                                                "sense_id": "b5448d70-f576-3acf-a63a-83a4c6e38042",
                                                "text": "Но при этом следует учесть, что магия воздействия комедийного диалога, помимо его впечатляющей характерности, связана также со всеобщей и неизбывной потребностью в юморе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "166d8beb-9be5-32d5-827a-1e5d49fc0918",
                                        "entry_id": "f11ed653-0e71-3857-b4b4-f2b2965c9d05",
                                        "glosses": [
                                            "перен. притягательная, покоряющая сила; очарование"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b851e35-370a-41e6-a8fe-2d3a79562a1d",
                                                "sense_id": "166d8beb-9be5-32d5-827a-1e5d49fc0918",
                                                "text": "В самой посадке за барабанами, в полуприкрытых его огромных марсианских глазищах жила магия."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
