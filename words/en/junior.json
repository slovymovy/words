                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "name_group",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone calls him <w>Junior</w> to distinguish him from his dad.",
                            "target_lang_translations": {
                                "ru": "Все зовут его <w>Джуниор</w>, чтобы отличить от отца.",
                                "zh": "大家都叫他<w>小名</w>，以把他和他的父亲区分开来。"
                            }
                        },
                        {
                            "text": "<w>Junior</w> is playing in the backyard with his friends.",
                            "target_lang_translations": {
                                "ru": "<w>Джуниор</w> играет на заднем дворе со своими друзьями.",
                                "zh": "<w>小名</w>正在后院和朋友们玩耍。"
                            }
