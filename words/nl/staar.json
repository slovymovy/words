                            "target_lang_translations": {
                                "en": "In some eastern dialects, they still call that bird a <w>starling</w>."
                            }
                        },
                        {
                            "text": "De oude boer wees naar de boom en zei dat er een <w>staar</w> op de tak zat.",
                            "target_lang_translations": {
                                "en": "The old farmer pointed to the tree and said there was a <w>starling</w> sitting on the branch."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "mainly regional or dialectal usage for starling"
                        }
                    ],
                    "target_lang_definitions": {
