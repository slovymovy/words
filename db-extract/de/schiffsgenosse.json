                "senses": [
                    {
                        "sense_id": "422b3d69-e9d2-3972-a779-55fd5a23a2fd",
                        "entry_id": "acc0ca69-97ec-3869-b924-9153194a1b39",
                        "glosses": [
                            "Person, mit der man sich (als Teil einer Schiffsbesatzung) auf einem Schiff befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4636b99-d448-4eea-bc04-629d6a45d059",
                                "sense_id": "422b3d69-e9d2-3972-a779-55fd5a23a2fd",
                                "text": "„[…] Auf die Frage, wo denn sein alter Schiffsgenosse wohnt, hat er keine befriedigende Antwort geben können.“"
                            },
                            {
                                "example_id": "bc364f62-f318-4f8c-bb8a-f583877b07ae",
                                "sense_id": "422b3d69-e9d2-3972-a779-55fd5a23a2fd",
                                "text": "„Eure Dienste sollen nicht vergessen werden. Hier ist Gold“, sagte er dem Neger, der ihm zunächst stand, eine Handvoll davon anbietend. „Teilt es unter euch wie redliche Schiffsgenossen, und ihr könnt euch meines Schutzes stets versichert halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
