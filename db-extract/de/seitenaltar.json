                "senses": [
                    {
                        "sense_id": "00756c54-69cc-31d1-93e9-8171c683379c",
                        "entry_id": "1d208e54-a474-3c29-ab02-0fc8212f650b",
                        "glosses": [
                            "Altar im Seitenschiff einer Kirche"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "a4f804b1-00f5-482b-9225-69463f084765",
                                "sense_id": "00756c54-69cc-31d1-93e9-8171c683379c",
                                "text": "„Der spätgotische Seitenaltar (auch Heiligkreuz- und Nothelferaltar) der Marienkirche in Rieden (heute Gemeinde Rosengarten) wurde um 1520 im Stil der hällisch-fränkischen Kunsttradition geschaffen, während die flachen Flügelreliefs Anklänge an Arbeiten aus Ulm zeigen.“"
                            },
                            {
                                "example_id": "187e5f25-85bf-4923-9a6b-66f601ccee3a",
                                "sense_id": "00756c54-69cc-31d1-93e9-8171c683379c",
                                "text": "„Als Beimesse bezeichnet man eine Heilige Messe in der außerordentlichen Form des Römischen Ritus, die an einem Seitenaltar zelebriert wird und parallel zu einer Messe stattfindet, die in der gleichen Kirche am Hauptaltar gefeiert wird.“"
                            },
                            {
                                "example_id": "bc006a1a-8bfd-437c-9ef2-1cafbfe6717c",
                                "sense_id": "00756c54-69cc-31d1-93e9-8171c683379c",
                                "text": "„Anscheinend hörte sie die Messe, die am Seitenaltar, vier Schritte von mir, gelesen wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
