                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "groottante",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "4a43850f-3a47-366f-8aff-03efd57c3a30",
                                        "entry_id": "8f1863ca-39f9-3991-a99a-8cdaf0adad52",
                                        "glosses": [
                                            "de zus van een grootouder; de echtgenote van een broer van een grootouder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "451980e4-8105-4fa1-9b64-caac0dcf09d2",
                                                "sense_id": "4a43850f-3a47-366f-8aff-03efd57c3a30",
                                                "text": "Bijna 33 jaar na de gewelddadige dood van een vierjarige jongen in de Vogezen komt er een verrassende wending in het onderzoek naar deze zaak. De procureur van Dijon, Jean-Jacques Bosc, bevestigde vrijdag in de Franse stad mee dat de groottante en grootoom van Grégory in voorlopige hechtenis werden genomen."
                                            },
                                            {
                                                "example_id": "21fbc1d2-f915-4203-ae4d-05ebff49138a",
                                                "sense_id": "4a43850f-3a47-366f-8aff-03efd57c3a30",
                                                "text": "Zijn huis, te oordelen aan de ingemaakte kast achter zijn rug en de vele deuren een oude boerenwoonst, doet me denken aan de woning van een groottante."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
