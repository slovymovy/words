                ],
                "senses": [
                    {
                        "sense_id": "56083d45-eff8-358d-a93f-2c4e06bce150",
                        "entry_id": "4e9a727f-1aa7-3aa3-883b-867c9c067823",
                        "glosses": [
                            "ein in bestimmten Deklinationsklassen den Dativ Singular anzeigendes Flexionssuffix im Deutschen, das im Zuge einer stattfindenden Apokope als veraltend gilt und zunehmend ausfällt, sich in festen Phrasen aber noch durchgängig hält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b4cc7d1-2eb4-49bc-b680-30d8c2d23d49",
                                "sense_id": "56083d45-eff8-358d-a93f-2c4e06bce150",
                                "text": "Das Dativ-e kommt – grob gesagt – nur bei Nomen vor, die den Genitiv Singular auch mit ‚-es‘ bilden."
                            },
                            {
                                "example_id": "ffb7f25c-2aa5-4899-954d-973350b12da0",
                                "sense_id": "56083d45-eff8-358d-a93f-2c4e06bce150",
                                "text": "„Im Schulunterricht wurde dieses Dativ-e bis vor wenigen Generationen allerdings noch so streng verlangt, dass es in der Schriftsprache bis etwa 1940 noch oft benutzt wurde.“"
                            },
                            {
                                "example_id": "a1a14957-ca73-4ef0-84fc-3dc56c16c757",
                                "sense_id": "56083d45-eff8-358d-a93f-2c4e06bce150",
                                "text": "„Möglich ist das Dativ-e allgemein bei einsilbigen, auf Konsonant auslautenden Maskulina und Neutra des Kernwortschatzes: ‚dem Manne, dem Bette, dem Tage‘.“"
                            },
                            {
                                "example_id": "ee40fbfe-bef2-4839-bf9b-8645db266edc",
                                "sense_id": "56083d45-eff8-358d-a93f-2c4e06bce150",
                                "text": "Aus rhythmischen oder stilistischen Gründen kann das Dativ-e beibehalten werden, wie in dem Volkslied: „Am Brunnen vor dem Tore, da steht ein Lindenbaum“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
