                        "glosses": [
                            "Either of two nuclides of different elements having the same mass number."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "acc41f62-16e3-4fb4-9491-54cad792e392",
                        "source_entry_id": "2d545cc9-cf8c-3787-b895-0fd85176183c",
                        "source_sense_description": "line on a map connecting places of equal pressure",
                        "target_lang_word": "isobaar",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isobaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "cb50e1ce-2fd1-308c-834d-182113c7fcf2",
                                        "entry_id": "971474c4-0d8b-313d-b768-dd9c1867b488",
                                        "glosses": [
                                            "bij constant houden van de druk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a47a803e-88ed-42ef-abad-56f360f221ba",
                                                "sense_id": "cb50e1ce-2fd1-308c-834d-182113c7fcf2",
                                                "text": "Het kookpunt van een vloeistof is slechts onder isobare omstandigheden een constante temperatuur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isobaar",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ed48e2-a94a-3a50-8f0d-49321b9ad418",
                                        "entry_id": "d393e120-f215-319d-9e3e-17b6be10aa4e",
                                        "glosses": [
                                            "een verzameling punten onder constant houden van de druk gemeten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00b11114-6893-4f1c-8246-ff63d0232226",
                                                "sense_id": "c9ed48e2-a94a-3a50-8f0d-49321b9ad418",
                                                "text": "De weerman tekende vroeger de isobaren met lippenstift op de kaart om er het weer mee te voorspellen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7ed1a85-6005-435d-9bea-378c53310697",
                        "source_entry_id": "2d545cc9-cf8c-3787-b895-0fd85176183c",
                        "source_sense_description": "line on a map connecting places of equal pressure",
                        "target_lang_word": "isobare",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "isobare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9080c39a-1890-3e45-bd44-0e3dc61ffef9",
                                        "entry_id": "8e8ffb04-8ac4-3e2e-bca1-3ecce6c460f6",
                                        "glosses": [
                                            "Se dit de deux lieux où la pression atmosphérique est égale. Par extension,"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbf183d3-86c0-4ee0-b468-7494d3c89d8a",
                                                "sense_id": "9080c39a-1890-3e45-bd44-0e3dc61ffef9",
                                                "text": "Lignes isobares, courbes isobares : lignes, courbes indiquant ces lieux sur des cartes."
                                            },
                                            {
                                                "example_id": "1184bd8b-4315-47df-b1a6-cf0486d35bfe",
                                                "sense_id": "9080c39a-1890-3e45-bd44-0e3dc61ffef9",
                                                "text": "En présentant son mémoire sur la circulation atmosphérique (Petermann’s Mittheilungen, Ergänzungsheft, nᵒ 38), M. A. [Alexandre] Voyeikof fait ressortir l’importance des lignes isobares qui, d’après la loi si connue de Buys-Ballot, donnent la clef des vents. […] Sur les cartes de M. Voyeikof les isobares sont tracées de deux en deux millimètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f2c116d-e10d-385b-8907-1692836309b0",
                                        "entry_id": "8e8ffb04-8ac4-3e2e-bca1-3ecce6c460f6",
                                        "glosses": [
                                            "Caractérise une transformation qui s’effectue à pression constante."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5b57ddda-13db-3b6e-aa6e-de24f1ecb823",
                                        "entry_id": "8e8ffb04-8ac4-3e2e-bca1-3ecce6c460f6",
                                        "glosses": [
                                            "Caractérise deux éléments qui possèdent le même nombre de nucléons (nombres de masse A identiques), contrairement aux nombres de protons (numéros atomiques Z différents)."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7afec7d9-f8af-45b5-9d6e-d88132dcd1c8",
                                                "sense_id": "5b57ddda-13db-3b6e-aa6e-de24f1ecb823",
                                                "text": "Le carbone-14 et l’azote-14 (notation : {}₆¹⁴ operatorname C et {}₇¹⁴ operatorname N) sont deux éléments chimiques isobares."
                                            },
                                            {
                                                "example_id": "80871248-be93-4517-b499-893064b9dd17",
                                                "sense_id": "5b57ddda-13db-3b6e-aa6e-de24f1ecb823",
                                                "text": "L’élément « père » d’une désintégration bêta et l’élément « fils » sont isobares."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isobare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c32b6b8-2946-3848-8072-fff8af804b52",
                                        "entry_id": "bcdd1f1a-ba26-341e-bf13-ce748f74222b",
                                        "glosses": [
                                            "Ligne, courbe reliant des lieux de même pression atmosphérique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41e4858b-a30a-466e-a104-61dbd2b1f303",
                                                "sense_id": "7c32b6b8-2946-3848-8072-fff8af804b52",
                                                "text": "En présentant son mémoire sur la circulation atmosphérique (Petermann’s Mittheilungen, Ergänzungsheft, nᵒ 38), M. A. [Alexandre] Voyeikof fait ressortir l’importance des lignes isobares qui, d’après la loi si connue de Buys-Ballot, donnent la clef des vents. […] Sur les cartes de M. Voyeikof les isobares sont tracées de deux en deux millimètres."
                                            },
                                            {
                                                "example_id": "5f1f0480-a358-469b-87ff-d457f75b9c0d",
                                                "sense_id": "7c32b6b8-2946-3848-8072-fff8af804b52",
                                                "text": "Je me suis demandé si les isobares de nos cartes journalières ne seraient pas modifiées notablement à mesure qu’on s’élève dans l’atmosphère."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "isobare",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc97a217-bd04-370c-9ae6-d13008b7bddc",
                                        "entry_id": "52d44e06-be65-31e5-b92a-5c1b9cc60311",
                                        "glosses": [
                                            "Substantif de l’adjectif : noyaux ou atomes possédant le même nombre de nucléons."
                                        ],
                                        "tags": [
                                            "Chimie physique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8ff3315-5f05-4ca1-b539-cd9e2cb0f3e4",
                                                "sense_id": "bc97a217-bd04-370c-9ae6-d13008b7bddc",
                                                "text": "Il est nécessaire, pour spécifier le modèle, de savoir comment l’énergie disponible au centre de masse se partage entre le centre de pionisation et les isobares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
