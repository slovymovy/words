                                        "examples": [
                                            {
                                                "example_id": "8c2bd479-75a6-4f8b-8b18-eaad7953ac1e",
                                                "sense_id": "599cba2c-bc1d-3ab0-8f37-f76a9219860e",
                                                "text": "Какая удача, что я тебя встретил! Да пребудет с тобой удача!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
