                "senses": [
                    {
                        "sense_id": "7ab7ff67-ace1-373e-8c97-25369eb688d0",
                        "entry_id": "ab57c943-a41c-3c59-965b-a01e76248a4c",
                        "glosses": [
                            "twenty-six-headed"
                        ],
