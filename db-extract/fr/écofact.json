                "entry_id": "d52014df-a1cf-325b-ae4f-ea90cdf07d73",
                "word": "écofact",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "18aa721a-a329-47e9-9047-239dcec997a3",
                        "entry_id": "d52014df-a1cf-325b-ae4f-ea90cdf07d73",
