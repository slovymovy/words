                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "91a8ff98-e15b-42d5-ab0b-a5b7483bcb82",
                        "source_entry_id": "eeea27c6-400e-3511-91ac-2cdfd50124e4",
                        "source_sense_id": "5792fb8b-1025-385f-95ae-fe215cf33d44",
                        "source_sense_description": "wechselseitige militärische Aufrüstung zweier oder mehrerer Konkurrenten",
                        "target_lang_word": "corrida armamentista",
                        "target_lang_code": "pt",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "corrida armamentista",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "bf256d33-54c6-3ee0-8d78-83448f062fec",
                                        "entry_id": "35f56cc2-be52-3f4b-a987-2b45fbf459d9",
                                        "glosses": [
                                            "situação na qual dois ou mais países, bem como alianças entre estes, realizam a ampliação da produção de armas, da tecnologia de sua produção e o aumento de tropas com o fim de superar a capacidade bélica dos rivais que, por sua vez, reagem de igual forma de modo que há uma espiral crescente e sem limite final"
                                        ],
                                        "tags": [
                                            "Geopolítica"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d59754f-d082-4ada-866b-e8e70a1a7c46",
                                                "sense_id": "bf256d33-54c6-3ee0-8d78-83448f062fec",
                                                "text": "Número de ogivas consideradas prontas para uso vem crescendo e liga alerta para a primeira corrida armamentista nuclear do pós-Guerra Fria."
                                            },
                                            {
                                                "example_id": "f98d6049-caa2-4d3a-a439-41ce3d379e64",
                                                "sense_id": "bf256d33-54c6-3ee0-8d78-83448f062fec",
                                                "text": "Mais de 100 países, de todas as regiões do planeta, aumentaram os orçamentos de defesa levando a corrida armamentista a um patamar jamais visto."
                                            },
                                            {
                                                "example_id": "8d019f72-ba53-4d2c-baf4-fb4708163563",
                                                "sense_id": "bf256d33-54c6-3ee0-8d78-83448f062fec",
                                                "text": "“A China está se posicionando como uma superpotência global. Estamos nas fases iniciais de uma nova corrida armamentista”, disse William Alberque, pesquisador sênior associado do Pacific Forum e ex-diretor de controle de armas da Otan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
