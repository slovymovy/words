{
    "word_family": [
        "current",
        "currently",
        "concurrent",
        "recurrence"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb12ba23-a7d3-3780-aa0b-b71e78764c34",
                    "sense_definition": "The system of money used in a particular country or region.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "financial_money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The euro is the official <w>currency</w> of many European countries.",
                            "target_lang_translations": {
                                "pl": "Euro jest oficjalną <w>walutą</w> wielu krajów europejskich."
                            }
                        },
                        {
                            "text": "We need to exchange some dollars into the local <w>currency</w> before we leave the airport.",
                            "target_lang_translations": {
                                "pl": "Musimy wymienić trochę dolarów na lokalną <w>walutę</w> przed opuszczeniem lotniska."
                            }
                        }
                    ],
                    "synonyms": [
                        "money",
                        "legal tender",
                        "cash"
                    ],
                    "common_phrases": [
                        "foreign currency",
                        "local currency",
                        "hard currency",
                        "currency exchange",
                        "digital currency"
                    ],
                    "target_lang_definitions": {
                        "pl": "System pieniężny używany w konkretnym kraju lub regionie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "waluta",
                                "target_lang_sense_clarification": "oficjalna jednostka monetarna państwa"
                            },
                            {
                                "target_lang_word": "środek płatniczy",
                                "target_lang_sense_clarification": "pieniądze służące do dokonywania transakcji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "841e5cfc-c4ae-3673-a9f0-ee1fd6718792",
                    "sense_definition": "The state of being generally accepted, used, or known by many people.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_acceptance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rumor began to gain <w>currency</w> after it was published in a major newspaper.",
                            "target_lang_translations": {
                                "pl": "Plotka zaczęła zyskiwać na <w>popularności</w> po tym, jak została opublikowana w ważnej gazecie."
                            }
                        },
                        {
                            "text": "That old scientific theory has lost all <w>currency</w> among modern researchers.",
                            "target_lang_translations": {
                                "pl": "Ta stara teoria naukowa straciła całkowicie na <w>aktualności</w> wśród współczesnych badaczy."
                            }
                        }
                    ],
                    "synonyms": [
                        "acceptance",
                        "prevalence",
                        "circulation",
                        "popularity"
                    ],
                    "common_phrases": [
                        "gain currency",
                        "lose currency",
                        "have currency",
                        "wide currency"
                    ],
                    "target_lang_definitions": {
                        "pl": "Stan powszechnej akceptacji, używania lub znajomości czegoś przez wiele osób."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "popularność",
                                "target_lang_sense_clarification": "powszechne uznanie lub akceptacja"
                            },
                            {
                                "target_lang_word": "aktualność",
                                "target_lang_sense_clarification": "bycie zgodnym z obecnym stanem wiedzy lub trendów"
                            },
                            {
                                "target_lang_word": "rozpowszechnienie",
                                "target_lang_sense_clarification": "szerokie występowanie w obiegu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d09419a-49ba-3e21-999c-bdc43d5724e1",
                    "sense_definition": "Paper money, as distinct from coins.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "financial_money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The vending machine accepts coins but does not take paper <w>currency</w>.",
                            "target_lang_translations": {
                                "pl": "Automat przyjmuje monety, ale nie przyjmuje <w>banknotów</w>."
                            }
                        },
                        {
                            "text": "He pulled a crumpled piece of <w>currency</w> from his pocket to pay the driver.",
                            "target_lang_translations": {
                                "pl": "Wyciągnął z kieszeni pognieciony <w>banknot</w>, aby zapłacić kierowcy."
                            }
                        }
                    ],
                    "synonyms": [
                        "banknotes",
                        "bills",
                        "paper money"
                    ],
                    "antonyms": [
                        "coinage",
                        "specie"
                    ],
                    "target_lang_definitions": {
                        "pl": "Pieniądze papierowe, w odróżnieniu od monet."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "banknoty",
                                "target_lang_sense_clarification": "pieniądze w formie papierowej"
                            },
                            {
                                "target_lang_word": "gotówka papierowa",
                                "target_lang_sense_clarification": "pieniądze niebędące bilonem"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}