                    "sense_definition": "Разговорное название немецкого пикирующего бомбардировщика Юнкерс Ю-87 времён Второй мировой войны.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "plane_name",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "В небе появилась вражеская <Штука> и начала резко пикировать вниз.",
                            "target_lang_translations": {
                                "en": "An enemy <Stuka> appeared in the sky and began to dive sharply.",
                                "de": "Am Himmel erschien ein feindlicher <Stuka> und begann steil nach unten zu stürzen."
                            }
                        },
                        {
                            "text": "Советские солдаты быстро научились сбивать немецкие <Штуки>.",
                            "target_lang_translations": {
                                "en": "Soviet soldiers quickly learned to shoot down German <Stukas>.",
                                "de": "Sowjetische Soldaten lernten schnell, deutsche <Stukas> abzuschießen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical context (WWII)"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Colloquial name for the German Junkers Ju 87 dive bomber from World War II.",
                        "de": "Umgangssprachliche Bezeichnung für den deutschen Sturzkampfbomber Junkers Ju 87 aus dem Zweiten Weltkrieg."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Stuka",
                                "target_lang_sense_clarification": "colloq.: the German Junkers Ju 87 dive bomber"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Stuka",
                                "target_lang_sense_clarification": "Kurzform für Sturzkampfflugzeug"
                            }
                        ]
                    }
                }
            ]
        }
    ]
