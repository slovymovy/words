                ],
                "translations": [
                    {
                        "translation_id": "3deb566f-15cc-4214-9a1f-0d21b5b230b8",
                        "source_entry_id": "dbb44ba0-e640-3f1d-82f6-bf0be4ee9f82",
                        "source_sense_id": "9f751786-b8a2-3ef1-b577-067fea04f092",
                        "target_lang_word": "shining",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "shining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "399f3dcb-67c4-3bbc-ad6b-82747e1be9ff",
                                        "entry_id": "a6e99eb7-4572-31ef-bd53-80fa1d1920f7",
                                        "glosses": [
                                            "Emitting light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78e1330b-374c-4e38-a7d8-5c4d220941db",
                                                "sense_id": "399f3dcb-67c4-3bbc-ad6b-82747e1be9ff",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff0c62e5-3e2a-358d-8797-e212f4b4ca17",
                                        "entry_id": "a6e99eb7-4572-31ef-bd53-80fa1d1920f7",
                                        "glosses": [
                                            "Reflecting light."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f80333ac-c3f9-362e-baa4-374239a29a38",
                                        "entry_id": "a6e99eb7-4572-31ef-bd53-80fa1d1920f7",
                                        "glosses": [
                                            "Having a high polish or sheen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "debaabc2-f7e7-4628-b37c-49a0a345fb23",
                                                "sense_id": "f80333ac-c3f9-362e-baa4-374239a29a38",
                                                "text": "He was at the wedding, too. His beard was flowinger and redder, and the part in the back of his head shininger than ever. He had an elegant time. He was so full of himself you would have thought it was his own party."
                                            },
                                            {
                                                "example_id": "68699208-6734-48ff-9bb3-14607b30bce8",
                                                "sense_id": "f80333ac-c3f9-362e-baa4-374239a29a38",
                                                "text": "Hardly knowing what he meant, she plucked a many-headed specimen with a long stalk. At the end of it was such a shining needle that it dazzled her eyes so that she couldn’t see how she did the sewing up with it. But however it was done, the torn sleeve, she says, “didn’t look like wanting mending any more, but was better tore ’cos it let you see he had a shininger coat under.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91f2263-684e-38c3-9015-49cb28424179",
                                        "entry_id": "a6e99eb7-4572-31ef-bd53-80fa1d1920f7",
                                        "glosses": [
                                            "Having exceptional merit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "99ac2f29-843f-42de-acdd-3f04dd26d2ae",
                                                "sense_id": "b91f2263-684e-38c3-9015-49cb28424179",
                                                "text": "a shining example"
                                            },
                                            {
                                                "example_id": "805e213f-8864-4021-a8a1-eb341d8d2097",
                                                "sense_id": "b91f2263-684e-38c3-9015-49cb28424179",
                                                "text": "Jill had, as you might say quite fallen in love with the Unicorn. She thought—and she wasn’t far wrong—that he was the shiningest, delicatest, most graceful animal she had ever met: and he was so gentle and soft of speech that, if you hadn’t known, you would hardly have believed how fierce and terrible he could be in battle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "shining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0541fa02-d6f5-309f-aece-17aa5d04d419",
                                        "entry_id": "3ed4dcf7-e106-313c-adda-bfca482173b3",
                                        "glosses": [
                                            "present participle and gerund of shine"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "shining",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "abedbcb5-3fe2-31e4-9a7c-52d78f0ecb31",
                                        "entry_id": "cba397f2-1ecd-30b4-8435-646d5fafbc39",
                                        "glosses": [
                                            "A bright emission of light; a gleam."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9dcd8fb6-bad0-4a2c-9556-fa130b40de47",
                        "source_entry_id": "dbb44ba0-e640-3f1d-82f6-bf0be4ee9f82",
                        "source_sense_id": "9f751786-b8a2-3ef1-b577-067fea04f092",
                        "target_lang_word": "glitter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9bd394b-ac1d-35a3-b26e-23c7e23834df",
                                        "entry_id": "218710e2-ebc4-37fe-9bad-92c50bd518ca",
                                        "glosses": [
                                            "A bright, sparkling light; shininess or brilliance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c9e3d6b-0296-49d6-8626-e120e60049bc",
                                                "sense_id": "d9bd394b-ac1d-35a3-b26e-23c7e23834df",
                                                "text": "As yet there had been no symptom of the news having any better foundation than in the fears of those who brought it, but The Boot had not been deserted five minutes, when there appeared, coming across the fields, a body of men who, it was easy to see, by the glitter of their arms and ornaments in the sun, and by their orderly and regular mode of advancing."
                                            },
                                            {
                                                "example_id": "647b14d6-1376-489f-8903-f1858fd6a695",
                                                "sense_id": "d9bd394b-ac1d-35a3-b26e-23c7e23834df",
                                                "text": "This to them seems most like mother earth in color, and therefore best, as it is, to enhance the beauty of flowers instead of detracting from their exquisite shades. What a contrast to the glitter and show of our silver vases, which represent generally little else but their cost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b7763f-0a45-3649-b314-63038ecdfc5f",
                                        "entry_id": "218710e2-ebc4-37fe-9bad-92c50bd518ca",
                                        "glosses": [
                                            "A shiny, decorative adornment, sometimes sprinkled on glue to make simple artwork."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "895d3f2b-4a2e-3ab4-aaba-733176cb339a",
                                        "entry_id": "218710e2-ebc4-37fe-9bad-92c50bd518ca",
                                        "glosses": [
                                            "Glitz."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "glitter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                                        "entry_id": "5c3bf602-023d-3a68-b22d-00b7eaf4d0ed",
                                        "glosses": [
                                            "To sparkle with light; to shine with a brilliant and broken light or showy luster; to gleam."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "869831e7-d9e9-43c7-97f2-57a5f319fe0e",
                                                "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                                                "text": "a glittering sword"
                                            },
                                            {
                                                "example_id": "3022b4cb-c1fb-4a9f-9d42-4a63c2679f3c",
                                                "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                                                "text": "the glittering ornaments on a Christmas tree"
                                            },
                                            {
                                                "example_id": "06d4c5e6-7104-4292-82c3-8f45ac39522b",
                                                "sense_id": "f450466f-3fb7-3f31-ab52-ea23c75d8993",
                                                "text": "The field yet glitters with the pomp of war."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b525baac-06c6-3855-a18b-02dee7b06319",
                                        "entry_id": "5c3bf602-023d-3a68-b22d-00b7eaf4d0ed",
                                        "glosses": [
                                            "To be showy, specious, or striking, and hence attractive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
