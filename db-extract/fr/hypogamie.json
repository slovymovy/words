                "senses": [
                    {
                        "sense_id": "119c71f7-6754-3287-a840-fd1c88ea33f6",
                        "entry_id": "602d98d5-1e60-39ae-89d9-52403f1d1894",
                        "glosses": [
                            "Pour un individu, mariage avec une personne de rang social inférieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b209f89d-94d1-414e-95d0-e0f0f2de3b24",
                                "sense_id": "119c71f7-6754-3287-a840-fd1c88ea33f6",
                                "text": "L’importance des biens de (et transmissibles par) l’épouse en provenance du père (dot en plus de l’héritage) s’est nettement réduite – en parallèle avec un développement de l’hypogamie des filles, avant que soit réintroduite la dot versée par le père (rachetant « forfaitairement » les droits successoraux des femmes mariées), mais en argent (de même que les droits transmis par le mari se transformaient en rentes sur les biens de celui-ci)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e0e21e7-07cd-44b5-aaa8-f9caea948c1e",
                        "source_entry_id": "602d98d5-1e60-39ae-89d9-52403f1d1894",
                        "source_sense_id": "119c71f7-6754-3287-a840-fd1c88ea33f6",
                        "target_lang_word": "hypogamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypogamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8cfecb8-b469-3f4c-a4e5-f6e2cd975048",
                                        "entry_id": "1aeb7a02-0f5e-3a1d-952c-7d2a0a7adb90",
                                        "glosses": [
                                            "The seeking of a spouse of lower socioeconomic status or caste than oneself."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ce2158-b6d5-4d8a-a66c-2ee15034cd13",
                                                "sense_id": "e8cfecb8-b469-3f4c-a4e5-f6e2cd975048",
                                                "text": "The reverse (hypogamy) is rare because with marriage a woman and her future offspring take on the social position of the husband, and so an upper‐class woman marrying a lower‐class man reduces her position as well as that of her children."
                                            },
                                            {
                                                "example_id": "1bd514f0-a13c-42b7-89d2-2dba1d6bfde9",
                                                "sense_id": "e8cfecb8-b469-3f4c-a4e5-f6e2cd975048",
                                                "text": "Men like Mr. Lim, according to Government officials, often end up marrying \"downward\" - hypogamy - after they fail to win a woman of their own educational level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
