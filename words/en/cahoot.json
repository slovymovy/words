{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ef5e200a-0ead-3af2-b8f8-9aa9d882870d",
                    "sense_definition": "A collusive partnership or secret alliance, especially for questionable or dishonest purposes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "partnership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The investigators suspected the mayor was in <w>cahoot</w> with local corrupt businessmen.",
                            "target_lang_translations": {
                                "es": "Los investigadores sospechaban que el alcalde estaba en <w>complicidad</w> con empresarios corruptos locales."
                            }
                        },
                        {
                            "text": "Several dishonest officials formed a secret <w>cahoot</w> to embezzle state funds.",
                            "target_lang_translations": {
                                "es": "Varios funcionarios deshonestos formaron una <w>componenda</w> secreta para malversar fondos estatales."
                            }
                        }
                    ],
                    "synonyms": [
                        "cahoots"
                    ],
                    "common_phrases": [
                        "in cahoot with"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in singular dialectally or informally instead of cahoots"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Una asociación ilícita, compadrazgo o alianza secreta, especialmente con fines dudosos o deshonestos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "componenda",
                                "target_lang_sense_clarification": "acuerdo inmoral o ilícito"
                            },
                            {
                                "target_lang_word": "complicidad",
                                "target_lang_sense_clarification": "alianza para delinquir o engañar"
                            },
                            {
                                "target_lang_word": "compadrazgo",
                                "target_lang_sense_clarification": "alianza encubierta por beneficio mutuo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03539c16-9e68-3490-b617-a35f0e0cfc13",
                    "sense_definition": "A partner or accomplice, especially in wrongdoing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "partnership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The thief was arrested, but his main <w>cahoot</w> managed to escape the scene.",
                            "target_lang_translations": {
                                "es": "El ladrón fue arrestado, pero su principal <w>compinche</w> logró huir del lugar."
                            }
                        },
                        {
                            "text": "She refused to name her <w>cahoot</w> during the police interrogation.",
                            "target_lang_translations": {
                                "es": "Ella se negó a nombrar a su <w>cómplice</w> durante el interrogatorio policial."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "used to describe an accomplice"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Socio o cómplice, especialmente en una mala acción o delito."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "cómplice",
                                "target_lang_sense_clarification": "persona que participa en una fechoría"
                            },
                            {
                                "target_lang_word": "compinche",
                                "target_lang_sense_clarification": "amigo o aliado para cometer faltas o delitos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf39fc81-cdda-332a-a4d9-854b6b4318bb",
                    "sense_definition": "A company or partnership.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "partnership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two traders decided to form a commercial <w>cahoot</w> to expand their business.",
                            "target_lang_translations": {
                                "es": "Los dos comerciantes decidieron formar una <w>sociedad</w> comercial para expandir su negocio."
                            }
                        },
                        {
                            "text": "They entered into a temporary <w>cahoot</w> to finance the risky shipping expedition.",
                            "target_lang_translations": {
                                "es": "Formaron una <w>asociación</w> temporal para financiar la arriesgada expedición marítima."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historic or regional commercial partnership"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Asociación, compañía o sociedad comercial."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sociedad",
                                "target_lang_sense_clarification": "asociación comercial o de negocios"
                            },
                            {
                                "target_lang_word": "asociación",
                                "target_lang_sense_clarification": "alianza de negocios"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "60195e6b-9b4a-384e-8085-9376ca72e3f3",
                    "sense_definition": "To collude or act in partnership, especially secretly or dishonestly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "partnership",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Critics accused politicians of <w>cahooting</w> with wealthy corporate lobbyists behind closed doors.",
                            "target_lang_translations": {
                                "es": "Los críticos acusaron a los políticos de <w>estar confabulados</w> a puerta cerrada con ricos cabilderos corporativos."
                            }
                        },
                        {
                            "text": "They were caught secretly <w>cahooting</w> to fix the market prices.",
                            "target_lang_translations": {
                                "es": "Fueron descubiertos <w>conchabándose</w> en secreto para fijar los precios del mercado."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informal verb use"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Confabularse o actuar en complicidad, especialmente en secreto o de manera deshonesta."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "confabularse",
                                "target_lang_sense_clarification": "ponerse de acuerdo para actuar ilícitamente"
                            },
                            {
                                "target_lang_word": "complotar",
                                "target_lang_sense_clarification": "conspirar o actuar secretamente"
                            },
                            {
                                "target_lang_word": "conchabarse",
                                "target_lang_sense_clarification": "asociarse de manera dudosa o deshonesta"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}