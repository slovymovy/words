                    "sense_definition": "een jonge jongen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "kind",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat kleine <w>joch</w> speelt de hele middag buiten in de zandbak.",
                            "target_lang_translations": {
                                "en": "That little <w>boy</w> has been playing outside in the sandbox all afternoon.",
                                "ru": "Этот маленький <w>мальчуган</w> весь день играет на улице в песочнице."
                            }
                        },
                        {
                            "text": "Wat een dapper <w>joch</w> is het dat hij niet huilt na die val.",
                            "target_lang_translations": {
                                "en": "What a brave <w>lad</w> he is for not crying after that fall.",
                                "ru": "Какой храбрый <w>мальчишка</w>, что не плачет после такого падения."
                            }
                        }
                    ],
                    "synonyms": [
