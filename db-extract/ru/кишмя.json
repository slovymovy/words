        "ru-extract.jsonl": [
            {
                "entry_id": "f6981059-fac2-3aff-8be0-d9b2a47fc280",
                "word": "кишмя",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fb23054d-21c2-30f8-9442-64ff51254050",
                        "entry_id": "f6981059-fac2-3aff-8be0-d9b2a47fc280",
                        "glosses": [
                            "во множестве, полностью заполонив"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "74d5411d-6c19-4563-9ff3-7368a6ebde95",
                                "sense_id": "fb23054d-21c2-30f8-9442-64ff51254050",
                                "text": "Бог, отдавший сотворённой им кишмя кишащей жизни лишь крохотный кусочек своей непостижимой сущности…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec7d1f8f-87f3-419c-adf1-a5b072472fd0",
                        "source_entry_id": "f6981059-fac2-3aff-8be0-d9b2a47fc280",
                        "source_sense_id": "fb23054d-21c2-30f8-9442-64ff51254050",
                        "target_lang_word": "wimmeln",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wimmeln",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ae6f643f-134f-3fb4-88bc-2ac8d6028603",
                                        "entry_id": "b677242d-48d0-3b96-8ee5-bd43cc128170",
                                        "glosses": [
                                            "sich wild, ungeordnet durcheinander bewegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0def351f-ea4a-4e0a-822e-b6242bcdcd1a",
                                                "sense_id": "ae6f643f-134f-3fb4-88bc-2ac8d6028603",
                                                "text": "Die Ameisen wimmeln durch ihren Bau."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9cb41216-a67a-3691-81d3-54b4e87fd682",
                                        "entry_id": "b677242d-48d0-3b96-8ee5-bd43cc128170",
                                        "glosses": [
                                            "von vielen Dingen oder Lebewesen erfüllt, durchsetzt sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65d04b54-65aa-4b64-87b4-654d3cc6256c",
                                                "sense_id": "9cb41216-a67a-3691-81d3-54b4e87fd682",
                                                "text": "Der Boden wimmelt von Ameisen."
                                            },
                                            {
                                                "example_id": "c7ac2263-682b-49a0-9e36-82d02ead5eb9",
                                                "sense_id": "9cb41216-a67a-3691-81d3-54b4e87fd682",
                                                "text": "Der Artikel wimmelte von Fehlern."
                                            },
                                            {
                                                "example_id": "0ad181ce-d175-47ea-869c-a1ddf483c60d",
                                                "sense_id": "9cb41216-a67a-3691-81d3-54b4e87fd682",
                                                "text": "„In manchen Teilen der Biosphäre wimmelt es von Leben, weil dort die Lebensbedingungen beinahe ideal sind. Andere Teile sind nur spärlich besiedelt, weil extreme Kälte oder Hitze das Überleben schwierig macht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3c658ed2-0bcb-3e52-aa79-b831daa0a97b",
                                        "entry_id": "b677242d-48d0-3b96-8ee5-bd43cc128170",
                                        "glosses": [
                                            "viele, sich durcheinander bewegende Lebewesen vorhanden sein"
                                        ],
                                        "tags": [
                                            "impersonal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "839f5f1a-fac1-4a66-a337-9e5ffb088e47",
                                                "sense_id": "3c658ed2-0bcb-3e52-aa79-b831daa0a97b",
                                                "text": "Hier wimmelt es von Mücken und Bremsen!"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a6dc5bf-d2a5-4e33-8816-d8bfe2b2b10c",
                        "source_entry_id": "f6981059-fac2-3aff-8be0-d9b2a47fc280",
                        "source_sense_id": "fb23054d-21c2-30f8-9442-64ff51254050",
                        "target_lang_word": "strotzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "strotzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ef87503f-5567-3075-b9c2-f4101faf07e4",
                                        "entry_id": "e61b90e4-a924-36dd-8fe6-5d5b080f0110",
                                        "glosses": [
                                            "sehr viel, ein Übermaß von etwas enthalten"
                                        ],
                                        "tags": [
                                            "dative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b5a6766-bbb6-41d9-9b23-7a95638a9beb",
                                                "sense_id": "ef87503f-5567-3075-b9c2-f4101faf07e4",
                                                "text": "„Sie sieht doch gar nicht so reichgeschmückt aus wie andere Gräfinnen, die von funkelndem Geschmeide strotzen, […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c101283a-5b2f-3129-859a-ae40748352eb",
                                        "entry_id": "e61b90e4-a924-36dd-8fe6-5d5b080f0110",
                                        "glosses": [
                                            "von einer Eigenschaft, Fähigkeit so gänzlich erfüllt sein, dass es auffällt"
                                        ],
                                        "tags": [
                                            "dative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfbaac1d-75f5-4c79-aa52-e8804876d22a",
                                                "sense_id": "c101283a-5b2f-3129-859a-ae40748352eb",
                                                "text": "Sie strotzt vor Stolz, als sie ihrer Familie die Medaille zeigt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ec5a636-cb5d-4f76-885e-278408cc628e",
                        "source_entry_id": "f6981059-fac2-3aff-8be0-d9b2a47fc280",
                        "source_sense_id": "fb23054d-21c2-30f8-9442-64ff51254050",
                        "target_lang_word": "fourmiller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fourmiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "79856741-1d89-3a81-a026-15457cecb659",
                                        "entry_id": "8609548f-cae8-36d5-9c9a-c31ef978d11a",
                                        "glosses": [
                                            "Remuer, s’agiter en grand nombre, à la façon des fourmis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2782f4cc-74a7-42cb-945f-96ad6be7d97d",
                                                "sense_id": "79856741-1d89-3a81-a026-15457cecb659",
                                                "text": "Les uns plantent des échelles, d’autres fourmillent comme des abeilles et tâchent de grimper sur les épaules les uns des autres."
                                            },
                                            {
                                                "example_id": "70276025-1b22-4fe8-8739-986c3e05c3ff",
                                                "sense_id": "79856741-1d89-3a81-a026-15457cecb659",
                                                "text": "De temps en temps, par un effort désespéré, elle tendait les ficelles relâchées de ses jarrets, et parvenait à soulever sa pauvre vieille jambe taillée en balustre, de manière à produire une petite cabriole nerveuse, comme une grenouille morte soumise à la pile de Volta, et à faire scintiller et fourmiller une seconde les paillettes de cuivre du lambeau douteux qui lui servait de basquine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f03c7126-b8b4-3791-80c5-0c3f29e37e43",
                                        "entry_id": "8609548f-cae8-36d5-9c9a-c31ef978d11a",
                                        "glosses": [
                                            "Être réunis en grand nombre."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34ee1f28-7503-4a89-ae59-af5fe8c9e89f",
                                                "sense_id": "f03c7126-b8b4-3791-80c5-0c3f29e37e43",
                                                "text": "Au moment où il se disposaient à revenir chargés d'or et de perles, ils s'aperçurent que leurs navires faisaient eau, percés à jour par le broma ou ver marin qui fourmille dans les régions de la zone torride."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "703bb634-2448-38c0-bb1c-b0749ebdc4c2",
                                        "entry_id": "8609548f-cae8-36d5-9c9a-c31ef978d11a",
                                        "glosses": [
                                            "Être affecté d’un picotement comme si l’on sentait courir des fourmis sous la peau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed479ae6-3518-405c-8ad7-25bb8278e81e",
                                                "sense_id": "703bb634-2448-38c0-bb1c-b0749ebdc4c2",
                                                "text": "Toute la main me fourmille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89641fc7-4450-3c49-8f49-9badc786bf55",
                                        "entry_id": "8609548f-cae8-36d5-9c9a-c31ef978d11a",
                                        "glosses": [
                                            "Abonder en."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3077278d-39e0-4421-aea5-1f03b002a46d",
                                                "sense_id": "89641fc7-4450-3c49-8f49-9badc786bf55",
                                                "text": "Thommereux. — … Mais l’histoire fourmille de ces héroïnes qui avaient su concilier leurs devoirs avec leurs penchants ! mais même… dans l’histoire sainte… vous avez des principes religieux, vous ?… Eh ! bien, l’histoire sainte est pleine de ces exemples."
                                            },
                                            {
                                                "example_id": "dfe7ed3b-82f0-436f-a3a9-b18874c877da",
                                                "sense_id": "89641fc7-4450-3c49-8f49-9badc786bf55",
                                                "text": "L'œuvre entière fourmille de ces expressions délicieuses. Il est vrai que le troubadour connaissait parfaitement les érotiques latins."
                                            },
                                            {
                                                "example_id": "5bb481e5-ae45-4dfc-8f8a-d56a815ed074",
                                                "sense_id": "89641fc7-4450-3c49-8f49-9badc786bf55",
                                                "text": "Les journaux fourmillent d’articles traitant de situations difficiles – la pauvreté galopante, la propagation de maladies mortelles, la pollution de l’environnement, les menaces pesant sur la vie privée, le spectre du terrorisme – qui exigent des solutions."
                                            },
                                            {
                                                "example_id": "b3ca0a67-1872-4179-b9b8-bc5cb39c098d",
                                                "sense_id": "89641fc7-4450-3c49-8f49-9badc786bf55",
                                                "text": "Le moindre espace fourmille de vie : de délicates grenouilles vénéneuses, aux peintures de guerre en forme de squelettes, accolées en pleine copulation, sécrétant leurs œufs précieux sur les feuilles ruisselantes. Des lianes étranglant leurs pareilles dans leur éternelle lutte pour la lumière du soleil. La respiration des singes. Le glissement d’un ventre de serpent sur une branche. Une armée de fourmis en colonne débitant un arbre géant en grains uniformes qu’elles entraînent vers d’obscures profondeurs à destination de leur reine vorace. À laquelle répond un chœur de jeunes plants inclinant leurs cols surgis de souches pourries, aspirant la vie de la mort. Cette forêt se dévore elle-même, vivante à jamais."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "22a2e9a7-27f5-4978-b33d-245d4f9160f9",
                        "source_entry_id": "f6981059-fac2-3aff-8be0-d9b2a47fc280",
                        "source_sense_id": "fb23054d-21c2-30f8-9442-64ff51254050",
                        "target_lang_word": "grouiller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grouiller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b8f63ec8-11cb-33b8-8b87-dcd510f1fcaa",
                                        "entry_id": "6bd4748a-645f-3ec9-90c2-71cabab7520d",
                                        "glosses": [
                                            "Remuer en masse confuse, abonder, pulluler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02b70ab8-b045-4803-8f02-2856ba84d731",
                                                "sense_id": "b8f63ec8-11cb-33b8-8b87-dcd510f1fcaa",
                                                "text": "Ce qui, autrefois, grouillait en bas, resplendit en haut aujourd’hui. Le domestique a jeté sa livrée à la tête de son maître et se pavane dans ses habits. Non seulement il est devenu son égal, mais il le domine."
                                            },
                                            {
                                                "example_id": "d82f02dc-005a-41c0-a031-360979d4aff5",
                                                "sense_id": "b8f63ec8-11cb-33b8-8b87-dcd510f1fcaa",
                                                "text": "Sale et productif comme le commerce, ce passage, toujours plein d’allants et de venants, de charrettes, de haquets, est d’un aspect repoussant, et la population qui y grouille est en harmonie avec les choses et les lieux."
                                            },
                                            {
                                                "example_id": "01d99375-57ff-433f-86c0-b88ea94ee695",
                                                "sense_id": "b8f63ec8-11cb-33b8-8b87-dcd510f1fcaa",
                                                "text": "S’approchant de la grille ouverte, Raoul constata que, dans le parc, grouillait tout un peuple d’ouvriers qui retournaient la terre des allées et des pelouses."
                                            },
                                            {
                                                "example_id": "41331bf5-9d5f-4abe-aa9f-1772d496fb26",
                                                "sense_id": "b8f63ec8-11cb-33b8-8b87-dcd510f1fcaa",
                                                "text": "Une foule serrée et bruyante grouillait dans les rues. Ce n’était que tarbouches, galabiehs toutes neuves aux fraîches couleurs, voiles noires de paysannes, châles rouges jaunes et oranges des fillettes, turbans et majestueuses robes des cheikhs."
                                            },
                                            {
                                                "example_id": "df080776-c1c5-4521-b39a-c893d49d18e1",
                                                "sense_id": "b8f63ec8-11cb-33b8-8b87-dcd510f1fcaa",
                                                "text": "La Syldavie risque en effet d’être annexée par son voisin bordure et l’entourage royal grouille d’espions ayant pour but de préparer le terrain avec un premier objectif : miner l’autorité royale en dérobant le symbole de sa légitimité, son sceptre, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42ffc499-28b4-3fd3-a31c-11202f4e4bed",
                                        "entry_id": "6bd4748a-645f-3ec9-90c2-71cabab7520d",
                                        "glosses": [
                                            "Être rempli d’une masse grouillante, en parlant d’une chose ou d’un lieu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "464ebdbc-3cc2-4e1c-8532-1d8f8f3e752c",
                                                "sense_id": "42ffc499-28b4-3fd3-a31c-11202f4e4bed",
                                                "text": "L’autre grande place de Parthenay, […], comme tous les mercredis grouillait de paysans en blouses bleues toutes neuves rêches comme des chasubles, de paysannes arborant sur leurs têtes leurs gâtinelles aux longs rubans de moire blanche, de maquignons, leurs fouets autour du cou, des bouviers, l’aiguillon à la main comme une lance, […]."
                                            },
                                            {
                                                "example_id": "ce643a00-fe5e-4ab1-873e-0ba39fd47d88",
                                                "sense_id": "42ffc499-28b4-3fd3-a31c-11202f4e4bed",
                                                "text": "La demeure des Lankabout est un authentique Olympe grouillant de dieux roturiers et de houris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a986593-bbe4-3c99-bfcc-457ec4941bdf",
                                        "entry_id": "6bd4748a-645f-3ec9-90c2-71cabab7520d",
                                        "glosses": [
                                            "ou Bouger, remuer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f03f1f0-48a8-45f4-a585-5f6718492a2f",
                                                "sense_id": "4a986593-bbe4-3c99-bfcc-457ec4941bdf",
                                                "text": "Cependant sa visite, assez insupportable, traîne en une longueur encore épouvantable ; et l’on demande l’heure, et l’on bâille vingt fois, qu’elle grouille aussi peu qu’une pièce de bois."
                                            },
                                            {
                                                "example_id": "3fee3fcc-cd57-4058-bab0-889bfcd41199",
                                                "sense_id": "4a986593-bbe4-3c99-bfcc-457ec4941bdf",
                                                "text": "— Blasphème ! je te ferai bien grouiller, moué…"
                                            },
                                            {
                                                "example_id": "431eb839-6909-4190-ae8f-ef9aa75ca736",
                                                "sense_id": "4a986593-bbe4-3c99-bfcc-457ec4941bdf",
                                                "text": "Si on s’arrête, les pieds s’embourbent, germent le temps de le dire, poussent des racines, plus moyen de grouiller."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "343870b4-e2c6-3fbf-91a7-d0015b908342",
                                        "entry_id": "6bd4748a-645f-3ec9-90c2-71cabab7520d",
                                        "glosses": [
                                            "Faire du bruit, gargouiller, en parlant des intestins, de l’abdomen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a455d628-f32f-46a6-90b8-e9f1e5e8bbb5",
                                                "sense_id": "343870b4-e2c6-3fbf-91a7-d0015b908342",
                                                "text": "J’ai le ventre qui grouille !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "465ee28d-9368-3cee-8ccd-604344fe77a7",
                                        "entry_id": "6bd4748a-645f-3ec9-90c2-71cabab7520d",
                                        "glosses": [
                                            "ou Se dépêcher."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "intransitive",
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21b75eb4-73cc-4e9f-91f2-97136e8bd9e6",
                                                "sense_id": "465ee28d-9368-3cee-8ccd-604344fe77a7",
                                                "text": "Compte tenu de la pluie qui était tombée, Misty avait sûrement laissé des dizaines de traces qui nous permettraient de remonter jusqu’à elle si on se grouillait un peu."
                                            },
                                            {
                                                "example_id": "c91ecf2e-872a-4abc-9b54-6a918efa6330",
                                                "sense_id": "465ee28d-9368-3cee-8ccd-604344fe77a7",
                                                "text": "Éreintés par une rude journée de travail les derniers oiseaux se grouillaient pour rentrer chez eux."
                                            },
                                            {
                                                "example_id": "c69146c9-96de-4ff6-a05f-cc0bdade8a92",
                                                "sense_id": "465ee28d-9368-3cee-8ccd-604344fe77a7",
                                                "text": "Vous avez intérêt à vous grouiller si vous ne voulez pas rater le train !"
                                            },
                                            {
                                                "example_id": "be5ebaec-d4f4-4239-96e5-2c199eb6dcdd",
                                                "sense_id": "465ee28d-9368-3cee-8ccd-604344fe77a7",
                                                "text": "Allez, grouille, il va faire nuit !"
                                            },
                                            {
                                                "example_id": "8938e8f6-0ac0-40cf-a7de-0089fe3993c8",
                                                "sense_id": "465ee28d-9368-3cee-8ccd-604344fe77a7",
                                                "text": "Grouille-toi de finir avant que le prof arrive."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a44e8685-8a61-4161-8e82-7511d14e4a84",
                        "source_entry_id": "f6981059-fac2-3aff-8be0-d9b2a47fc280",
                        "source_sense_id": "fb23054d-21c2-30f8-9442-64ff51254050",
                        "target_lang_word": "regorger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regorger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6da5bb28-d982-3cc0-b6fd-c0e2cfb5c502",
                                        "entry_id": "5e172ac5-bbdf-3060-b962-798ab9f7bfcf",
                                        "glosses": [
                                            "S’épancher hors de ses limites, en parlant de l’eau et des autres liquides."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3be43c6a-6206-4ba4-8a8c-91d7de353f34",
                                                "sense_id": "6da5bb28-d982-3cc0-b6fd-c0e2cfb5c502",
                                                "text": "Les pluies incessantes ont fait regorger la rivière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be8e675c-8ce8-3081-8cbe-d0a797b298fa",
                                        "entry_id": "5e172ac5-bbdf-3060-b962-798ab9f7bfcf",
                                        "glosses": [
                                            "Avoir une grande abondance de quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31d07f61-56ea-44ff-9106-24556b871ae2",
                                                "sense_id": "be8e675c-8ce8-3081-8cbe-d0a797b298fa",
                                                "text": "Ce n’est point tout : comme les animaux ne mouraient pas plus que les hommes, bientôt la terre regorgea tellement d’habitants, qu’elle ne put les nourrir ; il vint une horrible famine."
                                            },
                                            {
                                                "example_id": "5330cab5-df29-46ab-a20a-d85f28fed79d",
                                                "sense_id": "be8e675c-8ce8-3081-8cbe-d0a797b298fa",
                                                "text": "[…], après une autre étape de quatre heures, atteignons Souk El-Arbâ (le marché du mercredi), dans un cirque rocheux où les pluies ont formé de nombreux étangs regorgeant d’oiseaux aquatiques : canards, poules d'eau, bécassines, hérons, etc."
                                            },
                                            {
                                                "example_id": "a8b00857-a796-4e46-8a4b-13aedde25ac3",
                                                "sense_id": "be8e675c-8ce8-3081-8cbe-d0a797b298fa",
                                                "text": "Avignon, Carpentras, Cavaillon, regorgent, pour la malédiction des familles, de tripots où de grosses sommes sont à chaque instant risquées."
                                            },
                                            {
                                                "example_id": "fd75e7aa-3c29-4845-94eb-9e375fe2d571",
                                                "sense_id": "be8e675c-8ce8-3081-8cbe-d0a797b298fa",
                                                "text": "Les bistros regorgeaient d’hommes, de femmes endormis, que parfois le garçon réveillait pour qu’ils cédassent la place à de nouveaux venus."
                                            },
                                            {
                                                "example_id": "f8a7e697-8516-4799-9ce1-ac74dff813e4",
                                                "sense_id": "be8e675c-8ce8-3081-8cbe-d0a797b298fa",
                                                "text": "Que tu as de beaux champs d’orge,\nGiroflé, girofla\nTon verger de fruits regorge\nLe bon temps c’est là."
                                            },
                                            {
                                                "example_id": "e2d97e05-c927-4ea2-8512-d0c598941608",
                                                "sense_id": "be8e675c-8ce8-3081-8cbe-d0a797b298fa",
                                                "text": "L’église ce dimanche, regorge de gens […] qui ne l’appellent que pour les derniers sacrements, et qu’il oindra, à l'agonie, dans l’inconscience quasi totale, absous néanmoins de toutes leurs fautes."
                                            },
                                            {
                                                "example_id": "1edf1fe7-24f8-440d-8bb6-2f37fa00ae7a",
                                                "sense_id": "be8e675c-8ce8-3081-8cbe-d0a797b298fa",
                                                "text": "Regorger de santé, jouir d’une santé brillante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb2e8ffd-90be-3147-9d55-203e8ea589e2",
                                        "entry_id": "5e172ac5-bbdf-3060-b962-798ab9f7bfcf",
                                        "glosses": [
                                            "Être très abondant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da57898d-37ea-4935-9f8f-decb906c9ff5",
                                                "sense_id": "bb2e8ffd-90be-3147-9d55-203e8ea589e2",
                                                "text": "Les magasins regorgent dans la médina, mais ils ne sont par pour autant absents du Guéliz."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bf5d108-1bc8-324b-8fba-a54804663b78",
                                        "entry_id": "5e172ac5-bbdf-3060-b962-798ab9f7bfcf",
                                        "glosses": [
                                            "Retourner, restituer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1b6392d-7761-4565-a544-d2a85012624e",
                                                "sense_id": "7bf5d108-1bc8-324b-8fba-a54804663b78",
                                                "text": "Il regorgeait le mois courant les meubles du mois dernier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
