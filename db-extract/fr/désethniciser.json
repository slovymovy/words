                "senses": [
                    {
                        "sense_id": "f7a0a675-d105-3711-8f0f-c18ff2d65491",
                        "entry_id": "42bb1474-2053-3962-beab-303fea9ed6cb",
                        "glosses": [
                            "Faire perdre à quelque chose son caractère ethnique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdb93ec5-4067-473e-a8ff-10f5ceac4bd4",
                                "sense_id": "f7a0a675-d105-3711-8f0f-c18ff2d65491",
                                "text": "Nous avons vu dans l’introduction à ce colloque comment la pensée de l’historien archéologue avait contribué à « désethniciser » la réflexion sur la Grèce antique."
                            },
                            {
                                "example_id": "0b696794-e6e8-45da-90a8-3699ce2b133a",
                                "sense_id": "f7a0a675-d105-3711-8f0f-c18ff2d65491",
                                "text": "Il contribuera à éclaircir le paysage politique béninois, à favoriser la formation de grands blocs de courants de pensée politique, à désethniciser et déclaniser un temps soit peu la compétition électorale et surtout à stabiliser et renforcer la décision politique."
                            }
                        ]
                    }
