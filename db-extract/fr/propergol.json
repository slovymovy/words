                        "entry_id": "811874cc-76f9-3bc3-8133-ece4206a4223",
                        "glosses": [
                            "Produit de propulsion constitué d'un ou plusieurs ergols et apte à fournir par réaction chimique l'énergie de réaction mécanique d'un moteur-fusée."
                        ],
                        "tags": [
                            "Propulsion spatiale"
                        ],
                        "examples": [
                            {
                                "example_id": "4af26d50-e717-4175-99cb-b6e7b267988f",
                                "sense_id": "21207803-1c29-3e8c-8907-2a6c8d13bd83",
                                "text": "Stock et Ludo étaient aussi présents, silencieux, fermés, aussi compacts que des blocs de propergol."
                            },
                            {
                                "example_id": "c1c7b16d-eba3-4e56-921d-911e5e9a3fe1",
                                "sense_id": "21207803-1c29-3e8c-8907-2a6c8d13bd83",
                                "text": "L’agence a précisé que, à la suite d’une éclipse survenue en avril, la sonde ayant été coupée de la lumière du soleil, son « propergol a dû s’épuiser »."
                            }
                        ]
                    }
