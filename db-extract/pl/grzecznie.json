                                    {
                                        "sense_id": "2e68c249-9e85-3ff4-88f8-7cfa48ecf743",
                                        "entry_id": "734fc948-234b-35ef-8430-7d1013013b5d",
                                        "glosses": [
                                            "in a polite manner"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c52fb8b-7166-4ff0-a313-7adb11718c3a",
                                                "sense_id": "2e68c249-9e85-3ff4-88f8-7cfa48ecf743",
                                                "text": "If pressed about a serious accusation like rape, you can politely reply that you can’t answer questions pertaining to such an allegation without legal representation and wish to remain silent."
                                            },
                                            {
                                                "example_id": "5148b910-1d48-4c7e-a82b-988edb0f59d9",
                                                "sense_id": "2e68c249-9e85-3ff4-88f8-7cfa48ecf743",
                                                "text": "It was night once more and Mary had got through another day without throwing herself politely from a top floor window or scrawling filthy words on the dining room walls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29c0eb0f-4f9d-4d81-9ec9-7539b96432dc",
                        "source_entry_id": "69d91e2e-67cc-3bd5-ab50-2404915a6ea9",
                        "source_sense_id": "f180e623-d8e9-33d7-a8da-492753690fff",
                        "target_lang_word": "nicely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nicely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c725bb73-a647-31c6-a632-3b8c7f8e80b5",
                                        "entry_id": "dcf87a45-ba16-3e5d-a12f-31f1cb27e6a3",
                                        "glosses": [
                                            "Fastidiously; carefully."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "118ab2ae-c44d-4324-bca5-d56c20a1e271",
                                                "sense_id": "c725bb73-a647-31c6-a632-3b8c7f8e80b5",
                                                "text": "He lookt askew with his mistrustfull eyes, / And nicely trode, as thornes lay in his way, / Or that the flore to shrinke he did auyse [...]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f77559a-f86c-3821-b2c7-ac9a0d17302c",
                                        "entry_id": "dcf87a45-ba16-3e5d-a12f-31f1cb27e6a3",
                                        "glosses": [
                                            "Precisely; with fine discernment or judgement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de7a8b63-fa1f-4f28-9c41-26a51a259aba",
                                                "sense_id": "8f77559a-f86c-3821-b2c7-ac9a0d17302c",
                                                "text": "All told, we had scarce two miles to run; but the navigation was delicate, the entrance to this northern anchorage was not only narrow and shoal, but lay east and west, so that the schooner must be nicely handled to be got in."
                                            },
                                            {
                                                "example_id": "b5f1a56e-bbc9-4ed3-bf66-c226b9905389",
                                                "sense_id": "8f77559a-f86c-3821-b2c7-ac9a0d17302c",
                                                "text": "An army – especially in peace time – is a very complex and nicely adjusted affair […]."
                                            },
                                            {
                                                "example_id": "3ddff41e-e319-41b1-9b55-38d86f332f03",
                                                "sense_id": "8f77559a-f86c-3821-b2c7-ac9a0d17302c",
                                                "text": "Henry's carefully calibrated public appearances would present him as the wellspring of honour, justice and power, the unknowable, all-seeing sovereign who, as the Milanese ambassador Soncino nicely observed, appeared in public ‘like one at the top of a tower looking on at what is passing in the plain’."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc27262-758c-3286-8b32-c49bf7960468",
                                        "entry_id": "dcf87a45-ba16-3e5d-a12f-31f1cb27e6a3",
                                        "glosses": [
                                            "Pleasantly; satisfactorily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47e344ec-c512-45cf-9e14-5956279e4cb8",
                                                "sense_id": "4dc27262-758c-3286-8b32-c49bf7960468",
                                                "text": "1986-1987, Lou Sullivan, personal diary, quoted in 2019, Ellis Martin, Zach Ozma (editors), We Both Laughed In Pleasure\nHe was a sweet boy, but became the kind of man I can do nicely without."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8af89431-0fa8-46e2-a2a9-6de920bb9c31",
                        "source_entry_id": "69d91e2e-67cc-3bd5-ab50-2404915a6ea9",
                        "source_sense_id": "f180e623-d8e9-33d7-a8da-492753690fff",
                        "target_lang_word": "courteously",
