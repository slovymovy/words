                    },
                    {
                        "sense_id": "3d0a9fa5-f814-36c5-8b3c-29a992caaa9a",
                        "entry_id": "0d650a90-4bb6-36dc-9ef1-af3fc7f2425f",
                        "glosses": [
                            "An igneous rock composed of feldspar and hornblende."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "d0f21599-f3c9-4543-b9d6-b73de488de8d",
                                "sense_id": "3d0a9fa5-f814-36c5-8b3c-29a992caaa9a",
                                "text": "The temple, of which some massive hewn blocks and a fine column of Syenite granite still mark the site, occupied a terrace facing the source of the river and commanding a magnificent prospect."
                            },
                            {
                                "example_id": "081d9b66-8498-400f-8910-dac8e815af43",
                                "sense_id": "3d0a9fa5-f814-36c5-8b3c-29a992caaa9a",
                                "text": "Much of the southern half of the southeastern body is a mafic syenite, slightly more felsic than the shonkinite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a18e7c7-85b9-4b23-8d5a-3d9007e8c55a",
                        "source_entry_id": "0d650a90-4bb6-36dc-9ef1-af3fc7f2425f",
                        "source_sense_description": "igneous rock composed of feldspar and hornblende",
                        "target_lang_word": "syénite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "syénite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cfe05919-3d98-3a95-8f10-0bdf04e0bdc3",
                                        "entry_id": "64060a85-1a42-3805-9749-b20a314fe86d",
                                        "glosses": [
                                            "Roche plutonique, rose, composé grenu de feldspath alcalin, de biotite et de hornblende ; granite dépourvu de quartz."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2928f70-af86-49d7-a5b1-9371f933f659",
                                                "sense_id": "cfe05919-3d98-3a95-8f10-0bdf04e0bdc3",
                                                "text": "[…] ; et entre ce dernier chemin et la source minérale, de la syénite, diorite et felsite gris-bleuâtre, contenant des grains de mica, sont recouvertes par du grès meulier et du calcaire carbonifère. A la source minérale, la syénite est coupée par un dyke de felsite gris-bleuâtre de deux pieds d'épaisseur."
                                            },
                                            {
                                                "example_id": "f1251ee9-070d-469e-a4da-36b5435b5516",
                                                "sense_id": "cfe05919-3d98-3a95-8f10-0bdf04e0bdc3",
                                                "text": "À Rome, l’obélisque en syénite situé au centre de la place du Vatican avait été transporté d’Héliopolis par Caligula pour décorer la spina du cirque de Néron."
                                            },
                                            {
                                                "example_id": "7daeda64-b6ec-479b-8db7-cc9e8ba51c19",
                                                "sense_id": "cfe05919-3d98-3a95-8f10-0bdf04e0bdc3",
                                                "text": "En ce qui concerne plus particulièrement la syénite erratique, les observations de M. MEYER [107] ont montré que cette roche dispersée en « éventail » à partir de « l'île vosgienne » a suivi différents itinéraires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
