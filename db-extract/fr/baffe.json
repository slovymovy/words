                    {
                        "sense_id": "495690fb-0ddc-3c9a-b784-e1f3a595e59c",
                        "entry_id": "e849bced-d299-38ba-8d06-a2899d16a574",
                        "glosses": [
                            "klap, optater"
                        ],
