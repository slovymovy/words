                {
                    "sense_id": "c80b9683-c13b-3f83-a7a0-de75b29e88d6",
                    "sense_definition": "Trahir quelqu'un ou livrer un secret par intérêt, déloyauté ou lâcheté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "trahison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le complice a fini par <w>vendre</w> ses associés à la police.",
                            "target_lang_translations": {
                                "en": "The accomplice eventually <w>betrayed</w> his associates to the police.",
                                "ru": "Соучастник в конце концов <w>выдал</w> своих сообщников полиции.",
                                "nl": "De handlanger heeft zijn medeplichtigen uiteindelijk aan de politie <w>verraden</w>.",
                                "de": "Der Komplize hat seine Mittäter schließlich an die Polizei <w>verraten</w>.",
                                "pl": "Wspólnik w końcu <w>wydał</w> policji swoich kompanów.",
                                "it": "Alla fine il complice <w>ha venduto</w> i suoi soci alla polizia.",
                                "cs": "Spolupachatel nakonec své komplice policii <w>udal</w>.",
                                "tr": "Suç ortağı sonunda ortaklarını polise <w>ele verdi</w>.",
                                "es": "El cómplice acabó por <w>delatar</w> a sus socios ante la policía.",
                                "zh": "这个同案犯最终还是把同伙们<w>出卖</w>给了警方。"
                            }
                        },
                        {
                            "text": "Ils pensaient pouvoir lui faire confiance, mais il les a <w>vendus</w> sans hésiter.",
                            "target_lang_translations": {
                                "en": "They thought they could trust him, but he <w>betrayed</w> them without hesitation.",
                                "ru": "Они думали, что могут ему доверять, но он без колебаний <w>предал</w> их.",
                                "nl": "Ze dachten hem te kunnen vertrouwen, maar hij heeft hen zonder aarzelen <w>verraden</w>.",
                                "de": "Sie dachten, sie könnten ihm vertrauen, aber er hat sie ohne zu zögern <w>verraten</w>.",
                                "pl": "Myśleli, że mogą mu ufać, ale on bez wahania ich <w>zdradził</w>.",
                                "it": "Pensavano di potersi fidare di lui, ma li <w>ha traditi</w> senza esitare.",
                                "cs": "Mysleli, že mu mohou věřit, ale on je bez váhání <w>zradil</w>.",
                                "tr": "Ona güvenebileceklerini düşünüyorlardı, ama o hiç tereddüt etmeden onları <w>sattı</w>.",
                                "es": "Creían que podían confiar en él, pero los <w>traicionó</w> sin dudarlo.",
                                "zh": "他们以为可以信任他，可他毫不犹豫地<w>背叛</w>了他们。"
                            }
                        }
