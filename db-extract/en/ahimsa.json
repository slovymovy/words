                "senses": [
                    {
                        "sense_id": "926483d6-bcf2-3160-84e2-bc03a6ee1e75",
                        "entry_id": "7acefe68-acfb-3012-a8f4-d0bb9053b151",
                        "glosses": [
                            "A doctrine of non-violence, concerned with the sacredness of all living things and an effort to avoid causing harm to them."
                        ],
                        "tags": [
                            "Hinduism",
                            "Jainism",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "72d5c243-7ddd-4d5c-8f88-b9d6304f61fa",
                                "sense_id": "926483d6-bcf2-3160-84e2-bc03a6ee1e75",
                                "text": "Already, at this very early date, the ritualists were moving towards the ideal of ahimsa (\"harmlessness\") that would become the indispensable virtue of the Indian Axial Age."
                            },
                            {
                                "example_id": "9710c398-2a47-450e-b7a3-54c252af854b",
                                "sense_id": "926483d6-bcf2-3160-84e2-bc03a6ee1e75",
                                "text": "This, in essence, is the Jain doctrine of ahimsa – a direct inversion of Vedic beliefs about the sustaining powers of animal sacrifice."
                            }
                        ]
                    }
                ],
