                                    {
                                        "sense_id": "9ee5a8a0-7c0e-3884-89ab-09b96a78a65c",
                                        "entry_id": "9c57434d-1e11-3256-9932-ee02909c0936",
                                        "glosses": [
                                            "voorwerp, materiaal of oppervlak dat ziekteverwekker kan overdragen tussen besmette wezens\\nEen levend wezen dat zelf niet besmet raakt, maar een ziektekiem via huid of vacht overdraagt kan ook als een fomiet worden beschouwd."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d0d984a-d602-4c82-83d0-b47fac002415",
                                                "sense_id": "9ee5a8a0-7c0e-3884-89ab-09b96a78a65c",
                                                "text": "Mijn suggestie is dat we op zoek gaan naar een fomiet. 'Een non-organische ziekteoverbrenger,' verhelderde Odhiambo."
                                            },
                                            {
                                                "example_id": "0a6603d2-f386-48c2-b4f5-76416081ed09",
                                                "sense_id": "9ee5a8a0-7c0e-3884-89ab-09b96a78a65c",
                                                "text": "Fomieten zijn voorwerpen of substanties waarop ziekteverwekkers kunnen zitten en die de ziekteverwekkers ook kunnen overdragen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
