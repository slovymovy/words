                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6bd9b9ee-fc1a-481b-9dd5-7c1999b57ef1",
                                "sense_id": "420dda28-abcc-3760-84e5-7ffe07c28d64",
                                "text": "Serious as was the flood damage in England, the bursting of some of the dykes on the coast of Holland resulted in an even more widespread and devastating inundation."
                            },
                            {
                                "example_id": "f5bb127e-d9ef-4153-8588-e0dcf918c364",
                                "sense_id": "420dda28-abcc-3760-84e5-7ffe07c28d64",
                                "text": "“The whole world has a stake in maintaining peace and stability in the Taiwan Strait. The security of commercial shipping lanes and global supply chains depends on it. And so does freedom of navigation worldwide. Make no mistake: conflict in the Taiwan Strait would be devastating.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8f72496-af3f-4fa4-bcea-6b5731810ef2",
                        "source_entry_id": "a9dce8f3-4975-341b-9d35-88aa68108c61",
                        "source_sense_id": "420dda28-abcc-3760-84e5-7ffe07c28d64",
                        "source_sense_description": "causing devastation",
                        "target_lang_word": "dévastateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
