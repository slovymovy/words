                                                "example_id": "183c7a8b-b969-46f3-9a8c-a598fb52589b",
                                                "sense_id": "4112716f-bc4b-3dad-97b8-19933a58a474",
                                                "text": "Payer tant pour le plombage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8467736-821c-39a2-9b7b-d07dcf9c4fef",
                                        "entry_id": "fb1cb785-b08c-31f2-aa79-2f02c01ed4e4",
                                        "glosses": [
                                            "Remplissage, avec un amalgame dentaire, qui autrefois contenait du plomb, de la cavité d’une dent cariée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9807c280-c93a-4d89-980e-fa8bc4e58516",
                                                "sense_id": "e8467736-821c-39a2-9b7b-d07dcf9c4fef",
                                                "text": "Le plombage des dents."
                                            },
                                            {
                                                "example_id": "6b05aed2-35be-45b6-8841-19862d303f77",
                                                "sense_id": "e8467736-821c-39a2-9b7b-d07dcf9c4fef",
                                                "text": "J’étais en effet experte dans la reprise de caries sous plombage, ce qui finissait par une dent dévitalisée, donc fragilisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "322fea7c-d25b-3023-9f21-b6c8024d19e9",
                                        "entry_id": "fb1cb785-b08c-31f2-aa79-2f02c01ed4e4",
