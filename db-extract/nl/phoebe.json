                                "sense_id": "788e76c4-25fc-3d27-b8c5-caafcd3bc483",
                                "text": "Zes series moesten Senna Antonisse, Evi Goedendorp, Dyanne de Waardt, Anna Zuchowska, Phoebe Jansen, Veerle Ribbens en Shanna Huisman in rap tempo achter elkaar springen."
                            }
                        ]
                    },
                    {
                        "sense_id": "32537c8f-3b8a-32e7-bba6-55f278e7c00a",
                        "entry_id": "01d41ee2-863d-3b55-b8e7-ed425532787b",
                        "glosses": [
                            "een van de manen die rond de planeet Saturnus draaien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1180afb4-5625-4a96-b176-20521814c80d",
                                "sense_id": "32537c8f-3b8a-32e7-bba6-55f278e7c00a",
                                "text": "Uit gegevens van de ruimtesonde Cassini blijkt dat de kleine Saturnusmaan Phoebe meer planeetachtige kenmerken vertoont dan tot nu toe werd gedacht."
                            }
                        ]
