                        "examples": [
                            {
                                "example_id": "557ec95a-83a1-4ee8-b105-ae9c8d272103",
                                "sense_id": "e91cfec6-51de-310e-a31f-5dc8047e1f52",
                                "text": "One moment the retailer of tea, sugar, rum, and tobacco; the next, the ebriate solace of her ebriate mate."
                            },
                            {
                                "example_id": "47880440-a549-4e78-b5f0-6fb4bd66d16c",
                                "sense_id": "e91cfec6-51de-310e-a31f-5dc8047e1f52",
                                "text": "Acme then her head reflecting, Kiss'd her sweet youth's ebriate eyes, With her rosy lips connecting Looks that glistened with replies."
                            },
                            {
                                "example_id": "df7c0997-6c8c-451c-b0a6-62c9fdeb63e6",
                                "sense_id": "e91cfec6-51de-310e-a31f-5dc8047e1f52",
                                "text": "Here before lords of the brain, why and till when, foolishly vain, Sett'st thou forth, crown of the feast, drunkard, thy soft ebriate strain?"
                            }
                        ]
                    }
