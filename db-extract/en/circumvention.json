                        "sense_id": "24513de8-bafa-3ba0-989f-61c9375924fe",
                        "entry_id": "62a644f8-f392-376a-8e0a-9de9596913c1",
                        "glosses": [
                            "The act of prevailing over another by fraud or deception."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f3ad96a0-5525-460c-932f-653c89c0fd51",
                                "sense_id": "24513de8-bafa-3ba0-989f-61c9375924fe",
                                "text": "a school in which he learns sly circumvention"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0936707a-2ef0-4093-8a1e-358b0dd3444d",
                        "source_entry_id": "62a644f8-f392-376a-8e0a-9de9596913c1",
                        "source_sense_description": "bypassing",
                        "target_lang_word": "Umgehung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umgehung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1513fb9-95fe-3e33-81db-15f5029ab9d2",
                                        "entry_id": "a7649eb6-4d1d-397e-b22d-aaa737be3464",
                                        "glosses": [
                                            "im Bogen ein Hindernis umfahren, umlaufen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a17e9d8a-8dbc-4ed2-a0cc-1e71c65b030f",
                                                "sense_id": "b1513fb9-95fe-3e33-81db-15f5029ab9d2",
                                                "text": "„Noch während Römer und Makedonen sich bekämpften, unterwarf er im Jahr 197 v.Chr. einen Teil Lykiens mit der Stadt Xanthos, zog dann weiter nach Westen und Norden, wo er, unter Umgehung der rhodischen und pergamenischen Besitzungen in Kleinasien, Ephesos einnahm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c9d7c80-33aa-3b2a-9dac-481199c4195a",
                                        "entry_id": "a7649eb6-4d1d-397e-b22d-aaa737be3464",
                                        "glosses": [
                                            "Vermeidung einer unangenehme Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "54edfb81-7cfe-40de-8473-b273564f7eb0",
                                                "sense_id": "7c9d7c80-33aa-3b2a-9dac-481199c4195a",
                                                "text": "Unter Umgehung einer direkten Konfrontation hat man das Problem dadurch gelöst, dass die Parteien durch Stellvertreter miteinander konferierten."
                                            },
                                            {
                                                "example_id": "e13193ce-95fc-4c84-aa51-73001b6f08b9",
                                                "sense_id": "7c9d7c80-33aa-3b2a-9dac-481199c4195a",
                                                "text": "„Marando war der erste, der direkt mit den kolumbianischen Drogenkartellen verhandelte, unter Umgehung sämtlicher Mittelsmänner – was den Profit der Mafia weiter nach oben schraubte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "86639c46-d851-3a3d-9bcd-862379b11df2",
                                        "entry_id": "a7649eb6-4d1d-397e-b22d-aaa737be3464",
                                        "glosses": [
                                            "Missachtung einer Vorschrift"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b07bd18a-4687-4196-a900-50661b2fce05",
                                                "sense_id": "86639c46-d851-3a3d-9bcd-862379b11df2",
                                                "text": "Sie ist unter Umgehung des Zutrittsverbots durch die offene Terrassentür in das Haus eingedrungen."
                                            },
                                            {
                                                "example_id": "50a97425-a435-412f-9f85-447ab52d690e",
                                                "sense_id": "86639c46-d851-3a3d-9bcd-862379b11df2",
                                                "text": "„Beide Methoden – Eigenkapital und Staatskredite – riechen schon von Weitem nach Umgehung der verfassungsrechtlichen Schuldenbremse.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "f7cd042a-07ee-3359-9276-971b37a49b8c",
                                        "entry_id": "a7649eb6-4d1d-397e-b22d-aaa737be3464",
                                        "glosses": [
                                            "Umgehungsstraße"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14d4f980-8609-499a-9bb4-bd8496bac633",
                                                "sense_id": "f7cd042a-07ee-3359-9276-971b37a49b8c",
                                                "text": "Jetzt soll die Umgehung ja doch gebaut werden, hat mir letztens mein Vater erzählt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
