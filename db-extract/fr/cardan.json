                                        "entry_id": "17c2b98f-d534-30af-a831-407c60be5c9e",
                                        "glosses": [
                                            "To suspend using a gimbal or gimbals."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4eeb5da9-54e5-4b2c-95bf-8c867d6e0ff0",
                                                "sense_id": "cf0b8711-832d-3f5c-bd71-10cc96b4bc8f",
                                                "text": "1918, Richard Dehan (Clotilde Graves), That Which Hath Wings, New York: G.P. Putnam’s Sons, Chapter 32,\n[…] he conned his course in masterly fashion by aid of the roller-map, protected by its transparent, rainproof casing, or the compass, clock, altimeter, and other instruments gimballed in the wooden frame in front of the pilot’s seat."
                                            }
                                        ]
                                    },
