                                "target_senses": [
                                    {
                                        "sense_id": "0c67709c-5528-3c2a-a79a-6908882bccc9",
                                        "entry_id": "62e5e15b-0051-3c0c-af66-2ef84d4044c5",
                                        "glosses": [
                                            "nahezu rund; von runden Formen geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1406ed2d-d70a-4f46-9489-7b2e5ed2cb8f",
                                                "sense_id": "0c67709c-5528-3c2a-a79a-6908882bccc9",
                                                "text": "Im Kinderzimmer sind alle Kanten rundlich."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f83693ee-5aa1-3a14-9343-a7f8288e99b0",
                                        "entry_id": "62e5e15b-0051-3c0c-af66-2ef84d4044c5",
                                        "glosses": [
                                            "ein wenig dick"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3824d022-43c9-4465-aeb9-8e68ce2e11f6",
                                                "sense_id": "f83693ee-5aa1-3a14-9343-a7f8288e99b0",
                                                "text": "Eine rundliche Frau begrüßte uns auf dem Fischmarkt."
                                            },
                                            {
                                                "example_id": "660dd9f5-2681-40ca-8774-508e1d744414",
                                                "sense_id": "f83693ee-5aa1-3a14-9343-a7f8288e99b0",
                                                "text": "„Endlich kam eine elegante, rundliche Dame mittleren Alters und führte ihn durch eine Flucht von Büros zu der Suite des Produzenten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4c86f85-8f0f-42cc-a0f4-accfd240dc63",
                        "source_entry_id": "7cf11868-42ec-3505-bef3-cbcaf8537ca7",
