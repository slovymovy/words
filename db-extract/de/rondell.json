                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "227669cd-43a5-3aed-b159-a1900ae4411d",
                        "entry_id": "b7d66d0d-8a2c-350f-b332-e0b970fae036",
                        "glosses": [
                            "halbkreisförmiges Erdwerk an den Festungsecken, aus dem sich die Bastion entwickelte"
                        ],
                        "tags": [
                            "Festungsbau",
                            "abgeleitet"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "132ff421-0f12-3902-9572-740cf6fb72c5",
                        "entry_id": "b7d66d0d-8a2c-350f-b332-e0b970fae036",
                        "glosses": [
                            "Rundbau oder auch runder Platz"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "d894ffd6-b8c1-493d-b8a4-b6380c244294",
                                "sense_id": "132ff421-0f12-3902-9572-740cf6fb72c5",
                                "text": "„Die Admiralstraße, die am Rondell des Kottbuser Tores beginnt, trifft im Südwesten auf den Landwehrkanal; […]“"
                            },
                            {
                                "example_id": "df8e5e2e-6437-4b16-acfa-7ceb44f3c084",
                                "sense_id": "132ff421-0f12-3902-9572-740cf6fb72c5",
                                "text": "„Sie schoben ihre Fahrräder um das Rondell herum und gingen hinüber zum Marktplatz.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "0a3f3900-6bac-33b7-adaa-0a57c910c57e",
                        "entry_id": "b7d66d0d-8a2c-350f-b332-e0b970fae036",
                        "glosses": [
                            "kreisförmige Gartenanlage wie z.B. ein Zierbeet"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "488f2ead-8bfd-4a6f-9cbb-4a92af8817ad",
                                "sense_id": "0a3f3900-6bac-33b7-adaa-0a57c910c57e",
                                "text": "„Rolf liegt vor dem Rondell im Gras, das Gesicht nach unten, sein Smart-Phone und zwei Weinflaschen neben sich.“"
                            },
                            {
                                "example_id": "8828ae4b-7037-41c1-b41e-da397f3ac10e",
                                "sense_id": "0a3f3900-6bac-33b7-adaa-0a57c910c57e",
                                "text": "„Und ein Windstoß, der eben in das große, mit Zentifolien dicht besetzte Rondell gefahren war, trieb eine Wolke von Rosenblättern auf Cécile zu.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
