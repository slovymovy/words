                "senses": [
                    {
                        "sense_id": "d37e0ab7-fb78-3a6c-947f-e10108146c8d",
                        "entry_id": "6756db3c-6345-3de6-8a65-472151e8db5b",
                        "glosses": [
                            "To play mean tricks; to act shabbily."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7f08ebbe-1e92-39b4-af77-35cbd00575e7",
                        "entry_id": "6756db3c-6345-3de6-8a65-472151e8db5b",
                        "glosses": [
                            "To move (something, away or out of the way), to drive off."
                        ],
                        "tags": [
                            "UK",
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f70b8822-7a85-4d3c-a4b3-7bdfd44e4fb4",
                                "sense_id": "7f08ebbe-1e92-39b4-af77-35cbd00575e7",
                                "text": "Certain Nipnets intended to have sheltred themselves under Vncas; but he perceiving it would be distastful to the English, soon shab'd them off."
                            },
                            {
                                "example_id": "232a99db-e707-44e3-969d-6d6aabef3579",
                                "sense_id": "7f08ebbe-1e92-39b4-af77-35cbd00575e7",
                                "text": "I have shabb'd him off purely."
                            },
                            {
                                "example_id": "0867fbc0-0b4c-4761-8eff-38da81ac8d52",
                                "sense_id": "7f08ebbe-1e92-39b4-af77-35cbd00575e7",
                                "text": "They shab'd […] Thomas aff to hell."
                            },
                            {
                                "example_id": "0c5282f5-73a6-463f-8192-79140cca47b0",
                                "sense_id": "7f08ebbe-1e92-39b4-af77-35cbd00575e7",
                                "text": "[…] but when that [money] was gone, and he had not as much ground, that he could call his own, as would sod a lark, they soon shabbed him off."
                            },
                            {
                                "example_id": "474e9d16-1769-4186-8639-79ef048aaab7",
                                "sense_id": "7f08ebbe-1e92-39b4-af77-35cbd00575e7",
                                "text": "I hold the people in too much esteem, to shab them off with any thing of a secondary quality, whilst Providence has blessed me with the means of providing them the best."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f69cf17-2c3a-3883-b896-4a2b014681af",
                        "entry_id": "6756db3c-6345-3de6-8a65-472151e8db5b",
                        "glosses": [
                            "To skulk or sneak away."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "2b6435b2-f7ad-420d-8ea2-24fac126cbc1",
                                "sense_id": "1f69cf17-2c3a-3883-b896-4a2b014681af",
                                "text": "[…] and so the fat Parson shabb'd off,[…]"
                            },
                            {
                                "example_id": "ffdac0a0-6b62-4c7b-ab90-f5364285ff06",
                                "sense_id": "1f69cf17-2c3a-3883-b896-4a2b014681af",
                                "text": "We bided a moment as the push we were part of moved forward and took the opportunity to slip deftly back through it, thus shabbing off from our prey."
                            }
                        ]
                    }
