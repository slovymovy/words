{
    "word_family": [
        "thrifty",
        "thriftless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "abe5ef8c-81b1-3f15-87cd-758f9ea9483a",
                    "sense_definition": "The quality of using money or resources carefully and without waste.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "economy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>thrift</w> allowed her to save enough money for a comfortable retirement.",
                            "target_lang_translations": {
                                "cs": "Její <w>spořivost</w> jí umožnila ušetřit dost peněz na pohodlný důchod."
                            }
                        },
                        {
                            "text": "The family practiced <w>thrift</w> by growing their own vegetables and repairing old clothes.",
                            "target_lang_translations": {
                                "cs": "Rodina praktikovala <w>hospodárnost</w> tím, že si pěstovala vlastní zeleninu a opravovala staré oblečení."
                            }
                        }
                    ],
                    "synonyms": [
                        "frugality"
                    ],
                    "antonyms": [
                        "spendthrift"
                    ],
                    "common_phrases": [
                        "practice thrift"
                    ],
                    "target_lang_definitions": {
                        "cs": "Vlastnost spočívající v pečlivém a neplýtvavém nakládání s penězi nebo zdroji."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spořivost",
                                "target_lang_sense_clarification": "vlastnost šetřit penězi či zdroji"
                            },
                            {
                                "target_lang_word": "hospodárnost",
                                "target_lang_sense_clarification": "schopnost nakládat s prostředky efektivně"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be86c85f-cef3-32ca-82d1-7cb3d6941666",
                    "sense_definition": "A financial institution that primarily accepts savings deposits and makes mortgage loans.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "economy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many local <w>thrifts</w> were converted into commercial banks during the financial crisis.",
                            "target_lang_translations": {
                                "cs": "Mnoho místních <w>spořitelních družstev</w> bylo během finanční krize přeměněno na komerční banky."
                            }
                        },
                        {
                            "text": "The small <w>thrift</w> offered lower interest rates on home loans than the national banks.",
                            "target_lang_translations": {
                                "cs": "Malá <w>spořitelna</w> nabízela nižší úrokové sazby u úvěrů na bydlení než národní banky."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Finanční instituce, která přijímá vklady a poskytuje hypoteční úvěry."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "spořitelní družstvo",
                                "target_lang_sense_clarification": "instituce zaměřená na vklady a úvěry"
                            },
                            {
                                "target_lang_word": "spořitelna",
                                "target_lang_sense_clarification": "obecný název pro instituci zaměřenou na spoření"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5a954c5-f7a8-30ac-aac0-a35d18c56dfa",
                    "sense_definition": "Prosperity or success in gaining wealth or property.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "economy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He hoped that his new business venture would bring him great <w>thrift</w>.",
                            "target_lang_translations": {
                                "cs": "Doufal, že mu jeho nový podnikatelský záměr přinese velkou <w>prosperitu</w>."
                            }
                        },
                        {
                            "text": "The merchant sought <w>thrift</w> through his extensive trade routes across the sea.",
                            "target_lang_translations": {
                                "cs": "Obchodník hledal <w>zmožení se</w> prostřednictvím svých rozsáhlých obchodních cest přes moře."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely outdated in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Prosperita nebo úspěch při získávání bohatství či majetku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "prosperita",
                                "target_lang_sense_clarification": "úspěšný rozvoj a bohatství"
                            },
                            {
                                "target_lang_word": "zmožení se",
                                "target_lang_sense_clarification": "zastaralý výraz pro nabytí majetku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b0e202a-c34d-34c7-a27b-ab5a208bd253",
                    "sense_definition": "A type of coastal plant with small pink or white flowers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rocky cliffs were covered in patches of pink <w>thrift</w>.",
                            "target_lang_translations": {
                                "cs": "Skalnaté útesy byly pokryty trsy růžové <w>trávničky</w>."
                            }
                        },
                        {
                            "text": "Sea <w>thrift</w> is a hardy plant that thrives in salty coastal environments.",
                            "target_lang_translations": {
                                "cs": "<w>Trávnička</w> přímořská je odolná rostlina, které se daří ve slaném pobřežním prostředí."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pobřežní rostlina s malými růžovými nebo bílými květy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "trávnička",
                                "target_lang_sense_clarification": "rod rostlin (Armeria) rostoucích na pobřeží"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4969d63-f6e3-3c7a-a816-448f38d3062a",
                    "sense_definition": "The state of growing vigorously and healthily.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener was pleased with the <w>thrift</w> of the young seedlings in the greenhouse.",
                            "target_lang_translations": {
                                "cs": "Zahradník byl potěšen <w>bujností</w> mladých sazenic ve skleníku."
                            }
                        },
                        {
                            "text": "Proper soil conditions are essential for the <w>thrift</w> of these delicate flowers.",
                            "target_lang_translations": {
                                "cs": "Správné půdní podmínky jsou nezbytné pro <w>prospívání</w> těchto křehkých květin."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Stav bujného a zdravého růstu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "bujnost",
                                "target_lang_sense_clarification": "stav zdravého a silného růstu rostlin"
                            },
                            {
                                "target_lang_word": "prospívání",
                                "target_lang_sense_clarification": "dobrý stav a vývoj"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e8e925a6-2afa-3052-b66b-745c18f6ef5d",
                    "sense_definition": "To shop for second-hand items at a store that sells donated goods.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shopping",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I love to <w>thrift</w> on weekends to find unique vintage clothing.",
                            "target_lang_translations": {
                                "cs": "O víkendech ráda <w>nakupuji v sekáčích</w>, abych našla unikátní vintage oblečení."
                            }
                        },
                        {
                            "text": "She <w>thrifted</w> a beautiful wooden chair for only five dollars.",
                            "target_lang_translations": {
                                "cs": "V sekáči <w>ulovila</w> krásnou dřevěnou židli za pouhých pět dolarů."
                            }
                        }
                    ],
                    "common_phrases": [
                        "go thrifting"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Commonly used in informal contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nakupování zboží z druhé ruky v obchodech s darovaným zbožím."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nakupovat v sekáči",
                                "target_lang_sense_clarification": "neformální výraz pro nákup v obchodech s obnošeným zbožím"
                            },
                            {
                                "target_lang_word": "shánět v second handu",
                                "target_lang_sense_clarification": "hledání unikátních kousků v obchodech s použitým zbožím"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
