                                "example_id": "826895e0-8b77-4388-a93e-224108708e79",
                                "sense_id": "c9004f4d-f4d9-3c8b-aec9-32f3439fc802",
                                "text": "„Der frühere Slalomweltmeister Manfred Pranger hat einen Schlussstrich gezogen und am Freitag in Innsbruck unter Tränen sein Karriereende bekanntgegeben.“"
                            },
                            {
                                "example_id": "a55679a8-490f-44ad-a090-3e0c144f2447",
                                "sense_id": "c9004f4d-f4d9-3c8b-aec9-32f3439fc802",
                                "text": "„25 Jahre nach Ingemar Stenmark ist es Mario Matt, dem Champion von 2001, zum zweiten Mal in seiner Karriere gelungen, Slalomweltmeister zu werden.“"
                            }
                        ],
