                ],
                "senses": [
                    {
                        "sense_id": "0cd8800b-1bed-344e-bf30-ba20d5dd054e",
                        "entry_id": "e9230607-c69d-3da6-9fca-fce520539993",
                        "glosses": [
                            "gezielte körperliche Aktivität oder Haltung, die der Förderung von Gesundheit, Beweglichkeit, Entspannung oder ähnlichen Zielen dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "290e310e-bf9d-47dc-bd02-def81298a42d",
                                "sense_id": "0cd8800b-1bed-344e-bf30-ba20d5dd054e",
                                "text": "„Wir nutzen dabei Selbsterfahrung, Körperübungen, Naturerfahrungen, Tanz, spirituelle Elemente, Trance- und Vorstellungsreisen, Zeremonien/Rituale, theoretische Inspirationen und den Austausch untereinander.“"
                            },
                            {
                                "example_id": "72b35c75-7756-4ff4-bc46-7d4740e995d4",
                                "sense_id": "0cd8800b-1bed-344e-bf30-ba20d5dd054e",
                                "text": "„Ich arbeite mit Ihnen mit angenehmen Körperübungen an der Vertiefung der Atmung und der Heilung Ihrer Stimme.“"
                            },
                            {
                                "example_id": "9acad653-14bc-451d-8732-aa6096237163",
                                "sense_id": "0cd8800b-1bed-344e-bf30-ba20d5dd054e",
                                "text": "„Unser Yoga beinhaltet neben den Asanas (Körperübungen) auch Meditationen und Atemübungen.“"
                            },
                            {
                                "example_id": "a6ab277d-e646-4616-9455-8d186954156a",
                                "sense_id": "0cd8800b-1bed-344e-bf30-ba20d5dd054e",
                                "text": "„Durch gezielte Körperübungen, Natur- und Sinneserfahrungen erspüren wir ihre Wirkung in unserem gesamten System von Körper, Seele und Geist.“"
                            },
                            {
                                "example_id": "0c08d90f-f138-4df8-93ab-b42ed5e631da",
                                "sense_id": "0cd8800b-1bed-344e-bf30-ba20d5dd054e",
                                "text": "„Mach eine anstrengende Körperübung, zum Beispiel Knie- oder Rumpfbeugen, joggen, Musik hören und dazu tanzen.“"
                            },
                            {
                                "example_id": "52e8bc67-b5a8-4e2f-b9b9-c299e21dfefc",
                                "sense_id": "0cd8800b-1bed-344e-bf30-ba20d5dd054e",
                                "text": "„Wir haben uns vorgenommen, durch feinfühliges Coaching, Körperübungen und gemeinsames Fliegen das Ganze umzudrehen:“"
                            },
                            {
                                "example_id": "8fa9f49d-6400-45ca-8c17-5831eb32eb69",
                                "sense_id": "0cd8800b-1bed-344e-bf30-ba20d5dd054e",
                                "text": "„Die Übungssequenzen, die Hausaufgaben bestehen vorrangig aus Körperbewegungen, Körperübungen, kombiniert mit Atemmustern, Atemtechniken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
