{
    "word_family": [
        "kaloryferowy"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "93d3b68f-e36d-3174-a25c-5742e0a34e61",
                    "sense_definition": "urządzenie służące do ogrzewania pomieszczeń, przez które przepływa gorąca woda lub para",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ogrzewanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Znowu <w>kaloryfer</w> w łazience się zapowietrzył.",
                            "target_lang_translations": {
                                "ru": "Опять <w>батарея</w> в ванной завоздушилась."
                            }
                        },
                        {
                            "text": "Szkolne <w>kaloryfery</w> znowu nie grzeją i jeśli niska temperatura utrzyma się do jutra, będą musieli zwolnić nas z zajęć.",
                            "target_lang_translations": {
                                "ru": "Школьные <w>батареи</w> снова не греют, и если низкая температура продержится до завтра, им придётся отпустить нас с уроков."
                            }
                        }
                    ],
                    "synonyms": [
                        "grzejnik"
                    ],
                    "common_phrases": [
                        "gorący kaloryfer",
                        "zimny kaloryfer"
                    ],
                    "target_lang_definitions": {
                        "ru": "устройство для отопления помещений, через которое проходит горячая вода или пар"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "батарея",
                                "target_lang_sense_clarification": "отопительный прибор"
                            },
                            {
                                "target_lang_word": "радиатор",
                                "target_lang_sense_clarification": "отопительный прибор"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a92cd7a8-ba8b-3892-8d79-ed0df02a4321",
                    "sense_definition": "wyraźnie zarysowane mięśnie brzucha u człowieka",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ciało",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ćwiczę od kilku tygodni, żeby w lecie pokazać ładny <w>kaloryfer</w> na plaży.",
                            "target_lang_translations": {
                                "ru": "Я тренируюсь уже несколько недель, чтобы летом показать красивые <w>кубики</w> на пляже."
                            }
                        },
                        {
                            "text": "Mój brat spędza godziny na siłowni, bo marzy mu się twardy <w>kaloryfer</w>.",
                            "target_lang_translations": {
                                "ru": "Мой брат часами пропадает в спортзале, потому что мечтает о стальном <w>прессе</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "sześciopak"
                    ],
                    "common_phrases": [
                        "zrobić kaloryfer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "używane w kontekście sportowym i potocznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "хорошо выраженные, рельефные мышцы живота"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кубики",
                                "target_lang_sense_clarification": "рельефные мышцы пресса"
                            },
                            {
                                "target_lang_word": "пресс",
                                "target_lang_sense_clarification": "мышцы живота"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6df57770-dc5f-3795-b5c0-7546487c0e8c",
                    "sense_definition": "potoczne określenie akordeonu",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "instrumenty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Od tygodnia syn sąsiadów rzępoli na <w>kaloryferze</w>, tak że uszy więdną.",
                            "target_lang_translations": {
                                "ru": "Уже неделю соседский сын пилит на <w>гармошке</w> так, что уши вянут."
                            }
                        },
                        {
                            "text": "Mój dziadek świetnie gra na starym <w>kaloryferze</w> podczas rodzinnych spotkań.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка отлично играет на старом <w>баяне</w> во время семейных посиделок."
                            }
                        }
                    ],
                    "synonyms": [
                        "akordeon",
                        "harmonia",
                        "harmoszka"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "żartobliwe określenie instrumentu"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "разговорное или шутливое название аккордеона или баяна"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "баян",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            },
                            {
                                "target_lang_word": "гармонь",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            },
                            {
                                "target_lang_word": "аккордеон",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0372c2a-460a-34f8-947e-f1aa12bc4fb7",
                    "sense_definition": "żartobliwe określenie stopnia wojskowego plutonowego",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "wojsko",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po szkółce podoficerskiej Jacek podpisał kontrakt zawodowy i został <w>kaloryferem</w> w jednostce przeciwlotniczej.",
                            "target_lang_translations": {
                                "ru": "После школы унтер-офицеров Яцек подписал профессиональный контракт и стал <w>плутоновым</w> в зенитной части."
                            }
                        },
                        {
                            "text": "W wojsku na plutonowego często mówi się żartobliwie <w>kaloryfer</w>.",
                            "target_lang_translations": {
                                "ru": "В армии взводного сержанта часто шутливо называют <w>«батареей»</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plutonowy"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "żargon wojskowy"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "шутливое армейское обозначение звания взводного (плутонового)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "плутоновый",
                                "target_lang_sense_clarification": "младший сержант / сержант (в польской армии)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}