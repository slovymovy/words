                "senses": [
                    {
                        "sense_id": "2787edb3-07fc-3c86-b7a7-958f20fecc74",
                        "entry_id": "8abade4d-947a-3b0e-a9a1-293f3f3d9667",
                        "glosses": [
                            "To leave hastily; to flee, especially with a whirring sound"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "1a71c848-fd24-41dc-8237-9650c809ff49",
                                "sense_id": "2787edb3-07fc-3c86-b7a7-958f20fecc74",
                                "text": "… while at the same moment, whir-r-r! up sprung a bevy of twenty quail, at least, startling me for the moment by the thick whirring of their wings, and skirring over the underwood right toward Archer."
                            },
                            {
                                "example_id": "13f79333-9e34-40ab-88e7-257ddfd91abc",
                                "sense_id": "2787edb3-07fc-3c86-b7a7-958f20fecc74",
                                "text": "Our left wing, when they occupied the hills, saw four or five hundred Turks 'skirr away' in one body, and the machine-gunners found a target."
                            }
                        ]
                    },
                    {
                        "sense_id": "302bd13e-8570-3d8a-bd49-dd3a76a5fe71",
                        "entry_id": "8abade4d-947a-3b0e-a9a1-293f3f3d9667",
                        "glosses": [
                            "To make a whirring sound."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef884439-5c17-429e-856b-caf5f5111f17",
                                "sense_id": "302bd13e-8570-3d8a-bd49-dd3a76a5fe71",
                                "text": "... but that they had no thought to let the thing go unnoticed was quickly evidenced by the skirring of motors upon the landing-stage and the quick shooting airward of a long-lined patrol boat."
                            }
                        ]
                    },
                    {
                        "sense_id": "d022f358-3391-3521-b990-3c0d454ad37a",
                        "entry_id": "8abade4d-947a-3b0e-a9a1-293f3f3d9667",
                        "glosses": [
                            "To search about in, scour"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "011bafaa-577b-497e-ba36-df1638d4a9dc",
                                "sense_id": "d022f358-3391-3521-b990-3c0d454ad37a",
                                "text": "The gates of Granada once more poured forth legions of light scouring cavalry, which skirred the country up to the very gates of the Christian fortresses, sweeping off flocks and herds."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc2e9a11-e06a-3c5d-9911-0cb0e0ea36fd",
                        "entry_id": "8abade4d-947a-3b0e-a9a1-293f3f3d9667",
                        "glosses": [
                            "to pass over quickly, skim"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cce850d-a4a4-4f05-acf9-8b2e6e82a0b2",
                                "sense_id": "cc2e9a11-e06a-3c5d-9911-0cb0e0ea36fd",
                                "text": "I had flown in a helicopter with Javits and Bobby Kennedy. I was skirring around New York like an ephemerid, my jacket lined with jolly psychedelic green."
                            }
                        ]
                    }
