                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dawniej wierzono, że umysł nieszczęśnika został nagle <w>obłąkany</w> przez złe moce i demony.",
                            "target_lang_translations": {
                                "ru": "В старину верили, что разум несчастного был внезапно <w>помрачён</w> злыми силами и демонами."
                            }
                        },
                        {
                            "text": "Mężczyzna został <w>obłąkany</w> przez fałszywe wizje, które nie dawały mu spokoju nocą.",
                            "target_lang_translations": {
                                "ru": "Мужчина был <w>сведён с ума</w> ложными видениями, не дававшими ему покоя по ночам."
                            }
                        }
                    ],
