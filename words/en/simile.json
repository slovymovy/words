{
    "word_family": [
        "assimilation",
        "assimilate",
        "similitude",
        "similar",
        "similarity",
        "facsimile"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "90671dea-1855-3ccf-a04e-2b596e1aa91a",
                    "sense_definition": "A figure of speech expressing resemblance between two things using words such as \"like\" or \"as\".",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The poem contains a <w>simile</w> comparing the runner to a swift hawk in flight.",
                            "target_lang_translations": {
                                "zh": "这首诗中包含一个将赛跑者比作飞行中敏捷猎鹰的<w>明喻</w>。"
                            }
                        },
                        {
                            "text": "In literature class, we learned to use a <w>simile</w> to make our descriptions more vivid.",
                            "target_lang_translations": {
                                "zh": "在文学课上，我们学习了如何使用<w>明喻</w>来使我们的描写更加生动。"
                            }
                        }
                    ],
                    "synonyms": [
                        "analogy",
                        "metaphor",
                        "comparison"
                    ],
                    "common_phrases": [
                        "use a simile",
                        "striking simile",
                        "poetic simile"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种修辞手法，通过使用“像”或“如同”等词语来表达两事物之间的相似性。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "明喻",
                                "target_lang_sense_clarification": "修辞学中指明喻句，即本体、喻体和比喻词同时出现的比喻。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3327804-c22c-319a-9ee4-df6d622909bb",
                    "sense_definition": "Similarity, likeness, or resemblance to something else.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a striking <w>simile</w> between the ancient statue and the modern painting.",
                            "target_lang_translations": {
                                "zh": "那座古代雕像与现代画作之间存在着惊人的<w>相似</w>之处。"
                            }
                        },
                        {
                            "text": "The scholar observed a faint <w>simile</w> in the behavior of the two distant animal species.",
                            "target_lang_translations": {
                                "zh": "学者观察到这两个相距甚远的物种在行为上存在微弱的<w>相似</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "likeness",
                        "resemblance",
                        "similitude"
                    ],
                    "antonyms": [
                        "dissimile"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rare or archaic usage meaning resemblance"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指事物之间的相似、相像或类似之处（古语用法）。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "相似",
                                "target_lang_sense_clarification": "指事物之间相像，在现代汉语中更为常用。"
                            },
                            {
                                "target_lang_word": "类似",
                                "target_lang_sense_clarification": "指大致相像，用于描述事物间的共同点。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}