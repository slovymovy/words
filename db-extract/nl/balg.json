                "translations": [
                    {
                        "translation_id": "5d7b4a25-def8-44a1-bad2-45e8485e3ae2",
                        "source_entry_id": "0610eb96-c16e-3989-8338-d3f3726d8962",
                        "target_lang_word": "bellows",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bellows",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30607556-19d8-3c07-9cec-8586604f9fde",
                                        "entry_id": "5df98bd3-6f9a-3203-a051-91fdb3822f01",
                                        "glosses": [
                                            "A device for delivering pressurized air in a controlled quantity to a controlled location. At its most simple terms a bellows is a container which is deformable in such a way as to alter its volume which has an outlet or outlets where one wishes to blow air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4ec55a8-7e78-4da8-9fae-cf6a7e23a164",
                                                "sense_id": "30607556-19d8-3c07-9cec-8586604f9fde",
                                                "text": "When wood fires were common, so were bellows for helping start them."
                                            },
                                            {
                                                "example_id": "69f1d658-93d3-4699-ad0c-236ab3ba718a",
                                                "sense_id": "30607556-19d8-3c07-9cec-8586604f9fde",
                                                "text": "That concertina was a wonder in its way. The handles that was on it first was wore out long ago, and he'd made new ones of braided rope yarn. And the bellows was patched in more places than a cranberry picker's overalls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cfb09a3e-411c-3407-bdbf-4032b0bb17ee",
                                        "entry_id": "5df98bd3-6f9a-3203-a051-91fdb3822f01",
                                        "glosses": [
                                            "Any flexible container or enclosure, as one used to cover a moving joint."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c2a1a9c4-6944-34df-8236-25c54b8bfb52",
                                        "entry_id": "5df98bd3-6f9a-3203-a051-91fdb3822f01",
                                        "glosses": [
                                            "The lungs."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0155b5bf-b81b-4b5b-b496-c8acd156bf10",
                                                "sense_id": "c2a1a9c4-6944-34df-8236-25c54b8bfb52",
                                                "text": "“Why, who should J. B. mean by Joe, but old Joe Bagstock—Joseph—your slave—Joe, Ma’am? Here! Here’s the man! Here are the Bagstock bellows, Ma’am!” cried the Major, striking himself a sounding blow on the chest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "650caed0-4d2e-3b42-88ce-665d72e0f36c",
                                        "entry_id": "5df98bd3-6f9a-3203-a051-91fdb3822f01",
                                        "glosses": [
                                            "Flexible, light-tight enclosures connecting the lensboard and the camera back."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09c5f272-12ca-3807-b23f-1ee766d4d4f5",
                                        "entry_id": "5df98bd3-6f9a-3203-a051-91fdb3822f01",
                                        "glosses": [
                                            "That which fans the fire of hatred, jealousy, etc."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bellows",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4729af64-f0f5-36ab-8bdf-a11e5e0f6c4b",
                                        "entry_id": "b5a293b4-00b5-38d6-b270-4e8afc0452ef",
                                        "glosses": [
                                            "To operate a bellows; to direct air at (something) using a bellows."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3e57b62-7481-438a-b3b7-b5494afd0ba0",
                                                "sense_id": "4729af64-f0f5-36ab-8bdf-a11e5e0f6c4b",
                                                "text": "[…] I was recommended to the place as a man who could give another man as good as he brought, and I took it. It’s easier than bellowsing and hammering."
                                            },
                                            {
                                                "example_id": "d98edc4c-1f7c-4809-b02d-7c386cc26f4a",
                                                "sense_id": "4729af64-f0f5-36ab-8bdf-a11e5e0f6c4b",
                                                "text": "So bellowsed, all the kindled soul of Hugh\nBecame a still white hell of brooding ire,\nAnd through his veins regenerating fire\nRan, driving out the lethargy of pain."
                                            },
                                            {
                                                "example_id": "003730c7-a201-4ed5-b7a8-fe22dd520b8b",
                                                "sense_id": "4729af64-f0f5-36ab-8bdf-a11e5e0f6c4b",
                                                "text": "The smiths of the heavens are mending the weather;\nTheir hammers are beating the fragments together.\nThe cumulus mountains with nebulous gorges\nAre dazzled with flame of the wind-bellowsed forges;"
                                            },
                                            {
                                                "example_id": "0260a123-1284-4bf9-9075-a8e442b83c8a",
                                                "sense_id": "4729af64-f0f5-36ab-8bdf-a11e5e0f6c4b",
                                                "text": "He almost let the cigar go out. ‘Good God, no. We’re both exiles, aren’t we?’ He bellowsed the end red again and continued, delicate as a musician, his scoring."
                                            },
                                            {
                                                "example_id": "87991b4c-865f-47a2-8495-0621318812dd",
                                                "sense_id": "4729af64-f0f5-36ab-8bdf-a11e5e0f6c4b",
                                                "text": "This is a capricious devil, the furnace, though I say it myself, and it wants regular bellowsing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e54ac81-339d-3d50-9692-63817a12606c",
                                        "entry_id": "b5a293b4-00b5-38d6-b270-4e8afc0452ef",
                                        "glosses": [
                                            "To expand and contract like a bellows."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd99f9f9-269c-45d0-9a79-493626cc3722",
                                                "sense_id": "8e54ac81-339d-3d50-9692-63817a12606c",
                                                "text": "[…] [the dogs] sprang up, and, with a grand spraying of the crisp snow as they fleetly clambered up the steep side, they were with us in an incredibly short time, with pink tongues protruding, sides bellowsing, and sterns wagging."
                                            },
                                            {
                                                "example_id": "b8c57e10-b228-4e90-b65c-9173edd66998",
                                                "sense_id": "8e54ac81-339d-3d50-9692-63817a12606c",
                                                "text": "The pony still lay on his side and the wound in his throat bellowsed in and out."
                                            },
                                            {
                                                "example_id": "d8356542-e4b1-4299-915b-3b0d52a0bf64",
                                                "sense_id": "8e54ac81-339d-3d50-9692-63817a12606c",
                                                "text": "A sick-looking dog sat in the middle of the road, head down, sides bellowsing, white foam dripping from its muzzle to the heat-shimmering pavement."
                                            },
                                            {
                                                "example_id": "f1feb2b0-85aa-4a7b-a73b-558a634ff2c6",
                                                "sense_id": "8e54ac81-339d-3d50-9692-63817a12606c",
                                                "text": "The old man laughed without making a sound. His chest bellowsed and he opened his mouth to display a horseshoe of gold molars."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b79e037a-ac7d-35dd-b575-d04f65290f38",
                                        "entry_id": "b5a293b4-00b5-38d6-b270-4e8afc0452ef",
                                        "glosses": [
                                            "To fold up like a bellows; to accordion."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f018dd7-f0fc-4d9e-98f9-2deb02df05f6",
                                                "sense_id": "b79e037a-ac7d-35dd-b575-d04f65290f38",
                                                "text": "Without being tight […] the boot leg should fit close. The ankle should be supple as a stocking, and “bellowsed” to make sure of suppleness."
                                            },
                                            {
                                                "example_id": "d5dd8687-1041-4ac7-b92e-7db7c79f8f3c",
                                                "sense_id": "b79e037a-ac7d-35dd-b575-d04f65290f38",
                                                "text": "[…] the chairman of the gathered scholars […] [shushed] the black waiters preparing to feed us a hefty lunch behind the bellowsed dividing wall with the impatient yell, “You’re disturbing our meeting,” while we discussed their plight on our side of the wall."
                                            },
                                            {
                                                "example_id": "ce41a2c7-5c56-4844-919a-e3cfa636b6d2",
                                                "sense_id": "b79e037a-ac7d-35dd-b575-d04f65290f38",
                                                "text": "[The bus] rolled swiftly down the hill and bellowsed five parked cars […]"
                                            }
                                        ]
                                    }
                                ]
                            },
