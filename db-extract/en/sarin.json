                "entry_id": "7f966d04-856d-3a7e-a57b-0545a3dd6b4a",
                "word": "sarin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aa90326b-32f2-314f-8ab1-9dbcafcb26a3",
                        "entry_id": "7f966d04-856d-3a7e-a57b-0545a3dd6b4a",
                        "glosses": [
                            "The nerve gas O-isopropyl methylphosphonofluoridate, used as a chemical weapon."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "39109e27-c56a-421a-b150-842270da015b",
                                "sense_id": "aa90326b-32f2-314f-8ab1-9dbcafcb26a3",
                                "text": "The health minister in Turkey, which treated many of the attack's victims and conducted autopsies on others, said test results conducted on victims confirmed sarin gas was used."
                            },
                            {
                                "example_id": "748af126-11a0-4a4a-81b5-33fc1fdd60b7",
                                "sense_id": "aa90326b-32f2-314f-8ab1-9dbcafcb26a3",
                                "text": "Because Syria was not a signatory of the Chemical Weapons Convention, there was no international mechanism to ascribe responsibility for the attack, although UN inspectors did conclude that sarin had been deployed."
                            },
                            {
                                "example_id": "d2c3aacc-cf63-446e-9017-923f1d04f088",
                                "sense_id": "aa90326b-32f2-314f-8ab1-9dbcafcb26a3",
                                "text": "Trostianets mayor Yuriy Bova said officials had discovered traces of the deadly substance sarin and other chemical substances. Sarin is a clear and odourless substance that is classed as a potentially lethal nerve agent."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72324944-0c5d-4f6d-a6d9-206816c1c1b6",
                        "source_entry_id": "7f966d04-856d-3a7e-a57b-0545a3dd6b4a",
                        "source_sense_id": "aa90326b-32f2-314f-8ab1-9dbcafcb26a3",
                        "source_sense_description": "nerve gas",
                        "target_lang_word": "sarin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d3fb9be4-6308-3c67-9e75-31aff8731ca2",
                                        "entry_id": "5081b545-f241-3cb4-a656-15b1cd85cb6c",
                                        "glosses": [
                                            "Substance inodore, incolore et volatile, de la famille des organophosphorés, de formule chimique brute C₄H₁₀FO₂P, extrêmement neurotoxique pour l’homme et l’animal et dont l’effet est généralement létal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d19ec63-9eac-4df4-8094-fb5a992fa15f",
                                                "sense_id": "d3fb9be4-6308-3c67-9e75-31aff8731ca2",
                                                "text": "Le sarin est environ 500 fois plus toxique que le cyanure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dbbe8784-0c76-4465-b2cf-725819946adb",
                        "source_entry_id": "7f966d04-856d-3a7e-a57b-0545a3dd6b4a",
                        "source_sense_id": "aa90326b-32f2-314f-8ab1-9dbcafcb26a3",
                        "source_sense_description": "nerve gas",
                        "target_lang_word": "Sarin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sarin",
