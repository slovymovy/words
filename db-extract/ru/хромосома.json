                        "sense_id": "cbd8cf1b-40d0-318f-92d0-056ec3d9dfef",
                        "entry_id": "871b9613-e0cc-313e-b1fb-6aeba291cb5c",
                        "glosses": [
                            "цитол. нуклеопротеидная структура в ядре эукариотической клетки"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a438e8b4-1a2e-4e0e-b314-bd31d57ae364",
                                "sense_id": "cbd8cf1b-40d0-318f-92d0-056ec3d9dfef",
                                "text": "Рожь имеет 14 хромосом, мягкая пшеница, с которой мы сравниваем рожь, 42 хромосомы."
                            },
                            {
                                "example_id": "17b9f964-2c1d-4eb9-ac1c-b0f6bafac81a",
                                "sense_id": "cbd8cf1b-40d0-318f-92d0-056ec3d9dfef",
                                "text": "Под воздействием тёплой воды происходит слияние двух мужских ядер, образующих нормальное ядро, состоящее из двойного (диплоидного) набора хромосом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36cca9bf-6fbb-4352-b105-c73fbd7ccf5e",
                        "source_entry_id": "871b9613-e0cc-313e-b1fb-6aeba291cb5c",
                        "source_sense_id": "cbd8cf1b-40d0-318f-92d0-056ec3d9dfef",
                        "target_lang_word": "chromosome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
