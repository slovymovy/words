                                        "glosses": [
                                            "Eigenschaft einer Funktion, bei der die Verknüpfung mit sich selbst die gleichen Ergebnisse liefert wie bei der ersten Anwendung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ae32c47-9bca-4061-92af-4f934e59bd35",
                                                "sense_id": "ab666ac7-d794-3056-9d19-28f56a497c76",
                                                "text": "Eine Idempotenz liegt vor, wenn die Multiplikation einer Zahl mit sich selbst als Ergebnis dieselbe Zahl ergibt; dies trifft für die Zahlen 0 und 1 zu."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
