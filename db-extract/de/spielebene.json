                "senses": [
                    {
                        "sense_id": "8ba720fa-77f1-3e0c-b8f6-fd272f0de3d0",
                        "entry_id": "07bdfc8a-c4b2-3b82-82d2-da6646499001",
                        "glosses": [
                            "Plattform, Level, auf der/dem gespielt werden kann, auch im Sinne eines bestimmten Anspruchsniveaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da012301-f575-4c98-853c-03f79ef293f6",
                                "sense_id": "8ba720fa-77f1-3e0c-b8f6-fd272f0de3d0",
                                "text": "„Durch die Kombination von anfassbaren und elektronischen Spielzeugen entstünden völlig neue Spielebenen und Spielformen, hieß es zur Begründung.“"
                            },
                            {
                                "example_id": "93e048fb-52a1-4261-a487-1ff2f3b858d0",
                                "sense_id": "8ba720fa-77f1-3e0c-b8f6-fd272f0de3d0",
                                "text": "„Auf der nächsten Spielebene muß dann der Spieler nach Moskau fliegen und die dortige Kommandozentrale zerstören.“"
                            },
                            {
                                "example_id": "6356f86e-7a11-40e9-9f89-f32862206f0c",
                                "sense_id": "8ba720fa-77f1-3e0c-b8f6-fd272f0de3d0",
                                "text": "„Kriegsspielen ist ethisch unbedenklich, solange die Spielebene nicht verlassen wird; das Verlassen der Ebene betrifft aber nicht mehr das Spiel.“"
                            },
                            {
                                "example_id": "e66e26cf-e8b9-4b4e-b7ae-d151aa403bef",
                                "sense_id": "8ba720fa-77f1-3e0c-b8f6-fd272f0de3d0",
                                "text": "„In einem qualitativen Beobachtungsprojekt zur Aggressivität im kindlichen Spiel zeigt Gisela Wegener-Spöhring die spielpädagogische Bedeutung dieser sozialen Spielebene auf.“"
                            },
                            {
                                "example_id": "b12e5253-ca21-4778-aac3-b77d02b1b629",
                                "sense_id": "8ba720fa-77f1-3e0c-b8f6-fd272f0de3d0",
                                "text": "„Gehört die kesse Biene oder der tolle Hecht heute zur Spracherfahrung von Kindern, sodass sie eine Gebrauchs- und eine Spielebene überhaupt erleben?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
