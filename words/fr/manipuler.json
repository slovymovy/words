            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06529105-617a-39fb-b23c-e66723102efb",
                    "sense_definition": "Manier, tenir ou faire fonctionner avec les mains un objet, souvent avec précaution ou habileté.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les élèves doivent <w>manipuler</w> avec soin ces flacons en verre très fragiles."
                        },
                        {
                            "text": "Le technicien <w>manipule</w> les pièces délicates de l'horloge avec une petite pince."
                        }
                    ],
                    "synonyms": [
                        "manier",
                        "toucher"
                    ],
                    "common_phrases": [
                        "manipuler avec soin",
                        "manipuler avec précaution"
                    ]
                },
                {
                    "sense_id": "f663d435-1cae-33a7-8a45-b5f3f8004824",
                    "sense_definition": "Exercer une influence détournée sur quelqu'un ou fausser des éléments pour parvenir à ses fins.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce politicien corrompu tente de <w>manipuler</w> les foules en diffusant de fausses informations."
                        },
                        {
                            "text": "Il a réussi à <w>manipuler</w> des données financières afin de masquer ses pertes réelles."
                        }
                    ],
                    "synonyms": [
                        "influencer",
                        "manœuvrer",
                        "instrumentaliser"
                    ],
                    "common_phrases": [
                        "manipuler les foules",
                        "manipuler des données"
                    ]
                },
                {
                    "sense_id": "2c02316f-ca48-3803-94b5-aa822afe685b",
                    "sense_definition": "Effectuer des opérations pratiques ou des expériences dans un cadre scientifique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durant les travaux pratiques de chimie, nous passons des heures à <w>manipuler</w> en laboratoire."
                        },
                        {
                            "text": "Ce jeune chercheur <w>manipule</w> tous les matins pour préparer ses cultures de cellules."
                        }
                    ],
                    "synonyms": [
                        "expérimenter"
                    ],
                    "common_phrases": [
