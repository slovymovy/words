                "senses": [
                    {
                        "sense_id": "b039e6be-f84e-3d53-9dcc-0a39e6047611",
                        "entry_id": "9035ce93-3ce4-36e0-b141-2e61d366ca78",
                        "glosses": [
                            "Relatif à saint Pierre, apôtre du Christ, mort martyr à Rome et considéré traditionnellement comme le premier pape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0757d23f-05cc-44a4-98bc-68ea7f2845d3",
                                "sense_id": "b039e6be-f84e-3d53-9dcc-0a39e6047611",
                                "text": "Il faut sans cesse relire toute cette leçon de l'Évangile, afin que l'exercice du ministère pétrinien ne perde rien de son authenticité et de sa transparence. ."
                            },
                            {
                                "example_id": "0a1c01e8-50ed-4d4d-8ebd-3e1a91e1f6a5",
                                "sense_id": "b039e6be-f84e-3d53-9dcc-0a39e6047611",
                                "text": "C'est pour affirmer … les droits exclusifs du siège romain qu'Étienne invoque son ascendance pétrinienne, et allègue Matthieu 16, 18-19."
                            }
                        ]
                    },
                    {
                        "sense_id": "6fbcd397-bf23-33de-a4c2-501cc6766c93",
                        "entry_id": "9035ce93-3ce4-36e0-b141-2e61d366ca78",
                        "glosses": [
                            "Relatif à Pierre le Grand, empereur de Russie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b12aa54f-33ee-4f89-ab19-ace81e3800e6",
                                "sense_id": "6fbcd397-bf23-33de-a4c2-501cc6766c93",
                                "text": "L’idéologie de l’époque pétrinienne avait pour caractéristique de représenter le vécu de la Russie du dix-huitième siècle comme un commencement, un point de départ."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d01a25f4-3f5c-4473-984a-94a432bbcdeb",
                        "source_entry_id": "9035ce93-3ce4-36e0-b141-2e61d366ca78",
                        "target_lang_word": "Petrine",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petrine",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13b3159a-5f7a-3a1f-832b-73d3ee73eb27",
                                        "entry_id": "efa3429c-783d-3102-83f6-34a41c1e07a5",
                                        "glosses": [
                                            "Of or pertaining to people named Peter, particularly Saint Peter or Peter the Great."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0d96844-2626-4b70-868b-b0e5468f65cb",
                                                "sense_id": "13b3159a-5f7a-3a1f-832b-73d3ee73eb27",
                                                "text": "the Petrine Epistles"
                                            },
                                            {
                                                "example_id": "7c78afbb-176b-406f-8bbb-2f423f050fc3",
                                                "sense_id": "13b3159a-5f7a-3a1f-832b-73d3ee73eb27",
                                                "text": "...the statement of Apost. Const. vi. 8, that his ordination was Pauline, rather than Petrine, according to the competing traditions of St. Epiphanus and Rufinus, in which case he is the particular link in the Pauline succession."
                                            },
                                            {
                                                "example_id": "cf89a7fe-ab75-4700-b426-f9563e175f17",
                                                "sense_id": "13b3159a-5f7a-3a1f-832b-73d3ee73eb27",
                                                "text": "And thus, in this connection, is intruded upon us the narrative in the Petrine Gospel, which afterwards became famous, and according to which the Cross was borne to heaven with Christ at the Ascension."
                                            },
                                            {
                                                "example_id": "a229f115-bd9b-4343-b64a-ff3e654a3672",
                                                "sense_id": "13b3159a-5f7a-3a1f-832b-73d3ee73eb27",
                                                "text": "At the same time the tinctures of the reversed Petrine cross on the field and the chief changed from red to blue."
                                            },
                                            {
                                                "example_id": "5135f7bc-e9d5-4ecd-bbf7-f4245b5a5b14",
                                                "sense_id": "13b3159a-5f7a-3a1f-832b-73d3ee73eb27",
                                                "text": "The Swiss theologian Hans Urs von Balthasar takes this approach, arguing that in the church there is a Marian principle of holy obedience complementary to the Petrine principle of orderly hierarchical rule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbb89752-24b4-34e3-afb0-395cd27c93dc",
                                        "entry_id": "efa3429c-783d-3102-83f6-34a41c1e07a5",
                                        "glosses": [
                                            "Of or pertaining to people named Peter, particularly Saint Peter or Peter the Great.",
                                            "Depicted upside-down."
                                        ],
                                        "tags": [
                                            "of a cross"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
