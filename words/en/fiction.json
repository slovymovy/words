{
    "word_family": [
        "fictional",
        "fictionalize",
        "fictitious",
        "fictive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9a8ee9b9-3ced-3e49-9ce9-f7fb553af69c",
                    "sense_definition": "Literary type using invented or imaginative writing, instead of real facts, usually written as prose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "literature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I enjoy reading <w>fiction</w> much more than history books.",
                            "target_lang_translations": {
                                "ru": "Я люблю читать <w>художественную литературу</w> гораздо больше, чем книги по истории.",
                                "zh": "比起历史书，我更喜欢读<w>小说</w>。"
                            }
                        },
                        {
                            "text": "The library has a large section dedicated to science <w>fiction</w>.",
                            "target_lang_translations": {
                                "ru": "В библиотеке есть большой раздел, посвященный научной <w>фантастике</w>.",
                                "zh": "图书馆有一个专门陈列科幻<w>小说</w>的大区域。"
                            }
                        }
                    ],
                    "antonyms": [
                        "non-fiction",
                        "documentary"
                    ],
                    "common_phrases": [
                        "science fiction",
                        "historical fiction",
                        "work of fiction",
                        "crime fiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вид литературы, описывающий вымышленные события и образы, обычно в прозе; противопоставляется документальной литературе.",
                        "zh": "以虚构或想象的内容为基础的文学作品，通常以散文形式呈现，与纪实文学相对。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "художественная литература",
                                "target_lang_sense_clarification": "общий термин для произведений искусства слова"
                            },
                            {
                                "target_lang_word": "беллетристика",
                                "target_lang_sense_clarification": "повествовательная проза, часто используемая для легкого чтения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚构作品",
                                "target_lang_sense_clarification": "指文学创作中非真实存在的叙事作品"
                            },
                            {
                                "target_lang_word": "小说",
                                "target_lang_sense_clarification": "文学体裁的一种，通常指虚构的叙事文学"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d503e9a-4a5c-37e0-aa65-607b0ae655cf",
                    "sense_definition": "A verbal or written account that is not based on actual events, often intended to mislead.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "untruth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to separate fact from <w>fiction</w> to understand what really happened.",
                            "target_lang_translations": {
                                "ru": "Нам нужно отделить факты от <w>вымысла</w>, чтобы понять, что произошло на самом деле.",
                                "zh": "我们需要区分事实与<w>虚构</w>，才能了解到底发生了什么。"
                            }
                        },
                        {
                            "text": "His excuse for being late was pure <w>fiction</w>.",
                            "target_lang_translations": {
                                "ru": "Его оправдание опоздания было чистой <w>выдумкой</w>.",
                                "zh": "他迟到的借口纯属<w>杜撰</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fabrication",
                        "figment"
                    ],
                    "antonyms": [
                        "fact",
                        "truth"
                    ],
                    "common_phrases": [
                        "pure fiction",
                        "fact or fiction",
                        "polite fiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Устное или письменное сообщение, не соответствующее действительности; плод воображения или обман.",
                        "zh": "并非基于真实事件的口头或书面陈述，常用于误导他人或指代纯粹的想象。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вымысел",
                                "target_lang_sense_clarification": "то, что создано воображением, неправда"
                            },
                            {
                                "target_lang_word": "выдумка",
                                "target_lang_sense_clarification": "разговорное; изобретенная история, ложь"
                            },
                            {
                                "target_lang_word": "фикция",
                                "target_lang_sense_clarification": "нечто несуществующее, мнимое, поддельное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "虚构",
                                "target_lang_sense_clarification": "凭空捏造，非真实存在"
                            },
                            {
                                "target_lang_word": "谎言",
                                "target_lang_sense_clarification": "故意编造的虚假信息"
                            },
                            {
                                "target_lang_word": "杜撰",
                                "target_lang_sense_clarification": "无根据地编造"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd4b87ca-38d5-30ca-bb32-95714c07976b",
                    "sense_definition": "A rule or assumption that something is true for legal purposes, even if it is not factual.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The concept of corporate personhood is a useful legal <w>fiction</w>.",
                            "target_lang_translations": {
                                "ru": "Концепция юридического лица корпорации — это полезная правовая <w>фикция</w>.",
                                "zh": "公司法人格的概念是一种有用的<w>法律拟制</w>。"
                            }
                        },
                        {
                            "text": "Courts sometimes rely on a legal <w>fiction</w> to achieve a just result.",
                            "target_lang_translations": {
                                "ru": "Суды иногда полагаются на юридическую <w>фикцию</w>, чтобы добиться справедливого результата.",
                                "zh": "法院有时会依赖<w>法律拟制</w>来达成公正的结果。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "legal fiction"
                    ],
                    "target_lang_definitions": {
                        "ru": "Юридический прием, состоящий в признании существующим факта, который в действительности не существует или не доказан, для обеспечения определенных правовых последствий.",
                        "zh": "法律上的一种假设，即为了实现特定的法律效果，将某种不符合事实的情况视为真实。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фикция",
                                "target_lang_sense_clarification": "в контексте 'юридическая фикция'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "法律拟制",
                                "target_lang_sense_clarification": "法律术语，指将非事实视为事实的法律技术"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}