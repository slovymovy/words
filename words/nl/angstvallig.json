{
    "word_family": [
        "angst",
        "angstvalligheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e2f2311-f0c4-3a3e-8068-93ebbfc7648b",
                    "sense_definition": "met een overdreven of krampachtige zorgvuldigheid tot in de kleinste details",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zorgvuldigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boekhouder controleerde de cijfers op een <w>angstvallig</w> nauwkeurige manier.",
                            "target_lang_translations": {
                                "en": "The accountant checked the figures in a <w>scrupulously</w> accurate manner."
                            }
                        },
                        {
                            "text": "Zij probeerde het geheim <w>angstvallig</w> te bewaren voor haar collega's.",
                            "target_lang_translations": {
                                "en": "She tried <w>anxiously</w> to keep the secret from her colleagues."
                            }
                        }
                    ],
                    "synonyms": [
                        "nauwgezet",
                        "scrupuleus",
                        "pietluttig"
                    ],
                    "antonyms": [
                        "slordig",
                        "onverschillig"
                    ],
                    "common_phrases": [
                        "angstvallig-geheim-bewaren",
                        "angstvallig-nauwkeurig"
                    ],
                    "target_lang_definitions": {
                        "en": "with excessive or obsessive care and attention to the smallest details"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scrupulous",
                                "target_lang_sense_clarification": "extremely attentive to details"
                            },
                            {
                                "target_lang_word": "meticulous",
                                "target_lang_sense_clarification": "showing great attention to detail; very careful and precise"
                            },
                            {
                                "target_lang_word": "painstaking",
                                "target_lang_sense_clarification": "done with or employing great care and thoroughness"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8e8072c-c9da-3ec5-8067-caa3c7a1272f",
                    "sense_definition": "gekenmerkt door vrees of een ongemakkelijke spanning",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vrees",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na de harde klap viel er een <w>angstvallige</w> stilte in de grote zaal.",
                            "target_lang_translations": {
                                "en": "After the loud bang, an <w>anxious</w> silence fell over the large hall."
                            }
                        },
                        {
                            "text": "Met een <w>angstvallige</w> blik keek het kind naar de donkere kelderdeur.",
                            "target_lang_translations": {
                                "en": "With a <w>fearful</w> look, the child stared at the dark cellar door."
                            }
                        }
                    ],
                    "synonyms": [
                        "nauwgezet"
                    ],
                    "antonyms": [
                        "onbevreesd",
                        "moedig"
                    ],
                    "common_phrases": [
                        "angstvallige-stilte"
                    ],
                    "target_lang_definitions": {
                        "en": "characterized by fear or an uncomfortable tension"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "anxious",
                                "target_lang_sense_clarification": "experiencing worry, unease, or nervousness"
                            },
                            {
                                "target_lang_word": "fearful",
                                "target_lang_sense_clarification": "feeling or showing fear or anxiety"
                            },
                            {
                                "target_lang_word": "tense",
                                "target_lang_sense_clarification": "unable to relax because of nervousness or anxiety"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}