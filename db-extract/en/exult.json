                                        "entry_id": "bd1a80dc-ae74-317d-a884-95c1005bd0f9",
                                        "glosses": [
                                            "книжн. бурно радоваться, испытывать и выражать восторг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a13798ed-3591-42a8-9a4f-a47f41a977bf",
                                                "sense_id": "2a162e49-0d56-3771-9cc7-c3e94d30e623",
                                                "text": "Твои друзья, в ладони хлопая, ликуют."
                                            },
                                            {
                                                "example_id": "4d7bff91-430f-4180-9df5-abbfc6ab57e5",
                                                "sense_id": "2a162e49-0d56-3771-9cc7-c3e94d30e623",
