                "senses": [
                    {
                        "sense_id": "872cc6d8-2f3a-330b-9b93-2fcc0dc48a8c",
                        "entry_id": "40c0ffd7-09c9-30eb-a295-569e63cf9b24",
                        "glosses": [
                            "The nobility; peerage."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3007810b-573d-489f-9ed3-763bb9d88151",
                                "sense_id": "872cc6d8-2f3a-330b-9b93-2fcc0dc48a8c",
                                "text": "Faire braunch of noblesse, flowre of cheualrie, / That with your worth the world amazed make, / How shall I quite the paines, ye suffer for my sake?"
                            },
                            {
                                "example_id": "adc33850-b5fa-42fc-92b1-823a932a19fb",
                                "sense_id": "872cc6d8-2f3a-330b-9b93-2fcc0dc48a8c",
                                "text": "All gentlemen are almost obliged to it: and I know no reason we should give that advantage to the commonalty of England to be foremost in brave actions, which the noblesse of France would never suffer in their peasants"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
