                    "frequency": "Middle",
                    "semantic_group_id": "feelings",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a deep <w>ambivalence</w> about leaving her hometown for a new job in the city."
                        },
                        {
                            "text": "The politician's <w>ambivalence</w> toward the new policy left many voters feeling confused and frustrated."
                        }
                    ],
                    "synonyms": [
                        "conflict",
                        "uncertainty"
                    ],
                    "antonyms": [
