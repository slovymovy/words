        "ru-extract.jsonl": [
            {
                "entry_id": "d5241d1d-8524-3eab-be1a-6f39ce4bbf49",
                "word": "вычисляемый",
                "pos": "adj",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ece0962c-b3ff-3b32-affc-5f58704b0e07",
                        "entry_id": "d5241d1d-8524-3eab-be1a-6f39ce4bbf49",
                        "glosses": [
                            "такой, который может быть вычислен"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "064e36b9-dd84-4524-818e-2b003907b95a",
                                "sense_id": "ece0962c-b3ff-3b32-affc-5f58704b0e07",
                                "text": "До края Вселенной нам добраться не удастся, но она имеет вполне вычисляемый объем и известные границы."
                            },
                            {
                                "example_id": "32e8580a-5718-4354-b161-9856150847b9",
                                "sense_id": "ece0962c-b3ff-3b32-affc-5f58704b0e07",
                                "text": "Факт образцовый, никому не известный, но вполне вычисляемый."
                            }
                        ]
                    },
                    {
                        "sense_id": "51b1bea4-ebb4-3f76-82ca-6c04606283b9",
                        "entry_id": "d5241d1d-8524-3eab-be1a-6f39ce4bbf49",
                        "glosses": [
                            "комп. полученный в результате предшествующих вычислений; непостоянный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e43cccd-c738-4909-acd3-05dd993b2c20",
                                "sense_id": "51b1bea4-ebb4-3f76-82ca-6c04606283b9",
                                "text": "characters[i].chrai.energymax ― максимальный уровень энергии, НО из-за того, что этот параметр вычисляемый, введенное значение будет работать (полоска энергии станет соответствовать введенному значению) только до следующего его расчета (а рассчитывается максимальный уровень энергии при каждом нажатии F2)."
                            }
                        ]
                    }
                ],
