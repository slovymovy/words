                                        "examples": [
                                            {
                                                "example_id": "82a14599-aaed-470c-8505-ca36f23bc526",
                                                "sense_id": "65a4c0b4-8c18-387a-b313-ac9b21b9fe81",
                                                "text": "Dokter Jan Mathieu van Lotto legt uit in een perscommuniqué: 'Een normale long zit vast tegen het ribbenrooster. Wanneer tussen de long en het ribbenrooster lucht komt te zitten, klapt de long naar binnen en verkleint de longinhoud. Jurgen Van den Broeck liep vorig jaar bij zijn val in de Tour onder meer een klaplong op. Vanmorgen is de lucht op die plaats weggezogen zodat de long opnieuw zijn normale volume kan aannemen.'"
                                            },
                                            {
                                                "example_id": "b97c2e45-e714-4606-8140-3a5e3d55a15e",
                                                "sense_id": "65a4c0b4-8c18-387a-b313-ac9b21b9fe81",
                                                "text": "Hugo Broos is niet langer de bondscoach van Kameroen. Dat heeft de Kameroense voetbalbond vandaag bekend gemaakt in een perscommuniqué."
                                            }
