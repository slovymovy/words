                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ae8894a-b390-4468-b014-7b6fa6746a20",
                                "sense_id": "abdbe6a7-07a6-3874-bfd5-0317e404b6e1",
                                "text": "De tektoniek is een vakgebied binnen de aardwetenschappen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93ea5a23-c2f0-4521-8b16-8445d23a6f9e",
                        "source_entry_id": "bc446752-862b-3803-913d-58c697d2f268",
                        "source_sense_id": "4fd7632c-20dc-3b2f-8d28-926aa4ad4f94",
