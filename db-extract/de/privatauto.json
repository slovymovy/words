                        "examples": [
                            {
                                "example_id": "a3f72c33-814d-4ab7-8f20-b62a4f2c31d6",
                                "sense_id": "aea68819-411a-31b9-8531-0e75fd6cc06c",
                                "text": "„Das Privatauto ist unzeitgemäßer Individualismus.“"
                            },
                            {
                                "example_id": "900a736d-f880-4f3f-89ac-55bde6824e04",
                                "sense_id": "aea68819-411a-31b9-8531-0e75fd6cc06c",
                                "text": "„Vor dem Kabarett parkten viele Privatautos.“"
                            },
                            {
                                "example_id": "4b876ff6-2cb8-4e5f-a5a1-53f78d3124a9",
                                "sense_id": "aea68819-411a-31b9-8531-0e75fd6cc06c",
                                "text": "„Das große Privatauto, in das Franz Biberkopf gelegt wird - ohne Bewußtsein, er hat Kampfer und Skopolaminmorphium bekommen - rast zwei Stunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
