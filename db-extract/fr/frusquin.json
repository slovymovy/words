                    {
                        "sense_id": "27c26762-1cf0-3699-a8f9-6ca85323407a",
                        "entry_id": "c91d6bd7-327c-3d7a-95de-1acd4d780c4b",
                        "glosses": [
                            "Ce qu’un homme a d’argent et de nippes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f5b2cbb-10b8-4ac8-9cb4-28792f874957",
                                "sense_id": "27c26762-1cf0-3699-a8f9-6ca85323407a",
                                "text": "Polissons sont ceux qui ont des frusquins (habits) qui ne valent que floutière (rien) ; en hiver quand sigris bouesse (il fait froid), c’est lorsque leur état est plus chenâtre (meilleur), etc. (Le Jargon.)"
                            },
                            {
                                "example_id": "f25b3e71-e295-4ed9-a3c6-aa7c6b6cd7e6",
                                "sense_id": "27c26762-1cf0-3699-a8f9-6ca85323407a",
                                "text": "Ah ! si ma garce de femme, avant d’en crever, n’avait pas bu tout mon saint-frusquin, à mesure que je le gagnais !"
                            },
                            {
                                "example_id": "109b86c7-8b77-428c-9afe-0c071ef8cac2",
                                "sense_id": "27c26762-1cf0-3699-a8f9-6ca85323407a",
                                "text": "Il a perdu tout son frusquin."
                            }
                        ]
                    }
                ],
