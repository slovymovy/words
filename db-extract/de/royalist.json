                "senses": [
                    {
                        "sense_id": "cdfa77fe-05a2-35e2-a612-42f9ab863c82",
                        "entry_id": "2dcefe3f-26ad-31cd-82fa-271c647e84e6",
                        "glosses": [
                            "jemand, der für das Königtum/den König eintritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "790fa9cf-1d65-4415-809a-cb597e0cc02b",
                                "sense_id": "cdfa77fe-05a2-35e2-a612-42f9ab863c82",
                                "text": "„Gebürtige Südamerikaner hingegen wurden geschont, selbst wenn sie für die Royalisten gekämpft hatten.“"
                            },
                            {
                                "example_id": "bed7732d-a61b-49e4-83cb-8bd2c5b26ce1",
                                "sense_id": "cdfa77fe-05a2-35e2-a612-42f9ab863c82",
                                "text": "„Als überzeugter Royalist und Anhänger Karls will er dem neuen »Bürgerkönig« nicht dienen und reist auf eigene Kosten aus Algier ab.“"
                            },
                            {
                                "example_id": "beecfa1e-2f7c-4e87-bec0-293c529fa4fd",
                                "sense_id": "cdfa77fe-05a2-35e2-a612-42f9ab863c82",
                                "text": "„Der Traum des Royalisten ist es, dass die Erinnerungen nicht den Neubauten weichen müssen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
