                                                "example_id": "0f0285cb-606b-407c-bc8d-0e507412f7bf",
                                                "sense_id": "c378db36-9847-32e1-93ba-2ff1b8c8f0d6",
                                                "text": "La lucerne ou lanterne d’allumeur renferme , outre une lampe fixe , une petite lampe à main, qui tient lieu de bougie pour l’allumage des phares."
                                            },
                                            {
                                                "example_id": "44e91d95-337e-44c7-a5e4-40b43ba63cec",
                                                "sense_id": "c378db36-9847-32e1-93ba-2ff1b8c8f0d6",
                                                "text": "En 1738, Lardier, le premier fondeur des Forges, est renvoyé pour avoir raté, après plusieurs essais, le premier allumage du fourneau."
                                            },
                                            {
                                                "example_id": "67893148-2955-4042-a0a5-eb290abd0d8d",
                                                "sense_id": "c378db36-9847-32e1-93ba-2ff1b8c8f0d6",
                                                "text": "Elle avait plusieurs commandes devant elle : un circulateur à changer chez le buraliste, un chauffe-eau à gaz qui frisait l’explosion à chaque allumage — ici, c’était le grand truc —, et une vidange qui refoulait, ici même, au café."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "782546a4-e9ce-35c0-a442-40a95b5c8a94",
                                        "entry_id": "0b109c62-244e-3187-9631-c9c6838a1bab",
                                        "glosses": [
                                            "Inflammation du mélange gazeux combustible contenu dans la chambre à explosion."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "214127a9-19ec-3c23-9138-985c4c193953",
                                        "entry_id": "0b109c62-244e-3187-9631-c9c6838a1bab",
                                        "glosses": [
                                            "Opération donnant naissance à la combustion d’une poudre ou d’une charge propulsive."
                                        ],
                                        "tags": [
                                            "Armement-Matériaux énergétiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
