                ],
                "senses": [
                    {
                        "sense_id": "072076a6-bd4d-3c94-b544-08bcca0d5a9b",
                        "entry_id": "3c00b865-0b44-3e39-9bd6-bbd7bdc274c5",
                        "glosses": [
                            "eine krankhafte Anhäufung von Basen im Blut mit einem pH-Wert von pH > 7,43"
                        ],
                        "tags": [
                            "Physiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "763e6af5-d2a1-474f-893d-7be05e98e78f",
                                "sense_id": "072076a6-bd4d-3c94-b544-08bcca0d5a9b",
                                "text": "„Die Alkalose führt zu erniedrigten Plasma-Calciumspiegeln und damit zu erhöhter Erregbarkeit von Nerven und Muskeln.“"
                            },
                            {
                                "example_id": "ca7bfdbd-c3b0-4eb0-bf44-6efe33dd27b0",
                                "sense_id": "072076a6-bd4d-3c94-b544-08bcca0d5a9b",
                                "text": "„Aufgrund des herrschenden Sauerstoffmangels kommt es zu einer reflektorischen Hyperventilation, die durch vermehrtes Abatmen von CO2 zu einer respiratorischen Alkalose führt […].“"
                            },
                            {
                                "example_id": "93ec5a07-f93d-4ddf-9fc0-1d1ec83c8ef8",
                                "sense_id": "072076a6-bd4d-3c94-b544-08bcca0d5a9b",
                                "text": "„Als Folge einer Alkalose kann unter anderem eine Tetanie auftreten.“"
                            },
                            {
                                "example_id": "2d8b3542-ef04-45a1-87ce-0061378c6a05",
                                "sense_id": "072076a6-bd4d-3c94-b544-08bcca0d5a9b",
                                "text": "„Bei Blutuntersuchungen zeigen sich eine Hyponatriämie, einer Hypophosphatämie, wie auch einer Hypokaliämie mit metabolischer hypochlorämischer Alkalose.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
