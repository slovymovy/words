            "senses": [
                {
                    "sense_id": "146962fc-0970-3856-bbd8-69686f7d0e44",
                    "sense_definition": "Ensemble ou classe dans laquelle on range des personnes ou des choses présentant des caractères communs.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "classification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les produits du magasin sont classés par <w>catégorie</w> pour faciliter les recherches des clients."
                        },
                        {
                            "text": "Cette nouvelle voiture appartient à la <w>catégorie</w> des véhicules électriques haut de gamme."
                        }
                    ],
                    "synonyms": [
                        "classe",
                        "groupe",
                        "ordre"
                    ],
                    "common_phrases": [
