                    "frequency": "Middle",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le poids total des bagages ne doit pas <w>excéder</w> vingt kilos par passager."
                        },
                        {
                            "text": "Les dépenses totales risquent d'<w>excéder</w> largement les prévisions financières établies pour l'année."
                        }
                    ],
                    "synonyms": [
