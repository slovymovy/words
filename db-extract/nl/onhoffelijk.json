                                        "sense_id": "5a3969af-9e0a-38d1-9a50-f13a0bf1b0e0",
                                        "entry_id": "9d6edc52-9b59-3531-a5cc-92d1a94ebe62",
                                        "glosses": [
                                            "Having bad manners; impolite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4da59241-d53e-4eca-a48d-207410f16e12",
                                                "sense_id": "5a3969af-9e0a-38d1-9a50-f13a0bf1b0e0",
                                                "text": "He was extremely ill-mannered and caused offence wherever he went."
                                            }
                                        ]
