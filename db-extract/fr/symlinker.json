                                "example_id": "56882c49-e10f-47fc-aa91-7a68bdf6972e",
                                "sense_id": "c64def46-3661-381a-abe0-2a5f99fbfb35",
                                "text": "Et quel serait le partitionnement idéal du HDD alors (et je symlinke quoi vers quoi)?"
                            }
                        ]
                    }
