                                                "sense_id": "bfd0a07b-4661-3be4-9b4a-53d80d607cbd",
                                                "text": "the era of gray, boring banality and stagnation"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37a4c6b4-dc34-3efe-9f62-af8b064396d7",
                                        "entry_id": "642797b0-9f0e-3598-8024-12262b4c18c2",
                                        "glosses": [
                                            "Of indistinct, disputed or uncertain quality or acceptability."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
