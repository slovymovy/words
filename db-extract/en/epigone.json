                    {
                        "translation_id": "838eab20-b837-4fe9-bbb0-4ac3148b8ab6",
                        "source_entry_id": "34dc7e6c-bf37-315b-8d79-70d71f690b3c",
                        "source_sense_description": "imitator of artist or style",
                        "target_lang_word": "epigon",
