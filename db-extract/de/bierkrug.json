                ],
                "translations": [
                    {
                        "translation_id": "b25ee9e2-54a9-4f6d-bb21-476d4a71e9ec",
                        "source_entry_id": "0e144dfa-d83c-36cc-b8c5-22d2f50b5c93",
                        "source_sense_id": "aca60e2b-9933-3292-a8ab-88a531c35abf",
                        "source_sense_description": "ein größeres Gefäß zum Trinken von Bier",
                        "target_lang_word": "beer mug",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ced73fbd-2b5e-4648-b872-f143c231716b",
                        "source_entry_id": "0e144dfa-d83c-36cc-b8c5-22d2f50b5c93",
                        "source_sense_id": "aca60e2b-9933-3292-a8ab-88a531c35abf",
                        "source_sense_description": "ein größeres Gefäß zum Trinken von Bier",
                        "target_lang_word": "stein",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stein",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "141d9900-5e99-3cee-a4d5-117bf0537e5c",
                                        "entry_id": "c6a4f63b-0c23-3abe-b6de-ca558ba5db24",
                                        "glosses": [
                                            "A beer mug, usually made of ceramic or glass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc4590ad-2bbc-48d1-9da5-73e36223683c",
                                                "sense_id": "141d9900-5e99-3cee-a4d5-117bf0537e5c",
                                                "text": "So this was my future home, I thought! Certainly it made a brave picture. I had seen similar ones fired-in on many a Heidelberg stein—coloring and all. Backed by towering hills,[…]a sky of palest Gobelin flecked with fat, fleecy little clouds, it in truth looked a dear little city; the city of one's dreams."
                                            },
                                            {
                                                "example_id": "36802d07-d52e-4df9-b282-7d8e2d3c90c1",
                                                "sense_id": "141d9900-5e99-3cee-a4d5-117bf0537e5c",
                                                "text": "A gnome-size German civilian with a red von Hindenburg mustache is dispensing steins of what looks to be mostly head."
                                            },
                                            {
                                                "example_id": "333c17e1-985e-4030-bb9f-aeb9c827a91b",
                                                "sense_id": "141d9900-5e99-3cee-a4d5-117bf0537e5c",
                                                "text": "[…] those 50 grams of resin-soaked dope, which had been so potent that on the second day it had given him an anxiety attack so paralyzing that he had gone to the bathroom in a Tufts University commemorative ceramic stein to avoid leaving his bedroom,[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "97d045ba-7270-460a-8783-256b437238b5",
                        "source_entry_id": "0e144dfa-d83c-36cc-b8c5-22d2f50b5c93",
                        "source_sense_id": "aca60e2b-9933-3292-a8ab-88a531c35abf",
                        "source_sense_description": "ein größeres Gefäß zum Trinken von Bier",
                        "target_lang_word": "pot à bière",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "31d9256f-5af2-47e7-9bd3-854152b2f23c",
                        "source_entry_id": "0e144dfa-d83c-36cc-b8c5-22d2f50b5c93",
                        "source_sense_id": "aca60e2b-9933-3292-a8ab-88a531c35abf",
                        "source_sense_description": "ein größeres Gefäß zum Trinken von Bier",
                        "target_lang_word": "chope",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chope",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14f7d9b1-3ae1-3748-9337-f4772babd2b2",
                                        "entry_id": "d21610d2-ac75-348d-915d-f7f3482479c0",
                                        "glosses": [
                                            "Grand récipient cylindrique à anse pour boire de la bière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4f6a22b-90fc-4626-b75d-5723dd1f4e5d",
                                                "sense_id": "14f7d9b1-3ae1-3748-9337-f4772babd2b2",
                                                "text": "On sert les bières dans des chopes aux fêtes de la bière en Allemagne."
                                            },
                                            {
                                                "example_id": "1056511a-b1ca-4efd-95a5-ffe7825479a5",
                                                "sense_id": "14f7d9b1-3ae1-3748-9337-f4772babd2b2",
                                                "text": "Je vis assis, tel qu'un ange aux mains d'un barbier,\nEmpoignant une chope à fortes cannelures,\nL'hypogastre et le col cambrés, une Gambier\nAux dents, sous l'air gonflé d'impalpables voilures."
                                            },
                                            {
                                                "example_id": "fa6e3838-f68b-4a54-99e3-6158a4d43501",
                                                "sense_id": "14f7d9b1-3ae1-3748-9337-f4772babd2b2",
                                                "text": "Je ne voyage que dans les pays à bière, et je juge les villes à la capacité des chopes. Je tente l’épreuve dès la sortie de la gare : si le verre à bière est réduit à la taille ridicule du bock moderne, je reprends mon bagage. Lla ville est jugée : c’est une ville mesquine, plate, étroite, tout à fait anti-artistique."
                                            },
                                            {
                                                "example_id": "e3effb35-c0d4-44af-be9f-7219d8597ae3",
                                                "sense_id": "14f7d9b1-3ae1-3748-9337-f4772babd2b2",
                                                "text": "Deux bouquets de chopes dans les mains, le serveur n’hésite pas à pousser les débris hors de sa route quand il apporte la bière et sa voix couvre un instant celle des chanteurs : « À qui la fraîche sans faux col ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7d8533e-323a-32e3-b0bf-b922b5331999",
                                        "entry_id": "d21610d2-ac75-348d-915d-f7f3482479c0",
                                        "glosses": [
                                            "Son contenu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "625dc9cd-1ee3-44b3-9355-2c1741d9f87c",
                                                "sense_id": "c7d8533e-323a-32e3-b0bf-b922b5331999",
                                                "text": "Napoléon torcha son assiette et vida sa chope d'eau."
                                            },
                                            {
                                                "example_id": "91a5e8bb-9f66-4888-a046-45e35c5836f6",
                                                "sense_id": "c7d8533e-323a-32e3-b0bf-b922b5331999",
                                                "text": "— C'est ici qu'intervient le « Sturm-Lokal », la brasserie qui sert d'annexe à chaque « Sturm-Kaserne ». On s'y réunit le soir pour commenter le Coran brun en buvant des chopes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2eb98eb-0157-3824-880d-a789c35648be",
                                        "entry_id": "d21610d2-ac75-348d-915d-f7f3482479c0",
                                        "glosses": [
                                            "Bière légère."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b44f6a9-bf4e-4f6a-9105-5841a5143abc",
                                                "sense_id": "c2eb98eb-0157-3824-880d-a789c35648be",
                                                "text": "Tu veux boire une chope avec moi?"
                                            }
                                        ]
