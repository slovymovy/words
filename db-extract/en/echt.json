                                            {
                                                "example_id": "0090b3bc-22de-4ac6-869f-69c812b9d2d5",
                                                "sense_id": "80d023d6-9e53-33fc-aee4-5d4c8fc051ac",
                                                "text": "Dit zijn echte parels."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "echt",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "946c2dfd-e1db-3903-9621-5b76fc95263c",
                                        "entry_id": "25a69993-32dc-343b-a5e9-3c921f0e503d",
                                        "glosses": [
                                            "heus"
                                        ],
                                        "tags": [
                                            "om de stelligheid van een bewering te benadrukken"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93322494-9d7d-4a07-ad54-89b32a8ac771",
                                                "sense_id": "946c2dfd-e1db-3903-9621-5b76fc95263c",
                                                "text": "Hij zingt echt mooi"
                                            },
                                            {
                                                "example_id": "491a918d-ccf1-4f69-9158-bfdc4515eaa5",
                                                "sense_id": "946c2dfd-e1db-3903-9621-5b76fc95263c",
                                                "text": "Tot mijn verbazing wist ik deze zes weken durende tocht zonder noemenswaardige problemen te voltooien, waardoor ik voor het eerst echt begon te geloven dat mijn ‘American Dream’ wel eens in vervulling zou kunnen gaan."
                                            },
                                            {
                                                "example_id": "139f2ecc-fc2a-4281-8675-dae24d012df1",
                                                "sense_id": "946c2dfd-e1db-3903-9621-5b76fc95263c",
                                                "text": "Deze fabrikanten proberen elkaar flink af te troeven. \"Er is echt een innovatie-oorlog gaande. Omdat er nu zo veel concurrentie is, probeert iedereen nieuwe functies in een auto te stoppen\", zegt Van Dillen. Niet elke innovatie is volgens hem even geslaagd. \"Veel van de nieuwe Chinese auto's hebben een waslijst aan innovaties waar mensen waarschijnlijk niet veel van zullen gebruiken.\""
                                            },
                                            {
                                                "example_id": "f5072a2d-9313-4c7f-a978-cf35985cf88c",
                                                "sense_id": "946c2dfd-e1db-3903-9621-5b76fc95263c",
                                                "text": "\"Het is dit jaar voor eerst dat we het effect zo duidelijk zien\", zegt voorzitter Rachel Heijne van Kringloop Nederland. \"We zien ook dat de kwaliteit van spullen gewoon echt slecht is. Het is kleding die na een paar keer wassen kapot gaat. Die kun je niet in de kringloop verkopen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "837923d6-99d6-3a2b-8043-c5019cdf0a52",
                                        "entry_id": "25a69993-32dc-343b-a5e9-3c921f0e503d",
                                        "glosses": [
                                            "dat is echt ....:typisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6abdcf27-33b6-4f4c-9f0d-080d492315ac",
                                                "sense_id": "837923d6-99d6-3a2b-8043-c5019cdf0a52",
                                                "text": "Om op een sollicitatiegesprek te laat te komen is echt iets voor hem."
                                            }
                                        ]
                                    }
                                ]
                            },
