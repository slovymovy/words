                            }
                        ]
                    },
                    {
                        "translation_id": "c33a59d5-dfef-45e3-bdca-59a6fde64639",
                        "source_entry_id": "a475e561-63b2-3353-ae87-1b995682686e",
                        "source_sense_description": "someone who lives in a city or similar urban area",
                        "target_lang_word": "citadin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "citadin",
