    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "3aa990be-eb46-38f6-a248-8c4077e168ac",
                    "sense_definition": "На большом расстоянии или на большое расстояние.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "spatial_distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Моя школа находится <далеко> от дома, поэтому я езжу на автобусе.",
                            "target_lang_translations": {
                                "en": "My school is <far> from home, so I take the bus.",
                                "zh": "我的学校离家很<w>远</w>，所以我坐公交车去。"
                            }
                        },
                        {
                            "text": "Не уходи <далеко>, мы скоро будем обедать.",
                            "target_lang_translations": {
                                "en": "Don't go <far>, we will be having lunch soon.",
                                "zh": "别走太<w>远</w>，我们很快就要吃午饭了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "неблизко"
                    ],
                    "antonyms": [
                        "близко",
                        "недалеко",
                        "вблизи",
                        "неподалёку"
                    ],
                    "common_phrases": [
                        "далеко от дома",
                        "уйти далеко",
                        "жить далеко"
                    ],
                    "target_lang_definitions": {
                        "en": "At a great distance or to a great distance.",
                        "zh": "指在很大的空间距离上或向很大的空间距离移动。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "far",
                                "target_lang_sense_clarification": "spatial distance"
                            },
                            {
                                "target_lang_word": "far away",
                                "target_lang_sense_clarification": "remote location"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "远",
                                "target_lang_sense_clarification": "空间距离大"
                            },
                            {
                                "target_lang_word": "遥远",
                                "target_lang_sense_clarification": "偏远的地方"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "171642e7-939d-3a3b-b050-b85f2dc1c558",
                    "sense_definition": "Оценка расстояния до чего-либо как значительного (обычно в роли сказуемого).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "spatial_distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "До ближайшей станции метро отсюда очень <далеко>.",
                            "target_lang_translations": {
                                "en": "It is very <far> to the nearest metro station from here.",
                                "zh": "从这儿到最近的地铁站非常<w>远</w>。"
                            }
                        },
                        {
                            "text": "Нам ещё <далеко> идти до вершины горы.",
                            "target_lang_translations": {
                                "en": "We still have <far> to go to the mountain peak.",
                                "zh": "我们离山顶还有很<w>远</w>的路要走。"
                            }
                        }
                    ],
                    "synonyms": [
                        "неблизко"
                    ],
                    "antonyms": [
                        "близко",
                        "недалеко"
                    ],
                    "common_phrases": [
                        "отсюда далеко",
                        "как далеко до"
                    ],
                    "target_lang_definitions": {
                        "en": "Assessment of distance as significant (usually used predicatively).",
                        "zh": "对距离的评估，认为距离很长（通常作谓语）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "far",
                                "target_lang_sense_clarification": "long distance"
                            },
                            {
                                "target_lang_word": "a long way",
                                "target_lang_sense_clarification": "idiomatic expression for distance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "远",
                                "target_lang_sense_clarification": "距离长"
                            },
                            {
                                "target_lang_word": "很远",
                                "target_lang_sense_clarification": "路途遥远"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "237dfb58-e6ba-3b90-8264-dd4f2303fb64",
                    "sense_definition": "В значительной степени; намного (используется для усиления отрицания или сравнения).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "figurative_degree",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот фильм <далеко> не самый интересный из тех, что я видел.",
                            "target_lang_translations": {
                                "en": "This movie is <far> from the most interesting one I've seen.",
                                "zh": "这部电影<w>远</w>非我所看过的电影中最有趣的一部。"
                            }
                        },
                        {
                            "text": "Гости разошлись по домам <далеко> за полночь.",
                            "target_lang_translations": {
                                "en": "The guests went home <way> past midnight.",
                                "zh": "客人们在午夜过<w>远</w>之后才各自回家。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "далеко не",
                        "далеко за"
                    ],
                    "target_lang_definitions": {
                        "en": "To a significant degree; much (used to intensify negation or comparison).",
                        "zh": "在很大程度上；用于加强否定或比较的语气。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "far",
                                "target_lang_sense_clarification": "degree intensifier"
                            },
                            {
                                "target_lang_word": "way",
                                "target_lang_sense_clarification": "informal intensifier"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "远",
                                "target_lang_sense_clarification": "程度副词"
                            },
                            {
                                "target_lang_word": "绝",
                                "target_lang_sense_clarification": "用于否定加强语气"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea039a0b-9a53-36bf-9fed-247cc43388f9",
                    "sense_definition": "Оценка чьих-либо качеств или возможностей как значительно уступающих кому-либо или чему-либо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_comparison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне ещё <далеко> до твоего уровня владения языком.",
                            "target_lang_translations": {
                                "en": "I am still <far> from your level of language proficiency.",
                                "zh": "我的语言水平离你的水平还<w>差得远</w>。"
                            }
                        },
                        {
                            "text": "Этому ресторану <далеко> до идеала, но еда там вкусная.",
                            "target_lang_translations": {
                                "en": "This restaurant is <far> from ideal, but the food there is tasty.",
                                "zh": "这家餐厅离理想标准还<w>差得远</w>，但那里的食物很好吃。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "далеко до идеала",
                        "ему далеко до"
                    ],
                    "target_lang_definitions": {
                        "en": "Assessment of qualities or capabilities as significantly inferior to someone or something.",
                        "zh": "评价某人的素质或能力与某人或某物相比有显著差距。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "far",
                                "target_lang_sense_clarification": "figurative distance"
                            },
                            {
                                "target_lang_word": "a long way",
                                "target_lang_sense_clarification": "figurative gap"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "差得远",
                                "target_lang_sense_clarification": "比喻差距大"
                            },
                            {
                                "target_lang_word": "远不如",
                                "target_lang_sense_clarification": "比喻水平低"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ec824c71-5318-3521-be3b-a78109d21c3e",
                    "sense_definition": "Краткая форма среднего рода единственного числа прилагательного <w>далёкий</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это село <далеко> и неизвестно большинству туристов.",
                            "target_lang_translations": {
                                "en": "This village is <far away> and unknown to most tourists.",
                                "zh": "这个村庄很<w>远</w>，大多数游客都不知道。"
                            }
                        },
                        {
                            "text": "Счастье казалось таким возможным, но теперь оно <далеко>.",
                            "target_lang_translations": {
                                "en": "Happiness seemed so possible, but now it is <far away>.",
                                "zh": "幸福曾经看起来触手可及，但现在它已变得很<w>远</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "short neuter singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Short neuter singular form of the adjective 'distant'.",
                        "zh": "形容词“遥远的”短尾中性单数形式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "far",
                                "target_lang_sense_clarification": "distant"
                            },
                            {
                                "target_lang_word": "distant",
                                "target_lang_sense_clarification": "remote"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "远",
                                "target_lang_sense_clarification": "遥远"
                            },
                            {
                                "target_lang_word": "遥远",
                                "target_lang_sense_clarification": "偏远"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}