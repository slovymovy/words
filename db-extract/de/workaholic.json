                        "source_sense_id": "2344baad-1565-3e1c-aba9-2a853e964bbc",
                        "source_sense_description": "Person, die übermäßig viel arbeitet; jemand, der an Arbeitssucht leidet",
                        "target_lang_word": "workaholic",
