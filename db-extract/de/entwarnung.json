                "senses": [
                    {
                        "sense_id": "dd19dddc-22a7-38cc-ba00-caa8496c9d69",
                        "entry_id": "eac4f938-70f8-34aa-8e0b-1aaa30721ed1",
                        "glosses": [
                            "Aufhebung/Beendigung eines zuvor erklärten Alarms"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb2aaafe-5e72-45b3-aaea-7a5abc319898",
                                "sense_id": "dd19dddc-22a7-38cc-ba00-caa8496c9d69",
                                "text": "„Kam die Entwarnung nach Mitternacht, dann gab es zwei Stunden schulfrei, das war angenehm, mitunter sogar wünschenswert.“"
                            },
                            {
                                "example_id": "37c61a5f-26d7-4fab-bf2a-381eda15e26f",
                                "sense_id": "dd19dddc-22a7-38cc-ba00-caa8496c9d69",
                                "text": "„Hier ist alles zertrümmert, und die Sirenen geben gerade Entwarnung.“"
                            },
                            {
                                "example_id": "ff0a5dc6-fedd-462d-a0d1-04edb65af295",
                                "sense_id": "dd19dddc-22a7-38cc-ba00-caa8496c9d69",
                                "text": "„Nach der Entwarnung gegen drei Uhr früh lief Roman die Treppe hoch und trat auf die Straße.“"
                            },
                            {
                                "example_id": "5b936ca2-b0ae-4dc9-97a3-05296c491e0a",
                                "sense_id": "dd19dddc-22a7-38cc-ba00-caa8496c9d69",
                                "text": "„Seitdem es am frühen Vormittag Alarm gegeben hat, ist noch keine Entwarnung erfolgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
