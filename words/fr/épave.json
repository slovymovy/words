                    "frequency": "VeryLow",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon l'ancienne coutume, les biens considérés comme des <w>épaves</w> revenaient au seigneur."
                        },
                        {
                            "text": "La législation maritime précise les règles d'attribution de toute <w>épave</w> sans maître."
                        }
                    ],
                    "common_phrases": [
                        "droit d'épave"
                    ],
                    "traits": [
