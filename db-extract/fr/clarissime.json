                    {
                        "sense_id": "ed1f8e98-e75f-3567-8ff0-097b9b0b6a8e",
                        "entry_id": "8e969adf-03a9-3078-b12f-0cb3c3ac24d5",
                        "glosses": [
                            "Superlatif de clair."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "923081e2-c69e-412f-94a6-9e9d1a77a9ba",
                                "sense_id": "ed1f8e98-e75f-3567-8ff0-097b9b0b6a8e",
                                "text": "Soit la scène de la statue. Elle est clarissime dans ses profondeurs pour le vrai lecteur que je désire."
                            }
                        ]
                    },
                    {
                        "sense_id": "c08675bd-e2f4-3491-b52d-65ec0752267c",
                        "entry_id": "8e969adf-03a9-3078-b12f-0cb3c3ac24d5",
                        "glosses": [
                            "Très illustre, illustrissime."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "826927b7-0e31-42cc-bfa2-88c36877bbd2",
                                "sense_id": "c08675bd-e2f4-3491-b52d-65ec0752267c",
                                "text": "Ne cherchez donc pas du côté du moral, docteur clarissime, vous ne trouverez rien."
                            },
                            {
                                "example_id": "2ad5076b-edf5-4758-b8f3-dd5c9b3d6289",
                                "sense_id": "c08675bd-e2f4-3491-b52d-65ec0752267c",
                                "text": "Il se croyait positivement à Rhodes où ses ancêtres avaient surtout combattu, et c’était lui-même qui avait imposé le nom de cette forteresse clarissime à son lamentable donjon croulant."
                            }
                        ]
                    }
                ],
