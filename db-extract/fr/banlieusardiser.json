                        "glosses": [
                            "Faire devenir de banlieue, banlieusard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4bc7641f-cfa9-4592-9f57-df563c4f67e4",
                                "sense_id": "06e8a074-8d1b-328e-8f33-3285d5e7a5ef",
                                "text": "Penser la Méditerranée… elle transforme les paysans en agriculteurs et banlieusardise bourgs et villages.…"
                            },
                            {
                                "example_id": "ddb620e3-c9b6-48ce-bb14-10381f823d68",
                                "sense_id": "06e8a074-8d1b-328e-8f33-3285d5e7a5ef",
                                "text": "Banlieusardisé depuis peu, mais point n’était besoin de gratter longtemps ce vernis pour retrouver intégralement la matoiserie originelle."
                            }
                        ]
                    }
