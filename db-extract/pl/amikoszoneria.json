                "senses": [
                    {
                        "sense_id": "cc8848a7-26af-3cb9-ad8b-9337a5d1e568",
                        "entry_id": "27bca67d-69dc-3132-8158-9bc4d6571ef5",
                        "glosses": [
                            "übertriebene Vertrautheit"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
