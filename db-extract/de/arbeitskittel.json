                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c2f1cfe-4111-462f-971f-4b50a2d8b721",
                                "sense_id": "de13bbd5-fe70-3a28-9c05-71bca3ba6b12",
                                "text": "„Der Laufbursche trug einen grünen Arbeitskittel und ein dickes Pflaster auf der linken Wange.“"
                            },
                            {
                                "example_id": "eee932b2-b49f-4c55-ad8d-dbddf7dcb47f",
                                "sense_id": "de13bbd5-fe70-3a28-9c05-71bca3ba6b12",
                                "text": "„Miras weißer Arbeitskittel hat große Taschen.“"
                            },
                            {
                                "example_id": "71f5d95d-f900-455e-b2ba-5c836bea6664",
                                "sense_id": "de13bbd5-fe70-3a28-9c05-71bca3ba6b12",
                                "text": "„Die nächste Serie stammte offenbar aus der Eisenhütte bei Lyon, Papa mit Schutzhelm und Arbeitskittel auf dem Werkgelände, das Gesicht der Sonne zugewandt.“"
                            }
