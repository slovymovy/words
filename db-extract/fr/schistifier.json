                "senses": [
                    {
                        "sense_id": "cbbcc747-e030-381d-8a9d-e2f5c6424cec",
                        "entry_id": "2c1af98b-a86e-33bc-9e48-265fa6521106",
                        "glosses": [
                            "Protéger (une galerie de mine) des explosions grâce à des poussières non combustibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36492d01-2005-4dfe-9352-d7b7dbde0060",
                                "sense_id": "cbbcc747-e030-381d-8a9d-e2f5c6424cec",
                                "text": "Les sacs de poussière étaient amenés en berlines puis répartis, pendant le déchargement, le long de la galerie à schistifier."
                            },
                            {
                                "example_id": "a601791f-a093-48a3-815c-115967f74f9c",
                                "sense_id": "cbbcc747-e030-381d-8a9d-e2f5c6424cec",
                                "text": "En mai l'essai au jour d'une machine à schistifier, d'origine américaine, est assez convaincant pour que soit décidé un programme d'équipement."
                            }
                        ]
                    }
