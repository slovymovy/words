                        "source_sense_id": "f315b994-f381-3b2b-990b-859e77c17558",
                        "target_lang_word": "Unzufriedenheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unzufriedenheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                        "entry_id": "79b52eb1-14aa-31bf-be82-c12206d49361",
                                        "glosses": [
                                            "Zustand, in dem man mit dem Gegebenen, den Verhältnissen und Bedingungen, dem Vorhandenen und Erreichten nicht einverstanden ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "056056a3-a70d-4c6e-9540-78ce6271e9ee",
                                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                                "text": "„Der Deutsche hat an und für sich eine starke Neigung zur Unzufriedenheit.“"
                                            },
                                            {
                                                "example_id": "741401fc-677f-40dd-9625-44df921aeaa9",
                                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                                "text": "„Er spürt die verbreitete Unzufriedenheit über das Kolonialregime.“"
                                            },
                                            {
                                                "example_id": "a30fc500-ce52-468c-b28f-ceb0e9d95115",
                                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                                "text": "„Die große Unzufriedenheit mit dem politischen und wirtschaftlichen System der DDR zeigte sich auch in der hohen Zahl von Flüchtlingen.“"
                                            },
                                            {
                                                "example_id": "b1ead403-0069-49c2-a432-73c35cc837c2",
                                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                                "text": "„Wir möchten unsere Ratlosigkeit und unsere Unzufriedenheit mit dem politischen Geschäft demonstrieren, in dem sich offenbar der Starrköpfigste und Unbeweglichste durchsetzt“, hieß es im Aufruf zu dem Protestmarsch, der im Brüsseler EU-Viertel endete."
                                            },
                                            {
                                                "example_id": "50dd21ac-a02c-44ec-96c4-e3c77481dc02",
                                                "sense_id": "af9be810-643f-3906-815d-b387d74f6a71",
                                                "text": "„Wer nicht zufrieden sein will, muss seine Unzufriedenheit ertragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6069e3e-3dd6-4f05-ba28-31ac024f455f",
                        "source_entry_id": "7c18c757-a565-34e3-a64f-099b4f129b64",
                        "source_sense_id": "f315b994-f381-3b2b-990b-859e77c17558",
                        "target_lang_word": "недово́льство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "недово́льство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "61b57a55-4e8f-3a56-bbd8-9c11cb52990e",
                                        "entry_id": "71475b77-253e-3c23-b27b-363f164dbfec",
                                        "glosses": [
                                            "отсутствие удовлетворённости, отрицательное отношение к кому-чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f0def0-6ce3-425e-a17b-4d72ee69a7ef",
                                                "sense_id": "61b57a55-4e8f-3a56-bbd8-9c11cb52990e",
                                                "text": "Он изнемогает под игом всевозможных невольных союзов и искусственных общественных комбинаций и не хочет верить, что в этих-то невольных союзах и комбинациях и кроется корень всех его недовольств и что устранить эти недовольства нельзя иначе, как устранив причины их породившие."
                                            },
                                            {
                                                "example_id": "4e7c6c07-7e13-45d8-8903-469ba90a4813",
                                                "sense_id": "61b57a55-4e8f-3a56-bbd8-9c11cb52990e",
                                                "text": "Все эти следы его жизни как будто охватили его и говорили ему: «Нет, ты не уйдешь от нас и не будешь другим, а будешь такой же, каков был: с сомнениями, вечным недовольством собой, напрасными попытками исправления и падениями и вечным ожиданием счастья, которое не далось и невозможно тебе»."
                                            },
                                            {
                                                "example_id": "61f414ba-d5be-4459-8a20-cb5c66501616",
                                                "sense_id": "61b57a55-4e8f-3a56-bbd8-9c11cb52990e",
                                                "text": "Обыкновенно я сидел на нижней ступени террасы; меня томило недовольство собой, было жаль своей жизни, которая протекала так быстро и неинтересно, и я все думал о том, как хорошо было бы вырвать из своей груди сердце, которое стало у меня таким тяжелым."
                                            },
                                            {
                                                "example_id": "b2955628-7ba0-46bb-9525-efce674c0d86",
                                                "sense_id": "61b57a55-4e8f-3a56-bbd8-9c11cb52990e",
                                                "text": "А тело никогда не довольно, и от этого недовольства люди, как бедные, так и богатые, стараются забыться в курении или пьянстве."
                                            },
                                            {
                                                "example_id": "c72e14c9-1769-47ae-9ddf-f5c8e9de19cc",
                                                "sense_id": "61b57a55-4e8f-3a56-bbd8-9c11cb52990e",
                                                "text": "В народе росло недовольство войной, дороговизной, всей нищей жизнью, неспособностью и нежеланием царского правительства облегчить положение трудового люда."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e8acd3d9-71d5-4bb9-8248-a754ecab3e32",
                        "source_entry_id": "7c18c757-a565-34e3-a64f-099b4f129b64",
                        "source_sense_id": "f315b994-f381-3b2b-990b-859e77c17558",
                        "target_lang_word": "неудовлетворённость",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "неудовлетворённость",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8d798dfe-df66-36cd-812d-2f0d1fd14c5d",
                                        "entry_id": "da425224-2b37-3e24-b381-6b86451285ce",
                                        "glosses": [
                                            "свойство или состояние по значению прилагательного неудовлетворённый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d1ab1da-09ae-414c-b3a2-f8c06a674dd7",
                                                "sense_id": "8d798dfe-df66-36cd-812d-2f0d1fd14c5d",
                                                "text": "Неудовлетворённость покупкой."
                                            },
                                            {
                                                "example_id": "1ac09716-f4b1-44fd-9c67-833cd1547842",
                                                "sense_id": "8d798dfe-df66-36cd-812d-2f0d1fd14c5d",
                                                "text": "Сразу же чувствуя, что крылатую женщину угнетают сомнения и неудовлетворённость, зритель, однако, становится в тупик перед множеством рассеянных здесь намёков."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
