                {
                    "sense_id": "c8570c84-c897-35f5-b509-695a2406e048",
                    "sense_definition": "A short form of male names such as Alan, Albert, Alexander, or Alfred.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My neighbor <w>Al</w> helps me with the garden every weekend.",
                            "target_lang_translations": {
                                "ru": "Мой сосед <w>Эл</w> помогает мне в саду каждые выходные.",
                                "zh": "我的邻居<w>阿尔</w>每个周末都会帮我打理花园。"
                            }
                        },
                        {
                            "text": "Everyone calls him <w>Al</w>, but his full name is actually Albert.",
                            "target_lang_translations": {
                                "ru": "Все зовут его <w>Эл</w>, но на самом деле его полное имя — Альберт.",
                                "zh": "大家都叫他<w>阿尔</w>，但他的全名其实是阿尔伯特。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Uncle Al",
                        "Big Al"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "diminutive"
                        }
