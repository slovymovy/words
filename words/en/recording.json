{
    "word_family": [
        "record",
        "recorder"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3ccdb358-b1d9-3d98-a15d-1efa9ae207a9",
                    "sense_definition": "A piece of music, speech, or video that has been stored on a tape, disc, or digital file.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I listened to a <w>recording</w> of the speech to understand the details.",
                            "target_lang_translations": {
                                "ru": "Я прослушал <w>запись</w> речи, чтобы понять детали.",
                                "zh": "我听了一段演讲的<w>录音</w>以了解细节。"
                            }
                        },
                        {
                            "text": "The band released a new <w>recording</w> of their most popular song.",
                            "target_lang_translations": {
                                "ru": "Группа выпустила новую <w>запись</w> своей самой популярной песни.",
                                "zh": "乐队发布了他们最受欢迎歌曲的一首新<w>录音</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "tape",
                        "track",
                        "video",
                        "clip",
                        "audio"
                    ],
                    "common_phrases": [
                        "make a recording",
                        "audio recording",
                        "digital recording",
                        "live recording"
                    ],
                    "target_lang_definitions": {
                        "ru": "Музыкальное произведение, речь или видео, сохраненные на пленке, диске или в цифровом файле.",
                        "zh": "指存储在磁带、光盘或数字文件中的音乐、演讲或视频片段。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "результат: трек, видео, файл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "录音",
                                "target_lang_sense_clarification": "指音频记录"
                            },
                            {
                                "target_lang_word": "录像",
                                "target_lang_sense_clarification": "指视频记录"
                            },
                            {
                                "target_lang_word": "唱片",
                                "target_lang_sense_clarification": "指音乐作品的载体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ca97bf6-a0e9-3372-82d2-af9f5bb4281a",
                    "sense_definition": "The process or action of capturing sound, images, or data to store them permanently.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>recording</w> of the concert took several hours to complete.",
                            "target_lang_translations": {
                                "ru": "<w>Запись</w> концерта заняла несколько часов.",
                                "zh": "音乐会的<w>录制</w>花了几个小时才完成。"
                            }
                        },
                        {
                            "text": "Illegal <w>recording</w> of movies in the cinema is strictly prohibited.",
                            "target_lang_translations": {
                                "ru": "Незаконная <w>запись</w> фильмов в кинотеатре строго запрещена.",
                                "zh": "在电影院非法<w>录制</w>电影是严格禁止的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "capturing",
                        "taping",
                        "filming",
                        "documentation"
                    ],
                    "common_phrases": [
                        "start recording",
                        "stop recording",
                        "during the recording"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или действие по захвату звука, изображений или данных для их постоянного хранения.",
                        "zh": "捕捉声音、图像或数据并将其永久保存的过程或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "процесс сохранения"
                            },
                            {
                                "target_lang_word": "съёмка",
                                "target_lang_sense_clarification": "видеозапись"
                            },
                            {
                                "target_lang_word": "звукозапись",
                                "target_lang_sense_clarification": "аудио"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "录制",
                                "target_lang_sense_clarification": "指进行录音或录像的过程"
                            },
                            {
                                "target_lang_word": "拍摄",
                                "target_lang_sense_clarification": "指视频拍摄过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c5bdfaa-5b1e-3539-ad4c-a1631eaf8c88",
                    "sense_definition": "The act of officially writing down information or entering it into a system or register.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Accurate <w>recording</w> of financial data is essential for the company.",
                            "target_lang_translations": {
                                "ru": "Точная <w>фиксация</w> финансовых данных необходима для компании.",
                                "zh": "准确地<w>记录</w>财务数据对公司至关重要。"
                            }
                        },
                        {
                            "text": "The <w>recording</w> of votes continued late into the night.",
                            "target_lang_translations": {
                                "ru": "<w>Регистрация</w> голосов продолжалась до поздней ночи.",
                                "zh": "选票的<w>登记</w>工作一直持续到深夜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "registration",
                        "logging",
                        "entry",
                        "documentation"
                    ],
                    "common_phrases": [
                        "data recording",
                        "recording of deeds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по официальному письменному фиксированию информации или внесению её в систему или реестр.",
                        "zh": "正式书面记录信息或将其输入系统、登记册的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "регистрация",
                                "target_lang_sense_clarification": "внесение в реестр"
                            },
                            {
                                "target_lang_word": "фиксация",
                                "target_lang_sense_clarification": "документирование данных"
                            },
                            {
                                "target_lang_word": "учёт",
                                "target_lang_sense_clarification": "ведение записей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "登记",
                                "target_lang_sense_clarification": "指列入名册或系统"
                            },
                            {
                                "target_lang_word": "记录",
                                "target_lang_sense_clarification": "指书面或系统性存档"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0039a62b-bbab-31a3-a7ef-567353083510",
                    "sense_definition": "Present participle and gerund of <w>record</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is currently <w>recording</w> a new album in the studio.",
                            "target_lang_translations": {
                                "ru": "В данный момент она <w>записывает</w> новый альбом в студии.",
                                "zh": "她目前正在录音室<w>录制</w>一张新专辑。"
                            }
                        },
                        {
                            "text": "He was caught <w>recording</w> the conversation without permission.",
                            "target_lang_translations": {
                                "ru": "Его поймали за <w>записью</w> разговора без разрешения.",
                                "zh": "他因未经许可<w>录制</w>谈话而被抓住了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола record.",
                        "zh": "动词 record 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "записывающий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "записывая",
                                "target_lang_sense_clarification": "деепричастие"
                            },
                            {
                                "target_lang_word": "запись",
                                "target_lang_sense_clarification": "отглагольное существительное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "录制",
                                "target_lang_sense_clarification": "指正在进行录制动作"
                            },
                            {
                                "target_lang_word": "记录",
                                "target_lang_sense_clarification": "指正在进行书写或登记动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}