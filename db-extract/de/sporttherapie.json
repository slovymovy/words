                "senses": [
                    {
                        "sense_id": "20edefab-7176-3068-b139-d24266636e34",
                        "entry_id": "adc1b912-7c40-32d1-9119-b336f9292560",
                        "glosses": [
                            "Therapieform zur Vorbeugung oder Rehabilitation, die sich Mittel und Methoden des sportlichen Trainings bedient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fed2e46-5ec0-414b-a23c-2c069270fbda",
                                "sense_id": "20edefab-7176-3068-b139-d24266636e34",
                                "text": "„Die Ursprünge der Sport- und Bewegungstherapie reichen bis ins 19. Jahrhundert zurück.“"
                            },
                            {
                                "example_id": "68343c14-c705-4078-b722-861863b81557",
                                "sense_id": "20edefab-7176-3068-b139-d24266636e34",
                                "text": "„In schweren Fällen verlassen sich die Mediziner zunehmend auf nicht-medikamentöse Begleitbehandlung wie Muskelentspannung, Stressbewältigung und die Sporttherapie.“"
                            },
                            {
                                "example_id": "512a091f-7aed-4a00-ad29-0bc4117fbfb0",
                                "sense_id": "20edefab-7176-3068-b139-d24266636e34",
                                "text": "Eine Kombination aus Ergo-, Physio- und Sporttherapie hat mich nach meinem Unfall wieder für den Beruf fit gemacht."
                            }
                        ],
