                                        "tags": [
                                            "Sinneseindruck",
                                            "Geschmacksrichtung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4263e50a-5d06-433e-a1ca-48ce3e7ddec2",
                                                "sense_id": "f09ba1c0-6270-3b9a-aeda-098805cec581",
                                                "text": "Honig ist süß."
                                            },
                                            {
                                                "example_id": "1e9853e7-12e0-40f0-9b14-b659e9855f6e",
                                                "sense_id": "f09ba1c0-6270-3b9a-aeda-098805cec581",
                                                "text": "Das ist zu süß, so kann man das hier nicht als Nachtisch servieren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cce4967d-f0f6-3783-87ea-93ab974dfe94",
                                        "entry_id": "3a005c06-8753-3742-a559-3f286f9991ea",
                                        "glosses": [
                                            "niedlich"
                                        ],
                                        "tags": [
                                            "positive",
                                            "bewundernde und beschützende Gefühle wie einem Kind gegenüber auslösend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33aae636-a5bc-41d6-9f44-67ddcc1d8844",
                                                "sense_id": "cce4967d-f0f6-3783-87ea-93ab974dfe94",
                                                "text": "Ach, ist das ein süßes Plüschtier, das du da hast!"
                                            },
                                            {
                                                "example_id": "6312e152-f338-4029-a63d-b88ca62768e7",
                                                "sense_id": "cce4967d-f0f6-3783-87ea-93ab974dfe94",
                                                "text": "Süßer die Glocken nie klingen, als zu der Weihnachtszeit."
                                            },
                                            {
                                                "example_id": "042838d3-5fda-4094-92d8-64f2a0e428f1",
                                                "sense_id": "cce4967d-f0f6-3783-87ea-93ab974dfe94",
                                                "text": "Danke! Das ist aber süß! Dass ihr daran gedacht habt!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
