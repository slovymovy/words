                ],
                "translations": [
                    {
                        "translation_id": "de22689a-f876-4973-975d-b071d5266ed6",
                        "source_entry_id": "14108b3e-1a26-36fa-8a41-bed48caf8d83",
                        "source_sense_id": "37e83a58-c4c5-37fb-82d5-f2bc1bb8fe25",
                        "source_sense_description": "Bürgerin von Norwegen",
                        "target_lang_word": "Norwegian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Norwegian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c1ee3192-6c74-3f3b-b75e-0a3d9a9546d7",
                                        "entry_id": "ce1cb2e4-94aa-31b9-95e9-b78b9a65bb71",
                                        "glosses": [
                                            "A native of Norway."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3af9156d-247e-4db4-a4b6-48e354ca335e",
                                                "sense_id": "c1ee3192-6c74-3f3b-b75e-0a3d9a9546d7",
                                                "text": "But despite the President’s offer, it’s unlikely that an influx of Norwegians will begin to settle in the US anytime soon."
                                            },
                                            {
                                                "example_id": "6204d060-cefb-4b1e-a937-9b160aed3f67",
                                                "sense_id": "c1ee3192-6c74-3f3b-b75e-0a3d9a9546d7",
                                                "text": "At the age of 22, the Norwegian forward had already established himself as one of the best goalscorers in European football – first at Red Bull Salzburg, then with two prolific seasons at Borussia Dortmund."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3cf81f0-2d87-3510-b5a2-7a48122f4b0c",
                                        "entry_id": "ce1cb2e4-94aa-31b9-95e9-b78b9a65bb71",
                                        "glosses": [
                                            "A kind of fishing boat on the Great Lakes of North America."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b635124a-b237-3211-962a-0db31e1fd3d2",
                                        "entry_id": "ce1cb2e4-94aa-31b9-95e9-b78b9a65bb71",
                                        "glosses": [
                                            "The language of Norway, which has two official forms (written standards): Bokmål and Nynorsk."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5cf2f21c-9988-4f17-9b39-5bfc3b19c348",
                                                "sense_id": "b635124a-b237-3211-962a-0db31e1fd3d2",
                                                "text": "People don’t tend to use sounds that aren’t in their native language. (citation) So if you’re an English speaker, you’re not going to bust out some Norwegian vowels. This rather lets the air out of the theory that individuals engaged in glossolalia are actually speaking another language."
                                            },
                                            {
                                                "example_id": "ae46afc7-0cee-4121-b1d7-a2fb64e2f69e",
                                                "sense_id": "b635124a-b237-3211-962a-0db31e1fd3d2",
                                                "text": "[Kirsten] Gillibrand’s Mandarin can be written off as the résumé-building accomplishment of a striver, while Norwegian, which has no practical value for an American president, is taken as a sign of intellectual curiosity and authenticity — the sort of whimsical surplus achievement that often upstages workaday accomplishments."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Norwegian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f675a76-8e79-3d47-85a4-69848542f61e",
                                        "entry_id": "ffbe4ee4-01a6-30f7-933f-4d23be4db7b8",
                                        "glosses": [
                                            "Of or pertaining to Norway (the country)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "401fafb9-38f4-4a28-9e95-049433dd8278",
                                                "sense_id": "7f675a76-8e79-3d47-85a4-69848542f61e",
                                                "text": "Between Kiruna and the Norwegian border, along the chain of lovely lakes, a number of holiday resorts offering every comfort for the visitor have been developed."
                                            },
                                            {
                                                "example_id": "babaa28c-abd2-4b09-b3be-2c03fcbf6b99",
                                                "sense_id": "7f675a76-8e79-3d47-85a4-69848542f61e",
                                                "text": "Since she sprang from the imagination of the Norwegian playwright Henrik Ibsen in 1890, this coldhearted antiheroine has maintained a tight grip on the attention of audiences across the globe, outstripping all the many other complicated women in Ibsen’s oeuvre, even the door-slamming Nora of “A Doll’s House”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aaf9654-9d1d-301f-9907-4f7533643a93",
                                        "entry_id": "ffbe4ee4-01a6-30f7-933f-4d23be4db7b8",
                                        "glosses": [
                                            "Of or pertaining to the Norwegian people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b32dfba1-c84d-4419-bf54-f38657eaae52",
                                                "sense_id": "4aaf9654-9d1d-301f-9907-4f7533643a93",
                                                "text": "The line ends at Narvik. Eight years ago the whole town was in ruins, but the industry of the Norwegian people has rebuilt it entirely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b54ae67-bbe7-3f39-b155-df60b9bbeb9d",
                                        "entry_id": "ffbe4ee4-01a6-30f7-933f-4d23be4db7b8",
                                        "glosses": [
                                            "Of or pertaining to the Norwegian language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
