                "senses": [
                    {
                        "sense_id": "50256824-37f5-308c-a912-f2f9c628136e",
                        "entry_id": "931fa331-cd79-38df-a87f-6b0a4afbd79e",
                        "glosses": [
                            "Angehörigkeit zu einem Verein oder Verbund; Mitgliedschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cbc8a36-a74e-4f06-85fe-10b696d608be",
                                "sense_id": "50256824-37f5-308c-a912-f2f9c628136e",
                                "text": "„Hiszpania przygotowywała się do członkostwa w Unii Europejskiej przez wiele lat, my musimy to zrobić przez dwa, trzy lata, akceptując wynikające z tego różnego rodzaju szoki dostosowawcze.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d75d96fa-8cc0-41a6-9eea-1e612f9e3939",
                        "source_entry_id": "931fa331-cd79-38df-a87f-6b0a4afbd79e",
                        "source_sense_id": "50256824-37f5-308c-a912-f2f9c628136e",
                        "source_sense_description": "Angehörigkeit zu einem Verein oder Verbund; Mitgliedschaft",
                        "target_lang_word": "Mitgliedschaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mitgliedschaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb6afed-f33c-3636-9a64-067abc04518f",
                                        "entry_id": "2f9e5e1b-bd56-3df2-966d-88b63a919a99",
                                        "glosses": [
                                            "Zustand, in dem jemand Mitglied von etwas ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5b728c2-3a68-452c-acbc-ae492f3295a8",
                                                "sense_id": "dbb6afed-f33c-3636-9a64-067abc04518f",
                                                "text": "Ich möchte meine Mitgliedschaft im Schützenverein kündigen."
                                            },
                                            {
                                                "example_id": "36587ae7-ca7a-4180-9658-3777c8b70155",
                                                "sense_id": "dbb6afed-f33c-3636-9a64-067abc04518f",
                                                "text": "„Die Mitgliedschaft dauert sechs Jahre, eine Wiederberufung ist jedoch möglich.“"
                                            },
                                            {
                                                "example_id": "313eb90b-3f08-44d6-bc66-ce4cb171d74a",
                                                "sense_id": "dbb6afed-f33c-3636-9a64-067abc04518f",
                                                "text": "„Auf dem NATO-Gipfel in Bukarest wurde der Ukraine und Georgien eine Mitgliedschaft [Anmerkung: in der NATO] zwar in Aussicht gestellt, doch ohne Datum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
