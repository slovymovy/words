                {
                    "sense_id": "ba33619f-8f99-3c40-928f-8a7c6a57f2d8",
                    "sense_definition": "Possessing or displaying splendor; shining; very bright.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>splendid</w> sun rose above the horizon, warming the earth.",
                            "target_lang_translations": {
                                "ru": "<w>Сияющее</w> солнце взошло над горизонтом, согревая землю.",
                                "nl": "De <w>stralende</w> zon rees boven de horizon en verwarmde de aarde."
                            }
                        },
                        {
                            "text": "A <w>splendid</w> light filled the ancient cathedral hall.",
                            "target_lang_translations": {
                                "ru": "<w>Ослепительный</w> свет наполнил зал древнего собора.",
                                "nl": "Een <w>schitterend</w> licht vulde de hal van de oude kathedraal."
                            }
                        }
                    ],
