                ],
                "translations": [
                    {
                        "translation_id": "2f6a4536-867e-4e85-afad-ce183005d358",
                        "source_entry_id": "d71c36c6-8f90-3e40-a7fc-0175ee0fbfda",
                        "source_sense_id": "87b066a7-7648-3d4d-864c-58774f6b0324",
                        "target_lang_word": "asphalt",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asphalt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                        "entry_id": "619ce02d-05d5-3951-831c-a59be206fd0e",
                                        "glosses": [
                                            "A sticky, black to brown and highly viscous liquid or semi-solid, composed almost entirely of bitumen with small mineral particles, that is present in most crude petroleums and in some natural deposits."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3384066d-357a-4d53-822d-b0ea8704ec4b",
                                                "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                                "text": "The mining of asphalt was big business in this area in the early twentieth century."
                                            },
                                            {
                                                "example_id": "8c6190b2-5f40-4cdc-9ef6-f630d3ba8c03",
                                                "sense_id": "dd5228d0-44c4-3050-a0fc-3a511efe63d8",
                                                "text": "Felltham wrote in the beginning of the 17th century of the “Bitumated walls of Babylon;” the source of its supply, the fountains of Is, on a tributary of the Euphrates, still yields asphalt."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                        "entry_id": "619ce02d-05d5-3951-831c-a59be206fd0e",
                                        "glosses": [
                                            "Ellipsis of asphalt concrete, a hard ground covering used for roads and walkways."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64a4fc99-d445-4f40-a3aa-9a78fea8b404",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Near-synonyms: tarmac, tarmacadam, blacktop, bitumen"
                                            },
                                            {
                                                "example_id": "26b5c27c-e741-41b1-a6de-636379769b18",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Please hose off the asphalt near the top of the driveway if the trucks get lots of mud on it."
                                            },
                                            {
                                                "example_id": "105cb154-efff-428d-b9fe-55d092027c33",
                                                "sense_id": "dc4adf97-2de4-384f-9129-5183fb7a630a",
                                                "text": "Between the grey mist of rainclouds the sun suddenly appeared to mottle the wet asphalt of Marble Arch in patches of silver and ebony."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asphalt",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eaa61ea5-93d1-339c-bc06-4ca38a2bef4c",
                                        "entry_id": "3dd6664b-8295-3382-af70-896317589cbb",
                                        "glosses": [
                                            "To pave with asphalt."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "32b1beec-c2dc-46f2-b01e-4ca465ac2ada",
                        "source_entry_id": "d71c36c6-8f90-3e40-a7fc-0175ee0fbfda",
                        "source_sense_id": "87b066a7-7648-3d4d-864c-58774f6b0324",
                        "target_lang_word": "worker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "One who works: a person who performs labor for a living; traditionally, especially, manual labor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13711fdb-2e40-46b9-80e0-247a5e15e7eb",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Near-synonym: employee"
                                            },
                                            {
                                                "example_id": "5a6399c5-0b3f-4ae8-b142-5fa2bb33b805",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Fret not thy ſelfe becauſe of euill doers, neither bee thou enuious againſt the workers of iniquitie."
                                            },
                                            {
                                                "example_id": "fbc7e998-979d-49b3-b47c-2996222eeb64",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Writer Ta Chen, in a statistical study of industrial labor in China in 1933, recorded that 66.6 percent of the total number of workers in the four main industrial regions of Kwangtung were women. In Shun-te, 81.2 percent of the labor force were women."
                                            },
                                            {
                                                "example_id": "68875285-4c6f-47f6-81e0-48c104c9ee14",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese […] began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death. Nowadays workers are exposed to far lower doses and manganism is rare."
                                            },
                                            {
                                                "example_id": "9f6a7db4-d29c-4779-b9f9-7c7fad265f74",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Although the radiation levels identified are high, a threat to human health is very unlikely because apart from workers at the site, no-one goes there."
                                            },
                                            {
                                                "example_id": "455b28ad-223f-4925-b8b4-8ab3789d13cc",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "That would allow employers to keep some tip money for themselves, as long as each worker made at least the full federal minimum wage of $7.25 an hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de39e866-8ea3-3fd0-8c54-2ae731a05a99",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A nonreproductive social insect, such as ant, bee, termite, or wasp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a901efe-a474-3783-a606-47ae4f5de623",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A nonreproductive social insect, such as ant, bee, termite, or wasp.",
                                            "A female ant, bee, termite or wasp."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d27498dd-084d-3449-b21c-77e2a1a762d2",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A thread performing one instance of a particular task within a program."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a32f3911-f600-46d7-9da8-ac0a9bf9245c",
                                                "sense_id": "d27498dd-084d-3449-b21c-77e2a1a762d2",
                                                "text": "This FTP client spawns a separate worker for each file to be uploaded."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
