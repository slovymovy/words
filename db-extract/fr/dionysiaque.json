                "word": "dionysiaque",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "531f49d7-8da7-421d-9ed9-b152dd40c547",
                        "entry_id": "9d71a46e-824a-3ceb-a469-51715f53a6ff",
                        "tags": [
