                        "examples": [
                            {
                                "example_id": "8b228619-76c1-4dd3-8414-4c7495c0d561",
                                "sense_id": "63d20ab4-7d9c-376a-b7c5-a9dac013ea21",
                                "text": "„Der Carver hat den geraden Alpinski der neunziger Jahre längst abgelöst.“"
                            },
                            {
                                "example_id": "9cef2a6e-79c1-4a36-b303-c8c7f338844b",
                                "sense_id": "63d20ab4-7d9c-376a-b7c5-a9dac013ea21",
                                "text": "„Der Verkauf von Alpinski ist massiv eingebrochen, weltweit werden noch rund eine Million Paar Ski verkauft.“"
                            },
                            {
                                "example_id": "3f13cd4b-1147-439c-8d2c-4993fd6e1687",
                                "sense_id": "63d20ab4-7d9c-376a-b7c5-a9dac013ea21",
                                "text": "„Fast jedes zweite nach Deutschland importierte Paar Alpinski ist „made in China“.“"
                            }
                        ],
