                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spieltisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "902077a6-e30a-337a-9956-c01c4ab097a4",
                                        "entry_id": "d4c76f2a-0dd6-37d2-ad14-22522941a22b",
                                        "glosses": [
                                            "Tisch, an dem gespielt wird: Glücksspiele und andere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "487a78d6-5cf4-4232-8595-8cc8a1b2c885",
                                                "sense_id": "902077a6-e30a-337a-9956-c01c4ab097a4",
                                                "text": "„Dann kehrte der frisch Rasierte an seinen Spieltisch zurück, und der Barbier packte seine Scherinstrumente in eine bemerkenswert schöne braune Ledertasche und verließ die Höhle, ein lebender Beweis seiner Kunst.“"
                                            },
                                            {
                                                "example_id": "c1bddd0c-761f-41ad-b5c6-16e8ac5da06f",
                                                "sense_id": "902077a6-e30a-337a-9956-c01c4ab097a4",
                                                "text": "„Er trank das barbarisch scharfe Gesöff und konnte trotzdem nicht von den Augen am Spieltisch loskommen.“"
                                            },
                                            {
                                                "example_id": "6e6b9265-ff93-448b-8a6d-369303a6b4d9",
                                                "sense_id": "902077a6-e30a-337a-9956-c01c4ab097a4",
                                                "text": "„Sie war vom Spieltisch aufgestanden und rechnete gerade ab, als Rostow kam.“"
                                            },
                                            {
                                                "example_id": "993e0960-c1fd-44c0-a1b5-200c3ce29164",
                                                "sense_id": "902077a6-e30a-337a-9956-c01c4ab097a4",
                                                "text": "„Eine Viertelstunde später setzte sie sich an den Spieltisch, und ich ging essen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f406d97b-8ce6-359a-89fb-3254d9a6134a",
                                        "entry_id": "d4c76f2a-0dd6-37d2-ad14-22522941a22b",
                                        "glosses": [
                                            "Teil der Orgel, von dem aus alles gesteuert wird"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
