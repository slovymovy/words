                    {
                        "sense_id": "0a7d5a40-7930-3dd6-9a00-7b19c428690e",
                        "entry_id": "d396a07b-c0a0-3aaf-b7b4-92f814872c42",
                        "glosses": [
                            "op grove wijze de regels van hoffelijkheid en respect schendend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fea8a861-8e2c-4ed4-acae-4c7a87073d82",
                                "sense_id": "0a7d5a40-7930-3dd6-9a00-7b19c428690e",
                                "text": "Die onbeschofte rekel komt er niet meer in."
                            },
                            {
                                "example_id": "bf34c0a4-e1e7-4334-b194-e62457b3c80d",
                                "sense_id": "0a7d5a40-7930-3dd6-9a00-7b19c428690e",
                                "text": "In de Oval Office werd niet alleen Zelensky op een ongelofelijk onbeschofte manier onderuitgehaald – de doodvermoeide leider die al drie jaar dag en nacht in touw is om zijn land uit de klauwen van Poetin te houden – maar vielen ook alle maskers af over de westerse alliantie."
                            },
                            {
                                "example_id": "b1a44c7a-ee50-40b8-a082-610fc27b2761",
                                "sense_id": "0a7d5a40-7930-3dd6-9a00-7b19c428690e",
                                "text": "Er waren de nodige vervelende lui, die onbeschoft, arrogant of verwend waren en ik deed mijn best om ze te vermijden."
                            }
                        ]
                    }
                ],
