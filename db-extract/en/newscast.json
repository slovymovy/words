                                        "sense_id": "e814f15a-ee3b-3a6b-982a-de17cdd7eb42",
                                        "entry_id": "e4009c38-33af-3a92-af69-ac36a8d09526",
                                        "glosses": [
                                            "Journal d’informations quotidien diffusé par une chaine de télévision à heures fixes."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42dc9ef2-6d04-453e-ac27-db9e26f98864",
                                                "sense_id": "e814f15a-ee3b-3a6b-982a-de17cdd7eb42",
                                                "text": "Le téléjournal de 18 heures."
                                            },
                                            {
                                                "example_id": "0714ec78-1c5d-4822-a37b-6656ff343ccb",
                                                "sense_id": "e814f15a-ee3b-3a6b-982a-de17cdd7eb42",
                                                "text": "La durée des téléjournaux est presque la même. Elle est habituellement de trente minutes, à l’exception de celui de Radio-Canada qui est plus court de cinq minutes. Les téléjournaux européens sont moins sous la contrainte d’horaires fixes et leur durée peut être prolongée […]."
                                            },
                                            {
                                                "example_id": "3d76cf6a-e728-4c7d-8f40-bd4801055aec",
                                                "sense_id": "e814f15a-ee3b-3a6b-982a-de17cdd7eb42",
                                                "text": "Le terme de « procès » n’est d’ailleurs pas un vain mot, puisque la commission des plaintes de la SSR a dû se pencher sur trois douzaines de réclamations concernant la manière dont le téléjournal suisse alémanique avait couvert les manifestations de Zurich."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2f51b15-6e44-495b-923d-80b6240e0e05",
                        "source_entry_id": "d1b898ff-f6b8-3e05-801e-30fb1830ec27",
                        "source_sense_id": "8695c7cc-d0af-3275-9006-5d10ef7a9e1e",
                        "source_sense_description": "broadcast of news",
                        "target_lang_word": "Nachrichtensendung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nachrichtensendung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6aec5517-7ee8-3e03-af19-c95aed564958",
                                        "entry_id": "a217fb15-e26f-34f3-91a9-136987ed9c34",
                                        "glosses": [
                                            "Sendung in Rundfunk oder Fernsehen, in der Nachrichten vermittelt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ff489b4-195e-4405-bec2-d257c5fdfca9",
                                                "sense_id": "6aec5517-7ee8-3e03-af19-c95aed564958",
                                                "text": "Die Nachrichtensendungen kommen bei den verschiedenen Sendern teilweise zu unterschiedlichen Zeiten."
                                            },
                                            {
                                                "example_id": "1610b794-6c55-492a-b114-d2b08bc1efea",
                                                "sense_id": "6aec5517-7ee8-3e03-af19-c95aed564958",
                                                "text": "„Später dann, während des Krieges, arbeitete ich beim Auswärtigen Amt im Abhördienst für die Nachrichtensendungen aus London.“"
                                            },
                                            {
                                                "example_id": "8901b24e-a3ab-40fc-b3e1-97ce1d9a80c8",
                                                "sense_id": "6aec5517-7ee8-3e03-af19-c95aed564958",
                                                "text": "„Ich suchte mir eine Nachrichtensendung, doch der Weg von mir zu den Ereignissen war weit.“"
                                            },
                                            {
                                                "example_id": "cefed2f4-bd4c-48a4-8fbf-1ca9bcc98f1c",
                                                "sense_id": "6aec5517-7ee8-3e03-af19-c95aed564958",
                                                "text": "„Wir schalteten die Nachrichtensendung ein, die schon den ganzen Nachmittag lief, denn soeben war der Golfkrieg ausgebrochen, und die Entwicklung wurde die ganze Zeir aktualisiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0dc6400-b779-4c1a-8a21-6660a9e27f16",
                        "source_entry_id": "d1b898ff-f6b8-3e05-801e-30fb1830ec27",
                        "source_sense_id": "8695c7cc-d0af-3275-9006-5d10ef7a9e1e",
                        "source_sense_description": "broadcast of news",
                        "target_lang_word": "Tagesschau",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tagesschau",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8676d058-3146-3fe7-b1fb-74e2d2c2c31b",
                                        "entry_id": "120bf9e3-4fb0-38ed-b0f9-029c6a4ab134",
                                        "glosses": [
