                                "target_senses": [
                                    {
                                        "sense_id": "20a2e18d-26e5-3abe-9b4e-bc2e4e43fad1",
                                        "entry_id": "dcec3fa7-d4c8-3df9-9038-9543e25d997a",
                                        "glosses": [
                                            "In an indirect manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca4c042-3338-4894-8516-a13173daed86",
                                                "sense_id": "20a2e18d-26e5-3abe-9b4e-bc2e4e43fad1",
                                                "text": "His alcoholism had a direct effect on his health, and indirectly caused problems for others."
                                            },
                                            {
                                                "example_id": "5ec25608-e92c-49dc-8dc6-fadae65465eb",
                                                "sense_id": "20a2e18d-26e5-3abe-9b4e-bc2e4e43fad1",
                                                "text": "At laſt a new Ceſſation of Hoſtilities upon theſe Points was reſolved on; yet the Hatred continues, and the War goes on, though more covertly, and more indirectly than before."
                                            },
                                            {
                                                "example_id": "b2c75552-64ea-4675-a447-e9d02213304a",
                                                "sense_id": "20a2e18d-26e5-3abe-9b4e-bc2e4e43fad1",
                                                "text": "For while he refers to his gout (a good disease), he does not mention the complaint which indirectly killed him, his hydrocele – an enlargement of the scrotum."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4d06530-ac52-4793-bff4-c73b8e1948d5",
                        "source_entry_id": "2c7c8b41-a55a-31fc-a561-261ae993f4b2",
                        "source_sense_id": "80386a81-73a0-3d29-bdff-2a3292c6a9f3",
                        "target_lang_word": "obliquely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obliquely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9c434510-e129-3cbf-aea0-e6d2fe82710a",
                                        "entry_id": "e3f5b4dc-08eb-3871-9cb0-c2d212069258",
                                        "glosses": [
                                            "In an oblique manner; sideways."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e0b8be5-e2c1-400b-ab6f-160a9f6d06da",
                                                "sense_id": "9c434510-e129-3cbf-aea0-e6d2fe82710a",
                                                "text": "Then, advancing obliquely towards us, came a fifth."
                                            },
                                            {
                                                "example_id": "228fd525-da6b-4217-8027-da7ecc2c2749",
                                                "sense_id": "9c434510-e129-3cbf-aea0-e6d2fe82710a",
                                                "text": "Finally I descended the hill, obliquely, towards the trees I had seen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c83f5288-5169-4391-9269-0f3fab189126",
