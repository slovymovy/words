                                        "sense_id": "6b9c2dce-dc0b-3f60-9b13-da75ad9f9b2c",
                                        "entry_id": "d237b766-6c36-345c-bffb-17d931964bb2",
                                        "glosses": [
                                            "Constriction anormale et souvent douloureuse des mâchoires souvent due à une pathologie (tétanos)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0146a46b-3a83-440b-b535-1e38c9545833",
                                                "sense_id": "6b9c2dce-dc0b-3f60-9b13-da75ad9f9b2c",
                                                "text": "Le trisme empêche la mastication et est très dangereux pour le malade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34960697-2fa8-41e4-9f36-9790c126ce24",
                        "source_entry_id": "f21ed05c-b41c-3c9f-9045-f0f6583efb73",
                        "source_sense_id": "fd2b867b-c5f2-3627-869e-3460620ff8d1",
                        "source_sense_description": "disease",
                        "target_lang_word": "trismus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "trismus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "941fc3fd-8651-36e4-8ad6-2658fdafa869",
                                        "entry_id": "0f84f9ec-9438-312c-9e28-0c41394c1510",
                                        "glosses": [
                                            "Contraction constante et involontaire des muscles des mâchoires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b5859d0-23c3-4b62-8324-1c0f3b2e0e02",
                                                "sense_id": "941fc3fd-8651-36e4-8ad6-2658fdafa869",
                                                "text": "J’enfonçais mes ongles dans mes paumes ; je crispais les maxillaires sous le trismus de l’entêtement ; je fronçais les sourcils…"
                                            },
                                            {
                                                "example_id": "11a245b0-d2ec-46b5-9d5e-8b2d8683767a",
                                                "sense_id": "941fc3fd-8651-36e4-8ad6-2658fdafa869",
                                                "text": "La raideur est en effet une crampe du mollet dans le pied, et une crampe du mollet est une raideur dans le bas de la jambe. Avoir la gueule bloquée par un trismus, c’est un peu pareil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc366feb-1e93-4dad-8f6c-b5e8080f4324",
                        "source_entry_id": "f21ed05c-b41c-3c9f-9045-f0f6583efb73",
                        "source_sense_id": "fd2b867b-c5f2-3627-869e-3460620ff8d1",
                        "source_sense_description": "disease",
                        "target_lang_word": "Tetanus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Tetanus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b15f987-9fb5-3670-8001-f52a56a96a64",
                                        "entry_id": "f5e57329-3687-3620-aebf-9f439151aa37",
                                        "glosses": [
                                            "Infektionskrankheit, die Lähmungen und Muskelkrämpfe zur Folge hat und häufig tödlich endet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dbd0d4f-25aa-4429-bf61-33bb9729ab5c",
                                                "sense_id": "7b15f987-9fb5-3670-8001-f52a56a96a64",
                                                "text": "Die Impfung gegen Tetanus wurde 1927 eingeführt."
                                            },
                                            {
                                                "example_id": "c7384481-4551-4aca-801d-1cac8bcf1695",
                                                "sense_id": "7b15f987-9fb5-3670-8001-f52a56a96a64",
                                                "text": "„Bei anderen Infektionskrankheiten wie Diphtherie, Tetanus, Keuchhusten und anderen ist zwar eine weltweite Ausrottung nicht erreichbar, aber die in deutschsprachigen und vielen anderen Ländern erreichten Erfolge der Schutzimpfung sind sehr eindrucksvoll.“"
                                            },
                                            {
                                                "example_id": "b6697a8a-ce72-4a37-9311-f4210aff0926",
                                                "sense_id": "7b15f987-9fb5-3670-8001-f52a56a96a64",
                                                "text": "„Beide Male musste ich ins Krankenhaus, bekam scheußliche Spritzen gegen Tetanus, Tollwut oder weiß der Teufel was für Krankheiten.“"
                                            },
                                            {
                                                "example_id": "a16557ee-bfa0-44ad-bcf4-72827077a2e6",
                                                "sense_id": "7b15f987-9fb5-3670-8001-f52a56a96a64",
                                                "text": "„Auf dem Rückweg starb ihr Sohn Christie an Tetanus, und der trauernden Mutter wurden die Truhen mit den letzten Habseligkeiten gestohlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
