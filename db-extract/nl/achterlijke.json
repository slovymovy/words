                        "tags": [],
                        "examples": [
                            {
                                "example_id": "467c5d49-9ad2-4980-95d9-381ed9cf8671",
                                "sense_id": "98a86e7c-647c-3764-abbe-201e91bc5acb",
                                "text": "De rechter opende zijn mond en toen hij sprak deed hij dit niet in het formele Arabisch, waarmee hij tot nu toe de zaal had toegesproken, maar in zijn dialect, om zo aan de achterlijke meute duidelijk te maken wat hij zojuist had gezegd. 'Hij kan helemaal geen kinderen krijgen.'"
                            }
                        ]
                    },
                    {
                        "sense_id": "c75ec139-5fcb-35b2-95c6-32ed0423ca01",
                        "entry_id": "074d3c80-fb7f-323b-aed0-106f2cbadd8d",
