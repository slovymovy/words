                "senses": [
                    {
                        "sense_id": "4cb0a0d0-883b-37e6-9598-f32d384ee9fd",
                        "entry_id": "f859ec8a-2060-3117-9d84-71369868f11b",
                        "glosses": [
                            "Action de synthétiser, de rendre synthétique."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "e755e711-3280-43ac-9d1e-3a87d00927b0",
                                "sense_id": "4cb0a0d0-883b-37e6-9598-f32d384ee9fd",
                                "text": "Une telle synthétisation de la théorie implique un haut degré d’unité des explications fournies, de la cohérence philosophique, conceptuelle et méthodologique."
                            },
                            {
                                "example_id": "ce57f735-2144-4023-93c7-9a5b151cdad9",
                                "sense_id": "4cb0a0d0-883b-37e6-9598-f32d384ee9fd",
                                "text": "Ces divers travaux mettant en rapport des linguistes, des phonéticiens et des informaticiens a permis la synthétisation de la parole qui conduit des machines à « dialoguer » entres elles sans intervention humaine."
                            },
                            {
                                "example_id": "dc71f69d-9271-46cd-a572-81c95b566c0d",
                                "sense_id": "4cb0a0d0-883b-37e6-9598-f32d384ee9fd",
                                "text": "Dans la pomme, la concentration des sucres s’accroît pendant toute la durée de la formation de l’amidon et même après que la synthétisation d’amidon a cessé."
                            },
                            {
                                "example_id": "d02d0574-c433-416a-8b17-c8424b6a6867",
                                "sense_id": "4cb0a0d0-883b-37e6-9598-f32d384ee9fd",
                                "text": "Quoi qu’il en soit, et en attendant la synthétisation des systèmes philosophiques qui discordent à notre époque, il résulte de ce qui précède : (…)’' — (Robert (du Var), Éléments de philosophie sociale rédigés d’après les écrits de Pierre Leroux, 1843)"
                            }
                        ]
                    }
                ],
