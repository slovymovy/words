{
    "word_family": [
        "gasper",
        "gaspingly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9437b3f5-6d61-366b-a914-78f629ad4eec",
                    "sense_definition": "To draw in the breath suddenly, as if from a shock or surprise.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience <w>gasped</w> in surprise as the magician disappeared from the stage.",
                            "target_lang_translations": {
                                "ru": "Зрители <w>ахнули</w> от удивления, когда фокусник исчез со сцены."
                            }
                        },
                        {
                            "text": "She <w>gasped</w> with horror when she saw the damage to her car.",
                            "target_lang_translations": {
                                "ru": "Она <w>вскрикнула</w> от ужаса, когда увидела повреждения на своей машине."
                            }
                        }
                    ],
                    "synonyms": [
                        "gulp"
                    ],
                    "common_phrases": [
                        "gasp with horror",
                        "gasp in surprise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапно вдохнуть воздух от шока или удивления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ахнуть",
                                "target_lang_sense_clarification": "от удивления или испуга"
                            },
                            {
                                "target_lang_word": "вскрикнуть",
                                "target_lang_sense_clarification": "коротко вдохнув от неожиданности"
                            },
                            {
                                "target_lang_word": "затаить дыхание",
                                "target_lang_sense_clarification": "от изумления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7331624c-0a37-396d-89d5-5ef4501ea9fb",
                    "sense_definition": "To breathe quickly or in a labored manner, especially after heavy physical exertion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "breathing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were all <w>gasping</w> for air when we finally reached the mountain summit.",
                            "target_lang_translations": {
                                "ru": "Мы все <w>задыхались</w> от нехватки воздуха, когда наконец достигли вершины горы."
                            }
                        },
                        {
                            "text": "The runner <w>gasped</w> for breath after finishing the long marathon.",
                            "target_lang_translations": {
                                "ru": "Бегун тяжело <w>ловил ртом воздух</w> после завершения длинного марафона."
                            }
                        }
                    ],
                    "synonyms": [
                        "pant",
                        "puff",
                        "wheeze"
                    ],
                    "common_phrases": [
                        "gasp for air",
                        "gasp for breath"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часто или тяжело дышать, особенно после сильной физической нагрузки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "задыхаться",
                                "target_lang_sense_clarification": "от нехватки воздуха"
                            },
                            {
                                "target_lang_word": "тяжело дышать",
                                "target_lang_sense_clarification": "после бега или нагрузки"
                            },
                            {
                                "target_lang_word": "ловить ртом воздух",
                                "target_lang_sense_clarification": "пытаясь отдышаться"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52a8c8c1-68fe-3d77-8071-de583c700f64",
                    "sense_definition": "To have a strong or desperate desire for something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "desire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the long meeting, I am absolutely <w>gasping</w> for a cup of tea.",
                            "target_lang_translations": {
                                "ru": "После долгого совещания я просто <w>умираю как хочу</w> чашку чая."
                            }
                        },
                        {
                            "text": "The thirsty hikers were <w>gasping</w> for a cold drink in the heat.",
                            "target_lang_translations": {
                                "ru": "Изнывающие от жажды туристы на жаре <w>мечтали</w> о холодном напитке."
                            }
                        }
                    ],
                    "synonyms": [
                        "crave",
                        "long"
                    ],
                    "common_phrases": [
                        "gasping for a drink"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in British English to mean very thirsty"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь сильное или отчаянное желание чего-либо (часто о питье)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "умирать как хотеть",
                                "target_lang_sense_clarification": "разг., очень сильно желать"
                            },
                            {
                                "target_lang_word": "жаждать",
                                "target_lang_sense_clarification": "сильно хотеть пить или чего-то еще"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "841360d0-00b5-37a2-9efb-31c1a96a45f8",
                    "sense_definition": "To speak in a breathless or struggling manner.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speaking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old man <w>gasped</w> his last few words to his family.",
                            "target_lang_translations": {
                                "ru": "Старик, <w>задыхаясь</w>, произнес свои последние слова семье."
                            }
                        },
                        {
                            "text": "Help me, she <w>gasped</w>, clutching her chest in pain.",
                            "target_lang_translations": {
                                "ru": "«Помогите мне», — <w>прохрипела</w> она, схватившись за грудь от боли."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gasp out words"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить, задыхаясь или с трудом прерывая дыхание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прохрипеть",
                                "target_lang_sense_clarification": "едва дыша"
                            },
                            {
                                "target_lang_word": "выдавить",
                                "target_lang_sense_clarification": "слова, задыхаясь"
                            },
                            {
                                "target_lang_word": "произнести задыхаясь",
                                "target_lang_sense_clarification": "прерывистым голосом"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a387716-d538-3db7-a8ab-63b0d74362bf",
                    "sense_definition": "A short, sudden intake of breath.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "breathing_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience gave a <w>gasp</w> of astonishment when the winner was announced.",
                            "target_lang_translations": {
                                "ru": "В зале раздался изумленный <w>вздох</w>, когда объявили победителя."
                            }
                        },
                        {
                            "text": "There was an audible <w>gasp</w> in the room when the secret was revealed.",
                            "target_lang_translations": {
                                "ru": "Когда тайна была раскрыта, в комнате послышался отчетливый <w>вздох</w> удивления."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gasp of astonishment",
                        "audible gasp"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий, внезапный вдох."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судорожный вздох",
                                "target_lang_sense_clarification": "от испуга или изумления"
                            },
                            {
                                "target_lang_word": "вскрик",
                                "target_lang_sense_clarification": "сопровождаемый вдохом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba099739-b64c-351c-a96e-13a1a818a65c",
                    "sense_definition": "A draw or drag on a cigarette.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "smoking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am just popping out for a quick <w>gasp</w> before the next session starts.",
                            "target_lang_translations": {
                                "ru": "Я просто выскочу на быструю <w>затяжку</w> перед началом следующей сессии."
                            }
                        },
                        {
                            "text": "He took a long <w>gasp</w> on his cigarette and looked out the window.",
                            "target_lang_translations": {
                                "ru": "Он сделал глубокую <w>затяжку</w> и посмотрел в окно."
                            }
                        }
                    ],
                    "synonyms": [
                        "drag",
                        "puff"
                    ],
                    "common_phrases": [
                        "out for a gasp"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal British usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Затяжка сигаретой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затяжка",
                                "target_lang_sense_clarification": "вдох табачного дыма"
                            },
                            {
                                "target_lang_word": "перекур",
                                "target_lang_sense_clarification": "брит. разг., короткий перерыв на сигарету"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "1588f640-6c89-35f4-9748-a5b451705b8c",
                    "sense_definition": "An exclamation representing the sound of a gasp, often used to express mock shock.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Gasp</w>! What will happen next in this dramatic story?",
                            "target_lang_translations": {
                                "ru": "<w>О боже</w>! Что же произойдет дальше в этой драматичной истории?"
                            }
                        },
                        {
                            "text": "He jokingly said <w>gasp</w> when I told him the price of the coffee.",
                            "target_lang_translations": {
                                "ru": "Он в шутку <w>ахнул</w>, когда я назвал ему цену на кофе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in digital communication or storytelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Междометие, имитирующее звук вздоха, часто для выражения притворного шока."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "о боже",
                                "target_lang_sense_clarification": "имитация шока"
                            },
                            {
                                "target_lang_word": "ах",
                                "target_lang_sense_clarification": "звукоподражание вздоху"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "70848d1e-b3a1-3089-812e-5fd35c48115f",
                    "sense_definition": "An acronym for globalist, academic, secular and progressive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acronym",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author criticized the <w>GASP</w> values held by the Western establishment.",
                            "target_lang_translations": {
                                "ru": "Автор критиковал ценности <w>GASP</w>, которых придерживается западный истеблишмент."
                            }
                        },
                        {
                            "text": "Some critics argue that <w>GASP</w> sources dominate the current media landscape.",
                            "target_lang_translations": {
                                "ru": "Некоторые критики утверждают, что источники <w>GASP</w> доминируют в современном медиапространстве."
                            }
                        }
                    ],
                    "common_phrases": [
                        "GASP sources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аббревиатура: глобалистский, академический, светский и прогрессивный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "GASP",
                                "target_lang_sense_clarification": "политическая аббревиатура"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}