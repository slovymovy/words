                "senses": [
                    {
                        "sense_id": "f57277ac-9233-30c5-adab-cbb170091420",
                        "entry_id": "288a4fe1-7f55-3c0e-821d-4245f176680d",
                        "glosses": [
                            "To bubble; to gurgle."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "051bd25f-95c7-35dc-90e0-cac9f8e32c49",
                        "entry_id": "288a4fe1-7f55-3c0e-821d-4245f176680d",
                        "glosses": [
                            "To babble; to speak in an excited rush."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f74fac2-547e-43d0-9648-e700a03a1742",
                                "sense_id": "051bd25f-95c7-35dc-90e0-cac9f8e32c49",
                                "text": "She burbled on, as if I cared to listen."
                            },
                            {
                                "example_id": "9be03b0d-c37d-4d24-8b68-f22d87a35317",
                                "sense_id": "051bd25f-95c7-35dc-90e0-cac9f8e32c49",
                                "text": "\"No, Jo, it wasn't one bit crowded, there was room enought ^([sic]) for everyone,\" she burbled on. \"And we were there, and all these other wymeen too, of all shapes, sizes, and colors...\""
                            },
                            {
                                "example_id": "43d707b1-5bc5-4bf3-91d7-d90fc0607102",
                                "sense_id": "051bd25f-95c7-35dc-90e0-cac9f8e32c49",
                                "text": "“No way this one’s going to miss us this time,” burbles one bebooted doomsdayer to another."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fac3da6f-f910-4b31-a412-cb14539ea228",
                        "source_entry_id": "288a4fe1-7f55-3c0e-821d-4245f176680d",
                        "source_sense_description": "to bubble, to gurgle",
                        "target_lang_word": "murmelen",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "murmelen",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "235a9212-207d-3b3b-be46-62782e68557a",
                                        "entry_id": "ed7bdf66-33a5-3685-ae17-48ae54051bc2",
                                        "glosses": [
                                            "zachtjes en onverstaanbaar praten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b71563-91bd-4ce6-8149-89cf96ce8b03",
                                                "sense_id": "235a9212-207d-3b3b-be46-62782e68557a",
                                                "text": "Mijn oude oma zat altijd in haar stoel te murmelen."
                                            },
                                            {
                                                "example_id": "d81949e6-f5c1-4dec-8d79-555b648b2c7d",
                                                "sense_id": "235a9212-207d-3b3b-be46-62782e68557a",
                                                "text": "Centrum Gent, stralende winterdag die wel lente lijkt. Aan mijn vrolijke soldeneuforie komt prompt een eind als ik word achtervolgd door een man. Twee straten lang loopt hij achter me aan, van alles murmelend wat ik niet versta of wil verstaan. Instant angst, onderbuik in een kramp. Aan mijn auto blijft hij zich opdringen tot ik instap en wegrijd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ed30f88-6eea-3c2e-bead-eac5c7d827bf",
                                        "entry_id": "ed7bdf66-33a5-3685-ae17-48ae54051bc2",
                                        "glosses": [
                                            "zacht ruisen van bijvoorbeeld een beekje"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b40918fe-8995-3b28-9b0b-87ebd2f4d020",
                                        "entry_id": "ed7bdf66-33a5-3685-ae17-48ae54051bc2",
                                        "glosses": [
                                            "zachtjes mopperen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be49c54f-ee35-4491-b741-9a04060ebc6a",
                                                "sense_id": "b40918fe-8995-3b28-9b0b-87ebd2f4d020",
                                                "text": "Na de 2-1 komt het oude euvel om de hoek kijken. We gaan te veel naar achteren lopen, het publiek begint te murmelen en de dreiging van de 2-2 ligt op de loer. Daarbij wil ik ook de complimenten aan Achilles geven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
