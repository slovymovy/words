                    {
                        "sense_id": "7eee7655-81a8-38a9-acf6-c7b97ffd9afa",
                        "entry_id": "9993acc0-4944-3032-9f86-fa725a61a0bf",
                        "glosses": [
                            "zebranie przedstawicieli duchowieństwa i świeckich w kościołach chrześcijańskich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0694bb-aa98-495e-b9e3-9f64c24076c1",
                                "sense_id": "7eee7655-81a8-38a9-acf6-c7b97ffd9afa",
                                "text": "Biskup diecezjalny może wezwać na synod diecezjalny w charakterze członków także innych, czy to duchownych, czy członków instytutów życia konsekrowanego, czy wiernych świeckich"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "5c1ebd3a-5397-336d-8913-292676a609c2",
                        "entry_id": "9993acc0-4944-3032-9f86-fa725a61a0bf",
                        "glosses": [
                            "w prawosławiu: stała rada biskupów"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "358d8875-4d42-4f98-9173-987585b23d30",
                        "source_entry_id": "9993acc0-4944-3032-9f86-fa725a61a0bf",
                        "source_sense_id": "7eee7655-81a8-38a9-acf6-c7b97ffd9afa",
                        "target_lang_word": "synod",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synod",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfc26830-4918-3c88-bfd2-c05e12b1dc60",
                                        "entry_id": "663e8b43-fd60-34c5-bfdd-ed32a27e495f",
                                        "glosses": [
                                            "An ecclesiastic council or meeting to consult on church matters."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "599dbe80-ce8c-4492-9d19-7957b575d7e4",
                                                "sense_id": "bfc26830-4918-3c88-bfd2-c05e12b1dc60",
                                                "text": "Addressing a number of previously taboo topics, this synod could result in several liberalizing reforms, though there is no guarantee that it will produce anything at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dc1fb71-83e7-3868-aec5-0e457ab56420",
                                        "entry_id": "663e8b43-fd60-34c5-bfdd-ed32a27e495f",
                                        "glosses": [
                                            "An administrative division of churches, either the entire denomination, as in the Lutheran Church–Missouri Synod, or a mid-level division (middle judicatory, district) as in the Evangelical Lutheran Church in America"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43fb3ffd-64ef-384f-a3c5-5f4a0d3fffcd",
                                        "entry_id": "663e8b43-fd60-34c5-bfdd-ed32a27e495f",
                                        "glosses": [
                                            "An assembly or council having civil authority (formal); a legislative body."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490f1d20-8db0-48e1-af75-2d7558cdf58f",
                                                "sense_id": "43fb3ffd-64ef-384f-a3c5-5f4a0d3fffcd",
                                                "text": "It hath in solemn synods been decreed."
                                            },
                                            {
                                                "example_id": "e8aa69ef-a833-4206-8ba7-b4e1a1e91de7",
                                                "sense_id": "43fb3ffd-64ef-384f-a3c5-5f4a0d3fffcd",
                                                "text": "A third part of the Gods, in synod met / Their deities to assert; who, while they feel / Vigour divine within them, can allow / Omnipotence to none."
                                            },
                                            {
                                                "example_id": "4bda46c0-e121-44b1-a9bf-189c365dc7a7",
                                                "sense_id": "43fb3ffd-64ef-384f-a3c5-5f4a0d3fffcd",
                                                "text": "Parent of Gods and Men, propitious Jove! / And you bright ſynod of the Pow'rs above; / On this my ſon your gracious gifts beſtow; / Grant him to live, and great in arms to grow, [...]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1e47079-f889-36c1-8d33-6354da80e44c",
                                        "entry_id": "663e8b43-fd60-34c5-bfdd-ed32a27e495f",
                                        "glosses": [
                                            "A conjunction of two or more of the heavenly bodies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "089c2903-7553-4653-8b62-81df35114a7b",
                        "source_entry_id": "9993acc0-4944-3032-9f86-fa725a61a0bf",
                        "source_sense_id": "7eee7655-81a8-38a9-acf6-c7b97ffd9afa",
                        "target_lang_word": "synod",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "383367ad-8418-4631-a26c-bff0e87e8381",
                        "source_entry_id": "9993acc0-4944-3032-9f86-fa725a61a0bf",
                        "source_sense_id": "7eee7655-81a8-38a9-acf6-c7b97ffd9afa",
                        "target_lang_word": "synode",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "synode",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "145db9ef-3ad3-388d-9c94-183d1ebb6b52",
                                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                                        "glosses": [
                                            "Assemblée ecclésiastique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                                        "glosses": [
                                            "Assemblée ecclésiastique.",
                                            "Assemblée d'ecclésiastiques catholiques, qui se fait dans chaque diocèse par le mandement de l’évêque ou d’un autre supérieur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d457ec1c-6656-4e3d-a2da-ed7ba36f277a",
                                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                                "text": "Tenir un synode."
                                            },
                                            {
                                                "example_id": "3251f4ee-bf87-4b05-93d7-c841043315c5",
                                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                                "text": "On a même organisé des synodes d’évêques, vers le VIIIᵉ siècle pour délibérer de cette question."
                                            },
                                            {
                                                "example_id": "76f5ad83-4eed-4144-b2ed-69a5541d11a5",
                                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                                "text": "L'étymologie du terme est d'ailleurs suggestive : « synode » vient du grec sun-odos, qui signifie « marcher ensemble », « faire route ensemble ». L'idée est immédiatement présente que l'Église existe grâce à la convergence et à la participation de tous."
                                            },
                                            {
                                                "example_id": "7324143a-118a-4866-aeef-4ba9b041b00f",
                                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                                "text": "C’est en tout cas ce qu’ont demandé les évêques catholiques réunis à Rome, au dernier jour d’un synode (une assemblée convoquée par le pape) sur l’Amazonie, samedi 26 octobre."
                                            },
                                            {
                                                "example_id": "209d4847-1c55-49b5-a4a2-b19aa3927485",
                                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                                "text": "Synode diocésain."
                                            },
                                            {
                                                "example_id": "1ed025fa-1ed9-4e6d-b311-10f8f4afb684",
                                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                                "text": "Aller au synode."
                                            },
                                            {
                                                "example_id": "7b4d8375-ae0f-4bb5-bab8-41e396efd20c",
                                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                                "text": "Convoquer le synode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3738487f-5d7b-35a4-bfce-d63158b067e4",
                                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                                        "glosses": [
                                            "Assemblée ecclésiastique.",
                                            "Assemblée représentative de laïcs et ministres du culte protestants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "503fdc12-dcf3-4e19-97ad-d2abd3d73db9",
                                                "sense_id": "3738487f-5d7b-35a4-bfce-d63158b067e4",
                                                "text": "Synode national, général."
                                            },
                                            {
                                                "example_id": "c69ddd96-b2ac-4611-991e-1c0910168039",
                                                "sense_id": "3738487f-5d7b-35a4-bfce-d63158b067e4",
                                                "text": "Synode provincial."
                                            },
                                            {
                                                "example_id": "19439489-3c12-4c9f-badc-a84165d08f4b",
                                                "sense_id": "3738487f-5d7b-35a4-bfce-d63158b067e4",
                                                "text": "Le synode de Dordrecht."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc9dafe8-f2b6-35ba-af79-f7ca65a45085",
                                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                                        "glosses": [
                                            "Assemblée ecclésiastique.",
                                            "Assemblée de croyants juifs, aussi dite grande Synagogue."
                                        ],
                                        "tags": [
                                            "Judaism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0cc0e516-50e6-4c73-8209-72991e2bac61",
                                                "sense_id": "cc9dafe8-f2b6-35ba-af79-f7ca65a45085",
                                                "text": "Le Grand Synode (…) qui rappelait le Conseil des Anciens de Moïse (…) se composait de 120 membres (…). Ceux qui en faisaient partie n'étaient pas des prêtres, mais des savants et des sages."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
