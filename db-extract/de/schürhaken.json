                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a69df53e-bd7f-3ba4-80e5-b8192aaed9b2",
                                        "entry_id": "a30f6cef-9269-3eda-a061-fae8845a3f60",
                                        "glosses": [
                                            "One who pokes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1aa174fb-3ff6-4aba-b3d1-6deee2f5942f",
                                                "sense_id": "a69df53e-bd7f-3ba4-80e5-b8192aaed9b2",
                                                "text": "The guy next to him poked him in the ribs and said, “Check out the bazongas on this one!” Lee pivoted toward the rib poker and found himself looking straight into the face of Romeo Bouchard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3383da7-3877-33c8-9d98-7e596a71e946",
                                        "entry_id": "a30f6cef-9269-3eda-a061-fae8845a3f60",
                                        "glosses": [
                                            "A kind of duck, the pochard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cb9651e6-06fe-3f88-a1af-2a2604bac2f2",
                                        "entry_id": "a30f6cef-9269-3eda-a061-fae8845a3f60",
                                        "glosses": [
                                            "A knife."
                                        ],
                                        "tags": [
                                            "Multicultural-London-English",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61791e46-1923-4736-98f7-f2b7fba92819",
                                                "sense_id": "cb9651e6-06fe-3f88-a1af-2a2604bac2f2",
                                                "text": "Key sense with the super-soaker\nLongest poker, leave man stressed like yoga"
                                            },
                                            {
                                                "example_id": "96f6d19f-a216-4df2-a644-40ba733e2d24",
                                                "sense_id": "cb9651e6-06fe-3f88-a1af-2a2604bac2f2",
                                                "text": "There is that guy that does with the pokings\nI step with my poker\nPlay, cuz right, you might get folded"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "504cb957-191d-3bf5-ae0c-671584c72a3f",
                                        "entry_id": "9e2223f6-ce66-3414-aa13-01dec1663ae1",
                                        "glosses": [
                                            "To poke with a utensil such as a poker or needle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3403e50-6276-45db-80ea-8075f20336cb",
                                                "sense_id": "504cb957-191d-3bf5-ae0c-671584c72a3f",
                                                "text": "The King continued pokering the fire with his back to the door, and took no notice of Lord Chesterfield."
                                            },
                                            {
                                                "example_id": "eae725a7-3808-4d3e-b783-450279a460ee",
                                                "sense_id": "504cb957-191d-3bf5-ae0c-671584c72a3f",
                                                "text": "The lids have very pleasant designs pokered on with a hot needle."
                                            },
                                            {
                                                "example_id": "64c81df9-fd14-4885-abf7-b9cd365f8ad1",
                                                "sense_id": "504cb957-191d-3bf5-ae0c-671584c72a3f",
                                                "text": "When she was gone Bell was afflicted by a mood that had her moving round the room, holding on to the yellow curtain, standing over her girls, stroking the sails of the model yacht, opening the drawer and looking at the broken brooch, pokering the fire, and shifting the kettle's position on the hearth."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e965ed4f-fb71-3927-853a-0e9c5b5d647a",
                                        "entry_id": "c5ddb17b-8b13-3032-928b-b7622c451511",
                                        "glosses": [
                                            "Any of various card games in which, following each of one or more rounds of dealing or revealing cards, the players in sequence make tactical bets or drop out, the bets forming a pool to be taken either by the sole remaining player or, after all rounds and bets have been completed, by those remaining players who hold a superior hand according to a standard ranking of hand values for the game."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22dd5538-6009-4c25-af31-5da967a9f20d",
                                                "sense_id": "e965ed4f-fb71-3927-853a-0e9c5b5d647a",
                                                "text": "As mesmerizing as it is to watch Kristen Kish whip up bacon and cinnamon waffles with boysenberry and strawberry jam, imagine playing poker with Hosea Rosenberg."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c85c190-362d-37e2-91c1-439cf6c876e8",
                                        "entry_id": "c5ddb17b-8b13-3032-928b-b7622c451511",
                                        "glosses": [
                                            "All the four cards of the same rank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6fc6aec-ef53-3b00-8c26-a8aac4f4681c",
                                        "entry_id": "c5ddb17b-8b13-3032-928b-b7622c451511",
                                        "glosses": [
                                            "The scoring of four goals by a player in one match."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d4fe6e1-96d1-4014-8597-48ff44b608ce",
                                                "sense_id": "a6fc6aec-ef53-3b00-8c26-a8aac4f4681c",
                                                "text": "Greaves hit three hat-tricks, two pokers and five goals against West Brom on his way to a record-setting 41 league goals."
                                            },
                                            {
                                                "example_id": "1c315007-f80f-4359-9e7c-9b986567445f",
                                                "sense_id": "a6fc6aec-ef53-3b00-8c26-a8aac4f4681c",
                                                "text": "Poker Face: Taty Castellanos strikes FOUR times for NYCFC vs. RSL"
                                            },
                                            {
                                                "example_id": "71d97b57-8cea-4f65-8b97-1e10f9b41947",
                                                "sense_id": "a6fc6aec-ef53-3b00-8c26-a8aac4f4681c",
                                                "text": "Ibra has scored a \"poker\" on four separate occasions during his career: twice with Paris Saint-Germain and twice for Sweden. The most famed example must surely be his single-handed crushing of England in a friendly back in 2012, when the striker rounded off a 4-2 victory for the Swedes with a truly immense long-range overhead kick in the final minute."
                                            },
                                            {
                                                "example_id": "80360e88-1722-4f2c-b462-b7b6b844ddf0",
                                                "sense_id": "a6fc6aec-ef53-3b00-8c26-a8aac4f4681c",
                                                "text": "The only player who scored a poker at Nou Camp is Milinko Pantić. Curiously, despite his 4 goals, his team (Atlético Madrid) lost the game."
                                            },
                                            {
                                                "example_id": "12bcfe44-80d2-48d9-9ed4-914c30b177fe",
                                                "sense_id": "a6fc6aec-ef53-3b00-8c26-a8aac4f4681c",
                                                "text": "Daka also became only the fifth player to score four or more in a Europa League match, and the second fastest after Willian José, whose 'poker' came in the space of 26 minutes for Real Sociedad at Vardar in 2017."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e7a670d-2710-31fb-93ff-aa85fb41786a",
                                        "entry_id": "f6d3ebba-ab98-3665-b38e-d616a4b5395b",
                                        "glosses": [
                                            "To play poker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c01996-5d7f-401b-a2d8-0cc7107c1f5b",
                                                "sense_id": "5e7a670d-2710-31fb-93ff-aa85fb41786a",
                                                "text": "Then we went to Mead's and pokered until morning."
                                            },
                                            {
                                                "example_id": "3a0243b1-3829-4adb-ab46-226bf1cca2f1",
                                                "sense_id": "5e7a670d-2710-31fb-93ff-aa85fb41786a",
                                                "text": "Papa liked nothing better than a game of poker . His pokering habits caused Mama grave anxiety."
                                            },
                                            {
                                                "example_id": "e0c4f308-f603-4c25-bb14-db5b182e698b",
                                                "sense_id": "5e7a670d-2710-31fb-93ff-aa85fb41786a",
                                                "text": "\"He ran with and pokered with us boys,” Bob Paine would recall fifty years later, “ the darndest, pepperyest, finest companion a fellow could ask.”"
                                            },
                                            {
                                                "example_id": "88963865-6227-47c1-92f7-1253739f1dbc",
                                                "sense_id": "5e7a670d-2710-31fb-93ff-aa85fb41786a",
                                                "text": "“Yeah,” Lemming mutters. “We're pokering, so shut the fuck up.” “I raise five,” Blake announces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "poker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5cd73bd7-3b24-3ff1-9aac-91e641cff713",
                                        "entry_id": "6b8d19b2-1208-3be1-8ec3-3520c5a418b8",
                                        "glosses": [
                                            "Any imagined frightful object, especially one supposed to haunt the darkness; a bugbear."
                                        ],
                                        "tags": [
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
