                    }
                ],
                "translations": [
                    {
                        "translation_id": "70d3cd53-85b0-44c5-9679-97c27cbbcdf2",
                        "source_entry_id": "a3d3a2c3-b418-331c-aaa1-9857bd9f4032",
                        "target_lang_word": "nit-pick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ad7b4681-8aaa-45ad-a9df-e9af8b42609e",
                        "source_entry_id": "a3d3a2c3-b418-331c-aaa1-9857bd9f4032",
                        "target_lang_word": "chicaner",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chicaner",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "538d22d6-6c45-3edf-a7f0-5efdc8be86f4",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Soulever, dans un procès, un point mineur de droit pour embrouiller l’affaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c75a3098-4fe9-408c-8d7c-f0e8766ab722",
                                                "sense_id": "538d22d6-6c45-3edf-a7f0-5efdc8be86f4",
                                                "text": "Item, à maistre Jehan Cotard,\nMon procureur en Court d’Eglise,\nDevoye environ ung patard,\nCar à present bien m’en advise,\nQuant chicanner me feit Denise,\nDisant que l’avoye mauldite;\nPour son ame, qu’ès cieulx soit mise!\nCeste Oraison j’ay cy escripte."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805f17f4-1ef9-3473-9705-7b934f0a99a2",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Créer des difficultés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e97dbdf-04e6-423f-be35-5fd4bf218037",
                                                "sense_id": "805f17f4-1ef9-3473-9705-7b934f0a99a2",
                                                "text": "Chicaner le terrain, le disputer pied à pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "feaba0c4-170e-3973-b01a-db2f4503cdbe",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Serrer le vent le plus près possible, comme en lui disputant, parce qu’il est défavorable, une pleine action sur les voiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "448c5b86-9264-4e2c-a24e-dcf5ce0a589b",
                                                "sense_id": "feaba0c4-170e-3973-b01a-db2f4503cdbe",
                                                "text": "Chicaner le vent, gouverner au plus près du vent, presque à ralinguer."
                                            },
                                            {
                                                "example_id": "ed341dac-36bf-41ab-928d-ac2bf0c9c84a",
                                                "sense_id": "feaba0c4-170e-3973-b01a-db2f4503cdbe",
                                                "text": "Un navire qui chicane le vent diminue son sillage et augmente sa dérive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7db415-c4ca-37d0-b12f-20a3ad8de259",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Se servir de subtilités captieuses, contester sans fondement, en quelque matière que ce soit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbb59da4-8b3c-471b-afdf-29df51a927e1",
                                                "sense_id": "fb7db415-c4ca-37d0-b12f-20a3ad8de259",
                                                "text": "Il chicane, ergote sur tout, à propos de tout."
                                            },
                                            {
                                                "example_id": "a9837654-d783-4ae0-a69b-23fc856e3c4b",
                                                "sense_id": "fb7db415-c4ca-37d0-b12f-20a3ad8de259",
                                                "text": "Quelles gens ! disait-il, bon Dieu ! quelles gens ! Avec les uns il faut finir par se battre ; les autres ergotent comme des pédans, chicanent comme des procureurs, et puis s’endorment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec2a1bcc-9818-3276-ad2c-39b8ffbd2a10",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Chercher noise à quelqu’un."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65abf1f3-9314-47ff-970d-581e8c755cfe",
                                                "sense_id": "ec2a1bcc-9818-3276-ad2c-39b8ffbd2a10",
                                                "text": "Cet homme chicane tous ses voisins."
                                            },
                                            {
                                                "example_id": "0ad62f20-49d9-4d55-9ac6-6546c7310c8d",
                                                "sense_id": "ec2a1bcc-9818-3276-ad2c-39b8ffbd2a10",
                                                "text": "Monsieur, vous avez mangé de la mortadelle, vos papiers d’identité, s’il vous plaît ! Je leur ai donc dit que quand on avait dîné comme ils avaient dîné, on ne venait pas chicaner les gens pour une rondelle de saucisson et leur demander les papiers d’identité…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a4694bb-5bff-3cf9-a56e-2885342d9cf7",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Reprendre, critiquer mal à propos et sur des bagatelles."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ed14cde-5069-4663-ab51-f0eb633bc8b3",
                                                "sense_id": "4a4694bb-5bff-3cf9-a56e-2885342d9cf7",
                                                "text": "Cessez de le chicaner à tout propos."
                                            },
                                            {
                                                "example_id": "9d29e4ab-3909-445d-80ee-cd755f75e438",
                                                "sense_id": "4a4694bb-5bff-3cf9-a56e-2885342d9cf7",
                                                "text": "La feue Reine-mère, de son côté, ne vivoit pas trop bien avec le Roi : elle le chicanoit en toutes choses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Se chamailler, se quereller."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3561666-d725-4524-8c95-fc146b3ebf95",
                                                "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                                "text": "Ils ne cessent de se chicaner."
                                            },
                                            {
                                                "example_id": "8277bb6e-6194-42bb-b724-189b54c9cb2c",
                                                "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                                "text": "Ici, les enfants se chicanent pour des bêtises, pas pour autre chose."
                                            },
                                            {
                                                "example_id": "4933e4d8-7134-4fc2-a97f-2d2e093d9f1c",
                                                "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                                "text": "Imaginez un enfant qui se chicane avec ses parents le matin à table. Il emmagasine ainsi du stress, de l’énergie dans le ventre."
                                            },
                                            {
                                                "example_id": "8e082c85-2d6c-4b42-8813-55161b4b3334",
                                                "sense_id": "ad4c2ec9-8be3-3eb4-9341-058364e91c74",
                                                "text": "Eh ! conscience ou esprit, qu'importe ! Ne chicanons pas sur les mots, je vous prie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d0225c8-75e7-3aee-afb6-866cd7a65b09",
                                        "entry_id": "fd8bc9fb-a93f-3cbf-8888-e96f992d1b5c",
                                        "glosses": [
                                            "Gronder, admonester, enguirlander."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0391f827-10fb-48bb-ada2-818fe9546c5b",
                                                "sense_id": "7d0225c8-75e7-3aee-afb6-866cd7a65b09",
                                                "text": "«J'ai comme eu l'impression qu'on retourne dans les années 1950, à l'époque du \"Speak White\", où on se faisait chicaner parce qu'on parlait en français», lance la députée Ruba Ghazal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc44b59f-5fcc-4a63-8119-b75e47c658ed",
                        "source_entry_id": "a3d3a2c3-b418-331c-aaa1-9857bd9f4032",
                        "target_lang_word": "chercher la petite bête",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chercher la petite bête",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "72a72e5a-17b5-35be-9a3e-4c582e20a3c7",
                                        "entry_id": "b2931877-bac7-33d9-bad7-5ffea696a60e",
                                        "glosses": [
                                            "Regarder trop aux détails, ergoter."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "359ffa0c-8800-4dfb-8e34-25e7f3a75f80",
                                                "sense_id": "72a72e5a-17b5-35be-9a3e-4c582e20a3c7",
                                                "text": "— Je vous dirai que je n’aime pas beaucoup chercher la petite bête et m’égarer dans des pointes d’aiguilles ; on ne perd pas son temps à couper les cheveux en quatre ici, ce n’est pas le genre de la maison, répondit Mme Verdurin, que le docteur Cottard regardait avec une admiration béate et un zèle studieux se jouer au milieu de ce flot d’expressions toutes faites."
                                            },
                                            {
                                                "example_id": "38771a9c-6d5f-4987-9991-df60cb4dbca1",
                                                "sense_id": "72a72e5a-17b5-35be-9a3e-4c582e20a3c7",
                                                "text": "Or il m’était impossible de lui faire des reproches ou de lui poser des questions à propos de choses qu’elle eût déclarées si minimes, si insignifiantes, retenues par moi pour le plaisir de « chercher la petite bête »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
