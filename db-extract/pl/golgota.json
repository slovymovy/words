                "senses": [
                    {
                        "sense_id": "4a7314a9-cc39-3aa5-91e8-5cf911f5780d",
                        "entry_id": "5b537ff3-9ab6-3c7a-9355-15ed44ee7ad1",
                        "glosses": [
                            "niewielkie wzniesienie w Jerozolimie, na którym miał umrzeć Jezus"
                        ],
                        "tags": [
                            "Biblical"
                        ],
                        "examples": [
                            {
                                "example_id": "a9c74175-51f6-4815-9abf-8a97ae62ce90",
                                "sense_id": "4a7314a9-cc39-3aa5-91e8-5cf911f5780d",
                                "text": "Wzniesienie Golgoty znajduje się obecnie we wnętrzu Bazyliki Bożego Grobu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1d53f540-f7f0-3cf1-aa12-8fc8e433d8da",
                        "entry_id": "5b537ff3-9ab6-3c7a-9355-15ed44ee7ad1",
                        "glosses": [
                            "przedstawienie Kalwarii w sztuce, także odtworzenie w krajobrazie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "09e6f73f-ef0f-4cb4-a370-14073400f809",
                                "sense_id": "1d53f540-f7f0-3cf1-aa12-8fc8e433d8da",
                                "text": "Golgota tego renesansowego mistrza zadziwia ilością szczegółów."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "384dba52-5ff5-34df-92c6-568d8b8d00f3",
                        "entry_id": "5b537ff3-9ab6-3c7a-9355-15ed44ee7ad1",
                        "glosses": [
                            "miejsce katorgi, umęczenia"
                        ],
                        "tags": [
                            "metaphoric"
                        ],
                        "examples": [
                            {
                                "example_id": "3d8c6366-29b6-4161-a28e-9f9a9a0cc0e5",
                                "sense_id": "384dba52-5ff5-34df-92c6-568d8b8d00f3",
                                "text": "W miejskim muzeum otwarto wystawę o Golgocie Wschodu."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11eaabd5-6129-49ba-865c-7cdb07ae3734",
                        "source_entry_id": "5b537ff3-9ab6-3c7a-9355-15ed44ee7ad1",
                        "source_sense_id": "4a7314a9-cc39-3aa5-91e8-5cf911f5780d",
                        "target_lang_word": "Golgotha",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Golgotha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b973fbd-d1cb-303c-a2d6-8e2c85297dbe",
                                        "entry_id": "6fbd8fe7-f2d2-3e2a-b3e5-7c263aa880c7",
                                        "glosses": [
                                            "The hill outside Jerusalem where Jesus was crucified."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67a503a8-3454-4440-a561-51b2f37ba1f2",
                                                "sense_id": "8b973fbd-d1cb-303c-a2d6-8e2c85297dbe",
                                                "text": "\"And he bearing his cross went forth into a place called the place of a skull, which is called in the Hebrew Golgotha\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16380bb6-134b-3084-a093-5c1e3fcdf835",
                                        "entry_id": "6fbd8fe7-f2d2-3e2a-b3e5-7c263aa880c7",
                                        "glosses": [
                                            "The rooms of the heads of the colleges."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d2cf0b-d075-49fa-a27b-215910102bdb",
                                                "sense_id": "16380bb6-134b-3084-a093-5c1e3fcdf835",
                                                "text": "But Printing is not the only, nor the principal uſe, for which theſe ſtupendous ſtone-walls were erected; for here is that famous apartment, by idle wits and buffoons nick-named Golgotha, i.e. the place of Sculls or Heads of colleges and halls, where they meet and debate upon all extraordinary affairs, which occur within the precincts of their juriſdiction."
                                            },
                                            {
                                                "example_id": "57a5ffab-3267-438e-8120-16e3c1e8f18e",
                                                "sense_id": "16380bb6-134b-3084-a093-5c1e3fcdf835",
                                                "text": "Graduates […] will never forget that majestic stature, that massive brow, that commanding look, as its possessor paced the ante-chapel of his college, or took his seat of presidence among the skulls of Golgotha."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Golgotha",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5ff19599-d3d7-3628-9d19-2523a437b7df",
                                        "entry_id": "441b5372-5157-3843-af0f-a1c7c03cf4b1",
                                        "glosses": [
                                            "A charnel house."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "451005af-5386-31a9-a128-0e095024797c",
                                        "entry_id": "441b5372-5157-3843-af0f-a1c7c03cf4b1",
                                        "glosses": [
                                            "A hat."
                                        ],
                                        "tags": [
                                            "UK",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2af9865e-e446-417c-9416-87617124d9fe",
                                                "sense_id": "451005af-5386-31a9-a128-0e095024797c",
                                                "text": "[…] to the hat-rail; when Wigg went to put it on, it of course resisted, and giving it a spatch, off came the brim. In his fury at the destruction of his “Golgotha,” Wigg rushed to the counter, and seizing a fifty sovereign brass weight, hurled it […]"
                                            },
                                            {
                                                "example_id": "de48704b-ee3c-4945-be34-b5645739f630",
                                                "sense_id": "451005af-5386-31a9-a128-0e095024797c",
                                                "text": "[…] and finally raised his hat and put it on again, cocked back on one side of his head in exact imitation of the manner in which the tall man carried his golgotha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "84615351-e1e8-4d35-90e9-d157a8bf9105",
                        "source_entry_id": "5b537ff3-9ab6-3c7a-9355-15ed44ee7ad1",
                        "source_sense_id": "4a7314a9-cc39-3aa5-91e8-5cf911f5780d",
                        "target_lang_word": "Golgota",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Golgota",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "555159d8-461c-31a8-a2b1-a651c4c51b03",
                                        "entry_id": "183cfa4a-71e5-3556-b7fa-6330f61ebfbe",
                                        "glosses": [
                                            "místo v Izraeli, kde byl ukřižován Ježíš Kristus"
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7796657d-5229-4f0a-a876-8b5ef4070f8f",
                                                "sense_id": "555159d8-461c-31a8-a2b1-a651c4c51b03",
                                                "text": "Zásuvky [Světlanina] psacího stolu v dětském centru zvonily jako taška z Lidlu. Odsoudili jsme sami sebe k hypertenzi, jícnovým varixům, jaterní cirhóze a dilatační kardiomyopatii, protože jsme stejně jako naši rodiče nedokázali vláčet své kříže na Golgotu střízliví."
                                            },
                                            {
                                                "example_id": "3145d180-5b0f-42ac-8e1c-f9151505ac96",
                                                "sense_id": "555159d8-461c-31a8-a2b1-a651c4c51b03",
                                                "text": "Anatol táhne s ptáky, prchá z Golgoty, ztrácí se v Moskvě, odchází do důchodu, kolonizuje kosmos a vůbec akčně rozvíjí svou jedinečnou migrační poetiku."
                                            },
                                            {
                                                "example_id": "922bc460-e6eb-44ae-9e6e-9ec02a6c8214",
                                                "sense_id": "555159d8-461c-31a8-a2b1-a651c4c51b03",
                                                "text": "Ve strachu před nákazou a možností smrti lépe zrevidujeme způsob, jak a proč žijeme. Alespoň někdo pochopí význam kříže, který nám teď Prozřetelnost položila na záda. Jestli jsme ochotní ho donést na svoji osobní Golgotu, nebo zůstaneme stát a snažit se ho zbavit a jen nadávat na jeho tíhu. Je to příležitost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb2512ce-080a-3f99-b7e7-362aa448306c",
                                        "entry_id": "183cfa4a-71e5-3556-b7fa-6330f61ebfbe",
                                        "glosses": [
                                            "velké utrpení"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4ca4ac3f-053a-42e2-a5c9-d5813b2cee72",
                        "source_entry_id": "5b537ff3-9ab6-3c7a-9355-15ed44ee7ad1",
                        "source_sense_id": "4a7314a9-cc39-3aa5-91e8-5cf911f5780d",
                        "target_lang_word": "Golgotha",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Golgotha",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95eddc09-d51f-30e6-866c-d68838d9fd51",
                                        "entry_id": "452c4455-da12-32f0-b7be-6baf96e37daa",
                                        "glosses": [
                                            "Colline de Jérusalem où Jésus a été crucifié, d’après les évangiles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8161e03-0a5e-4e07-b9c7-5c851952a8c0",
                                                "sense_id": "95eddc09-d51f-30e6-866c-d68838d9fd51",
                                                "text": "D’une main elle [la Mort] tient une faux comme un moissonneur ; de l’autre elle cache la seule blessure qu’elle ait jamais reçue, et que le Christ vainqueur lui porta dans le sein au sommet du Golgotha."
                                            },
                                            {
                                                "example_id": "b126458d-d8ad-4639-bc59-1ce8c7efd175",
                                                "sense_id": "95eddc09-d51f-30e6-866c-d68838d9fd51",
                                                "text": "Quant à Gabin, il a plus l'air de descendre de la Courtille que du Golgotha, mais il s'en lave les pognes."
                                            },
                                            {
                                                "example_id": "605bdb19-b1f8-4ba8-b064-012a639d0a7f",
                                                "sense_id": "95eddc09-d51f-30e6-866c-d68838d9fd51",
                                                "text": "Une fois remplis, ces satanés seaux étaient pareils aux entraves d’un bagnard, et la pénible remontée au foyer prenait des allures de Calvaire du Golgotha."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55247d3a-dd34-42de-88ae-f07058afb1ae",
                        "source_entry_id": "5b537ff3-9ab6-3c7a-9355-15ed44ee7ad1",
                        "source_sense_id": "4a7314a9-cc39-3aa5-91e8-5cf911f5780d",
