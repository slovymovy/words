                        "glosses": [
                            "A chemical compound that is a variation of a silicate where some silicon atoms are replaced by vanadium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60967dee-d0f9-4831-b603-b4a4ef5c217b",
                                "sense_id": "e96b6ec5-2343-3824-a8c0-c5696356ab75",
                                "text": "The spectroscopic characteristics of the vanadium species in our vanadosilicates are to some extent similar to those of vanadium grafted on silica. However, we see no reasons why large differences would be expected."
                            },
                            {
                                "example_id": "9ea212cc-2b9c-4e12-8e4d-245ddeafd930",
                                "sense_id": "e96b6ec5-2343-3824-a8c0-c5696356ab75",
                                "text": "Synthesis of vanadosilicates\nThe samples were synthesized by conventional hydrothermal techniques utilising tetraethyl orthosilicate as the silica source and vanadyl sulfate as the vanadium source."
                            }
                        ]
