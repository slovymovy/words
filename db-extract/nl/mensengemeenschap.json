                        "examples": [
                            {
                                "example_id": "ee6a1ab3-4068-45fd-8dd0-e33c64a62647",
                                "sense_id": "ce5c8261-5610-3869-adce-646089ff247f",
                                "text": "De wezenlijke opdracht van de mensengemeenschap is mijns inziens lijden te vermijden of te verminderen."
                            },
                            {
                                "example_id": "4956fade-60c3-4b57-ad1f-58bd86c37425",
                                "sense_id": "ce5c8261-5610-3869-adce-646089ff247f",
                                "text": "Met deze eenvoudige rekwisieten roepen de spelers de sfeer op van een dorp, van een kleine mensengemeenschap die zich wanhopig staande houdt in een wereld van honger."
                            },
                            {
                                "example_id": "5af07440-9d1b-4850-9ed2-0b27daccc38b",
                                "sense_id": "ce5c8261-5610-3869-adce-646089ff247f",
                                "text": "Het leven was daar op het Finse platteland veel meer een strijd om het bestaan dan we nu gewend zijn. Wellicht bestond die situatie honderden eeuwen in mensengemeenschappen."
                            }
                        ]
                    }
