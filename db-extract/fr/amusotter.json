                            {
                                "example_id": "723ab5e7-2fa5-4ae7-b374-c4c914b131ce",
                                "sense_id": "58ee8183-75fe-338e-a0f5-80dbd6ea1ae9",
                                "text": "Dans chacune d’elle, un poulet assoupi, s’amusottait à regarder s’escrimer le mécanicien"
                            },
                            {
                                "example_id": "163778d7-f431-4e49-83f6-9509ff568e5c",
                                "sense_id": "58ee8183-75fe-338e-a0f5-80dbd6ea1ae9",
                                "text": "On s'amusotte un peu... mais on a l'impression de passer à côté de quelque chose."
                            },
                            {
                                "example_id": "ce721b0d-6f3f-4d1f-9a9d-7b6942548e7f",
                                "sense_id": "58ee8183-75fe-338e-a0f5-80dbd6ea1ae9",
                                "text": "Pourquoi, au lieu d'éclater de rire comme pour les précédents, on sourit, on pouffe, on s'amusotte?"
                            }
                        ]
                    }
