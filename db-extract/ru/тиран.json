                "senses": [
                    {
                        "sense_id": "084ad50d-b872-3131-b0db-6fe73c3ff89d",
                        "entry_id": "4e24130c-8f5c-3cf0-9f85-b15087eabdd8",
                        "glosses": [
                            "tyrant (also figurative)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e216011f-2142-4eac-adcc-ce3fe7a19246",
                                "sense_id": "084ad50d-b872-3131-b0db-6fe73c3ff89d",
                                "text": "— Никто́ не ска́жет, бу́дто я / Тира́н и сумасбро́д, / За то́, что к ча́ю я люблю́ / Хоро́ший бутербро́д.",
                                "translation": "“No one would say that I / Am a tyrant and madman, / For the fact that with my tea I like / A good bread-and-butter sandwich.”",
                                "english": "“No one would say that I / Am a tyrant and madman, / For the fact that with my tea I like / A good bread-and-butter sandwich.”"
                            }
