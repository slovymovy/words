                                        "entry_id": "e03efa7e-6c8a-3159-a14b-394f682117a2",
                                        "glosses": [
                                            "ein Vogel, der wie ein Rabe aussieht und sehr gut Sprachlaute nachahmen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6265f73b-ac44-4e3b-8f54-07f818031248",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "Beos sind in Südostasien zu Hause."
                                            },
                                            {
                                                "example_id": "fd23b5ce-16bd-4901-b890-78df4571dbaa",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "Der Beo kann bis zu 20 Jahre alt werden."
                                            },
                                            {
                                                "example_id": "969381c1-6a4a-44ef-81a7-8f900d308085",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "Beos können viele Geräusche nachahmen und sogar ganze Sätze sprechen."
                                            },
                                            {
                                                "example_id": "0e497bf6-4cef-4c76-880e-1ed3f7f85784",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "„Beos fressen hauptsächlich Waldfrüchte und -beeren und sind wild auf bestimmte Wildfeigensorten.“"
                                            },
                                            {
                                                "example_id": "aceca124-9d21-4df0-a613-add45fcf762c",
                                                "sense_id": "488851db-65ca-336b-b5d6-7cdb67b990f6",
                                                "text": "„Als äußerst gesellige Tiere versammeln sich Beos tagsüber in Gruppen von fünf bis zehn Vögeln, ständig miteinander rufend und schwatzend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
