                "senses": [
                    {
                        "sense_id": "e23b8af7-695e-36ea-8456-89474661c574",
                        "entry_id": "9704ac7d-27aa-3089-8708-340de50679e2",
                        "glosses": [
                            "physikalisches Phänomen, wonach Vorgänge in einem bewegten System langsamer ablaufen als in einem ruhenden System"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "038717cb-19bc-457e-aca9-fb97815ad5a7",
                                "sense_id": "e23b8af7-695e-36ea-8456-89474661c574",
                                "text": "„Diese Konsequenz der speziellen Relativitätstheorie wird als Zeitdilatation bezeichnet, denn wenn alle Prozesse gleichmässig langsamer ablaufen, dann kann das als eine Verlangsamung des Zeitablaufs aufgefasst werden.“"
                            },
                            {
                                "example_id": "96b0e388-e861-4b6e-8132-6a59b02de51e",
                                "sense_id": "e23b8af7-695e-36ea-8456-89474661c574",
                                "text": "„Einstein stellte fest, dass bewegten Beobachtern Längen verkürzt und Zeiten gedehnt erscheinen. Diese sogenannte Zeitdilatation lässt sich auf die einfache Formel bringen: Bewegte Uhren gehen langsamer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
