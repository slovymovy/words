                        "entry_id": "5ebab1f8-ff96-3b30-a5dc-4cdd69b0d52f",
                        "glosses": [
                            "Forscher, der sich mit der Erforschung der Gletscher beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28412ad1-465a-427a-876e-871ca0070d28",
                                "sense_id": "17822c9e-f3fd-3d78-bd99-e84c83d182ba",
                                "text": "„Eine Verhinderung des Klimawandels ist nicht mehr möglich, glaubt Gletscherforscher Georg Kaser.“"
                            },
                            {
                                "example_id": "41d978b8-d63d-4a0e-9866-2c3922c1b908",
                                "sense_id": "17822c9e-f3fd-3d78-bd99-e84c83d182ba",
                                "text": "„Angesichts steigender Temperaturen prophezeien Gletscherforscher, dass 95 Prozent der rund 4000 Eisfelder in den Alpen bis Ende dieses Jahrhunderts verschwinden könnten.“"
                            }
                        ],
