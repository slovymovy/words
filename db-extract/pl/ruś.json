                                        "entry_id": "688a9a8d-89a4-36ec-aa74-0de53dd59a9a",
                                        "glosses": [
                                            "genitiv plurálu substantiva Rusy"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5681bb14-9cb8-4425-af52-08cc386638c0",
                                                "sense_id": "c86dac83-2142-3186-b8ee-f321cb80a15b",
                                                "text": "Než Šafařík, jsa tehdáž profesorem v Novém Sadě, poděkoval se z rodinných ohledů za povolání do Rus, a Hanka, namnoze jsa zrazován od přátel svých, přesvědčen jsa, že by sláva jeho v Rusích vybledla, taktéž ustoupil."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f866a250-0b86-42a1-a952-206f92c7dc06",
                        "source_entry_id": "b5a02771-c942-3306-94b4-e2a7be24ad79",
                        "source_sense_id": "7d13ead9-f6f2-3b6f-a14b-1be9a53cb9c4",
                        "target_lang_word": "Русь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Русь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "21ccea29-4b2e-3bd0-ba96-1dea6d98e05a",
                                        "entry_id": "518f64a4-1294-3f72-8aa2-edbc55ff42c5",
                                        "glosses": [
                                            "истор. историческое название земель восточных славян и образовавшегося там в средних веках государства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4621e09a-6fcc-42d4-9470-ef6a8be19da0",
                                                "sense_id": "21ccea29-4b2e-3bd0-ba96-1dea6d98e05a",
                                                "text": "Русь имела два равноправных центра на этих путях — Новгород и Киев."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "363bb23a-eb29-3b8d-904b-76bae2d60758",
                                        "entry_id": "518f64a4-1294-3f72-8aa2-edbc55ff42c5",
                                        "glosses": [
                                            "поэт., высок. то же, что Россия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f5e4d8f-ba14-422e-a851-0b36362b8217",
                                                "sense_id": "363bb23a-eb29-3b8d-904b-76bae2d60758",
                                                "text": "Посмертная слава поэта Рубцова будет на Руси повсеместная, пусть и не очень громкая."
                                            },
                                            {
                                                "example_id": "77e83b05-05c8-4a75-a647-060cb7381828",
                                                "sense_id": "363bb23a-eb29-3b8d-904b-76bae2d60758",
                                                "text": "Перводержавную // Русь православную // Боже, храни!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
