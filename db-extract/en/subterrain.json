                "senses": [
                    {
                        "sense_id": "3e70e1a0-1d6f-327d-8c12-0c8ce2af6cd0",
                        "entry_id": "08e7a1bd-affa-3b89-8315-8d38b8d3dc88",
                        "glosses": [
                            "Synonym of subterranean."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9487053b-8d3f-41a8-8479-0f6f8605742b",
                                "sense_id": "3e70e1a0-1d6f-327d-8c12-0c8ce2af6cd0",
                                "text": "Some skinks have adopted a subterrain life and have dispensed with their limbs."
                            },
                            {
                                "example_id": "b5a9f4b9-0ded-4615-afef-2646cb85f6bf",
                                "sense_id": "3e70e1a0-1d6f-327d-8c12-0c8ce2af6cd0",
                                "text": "The secondary chamber, however, was tapped and the rock-melt, previously stored in this domain, moved sidewards through a subterrain outlet of the chamber."
                            },
                            {
                                "example_id": "bb624fef-0ea5-43b8-970e-1144a2ca1d6a",
                                "sense_id": "3e70e1a0-1d6f-327d-8c12-0c8ce2af6cd0",
                                "text": "Some of the scientific explanations that promote natural formation include wind faceting and shifting of subterrain plates (Marsquakes ) ."
                            }
                        ]
                    }
                ],
