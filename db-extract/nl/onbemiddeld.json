                "senses": [
                    {
                        "sense_id": "e273e001-5a85-322f-ad67-5f0857d2e4a1",
                        "entry_id": "a0918218-fa05-3c74-b3d6-dacbbcb679f5",
                        "glosses": [
                            "zonder veel financiële middelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0eb117bc-507d-4578-9977-39878a9392b5",
                                "sense_id": "e273e001-5a85-322f-ad67-5f0857d2e4a1",
                                "text": "De bescheidenheid en dienstbare houding hadden een voedingsbodem in haar eenvoudige afkomst. Ze groeide op in een onbemiddeld arbeidersgezin in Krommenie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0649c4b3-b8df-4b88-bf75-654f54ea9dbb",
                        "source_entry_id": "a0918218-fa05-3c74-b3d6-dacbbcb679f5",
                        "source_sense_id": "e273e001-5a85-322f-ad67-5f0857d2e4a1",
                        "source_sense_description": "zonder veel financiële middelen",
                        "target_lang_word": "without means",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1799fb27-051a-49b8-9eed-67015b2861d4",
                        "source_entry_id": "a0918218-fa05-3c74-b3d6-dacbbcb679f5",
                        "source_sense_id": "e273e001-5a85-322f-ad67-5f0857d2e4a1",
                        "source_sense_description": "zonder veel financiële middelen",
                        "target_lang_word": "indigent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "indigent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ff2faab-ed0a-367a-8a00-82fb9090a4b5",
                                        "entry_id": "0f413e0d-173f-3e69-a86f-2485a5826ef5",
                                        "glosses": [
                                            "Poor; destitute; in need."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e13e7f20-dd9e-4167-bb9b-5752b30af73f",
                                                "sense_id": "4ff2faab-ed0a-367a-8a00-82fb9090a4b5",
                                                "text": "Many of the indigent children are so badly provided for by their parents, with both food and raiment, that they cannot attend school regularly; […]"
                                            },
                                            {
                                                "example_id": "25bec8fa-a472-4746-96f5-1206f88c0111",
                                                "sense_id": "4ff2faab-ed0a-367a-8a00-82fb9090a4b5",
                                                "text": "And were I not a thing for you and me\nTo execrate in anguish, you would be\nAs indigent a stranger to surprise,\nI fear, as I was once, and as unwise."
                                            },
                                            {
                                                "example_id": "b59e2be6-6159-4295-a7ee-909b885a0625",
                                                "sense_id": "4ff2faab-ed0a-367a-8a00-82fb9090a4b5",
                                                "text": "I had since my introduction to the prince been sensitive to the fact that he must think an obviously indigent soldier of fortune will sooner or later open the subject of a subscription to the Greek Cause."
                                            },
                                            {
                                                "example_id": "74194805-f347-4c0c-a047-12a407b81afb",
                                                "sense_id": "4ff2faab-ed0a-367a-8a00-82fb9090a4b5",
                                                "text": "Because of this, when my second major health fiasco happened, I had no insurance, so I went to a teaching hospital where they took indigent patients."
                                            },
                                            {
                                                "example_id": "667f56f3-7f7a-4997-9287-85b601ce06c9",
                                                "sense_id": "4ff2faab-ed0a-367a-8a00-82fb9090a4b5",
                                                "text": "In numerous Supreme Court decisions since Gideon v. Wainwright, the states have been required to provide counsel for indigent defendants at virtually all other stages of the criminal process, beginning with arrest and concluding with the defendant's release from the system."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "781c34c4-0e53-3b1d-830b-b034e8746948",
                                        "entry_id": "0f413e0d-173f-3e69-a86f-2485a5826ef5",
                                        "glosses": [
                                            "Utterly lacking or in need of something specified."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28415a37-108f-452f-ac76-30e2ec8836d5",
                                                "sense_id": "781c34c4-0e53-3b1d-830b-b034e8746948",
                                                "text": "Again some Bodies dissolve both in Fire and Water, as Gums; &c. And these are such, as have both Plenty of Spirit; and their tangible Parts indigent of Moisture: the former promotes the Dilatation of the Spirits by the Fire and the latter stimulates the Parts to receive the Liquor."
                                            },
                                            {
                                                "example_id": "46a7c694-b4a4-45f7-a50c-523f66688907",
                                                "sense_id": "781c34c4-0e53-3b1d-830b-b034e8746948",
                                                "text": "Will Providence guard us? How do I ſee that our Sex is naturally Indigent of Protection?—I hope it is in Fate to crown our Loves; for 'tis only in the Protection of Men of Honour, that we are naturally truly Safe […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "indigent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d1175713-77cf-3639-8392-3d1ba44df6ae",
                                        "entry_id": "abb34015-b3aa-3f95-9ee5-20ded5e3ee23",
                                        "glosses": [
                                            "A person in need, or in poverty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24c10059-1562-46e9-be47-ee1c6b2b2982",
                                                "sense_id": "d1175713-77cf-3639-8392-3d1ba44df6ae",
                                                "text": "I liked the streets best, so I walked and stared, and slept in a Salvation Army hostel for indigents. But I was no indigent; I was rich in feeling, and that was a luxury I had rarely known."
                                            },
                                            {
                                                "example_id": "357a13db-552a-4376-90e4-5902cd8eba21",
                                                "sense_id": "d1175713-77cf-3639-8392-3d1ba44df6ae",
                                                "text": "The influx of indigents overwhelmed the city's meagre social services and affordable accommodation."
                                            },
                                            {
                                                "example_id": "7a91c302-3362-406c-bcd9-63b53607486d",
                                                "sense_id": "d1175713-77cf-3639-8392-3d1ba44df6ae",
                                                "text": "Then in 2005 a Republican-led Congress passed a bill requiring millions of low-income people to pay higher co-payments and premiums under Medicaid. The result was that many more indigents had to forgo care."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
