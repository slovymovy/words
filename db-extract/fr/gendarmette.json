                        "sense_id": "babc2fc6-a99e-37a5-bc95-486af3b44bee",
                        "entry_id": "85f28f6b-3720-36e2-bec5-17efa87be877",
                        "glosses": [
                            "Femme gendarme."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ed045ae0-bfc2-4fe2-810e-7089e3ae4b4a",
                                "sense_id": "babc2fc6-a99e-37a5-bc95-486af3b44bee",
                                "text": "Babeth Étienne, qui joue le rôle de Marianne Bonnet, une des gendarmettes […]."
                            },
                            {
                                "example_id": "2fc2f5f3-da69-42c7-a9ab-b3364bd24251",
                                "sense_id": "babc2fc6-a99e-37a5-bc95-486af3b44bee",
                                "text": "Rattrapée, en effet, elle oppose une violente résistance aux gendarmes qui sont contraints de la menotter pour parvenir à la maîtriser. Un échange virulent durant lequel une gendarmette est blessée aux doigts."
                            },
                            {
                                "example_id": "f4bbb1dd-6f27-4f46-a1a7-97c6786a7808",
                                "sense_id": "babc2fc6-a99e-37a5-bc95-486af3b44bee",
                                "text": "Nous avons des gendarmettes dont le nom possède une consonance douce, moins effrayante que celle de « gendarme »"
                            }
                        ]
                    }
                ],
