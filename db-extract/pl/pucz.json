                ],
                "senses": [
                    {
                        "sense_id": "1aa74e7b-8253-3a81-ab7b-31af6899cb6f",
                        "entry_id": "a7b0265c-2053-36a8-8f26-3e749df3842c",
                        "glosses": [
                            "zamach stanu, przewrót"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d749ba3c-1621-465c-b9b7-c3979f2c059a",
                                "sense_id": "1aa74e7b-8253-3a81-ab7b-31af6899cb6f",
                                "text": "Zresztą, ten cały pucz nie był tylko kiepskim żartem - nie wolno zapominać, że niewiele później odbył się \"marsz na Rzym\" faszystowskich czarnych koszul i została zainstalowana dyktatura Mussoliniego"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fddc4af1-d9e5-48f6-aba5-83c81bdfeff0",
                        "source_entry_id": "a7b0265c-2053-36a8-8f26-3e749df3842c",
                        "source_sense_id": "1aa74e7b-8253-3a81-ab7b-31af6899cb6f",
                        "target_lang_word": "путч",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "путч",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5cd51db9-d6fc-3aa7-b1a5-0ad6dd5ca8d6",
                                        "entry_id": "a7cd6299-8825-324e-897e-82f4079e699e",
                                        "glosses": [
                                            "полит. консервативный или праворадикальный мятеж или государственный переворот, осуществляемый заговорщиками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e34a3432-936a-42cc-82a3-555555305746",
                                                "sense_id": "5cd51db9-d6fc-3aa7-b1a5-0ad6dd5ca8d6",
                                                "text": "Заполнил эту пропасть французский трудовой народ, ответивший на неудавшийся фашистский путч сначала демонстрацией и забастовкой, а через несколько месяцев круто повернувший «влево» руль внутренней политики своей страны."
                                            },
                                            {
                                                "example_id": "99589cf9-211d-4e0d-a589-35c2579248fc",
                                                "sense_id": "5cd51db9-d6fc-3aa7-b1a5-0ad6dd5ca8d6",
                                                "text": "Ростропович приезжает на путчи чаще, чем на концерты."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
