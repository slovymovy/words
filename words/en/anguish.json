{
    "word_family": [
        "anguished",
        "anguishing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68dad38a-2e0e-3d9b-ba42-55409896c485",
                    "sense_definition": "Extreme pain, either of body or mind; excruciating distress.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_and_physical_suffering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family waited in deep <w>anguish</w> for any news about the missing child.",
                            "target_lang_translations": {
                                "ru": "Семья в глубоком <w>мучении</w> ждала хоть каких-то новостей о пропавшем ребенке."
                            }
                        },
                        {
                            "text": "He cried out in <w>anguish</w> when he realized his life's work had been destroyed.",
                            "target_lang_translations": {
                                "ru": "Он вскрикнул от <w>боли</w>, когда понял, что дело всей его жизни разрушено."
                            }
                        }
                    ],
                    "synonyms": [
                        "agony",
                        "torment",
                        "torture",
                        "distress",
                        "grief"
                    ],
                    "antonyms": [
                        "joy",
                        "delight",
                        "comfort",
                        "happiness"
                    ],
                    "common_phrases": [
                        "deep anguish",
                        "cry of anguish",
                        "mental anguish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильная физическая или душевная боль; мучительное страдание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мука",
                                "target_lang_sense_clarification": "сильное физическое или нравственное страдание"
                            },
                            {
                                "target_lang_word": "страдание",
                                "target_lang_sense_clarification": "крайне болезненные ощущения, душевное мучение"
                            },
                            {
                                "target_lang_word": "мучение",
                                "target_lang_sense_clarification": "очень сильная боль, крайне болезненное ощущение"
                            },
                            {
                                "target_lang_word": "терзание",
                                "target_lang_sense_clarification": "душевные муки, сильное страдание"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b07a9ed6-6d7f-3d0a-a098-ed4a20ec7866",
                    "sense_definition": "To suffer extreme pain or distress.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "suffer_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She would <w>anguish</w> over the difficult decision for many weeks before making up her mind.",
                            "target_lang_translations": {
                                "ru": "Она будет <w>терзаться</w> из-за этого трудного решения много недель, прежде чем сделает выбор."
                            }
                        },
                        {
                            "text": "There is no need to <w>anguish</w> over minor mistakes that can easily be corrected.",
                            "target_lang_translations": {
                                "ru": "Нет необходимости <w>мучиться</w> из-за мелких ошибок, которые легко исправить."
                            }
                        }
                    ],
                    "synonyms": [
                        "agonize",
                        "suffer",
                        "grieve"
                    ],
                    "antonyms": [
                        "rejoice"
                    ],
                    "common_phrases": [
                        "anguish over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Испытывать сильные физические или душевные мучения; сильно переживать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терзаться",
                                "target_lang_sense_clarification": "испытывать сильные нравственные или физические мучения"
                            },
                            {
                                "target_lang_word": "мучиться",
                                "target_lang_sense_clarification": "испытывать страдания, тяжело переживать"
                            },
                            {
                                "target_lang_word": "изводиться",
                                "target_lang_sense_clarification": "терять силы, томиться, терзаясь чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e3cc9de2-5693-3fcf-9edc-eb7baf9f6be4",
                    "sense_definition": "To cause to suffer severe pain or distress.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "cause_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tragic loss of their home continued to <w>anguish</w> the family for years.",
                            "target_lang_translations": {
                                "ru": "Трагическая потеря дома продолжала <w>терзать</w> семью на протяжении многих лет."
                            }
                        },
                        {
                            "text": "He did not wish to <w>anguish</w> his parents with the bad news.",
                            "target_lang_translations": {
                                "ru": "Он не хотел <w>расстраивать</w> родителей плохими новостями."
                            }
                        }
                    ],
                    "synonyms": [
                        "torment",
                        "torture",
                        "afflict",
                        "pain"
                    ],
                    "antonyms": [
                        "comfort",
                        "soothe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять кому-либо сильные физические или душевные страдания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "причинять сильные душевные или физические страдания"
                            },
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "причинять страдания, изводить"
                            },
                            {
                                "target_lang_word": "изводить",
                                "target_lang_sense_clarification": "мучить, портить жизнь, лишать покоя"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0c60705f-9568-3db1-b62e-022c75b9ec76",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We invited Mr. <w>Anguish</w> to speak at the local historical society meeting.",
                            "target_lang_translations": {
                                "ru": "Мы пригласили господина <w>Ангуиша</w> выступить на заседании местного исторического общества."
                            }
                        },
                        {
                            "text": "The old documents were signed by a man named Edmund <w>Anguish</w>.",
                            "target_lang_translations": {
                                "ru": "Старые документы были подписаны человеком по имени Эдмунд <w>Ангуиш</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "Family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ангуиш",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7226ee2-85d5-3afc-b33c-5e8fca58cf9c",
                    "sense_definition": "A male given name.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "They decided to name their newborn son <w>Anguish</w> after his grandfather.",
                            "target_lang_translations": {
                                "ru": "Они решили назвать своего новорожденного сына <w>Ангуишем</w> в честь дедушки."
                            }
                        },
                        {
                            "text": "In the old parish records, <w>Anguish</w> was listed as a resident of the village.",
                            "target_lang_translations": {
                                "ru": "В старых приходских книгах <w>Ангуиш</w> значился как житель деревни."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rare historical given name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское личное имя."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Ангуиш",
                                "target_lang_sense_clarification": "мужское имя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}