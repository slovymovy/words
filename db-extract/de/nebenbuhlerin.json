                "senses": [
                    {
                        "sense_id": "c2c629a5-42ef-353f-8312-08c01b979c2f",
                        "entry_id": "5d106b04-8b9b-3eb5-b10a-6cfe0ee1cc94",
                        "glosses": [
                            "Mitbewerberin, die um denselben Mann wirbt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b70f4ec8-db4c-4508-8647-19539be5f23c",
                                "sense_id": "c2c629a5-42ef-353f-8312-08c01b979c2f",
                                "text": "„Sie wurde also etwa 70 Jahre alt, hat ihren Ehemann um etwa zehn und ihre Nebenbuhlerin um knapp drei Jahre überlebt.“"
                            },
                            {
                                "example_id": "3dadbfc3-7a6a-49f6-9557-4efee31b2fdb",
                                "sense_id": "c2c629a5-42ef-353f-8312-08c01b979c2f",
                                "text": "„Da schmeichelte ich mir, Nanetta könnte wohl Angelas heimliche Nebenbuhlerin sein.“"
                            },
                            {
                                "example_id": "d49b9a34-6f2d-4735-98bf-ac6f7fd55036",
                                "sense_id": "c2c629a5-42ef-353f-8312-08c01b979c2f",
                                "text": "„Sie suchte sich Nebenbuhlerinnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
