    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "67838a71-abd3-3667-9587-44401c128ea7",
                    "sense_definition": "Including every possible element or detail; fully comprehensive and thorough.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "thoroughness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The researchers conducted an <w>exhaustive</w> search of all available documents to find the missing evidence.",
                            "target_lang_translations": {
                                "ru": "Исследователи провели <w>исчерпывающий</w> поиск всех доступных документов, чтобы найти недостающие улики."
                            }
                        },
                        {
                            "text": "After an <w>exhaustive</w> investigation, the police concluded that the fire was started by an electrical fault.",
                            "target_lang_translations": {
                                "ru": "После <w>всестороннего</w> расследования полиция пришла к выводу, что пожар произошел из-за неисправности электропроводки."
                            }
                        }
                    ],
                    "synonyms": [
                        "all-encompassing",
                        "exhaustive"
                    ],
                    "antonyms": [
                        "incomplete",
                        "partial",
                        "superficial",
                        "cursory"
                    ],
                    "common_phrases": [
                        "exhaustive search",
                        "exhaustive list",
                        "exhaustive investigation",
                        "exhaustive study"
                    ],
                    "target_lang_definitions": {
                        "ru": "Включающий в себя все возможные элементы или детали; полностью всесторонний и тщательный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "исчерпывающий",
                                "target_lang_sense_clarification": "полный, охватывающий всё"
                            },
                            {
                                "target_lang_word": "всесторонний",
                                "target_lang_sense_clarification": "детальный, со всех сторон"
                            },
                            {
                                "target_lang_word": "подробный",
                                "target_lang_sense_clarification": "содержащий много деталей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eefbe367-ee87-34d3-b78d-0829259657f0",
                    "sense_definition": "Tending to drain resources or strength; causing extreme tiredness or fatigue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "tiring",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chopping and hauling wood all day was <w>exhaustive</w> work that left her completely spent.",
                            "target_lang_translations": {
                                "ru": "Колка и переноска дров в течение всего дня была <w>изнурительной</w> работой, которая полностью лишила её сил."
                            }
                        },
                        {
                            "text": "The <w>exhaustive</w> demands of the court eventually depleted the church's financial reserves.",
                            "target_lang_translations": {
                                "ru": "<w>Истощающие</w> требования суда в конечном итоге исчерпали финансовые резервы церкви."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiring",
                        "draining",
                        "exhausting",
                        "fatiguing",
                        "wearisome"
                    ],
                    "antonyms": [
                        "invigorating",
                        "refreshing",
                        "energizing"
                    ],
                    "common_phrases": [
                        "exhaustive work",
                        "exhaustive demands"
                    ],
                    "target_lang_definitions": {
                        "ru": "Приводящий к истощению ресурсов или сил; вызывающий крайнюю усталость или утомление."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "изнурительный",
                                "target_lang_sense_clarification": "крайне утомительный"
                            },
                            {
                                "target_lang_word": "истощающий",
                                "target_lang_sense_clarification": "лишающий сил или ресурсов"
                            },
                            {
                                "target_lang_word": "тяжёлый",
                                "target_lang_sense_clarification": "требующий больших усилий"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}