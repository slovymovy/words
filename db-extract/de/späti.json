                    {
                        "form_id": "2fe51f98-f8a6-4e1b-b3ee-49bfca9a7e62",
                        "entry_id": "0fdc0d9a-708d-3c5e-954c-b41df704d8d5",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Spätis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                        "entry_id": "0fdc0d9a-708d-3c5e-954c-b41df704d8d5",
                        "glosses": [
                            "über den allgemeinen Ladenschluss hinaus geöffnete kleinere Verkaufsstelle in einer Großstadt (vor allem Berlin, ferner unter anderem auch Hamburg, Köln, München), in der Getränke, Tabakwaren und zumeist auch Zeitschriften, Lebensmittel verkauft sowie häufig auch Internetzugänge angeboten werden"
                        ],
                        "tags": [
                            "colloquial",
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "5b45dad3-246f-4070-9d4f-8ab7dffd9b80",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Wirtschaftlich trifft es die restlichen Tankstellen – der klassische ‚Späti‘ wie in Berlin ist im Südwesten so gut wie unbekannt.“"
                            },
                            {
                                "example_id": "3c6ae9b9-da10-4333-9e46-85476f34d2d2",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Auf Seite 21 stehen die wirklich relevanten Dinge, die ich für Sie wie folgt übersetzen möchte: Wenn ein offenkundiger Nazi ein paar Mal Bier im Späti geklaut hat, ist er ein Ladendieb im Bereich der Allgemeinkriminalität.“"
                            },
                            {
                                "example_id": "506258bb-faff-45a9-a82c-d7fd5e77e695",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Wir bedauern, dass die bisherige liberale Praxis gegenüber Spätis in Berlin dank einer Einzelperson offenbar beendet werden soll.“"
                            },
                            {
                                "example_id": "e7b244c0-454a-4353-8040-10298bce6e4e",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Der ‚Späti‘ vollbringt eine Dienstleitung an Menschen, die lange schlafen möchten oder denen zu spät einfällt, woran sie früher hätten denken sollen, und das sind in dieser Stadt einige.“"
                            },
                            {
                                "example_id": "766deb76-61c3-4fbf-85fd-3652a43583ff",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Zu den Kiosk-Hochburgen zählten Köln, Hannover, das Ruhrgebiet, Hamburg-Harburg, Flensburg und Berlin mit seinen Spätis.“"
                            },
                            {
                                "example_id": "71f0074c-3d02-412a-95bd-66401d4a151a",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Ende April ordnete das OVG die strikte Auslegung des Gesetzestextes an: Der Inhaber eines Spätis am Mauerpark hatte darauf geklagt, am 1. Mai öffnen zu dürfen.“"
                            },
                            {
                                "example_id": "87b7b1a2-80e0-4fb5-b64c-33f895bbc2ec",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Denn ein echter Späti ist auch eine soziale Einrichtung.“"
                            },
                            {
                                "example_id": "744d51f5-6222-4374-9a64-f7d59691d927",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Die Bühne ist einem ‚Späti‘ nachempfunden, einem für das Überleben in der Großstadt essenziellen Kiosk.“"
                            },
                            {
                                "example_id": "517c2da7-f25a-4a2b-9c4c-3b26e03c7d2f",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Er fotografierte an die 300 von ihnen, sprach mit den Besitzern und stellte fest: ‚Auch wenn sich die Spätis ähneln, sind sie immer Unikate.‘“"
                            },
                            {
                                "example_id": "eae37075-873b-45fd-b1c3-b4e40e4e6fc5",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Schon, aber der Späti wird für viele zur Ersatzkneipe, man verweilt dort, quatscht sich fest, es gibt viel nachbarschaftliche Kommunikation.“"
                            },
                            {
                                "example_id": "aa0da12d-86a8-45e5-9882-18d99d0b8f96",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„‚Aber nur die Berliner Spätis sind wirklich 24 Stunden offen und bieten den Kunden auch noch Sitzmöglichkeiten‘, sagt Klier.“"
                            },
                            {
                                "example_id": "6ad86220-9a0c-4c21-9d5b-1b8e5202b36f",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Doch was in München lange Zeit gefehlt hat, ist das, was sie in Berlin Späti nennen. Ein Späti, Kurzform für Spätkauf, besteht im Wesentlichen aus einem (oder mehreren) gut gefüllten Kühlschränken, einem Tabakregal und einem Tresen mit Schokoriegeln und Chips. Vor allem aber hat ein Späti auch dann noch offen, wenn die Lichter im Supermarkt nicht mehr brennen, der Sonnenuntergang aber zu einem Bierchen an der Isar einlädt.“"
                            },
                            {
                                "example_id": "f702912c-ba97-4ca9-9047-7c75b2c71a78",
                                "sense_id": "f09a2496-aa14-3c84-a715-73bc9a3d26c6",
                                "text": "„Als sie bemerkte, dass die Verdächtigen etwas stehlen wollten, habe sie das ihrem Mann gesagt und dann den Späti in der Neuköllner Sonnenallee von außen verschlossen, sagte ein Sprecher der Berliner Polizei am Sonntag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
