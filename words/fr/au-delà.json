                    "sense_definition": "Indique ce qui dépasse un seuil, une quantité ou une mesure.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le coût des travaux s'élève bien <w>au-delà</w> du budget prévu initialement."
                        },
                        {
                            "text": "La température est montée <w>au-delà</w> de quarante degrés pendant la canicule."
                        }
                    ],
                    "common_phrases": [
