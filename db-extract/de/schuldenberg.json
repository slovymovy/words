                        "form": "den Schuldenberg"
                    },
                    {
                        "form_id": "a98738d4-f106-4d12-a57d-a7e4951d9450",
                        "entry_id": "b29adc38-46cf-335f-84d3-5e0516bdcab7",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schuldenberge"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a8d7ef1-010b-388b-bc21-a93ff96ae2fb",
                        "entry_id": "b29adc38-46cf-335f-84d3-5e0516bdcab7",
                        "glosses": [
                            "hohe Schuldensumme"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997e6427-eddb-4247-ae7e-770637e70c4b",
                                "sense_id": "6a8d7ef1-010b-388b-bc21-a93ff96ae2fb",
                                "text": "Der Schuldenberg von Deutschland ist immens hoch."
                            },
                            {
                                "example_id": "851ffb5d-9e17-4c05-9493-556434170eca",
                                "sense_id": "6a8d7ef1-010b-388b-bc21-a93ff96ae2fb",
                                "text": "„Doch seitdem die Schuldenberge vieler Mitgliedsnationen wachsen und der Zerfall des Gemeinschaftsgeldes droht, ist die Währungsbehörde zu einer Art Ersatzregierung für die Eurozone geworden.“"
                            },
                            {
                                "example_id": "c450f4ec-0750-4198-b326-3f820947c85d",
                                "sense_id": "6a8d7ef1-010b-388b-bc21-a93ff96ae2fb",
                                "text": "Keine griechische Regierung sei in der Lage, den Schuldenberg auch nur im Ansatz abzutragen - die diskutierten Lösungen seien reine Heftpflaster, um der deutschen Öffentlichkeit sagen zu können, man bekomme das schon irgendwie hin."
                            },
                            {
                                "example_id": "4c9504a4-f2d6-4c43-bb16-3500146ac31d",
                                "sense_id": "6a8d7ef1-010b-388b-bc21-a93ff96ae2fb",
                                "text": "[Überschrift: ] Paul Kazarian über Griechenland: US-Investor nennt Schuldenberg \"die Lüge des Jahrhunderts\""
                            },
                            {
                                "example_id": "78f53969-00dc-41c2-9865-1f03478dada0",
                                "sense_id": "6a8d7ef1-010b-388b-bc21-a93ff96ae2fb",
                                "text": "[Die südkoreanische Reederei] Hanjin schreibt bereits seit fünf Jahren rote Zahlen und trägt zurzeit einen Schuldenberg von über 4,5 Milliarden Euro mit sich herum."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
