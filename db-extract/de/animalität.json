                    {
                        "form_id": "e313b13b-4fce-41d0-a0d6-7a54b8a063fd",
                        "entry_id": "98a9e0ba-efbf-38a9-a0ff-9ad34a56875d",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Animalität"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "133f2be9-3108-3715-86b2-dfa0968f0c28",
                        "entry_id": "98a9e0ba-efbf-38a9-a0ff-9ad34a56875d",
                        "glosses": [
                            "Eigenschaft/Haltung/Handlungsweise, die tierisches (animales, animalisches) Verhalten zeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3722cbd-ed18-41ee-b8fb-ed2f1c4c67ff",
                                "sense_id": "133f2be9-3108-3715-86b2-dfa0968f0c28",
                                "text": "„Während Demeter tendenziell für Animalität, Sexualität und Gewalt steht, steht Johannes tendenziell für Geistigkeit, Keuschheit und »Milde«.“"
                            },
                            {
                                "example_id": "6a670e86-7a09-4d41-b962-ee2622530655",
                                "sense_id": "133f2be9-3108-3715-86b2-dfa0968f0c28",
                                "text": "„Böhme sprach von der ‚Wiederaneignung der Natur im Menschen‘, von dem, ‚was Kant klassisch die Animalität nannte‘."
                            },
                            {
                                "example_id": "cc3807d6-472f-405a-aaee-856382a1a4cf",
                                "sense_id": "133f2be9-3108-3715-86b2-dfa0968f0c28",
                                "text": "„Dem entspricht weiter, dass Badious Begriff der Animalität nicht nur das Leben im wortwörtlich animalischen Sinn, sondern weite Bereiche überhaupt des Alltagslebens und darin der alltäglichen Arbeit trifft.“"
                            },
                            {
                                "example_id": "4d2533ae-aa6d-495d-a455-587e0e8ae718",
                                "sense_id": "133f2be9-3108-3715-86b2-dfa0968f0c28",
                                "text": "„Wir unterscheiden, was schon Aristoteles that, drei Charaktere im Menschenleben: Animalität, Vegetation und Humanität. Animalität und Vegetation hängen mit dem körperlichen Leben des Menschen zusammen.“ (1870)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
