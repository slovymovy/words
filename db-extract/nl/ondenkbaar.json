                        "sense_id": "f0c1e1d7-a8ea-3c03-ab6e-e6ab2bc764cc",
                        "entry_id": "24d6ab79-fe14-3f6e-a2fd-2bb49805fec3",
                        "glosses": [
                            "heel onwaarschijnlijk, dat iets zelfs niet de bedenken valt, onvoorstelbaar"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff96a12d-6970-4349-83c3-c68cea9098bd",
                                "sense_id": "f0c1e1d7-a8ea-3c03-ab6e-e6ab2bc764cc",
                                "text": "Het is ondenkbaar dat mijn dochter haar rijbewijs haalt."
                            },
                            {
                                "example_id": "b0c93d18-5189-4ccb-b336-4281eb2fd122",
                                "sense_id": "f0c1e1d7-a8ea-3c03-ab6e-e6ab2bc764cc",
                                "text": "Ook de Engelse Necktie droeg zijn gitaar de hele trail met zich mee. Zonder muziek de trail lopen was ondenkbaar voor hem."
                            }
                        ]
                    }
                ],
