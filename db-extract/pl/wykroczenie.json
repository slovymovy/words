                        "target_lang_word": "Verstoß",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verstoß",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f0fc5d5b-2ee1-3688-bb1a-40ddb6c1d3ab",
                                        "entry_id": "fe8bfada-0c73-372b-bf01-c7cc0fe84b26",
                                        "glosses": [
                                            "Nichteinhaltung, Übertretung eines Gesetzes, einer Norm oder Abmachung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddef4939-ff12-492d-b970-d75b8620471c",
                                                "sense_id": "f0fc5d5b-2ee1-3688-bb1a-40ddb6c1d3ab",
                                                "text": "Der Verstoß gegen die Geschwindigkeitsbeschränkung kostete eine Menge Geld und drei Punkte."
                                            },
                                            {
                                                "example_id": "ed396e82-60a8-4653-9af4-f84007cc7a14",
                                                "sense_id": "f0fc5d5b-2ee1-3688-bb1a-40ddb6c1d3ab",
                                                "text": "„H. musste wegen vorsätzlichen Verstoßes gegen seine ärztlichen Berufspflichten 12000 Euro Buße zahlen.“"
                                            },
                                            {
                                                "example_id": "516c277f-3768-449f-8a4e-58ecc2547e91",
                                                "sense_id": "f0fc5d5b-2ee1-3688-bb1a-40ddb6c1d3ab",
                                                "text": "„Während sich die Wirkung eigentlicher Sprachlehre, hauptsächlich also Rechtschreibung und Grammatik, in der korrekten Beherrschung und Anwendung orthographischer und grammatischer Regeln überprüfbar äußert, vor allem auch darin, daß Verstöße gegen sie klar als »Fehler« identifiziert werden, läßt sich eine entsprechende Wirkung von Sprachkritik und Stillehre nicht strikt nachweisen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdf2c54b-e78f-4d52-82d8-6e80d7ff4472",
                        "source_entry_id": "f2d89223-d671-36c0-9790-552260c4d14b",
                        "source_sense_id": "142fa803-c136-31b0-bc49-98a24d632124",
                        "target_lang_word": "проступок",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "проступок",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4250d755-9b27-3704-b623-8da3d8d016c3",
                                        "entry_id": "aa306e97-e42e-3368-81c4-3cc234a73a15",
                                        "glosses": [
                                            "поступок, нарушающий какие-либо нормы, правила поведения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46bd0242-701b-44ab-84f7-605ccd9999c3",
                                                "sense_id": "4250d755-9b27-3704-b623-8da3d8d016c3",
                                                "text": "Она прощалась с ними в самых трогательных выражениях, извиняла свой проступок неодолимою силою страсти и оканчивала тем, что блаженнейшею минутою жизни почтет она ту, когда позволено будет ей броситься к ногам дражайших её родителей."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98740e7-7a45-3a64-b8e9-506cb7e75010",
                                        "entry_id": "aa306e97-e42e-3368-81c4-3cc234a73a15",
                                        "glosses": [
                                            "юр. правонарушение, имеющее меньшую общественную опасность, чем уголовное преступление"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ab98950-656e-44e0-966f-f02bcd95d5e9",
                                                "sense_id": "a98740e7-7a45-3a64-b8e9-506cb7e75010",
                                                "text": "Начнётся, бывало, следствие, и хотя дело ничем не кончится, ибо в «Уложении о наказаниях» за подобные проступки наказания не полагается, однако же несговорчивому даннику нахождение под следствием всегда обходилось гораздо дороже той суммы, которую он поупрямился заплатить своевременно."
                                            },
                                            {
                                                "example_id": "0de1e1c8-eb93-4375-bf52-472b7290e853",
                                                "sense_id": "a98740e7-7a45-3a64-b8e9-506cb7e75010",
                                                "text": "По делам уголовным к подсудности мировых судов были отнесены проступки и небольшие преступления, за которые предусматривались наказания в виде выговора, замечания и внушения, денежного взыскания до 300 рублей, ареста до трех месяцев либо тюремного заключения до одного года."
                                            }
                                        ]
                                    }
                                ]
                            }
