                "senses": [
                    {
                        "sense_id": "b080501c-e831-30d1-bf0a-40b34106cbb0",
                        "entry_id": "6e778fd2-4c93-3994-af01-b9a917787d49",
                        "glosses": [
                            "für elektromagnetische Wellen durchlässige, meist kuppelförmige Verkleidung aus Kunststoff, um Antennenanlagen vor Witterungseinflüssen und Windlast zu schützen"
                        ],
                        "tags": [
                            "Radartechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "7043b308-0874-464d-b0ad-cd2e61e152c5",
                                "sense_id": "b080501c-e831-30d1-bf0a-40b34106cbb0",
                                "text": "„Das Radom verschließt das Gehäuse und hat sehr geringen Einfluss auf die Radarsignalabstrahlungscharakteristik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ffa94d19-0c31-4b38-b4a1-3f4cf923c0f0",
                        "source_entry_id": "6e778fd2-4c93-3994-af01-b9a917787d49",
                        "source_sense_id": "b080501c-e831-30d1-bf0a-40b34106cbb0",
                        "target_lang_word": "radome",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radome",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a677dc05-caec-3b85-a4d0-adb6f4fd794c",
                                        "entry_id": "a6768cd2-720a-3261-9e0b-7918196d3e80",
                                        "glosses": [
                                            "A radar dome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea41deb4-0b74-4f6b-903e-7e0df28570b1",
                                                "sense_id": "a677dc05-caec-3b85-a4d0-adb6f4fd794c",
                                                "text": "Radar antennas were distributed in large quantities throughout the base, half of them in white radomes that looked as if some gigantic bird had laid a clutch of eggs at random."
                                            },
                                            {
                                                "example_id": "d8b9fef2-e841-4da7-a020-119db31d225c",
                                                "sense_id": "a677dc05-caec-3b85-a4d0-adb6f4fd794c",
                                                "text": "And it took my mother just twenty or so minutes to get to her new job at the NSA, whose boxy futuristic headquarters, topped with radomes and sheathed in copper to seal in the communications signals, forms the heart of Fort Meade."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aca7c9f7-e8ef-4767-9675-0b19d94fbb23",
                        "source_entry_id": "6e778fd2-4c93-3994-af01-b9a917787d49",
                        "source_sense_id": "b080501c-e831-30d1-bf0a-40b34106cbb0",
                        "target_lang_word": "radôme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "radôme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95c40e97-6e30-358d-b2ad-d81b3b7fc67d",
                                        "entry_id": "de4fe4b7-4185-3f84-985f-b223022c14ea",
                                        "glosses": [
                                            "Abri en forme de dôme protégeant une antenne de radar, au sol, au sommet d'un bâtiment ou encore sur un véhicule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1a3ed53-76f6-4c5d-8c5b-98e12a500a72",
                                                "sense_id": "95c40e97-6e30-358d-b2ad-d81b3b7fc67d",
                                                "text": "Je confirme transpondeur sur 7 700, nous avons traversé un gros nuage de grêle, le pare-brise est fissuré, le radôme est sûrement défoncé."
                                            }
                                        ]
                                    }
                                ]
                            }
