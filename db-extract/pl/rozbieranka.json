                        ]
                    },
                    {
                        "translation_id": "a6f090db-a246-4d0a-8258-345af7f6a4bd",
                        "source_entry_id": "7eac7963-ee20-3f7b-801c-d5dea96b5adf",
                        "source_sense_id": "32da26d8-2665-3072-a680-e132b91a4ecd",
                        "target_lang_word": "party",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "party",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4519b715-4f36-3752-8f25-edb801720ef7",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A person or group of people constituting one side in a legal proceeding, such as in a legal action or a contract."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebc778e8-f327-4e17-a188-fb10372dd377",
                                                "sense_id": "4519b715-4f36-3752-8f25-edb801720ef7",
                                                "text": "The contract requires that the party of the first part pay the fee."
                                            },
                                            {
                                                "example_id": "6c2cc5d2-c118-442f-945e-1581e03429a9",
                                                "sense_id": "4519b715-4f36-3752-8f25-edb801720ef7",
                                                "text": "His party was campaigning successfuly."
                                            },
                                            {
                                                "example_id": "dd3252d9-35e7-4b93-9fae-70885d475e5e",
                                                "sense_id": "4519b715-4f36-3752-8f25-edb801720ef7",
                                                "text": "if the Jury had found that the party slain had been of English race and nation, it had been adjudged felony"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b903ab9b-0920-3523-8633-424a58726883",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A person; an individual."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "574a477a-6259-4567-aba2-ad16f6a5e602",
                                                "sense_id": "b903ab9b-0920-3523-8633-424a58726883",
                                                "text": "He is a queer party."
                                            },
                                            {
                                                "example_id": "01f30b7a-0981-4081-8e72-14ff055013bb",
                                                "sense_id": "b903ab9b-0920-3523-8633-424a58726883",
                                                "text": "`These young parties have a way of looking at one, sir,' he would say apologetically, `which I don't call respectable.'"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce25f57f-9d1d-30ad-b7e1-1564314730dc",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A person; an individual.",
                                            "With to: someone who takes part in an action or affair; an accessory."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f433347b-7af4-4dff-a845-55fc449f58b9",
                                                "sense_id": "ce25f57f-9d1d-30ad-b7e1-1564314730dc",
                                                "text": "I can't possibly be a party to that kind of reckless behaviour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf4bc881-1ce1-3472-b58a-09dd5fa1e8a1",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people forming one side in a given dispute, contest, etc., or united in maintaining a cause, policy, or opinion in opposition to others; a faction."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebcd7355-5936-4524-b01c-46a57e26fe26",
                                                "sense_id": "bf4bc881-1ce1-3472-b58a-09dd5fa1e8a1",
                                                "text": "A mile back in the forest the tribe had heard the fierce challenge of the gorilla, and, as was his custom when any danger threatened, Kerchak called his people together, partly for mutual protection against a common enemy, since this gorilla might be but one of a party of several, and also to see that all members of the tribe were accounted for."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85679e34-e5bb-37e6-a543-cd1e0223ca2c",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people forming one side in a given dispute, contest, etc., or united in maintaining a cause, policy, or opinion in opposition to others; a faction.",
                                            "Active player characters organized into a single group."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1133088d-a6d5-3ff4-acc3-2be2527d87c5",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people forming one side in a given dispute, contest, etc., or united in maintaining a cause, policy, or opinion in opposition to others; a faction.",
                                            "A group of characters controlled by the player."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b3007d7b-e493-3b3d-9435-8ef7296159b5",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people forming one side in a given dispute, contest, etc., or united in maintaining a cause, policy, or opinion in opposition to others; a faction.",
                                            "A political group considered as a formal whole, usually organized on a national basis, which contests elections and aims to form or take part in a government; a political party."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9b870386-144e-4ef8-8b76-eb56083585b4",
                                                "sense_id": "b3007d7b-e493-3b3d-9435-8ef7296159b5",
                                                "text": "The green party took 12% of the vote."
                                            },
                                            {
                                                "example_id": "a206bf47-370f-4c58-a2d3-ef34c8a024b1",
                                                "sense_id": "b3007d7b-e493-3b3d-9435-8ef7296159b5",
                                                "text": "\"A fine man, that Dunwody, yonder,\" commented the young captain, as they parted, and as he turned to his prisoner. \"We'll see him on in Washington some day.[…]A strong man—a strong one; and a heedless.\" ¶ \"Of what party is he?\" she inquired, as though casually."
                                            },
                                            {
                                                "example_id": "ee2fbdb5-35cb-4d2c-80c5-e234ee96ca78",
                                                "sense_id": "b3007d7b-e493-3b3d-9435-8ef7296159b5",
                                                "text": "The Party told you to reject the evidence of your eyes and ears. It was their final, most essential command."
                                            },
                                            {
                                                "example_id": "e0b396ec-3751-416e-9496-e3f1e44b04ec",
                                                "sense_id": "b3007d7b-e493-3b3d-9435-8ef7296159b5",
                                                "text": "In the freer political atmosphere before the 1989 repression, peasant protests against the Party in Henan were sometimes openly discussed. A transcript of a meeting between peasants and cadres in Jili district near Luoyang published in the Peasants’ Daily recorded some vivid complaints."
                                            },
                                            {
                                                "example_id": "0b8dfc0e-75e1-409d-a660-d1e8ff6fef56",
                                                "sense_id": "b3007d7b-e493-3b3d-9435-8ef7296159b5",
                                                "text": "The RNC entered June with about $72.4 million in cash reserves, nearly five times the $15 million stockpiled by the DNC, as the two parties gear up for gubernatorial races this fall and next year’s costly midterm elections for Congress. […] The party’s cash crunch is serious enough that party officials have weighed seeking a line of credit to help it stay afloat, a development first reported by The New York Times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a1f3889-58f6-30b0-a807-ea29742a0aad",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people forming one side in a given dispute, contest, etc., or united in maintaining a cause, policy, or opinion in opposition to others; a faction.",
                                            "A political group considered as a formal whole, usually organized on a national basis, which contests elections and aims to form or take part in a government; a political party.",
                                            "The Communist Party, especially as the sole political party of a communist state."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20a1e28a-8620-3d70-9978-e92942c43a27",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people forming one side in a given dispute, contest, etc., or united in maintaining a cause, policy, or opinion in opposition to others; a faction.",
                                            "A political group considered as a formal whole, usually organized on a national basis, which contests elections and aims to form or take part in a government; a political party.",
                                            "The feeling of solidarity with and support for one's political party; partisanship, especially in political matters."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "broadly",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba5701fa-32c8-3eef-8c62-975166227d8a",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A detachment of troops selected for a particular service or duty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0289446b-704a-47f5-b18a-9ea2c4e64a20",
                                                "sense_id": "ba5701fa-32c8-3eef-8c62-975166227d8a",
                                                "text": "boarding party"
                                            },
                                            {
                                                "example_id": "8f97faa8-be56-4e07-a01f-5bbea5f67d69",
                                                "sense_id": "ba5701fa-32c8-3eef-8c62-975166227d8a",
                                                "text": "The settlers were attacked early next morning by a scouting party."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84f8be8d-8d3c-32aa-b9ae-7e4a7d436f10",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people gathered together, especially temporarily, for a specific purpose such as travel or sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8497fe19-713e-4d97-93b7-215b9ded4ec8",
                                                "sense_id": "84f8be8d-8d3c-32aa-b9ae-7e4a7d436f10",
                                                "text": "We're expecting a large party from the London office."
                                            },
                                            {
                                                "example_id": "8ece382e-8232-4ce7-9b29-d0e12cfc2193",
                                                "sense_id": "84f8be8d-8d3c-32aa-b9ae-7e4a7d436f10",
                                                "text": "Do you have a table available for a party of four?"
                                            },
                                            {
                                                "example_id": "1a9fbf5a-d71f-44ca-9c67-ac61b51ada3d",
                                                "sense_id": "84f8be8d-8d3c-32aa-b9ae-7e4a7d436f10",
                                                "text": "We made an odd party before the arrival of the Ten, particularly when the Celebrity dropped in for lunch or dinner."
                                            },
                                            {
                                                "example_id": "ed2bfe51-e36f-48a7-9e3c-d1cd89a35ce7",
                                                "sense_id": "84f8be8d-8d3c-32aa-b9ae-7e4a7d436f10",
                                                "text": "[…] the whole party were still standing and talking together very agreeably, when the sound of horses drew their notice, and Darcy and Bingley were seen riding down the street."
                                            },
                                            {
                                                "example_id": "7710a880-ec35-4d61-9d99-bdae8a27db84",
                                                "sense_id": "84f8be8d-8d3c-32aa-b9ae-7e4a7d436f10",
                                                "text": "When the line was being surveyed in 1880, the survey party, proceeding along the course of Stock Creek, reached a natural amphitheatre with a rock wall 200 ft. high, in the face of which there was an arched tunnel entrance, [...] into which the stream passed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e116a696-9693-3610-913e-b448dbe54e6f",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people gathered together, especially temporarily, for a specific purpose such as travel or sport.",
                                            "A social gathering, usually of invited guests, which typically involves eating, drinking, and entertainment and often held to celebrate a particular occasion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "948bcadc-17ec-4dcc-bd7d-4c80ca01144e",
                                                "sense_id": "e116a696-9693-3610-913e-b448dbe54e6f",
                                                "text": "I'm throwing a huge party for my 21st birthday."
                                            },
                                            {
                                                "example_id": "57edf719-cd17-4be3-8b9c-e1cd53683bc6",
                                                "sense_id": "e116a696-9693-3610-913e-b448dbe54e6f",
                                                "text": "So-So, tonight, tonight, let’s look at where that time actually goes, and let’s begin with the most obvious form of fundraising: fundraisers. These are usually shitty parties in D.C. bars, restaurants, or townhouses, and there are a lot of them! The Sunlight Foundation estimates that, in the last election cycle, members of Congress held over 28 hundred fundraisers! Washington is like Rod Stewart’s haircut: party in the front, party in the back, frankly too much party and no business anywhere to be found!"
                                            },
                                            {
                                                "example_id": "71d82c2c-06ad-4258-a13a-a8a9943fe982",
                                                "sense_id": "e116a696-9693-3610-913e-b448dbe54e6f",
                                                "text": "You know I’d leave any party for you / 'Cause no party’s so sweet as a party of two"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3b5107e-1577-3ce9-b737-06ccaab37863",
                                        "entry_id": "c614384c-4d26-3df0-926b-01bd2db56d3e",
                                        "glosses": [
                                            "A group of people gathered together, especially temporarily, for a specific purpose such as travel or sport.",
                                            "A gathering of acquaintances so that one of them may offer items for sale to the rest of them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b8ab40-62b2-48fd-9950-b183a13b8fbb",
