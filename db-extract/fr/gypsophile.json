                                                "example_id": "53d478f8-2922-43b3-927c-a727f3c3120f",
                                                "sense_id": "72a71d8d-98d5-31b4-910e-61838f7835c9",
                                                "text": "Gypsophilas are closely related to pinks and carnations."
                                            },
