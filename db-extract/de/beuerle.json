                ],
                "senses": [
                    {
                        "sense_id": "8f269cfb-3154-3a28-8f20-27f8ff893313",
                        "entry_id": "7d978453-450c-3f4e-822e-86b7b4a84581",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a05ccfaa-4a65-46c3-8391-350d2257b2a9",
                                "sense_id": "8f269cfb-3154-3a28-8f20-27f8ff893313",
                                "text": "Frau Beuerle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "d0a3f412-8220-4bc4-9e70-0f3855dad0cf",
                                "sense_id": "8f269cfb-3154-3a28-8f20-27f8ff893313",
                                "text": "Herr Beuerle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1908ae8f-cd2c-446e-badf-d4d61f68b16a",
                                "sense_id": "8f269cfb-3154-3a28-8f20-27f8ff893313",
                                "text": "Die Beuerles fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "ac4b66fd-f164-4a2b-9073-92dece232c91",
                                "sense_id": "8f269cfb-3154-3a28-8f20-27f8ff893313",
                                "text": "Der Beuerle trägt nie die Pullover, die die Beuerle ihm strickt."
                            },
                            {
                                "example_id": "bf0f1f2a-01bf-446c-8907-d29c7ebcb274",
                                "sense_id": "8f269cfb-3154-3a28-8f20-27f8ff893313",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Beuerle kommt, geht der Herr Beuerle.“"
                            },
                            {
                                "example_id": "d1e59dec-caf7-4a3d-93fe-4d62a2987541",
                                "sense_id": "8f269cfb-3154-3a28-8f20-27f8ff893313",
                                "text": "Beuerle kommt und geht."
                            },
                            {
                                "example_id": "c1ad5f47-413d-4897-8770-227f0023d1ca",
                                "sense_id": "8f269cfb-3154-3a28-8f20-27f8ff893313",
                                "text": "Beuerles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
