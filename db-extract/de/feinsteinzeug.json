                        "cross_references": [
                            {
                                "target_word": "grès cérame",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6941b452-3953-3829-acc6-1cff79c7ac7d",
                                        "entry_id": "9006d137-a155-3405-bd5b-cf35ca926e0c",
                                        "glosses": [
                                            "Pâte d’argile et de silice compressée à plusieurs centaines de kilogramme par cm², cuite vers 1250° C et utilisée pour réaliser des carreaux et autres pièces de décoration de formes variées. Il peut être teinté dans la masse et/ou émaillé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ff02be-ae3d-466e-9a70-18d7824ff7a9",
                                                "sense_id": "6941b452-3953-3829-acc6-1cff79c7ac7d",
                                                "text": "Grès cérame émaillé."
                                            },
                                            {
                                                "example_id": "a22b91d7-882a-460d-95cc-f50b9de0093e",
                                                "sense_id": "6941b452-3953-3829-acc6-1cff79c7ac7d",
                                                "text": "Les meilleurs de tous les revêtements ce sont les carreaux en grès cérame vitrifié . Le grès cérame vitrifié est très dur, il raie le verre ; il est inusable, inattaquable à la gelée, absolument imperméable, non seulement par la partie émaillé mais dans toute son épaisseur, …. — (Eugène Richard , Précis d'hygiène appliquée, Éd. Doin, 1891)"
                                            },
                                            {
                                                "example_id": "66448947-e637-4a41-8179-ecec2f3dcb71",
                                                "sense_id": "6941b452-3953-3829-acc6-1cff79c7ac7d",
                                                "text": "On peut juger d’abord de l’importance du grès cérame dont Sèvres nous expose les compositions pour la première fois."
                                            },
                                            {
                                                "example_id": "0f2097d4-86cf-4eb0-935b-1f17d0b33d53",
                                                "sense_id": "6941b452-3953-3829-acc6-1cff79c7ac7d",
                                                "text": "Le sol de la salle de bains, dallé de grès cérame jaune clair, était en pente et orientait l'eau vers un orifice situé juste au-dessus du bureau du locataire de l'étage inférieur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
