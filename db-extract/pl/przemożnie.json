                                                "sense_id": "c7c33ae2-e0b6-3bf6-aeab-88511ac9b23c",
                                                "text": "„Das gelungene Bubenstück hätte ihm eine erhebliche Aufmerksamkeit gesichert und einen gewaltigen Ansehensschub verschafft.“"
                                            },
                                            {
                                                "example_id": "4d00c7d6-c80a-435a-b368-80e9585d3885",
                                                "sense_id": "c7c33ae2-e0b6-3bf6-aeab-88511ac9b23c",
                                                "text": "Da täuschst du dich aber gewaltig, mein Lieber!"
                                            },
                                            {
                                                "example_id": "10f9d781-aa7e-4295-bf10-2b4bc9141e7c",
                                                "sense_id": "c7c33ae2-e0b6-3bf6-aeab-88511ac9b23c",
                                                "text": "Das ist dir aber gewaltig gut gelungen!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "277b2f9c-536e-3213-ac77-a30302f05989",
                                        "entry_id": "297ba897-0b9e-386b-90fe-b7e1253f2923",
                                        "glosses": [
                                            "mit viel Macht ausgestattet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde5d410-6ac4-40ad-bec6-e2714eb6a884",
                                                "sense_id": "277b2f9c-536e-3213-ac77-a30302f05989",
