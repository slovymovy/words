                {
                    "sense_id": "3086c537-8443-3247-97ee-79ca2739da80",
                    "sense_definition": "Een grote hoeveelheid.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er waren een <w>boel</w> mensen op het feest aanwezig.",
                            "target_lang_translations": {
                                "en": "There were a <w>lot</w> of people present at the party.",
                                "ru": "На вечеринке была <w>куча</w> людей.",
                                "tr": "Partide bir <w>sürü</w> insan vardı."
                            }
                        },
                        {
                            "text": "Dat kost een hele <w>boel</w> geld, dus we moeten even sparen.",
                            "target_lang_translations": {
                                "en": "That costs a whole <w>lot</w> of money, so we have to save up for a bit.",
                                "ru": "Это стоит <w>кучу</w> денег, так что нам нужно немного подкопить.",
                                "tr": "Bu, bir <w>sürü</w> para tutuyor, bu yüzden biraz birikim yapmamız gerekiyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoop",
                        "veel",
                        "massa"
                    ],
                    "common_phrases": [
                        "een hele boel",
                        "een boel geld",
                        "een boel mensen"
                    ],
                    "target_lang_definitions": {
                        "en": "A large amount.",
                        "ru": "Большое количество чего-либо.",
                        "tr": "Büyük bir miktar; çok sayıda ya da çok fazla şey."
