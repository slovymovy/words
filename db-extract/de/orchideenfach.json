                "senses": [
                    {
                        "sense_id": "52330861-0c00-3520-aaa0-8ca1810b5f3c",
                        "entry_id": "0be1c747-a977-31f5-9646-adb1eaad3383",
                        "glosses": [
                            "spezielles, ausgefallenes, seltenes Fachgebiet; Nischen-Fach"
