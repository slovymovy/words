                                    {
                                        "sense_id": "bda932c6-3915-319c-ab2f-a99f60ba0795",
                                        "entry_id": "f6362334-6c14-3662-a2db-5415abc6bd00",
                                        "glosses": [
                                            "A person who learns from another, especially one who then teaches others."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05c418a2-f599-35a1-851e-d720cf382818",
                                        "entry_id": "f6362334-6c14-3662-a2db-5415abc6bd00",
                                        "glosses": [
                                            "An active follower or adherent of someone, or some philosophy etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0a3be76-93ea-4d39-83be-8f170879235f",
                                                "sense_id": "05c418a2-f599-35a1-851e-d720cf382818",
                                                "text": "And it came to pass, as Jesus sat at meat in the house, behold, many publicans and sinners came and sat down with him and his disciples."
                                            },
                                            {
                                                "example_id": "625b3472-f55d-4740-a0c0-0639fc306bf7",
                                                "sense_id": "05c418a2-f599-35a1-851e-d720cf382818",
                                                "text": "By some paradoxical evolution rancour and intolerance have been established in the vanguard of primitive Christianity. Mrs. Spoker, in common with many of the stricter disciples of righteousness, was as inclement in demeanour as she was cadaverous in aspect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25ee6753-7cb9-329c-8bed-f7ed3ca1269d",
                                        "entry_id": "f6362334-6c14-3662-a2db-5415abc6bd00",
                                        "glosses": [
                                            "A wretched, miserable-looking man."
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
