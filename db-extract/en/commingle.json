                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32b467b8-1f3d-4ff0-9d90-7b4fbc830c71",
                                                "sense_id": "461d98a7-6f88-3cf1-839d-20c85c45cf36",
                                                "text": "„Alle Sandkörner fügen sich zusammen, zuerst zu einer Düne, und dann zu dem grossen Felsen des Lebens.“"
                                            },
                                            {
                                                "example_id": "5e053eec-f7c0-4f25-b609-bd47c6998716",
                                                "sense_id": "461d98a7-6f88-3cf1-839d-20c85c45cf36",
                                                "text": "„Bilder fügen sich zusammen, die eine rätselhafte Klarheit schaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
