                            {
                                "example_id": "39184b55-44b3-4c67-b862-f1f72c074938",
                                "sense_id": "ae48e824-86f0-3396-b5e9-9a6628d46ad6",
                                "text": "„Als die Sonne am Morgen aufging, wanderte Shah Zarina ziellos eine Straße entlang, die das linke Ufer des Swat säumte.“"
                            },
                            {
                                "example_id": "2d49b048-59c6-4b50-b82b-2713076d9a89",
                                "sense_id": "ae48e824-86f0-3396-b5e9-9a6628d46ad6",
                                "text": "„Der Major führte seinen Chef auf einem von Kiefern und Zedern gesäumten Weg auf einen Hügel hinauf, von dem aus man einen herrlichen Blick auf ein weites Tal und den Panjkora-Fluss hatte, der quer durch den Dir-Distrikt nach Süden schäumte, um dort in den Swat zu münden.“"
                            }
