                        "sense_id": "f106393e-5ae1-3ef6-b6b0-5a12b9457612",
                        "entry_id": "844cae99-9d78-3de3-b8ef-f9706538b233",
                        "glosses": [
                            "Auktion, bei der Nutzungsrechte für bestimmte Funkfrequenzen versteigert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49e87760-cd78-4e08-ba03-92b2160e14c2",
                                "sense_id": "f106393e-5ae1-3ef6-b6b0-5a12b9457612",
                                "text": "„Der Mobilfunkanbieter \"3\" will seine Ankündigung ernst machen und gegen die Bescheide aus der Frequenzauktion beim Verwaltungsgerichtshof (VwGH) und Verfassungsgerichtshof (VfGH) Beschwerde einbringen.“"
                            },
                            {
                                "example_id": "9c6fc4b5-8b04-4e35-a2da-fab2f9ce59ba",
                                "sense_id": "f106393e-5ae1-3ef6-b6b0-5a12b9457612",
                                "text": "„Noch gut in Erinnerung ist den deutschen Mobilfunkern die legendäre UMTS-Frequenzauktion im Jahr 2000: Umgerechnet mehr als 50 Milliarden Euro landeten im Topf von Bundesfinanzminister Hans Eichel.“"
                            }
                        ],
