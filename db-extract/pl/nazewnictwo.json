                        "cross_references": [
                            {
                                "target_word": "onomastics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "66b7c6a6-0414-30b8-a0a2-12c83146880e",
                                        "entry_id": "36e92e57-070f-3ce4-a314-bea618fac363",
                                        "glosses": [
                                            "The branch of lexicology devoted to the study of names and naming, especially the origins of names."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dce0e7a5-f281-4e87-9d0f-9da1face1247",
                                                "sense_id": "66b7c6a6-0414-30b8-a0a2-12c83146880e",
                                                "text": "Her father had long been a student of onomastics, and loved to unpack the names of people they encountered as children."
                                            },
                                            {
                                                "example_id": "2579a443-f9aa-4c61-b630-042d0b558cf2",
                                                "sense_id": "66b7c6a6-0414-30b8-a0a2-12c83146880e",
                                                "text": "From the point of view of onomastics, proper names fulfill many functions (individualizing, localizing, differentiating etc.)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95270b34-33e9-41ff-a62a-ee3a254fe845",
                        "source_entry_id": "d1cb276f-941d-3733-81c4-21a8ac3521f7",
                        "source_sense_id": "92a358ea-40f9-305c-9e26-530bb70afe63",
                        "target_lang_word": "onomastology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d3678807-0793-426a-ab6f-3704b729dd69",
                        "source_entry_id": "d1cb276f-941d-3733-81c4-21a8ac3521f7",
                        "source_sense_id": "92a358ea-40f9-305c-9e26-530bb70afe63",
                        "target_lang_word": "Namenkunde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Namenkunde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                        "entry_id": "2482352e-914b-39c8-a850-848096fc0c15",
                                        "glosses": [
                                            "linguistische Disziplin, die sich der Erforschung von Eigennamen widmet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e793ec0-0c3d-4d31-9569-a40059be0bec",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "Die Namenkunde erforscht die Entwicklung, Etymologie und Verbreitung von Eigennamen."
                                            },
                                            {
                                                "example_id": "14f29664-7a59-4046-b954-b1c40562b0f1",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "„Aber auch und vor allem Leipzig gilt als traditionelles Zentrum der Onomastik, wie Fachwissenschaftler die Namenkunde nennen.“"
                                            },
                                            {
                                                "example_id": "0650286b-be63-4b4f-92c4-2a2b4c15a58e",
                                                "sense_id": "0ab4f9f9-9f04-3a59-a3c7-76980e18e719",
                                                "text": "„In den Lehrplänen ist Namenkunde recht unterschiedlich vertreten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "133198df-54ce-40a7-b633-29d9491ec511",
                        "source_entry_id": "d1cb276f-941d-3733-81c4-21a8ac3521f7",
                        "source_sense_id": "aaec9f37-496a-3bf1-b4a8-0965c7581e70",
                        "target_lang_word": "nomenclature",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nomenclature",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "083ac45b-75ac-3c94-87c5-97c2d9364ba1",
                                        "entry_id": "1739478d-7274-3248-8429-02a85ac050df",
                                        "glosses": [
                                            "A set of rules used for forming the names or terms in a particular field of arts or sciences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "100e52fa-41d5-42c9-927d-af19cd254f5a",
                                                "sense_id": "083ac45b-75ac-3c94-87c5-97c2d9364ba1",
                                                "text": "It is also pertinent to note that the current obvious decline in work on holarctic hepatics most surely reflects a current obsession with cataloging and with nomenclature of the organisms—as divorced from their study as living entities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b661293f-96e6-3c33-8fbc-9f8ef4e2f504",
                                        "entry_id": "1739478d-7274-3248-8429-02a85ac050df",
                                        "glosses": [
                                            "A set of names or terms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e56771f-f1c2-4cd7-98ed-325cbf298e8c",
                                                "sense_id": "b661293f-96e6-3c33-8fbc-9f8ef4e2f504",
                                                "text": "Another major defect of the current literature dealing with the nomenclature of hybrid forms of English is the scant attention paid to the question of frequency."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b5f56e-6f70-3811-a8f0-598bb36f1ee6",
                                        "entry_id": "1739478d-7274-3248-8429-02a85ac050df",
                                        "glosses": [
                                            "A name."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
