                                "example_id": "7115dffe-bd8b-40a4-9b75-fb7e732b278c",
                                "sense_id": "6bec292e-56d8-3992-8491-c75e33d17f5f",
                                "text": "J'en fus d'ailleurs tout abalobé quand je la vis pour la première fois !"
                            },
                            {
                                "example_id": "8d64b988-965d-4059-a43a-fd7bd731312a",
                                "sense_id": "6bec292e-56d8-3992-8491-c75e33d17f5f",
                                "text": "« … que je verrais M. le préfet de police en chair, en os et en uniforme, que je ne serais pas plus abalobé. »"
                            }
                        ]
