                        "glosses": [
                            "Artisan qui ressemelle les chaussures."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "d816292e-f09f-4e2b-a235-f7de77a6dbaf",
                                "sense_id": "3034d8ac-cea6-3ca0-99e5-9740524b66de",
                                "text": "Il était bien avec son concierge, le père Talon, un nom épatant pour un ressemeleur de bottes !"
                            },
                            {
                                "example_id": "2086f0b3-cb5d-421c-8cd5-dd76e9c09897",
                                "sense_id": "3034d8ac-cea6-3ca0-99e5-9740524b66de",
                                "text": "Quittant le bord de mer, elle s’enfonce dans un enchevêtrement de ruelles où se succèdent vendeurs de dosas, ressemeleurs de chaussures, échoppes dans lesquelles des hommes en sueur manipulent d’énormes fers à repasser, boutiques aux couleurs défraîchies proposant indifféremment des épices, des sculptures, de l’encens, des piles, des pâtisseries ou des couches pour bébés."
                            }
                        ]
