        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9d248a1d-75b7-3c8d-bf08-eff6f88382a2",
                    "sense_definition": "To make fruit soft or tender by ripening.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "ripeness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warm sun helps to <w>mellow</w> the fruit on the vine.",
                            "target_lang_translations": {
                                "zh": "温暖的阳光有助于让藤上的果实<w>催熟</w>。",
                                "tr": "Sıcak güneş, asmadaki meyveleri <w>olgunlaştırmaya</w> yardımcı olur.",
                                "pl": "Ciepłe słońce pomaga owocom na gałęziach <w>dojrzewać</w>.",
                                "it": "Il caldo sole aiuta a <w>far maturare</w> i frutti sulla vite.",
                                "nl": "De warme zon helpt het fruit aan de rank te <w>rijpen</w>."
                            }
                        },
                        {
                            "text": "Leave the avocados on the counter to <w>mellow</w>.",
                            "target_lang_translations": {
                                "zh": "把牛油果放在台面上让它<w>熟透</w>。",
                                "tr": "Avokadoları <w>olgunlaşmaları</w> için tezgahta bırakın.",
                                "pl": "Zostaw awokado na blacie, aby <w>doszło</w>.",
                                "it": "Lascia gli avocado sul bancone a <w>maturare</w>.",
                                "nl": "Laat de avocado's op het aanrecht liggen om te <w>rijpen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "ripen"
                    ],
                    "target_lang_definitions": {
                        "zh": "使果实成熟变软。",
                        "tr": "Meyveyi olgunlaştırarak yumuşatmak veya meyvenin olgunlaşıp yumuşaması.",
                        "pl": "Dojrzewać lub sprawiać, że owoce dojrzewają i stają się miękkie.",
                        "it": "Rendere o diventare maturo e morbido (di frutta).",
                        "nl": "Zacht of mals worden of maken door te rijpen."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "催熟",
                                "target_lang_sense_clarification": "指通过某种方式使果实变熟。"
                            },
                            {
                                "target_lang_word": "变熟",
                                "target_lang_sense_clarification": "不及物：果实自行变软变熟"
                            },
                            {
                                "target_lang_word": "熟透",
                                "target_lang_sense_clarification": "不及物：放到完全成熟变软"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "olgunlaşmak",
