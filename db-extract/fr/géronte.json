                    }
                ],
                "senses": [
                    {
                        "sense_id": "20604b45-0020-3e02-85ed-312002ccfc95",
                        "entry_id": "722c4740-2534-3717-ac12-34c269ef0029",
                        "glosses": [
                            "Vieillard de caractère faible, qui se laisse facilement duper."
                        ],
                        "tags": [
                            "Par allusion à un personnage de comédie"
                        ],
                        "examples": [
                            {
                                "example_id": "96f1de22-59b5-441a-917a-77a7c2e7346b",
                                "sense_id": "20604b45-0020-3e02-85ed-312002ccfc95",
                                "text": "Il s’indigna de s’entendre traiter de géronte."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1f6df4b-080a-37a8-b1a6-ad1fd5d08058",
                        "entry_id": "722c4740-2534-3717-ac12-34c269ef0029",
                        "glosses": [
                            "Vieillard exerçant le pouvoir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e5a46bb-f5ae-4e9a-999e-a37962365f06",
                                "sense_id": "d1f6df4b-080a-37a8-b1a6-ad1fd5d08058",
                                "text": "Léonid Brejnev, Iouri Andropov et Konstantin Tchernenko furent des gérontes de l’Union soviétique."
                            }
                        ]
                    },
                    {
                        "sense_id": "f602b4e0-538b-304a-b6f5-1600e8f48c71",
                        "entry_id": "722c4740-2534-3717-ac12-34c269ef0029",
                        "glosses": [
                            "Homme âgé, vieillard."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60451e0e-ece4-4044-aeb4-898bf2d9800d",
                                "sense_id": "f602b4e0-538b-304a-b6f5-1600e8f48c71",
                                "text": "Habitué à lire comme un sourd sur les lèvres d'autrui, je déchiffrerai sur celle de ma bru, excédée de se trouver coincée parmi les gérontes, ce murmure inaudible qui fait sourire mon fils :\n— On devrait se marier entre jeunes et s'enterrer entre vieux."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7c9328da-0624-4244-aa2e-90a1a7df0bc2",
                        "source_entry_id": "722c4740-2534-3717-ac12-34c269ef0029",
                        "target_lang_word": "геронт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "геронт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "b0380652-a039-3d4e-a7bb-1b394a88214f",
                                        "entry_id": "17985534-ce3a-3fd4-8341-b900b3f69e2e",
                                        "glosses": [
                                            "истор. в Древней Греции (Спарте) — член совета старейшин (герусии), высшее должностное лицо Спартанского государства"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5246776-ec9e-4817-bdcf-c9b3d6f9436a",
                                                "sense_id": "b0380652-a039-3d4e-a7bb-1b394a88214f",
                                                "text": "Геронты собираются на совещание по зову царя на площади или в другом общественном месте. Не все благородные — геронты: число их является почти постоянно ограниченным. Хотя геронты вовсе не старцы, но поэт охотно представляет их себе как старейших мужей, не принимающих более участия в бою."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7099345d-02c6-36c0-ae23-4fcb9e4a738c",
                                        "entry_id": "17985534-ce3a-3fd4-8341-b900b3f69e2e",
                                        "glosses": [
                                            "шутл. старец"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6607e57-7066-47d0-b21c-9cabc557ed35",
                                                "sense_id": "7099345d-02c6-36c0-ae23-4fcb9e4a738c",
                                                "text": "Ты прав, старик. Геронты запятнали светлые знамена нашей армии. Это говорю тебе я, полковник ГРУ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
