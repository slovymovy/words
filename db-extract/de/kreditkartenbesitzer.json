                "senses": [
                    {
                        "sense_id": "df627f26-c4e9-3892-8d1d-073145d360b6",
                        "entry_id": "ed0e0357-c19f-3236-9267-2780de61d646",
                        "glosses": [
                            "jemand, der eine Kreditkarte besitzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8a5f435-1a73-4a15-a7fc-2db8b6878b9c",
                                "sense_id": "df627f26-c4e9-3892-8d1d-073145d360b6",
                                "text": "„Rechnerisch würde damit jeder Bankomat- und Kreditkartenbesitzer mit 11 Euro pro Jahr belastet.“"
                            },
                            {
                                "example_id": "471408b5-02ea-42bf-9324-41fa4f56ebfe",
                                "sense_id": "df627f26-c4e9-3892-8d1d-073145d360b6",
                                "text": "„So legte die Visa-Aktie dank der guten Kauflaune der Kreditkartenbesitzer zu: Im Geschäftsquartal bis Ende März wurde der Überschuss verglichen mit dem Vorjahreswert auf 2,6 Mrd. Dollar mehr als versechsfacht, zudem erhöhte das Unternehmen seine Prognose.“"
                            },
                            {
                                "example_id": "2c2efe34-9113-4261-9947-85bcad53a3a6",
                                "sense_id": "df627f26-c4e9-3892-8d1d-073145d360b6",
                                "text": "„Der rechtmäßige Kreditkartenbesitzer hatte einige Monate nach der falschen Briefzustellung bei der Commerzbank nachgefragt, wo seine neue Kreditkarte denn bleibe.“"
                            },
                            {
                                "example_id": "4ddc5c79-068f-428e-b86d-0fb6d9195360",
                                "sense_id": "df627f26-c4e9-3892-8d1d-073145d360b6",
                                "text": "„Wer sich darauf einlässt, findet alles, was man braucht, um arglose Kreditkartenbesitzer, Bankkunden oder PayPal-Nutzer zu bestehlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
