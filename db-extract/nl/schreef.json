                        "examples": [
                            {
                                "example_id": "22652f00-ed34-44e4-9a7f-c515de968804",
                                "sense_id": "819e4f98-b9ed-34d2-a01c-4764effe802b",
                                "text": "Ik schreef."
                            },
                            {
                                "example_id": "8acdd31d-6c21-43ca-aeb6-fd866a64c7b8",
                                "sense_id": "819e4f98-b9ed-34d2-a01c-4764effe802b",
                                "text": "Jij schreef."
                            },
                            {
                                "example_id": "40ee7d20-1814-462a-9428-996119928789",
                                "sense_id": "819e4f98-b9ed-34d2-a01c-4764effe802b",
                                "text": "Hij, zij, het schreef."
                            },
                            {
                                "example_id": "dbd595b1-bf02-4e1f-9147-4288ccade978",
                                "sense_id": "819e4f98-b9ed-34d2-a01c-4764effe802b",
                                "text": "Maar dit gevoel duurde niet lang want na een kort praatje schreef hij opeens een officiële boete uit voor de hele groep omdat het blijkbaar verboden was om boven op Mount Whitney te overnachten."
                            },
                            {
                                "example_id": "deb13dd5-b751-432c-8bf1-e675fb3db4b7",
                                "sense_id": "819e4f98-b9ed-34d2-a01c-4764effe802b",
                                "text": "In 2002 en 2003 trok ik intensief op met Muskee, omdat ik zijn biografie schreef. Hij nam me mee op autoritten, waarbij hij veel klassieke muziek liet horen. Hij was verknocht aan Drenthe en liet mij de bossen en groene vlakten zien die hij zo goed kende. Hij gidste me naar het vennetje waar de regels voor zijn grootste hit 'Window of my eyes' in hem opkwamen."
                            }
                        ]
                    }
