                                    {
                                        "sense_id": "d3e4ec7b-8b1a-3bed-8d06-d9862f69733a",
                                        "entry_id": "dac722fd-9c4d-3341-b46c-5e3f3d55f263",
                                        "glosses": [
                                            "Any flower of the genus Narcissus; a daffodil."
