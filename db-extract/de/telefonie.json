                                "target_senses": [
                                    {
                                        "sense_id": "e9961f3c-4fc3-3261-9bb4-b80deb1d7939",
                                        "entry_id": "f5711941-9810-303a-ad45-8cf01c4cf6ca",
                                        "glosses": [
                                            "Système de communication inventé par F. Sudre et qui consiste en la transmission par un câble d'un message codé avec trois notes de musique, cet appareil n'a été utilisé que par l'armée on le nomme aussi télégraphie acoustique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05259f35-b7b1-3372-ac4e-474bfbfe14c1",
                                        "entry_id": "f5711941-9810-303a-ad45-8cf01c4cf6ca",
                                        "glosses": [
                                            "Art d’installer, de faire fonctionner le téléphone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "299afbd4-de9c-41b8-9ac4-1025f8f70007",
                                                "sense_id": "05259f35-b7b1-3372-ac4e-474bfbfe14c1",
                                                "text": "Les conditions sont donc réunies pour que la convergence entre l'informatique et la téléphonie se réalise sous la forme d’« ordiphones » mobiles très multifonctionnels, véritables bureaux de poche. Notebooks, notepads, assistants personnels numériques, livres électroniques... les noms sont encore flottants, et ils sous-évaluent, selon un habitus culturel tenace, la fonction téléphonique qui apporte pourtant l'essentiel, à savoir la puissance commutative des réseaux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed113eb2-eb84-3c2f-bc86-0c52b1213c95",
                                        "entry_id": "f5711941-9810-303a-ad45-8cf01c4cf6ca",
                                        "glosses": [
                                            "Science de la transmission du son à grande distance."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8400ed2f-bbff-3d39-b046-2a8dbe48f7e4",
                                        "entry_id": "f5711941-9810-303a-ad45-8cf01c4cf6ca",
                                        "glosses": [
                                            "Secteur d'activité dans le domaine de la conception et de la commercialisation de téléphones."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9686bbb-dbc0-491f-95f9-ab17f3570a1e",
                                                "sense_id": "8400ed2f-bbff-3d39-b046-2a8dbe48f7e4",
                                                "text": "Cette solution de téléphonie sur Internet multi-plateformes utilise une technologie propriétaire basée sur le peer-to-peer afin d'établir une connexion vers le correspondant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a13b123f-566e-3c59-a39d-ac68dcd5c6d1",
                                        "entry_id": "f5711941-9810-303a-ad45-8cf01c4cf6ca",
                                        "glosses": [
                                            "Exploitation par la police de données des opérateurs téléphoniques obtenues par réquisition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "531872e3-4a79-4c72-8c47-1425096bef2f",
                                                "sense_id": "a13b123f-566e-3c59-a39d-ac68dcd5c6d1",
                                                "text": "Grâce à la téléphonie, les gendarmes ont découvert qu’elle a menti sur son emploi du temps."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
