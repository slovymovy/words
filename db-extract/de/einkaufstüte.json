                "senses": [
                    {
                        "sense_id": "be8b5d8a-8cec-3baa-ab4a-ea1482052bd5",
                        "entry_id": "74e657ba-2826-37bc-b778-154f9b39cde3",
                        "glosses": [
                            "einfaches Tragegefäß zum Transport kürzlich erworbener Konsumartikel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "852e687b-8c05-4004-9ef6-5ce57dfe7c9c",
                                "sense_id": "be8b5d8a-8cec-3baa-ab4a-ea1482052bd5",
                                "text": "„Lustig, wie die alten Dampfer Brücke für Brücke antuckern, immer mehr Passagiere, vollgepackt mit Einkaufstüten und Kartons, über die schmalen Stege an Land entlassen.“"
                            },
                            {
                                "example_id": "182fcde7-d4ba-4fa6-b0a3-27f0b8fb936b",
                                "sense_id": "be8b5d8a-8cec-3baa-ab4a-ea1482052bd5",
                                "text": "„Die Frau des Verwalters ging mitten auf der Straße und schleppte sich mit zwei schweren Einkaufstüten aus Stoff ab.“"
                            },
                            {
                                "example_id": "a3b76ca9-e08e-4dc2-830f-9110c0ba8367",
                                "sense_id": "be8b5d8a-8cec-3baa-ab4a-ea1482052bd5",
                                "text": "„Im Arm hält er eine Einkaufstüte aus Stoff, aus der oben ein Baguette schaut.“"
                            },
                            {
                                "example_id": "90b4c5ec-d069-4474-8603-f719658664df",
                                "sense_id": "be8b5d8a-8cec-3baa-ab4a-ea1482052bd5",
                                "text": "„Sie stand mit vollen Einkaufstüten am Ausgang und wartete darauf, dass ihre Mutter mit dem Auto vorfuhr.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
