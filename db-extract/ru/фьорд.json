                    },
                    {
                        "translation_id": "fc941ce3-a8d3-4188-931e-f51264b06937",
                        "source_entry_id": "cecea884-7747-387a-b5d6-796664497a09",
                        "source_sense_id": "a583979c-753f-3c3e-992f-424eccacd61a",
                        "target_lang_word": "Fjord",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fjord",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa67de82-7bb3-32c7-846f-03998dfed875",
                                        "entry_id": "36b0975e-4cc7-3ac9-a0e5-88cd814bc9a5",
                                        "glosses": [
                                            "langgestreckte, schmale Meeresbucht mit Steilküste"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fcbbb08-77c8-4a23-8485-1cc08d857db9",
                                                "sense_id": "aa67de82-7bb3-32c7-846f-03998dfed875",
                                                "text": "In Skandinavien ist die gesamte Westküste von Fjorden zerfurcht."
                                            },
                                            {
                                                "example_id": "24701a2e-506b-4158-b768-aaa076ca231b",
                                                "sense_id": "aa67de82-7bb3-32c7-846f-03998dfed875",
                                                "text": "„Auf der einen Seite des Fjordes lagern zwei Boote in einer Lagerhalle aus Wellblech, eingezwängt zwischen den Felsen, in der Bucht gegenüber liegt das hellgelbe Gerippe eines Zwergwals, an dem blaues Ölzeug zum Trocknen hängt.“"
                                            },
                                            {
                                                "example_id": "6e6aa4a4-e269-4e0c-9484-15dfc5fb5c2e",
                                                "sense_id": "aa67de82-7bb3-32c7-846f-03998dfed875",
                                                "text": "„Die zersprungenen Basaltblöcke lagen am Grunde des Fjords verstreut wie auf einem antiken Trümmerfeld.“"
                                            },
                                            {
                                                "example_id": "05e6651d-0d69-4d6a-bebf-4f19a8920c9b",
                                                "sense_id": "aa67de82-7bb3-32c7-846f-03998dfed875",
                                                "text": "„Auf diese Weise nehmen sie riesige Flächen für sich in Besitz, manche der Männer erklären sogar ganze Fjorde zu ihrem persönlichen Eigentum.“"
                                            },
                                            {
                                                "example_id": "8e225c28-6be2-4d5b-b58e-03c33badaacb",
                                                "sense_id": "aa67de82-7bb3-32c7-846f-03998dfed875",
                                                "text": "„Den ersten Fjord zu fahren ist ein besonderes Erlebnis.“"
                                            },
                                            {
                                                "example_id": "08b3a9a3-d4be-4f57-812e-357bc8c6764e",
                                                "sense_id": "aa67de82-7bb3-32c7-846f-03998dfed875",
                                                "text": "Fjord oder Förde – die Frage, mit welchem Namen Flensburg werben soll, wird nicht nur bei den Touristikern heiß diskutiert (wir berichteten)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
