                        "examples": [
                            {
                                "example_id": "ed8ac105-e2de-4ebe-bd3a-c7b695b9a112",
                                "sense_id": "f983a1aa-cca5-3ac6-b6d2-43ed6992733e",
                                "text": "Het spul werd zo genoemd omdat het sterk uitdijde wanneer het verdampte, zodat een kleine hoeveelheid al een groot stofvlak kon vormen, zoals een klein druppeltje olie zich als een oliefilm van moleculaire dikte verspreidde over een groot wateroppervlak."
                            },
                            {
                                "example_id": "c93654f8-c1d9-4d1f-a7d6-56cc622eb28d",
                                "sense_id": "f983a1aa-cca5-3ac6-b6d2-43ed6992733e",
                                "text": "Het olympisch zeiltoernooi in de bocht van Guanabara is al geruime tijd omstreden. Onder anderen de Nederlandse medaillekandidaten Dorian van Rijsselberghe en Marrit Bouwmeester hebben al kunnen ervaren dat er behalve een oliefilm ook veel vuil in de baai drijft, waaronder kadavers. Bij tropische hoosbuien spoelt de troep uit de krottenwijken zo de zee in. Ook wordt er veel ongezuiverd water geloosd."
                            }
                        ]
                    }
