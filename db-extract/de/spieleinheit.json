                ],
                "senses": [
                    {
                        "sense_id": "8a783edc-d762-3f17-82e5-d84b5ea3104e",
                        "entry_id": "c6ec4118-037f-385f-a592-d0a719b9d13b",
                        "glosses": [
                            "in sich geschlossener inhaltlicher, methodischer, struktureller oder zeitlicher Teil eines komplexen Spielgeschehens realer oder virtueller Art"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d566b46d-05fb-4da0-a3ac-fd9b9c1435f4",
                                "sense_id": "8a783edc-d762-3f17-82e5-d84b5ea3104e",
                                "text": "„Im zweiten thematischen Block ging es um Fragen zu handlungsleitenden Überlegungen während der Spieleinheit.“"
                            },
                            {
                                "example_id": "915a9cb9-8be1-4382-9595-a6f90ce72eaf",
                                "sense_id": "8a783edc-d762-3f17-82e5-d84b5ea3104e",
                                "text": "„Die Spieleinheiten werden so strukturiert, dass sie für die Kinder vorhersehbar sind.“"
                            },
                            {
                                "example_id": "625f16fc-2ee0-4ca6-8c89-73f74533c14d",
                                "sense_id": "8a783edc-d762-3f17-82e5-d84b5ea3104e",
                                "text": "„Länger als eine Spieleinheit von sieben Minuten, Chukka genannt, können sie nicht galoppieren.“"
                            },
                            {
                                "example_id": "8e2961e1-59d1-49f5-9e31-69c6a80cf7e8",
                                "sense_id": "8a783edc-d762-3f17-82e5-d84b5ea3104e",
                                "text": "„Unsere Spiele eignen sich eben besser für kurze Spieleinheiten als die aufwendigen Entwicklungen, sagt Shinichi Iriyama von Gree.“"
                            },
                            {
                                "example_id": "88056066-c140-4f4d-84cd-bbac4ec5c2e0",
                                "sense_id": "8a783edc-d762-3f17-82e5-d84b5ea3104e",
                                "text": "„Hilbigs Roman hat die Wahrheit der Märchen; deren Bau einer eigenen Logik setzt sich ja zusammen aus lauter unlogischen kleinen Spieleinheiten: sprechende Spiegel und Frösche als Prinzen und blutende Schühchen und Haar so lang wie ein Schloßturm hoch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
