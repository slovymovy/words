                        "sense_id": "b77b831d-641a-31ba-b823-9ba682c31250",
                        "entry_id": "bb0d2caa-ac66-30a3-9365-865c6d7e4db9",
                        "glosses": [
                            "Femme née pendant un baby-boom et qui va prendre, ou a déjà pris, sa retraite."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f93a2f28-43fc-4d92-ac1d-4b54269903c4",
                                "sense_id": "b77b831d-641a-31ba-b823-9ba682c31250",
                                "text": "À eux aussi de se saisir de ce sujet si actuel, en profitant du fait que le débat n'a jamais autant tourné autour de ces baby-boomers nés à partir de 1946 et qui deviennent mamy-boomeuses et papy-boomers."
                            },
                            {
                                "example_id": "abbc9c0c-a2f6-4b7f-857c-e6091be8e39b",
                                "sense_id": "b77b831d-641a-31ba-b823-9ba682c31250",
                                "text": "Aussi futée que sa royale belle-mère, elle a magnifiquement défini sa cible : les papy-boomers et les mamy-boomeuses."
                            }
                        ]
                    }
