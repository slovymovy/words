                "senses": [
                    {
                        "sense_id": "2a595881-ba17-3979-b9c0-2b906e994905",
                        "entry_id": "fe56c390-04b4-3205-9f09-b0505d5a8326",
                        "glosses": [
                            "andauerndes Quälen/Triezen"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "5bdf2901-7c1e-4048-b531-dbf4341e9e58",
                                "sense_id": "2a595881-ba17-3979-b9c0-2b906e994905",
                                "text": "„Als ein heftiger Einspruch seitens Onkel Paules gegen diese Triezerei erfolgt, hat man unter Ignorierung des verweisartigen Charakters dieses Einspruchs sofort eine Gegenfrage, die den gegnerischen Einspruch zum Inhaltsteil des Gesprächs macht.“"
                            },
                            {
                                "example_id": "12677f4f-e0b0-4d6c-8052-371b32c82a5d",
                                "sense_id": "2a595881-ba17-3979-b9c0-2b906e994905",
                                "text": "„Die ewige Triezerei wirkt sich aus als eine rücksichtslose Ausnutzung aller Beteiligten, denen nach den verflossenen schweren Kampftagen etwas Ruhe weit besser tun würde.“"
                            },
                            {
                                "example_id": "4995803c-b4fb-40a6-8019-78d663644c46",
                                "sense_id": "2a595881-ba17-3979-b9c0-2b906e994905",
                                "text": "„Als Grund für die Triezerei habe er ihr gesagt, dass die CDU ihn in der Zeit als hessischen Umweltminister auch so hart rangenommen hätte.“"
                            },
                            {
                                "example_id": "d5a6c87b-edb3-4d15-a6c9-4ac435d0aac2",
                                "sense_id": "2a595881-ba17-3979-b9c0-2b906e994905",
                                "text": "„Scheinbar zwanglos ergibt sich eins aus dem anderen, aus Plauderei und Triezerei.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
