                "senses": [
                    {
                        "sense_id": "e7b5eba9-9c4f-337e-b7b5-815d5b344bc1",
                        "entry_id": "d36a5f35-31e7-3385-b503-8d946b1f3dc0",
                        "glosses": [
                            "Höhe, auf der Flugverkehr stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e31646de-3e7e-4895-bc6e-6a6351e6993e",
                                "sense_id": "e7b5eba9-9c4f-337e-b7b5-815d5b344bc1",
                                "text": "„Er erklärt mir, wie ich das Flugzeug wieder auf Reiseflughöhe bringen könne, nachdem er über dem Ozean abgesprungen sei.“"
                            },
                            {
                                "example_id": "31892d7f-b6f2-4b9c-a708-a5f0211aa783",
                                "sense_id": "e7b5eba9-9c4f-337e-b7b5-815d5b344bc1",
                                "text": "„Mittlerweile hatte sich die Fluglage stabilisiert, obwohl Kolt sicher war, dass sie noch lange keine normale Reiseflughöhe erreicht hatten.“"
                            },
                            {
                                "example_id": "21bba74f-da7a-45b7-a75f-905fd5bd06e7",
                                "sense_id": "e7b5eba9-9c4f-337e-b7b5-815d5b344bc1",
                                "text": "„Bei neuntausend Metern erreichte das Flugzeug seine Reiseflughöhe und steuerte, das Gefunkel der Sterne hinter sich, durch den mexikanischen Himmel nordwärts.“"
                            },
                            {
                                "example_id": "286859c7-72ee-40aa-befe-ba51d3c352a6",
                                "sense_id": "e7b5eba9-9c4f-337e-b7b5-815d5b344bc1",
                                "text": "„Wir hatten unsere Reiseflughöhe noch nicht erreicht, als der Flugbegleiter in Zivil mich zum hinteren Besprechungsraum dirigierte und die nussbaumfurnierte Tür hinter mir verriegelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
