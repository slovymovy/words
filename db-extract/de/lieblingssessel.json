                        "examples": [
                            {
                                "example_id": "531c94af-5fea-466b-aebc-3679faabcaf3",
                                "sense_id": "205b5e69-db99-31e7-b05a-010d06eb8e9f",
                                "text": "„Er hatte angenommen, sie bei heruntergelassenen Jalousien in ihrem Lieblingssessel im Wohnzimmer kauernd vorzufinden, in Tränen aufgelöst vielleicht, doch das Wohnzimmer war leer.“"
                            },
                            {
                                "example_id": "95286008-f793-475b-b0cb-0451b45362f3",
                                "sense_id": "205b5e69-db99-31e7-b05a-010d06eb8e9f",
                                "text": "„Er nahm einen Schluck davon und setzte sich in seinen Lieblingssessel.“"
                            }
                        ],
