                ],
                "senses": [
                    {
                        "sense_id": "71189be6-c5da-3fb0-9749-43e48eaf39a3",
                        "entry_id": "84d9647a-289d-3e96-bf9c-f6d061f481ea",
                        "glosses": [
                            "eineinhalb Stunden dauernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63dfa406-de94-47de-aeb3-78a6ec373cbb",
                                "sense_id": "71189be6-c5da-3fb0-9749-43e48eaf39a3",
                                "text": "„Im Lauf der eineinhalbstündigen Vernehmung durch Garvey und Kincaid stellt er ebenso viele Fragen, wie er beantwortet, und liefert freiwillig eine Menge Informationen.“"
                            },
                            {
                                "example_id": "133ee783-b19d-430a-b4eb-008a0a9057f2",
                                "sense_id": "71189be6-c5da-3fb0-9749-43e48eaf39a3",
                                "text": "„Und jenseits dieser engeren Schutzzone, so war ihm versichert worden, waren die regimetreuen Milizen ausgeschwärmt und hatten Städte und Dörfer im Umkreis von 20 Kilometern durchkämmt und gesäubert, extra für seinen eineinhalbstündigen Besuch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
