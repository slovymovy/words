                        "examples": [
                            {
                                "example_id": "ec92805a-28d0-4c5c-8b8a-12f948f4cc4c",
                                "sense_id": "4786ecb7-8bcf-3de8-9858-1e8825bd80d4",
                                "text": "После долгого молчания Панов убито промолвил, что грош цена его рекомендации."
                            },
                            {
                                "example_id": "103ee35f-f377-42c7-946e-bb2004e05659",
                                "sense_id": "4786ecb7-8bcf-3de8-9858-1e8825bd80d4",
                                "text": "― Да, ― убито кивнул головой Корнилов.― Если так, то на редкость умный и хорошо замаскированный."
                            },
                            {
                                "example_id": "e94cf0ae-f048-41b3-b4d6-fc6cabb8e0f9",
                                "sense_id": "4786ecb7-8bcf-3de8-9858-1e8825bd80d4",
                                "text": "― Говори по порядку, ― Нугзар убито пустился на стул."
                            }
                        ]
                    }
