                                        "entry_id": "ed0fcbba-0542-3a8f-b82a-343f1567e7b6",
                                        "glosses": [
                                            "die Handlung, etwas ungültig oder nicht-existent zu machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69e76cde-52bc-458b-acf5-6459aa892231",
                                                "sense_id": "ae1eb5cb-f884-395f-80c1-2722dd7219bf",
                                                "text": "Die Demonstranten dort sind für die Abschaffung der Todesstrafe."
                                            },
                                            {
                                                "example_id": "418ed54b-fcb7-4cfb-8de0-46f376c55eb7",
                                                "sense_id": "ae1eb5cb-f884-395f-80c1-2722dd7219bf",
                                                "text": "„Der Norden, der inzwischen erfolgreich Fabriken mit Wasserkraft und Dampfmaschinen betrieb, hatte sich auch gesellschaftlich modernisiert und forderte die Abschaffung der Sklaverei.“"
                                            },
                                            {
                                                "example_id": "b66b9fde-7f83-4384-b131-2d2b9897bcc1",
                                                "sense_id": "ae1eb5cb-f884-395f-80c1-2722dd7219bf",
                                                "text": "„Die Abschaffung der Feudalherrschaft 1868 in Japan hat die Grundlinien des tradierten Anredesystems nicht verwischt.“"
                                            },
                                            {
                                                "example_id": "bc17728e-a57e-415d-a200-8e2fd6836d09",
                                                "sense_id": "ae1eb5cb-f884-395f-80c1-2722dd7219bf",
                                                "text": "„Bemerkenswert ist seine fröhliche Bejahung der Abschaffung des Erbadels.“"
                                            },
                                            {
                                                "example_id": "06196ea7-f779-4bc4-85cb-1c8f5603f934",
                                                "sense_id": "ae1eb5cb-f884-395f-80c1-2722dd7219bf",
                                                "text": "„Der Text war scharf romfeindlich und sprach sich für die Säkularisierung von Kirchengut, die Priesterehe und die Abschaffung der Leibeigenschaft aus.“"
                                            }
                                        ],
