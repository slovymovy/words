                "senses": [
                    {
                        "sense_id": "55740ca8-252e-3804-9ed8-2c7cb74753e1",
                        "entry_id": "a96e8b37-9a87-3dbb-b7fc-8b2c28d5c774",
                        "glosses": [
                            "das Eingehen einer weiteren Ehe, obwohl man noch verheiratet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d9b01d5-6dda-4566-8804-bbd070568b1b",
                                "sense_id": "55740ca8-252e-3804-9ed8-2c7cb74753e1",
                                "text": "„Meine Mutter solle ihm schreiben, daß Herr Krabbe sich um keine weiteren Familien meines Vaters kümmern werde und ihm auch nicht beistehe, wenn er wegen Bigamie eingesperrt würde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6c245052-7372-4d72-af4c-30b4444d877c",
                        "source_entry_id": "a96e8b37-9a87-3dbb-b7fc-8b2c28d5c774",
                        "source_sense_id": "55740ca8-252e-3804-9ed8-2c7cb74753e1",
                        "source_sense_description": "das Eingehen einer weiteren Ehe, obwohl man noch verheiratet ist",
                        "target_lang_word": "重婚",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "重婚",
                                "target_lang_code": "zh",
                                "target_senses": [
                                    {
                                        "sense_id": "52d1afbb-7156-3a0f-9792-10210617d279",
                                        "entry_id": "b556ecd5-df0d-3baf-bded-ef058c4f0afb",
                                        "glosses": [
                                            "已有配偶而又與他人結婚"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "41018ca7-92f0-340d-a2af-57eebc6ad0b4",
                                        "entry_id": "b556ecd5-df0d-3baf-bded-ef058c4f0afb",
                                        "glosses": [
                                            "重新婚配，再婚"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "809735bb-89c1-43da-9fe5-9dfa52b5608a",
                                                "sense_id": "41018ca7-92f0-340d-a2af-57eebc6ad0b4",
                                                "text": "我當替你别選高門，重婚俊傑，也不誤你一世。"
                                            },
                                            {
                                                "example_id": "cd4352d7-bf33-4ef9-b2b2-9d4cd94baeeb",
                                                "sense_id": "41018ca7-92f0-340d-a2af-57eebc6ad0b4",
                                                "text": "我当替你别选高门，重婚俊杰，也不误你一世。"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "06654d92-b459-384d-9e84-020f42054c4f",
                                        "entry_id": "b556ecd5-df0d-3baf-bded-ef058c4f0afb",
                                        "glosses": [
                                            "已有亲缘关系的双方再结姻缘之好"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54361327-5f54-42de-acd5-3caeb253c055",
                        "source_entry_id": "a96e8b37-9a87-3dbb-b7fc-8b2c28d5c774",
                        "source_sense_id": "55740ca8-252e-3804-9ed8-2c7cb74753e1",
                        "source_sense_description": "das Eingehen einer weiteren Ehe, obwohl man noch verheiratet ist",
                        "target_lang_word": "bigamy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigamy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                        "entry_id": "b2396ad4-61b1-3ba6-a6a0-e4c3854bf411",
                                        "glosses": [
                                            "The state of having two (legal or illegal) spouses simultaneously."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c60eedb-4b74-47f7-ac60-65606cf16e69",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "But now we may find in S. Margarets life, who it is that is Chriſtes wife: whereby we are ſo much wiſer than we were before. But looke in the life of S. Katharine, in the golden legend, and you ſhall find that he was alſo married to S. Katharine, and that our ladie made the marriage, &c. An excellent authoritie for bigamie."
                                            },
                                            {
                                                "example_id": "9a33cd19-4c01-4fa3-b13f-52dcb1156fec",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "A beauty-waining and diſtreſſed widow [Elizabeth Woodville], / Euen in the afternoone of her beſt daies / Made priſe and purchaſe of his [Edward IV's] luſtfull eye, / Seduct the pitch and height of al his thoughts, / To baſe declenſion and loathd bigamie, / By her in his vnlawfull bed he got."
                                            },
                                            {
                                                "example_id": "9e75c3ca-042e-432d-8ab5-5ecfcf3b03ba",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "Not to take a Wife to her Siſter] Not to take one Wife to another, or not to have at once two Wives. This ſentence condemneth Bigamie, and Polygamie, having two or more Wives together, Lev[iticus] 18. 18. Neither ſhalt thou take a Wife to her Siſter to vex her."
                                            },
                                            {
                                                "example_id": "9effe95d-a843-427f-a29f-66c80f3dd5a8",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "It is the Complaint of many that ſecular Judges and others make an Objection of Bigamy againſt Clerks when they are taken and impriſon'd for their Crimes, and demand to be ſent to the Eccleſiaſtical Court; [...] Farther he who marries a Widow, or two Women oftentimes does not contract Bigamy according to them, and they do not eſteem ſome to be Bigamiſts, who really are ſo."
                                            },
                                            {
                                                "example_id": "ffbf5095-ba88-44cf-a632-3fbe258f0d4f",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "This is a peculiar privilege of the clergy, that sentence of death can never be passed upon them for any number of manslaughters, bigamies, simple larcenies, or other clergyable offences; [...]"
                                            },
                                            {
                                                "example_id": "835a7278-be25-4059-8e8a-111ad21d7d82",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "The missionaries have prepared a sort of penal tariff to facilitate judicial proceedings. [...] The judge being provided with a book, in which all these matters are cunningly arranged, the thing is vastly convenient. For instance: a crime is proved,—say, bigamy; turn to letter B.—and there you have it. Bigamy:—forty days on the Broom Road, and twenty mats for the queen. Read the passage aloud, and sentence is pronounced."
                                            },
                                            {
                                                "example_id": "912a54d3-ee14-454f-b2ae-1215c7d40dd4",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "The providers of our sensational fiction [...] have gone on describing murders, bigamies, and forgeries, forgeries, bigamies, and murders, until at length these crimes have become about the most commonplace acts that a hero or heroine can perform."
                                            },
                                            {
                                                "example_id": "e417c1be-31bb-4ee4-9ea2-760bae046b94",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "Anita laughed and hugged him and told him he was the best kid in the world, if he was fifteen years older she'd commit bigamy and marry him. Sully-John blushed until he was purple."
                                            },
                                            {
                                                "example_id": "84b5af32-5cfb-4fc9-950a-d7318d37eafa",
                                                "sense_id": "c8a17fa4-f277-3abc-b1ed-910e99cfaf6c",
                                                "text": "One of nineteenth-century Britain's most important pieces of marriage law legislation, the Matrimonial Causes Act of 1857, immediately preceded the explosion of bigamy novels in the early 1860s. [...] Bigamy plots thus suggest a literary-historical asymmetry: just when middle-class Victorians no longer needed to commit bigamy, or, for that matter, murder, to get rid of an unwanted first spouse, bigamy was transformed from a real crime into a popular narrative device."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1816f969-1491-3cc7-8dbc-9313167a7d3c",
                                        "entry_id": "b2396ad4-61b1-3ba6-a6a0-e4c3854bf411",
                                        "glosses": [
                                            "A second marriage after the death of a spouse."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a93ec4b5-9d02-4a7f-b7a9-329048705033",
                                                "sense_id": "1816f969-1491-3cc7-8dbc-9313167a7d3c",
                                                "text": "Bigamie was a counterplea (deuiſed at yͤ Councell of Lyons, vpon mislike of ſecond marriage) to be obiected, when the priſoner demaundeth the benefite of the Clergie, to wit, his Book, as namely to ſay, that he which demaundeth the priuiledge of the Clergie, was married to ſuch a woman at ſuch a place, within ſuch a Dioceſſe, and that ſhee is dead, and that hee hath married another woman within the ſame Dioceſſe, or within ſome other Dioceſſe, and ſo is Bigamus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
