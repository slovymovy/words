                ],
                "senses": [
                    {
                        "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                        "entry_id": "71a5da00-aa71-3d79-beeb-07e859a4451b",
                        "glosses": [
                            "Eigenschaft, eine Vielzahl von Lösungen, Bedeutungen, Funktionen oder Ähnliches zu haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3560bb2-b9d6-456d-be02-fad28672fb5f",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Während Ambiguität das sprachtheoretische Problem der Herstellung begrifflicher Zu- und Einordnungen bezeichne, beziehe sich Ambivalenz auf Mehrwertigkeit im Erleben und Handeln […].“"
                            },
                            {
                                "example_id": "dd2857fc-6eeb-4374-93c9-8d24ef69c6bb",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Eben dieser traditionelle, die ganze abendländische Philosophie bis zu Hegel immer 15 konsequenter beherrschende Subjekt-Objekt-Dualismus muß einer ursprünglicheren Mehrwertigkeit Platz machen.“"
                            },
                            {
                                "example_id": "90d7a8a4-5394-42cd-8d56-267bd0490316",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Hinsichtlich der Mehrwertigkeit der Zukunftserwartungen lässt sich leider nicht mehr sagen, als dass diese durch nichts aus der Welt zu schaffen ist und beim Bewertungsvorgang berücksichtigt werden muss.“"
                            },
                            {
                                "example_id": "363c94cf-e020-446a-b60e-d000062f918e",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Die permanente Beschämung des Ichs entsteht aus der Mehrstimmigkeit und Mehrwertigkeit dessen, was es beherrscht.“"
                            },
                            {
                                "example_id": "67cf0da1-b679-4f24-aad6-0771196cfbf7",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Ambiguität ist somit mit Vieldeutigkeit, Ambivalenz dagegen mit Mehrwertigkeit von Bewertung zu definieren.“"
                            },
                            {
                                "example_id": "8baba194-e99f-455c-96be-e1181a6bc0fd",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Durch eine Mehrwertigkeit von Kursen und der Zusammenfassung von zertifizierten Abschlüssen soll diese Durchlässigkeit erreicht werden.“"
                            },
                            {
                                "example_id": "adca588c-7b52-4700-a72c-b6266edfff5a",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Polyvalenz bedeutet Mehrwertigkeit und war in Herthas zweieinhalb Schweizer Jahren unbedingte Einstellungsvoraussetzung.“"
                            },
                            {
                                "example_id": "c7c65b5a-113b-4eee-b836-c659167483e9",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Aus dieser Mehrwertigkeit der Zielausprägungen resultiert in einer Entscheidungssituation das Problem der Auswahl alternativer Aktivitäten.“"
                            },
                            {
                                "example_id": "8617f009-9d47-4707-ad09-96f2ef1ea8ff",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Die Mehrwertigkeit des Konsumismus hebt sich hier sehr prägnant von der Einwertigkeit der Religion und der Zweiwertigkeit der Politik ab.“"
                            },
                            {
                                "example_id": "d6830016-0722-46f9-8194-c0bae3353b7c",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Daraus ergäbe sich nicht zuletzt aufgrund der Mehrwertigkeit der Inflationserwartungen ein beachtliches Prognoseproblem.“"
                            },
                            {
                                "example_id": "f0c267cc-54a3-405b-85a3-3764dfa100ff",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Die Komplexität und Mehrwertigkeit in der Bedeutungsgebung des Verstehensbegriffs macht ihn für den wissenschaftlichen und damit auch konzeptionellen Gebrauch ungeeignet.“"
                            },
                            {
                                "example_id": "e2368048-0dc4-49c2-9ac1-47c49584c95e",
                                "sense_id": "20816642-b41f-3c26-9b11-58e43eb91521",
                                "text": "„Das Werk ist ein leuchtendes Beispiel für Bermejos Kunst der Mehrwertigkeit: Andachtsbild, Bilderzählung, Landschaftsmalerei, religiöse Allegorie und eine Hommage an Fauna und Flora zugleich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
