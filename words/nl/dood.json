                        "ru": "в очень сильной степени; очень сильно"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dead",
                                "target_lang_sense_clarification": "used as an intensifier"
                            },
                            {
                                "target_lang_word": "extremely",
                                "target_lang_sense_clarification": "to a high degree"
                            },
                            {
                                "target_lang_word": "to death",
                                "target_lang_sense_clarification": "used in phrases like 'scared to death'"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "до смерти",
                                "target_lang_sense_clarification": "в выражениях типа 'испугаться до смерти'"
                            },
                            {
                                "target_lang_word": "ужасно",
                                "target_lang_sense_clarification": "как усилитель"
                            },
                            {
                                "target_lang_word": "смертельно",
                                "target_lang_sense_clarification": "очень сильно"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ff380f55-4203-35bd-afc4-d8d15e0b5ae1",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>doden</w>",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>dood</w> de tijd door een boek te lezen.",
