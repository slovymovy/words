            "senses": [
                {
                    "sense_id": "f9caa759-a373-3886-8fae-c88b36ffbecf",
                    "sense_definition": "Naviguer, avancer sur l'eau en parlant d'un bateau ou d'une embarcation.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "navigation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit bateau <w>vogue</w> doucement sur les flots calmes du lac."
                        },
                        {
                            "text": "Ils aiment <w>voguer</w> au gré du vent le long de la côte."
                        }
                    ],
                    "synonyms": [
                        "naviguer",
                        "flotter"
                    ],
                    "antonyms": [
                        "couler",
                        "sombrer"
                    ],
                    "common_phrases": [
                        "voguer au gré du vent",
                        "voguer sur les flots",
                        "voguer vers le large"
                    ]
                },
                {
                    "sense_id": "4654dba7-520c-39a3-8585-c5e5edeb8840",
                    "sense_definition": "Se déplacer avec légèreté dans l'air ou l'espace, comme un navire sur l'eau.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lourds nuages sombres <w>voguaient</w> lentement dans le ciel d'automne."
                        },
                        {
                            "text": "La montgolfière <w>vogue</w> au-dessus de la vallée sans faire le moindre bruit."
                        }
                    ],
                    "synonyms": [
                        "planer",
                        "flotter"
                    ],
                    "common_phrases": [
