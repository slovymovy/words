                "senses": [
                    {
                        "sense_id": "1bf8bdcc-e283-3a5c-b472-b1f49c94bfe8",
                        "entry_id": "e5dbaa2b-7055-34fe-82a7-44006320b34c",
                        "glosses": [
                            "eine Theorie, die die heutigen großen Menschenaffen oder Pongidae, insbesondere die Schimpansen, mit ihren im Verhältnis zu den Beinen deutlich verlängerten Armen als modellartige Ausgangsform für die Entwicklung in Richtung auf die Menschenartigen oder Hominidae betrachtet"
                        ],
                        "tags": [
                            "Evolutionsbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "35ad0958-c517-41d4-922c-384b048911a6",
                                "sense_id": "1bf8bdcc-e283-3a5c-b472-b1f49c94bfe8",
                                "text": "„Die Pongidenhypothese in ihrer allgemeinsten Prägung bleibt allerdings trotz aller Neufunde und der damit gegebenen Beurteilungsmöglichkeiten durchaus unerschüttert.“"
                            },
                            {
                                "example_id": "87e9f406-0f23-4549-9166-b02a2aabda9d",
                                "sense_id": "1bf8bdcc-e283-3a5c-b472-b1f49c94bfe8",
                                "text": "Nach der Pongidenhypothese überspannt der heutige Schimpanse (Pan troglodytes) die Stadien von arboreal-bimanueller bis zur terrestrisch-bipeden Fortbewegung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
