                        "glosses": [
                            "Donner un caractère consensuel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "829aedfc-5fc9-4a79-a391-f6037eeac5b3",
                                "sense_id": "1da78343-4285-3542-8726-1b765b8a54d8",
                                "text": "L’important, de nos jours, ce n'est pas d’imposer des décisions, mais de les « consensualiser »."
                            },
                            {
                                "example_id": "b414774f-b7a7-4877-ae15-b663b7062f70",
                                "sense_id": "1da78343-4285-3542-8726-1b765b8a54d8",
                                "text": "Une autre vision, d’inspiration à la fois sociale-démocrate et institutionnaliste, voit dans les institutions qui interviennent dans le monde socio-économique une façon de normaliser, même de consensualiser, les comportements des acteurs."
                            }
                        ]
                    }
