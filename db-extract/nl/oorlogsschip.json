                    {
                        "sense_id": "7584b3f7-fb76-37e2-9ea5-86e3ea21ce53",
                        "entry_id": "8ce62ef9-5ca0-38dd-bd19-54e08214356a",
                        "glosses": [
                            "warship, combat ship"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "2a0c4907-a553-49ff-bc5c-097a801de382",
                                "sense_id": "7584b3f7-fb76-37e2-9ea5-86e3ea21ce53",
                                "text": "Het oorlogsschip patrouilleerde de kustlijn om piraterij te bestrijden.",
                                "translation": "The warship patrolled the coastline to combat piracy.",
                                "english": "The warship patrolled the coastline to combat piracy."
                            },
                            {
                                "example_id": "5da07017-c444-48aa-87b7-0049c8b6ad73",
                                "sense_id": "7584b3f7-fb76-37e2-9ea5-86e3ea21ce53",
                                "text": "Het oorlogsschip was uitgerust met geavanceerde wapens en communicatiesystemen.",
                                "translation": "The combat ship was equipped with advanced weapons and communication systems.",
                                "english": "The combat ship was equipped with advanced weapons and communication systems."
                            },
                            {
                                "example_id": "d4bede1e-cec5-4bac-a997-ce27de16ecab",
                                "sense_id": "7584b3f7-fb76-37e2-9ea5-86e3ea21ce53",
                                "text": "Het oorlogsschip was onderdeel van een internationale vloot die opereerde in conflictgebieden.",
                                "translation": "The warship was part of an international fleet operating in conflict zones.",
                                "english": "The warship was part of an international fleet operating in conflict zones."
                            }
                        ]
                    }
                ],
