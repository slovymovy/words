                                                "sense_id": "ae59bffb-1c48-3ec1-a0ec-905947e42f14",
                                                "text": "It's supercalifragilisticexpialidocious."
                                            },
                                            {
                                                "example_id": "fbc79a88-f588-4c6e-85ad-b0ab5f79bbc2",
                                                "sense_id": "ae59bffb-1c48-3ec1-a0ec-905947e42f14",
                                                "text": "By comparison with the present transcribers, I'm sure my performance would be supercalifragilisticexpialidocious."
                                            },
                                            {
                                                "example_id": "f3473111-3a22-41a0-afac-f6efaf3badd1",
                                                "sense_id": "ae59bffb-1c48-3ec1-a0ec-905947e42f14",
                                                "text": "This is a real biggie so pay attention—I still pinch myself occasionally to even believe I did this; it was supercalifragilisticexpialidocious."
                                            }
                                        ]
                                    }
