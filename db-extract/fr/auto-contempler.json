                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f01cc6c-4c4e-4455-a2af-de8e1ec9e086",
                                "sense_id": "d23b302f-62e7-3572-8be5-cfb47f48f13e",
                                "text": "À Pampelune, et dans d’autres arènes où la tendance consiste pour le spectateur à s’auto-contempler dans le miroir du minotaure, le public passe souvent à coté d’une analyse correcte."
                            },
                            {
                                "example_id": "d16f18cb-082a-4326-b0de-e0d3a4fa1e64",
                                "sense_id": "d23b302f-62e7-3572-8be5-cfb47f48f13e",
                                "text": "La liberté n’a pas d’autre but que de s’aliéner elle-même dans l’acte librement choisi. Si elle reste à s’auto-contempler, elle n’est plus qu'une impuissance."
                            }
                        ]
                    }
