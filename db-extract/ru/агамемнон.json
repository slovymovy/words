                                        "sense_id": "ec359ad0-8cf1-3f7f-9de8-887224d9fa0e",
                                        "entry_id": "f5ac84e8-4f96-3fe8-8dde-2c6d9557682f",
                                        "glosses": [
                                            "One of the most distinguished heroes of Greek mythology. He is the son of King Atreus of Mycenae and Queen Aerope and the brother of Menelaus. He is famous for rallying the Greeks in the Trojan War, yet infamous for the sacrifice of his daughter Iphigenia at the commencement of the war."
                                        ],
                                        "tags": [
                                            "Greek"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a184f997-0e23-4ce8-a321-41752fbcdd57",
                        "source_entry_id": "e6b059a4-db8c-3b08-ba76-7a8160700988",
                        "target_lang_word": "Agamenón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
