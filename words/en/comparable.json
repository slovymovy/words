{
    "word_family": [
        "compare",
        "comparison",
        "comparative",
        "comparatively",
        "incomparable"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "2d456e3e-7675-3579-a287-a4f24af28c36",
                    "sense_definition": "Similar in size, amount, or quality to something else",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two cars are <w>comparable</w> in price but the first one has better features.",
                            "target_lang_translations": {
                                "ru": "Эти две машины <w>сопоставимы</w> по цене, но у первой характеристики лучше.",
                                "zh": "这两辆车价格<w>相当</w>，但第一辆车的配置更好。",
                                "es": "Los dos coches son <w>comparables</w> en precio, pero el primero tiene mejores características."
                            }
                        },
                        {
                            "text": "The increase in risk is <w>comparable</w> to the risk of other long-term illnesses.",
                            "target_lang_translations": {
                                "ru": "Увеличение риска <w>сравнимо</w> с риском других хронических заболеваний.",
                                "zh": "风险的增加与其它长期疾病的风险<w>相当</w>。",
                                "es": "El aumento del riesgo es <w>comparable</w> al riesgo de otras enfermedades a largo plazo."
                            }
                        }
                    ],
                    "antonyms": [
                        "different",
                        "unequal"
                    ],
                    "common_phrases": [
                        "comparable in size",
                        "comparable in price",
                        "broadly comparable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Схожий по размеру, количеству или качеству с чем-либо другим",
                        "zh": "在大小、数量或质量上与他物相似",
                        "es": "Similar en tamaño, cantidad o calidad a otra cosa"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сопоставимый",
                                "target_lang_sense_clarification": "по характеристикам"
                            },
                            {
                                "target_lang_word": "сравнимый",
                                "target_lang_sense_clarification": "по величине или качеству"
                            },
                            {
                                "target_lang_word": "аналогичный",
                                "target_lang_sense_clarification": "подобный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "相当的",
                                "target_lang_sense_clarification": "指程度或质量相近"
                            },
                            {
                                "target_lang_word": "可比的",
                                "target_lang_sense_clarification": "指可以放在一起比较"
                            },
                            {
                                "target_lang_word": "类似的",
                                "target_lang_sense_clarification": "指性质相近"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "comparable",
                                "target_lang_sense_clarification": "que tiene similitud o analogía"
                            },
                            {
                                "target_lang_word": "equivalente",
                                "target_lang_sense_clarification": "de valor o calidad similar"
                            },
                            {
                                "target_lang_word": "semejante",
                                "target_lang_sense_clarification": "que tiene características parecidas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "754b90fe-5737-3c2a-91bd-6cbc4b9c3cb0",
                    "sense_definition": "Able to be compared to something else because of similar characteristics",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "similarity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "An elephant is <w>comparable</w> in size to a double-decker bus.",
                            "target_lang_translations": {
                                "ru": "Слон <w>сопоставим</w> по размеру с двухэтажным автобусом.",
                                "zh": "大象的体型与双层巴士<w>相当</w>。",
                                "es": "Un elefante es <w>comparable</w> en tamaño a un autobús de dos pisos."
                            }
                        },
                        {
                            "text": "You cannot say that robbing a bank is like pickpocketing because the two are simply not <w>comparable</w>.",
                            "target_lang_translations": {
                                "ru": "Нельзя сказать, что ограбление банка — это то же самое, что карманная кража, потому что эти вещи просто <w>несопоставимы</w>.",
                                "zh": "你不能说抢银行和扒窃是一回事，因为这两者根本没有<w>可比性</w>。",
                                "es": "No se puede decir que robar un banco es como el carterismo porque ambos simplemente no son <w>comparables</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "incomparable"
                    ],
                    "common_phrases": [
                        "not comparable",
                        "directly comparable"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот, который можно сравнить с чем-либо из-за схожих черт",
                        "zh": "因具有相似特征而能够进行比较的",
                        "es": "Que puede ser comparado con otra cosa debido a características similares"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сравнимый",
                                "target_lang_sense_clarification": "допускающий сравнение"
                            },
                            {
                                "target_lang_word": "сопоставимый",
                                "target_lang_sense_clarification": "имеющий общие черты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可比的",
                                "target_lang_sense_clarification": "指具备比较的条件"
                            },
                            {
                                "target_lang_word": "相提并论的",
                                "target_lang_sense_clarification": "指可以放在一起讨论"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "comparable",
                                "target_lang_sense_clarification": "que se puede comparar lógicamente"
                            },
                            {
                                "target_lang_word": "equiparable",
                                "target_lang_sense_clarification": "que puede ponerse al mismo nivel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2beb9c7a-5c8e-3efd-b6ac-6e52d8f57281",
                    "sense_definition": "Having comparative and superlative forms",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word big is a <w>comparable</w> adjective because it can take the forms bigger and biggest.",
                            "target_lang_translations": {
                                "ru": "Слово «big» — это прилагательное, <w>имеющее степени сравнения</w>, так как оно может принимать формы «bigger» и «biggest».",
                                "zh": "单词 big 是一个<w>可比较的</w>形容词，因为它有 bigger 和 biggest 两种形式。",
                                "es": "La palabra 'big' es un adjetivo <w>graduable</w> porque puede adoptar las formas 'bigger' y 'biggest'."
                            }
                        },
                        {
                            "text": "Some linguists argue that absolute adjectives like unique are not <w>comparable</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые лингвисты утверждают, что абсолютные прилагательные, такие как «unique», <w>не имеют степеней сравнения</w>.",
                                "zh": "一些语言学家认为，像 unique 这样的绝对形容词是不<可比较的>。",
                                "es": "Algunos lingüistas argumentan que los adjetivos absolutos como 'único' no son <w>graduables</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "gradable"
                    ],
                    "antonyms": [
                        "ungradable"
                    ],
                    "common_phrases": [
                        "comparable adjective"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий степени сравнения (сравнительную и превосходную)",
                        "zh": "指形容词具有比较级和最高级形式",
                        "es": "Que admite grados de comparación (comparativo y superlativo)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "имеющий степени сравнения",
                                "target_lang_sense_clarification": "в лингвистике"
                            },
                            {
                                "target_lang_word": "градуируемый",
                                "target_lang_sense_clarification": "о качественных прилагательных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可比较的",
                                "target_lang_sense_clarification": "指词汇学中具有等级变化"
                            },
                            {
                                "target_lang_word": "有等级的",
                                "target_lang_sense_clarification": "指形容词的程度变化"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "graduable",
                                "target_lang_sense_clarification": "en lingüística, que admite grados"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d6ce2d3-5b4b-3e2f-9391-54d55f616a33",
                    "sense_definition": "Constituting a pair in a particular partial order",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Six and forty-two are <w>comparable</w> in the divides order but six and nine are not.",
                            "target_lang_translations": {
                                "ru": "Шесть и сорок два <w>сравнимы</w> в отношении делимости, а шесть и девять — нет.",
                                "zh": "在整除关系中，6 和 42 是<w>可比较的</w>，但 6 和 9 则不是。",
                                "es": "Seis y cuarenta y dos son <w>comparables</w> en la relación de divisibilidad, pero seis y nueve no."
                            }
                        },
                        {
                            "text": "In this set, any two elements are <w>comparable</w> under the given relation.",
                            "target_lang_translations": {
                                "ru": "В этом множестве любые два элемента <w>сравнимы</w> в рамках данного отношения.",
                                "zh": "在这个集合中，任意两个元素在给定关系下都是<w>可比较的</w>。",
                                "es": "En este conjunto, cualesquiera dos elementos son <w>comparables</w> bajo la relación dada."
                            }
                        }
                    ],
                    "antonyms": [
                        "incomparable"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Образующий пару в определенном частичном порядке",
                        "zh": "在数学偏序关系中能够构成比较对的",
                        "es": "Que forma un par en un orden parcial determinado"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сравнимый",
                                "target_lang_sense_clarification": "в математике"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可比较的",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "comparable",
                                "target_lang_sense_clarification": "en matemáticas, dentro de una relación de orden"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "daa6a3eb-a590-380f-8756-89e017cdd642",
                    "sense_definition": "An item or property that is suitable for comparison to another, especially in real estate",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "comparison_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The appraiser could not find any <w>comparables</w> because there had been no sales nearby.",
                            "target_lang_translations": {
                                "ru": "Оценщик не смог найти <w>аналогов</w>, так как поблизости не было продаж.",
                                "zh": "评估师找不到任何<w>参照物</w>，因为附近近期没有房产交易。",
                                "es": "El tasador no pudo encontrar ningún <w>análogo</w> porque no había habido ventas cerca."
                            }
                        },
                        {
                            "text": "When valuing the house, we looked at several <w>comparables</w> in the same neighborhood.",
                            "target_lang_translations": {
                                "ru": "При оценке дома мы изучили несколько <w>сопоставимых объектов</w> в том же районе.",
                                "zh": "在评估这栋房子时，我们参考了同一社区的几个<w>可比案例</w>。",
                                "es": "Al valorar la casa, observamos varios <w>análogos</w> en el mismo vecindario."
                            }
                        }
                    ],
                    "common_phrases": [
                        "market comparables",
                        "recent comparables"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "business"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объект или объект недвижимости, подходящий для сравнения с другим",
                        "zh": "适合用于比较的物品或属性，尤指房地产估价中的参照物",
                        "es": "Elemento o propiedad adecuado para ser comparado con otro, especialmente en bienes raíces"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аналог",
                                "target_lang_sense_clarification": "для оценки стоимости"
                            },
                            {
                                "target_lang_word": "сопоставимый объект",
                                "target_lang_sense_clarification": "в недвижимости"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "参照物",
                                "target_lang_sense_clarification": "估价时的对比对象"
                            },
                            {
                                "target_lang_word": "可比案例",
                                "target_lang_sense_clarification": "房地产评估中的类似房产"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "análogo",
                                "target_lang_sense_clarification": "objeto de referencia para valoración"
                            },
                            {
                                "target_lang_word": "término de comparación",
                                "target_lang_sense_clarification": "en tasaciones inmobiliarias"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}