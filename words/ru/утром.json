                                "nl": "Morgen<ochtend> gaan we naar het buitenhuis.",
                                "pl": "Jutro <rano> pojedziemy na działkę.",
                                "de": "Morgen <am Morgen> fahren wir zur Datscha.",
                                "fr": "Demain <matin>, nous irons à la datcha.",
                                "it": "Domani <mattina> andremo alla dacia.",
                                "cs": "Zítra <ráno> pojedeme na chatu.",
                                "tr": "Yarın <sabah> yazlığa gideceğiz.",
                                "es": "Mañana <por la mañana> iremos a la casa de campo."
                            }
                        },
                        {
                            "text": "Сегодня <утром> была прекрасная погода.",
                            "target_lang_translations": {
                                "en": "The weather was beautiful this <morning>.",
                                "zh": "今天<早上>天气很好。",
                                "nl": "Het was <vanmorgen> prachtig weer.",
                                "pl": "Dzisiaj <rano> była piękna pogoda.",
                                "de": "Heute <am Morgen> war das Wetter herrlich.",
                                "fr": "Il a fait un temps magnifique <ce matin>.",
                                "it": "Questa <mattina> c'era un tempo bellissimo.",
                                "cs": "Dnes <ráno> bylo krásné počasí.",
                                "tr": "Bugün <sabah> hava çok güzeldi.",
                                "es": "Hoy <por la mañana> hizo un tiempo maravilloso."
                            }
