                "forms": [],
                "senses": [
                    {
                        "sense_id": "7d564972-aba4-3e43-aa45-4ab5b1731e67",
                        "entry_id": "cf1bbace-f5be-3754-acf7-61cae2b5d16b",
                        "glosses": [
                            "w wystarczającym stopniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69bbd66a-b7c4-44ee-8f65-9313f3f21ac5",
                                "sense_id": "7d564972-aba4-3e43-aa45-4ab5b1731e67",
                                "text": "Jak ona się zachowa? - myślał. - Czy jest dostatecznie bystra, żeby zrozumieć naszą wspólną grę?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "71d7a287-373b-4476-a609-d2e94a53c4ea",
                        "source_entry_id": "cf1bbace-f5be-3754-acf7-61cae2b5d16b",
                        "source_sense_id": "7d564972-aba4-3e43-aa45-4ab5b1731e67",
                        "target_lang_word": "sufficiently",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sufficiently",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3ab3eb9-99c2-3da4-8b8a-b05e5bcf530b",
                                        "entry_id": "d647abfc-d11d-3d85-aeb6-c16eaf1a6d45",
                                        "glosses": [
                                            "In a sufficient manner; enough."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3160b8bf-1b1f-4387-9d12-2def4da69cdc",
                                                "sense_id": "d3ab3eb9-99c2-3da4-8b8a-b05e5bcf530b",
                                                "text": "Once we had eaten and drunk sufficiently, we padded off to sleep."
                                            },
                                            {
                                                "example_id": "30d0d0e1-09da-420c-ac18-5c95d5a79c1a",
                                                "sense_id": "d3ab3eb9-99c2-3da4-8b8a-b05e5bcf530b",
                                                "text": "Sunning himself on the board steps, I saw for the first time Mr. Farquhar Fenelon Cooke.[…]A silver snaffle on a heavy leather watch guard which connected the pockets of his corduroy waistcoat, together with a huge gold stirrup in his Ascot tie, sufficiently proclaimed his tastes."
                                            },
                                            {
                                                "example_id": "549de24d-6f08-4566-b3e7-38e72a2698f6",
                                                "sense_id": "d3ab3eb9-99c2-3da4-8b8a-b05e5bcf530b",
                                                "text": "I prefer to think that birds have a sufficiently developed sense of humour to enjoy the spectacle of a human being hunched beneath a bush kissing the back of their hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b142f75b-bc89-39ec-a15b-61bd719ef20e",
                                        "entry_id": "d647abfc-d11d-3d85-aeb6-c16eaf1a6d45",
                                        "glosses": [
                                            "To a sufficient extent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dca12fd-8ea9-425b-9061-af3a0d484256",
                                                "sense_id": "b142f75b-bc89-39ec-a15b-61bd719ef20e",
                                                "text": "We wanted to build a tepee, but we couldn't find sufficiently long sticks."
                                            },
                                            {
                                                "example_id": "610d84dd-8e65-4029-9ff5-3dbc538b3593",
                                                "sense_id": "b142f75b-bc89-39ec-a15b-61bd719ef20e",
                                                "text": "There are those who value a seat sufficiently highly that they prefer to make their daily journeys by the Western Region Vine Street line."
                                            },
                                            {
                                                "example_id": "13120bc0-c920-4c9b-b925-14e11b42509a",
                                                "sense_id": "b142f75b-bc89-39ec-a15b-61bd719ef20e",
                                                "text": "Attempts by Waterloo signalmen to clear the points by power operation eventually exhausted point motor batteries, which are fed by trickle chargers, and a blown fuse accentuated the problem; thus, even when the points had been cleared of ice, no power was available to operate them until the batteries were sufficiently recharged."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1b75ac4-6d5a-442f-9f7e-2402a152fba6",
                        "source_entry_id": "cf1bbace-f5be-3754-acf7-61cae2b5d16b",
                        "source_sense_id": "7d564972-aba4-3e43-aa45-4ab5b1731e67",
