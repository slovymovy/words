                ],
                "senses": [
                    {
                        "sense_id": "90f4835d-9686-35bd-8ee6-f2fb64d6f0b9",
                        "entry_id": "f1ef4ec5-0efc-3af8-88dc-f770d66b0e65",
                        "glosses": [
                            "weibliche Person, die gegen Bezahlung ihre Arbeitskraft in einem Haushalt zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02734b84-342b-4af8-8c16-2e5ad87729b8",
                                "sense_id": "90f4835d-9686-35bd-8ee6-f2fb64d6f0b9",
                                "text": "„Tausende junge äthiopische Frauen gehen jedes Jahr in die Golfstaaten, um sich dort als Hausangestellte zu verdingen.“"
                            },
                            {
                                "example_id": "6e2fe8a0-7453-4a92-a880-979012928c8f",
                                "sense_id": "90f4835d-9686-35bd-8ee6-f2fb64d6f0b9",
                                "text": "„Hinterm Haus würde sich eine Zweizimmerwohnung für die Hausangestellten befinden.“"
                            },
                            {
                                "example_id": "9091df00-ca87-4837-8ca7-09518814c8f3",
                                "sense_id": "90f4835d-9686-35bd-8ee6-f2fb64d6f0b9",
                                "text": "„Wer wundert sich da, dass selbst passionierte Hausangestellte diesem Berufszweig den Rücken kehren?“"
                            },
                            {
                                "example_id": "62eb165b-d232-4879-b442-3a6c4c5e6420",
                                "sense_id": "90f4835d-9686-35bd-8ee6-f2fb64d6f0b9",
                                "text": "„Für Karla Castrup war Henni bald mehr als nur eine Hausangestellte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
