                                        "entry_id": "b204f093-f237-3c09-a216-1581a33190f9",
                                        "glosses": [
                                            "Unquestionably dead. Used for both inanimate objects and once living beings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75bcdc3c-565f-4a0e-a564-5f15376e0b4d",
                                                "sense_id": "0eadf96f-120a-38ae-984d-393fd7127ae2",
                                                "text": "I picked up the phone, but the line was dead as a doornail."
                                            },
                                            {
                                                "example_id": "1619cc48-007d-4e21-8bee-6ae9db7e1b0f",
                                                "sense_id": "0eadf96f-120a-38ae-984d-393fd7127ae2",
                                                "text": "We finally found John's cat run over in the next road. He was as dead as a doornail."
                                            },
                                            {
                                                "example_id": "01405de0-f264-4a77-bb21-ed0d02c72f46",
                                                "sense_id": "0eadf96f-120a-38ae-984d-393fd7127ae2",
                                                "text": "Old Marley was as dead as a door-nail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
