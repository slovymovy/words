                        "zh": [
                            {
                                "target_lang_word": "树干",
                                "target_lang_sense_clarification": "树木的主干"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c11db526-92d2-384b-a0d3-7ae2c62fb33e",
                    "sense_definition": "The enclosed space at the back of a car used for carrying luggage and other goods.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please put your suitcases in the <w>trunk</w> before we leave.",
