                ],
                "senses": [
                    {
                        "sense_id": "1e6a85bf-3dc3-3183-b58a-24b4e487d68e",
                        "entry_id": "0e256530-6d07-371e-b9c8-97267fd5a039",
                        "glosses": [
                            "griechischer Schnaps mit dem Geschmack von Anis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9186e8a3-bbbf-452b-b33a-80a791f1774c",
                                "sense_id": "1e6a85bf-3dc3-3183-b58a-24b4e487d68e",
                                "text": "In griechischen Lokalen bekommt man meist ungefragt einen Ouzo als Aperitif."
                            },
                            {
                                "example_id": "7b4e5b97-c0c9-4950-b0c3-dfae5520b71f",
                                "sense_id": "1e6a85bf-3dc3-3183-b58a-24b4e487d68e",
                                "text": "„Unterwegs in den Dörfern kostet der Ouzo eine Drachme (14 Pfennig), ebensowenig ein Täßchen griechisch-türkisch gebrauten Kaffees.“"
                            },
                            {
                                "example_id": "bc805c23-14e8-4633-91c9-57a5f6ec66df",
                                "sense_id": "1e6a85bf-3dc3-3183-b58a-24b4e487d68e",
                                "text": "„Der Ouzo hebt seine Laune.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f78ed8ed-c617-4580-ae11-ace013bba0aa",
                        "source_entry_id": "0e256530-6d07-371e-b9c8-97267fd5a039",
                        "source_sense_id": "1e6a85bf-3dc3-3183-b58a-24b4e487d68e",
                        "source_sense_description": "griechischer Schnaps mit dem Geschmack von Anis",
                        "target_lang_word": "ouzo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouzo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e610ec3c-7289-30f1-8b40-2f50faec9a77",
                                        "entry_id": "f075ac22-4558-3fd4-a502-21b2217853a8",
                                        "glosses": [
                                            "An anise-flavoured aperitif, originating in Greece."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2a0120-ef84-4e79-b949-812f0856fcb9",
                                                "sense_id": "e610ec3c-7289-30f1-8b40-2f50faec9a77",
                                                "text": "Jai went in and poured out two glasses of ouzo, throwing a splash of water. He stuck his finger into each and stirred; the liquor swirled and got foggy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4a4e788-e685-39e8-bea7-8ac1bc256c4c",
                                        "entry_id": "f075ac22-4558-3fd4-a502-21b2217853a8",
                                        "glosses": [
                                            "A serving of this drink."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51942048-11d9-4c63-b0e3-807363cb0f6d",
                                                "sense_id": "b4a4e788-e685-39e8-bea7-8ac1bc256c4c",
                                                "text": "In Athens he looked up from his ouzo at what he called the ugliest people in the world."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "205e6636-dfbe-45fe-915d-64633041b416",
                        "source_entry_id": "0e256530-6d07-371e-b9c8-97267fd5a039",
                        "source_sense_id": "1e6a85bf-3dc3-3183-b58a-24b4e487d68e",
                        "source_sense_description": "griechischer Schnaps mit dem Geschmack von Anis",
                        "target_lang_word": "ouzo",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouzo",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a57aa73c-f134-359d-81e4-8d707e34331d",
                                        "entry_id": "9905845a-c11f-3bd5-9f47-5b69fdd0c0a9",
                                        "glosses": [
                                            "Liqueur d’origine grecque parfumée à l’anis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17a1a15a-09df-4178-9138-ee1e6ce66312",
                                                "sense_id": "a57aa73c-f134-359d-81e4-8d707e34331d",
                                                "text": "— Parfait, conclut la Mastodonte, vous étiez donc chez le Chinois et vous buviez du retsina.\n— Non, de l’ouzo. Leur retsina n'est pas bon. Il est trouble, il sent mauvais."
                                            },
                                            {
                                                "example_id": "945c542c-ac13-477f-ac58-f8a75e3d124e",
                                                "sense_id": "a57aa73c-f134-359d-81e4-8d707e34331d",
                                                "text": "Rien à voir, le raki turc, c'est plutôt comme de l'ouzo."
                                            },
                                            {
                                                "example_id": "84925c22-138f-497b-a1d4-0a7be255e840",
                                                "sense_id": "a57aa73c-f134-359d-81e4-8d707e34331d",
                                                "text": "Sa couleur solaire, associée par la publicité au bleu du ciel et de la mer, quiinvitait à l’évasion, au voyage, à la fête voire à « l’estrambord », acheva de « marseilliser » l’image de cette boisson, cousine méditerranéenne de l’ouzo, du raki ou de l’arak."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4a4ba5c-f36a-42fa-ab5a-b653dfc0d4b7",
                        "source_entry_id": "0e256530-6d07-371e-b9c8-97267fd5a039",
                        "source_sense_id": "1e6a85bf-3dc3-3183-b58a-24b4e487d68e",
