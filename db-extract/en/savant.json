                ],
                "translations": [
                    {
                        "translation_id": "4f55d91e-302a-4dbe-a9e2-56cd9801e470",
                        "source_entry_id": "023b9fd5-84a0-36a9-a39a-c5601c376d9d",
                        "source_sense_description": "a person of learning",
                        "target_lang_word": "Gelehrter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gelehrter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "db445bae-7cdc-3950-9cd3-4e6a98a23053",
                                        "entry_id": "d4371655-1e53-3dd6-8b24-804325bebc8b",
                                        "glosses": [
                                            "gebildete Person, die über erhebliches Wissen, meist einer bestimmten Fachrichtung, verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc70178a-3611-48fe-baae-549e07b72b7a",
                                                "sense_id": "db445bae-7cdc-3950-9cd3-4e6a98a23053",
                                                "text": "Der Gelehrte referierte über die Auswirkungen der Französischen Revolution."
                                            },
                                            {
                                                "example_id": "f76995d3-f66f-417b-bc4a-60587d94a031",
                                                "sense_id": "db445bae-7cdc-3950-9cd3-4e6a98a23053",
                                                "text": "„Dieser Einwand kursierte, seit der Terror des Pariser Wohlfahrtsausschusses viele deutsche Schriftsteller und Gelehrte über ihre eigene Courage hatte so erschrecken lassen, dass sie auch mental wieder zu jener Ordnung zurückkehrten, die von ihnen politisch ohnehin nie infrage gestellt worden war.“"
                                            },
                                            {
                                                "example_id": "c2f12588-2cd5-4de3-aa79-3248fe8bd1bb",
                                                "sense_id": "db445bae-7cdc-3950-9cd3-4e6a98a23053",
                                                "text": "„In dem Überfall sieht der Gelehrte eine Strafe Gottes - anders kann er sich das plötzliche Auftauchen der Ungläubigen nicht erklären.“"
                                            },
                                            {
                                                "example_id": "ab0696b5-8699-48f0-b8b0-b2065fffb3e7",
                                                "sense_id": "db445bae-7cdc-3950-9cd3-4e6a98a23053",
                                                "text": "„Wie kann ich aus der Welt fliehen und mein Leben als Gelehrter rechtfertigen, in einem Zeitalter, das nach der Zerstörung der Universität schreit.“"
                                            },
                                            {
                                                "example_id": "ac823786-0cdc-420b-bfef-808122b5fb2c",
                                                "sense_id": "db445bae-7cdc-3950-9cd3-4e6a98a23053",
                                                "text": "„Die heutigen Gelehrten sind lauter Schwätzer.“"
                                            },
                                            {
                                                "example_id": "59a9a33d-ec2e-471a-b353-b175055c961a",
                                                "sense_id": "db445bae-7cdc-3950-9cd3-4e6a98a23053",
                                                "text": "„Es gab eine lange Tradition unter jüdischen Gelehrten, sich mit arabischer Kultur zu beschäftigen: […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
