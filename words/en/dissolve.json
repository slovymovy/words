{
    "word_family": [
        "dissolution",
        "dissolvable",
        "dissolvent",
        "indissoluble",
        "undissolved"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f495f94c-930e-3d6a-887c-506fe8c5905f",
                    "sense_definition": "To cause a solid substance to become part of a liquid to form a solution.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>dissolve</w> the sugar in warm water before adding it to the mixture.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>растворить</w> сахар в теплой воде, прежде чем добавлять его в смесь."
                            }
                        },
                        {
                            "text": "The scientist watched the salt <w>dissolve</w> completely in the beaker.",
                            "target_lang_translations": {
                                "ru": "Ученый наблюдал, как соль полностью <w>растворяется</w> в мензурке."
                            }
                        }
                    ],
                    "synonyms": [
                        "melt"
                    ],
                    "common_phrases": [
                        "dissolve in water",
                        "dissolve sugar",
                        "dissolve salt"
                    ],
                    "target_lang_definitions": {
                        "ru": "Растворять твердое вещество в жидкости для получения раствора."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растворять",
                                "target_lang_sense_clarification": "процесс смешивания с жидкостью"
                            },
                            {
                                "target_lang_word": "растворить",
                                "target_lang_sense_clarification": "завершить процесс растворения"
                            },
                            {
                                "target_lang_word": "распускать",
                                "target_lang_sense_clarification": "разг., часто о краске или масле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9b48e9a8-25e3-386a-9136-8f624f956735",
                    "sense_definition": "To officially end a formal group, organization, or legal agreement such as a marriage or parliament.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "termination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prime minister decided to <w>dissolve</w> parliament and call for a new election.",
                            "target_lang_translations": {
                                "ru": "Премьер-министр решил <w>распустить</w> парламент и назначить новые выборы."
                            }
                        },
                        {
                            "text": "They agreed to <w>dissolve</w> their partnership after ten years of working together.",
                            "target_lang_translations": {
                                "ru": "Они согласились <w>расторгнуть</w> партнерство после десяти лет совместной работы."
                            }
                        }
                    ],
                    "antonyms": [
                        "establish",
                        "found"
                    ],
                    "common_phrases": [
                        "dissolve parliament",
                        "dissolve a marriage",
                        "dissolve a partnership"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально прекращать деятельность организации, группы или действие юридического соглашения (брака, парламента)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распускать",
                                "target_lang_sense_clarification": "о парламенте или организации"
                            },
                            {
                                "target_lang_word": "расторгать",
                                "target_lang_sense_clarification": "о браке или договоре"
                            },
                            {
                                "target_lang_word": "ликвидировать",
                                "target_lang_sense_clarification": "об организации или компании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fa0cd4b-4bb3-3411-a121-edadc8d60487",
                    "sense_definition": "To annul, rescind, or officially bring a legal order or injunction to an end.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge chose to <w>dissolve</w> the injunction after hearing the new evidence.",
                            "target_lang_translations": {
                                "ru": "Судья решил <w>отменить</w> судебный запрет после заслушивания новых показаний."
                            }
                        },
                        {
                            "text": "The old government was <w>dissolved</w> and reshaped by the new leadership.",
                            "target_lang_translations": {
                                "ru": "Старое правительство было <w>распущено</w> и переформировано новым руководством."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dissolve an injunction"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Аннулировать, отменять или официально прекращать действие судебного приказа или запрета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "аннулировать",
                                "target_lang_sense_clarification": "официально отменять"
                            },
                            {
                                "target_lang_word": "отменять",
                                "target_lang_sense_clarification": "прекращать действие указа"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a1c3fd3-7736-3ab5-bbb8-64074e1a3e40",
                    "sense_definition": "To transition between two film scenes by having one image gradually disappear while the next appears.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "film_editing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The director used a slow <w>dissolve</w> to show the passage of time between the two scenes.",
                            "target_lang_translations": {
                                "ru": "Режиссер использовал медленный <w>наплыв</w>, чтобы показать течение времени между двумя сценами."
                            }
                        },
                        {
                            "text": "The editor decided to <w>dissolve</w> from the forest shot into the city skyline.",
                            "target_lang_translations": {
                                "ru": "Монтажер решил сделать <w>переход</w> от кадра с лесом к панораме города."
                            }
                        }
                    ],
                    "synonyms": [
                        "fade out"
                    ],
                    "common_phrases": [
                        "dissolve to black"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создавать переход между сценами в кино, когда одно изображение постепенно исчезает, а другое появляется."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "делать наплыв",
                                "target_lang_sense_clarification": "киномонтажный прием"
                            },
                            {
                                "target_lang_word": "растворять",
                                "target_lang_sense_clarification": "постепенно переходить к следующему кадру"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ee90a696-1343-33e2-add1-9a148e5d7896",
                    "sense_definition": "A transition in film or video where one shot is gradually replaced by another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "film_editing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The film uses many <w>dissolves</w> and wipes to create a nostalgic period effect.",
                            "target_lang_translations": {
                                "ru": "В фильме используется много <w>наплывов</w> и шторных переходов для создания ностальгического эффекта эпохи."
                            }
                        },
                        {
                            "text": "A quick <w>dissolve</w> linked the two sequences together seamlessly.",
                            "target_lang_translations": {
                                "ru": "Быстрый <w>наплыв</w> плавно соединил два эпизода."
                            }
                        }
                    ],
                    "synonyms": [
                        "fade out"
                    ],
                    "common_phrases": [
                        "slow dissolve",
                        "cross dissolve"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переход в кино или видео, при котором один кадр постепенно заменяется другим."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наплыв",
                                "target_lang_sense_clarification": "плавный переход между кадрами"
                            },
                            {
                                "target_lang_word": "затемнение",
                                "target_lang_sense_clarification": "в контексте ухода кадра"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}