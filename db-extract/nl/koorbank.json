                "senses": [
                    {
                        "sense_id": "16f4e2e5-860e-36d1-a399-dca8cd3e8fe7",
                        "entry_id": "2fd6ba9a-5d90-3bed-a414-e65d896897ed",
                        "glosses": [
                            "een rij zitplaatsen tegen de zijwanden van het koor van een kerk, meestal een kathedraal, kapittelkerk of kloosterkerk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6906e3a3-e2dc-4224-a2b1-19c914a9a525",
                                "sense_id": "16f4e2e5-860e-36d1-a399-dca8cd3e8fe7",
                                "text": "Hollande wordt verder onder meer erekanunnik van de Notre Dame-basiliek in Cléry in Centraal-Frankrijk, waar Lodewijk XI begraven ligt. Dat geeft hem het recht in de koorbanken voor in de kerk plaats te nemen en een almucium (een bepaald soort bontmantel) te dragen."
                            },
                            {
                                "example_id": "ec4167c3-db2c-43b4-9137-231bf2a7d945",
                                "sense_id": "16f4e2e5-860e-36d1-a399-dca8cd3e8fe7",
                                "text": "In de hoek staat een koorbank waarin in vroeger tijd de geestelijken stonden te zingen. Aan de wand hangt een aantal levensgrote schilderijen van ene heer van Persyn en zijn echtgenote. In een vitrine staan drie dozen vol met pijpenkoppen."
                            }
                        ]
                    }
