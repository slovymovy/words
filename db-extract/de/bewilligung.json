                    {
                        "sense_id": "47ef6df7-b8ef-3dd2-bd17-45de32e35d3a",
                        "entry_id": "e81b2455-cdcf-3caf-85c4-4a5ec8808b81",
                        "glosses": [
                            "formelle (amtliche) Zustimmung zu einem Vorhaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d314ad-0e5d-4a58-99cd-6e7995df3b0e",
                                "sense_id": "47ef6df7-b8ef-3dd2-bd17-45de32e35d3a",
                                "text": "„Das Aufstellen einer Sänfte im Bereich einer Fußgeherzone bedarf dann keiner Bewilligung gem § 82 Abs 1 StVO, wenn dies in der Absicht erfolgt, die Sänfte von dort aus bestimmungsgemäß, also für einen Personentransport auf einer Straße mit öffentlichem Verkehr, einzusetzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9131b304-3478-3e23-b1be-46af044900fa",
                        "entry_id": "e81b2455-cdcf-3caf-85c4-4a5ec8808b81",
                        "glosses": [
                            "das formelle (amtliche) Zustimmen zu einem Vorhaben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7230dc7d-28d4-4d53-bef0-3c30971bbacf",
                                "sense_id": "9131b304-3478-3e23-b1be-46af044900fa",
                                "text": "„Das Aufstellen einer Sänfte im Bereich einer Fußgeherzone bedarf dann keiner Bewilligung gem § 82 Abs 1 StVO, wenn dies in der Absicht erfolgt, die Sänfte von dort aus bestimmungsgemäß, also für einen Personentransport auf einer Straße mit öffentlichem Verkehr, einzusetzen.“"
                            }
                        ],
