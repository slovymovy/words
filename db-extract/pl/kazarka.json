                    {
                        "translation_id": "63b2f86a-39bc-475b-886e-5a43692cff8a",
                        "source_entry_id": "584c515e-9d00-3d6c-a2c4-bd7c67c1b450",
                        "source_sense_id": "9f52a462-8237-34df-9744-533e6acba6f3",
                        "target_lang_word": "огарь",
