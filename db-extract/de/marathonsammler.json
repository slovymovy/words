                ],
                "senses": [
                    {
                        "sense_id": "fa6dbbc8-e49a-339d-aaf3-ecc61a6ce524",
                        "entry_id": "a041aec1-94f3-3084-97ee-3688222f91ce",
                        "glosses": [
                            "Person, die viele Marathonläufe absolviert hat und diese Teilnahmen als eine Art Sammlung betrachtet"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "6c08be75-cdf9-44f6-9aa0-3a450b7e82d1",
                                "sense_id": "fa6dbbc8-e49a-339d-aaf3-ecc61a6ce524",
                                "text": "„Als Marathonsammler, der lieber häufiger Marathons im Dauerlauftempo läuft, als wenige Marathons versucht schnell zu rennen, nehme ich die so oder so kurze Zeit eines Marathonlaufs gerne zum Anlass mehrere Tage in besonderen Regionen zu verbringen und diese intensiv zu erkunden.“"
                            },
                            {
                                "example_id": "3fa9ceeb-38be-4ff7-a8cf-58d03b66cee8",
                                "sense_id": "fa6dbbc8-e49a-339d-aaf3-ecc61a6ce524",
                                "text": "„Der Ultraläufer und Marathonsammler Frank Pachura aus Welver möchte im Kraftwerk von Personal Trainer Jan Martens von ‚seinem‚ Laufsport berichten.“"
                            },
                            {
                                "example_id": "5a26ccf4-3e72-4552-a456-5236652fad47",
                                "sense_id": "fa6dbbc8-e49a-339d-aaf3-ecc61a6ce524",
                                "text": "„Im übrigen sind Marathonsammler genau den selben Wehwehchen ausgesetzt wie jeder von euch.“"
                            },
                            {
                                "example_id": "0e0c6b16-85c1-47e3-be78-43d9e44f6a0a",
                                "sense_id": "fa6dbbc8-e49a-339d-aaf3-ecc61a6ce524",
                                "text": "„Als Marathonsammler (über 150) sieht er sich als Spezialist für Distanzen zwischen Halbmarathon und Marathon.“"
                            },
                            {
                                "example_id": "b31b2b59-0f53-47c8-8204-936048f4f740",
                                "sense_id": "fa6dbbc8-e49a-339d-aaf3-ecc61a6ce524",
                                "text": "„Bereits am 2. Juli startet in Bad Blumau ein anderer Extrem-Bewerb, über 50 ‚Marathonsammler‘ werden zehn Marathons in zehn Tagen absolvieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
