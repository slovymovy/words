                                "target_senses": [
                                    {
                                        "sense_id": "4e6d14ec-4a77-3682-be42-06f499386bf9",
                                        "entry_id": "9ce1c036-5477-35c7-bdf0-b81e86ad1c9c",
                                        "glosses": [
                                            "To exchange or give (something) in an non-normal exchange (for something else)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b03cbc5-ed76-4554-971e-4bfb81dd203b",
                                                "sense_id": "4e6d14ec-4a77-3682-be42-06f499386bf9",
                                                "text": "In an effort to provide more permanent accommodations, employers may offer employees the opportunity either to swap jobs with a colleague or to transfer to a new position."
                                            },
                                            {
                                                "example_id": "a80ffa30-7fae-474e-9c2d-0d354d01dfad",
                                                "sense_id": "4e6d14ec-4a77-3682-be42-06f499386bf9",
                                                "text": "Chief watched these goings-on without pleasure, and waved them off in disgust when the smarmiest of the two suggested he might wish to swap that elk's tooth for this jug of fine rye whiskey."
                                            },
                                            {
                                                "example_id": "fbf69728-fc28-4877-add6-ebb3cef0b5e6",
                                                "sense_id": "4e6d14ec-4a77-3682-be42-06f499386bf9",
                                                "text": "The Shah wanted to swap oil for more arms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0029e93e-539a-303f-8798-4e4ace925ec8",
                                        "entry_id": "9ce1c036-5477-35c7-bdf0-b81e86ad1c9c",
                                        "glosses": [
                                            "To hit, to strike."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38b186c5-83e7-4416-bbc2-5a59bee77158",
                                                "sense_id": "0029e93e-539a-303f-8798-4e4ace925ec8",
                                                "text": "And he whipped his sword out of its scabbard, and swapped off the pudding from the black knight's nose. Unfortunately (for him) he swapped off a good bit of the nose, too."
                                            },
                                            {
                                                "example_id": "8b27434d-c2d7-48e3-9cae-8e5812514a2d",
                                                "sense_id": "0029e93e-539a-303f-8798-4e4ace925ec8",
                                                "text": "\"Maybe Apes will grow honest, Sister,\" said Edmund. \"But, by the Lion, if he breaks it again, it may be in such time and place that any of us could swap off his head in clean battle.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "798617d7-baa9-3647-8ab4-3ff1dce8fe23",
                                        "entry_id": "9ce1c036-5477-35c7-bdf0-b81e86ad1c9c",
                                        "glosses": [
                                            "To beat the air, or ply the wings, with a sweeping motion or noise; to flap."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45f462a7-af3b-321d-8d25-db2d589ca2c7",
                                        "entry_id": "9ce1c036-5477-35c7-bdf0-b81e86ad1c9c",
                                        "glosses": [
                                            "To descend or fall; to rush hastily or violently."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "swap",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a32300b-ad6b-3b18-9d30-a2973979292b",
                                        "entry_id": "bacf7791-544c-35b3-9b1f-80e239bbc4dc",
                                        "glosses": [
                                            "An exchange of two comparable things."
                                        ],
                                        "tags": [],
