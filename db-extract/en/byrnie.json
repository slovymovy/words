                ],
                "senses": [
                    {
                        "sense_id": "a9b5bc2a-9ad4-3ea7-84a5-b388098760b8",
                        "entry_id": "d699c140-1793-3c7d-85f6-73726aae5565",
                        "glosses": [
                            "A short chain mail shirt, covering from the upper arms to the upper thighs."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "815437ed-3083-4eff-ae5f-eb72125fec61",
                                "sense_id": "a9b5bc2a-9ad4-3ea7-84a5-b388098760b8",
                                "text": "[…] those that walked armed before the Witches’ booths, six in company, harnessed as for battle in byrnies of shining bronze, with greaves and shields of bronze and helms that glanced in the sun."
                            },
                            {
                                "example_id": "2b104e7b-6f83-473e-a2e3-ecb3dc5635ba",
                                "sense_id": "a9b5bc2a-9ad4-3ea7-84a5-b388098760b8",
                                "text": "It was the Viking habit. Even as a man plowed his field or chopped trees in the woods, his byrnie and his sword were always at hand."
                            },
                            {
                                "example_id": "ccbe6d84-cebe-4efc-8771-8ec2cf0a4a60",
                                "sense_id": "a9b5bc2a-9ad4-3ea7-84a5-b388098760b8",
                                "text": "Unferth stood beside him, his huge arms folded on his byrnie."
                            },
                            {
                                "example_id": "7633af86-3d28-4f7e-95f6-95b60e6232de",
                                "sense_id": "a9b5bc2a-9ad4-3ea7-84a5-b388098760b8",
                                "text": "The mail-coat, or byrnie, was made of iron links that probably were cut out of sheet metal with a die, or from flat hammered wire cut into short lengths."
                            }
                        ]
                    }
                ],
