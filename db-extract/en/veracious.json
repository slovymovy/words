                                "sense_id": "842f0da2-42cf-31f2-b36e-e41fc3da0492",
                                "text": "The politician's statement was eventually proven to be veracious."
                            },
                            {
                                "example_id": "60ac0e82-a9de-4b8c-bf24-61586d2719c5",
                                "sense_id": "842f0da2-42cf-31f2-b36e-e41fc3da0492",
                                "text": "\"It were against all rules, whether of history or romance—whether I look to my grandfather Henri Quatre, or to the less veracious chronicles of Scuderi, and copy Oroondates—to depart without some favour.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "eb1f6abb-d73c-3437-b784-baf8349cb39b",
                        "entry_id": "80f93501-8c4c-368f-b3e4-287deda1f473",
                        "glosses": [
                            "Truthful; speaking the truth."
                        ],
                        "tags": [],
                        "examples": [
                            {
