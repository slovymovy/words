                "senses": [
                    {
                        "sense_id": "76c35c80-c870-3aca-bc91-a1f12cc29075",
                        "entry_id": "000565ee-327a-370a-a1dc-50ef544dc629",
                        "glosses": [
                            "Eigenschaft/Einstellung, kleinlich, pedantisch, nicht großzügig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a14c962f-7e29-42ab-8099-771af34458b2",
                                "sense_id": "76c35c80-c870-3aca-bc91-a1f12cc29075",
                                "text": "„Engherzigkeit war in dieser Gemeinde eine Lebensart, Heuchelei eine von allen praktizierte, aber nur von wenigen zur Vollendung gebrachte Kunst – und diese wenigen wurden dafür mit den erbärmlichsten Ehren bedacht.“"
                            },
                            {
                                "example_id": "af28fac2-1867-47b6-b0a8-c1f18b2eae46",
                                "sense_id": "76c35c80-c870-3aca-bc91-a1f12cc29075",
                                "text": "„Die Ausgewogenheit zwischen Selbstliebe und Nächstenliebe, zwischen Großherzigkeit und Engherzigkeit muss wieder hergestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
