                "senses": [
                    {
                        "sense_id": "d796d02a-3ae9-3c30-be87-f7f77c109ca0",
                        "entry_id": "eaa9ebb8-a0fe-3233-85e2-b80fcd530baf",
                        "glosses": [
                            "Petite butée dans un mécanisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9af39b9-28be-4180-a59b-debe71ad441a",
                                "sense_id": "d796d02a-3ae9-3c30-be87-f7f77c109ca0",
                                "text": "En se servant de la poignée L, l’ouvrière rabat la brosse Q, le va-et-vient marchant toujours, le taquet d’entraînement arrive au contact de la pièce A."
                            }
                        ]
                    },
                    {
                        "sense_id": "6021e4b3-c387-3507-acc8-5f1a734daa70",
                        "entry_id": "eaa9ebb8-a0fe-3233-85e2-b80fcd530baf",
                        "glosses": [
                            "Butée réglable utilisée pour arrêter le chariot d’une machine à écrire, pour taquer des caractères et les mettre à niveau."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "c9fec49a-d7f5-3843-b390-4d45a131b6cf",
                        "entry_id": "eaa9ebb8-a0fe-3233-85e2-b80fcd530baf",
                        "glosses": [
                            "Crochet où l’on amarre des cordages."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "135ddcc5-6cc7-4ed5-b293-29243db8686a",
                                "sense_id": "c9fec49a-d7f5-3843-b390-4d45a131b6cf",
                                "text": "Taquets de haubans, taquet de cabestan."
                            }
                        ]
                    },
                    {
                        "sense_id": "44af9e6c-9942-3dc6-bad2-e506783be82a",
                        "entry_id": "eaa9ebb8-a0fe-3233-85e2-b80fcd530baf",
                        "glosses": [
                            "Morceau de bois ou de métal taillé pour maintenir l’encoignure d’une armoire, d’un meuble ; bout de bois qui sert à porter le bout d’un tasseau ou d’une barre qu’on ne peut pas arrêter avec des clous."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d233c28b-779a-4fd8-98ac-495290575cc6",
                                "sense_id": "44af9e6c-9942-3dc6-bad2-e506783be82a",
                                "text": "Il m’enveloppa ensuite la tête d’un chiffon, tandis que De… lui disait : « Mettez-lui un taquet dans la bouche. » […]. Il cherchait à m’enfoncer un morceau de bois entre les lèvres pour que je ne puisse fermer la bouche […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "45eeac2a-b8dc-34b7-a7a1-a66d0f7790a3",
                        "entry_id": "eaa9ebb8-a0fe-3233-85e2-b80fcd530baf",
                        "glosses": [
                            "Coup de poing ou de pied, gifle."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f3b5ab67-5306-4350-a08e-5834df212481",
                                "sense_id": "45eeac2a-b8dc-34b7-a7a1-a66d0f7790a3",
                                "text": "Cet imbécile m’a collé un taquet en pleine figure, je suis devenu fou furieux, il a fallu nous séparer."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd2acc6c-de8d-3619-bf2f-ec7da91181bc",
                        "entry_id": "eaa9ebb8-a0fe-3233-85e2-b80fcd530baf",
                        "glosses": [
                            "Injection de drogue."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": []
                    }
