                ],
                "senses": [
                    {
                        "sense_id": "2da4dfb5-ee91-3120-bcb4-5e6085da092c",
                        "entry_id": "9313bdec-c66e-3062-bc84-26bb758bd171",
                        "glosses": [
                            "Behörde, Organisation oder Betrieb, die im Bereich des Postverkehrs tätig sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf972b86-9aa0-4e6e-a14f-e391d1415ace",
                                "sense_id": "2da4dfb5-ee91-3120-bcb4-5e6085da092c",
                                "text": "„Nach Einrichtung des Weltpostvereins und seines Standardportos verzeichnet der überseeische Postverkehr ebenso wie die Postdienste der beteiligten Länder gänzlich unerwartete Zuwachsraten.“"
                            },
                            {
                                "example_id": "a2fab78e-0472-49ad-89be-02ea96bba750",
                                "sense_id": "2da4dfb5-ee91-3120-bcb4-5e6085da092c",
                                "text": "„Häufig wurden auch Briefmarken zur Quittierung der Telegrammgebühren verwendet – schließlich waren Post- und Telegrafendienst oft in einer Behörde zusammengefasst.“"
                            },
                            {
                                "example_id": "7a5bd548-6580-4da0-9b00-6288febcf495",
                                "sense_id": "2da4dfb5-ee91-3120-bcb4-5e6085da092c",
                                "text": "„Damit startete in den von Alliierten besetzten deutschen Gebieten in und um Aachen ein noch lokal begrenzter, aber zuverlässiger Postdienst, der später das ganze Besatzungsgebiet der Briten und US-Amerikaner, die Bizone, umfassen sollte.“"
                            },
                            {
                                "example_id": "8ef58a08-b221-4a7f-b721-ec5677118db3",
                                "sense_id": "2da4dfb5-ee91-3120-bcb4-5e6085da092c",
                                "text": "„Es ist nicht klar, wann in Cobán zum ersten Mal ein Postdienst eingerichtet wurde, aber es ist eine Korrespondenz bekannt, die bis in die spanische Kolonialzeit zurückreicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "eb584458-1f49-33c3-9931-662b740ea9bc",
                        "entry_id": "9313bdec-c66e-3062-bc84-26bb758bd171",
                        "glosses": [
                            "Tätigkeit bei der Post"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc43417-c687-46c1-b7c4-9a15fe07cfff",
                                "sense_id": "eb584458-1f49-33c3-9931-662b740ea9bc",
                                "text": "„Er rechtfertigt sich: Als Évolué werde ein westlicher Lebensstil von ihm erwartet, sein Gehalt reiche dafür aber selbst nach mehr als einem Jahrzehnt im Postdienst nicht aus.“"
                            },
                            {
                                "example_id": "e17b17b2-58a2-46da-8717-522c889d850c",
                                "sense_id": "eb584458-1f49-33c3-9931-662b740ea9bc",
                                "text": "„Diese durften ja auch keine gewöhnlichen Telegramme versenden, sondern mussten sich mit dem Versand von Brieftelegrammen begnügen, während »Reichsdeutsche« in Böhmen und Mähren alle Postdienste uneingeschränkt in Anspruch nehmen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
