                ],
                "senses": [
                    {
                        "sense_id": "a5cba0e2-79e2-3b52-b252-697774e3ecf5",
                        "entry_id": "c1f90915-2646-3fb5-9dc0-0663a3dbe496",
                        "glosses": [
                            "Mann aus der Provinz, Mann mit vermeintlich geringem geistig-kulturellem Niveau"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a892f6f8-f139-4193-94e5-edd9f53289cd",
                                "sense_id": "a5cba0e2-79e2-3b52-b252-697774e3ecf5",
                                "text": "„Er war ein schüchterner, verklemmter, nicht gerade hochintelligenter, spätpubertierender Jüngling, einer von diesen Provinzheinis, die bisher noch nicht gewußt haben, daß es jenseits ihres Kaffs auch noch Welt gibt.“"
                            },
                            {
                                "example_id": "ac47ac6f-2d8a-4fdb-8a1e-b4f829d6fb98",
                                "sense_id": "a5cba0e2-79e2-3b52-b252-697774e3ecf5",
                                "text": "„Wie zwei Provinzheinis, die sich nicht abstimmen können.“"
                            },
                            {
                                "example_id": "33a274e3-90ee-4b76-b4e5-ac81f452bc76",
                                "sense_id": "a5cba0e2-79e2-3b52-b252-697774e3ecf5",
                                "text": "„Eine Fußball-WM demonstriert, dass wir als Provinzheinis, Gelegenheitsnationalisten und Weltbürger vielfältige und zum Teil ganz konträre Wir-Gefühle hegen können.“"
                            },
                            {
                                "example_id": "6923bb84-eb16-436e-afb0-a78bac7b831e",
                                "sense_id": "a5cba0e2-79e2-3b52-b252-697774e3ecf5",
                                "text": "„Bitte, wir reden hier nicht über irgendeinen Provinzheini. Wir reden über den Münchner Oberbürgermeister, einen Mann, der einmal im Jahr weltberühmt wird.“"
                            },
                            {
                                "example_id": "ed8f6996-b521-42ec-9957-132cc7c3b7a1",
                                "sense_id": "a5cba0e2-79e2-3b52-b252-697774e3ecf5",
                                "text": "„Es kann losgehen, nach dem letzten Vorlauf der Damen über 1500 Meter Freistil darf ich ins Becken, als Provinzheini im Riesenbecken der Metropole, in dem die Stars schwimmen, in dem Jan-Philip am Dienstag Bronze gewann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
