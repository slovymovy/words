                                "sense_id": "f530832c-039a-3f36-a685-a6ae75e1712c",
                                "text": "For every point on a great circle its antipole is on the same great circle."
                            }
                        ]
                    },
                    {
                        "sense_id": "c88d78ef-8b77-3e2f-bcb5-29847b46af19",
                        "entry_id": "5233cd04-54b4-33f2-a8cc-13457c1fcb54",
                        "glosses": [
                            "A position directly opposite (possibly also used figuratively)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9dd57445-da02-4617-b394-f16f8c0c186b",
                                "sense_id": "c88d78ef-8b77-3e2f-bcb5-29847b46af19",
                                "text": "A line drawn from a point on a circle to its antipole will cross through the center."
                            }
                        ]
                    }
                ],
