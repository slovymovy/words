                                            {
                                                "example_id": "3fc481b4-18bd-4244-b2e9-7cc4ec987c7b",
                                                "sense_id": "0a07724f-a4ef-3d77-bd14-fc9d8550f1ae",
                                                "text": "Seit diesem Schicksalsschlag ist sie zur Säuferin geworden."
                                            }
