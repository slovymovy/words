                "senses": [
                    {
                        "sense_id": "75b83823-2763-390a-b369-14433c59757d",
                        "entry_id": "d635a4a3-35d8-3406-8b47-416a626eadda",
                        "glosses": [
                            "in Chile und Argentinien heimischer Nadelbaum mit dreieckigen, spitzen Blättern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a59def69-38e8-4101-a617-9677dd6f1713",
                                "sense_id": "75b83823-2763-390a-b369-14433c59757d",
                                "text": "„Sehr hübsch liegt Villa Pehuenia am Ufer des Lago Aluminé. Der Ort ist nach den hier pehuen genannten Araukarienbäumen (oder Andentannen) benannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bb287c33-b777-4444-af67-2ff2d72bb664",
                        "source_entry_id": "d635a4a3-35d8-3406-8b47-416a626eadda",
                        "source_sense_id": "75b83823-2763-390a-b369-14433c59757d",
                        "source_sense_description": "in Chile und Argentinien heimischer Nadelbaum mit dreieckigen, spitzen Blättern",
                        "target_lang_word": "monkey puzzle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monkey puzzle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "845d3800-4883-3de1-8de6-c91f82c77ee5",
                                        "entry_id": "976c8a89-2964-3ef1-ad34-465eb9703063",
                                        "glosses": [
                                            "A large coniferous tree, Araucaria araucana, native to Chile."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e950d6fb-84dc-4ee3-8f02-b1e4f13b75af",
                                                "sense_id": "845d3800-4883-3de1-8de6-c91f82c77ee5",
                                                "text": "They could see the small stone house where she used to live, with a monkey puzzle in front of it like a moustache."
                                            },
                                            {
                                                "example_id": "d5793cb6-54c7-4788-a65f-6de1ad98bb4c",
                                                "sense_id": "845d3800-4883-3de1-8de6-c91f82c77ee5",
                                                "text": "Even those, such as the vicar, who might by education have been supposed to put a less superstitious valuation upon her character and who were too tolerant to believe ill of the stage profession in itself and in the proper place, could not believe its transplantation into a village to be right or desirable. His sense of the fitness of things was as outraged as if a parishioner had suggested planting a monkey-puzzle over a mother's grave."
                                            },
                                            {
                                                "example_id": "c53dee18-4950-45d7-849a-5a75ef16e43d",
                                                "sense_id": "845d3800-4883-3de1-8de6-c91f82c77ee5",
                                                "text": "Harry had always wanted a cedar tree on the lawn, as there had been in his old home, but had done the best he could by planting a monkey-puzzle, which was said to be quicker growing."
                                            },
                                            {
                                                "example_id": "802ec689-7241-403e-9039-526e57f0e9ce",
                                                "sense_id": "845d3800-4883-3de1-8de6-c91f82c77ee5",
                                                "text": "While I am planting a monkey puzzle in the front garden in his memory, an old man stops and tells me he remembers, in his wild far-off youth, climbing a monkey puzzle for a bet – 'A great tall thing' – and being lacerated to pieces by the spikes."
                                            },
                                            {
                                                "example_id": "9a9546f0-4da2-43de-a112-d43dacad32ec",
                                                "sense_id": "845d3800-4883-3de1-8de6-c91f82c77ee5",
                                                "text": "Two days later I took it to the former manse, a solid grey stately Victorian building with a tall monkey puzzle tree on the lawn."
                                            },
                                            {
                                                "example_id": "67f2dbf2-c7d6-4330-aac1-7d98845ab22d",
                                                "sense_id": "845d3800-4883-3de1-8de6-c91f82c77ee5",
                                                "text": "In the late afternoon, I went for a walk along a monkey puzzle-lined trail."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fa432cce-5ce4-4967-b3ee-fe405a9984aa",
