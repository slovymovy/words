                ],
                "senses": [
                    {
                        "sense_id": "baefed40-3fb4-3570-9d35-1c28b00ec10d",
                        "entry_id": "3a00cd7e-ead8-3f59-8526-d0aa8a0d411b",
                        "glosses": [
                            "zugeführte, impulsstarke Luftströmung, die sich mit der vorhanden Raumluft vermengt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75077ef3-c8dc-4a87-a2ae-b4d85be36ba1",
                                "sense_id": "baefed40-3fb4-3570-9d35-1c28b00ec10d",
                                "text": "„Die Mischlüftung zählt zu den ältesten und am häufigsten eingesetzten Luftführungsformen.“"
                            },
                            {
                                "example_id": "2b85e331-83ec-44f4-97ec-b92aeb4d1a93",
                                "sense_id": "baefed40-3fb4-3570-9d35-1c28b00ec10d",
                                "text": "„Bei der Mischlüftung wird einem Raum Luft mit verhältnismäßig hoher Geschwindigkeit außerhalb des Aufenthaltsbereiches, in der Regel von Wand oder Decke, zugeführt.“"
                            },
                            {
                                "example_id": "ed83eb9a-beb0-4034-8466-eb6a398d36d1",
                                "sense_id": "baefed40-3fb4-3570-9d35-1c28b00ec10d",
                                "text": "„Bei der turbulenten Mischlüftung, auch Verdünnungsströmung genannt, vermischt sich die in den Raum eintretende Zuluft mit der höher kontaminierten Raumluft durch Induktion (Mitreißen der Luft).“"
                            },
                            {
                                "example_id": "52abf902-aa46-4f52-af9f-6928c37e8c92",
                                "sense_id": "baefed40-3fb4-3570-9d35-1c28b00ec10d",
                                "text": "„Nachteilig bei der Mischlüftung sind die hohen Strömungsgeschwindigkeiten (Lärm, Zugluft) und die Turbulenzen, die zu starker Staubaufwirbelung führen.“"
                            },
                            {
                                "example_id": "de8c2374-7803-419d-929b-680f9d553ea5",
                                "sense_id": "baefed40-3fb4-3570-9d35-1c28b00ec10d",
                                "text": "„Zur lufttechnischen Behandlung von Produktionshallen mit großen Wärmelasten erweist sich die Mischlüftung in ihrer Anwendungsmöglichkeit als sehr begrenzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
