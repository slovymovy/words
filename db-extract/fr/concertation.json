        "fr-extract.jsonl": [
            {
                "entry_id": "50a11371-9f9f-3c99-a767-d5d13cb40e24",
                "word": "concertation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e1e79251-f094-4486-92ce-c875457e74e8",
                        "entry_id": "50a11371-9f9f-3c99-a767-d5d13cb40e24",
                        "tags": [
                            "plural"
                        ],
                        "form": "concertations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9854bc5a-4d54-343e-987c-ba124334dd9e",
                        "entry_id": "50a11371-9f9f-3c99-a767-d5d13cb40e24",
                        "glosses": [
                            "Processus de dialogue ou de consultation entre différent·es acteur·rices, visant à élaborer ou ajuster collectivement des décisions, en particulier dans le cadre de l’action publique."
                        ],
                        "tags": [
                            "Politiques publiques"
                        ],
                        "examples": [
                            {
                                "example_id": "41cc49fd-0e07-4325-a9ab-a076544dfffd",
                                "sense_id": "9854bc5a-4d54-343e-987c-ba124334dd9e",
                                "text": "Le ministre du Travail, Olivier Dussopt, a annoncé sur France 3 que la concertation sur la réforme de l’assurance-chômage, qui doit faire varier les indemnités versées en fonction de la conjoncture, sera ouverte « dans une dizaine de jours »."
                            },
                            {
                                "example_id": "a866cc90-2e8e-455b-a78f-4fd10e66e0db",
                                "sense_id": "9854bc5a-4d54-343e-987c-ba124334dd9e",
                                "text": "En 2005-2006, le gouvernement fédéral va poursuivre et intensifier sa politique de concertation avec les interlocuteurs sociaux en-dehors du cadre formel des accords interprofessionnels."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14474542-d85c-4a13-9c83-f3a41e53eecb",
                        "source_entry_id": "50a11371-9f9f-3c99-a767-d5d13cb40e24",
                        "source_sense_id": "9854bc5a-4d54-343e-987c-ba124334dd9e",
                        "target_lang_word": "dialogue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dialogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd6c242b-a7f5-34b6-b1d9-9fd79181bde2",
                                        "entry_id": "ea210ff7-08cf-3b93-8e7b-947c969e63db",
                                        "glosses": [
                                            "A conversation or other form of discourse between two or more individuals."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "96dd6b6d-b994-4d8a-a88a-abf40efd9bb8",
                                                "sense_id": "fd6c242b-a7f5-34b6-b1d9-9fd79181bde2",
                                                "text": "Melinda and Bill maintained a dialogue via email over the course of their long-distance relationship."
                                            },
                                            {
                                                "example_id": "f3dd3585-72c0-4724-934c-b49f60ed4fdc",
                                                "sense_id": "fd6c242b-a7f5-34b6-b1d9-9fd79181bde2",
                                                "text": "Start up a dialogue"
                                            },
                                            {
                                                "example_id": "71d2195d-2096-4fd7-b538-3d8db83b2b59",
                                                "sense_id": "fd6c242b-a7f5-34b6-b1d9-9fd79181bde2",
                                                "text": "Guido and Francesca exchanged looks; for the attention with which both had listened had enabled them to comprehend with tolerable accuracy the preceding dialogue."
                                            },
                                            {
                                                "example_id": "9d62c7cc-51c7-4768-a7b2-92189b27f3fa",
                                                "sense_id": "fd6c242b-a7f5-34b6-b1d9-9fd79181bde2",
                                                "text": "The hours of dialogue with Winfrey, which culminated in a choked-up moment on Friday night as he discussed the impact of his cheating on his family, appear to have failed to give Armstrong the redemption that he craves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "954ef915-c56f-3991-bd90-c9b242b5e643",
                                        "entry_id": "ea210ff7-08cf-3b93-8e7b-947c969e63db",
                                        "glosses": [
                                            "In a dramatic or literary presentation, the verbal parts of the script or text; the verbalizations of the actors or characters."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70402edc-d2ba-4323-94ee-c2b4d6dabf37",
                                                "sense_id": "954ef915-c56f-3991-bd90-c9b242b5e643",
                                                "text": "The movie had great special effects, but the dialogue was lackluster."
                                            },
                                            {
                                                "example_id": "8dac9984-09ca-4f51-a72f-dfe67d09a9ce",
                                                "sense_id": "954ef915-c56f-3991-bd90-c9b242b5e643",
                                                "text": "In 1936, Anstey had co-directed Housing Problems, which featured direct dialogue recording - allowing the subjects of the film to speak for themselves. As Anstey said: \"At the time nobody had done it, and we gave slum dwellers a chance to make their own films.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7f052d5-35d1-38a8-b1fd-811519ea0695",
                                        "entry_id": "ea210ff7-08cf-3b93-8e7b-947c969e63db",
                                        "glosses": [
                                            "A literary form, where the presentation resembles a conversation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b3bce05-9e3d-49cb-89ee-c58ca6025c36",
                                                "sense_id": "e7f052d5-35d1-38a8-b1fd-811519ea0695",
                                                "text": "A literary historian, she specialized in the dialogues of ancient Greek philosophers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b910b887-e05d-39a3-af82-f30f8b01689b",
                                        "entry_id": "ea210ff7-08cf-3b93-8e7b-947c969e63db",
                                        "glosses": [
                                            "Nonstandard form of dialog (“dialog box”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "countable",
                                            "nonstandard",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c252831-d231-47ba-bca1-60e4a4079dba",
                                                "sense_id": "b910b887-e05d-39a3-af82-f30f8b01689b",
                                                "text": "Once the My Computer dialogue opens, select Local Disk (C:), then right click and scroll down."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dialogue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "144b54ab-3345-3812-95f0-d2007073024c",
                                        "entry_id": "2640d573-91e1-3bce-b88c-200d404b409b",
                                        "glosses": [
                                            "To discuss or negotiate so that all parties can reach an understanding."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "496aef3f-660c-400e-b6f6-72ab6c363899",
                                                "sense_id": "144b54ab-3345-3812-95f0-d2007073024c",
                                                "text": "Pearson wanted to dialogue with his overseas counterparts about the new reporting requirements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04ba5894-e202-3971-9b0a-02aea263edca",
                                        "entry_id": "2640d573-91e1-3bce-b88c-200d404b409b",
                                        "glosses": [
                                            "To put into dialogue form."
                                        ],
                                        "tags": [
