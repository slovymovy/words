                    "frequency": "High",
                    "semantic_group_id": "tromperie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a préféré <w>mentir</w> à ses parents plutôt que d'avouer sa mauvaise note."
                        },
                        {
                            "text": "Je sais qu'elle <w>ment</w> quand elle évite de me regarder dans les yeux."
                        }
                    ],
                    "synonyms": [
                        "mythoner",
                        "mythonner",
                        "raconter des cracks",
                        "raconter des histoires",
                        "raconter des salades"
                    ],
                    "common_phrases": [
                        "mentir par omission",
                        "sans mentir"
                    ]
                },
                {
                    "sense_id": "c51f5526-ac21-3d4d-902b-bacfe566ed38",
                    "sense_definition": "Se persuader soi-même d'une chose que l'on sait pertinemment être fausse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "illusion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il ne sert à rien de se <w>mentir</w>, la situation financière est devenue très critique."
                        },
                        {
                            "text": "Elle continue de se <w>mentir</w> en espérant qu'il changera de comportement avec le temps."
                        }
                    ],
                    "common_phrases": [
