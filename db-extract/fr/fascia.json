                                    {
                                        "sense_id": "f0516085-6df0-362d-8a43-b5a5ed60b848",
                                        "entry_id": "3dd73481-c72f-3fb7-bccf-b1c460774bbe",
                                        "glosses": [
                                            "The layer of loose tissue, often containing fat, immediately beneath the skin; the stronger layer of connective tissue covering and investing muscles and organs; an aponeurosis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3ece2aa-bd90-4e36-bfe4-85f64a85cb2c",
                                                "sense_id": "f0516085-6df0-362d-8a43-b5a5ed60b848",
                                                "text": "The deepest layer of cervical fascia consists of two main subdivisions: the alar and prevertebral fasciae."
                                            },
                                            {
                                                "example_id": "07bb0c43-bab6-478e-98f9-32a937f25c6e",
                                                "sense_id": "f0516085-6df0-362d-8a43-b5a5ed60b848",
                                                "text": "Close-up of the fascia surrounding a muscle in an unembalmed cadaver."
                                            },
                                            {
                                                "example_id": "1990eb19-7697-4690-9d2a-a9fb1e076075",
                                                "sense_id": "f0516085-6df0-362d-8a43-b5a5ed60b848",
                                                "text": "2017, Andrea Pasini, Antonio Stecco, Carla Stecco, 19: Fascial Anatomy of the Viscera, Torsten Liem, Paolo Tozzi, Anthony Chila (editors), Fascia in the Osteopathic Field, Handspring Publishing, page 173,\nThis is evidence that the insertional fasciae are the ones that provide the connections between internal fasciae and muscular fascia, and between the different organs. The same pattern can be applied to the fasciae that surround the glands."
                                            },
                                            {
                                                "example_id": "6e4c793e-7594-493a-a093-d20e264ba423",
                                                "sense_id": "f0516085-6df0-362d-8a43-b5a5ed60b848",
                                                "text": "The superficial fascia surrounds the body and includes subcutaneous fat; the deep fascia surrounds the musculoskeletal system; the meningeal fascia surrounds the nervous system; the visceral fascia surrounds body cavities and organs."
                                            }
                                        ]
                                    },
                                    {
