                "senses": [
                    {
                        "sense_id": "31cf9d20-c3f3-3aab-90e8-8d6b06ad42b9",
                        "entry_id": "469c0c18-9755-3a09-994a-70471ba8c0c3",
                        "glosses": [
                            "Défaire une partie d’un travail de broderie précédemment effectué, à la suite d'une erreur."
                        ],
                        "tags": [
                            "Broderie"
                        ],
                        "examples": [
                            {
                                "example_id": "26b8b49c-f43c-4a5b-94c5-045072fced30",
                                "sense_id": "31cf9d20-c3f3-3aab-90e8-8d6b06ad42b9",
                                "text": "Pénéloper, verbe bien connu des brodeuses ! Et je dois dire qu’en ce moment , j’excelle en la matière !!!"
                            },
                            {
                                "example_id": "207e31f0-a7b8-4e8c-a235-4257e7c54b0e",
                                "sense_id": "31cf9d20-c3f3-3aab-90e8-8d6b06ad42b9",
                                "text": "Pourtant c’est sur ce modèle assez simple que j'ai pénélopé comme cela ne m’était pas arrivé depuis longtemps!"
                            },
                            {
                                "example_id": "821972bf-19e4-43c7-a880-b498f884e19c",
                                "sense_id": "31cf9d20-c3f3-3aab-90e8-8d6b06ad42b9",
                                "text": "Après avoir pénélopé mon erreur de centrage et refais, je continue la suite de la broderie."
                            }
                        ]
                    }
                ],
