                    "synonyms": [
                        "dine",
                        "chow down"
                    ],
                    "common_phrases": [
                        "eat out",
                        "ready to eat",
                        "time to eat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Принимать пищу в рамках трапезы (завтрак, обед, ужин)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "есть",
                                "target_lang_sense_clarification": "обедать, ужинать и т.д."
                            },
                            {
                                "target_lang_word": "поесть",
                                "target_lang_sense_clarification": "совершить прием пищи"
