                                    {
                                        "sense_id": "7d79768d-3cdd-358d-a317-ea905edf783c",
                                        "entry_id": "bb259c1f-feab-3a1d-bc13-6db8fd81a4db",
                                        "glosses": [
                                            "Sharp, barbed; not dull."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20f9b8a2-00da-4739-8db5-068076e1e043",
                                                "sense_id": "7d79768d-3cdd-358d-a317-ea905edf783c",
                                                "text": "The warrior brandished a pointed spear."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3692a9f8-3810-343e-9047-e667d91b9611",
                                        "entry_id": "bb259c1f-feab-3a1d-bc13-6db8fd81a4db",
                                        "glosses": [
                                            "Having a certain amount of points."
                                        ],
                                        "tags": [
                                            "in-compounds"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc47772-2b30-4805-b5da-20fb1ab180db",
                                                "sense_id": "3692a9f8-3810-343e-9047-e667d91b9611",
                                                "text": "a five-pointed star"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ce29c2c-03c2-3f31-8ca6-614f57c7b9fb",
                                        "entry_id": "bb259c1f-feab-3a1d-bc13-6db8fd81a4db",
                                        "glosses": [
                                            "Having a relevance to the matter at hand: pertinent, relevant."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51ed0aa3-d39b-3743-9753-86a65fd3b359",
                                        "entry_id": "bb259c1f-feab-3a1d-bc13-6db8fd81a4db",
                                        "glosses": [
                                            "In animals, having a coat pattern with points, that is, darkening of the extremities."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa6b9df3-7cdd-4fd2-a8d0-76c8497dd242",
                                                "sense_id": "51ed0aa3-d39b-3743-9753-86a65fd3b359",
                                                "text": "The Siamese is a pointed breed of cat."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "549f87da-509d-3f74-9fc5-577a99a1e720",
                                        "entry_id": "bb259c1f-feab-3a1d-bc13-6db8fd81a4db",
                                        "glosses": [
                                            "Directed negatively at a person or topic."
                                        ],
                                        "tags": [
                                            "comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "02e690b0-f0ad-494a-afd7-1b5e869f8216",
                                                "sense_id": "549f87da-509d-3f74-9fc5-577a99a1e720",
                                                "text": "Attention has been called to the report in a New-York paper, which has been made the subject of pointed comment […]"
                                            },
                                            {
                                                "example_id": "03c23eb5-875e-4a49-aa37-0d4843a154bb",
                                                "sense_id": "549f87da-509d-3f74-9fc5-577a99a1e720",
                                                "text": "After a harsh police crackdown last week fueled anger and swelled protests, President Dilma Rousseff, a former guerrilla who was imprisoned under the dictatorship and has now become the target of pointed criticism herself, tried to appease dissenters by embracing their cause on Tuesday."
                                            },
                                            {
                                                "example_id": "0f2457dc-af56-4721-b90b-022a007fbad0",
                                                "sense_id": "549f87da-509d-3f74-9fc5-577a99a1e720",
                                                "text": "President Taft to-day had a pointed comment for the \"new nationalism\" that his predecessor has been launching in the West."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e0ff723-433c-39ec-a09e-7e28f11c487f",
                                        "entry_id": "bb259c1f-feab-3a1d-bc13-6db8fd81a4db",
                                        "glosses": [
                                            "That has a named, but otherwise arbitrary, point (called the basepoint) that remains unchanged during subsequent discussion and is kept track of during all operations."
                                        ],
                                        "tags": [
                                            "of a topological space"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a380d9b6-8b7a-47e6-b615-d4ab056d6330",
                                                "sense_id": "2e0ff723-433c-39ec-a09e-7e28f11c487f",
                                                "text": "The class of all pointed spaces forms a category - Top_• - with basepoint preserving continuous maps as morphisms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b3345f-26b9-33e1-94ab-a79659a5d07e",
                                        "entry_id": "bb259c1f-feab-3a1d-bc13-6db8fd81a4db",
                                        "glosses": [
                                            "precise, on the dot."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "525d5907-51f2-4a99-ba94-00d0dea3a841",
                                                "sense_id": "a2b3345f-26b9-33e1-94ab-a79659a5d07e",
                                                "text": "With their usual punctuality, the boys arrive at the pointed hour of three."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
