                        "entry_id": "c0f173fe-2222-3434-a499-1fde0fd057a4",
                        "glosses": [
                            "verkehrstechnische Absicherungen von Bahnübergängen für Fußgänger oder auch für Fahrzeuge aller Art"
                        ],
                        "tags": [
                            "Verkehrswesen"
                        ],
                        "examples": [
