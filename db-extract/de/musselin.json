                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Musselin"
                    },
                    {
                        "form_id": "19b8afa8-14ed-4d7d-b84b-f3dfd98f0bf3",
                        "entry_id": "20c285a5-5783-38da-b399-253a8b8583df",
                        "tags": [
                            "accusative",
