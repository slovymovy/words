                        "examples": [
                            {
                                "example_id": "be97a718-da01-4041-a63e-895439d3413f",
                                "sense_id": "0e021b48-8aab-3a9e-ac10-cd9df1531d18",
                                "text": "Die kleine Detlefsen wird auch schon flügge."
                            },
                            {
                                "example_id": "8fa85a6e-1d9f-4ec1-8980-40e8836dfcdf",
                                "sense_id": "0e021b48-8aab-3a9e-ac10-cd9df1531d18",
                                "text": "Bei den Detlefsens geht es in letzter Zeit drunter und drüber."
                            },
                            {
                                "example_id": "a97592a8-51a3-4f67-a45b-424afd929348",
                                "sense_id": "0e021b48-8aab-3a9e-ac10-cd9df1531d18",
                                "text": "Die alte Frau Detlefsen sitzt gerne an der Schlei."
                            },
                            {
                                "example_id": "43aa2d40-d19d-43d1-a749-ad42f70530e0",
                                "sense_id": "0e021b48-8aab-3a9e-ac10-cd9df1531d18",
                                "text": "Während der Sommermonate sollen wir uns um den Gartenteich des Herrn Detlefsen kümmern."
                            }
                        ],
