                        "source_sense_id": "c1b868ba-5f8f-371a-9e43-a7d0b5dca9fa",
                        "target_lang_word": "adulateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "adulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                        "entry_id": "7b2897f0-e33a-3166-81de-d17f662b395f",
                                        "glosses": [
                                            "Celui qui adule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d19df7c8-80f9-4427-9bed-c70c751ac7ec",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "Lâche, vil adulateur."
                                            },
                                            {
                                                "example_id": "b3e950ad-f470-42e5-baa8-4bc4d2632498",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "Les adulateurs ont perdu ce prince."
                                            },
                                            {
                                                "example_id": "1a3acfaf-e572-422c-aea8-744dd8e4de9f",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "C’est un perpétuel adulateur."
                                            },
                                            {
                                                "example_id": "e929ae80-88ca-4d75-9b5e-ae57bb37bba0",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "C’est une grande adulatrice."
                                            },
                                            {
                                                "example_id": "46d75ffd-5f64-4f56-9d92-ae8098aaa452",
                                                "sense_id": "29508038-de4f-39cb-b0c5-ac0929afc0d3",
                                                "text": "Ses sentiments à l’endroit de l’empereur ne sont nullement ceux d’un adulateur."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "adulateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "efa3ca32-5e17-312c-a779-9408d7e2c602",
                                        "entry_id": "aa042a69-9b9e-3970-b28b-c42815c51cbd",
                                        "glosses": [
                                            "Qui adule."
                                        ],
                                        "tags": [
                                            "formal",
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fcba0db-3705-4635-810e-6a835881b3a2",
                                                "sense_id": "efa3ca32-5e17-312c-a779-9408d7e2c602",
                                                "text": "Langage adulateur."
                                            },
                                            {
                                                "example_id": "e9b28385-0ee6-42ad-80f1-b3e92b380b7c",
                                                "sense_id": "efa3ca32-5e17-312c-a779-9408d7e2c602",
                                                "text": "Vers adulateurs."
                                            },
                                            {
                                                "example_id": "a4b4374a-5c2b-4df8-add8-1e6891d9f05d",
                                                "sense_id": "efa3ca32-5e17-312c-a779-9408d7e2c602",
                                                "text": "Au reste, personne n'est assez adulateur pour excuser cette prostitution d'ennoblissements, de titres, de cordons, de places académiques, de grades militaires qui s'aggrave chaque jour."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1e7d46eb-78f1-46ce-aea5-1ee006e8872b",
                        "source_entry_id": "ddb32cd1-addb-3512-be30-a4da7093ce10",
                        "source_sense_id": "c1b868ba-5f8f-371a-9e43-a7d0b5dca9fa",
                        "target_lang_word": "flatteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flatteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a3ae5c02-b882-3405-b43f-17e129998db0",
                                        "entry_id": "26cb076e-2c4e-337d-afaf-ab9752f3c02a",
                                        "glosses": [
                                            "Qui flatte, qui loue avec exagération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0f18382-542f-4b09-9f66-d421c73201d2",
                                                "sense_id": "a3ae5c02-b882-3405-b43f-17e129998db0",
                                                "text": "Sans la liberté de blâmer, il n’est point d’éloge flatteur."
                                            },
                                            {
                                                "example_id": "558f7c5a-6884-46f8-bca2-92923744a458",
                                                "sense_id": "a3ae5c02-b882-3405-b43f-17e129998db0",
                                                "text": "Un miroir flatteur est un miroir où l’on se voit plus beau qu’on n’est"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6d4767f-d578-3351-88c1-25901a6a7c0d",
                                        "entry_id": "26cb076e-2c4e-337d-afaf-ab9752f3c02a",
                                        "glosses": [
                                            "Qui témoigne l’approbation, la louange, la faveur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "863a8d7d-5f7e-45e5-b155-830043cc1a95",
                                                "sense_id": "b6d4767f-d578-3351-88c1-25901a6a7c0d",
                                                "text": "L’anecdote est flatteuse pour la gloire de Raschi. Il ne lui manque que d'être vraie, […]."
                                            },
                                            {
                                                "example_id": "782bab17-1e34-4def-a01a-6fb0831baed8",
                                                "sense_id": "b6d4767f-d578-3351-88c1-25901a6a7c0d",
                                                "text": "Avoir les manières flatteuses, c’est avoir les manières douces et insinuantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d05be9a-5a87-36ac-9800-5934b0508077",
                                        "entry_id": "26cb076e-2c4e-337d-afaf-ab9752f3c02a",
                                        "glosses": [
                                            "Qui est agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea05fd4-256b-43a7-935f-f998134e73a6",
                                                "sense_id": "6d05be9a-5a87-36ac-9800-5934b0508077",
                                                "text": "[…], il fit une seconde halte pour lire ces mots : À la Belle-Étoile, écrits en légende sous une peinture qui représentait le simulacre le plus flatteur pour un voyageur affamé : c’était une volaille rôtissant au milieu d’un ciel noir, […]."
                                            },
                                            {
                                                "example_id": "426035b4-6dbf-4ef6-bf97-960f8b8d8876",
                                                "sense_id": "6d05be9a-5a87-36ac-9800-5934b0508077",
                                                "text": "Le lissage après peignage donne une apparence plus flatteuse à la laine."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flatteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7f29466d-0c47-30cb-a4a1-d574f9c59c7b",
                                        "entry_id": "ed86fbae-7d7b-3ecd-9fb0-e961d58cf2be",
                                        "glosses": [
                                            "Celui qui flatte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1acace7a-49e6-4325-8e41-b2316608fc9e",
                                                "sense_id": "7f29466d-0c47-30cb-a4a1-d574f9c59c7b",
                                                "text": "Car les princes n’ont d’autre moyen d’écarter les flatteurs, que de montrer que la vérité ne peut les offenser ; […]."
                                            },
                                            {
                                                "example_id": "2ae6efd7-0c13-429a-a31a-26056c33073a",
                                                "sense_id": "7f29466d-0c47-30cb-a4a1-d574f9c59c7b",
                                                "text": "D’obséquieux flatteurs le comparaient au prince Noir,à Alcibiade, à César."
                                            },
                                            {
                                                "example_id": "67cade9b-b341-4aa9-9440-8bb8e82b6643",
                                                "sense_id": "7f29466d-0c47-30cb-a4a1-d574f9c59c7b",
                                                "text": "Taisez-vous, flatteur !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
