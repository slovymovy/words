                "senses": [
                    {
                        "sense_id": "b5670d08-5540-3909-8d40-4548c88b9230",
                        "entry_id": "410b0656-b6b2-349a-a041-9011136cf11e",
                        "glosses": [
                            "Anhänger der philosophischen Lehre des altgriechischen Philosophen Pythagoras von Samos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "387ae3b4-3649-4b5d-8c10-fc6d1a2fd217",
                                "sense_id": "b5670d08-5540-3909-8d40-4548c88b9230",
                                "text": "„Um 389/388 unternahm Platon seine erste Sizilienreise. Zunächst fuhr er nach Unteritalien, wo im 5. Jahrhundert die Philosophengemeinschaft der Pythagoreer großen Einfluss erlangt hatte, dann aber in blutigen Unruhen stark geschwächt worden war.“"
                            },
                            {
                                "example_id": "dc83c17b-5a66-4a55-b823-90c7536f4001",
                                "sense_id": "b5670d08-5540-3909-8d40-4548c88b9230",
                                "text": "„Die Pythagoreer waren davon überzeugt, daß der Weltschöpfer die Welt nach einem geometrischen Muster entworfen und mittels Zahlen geordnet hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf1dbb61-1d35-46db-baaa-63971a2490ee",
                        "source_entry_id": "410b0656-b6b2-349a-a041-9011136cf11e",
                        "source_sense_id": "b5670d08-5540-3909-8d40-4548c88b9230",
                        "source_sense_description": "Anhänger der philosophischen Lehre des altgriechischen Philosophen Pythagoras von Samos",
                        "target_lang_word": "Pythagorean",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pythagorean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80e04456-b677-31df-b8dd-723e2b5927f5",
                                        "entry_id": "fac4abfd-c2b6-34db-b361-18c891226829",
                                        "glosses": [
                                            "A follower of Pythagoras; someone who believes in or advocates Pythagoreanism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4fe23995-931b-40c9-b65b-fe3ba6850bb3",
                                                "sense_id": "80e04456-b677-31df-b8dd-723e2b5927f5",
                                                "text": "Plato could still speak the language of archaic myth. He could speak it, because he was a Pythagorean, and myth was their technical language."
                                            },
                                            {
                                                "example_id": "123fefaa-75e7-488d-921c-3fc1adb81cd3",
                                                "sense_id": "80e04456-b677-31df-b8dd-723e2b5927f5",
                                                "text": "Plato clearly distinguished the Orphics and the Pythagoreans."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Pythagorean",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8f08391-7642-38a8-a0a1-16b01bfbadbf",
                                        "entry_id": "36f68354-2a34-3908-a952-f413e4c4a85b",
                                        "glosses": [
                                            "Pertaining to Pythagoras or his philosophy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "39f4dcce-d596-30d8-b288-b32d7453ac39",
                                        "entry_id": "36f68354-2a34-3908-a952-f413e4c4a85b",
                                        "glosses": [
                                            "Following the lifestyle advocated by the Pythagoreans; specifically, vegetarian."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "390d3bd9-8034-48e9-aeb8-52d8fe77f473",
                        "source_entry_id": "410b0656-b6b2-349a-a041-9011136cf11e",
                        "source_sense_id": "b5670d08-5540-3909-8d40-4548c88b9230",
                        "source_sense_description": "Anhänger der philosophischen Lehre des altgriechischen Philosophen Pythagoras von Samos",
                        "target_lang_word": "pythagoricien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pythagoricien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5ce29de0-ab5f-33ce-8c7a-25de6e119dda",
                                        "entry_id": "0a1b27d3-3483-360d-bd73-d196065c2690",
                                        "glosses": [
                                            "Relatif à Pythagore."
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df7a59f2-239a-41d0-ac3f-46bd64a2a44e",
                                                "sense_id": "5ce29de0-ab5f-33ce-8c7a-25de6e119dda",
                                                "text": "Ceux qui se réclament de lui, en effet, suivent un mode de vie qu’ils appellent pythagoricien, et ce fait les rend manifestement différents aux yeux des autres."
                                            },
                                            {
                                                "example_id": "2c5a9e6f-e67c-4a59-afbd-bb74d56985df",
                                                "sense_id": "5ce29de0-ab5f-33ce-8c7a-25de6e119dda",
                                                "text": "Ce texte a fait l’objet d’une bibliographie considérable, et il a en particulier inspiré de nombreux mathématiciens et informaticiens qui ont été fascinés par l’idée qu’une méthode générale pour la génération des triplets pythagoriciens ait pu avoir été inventée plus de mille ans avant Pythagore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13cac36f-eaa5-3187-a28c-19fc516d31cb",
                                        "entry_id": "0a1b27d3-3483-360d-bd73-d196065c2690",
                                        "glosses": [
                                            "Qui appartient à une école de philosophes géomètres, dont Pythagore était le chef."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59001ae-d7d5-430c-9d14-6b2f8cda0708",
                                                "sense_id": "13cac36f-eaa5-3187-a28c-19fc516d31cb",
                                                "text": "historiens plus curieux et plus méthodiques de reconstituer l'histoire pythagoricienne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b509e771-d592-3f94-8f27-da4676f249b4",
                                        "entry_id": "0a1b27d3-3483-360d-bd73-d196065c2690",
                                        "glosses": [
                                            "Qui a rapport à l’école de Pythagore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46307177-96eb-41c2-8d88-c1a2c8b90c4f",
                                                "sense_id": "b509e771-d592-3f94-8f27-da4676f249b4",
                                                "text": "Diodore de Sicile a confondu l’opinion que les gaulois avoient d’une autre vie avec la métempsychose égyptienne & pythagoricienne […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pythagoricien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0375f2eb-0394-30a4-a01b-d03e463f8b5d",
                                        "entry_id": "49ee3f52-801f-3a68-b591-858dfe67c92d",
                                        "glosses": [
                                            "Membre de l’école philosophique de Pythagore."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e1176caf-ffca-4b55-affd-b70775a00a7d",
                                                "sense_id": "0375f2eb-0394-30a4-a01b-d03e463f8b5d",
                                                "text": "J’en conclus que les dieux ont eu raison de faire périr dans un naufrage le pythagoricien coupable d’avoir divulgué la découverte des incommensurables."
                                            },
                                            {
                                                "example_id": "5aa863bb-2eeb-4a92-91f8-795cc26827bd",
                                                "sense_id": "0375f2eb-0394-30a4-a01b-d03e463f8b5d",
                                                "text": "Les druides gaulois ont un rôle social assez similaire à celui des pythagoriciens de la Grande Grèce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
