        "fr-extract.jsonl": [
            {
                "entry_id": "85b32eb5-ab34-3086-a89c-ec1b61b70b3e",
                "word": "échine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d65ec49a-94c7-42c5-8384-cd28b13f65c3",
                        "entry_id": "85b32eb5-ab34-3086-a89c-ec1b61b70b3e",
                        "tags": [
                            "plural"
                        ],
                        "form": "échines"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5cf94657-bd74-395d-8cfb-8afcec956449",
                        "entry_id": "85b32eb5-ab34-3086-a89c-ec1b61b70b3e",
                        "glosses": [
                            "Partie du dos de l’homme ou de certains animaux, en forme d’épine, qui va de la nuque au coccyx."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caf40a65-f394-44ea-849f-4c201245a93c",
                                "sense_id": "5cf94657-bd74-395d-8cfb-8afcec956449",
                                "text": "Il entre, souriant, l’échine basse, frétille autour de vous, vous appelle « cher maître », et ne s’en ira pas sans emporter votre dernier livre. Rien que le dernier !"
                            },
                            {
                                "example_id": "6a64989d-7621-49e6-be89-76f4e2db848d",
                                "sense_id": "5cf94657-bd74-395d-8cfb-8afcec956449",
                                "text": "« Gardes ! Au Roi ! » cria Philippe le Bel.\nSa voix fit passer le froid dans l’échine des assistants, et se répercuta, insolite, terrible, à travers le château et la nuit."
                            },
                            {
                                "example_id": "454c171b-f2ad-497f-aa20-3442ae6158ff",
                                "sense_id": "5cf94657-bd74-395d-8cfb-8afcec956449",
                                "text": "Dans un coin de cette place, un tulipier s’accoude à une haute muraille hérissée de pointes de fer.\nAinsi les monstres marins ont l’échine armée d’une terrible défense."
                            },
                            {
                                "example_id": "4ef13803-4393-4faf-9017-bb280c48023d",
                                "sense_id": "5cf94657-bd74-395d-8cfb-8afcec956449",
                                "text": "Il sentait couler dans ses veines toute la sanie des rêves impuissants, des appétences infécondes, et sur son échine s'appesantissait le fardeau de la résignation et de la timidité."
                            },
                            {
                                "example_id": "3aa820e6-aab5-4c8c-a602-e554bb8dd876",
                                "sense_id": "5cf94657-bd74-395d-8cfb-8afcec956449",
                                "text": "Une douleur l’accable le long de l’échine."
                            }
                        ]
                    }
                ],
