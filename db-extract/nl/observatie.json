                    },
                    {
                        "sense_id": "1a5a993c-380e-3d50-9c9d-50f47e9ebb78",
                        "entry_id": "580de24f-a6cc-3526-a4c9-4fb1e9b2ace5",
                        "glosses": [
                            "wat men met de zintuigen kan waarnemen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1cdaa82e-f063-40e5-a05a-0284410e18ff",
                                "sense_id": "1a5a993c-380e-3d50-9c9d-50f47e9ebb78",
                                "text": "Hij was vijfenzestig geworden, dan was het niet langer gepast. Dat nam niet weg dat het een observatie was die niet te vermijden viel, en wat hij bij zichzelf in zijn zolderkamer dacht kon niemand schaden of in verlegenheid brengen."
                            }
                        ]
                    },
                    {
                        "sense_id": "cfc4f492-c78d-3b27-bfc9-17e8480522aa",
                        "entry_id": "580de24f-a6cc-3526-a4c9-4fb1e9b2ace5",
                        "glosses": [
                            "constatering, opmerking"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a4d2cad-73e7-4ed8-beba-c23245435531",
                        "source_entry_id": "580de24f-a6cc-3526-a4c9-4fb1e9b2ace5",
                        "source_sense_id": "92245e25-8d95-351b-a87a-a6448e505640",
                        "source_sense_description": "waarneming",
                        "target_lang_word": "observation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "observation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3abf0ab0-1e3e-3c02-a162-2874166c18a0",
                                        "entry_id": "43e28c9b-4700-344b-b0cb-3a5098c3fa31",
                                        "glosses": [
                                            "The act of observing, and the fact of being observed (see observance)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f52adee-6dda-4a94-909c-82f610ccd29c",
                                                "sense_id": "3abf0ab0-1e3e-3c02-a162-2874166c18a0",
                                                "text": "But Miss Thorn relieved the situation by laughing aloud,[…]. We began to tell her about Mohair and the cotillon, and of our point of observation from the Florentine galleried porch, and she insisted she would join us there."
                                            },
                                            {
                                                "example_id": "b080237a-67f1-4b93-a1b4-1122d7d838e1",
                                                "sense_id": "3abf0ab0-1e3e-3c02-a162-2874166c18a0",
                                                "text": "The physics of elementary particles in the 20th century was distinguished by the observation of particles whose existence had been predicted by theorists sometimes decades earlier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50015863-b5ef-3d72-8870-fc2ecc2933ca",
                                        "entry_id": "43e28c9b-4700-344b-b0cb-3a5098c3fa31",
                                        "glosses": [
                                            "The act of noting and recording some event; or the record of such noting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "50c2fcca-12f9-38ad-90f5-2acf1ae9361e",
                                        "entry_id": "43e28c9b-4700-344b-b0cb-3a5098c3fa31",
                                        "glosses": [
                                            "A remark or comment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b35c001d-8c63-47dc-9a39-2b5be4419f02",
                                                "sense_id": "50c2fcca-12f9-38ad-90f5-2acf1ae9361e",
                                                "text": "That's a foolish observation."
                                            },
                                            {
                                                "example_id": "060e5205-9e5c-4893-91ae-3fe211cda038",
                                                "sense_id": "50c2fcca-12f9-38ad-90f5-2acf1ae9361e",
                                                "text": "To observations which ourselves we make / We grow more partial for the observer's sake."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14e7936c-204e-3177-ab50-6d5ab8134970",
                                        "entry_id": "43e28c9b-4700-344b-b0cb-3a5098c3fa31",
                                        "glosses": [
                                            "A judgement based on observing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c6e659a-9023-4f4f-90f8-f751f1b3ad3f",
                                                "sense_id": "14e7936c-204e-3177-ab50-6d5ab8134970",
                                                "text": "This hypothesis goes by many names, including group resistence, the threshold effect, and the gender paradox. Because the hypothesis holds such wide appeal, it is worth revisiting the logic behind it. The hypothesis is built on the factual observation that fewer females than males act antisocially."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80afc4dd-4ab2-3b83-952b-7c00b72f5b0c",
                                        "entry_id": "43e28c9b-4700-344b-b0cb-3a5098c3fa31",
                                        "glosses": [
                                            "Performance of what is prescribed; adherence in practice; observance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e37062b1-09f8-4aa9-9016-57a70ec9c3ca",
                                                "sense_id": "80afc4dd-4ab2-3b83-952b-7c00b72f5b0c",
                                                "text": "We are to procure dispensation or leave to omit the observation of it in such circumstances."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aae5d93-1ab9-3a7a-aba6-54c3006c6249",
                                        "entry_id": "43e28c9b-4700-344b-b0cb-3a5098c3fa31",
                                        "glosses": [
                                            "A regime under which a subject is routinely observed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10f368cb-b54d-353b-9f1f-1dbab5e783f7",
                                        "entry_id": "43e28c9b-4700-344b-b0cb-3a5098c3fa31",
                                        "glosses": [
                                            "A realization of a random variable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a56a5ff-617a-4371-be63-a07ea1cd8585",
                        "source_entry_id": "580de24f-a6cc-3526-a4c9-4fb1e9b2ace5",
                        "source_sense_id": "92245e25-8d95-351b-a87a-a6448e505640",
                        "source_sense_description": "waarneming",
                        "target_lang_word": "observation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "observation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4e8e8718-e433-3ac6-a97c-add68f66e426",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Action d’observer ce qui est prescrit par quelque loi ou ce que l’on a promis à quelqu’un."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e342e4-d5e6-43cd-9269-9016a8260a94",
                                                "sense_id": "4e8e8718-e433-3ac6-a97c-add68f66e426",
                                                "text": "L’observation des lois de la République."
                                            },
                                            {
                                                "example_id": "26ffbe77-117c-47aa-b56a-92001ada6976",
                                                "sense_id": "4e8e8718-e433-3ac6-a97c-add68f66e426",
                                                "text": "L’observation de sa parole, de sa promesse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d95fc383-4912-317c-a10f-6d6aca29f327",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Action de regarder avec attention, de surveiller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07260b7f-4fde-4c03-9e4d-20c5f0fedfeb",
                                                "sense_id": "d95fc383-4912-317c-a10f-6d6aca29f327",
                                                "text": "Voilà un excellent poste d’observation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4507c156-0971-3474-8e7c-fe56fdb942db",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Ce que l'on aperçoit ainsi."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c994e09-1799-42e5-a7cb-3e54ef913d9a",
                                                "sense_id": "4507c156-0971-3474-8e7c-fe56fdb942db",
                                                "text": "Fort des très nombreuses observations que j'ai recueillies (80 à l'heure actuelle), je récuse absolument la syphilis comme facteur de mongolisme."
                                            },
                                            {
                                                "example_id": "4b3c6465-40bd-4ed2-8677-cf2d7a19f2d8",
                                                "sense_id": "4507c156-0971-3474-8e7c-fe56fdb942db",
                                                "text": "Ce même soir (NDR : le 19 novembre), mais à 17 h 34, un habitant de Logny-Bogny, entre Rumigny et Signy-l’Abbaye, a vu un « point lumineux » allant lentement vers l'est. Cette observation pourrait correspondre au passage de la station spatiale internationale ISS « mais ça coince car les photos prises par le témoin avec son portable sont contradictoires avec la description de l'ISS », estime M. Lemaire […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88cb9700-34fd-3cb7-907e-1103cdc05ef8",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Surveillance attentive à laquelle on soumet des personnes ou des animaux en vue d'établir un diagnostic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7adeaa39-5120-4781-9dc9-4c7e6a90ab99",
                                                "sense_id": "88cb9700-34fd-3cb7-907e-1103cdc05ef8",
                                                "text": "Nous apprenons que Léon Bouché, le simple d’esprit qui est à l’origine de l’incendie qui a détruit un groupe de bâtiments au lieudit « Le Petit Ban » a été conduit à l’hôpital de Rethel où il a été mis en observation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcfe4140-26cb-30a4-83c7-bdc36b60791f",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Action de considérer avec attention, avec étude les choses physiques ou morales."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96fe1f45-7e4b-4ab8-b11a-143611003825",
                                                "sense_id": "dcfe4140-26cb-30a4-83c7-bdc36b60791f",
                                                "text": "À peu près en même temps que Bonnet faisait ses curieuses observations, les naturalistes découvraient d’autres phénomènes bien autrement inconciliables avec les idées qu’on regardait alors comme les fondemens de la science."
                                            },
                                            {
                                                "example_id": "00fe42cc-52fe-47c1-bc60-a5434d69df85",
                                                "sense_id": "dcfe4140-26cb-30a4-83c7-bdc36b60791f",
                                                "text": "Il procédait par l’observation, analysant et classant des faits (instantiæ Naturæ, comme on les désignait assez pédantesquement), et les transformant en lois générales."
                                            },
                                            {
                                                "example_id": "ace8d2d2-40bd-4e2b-8434-96b7293cd48a",
                                                "sense_id": "dcfe4140-26cb-30a4-83c7-bdc36b60791f",
                                                "text": "Enfin ne craignons pas de substituer à la science cabalistique ancienne, l’explication du monde par l’observation des phénomènes de la nature."
                                            },
                                            {
                                                "example_id": "b732b7a3-4b9c-4013-84ff-f8154d4fdfe7",
                                                "sense_id": "dcfe4140-26cb-30a4-83c7-bdc36b60791f",
                                                "text": "Si le principe de cette « sismologie stellaire », ou astérosismologie, est simple, sa mise en œuvre est un véritable défi, tant en termes d’observations que de modélisation théorique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c715ed58-8bde-37f9-8e05-df0a3499eb8d",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Résultat de ces études."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e4b18bb-5980-4e82-b3a2-d30d81232d53",
                                                "sense_id": "c715ed58-8bde-37f9-8e05-df0a3499eb8d",
                                                "text": "Quelques observations d’empoisonnement à la suite d’injections vaginales avec de l’eau de Goulard, de l'usage de collyres à base de plomb, montrent que l'absorption se fait par les diverses muqueuses."
                                            },
                                            {
                                                "example_id": "30f4f1e0-6332-4615-addf-633b9dd9f26f",
                                                "sense_id": "c715ed58-8bde-37f9-8e05-df0a3499eb8d",
                                                "text": "[…], et ce qui se passait ne coïncidait nullement avec nos observations journellement vérifiées."
                                            },
                                            {
                                                "example_id": "1992d708-d754-40cf-920f-73e05805fc05",
                                                "sense_id": "c715ed58-8bde-37f9-8e05-df0a3499eb8d",
                                                "text": "Pendant toute la nuit, je dus veiller attentivement, car mes observations m'avaient indiqué la proximité du rocher de Malpelo, […]."
                                            },
                                            {
                                                "example_id": "f398c30b-156b-4c8a-b239-4cf0c8c3f15e",
                                                "sense_id": "c715ed58-8bde-37f9-8e05-df0a3499eb8d",
                                                "text": "Parmi ces observations il en est que nous ne pourrons publier que lorsque les événements en cours, sans lesquels, d'ailleurs, nous n'eussions certainement pas vu l’embâcle de la Meuse, seront terminés."
                                            },
                                            {
                                                "example_id": "f79ac32f-9e72-461b-93e1-9b4d38398afc",
                                                "sense_id": "c715ed58-8bde-37f9-8e05-df0a3499eb8d",
                                                "text": "Les multirécidivistes sont paranos, ils connaissent le travail de la police et font des contre-observations. À chaque fois qu'ils tombent, ils analysent en détail le dossier judiciaire pour connaître ce qui leur a été fatal, apprenant de leurs maladresses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3168d4b7-090f-3880-acf6-d59627e2f214",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Remarques sur des écrits de quelque auteur."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c42a680-ad33-4e12-b11e-3d1273da4333",
                                                "sense_id": "3168d4b7-090f-3880-acf6-d59627e2f214",
                                                "text": "Observations sur la Rhétorique d’Aristote."
                                            },
                                            {
                                                "example_id": "467212b6-e56f-4302-a291-4c26c4d95d63",
                                                "sense_id": "3168d4b7-090f-3880-acf6-d59627e2f214",
                                                "text": "Il a publié cet auteur avec de savantes observations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22b7b90-fa6a-36eb-8772-7695a39549a5",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Réflexion, considération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6e62b80e-c816-42e9-a215-4aa119c34d05",
                                                "sense_id": "d22b7b90-fa6a-36eb-8772-7695a39549a5",
                                                "text": "Ils affirment aussi, sur nos observations, qu'elles n'ont pas non plus de pyramidon, ni de quinine."
                                            },
                                            {
                                                "example_id": "03378c1e-0dc0-4bcf-9511-d49214c8d4e8",
                                                "sense_id": "d22b7b90-fa6a-36eb-8772-7695a39549a5",
                                                "text": "Je demande à faire une observation, permettez que je fasse une 'observation'."
                                            },
                                            {
                                                "example_id": "872c93b0-33a8-40dc-a492-eabaf5262ec0",
                                                "sense_id": "d22b7b90-fa6a-36eb-8772-7695a39549a5",
                                                "text": "Avez-vous encore quelque observation à faire ?"
                                            },
                                            {
                                                "example_id": "688ee824-fbb6-4d5a-a2da-6a58a417d589",
                                                "sense_id": "d22b7b90-fa6a-36eb-8772-7695a39549a5",
                                                "text": "Votre observation me paraît juste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef6ce73f-f35f-3c50-8006-fd30b2e9fa39",
                                        "entry_id": "3f4332e8-9f9f-3e23-a850-58be79abfe59",
                                        "glosses": [
                                            "Remarque nuancée de reproche que l’on fait à quelqu’un sur sa manière d’agir, sur sa conduite."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d385433e-2d8e-4287-a048-13bd1b2cb935",
                                                "sense_id": "ef6ce73f-f35f-3c50-8006-fd30b2e9fa39",
                                                "text": "Faire des observations à un enfant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c8511a3f-709f-457c-9287-67424c7e0a44",
                        "source_entry_id": "580de24f-a6cc-3526-a4c9-4fb1e9b2ace5",
                        "source_sense_id": "92245e25-8d95-351b-a87a-a6448e505640",
                        "source_sense_description": "waarneming",
