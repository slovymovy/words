                        "glosses": [
                            "Zustand, Eigenschaft, sich verändern (modifizieren) lassen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c860fc10-2c50-471e-8bda-7237b4a600bf",
                                "sense_id": "fd8449e6-74f6-30dd-88aa-687f4d405142",
                                "text": "„Da dieses Grundprinzip für Startups anfangs allerdings nur auf ungetesteten Annahmen basiert, ist ein Modell erforderlich, welches eine hohe Anpassungsfähigkeit und eine leichte Modifizierbarkeit gewährleistet.“"
                            },
                            {
                                "example_id": "35964e96-cde5-44f7-a440-d66cef83ddce",
                                "sense_id": "fd8449e6-74f6-30dd-88aa-687f4d405142",
                                "text": "„Wenn Sie die Entwickler dazu befragen, können Sie ein Gespür für Aspekte der Analysierbarkeit und Modifizierbarkeit bekommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
