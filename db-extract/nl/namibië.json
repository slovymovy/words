                            {
                                "example_id": "6c2e9f83-3d12-4319-a0d1-315e139074f7",
                                "sense_id": "9481c33f-5e86-323d-9c4b-6d1426066719",
                                "text": "Ik weet niet meer wie, maar iemand uit onze familie woont in Namibië."
