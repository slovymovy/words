                        "examples": [
                            {
                                "example_id": "7b1db9bb-4401-48da-aef6-7dc9abcf43ba",
                                "sense_id": "2c5b17fa-0c7a-384c-8b94-b67332fae11e",
                                "text": "He had read of the wonderful success which attended the efforts of some of his countrymen who had emigrated to Australia, that arcadia of the agriculturist, and burning with a desire to seek his fortune in the new land of promise, he began to make inquiries of the place, its products, and of the possibilities of successful operations while there."
                            },
                            {
                                "example_id": "ba20f09e-e6b0-4f03-a907-ae02f7ea93c1",
                                "sense_id": "2c5b17fa-0c7a-384c-8b94-b67332fae11e",
                                "text": "No other development is visible, and the road is free of traffic--a path to freedom through a perfect arcadia."
                            }
                        ]
