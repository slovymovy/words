                        "entry_id": "61be627b-5bd5-3441-b972-b29a5e5fa601",
                        "glosses": [
                            "Spaanse mousserende wijn, vooral geproduceerd ten zuidwesten van Barcelona"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a46e0539-1fa2-4d65-932d-ca15ee7884c2",
                                "sense_id": "cff80490-1d45-36c4-859c-95a5f12884e5",
                                "text": "Elk zichzelf respecterend restaurant biedt vandaag een Spaanse cava, een witte of rode rioja, een majestueuze priorato of een krachtige ribera del duero aan."
                            }
                        ]
                    }
