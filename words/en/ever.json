                    "frequency": "VeryLow",
                    "semantic_group_id": "quantifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ever</w> place you look, there are new houses being built.",
                            "target_lang_translations": {
                                "ru": "В <w>каждом</w> месте, куда ни глянь, строятся новые дома."
                            }
