                                        "sense_id": "d4b494eb-c777-3fa6-a433-71a1005c4e18",
                                        "entry_id": "0fb255d0-c491-3853-a4ad-d51a3d42ea8b",
                                        "glosses": [
                                            "Of or relating to the years of early childhood before attendance at primary school."
                                        ],
                                        "tags": [
