                        ],
                        "form": "hypothalami"
                    },
                    {
                        "form_id": "1454638e-4569-475b-9973-206168fcba27",
                        "entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
                        "tags": [
                            "plural"
                        ],
                        "form": "hypothalamuses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                        "entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
                        "glosses": [
                            "A region of the forebrain located below the thalamus, forming the basal portion of the diencephalon, and functioning to regulate body temperature, some metabolic processes and governing the autonomic nervous system."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d24e1f8-a785-4b45-a9b6-fa6b3338152d",
                                "sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                                "text": "To avoid catastrophe, the brain has its trusty control centre, the hypothalamus, which tells the body to cool itself by sweating or to warm itself by shivering."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "690c4227-71b1-45ba-9863-a34033440aca",
                        "source_entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
                        "source_sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                        "source_sense_description": "a region of the brain, below the thalamus",
                        "target_lang_word": "hypothalamus",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d002c42c-f14a-4f4a-9092-16c12d13ff73",
                        "source_entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
                        "source_sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                        "source_sense_description": "a region of the brain, below the thalamus",
                        "target_lang_word": "podhrbolí",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "aaf41fe9-c6a4-4ff1-8010-486d4ee4aa97",
                        "source_entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
                        "source_sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                        "source_sense_description": "a region of the brain, below the thalamus",
                        "target_lang_word": "hypothalamus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypothalamus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                                        "entry_id": "0c308e6e-ce0b-3f81-83d6-a79a485b99a7",
                                        "glosses": [
                                            "deel van de hersenen dat een directe verbinding heeft met het hormonale systeem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8cff5df-8c59-4efe-b434-4bc8a2dc3153",
                                                "sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                                                "text": "De onderzoekers hebben acht muizen met in totaal tien foetussen ongeveer halverwege de zwangerschap 24 uur lang geen eten gegeven. Dat stadium van de zwangerschap is kritiek voor de ontwikkeling van de hypothalamus, die het autonome zenuwstelsel aanstuurt."
                                            },
                                            {
                                                "example_id": "39af7b4f-aa6f-42d6-b238-f6e13bb8333f",
                                                "sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                                                "text": "Als het orgasme plaatsvindt, piekt de activiteit in de hersenen. Dat gebeurt in de zogenaamde hypothalamus, wat een chemische 'explosie' veroorzaakt. Na het orgasme neemt de activiteit meteen af."
                                            },
                                            {
                                                "example_id": "4702e8db-0e17-471c-b0a7-5a8db26f1b09",
                                                "sense_id": "ddb4b11f-04d8-3f74-9004-964564d60bfc",
                                                "text": "Ook stimuleert alcohol de hypothalamus. Dit is een deel van de hersenen dat je slaapritme, lichaamstemperatuur en honger regelt. Wanneer de hypothalamus wordt gestimuleerd, krijgen we honger op momenten dat we helemaal geen honger hebben."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc7e7de2-51ca-4bb3-a260-b6524a60d068",
                        "source_entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
                        "source_sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                        "source_sense_description": "a region of the brain, below the thalamus",
                        "target_lang_word": "hypothalamus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypothalamus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9d71d4f1-abc6-3843-b35b-4c411b85bfd5",
                                        "entry_id": "c3a295c2-6c6c-363c-b469-f365c8f78437",
                                        "glosses": [
                                            "Région diencéphalique du cerveau qui intervient dans la régulation des fonctions endocrines, autonomes et comportementales (sexuelles, alimentaires, défensive, de stress, de thermorégulation, du cycle circadien)."
                                        ],
                                        "tags": [
                                            "Endocrinologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aab48720-5667-490d-98c9-bb86cfd2b898",
                                                "sense_id": "9d71d4f1-abc6-3843-b35b-4c411b85bfd5",
                                                "text": "L'hypothalamus constitue les parois inféro-latérales du IIIème ventricule sous le thalamus, de chaque côté, dont il est séparé par le sillon hypothalamique."
                                            },
                                            {
                                                "example_id": "66474622-c229-493e-8d34-cc5583254a18",
                                                "sense_id": "9d71d4f1-abc6-3843-b35b-4c411b85bfd5",
                                                "text": "Souvenez-vous, nous avons déjà traversé l’hypothalamus pour y repérer les boutons qui déclenchent le sommeil, l’éveil et le rêve."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e211b061-73c7-4537-a3d2-6de1db3128fd",
                        "source_entry_id": "3ac8ba65-2086-333c-814d-ea92292ece2a",
                        "source_sense_id": "d91d08b5-f9ae-30bc-8b47-7bc7291717ae",
                        "source_sense_description": "a region of the brain, below the thalamus",
                        "target_lang_word": "Hypothalamus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hypothalamus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                        "entry_id": "670944db-33a0-333b-b6ae-462e31e4c64a",
                                        "glosses": [
                                            "Teil des Zwischenhirns zur Steuerung der vegetativen Funktionen des Körpers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd494726-8356-4833-b67b-68b7fc927b9a",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Bislang gingen Forscher davon aus, dass eine spezialisierte Gehirnregion im so genannten Hypothalamus je nach Tageszeit bestimmte Gene ein- oder ausschaltet.“"
                                            },
                                            {
                                                "example_id": "a610f6d5-fd16-4030-9a65-1f1068635028",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Verspielte Katzen verwandelten sie von einem Augenblick zum andern durch Stimulierung ihres lateralen Hypothalamus in wilde Tiger und dann ebenso plötzlich wieder in schnurrende Kätzchen.“"
                                            },
                                            {
                                                "example_id": "0090e9ec-c9f1-4bb5-b76d-db4af28704d7",
                                                "sense_id": "032e1ddb-46db-3bfe-9b4b-4ea563c74760",
                                                "text": "„Sie legten den Tieren Elektroden an den Hypothalamus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
