                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b9b60f3-201f-469c-9c79-bd526af10ebe",
                                "sense_id": "8442bd28-2fb1-3ff6-8dd7-af635844d91c",
                                "text": "Zrzucenie bomby w jednym momencie spowodowało pogrom wśród wroga."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "9f610a64-9953-348e-93dd-0a99353a4058",
                        "entry_id": "197545f0-4e3b-3981-8eac-00e8dd1a3b20",
                        "glosses": [
                            "zadanie komuś klęski"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "ebb71a66-3ccb-473f-9ab6-fac25c1c59d8",
                                "sense_id": "9f610a64-9953-348e-93dd-0a99353a4058",
                                "text": "Nauczyciel zrobił wczoraj istny pogrom – na sprawdzianie połowa klasy dostała jedynki za ściąganie."
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
