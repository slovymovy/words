                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6429a68-ce6d-3b95-9b31-00d77257b098",
                                        "entry_id": "8bbb9cbe-2bbb-39c1-b560-98048bd91e53",
                                        "glosses": [
                                            "een snel vaartuig",
                                            "een pleziervaartuig"
                                        ],
                                        "tags": [
                                            "neuter"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48b5f646-d5d4-4f6c-9f1b-f041ddb5ad59",
                                                "sense_id": "c6429a68-ce6d-3b95-9b31-00d77257b098",
                                                "text": "Te Vlissingen lag er een jachtje bereid om naar Oost-Indië te varen.\n Op de voorplecht stond er een cupido die er speelde op zijn vergulde snaren."
                                            }
                                        ]
                                    }
                                ]
                            },
