                "senses": [
                    {
                        "sense_id": "a2bb7037-d29e-3a02-8c0f-c5b5ada7fef7",
                        "entry_id": "42f0aefe-2f2e-319a-9a1f-7813d65a7d74",
                        "glosses": [
                            "Obermenge der Wörter einer Sprache für Geruch; Sprachraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52939467-56ab-4331-8e3e-8b535280af6b",
                                "sense_id": "a2bb7037-d29e-3a02-8c0f-c5b5ada7fef7",
                                "text": "„Unser Geruchswortschatz ist auf einen Bruchteil dessen, was noch vor dem 18. Jahrhundert gebräuchlich war, zusammengeschrumpft.“"
                            },
                            {
                                "example_id": "578eff1e-7685-4848-bcae-e539ed45d114",
                                "sense_id": "a2bb7037-d29e-3a02-8c0f-c5b5ada7fef7",
                                "text": "„Auch für Deutschland ist belegt, daß sich \"spätestens seit dem 18. Jahrhundert der Geruchswortschatz, zumindest im Deutschen [, verringerte.] Von der Vielzahl der Wörter, die noch weit in die frühneuhochdeutsche Zeit hinein die verschiedenen Formen der Geruchsempfindungen beschrieben, sind in der Gegenwart nur noch etwa ein Viertel erhalten geblieben.\" (JÜTTE 2000, 229).“"
                            },
                            {
                                "example_id": "c2b1c3e8-0d7b-40bb-ad79-67284c2fbb3a",
                                "sense_id": "a2bb7037-d29e-3a02-8c0f-c5b5ada7fef7",
                                "text": "„Diese bedeutendere kulturelle und soziale Rolle der Gerüche manifestiert sich nun wiederum – man möchte fast sagen konsequenterweise – in einem, ebenfalls im Vergleich zu westlichen Kulturen, ausdifferenzierteren Geruchswortschatz, so hält etwa Howes (1987) fest […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b5f132be-5497-3688-a681-5c6bb49ac6f8",
                        "entry_id": "42f0aefe-2f2e-319a-9a1f-7813d65a7d74",
                        "glosses": [
                            "Untermenge an Wörter, die eine Person für Gerüche kennt; individuelles Sprachvermögen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf1e5b6-fe58-4575-902e-9572489d8b96",
                                "sense_id": "b5f132be-5497-3688-a681-5c6bb49ac6f8",
                                "text": "„Patrick Süskind hat einen extrem grossen Geruchswortschatz.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
