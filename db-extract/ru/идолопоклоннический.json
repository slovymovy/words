                    {
                        "translation_id": "6a86d750-5317-4773-8dc9-1e88039afb93",
                        "source_entry_id": "3191e95a-78c9-33ff-81a3-b3772c225d46",
                        "source_sense_id": "e18c3eab-9c1b-36b7-9005-9fc4506ba2dd",
                        "target_lang_word": "götzendienerisch",
