                "senses": [
                    {
                        "sense_id": "15634c3e-c58f-3bf5-b7a0-ba4aa0e07b7f",
                        "entry_id": "cee70181-7c93-3594-9fe2-f3d233b8b42e",
                        "glosses": [
                            "Articulation fixe de deux os."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a44fc995-33ef-433c-8e71-299ae85899ad",
                                "sense_id": "15634c3e-c58f-3bf5-b7a0-ba4aa0e07b7f",
                                "text": "La synarthrose, que quelques Anatomistes nomment articulation immobile, est une articulation dans laquelle deux os sont unis par une substance intermédiaire, qui ne leur permet aucun mouvement."
                            },
                            {
                                "example_id": "711f701c-bc3b-4e7b-bb55-f2a259021bcd",
                                "sense_id": "15634c3e-c58f-3bf5-b7a0-ba4aa0e07b7f",
                                "text": "Les synarthroses se rencontrent au crâne et à la face, la plupart revêtent la forme de sutures ; aussi suture est-il devenu à peu près synonyme de synarthrose."
                            }
                        ]
                    }
                ],
