                "senses": [
                    {
                        "sense_id": "bfe1b762-f273-34cd-adc8-ad1c9e4d141a",
                        "entry_id": "72860d6e-da27-30d7-9de0-1fef9a181590",
                        "glosses": [
                            "bewaffneter Konflikt, an welchem viele Länder beteiligt sind und dessen Kampfhandlungen sich über einen großen Teil der Erde erstrecken"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "3c45dea0-f7b3-4319-8eba-60ae20439b1b",
                                "sense_id": "bfe1b762-f273-34cd-adc8-ad1c9e4d141a",
                                "text": "Der Leiter eines unter Sophies Schirmherrschaft stehenden Jugendheims in der bosnischen Hauptstadt hat die Dramatik des Geschehens aus nächster Nähe miterlebt, das Anlass, nicht Ursache gewesen ist für den ersten Weltenbrand."
                            },
                            {
                                "example_id": "d637ba6c-21d6-4325-b990-0dae8f3e5e3b",
                                "sense_id": "bfe1b762-f273-34cd-adc8-ad1c9e4d141a",
                                "text": "„Dennoch bringt der Weltenbrand auch hier tiefgehende Umwälzungen mit sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "23fc54ae-7034-30b8-be26-4287e900439e",
                        "entry_id": "72860d6e-da27-30d7-9de0-1fef9a181590",
                        "glosses": [
                            "Vernichtung alles Bekannten in der nordisch-germanischen Mythologie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dca64f8-d2bc-4ea1-a392-9dcf46e10a84",
                                "sense_id": "23fc54ae-7034-30b8-be26-4287e900439e",
                                "text": "„Der Zeit der klirrenden Kälte folgt als zweites großes eschatologisches Ereignis der Weltenbrand.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
