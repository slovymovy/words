                    {
                        "translation_id": "01b63a6f-3196-46c3-a700-93f811c369b3",
                        "source_entry_id": "f05e97ea-1151-3b47-9bb6-c76674dfc4bd",
                        "source_sense_description": "непрозрачный драгоценный камень",
                        "target_lang_word": "turquesa",
                        "target_lang_code": "es",
