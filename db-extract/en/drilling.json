            {
                "entry_id": "ee26e3d5-a736-3e9c-aea7-46cd53dc3a1e",
                "word": "drilling",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "24a879ef-20bf-3d17-878f-a0ed73485bf3",
                        "entry_id": "ee26e3d5-a736-3e9c-aea7-46cd53dc3a1e",
                        "glosses": [
                            "vrt, vrtání, vývrt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ec26a71-8c51-4a2f-a80f-78a37dd5816c",
                                "sense_id": "24a879ef-20bf-3d17-878f-a0ed73485bf3",
                                "text": "We've been quite fed up with all this noisy drilling around our flat.",
                                "translation": "Už máme vážně dost toho hlučného vrtání kolem našeho bytu."
                            },
                            {
                                "example_id": "a5ce7fdf-4348-482a-bcca-26242a4c43de",
                                "sense_id": "24a879ef-20bf-3d17-878f-a0ed73485bf3",
                                "text": "The other side countered that any economic benefit from drilling was far outweighed by the need to preserve the Arctic Refuge — a jewel of our public lands, a vital habitat for wildlife, and a sacred place for the Gwich'in people.",
                                "translation": "Druhá strana namítla, že jakýkoliv ekonomický přínos z vrtání bohatě převažuje potřeba chránit arktické refugium, klenot našich veřejných pozemků a životně důležité místo pro přežití divoké přírody, posvátné místo gwičinského národa."
                            },
                            {
                                "example_id": "cc56cfd9-70ba-422e-9aac-052b577dcd8b",
                                "sense_id": "24a879ef-20bf-3d17-878f-a0ed73485bf3",
                                "text": "An asset for drilling was purchased and placed in service by a petroleum production company."
                            }
                        ]
                    }
                ],
