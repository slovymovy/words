                "senses": [
                    {
                        "sense_id": "32efcc40-a6ae-3d3a-ac6a-4ad5bbcc4486",
                        "entry_id": "c6bcac80-03df-3584-80f1-65bc4663c8aa",
                        "glosses": [
                            "yearbook"
                        ],
                        "tags": [
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "e7512a65-e56a-4bdd-8b93-745c939ff1d9",
                                "sense_id": "32efcc40-a6ae-3d3a-ac6a-4ad5bbcc4486",
                                "text": "In het jaarboek van de school staan foto's en herinneringen van het afgelopen schooljaar.",
                                "translation": "In the school yearbook, there are photos and memories from the past academic year.",
                                "english": "In the school yearbook, there are photos and memories from the past academic year."
                            },
                            {
                                "example_id": "a310db57-c4cc-4134-80a0-a7671a986928",
                                "sense_id": "32efcc40-a6ae-3d3a-ac6a-4ad5bbcc4486",
                                "text": "Het jaarboekje van de vereniging bevat een overzicht van alle activiteiten van het afgelopen jaar.",
                                "translation": "The association's yearbook contains an overview of all the activities from the past year.",
                                "english": "The association's yearbook contains an overview of all the activities from the past year."
                            }
                        ]
                    },
                    {
                        "sense_id": "30747e21-6a04-3073-a98b-911da4edbc81",
                        "entry_id": "c6bcac80-03df-3584-80f1-65bc4663c8aa",
                        "glosses": [
                            "annals, chronicle"
                        ],
                        "tags": [
                            "in-plural",
                            "neuter"
                        ],
                        "examples": [
                            {
                                "example_id": "9a6b68b8-d46b-42e4-9ddb-f5518d7cd11d",
                                "sense_id": "30747e21-6a04-3073-a98b-911da4edbc81",
                                "text": "De geschiedenis van de stad wordt vastgelegd in de jaarboeken van de lokale archieven.",
                                "translation": "The history of the city is recorded in the annals of the local archives.",
                                "english": "The history of the city is recorded in the annals of the local archives."
                            },
                            {
                                "example_id": "bc8b5bfb-fb91-40b3-8851-e06ad4eae70a",
                                "sense_id": "30747e21-6a04-3073-a98b-911da4edbc81",
                                "text": "De jaarboeken van de vereniging geven een gedetailleerd overzicht van de gebeurtenissen en prestaties van elk jaar.",
                                "translation": "The association's chronicles provide a detailed overview of the events and achievements of each year.",
                                "english": "The association's chronicles provide a detailed overview of the events and achievements of each year."
                            }
                        ]
                    }
