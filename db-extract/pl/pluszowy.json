                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4de97bd0-5450-36dc-bd82-9b883d91e6c3",
                                        "entry_id": "5ba2282e-e96f-3262-962a-e4b2ecd4e056",
                                        "glosses": [
                                            "Very extravagant."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7e6d32d-b5e8-3ca7-92e7-48fd35b15770",
                                        "entry_id": "5ba2282e-e96f-3262-962a-e4b2ecd4e056",
                                        "glosses": [
                                            "Very expensive, or appearing expensive; opulent, luxurious."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d35dc5e1-1b1f-46d8-aeb2-7ccf2d1ac39f",
                                                "sense_id": "f7e6d32d-b5e8-3ca7-92e7-48fd35b15770",
                                                "text": "They lived in a plush apartment complex."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d35dc444-7ed3-3113-8500-a23da050f695",
                                        "entry_id": "5ba2282e-e96f-3262-962a-e4b2ecd4e056",
                                        "glosses": [
                                            "Having a soft, fluffy exterior (of a man-made object, especially stuffed animals or upholstery)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78451c16-b6c6-4bc2-8091-5d40e7386833",
                                                "sense_id": "d35dc444-7ed3-3113-8500-a23da050f695",
                                                "text": "This plush toy is so cute and soft — I want it!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79d17d03-0fed-30e7-a712-a2ec43ea8489",
                                        "entry_id": "4f339267-ad24-3edc-b4ac-152c5f66f873",
                                        "glosses": [
                                            "A textile fabric with a nap or shag on one side, longer and softer than the nap of velvet."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7c953ad-61ce-485a-ae3b-935ae9b82aff",
                                                "sense_id": "79d17d03-0fed-30e7-a712-a2ec43ea8489",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered. […] The Maria had a cabin, which was finished in hard wood and yellow plush, and accommodations for keeping things cold."
                                            },
                                            {
                                                "example_id": "35df9840-37f0-464b-8f4f-77cf9ac6d056",
                                                "sense_id": "79d17d03-0fed-30e7-a712-a2ec43ea8489",
                                                "text": "That night the Boy slept in a different bedroom, and he had a new bunny to sleep with him. It was a splendid bunny, all white plush with real glass eyes, but the Boy was too excited to care very much about it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d18587c-1185-35e6-a0e6-db90159ad195",
                                        "entry_id": "4f339267-ad24-3edc-b4ac-152c5f66f873",
                                        "glosses": [
                                            "A plush toy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d202c18b-d63d-4e69-8eb3-8267542efaf0",
                                                "sense_id": "0d18587c-1185-35e6-a0e6-db90159ad195",
                                                "text": "When Play Along — the holder of the Care Bears master toy license — placed Care Bears plushes in Spencer Gifts last year, tweens and teenage girls bought the toys."
                                            },
                                            {
                                                "example_id": "ad5362dd-4447-4b3d-9909-88bc357958f4",
                                                "sense_id": "0d18587c-1185-35e6-a0e6-db90159ad195",
                                                "text": "For a small fee, the player can control a crane equipped with a gripper to pick a gift, usually a plush or a small toy, and has to drop it in a place where he/she can grab it."
                                            },
                                            {
                                                "example_id": "aeaad6c4-d4da-4692-b7bf-8422a25f7bc7",
                                                "sense_id": "0d18587c-1185-35e6-a0e6-db90159ad195",
                                                "text": "[…] L.A. Prop Cinema Storage, full of kids' clothing (mostly for girls), PJs, and lots of toys and plushes (there's also a substantial infant area)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "plush",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da73fe40-7102-3f91-a596-f83433cd9231",
                                        "entry_id": "3dd5c1de-c829-3cd6-9f59-fb57658acd1c",
                                        "glosses": [
                                            "To give a soft, fluffy surface to."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43a1d48a-f708-4de6-865b-ac121271b6f4",
                                                "sense_id": "da73fe40-7102-3f91-a596-f83433cd9231",
                                                "text": "Green moss plushed the boulders that were stewn ^([sic]) about, reaching up to splash the cliffs with a velvet mantle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb7d2af3-04f0-466e-b940-04a64c58f110",
                        "source_entry_id": "ca845b65-3fb3-3501-9e0a-24764b8b839f",
