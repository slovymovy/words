                        "examples": [
                            {
                                "example_id": "b49ad67f-af84-4975-8891-17e2d0495c73",
                                "sense_id": "760413a2-a639-3443-8f98-26dccd54eaa2",
                                "text": "Ofschoon binnen de geldende beleidsregels geen ruimte meer was, is er toch nog een mogelijkheid gevonden. Recent zag het er naar uit dat er geen tweede Glazen Huis zou komen. De aanvraag daartoe werd afgewezen door een ambtenaar. Het gemeentelijk activiteitenschema zou daarvoor geen mogelijkheid meer bieden."
                            },
                            {
                                "example_id": "fe4e51a5-9d28-486b-ba68-e358ef442691",
                                "sense_id": "760413a2-a639-3443-8f98-26dccd54eaa2",
                                "text": "Op het openbare activiteitenschema van de NAVO, dat half december werd bijgewerkt, komt de oefening 'Neptune Strike 2022' vooralsnog niet voor."
                            }
                        ]
