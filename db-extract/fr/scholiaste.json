                            {
                                "example_id": "6a44e99c-f7a5-4678-9521-67c7cfeacc29",
                                "sense_id": "03149726-69cc-36a0-84e6-5ef5aadb631d",
                                "text": "Le scholiaste de Théocrite assure que de son temps les moissonneurs de Phrygie chantoient encore les éloges de Lithyersès comme d’un excellent moissonneur"
                            },
                            {
                                "example_id": "407afebc-04fe-4bd0-8559-3dbb48f4cdad",
                                "sense_id": "03149726-69cc-36a0-84e6-5ef5aadb631d",
                                "text": "Il enfonça la jeune fille dans Vasari, enferma son temps et sa pensée dans les grammaires, les dictionnaires, les commentateurs, tous les scholiastes de l’art italien, la tint voûtée sur l’ingrat travail, sur l’ennui et la fatigue de traduire des mots à tâtons."
                            }
                        ]
                    }
