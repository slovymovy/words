                "senses": [
                    {
                        "sense_id": "b067152b-9164-3a27-8b93-bebfa0f62106",
                        "entry_id": "7188b328-2f37-3a5a-bbe5-00792375bf8c",
                        "glosses": [
                            "Attente entraînant un arrêt, une immobilisation provisoire."
