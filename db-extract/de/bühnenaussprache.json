                "senses": [
                    {
                        "sense_id": "33ba62b2-4c66-3425-91aa-6db5103ebca7",
                        "entry_id": "eccfd110-32dc-3219-876e-99cb6a2a48f6",
                        "glosses": [
                            "besonders auf Deutlichkeit angelegte Form der Aussprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7909066b-a913-4a3a-a46e-753bb4603f6c",
                                "sense_id": "33ba62b2-4c66-3425-91aa-6db5103ebca7",
                                "text": "„Die Bühnenaussprache ist eine ideale Norm, die der Sprechwirklichkeit weniger nah kommt als die oben beschriebene Standardlautung.“"
                            },
                            {
                                "example_id": "7ad49b3c-33a8-4f4f-8b77-cfaf56a8ccb0",
                                "sense_id": "33ba62b2-4c66-3425-91aa-6db5103ebca7",
                                "text": "„‚Reines‘ Deutsch ist beileibe nicht Berlinerisch, sondern entstammt eher der Gegend um Hannover; und es wurde normiert als »mustergültige Bühnenaussprache«.“"
                            },
                            {
                                "example_id": "9aa10c70-5ff1-46e0-8cbb-9ebaf55507d1",
                                "sense_id": "33ba62b2-4c66-3425-91aa-6db5103ebca7",
                                "text": "„Ungefähr diese Bühnenaussprache haben wir für unser Glossar gewählt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
