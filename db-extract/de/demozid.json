                "senses": [
                    {
                        "sense_id": "72b1fc7f-22ee-3c4c-a90f-0e399819d552",
                        "entry_id": "2450afa2-a5ad-301e-9ae7-0c7338a97076",
                        "glosses": [
                            "vorsätzliche Massentötung von bestimmten Menschengruppen durch eine Regierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b03c7776-cb69-4924-820d-a6b11b02b438",
                                "sense_id": "72b1fc7f-22ee-3c4c-a90f-0e399819d552",
                                "text": "„Wie steht es dann mit den Ansprüchen osmanischer Staatsbürger griechischer Nationalität, deren Vorfahren im selben Zeitraum Opfer türkischer Staatsverbrechen - Genozid und Demozid - geworden sind, an die Republik Türkei?“"
                            },
                            {
                                "example_id": "068657d9-0c0b-4365-ba68-6fed15e21c0f",
                                "sense_id": "72b1fc7f-22ee-3c4c-a90f-0e399819d552",
                                "text": "„Der Begriff Demozid wurde von Rummel gewählt, weil Genozid seit der Völkermord-Konvention der Vereinten Nationen von 1948 eine ethnischrassische Gruppenidentität für die Opfer voraussetzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
