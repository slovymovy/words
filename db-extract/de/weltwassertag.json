                "senses": [
                    {
                        "sense_id": "3b8dec04-26e3-391a-a5ca-3804cf4c3968",
                        "entry_id": "4b1a6947-fa35-315d-9098-43ca6b19fbd3",
                        "glosses": [
                            "Welttag zum Thema Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dbbc59b-6970-4578-9a22-9a0b2a9818ea",
                                "sense_id": "3b8dec04-26e3-391a-a5ca-3804cf4c3968",
                                "text": "„Es gibt auch in Afrika genug Wasser - der Zugang dazu ist aber in vielen Ländern sehr unsicher, berichtet die UN am Weltwassertag 2022.“"
                            },
                            {
                                "example_id": "59ff0980-e07d-406b-9888-82c3a20eae14",
                                "sense_id": "3b8dec04-26e3-391a-a5ca-3804cf4c3968",
                                "text": "„Trotz der globalen Ziele für nachhaltige Entwicklung hätten fast die Hälfte der 54 Länder des Kontinents in den vergangenen drei bis fünf Jahren im Bereich Wassersicherheit keine Fortschritte gemacht, hieß es in dem zum Weltwassertag am 22. März veröffentlichten Bericht.“"
                            },
                            {
                                "example_id": "6fb53ded-3c55-43be-91ce-326ae3f9a4af",
                                "sense_id": "3b8dec04-26e3-391a-a5ca-3804cf4c3968",
                                "text": "„Im Dezember 1992 hat die UN-Generalversammlung erstmals den Weltwassertag ins Leben gerufen, um auf die globale Wasserknappheit aufmerksam zu machen und zu nachhaltigem Umgang damit zu ermahnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
