                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4190c5a5-8901-4d14-b6a5-586f2fc16bae",
                        "source_entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                        "source_sense_description": "of great volume",
                        "target_lang_word": "objemný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "objemný",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d7aa8126-e3ed-3453-a6e9-65f33adc4b8e",
                                        "entry_id": "20400aee-0bcb-375c-ae7b-31bac3e1f144",
                                        "glosses": [
                                            "mající velké rozměry nebo objem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9f4dd5c-f4aa-4a07-a799-7f6bed861ab2",
                                                "sense_id": "d7aa8126-e3ed-3453-a6e9-65f33adc4b8e",
                                                "text": "Nyní používané bílé objemné skafandry byly navrženy pro projekt Apollo v 60. letech minulého století. Potřebám novodobých dobyvatelů vesmíru však už příliš nevyhovují."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "394e133d-6106-4491-b2ee-b10b3a983d50",
                        "source_entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                        "source_sense_description": "of great volume",
                        "target_lang_word": "volumineus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "volumineus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "847a0650-4342-3ca4-9e6b-418e062948b0",
                                        "entry_id": "089ec5af-060a-301d-904f-dd4e2ee2c986",
                                        "glosses": [
                                            "een grote omvang hebbende"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ca8b0ad-7b7d-4733-9e38-329dc92d9cbf",
                                                "sense_id": "847a0650-4342-3ca4-9e6b-418e062948b0",
                                                "text": "Het geheim van een goede zeilracer zit in de combinatie van een licht gewicht, een perfect onderwaterschip met mooi ballastaandeel en perfecte tuigage. Voor een comfortabele cruiser is een volumineus interieur en gemakkelijke ‘handling’ nodig. Het is X-Yachts gelukt beide vereisten in de X4 naar tevredenheid van alle testzeilers te combineren."
                                            },
                                            {
                                                "example_id": "a0dd0cd9-20c2-40d1-b244-bc492426fbe1",
                                                "sense_id": "847a0650-4342-3ca4-9e6b-418e062948b0",
                                                "text": "Breng voordat je een hoed opzet, eerst je haar in model. Zo is het aan te raden om op je haarwortels wat haarspray te verdelen en vervolgens met je hoofd ondersteboven je haardos te föhnen. Op die manier zorg je voor een volumineus kapsel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a0f534e-7e9c-32f4-b264-fa170c549d5a",
                                        "entry_id": "089ec5af-060a-301d-904f-dd4e2ee2c986",
                                        "glosses": [
                                            "zeer dik zijn"
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13eecd61-bc01-4dc1-b9f5-5a14a1852868",
                                                "sense_id": "0a0f534e-7e9c-32f4-b264-fa170c549d5a",
                                                "text": "Deze mensen zijn zo volumineus dat zij nauwelijks in staat zijn hun leven gaande te houden. Dientengevolge komt er een legioen aan hulpverleners (waaronder ik) bij deze mensen over de vloer om hun huishouden enigszins op orde te houden."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e088caae-5639-4e53-8391-6c1171f37b77",
                        "source_entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
                        "source_sense_description": "of great volume",
                        "target_lang_word": "voluminös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "voluminös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                        "entry_id": "742db393-bdde-3b0a-9a03-5ea1b9190343",
                                        "glosses": [
                                            "mit Masse und mit deutlichem Umfang (Volumen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be2f9cf8-72f3-46b7-a28a-a38b250e4802",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "„Die anfängliche Sorge, durch den voluminösen Wasserstofftank werde das Rad unhandlicher, bestätigt sich nicht.“"
                                            },
                                            {
                                                "example_id": "1bd64762-c0c2-4dbd-b5a4-bb0ba7f8c1e0",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "„Sie ist Mitte dreißig, mittelgroß, misst etwa Einmeterundsiebzig, trägt ihr dunkelblondes Haar lang und offen, durch Dauerwelle voluminös aufgebauscht, eine richtige Löwenmähne.“"
                                            },
                                            {
                                                "example_id": "ac5c6968-55e0-4b6b-b4a5-c3c5e335430a",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "Das Pferd bekommt zur Zeit nahrhaftes, aber wenig voluminöses Futter."
                                            },
                                            {
                                                "example_id": "44c37b85-d8af-46bf-9470-b0b3b7f93d5f",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "Ihr voluminöser Leib passte gerade so in den einzigen Sessel des Wartezimmers."
                                            },
                                            {
                                                "example_id": "9ccac227-266b-49d2-957c-54e6d592eaf3",
                                                "sense_id": "d8947c0e-261e-3e89-824e-f153b6743fa1",
                                                "text": "„Plötzlich war die Wolke da — schwarz, haushoch und voluminöser als alles, was ich bisher gesehen habe — und schon zu nah, um ihr noch entkommen zu können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a736c84e-03cb-46b2-b970-90a98c4a757e",
                        "source_entry_id": "230cd126-4e19-343e-baa7-8b9958ede90a",
