        "fr-extract.jsonl": [
            {
                "entry_id": "de13bc68-7181-3755-9fd1-5c0c6deaceb5",
                "word": "trudeaumanie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "03973cd1-25bc-314c-9669-6024508cb672",
                        "entry_id": "de13bc68-7181-3755-9fd1-5c0c6deaceb5",
                        "glosses": [
                            "Surnom donné au grand engouement suscité par l’entrée en politique canadienne de Pierre Elliott Trudeau en 1968."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3176038f-1dfc-4001-9bf4-8d5c4f752b4b",
                                "sense_id": "03973cd1-25bc-314c-9669-6024508cb672",
                                "text": "La Trudeaumanie qui l’entoure tout au long des 16 années que durera son règne, avec une éclipse de quelques mois entre 1979 et 1980 au profit du conservateur Joe Clark, l’ont constamment poussé à l’avant-scène de l’information, tant comme acteur public que sur le plan personnel­­."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dd7585c-8965-3658-b074-396f36f82c38",
                        "entry_id": "de13bc68-7181-3755-9fd1-5c0c6deaceb5",
                        "glosses": [
                            "Surnom donné au grand engouement suscité par Justin Trudeau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0e39f76-e33f-4261-9a08-354c1f0865ef",
                                "sense_id": "4dd7585c-8965-3658-b074-396f36f82c38",
                                "text": "Possédant tous deux un charisme certain, il va sans dire que Trudeau fils a fait ressusciter le phénomène de la Trudeaumanie depuis son élection en 2015."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "319884b8-fc4f-402d-95a7-9b173bd14efa",
                        "source_entry_id": "de13bc68-7181-3755-9fd1-5c0c6deaceb5",
                        "target_lang_word": "Trudeaumania",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trudeaumania",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fc9d512-b494-3130-8904-47fd36deeb66",
                                        "entry_id": "2d497b53-f91f-3bb7-b95a-e3b829d95f37",
                                        "glosses": [
                                            "Fervent admiration of Pierre Trudeau (1919–2000), Prime Minister of Canada from 1968 to 1979 and from 1980 to 1984, especially during his 1968 election campaign and his early years in office."
                                        ],
                                        "tags": [
                                            "Canadian",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d90afed-904f-430a-9da0-0c5a0c75fc69",
                                                "sense_id": "7fc9d512-b494-3130-8904-47fd36deeb66",
                                                "text": "But Wright takes a rather contrarian position about the impact of emotionally charged Trudeaumania on PET’s astonishing political rise in 1968."
                                            },
                                            {
                                                "example_id": "ac9fe6f2-da4c-472a-8a48-9f33c9e9f51d",
                                                "sense_id": "7fc9d512-b494-3130-8904-47fd36deeb66",
                                                "text": "Conservatives deny that what they refer to as Trudeaumania has scared candidates from their ranks."
                                            },
                                            {
                                                "example_id": "b5545244-a0c1-4d2d-bc3b-9b2a57cfab68",
                                                "sense_id": "7fc9d512-b494-3130-8904-47fd36deeb66",
                                                "text": "Pierre Elliott Trudeau, Canada's own distinctive revolution in democratic political style; the swinger, the all-round athlete: Trudeaumania as overture to the Just Society."
                                            },
                                            {
                                                "example_id": "aebb8811-08d0-41d5-8329-d82ca501d6bd",
                                                "sense_id": "7fc9d512-b494-3130-8904-47fd36deeb66",
                                                "text": "During the 1968–69 school year, remembered for its anti-Vietnam War demonstrations and Trudeaumania, Michael Ignatieff and Bob Rae shared a cheap apartment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26156b85-7d09-3c0f-aa70-af549ee6b85f",
                                        "entry_id": "2d497b53-f91f-3bb7-b95a-e3b829d95f37",
                                        "glosses": [
                                            "Fervent admiration of Justin Trudeau (born 1971), Prime Minister of Canada from 2015 to 2025."
                                        ],
                                        "tags": [
                                            "Canadian",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bd062e6-b3b4-42a3-99d3-589bf891db91",
                                                "sense_id": "26156b85-7d09-3c0f-aa70-af549ee6b85f",
                                                "text": "Nearly eight years ago, Trudeau was swept into Canada’s highest office on a wave of “Trudeaumania,” a fresh-faced leader who championed the idea that a more progressive, diverse, and open Canada would make the country stronger and elevate its global standing."
                                            },
                                            {
                                                "example_id": "671e37e9-0834-487f-b447-9957bf4347dd",
                                                "sense_id": "26156b85-7d09-3c0f-aa70-af549ee6b85f",
                                                "text": "Trudeaumania, in all its selfie and handshake glory, was on full display in the city, with the crowd growing as word got out across Canada’s largest Bavarian festival that the prime minister had arrived."
                                            },
                                            {
                                                "example_id": "1d5d2451-a6ba-4320-b029-412eed53824d",
                                                "sense_id": "26156b85-7d09-3c0f-aa70-af549ee6b85f",
                                                "text": "It quickly became clear PACE has been provoked by a number issue related to Prime Minister Justin Trudeau and NDP Leader Jagmeet Singh’s agenda. Phimester and Main argue Sohi’s city council is essentially an agent for this agenda and they want to reverse Trudeaumania here. “It’s so ideological,” Main said of council. “It’s trying to be pure and virtue-signally and making sure that Trudeau and Singh are happy with what they’re doing. It’s just nuts.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
