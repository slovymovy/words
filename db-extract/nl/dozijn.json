                    {
                        "sense_id": "2c51bc5a-91e7-3cff-b214-10828fdf1aa6",
                        "entry_id": "4f3ab2b5-8804-3382-bddc-a4ae50c74b9f",
                        "glosses": [
                            "een set van twaalf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89563d29-1412-4ab1-9169-3c6e5976f3b4",
                                "sense_id": "2c51bc5a-91e7-3cff-b214-10828fdf1aa6",
                                "text": "Hij heeft een dozijn fietsen thuis."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3fc4bd0-d6cc-4a0c-b402-8384bf6de087",
                        "source_entry_id": "4f3ab2b5-8804-3382-bddc-a4ae50c74b9f",
                        "source_sense_id": "2c51bc5a-91e7-3cff-b214-10828fdf1aa6",
                        "source_sense_description": "een set van twaalf",
                        "target_lang_word": "Dutzend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dutzend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                        "entry_id": "07040f58-a0a9-374a-94e5-a8b4f08fdef3",
                                        "glosses": [
                                            "alter, aber auch heute noch gebräuchlicher Zahlklassifikator für die Zahl Zwölf; zwölf"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56347f0b-b960-47bd-9ec5-b76122a4f745",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„In den Alpen und im Alpenvorland kreisen bei guter Thermik nicht weniger als zwei bis drei Dutzend Gleit- und Deltaflieger gleichzeitig über dem Tal.“"
                                            },
                                            {
                                                "example_id": "9931d1f3-0ba1-4d04-9594-e8c555c6387b",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„Fast alle, die im Höhenbergsteigen Rang und Namen haben, sind an der Lhotse-Südwand gescheitert, insgesamt rund ein Dutzend Expeditionen.“"
                                            },
                                            {
                                                "example_id": "dd4f2bcb-f47d-48c3-9f0e-7cfe061a17bd",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "Ich habe heute zwei Dutzend Äpfel gekauft."
                                            },
                                            {
                                                "example_id": "7e577050-d971-42f4-ac5d-2e530919f627",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„Er schlägt ein Dutzend Eier hinein.“"
                                            },
                                            {
                                                "example_id": "519c8961-6cdf-460d-b676-f23b515f8b72",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„Ich fand mich plötzlich auf einem Podium einem Lautsprecher und etwa zwei Dutzend bleichen Gesichtern gegenüber, die deutschen Journalisten gehörten.“"
                                            },
                                            {
                                                "example_id": "19f27b37-f120-4677-8090-650be6a9b429",
                                                "sense_id": "ea7fca29-f998-357a-aefa-75bfcbc11509",
                                                "text": "„Als er am oberen Ende der breiten, steilen Rampe angelangt war, die zu dem großen Veranstaltungssaal führte, sah er vor der Türreihe bereits eine Schar von Leuten warten, mindestens zwei Dutzend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "50f76240-0607-3abe-b665-b60280df29af",
                                        "entry_id": "07040f58-a0a9-374a-94e5-a8b4f08fdef3",
                                        "glosses": [
                                            "unbestimmte Anzahl von etwas; viele"
                                        ],
                                        "tags": [
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f85cc5a4-eb47-4fdb-b7db-541e63e390e2",
                                                "sense_id": "50f76240-0607-3abe-b665-b60280df29af",
                                                "text": "Auf dem Platz versammelten sich dutzende Schaulustige."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c17f19f-c6c9-4908-938d-47a604dcf922",
                        "source_entry_id": "4f3ab2b5-8804-3382-bddc-a4ae50c74b9f",
                        "source_sense_id": "2c51bc5a-91e7-3cff-b214-10828fdf1aa6",
                        "source_sense_description": "een set van twaalf",
                        "target_lang_word": "dozen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dozen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                        "entry_id": "a63c990e-aa49-3688-b989-4d00a269aa7c",
                                        "glosses": [
                                            "A set of twelve."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d565ffda-e991-4d14-95a0-7ddcff6374b1",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "Can I have a dozen eggs, please?"
                                            },
                                            {
                                                "example_id": "803e1c89-0235-4787-9338-95e02c637178",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "I ordered two dozen doughnuts."
                                            },
                                            {
                                                "example_id": "e61c9211-8e48-46df-825f-d3324ddf1138",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "There are hundreds of people from each continent in the convention but only a few dozen came from Africa."
                                            },
                                            {
                                                "example_id": "be2c953c-426e-40e5-88e5-0fb5f1444164",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "Pack the shirts in dozens, please."
                                            },
                                            {
                                                "example_id": "df72d67f-abcc-4982-936d-3e30937fe511",
                                                "sense_id": "d3534d35-5756-38de-874f-887ba6339c6b",
                                                "text": "Almost three dozen US service members were diagnosed with traumatic brain injuries after the Iranian missile attack earlier this month, the Pentagon said Friday."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                        "entry_id": "a63c990e-aa49-3688-b989-4d00a269aa7c",
                                        "glosses": [
                                            "A large, unspecified number of, comfortably estimated in small multiples of twelve, thus generally implied to be significantly more than ten or twelve, but less than perhaps one or two hundred; many."
                                        ],
                                        "tags": [
                                            "as plural only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3112f49-d79d-4833-b132-e9c169dc13c1",
                                                "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                                "text": "There must have been dozens of examples just on the first page."
                                            },
                                            {
                                                "example_id": "979ea899-90aa-4ba9-bcfa-428415627e6b",
                                                "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                                "text": "There were dozens and dozens of applicants before the job was posted."
                                            },
                                            {
                                                "example_id": "93bb9652-b433-4974-b70e-5c03ba7649a1",
                                                "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                                "text": "Although there are dozens of different types of gems, among the best known and most important are diamond, ruby and sapphire, emerald and other gem forms of the mineral beryl, chrysoberyl, tanzanite, tsavorite, topaz and jade."
                                            },
                                            {
                                                "example_id": "bcd194d1-f9a2-40b0-a7b1-cb7eff921f09",
                                                "sense_id": "ed341adf-e8ca-36a5-8407-aaab09b0e8d6",
                                                "text": "Jessalyn, known to her family as Jessa, was one of the dozens who were hit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "145d62a1-866d-3415-b0d7-fcee7bd8130e",
                                        "entry_id": "a63c990e-aa49-3688-b989-4d00a269aa7c",
                                        "glosses": [
                                            "An old English measure of ore containing 12 hundredweight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa403156-1c0a-44c2-b978-7108bd2b3e28",
                                                "sense_id": "145d62a1-866d-3415-b0d7-fcee7bd8130e",
                                                "text": "The dozen as a measure for iron ore remained almost completely constant at 12 cwts. during the sixteenth and seventeenth centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da3b5ed7-7bb6-3ff3-a03b-0cf0d92dc052",
                                        "entry_id": "a63c990e-aa49-3688-b989-4d00a269aa7c",
                                        "glosses": [
                                            "The number twelve."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f83c8a7f-1d98-4224-86c6-aa3a678eb8e0",
                        "source_entry_id": "4f3ab2b5-8804-3382-bddc-a4ae50c74b9f",
