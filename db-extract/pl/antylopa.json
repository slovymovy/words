                                        "entry_id": "a66c0d2a-aa6f-3bcc-a335-791a2f87e3f0",
                                        "glosses": [
                                            "Ruminant aux pattes fines et aux cornes creuses arquées. Peut désigner de nombreux bovidés, à l'exclusion des ovins, des caprins, et des vaches et autres animaux de bétail ressemblants."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a11aa873-a132-4b57-9b82-37b0fe69673d",
                                                "sense_id": "8812f34e-6a97-3043-b02d-faa2ae85e8a8",
                                                "text": "La gazelle, l’éland appartiennent au groupe des antilopes."
                                            },
                                            {
                                                "example_id": "fd9ad46d-ce80-4791-a60f-2962883e1dc6",
                                                "sense_id": "8812f34e-6a97-3043-b02d-faa2ae85e8a8",
                                                "text": "Il serra une liane au cou de l’antilope et il la dépouilla de la fourrure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
