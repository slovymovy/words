                "senses": [
                    {
                        "sense_id": "016f73fc-f4aa-3857-8cba-e9fb031911e4",
                        "entry_id": "fdfd165d-d562-3378-82c9-dd102b35bd10",
                        "glosses": [
                            "gastfreundlicher Hausherr; Gastgeber, Gastfreund"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a314b110-74c3-45ee-a5c1-86f874039846",
                        "source_entry_id": "fdfd165d-d562-3378-82c9-dd102b35bd10",
                        "source_sense_id": "016f73fc-f4aa-3857-8cba-e9fb031911e4",
                        "source_sense_description": "veraltet: gastfreundlicher Hausherr; Gastgeber, Gastfreund",
                        "target_lang_word": "Gastgeber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gastgeber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e973c542-6e64-37a6-a046-72f79ba4e1f3",
                                        "entry_id": "5b542ee2-1114-33c7-a154-8237de52940f",
                                        "glosses": [
                                            "jemand, der jemanden als Gast zu sich einlädt; bei sich zu Gast hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0058fbc4-9e24-4878-8320-444ece9205f0",
                                                "sense_id": "e973c542-6e64-37a6-a046-72f79ba4e1f3",
                                                "text": "Er ist ein sehr guter Gastgeber. Er unterhält seine Gäste sehr gut."
                                            },
                                            {
                                                "example_id": "7a461248-277c-420a-95f3-1dca0ef83ce7",
                                                "sense_id": "e973c542-6e64-37a6-a046-72f79ba4e1f3",
                                                "text": "„Als Humboldt spätabends vom Empfang beim Bürgermeister heimkam, wollte sein Gastgeber mit ihm trinken.“"
                                            },
                                            {
                                                "example_id": "da8ef33e-d230-4ec4-89e6-958f5f457cfd",
                                                "sense_id": "e973c542-6e64-37a6-a046-72f79ba4e1f3",
                                                "text": "„Mein Onkel und ich grüßten unsere Gastgeber noch einmal laut und herzlich und machten uns zu Fuß auf den Weg.“"
                                            },
                                            {
                                                "example_id": "675e5db5-d007-4fa2-9f3b-3c866964d9a5",
                                                "sense_id": "e973c542-6e64-37a6-a046-72f79ba4e1f3",
                                                "text": "„Das Zimmer seiner Gastgeber damals lag vorn links.“"
                                            },
                                            {
                                                "example_id": "a649514b-94dc-44df-9416-935ea3205295",
                                                "sense_id": "e973c542-6e64-37a6-a046-72f79ba4e1f3",
                                                "text": "„Eine Woche lang hatte unser Gastgeber beobachtet, wo die Wachtelschwärme sich sammelten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a66537ed-890d-35d2-a14a-fa96ddaf645c",
                                        "entry_id": "5b542ee2-1114-33c7-a154-8237de52940f",
                                        "glosses": [
                                            "derjenige oder diejenigen Teilnehmer an einer Veranstaltung, in dessen/deren Räumlichkeiten diese stattfindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d345d07-3b42-4e10-9d68-70120036bc55",
                                                "sense_id": "a66537ed-890d-35d2-a14a-fa96ddaf645c",
                                                "text": "„Vergebens bemühten sich die Gastgeber, auch gleich die unerhörten Vorgänge in dessen Land von der Tagesordnung zu streichen.“"
                                            },
                                            {
                                                "example_id": "1a695a6e-cd51-404c-9e64-1a771e4c981b",
                                                "sense_id": "a66537ed-890d-35d2-a14a-fa96ddaf645c",
                                                "text": "Das Spiel endete 3 : 2 für die Gastgeber."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
