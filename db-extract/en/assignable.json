                    {
                        "sense_id": "59201ae0-e5a0-3f20-85ff-b9d5a08c448d",
                        "entry_id": "38f44136-5523-345b-82bd-4c495509ce45",
                        "glosses": [
                            "Capable of being specified or shown."
