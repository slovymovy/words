                    },
                    {
                        "translation_id": "5dbe5900-5ab5-4542-8b1f-69b59a92f128",
                        "source_entry_id": "997cce62-37a7-35ae-92a4-9f262d1b91f3",
                        "source_sense_id": "ea47b007-1318-346b-9e00-abc32d1e8663",
                        "source_sense_description": "a follower of Sigmund Freud",
                        "target_lang_word": "Freudianer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Freudianer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d326466a-1d10-3788-b8ea-1f280ee447e0",
                                        "entry_id": "1d8bd4d2-8e6b-310c-8c91-eaef68f18f0c",
                                        "glosses": [
                                            "Anhänger der Lehre Sigmund Freuds"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eab39fc2-350c-4852-a9d1-a3b12ed61a0d",
                                                "sense_id": "d326466a-1d10-3788-b8ea-1f280ee447e0",
                                                "text": "Also, er ist Freudianer, und das sagt doch alles."
                                            },
                                            {
                                                "example_id": "4f7451a8-44cb-4490-a44a-0ee257df503a",
                                                "sense_id": "d326466a-1d10-3788-b8ea-1f280ee447e0",
                                                "text": "„Ich lache über die seichten Endokrinologen, über Gimpel und Emporkömmlinge wie die Freudianer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
