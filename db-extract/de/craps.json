                        "examples": [
                            {
                                "example_id": "9d987274-23d6-41b4-b140-b73ed6353924",
                                "sense_id": "3523d72f-e4cd-3de1-a67c-a6d4949efe49",
                                "text": "„Zunächst einmal muss man wissen, was Craps war.“"
                            },
                            {
                                "example_id": "24a3d2e1-2ba8-4ebd-9619-b5b471dea437",
                                "sense_id": "3523d72f-e4cd-3de1-a67c-a6d4949efe49",
                                "text": "„Vor über zwanzig Jahren hatten Peggy und er es aufgegeben, in Kalifornien Salat anzubauen, hatten das wenige, was sie besaßen, in ihren alten Ford geschmissen und waren gen Osten nach Reno gefahren, wo Steve eine Glückssträhne beim Poker hatte, die Peggy kurzerhand krönte, indem sie Craps spielte und drei Siebener hintereinander würfelte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4dfb8e83-d31b-4b72-99a5-f2db9a272cb8",
                        "source_entry_id": "97d8bef3-d601-3d2a-a63d-61eecbb2589f",
                        "source_sense_id": "3523d72f-e4cd-3de1-a67c-a6d4949efe49",
