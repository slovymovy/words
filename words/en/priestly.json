                    "examples": [
                        {
                            "text": "Doctor <w>Priestly</w> gave a fascinating lecture on the history of local geology.",
                            "target_lang_translations": {
                                "ru": "Доктор <w>Пристли</w> прочитал захватывающую лекцию по истории местной геологии."
                            }
