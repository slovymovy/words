    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4a21b028-d3f4-37ba-8b34-b35ac41b2843",
                "word": "maffick",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6d462d58-5e4e-40dc-b73c-38f54acd7ec8",
                        "entry_id": "4a21b028-d3f4-37ba-8b34-b35ac41b2843",
                        "tags": [
                            "plural"
                        ],
                        "form": "mafficks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dcfc47c6-cf48-387c-8e47-760a11e006a8",
                        "entry_id": "4a21b028-d3f4-37ba-8b34-b35ac41b2843",
                        "glosses": [
                            "The boisterous celebration of a victory."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "574e46c7-bd42-4090-a03d-dbb5872e9989",
                                "sense_id": "dcfc47c6-cf48-387c-8e47-760a11e006a8",
                                "text": "But far the greater number of the inhabitants lead a sober life, only breaking out into occasional excess on “mafficks” of authorised national rejoicing, on the days of public holiday, or on the last night of the year, and other periods of unusual solemnity."
                            },
                            {
                                "example_id": "6d815aff-5a10-48af-991f-a86dbab79ee5",
                                "sense_id": "dcfc47c6-cf48-387c-8e47-760a11e006a8",
                                "text": "War gives to them something of the excitement of the public-house; and much as I hate the passion of jingoism among those to whom fortune has given the education and opportunity to think, I recognise that a slum “on the Maffick” was a thing far less degrading to human nature than the calculations of financiers or the plots of statesmen."
                            },
                            {
                                "example_id": "1315fbb0-b360-4c86-9bb4-fea218dd7cdd",
                                "sense_id": "dcfc47c6-cf48-387c-8e47-760a11e006a8",
                                "text": "It was a clandestine “maffick,” but was all the more exuberant because we had the satisfaction of knowing that we had outwitted the authorities completely, they being in utter ignorance of our celebration."
                            },
                            {
                                "example_id": "8416de40-50a5-4641-9f20-6a9a42147e9b",
                                "sense_id": "dcfc47c6-cf48-387c-8e47-760a11e006a8",
                                "text": "This, needless to say, ended the maffick and put a damper on the rest of the VE Day celebrations."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "dbd4d1d9-4495-36e9-86d5-6419df379aa5",
