            "senses": [
                {
                    "sense_id": "2e865e1b-2379-3ca3-9207-493328af7b61",
                    "sense_definition": "gereed voor gebruik staan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gereedheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er stond een huurauto <w>klaar</w> op het vliegveld voor de toeristen.",
                            "target_lang_translations": {
                                "en": "A rental car was <w>ready</w> at the airport for the tourists."
                            }
                        },
                        {
                            "text": "Het ontbijt zal morgenochtend om acht uur voor jullie <w>klaarstaan</w>.",
                            "target_lang_translations": {
                                "en": "Breakfast will <w>be ready</w> for you at eight o'clock tomorrow morning."
                            }
                        }
                    ],
                    "synonyms": [
                        "gereedstaan"
                    ],
                    "common_phrases": [
                        "klaarstaan voor gebruik"
                    ],
                    "target_lang_definitions": {
                        "en": "To be ready or available for use or consumption."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be ready",
                                "target_lang_sense_clarification": "to be prepared for use"
                            },
                            {
                                "target_lang_word": "be waiting",
                                "target_lang_sense_clarification": "to be present and available"
                            },
                            {
                                "target_lang_word": "be on standby",
                                "target_lang_sense_clarification": "to be available for immediate use"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9e2914eb-e7df-3aeb-b576-d8b3e7867177",
                    "sense_definition": "klaar zijn om onmiddellijk met een actie te beginnen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "gereedheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De brandweerlieden <w>staan klaar</w> om bij het kleinste signaal uit te rukken.",
                            "target_lang_translations": {
                                "en": "The firefighters <w>stand ready</w> to head out at the slightest signal."
                            }
                        },
                        {
                            "text": "Blijf in de buurt en <w>sta klaar</w> voor de start van de wedstrijd.",
                            "target_lang_translations": {
                                "en": "Stay close and <w>be ready</w> for the start of the race."
                            }
                        }
                    ],
                    "synonyms": [
                        "gereedstaan",
                        "paraat staan"
                    ],
                    "common_phrases": [
                        "klaarstaan voor vertrek"
                    ],
                    "target_lang_definitions": {
                        "en": "To be ready to start an action immediately."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand ready",
                                "target_lang_sense_clarification": "to be prepared to act"
                            },
                            {
                                "target_lang_word": "be poised",
                                "target_lang_sense_clarification": "to be ready to move or act"
                            },
                            {
                                "target_lang_word": "stand by",
                                "target_lang_sense_clarification": "to wait in expectation of an event"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c360fcb-09c0-390b-9b63-2b68992d4442",
                    "sense_definition": "altijd bereid zijn om iemand te helpen of te ondersteunen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hulpvaardigheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij had altijd voor hem <w>klaargestaan</w> als hij persoonlijke problemen had.",
                            "target_lang_translations": {
                                "en": "She had always <w>been there</w> for him when he had personal problems."
                            }
                        },
                        {
                            "text": "Goede buren <w>staan</w> altijd voor elkaar <w>klaar</w> in tijden van nood.",
                            "target_lang_translations": {
                                "en": "Good neighbors always <w>stand by</w> each other in times of need."
                            }
                        }
                    ],
                    "synonyms": [
                        "helpen",
                        "bijstaan"
                    ],
                    "common_phrases": [
                        "voor iemand klaarstaan"
                    ],
                    "target_lang_definitions": {
                        "en": "To always be prepared to help or support someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be there for",
                                "target_lang_sense_clarification": "to be available to support someone"
                            },
                            {
                                "target_lang_word": "stand by",
                                "target_lang_sense_clarification": "to support or remain loyal to someone"
                            },
                            {
                                "target_lang_word": "be ready to help",
                                "target_lang_sense_clarification": "to be willing to assist"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01472d08-4123-32b9-9029-7128f46fed30",
                    "sense_definition": "wachten op instructies of een gebeurtenis",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gereedheid",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De soldaten <w>staan klaar</w> voor nieuwe bevelen van hun commandant.",
                            "target_lang_translations": {
                                "en": "The soldiers are <w>standing by</w> for new orders from their commander."
                            }
                        },
                        {
                            "text": "De technici <w>staan klaar</w> om het systeem direct te repareren.",
                            "target_lang_translations": {
                                "en": "The technicians are <w>on standby</w> to repair the system immediately."
                            }
                        }
                    ],
                    "synonyms": [
                        "afwachten",
                        "stand-by staan"
                    ],
                    "common_phrases": [
                        "klaarstaan voor bevelen"
                    ],
                    "target_lang_definitions": {
                        "en": "To wait for instructions or for a specific event to occur."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stand by",
                                "target_lang_sense_clarification": "to wait for further instructions"
                            },
                            {
                                "target_lang_word": "await",
                                "target_lang_sense_clarification": "to wait for something expected"
                            },
                            {
                                "target_lang_word": "be on call",
                                "target_lang_sense_clarification": "to be ready when summoned"
                            }
                        ]
                    }
                }
            ]
        }
