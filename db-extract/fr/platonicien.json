                    }
                ],
                "senses": [
                    {
                        "sense_id": "68ba4b60-1b96-37b6-9550-5f375543ec2c",
                        "entry_id": "6ad6d20f-9acc-3ce1-a640-17dcc42da271",
                        "glosses": [
                            "Adepte de Platon, de sa philosophie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf3ae1b2-30e3-4710-9661-6a204811ea4c",
                                "sense_id": "68ba4b60-1b96-37b6-9550-5f375543ec2c",
                                "text": "Abélard est donc un platonicien affranchi du réalisme des genres et des espèces leur existence éternelle est celle de pures essences, ce dernier terme devant être dépouillé de tout ce qui pourrait faire penser au mode d’être des choses."
                            },
                            {
                                "example_id": "66da72d0-8f56-4a46-9b90-a480486ed61f",
                                "sense_id": "68ba4b60-1b96-37b6-9550-5f375543ec2c",
                                "text": "Les platoniciens croyaient que toutes les connaissances que nous acquérons ne sont que des réminiscences de ce que nous avons su avant notre naissance."
                            },
                            {
                                "example_id": "630ebe4a-7117-49f1-acb4-d96c39d6506f",
                                "sense_id": "68ba4b60-1b96-37b6-9550-5f375543ec2c",
                                "text": "La lutte entre les platoniciens et les aristotéliciens."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e8c77bd-02b7-4475-8de1-6c8b90d4c8af",
                        "source_entry_id": "6ad6d20f-9acc-3ce1-a640-17dcc42da271",
                        "source_sense_id": "68ba4b60-1b96-37b6-9550-5f375543ec2c",
                        "target_lang_word": "Platonist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Platonist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7bd0457-70a1-3afb-8917-b9f4d0df89a4",
                                        "entry_id": "6e762459-0f30-30a9-8841-5c1f8c5f2240",
                                        "glosses": [
                                            "A member of the philosophical school of thought established by Plato; a believer in Platonism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b934849-77e7-4a6c-a47e-6b032b2b4685",
                                                "sense_id": "e7bd0457-70a1-3afb-8917-b9f4d0df89a4",
                                                "text": "[St Augustine of Hippo] became of a Maniche, and of a platoniste a good christian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87dd27d7-d36a-3bed-afe6-2c84370e89db",
                                        "entry_id": "6e762459-0f30-30a9-8841-5c1f8c5f2240",
                                        "glosses": [
                                            "One who holds similar beliefs, particularly that abstract ideas are real."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d5e8b0-5680-4aeb-8dd2-01bfad1c1393",
                                                "sense_id": "87dd27d7-d36a-3bed-afe6-2c84370e89db",
                                                "text": "I suspect that in their hearts most working mathematicians are Platonists, in that they take it as a matter of unassailable if unprovable fact that mathematical reality stands apart from the world, and is at least as real as the world, and possibly gives shape to the world, as Plato suggested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4be53d5-3753-376b-bb5a-e8617f122f83",
                                        "entry_id": "6e762459-0f30-30a9-8841-5c1f8c5f2240",
                                        "glosses": [
                                            "A platonic lover."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
