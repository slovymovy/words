                "senses": [
                    {
                        "sense_id": "9f233511-ae3a-329a-90da-e49886d8d32b",
                        "entry_id": "2b1e4a47-6d1c-32c6-a3c9-cfd0200ad8a7",
                        "glosses": [
                            "Variante de matagraboliser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fcde6d6-670a-4454-99a5-9c8d4a7b0bd9",
                                "sense_id": "9f233511-ae3a-329a-90da-e49886d8d32b",
                                "text": "Cela matagrobolise leurs pauvres cervelles. Le droit du bouilleur de cru à bouillir son cru est absolu."
                            },
                            {
                                "example_id": "8c1100f1-3ab2-44aa-8865-a75784128c6a",
                                "sense_id": "9f233511-ae3a-329a-90da-e49886d8d32b",
                                "text": "Dans le cas contraire, il convient d’être en acier trempé pour agréer des gens avec qui l’on n'a aucun point commun, nulle affinité, dont la présence, ce grenouillage, nous matagrobolise."
                            }
                        ]
                    }
