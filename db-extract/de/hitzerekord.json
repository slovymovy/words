                "senses": [
                    {
                        "sense_id": "d85208eb-03a6-3af9-a22f-19a19ef1a6b0",
                        "entry_id": "c26fa8b8-31fe-3bd6-936c-4ffe5cdef803",
                        "glosses": [
                            "höchster erreichter Temperaturwert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8dd0a928-37bc-4faf-a7c2-518a943561ba",
                                "sense_id": "d85208eb-03a6-3af9-a22f-19a19ef1a6b0",
                                "text": "Der Hitzerekord für Hannover liegt bei 38,0 Grad, deutschlandweit bei 40,3 Grad und weltweit bei 57,3 Grad."
                            },
                            {
                                "example_id": "a412b3cf-8161-4278-8530-75ffa02a885d",
                                "sense_id": "d85208eb-03a6-3af9-a22f-19a19ef1a6b0",
                                "text": "„Vor eineinhalb Wochen wurde in Bad Deutsch-Altenburg der Hitzerekord Österreichs gemessen.“"
                            },
                            {
                                "example_id": "9a218550-7730-4c4d-9691-74d4c3324495",
                                "sense_id": "d85208eb-03a6-3af9-a22f-19a19ef1a6b0",
                                "text": "„Der Sommer 2018 wird trotzdem nicht den absoluten Hitzerekord in Deutschland brechen.“"
                            },
                            {
                                "example_id": "8897a92c-45ba-4338-88f2-d6c3a79e7df1",
                                "sense_id": "d85208eb-03a6-3af9-a22f-19a19ef1a6b0",
                                "text": "„Wenige Jahre zuvor war der Hitzerekord aus Al-Aziziya von etablierten Meteorologen angezweifelt worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
