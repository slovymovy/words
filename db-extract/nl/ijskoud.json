                "senses": [
                    {
                        "sense_id": "9108c24e-245b-3b5f-94e0-b41edd17133d",
                        "entry_id": "2b38dc5a-4c9c-30fb-a321-a4b40837454f",
                        "glosses": [
                            "met de temperatuur van ijs, of zo koud als ijs aanvoelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26ccea46-a998-45a5-906b-42107221f7cf",
                                "sense_id": "9108c24e-245b-3b5f-94e0-b41edd17133d",
                                "text": "Hij was bang in het ijskoude water te vallen."
                            },
                            {
                                "example_id": "babe945e-928e-4003-9112-aaaa39f89745",
                                "sense_id": "9108c24e-245b-3b5f-94e0-b41edd17133d",
                                "text": "Het was een ijskoude nacht en ik werd meerdere malen bibberend wakker. Verbaasd zag ik de volgende ochtend dat er een dun laagje ijs op mijn tent lag."
                            },
                            {
                                "example_id": "93cc11be-860d-427a-91f1-30c436e3b3f8",
                                "sense_id": "9108c24e-245b-3b5f-94e0-b41edd17133d",
                                "text": "Er woei een ijskoude wind en Sint trok zijn warme rode mantel dicht om zich heen."
                            }
                        ]
                    },
                    {
                        "sense_id": "d331cbd2-87a5-3996-869b-bc812f316d5b",
                        "entry_id": "2b38dc5a-4c9c-30fb-a321-a4b40837454f",
                        "glosses": [
                            "met een heel lage temperatuur, bijzonder kil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7a567c9-d06e-4549-817f-4df4e662e122",
                                "sense_id": "d331cbd2-87a5-3996-869b-bc812f316d5b",
                                "text": "Een stilstaand molecuul is goed te bestuderen. In Groningen is een molecuul stil gezet met ijskoud gas en elektrische velden."
                            }
                        ]
                    },
                    {
                        "sense_id": "682072ae-81bc-368d-8ea7-a267ddcfcac4",
                        "entry_id": "2b38dc5a-4c9c-30fb-a321-a4b40837454f",
                        "glosses": [
                            "onverstoorbaar, geheel rustig onder spanning, zonder enig medegevoel"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "daaf5040-d17e-4439-8ce2-9e210af2f206",
                                "sense_id": "682072ae-81bc-368d-8ea7-a267ddcfcac4",
                                "text": "Hij bleef er ijskoud onder."
                            },
                            {
                                "example_id": "56b9dd47-ed6e-4f46-8e30-09ab2ce5233c",
                                "sense_id": "682072ae-81bc-368d-8ea7-a267ddcfcac4",
                                "text": "Zijn verwarde gedachteflitsen draaien voortdurend om die ijskoude blik van luitenant Pradelle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bba22e0d-6886-46b1-8831-e0d4a6140249",
                        "source_entry_id": "2b38dc5a-4c9c-30fb-a321-a4b40837454f",
                        "source_sense_id": "9108c24e-245b-3b5f-94e0-b41edd17133d",
                        "source_sense_description": "bijzonder koud, zo koud als ijs",
                        "target_lang_word": "eiskalt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eiskalt",
