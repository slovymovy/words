                    {
                        "form_id": "629f2fc5-3cce-4d86-b8c8-f20fe0496b38",
                        "entry_id": "3f465049-e991-3e66-a6dc-2d0cbca3c2f2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Fluggeräte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c61f4be5-c832-3248-bbc5-517fc0885f96",
                        "entry_id": "3f465049-e991-3e66-a6dc-2d0cbca3c2f2",
                        "glosses": [
                            "unbemanntes technisches Objekt, das sich durch die Luft bewegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06b7d58-2df2-47dc-a62c-b08478f272fc",
                                "sense_id": "c61f4be5-c832-3248-bbc5-517fc0885f96",
                                "text": "„Mit Radaraugen soll das Fluggerät der europäischen Weltraumbehörde Esa dann auf die Eisflächen des Planeten blicken.“"
                            },
                            {
                                "example_id": "d4db103f-2232-4822-9c61-3b6c825ce5ee",
                                "sense_id": "c61f4be5-c832-3248-bbc5-517fc0885f96",
                                "text": "„Laut Aussage der Veranstalter liege die Bestmarke im Drachensteigen derzeit bei 674 Fluggeräten.“"
                            },
                            {
                                "example_id": "9b3b62da-3100-4e55-bed4-cc900cd9d436",
                                "sense_id": "c61f4be5-c832-3248-bbc5-517fc0885f96",
                                "text": "„Das etwa 3,6 Meter lange Fluggerät war zunächst von einem B-52-Bomber in einer Flughöhe von knapp 12200 Meter abgesetzt und dann von einer Rakete auf 30000 Meter Höhe gebracht worden.“"
                            },
                            {
                                "example_id": "60c95bb1-9058-4258-b540-31212b84862e",
                                "sense_id": "c61f4be5-c832-3248-bbc5-517fc0885f96",
                                "text": "„Vor zwei Wochen hatte die US-Armee in einem Memo alle Truppen angewiesen, Drohnen von DJI nicht mehr einzusetzen, die Batterien und Speicherkarten zu entfernen und die Fluggeräte sicher aufzubewahren.“"
                            },
                            {
                                "example_id": "35435309-8288-4bf7-9e02-07bb50ac7fb0",
                                "sense_id": "c61f4be5-c832-3248-bbc5-517fc0885f96",
                                "text": "„Das etwa 1,7 Kilogramm schwere Fluggerät sei nur wenige Meter neben einer Familie mit zwei Kindern am Boden eingeschlagen, berichtete die Polizei am Dienstag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2f9fdd2f-1ec1-38c0-9f08-9b123e9a7962",
                        "entry_id": "3f465049-e991-3e66-a6dc-2d0cbca3c2f2",
                        "glosses": [
                            "technische Konstruktion beziehungsweise Luftfahrzeug, mit dessen Hilfe sich ein Mensch im Luftraum bewegen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f02fbfd-e03e-4b5d-9346-e1ad6d388237",
                                "sense_id": "2f9fdd2f-1ec1-38c0-9f08-9b123e9a7962",
                                "text": "„Vierhundert Jahre vor Lilienthal träumte bereits ein anderes Genie davon, sich mit einem Fluggerät durch die Luft zu bewegen.“"
                            },
                            {
                                "example_id": "94731b02-8f5c-4f06-ad25-b64d0691583e",
                                "sense_id": "2f9fdd2f-1ec1-38c0-9f08-9b123e9a7962",
                                "text": "„Der wesentliche Unterschied zwischen beiden Sportarten besteht in den Fluggeräten.“"
                            },
                            {
                                "example_id": "42541935-0f49-4ccd-885f-563961e37df5",
                                "sense_id": "2f9fdd2f-1ec1-38c0-9f08-9b123e9a7962",
                                "text": "„Denkmal für die gefallenen Luftschiffer: Am 1. Juli 1900 wagte Graf Zeppelin den ersten Flug mit dem nach ihm benannten Fluggerät über den Bodensee.“"
                            },
                            {
                                "example_id": "5f022159-be6c-40e1-bec1-faf79d9abe37",
                                "sense_id": "2f9fdd2f-1ec1-38c0-9f08-9b123e9a7962",
                                "text": "„In einer Zeit, da ein Mittelklassewagen wie der andere aussieht und sich auch moderne Verkehrsflugzeuge im Design nur unwesentlich voneinander unterscheiden, ist der Airbus A 380 eben ein besonderes Fluggerät.“"
                            },
                            {
                                "example_id": "869f81d3-cf95-4ba1-94a0-c67f0db79f21",
                                "sense_id": "2f9fdd2f-1ec1-38c0-9f08-9b123e9a7962",
                                "text": "„Zur ISS wollen in diesem Jahr auch die Europäer aufbrechen, und zwar erstmals mit einem eigenen Fluggerät.“"
                            },
                            {
                                "example_id": "49dad9b3-a825-4cfc-8acd-4fac34c1d88f",
                                "sense_id": "2f9fdd2f-1ec1-38c0-9f08-9b123e9a7962",
                                "text": "„Einen Heißluftballon erwarben französische Ballonfahrer für den Schnäppchenpreis von 6400 Euro - normalerweise kostet ein solches Fluggerät mehrere zehntausend Euro.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
