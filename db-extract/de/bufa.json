            },
            {
                "entry_id": "88dc34c1-7e9e-317c-9baf-828fbdab5127",
                "word": "BUFA",
                "pos": "abbrev",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5b487225-7ff5-3073-9dfa-4e3fbfeb5d57",
                        "entry_id": "88dc34c1-7e9e-317c-9baf-828fbdab5127",
                        "glosses": [
                            "Bild- und Filmamt"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "9af13eac-1bba-4504-8782-78471786cf7e",
                                "sense_id": "5b487225-7ff5-3073-9dfa-4e3fbfeb5d57",
                                "text": "„Aus ihr entwickelte sich 1917 das Bild- und Filmamt (BUFA).“"
                            },
                            {
                                "example_id": "34ddb618-1c60-41b2-a1e9-f683e426edb0",
                                "sense_id": "5b487225-7ff5-3073-9dfa-4e3fbfeb5d57",
                                "text": "„Die deutsche Regierung erkannte schon frühzeitig den Propagandawert des Films und begründete 1915 das „Bild- und Film-Amt“ (BUFA), das dem Reichskriegsministerium unterstand. Auf Anregung des Generals Ludendorff wurde das BUFA Ende 1917 unter finanzieller Beteiligung des Reiches und führender Industrie- und Bankenkreise in einen umfassenden Wirtschaftskonzern umgewandelt: die Universum-Film-AG.“"
                            },
                            {
                                "example_id": "62f3f348-85d4-4395-bf8d-04efba76f5e4",
                                "sense_id": "5b487225-7ff5-3073-9dfa-4e3fbfeb5d57",
                                "text": "„Die gesamte Tätigkeit des BUFA war auf die Einbeziehung des Films in den Dienst der Kriegführung gerichtet und wandte sich besonders der Inlandspropaganda zu.“"
                            },
                            {
                                "example_id": "8131fef1-022f-49fa-8c27-ec07f8981b4a",
                                "sense_id": "5b487225-7ff5-3073-9dfa-4e3fbfeb5d57",
                                "text": "„Zugleich wurde er Hausjurist des Bild- und Filmamtes (BUFA).“"
                            },
                            {
                                "example_id": "9aa5337f-aa2e-4f4e-bea3-6120da5f1f0f",
                                "sense_id": "5b487225-7ff5-3073-9dfa-4e3fbfeb5d57",
                                "text": "„Das Leben des Menschen ist sein wertvollster Besitz, wenn man es so liebt wie Unteroffizier Verdy, der jetzt mit dem Landsturmmann Bertin nach Kloster Poshaitje wandert, weil das Bild-und-Film-Amt, BUFA genannt, Fotos des Klosters angefordert hat.“"
                            },
                            {
                                "example_id": "8b652e48-bd28-4267-84f2-8c410d29ab0e",
                                "sense_id": "5b487225-7ff5-3073-9dfa-4e3fbfeb5d57",
                                "text": "„Dazu kam, dass das Bankkapital sich auch an den Produktionsfirmen beteiligte, als man sah, behördliche Stellen interessieren sich für den Film, wie die Gründung des Bild- und Filmamtes (BUFA) durch das Kriegsministerium zeigte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7bbb2a07-e04f-33e5-9943-e9d3fd34a235",
                        "entry_id": "88dc34c1-7e9e-317c-9baf-828fbdab5127",
                        "glosses": [
                            "Bundesfachschule"
                        ],
                        "tags": [
                            "(Deutschland)",
                            "insbesondere"
                        ],
                        "examples": [
                            {
                                "example_id": "3871bab4-db9b-4e6b-8d3c-efac7fd265cf",
                                "sense_id": "7bbb2a07-e04f-33e5-9943-e9d3fd34a235",
                                "text": "„Übrigens… […] ist die Bezeichnung »Bundesfachschule« (BUFA) ein Hinweis auf die Mitwirkung der Bundesverbände des Handwerks und der Industrie an ihrer Gründung.“"
                            },
                            {
                                "example_id": "e41fbf10-9d32-402a-8de7-39b8d499bf88",
                                "sense_id": "7bbb2a07-e04f-33e5-9943-e9d3fd34a235",
                                "text": "„Bundesfachschule für Sanitär- und Heizungstechnik (BUFA), Bertholdstraße 1, 76131 Karlsruhe“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fcf269aa-eb02-30fa-8974-13ef05c17aae",
                        "entry_id": "88dc34c1-7e9e-317c-9baf-828fbdab5127",
                        "glosses": [
                            "Bundesfachschule für Orthopädie-Technik"
                        ],
                        "tags": [
                            "1957-1981 Frankfurt",
                            "danach Dortmund"
                        ],
                        "examples": [
                            {
                                "example_id": "c1cc35df-a473-43a1-9613-75f634300d57",
                                "sense_id": "fcf269aa-eb02-30fa-8974-13ef05c17aae",
                                "text": "„Die fachspezifischen Studiensemester werden in Zusammenarbeit der Hochschule mit der Bundesfachschule für Orthopädietechnik (BUFA) durchgeführt, so dass ein möglichst hohes Maß an Kenntnissen und klinisch-praktischer Fähigkeiten erworben wird.“"
                            },
                            {
                                "example_id": "affe98ee-5dd4-4750-84cb-43b2f449519c",
                                "sense_id": "fcf269aa-eb02-30fa-8974-13ef05c17aae",
                                "text": "„Ich absolvierte 1956/57 den 6. Lehrgang der Bundesfachschule für Orthopädie-Technik in Frankfurt (BUFA) - Gründung 1954 -, unter der Leitung von Stefan Burger und anschliessend die Meisterprüfung.“"
                            },
                            {
                                "example_id": "2dce0fa2-5f3f-492f-881a-af84f24fd674",
                                "sense_id": "fcf269aa-eb02-30fa-8974-13ef05c17aae",
                                "text": "„Die Realisierung war möglich durch die grenzüberschreitende Zusammenarbeit mit der Internationalen Akademie EUROPA-Schule, Lehrstätte für Rehabilitationstechnik, bekannt unter dem Namen BUFA (Bundesfachschule) in Dortmund.“"
                            },
                            {
                                "example_id": "3341d2cc-ad80-4760-8b7f-ce14bac2842e",
                                "sense_id": "fcf269aa-eb02-30fa-8974-13ef05c17aae",
                                "text": "„Positionierung des mechanischen Drehpunktes nach BUFA* […] *BUFA = Bundesfachschule für Orthopädietechnik, Dortmund, Deutschland – www.ot-bufa.de“"
                            },
                            {
                                "example_id": "4f9aaad5-6c2a-490d-8cb1-243903cf95a5",
                                "sense_id": "fcf269aa-eb02-30fa-8974-13ef05c17aae",
                                "text": "„Leitlinie Unterarmprothesen. Bundesinnungsverband für Orthopädie-Technik (BUFA), 2004“"
                            }
                        ],
                        "sense_index_json": "\"2a\""
                    },
                    {
                        "sense_id": "64ff7a43-df61-3664-940c-137312a21f3f",
                        "entry_id": "88dc34c1-7e9e-317c-9baf-828fbdab5127",
