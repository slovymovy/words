                    },
                    {
                        "translation_id": "84426107-d529-47d5-85a9-7882954ceb41",
                        "source_entry_id": "b440474d-8dff-354a-b937-c3e794db5290",
                        "target_lang_word": "quadrille",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quadrille",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d954f50f-b165-3faf-981e-19891ad175f8",
                                        "entry_id": "a1e93b19-93f0-39d5-a4bd-6ca7c3630ae2",
                                        "glosses": [
                                            "A dance originating in the mid-1700s with four couples forming a square, rather much like the modern square dance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ea00dfa-a599-490c-80c9-c1f503f7c364",
                                                "sense_id": "d954f50f-b165-3faf-981e-19891ad175f8",
                                                "text": "The movements of the other women were more or less similar to Tess's, the whole bevy of them drawing together like dancers in a quadrille at the completion of a sheaf by each, every one placing her sheaf on end against those of the rest, till a shock, or 'stitch' as it was here called, of ten or a dozen was formed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18af12c9-1e24-31e4-a485-2e74950363af",
                                        "entry_id": "a1e93b19-93f0-39d5-a4bd-6ca7c3630ae2",
                                        "glosses": [
                                            "The music for this dance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0acfe6c2-55df-47c1-b762-a595fceed7b6",
                                                "sense_id": "18af12c9-1e24-31e4-a485-2e74950363af",
                                                "text": "There was ol' Mickey Coote\n Who played hard on his flute\n When the ladies lined up for a set\n He was tootin' with skill\n For each sparkling quadrille\n Though the dancers were fluther'd and bet"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d2fdc21-13da-3689-a9e6-9e69b2e88dee",
                                        "entry_id": "a1e93b19-93f0-39d5-a4bd-6ca7c3630ae2",
                                        "glosses": [
                                            "A Spanish trick-taking card game from the 1700s played with a 40-card deck."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "189b6a11-21d5-4289-af30-21126f5f17ce",
                                                "sense_id": "9d2fdc21-13da-3689-a9e6-9e69b2e88dee",
                                                "text": "It now first struck her that she was selected from among her sisters as worthy of being the mistress of Hunsford Parsonage, and of assisting to form a quadrille table at Rosings, in the absence of more eligible visitors."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a134220-6079-3d3a-9d95-7822e8159e19",
                                        "entry_id": "a1e93b19-93f0-39d5-a4bd-6ca7c3630ae2",
                                        "glosses": [
                                            "A choreographed dressage ride, commonly performed to music, with a minimum of four horses."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "quadrille",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f1332de4-5c22-388c-acd4-d27e3fa84817",
                                        "entry_id": "8ad2c926-f5d0-381a-ba25-332b13df614c",
                                        "glosses": [
                                            "To dance the quadrille."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "57847096-26e0-4043-a719-c59246094f83",
                                                "sense_id": "f1332de4-5c22-388c-acd4-d27e3fa84817",
                                                "text": "We quadrilled, waltzed, and conversed, in all of which my clever partner excelled; and her charms, combined with the excellent champagne I imbibed, fairly dazzled my imagination."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quadrille",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6edbaac-6a34-3ed7-9063-acf44bc05b96",
                                        "entry_id": "6151c46d-0434-32b3-b17c-a63e7d210f33",
                                        "glosses": [
                                            "Marked with squares."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "34b2ad2b-7e90-48d8-9b56-df52d5beb655",
                                                "sense_id": "b6edbaac-6a34-3ed7-9063-acf44bc05b96",
                                                "text": "Penknife, hand-lens, padlock key, marching compass and small cash went in his trouser pockets, leaving the tunic pockets for the little black quadrille notebook, pencil and pen, and the breast pockets for his breviary on one side and cigarettes and matches on the other."
                                            },
                                            {
                                                "example_id": "6942e0f7-30ca-4cb4-9eb9-5a0ffeb2670b",
                                                "sense_id": "b6edbaac-6a34-3ed7-9063-acf44bc05b96",
                                                "text": "He would write “one paragraph at time”, always beginning each novel in longhand – he favoured notebooks with quadrille lines (those little squares)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quadrille",
                                "target_lang_code": "en",
