                        ],
                        "examples": [
                            {
                                "example_id": "09db6eae-2195-4834-8f87-03c66d35249c",
                                "sense_id": "c44a6cef-494b-3785-b5d4-4bcb7260af54",
                                "text": "Un tafanari par essence est gros pour ne pas dire énorme, car s'il est petit, c'est un pétard . «T'as vu ce tafanari, elle risque pas de passer au travers de la cuvette des cagadous !»"
                            },
                            {
                                "example_id": "075b4566-977a-49c9-998e-96ef0ef21a97",
                                "sense_id": "c44a6cef-494b-3785-b5d4-4bcb7260af54",
                                "text": "Quel tafanari, dirait Gugusse. Une mappemonde ! A propos vous connaissez la dernière de Marius."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f75a013-19a7-3117-b695-2f567e31d3af",
                        "entry_id": "c3e807f1-962e-3b62-84f3-6df3eff3fa64",
                        "glosses": [
                            "Nom donné par analogie de forme aux grilles de fenêtres dont la partie inférieure est renflée, bombée vers l'extérieur."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "54ea6713-77f8-47c8-b2f8-4a4380a8a36f",
                                "sense_id": "7f75a013-19a7-3117-b695-2f567e31d3af",
                                "text": "Aux fenêtres ornementées de grilles forgées, rebondies à la base, que l'on appelait autrefois des tafanaris, des bacs à géraniums égayaient la rue..."
                            }
                        ]
                    }
