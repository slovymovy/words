{
    "word_family": [
        "latchkey",
        "unlatch"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e1d62c98-c07d-33d5-91a9-4d48a5f33b5e",
                    "sense_definition": "To fasten or close a door or gate using a latch.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fasten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please make sure you <w>latch</w> the garden gate so the dog does not escape.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, не забудь <w>запереть на щеколду</w> садовую калитку, чтобы собака не убежала.",
                                "zh": "请一定把花园门<w>闩好</w>，免得狗跑出去。",
                                "cs": "Prosím, ujisti se, že jsi <w>zavřel na petlici</w> zahradní branku, aby pes neutekl."
                            }
                        },
                        {
                            "text": "She heard the heavy wooden door <w>latch</w> firmly behind her as she entered the house.",
                            "target_lang_translations": {
                                "ru": "Войдя в дом, она услышала, как тяжелая деревянная дверь плотно <w>защёлкнулась</w> за её спиной.",
                                "zh": "她走进屋时，听见身后那扇沉重的木门咔嗒一声<w>闩上</w>了。",
                                "cs": "Když vešla do domu, slyšela, jak těžké dřevěné dveře za ní pevně <w>zaklaply</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fasten",
                        "secure",
                        "close"
                    ],
                    "antonyms": [
                        "unlatch",
                        "open"
                    ],
                    "common_phrases": [
                        "latch the gate",
                        "latch the door"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрывать или запирать дверь или ворота на щеколду или защелку.",
                        "zh": "用门闩或卡扣把门、栅门等关上或扣住。",
                        "cs": "Zavřít nebo zajistit dveře či branku pomocí západky nebo petlice."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запирать на щеколду",
                                "target_lang_sense_clarification": "использовать механический запор"
                            },
                            {
                                "target_lang_word": "защёлкивать",
                                "target_lang_sense_clarification": "закрывать до щелчка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闩上",
                                "target_lang_sense_clarification": "用门闩或卡扣把门、栅门等扣上"
                            },
                            {
                                "target_lang_word": "扣上",
                                "target_lang_sense_clarification": "强调扣紧、关牢"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "zavřít na petlici",
                                "target_lang_sense_clarification": "zajistit dveře mechanickým uzávěrem"
                            },
                            {
                                "target_lang_word": "zaklapnout",
                                "target_lang_sense_clarification": "zavřít dveře až do cvaknutí"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "212be4fb-1939-3215-8962-3b0880cb4116",
                    "sense_definition": "To attach or connect to the breast for feeding.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "breastfeeding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The midwife helped the new mother ensure the baby would <w>latch</w> correctly.",
                            "target_lang_translations": {
                                "ru": "Акушерка помогла молодой маме убедиться, что ребенок правильно <w>захватывает грудь</w>.",
                                "zh": "助产士帮助这位新手妈妈确保宝宝能正确<w>含住乳房</w>。",
                                "cs": "Porodní asistentka pomohla novopečené matce zajistit, aby se miminko správně <w>přisálo</w>."
                            }
                        },
                        {
                            "text": "It can take several days for a newborn to <w>latch</w> on effectively during nursing.",
                            "target_lang_translations": {
                                "ru": "Новорожденному может потребоваться несколько дней, чтобы научиться эффективно <w>прикладываться</w> во время кормления.",
                                "zh": "新生儿在哺乳时通常要过几天才能有效地<w>含乳</w>。",
                                "cs": "Novorozenci může trvat několik dní, než se naučí při kojení efektivně <w>přisát</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "latch on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикладываться или прикрепляться к груди для кормления.",
                        "zh": "指婴儿含住乳房并开始吃奶。",
                        "cs": "Přisát se k prsu za účelem kojení."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захватывать грудь",
                                "target_lang_sense_clarification": "о младенце при кормлении"
                            },
                            {
                                "target_lang_word": "прикладываться",
                                "target_lang_sense_clarification": "к груди"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "含住乳房",
                                "target_lang_sense_clarification": "指婴儿正确含住乳房开始吃奶"
                            },
                            {
                                "target_lang_word": "含乳",
                                "target_lang_sense_clarification": "较简洁说法，多用于哺乳语境"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "přisát se",
                                "target_lang_sense_clarification": "o dítěti při kojení"
                            },
                            {
                                "target_lang_word": "chytit se prsu",
                                "target_lang_sense_clarification": "správné uchopení bradavky dítětem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "28071657-26c6-33e3-8a81-247295ae5c5c",
                    "sense_definition": "To catch or lay hold of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grasp",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective managed to <w>latch</w> onto a vital piece of evidence that solved the case.",
                            "target_lang_translations": {
                                "ru": "Детективу удалось <w>зацепиться</w> за важную улику, которая помогла раскрыть дело.",
                                "zh": "侦探设法<w>抓住</w>了一条关键证据，最终破了案。",
                                "cs": "Detektivovi se podařilo <w>chytit</w> klíčového důkazu, který pomohl případ vyřešit."
                            }
                        },
                        {
                            "text": "He tried to <w>latch</w> the falling rope before it slipped out of reach.",
                            "target_lang_translations": {
                                "ru": "Он попытался <w>схватить</w> падающую веревку, прежде чем она выскользнула из рук.",
                                "zh": "绳子快要掉到够不着的地方之前，他试着把它<w>抓住</w>。",
                                "cs": "Pokusil se <w>popadnout</w> padající lano, než mu vyklouzlo z dosahu."
                            }
                        }
                    ],
                    "synonyms": [
                        "grasp",
                        "seize",
                        "clutch"
                    ],
                    "antonyms": [
                        "release",
                        "drop"
                    ],
                    "common_phrases": [
                        "latch onto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухватиться за что-либо или зацепиться за идею/улику.",
                        "zh": "抓住、攫住某物；也可引申为抓住线索或证据。",
                        "cs": "Chytit nebo uchopit něco; přeneseně se něčeho chytit (např. myšlenky nebo důkazu)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухватиться",
                                "target_lang_sense_clarification": "за предмет или идею"
                            },
                            {
                                "target_lang_word": "зацепиться",
                                "target_lang_sense_clarification": "за информацию или улику"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抓住",
                                "target_lang_sense_clarification": "抓住具体物体，也可引申为抓住线索"
                            },
                            {
                                "target_lang_word": "攫住",
                                "target_lang_sense_clarification": "强调一下子攫住、握住"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "chytit se",
                                "target_lang_sense_clarification": "uchopit předmět nebo se zachytit myšlenky"
                            },
                            {
                                "target_lang_word": "popadnout",
                                "target_lang_sense_clarification": "rychle uchopit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6f26302e-4d37-3cf3-b936-a75160ad4413",
                    "sense_definition": "To smear or anoint.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anoint",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spirit was told to <w>latch</w> the sleeping man's eyes with the magic juice.",
                            "target_lang_translations": {
                                "ru": "Духу велели <w>смазать</w> глаза спящего волшебным соком.",
                                "zh": "有人吩咐那精灵把魔汁<w>涂</w>在熟睡男子的眼睛上。",
                                "cs": "Duchovi bylo řečeno, aby spícímu muži <w>potřel</w> oči kouzelnou šťávou."
                            }
                        },
                        {
                            "text": "In the old play, the character would <w>latch</w> the potion onto the victim's eyelids.",
                            "target_lang_translations": {
                                "ru": "В старинной пьесе герой <w>наносил</w> зелье на веки жертвы.",
                                "zh": "在那部古老的戏剧里，那个角色会把药水<w>涂抹</w>在受害者的眼睑上。",
                                "cs": "Ve staré hře postava <w>nanášela</w> lektvar na oční víčka oběti."
                            }
                        }
                    ],
                    "synonyms": [
                        "anoint",
                        "smear"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in historical literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Смазывать или помазывать (устаревшее).",
                        "zh": "涂抹，涂在……上面；古旧用法。",
                        "cs": "Potřít nebo pomazat (zastaralé)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "смазывать",
                                "target_lang_sense_clarification": "наносить жидкость или мазь"
                            },
                            {
                                "target_lang_word": "помазать",
                                "target_lang_sense_clarification": "архаичное использование"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涂抹",
                                "target_lang_sense_clarification": "把液体、药膏等抹上去"
                            },
                            {
                                "target_lang_word": "涂",
                                "target_lang_sense_clarification": "文言或古旧用法，指涂擦、敷抹"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "potřít",
                                "target_lang_sense_clarification": "nanést vrstvu tekutiny nebo masti"
                            },
                            {
                                "target_lang_word": "pomazat",
                                "target_lang_sense_clarification": "knižní nebo archaický výraz"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea362870-a609-3d1c-aa76-2d11ddac74cc",
                    "sense_definition": "A mechanical fastening for a door or gate, typically consisting of a bar that falls into a notch.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fastener",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal <w>latch</w> clicked shut, signaling that the shed was finally secure.",
                            "target_lang_translations": {
                                "ru": "Металлическая <w>защёлка</w> щелкнула, сигнализируя о том, что сарай наконец заперт.",
                                "zh": "金属<w>门闩</w>咔嗒一声扣上了，说明棚屋终于锁好了。",
                                "cs": "Kovová <w>petlice</w> cvakla, což znamenalo, že kůlna je konečně zajištěna."
                            }
                        },
                        {
                            "text": "He lifted the <w>latch</w> and pushed the heavy oak door open.",
                            "target_lang_translations": {
                                "ru": "Он поднял <w>щеколду</w> и толкнул тяжелую дубовую дверь.",
                                "zh": "他抬起<w>门闩</w>，推开了那扇沉重的橡木门。",
                                "cs": "Zvedl <w>západku</w> a zatlačil na těžké dubové dveře, aby je otevřel."
                            }
                        }
                    ],
                    "synonyms": [
                        "catch",
                        "fastener",
                        "bolt"
                    ],
                    "common_phrases": [
                        "door latch",
                        "gate latch",
                        "lift the latch"
                    ],
                    "target_lang_definitions": {
                        "ru": "Механический запор для двери или ворот, обычно состоящий из пластины или стержня.",
                        "zh": "门、栅门等上的机械扣件，通常是落入卡槽中的横闩或卡扣。",
                        "cs": "Mechanický uzávěr dveří nebo branky, obvykle tvořený pohyblivou tyčí nebo západkou."
                    },
                    "translations": {
