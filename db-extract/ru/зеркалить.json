                "senses": [
                    {
                        "sense_id": "fde7f5ef-16c3-3744-86fe-682bab16c684",
                        "entry_id": "cbf74b51-c77d-3383-84e3-5bf3ee72e555",
                        "glosses": [
                            "отражать как в зеркале"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22f60203-fe41-46ee-a209-50e945c41942",
                                "sense_id": "fde7f5ef-16c3-3744-86fe-682bab16c684",
                                "text": "Догоравшая заря зеркалила тихую воду с силуэтами островов."
                            },
                            {
                                "example_id": "a943cd79-2264-48ac-a2b1-07177f854004",
                                "sense_id": "fde7f5ef-16c3-3744-86fe-682bab16c684",
                                "text": "Перрон был чисто вымыт и зеркалил ― господин Пьер Ч. видел всего себя под ногами."
                            }
                        ]
                    },
                    {
                        "sense_id": "0c62b9ff-0a68-3c71-bff3-64fd1066dbf7",
                        "entry_id": "cbf74b51-c77d-3383-84e3-5bf3ee72e555",
                        "glosses": [
                            "неол. разг. подражать, копировать как в зеркале"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd7f30f-60d2-4503-be62-674297989641",
                                "sense_id": "0c62b9ff-0a68-3c71-bff3-64fd1066dbf7",
                                "text": "А главное — посмотрите на их лучезарные улыбки и позы: лишь любящие люди умеют так зеркалить друг друга."
                            }
                        ]
                    },
                    {
                        "sense_id": "2b305c13-a499-3a75-9cc8-7d9e493485b3",
                        "entry_id": "cbf74b51-c77d-3383-84e3-5bf3ee72e555",
                        "glosses": [
                            "комп. жарг. то же, что зеркалировать; создавать зеркальные копии"
                        ],
