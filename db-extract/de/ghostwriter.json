                "senses": [
                    {
                        "sense_id": "91300ee3-6976-35ab-a8f3-5ee776313b5f",
                        "entry_id": "023fbdcd-d0cb-3cbb-b89c-1cc2f89686d8",
                        "glosses": [
                            "Person, die für jemand anderen Texte verfasst, aber als Autor nicht genannt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a26adc65-5ed2-4b0d-905e-fe394a48c9fc",
                                "sense_id": "91300ee3-6976-35ab-a8f3-5ee776313b5f",
                                "text": "„Es gibt weiterhin den Verdacht, dass er die Arbeit nicht selbst verfasst hat, dass es einen Ghostwriter gab.“"
                            },
                            {
                                "example_id": "2e2a19ec-7268-4111-8a06-22b6a0718f95",
                                "sense_id": "91300ee3-6976-35ab-a8f3-5ee776313b5f",
                                "text": "„Mein einstiger Dozent scheint sich hingegen leergeschrieben zu haben, sonst hätte er mich nicht als Ghostwriter in Dienst gestellt.“"
                            },
                            {
                                "example_id": "ccf90ba2-f29b-4f01-8017-a4aa0accdb85",
                                "sense_id": "91300ee3-6976-35ab-a8f3-5ee776313b5f",
                                "text": "„Bevor ich antworten konnte, fragte er mich, womit ich jetzt mein Geld verdiene, und ich erzählte ihm von meinen Aufträgen als Ghostwriterin eines Ghostwriters.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
