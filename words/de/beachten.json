                    "examples": [
                        {
                            "text": "Er war so vertieft in seine Arbeit, dass er die Besucher gar nicht <w>beachtete</w>.",
                            "target_lang_translations": {
                                "en": "He was so absorbed in his work that he did not <w>notice</w> the visitors at all.",
