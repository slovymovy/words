                "senses": [
                    {
                        "sense_id": "40e1a929-3083-33e1-a26c-1b3c2f067c5e",
                        "entry_id": "4b4178c8-2906-33a3-9640-f90f46a53624",
                        "glosses": [
                            "einmalig vergebene Nummer zu einer Bestellung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75d04be5-6598-4cf0-a7b6-a7effdd1fb0d",
                                "sense_id": "40e1a929-3083-33e1-a26c-1b3c2f067c5e",
                                "text": "„Die darin genannte Bestellungsnummer geben Sie bitte bei Ihrer Überweisung als Verwendungszweck an.“"
                            },
                            {
                                "example_id": "03ad6253-a619-41f4-a199-f3be8c76d9f7",
                                "sense_id": "40e1a929-3083-33e1-a26c-1b3c2f067c5e",
                                "text": "„Um Ihre Bestellung zu verfolgen geben Sie bitte die Bestellnummer ein und bestätigen Sie. Die Bestellungsnummer haben Sie mit der Bestellbestätigung per E-Mail erhalten.“"
                            },
                            {
                                "example_id": "cd2befe5-60ca-4eb2-a656-2d3b503999ee",
                                "sense_id": "40e1a929-3083-33e1-a26c-1b3c2f067c5e",
                                "text": "In jedem größeren Unternehmen werden individuell, so wie der Auftrag angenommen wird, fortlaufende Bestellungsnummern vergeben."
                            },
                            {
                                "example_id": "ddd7e2d6-2636-4273-a39b-78088fafd476",
                                "sense_id": "40e1a929-3083-33e1-a26c-1b3c2f067c5e",
                                "text": "Unter der Bestellungsnummer werden alle bestellten Artikel erfasst und aus dem Lager geholt, verpackt und später mit einem Lieferschein an den Kunden versendet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
