                ],
                "senses": [
                    {
                        "sense_id": "858eb0cc-dfcd-3701-8417-55dcefcc02a4",
                        "entry_id": "167ea6f7-f48c-3665-adb5-857b01fa26a5",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ad75be-3d06-43ba-b282-48fbee9168c4",
                                "sense_id": "858eb0cc-dfcd-3701-8417-55dcefcc02a4",
                                "text": "Frau Eisenmenger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1b7a80b6-f87e-484d-b3f5-eb457e1ea590",
                                "sense_id": "858eb0cc-dfcd-3701-8417-55dcefcc02a4",
                                "text": "Herr Eisenmenger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "72185eda-ce11-4142-abfe-5cb769e5fee7",
                                "sense_id": "858eb0cc-dfcd-3701-8417-55dcefcc02a4",
                                "text": "Die Eisenmengers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "2a48c719-1258-43c5-8d1c-309fc6642ed4",
                                "sense_id": "858eb0cc-dfcd-3701-8417-55dcefcc02a4",
                                "text": "Der Eisenmenger trägt nie die Schals, die die Eisenmenger ihm strickt."
                            },
                            {
                                "example_id": "11a22885-3d76-4388-87aa-0f0a1587a288",
                                "sense_id": "858eb0cc-dfcd-3701-8417-55dcefcc02a4",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Eisenmenger kommt, geht der Herr Eisenmenger.“"
                            },
                            {
                                "example_id": "72cd475c-3ea3-460a-8e16-3747a89acca9",
                                "sense_id": "858eb0cc-dfcd-3701-8417-55dcefcc02a4",
                                "text": "Eisenmenger kommt und geht."
                            },
                            {
                                "example_id": "8ab699c4-7f6a-492e-a4f0-6fe2d4de2e6d",
                                "sense_id": "858eb0cc-dfcd-3701-8417-55dcefcc02a4",
                                "text": "Eisenmengers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
