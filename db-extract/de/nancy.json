                "senses": [
                    {
                        "sense_id": "93a8b6ee-2f68-301b-9da2-69e8ded125cf",
                        "entry_id": "88aaa4fc-73f6-350d-bbb5-1ad37c9c8dc8",
                        "glosses": [
                            "Hauptstadt des französischen Départements Meurthe-et-Moselle in Lothringen/Grand Est"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f482310-5f1b-49ca-90ff-8a299da00bf5",
                                "sense_id": "93a8b6ee-2f68-301b-9da2-69e8ded125cf",
                                "text": "„In Nancy feiert man den heiligen Nikolaus 40 Tage lang mit Nikolausdörfern, Animationen, Karussells und Riesenrädern.“"
                            },
                            {
                                "example_id": "ccf97da9-e417-4096-b068-6eb63b417574",
                                "sense_id": "93a8b6ee-2f68-301b-9da2-69e8ded125cf",
                                "text": "„Ich brachte etwa zwölf Tage in Nancy damit zu, dem jungen Wildfang Anweisungen zu geben und die Mutter zu überzeugen, daß sie sich damit begnügen müsse, die sehr untertänige Dienerin der Gräfin Lascaris zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0790e097-e772-4efd-ab03-5ae99bf1b39a",
                        "source_entry_id": "88aaa4fc-73f6-350d-bbb5-1ad37c9c8dc8",
                        "source_sense_id": "93a8b6ee-2f68-301b-9da2-69e8ded125cf",
