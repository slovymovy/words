                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6542bde-124f-4d45-a40b-95b9c5e8cb58",
                                                "sense_id": "48e9881c-554b-3bec-ad55-5f04f9dc748a",
                                                "text": "With a \"peep\" from a high-pitched whistle, the train would leave by the crossover to the down line, […]."
                                            },
                                            {
                                                "example_id": "d00d1a69-30f1-48c5-9027-027006e5d3a7",
                                                "sense_id": "48e9881c-554b-3bec-ad55-5f04f9dc748a",
                                                "text": "She knew some Dutch and spoke a high-pitched stressless English."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "352ac777-2b6c-37b8-83b3-07c5df6af975",
