                    {
                        "translation_id": "d83801c2-18d6-4ba9-874c-4aef32987fe8",
                        "source_entry_id": "09daa752-f24c-355b-91f3-582cae3d8395",
                        "source_sense_description": "Oiseau marin du genre Fulmarus (1):",
                        "target_lang_word": "fulmar",
