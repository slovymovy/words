                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colombino",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "a19520c6-5e29-3f5d-80ce-f3c705e6dcf1",
                                        "entry_id": "db1d8170-06b1-3ea6-bf64-4a08cb1302a9",
                                        "glosses": [
                                            "Perteneciente a Cristóbal Colón o relacionado con él."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40f60435-f9f2-4f3b-bd07-67939613c071",
                                                "sense_id": "a19520c6-5e29-3f5d-80ce-f3c705e6dcf1",
                                                "text": "Corresponde al gran ciclo de los descubrimientos colombinos, ya que todos los viajes fueron dirigidos por el Almirante en uso del monopolio concertado con la Corona."
                                            }
