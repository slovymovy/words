                "senses": [
                    {
                        "sense_id": "5ba93c6f-27c5-39a1-9534-b3d98113c5d2",
                        "entry_id": "d294f1a2-dd32-37d2-b171-4a899d76b755",
                        "glosses": [
                            "Rauschmittel, das den Konsumenten aufputscht"
                        ],
                        "tags": [
                            "Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "70c84bcb-086a-4e77-992a-3e47a1219b80",
                                "sense_id": "5ba93c6f-27c5-39a1-9534-b3d98113c5d2",
                                "text": "„Dass wir mit dem Rausch der Giganten nicht mithalten konnten und wollten, wurde uns schnell bewusst. Sonst hätten wir irgendwann auch Ameisen schnupfen müssen und so hart ist dann doch nur Ozzy Osbourne. Überhaupt: Heroin, Koks, LSD, Upper, Downer, Schmerztabletten - in ihren Hochzeiten schmissen alle Großen alles ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6f6b21b2-c616-411d-9493-0bf707c17bef",
                        "source_entry_id": "d294f1a2-dd32-37d2-b171-4a899d76b755",
                        "source_sense_id": "5ba93c6f-27c5-39a1-9534-b3d98113c5d2",
                        "source_sense_description": "Jargon: Rauschmittel, das den Konsumenten aufputscht",
                        "target_lang_word": "upper",
