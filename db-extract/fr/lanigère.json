                "senses": [
                    {
                        "sense_id": "d6f98723-9746-3564-b833-73c1f8f1bfb0",
                        "entry_id": "b5e675a8-010e-37c7-b75c-8502350f88a9",
                        "glosses": [
                            "Qui porte de la laine, en parlant d’un animal."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "9be6e1db-38de-49cd-9fea-426e1625676e",
                                "sense_id": "d6f98723-9746-3564-b833-73c1f8f1bfb0",
                                "text": "Les fruits de l’Aigremoine, du Myosotis lappula, du Galium aparine, du Sanicula , etc., sont pourvus d’hameçons, au moyen desquels ils s’accrochent à la toison des animaux lanigères, et ils voyagent avec eux."
                            }
                        ]
                    },
                    {
                        "sense_id": "669cee23-75b8-3a3a-952e-5a84b53699e2",
                        "entry_id": "b5e675a8-010e-37c7-b75c-8502350f88a9",
                        "glosses": [
                            "Qui est recouvert d’un duvet ayant l’apparence de la laine."
                        ],
                        "tags": [
                            "analogy",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e8ab1dec-248c-4d7d-8c17-64421ffae442",
                                "sense_id": "669cee23-75b8-3a3a-952e-5a84b53699e2",
                                "text": "Ce sont les genévriers, les chèvrefeuilles, les églantiers, qui posent leur vert clair parmi le vert blanchâtre des cistes lanigères, les masses vert sombre des chênes kermès et les points d’exclamation presque noirs des cyprès."
                            }
                        ]
                    },
                    {
                        "sense_id": "9c031050-0622-3fd2-a443-597e8be1bd91",
                        "entry_id": "b5e675a8-010e-37c7-b75c-8502350f88a9",
                        "glosses": [
                            "(Non désuet) Puceron lanigère : espèce de puceron, parasite du pommier."
                        ],
                        "tags": [
                            "specifically"
                        ],
                        "examples": [
                            {
                                "example_id": "a80fb142-2a2f-4273-9943-e470a3615b0f",
                                "sense_id": "9c031050-0622-3fd2-a443-597e8be1bd91",
                                "text": "Cotonneux, tout couvert d’une ouate blanche de cheveux et de barbe, il ressemblait à un pommier envahi par le puceron lanigère."
                            },
                            {
                                "example_id": "3510a40c-639d-4000-8c5c-0c78a4c3de6e",
                                "sense_id": "9c031050-0622-3fd2-a443-597e8be1bd91",
                                "text": "Mis à part le puceron vert, les pucerons sont aujourd’hui moins à craindre ; ainsi, le puceron lanigère, autrefois redouté, se développe moins facilement grâce à l’introduction de porte-greffes résistants."
                            }
                        ]
                    }
