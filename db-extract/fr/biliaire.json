                ],
                "senses": [
                    {
                        "sense_id": "76f66e27-79dd-307b-b8de-01485fb814ec",
                        "entry_id": "87f86cdc-b421-3404-8877-52c51d01f646",
                        "glosses": [
                            "Relatif à la bile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67416af9-5387-4435-95fe-48caf0f01413",
                                "sense_id": "76f66e27-79dd-307b-b8de-01485fb814ec",
                                "text": "Portion du foie du Porc, injectée, destinée à montrer les rapports des conduits biliaires et des veinules portales."
                            },
                            {
                                "example_id": "3bdc1733-5553-4132-98dc-7ffcbcc67d39",
                                "sense_id": "76f66e27-79dd-307b-b8de-01485fb814ec",
                                "text": "Sylvius avait déjà fait observer que les bœufs qui, pendant l'hiver, sont affectés de concrétions biliaires, se guérissent au printemps en mangeant les feuilles et les tiges de chiendent dans les pâturages."
                            },
                            {
                                "example_id": "5518d134-fc96-496d-ad16-db46bde6f04b",
                                "sense_id": "76f66e27-79dd-307b-b8de-01485fb814ec",
                                "text": "Ces données fournies par l’épreuve de l’atropine pourraient faire conclure que l’intoxication biliaire porte à la fois sur le cœur et sur le pneumogastrique."
                            }
                        ]
                    }
                ],
