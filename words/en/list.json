                            }
                        },
                        {
                            "text": "Strong winds caused the tall ship to <w>list</w> to the left.",
                            "target_lang_translations": {
                                "ru": "Сильный ветер заставил высокий корабль <w>накрениться</w> влево.",
                                "zh": "强风导致这艘高大的船向左<w>倾斜</w>。"
                            }
                        }
