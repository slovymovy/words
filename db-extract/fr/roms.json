                                    },
                                    {
                                        "sense_id": "08308ae7-527a-3532-81a6-efed9633a08b",
                                        "entry_id": "f702ad4f-94b1-39b2-8364-f2818eeeea61",
                                        "glosses": [
                                            "Trivialname einiger Pilze",
                                            "des Reifpilzes"
