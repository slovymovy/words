                ],
                "senses": [
                    {
                        "sense_id": "38b3eff2-d16c-3845-bf25-b290f3745d5a",
                        "entry_id": "62964718-8153-327a-afcb-91236210fa04",
                        "glosses": [
                            "durch Druck in die Höhe gepresste Wassersäule, entweder auf natürlichem Weg (beispielsweise infolge von Hitze) oder künstlich mit Hilfe einer Pumpe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8fb23d01-77f9-461e-bc5d-64ea33fc3280",
                                "sense_id": "38b3eff2-d16c-3845-bf25-b290f3745d5a",
                                "text": "„Er heißt Strokkur und schießt touristengruppenfreundlich alle drei bis sieben Minuten eine Wasserfontäne in die Luft.“"
                            },
                            {
                                "example_id": "600c871b-3634-451b-be1d-ad89ef246432",
                                "sense_id": "38b3eff2-d16c-3845-bf25-b290f3745d5a",
                                "text": "Künstlerisch großartig ist vor allem die Szene, in der der Wal das Schiff zerstört und in seinem Strudel in die Tiefen reißt: Wrackteile fliegen durch die Luft, Wellen spitzen dem Betrachter entgegen und über allem schwebt Moby Dick mit seiner riesigen Wasserfontäne."
                            },
                            {
                                "example_id": "a19aac86-3e49-4cb0-a8ff-b25f49a973b4",
                                "sense_id": "38b3eff2-d16c-3845-bf25-b290f3745d5a",
                                "text": "Ein Bild stammt aus der Wende vom 19. zum 20. Jahrhundert. Es zeigt einen runden Platz mit einem Brunnen in der Mitte, aus dem eine mehrere Meter hohe Wasserfontäne in die Luft steigt."
                            },
                            {
                                "example_id": "b5b06e89-8aaa-4825-941c-81effd0df8c7",
                                "sense_id": "38b3eff2-d16c-3845-bf25-b290f3745d5a",
                                "text": "Mit Wasserfontänen beginnt der letzte Akt des Staatsbesuches der Queen in Berlin. Erst links, dann rechts schießt das Wasser in die Höhe. Denn kurz bevor die Queen aus dem Hotel Adlon kommt, werden die beiden Springbrunnen auf dem Pariser Platz vor dem Brandenburger Tor angestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a78bc91-251a-437e-91a8-5e17a6d27a2d",
                        "source_entry_id": "62964718-8153-327a-afcb-91236210fa04",
                        "source_sense_id": "38b3eff2-d16c-3845-bf25-b290f3745d5a",
                        "target_lang_word": "fountain",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fountain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7406d889-dd78-3aeb-a982-3f0820e47891",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "A natural source of water; a spring."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7293e4a4-2dba-404e-accd-7fb8f8d81459",
                                                "sense_id": "7406d889-dd78-3aeb-a982-3f0820e47891",
                                                "text": "A little fountaine became a riuer, and there was light, & the Sunne, and much water: this riuer is Eſther, whō the King married and made Queene."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2387f1b1-f023-3406-bcf5-48f5b7cc9728",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "An artificial, usually ornamental, water feature (usually in a garden or public place) consisting of one or more streams of water originating from a statue or other structure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64014479-0227-495f-a3b4-1658b14571af",
                                                "sense_id": "2387f1b1-f023-3406-bcf5-48f5b7cc9728",
                                                "text": "His house is right beside that fountain on Street 15."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc805e3b-1993-3f7f-93df-ef8c04f17c61",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "The structure from which an artificial fountain can issue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ecf0855-4502-4fa0-b8aa-053d21ba78b4",
                                                "sense_id": "cc805e3b-1993-3f7f-93df-ef8c04f17c61",
                                                "text": "As they turned into Hertford Street they startled a robin from the poet's head on a barren fountain, and he fled away with a cameo note."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d5e7f51-35d6-3cc5-8977-da7e409cc7d2",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "A reservoir from which liquid can be drawn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a877f8e2-a080-491c-a226-cb0c2600e1aa",
                                                "sense_id": "2d5e7f51-35d6-3cc5-8977-da7e409cc7d2",
                                                "text": "They heard her rouse the sleeping servant, and with her enter the kitchen; then the noise of a fire being lighted and the fountain being filled came to the watchers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72d30a89-4e0d-3065-a7fc-1807b4bff4f3",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "A source or origin of a flow (e.g., of favors or knowledge)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "123d1484-0013-4e5e-8d4c-16ac40a050ab",
                                                "sense_id": "72d30a89-4e0d-3065-a7fc-1807b4bff4f3",
                                                "text": "Nothing will pleaſe ſome Men, but Books ſtuff’d with Antiquity, groaning under the weight of Learned Quotations drawn from the Fountains: And what is all this but Pilfering."
                                            },
                                            {
                                                "example_id": "a1f2ec51-a8c7-4f5d-b5cd-cbdd75c6981f",
                                                "sense_id": "72d30a89-4e0d-3065-a7fc-1807b4bff4f3",
                                                "text": "My lighter moods are like to these,\n⁠That out of words a comfort win;\n⁠But there are other griefs within,\nAnd tears that at their fountain freeze; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0034a7b0-e703-33db-b96e-139b4bb739b0",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "A roundel barry wavy argent and azure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b2d8d96-efbc-45fb-b863-fe905202730e",
                                                "sense_id": "0034a7b0-e703-33db-b96e-139b4bb739b0",
                                                "text": "Crest : A boar's head couped gold semy of fountains armed gules. Motto : REMIS VELISQUE. Granted by the College of Arms 1966."
                                            },
                                            {
                                                "example_id": "9f31d417-e0e1-4cda-94c3-d040d02a79d8",
                                                "sense_id": "0034a7b0-e703-33db-b96e-139b4bb739b0",
                                                "text": "Argent, seme of fountains on a chief azure a Lorraine cross and an oak leaf of the first. Crest, None. Motto, Able and Ready. The blue of the shield represents Infantry. The fountains are emblematic of Arizona,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bea014f1-38d7-323d-b026-faf0238caca8",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "A juggling pattern typically done with an even number of props where each prop is caught by the same hand that throws it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d0e904bf-7122-3513-9219-7f59ac39a8d1",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "A soda fountain."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "177bbccf-eb95-431b-be35-e27a5959d5dd",
                                                "sense_id": "d0e904bf-7122-3513-9219-7f59ac39a8d1",
                                                "text": "He takes out a soup bowl, fills it with Pepsi from the fountain, and places it carefully on the counter in front of the boy. “That'll be a quarter,” he says professionally."
                                            },
                                            {
                                                "example_id": "7705f21c-bee7-47cf-9e68-0122c5155ea3",
                                                "sense_id": "d0e904bf-7122-3513-9219-7f59ac39a8d1",
                                                "text": "A Sproke was a soft drink Gloria and I had created with Jimbo’s help at the Banana Shack. It was basically fountain Coke mixed with fountain Sprite."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c217f71-22d9-3e6b-8b3a-e80f983070f3",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "A drink poured from a soda fountain, or the cup it is poured into."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1583f2c5-e14f-3930-abe8-0dc5ae5e2aef",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "A ground-based firework that projects sparks similar to a water fountain."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb736e9d-dc2b-3f9a-bba2-dea9f3c2925c",
                                        "entry_id": "6e63e0c5-7b41-332a-9927-7ff4d0ade270",
                                        "glosses": [
                                            "Anything that resembles a fountain in operation."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91c36c38-927f-443b-86ca-2bcdb57d5c22",
                                                "sense_id": "bb736e9d-dc2b-3f9a-bba2-dea9f3c2925c",
                                                "text": "Travellers over the London & North Western main line in bygone days will need no reminder of the pattering of cinders on the carriage roofs, the fountains of sparks from the chimneys at night and the distance from which the exhaust of approaching locomotives could be heard, due to the fierceness of their blast in such conditions."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fountain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f77fccac-bbf4-3ac6-ac84-dbabe8ab60b9",
                                        "entry_id": "f04fe7dd-6377-3176-94f9-3be062f40b9c",
                                        "glosses": [
                                            "To flow or gush as if from a fountain."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efc35cfa-d0b1-45fc-9276-996604b9cbc4",
                                                "sense_id": "f77fccac-bbf4-3ac6-ac84-dbabe8ab60b9",
                                                "text": "Lava fountained from the volcano."
                                            },
                                            {
                                                "example_id": "1d4e1cb7-adf1-4927-827b-6e247564a3fd",
                                                "sense_id": "f77fccac-bbf4-3ac6-ac84-dbabe8ab60b9",
                                                "text": "The fireflies swept toward him from all directions, in streams and rivers and currents of light, a vortex a hundred yards across, spiraling into the brighter center. They met over his supine body like ocean breakers, cascading, fountaining into the air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
