                "senses": [
                    {
                        "sense_id": "ff304619-671a-3a26-8e0d-d69973ffcfaf",
                        "entry_id": "131f950a-3b79-3610-b01b-59cad2846c9d",
                        "glosses": [
                            "спец. делать пилой надрез, надпиливать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46ef9ab5-a772-4923-a5d5-750367a61876",
                                "sense_id": "ff304619-671a-3a26-8e0d-d69973ffcfaf",
                                "text": "Запиливать стропильные рейки рекомендуется непосредственно при закреплении."
                            }
                        ]
                    },
                    {
                        "sense_id": "5cb6aca6-7bf9-3ac9-a188-9d9dbea8dfd2",
                        "entry_id": "131f950a-3b79-3610-b01b-59cad2846c9d",
                        "glosses": [
                            "спец. снимать напильником"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85474542-8827-496f-ad32-bb398f369242",
                                "sense_id": "5cb6aca6-7bf9-3ac9-a188-9d9dbea8dfd2",
                                "text": "Выступающие части винтов запиливают и зачищают."
                            },
                            {
                                "example_id": "b4c0b236-7200-41c6-9f46-c558fb5a1586",
                                "sense_id": "5cb6aca6-7bf9-3ac9-a188-9d9dbea8dfd2",
                                "text": "Когда соединение остынет, снимают охладители и формочку, место сварки зачищают стальной щёткой от остатков флюса и промывают бензином, а неровность шва запиливают напильником."
                            }
                        ]
                    },
                    {
                        "sense_id": "29d2b9b3-d035-37d4-a458-7ff5af0a3596",
                        "entry_id": "131f950a-3b79-3610-b01b-59cad2846c9d",
                        "glosses": [
                            "разг. замучивать, изводить (попрёками, придирками и т. п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06b3c657-4e21-4fd9-9335-707a77d1dd57",
                                "sense_id": "29d2b9b3-d035-37d4-a458-7ff5af0a3596",
                                "text": "В деньгах разве лишь не купается, а мужа до полусмерти запиливала, что зарплату не получает."
                            }
                        ]
                    },
                    {
                        "sense_id": "e409d009-c27d-33c5-83ce-8454b58ce5fb",
                        "entry_id": "131f950a-3b79-3610-b01b-59cad2846c9d",
                        "glosses": [
                            "жарг. портить в результате частого, интенсивного использования"
                        ],
                        "tags": [],
                        "examples": []
                    }
