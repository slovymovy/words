                        ],
                        "form": "die Momentaufnahmen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "92a1c5c5-7ebe-38b2-9d1a-6a5cd8c24e55",
                        "entry_id": "a2f354ec-19f8-301a-a6fd-06d85940eb80",
                        "glosses": [
                            "eine Aufnahme mit kurzer Belichtungszeit"
                        ],
                        "tags": [
                            "Fotografie"
                        ],
                        "examples": [
                            {
                                "example_id": "63b2de7f-66dd-4f8b-8f81-ed9a790dbf97",
                                "sense_id": "92a1c5c5-7ebe-38b2-9d1a-6a5cd8c24e55",
                                "text": "Auf der Momentaufnahme sieht man ihn beim Verlassen des Hauses."
                            },
                            {
                                "example_id": "d8d9627d-9569-4aa8-b5ee-d9181a63c737",
                                "sense_id": "92a1c5c5-7ebe-38b2-9d1a-6a5cd8c24e55",
                                "text": "„Fast kam es Ari wie die Momentaufnahme einer Theaterbühne vor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "15cf6d1a-4c05-3c00-af0c-8cd251e14a29",
                        "entry_id": "a2f354ec-19f8-301a-a6fd-06d85940eb80",
                        "glosses": [
                            "Status ohne Verbindung zum Vorher"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "ede0328d-5825-441d-9f29-4424903481e7",
                                "sense_id": "15cf6d1a-4c05-3c00-af0c-8cd251e14a29",
                                "text": "Der erschienene Bericht war nur eine Momentaufnahme der gegenwärtigen Lage."
                            },
                            {
                                "example_id": "36579e77-074d-4496-a945-462f1e2f53ba",
                                "sense_id": "15cf6d1a-4c05-3c00-af0c-8cd251e14a29",
                                "text": "„Wie jedes Gemälde, jede andere Erzählung erzählt auch der Witz in Momentaufnahmen, wie die Welt sich gerade dreht.“"
                            },
                            {
                                "example_id": "17a05a88-5dc8-44b5-804e-9128c679fd62",
                                "sense_id": "15cf6d1a-4c05-3c00-af0c-8cd251e14a29",
                                "text": "„Es sind Momentaufnahmen, die nicht umfassend sein können und daher nicht verallgemeinert werden dürfen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9ba5529-d9e6-4699-9eff-cd4dd1d78178",
                        "source_entry_id": "a2f354ec-19f8-301a-a6fd-06d85940eb80",
                        "source_sense_id": "92a1c5c5-7ebe-38b2-9d1a-6a5cd8c24e55",
                        "source_sense_description": "Fotografie: eine Aufnahme mit kurzer Belichtungszeit",
                        "target_lang_word": "instantané",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instantané",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                        "entry_id": "65af2f2c-8a2d-325e-a8a5-1582340a2096",
                                        "glosses": [
                                            "Qui ne dure qu’un instant, qui se produit soudainement, en un instant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b670850-d5b7-457c-a2ff-4dd61aa4f64b",
                                                "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                                "text": "Ce mouvement n’a été qu’instantané."
                                            },
                                            {
                                                "example_id": "cdbcc462-0c5e-425d-8d12-5ea066b1e342",
                                                "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                                "text": "Une frayeur instantanée."
                                            },
                                            {
                                                "example_id": "3fcce8a1-6625-407b-90e8-eb3f9d231c33",
                                                "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                                "text": "Une photographie instantanée"
                                            },
                                            {
                                                "example_id": "ef188dc0-df2a-4e32-9e46-a11f0f138d81",
                                                "sense_id": "d5126526-2074-34ed-8650-3c2e3d6cecd3",
                                                "text": "– La mort a dû être instantanée, déclara le docteur… un coup de couteau a suffi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d71b011-7a4f-30e6-b6e9-f90ba31e86dc",
                                        "entry_id": "65af2f2c-8a2d-325e-a8a5-1582340a2096",
                                        "glosses": [
                                            "Qui caractérise l’état à l’instant, par opposition à une valeur moyenne, une valeur efficace, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81d202aa-8a18-4d31-9fc4-9c294208a901",
                                                "sense_id": "7d71b011-7a4f-30e6-b6e9-f90ba31e86dc",
                                                "text": "La puissance instantanée, la valeur instantanée, une dérivée instantanée, la vitesse instantanée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "instantané",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b96b15e-4981-3750-834d-7d83a0402f19",
                                        "entry_id": "7562a7f2-e16d-3a0d-9d5d-72942f4f0896",
                                        "glosses": [
                                            "Photographie obtenue par une très courte exposition."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77f2fb28-32e2-4817-bf40-5c8d529ae0ca",
                                                "sense_id": "3b96b15e-4981-3750-834d-7d83a0402f19",
                                                "text": "L’instantané est plus vivant, mais moins exact que la pose."
                                            },
                                            {
                                                "example_id": "c45724e7-6ff4-46c2-977c-c63ccea0aa2d",
                                                "sense_id": "3b96b15e-4981-3750-834d-7d83a0402f19",
                                                "text": "Prendre un instantané, des instantanés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                        "entry_id": "7562a7f2-e16d-3a0d-9d5d-72942f4f0896",
                                        "glosses": [
                                            "Image capturée d’une action, d’un évènement."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "820cbd0b-e244-4ca4-9355-539c4f7f9ce3",
                                                "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                                "text": "Il y a vous-même, voyez : cet instantané qu’on vous prit à Monte-Carlo, où vous êtes si parfaitement ridicule et si correctement élégant !"
                                            },
                                            {
                                                "example_id": "adc2d5e3-8e79-40cb-b9f3-cee5baad71c1",
                                                "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                                "text": "Froberval passa la photographie. Beautrelet eut un geste de surprise. Il venait, sur l’instantané, de se reconnaître, debout, les deux mains dans ses poches, avec, autour de lui, une pelouse où se dressaient des arbres et des ruines."
                                            },
                                            {
                                                "example_id": "240bbea0-be8c-4c48-ba8a-331e6b9f7e05",
                                                "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                                "text": "Michel empila aussi dans la cassette les photographies de sa femme, tant vivante que morte, et les instantanés pris au cours de leurs voyages."
                                            },
                                            {
                                                "example_id": "24d71051-b982-4d9d-8e36-9a6a84fdaabb",
                                                "sense_id": "f6d2989c-d780-3aae-91bd-cbee4da8a6ca",
                                                "text": "À la différence du portrait, l’instantané saisit le moment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce1a028b-4084-38d2-8811-99f6104e3e6e",
                                        "entry_id": "7562a7f2-e16d-3a0d-9d5d-72942f4f0896",
                                        "glosses": [
                                            "Appareil qui sert à faire des photographies instantanées."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd4a06e4-3407-3759-91de-419547a0a834",
                                        "entry_id": "7562a7f2-e16d-3a0d-9d5d-72942f4f0896",
                                        "glosses": [
                                            "État d'un système sauvegardé à un instant donné."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
