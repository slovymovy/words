                        "glosses": [
                            "zonder dat het door iets wordt tegengehouden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7dd7e5b6-007f-41e5-bf7a-fc1603724bbd",
                                "sense_id": "f53c2b2f-72cb-3f71-b5cf-2da91ce2a690",
                                "text": "De zon scheen ongefilterd op zijn bleke gelaat met de donkere kringen rond zijn ogen."
                            },
                            {
                                "example_id": "4ba5263d-ba57-4e0a-81a6-2822b50149c8",
                                "sense_id": "f53c2b2f-72cb-3f71-b5cf-2da91ce2a690",
                                "text": "\"Racisme in het voetbal is van alle tijden\", legt correspondent Suse van Kleef uit. \"Nieuw is dat het zich de afgelopen tien jaar ook via sociale media verspreidt. Zo komt het ongefilterd bij de speler terecht. Vroeger kreeg een voetballer niet mee wat iemand thuis naar zijn televisie schreeuwde.\""
                            }
                        ]
                    }
                ],
