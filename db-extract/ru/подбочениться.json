                    {
                        "form_id": "e6db9215-94fd-4c6c-a290-ae96600f970e",
                        "entry_id": "bec8bbac-c2c0-3665-8a8e-59fa7d78d4c1",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "подбоче́нясь"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb8d7f89-9099-372a-9797-3ecde65a1412",
                        "entry_id": "bec8bbac-c2c0-3665-8a8e-59fa7d78d4c1",
                        "glosses": [
                            "разг. выпрямившись, упереться руками в бока (рукой в бок)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb233779-9ddb-454d-9f44-339f116ef5a7",
                                "sense_id": "eb8d7f89-9099-372a-9797-3ecde65a1412",
                                "text": "Она бросила тарелку и подбоченилась с необыкновенно воинственным видом, от которого нельзя было ожидать ничего хорошего."
                            },
                            {
                                "example_id": "e1a0b267-a531-4469-ad5b-d382312ccc9c",
                                "sense_id": "eb8d7f89-9099-372a-9797-3ecde65a1412",
                                "text": "Управляющий причмокнул, лошадь тронула, и Дмитрий Петрович невольно подбоченился."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a2692ef6-5bc8-4cee-a14e-bd51c484216b",
                        "source_entry_id": "bec8bbac-c2c0-3665-8a8e-59fa7d78d4c1",
                        "source_sense_id": "eb8d7f89-9099-372a-9797-3ecde65a1412",
                        "target_lang_word": "akimbo",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "akimbo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "311d92fc-3a83-3617-ae3e-5134e3dfe96c",
                                        "entry_id": "2c509243-750f-377e-b29b-58b9d07b4a08",
                                        "glosses": [
                                            "With a crook or bend; with the hand on the hip and elbow turned outward."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a9b7ca00-7df1-418d-8860-278a487c9bf3",
                                                "sense_id": "311d92fc-3a83-3617-ae3e-5134e3dfe96c",
                                                "text": "\"Now, then, mister,\" said he, with his head cocked and his arms akimbo, \"what are you driving at? Let's have it straight, now.\""
                                            },
                                            {
                                                "example_id": "6012fde2-2213-48a8-bb34-d00d72cb5903",
                                                "sense_id": "311d92fc-3a83-3617-ae3e-5134e3dfe96c",
                                                "text": "Girls take hold of the skirts; boys place the hands akimbo, bend forward from the waist, and bow."
                                            },
                                            {
                                                "example_id": "73dc91cb-0caa-4d47-94b4-82c664fbbeec",
                                                "sense_id": "311d92fc-3a83-3617-ae3e-5134e3dfe96c",
                                                "text": "Men preferred one pose above all others, namely, the elbow akimbo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4b8b891-1f3b-30bb-9841-1548bd102221",
                                        "entry_id": "2c509243-750f-377e-b29b-58b9d07b4a08",
                                        "glosses": [
                                            "With legs spread and the knees bent in an outward or awkward way, sometimes with the feet touching."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "akimbo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "994d27a7-3df4-3ac1-acb0-5227cfd1b8ef",
                                        "entry_id": "9e23382f-982d-3565-9470-888041cfb638",
                                        "glosses": [
                                            "Into, in, or of the position where the arms are akimbo."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef1928d6-dcb5-4d9d-9f8a-3520a6d54f63",
                                                "sense_id": "994d27a7-3df4-3ac1-acb0-5227cfd1b8ef",
                                                "text": "The man was standing akimbo."
                                            },
                                            {
                                                "example_id": "bb453f0c-0615-44fe-8575-c0ef3a9e5542",
                                                "sense_id": "994d27a7-3df4-3ac1-acb0-5227cfd1b8ef",
                                                "text": "Otherwise, it is likely that she may be accosted as \"dear\" or \"Sally,\"—invited to take \"a drop o' tea,\" or otherwise chaffed by rough women standing akimbo at street doors."
                                            },
                                            {
                                                "example_id": "bd95370b-8efe-4b8a-bb6e-9347c95895f6",
                                                "sense_id": "994d27a7-3df4-3ac1-acb0-5227cfd1b8ef",
                                                "text": "...and the other end window bearing the figure of a woman standing akimbo with her right hand touching her right temple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0437a87b-b7ba-39ce-b09a-5573ec647947",
                                        "entry_id": "9e23382f-982d-3565-9470-888041cfb638",
                                        "glosses": [
                                            "Of weapons, especially firearms: one held in each hand."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b771a444-ac32-41fb-b5f6-86aaa8c61c8d",
                                                "sense_id": "0437a87b-b7ba-39ce-b09a-5573ec647947",
                                                "text": "Although it was a little impractical, Elmer held his revolvers akimbo because to him it looked cool."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "akimbo",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d332caf8-1f26-3d86-aa40-185ab1458bd7",
                                        "entry_id": "ffd0bda4-4d3e-372a-9962-2518a951409b",
                                        "glosses": [
                                            "To wield (two weapons), one in each hand."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
