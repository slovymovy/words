                                        "entry_id": "a1774a6f-e77a-355b-b317-6aa143bf8ee5",
                                        "glosses": [
                                            "To cajole or attempt to persuade by flattery."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b41dcc93-0556-4cc8-9096-45d7ac40f3ad",
                                                "sense_id": "80cf40bf-b0a4-33e2-9ba9-71c948cf654c",
                                                "text": "I’d like one of those, too, if you can wheedle him into telling you where he got it."
                                            },
                                            {
                                                "example_id": "d5bd1cac-6c71-4472-9420-ee52e4a9bb49",
                                                "sense_id": "80cf40bf-b0a4-33e2-9ba9-71c948cf654c",
                                                "text": "Though he had beaten me in every bone / He still could wheedle me to love."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5df39a65-7e0d-3caf-b30d-b289fc652f66",
                                        "entry_id": "a1774a6f-e77a-355b-b317-6aa143bf8ee5",
                                        "glosses": [
                                            "To obtain by flattery, guile, or trickery."
