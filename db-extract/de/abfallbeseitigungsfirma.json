                "senses": [
                    {
                        "sense_id": "327b3ca6-663a-3aa0-b3af-f4b307d3ddc9",
                        "entry_id": "452aa2e3-e8c0-34e1-a2d6-297aab274cd8",
                        "glosses": [
                            "Firma, die Abfall beseitigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8431d398-3058-47e5-a375-bdb95f0df539",
                                "sense_id": "327b3ca6-663a-3aa0-b3af-f4b307d3ddc9",
                                "text": "„Am 07.05.2019, um die Mittagszeit, wurde durch Mitarbeiter einer Abfallbeseitigungsfirma auf der Friesenheimer Insel ein Brand in einem offenen Schütt-Container, der mit Filterabfällen beladen war, festgestellt.“"
                            },
                            {
                                "example_id": "a4bd5907-8409-44df-8309-d96bb3357bc5",
                                "sense_id": "327b3ca6-663a-3aa0-b3af-f4b307d3ddc9",
                                "text": "„In der Nacht zu Dienstag hat es bei der Abfallbeseitigungsfirma Remondis an der Hörstener Straße gebrannt.“"
                            },
                            {
                                "example_id": "505fdddd-8817-4d6e-b267-35a52126fe21",
                                "sense_id": "327b3ca6-663a-3aa0-b3af-f4b307d3ddc9",
                                "text": "„Jahrgang 37, Stammgast im »Tom-Tom«, der bis Ende letzten Jahres tatsächlich Wachmann eines Munitionsdepots nahe Gummersbach war und heute bei einer Abfallbeseitigungsfirma beschäftigt ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
