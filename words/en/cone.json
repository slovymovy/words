{
    "word_family": [
        "conical",
        "conic",
        "conifer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "229fdbd4-d1bd-3d8d-9e31-fb1930ebb40e",
                    "sense_definition": "A hard, crisp, edible biscuit shaped like a cone, used for holding ice cream.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She bought a chocolate ice cream <w>cone</w> at the beach.",
                            "target_lang_translations": {
                                "ru": "Она купила шоколадный <w>рожок</w> с мороженым на пляже.",
                                "zh": "她在海滩买了一个巧克力<w>蛋筒</w>冰淇淋。"
                            }
                        },
                        {
                            "text": "The child cried when he dropped his <w>cone</w> on the ground.",
                            "target_lang_translations": {
                                "ru": "Ребенок заплакал, когда уронил свой <w>рожок</w> на землю.",
                                "zh": "孩子把<w>蛋筒</w>掉在地上时哭了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cornet",
                        "ice cream cone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый хрустящий вафельный стаканчик конической формы для мороженого",
                        "zh": "一种圆锥形的硬脆饼干，用于盛放冰淇淋。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рожок",
                                "target_lang_sense_clarification": "вафельный"
                            },
                            {
                                "target_lang_word": "вафельный рожок",
                                "target_lang_sense_clarification": "для мороженого"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蛋筒",
                                "target_lang_sense_clarification": "冰淇淋的脆皮筒"
                            },
                            {
                                "target_lang_word": "甜筒",
                                "target_lang_sense_clarification": "冰淇淋的脆皮筒"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb0f161a-6fed-38a2-a732-6c963ef440cc",
                    "sense_definition": "An object or shape with a circular base that narrows to a point at the top.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The witch's hat was shaped like a tall black <w>cone</w>.",
                            "target_lang_translations": {
                                "ru": "Шляпа ведьмы имела форму высокого черного <w>конуса</w>.",
                                "zh": "女巫的帽子形状像一个高高的黑色<w>圆锥</w>。"
                            }
                        },
                        {
                            "text": "We learned how to calculate the volume of a <w>cone</w> in math class.",
                            "target_lang_translations": {
                                "ru": "На уроке математики мы учились вычислять объем <w>конуса</w>.",
                                "zh": "我们在数学课上学习了如何计算<w>圆锥</w>的体积。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cone shape"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или геометрическая фигура с круглым основанием, сужающаяся к точке наверху",
                        "zh": "具有圆形底座并向顶部尖端收缩的物体或形状。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конус",
                                "target_lang_sense_clarification": "геометрическая фигура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆锥",
                                "target_lang_sense_clarification": "几何形状"
                            },
                            {
                                "target_lang_word": "锥体",
                                "target_lang_sense_clarification": "几何形状"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77e483fa-1d50-3c65-ae09-7df034f06309",
                    "sense_definition": "A bright plastic object shaped like a cone, placed on a road to warn drivers or guide traffic.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "traffic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Workmen placed orange <w>cones</w> around the pothole to warn drivers.",
                            "target_lang_translations": {
                                "ru": "Рабочие расставили оранжевые <w>конусы</w> вокруг выбоины, чтобы предупредить водителей.",
                                "zh": "工人们在坑洞周围放置了橙色的<w>交通锥</w>以提醒司机。"
                            }
                        },
                        {
                            "text": "You must drive carefully between the traffic <w>cones</w>.",
                            "target_lang_translations": {
                                "ru": "Вы должны осторожно проезжать между дорожными <w>конусами</w>.",
                                "zh": "你必须小心地在<w>交通锥</w>之间行驶。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "traffic cone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Яркий пластиковый предмет конической формы, выставляемый на дороге для предупреждения водителей",
                        "zh": "一种放置在道路上用于警告驾驶员或引导交通的亮色塑料锥形物体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожный конус",
                                "target_lang_sense_clarification": "сигнальный"
                            },
                            {
                                "target_lang_word": "конус",
                                "target_lang_sense_clarification": "дорожный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "交通锥",
                                "target_lang_sense_clarification": "道路安全设施"
                            },
                            {
                                "target_lang_word": "路锥",
                                "target_lang_sense_clarification": "道路安全设施"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb3f147c-30c8-33da-842b-e6a73e44c3d6",
                    "sense_definition": "The hard, dry fruit of a pine or fir tree that contains seeds and has overlapping scales.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "botany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We collected pine <w>cones</w> from the forest floor to decorate the house.",
                            "target_lang_translations": {
                                "ru": "Мы собирали сосновые <w>шишки</w> с лесной подстилки, чтобы украсить дом.",
                                "zh": "我们从森林地面上收集了<w>松果</w>来装饰房子。"
                            }
                        },
                        {
                            "text": "The seeds inside the <w>cone</w> provide food for squirrels.",
                            "target_lang_translations": {
                                "ru": "Семена внутри <w>шишки</w> служат пищей для белок.",
                                "zh": "<w>松果</w>里的种子为松鼠提供了食物。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pine cone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердый сухой плод хвойных деревьев, содержащий семена и покрытый чешуйками",
                        "zh": "松树或冷杉树的坚硬干燥果实，含有种子并覆盖有重叠的鳞片。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шишка",
                                "target_lang_sense_clarification": "плод хвойных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "松果",
                                "target_lang_sense_clarification": "松树的果实"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "740316e4-0f87-38e4-a086-7b86bd99559c",
                    "sense_definition": "A specialized cell in the retina of the eye that is sensitive to color and bright light.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>cones</w> in our eyes allow us to distinguish between different colors.",
                            "target_lang_translations": {
                                "ru": "<w>Колбочки</w> в наших глазах позволяют нам различать разные цвета.",
                                "zh": "我们眼睛里的<w>视锥细胞</w>使我们能够区分不同的颜色。"
                            }
                        },
                        {
                            "text": "Human vision relies on rods for low light and <w>cones</w> for detail.",
                            "target_lang_translations": {
                                "ru": "Человеческое зрение полагается на палочки при слабом освещении и на <w>колбочки</w> для детализации.",
                                "zh": "人类视觉在弱光下依靠视杆细胞，在细节辨别上依靠<w>视锥细胞</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rods and cones"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светочувствительная клетка сетчатки глаза, отвечающая за цветовое зрение",
                        "zh": "视网膜中对颜色和强光敏感的特殊细胞。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колбочка",
                                "target_lang_sense_clarification": "анатомия глаза"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "视锥细胞",
                                "target_lang_sense_clarification": "眼部解剖学"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3503e0ee-246d-38c9-8776-4a399e4d0493",
                    "sense_definition": "To block or mark a section of a road or area using traffic cones, usually followed by 'off'.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "traffic_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Police had to <w>cone</w> off the lane after the accident occurred.",
                            "target_lang_translations": {
                                "ru": "Полиции пришлось <w>оградить конусами</w> полосу после аварии.",
                                "zh": "事故发生后，警察不得不<w>用路锥围起</w>了那条车道。"
                            }
                        },
                        {
                            "text": "The construction crew will <w>cone</w> off the parking lot tomorrow morning.",
                            "target_lang_translations": {
                                "ru": "Строительная бригада <w>оградит конусами</w> парковку завтра утром.",
                                "zh": "施工队明天早上将<w>用路锥围起</w>停车场。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cone off"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограждать или отмечать участок дороги с помощью дорожных конусов",
                        "zh": "使用交通锥阻挡或标记道路或区域的某一部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограждать конусами",
                                "target_lang_sense_clarification": "дорожные работы"
                            },
                            {
                                "target_lang_word": "выставлять конусы",
                                "target_lang_sense_clarification": "на дороге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用路锥围起",
                                "target_lang_sense_clarification": "交通管制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bfe2dd2-e200-3b81-b467-2bceddec8cc7",
                    "sense_definition": "To form or shape something into a cone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The potter <w>coned</w> the clay on the wheel before opening it up.",
                            "target_lang_translations": {
                                "ru": "Гончар <w>вытянул в конус</w> глину на круге, прежде чем раскрыть ее.",
                                "zh": "陶工在拉坯前将黏土在转盘上<w>塑成圆锥形</w>。"
                            }
                        },
                        {
                            "text": "The searchlight beam <w>coned</w> upwards into the dark sky.",
                            "target_lang_translations": {
                                "ru": "Луч прожектора <w>конусом уходил</w> вверх в темное небо.",
                                "zh": "探照灯的光束向上<w>塑成圆锥形</w>射入黑暗的天空。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Придавать чему-либо форму конуса",
                        "zh": "将某物塑造成圆锥形。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "придавать форму конуса",
                                "target_lang_sense_clarification": "формировать"
                            },
                            {
                                "target_lang_word": "сворачивать конусом",
                                "target_lang_sense_clarification": "скручивать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "塑成圆锥形",
                                "target_lang_sense_clarification": "改变形状"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "7a3fecd6-d929-3a6e-ad19-30dd79202776",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Cone</w> is a well-known lawyer in this town.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Коун</w> — известный юрист в этом городе.",
                                "zh": "<w>科恩</w>先生是镇上一位著名的律师。"
                            }
                        },
                        {
                            "text": "I went to school with a girl named Sarah <w>Cone</w>.",
                            "target_lang_translations": {
                                "ru": "Я учился в школе с девочкой по имени Сара <w>Коун</w>.",
                                "zh": "我和一个叫莎拉·<w>科恩</w>的女孩上过同一所学校。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Коун",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科恩",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "687efc14-591a-3889-b18a-71607da5476f",
                    "sense_definition": "A place name, such as a community in the United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They visited the small community of <w>Cone</w> during their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они посетили небольшое поселение <w>Коун</w>.",
                                "zh": "他们在公路旅行中参观了<w>科恩</w>这个小社区。"
                            }
                        },
                        {
                            "text": "<w>Cone</w> is located in a rural part of the state.",
                            "target_lang_translations": {
                                "ru": "<w>Коун</w> расположен в сельской части штата.",
                                "zh": "<w>科恩</w>位于该州的农村地区。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Название населенного пункта",
                        "zh": "地名，如美国的一个社区。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Коун",
                                "target_lang_sense_clarification": "топоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "科恩",
                                "target_lang_sense_clarification": "地名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}