                                    {
                                        "sense_id": "17da9cd2-7103-345b-8649-87f47e0e14c3",
                                        "entry_id": "3486cfe2-bbef-318a-9398-261c02e4d911",
                                        "glosses": [
                                            "nebensprachlich, sprachbegleitend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7f4e9e7-21d1-4139-9216-aeb18019cb66",
                                                "sense_id": "17da9cd2-7103-345b-8649-87f47e0e14c3",
                                                "text": "„Ein exemplarisches paralinguistisches Merkmal ist das Flüstern, das in manchen Sprachen dazu dient, dem Gesagten einen ‚verschwörerischen‘ Unterton zu verleihen.“"
                                            },
                                            {
                                                "example_id": "85a9b53b-aca3-47f3-ac72-a3081bf122ba",
                                                "sense_id": "17da9cd2-7103-345b-8649-87f47e0e14c3",
                                                "text": "„Wenn zwei Menschen miteinander reden, nehmen sie nicht nur das Gesagte wahr. Auch Emotionen werden transportiert und von dem jeweiligen Gegenüber empfangen, was die Unterhaltung meist erst komplett greifbar macht. Solche sogenannten paralinguistischen Eigenschaften können von Systemen zur automatischen Spracherkennung, wie einer Telefonanlage, bisher nicht erkannt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
