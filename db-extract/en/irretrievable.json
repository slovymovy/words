                    },
                    {
                        "translation_id": "d725404d-6b9a-4c1c-a05c-fea09de365ca",
                        "source_entry_id": "0d1ff762-2e77-34d8-8a55-0606e48fe9ab",
                        "source_sense_id": "27756349-8708-3e71-8de2-4496dc1170be",
                        "source_sense_description": "Not retrievable",
                        "target_lang_word": "irréparable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irréparable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ab8951b-ca9e-3523-af04-5e4bdc78fb2c",
                                        "entry_id": "67991755-ce0b-3a28-9607-8ebc9d3fccb3",
                                        "glosses": [
                                            "Qui ne peut être réparé, au sens propre comme au figuré."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e05b8047-515f-4a49-93c8-65a61d2cdfd0",
                                                "sense_id": "1ab8951b-ca9e-3523-af04-5e4bdc78fb2c",
                                                "text": "Même elle avait encor cet éclat emprunté\nDont elle eut soin de peindre et d’orner son visage,\nPour réparer des ans l’irréparable outrage."
                                            },
                                            {
                                                "example_id": "23a61e89-41d9-44a7-ba30-ab873269d09d",
                                                "sense_id": "1ab8951b-ca9e-3523-af04-5e4bdc78fb2c",
                                                "text": "C'était un irréparable malheur, qui, certainement, eût désespéré des gens moins énergiques."
                                            },
                                            {
                                                "example_id": "c3f4b268-8cc8-44d6-8e69-c32e3b37dfbf",
                                                "sense_id": "1ab8951b-ca9e-3523-af04-5e4bdc78fb2c",
                                                "text": "La jeune Américaine qui permet et se permet tout ce qui n’est pas irréparable."
                                            },
                                            {
                                                "example_id": "35c10b4b-0692-454d-a5ff-0ed4debbc50e",
                                                "sense_id": "1ab8951b-ca9e-3523-af04-5e4bdc78fb2c",
                                                "text": "Son attitude avait été telle que M. Donis éprouva un sentiment de soulagement en la voyant sortir ; plus d’une fois il avait eu peur qu’elle ne laissât échapper quelque parole irréparable."
                                            },
                                            {
                                                "example_id": "e79558a9-06d2-4d84-8073-89861e3713f0",
                                                "sense_id": "1ab8951b-ca9e-3523-af04-5e4bdc78fb2c",
                                                "text": "Je vais les faire tous attendre un peu avant de révéler la cachette de la voyante : il faut laisser à son crime le temps de devenir irréparable."
                                            },
                                            {
                                                "example_id": "a3422a63-9543-41de-9a4d-8cd5b25e5d15",
                                                "sense_id": "1ab8951b-ca9e-3523-af04-5e4bdc78fb2c",
                                                "text": "Il lui faisait pitié à cause de sa totale solitude et d’une amertume sans remède que trahissaient certains de ses propos comme si, depuis sa jeunesse, il avait subi déjà quelque désastre irréparable."
                                            },
                                            {
                                                "example_id": "5b4955a1-f905-4119-b018-a8b6f839ba60",
                                                "sense_id": "1ab8951b-ca9e-3523-af04-5e4bdc78fb2c",
                                                "text": "Une pompe à eau hors-service est irréparable, monsieur. Il faut la remplacer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "irréparable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd9933a-4943-322d-b1dd-2f73c46b98ac",
                                        "entry_id": "e67bcc55-1d2e-327d-a66a-10e9f27b3e83",
                                        "glosses": [
                                            "Acte grave aux conséquences irrémédiables ; situation inéluctable qui en découle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b6cd0a7-d728-4293-a14a-54c76259cd5b",
                                                "sense_id": "ddd9933a-4943-322d-b1dd-2f73c46b98ac",
                                                "text": "C'est une affaire d'inceste banale et tragique que juge le tribunal correctionnel de Coutances. Une jeune femme traumatisée depuis sept ans, depuis que son père a commis l'irréparable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ade0e963-3908-3187-9f33-6844ead8e930",
                                        "entry_id": "e67bcc55-1d2e-327d-a66a-10e9f27b3e83",
                                        "glosses": [
                                            "Un suicide ou un homicide."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "be0f340e-e2e7-4939-983d-40dfc66a9527",
                                                "sense_id": "ade0e963-3908-3187-9f33-6844ead8e930",
                                                "text": "\"S'il s'agit d'un accident, peut-être avez-vous paniqué, si vous avez commis l'irréparable, peut-être le regrettez-vous... Peut-être, craignez-vous les conséquences et ne savez comment vous en sortir… Tout cela, nous pouvons le comprendre, mais nous en appelons à votre cœur.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "80ee4513-13ef-4e5e-971d-0ea456fed8dc",
                        "source_entry_id": "0d1ff762-2e77-34d8-8a55-0606e48fe9ab",
                        "source_sense_id": "27756349-8708-3e71-8de2-4496dc1170be",
                        "source_sense_description": "Not retrievable",
                        "target_lang_word": "irrémédiable",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irrémédiable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6367c05-40da-321d-a4ba-1256235380a6",
                                        "entry_id": "7a3e3ea0-b6b4-3992-b8ef-c4236aaccc22",
                                        "glosses": [
                                            "À quoi on ne peut remédier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ed24cb6-df4e-46f9-a086-61d5668647ac",
                                                "sense_id": "f6367c05-40da-321d-a4ba-1256235380a6",
                                                "text": "Sommes-nous donc dans une époque d’irrémédiable décadence ? Plus nous approchons de la fin de ce siècle, plus notre décomposition s’aggrave et s’accélère."
                                            },
                                            {
                                                "example_id": "1b351ce0-0235-4459-8c77-f25eee247c8e",
                                                "sense_id": "f6367c05-40da-321d-a4ba-1256235380a6",
                                                "text": "Le conflit est donc irrémédiable (dans la névrose) et irrésolvable entre un trop tôt et un trop tard : seul pourra l'apaiser un fantasme avec sa mise en drame..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c607986f-3fd2-33d4-9b07-89ac3b69b46f",
                                        "entry_id": "7a3e3ea0-b6b4-3992-b8ef-c4236aaccc22",
                                        "glosses": [
                                            "Définitif."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb9bc4b4-724e-4a7e-92c3-f11707239f01",
                                                "sense_id": "c607986f-3fd2-33d4-9b07-89ac3b69b46f",
                                                "text": "L’esclavage n'entraînait pas du reste un abaissement irrémédiable, et on voyait au makhzen des affranchis parvenir aux fonctions les plus élevées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "irrémédiable",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5badb782-15b1-33e9-a383-e0c853a07d2b",
                                        "entry_id": "9b26f328-82d2-3ad6-afad-579fe4b64e7d",
                                        "glosses": [
                                            "Ce qui ne peut être empêché, ce qui est inévitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bf0bc2f-7d57-481e-9306-57cc8d80e965",
                                                "sense_id": "5badb782-15b1-33e9-a383-e0c853a07d2b",
                                                "text": "Elle s’efforçait de se rendormir, de ne plus penser, mais, quand elle ne pensait pas, elle gardait le même sentiment d’irrémédiable."
                                            },
                                            {
                                                "example_id": "b2a1c061-d242-466d-b75c-63660d938656",
                                                "sense_id": "5badb782-15b1-33e9-a383-e0c853a07d2b",
                                                "text": "Elle sait qu’on ne lui montre le monde qu’à travers des vitres bien lavées et souvent voilées de tulle, mais le peu qu’elle en voit lui montre presque partout l’irrémédiable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
