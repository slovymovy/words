                        "form_id": "71e7251d-cfc0-40d7-b4dc-9782899414da",
                        "entry_id": "b8556af6-0b18-3ff6-9b98-8bec02a54d9d",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more provisory"
                    },
                    {
                        "form_id": "079bd2a9-a8c7-4678-aa1e-89f487aeed06",
                        "entry_id": "b8556af6-0b18-3ff6-9b98-8bec02a54d9d",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most provisory"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4df8d79d-88ac-3c61-9528-dc980c7224e2",
                        "entry_id": "b8556af6-0b18-3ff6-9b98-8bec02a54d9d",
                        "glosses": [
                            "Temporary; pending something more permanent."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "d490ff7a-3b34-308f-a646-92335450d9ab",
                        "entry_id": "b8556af6-0b18-3ff6-9b98-8bec02a54d9d",
                        "glosses": [
                            "Containing a proviso or condition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1ce9143-fcb1-4427-a861-f8f4f3e38223",
                                "sense_id": "d490ff7a-3b34-308f-a646-92335450d9ab",
                                "text": "The provisory clause effectively excluded his otherwise logical heirs from his main inheritance."
                            }
                        ]
                    },
                    {
                        "sense_id": "d5e9766d-5344-3a4e-a84a-732b3b47bd47",
                        "entry_id": "b8556af6-0b18-3ff6-9b98-8bec02a54d9d",
                        "glosses": [
                            "Dependent on a proviso or condition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3de6a4a2-80d5-4f29-be92-bbc1c001bc1b",
                                "sense_id": "d5e9766d-5344-3a4e-a84a-732b3b47bd47",
                                "text": "A provisory guarantee is rather like blackmail."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "933e3b3e-bfb1-4f7b-a70e-eccaa2c1780d",
                        "source_entry_id": "b8556af6-0b18-3ff6-9b98-8bec02a54d9d",
                        "source_sense_description": "pending something more permanent",
                        "target_lang_word": "provisoire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provisoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1946c90c-a0a3-3d4f-981a-36fb0966c233",
                                        "entry_id": "7801cdc9-f76a-3d9f-84bc-9d6aece43856",
                                        "glosses": [
                                            "Qui se fait en attendant une autre chose, préalablement à une autre chose qui sera définitive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ca2e07f-0f5d-48ee-9acb-4186927ad9e5",
                                                "sense_id": "1946c90c-a0a3-3d4f-981a-36fb0966c233",
                                                "text": "Au jour, j'inspecte minutieusement les avaries et consolide les réparations provisoires de la nuit."
                                            },
                                            {
                                                "example_id": "3633ef6d-86e2-4009-b08c-bdd976b559d1",
                                                "sense_id": "1946c90c-a0a3-3d4f-981a-36fb0966c233",
                                                "text": "Nous avons fait un arrangement provisoire."
                                            },
                                            {
                                                "example_id": "e8381b74-593e-4982-818e-f723068e5798",
                                                "sense_id": "1946c90c-a0a3-3d4f-981a-36fb0966c233",
                                                "text": "Ce n’est là qu’un établissement provisoire."
                                            },
                                            {
                                                "example_id": "078be4e0-1531-4ec9-960c-24d582ddf48b",
                                                "sense_id": "1946c90c-a0a3-3d4f-981a-36fb0966c233",
                                                "text": "Gouvernement provisoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72181e5b-479c-3a38-bb75-b1b1f3abab65",
                                        "entry_id": "7801cdc9-f76a-3d9f-84bc-9d6aece43856",
                                        "glosses": [
                                            "Qualifie un jugement rendu par provision."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ec08e95-e24a-4069-8079-fa5316b374cb",
                                                "sense_id": "72181e5b-479c-3a38-bb75-b1b1f3abab65",
                                                "text": "Jugement, sentence, arrêt provisoire."
                                            },
                                            {
                                                "example_id": "a154bfa1-3bb2-45bb-abe2-18f00f7bbcd9",
                                                "sense_id": "72181e5b-479c-3a38-bb75-b1b1f3abab65",
                                                "text": "Mainlevée provisoire : mainlevée qui a été ordonnée en jugement par provision."
                                            },
                                            {
                                                "example_id": "85e0935b-b0d2-4509-8774-7d6b3c1dc93c",
                                                "sense_id": "72181e5b-479c-3a38-bb75-b1b1f3abab65",
                                                "text": "Les aliments, les réparations, etc., sont matière provisoire."
                                            },
                                            {
                                                "example_id": "f5aa7452-9039-4a6a-b5d1-b78a28034953",
                                                "sense_id": "72181e5b-479c-3a38-bb75-b1b1f3abab65",
                                                "text": "Demande, exécution provisoire : celle qui a lieu nonobstant l’appel du jugement."
                                            },
                                            {
                                                "example_id": "25e67c36-9b4c-4053-8ce9-618da056bdfe",
                                                "sense_id": "72181e5b-479c-3a38-bb75-b1b1f3abab65",
                                                "text": "Ordonner, prononcer l’exécution provisoire, avec ou sans caution."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "provisoire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cba9506-d6d5-3846-a760-ece0c48d2106",
                                        "entry_id": "3460594c-c14f-3522-8237-b967d99eb459",
                                        "glosses": [
                                            "Quelque chose de provisoire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0ab750d-584e-43b3-a3c3-dc44bfabcc29",
                                                "sense_id": "8cba9506-d6d5-3846-a760-ece0c48d2106",
                                                "text": "Il a gagné le provisoire."
                                            },
                                            {
                                                "example_id": "d00b7936-6e70-4e19-8a19-4a73be28805e",
                                                "sense_id": "8cba9506-d6d5-3846-a760-ece0c48d2106",
                                                "text": "Introduire un provisoire."
                                            },
                                            {
                                                "example_id": "abe830af-3bc7-48d4-a93f-fd7fd8fb62e7",
                                                "sense_id": "8cba9506-d6d5-3846-a760-ece0c48d2106",
                                                "text": "Ce n’est là qu’un provisoire."
                                            },
                                            {
                                                "example_id": "05993857-2148-4d78-926c-9b7fd7b8b275",
                                                "sense_id": "8cba9506-d6d5-3846-a760-ece0c48d2106",
                                                "text": "Rester dans le provisoire."
                                            },
                                            {
                                                "example_id": "d30876cd-9e0b-42f5-90db-afc766fbf0c8",
                                                "sense_id": "8cba9506-d6d5-3846-a760-ece0c48d2106",
                                                "text": "Sortir du provisoire."
                                            },
                                            {
                                                "example_id": "3f24216f-c535-4b79-81ec-0922132ecbaa",
                                                "sense_id": "8cba9506-d6d5-3846-a760-ece0c48d2106",
                                                "text": "Doit-on parler du provisoire dans le métier de l’historien ?"
                                            },
                                            {
                                                "example_id": "8bbb1418-83a4-4def-83d9-a1395be6ae03",
                                                "sense_id": "8cba9506-d6d5-3846-a760-ece0c48d2106",
                                                "text": "En France, rien ne dure comme le provisoire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "066c6330-ad50-4763-bc70-04ccc4fb10ba",
                        "source_entry_id": "b8556af6-0b18-3ff6-9b98-8bec02a54d9d",
                        "source_sense_description": "pending something more permanent",
                        "target_lang_word": "provisorisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "provisorisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "57ef0bb7-92c0-3119-945f-cc0faa98fe63",
                                        "entry_id": "d7f83df5-15bd-33f5-a62b-dda8cccfc242",
                                        "glosses": [
                                            "vorübergehend, notbehelfsweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f8ae9bf-c03a-49b2-bb7c-75f21d761ca1",
                                                "sense_id": "57ef0bb7-92c0-3119-945f-cc0faa98fe63",
                                                "text": "Das Gebilde aus Alufolie und Kabelbinder ist nur eine provisorische Lösung, damit der Betrieb weitergehen kann."
                                            },
                                            {
                                                "example_id": "db8fd293-e95f-4447-8795-362eeea3022a",
                                                "sense_id": "57ef0bb7-92c0-3119-945f-cc0faa98fe63",
                                                "text": "Die provisorische Brücke muss halten, bis der endgültige Zahnersatz da ist."
                                            },
                                            {
                                                "example_id": "313b945b-efe2-4919-a7c8-b320f18f3807",
                                                "sense_id": "57ef0bb7-92c0-3119-945f-cc0faa98fe63",
                                                "text": "„Darüber wird eine provisorische Holzhütte errichtet, an der mit goldenen Großbuchstaben der Name Lenin prangt.“"
                                            },
                                            {
                                                "example_id": "08ac7ba8-1f2a-47a4-b288-ddb61502207b",
                                                "sense_id": "57ef0bb7-92c0-3119-945f-cc0faa98fe63",
                                                "text": "Drei Roma-Camps in drei Tagen ließ der französische Innenminister Manuel Valls räumen. Bei den Einsätzen der Polizei zu Wochenanfang mussten bereits hunderte von Roma ihre provisorisch erbauten Lager verlassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
