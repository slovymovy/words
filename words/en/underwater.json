{
    "word_family": [
        "water",
        "watery",
        "overwater",
        "freshwater",
        "seawater",
        "groundwater"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "acd1ebb0-647c-3bb3-bbea-2aa2f30d1446",
                    "sense_definition": "Located, occurring, or used beneath the surface of the water.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diver discovered an ancient city while exploring the <w>underwater</w> ruins.",
                            "target_lang_translations": {
                                "ru": "Дайвер обнаружил древний город, исследуя <w>подводные</w> руины.",
                                "zh": "潜水员在探索<w>水下</w>遗迹时发现了一座古城。"
                            }
                        },
                        {
                            "text": "We used a special <w>underwater</w> camera to take pictures of the turtles.",
                            "target_lang_translations": {
                                "ru": "Мы использовали специальную <w>подводную</w> камеру, чтобы сфотографировать черепах.",
                                "zh": "我们用一台特制的<w>水下</w>相机拍摄了海龟的照片。"
                            }
                        }
                    ],
                    "synonyms": [
                        "subaquatic"
                    ],
                    "antonyms": [
                        "above-water"
                    ],
                    "common_phrases": [
                        "underwater world",
                        "underwater camera",
                        "underwater exploration",
                        "underwater swimming"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся, происходящий или используемый под поверхностью воды.",
                        "zh": "位于水面之下，或在水面之下使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подводный",
                                "target_lang_sense_clarification": "основное значение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "水下的",
                                "target_lang_sense_clarification": "形容词，指位置在水面以下"
                            },
                            {
                                "target_lang_word": "潜水的",
                                "target_lang_sense_clarification": "指用于水下活动的设备"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bccc6c4a-cd55-3484-83d6-685281cd3413",
                    "sense_definition": "Having a loan balance that is higher than the current market value of the property or asset securing the loan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many families were left <w>underwater</w> on their mortgages after the economic crisis.",
                            "target_lang_translations": {
                                "ru": "Многие семьи остались <w>с отрицательным капиталом</w> по ипотеке после экономического кризиса.",
                                "zh": "经济危机后，许多家庭的抵押贷款陷入了<w>资不抵债</w>的境地。"
                            }
                        },
                        {
                            "text": "It is stressful to be <w>underwater</w> and owe the bank more than the house is worth.",
                            "target_lang_translations": {
                                "ru": "Стрессово быть <w>в минусе</w> и быть должным банку больше, чем стоит дом.",
                                "zh": "背负着<w>负资产</w>，欠银行的钱比房子本身还值钱，这让人压力很大。"
                            }
                        }
                    ],
                    "synonyms": [
                        "upside down"
                    ],
                    "antonyms": [
                        "solvent",
                        "in the black"
                    ],
                    "common_phrases": [
                        "underwater mortgage",
                        "underwater on a loan"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий задолженность по кредиту, превышающую текущую рыночную стоимость актива (обычно недвижимости).",
                        "zh": "指贷款余额超过了抵押资产（通常为房产）的当前市场价值。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "с отрицательным капиталом",
                                "target_lang_sense_clarification": "финансовый термин"
                            },
                            {
                                "target_lang_word": "в минусе",
                                "target_lang_sense_clarification": "разговорное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资不抵债的",
                                "target_lang_sense_clarification": "金融术语，指负债超过资产价值"
                            },
                            {
                                "target_lang_word": "负资产的",
                                "target_lang_sense_clarification": "指房产价值低于贷款额"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6fcdb85-502d-3e51-8331-a9e9422db1c7",
                    "sense_definition": "Of a financial option, having a strike price that makes it unprofitable to exercise at the current market price.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "financial_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stock options are currently <w>underwater</w> because the share price has fallen significantly.",
                            "target_lang_translations": {
                                "ru": "Опционы на акции сейчас находятся <w>вне денег</w>, так как цена акций значительно упала.",
                                "zh": "由于股价大幅下跌，这些股票期权目前处于<w>价外</w>状态。"
                            }
                        },
                        {
                            "text": "Investors often worry when their call options become <w>underwater</w> before the expiration date.",
                            "target_lang_translations": {
                                "ru": "Инвесторы часто беспокоятся, когда их колл-опционы становятся <w>нерентабельными</w> до даты истечения.",
                                "zh": "当看涨期权在到期日前变得<w>无利可图</w>时，投资者往往会感到担忧。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "underwater option"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "finance jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "О финансовом опционе: имеющий цену исполнения, которая делает его реализацию невыгодной при текущей рыночной цене.",
                        "zh": "指金融期权的行权价使得在当前市场价格下行权无利可图。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вне денег",
                                "target_lang_sense_clarification": "биржевой термин (out of the money)"
                            },
                            {
                                "target_lang_word": "нерентабельный",
                                "target_lang_sense_clarification": "общий смысл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "价外的",
                                "target_lang_sense_clarification": "金融术语，指期权无内在价值"
                            },
                            {
                                "target_lang_word": "无利可图的",
                                "target_lang_sense_clarification": "指行权不划算"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "9b6e46ee-4af8-3752-b654-658b8361e200",
                    "sense_definition": "In a way that goes or stays beneath the surface of the water.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_location",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She took a deep breath and began to swim <w>underwater</w> across the pool.",
                            "target_lang_translations": {
                                "ru": "Она глубоко вздохнула и поплыла <w>под водой</w> через бассейн.",
                                "zh": "她深吸一口气，开始<w>在水下</w>游过泳池。"
                            }
                        },
                        {
                            "text": "The submarine can stay <w>underwater</w> for weeks without needing to surface.",
                            "target_lang_translations": {
                                "ru": "Подводная лодка может оставаться <w>под водой</w> неделями, не всплывая на поверхность.",
                                "zh": "潜艇可以在<w>水下</w>停留数周而无需浮出水面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "swim underwater",
                        "go underwater",
                        "stay underwater"
                    ],
                    "target_lang_definitions": {
                        "ru": "Таким образом, что действие происходит или состояние сохраняется под поверхностью воды.",
                        "zh": "以在水面之下移动或保持的状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "под водой",
                                "target_lang_sense_clarification": "наречие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在水下",
                                "target_lang_sense_clarification": "副词，表示动作发生的地点"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9d58835-7e31-3cdf-8d56-e43437662357",
                    "sense_definition": "To give too little water to a plant or soil.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardeners often <w>underwater</w> their plants during the winter months.",
                            "target_lang_translations": {
                                "ru": "Садоводы часто <w>недоливают</w> свои растения в зимние месяцы.",
                                "zh": "园丁在冬季经常给植物<w>浇水不足</w>。"
                            }
                        },
                        {
                            "text": "If you <w>underwater</w> the lawn, the grass will turn brown and brittle.",
                            "target_lang_translations": {
                                "ru": "Если вы будете <w>недостаточно поливать</w> газон, трава станет коричневой и ломкой.",
                                "zh": "如果你给草坪<w>浇水不足</w>，草就会变黄变脆。"
                            }
                        }
                    ],
                    "antonyms": [
                        "overwater"
                    ],
                    "common_phrases": [
                        "underwater the plants"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поливать растение или почву недостаточным количеством воды.",
                        "zh": "给植物或土壤浇水不足。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "недоливать",
                                "target_lang_sense_clarification": "глагол"
                            },
                            {
                                "target_lang_word": "недостаточно поливать",
                                "target_lang_sense_clarification": "описательный перевод"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "浇水不足",
                                "target_lang_sense_clarification": "动词短语，指水分供给不够"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68d8d1a7-bb8f-3ef8-a3fc-f2faae06c699",
                    "sense_definition": "A type of fishing lure designed to sink and move beneath the water surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angler attached a colorful <w>underwater</w> to attract the fish deep down.",
                            "target_lang_translations": {
                                "ru": "Рыбак прикрепил красочную <w>тонущую приманку</w>, чтобы привлечь рыбу на глубине.",
                                "zh": "垂钓者挂上了一个色彩鲜艳的<w>沉水饵</w>，以吸引深处的鱼。"
                            }
                        },
                        {
                            "text": "He prefers using an <w>underwater</w> when fishing in deep lakes during the summer.",
                            "target_lang_translations": {
                                "ru": "Он предпочитает использовать <w>глубоководную блесну</w> при рыбалке в глубоких озерах летом.",
                                "zh": "他夏天在深水湖泊钓鱼时，更喜欢使用<w>深水路亚</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "fishing context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тип рыболовной приманки, предназначенной для погружения и движения в толще воды.",
                        "zh": "一种设计用于下沉并在水面下移动的钓鱼诱饵。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тонущая приманка",
                                "target_lang_sense_clarification": "рыбалка"
                            },
                            {
                                "target_lang_word": "глубоководная блесна",
                                "target_lang_sense_clarification": "рыбалка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉水饵",
                                "target_lang_sense_clarification": "钓鱼术语"
                            },
                            {
                                "target_lang_word": "深水路亚",
                                "target_lang_sense_clarification": "指用于深水区的诱饵"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}