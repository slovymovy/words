                    },
                    {
                        "translation_id": "9ae102ea-a7a9-486a-b7bf-5adbce064003",
                        "source_entry_id": "48f2a6c5-82bb-3c25-8e43-c25f6140f52b",
                        "source_sense_id": "c2795f29-6344-352a-8080-73157a3be8dd",
                        "source_sense_description": "one who follows Marxism",
                        "target_lang_word": "Marxist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Marxist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a089fbaf-755c-3f17-bf8f-39aa6a5656c3",
                                        "entry_id": "759eb005-f64a-312c-bda1-f97fb2116aea",
                                        "glosses": [
                                            "Anhänger des Marxismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee3dd23b-c8f7-46f2-8a6d-d0f1178b170e",
                                                "sense_id": "a089fbaf-755c-3f17-bf8f-39aa6a5656c3",
                                                "text": "Der Marxist wirft einen Blick in seine Bücher."
                                            },
                                            {
                                                "example_id": "ccade4d1-e4d3-4e03-96e2-0864e54b6959",
                                                "sense_id": "a089fbaf-755c-3f17-bf8f-39aa6a5656c3",
                                                "text": "„Er nahm mich zu einer der geheimen Sitzungen mit, wo Marxisten und Nasseristen zusammenkamen.“"
                                            },
                                            {
                                                "example_id": "480231f4-f81e-4d1d-9894-20b334a5acb6",
                                                "sense_id": "a089fbaf-755c-3f17-bf8f-39aa6a5656c3",
                                                "text": "„Bei der Landtagswahl zwei Monate später wurde der bekennende Marxist von Oertzen wiedergewählt, wurde Kultusminister in Niedersachsen und hielt in der Folge sein Mandat bis 1982.“"
                                            },
                                            {
                                                "example_id": "e29ebec7-5771-4911-84ec-f740b38eb851",
                                                "sense_id": "a089fbaf-755c-3f17-bf8f-39aa6a5656c3",
                                                "text": "„In den ersten Jahren besuchten ihn dort oft andere Exiliraner, Maoisten wie er, ebenso wie Marxisten und Nationalisten.“"
                                            },
                                            {
                                                "example_id": "24041dff-6869-4f67-83bc-392bec897a5e",
                                                "sense_id": "a089fbaf-755c-3f17-bf8f-39aa6a5656c3",
                                                "text": "„Ihr führender Kopf war der junge Marxist und Guerillakämpfer Wilfred Mhanda, der als einer der wenigen ein über die formale Unabhängigkeit hinausweisendes politisches Konzept für eine Transformation der Kolonialgesellschaft entwickelt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fdd32ef4-7943-426c-8ee1-260452623c8d",
                        "source_entry_id": "48f2a6c5-82bb-3c25-8e43-c25f6140f52b",
