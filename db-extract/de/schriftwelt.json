                            {
                                "example_id": "9ad4586d-fff3-43d5-aa5d-0d1c9869bf6e",
                                "sense_id": "6d58dc2c-eb6b-359b-b80e-6eb0e3cd27f8",
                                "text": "„Ein wichtiges Initialerlebnis für die geschriebene Sprache muss dies ja für Canetti gewesen sein; zusammen mit der Zeitung des Vaters beginnt hier die Schriftwelt auf ihn zu wirken, die ihn sein Leben lang nicht mehr loslassen wird.“"
                            },
                            {
                                "example_id": "d44f3f6c-c4a3-49b0-9b9a-c574accccf26",
                                "sense_id": "6d58dc2c-eb6b-359b-b80e-6eb0e3cd27f8",
                                "text": "„Die Entwicklung der \"Schwarzen Kunst\" verursachte einen Umbruch in der Schriftwelt.“"
                            }
                        ],
