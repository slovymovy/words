                                ]
                            },
                            {
                                "target_word": "Hall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                        "entry_id": "8e9c3551-1ae3-37b6-a2a1-0a5f759be166",
                                        "glosses": [
                                            "deutscher Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "083cbd9e-0e94-412a-93e4-8f4f0688ee56",
                                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                                "text": "Frau Hall ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "d6ac41d3-9523-48b2-b84c-96e37239b928",
                                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                                "text": "Herr Hall wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "6dd3971b-1a22-4673-bcbb-f4e9c304606a",
                                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                                "text": "Die Halls fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "e886bfec-e1d7-46de-8543-d16b450256ca",
                                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                                "text": "Der Hall trägt nie die Schals, die die Hall ihm strickt."
                                            },
                                            {
                                                "example_id": "4642233c-57df-4850-bb09-b18401ba22ed",
                                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hall kommt, geht der Herr Hall.“"
                                            },
                                            {
                                                "example_id": "e289d5fb-9cec-44de-9ad4-6aa19972f4e2",
                                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                                "text": "Hall kommt und geht."
                                            },
                                            {
                                                "example_id": "602e17be-5ca5-47d7-900f-7d4777457f0b",
                                                "sense_id": "e3675613-173f-37a5-b759-9f580e3bd48b",
                                                "text": "Halls kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51a1fb06-a309-45ed-a90c-268108d93eda",
                        "source_entry_id": "f6f242c8-31d0-3a1c-a8b9-1160934f203e",
                        "source_sense_id": "2064d90d-224d-3f23-9141-337ad4081a6b",
                        "source_sense_description": "electronic effect",
                        "target_lang_word": "pogłos",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pogłos",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                        "entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                                        "glosses": [
                                            "wywołane działaniem fal odbitych w pomieszczeniu zamkniętym, przedłużenie czasu trwania danego dźwięku"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d252dc25-bcec-49e3-b179-43dd2381088a",
                                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                                "text": "W pustych korytarzach czy pustych salach pogłos jest bardzo długi"
                                            },
                                            {
                                                "example_id": "6b5d11b0-ab0c-402a-964f-dc4da062e1a7",
                                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                                "text": "Był to pogłos jakiejś rockowej ballady, której słowa wydały się Kubie dziwnie znajome"
                                            },
                                            {
                                                "example_id": "24747355-1d8c-431d-844d-5a4702aea750",
                                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                                "text": "Ich szepty niosły się wyraźnie dzięki pogłosowi"
                                            },
                                            {
                                                "example_id": "0fab7e2d-2fff-4dbc-b175-99a93bee7449",
                                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                                "text": "Na (…) płycie słyszymy melodie znanych pieśni kościelnych, jednak zamiast słów pojawiają się inne dźwięki: szumy, trzaski, dziwne pogłosy"
                                            },
                                            {
                                                "example_id": "bcdf984b-6207-4696-ac0c-c384c0d9bdfa",
                                                "sense_id": "5de36e0a-cfa2-38d2-978f-c515dbfb9e9e",
                                                "text": "Wiele cenionych przez realizatorów pogłosów płytowych tłumi częstotliwości powyżej 5 kHz"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "a9c47efd-2b02-339f-8311-f9de18e5e55f",
                                        "entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                                        "glosses": [
                                            "zwielokrotnienie dźwięku"
                                        ],
                                        "tags": [
                                            "akust."
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "3fabfcb6-a1ee-3ec6-8dda-bd6c75c6f7c9",
                                        "entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                                        "glosses": [
                                            "nawiązanie do zdarzeń i zjawisk wcześniejszych"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "7450f96a-1574-3835-8455-bf662701a971",
                                        "entry_id": "d3ec5ee8-5db7-3bd5-ae5b-6076421f48ab",
                                        "glosses": [
                                            "sztuczny efekt stosowany m.in. w muzyce elektronicznej imitujący zachowanie się dźwięku w przestrzeniach zamkniętych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd6382e2-4dc4-43a8-9439-94b44b531a30",
                                                "sense_id": "7450f96a-1574-3835-8455-bf662701a971",
                                                "text": "W latach pięćdziesiątych studia coraz częściej wyposażane były w urządzenia do wytwarzania sztucznego pogłosu"
                                            },
                                            {
                                                "example_id": "c5a3bafa-3aad-4b8e-b016-4c891ec8c19c",
                                                "sense_id": "7450f96a-1574-3835-8455-bf662701a971",
                                                "text": "Czasem w trakcie pracy nad miksem możemy zauważyć, że przesadziliśmy z pogłosem"
                                            },
                                            {
                                                "example_id": "a98fc321-ee07-47c3-a6f6-29f6369c458d",
                                                "sense_id": "7450f96a-1574-3835-8455-bf662701a971",
                                                "text": "Przyszła pora na omówienie jednego z najbardziej nadużywanych efektów przez młodych producentów. Tak, mowa o pogłosie"
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
