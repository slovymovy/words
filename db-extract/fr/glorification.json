                        "cross_references": [
                            {
                                "target_word": "aggrandizement",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9bdc24b7-aa0b-317a-8801-87a559b431c4",
                                        "entry_id": "c849ed58-6217-3c8d-90f7-bc087d2c1022",
                                        "glosses": [
                                            "The act of aggrandizing, or the state of being aggrandized or exalted in power, rank, honor, or wealth; exaltation; enlargement."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a6ae9473-e14f-42bc-a151-583a26fe2b42",
                                                "sense_id": "9bdc24b7-aa0b-317a-8801-87a559b431c4",
                                                "text": "The emperor seeks only the aggrandizement of his own family."
                                            },
                                            {
                                                "example_id": "c0b789ef-fed1-4fbf-b920-bac343e6abaf",
                                                "sense_id": "9bdc24b7-aa0b-317a-8801-87a559b431c4",
                                                "text": "He contented himself therefore with repeating, that his attachment was to Miss Ashton personally; that he desired neither wealth nor aggrandizement from her father's means and influence, and that nothing should prevent his keeping his engagement, excepting her own express desire that it should be relinquished—and he requested as a favour that the matter might be no more mentioned betwixt them at present, assuring the Marquis of A—— that he should be his confident in its progress or its interruption."
                                            },
                                            {
                                                "example_id": "8d8e8f9e-b5ec-4abb-8bd3-272c95abdd73",
                                                "sense_id": "9bdc24b7-aa0b-317a-8801-87a559b431c4",
                                                "text": "The political analyst, speaking on the second installment of the show after its debut on Saturday, said the president's motivation has always been either 'self-aggrandizement' or 'self-preservation.'"
                                            }
                                        ]
                                    }
                                ]
                            }
