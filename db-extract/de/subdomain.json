                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subdomain",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22059606-e78e-3078-b60e-6d8ceebf2181",
                                        "entry_id": "7f2c2ee8-ccf2-3175-a631-9f3533fe3917",
                                        "glosses": [
                                            "A domain or sphere that is part of a larger domain or sphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d86e99b-2866-43cd-9424-7a6c53428877",
                                                "sense_id": "22059606-e78e-3078-b60e-6d8ceebf2181",
                                                "text": "As a technical subdomain of biology ecological investigations have evolved from what has been traditionally called natural history."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0a65d3-fd06-3dae-899e-b05de6f3be55",
                                        "entry_id": "7f2c2ee8-ccf2-3175-a631-9f3533fe3917",
                                        "glosses": [
                                            "A domain name that has been prefaced with additional parts separated with periods."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60fcc57f-a787-46f4-9665-aeb73e211110",
                                                "sense_id": "5a0a65d3-fd06-3dae-899e-b05de6f3be55",
                                                "text": "A domain is a subdomain of another domain if it is contained within that domain. This relationship can be tested by seeing if the subdomain's name ends with the containing domain's name. For example, A.B.C.D is a subdomain of B.C.D, C.D, D, and \" \"."
                                            },
                                            {
                                                "example_id": "74073f56-12bf-4e7b-9207-edaa32693d5f",
                                                "sense_id": "5a0a65d3-fd06-3dae-899e-b05de6f3be55",
                                                "text": "BIND 9 Administrator Reference Manual (9.3.2), Copyright © 2004, 2005 Internet Systems Consortium, Inc. (\"ISC\"), Copyright © 2000-2003 Internet Software Consortium, https://web.archive.org/web/20060619063455/http://www.bind9.net/manual/bind/9.3.2/Bv9ARM.ch01.html\nEvery name in the DNS tree is a domain, even if it is terminal, that is, has no subdomains. Every subdomain is a domain and every domain except the root is also a subdomain."
                                            },
                                            {
                                                "example_id": "0f86e347-1ae6-4808-9fce-dc5fea6b0f5a",
                                                "sense_id": "5a0a65d3-fd06-3dae-899e-b05de6f3be55",
                                                "text": "\"We hope that the parties responsible for managing the security of this subdomain will take this as a wake-up call, and not as a threat,\" a note on the page said."
                                            },
                                            {
                                                "example_id": "1993c2f4-e99c-48ff-a2d2-6dd8b7bc01ed",
                                                "sense_id": "5a0a65d3-fd06-3dae-899e-b05de6f3be55",
                                                "text": "On July 8, 2025 Glitch project hosting and user profiles will be shut down. Your Glitch dashboard will remain available as usual through the end of 2025, with access to download all of your code for your projects, as well as a new feature to set up redirects for your project subdomains so your URLs keep working."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b7aa4fc-ee93-33ff-af4b-2190ebbc4999",
                                        "entry_id": "7f2c2ee8-ccf2-3175-a631-9f3533fe3917",
                                        "glosses": [
                                            "An additional part prefaced to a domain name."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28a6429f-f7cc-4b88-b494-2ccefbe7b89e",
                                                "sense_id": "4b7aa4fc-ee93-33ff-af4b-2190ebbc4999",
                                                "text": "In en.wiktionary.org, en is a subdomain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
