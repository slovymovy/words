                        "examples": [
                            {
                                "example_id": "2a588de2-2a4b-4a59-ab56-c2754def8ad6",
                                "sense_id": "4909e442-9d05-319f-b33f-131d1d046872",
                                "text": "„Die Freund*innen [sic] werden schon seit dem Kindergarten mit den beruflichen Zukunftsvorstellungen verknüpft.“"
                            },
                            {
                                "example_id": "8d1c7d89-2c0c-4dc9-828b-7787359497a3",
                                "sense_id": "4909e442-9d05-319f-b33f-131d1d046872",
                                "text": "„Handeln bedeutet, andere mit den eigenen Zukunftsvorstellungen zu konfrontieren und Zukunftsvorstellungen anderer einzuholen.“"
                            },
                            {
                                "example_id": "b2eb4ae1-f0a7-40f6-b2c1-e7329b2ede42",
                                "sense_id": "4909e442-9d05-319f-b33f-131d1d046872",
                                "text": "„Die Zukunftsvorstellung junger Menschen Laut der Studie von Statista, die 2018 erschienen ist, zählt für 66% der deutschen Bürger die Familie zu den erstrebenswertesten und wichtigsten Dingen im Leben.“"
                            }
                        ],
