{
    "word_family": [
        "follower",
        "unfollow"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f679f272-9b2a-3773-be8f-c589548d7033",
                    "sense_definition": "The continuous form of the verb <w>follow</w>.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>following</w> her brother to the park to make sure he is safe.",
                            "target_lang_translations": {
                                "ru": "Она <w>идёт за</w> своим братом в парк, чтобы убедиться, что он в безопасности.",
                                "tr": "Güvende olduğundan emin olmak için erkek kardeşini parka kadar <w>takip ediyor</w>."
                            }
                        },
                        {
                            "text": "Are you <w>following</w> the instructions carefully to build the model?",
                            "target_lang_translations": {
                                "ru": "Ты внимательно <w>следуешь</w> инструкциям при сборке модели?",
                                "tr": "Modeli yapmak için talimatları dikkatlice <w>takip ediyor</w> musun?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Длительная форма глагола follow (следовать, идти за).",
                        "tr": "'Follow' (takip etmek) fiilinin şimdiki/sürekli zaman hali."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следовать",
                                "target_lang_sense_clarification": "двигаться за кем-то или чем-то"
                            },
                            {
                                "target_lang_word": "идти за",
                                "target_lang_sense_clarification": "физически перемещаться вслед"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takip etme",
                                "target_lang_sense_clarification": "izleme, peşinden gitme"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a5f8fbb8-d06f-398b-a738-ce9b994a100a",
                    "sense_definition": "Coming next in time, order, or sequence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We agreed to meet again the <w>following</w> day to discuss the project details.",
                            "target_lang_translations": {
                                "ru": "Мы договорились встретиться снова на <w>следующий</w> день, чтобы обсудить детали проекта.",
                                "tr": "Proje detaylarını konuşmak için <w>ertesi</w> gün tekrar buluşmaya karar verdik."
                            }
                        },
                        {
                            "text": "Read the <w>following</w> chapter if you want to understand the story better.",
                            "target_lang_translations": {
                                "ru": "Прочитайте <w>следующую</w> главу, если хотите лучше понять историю.",
                                "tr": "Hikayeyi daha iyi anlamak istiyorsanız <w>sonraki</w> bölümü okuyun."
                            }
                        }
                    ],
                    "synonyms": [
                        "next",
                        "subsequent",
                        "succeeding"
                    ],
                    "antonyms": [
                        "preceding"
                    ],
                    "common_phrases": [
                        "the following day",
                        "the following year",
                        "the following week"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идущий следом по времени, порядку или последовательности.",
                        "tr": "Zaman, sıra veya silsile olarak bir sonra gelen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следующий",
                                "target_lang_sense_clarification": "наступающий после текущего"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ertesi",
                                "target_lang_sense_clarification": "ardından gelen gün veya zaman dilimi"
                            },
                            {
                                "target_lang_word": "sonraki",
                                "target_lang_sense_clarification": "sıradaki"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f8ae22c0-a1a5-373b-9b28-c87e87b6f3f9",
                    "sense_definition": "About to be mentioned, listed, or specified immediately.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "sequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please answer the <w>following</w> questions to complete your registration.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, ответьте на <w>следующие</w> вопросы, чтобы завершить регистрацию.",
                                "tr": "Kayıt işleminizi tamamlamak için lütfen <w>aşağıdaki</w> soruları yanıtlayın."
                            }
                        },
                        {
                            "text": "The <w>following</w> items are required for the camping trip this weekend.",
                            "target_lang_translations": {
                                "ru": "Для похода в эти выходные потребуются <w>следующие</w> предметы.",
                                "tr": "Bu hafta sonu kamp gezisi için <w>aşağıdaki</w> eşyalar gereklidir."
                            }
                        }
                    ],
                    "synonyms": [
                        "below"
                    ],
                    "antonyms": [
                        "aforementioned",
                        "abovementioned"
                    ],
                    "common_phrases": [
                        "the following items",
                        "the following example"
                    ],
                    "target_lang_definitions": {
                        "ru": "Который будет упомянут, перечислен или указан далее.",
                        "tr": "Hemen ardından belirtilecek, sıralanacak veya açıklanacak olan."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следующий",
                                "target_lang_sense_clarification": "упоминаемый далее"
                            },
                            {
                                "target_lang_word": "нижеследующий",
                                "target_lang_sense_clarification": "приводимый ниже"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aşağıdaki",
                                "target_lang_sense_clarification": "listede veya metinde hemen ardından gelen"
                            },
                            {
                                "target_lang_word": "müteakkip",
                                "target_lang_sense_clarification": "birbirini izleyen (resmi metinler)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70a05f98-343b-34ca-bd36-10b01b3521aa",
                    "sense_definition": "Blowing in the same direction as one is travelling.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ship sailed quickly across the ocean thanks to a strong <w>following</w> wind.",
                            "target_lang_translations": {
                                "ru": "Корабль быстро плыл через океан благодаря сильному <w>попутному</w> ветру.",
                                "tr": "Gemi, arkadan esen güçlü bir <w>poyraz</w> sayesinde okyanusta hızla ilerledi."
                            }
                        },
                        {
                            "text": "Cyclists love a <w>following</w> breeze because it makes the ride much easier.",
                            "target_lang_translations": {
                                "ru": "Велосипедисты любят <w>попутный</w> ветерок, потому что он делает поездку намного легче.",
                                "tr": "Bisikletçiler <w>arkadan esen</w> rüzgarı severler çünkü sürüşü çok daha kolaylaştırır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "following wind"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дующий в том же направлении, в котором происходит движение.",
                        "tr": "Hareket yönüyle aynı yönde esen (rüzgar)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "попутный",
                                "target_lang_sense_clarification": "о ветре"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "arkadan esen",
                                "target_lang_sense_clarification": "poyraz, gidiş yönüyle aynı yönde esen rüzgar"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "preposition",
            "senses": [
                {
                    "sense_id": "ba8ec7f7-26ec-3ecb-b4d9-3bd863fb6e6a",
                    "sense_definition": "Happening or coming after a specific event or time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Following</w> the meeting, everyone went to the cafeteria for lunch.",
                            "target_lang_translations": {
                                "ru": "<w>После</w> собрания все пошли в кафетерий на обед.",
                                "tr": "Toplantının <w>ardından</w> herkes öğle yemeği için kafeteryaya gitti."
                            }
                        },
                        {
                            "text": "He decided to resign <w>following</w> the scandal that appeared in the news.",
                            "target_lang_translations": {
                                "ru": "Он решил уйти в отставку <w>вслед за</w> скандалом, появившимся в новостях.",
                                "tr": "Haberlerde çıkan skandalın <w>sonrasında</w> istifa etmeye karar verdi."
                            }
                        }
                    ],
                    "antonyms": [
                        "before",
                        "prior to"
                    ],
                    "common_phrases": [
                        "following the announcement",
                        "following the event"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий или идущий после определенного события или времени.",
                        "tr": "Belirli bir olay veya zamandan sonra gerçekleşen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "после",
                                "target_lang_sense_clarification": "по окончании чего-либо"
                            },
                            {
                                "target_lang_word": "вслед за",
                                "target_lang_sense_clarification": "сразу после"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "ardından",
                                "target_lang_sense_clarification": "bir olayı takiben"
                            },
                            {
                                "target_lang_word": "sonra",
                                "target_lang_sense_clarification": "sonrasında"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b66ce789-4fb3-32ff-80c6-6a92a8113d8c",
                    "sense_definition": "Acting according to or in compliance with instructions or rules.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Following</w> the recipe exactly, she added two eggs and a cup of flour.",
                            "target_lang_translations": {
                                "ru": "В точности <w>следуя</w> рецепту, она добавила два яйца и чашку муки.",
                                "tr": "Tarife tam olarak <w>uyarak</w> iki yumurta ve bir su bardağı un ekledi."
                            }
                        },
                        {
                            "text": "The soldiers marched forward, <w>following</w> the orders of their commander.",
                            "target_lang_translations": {
                                "ru": "Солдаты маршировали вперед, <w>следуя</w> приказам своего командира.",
                                "tr": "Askerler komutanlarının emirlerini <w>takip ederek</w> öne doğru ilerlediler."
                            }
                        }
                    ],
                    "common_phrases": [
                        "following instructions",
                        "following the rules"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действующий согласно или в соответствии с инструкциями или правилами.",
                        "tr": "Talimatlara veya kurallara uygun olarak hareket etme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следуя",
                                "target_lang_sense_clarification": "руководствуясь чем-либо"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "uyarak",
                                "target_lang_sense_clarification": "kurallara veya talimatlara bağlı kalarak"
                            },
                            {
                                "target_lang_word": "takip ederek",
                                "target_lang_sense_clarification": "izleyerek"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a650d818-4fab-3d71-b085-0246af2bb104",
                    "sense_definition": "A group of people who support, admire, or follow someone or something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band has built a large and loyal <w>following</w> over the last decade.",
                            "target_lang_translations": {
                                "ru": "За последнее десятилетие группа собрала большую и преданную <w>аудиторию</w>.",
                                "tr": "Grup, son on yılda geniş ve sadık bir <w>takipçi kitlesi</w> oluşturdu."
                            }
                        },
                        {
                            "text": "She gained a massive <w>following</w> on social media after her video went viral.",
                            "target_lang_translations": {
                                "ru": "Она набрала огромное количество <w>подписчиков</w> в социальных сетях после того, как её видео стало вирусным.",
                                "tr": "Videosu viral olduktan sonra sosyal medyada devasa bir <w>takipçi kitlesi</w> kazandı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "loyal following",
                        "large following",
                        "cult following"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа людей, которые поддерживают кого-то или что-то, восхищаются ими или следят за ними.",
                        "tr": "Birini veya bir şeyi destekleyen, hayranlık duyan veya takip eden kişiler grubu."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "последователи",
                                "target_lang_sense_clarification": "сторонники"
                            },
                            {
                                "target_lang_word": "поклонники",
                                "target_lang_sense_clarification": "почитатели таланта"
                            },
                            {
                                "target_lang_word": "аудитория",
                                "target_lang_sense_clarification": "публика, слушатели"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takipçi kitlesi",
                                "target_lang_sense_clarification": "hayranlar veya destekçiler"
                            },
                            {
                                "target_lang_word": "kitle",
                                "target_lang_sense_clarification": "dinleyici/izleyici kitlesi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ae90061-536c-399f-89f4-e5325b9a0005",
                    "sense_definition": "The thing or things that are about to be mentioned.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>following</w> is a list of all the winners from the competition.",
                            "target_lang_translations": {
                                "ru": "<w>Ниже</w> представлен список всех победителей конкурса.",
                                "tr": "<w>Aşağıdakiler</w> yarışmadaki tüm kazananların listesidir."
                            }
                        },
                        {
                            "text": "Please include the <w>following</w> in your application letter.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, включите <w>следующее</w> в ваше заявление.",
                                "tr": "Lütfen başvuru mektubunuza <w>şunları</w> dahil edin."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the following is",
                        "include the following"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, что будет упомянуто далее.",
                        "tr": "Hemen ardından bahsedilecek olan şey veya şeyler."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "следующее",
                                "target_lang_sense_clarification": "то, что идет дальше"
                            },
                            {
                                "target_lang_word": "нижеследующее",
                                "target_lang_sense_clarification": "то, что приведено ниже"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "aşağıdakiler",
                                "target_lang_sense_clarification": "metinde belirtilen maddeler"
                            },
                            {
                                "target_lang_word": "şunlar",
                                "target_lang_sense_clarification": "takip eden hususlar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c657280-0667-397a-835e-c30f10f51bd6",
                    "sense_definition": "A user account on a social media platform that one subscribes to.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He checked his <w>followings</w> to see if anyone had posted new photos.",
                            "target_lang_translations": {
                                "ru": "Он проверил свои <w>подписки</w>, чтобы узнать, не выложил ли кто-нибудь новые фото.",
                                "tr": "Kimsenin yeni fotoğraf paylaşıp paylaşmadığını görmek için <w>takip ettiklerini</w> kontrol etti."
                            }
                        },
                        {
                            "text": "You can manage your <w>followings</w> in the settings menu of the app.",
                            "target_lang_translations": {
                                "ru": "Вы можете управлять своими <w>подписками</w> в меню настроек приложения.",
                                "tr": "Uygulamanın ayarlar menüsünden <w>takip ettiklerinizi</w> yönetebilirsiniz."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Учетная запись пользователя в социальной сети, на которую оформлена подписка.",
                        "tr": "Sosyal medyada bir kullanıcının abone olduğu/takip ettiği hesaplar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подписки",
                                "target_lang_sense_clarification": "список тех, кого читаешь в соцсетях"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "takip edilenler",
                                "target_lang_sense_clarification": "sosyal medya takipleri"
                            },
                            {
                                "target_lang_word": "takipler",
                                "target_lang_sense_clarification": "takip edilen hesap listesi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}