                        "entry_id": "7dc0fc78-5cb5-3092-8332-e68601ecb5a7",
                        "glosses": [
                            "The act of construing: interpreting, portraying, or both."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3448c55e-c902-4b20-9870-c3df4707e0f7",
                                "sense_id": "eb6f9a76-1c51-33da-a227-3f2a657330dd",
                                "text": "Near-synonyms: interpretation, portrayal"
