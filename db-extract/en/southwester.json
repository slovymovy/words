                "entry_id": "ac4ca11b-5252-3152-9922-aed9fb4168b1",
                "word": "southwester",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cdb6f10c-a3cf-464f-82bb-c3acd3b5c376",
                        "entry_id": "ac4ca11b-5252-3152-9922-aed9fb4168b1",
                        "tags": [
                            "plural"
                        ],
                        "form": "southwesters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20c542c3-5ef8-3323-bba7-99988666b310",
                        "entry_id": "ac4ca11b-5252-3152-9922-aed9fb4168b1",
                        "glosses": [
                            "A strong wind blowing from the southwest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9381d948-1f5c-4b1e-ba00-e5e0a397b52e",
                                "sense_id": "20c542c3-5ef8-3323-bba7-99988666b310",
                                "text": "Have you ever stood at the edge of a great wood on a high ridge when a wild south-wester broke over it in full fury on an autumn evening?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9506da53-ef53-3d2d-9321-c4b49a871330",
                        "entry_id": "ac4ca11b-5252-3152-9922-aed9fb4168b1",
                        "glosses": [
                            "A waterproof hat, often of oilskin and with a long brim at the back covering the neck, designed to repel wind and rain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "b5ffb2c8-4bc3-348f-ac3e-255e41fa65e3",
                        "entry_id": "ac4ca11b-5252-3152-9922-aed9fb4168b1",
                        "glosses": [
                            "A long raincoat, often worn at sea."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "416a37fb-8136-4abc-903c-41b9fb28d405",
                        "source_entry_id": "ac4ca11b-5252-3152-9922-aed9fb4168b1",
                        "source_sense_description": "wind",
                        "target_lang_word": "suroît",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suroît",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "386a0893-b528-3b34-b58e-4b53940f4096",
                                        "entry_id": "3d0cc2e0-9c4d-3040-9414-908effdfef6e",
                                        "glosses": [
                                            "Direction sud-ouest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e2f5bb0-d280-357c-b6b0-502d60790700",
                                        "entry_id": "3d0cc2e0-9c4d-3040-9414-908effdfef6e",
                                        "glosses": [
                                            "Vent du sud-ouest."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "387fd5bf-6db1-41aa-9c53-7be8ca6eca79",
                                                "sense_id": "6e2f5bb0-d280-357c-b6b0-502d60790700",
                                                "text": "Une tempête de suroît."
                                            },
                                            {
                                                "example_id": "2b6108b3-3d31-4ead-90ac-c7be233827c5",
                                                "sense_id": "6e2f5bb0-d280-357c-b6b0-502d60790700",
                                                "text": "D’autant que, Leterrier ne me contredira point, c’est pas d’la brume de mer, c’tte brume-là : le vent est quasi de suroît, c’est de la brume de terre."
                                            },
                                            {
                                                "example_id": "18e0f5ca-6580-490c-9193-2656daa94721",
                                                "sense_id": "6e2f5bb0-d280-357c-b6b0-502d60790700",
                                                "text": "Et tout à coup,sans sommation, l’invisible tempête de suroît se rue sur nous avec la violence d’une charge de cavalerie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ebfc6ce-a3a9-3716-a315-ea49485ba714",
                                        "entry_id": "3d0cc2e0-9c4d-3040-9414-908effdfef6e",
                                        "glosses": [
                                            "Chapeau imperméable qui protège la tête et la partie postérieure du cou des marins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1978699d-80a3-43b7-8b8f-91dd759d68cf",
                                                "sense_id": "3ebfc6ce-a3a9-3716-a315-ea49485ba714",
                                                "text": "À cause de la pluie, personne n’était sorti, sauf le vieux M. Thévenard qui, en ciré de marin, un suroît sur la tête, était allé prendre sa place au bout de la jetée."
                                            },
                                            {
                                                "example_id": "f30a0c55-ee87-4b7b-a1b2-d65601088c17",
                                                "sense_id": "3ebfc6ce-a3a9-3716-a315-ea49485ba714",
                                                "text": "Par-dessous, il y avait un vieux suroît blanchi aux embruns de bien des môles."
                                            },
                                            {
                                                "example_id": "1c2489c3-cec2-48e8-9e79-a9ef1db3d286",
                                                "sense_id": "3ebfc6ce-a3a9-3716-a315-ea49485ba714",
                                                "text": "Ces cinq hommes étaient vêtus pareillement, un épais tricot de laine bleue serrant le torse et s’enfonçant dans la ceinture du pantalon ; sur la tête, l’espèce de casque en toile goudronnée qu’on appelle suroît (du nom de ce vent de sud-ouest qui dans notre hémisphère amène les pluies)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
