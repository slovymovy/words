                "senses": [
                    {
                        "sense_id": "986b8490-7ef3-3009-ba34-62838ae6c35d",
                        "entry_id": "4824aba6-8f5b-345d-9844-8474e5637bf4",
                        "glosses": [
                            "Réaliser un mixage préalable (en cuisine)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "98bc9710-382d-4c8c-8a2d-8bb8fde072a4",
                                "sense_id": "986b8490-7ef3-3009-ba34-62838ae6c35d",
                                "text": "Pour éviter les grumeaux dans votre pâte à savon, il faut utiliser un moussoir à lait pour pré-mixer les pigments avec un peu d’huile liquide avant de l’ajouter au savon pour disperser et casser les grumeaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "8fd82c20-27b5-3f52-961d-d30110ad366d",
                        "entry_id": "4824aba6-8f5b-345d-9844-8474e5637bf4",
                        "glosses": [
                            "Réaliser un mixage préalable (en musique)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9e8d426-d9c0-433c-91b0-decffd6b5759",
                                "sense_id": "8fd82c20-27b5-3f52-961d-d30110ad366d",
                                "text": "Une console multipistes permet de traiter un à un chaque instrument et de pré-mixer toute la partie orchestrale avant l’arrivée du chanteur, avec la possibilité de garder plusieurs prises de voix et de ne conserver que les meilleurs passages repérés piste par piste…"
                            },
                            {
                                "example_id": "03af5427-bcb8-4cb1-b451-443b44629634",
                                "sense_id": "8fd82c20-27b5-3f52-961d-d30110ad366d",
                                "text": "C’est pour cette raison que je prends toujours du temps pour pré-mixer la batterie et la basse avant de m’occuper du son de guitare."
                            }
                        ]
                    }
                ],
