                                        "entry_id": "1417633b-3907-3035-a8c2-ce6c7fc7a9d1",
                                        "glosses": [
                                            "Celui qui est coupable de contrefaçon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40aceb1a-dd28-4615-96d3-5b8d2359c726",
                                                "sense_id": "1b4ad620-39ae-3a9c-bd50-f9d7365cba2a",
                                                "text": "Il a été puni comme contrefacteur."
                                            },
                                            {
                                                "example_id": "ca945eeb-64ba-4761-96d4-c8aa2823c2d4",
                                                "sense_id": "1b4ad620-39ae-3a9c-bd50-f9d7365cba2a",
                                                "text": "Un contrefacteur doit certainement avoir le droit de se défendre devant le tribunal du pays où il est supposé avoir commis cette violation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "347e8594-0d8c-4bbb-986e-05866c142074",
                        "source_entry_id": "3b68cc30-ff40-31d1-a2d8-2006700fd9ad",
