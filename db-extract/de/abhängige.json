                        "entry_id": "893db10b-629a-3d79-a0de-6ba9353aa631",
                        "glosses": [
                            "weibliche Person, die jemanden oder etwas dringend zum Leben braucht, davon in einer gewissen Art abhängig ist, der zum Beispiel auf (finanzielle) Unterstützung/Hilfe oder Medikamente/Suchtmittel angewiesen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7de2e66-f93f-43ef-94e0-b85fc2073319",
                                "sense_id": "0da3eea0-4af8-35be-92a7-c8f1c02bce0b",
                                "text": "„Und die meisten Männer haben inzwischen erkannt: Mit Abhängigen zu leben, macht keinen Spaß. Die meisten Männer wollen nicht mehr mit Püppchen zusammen sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
