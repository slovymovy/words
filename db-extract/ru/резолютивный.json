                                            {
                                                "example_id": "0474f9e9-e1dd-4b6c-a665-68e117363bf6",
                                                "sense_id": "d116a104-5850-3510-9865-8ae0fdbfda21",
                                                "text": "Practically 50 per cent of the female operatives are found in the two groups aged 15 to 19 and 20 to 24 years, while only 18.2 per cent of the female nonoperatives are found in these age groups."
