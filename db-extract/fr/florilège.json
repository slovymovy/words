        "fr-extract.jsonl": [
            {
                "entry_id": "341bd4f9-f62a-38ae-9168-4fdab65c6ef4",
                "word": "florilège",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "79d9be24-5650-4226-9ca2-3f8a1275407f",
                        "entry_id": "341bd4f9-f62a-38ae-9168-4fdab65c6ef4",
                        "tags": [
                            "plural"
                        ],
                        "form": "florilèges"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fcad6877-4ecc-3740-a0a8-1681c7a3363c",
                        "entry_id": "341bd4f9-f62a-38ae-9168-4fdab65c6ef4",
                        "glosses": [
                            "Recueil de fleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b4ce72d-481e-40cd-b6dc-a8fd0db23436",
                                "sense_id": "fcad6877-4ecc-3740-a0a8-1681c7a3363c",
                                "text": "Les herbiers, qui décrivaient les plantes utiles, sont détrônés par les florilèges où les plantes sont étudiées et illustrées pour leur beauté et leur caractère ornemental."
                            }
                        ]
                    },
                    {
                        "sense_id": "873a2c58-919e-34ac-876f-e76b2d43e2f5",
                        "entry_id": "341bd4f9-f62a-38ae-9168-4fdab65c6ef4",
                        "glosses": [
                            "Recueil de pièces choisies de poésie ou de textes littéraires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13b8a4c3-15c3-4412-b3c3-49d6f3371ded",
                                "sense_id": "873a2c58-919e-34ac-876f-e76b2d43e2f5",
                                "text": "La production hagiographique de la période moderne offre un florilège de textes longs (plusieurs centaines de pages) ou courts (de deux à quelques dizaines de folios), en prose ou en vers, portant sur des saints espagnols ou italiens."
                            },
                            {
                                "example_id": "84acb463-8006-4563-af31-735018057013",
                                "sense_id": "873a2c58-919e-34ac-876f-e76b2d43e2f5",
                                "text": "En 1973, quand le centre d'activités culturelles et de loisirs de Sully organisait son « florilège musical » en présentant un récital de guitare, un récital d'orgue et un concert de l'Ensemble instrumental Andrée Colson, tu n'étais pas intéressé encore ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "204d2de3-95c3-394c-a15c-b9698d71edd9",
                        "entry_id": "341bd4f9-f62a-38ae-9168-4fdab65c6ef4",
                        "glosses": [
                            "Collection, catégorie, groupe."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "9579aa9f-24e4-4040-86c0-f323bcfe02c2",
                                "sense_id": "204d2de3-95c3-394c-a15c-b9698d71edd9",
                                "text": "Il ajoutait au florilège des gens qui frappent du poing le rebord de la table où ils viennent de se cogner, ou bien cassent le poste de téléphone qui apporte les mauvaises nouvelles, une autre catégorie de justiciers : ceux qui bousillent la route sur laquelle leurs proches ont péri."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1141cb0-9d3a-4cc5-8391-77f906f708fa",
                        "source_entry_id": "341bd4f9-f62a-38ae-9168-4fdab65c6ef4",
                        "source_sense_description": "Recueil (botanique)",
                        "target_lang_word": "bloemlezing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bloemlezing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1e857f5b-0013-3dd4-b940-d2f7d8565e4b",
                                        "entry_id": "ac3e6b5f-e703-320c-81f5-a7d13cb91c43",
                                        "glosses": [
                                            "een boek samengesteld uit een keuze van werken van een of meer schrijvers, compilatiewerk, anthologie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1890fc9f-3a8f-46e3-84f6-f58ca581db95",
                                                "sense_id": "1e857f5b-0013-3dd4-b940-d2f7d8565e4b",
                                                "text": "- Joost Zwagerman heeft enkele bloemlezingen uit de Nederlandse en Vlaamse literatuur samengesteld."
                                            },
                                            {
                                                "example_id": "935170fe-8fe7-4be8-86de-dbf7fa5e1f66",
                                                "sense_id": "1e857f5b-0013-3dd4-b940-d2f7d8565e4b",
                                                "text": "- Ik proef iets wat bedorven is. Zo heet de verzameling hekeldichten waarin Nederlandse dichters hun boosheid uiten over een reeks onderwerpen. De bloemlezing is een initiatief van de voormalige Rotterdamse stadsdichter Daniël Dee, zijn gewezen Vlaardingse evenknie Benne van der Velde en Alexis de Roode van het Utrechts stadsdichtersgilde. Zij dragen er uit voor tijdens de Rotterdamse presentatie van de doos van Passage, een collectie van tien nieuwe dichtbundels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
