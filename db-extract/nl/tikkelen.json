                        ],
                        "examples": [
                            {
                                "example_id": "f4134cb1-9f5e-44d8-84c4-d87c2f3ea4ef",
                                "sense_id": "b063f5f8-8649-34ae-ae50-27a4e3ca3f65",
                                "text": "Een grasspriet tikkelde aan tegen haar neus, een vlieg mafte rustig op haar koon."
