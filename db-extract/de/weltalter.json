                                    },
                                    {
                                        "sense_id": "5d21ac45-1fd4-3a65-8be4-120401ca8079",
                                        "entry_id": "419648a0-9e03-3f69-86e7-bc36027fbf29",
                                        "glosses": [
                                            "A long period of time."
                                        ],
                                        "tags": [
                                            "US",
                                            "excessive",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "91f9995d-9f74-4731-b668-8aa31860d9f0",
                                                "sense_id": "5d21ac45-1fd4-3a65-8be4-120401ca8079",
                                                "text": "It’s been eons since we last saw each other."
                                            },
                                            {
                                                "example_id": "8263047a-85f1-4ce1-b461-3b74d7b54fc2",
                                                "sense_id": "5d21ac45-1fd4-3a65-8be4-120401ca8079",
                                                "text": "Traditionally, a luncheon is a lunch that takes an eon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdc79a66-105e-3e1f-b7e4-a3dfbbb85b90",
                                        "entry_id": "419648a0-9e03-3f69-86e7-bc36027fbf29",
                                        "glosses": [
                                            "A period of one billion (short scale, i.e. 1,000,000,000) years."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0474d9ac-a332-4ef4-abf2-3019713925f3",
                                                "sense_id": "bdc79a66-105e-3e1f-b7e4-a3dfbbb85b90",
                                                "text": "We live our lives in three dimensions for our threescore and ten allotted years. Yet every branch of contemporary science, from statistics to cosmology, alludes to processes that operate on scales outside of human experience: the millisecond and the nanometer, the eon and the light-year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "891a263c-6f60-3fcc-92ce-839ff1ae3caa",
                                        "entry_id": "419648a0-9e03-3f69-86e7-bc36027fbf29",
                                        "glosses": [
                                            "The longest geochronologic unit, being a period of hundreds of millions of years; subdivided into eras."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a185c99d-c843-3284-aaf1-3741fe2851f4",
