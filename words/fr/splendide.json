            "senses": [
                {
                    "sense_id": "a7b2e19d-e6c1-3e60-b1ef-96f43d974be0",
                    "sense_definition": "D'une beauté remarquable, qui suscite l'admiration par sa grandeur ou son élégance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "beaute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Depuis le sommet de la montagne, nous avons admiré une vue <w>splendide</w> sur la vallée."
                        },
                        {
                            "text": "Elle portait une robe <w>splendide</w> confectionnée sur mesure pour cette grande occasion."
                        }
                    ],
                    "synonyms": [
                        "grandiose",
                        "magnifique",
                        "somptueux"
                    ],
                    "common_phrases": [
                        "une vue splendide",
                        "un décor splendide"
                    ]
                },
                {
                    "sense_id": "8d3119cd-19f0-3df1-bc25-2ede77e20fa1",
                    "sense_definition": "Qui brille d'un éclat remarquable, en parlant du temps ou de la lumière.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eclat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons profité d'une <w>splendide</w> journée d'été pour nous promener au bord du lac."
                        },
                        {
                            "text": "Le ciel parfaitement dégagé offrait un <w>splendide</w> coucher de soleil sur l'horizon."
                        }
                    ],
                    "synonyms": [
                        "magnifique"
                    ],
                    "common_phrases": [
