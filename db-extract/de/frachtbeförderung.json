                ],
                "senses": [
                    {
                        "sense_id": "c1954a1c-4565-3479-ad28-84f4954d7c7e",
                        "entry_id": "adb68e60-196e-3c1e-8c59-9c5818a1e067",
                        "glosses": [
                            "die Beförderung von Fracht, das Transportieren von Fracht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b2bd1a9-a936-493b-b1dd-ddee10ba143e",
                                "sense_id": "c1954a1c-4565-3479-ad28-84f4954d7c7e",
                                "text": "Früher war der Hauptzweck von Schiffen die Frachtbeförderung, im Laufe der Zeit gewann jedoch die Passagierbeförderung an Wichtigkeit."
                            },
                            {
                                "example_id": "6e28239b-ec7f-4b66-8165-ddb7c69d1d6e",
                                "sense_id": "c1954a1c-4565-3479-ad28-84f4954d7c7e",
                                "text": "„Basis der positiven Einschätzungen der Lufthansa ist deren „sehr gute globale Marktposition“, wie die BayernLB konstatiert, und deren „breit diversifiziertes Geschäftsmodell und die Rolle als führender Anbieter von Frachtbeförderung, Wartungs- und Reparaturarbeiten für andere Airlines“, so die LBBW.“"
                            },
                            {
                                "example_id": "3ff6b352-5370-4ff4-bd14-3724e3e89ece",
                                "sense_id": "c1954a1c-4565-3479-ad28-84f4954d7c7e",
                                "text": "„Erstmals seit 2001 musste auch die Luftfahrt-Frachtbeförderung Rückgänge einstecken, mit 3,2 Millionen Tonnen wurden 7,7 Prozent weniger Güter transportiert als 2008.“"
                            },
                            {
                                "example_id": "bb829f69-8682-4560-8b2a-aac020115029",
                                "sense_id": "c1954a1c-4565-3479-ad28-84f4954d7c7e",
                                "text": "„Mit dem operativen Gewinnanstieg konnte die größte deutsche Fluggesellschaft den gestiegenen Ölpreis mehr als kompensieren. Dazu trugen unter anderem Rekordwerte bei der Passagier- und Frachtbeförderung sowie höhere Erlöse pro Ticket bei.“"
                            },
                            {
                                "example_id": "033a3471-3fe2-41dd-9d5d-9d3598583484",
                                "sense_id": "c1954a1c-4565-3479-ad28-84f4954d7c7e",
                                "text": "„Seit im Bonner Finanzressort die Dimensionen des neuen Berlin-Problems erkannt sind, versuchen sich die Steuer-Beamten an der Definition einer \"kleineren Lösung\": Die Lufthansa bliebe dabei steuerfrei wie jede andere \"gewerbliche Personen- oder Frachtbeförderung\".“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
