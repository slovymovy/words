                                        "sense_id": "954c05a3-8d4a-3390-a28e-ee7f8e670d86",
                                        "entry_id": "7c905a70-4db4-317b-aff2-e3b3a76880bc",
                                        "glosses": [
                                            "The Amharic language."
                                        ],
