                                                "text": "Artificial conversion of water into ice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d2c688e-0eff-3336-b787-3ce53badc4d5",
                                        "entry_id": "0a7af01f-9756-3917-bcc7-284c954f52ec",
                                        "glosses": [
