                ],
                "senses": [
                    {
                        "sense_id": "8333ae1c-0c34-3a94-bc42-d618e3b7c569",
                        "entry_id": "15428588-b3b1-398a-8034-c924df737dbd",
                        "glosses": [
                            "aus Wolle bestehender Mantel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9fb2836-6d17-42a0-b746-798ddbd8272b",
                                "sense_id": "8333ae1c-0c34-3a94-bc42-d618e3b7c569",
                                "text": "„Sie strich über den Ärmel des Wollmantels.“"
                            },
                            {
                                "example_id": "bdfa5fd9-b038-4693-8bce-cb5ca5544f11",
                                "sense_id": "8333ae1c-0c34-3a94-bc42-d618e3b7c569",
                                "text": "„Er trug seinen üblichen steifen Wollmantel mit hochgeschlagenem Kragen, die Schuhe am Ende seiner langen, schlanken Beine waren frisch poliert und Schnurrbart und Haar sorgfältig geschnitten.“"
                            },
                            {
                                "example_id": "418b1d5e-d77a-4d12-8f08-bc2f93a1af65",
                                "sense_id": "8333ae1c-0c34-3a94-bc42-d618e3b7c569",
                                "text": "„Er lag in einem der Kartons aus Berg, ein dünner blauer Wollmantel, den ich eingepackt hatte, weil er Ähnlichkeit mit Kleidungsstücken hatte, die ich selbst gern anzog.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
