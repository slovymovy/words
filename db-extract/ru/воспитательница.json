                    {
                        "translation_id": "3cc60aed-b225-4dc5-ae63-7e643e4174be",
                        "source_entry_id": "22dc8f00-907e-3cd1-8e68-27a18e8871c6",
                        "source_sense_id": "76dfdc14-89bb-3643-b87e-c767922a4469",
                        "target_lang_word": "éducatrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "éducatrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0dc09e07-3267-30d0-b3be-0ad6433fa7af",
                                        "entry_id": "cdad4ae9-abf2-3b41-af2b-2123261f869d",
                                        "glosses": [
                                            "Celle qui transmet un savoir, une habileté, en dehors d’un cadre strictement scolaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69df6d94-4101-4819-a6f0-0b193d07592e",
                                                "sense_id": "0dc09e07-3267-30d0-b3be-0ad6433fa7af",
                                                "text": "Bon gré mal gré, madame Nadine commence sa leçon et s’affaire à sa tâche, pendant que Farouk est à l’ordinateur, écouteurs sur les oreilles, accompagné d’une éducatrice."
                                            },
                                            {
                                                "example_id": "d3d750a2-5d0b-490b-8122-96a63d14476f",
                                                "sense_id": "0dc09e07-3267-30d0-b3be-0ad6433fa7af",
                                                "text": "Éducatrices sportives diplômées d’État, Sandrine Martin et Maguy Roucoules sont toutes les deux férues de Zumba."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4c2daa-7903-3ff6-8fc7-d22dfd8fc180",
                                        "entry_id": "cdad4ae9-abf2-3b41-af2b-2123261f869d",
                                        "glosses": [
                                            "Dans un sens plus large, se dit des penseuses, des écrivaines qui forment l’esprit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d70ed2f-c632-4712-ba91-3b49b0927ad4",
                                                "sense_id": "8f4c2daa-7903-3ff6-8fc7-d22dfd8fc180",
                                                "text": "Cette critique a été une utile éducatrice du goût."
                                            }
                                        ]
                                    }
                                ]
