                {
                    "sense_id": "3d51f555-7148-3a4a-bd56-800a85508202",
                    "sense_definition": "Процесс изготовления печатной продукции (книг, журналов) или фотографий.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "printing_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Новая книга готовится в <печать> и выйдет в следующем месяце.",
                            "target_lang_translations": {
                                "en": "The new book is being prepared for <w>print</w> and will be released next month.",
                                "es": "El nuevo libro se está preparando para la <w>imprenta</w> y saldrá el mes que viene.",
                                "fr": "Le nouveau livre est en cours d'<w>impression</w> et sortira le mois prochain."
                            }
                        },
                        {
                            "text": "Качество <печати> в этом журнале очень высокое.",
                            "target_lang_translations": {
                                "en": "The quality of <w>printing</w> in this magazine is very high.",
                                "es": "La calidad de <w>impresión</w> en esta revista es muy alta.",
                                "fr": "La qualité d'<w>impression</w> dans ce magazine est très élevée."
                            }
