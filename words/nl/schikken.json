                        "weerstaan"
                    ],
                    "common_phrases": [
                        "zich schikken naar"
                    ],
                    "target_lang_definitions": {
                        "en": "to adapt oneself to a situation or the will of another, often without protest"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "adapt",
                                "target_lang_sense_clarification": "to adjust to circumstances"
                            },
                            {
                                "target_lang_word": "comply",
                                "target_lang_sense_clarification": "to follow someone's wishes"
                            },
                            {
                                "target_lang_word": "resign oneself",
                                "target_lang_sense_clarification": "to accept a situation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "056bba3e-353a-3918-9247-3640e112108b",
                    "sense_definition": "een officieel conflict of juridisch geschil oplossen zonder tussenkomst van een rechter",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De twee bedrijven besloten de zaak te <w>schikken</w> voor een groot bedrag.",
                            "target_lang_translations": {
                                "en": "The two companies decided to <w>settle</w> the case for a large sum."
                            }
                        },
                        {
                            "text": "Trump <w>schikt</w> met omroep ABC om een rechtszaak te vermijden.",
                            "target_lang_translations": {
                                "en": "Trump <w>settles</w> with broadcaster ABC to avoid a lawsuit."
                            }
                        }
                    ],
                    "synonyms": [
                        "vergelijken",
                        "bijleggen"
                    ],
                    "antonyms": [
                        "procederen"
                    ],
                    "common_phrases": [
                        "een zaak schikken"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in juridische context"
                        }
                    ],
                    "target_lang_definitions": {
