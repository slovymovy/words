                                    {
                                        "sense_id": "2b653a15-b3e6-3880-99fb-8fa0ea71bc90",
                                        "entry_id": "d16e29da-813c-331c-80e5-1d5fb5f7ec14",
                                        "glosses": [
                                            "Densité ; nombre de tiges, généralement rapporté à l’hectare, d’un peuplement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ccefeb0-8fd4-4123-8ecb-21dcf76997d9",
                                                "sense_id": "2b653a15-b3e6-3880-99fb-8fa0ea71bc90",
                                                "text": "Le prélèvement est d’au moins 33 % du nombre initial de tiges pour les peuplements relativement clairs (N < 2000 ou 2,500 t/ha respectivement en épicéa ou sapin), et il peut aller jusqu’à 50 %."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "N",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "999cec81-69f9-3d4c-8697-432b17b08f13",
                                        "entry_id": "d2c19770-0dcb-3a30-a4fc-f644de3a62cb",
                                        "glosses": [
                                            "Échelle correspondant au rapport 1:160."
                                        ],
                                        "tags": [
                                            "Modélisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "719d75ef-59f4-4dab-9b75-d9958e3a4b67",
                                                "sense_id": "999cec81-69f9-3d4c-8697-432b17b08f13",
                                                "text": "Ça fait un certain nombre d’années que je pratique le N, et je ne comprends pas pourquoi on ne trouve pas du matériel plus accessible à cette échelle."
                                            },
                                            {
                                                "example_id": "f16c3a5c-86d4-4331-9674-223141933798",
                                                "sense_id": "999cec81-69f9-3d4c-8697-432b17b08f13",
                                                "text": "Ce type de bogie, même en N, étant quasiment introuvable, sauf en pièces détachées de remplacement (et à des prix défiant toute concurrence) je les ai fabriqués là encore en Kraftplex de 0,8 d’épaisseur […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
