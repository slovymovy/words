                                        "examples": [
                                            {
                                                "example_id": "fdccd855-a1c3-4ca9-9a5f-07f026d62f01",
                                                "sense_id": "6c4b3d65-6b0d-3aa9-aa52-c4784379ab05",
                                                "text": "The surreality of the crash scene dawned upon him only when he saw a holy figure in the smoke."
                                            },
                                            {
                                                "example_id": "00ab22a5-6671-4431-88b2-aeea2e2e533a",
                                                "sense_id": "6c4b3d65-6b0d-3aa9-aa52-c4784379ab05",
                                                "text": "And when he goes to greet his mother the surreality of it all stares him in the face: in two years she's turned into a little old lady."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97094099-633d-31b5-9801-5896c7243c4b",
                                        "entry_id": "9eb2e5ab-3e63-3750-a009-ce586ba9099b",
                                        "glosses": [
                                            "That which is surreal; a surreal entity, event or other fact."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
