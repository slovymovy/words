{
    "word": "apograph",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4538846d-0f2c-3392-aa14-8ffe03577dbd",
                "word": "apograph",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "caffd38b-a79d-48f2-83c3-f10f62a32419",
                        "entry_id": "4538846d-0f2c-3392-aa14-8ffe03577dbd",
                        "tags": [
                            "plural"
                        ],
                        "form": "apographs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a502bd6a-f204-384d-a3f4-936185781960",
                        "entry_id": "4538846d-0f2c-3392-aa14-8ffe03577dbd",
                        "glosses": [
                            "A copy or transcript of a manuscript (called the antigraph)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb86dbf1-9ab0-40bb-a178-b4a7701a2495",
                                "sense_id": "a502bd6a-f204-384d-a3f4-936185781960",
                                "text": "Moreover, this is not a holograph but an apograph, made by a scribe for the printers – you will note that both mayors write the same hand."
                            },
                            {
                                "example_id": "b66acdd2-fc03-434d-843b-3854f6c2ffce",
                                "sense_id": "a502bd6a-f204-384d-a3f4-936185781960",
                                "text": "For both C and R, as well as for all other corpora of Slavic manuscripts, including I and L, it has always been tacitly assumed that the scribe did not merely copy, but verified the text of his apograph via his own pronunciation (externally or internally), or even wrote upon dictation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ec3c0276-ea47-401e-b9ef-47cb9a411f8c",
                        "source_entry_id": "4538846d-0f2c-3392-aa14-8ffe03577dbd",
                        "source_sense_id": "a502bd6a-f204-384d-a3f4-936185781960",
                        "source_sense_description": "perfect copy",
                        "target_lang_word": "Abschrift",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abschrift",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                        "entry_id": "d6ed3710-e6f5-3b72-bfc8-7998d4aa4339",
                                        "glosses": [
                                            "durch Abschreiben erzeugte Kopie eines Schriftstücks"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58d1fe25-97ee-4702-aed4-d372c8185bcd",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "Diese Abschrift wurde von einem Mönch im Mittelalter angefertigt."
                                            },
                                            {
                                                "example_id": "fb91c1a7-df8f-40a8-9872-f67fb06a44f5",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "Die Abschriften der Dokumente sind in den Kriegswirren verloren gegangen."
                                            },
                                            {
                                                "example_id": "a4595c37-c645-4fc4-a98d-82b597cd9b7b",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "„Zum Glück erlaubte der von allem Antiken begeisterte Kirchenfürst sehr bald, dass Abschriften hergestellt wurden.“"
                                            },
                                            {
                                                "example_id": "14a76e6d-8ce3-441f-bdd0-8643c2c54507",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "„Die vorliegende Abschrift entstand acht Jahrzehnte später.“"
                                            },
                                            {
                                                "example_id": "62ae306c-2f24-461e-8a3a-d43243765365",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "„Sämtliche Glossen stammen aus der Entstehungszeit dieser Werke und werden seit jeher in den meisten Abschriften und Drucken mit aufgeführt.“"
                                            },
                                            {
                                                "example_id": "1dfafa45-d1f6-4511-b629-184539744e31",
                                                "sense_id": "cd598dfc-3eaf-311d-a436-56c80519a15c",
                                                "text": "„Man weiß jedoch nicht, wo und von wem sie hergestellt wurde. Wahrscheinlich irgendwo in einem Kloster, wo Abschriften zumeist geleistet wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d999590b-3ed2-424d-b383-e52fb9c892ef",
                        "source_entry_id": "4538846d-0f2c-3392-aa14-8ffe03577dbd",
                        "source_sense_id": "a502bd6a-f204-384d-a3f4-936185781960",
                        "source_sense_description": "perfect copy",
                        "target_lang_word": "Kopie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kopie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cbfebfac-11c4-3f21-8ce5-e940fa73107b",
                                        "entry_id": "54199912-ff58-3ef1-bbaf-e701ee3f9965",
                                        "glosses": [
                                            "Nachbildung/Wiedergabe eines Originals"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "178c7e07-f7d2-4697-ad75-d983528ab479",
                                                "sense_id": "cbfebfac-11c4-3f21-8ce5-e940fa73107b",
                                                "text": "Das Bild ist leider nur eine Kopie - das Original wäre ja unbezahlbar."
                                            },
                                            {
                                                "example_id": "b929692b-daad-4c78-ab83-b5b005b64961",
                                                "sense_id": "cbfebfac-11c4-3f21-8ce5-e940fa73107b",
                                                "text": "„Ermittler stießen auf dieses Datum, nachdem auch ihnen die Mails in Kopie anonym zugeschickt worden waren.“"
                                            },
                                            {
                                                "example_id": "986fe8ab-6d14-468d-bb6e-138dc6666c89",
                                                "sense_id": "cbfebfac-11c4-3f21-8ce5-e940fa73107b",
                                                "text": "„Es war notwendig, der Kopie der Kreuzigung, aber auch ihr selbst zu entkommen, und der Maler mußte denken, daß man Rücksicht auf ihn nehme.“"
                                            },
                                            {
                                                "example_id": "21b5bf4d-cda6-465d-a784-b1b993493ea7",
                                                "sense_id": "cbfebfac-11c4-3f21-8ce5-e940fa73107b",
                                                "text": "„Auch etliche Kaufleute begeistern sich für die Texte, erwerben die kostbaren Schriften oder lassen Kopien anfertigen.“"
                                            },
                                            {
                                                "example_id": "168c12e9-deb5-408b-9dfd-bd943e311418",
                                                "sense_id": "cbfebfac-11c4-3f21-8ce5-e940fa73107b",
                                                "text": "„Er holte ein Spiralbuch voller Notizen und Kopien von Archivdokumenten über das rätselhafte Schicksal der sterblichen Überreste des Kapitäns hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ac520fca-2cd4-33fb-a33f-dcf6b1d9f569",
                                        "entry_id": "54199912-ff58-3ef1-bbaf-e701ee3f9965",
                                        "glosses": [
                                            "speziell die Fotokopie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0560b01-fede-4984-9064-e05a8e9c770e",
                                                "sense_id": "ac520fca-2cd4-33fb-a33f-dcf6b1d9f569",
                                                "text": "Der Toner geht zur Neige, deshalb sind die Kopien etwas heller."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
