                                                "sense_id": "14327e01-21d8-37c8-9048-717d4616d3ca",
                                                "text": "Musiker aus der halben Welt trafen auf ein begeistertes Publikum."
                                            },
                                            {
                                                "example_id": "ff5102a4-233e-465d-bd7e-aa1d03accad7",
                                                "sense_id": "14327e01-21d8-37c8-9048-717d4616d3ca",
                                                "text": "Sie brauchen keine zufriedenen Gäste. Sie brauchen begeisterte Fans."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "531b7e69-6920-38ee-a50c-8a47f05b8b99",
                                        "entry_id": "837e9646-50d0-3d61-9303-990434295784",
                                        "glosses": [
                                            "die Stimmung gemäß [1] ausdrückend, erkennen lassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84d10425-68e6-43bd-9088-3bea7902603d",
                                                "sense_id": "531b7e69-6920-38ee-a50c-8a47f05b8b99",
                                                "text": "Es war Margret Thatcher, der auf den Falklands ein begeisterter Empfang bereitet wurde."
                                            },
                                            {
                                                "example_id": "7ae34402-8062-4784-b6ca-d35909ad07b3",
                                                "sense_id": "531b7e69-6920-38ee-a50c-8a47f05b8b99",
                                                "text": "Als ihr Idol Tadeusz Rydzyk die Kirchentreppen emporschreitet, ertönt ein begeisterter Applaus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "394f7fae-f5df-3fd2-80df-5c4cedbfb3b9",
                                        "entry_id": "837e9646-50d0-3d61-9303-990434295784",
                                        "glosses": [
                                            "an etwas/jemandem besonders interessiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd01f952-d632-4c0c-a5f2-f0d021a3ec50",
                                                "sense_id": "394f7fae-f5df-3fd2-80df-5c4cedbfb3b9",
                                                "text": "Überhaupt waren die Römer begeisterte Sammler."
                                            },
                                            {
                                                "example_id": "792dfdb3-c579-41ec-8980-279de5c4d1a0",
                                                "sense_id": "394f7fae-f5df-3fd2-80df-5c4cedbfb3b9",
                                                "text": "Zu den begeistertsten Anhängern Mesmers in Frankreich zählten die beiden Brüder von Puysegúr, von welchen der eine (Herr von Buzancy) 1784 den künstlichen Somnabulismus entdeckte."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
