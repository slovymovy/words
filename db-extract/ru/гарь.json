                ],
                "translations": [
                    {
                        "translation_id": "9352125e-e5fc-45b4-a58c-0c57d9825196",
                        "source_entry_id": "91573682-dafe-389f-8187-6490affd929c",
                        "source_sense_description": "нечто горелое",
                        "target_lang_word": "cinder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cinder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c20f2ce6-7356-39ee-833d-1fa665b25647",
                                        "entry_id": "3c39e4f9-7c7d-398d-b4fa-3581631573ad",
                                        "glosses": [
                                            "Partially or mostly burnt material that results from incomplete combustion of coal or wood etc.; it often rides the rising smoke column into the air, and it can pose a fire hazard when it lands, in dry conditions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ab94ad4-04ec-49d2-8f4d-da46a1a994c2",
                                                "sense_id": "c20f2ce6-7356-39ee-833d-1fa665b25647",
                                                "text": "Travellers over the London & North Western main line in bygone days will need no reminder of the pattering of cinders on the carriage roofs, the fountains of sparks from the chimneys at night and the distance from which the exhaust of approaching locomotives could be heard, due to the fierceness of their blast in such conditions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a0d3137-86a0-33b3-a462-f157474fb102",
                                        "entry_id": "3c39e4f9-7c7d-398d-b4fa-3581631573ad",
                                        "glosses": [
                                            "An ember."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d00affe-6089-4341-bbc1-614c4cfde1fe",
                                                "sense_id": "5a0d3137-86a0-33b3-a462-f157474fb102",
                                                "text": "If from adown the hopeful chops\nThe fat upon the cinder drops,\nTo stinking smoke it turns the flame,\nPoisoning the flesh from whence it came"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa6dc9a5-5039-32c9-a0fa-5adeb41996c4",
                                        "entry_id": "3c39e4f9-7c7d-398d-b4fa-3581631573ad",
                                        "glosses": [
                                            "Slag from a metal furnace."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e33c27ce-cc7f-3d7c-b284-9c1b95e7c4b6",
                                        "entry_id": "3c39e4f9-7c7d-398d-b4fa-3581631573ad",
                                        "glosses": [
                                            "Any strong stimulant added to tea, soda water, etc."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e990da44-1fe9-4e0e-9331-8c29b2514fd2",
                                                "sense_id": "e33c27ce-cc7f-3d7c-b284-9c1b95e7c4b6",
                                                "text": "Oh, horrid proposition! One would imagine, Tom, that you had been a coal-heaver. Had you said soda and cinder, I would have seconded the motion."
                                            },
                                            {
                                                "example_id": "0261b2bd-f401-44bc-ace9-7fcda6127922",
                                                "sense_id": "e33c27ce-cc7f-3d7c-b284-9c1b95e7c4b6",
                                                "text": "She'd sit by the fire, arms crossed, demanding that Ruby spike her tea with a cinder. But Ruby would never give in to her demands, no matter how much her mam begged. There was no alcohol in the house now; Arthur had made sure of that in an effort to get Mary sober."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cinder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "084ee5bf-f5c8-3edb-871e-e55b12a4663f",
                                        "entry_id": "78347798-5bc5-3a07-a5b2-06db8c06abb7",
                                        "glosses": [
                                            "To reduce to cinders."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dc14696c-d45d-32a7-9aab-ae1cf5ecb354",
                                        "entry_id": "78347798-5bc5-3a07-a5b2-06db8c06abb7",
                                        "glosses": [
                                            "To cover with cinders."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ff11703-b542-41a3-bd48-f42a41deff62",
                                                "sense_id": "dc14696c-d45d-32a7-9aab-ae1cf5ecb354",
                                                "text": "We plan to cinder this path."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
