                        "entry_id": "424fca32-4e9b-3fde-9223-ef45dd7c4472",
                        "glosses": [
                            "verzameling bij elkaar passende kleuren die in een bepaalde situatie gebruikt kunnen worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "95def8e4-c39a-4dc5-8e52-8421cc4582ee",
                                "sense_id": "f2b950a7-3c47-3fae-b3c2-d3dbfb9a33ba",
                                "text": "Van Gogh was verbolgen over deze veronachtzaming van het natuurlijke kleurenschema van de streek."
                            },
                            {
                                "example_id": "314a780b-4359-4022-b480-277428490dc6",
                                "sense_id": "f2b950a7-3c47-3fae-b3c2-d3dbfb9a33ba",
                                "text": ",,Nee hoor, je hoeft geen kleurenschema aan te houden. Als je van rust houdt: kies dan één kleurfamilie, dus bijvoorbeeld licht- en donkergroen. Maar sommigen houden juist van colorclashing, kleuren gebruiken die tegenover elkaar staan."
                            }
                        ]
