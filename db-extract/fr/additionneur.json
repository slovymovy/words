                        "sense_id": "17c424b3-24cc-374e-bdd4-dc330c02b321",
                        "entry_id": "44e47be0-4d48-3092-8568-00e05f80a2b1",
                        "glosses": [
                            "Circuit électronique permettant de faire une addition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02de84f7-22f1-4a7d-a4f1-e97dccc8b775",
                                "sense_id": "17c424b3-24cc-374e-bdd4-dc330c02b321",
                                "text": "Il existe deux types d’additionneurs : parallèle et série."
                            },
                            {
                                "example_id": "58799e62-e0dc-4f25-958e-17874aef2099",
                                "sense_id": "17c424b3-24cc-374e-bdd4-dc330c02b321",
                                "text": "Cette logique nécessiterait que chaque position de mémoire dispose d’un conducteur qui la relierait directement à l’additionneur, ce qui est matériellement impossible lorsque l’on sait que le nombre de positions de mémoire dont dispose un ordinateur aujourd’hui se chiffre en milliards (gigaoctet) et il faudrait alors autant de conducteurs."
                            }
                        ]
                    }
                ],
