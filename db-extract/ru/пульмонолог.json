                                                "sense_id": "f723233c-9468-3052-aa93-276688d93e47",
                                                "text": "Córka Kowalczyka jest pulmonologiem."
                                            },
                                            {
                                                "example_id": "f425ce6c-6840-41b2-946b-ededee5ed6c2",
