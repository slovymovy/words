        "pl-extract.jsonl": [
            {
                "entry_id": "757f6ff5-8eae-3cd2-8e28-7c018f3a68bc",
                "word": "ewentualnie",
                "pos": "adv",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "02f3822a-c301-3202-9c69-75fb07d0487e",
                        "entry_id": "757f6ff5-8eae-3cd2-8e28-7c018f3a68bc",
                        "glosses": [
                            "w razie zaistnienia pewnych okoliczności"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60d37837-9a47-4ef2-9487-f37e440cc82f",
                                "sense_id": "02f3822a-c301-3202-9c69-75fb07d0487e",
                                "text": "Wiosną ewentualnie czeka dużo występów, wyjawia z tajemniczym spojrzeniem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "257031fe-74a4-3a3e-b8e9-44d3fcfe73bf",
                        "entry_id": "757f6ff5-8eae-3cd2-8e28-7c018f3a68bc",
                        "glosses": [
                            "lub, albo, czy też"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2791a2de-fd1f-40bc-8a0b-918342986d98",
                                "sense_id": "257031fe-74a4-3a3e-b8e9-44d3fcfe73bf",
                                "text": "Bronzer stosowany na całą twarz powinien być matowy lub ewentualnie satynowy"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "004ef8df-12e2-4772-b7cf-0ba81658ef97",
                        "source_entry_id": "757f6ff5-8eae-3cd2-8e28-7c018f3a68bc",
                        "source_sense_id": "02f3822a-c301-3202-9c69-75fb07d0487e",
                        "target_lang_word": "alternatively",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alternatively",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8061cbf8-6127-392b-9ea2-eeceac26fecb",
                                        "entry_id": "06f0f69d-84d7-3128-b105-9556f088df00",
                                        "glosses": [
                                            "in an alternative way"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "779ab1ee-8865-4fe8-a411-7ddae9a9ff19",
                                                "sense_id": "8061cbf8-6127-392b-9ea2-eeceac26fecb",
                                                "text": "Observers should keep in mind that these efforts at living alternatively are not easily undertaken; indeed, if they were, more people would be doing what they do."
                                            },
                                            {
                                                "example_id": "8d2f58bd-3492-452e-b56d-7f00a941e2d7",
                                                "sense_id": "8061cbf8-6127-392b-9ea2-eeceac26fecb",
                                                "text": "Thus, we are creating a new class struggle between those who live within the social system and those who are marginalized or wish to live alternatively."
                                            },
                                            {
                                                "example_id": "bee63f05-eded-4453-b668-55f2bee8f115",
                                                "sense_id": "8061cbf8-6127-392b-9ea2-eeceac26fecb",
                                                "text": "Devising obviously asks for what we understand as general creativity, like the ability to take an initiative, to invent, to think alternatively, to associate interestingly, to create metaphors and images."
                                            },
                                            {
                                                "example_id": "e130f848-69f0-4f63-bc87-73d2c3ec46b0",
                                                "sense_id": "8061cbf8-6127-392b-9ea2-eeceac26fecb",
                                                "text": "Most people living alternatively have strong pro-environmental values and, unlike many 'greens' in mainstream society, are generally able to apply their values in day-to-day life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "319499aa-0bb8-3d91-8056-b7dae651576e",
                                        "entry_id": "06f0f69d-84d7-3128-b105-9556f088df00",
                                        "glosses": [
                                            "Used to link a pair of opposing possibilities."
                                        ],
                                        "tags": [
                                            "conjunctive",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3c6f49f1-ecd8-45d4-9e91-c7aa43c8fffc",
                        "source_entry_id": "757f6ff5-8eae-3cd2-8e28-7c018f3a68bc",
                        "source_sense_id": "02f3822a-c301-3202-9c69-75fb07d0487e",
                        "target_lang_word": "возможно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "возможно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a4bb8558-55b2-37bd-be26-84db1112b6d8",
                                        "entry_id": "df4c501d-c566-3300-9166-d926ff127517",
                                        "glosses": [
                                            "предик. есть возможность"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d897365-0779-4d25-88fb-827a5377bd6d",
                                                "sense_id": "a4bb8558-55b2-37bd-be26-84db1112b6d8",
                                                "text": "Сделать это возможно."
                                            },
                                            {
                                                "example_id": "524cac88-385f-4174-832f-a1a1edf7d33d",
                                                "sense_id": "a4bb8558-55b2-37bd-be26-84db1112b6d8",
                                                "text": "Возможно наследование от большинства встроенных типов и типов расширений."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c8d60db-bbff-3ed5-9c7e-60a09333813a",
                                        "entry_id": "df4c501d-c566-3300-9166-d926ff127517",
                                        "glosses": [
                                            "вводн. сл., вероятно, по-видимому"
                                        ],
                                        "tags": [
                                            "указывает на вероятность события"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a9fdb44-ba1d-4c5a-ba6c-b82b7790d339",
                                                "sense_id": "5c8d60db-bbff-3ed5-9c7e-60a09333813a",
                                                "text": "Возможно, если бы речь шла об обещаниях или призывах убить кого-либо с помощью радиоактивного вещества (например, полония-210), ингибитора холинэстеразы (например, метил (1-(диэтиламино)этилиден)-амидофторфосфоната, в просторечии «Новичок») или, на худой случай, из огнестрельного оружия (например, из золотого пистолета), это вряд ли противоречило бы принятым представлениям о депутатской этике. Но обещать (призывать) действовать столь примитивным способом – отделяя голову от туловища – недостойно высокого звания депутата Государственной Думы Российской Федерации, государства, обладающего разнообразными высокими технологиями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6dd85f-816d-365c-ab55-bb94d3ed8fb8",
                                        "entry_id": "df4c501d-c566-3300-9166-d926ff127517",
                                        "glosses": [
                                            "как можно, по возможности"
                                        ],
                                        "tags": [
                                            "указывает на крайнюю необходимость, употребляется перед сравнительной степенью прилагательного"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631050d4-f208-4335-92fa-0c600bc50563",
                                                "sense_id": "ac6dd85f-816d-365c-ab55-bb94d3ed8fb8",
                                                "text": "Я прошу прийти тебя возможно скорее."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6ee378d0-6d25-4cb3-b0a2-9b8e1d257666",
                        "source_entry_id": "757f6ff5-8eae-3cd2-8e28-7c018f3a68bc",
                        "source_sense_id": "02f3822a-c301-3202-9c69-75fb07d0487e",
                        "target_lang_word": "вероятно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вероятно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8e6c8894-2caa-3d97-90a4-97cd6cd559b7",
                                        "entry_id": "b62cf427-38df-33df-9768-1d37833636b7",
                                        "glosses": [
                                            "вводн. сл. наверное, по-видимому"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a31045e8-2f30-4ceb-b8e8-2384eaa1adbf",
                                                "sense_id": "8e6c8894-2caa-3d97-90a4-97cd6cd559b7",
                                                "text": "Вероятно, трагедия моя не будет иметь никакого успеха."
                                            },
                                            {
                                                "example_id": "276c9603-5403-44e4-a8a5-fcebfec9e68c",
                                                "sense_id": "8e6c8894-2caa-3d97-90a4-97cd6cd559b7",
                                                "text": "Уехала ― и теперь уже далеко, сидит, вероятно, в стеклянном белом салоне или на палубе и смотрит на огромную, блестящую под солнцем реку, на встречные плоты, на желтые отмели, на сияющую даль воды и неба, на весь этот безмерный волжский простор…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f904cf4f-c772-3b54-ab15-a207bac1ed6a",
                                        "entry_id": "b62cf427-38df-33df-9768-1d37833636b7",
                                        "glosses": [
                                            "предик. оценочная характеристика ситуации, чьих либо действий как возможных, допустимых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f572692-aa55-4d0d-aa40-3f08b09d0cd3",
                                                "sense_id": "f904cf4f-c772-3b54-ab15-a207bac1ed6a",
                                                "text": "Очень вероятно, что в половине августа перееду в Рязань."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "202bbe09-f638-3dc6-9728-07544cfe8d25",
                                        "entry_id": "b62cf427-38df-33df-9768-1d37833636b7",
                                        "glosses": [
                                            "употребляется при выражении неуверенного подтверждения"
                                        ],
                                        "tags": [
                                            "част."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38e724d3-9362-4246-a3c4-07c89dfc849a",
                                                "sense_id": "202bbe09-f638-3dc6-9728-07544cfe8d25",
                                                "text": "― Вероятно, простудились. ― Вероятно. ― Это худо. ― Ничего, поправлюсь…"
                                            },
                                            {
                                                "example_id": "f3819529-32b3-4fa0-ad62-53f0510529a1",
                                                "sense_id": "202bbe09-f638-3dc6-9728-07544cfe8d25",
                                                "text": "― Он тебя любил? ― Вероятно. Зачем бы он стал жить со мной, если бы не любил?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "вероятно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "913cdf4c-9a4f-304a-bab9-aac1aa2c11fd",
                                        "entry_id": "abd5d094-e818-312c-8e57-f60d8611705c",
                                        "glosses": [
                                            "краткая форма среднего рода единственного числа прилагательного вероятный"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8719d783-dee6-435b-9e64-176b2b8f89a8",
                        "source_entry_id": "757f6ff5-8eae-3cd2-8e28-7c018f3a68bc",
