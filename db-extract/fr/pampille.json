                    }
                ],
                "senses": [
                    {
                        "sense_id": "d980e5b2-6383-3554-b8e3-b299173070df",
                        "entry_id": "02fa7cea-a665-3712-9495-c726aea397c4",
                        "glosses": [
                            "Frange de passementerie comprenant un macaron d’où tombent des pendeloques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "150a228e-d22c-4865-97cd-c59ac1d1a0c2",
                                "sense_id": "d980e5b2-6383-3554-b8e3-b299173070df",
                                "text": "Même derrière la porte fermée, je peux imaginer la disposition des meubles, de son lit, de l’édredon un peu trop lourd, de son vieux fauteuil rose à pampilles et de la commode marquetée."
                            },
                            {
                                "example_id": "0ddc43e1-e3fe-4ddc-9dc3-c4ea6752b3d6",
                                "sense_id": "d980e5b2-6383-3554-b8e3-b299173070df",
                                "text": "Pampille à pendeloques de métal dans la toilette espagnole."
                            }
                        ]
                    },
                    {
                        "sense_id": "591a709a-937b-3dfa-b720-bb06153bd297",
                        "entry_id": "02fa7cea-a665-3712-9495-c726aea397c4",
                        "glosses": [
                            "Petite pendeloque."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "4aaf867a-37b2-4dab-bc32-4966d8e2cd51",
                                "sense_id": "591a709a-937b-3dfa-b720-bb06153bd297",
                                "text": "Sur ma lancée, un instinct infaillible me conduisit aussitôt à faire dégouliner la lumière des torchères et des lampes à pampilles sur les trésors du Mobilier national."
                            },
                            {
                                "example_id": "da0f49ce-49c0-49c7-9d54-afd2fa02c05c",
                                "sense_id": "591a709a-937b-3dfa-b720-bb06153bd297",
                                "text": "Montse, qui n’est jamais entrée dans un palace pour milliardaires et n’y serait jamais entrée s’il n’y avait eu la guerre … reste bouche bée devant le luxe qu’elle y découvre : les lustres à pampilles de luxe, les grands miroirs de luxe ..."
                            },
                            {
                                "example_id": "6209c89f-4762-4c83-b3e0-56f9a9666458",
                                "sense_id": "591a709a-937b-3dfa-b720-bb06153bd297",
                                "text": "Un beau jour et sans crier gare, l’un des immenses lustres en verre bleu de Venise à pampilles et pendeloques, accroché à la croisée du transept, s’est effondré, répandant sur le sol son lot d’éclats et de débris comme les minutes de sable du temps."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe5c1047-eb15-3baf-8731-6948a2f8af15",
                        "entry_id": "02fa7cea-a665-3712-9495-c726aea397c4",
                        "glosses": [
                            "Excroissance de peau située parfois sous le menton des chèvres."
                        ],
