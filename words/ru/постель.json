    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e3f58142-e85b-3047-bc9b-52735d011834",
                    "sense_definition": "Место для сна со спальными принадлежностями, а также сами эти принадлежности.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "сон",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Уставший после работы путник сразу лёг в <w>постель</w> и крепко уснул.",
                            "target_lang_translations": {
                                "en": "Tired after work, the traveler immediately got into <w>bed</w> and fell fast asleep."
                            }
                        },
                        {
                            "text": "Каждое утро она аккуратно заправляла свою <w>постель</w> покрывалом.",
                            "target_lang_translations": {
                                "en": "Every morning she neatly made her <w>bed</w> with a bedspread."
                            }
                        }
                    ],
                    "synonyms": [
                        "кровать",
                        "ложе"
                    ],
                    "common_phrases": [
                        "лечь в постель",
                        "заправлять постель",
                        "тёплая постель",
                        "встать с постели"
                    ],
                    "target_lang_definitions": {
                        "en": "A place for sleeping with bedding, or the bedding itself."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bed",
                                "target_lang_sense_clarification": "piece of furniture or place for sleeping"
                            },
                            {
                                "target_lang_word": "bedding",
                                "target_lang_sense_clarification": "sheets, blankets, and pillows"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42be2f24-f16f-3b95-89f4-a1362565e20c",
                    "sense_definition": "Сексуальные отношения или половой акт.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "интимность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они долго скрывали, что их связывает не только работа, но и <w>постель</w>.",
                            "target_lang_translations": {
                                "en": "For a long time they hid that they were connected not only by work, but also by <w>bed</w>."
                            }
                        },
                        {
                            "text": "Не стоит обсуждать свою <w>постель</w> с чужими людьми.",
                            "target_lang_translations": {
                                "en": "One shouldn't discuss one's <w>sex life</w> with strangers."
                            }
                        }
                    ],
                    "common_phrases": [
                        "затащить в постель"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Sexual relations or the act of sex."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bed",
                                "target_lang_sense_clarification": "sexual intimacy or relations"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "42926b5e-bbfd-33e6-b797-864c0bfd9399",
                    "sense_definition": "Самая широкая горизонтальная плоскость кирпича или камня при кладке.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "строительство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Каменщик ровным слоем нанёс раствор на <w>постель</w> нижнего кирпича.",
                            "target_lang_translations": {
                                "en": "The mason applied an even layer of mortar to the <w>bed</w> of the lower brick."
                            }
                        },
                        {
                            "text": "Самая широкая рабочая плоскость строительного камня традиционно называется <w>постелью</w>.",
                            "target_lang_translations": {
                                "en": "The broadest working face of a building stone is traditionally called the <w>bed</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The broadest horizontal surface of a brick or building stone in masonry."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bed",
                                "target_lang_sense_clarification": "horizontal surface of a brick or stone"
                            },
                            {
                                "target_lang_word": "bed surface",
                                "target_lang_sense_clarification": "masonry contact plane"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "038dced0-255b-3f17-9613-697514cd9687",
                    "sense_definition": "Опорная поверхность или часть механизма, на которую укладывается другая деталь.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "техника",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Перед монтажом вала механик тщательно очистил <w>постель</w> подшипника от старой смазки.",
                            "target_lang_translations": {
                                "en": "Before installing the shaft, the mechanic thoroughly cleaned the bearing <w>seat</w> of old grease."
                            }
                        },
                        {
                            "text": "При значительном износе <w>постели</w> деталь приходится полностью менять.",
                            "target_lang_translations": {
                                "en": "With significant wear of the <w>housing</w>, the part has to be replaced entirely."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A supporting surface or base of a mechanism upon which another part rests."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bed",
                                "target_lang_sense_clarification": "machinery foundation or base"
                            },
                            {
                                "target_lang_word": "seat",
                                "target_lang_sense_clarification": "bearing or valve support surface"
                            },
                            {
                                "target_lang_word": "housing",
                                "target_lang_sense_clarification": "supporting recess for a component"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c867276d-f93b-34f8-bd96-3fdffd3a0701",
                    "sense_definition": "Предохранительный слой агломерата, насыпаемый на колосниковую решётку при обжиге руды.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "металлургия",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Оператор строго контролировал подачу защитной <w>постели</w> на агломерационную ленту.",
                            "target_lang_translations": {
                                "en": "The operator strictly monitored the feed of the protective <w>hearth layer</w> onto the sinter strand."
                            }
                        },
                        {
                            "text": "Равномерная загрузка <w>постели</w> защищает металлическую решётку от перегрева.",
                            "target_lang_translations": {
                                "en": "Even loading of the <w>bed layer</w> protects the metal grate from overheating."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A protective layer of sinter or material spread on a grate during ore roasting."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "hearth layer",
                                "target_lang_sense_clarification": "protective layer on a sinter grate"
                            },
                            {
                                "target_lang_word": "bed",
                                "target_lang_sense_clarification": "layer of sinter material"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3578ac8d-9ffb-3256-bc73-f8d4dc6083f0",
                    "sense_definition": "Слой погибших пчёл на дне опустевшего улья.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "пчеловодство",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Осматривая заброшенный улей весной, пасечник обнаружил на дне плотную пчелиную <w>постель</w>.",
                            "target_lang_translations": {
                                "en": "Inspecting the abandoned hive in spring, the beekeeper found a dense <w>bed</w> of dead bees at the bottom."
                            }
                        },
                        {
                            "text": "Толстая <w>постель</w> из осыпавшихся насекомых свидетельствовала о зимней гибели пчелиной семьи.",
                            "target_lang_translations": {
                                "en": "A thick <w>layer</w> of fallen insects indicated that the bee colony had died during the winter."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A layer of dead bees accumulated on the bottom of a deserted hive."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bed",
                                "target_lang_sense_clarification": "layer of dead insects at the bottom of a hive"
                            },
                            {
                                "target_lang_word": "layer",
                                "target_lang_sense_clarification": "accumulation of dead bees"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92aaf568-af41-3055-9adc-86dc87fb88ea",
                    "sense_definition": "Углубление в грунте, по которому течёт водный поток; русло реки.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "география",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весенний паводок переполнил каменистую <w>постель</w> горной реки.",
                            "target_lang_translations": {
                                "en": "The spring flood overflowed the stony <w>bed</w> of the mountain river."
                            }
                        },
                        {
                            "text": "Поток воды постепенно вымывал новую <w>постель</w> среди известняковых скал.",
                            "target_lang_translations": {
                                "en": "The stream of water gradually carved out a new <w>channel</w> among the limestone rocks."
                            }
                        }
                    ],
                    "synonyms": [
