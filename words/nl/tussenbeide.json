{
    "word_family": [
        "tussen",
        "tussenkomst"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "ac73b84e-4380-3487-b0e5-2c4f4170b81f",
                    "sense_definition": "tussen twee strijdende partijen in, met als doel een conflict te beëindigen",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interventie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Toen het gesprek uit de hand liep, kwam de leraar snel <w>tussenbeide</w>.",
                            "target_lang_translations": {
                                "fr": "Lorsque la conversation a dégénéré, le professeur est rapidement <w>intervenu</w>."
                            }
                        },
                        {
                            "text": "Mijn vader kwam bij onze ruzie <w>tussenbeide</w> om de vrede te bewaren.",
                            "target_lang_translations": {
                                "fr": "Mon père s'est <w>interposé</w> dans notre dispute pour maintenir la paix."
                            }
                        }
                    ],
                    "synonyms": [
                        "interveniërend"
                    ],
                    "common_phrases": [
                        "tussenbeide komen",
                        "snel tussenbeide stappen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Entre deux parties en conflit, dans le but de mettre fin à une dispute"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "intervenir",
                                "target_lang_sense_clarification": "s'immiscer pour stopper un conflit"
                            },
                            {
                                "target_lang_word": "s'interposer",
                                "target_lang_sense_clarification": "se placer physiquement ou moralement entre deux personnes"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c05fd80c-cbba-36d4-afa5-4f5da4cfe6c0",
                    "sense_definition": "een geschil tussen twee andere partijen proberen op te lossen of te beslechten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interventie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij probeerde <w>tussenbeide</w> te komen om een fysieke confrontatie te voorkomen.",
                            "target_lang_translations": {
                                "fr": "Il a essayé d'<w>intervenir</w> pour éviter une confrontation physique."
                            }
                        },
                        {
                            "text": "Als men niet op tijd <w>tussenbeide</w> komt, kan het conflict verergeren.",
                            "target_lang_translations": {
                                "fr": "Si l'on n'<w>intervient</w> pas à temps, le conflit peut s'aggraver."
                            }
                        }
                    ],
                    "synonyms": [
                        "bemiddelen",
                        "ingrijpen"
                    ],
                    "common_phrases": [
                        "tussenbeide treden",
                        "tussenbeide komen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Tenter de résoudre ou de régler un différend entre deux autres parties"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "intervenir",
                                "target_lang_sense_clarification": "agir pour régler une situation"
                            },
                            {
                                "target_lang_word": "médier",
                                "target_lang_sense_clarification": "servir d'intermédiaire pour concilier"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}