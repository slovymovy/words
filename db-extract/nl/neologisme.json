                    },
                    {
                        "sense_id": "cae1f18b-6d82-39f3-a741-29e24d890f35",
                        "entry_id": "da745aed-155a-3a5f-a4af-d3e54b74158e",
                        "glosses": [
                            "een taalelement dat nieuw is of nieuw gevormd is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4029fc14-567a-49e9-9c49-5f3500477743",
                                "sense_id": "cae1f18b-6d82-39f3-a741-29e24d890f35",
                                "text": "En het woord 'stationcar' is zelfs uit uitsluitend vreemdtalige elementen opgebouwd; niettemin moet het als een zuiver Nederlands neologisme worden beschouwd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7825c58-e84b-4a88-a95d-fc8b1103e338",
                        "source_entry_id": "da745aed-155a-3a5f-a4af-d3e54b74158e",
                        "source_sense_id": "2686ff19-7d85-3c2d-960a-a0fbd4825d76",
                        "source_sense_description": "een woord dat nieuw is of nieuw gevormd is",
                        "target_lang_word": "Neologismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Neologismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "16345be7-86f0-3b8e-a5e2-cc6f8a987b69",
                                        "entry_id": "0dee2bd0-3e5e-34a5-83e8-bc30bcd7ebc4",
                                        "glosses": [
                                            "neu gebildeter sprachlicher Ausdruck (Neubedeutung, Neubildung, Neulexem, Neuwort), neu übernommenes Fremdwort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b476909-9e71-4b16-91dc-8cefbb145fbe",
                                                "sense_id": "16345be7-86f0-3b8e-a5e2-cc6f8a987b69",
                                                "text": "„Das Extrem auf der anderen Seite sind die Neologismen, die Neuwörter, die gerade erst in Gebrauch gekommen sind und bei denen man noch nicht so recht weiß, ob man sie schon unbesorgt gebrauchen darf.“"
                                            },
                                            {
                                                "example_id": "21bb149f-73cb-47ec-88aa-2a9f948d9d2f",
                                                "sense_id": "16345be7-86f0-3b8e-a5e2-cc6f8a987b69",
                                                "text": "„Der nervöse und beschwingte Stil bereichert sich oft durch burleske Neologismen von unbestreitbarer Treffsicherheit.“",
                                                "translation": "[*] „In der Gefahr, dieser Regel zu widerstreben, stehen vor allem zwei Wortgruppen: die Neologismen (Neuwörter) und die ‚Archaismen‘ (veraltete Wörter).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "411c33f7-1522-3406-ba5c-ff3acc780fda",
                                        "entry_id": "0dee2bd0-3e5e-34a5-83e8-bc30bcd7ebc4",
                                        "glosses": [
                                            "Wort ( lexikalisches Zeichen), das in einem bestimmten Zeitraum durch Wortbildung in einer Sprachgemeinschaft entsteht, weite Verbreitung unter den Sprechern findet und schließlich in die Wörterbücher, die den Wortschatz dieser Sprache kodifizieren, aufgenommen wird"
                                        ],
                                        "tags": [
                                            "genauer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8fd06971-dc5f-4911-86e1-47987a9ade80",
                                                "sense_id": "411c33f7-1522-3406-ba5c-ff3acc780fda",
                                                "text": "„Ich betrachte Neologismen als Lexeme, deren Entstehungszeit bekannt ist und die zu eben dieser Zeit von der Mehrzahl der Menschen einer Sprachgemeinschaft aufgenommen, aber noch als neu empfunden werden.“"
                                            },
                                            {
                                                "example_id": "dbf0926f-8c64-41e0-a89d-1f12e31a493a",
                                                "sense_id": "411c33f7-1522-3406-ba5c-ff3acc780fda",
                                                "text": "„Zur Ermittlung der stichwortwürdigen Neologismen des ersten Jahrzehnts aus der Menge der Neologismuskandidaten werden die gleichen Kriterien wie für die Neologismen der 90er Jahre herangezogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d64d6ddb-d74d-405d-a84e-78915beda4ad",
                        "source_entry_id": "da745aed-155a-3a5f-a4af-d3e54b74158e",
                        "source_sense_id": "2686ff19-7d85-3c2d-960a-a0fbd4825d76",
                        "source_sense_description": "een woord dat nieuw is of nieuw gevormd is",
                        "target_lang_word": "neologism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neologism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "954b0bd8-7924-3eec-b595-5c070d0980c4",
                                        "entry_id": "e4a046c1-794c-3e16-b8bf-b550ada1c236",
                                        "glosses": [
                                            "A word or phrase which has recently been coined; a new word or phrase."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cc5b097-a6cf-460c-b944-675479cc616c",
                                                "sense_id": "954b0bd8-7924-3eec-b595-5c070d0980c4",
                                                "text": "These neologisms demonstrate the cumulative quality of language, in which we use the known to describe the unknown."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "716ab5e0-6000-367a-ac5e-789e1f7f7895",
                                        "entry_id": "e4a046c1-794c-3e16-b8bf-b550ada1c236",
                                        "glosses": [
                                            "An existing word or phrase which has gained a new meaning."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bf76622c-8587-3d91-9e36-6c05f67887c1",
                                        "entry_id": "e4a046c1-794c-3e16-b8bf-b550ada1c236",
                                        "glosses": [
                                            "The act or instance of coining, or uttering a new word."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c479a896-7171-415e-aa81-3dc12a748a43",
                                                "sense_id": "bf76622c-8587-3d91-9e36-6c05f67887c1",
                                                "text": "Neologizing, the practice of coining new words, may seem to be an arcane, specialized activity, but it's everywhere -- and the skillful employment of neologism is what gives English much of its verve."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9e84c6ea-165e-3a7b-99ab-6847d3626eb7",
                                        "entry_id": "e4a046c1-794c-3e16-b8bf-b550ada1c236",
                                        "glosses": [
                                            "The newly coined, meaningless words or phrases of someone with a psychosis, usually schizophrenia."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3758677d-0988-3b1c-a976-c1f55fcbed36",
                                        "entry_id": "e4a046c1-794c-3e16-b8bf-b550ada1c236",
                                        "glosses": [
                                            "Synonym of neology."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "098ffaa2-ac06-4aaf-abc5-012bf61c89c5",
                        "source_entry_id": "da745aed-155a-3a5f-a4af-d3e54b74158e",
                        "source_sense_id": "2686ff19-7d85-3c2d-960a-a0fbd4825d76",
                        "source_sense_description": "een woord dat nieuw is of nieuw gevormd is",
                        "target_lang_word": "néologisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "néologisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "47e285b1-1a5a-34a5-bb2f-3b6b4cab4768",
                                        "entry_id": "3e450856-9e16-34c3-bf90-09af671aa2bf",
                                        "glosses": [
                                            "Abus de la création de mots nouveaux ou de l’emploi de mots anciens dans de nouveaux sens."
                                        ],
                                        "tags": [
                                            "dated",
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "86a65d57-1467-33a5-b3c6-cd9cd1672915",
                                        "entry_id": "3e450856-9e16-34c3-bf90-09af671aa2bf",
                                        "glosses": [
                                            "Fait d’employer ou d'inventer des mots nouveaux (nom commun, adjectif, etc.) ou des expressions nouvelles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6166e749-fd3f-4148-9814-8ebb4454962a",
                                                "sense_id": "86a65d57-1467-33a5-b3c6-cd9cd1672915",
                                                "text": "Rimbaud, champion du néologisme avec son « abracadabrantesque » repris par Jacques Chirac."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb7dc597-e1eb-33b9-9462-1d6366f798a5",
                                        "entry_id": "3e450856-9e16-34c3-bf90-09af671aa2bf",
                                        "glosses": [
                                            "Mot nouveau ou récemment forgé pour répondre à un manque ou pour son caractère expressif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81527105-eb49-40ca-86b7-e229acb4199c",
                                                "sense_id": "fb7dc597-e1eb-33b9-9462-1d6366f798a5",
                                                "text": "En linguistique, le caractère neuf d’un néologisme — sa néologicité — peut perdurer plusieurs années."
                                            },
                                            {
                                                "example_id": "d1adb43d-cf57-4f14-94d0-52411ab0d121",
                                                "sense_id": "fb7dc597-e1eb-33b9-9462-1d6366f798a5",
                                                "text": "La Fontaine, qui employa tant de mots, n’en inventa guère : il est à remarquer que les bons écrivains sont généralement fort sobres de néologismes. Le fonds commun du langage leur suffit."
                                            },
                                            {
                                                "example_id": "a65b0f8f-2caf-429e-aee1-6b052d94109b",
                                                "sense_id": "fb7dc597-e1eb-33b9-9462-1d6366f798a5",
                                                "text": "Le syntagme figé « énergivoraces » apparaît dans une phrase de type coercitif : « Nous sommes tous des « énergivoraces ». Or ce type de contrainte est neutralisé par l'effet humoristique du néologisme."
                                            },
                                            {
                                                "example_id": "1877af06-49a6-4eb8-9690-d6e1bceeba62",
                                                "sense_id": "fb7dc597-e1eb-33b9-9462-1d6366f798a5",
                                                "text": "Branduit. Néologisme créé par Jean-Louis Swiners. Exemples de branduits : le Coca-Cola, le Stabilo, etc."
                                            },
                                            {
                                                "example_id": "e92011c1-e31e-4ef9-b52f-19595cf36a0b",
                                                "sense_id": "fb7dc597-e1eb-33b9-9462-1d6366f798a5",
                                                "text": "Les néologismes sont en effet des constructions momentanées, la plupart du temps non reprises, et qui rapidement disparaissent. Ceux qui, au contraire, ont la faveur des locuteurs s'instituent en langue grâce au processus de lexicalisation."
                                            },
                                            {
                                                "example_id": "809cc040-7eb4-4224-9687-af53ac80aa0a",
                                                "sense_id": "fb7dc597-e1eb-33b9-9462-1d6366f798a5",
                                                "text": "C'est ce qu’illustre bien la confusion régnant autour du terme d'« illectronisme ». « Illectronisme » est un néologisme et mériterait de le rester. Ce sera probablement le cas, puisque les hommes politiques, qui sont les seuls à utiliser ce vocable, emploient toujours la périphrase « ce qu'on appelle l’\"illectronisme\" »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a9dffe-031b-3f9f-8aa6-d627dff2ee4e",
                                        "entry_id": "3e450856-9e16-34c3-bf90-09af671aa2bf",
                                        "glosses": [
                                            "Nouveau sens donné à un mot existant ; néosémie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e8a6199-c866-4e0a-a95e-fba1120475c7",
                                                "sense_id": "a7a9dffe-031b-3f9f-8aa6-d627dff2ee4e",
                                                "text": "Le mot souris désignant un petit boîtier relié à un ordinateur est un néologisme. Comme mulot, d'ailleurs. Mais l'un a pris et l'autre non."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ba3c6c-a0e4-381a-b2d2-072b88744c9e",
                                        "entry_id": "3e450856-9e16-34c3-bf90-09af671aa2bf",
                                        "glosses": [
                                            "Mot qui n’existe pas utilisé par quelqu’un souffrant de certains troubles du langage (aphasie…)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624f3f17-0bdd-410a-8f44-4d99bd45466f",
                                                "sense_id": "c7ba3c6c-a0e4-381a-b2d2-072b88744c9e",
                                                "text": "\"Foucra bouldou ! Bistroye ! Bistroye !\", ajouta-t-il avec conviction. Depuis quelque temps déjà, l’illustre écrivain avait contracté cette manie d’employer des mots bizarres, parfois désuets ou franchement impropres, quand ce n’étaient pas des néologismes enfantins à la manière du capitaine Haddock. Ses rares amis restants, comme ses éditeurs, lui passaient cette faiblesse, comme on passe à peu près tout à un vieux décadent fatigué."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aeeb3ac6-12bc-47a1-bc3d-efdf8ba28c90",
                        "source_entry_id": "da745aed-155a-3a5f-a4af-d3e54b74158e",
                        "source_sense_id": "2686ff19-7d85-3c2d-960a-a0fbd4825d76",
