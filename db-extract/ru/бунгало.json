                "senses": [
                    {
                        "sense_id": "690e808e-e0c6-3899-8060-488224cc6cea",
                        "entry_id": "05ee1024-a38e-35f5-912e-f98c34c0fbf4",
                        "glosses": [
                            "легкая загородная постройка в тропических странах, главным образом в Индии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce242999-65b6-4d2b-be8a-db18a4fd4630",
                                "sense_id": "690e808e-e0c6-3899-8060-488224cc6cea",
                                "text": "Уж так разве мы бедны? Это же элементарное бунгало, хижина, избушка."
                            }
                        ]
                    },
                    {
                        "sense_id": "dbadf7d9-e0a5-3947-907d-ef93ead50293",
                        "entry_id": "05ee1024-a38e-35f5-912e-f98c34c0fbf4",
                        "glosses": [
                            "одноэтажная дача, дом с верандой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e9096fd-63b2-40ad-a16e-fe523201b08c",
                                "sense_id": "dbadf7d9-e0a5-3947-907d-ef93ead50293",
                                "text": "Джон Леннон вознаградил тётю Мими за гостеприимство сполна и купил ей шикарное бунгало возле приморского города Борнмут на южном побережье Англии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3aaafe77-f7e6-482a-b354-f20c56576dcf",
                        "source_entry_id": "05ee1024-a38e-35f5-912e-f98c34c0fbf4",
                        "target_lang_word": "bungalow",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bungalow",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "52035f41-feb9-3499-86d1-eff3bcaf0584",
                                        "entry_id": "772cee2f-1c26-30ce-8c96-c9abc323b5e1",
                                        "glosses": [
                                            "A single-storey house, typically with rooms all on one level, or sometimes also with upper rooms set into the roof space."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed322e41-ea56-4e8d-8d68-6a80653f4cd4",
                                                "sense_id": "52035f41-feb9-3499-86d1-eff3bcaf0584",
                                                "text": "My aunt can't manage the stairs any more, so she's moving to a bungalow."
                                            },
                                            {
                                                "example_id": "ac66cda7-1076-4851-820f-a56b13f0b607",
                                                "sense_id": "52035f41-feb9-3499-86d1-eff3bcaf0584",
                                                "text": "Slowly she turned round and faced towards a neat white bungalow, set some way back from the path behind a low hedge of golden privet. No light showed, but someone there was playing the piano. The strange elusiveness of the soft, insistent melody seemed to draw her forward."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09339fa2-e182-332f-9ca8-2b0c96433449",
                                        "entry_id": "772cee2f-1c26-30ce-8c96-c9abc323b5e1",
                                        "glosses": [
                                            "A thatched or tiled one-story house in India surrounded by a wide veranda; a similar house in this style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "105945db-5db4-4e35-900e-c7761072f3c2",
                                                "sense_id": "09339fa2-e182-332f-9ca8-2b0c96433449",
                                                "text": "Following the rule adopted in most tropical countries, a bungalow style of house was chosen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ead53bf8-2348-390a-8f8d-adff038760bc",
                                        "entry_id": "772cee2f-1c26-30ce-8c96-c9abc323b5e1",
                                        "glosses": [
                                            "A chalet or lodge"
                                        ],
                                        "tags": [
                                            "Atlantic-Canada"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "df4a9a5c-18ef-3c07-86a1-ddbd96c3d024",
                                        "entry_id": "772cee2f-1c26-30ce-8c96-c9abc323b5e1",
                                        "glosses": [
                                            "A detached, freestanding house or mansion"
                                        ],
                                        "tags": [
                                            "Malaysia",
                                            "Singapore"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fac93633-db51-44f6-aa89-12c70df381ba",
                        "source_entry_id": "05ee1024-a38e-35f5-912e-f98c34c0fbf4",
