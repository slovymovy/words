                        "examples": [
                            {
                                "example_id": "413ccc07-4ff8-418f-86cd-91ae376d74e4",
                                "sense_id": "78da7f36-cf1a-3f55-9659-a7dfb0f49b3a",
                                "text": "„Katie kauft eine Dose Koffeintabletten sowie zwei große Thermosflaschen mit moderner Isolierung, aber Retro-Design aus den 1950er-Jahren aus geripptem Aluminium mit Schraubverschlüssen, die man als Becher benutzen kann.“"
                            },
                            {
                                "example_id": "e963176d-c7e8-49c1-91c0-ee0e657d8dd7",
                                "sense_id": "78da7f36-cf1a-3f55-9659-a7dfb0f49b3a",
                                "text": "„›Dann sind wir auch nicht schlimmer dran als jetzt. Wir können Koffeintabletten schlucken, bevor wir ins Bett gehen.‹“"
                            },
                            {
                                "example_id": "0f79f0fb-5cb3-4c6c-8bbe-6b6b603d1488",
                                "sense_id": "78da7f36-cf1a-3f55-9659-a7dfb0f49b3a",
                                "text": "„›Koffeintabletten‹, sagt er und wirft sich eine ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
