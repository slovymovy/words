            "pos": "verb",
            "senses": [
                {
                    "sense_id": "6f22cbbc-2d91-3700-83ed-74650ede04ef",
                    "sense_definition": "Traverser un lieu ou franchir une certaine distance en se déplaçant.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "deplacement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons <w>parcouru</w> plus de vingt kilomètres à pied pendant notre randonnée en montagne."
                        },
                        {
                            "text": "Ce train rapide <w>parcourt</w> la distance entre les deux villes en moins de deux heures."
                        }
                    ],
                    "synonyms": [
                        "traverser",
                        "sillonner"
                    ],
                    "common_phrases": [
                        "parcourir une distance",
                        "parcourir le monde",
                        "parcourir la ville"
                    ]
                },
                {
                    "sense_id": "64b11578-acb8-3376-86a8-899b02bd9632",
                    "sense_definition": "Regarder, lire ou examiner rapidement un texte ou un ensemble de choses.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "lecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle <w>parcourt</w> le journal chaque matin avant de partir travailler au bureau."
                        },
                        {
                            "text": "J'ai rapidement <w>parcouru</w> les notes de la réunion pour trouver les informations importantes."
                        }
                    ],
                    "synonyms": [
                        "survoler",
                        "feuilleter"
                    ],
                    "antonyms": [
                        "approfondir"
                    ],
                    "common_phrases": [
                        "parcourir un document",
                        "parcourir des yeux"
                    ]
                },
                {
                    "sense_id": "beb1c5d2-b175-3477-92f7-6163c0f49762",
                    "sense_definition": "Traverser ou envahir brièvement le corps ou l'esprit, en parlant d'une sensation ou d'une émotion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sensation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un frisson d'angoisse a <w>parcouru</w> son dos lorsqu'elle a entendu ce bruit étrange."
                        },
                        {
                            "text": "Un léger sourire <w>parcourut</w> son visage quand il reconnut la voix de son vieil ami."
                        }
                    ],
                    "synonyms": [
                        "traverser",
                        "envahir"
                    ],
                    "common_phrases": [
