                ],
                "senses": [
                    {
                        "sense_id": "656683b9-e4c7-38fe-8a18-89c018279a5c",
                        "entry_id": "67612caa-dd83-39ac-8131-11a4fa479392",
                        "glosses": [
                            "(gleichmäßiges) Lauftempo bei einer Ausdauerleistung; Lauftempo, das über längere Strecken hinweg konstant aufrechterhalten werden kann"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "16fd783b-a18a-4c18-a79c-d9d078a2d49e",
                                "sense_id": "656683b9-e4c7-38fe-8a18-89c018279a5c",
                                "text": "„Das normale Dauerlauftempo liegt bei mir zwischen 4:20 und 5:20 Pace (Min/km).“"
                            },
                            {
                                "example_id": "987659b4-fd12-48a4-be1f-ec6669f486d2",
                                "sense_id": "656683b9-e4c7-38fe-8a18-89c018279a5c",
                                "text": "„Hierbei laufen Sie bestimmte Streckenabschnitte in einem höheren Tempo als Ihr übliches Lauftempo, also im Renntempo, statt im Dauerlauftempo.“"
                            },
                            {
                                "example_id": "18194a5b-3370-4b61-83d6-1ff7bf50eb16",
                                "sense_id": "656683b9-e4c7-38fe-8a18-89c018279a5c",
                                "text": "„Dieses Dauerlauftempo ist nichts für Laufanfänger und auch für Fitness- und Gesundheitsläufer nicht zu empfehlen.“"
                            },
                            {
                                "example_id": "bf517465-2b12-4b0e-9baa-eea6b21e0568",
                                "sense_id": "656683b9-e4c7-38fe-8a18-89c018279a5c",
                                "text": "„Endorphine spürst du während du dich auspowerst: Entweder, wenn du dein ideales Dauerlauftempo gefunden hast (Runners Flow) oder wenn du nach längerem Lauf deine persönliche Leistungsgrenze überwindest und dir dein Körper eine Extradosis gegen die Schmerzen bereitstellt (Runners High).“"
                            },
                            {
                                "example_id": "1fe508a1-9ff2-446e-82cb-c5578020a3d8",
                                "sense_id": "656683b9-e4c7-38fe-8a18-89c018279a5c",
                                "text": "„Ein Marathon im Dauerlauftempo, zudem immer wieder unterbrochen durch geplante Gehpausen, das schadet nicht, erhöht durch den langen Lauf eher den Trainingserfolg.“"
                            },
                            {
                                "example_id": "b8430130-fd40-4f59-9cb6-a40c58e7e20f",
                                "sense_id": "656683b9-e4c7-38fe-8a18-89c018279a5c",
                                "text": "„Bei diesem Lauf können die letzten 10 km der Marathonstrecke im lockeren Dauerlauftempo absolviert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
