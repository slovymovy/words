    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c37bb5c2-00e1-3c1c-8a40-c34a771afae5",
                    "sense_definition": "A sudden, brief gush or stream of liquid.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "liquid_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sudden <w>spurt</w> of water shot from the broken pipe.",
                            "target_lang_translations": {
                                "zh": "破裂的水管中突然射出一<w>股</w>水流。",
                                "es": "Un repentino <w>chorro</w> de agua salió disparado de la tubería rota."
                            }
                        },
                        {
                            "text": "The doctor quickly bandaged the wound to stop each <w>spurt</w> of blood.",
                            "target_lang_translations": {
                                "zh": "医生迅速包扎好伤口，以止住每一次血液的<w>喷涌</w>。",
                                "es": "El médico vendó rápidamente la herida para detener cada <w>brotón</w> de sangre."
                            }
                        }
                    ],
                    "synonyms": [
                        "jet",
                        "gush",
                        "squirt"
                    ],
                    "common_phrases": [
                        "spurt of water",
                        "spurt of blood"
                    ],
                    "target_lang_definitions": {
                        "zh": "（液体）喷射，喷出，涌出一股",
                        "es": "Salida repentina y breve de un líquido en forma de chorro."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "喷射",
                                "target_lang_sense_clarification": "指液体的突然喷出"
                            },
                            {
                                "target_lang_word": "喷涌",
                                "target_lang_sense_clarification": "指大量液体猛烈涌出"
                            },
                            {
                                "target_lang_word": "一股",
                                "target_lang_sense_clarification": "作量词，表示喷出的一股液体"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "chorro",
                                "target_lang_sense_clarification": "salida brusca de líquido"
                            },
                            {
                                "target_lang_word": "chorrazo",
                                "target_lang_sense_clarification": "chorro repentino o fuerte"
                            },
                            {
                                "target_lang_word": "brotón",
                                "target_lang_sense_clarification": "oleada breve de líquido"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb83367a-5378-3bde-9660-202f3d3473e3",
                    "sense_definition": "A sudden, brief increase or burst of activity, effort, speed, or growth.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "burst_effort",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teenagers often experience a sudden growth <w>spurt</w> during high school.",
                            "target_lang_translations": {
                                "zh": "青少年在上高中期间往往会经历身体的<w>猛长</w>。",
                                "es": "Los adolescentes suelen dar un repentino <w>estirón</w> durante la secundaria."
                            }
                        },
                        {
                            "text": "The team worked in short <w>spurts</w> of energy to finish the project on time.",
                            "target_lang_translations": {
                                "zh": "团队依靠短时间的精力<w>迸发</w>来按时完成项目。",
                                "es": "El equipo trabajó con breves <w>ráfagas</w> de energía para terminar el proyecto a tiempo."
                            }
                        }
                    ],
                    "synonyms": [
                        "burst",
                        "surge"
