                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c8f74728-30e3-49cf-9085-b8ad50befe55",
                        "entry_id": "bd35df79-6d30-36d0-ba50-0688cce2302b",
                        "tags": [
                            "plural"
                        ],
                        "form": "vibrations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                        "entry_id": "bd35df79-6d30-36d0-ba50-0688cce2302b",
                        "glosses": [
                            "Mouvement des points d’un système déformable écartés de leur position d’équilibre."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "93e322f0-08ff-45e4-9df6-40b6623c5189",
                                "sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                                "text": "Différents mécanismes laryngés sont utilisés dans la parole et le chant pour faire varier la fréquence des vibrations."
                            },
                            {
                                "example_id": "0942c9ba-97d5-4008-b6c8-553ad8113f47",
                                "sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                                "text": "Dans le tamis vibrant électrique Hummer, les vibrations sont provoquées par voie électro-magnétique. Elles se produisent perpendiculairement à la surface tamisante et elles sont déterminées par quatre vibrateurs actionnant à chaque coin le cadre sur lequel la toile est tendue."
                            },
                            {
                                "example_id": "8f9f7fb1-e004-46d7-9f55-27d10279a1fd",
                                "sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                                "text": "[…]; les vibrations du moteur à deux-temps et de la chaîne de tronçonnage en mouvement sont absorbées, par conséquent, d'une manière encore plus efficace dans la zone tampon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c8be533b-e89e-4670-bbf6-c1b41522093c",
                        "source_entry_id": "bd35df79-6d30-36d0-ba50-0688cce2302b",
                        "source_sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                        "target_lang_word": "Vibration",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vibration",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "436f4831-918c-3b3a-830c-54b4848eb414",
                                        "entry_id": "152699db-85e9-310f-9246-91006b908022",
                                        "glosses": [
                                            "ganz schnelle Bewegung von einer Seite zur anderen Seite; Zittern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1206864-f28e-4cce-9a25-3f8fa934b96f",
                                                "sense_id": "436f4831-918c-3b3a-830c-54b4848eb414",
                                                "text": "Die Vibration der Waschmaschine brachte den Nachbarn um den Verstand."
                                            },
                                            {
                                                "example_id": "3608b79a-5129-4917-886b-15b99d9bd073",
                                                "sense_id": "436f4831-918c-3b3a-830c-54b4848eb414",
                                                "text": "Die Vibrationen ihres Massagestabes versetzten die Frau in Erregung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e3d7a57-b437-4a2c-a924-ffdbe2b6ebcb",
                        "source_entry_id": "bd35df79-6d30-36d0-ba50-0688cce2302b",
                        "source_sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                        "target_lang_word": "Erschütterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erschütterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9816cad5-f3e6-351b-a7ef-b69f131d6708",
                                        "entry_id": "a7d19ea8-e49b-3ca1-9b7e-8a20c288beb1",
                                        "glosses": [
                                            "heftige, wiederholte Stöße des Bodens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85459bad-4c8d-4391-a19c-ee2077193158",
                                                "sense_id": "9816cad5-f3e6-351b-a7ef-b69f131d6708",
                                                "text": "„In der Sinnesphysiologie versteht man unter Vibrationen leichte Erschütterungen, die über spezielle Rezeptoren (Vater-Pacini-Körperchen) registriert werden.“"
                                            },
                                            {
                                                "example_id": "d1d9496d-06ed-4c2a-8d96-915c6cbf00e4",
                                                "sense_id": "9816cad5-f3e6-351b-a7ef-b69f131d6708",
                                                "text": "„Die Eisscholle wurde von einer gewaltigen Erschütterung erfaßt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d2af7737-8088-38e4-a7f0-972bb2676508",
                                        "entry_id": "a7d19ea8-e49b-3ca1-9b7e-8a20c288beb1",
                                        "glosses": [
                                            "Gefühl, von etwas stark mitgenommen/betroffen zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7eb194-e2da-489b-89b4-e44e550cbf67",
                                                "sense_id": "d2af7737-8088-38e4-a7f0-972bb2676508",
                                                "text": "„Erschütterung und Schock sind die Reaktionen auf die Gewaltwelle.“"
                                            },
                                            {
                                                "example_id": "00caddf9-4bba-4626-b5ab-40edc73f0bf4",
                                                "sense_id": "d2af7737-8088-38e4-a7f0-972bb2676508",
                                                "text": "„Die Erschütterung über die in deutschem Namen verübten Massenmorde ließ ein Klagen über nationale Gebietsverluste und ethnische Säuberungen, selbst über Vergewaltigungen als unangemessen erscheinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4c80886-dd93-4fba-bf85-e67752b025a6",
                        "source_entry_id": "bd35df79-6d30-36d0-ba50-0688cce2302b",
                        "source_sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                        "target_lang_word": "vibration",
