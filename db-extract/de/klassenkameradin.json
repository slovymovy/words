                "senses": [
                    {
                        "sense_id": "c39ef85f-fc22-35c5-a2a4-04ca0ea111bc",
                        "entry_id": "9bedcb89-22dc-361c-9486-e7705d08c4ca",
                        "glosses": [
                            "weibliche Person, die mit anderen Personen in die gleiche Schulklasse geht oder ging"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91e3d5b7-4342-4cf6-bc2c-d5566f70bd22",
                                "sense_id": "c39ef85f-fc22-35c5-a2a4-04ca0ea111bc",
                                "text": "„Aber Feo musste die Unterprima wiederholen und wurde seine Klassenkameradin, sie saß direkt neben ihm:…“"
                            },
                            {
                                "example_id": "6d5a7ff2-cafc-4d4e-bb11-aea8a6c84b72",
                                "sense_id": "c39ef85f-fc22-35c5-a2a4-04ca0ea111bc",
                                "text": "„Klassenkameradinnen von Renate hatten Schmetterlinge und Blumen in das Album gemalt.“"
                            },
                            {
                                "example_id": "1b9d16b6-9e7d-48b7-ae04-2b7989d704c4",
                                "sense_id": "c39ef85f-fc22-35c5-a2a4-04ca0ea111bc",
                                "text": "„Während ich nun seinen schlanken, gebräunten Nacken mit den wilden Haaren und die hochgezogenen Schultern beobachtete, steckte meine Klassenkameradin Rebecca ihm verstohlen einen Zettel zu.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
