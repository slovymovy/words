                    {
                        "translation_id": "4c7ae383-34aa-48c8-b721-13086aef4fa4",
                        "source_entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                        "source_sense_description": "in a manner that this impossible to avoid",
                        "target_lang_word": "onvermijdelijk",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onvermijdelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                                        "entry_id": "14052fa9-a7c3-398a-b184-05ebf329918c",
                                        "glosses": [
                                            "waaraan niet te ontsnappen is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12d45250-e847-4374-bac7-0f38a9e9c16b",
                                                "sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                                                "text": "Het is onvermijdelijk dat er bezuinigd moet worden in zorg."
                                            },
                                            {
                                                "example_id": "b0a7bc1e-bb29-4bd2-81cb-faa7f66a884c",
                                                "sense_id": "d89582b2-3115-3272-a13a-04cdadb1a85b",
                                                "text": "Rond de in stijl overbeladen kersttafel in het appartement van oudoom Sverre ging het gesprek om te beginnen, dat was bijna onvermijdelijk, over kerst tegenwoordig en vroeger, over hoe de bedienden dapper hadden verdragen dat ze met de kerst moesten werken tegen een geringe vergoeding in de vorm van een niet al te eenvoudig kerstcadeau, een handtas, een zilveren armband, een vergulde broche."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "895556db-9bd8-4dd2-b9ac-62309f4218a6",
                        "source_entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                        "source_sense_description": "in a manner that this impossible to avoid",
                        "target_lang_word": "inévitablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inévitablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                        "entry_id": "52127d06-a6f9-3393-a619-d1c678e1c4a5",
                                        "glosses": [
                                            "D’une manière inévitable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d0d284c-0ace-4ca0-8b99-963021b07dc3",
                                                "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                                "text": "Il s’exposait à être inévitablement défait, si les troupes eussent été droit à lui."
                                            },
                                            {
                                                "example_id": "d8fc9216-53de-4ba1-b6b8-67f4db8e2a7f",
                                                "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                                "text": "Les sons vifs et légers ne portent-ils pas inévitablement dans notre âme le plaisir gai ?"
                                            },
                                            {
                                                "example_id": "cd38e16d-88f8-4566-8752-b223b8e5e58f",
                                                "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                                "text": "… l'État entreprend d'autre part une propagande dont le succès aurait inévitablement pour résultat de vider cette contrée garonnaise de ses derniers progéniteurs."
                                            },
                                            {
                                                "example_id": "e500a6be-e82d-43f7-8064-5daafe4afcba",
                                                "sense_id": "88a8d0a2-a8d7-3cbf-b822-58e2613b44c1",
                                                "text": "Octobre 2004 , je vais quitter Renault à la fin du mois, je prépare mon pot de départ. Inévitablement, c’est l’occasion d’un flash-back sur ma carrière professionnelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd1f6a90-22e1-4e5b-a3ec-f5912beb01a1",
                        "source_entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                        "source_sense_description": "in a manner that this impossible to avoid",
                        "target_lang_word": "zwangsläufig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zwangsläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                        "entry_id": "7723ef6d-932e-3787-a94b-1e983f10d1a1",
                                        "glosses": [
                                            "zwingend eintretend und unmöglich, vermieden zu werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca6e620c-15f2-458d-b399-e7aa6dd11533",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "Wenn Du die Tasse vom Tisch stößt, muss sie zwangsläufig zu Boden fallen."
                                            },
                                            {
                                                "example_id": "be2cfae5-7e02-4342-a38c-9f9e2832573a",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "Dieser Krieg wird uns zwangsläufig an den Rand des Untergangs treiben."
                                            },
                                            {
                                                "example_id": "36e936e3-3720-4dfb-8509-4bae4ab1d46d",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "Drogenkarrieren enden fast zwangsläufig in Armut und Obdachlosigkeit."
                                            },
                                            {
                                                "example_id": "b50f4529-179c-4217-824e-e0f709e7eb91",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "Er empfiehlt wegen des schlechten Wetters zwangsläufig zur Hütte umzukehren und erst beim Schönwetter wieder weiter zu Wandern."
                                            },
                                            {
                                                "example_id": "edbe81b5-0ce2-4083-a50d-9bf0426d9931",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "„Zu diesem Zeitpunkt wurde sie zwangsläufig zu einer nationalen und internationalen Figur.“"
                                            },
                                            {
                                                "example_id": "c5cc0ca2-5d1e-411b-8c51-e5ac24314b7a",
                                                "sense_id": "87b39624-cc33-3a18-b24b-88bbf4897f31",
                                                "text": "„Eine Beförderung war daher zwangsläufig mit einer Versetzung verbunden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
