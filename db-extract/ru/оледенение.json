                    },
                    {
                        "translation_id": "c95095e5-10e1-4a64-9b5e-91509a524f39",
                        "source_entry_id": "40759c34-4929-3522-8351-dcb325f8b432",
                        "target_lang_word": "Vereisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vereisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                                        "entry_id": "64354842-8939-3147-8481-27e350e46039",
                                        "glosses": [
                                            "Vorgang, in dem etwas zu Eis wird oder mit Eis bedeckt wird"
                                        ],
                                        "tags": [
                                            "Nomen Actionis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5738d9d5-ce45-4e8b-b35b-41775fb660fd",
                                                "sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                                                "text": "Die Vereisung des Sees erfolgte schneller als erwartet."
                                            },
                                            {
                                                "example_id": "999fc7a0-ddbb-4af3-876f-63bc7a34040a",
                                                "sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                                                "text": "„Aufgrund der Verlagerung der Kontinente in Richtung der Pole vollzogen sich vor etwa 40 bis zehn Millionen Jahren die Vereisung der Antarktis und nachfolgend die Gletscherbildung auf Grönland vor ca. fünf Millionen Jahren.“"
                                            },
                                            {
                                                "example_id": "9a36d2f4-4459-4627-9a8b-73522cd86eab",
                                                "sense_id": "10cc98f8-30e8-3aa4-b4b6-9cd787673e22",
                                                "text": "„Indessen nimmt die Glut im Innern ab, und die Sonne verliert ihre Kraft, so daß die Erde eines Tages durch Vereisung zugrunde geht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d87be42b-3a64-3ece-b224-3668fb80275c",
