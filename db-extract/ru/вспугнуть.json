                        "source_entry_id": "50b8e7c5-7a27-33b4-a964-a47cd42367ba",
                        "target_lang_word": "effaroucher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "effaroucher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e533f961-efb3-3e1a-94d8-1b5f9c2898b4",
                                        "entry_id": "5425f6cb-77f0-392d-90e7-90b22e01c6a1",
                                        "glosses": [
                                            "Épouvanter, effrayer et faire fuir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81c7f87a-1ee7-4531-952f-15521cb6f942",
                                                "sense_id": "e533f961-efb3-3e1a-94d8-1b5f9c2898b4",
                                                "text": "Je vous demande pardon, dit-il, de vous faire faire ce détour, mais il y a ici un étang à castors, et je crains de les effaroucher."
                                            },
                                            {
                                                "example_id": "d3c22de3-f481-4167-a3e5-6c5d2fd47e14",
                                                "sense_id": "e533f961-efb3-3e1a-94d8-1b5f9c2898b4",
                                                "text": "Ce second appel n’eut pour résultat que d’effaroucher les poules qui s’égaillèrent en gloussant et en battant de l’aile."
                                            },
                                            {
                                                "example_id": "06ed4160-9936-42e2-8ca0-e52a2f4e240a",
                                                "sense_id": "e533f961-efb3-3e1a-94d8-1b5f9c2898b4",
                                                "text": "Aussi rien n’est-il plus naturel que de voir des policiers […] prendre, pour ne pas effaroucher leur proie, l’apparence des gars qu’ils ont la mission d’appréhender."
                                            },
                                            {
                                                "example_id": "4a73c82f-647e-41b4-a271-4e3ae75f0f7f",
                                                "sense_id": "e533f961-efb3-3e1a-94d8-1b5f9c2898b4",
                                                "text": "— Je surpris, j’effarouchai en marquant tout de suite, sans ostentation, mais nettement, mon éloignement des observances religieuses, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a8947fb-4d77-3655-9c83-37565bfa0ed4",
                                        "entry_id": "5425f6cb-77f0-392d-90e7-90b22e01c6a1",
                                        "glosses": [
                                            "Rendre une personne si peu traitable qu’elle s’éloigne de vous."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "701836ef-5321-4f54-9bd2-b681748c856e",
                                                "sense_id": "2a8947fb-4d77-3655-9c83-37565bfa0ed4",
                                                "text": "M. Dumas, […], dit qu’il est difficile, sinon impossible, de transporter sur la scène les rapports réels entre femmes et hommes de la vie mondaine, de peur d’effaroucher la pudeur de ces dames qui ne sont chastes que par les oreilles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "adf1e4eb-4e45-3fe6-897e-c9f7bbbc2e90",
                                        "entry_id": "5425f6cb-77f0-392d-90e7-90b22e01c6a1",
                                        "glosses": [
                                            "Subtiliser, voler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a091bd00-f5a5-4bf3-9372-d36a70545028",
                                                "sense_id": "adf1e4eb-4e45-3fe6-897e-c9f7bbbc2e90",
                                                "text": "Tiens, Europe et Paccard n’ont point reparu, j’ai bien peur qu’ils n’aient effarouché les sept cent cinquante mille francs, lui dit Asie."
                                            },
                                            {
                                                "example_id": "b4cbcada-ae86-43ee-8e9f-b62a3817bd34",
                                                "sense_id": "adf1e4eb-4e45-3fe6-897e-c9f7bbbc2e90",
                                                "text": "Est-ce que, si j'avais effarouché ta nature, je serais restée avec toi après le coup ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
