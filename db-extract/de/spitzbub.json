                    {
                        "translation_id": "185bf81f-16d3-49fa-be18-fc89e81b32d5",
                        "source_entry_id": "6bf33aff-e575-3694-879a-8077e06b624f",
                        "source_sense_id": "c3b16381-4b4e-398b-98de-9e33e09736aa",
                        "source_sense_description": "ein schlauer Kleinkrimineller, ein gerissener Gauner, ein liebenswerter Schelm",
                        "target_lang_word": "padouch",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "padouch",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "62949ef6-f5ea-309d-a79a-b69dc3fa9689",
                                        "entry_id": "01a2a2a7-9b0d-31cb-b5ce-73fa0cd5af74",
                                        "glosses": [
                                            "zlý, podlý člověk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f360487-bd97-41c1-ab27-75ff5032a13a",
                                                "sense_id": "62949ef6-f5ea-309d-a79a-b69dc3fa9689",
                                                "text": "Padouch nebo hrdina, vždyť jsme jedna rodina."
                                            },
                                            {
                                                "example_id": "943a2860-b222-42d7-a075-33b438f9b042",
                                                "sense_id": "62949ef6-f5ea-309d-a79a-b69dc3fa9689",
                                                "text": "Jedním skokem jako chrti vrhla se celá tlupa k místu, odkud šustot ten pošel. „Ach — milost… ó!“ „Lotře!“ „Padouchu!“ „Zrádče!“ „Šibeničníku!“ Tak znělo spílání šesti ozbrojenců, když se nočního tuláka zmocnili."
                                            },
                                            {
                                                "example_id": "175310d3-f6ae-4c7c-8ff7-5504602eda16",
                                                "sense_id": "62949ef6-f5ea-309d-a79a-b69dc3fa9689",
                                                "text": "Hejtman chodí kolem nás a povídá: ,Vy lumpové, padouchové, neřádi, hyeny skvrnitý, tak bych vám chtěl kvůli tomu psovi všem napařit ajnclíka, rozsekat vás na nudle, postřílet a udělat z vás kapra namodro. Abyste ale věděli, že vás nebudu šetřit, dávám vám všem na čtrnáct dní kasárníka.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b7f972fa-d133-48e2-a0b8-4e7f90cef3c9",
                        "source_entry_id": "6bf33aff-e575-3694-879a-8077e06b624f",
                        "source_sense_id": "21c97a60-8e77-32e6-b9b9-e75c6fe5c00e",
                        "source_sense_description": "ein frecher, schelmischer Junge",
                        "target_lang_word": "rascal",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rascal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                        "entry_id": "ee503355-cc2b-3a57-b710-1e518070fbab",
                                        "glosses": [
                                            "A dishonest person; a rogue, a scoundrel, a trickster."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89202b7f-76a0-405a-9fb8-9f03aa6a4c69",
                                                "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                                "text": "Tuc[ca]. […] Can thy Author doe it impudently enough? / Hiſt[rio]. O, I warrant you, Captaine: and ſpitefully inough too; he ha's one of the moſt ouerflowing villanous wits, in Rome. He will ſlander any man that breathes; If he diſguſt him. / Tucca. I'le know the poor, egregious, nitty Raſcall; and he haue ſuch commendable Qualities, I'le cheriſh him: […]"
                                            },
                                            {
                                                "example_id": "41761047-b687-44d3-98ac-f14a440092bc",
                                                "sense_id": "3102f4c6-5900-352f-8710-ab62c234ef52",
                                                "text": "And he smote Corinius on his shaven jowl with the dice box, calling him cheat and mangy rascal, whereupon Corinius drew forth a bodkin to smite him in the neck withal; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                        "entry_id": "ee503355-cc2b-3a57-b710-1e518070fbab",
                                        "glosses": [
                                            "Sometimes diminutive: a cheeky person or creature; a troublemaker."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60571d97-fa9d-4f53-9682-36cf991a001c",
                                                "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                                "text": "That little rascal bit me!"
                                            },
                                            {
                                                "example_id": "4c0693cd-3d0b-427f-ad82-c8749c037c6e",
                                                "sense_id": "74a11f21-2358-35eb-aa85-6fe5fa486b17",
                                                "text": "If you have deer in the area, you may have to put a fence around your garden to keep the rascals out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35bb5b80-7d40-3e04-aa65-a505b35e2cce",
                                        "entry_id": "ee503355-cc2b-3a57-b710-1e518070fbab",
                                        "glosses": [
                                            "A member of a criminal gang."
                                        ],
                                        "tags": [
                                            "Papua-New-Guinea"
                                        ],
                                        "examples": []
                                    }
