{
    "word_family": [
        "constrict",
        "constriction",
        "constrictive"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a582b8be-8cb1-312e-a699-3b193b757a51",
                    "sense_definition": "A large snake that kills its prey by wrapping around it and squeezing it tightly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>constrictor</w> slowly wrapped its powerful body around the small animal.",
                            "target_lang_translations": {
                                "zh": "这条<w>蟒蛇</w>缓慢地用它强壮的身体缠住了那只小动物。"
                            }
                        },
                        {
                            "text": "Many people are afraid of the <w>constrictor</w> because of its deadly hunting method.",
                            "target_lang_translations": {
                                "zh": "许多人因为<w>蟒蛇</w>致命的捕猎方式而感到恐惧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "boa"
                    ],
                    "common_phrases": [
                        "boa constrictor"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种通过缠绕并紧紧挤压猎物来将其杀死的巨型蛇类。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蟒蛇",
                                "target_lang_sense_clarification": "指代通过缠绕猎物进行捕食的蛇类。"
                            },
                            {
                                "target_lang_word": "蚺",
                                "target_lang_sense_clarification": "指代无毒但体型巨大的缠绕型蛇类。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4d663d51-6ab0-3655-b0b2-616f616fa56f",
                    "sense_definition": "A muscle that narrows a vessel or passage by contracting.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pharyngeal <w>constrictor</w> helps move food down the throat during swallowing.",
                            "target_lang_translations": {
                                "zh": "咽<w>缩肌</w>有助于在吞咽时将食物推入喉咙。"
                            }
                        },
                        {
                            "text": "Each <w>constrictor</w> muscle plays a vital role in regulating blood flow through the vessels.",
                            "target_lang_translations": {
                                "zh": "每一块<w>缩肌</w>在调节血管血流方面都起着至关重要的作用。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "pharyngeal constrictor"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过收缩使血管或通道变窄的肌肉。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缩肌",
                                "target_lang_sense_clarification": "指代使器官或通道收缩的肌肉。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}