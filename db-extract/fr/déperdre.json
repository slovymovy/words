                ],
                "senses": [
                    {
                        "sense_id": "2abf139d-84b2-3131-801f-ac406ddf34fd",
                        "entry_id": "901e8cd7-5489-3595-a36e-c79e689f0f40",
                        "glosses": [
                            "Perdre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81a04c6c-86a4-44ac-8150-fe77c3e02c78",
                                "sense_id": "2abf139d-84b2-3131-801f-ac406ddf34fd",
                                "text": "L’absence de toute méthode fait déperdre beaucoup d’énergie ; les mauvais résultats découragent la masse."
                            }
                        ]
                    },
                    {
                        "sense_id": "680cf637-9c7e-3c74-a244-3015b3e95d0a",
                        "entry_id": "901e8cd7-5489-3595-a36e-c79e689f0f40",
                        "glosses": [
                            "Se défaire."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "94f4434c-c5e7-45e0-b5bf-dd128a1e6553",
                                "sense_id": "680cf637-9c7e-3c74-a244-3015b3e95d0a",
                                "text": "Les mots nous gênent, on voudrait les enlever, on les dit pour s’en déperdre."
                            },
                            {
                                "example_id": "f1267d55-c483-4672-97c7-e97e2ddb8f9c",
                                "sense_id": "680cf637-9c7e-3c74-a244-3015b3e95d0a",
                                "text": "La matière organisée ne fait guère autre chose que se déperdre, se reconstituer et se déperdre à nouveau."
                            }
                        ]
                    }
                ],
