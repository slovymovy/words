                    {
                        "sense_id": "9cdc6734-a001-3d73-a617-923b33c16860",
                        "entry_id": "ac1d2b15-e83a-3357-b3db-7bb7226f5aa6",
                        "glosses": [
                            "denkend aan iets of iemand met name aan zondige daden en overleden mensen, zich herinnerende"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2aa04855-254c-4132-b4e8-17398c197b23",
                                "sense_id": "9cdc6734-a001-3d73-a617-923b33c16860",
                                "text": "Is dit allemaal te mooi om waar te zijn? Laten we dan toch maar aan de sombere kant blijven, gedachtig het woord van columnist George Will: je kunt beter pessimist zijn - dan krijg je meestal gelijk en word je af en toe aangenaam verrast."
                            },
                            {
                                "example_id": "ab237df0-7b98-475f-a520-0e34775ffe9a",
                                "sense_id": "9cdc6734-a001-3d73-a617-923b33c16860",
                                "text": "3. Wees gedachtig, dat gij de dag des Heren heiligt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "90ea8107-8990-4c51-8235-7c1499114c44",
                        "source_entry_id": "ac1d2b15-e83a-3357-b3db-7bb7226f5aa6",
                        "source_sense_id": "9cdc6734-a001-3d73-a617-923b33c16860",
