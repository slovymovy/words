    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ea0f83de-1996-3bc9-a469-c06b5266a0ff",
                "word": "vinegret",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c3a5bae-459b-3fee-885b-75a2b4b4fc1b",
                        "entry_id": "ea0f83de-1996-3bc9-a469-c06b5266a0ff",
                        "glosses": [
                            "A type of Russian salad with diced cooked vegetables (red beets, potatoes, carrots), chopped onions, as well as sauerkraut or brined pickles or both, and sometimes other ingredients such as green peas or beans."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "087ee861-d940-450a-aa4c-53546d25ae92",
                                "sense_id": "3c3a5bae-459b-3fee-885b-75a2b4b4fc1b",
                                "text": "Vinegret wonderfully reflects the way international cuisine was integrated into Russia."
                            },
                            {
                                "example_id": "ccf85e61-4e71-4335-b809-492c99b1f6bd",
                                "sense_id": "3c3a5bae-459b-3fee-885b-75a2b4b4fc1b",
                                "text": "The great thing about vinegret, apart from being one of Russia’s favorites, is that it also happens to be a Lenten salad."
                            },
                            {
                                "example_id": "aa8c5340-ab19-4b85-94f3-34838ec11cda",
                                "sense_id": "3c3a5bae-459b-3fee-885b-75a2b4b4fc1b",
                                "text": "Maybe it’s my Russian heritage — beets are the undisputed superstars of Russian cooking and adored in Persian, Middle Eastern and North African cuisines, as well — but I’ll eat them in any permutation: in borscht, in vinegret or herring-under-a-fur-coat (two beloved Russian dishes), julienned raw in salads or spun into a garlicky spread, zakuski-style."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "039e9984-84df-47fc-b336-dea278e4c600",
                        "source_entry_id": "ea0f83de-1996-3bc9-a469-c06b5266a0ff",
                        "source_sense_id": "3c3a5bae-459b-3fee-885b-75a2b4b4fc1b",
                        "source_sense_description": "type of Russian salad",
