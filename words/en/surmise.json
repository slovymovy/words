{
    "word_family": [
        "surmiser",
        "surmisable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "202a6123-6f53-3c5c-8a47-17652f301820",
                    "sense_definition": "To form an idea or opinion about something without having strong evidence; to guess or suspect based on limited information.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conjecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>surmise</w> that the meeting was canceled because the manager's car is still in the parking lot.",
                            "target_lang_translations": {
                                "ru": "Я <w>предполагаю</w>, что собрание отменили, так как машина менеджера все еще на парковке."
                            }
                        },
                        {
                            "text": "One can only <w>surmise</w> the reasons for his sudden departure, as he left no note behind.",
                            "target_lang_translations": {
                                "ru": "О причинах его внезапного отъезда можно только <w>догадываться</w>, так как он не оставил никакой записки."
                            }
                        }
                    ],
                    "synonyms": [
                        "conjecture",
                        "guess",
                        "suspect",
                        "speculate",
                        "hypothesize"
                    ],
                    "antonyms": [
                        "know",
                        "prove",
                        "verify"
                    ],
                    "common_phrases": [
                        "only surmise",
                        "can surmise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сформулировать идею или мнение о чем-либо без веских доказательств; догадываться или подозревать на основе ограниченной информации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предполагать",
                                "target_lang_sense_clarification": "допускать возможность чего-либо"
                            },
                            {
                                "target_lang_word": "подозревать",
                                "target_lang_sense_clarification": "догадываться о чем-либо"
                            },
                            {
                                "target_lang_word": "высказывать догадку",
                                "target_lang_sense_clarification": "строить предположение"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20bcf846-7c74-3503-9391-2a9dfd94074b",
                    "sense_definition": "An idea or opinion that is based on little or no evidence; a guess or suspicion.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "conjecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detective's theory was based on mere <w>surmise</w> rather than any concrete physical evidence.",
                            "target_lang_translations": {
                                "ru": "Теория детектива основывалась на простом <w>предположении</w>, а не на каких-либо конкретных вещественных доказательствах."
                            }
                        },
                        {
                            "text": "Without any facts to support her claim, her statement remains nothing more than a <w>surmise</w>.",
                            "target_lang_translations": {
                                "ru": "Без каких-либо фактов, подтверждающих ее заявление, ее слова остаются не более чем <w>домыслом</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "conjecture",
                        "guess",
                        "supposition",
                        "hunch",
                        "speculation"
                    ],
                    "antonyms": [
                        "fact",
                        "certainty",
                        "proof"
                    ],
                    "common_phrases": [
                        "mere surmise",
                        "pure surmise"
                    ],
                    "target_lang_definitions": {
                        "ru": "Идея или мнение, основанное на незначительных доказательствах или их отсутствии; догадка или подозрение."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предположение",
                                "target_lang_sense_clarification": "догадка о чем-либо"
                            },
                            {
                                "target_lang_word": "домысел",
                                "target_lang_sense_clarification": "вывод, не основанный на фактах"
                            },
                            {
                                "target_lang_word": "подозрение",
                                "target_lang_sense_clarification": "мнение о возможности чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7963e72-1d5e-351e-9583-5c09422574fb",
                    "sense_definition": "A deep reflection or a state of being lost in thought, often involving a sense of wonder or awe.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "reflection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers looked at the vast canyon with a wild <w>surmise</w>, amazed by its sheer scale.",
                            "target_lang_translations": {
                                "ru": "Исследователи смотрели на огромный каньон с немым <w>изумлением</w>, пораженные его масштабами."
                            }
                        },
                        {
                            "text": "He sat in silence, his mind clouded by a dark <w>surmise</w> about the future of the project.",
                            "target_lang_translations": {
                                "ru": "Он сидел в тишине, и его разум был омрачен мрачным <w>предчувствием</w> относительно будущего проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "reflection",
                        "thought",
                        "contemplation"
                    ],
                    "common_phrases": [
                        "wild surmise"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in literary or poetic contexts to describe deep thought or wonder"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Глубокое раздумье или состояние погруженности в мысли, часто сопровождающееся чувством удивления или благоговения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раздумье",
                                "target_lang_sense_clarification": "глубокое размышление"
                            },
                            {
                                "target_lang_word": "догадка",
                                "target_lang_sense_clarification": "внезапное озарение или мысль"
                            },
                            {
                                "target_lang_word": "созерцание",
                                "target_lang_sense_clarification": "в контексте немого изумления"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}