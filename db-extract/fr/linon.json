            {
                "entry_id": "33a8e77a-0e56-3959-8846-6fdf5050394e",
                "word": "linon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d19e78fa-d24f-44da-9f75-12227a44a76f",
                        "entry_id": "33a8e77a-0e56-3959-8846-6fdf5050394e",
                        "tags": [
                            "plural"
                        ],
                        "form": "linons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "862f849b-3beb-35b6-95a8-6b25fa12dc99",
                        "entry_id": "33a8e77a-0e56-3959-8846-6fdf5050394e",
                        "glosses": [
                            "Toile de lin ou de coton, très claire et très fine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c4ae9ff-6a54-47a6-9f7f-9f154e310a58",
                                "sense_id": "862f849b-3beb-35b6-95a8-6b25fa12dc99",
                                "text": "Trois mouchoirs linon brodé et Valenciennes. L'un, couronne vicomtale, le second couronne comtale et Valenciennes à décors de fleurs de lys."
                            },
                            {
                                "example_id": "71a5fe91-e2d6-4860-bbf7-1d138425fa53",
                                "sense_id": "862f849b-3beb-35b6-95a8-6b25fa12dc99",
                                "text": "Linge de lit en linon « Ourson »: Pour que votre petit chéri soit toujours confortablement installé !"
                            },
                            {
                                "example_id": "50dda224-9924-47e4-9bbb-fa2476856e16",
                                "sense_id": "862f849b-3beb-35b6-95a8-6b25fa12dc99",
                                "text": "L'habitué du Moulin-Rouge ou du Casino de Paris n'aime que l'élégance de la cuisse, et il distingue assez mal le linon de la cotonnade : Plus il y a de linge, plus il est content."
                            },
                            {
                                "example_id": "9e6a1810-1a36-478d-ae55-c0da2739060d",
                                "sense_id": "862f849b-3beb-35b6-95a8-6b25fa12dc99",
                                "text": "Ses mains, sèches et jaunes, habituées aux toiles rudes, ont mille précautions pour saisir les linons soyeux et les mousselines caressantes."
                            },
                            {
                                "example_id": "cca0a9b4-83e6-4e8b-a91b-9a227ddf3ee0",
                                "sense_id": "862f849b-3beb-35b6-95a8-6b25fa12dc99",
                                "text": "Ce fut Alexis qui essuya l’eau avec son grand mouchoir de linon, bien soigneusement, pendant qu’Henriette pleurait sur une chaise."
                            },
                            {
                                "example_id": "1a212108-843d-4049-943a-fad1193c2306",
                                "sense_id": "862f849b-3beb-35b6-95a8-6b25fa12dc99",
                                "text": "Il lui arrivait d’être presque jolie, le soir, dans son déshabillé de linon ; mais la fatigue et le désespoir desséchaient son visage."
                            },
                            {
                                "example_id": "49770698-648f-4d61-be34-61eabb5b0ebf",
                                "sense_id": "862f849b-3beb-35b6-95a8-6b25fa12dc99",
                                "text": "Célita, en culotte de linon et en soutien-gorge, passait ses bas quand Natacha et Maud arrivèrent à leur tour."
                            }
                        ]
                    }
                ],
