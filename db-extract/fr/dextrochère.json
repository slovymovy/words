                        "entry_id": "32c55df3-7c6b-388e-aea0-1896b5042f5a",
                        "glosses": [
                            "Meuble représentant dans les armoiries un bras droit nu ou habillé, tenant une arme ou tout autre objet. À rapprocher de bras, main et senestrochère ou sénestrochère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d990357-73b7-45a1-99f8-034a8d5293de",
                                "sense_id": "093051d0-9952-3f1d-8eec-cd3170eadcbe",
                                "text": "Elle a sommé lʼécu d’une couronne de marquis, sans dextrochère."
                            },
                            {
                                "example_id": "7777c661-12ae-44f2-8639-e2bb23447cd2",
                                "sense_id": "093051d0-9952-3f1d-8eec-cd3170eadcbe",
                                "text": "de Costentin : de gueules, au dextrochère armé d’argent tenant une épée, et surmonté d’un casque taré de profil, tout du même."
                            },
                            {
                                "example_id": "222b1e9c-f768-4256-a851-1737709c224c",
                                "sense_id": "093051d0-9952-3f1d-8eec-cd3170eadcbe",
                                "text": "D’azur au dextrochère de carnation, habillé d’une manche large d’argent, tenant une crosse contournée d’or posée en pal, qui est de la commune de Saint-Seine-l’Abbaye → voir illustration « armoiries avec un dextrochère »"
                            }
                        ]
                    }
