                    "frequency": "VeryLow",
                    "semantic_group_id": "notebook",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Scholars of that era would read widely and diligently <w>commonplace</w> useful arguments.",
                            "target_lang_translations": {
                                "ru": "Учёные той эпохи много читали и усердно <w>выписывали в тетради</w> полезные аргументы."
