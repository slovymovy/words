                },
                {
                    "sense_id": "3b2cfe79-896e-3fe7-9e33-78ada94f71ee",
                    "sense_definition": "door een ongelukkige samenloop van omstandigheden; te wijten aan ongeluk of onhandigheid",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ongelukkigerwijs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De speler wilde op zijn keeper terugspelen, maar <w>ongelukkigerwijs</w> lepelde hij de bal over zijn doelman heen in het doel.",
                            "target_lang_translations": {
                                "en": "The player wanted to pass back to his goalkeeper, but <w>unluckily</w> he lobbed the ball over his goalkeeper into the goal."
                            }
                        },
                        {
                            "text": "Zij liet de vaas <w>ongelukkigerwijs</w> uit haar handen glippen tijdens het afstoffen.",
                            "target_lang_translations": {
                                "en": "She <w>accidentally</w> let the vase slip from her hands while dusting."
                            }
                        }
                    ],
                    "synonyms": [
                        "ongelukkig"
                    ],
                    "antonyms": [
                        "gelukkigerwijs"
                    ],
                    "common_phrases": [
