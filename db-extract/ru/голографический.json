                            }
                        ]
                    },
                    {
                        "translation_id": "ed3b9702-e1ff-437d-abf1-419a46e0cb19",
                        "source_entry_id": "5f60e66c-3c80-39f9-973f-b29f2adf2d51",
                        "source_sense_id": "6aac52ea-64f3-3e4c-baff-f4d88423007a",
                        "target_lang_word": "holographisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "holographisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff7735c-f740-3836-b53a-fa90218c3d65",
                                        "entry_id": "ff4f22ec-0193-3c6c-a293-4a830523aef8",
                                        "glosses": [
                                            "auf Hologramme oder die Holografie bezogen; mithilfe der Holografie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3797e7b8-dc69-468f-9ae1-a2a9f77dea4a",
                                                "sense_id": "6ff7735c-f740-3836-b53a-fa90218c3d65",
                                                "text": "„Um ein Objekt holographisch aufzuzeichnen wird es mit kohärentem Licht be- oder durchleuchtet.“"
                                            },
                                            {
                                                "example_id": "fbeb24ce-3716-47e8-8634-6041ed5b1e2b",
                                                "sense_id": "6ff7735c-f740-3836-b53a-fa90218c3d65",
                                                "text": "„Die Größe der holographisch darstellbaren Objekte wird von der Intensität der verfügbaren Laserstrahlung bestimmt, da das aus dem Laser austretende Strahlenbündel nur einen Durchmesser von der Größenordnung 1 mm hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "884032f6-4b06-3044-a8e8-95a4a8fc598f",
                                        "entry_id": "ff4f22ec-0193-3c6c-a293-4a830523aef8",
                                        "glosses": [
                                            "mit der Hand geschrieben"
                                        ],
                                        "tags": [
                                            "Rechtswissenschaften"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79ff1ac5-1e1e-4639-b355-706305ada354",
                                                "sense_id": "884032f6-4b06-3044-a8e8-95a4a8fc598f",
                                                "text": "„[…] beim Testament ist dagegen erforderlich, daß der Erblasser die gesamte Urkunde mit eigener Hand schreibt und unterschreibt (sog. holographische Schriftform, vgl. ä 2247 Abs. 1 BGB). Ein mit Schreibmaschine angefertigtes und nur unterschriebenes Testament […] ist also unwirksam […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "466e453f-f149-45c6-a908-5dd1b1922393",
                        "source_entry_id": "5f60e66c-3c80-39f9-973f-b29f2adf2d51",
                        "source_sense_id": "6aac52ea-64f3-3e4c-baff-f4d88423007a",
