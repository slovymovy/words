                "senses": [
                    {
                        "sense_id": "ab2632b3-b433-3e99-9c9d-6d8898af7c25",
                        "entry_id": "4a722950-9995-35d8-903c-9e4aaa192851",
                        "glosses": [
                            "drewniany budynek stawiany na halach pasterskich, w którym przez kilka miesięcy w roku, na czas wypasu, przebywa baca wraz z juhasami"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "a8892ee3-62f7-3512-803e-01014267ea77",
                        "entry_id": "4a722950-9995-35d8-903c-9e4aaa192851",
                        "glosses": [
                            "schronisko dla turystów na górskim szlaku"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30c7342f-c7de-4181-8793-977dace54783",
                        "source_entry_id": "4a722950-9995-35d8-903c-9e4aaa192851",
                        "source_sense_id": "ab2632b3-b433-3e99-9c9d-6d8898af7c25",
                        "target_lang_word": "Sennerei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sennerei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04204b58-5651-3a51-add6-a03d303a4c32",
                                        "entry_id": "b9e7e58a-4fb8-32f9-ac1e-4398ef9b2c88",
                                        "glosses": [
                                            "landwirtschaftlicher Betrieb in den Bergen, in dem Milch zu weiteren Produkten wie Butter und Käse verarbeitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3f8ed33-8e9f-449c-a37d-3678081772b1",
                                                "sense_id": "04204b58-5651-3a51-add6-a03d303a4c32",
                                                "text": "„In der Nebenkammer stehen Kübel und Töpfe; da ist das Milch- und Buttergeschäft, dessen Erträgnis dem Eigentümer der Sennerei redlich zugeliefert wird.“"
                                            },
                                            {
                                                "example_id": "85a54c80-3bc4-4370-a373-a86e0bca56cf",
                                                "sense_id": "04204b58-5651-3a51-add6-a03d303a4c32",
                                                "text": "„Am Ende des Tals lädt die Sennerei Robanov kot zum Imbiss ein.“"
                                            },
                                            {
                                                "example_id": "1f1066a5-ab5c-4714-8332-b177837fd6b0",
                                                "sense_id": "04204b58-5651-3a51-add6-a03d303a4c32",
                                                "text": "„Dadurch, dass die Sennerei die Milch von neun Milchlieferanten bezieht, kommen im Jahr rund 1,4 Millionen Liter Milch zusammen.“"
                                            },
                                            {
                                                "example_id": "3eddc0eb-385a-41ce-8674-ab34ad163dd3",
                                                "sense_id": "04204b58-5651-3a51-add6-a03d303a4c32",
                                                "text": "„Die älteste genossenschaftlich geführte Sennerei des Allgäus gibt es im Gunzesrieder Tal.“"
                                            },
                                            {
                                                "example_id": "9f198c68-2214-424c-8afd-af22137d1219",
                                                "sense_id": "04204b58-5651-3a51-add6-a03d303a4c32",
                                                "text": "„Hier dreht sich alles um Käse, und probieren darf man auch: die Sennerei Drei Zinnen.“"
                                            },
                                            {
                                                "example_id": "a5ce31a2-fca7-4764-b871-93fb4157ae99",
                                                "sense_id": "04204b58-5651-3a51-add6-a03d303a4c32",
                                                "text": "„In ungefähr 7-10 Meter Entfernung befand sich parallel dazu die Sennerei von Grän.“"
                                            },
                                            {
                                                "example_id": "72b826ff-7d5f-4261-98bd-88fe9472b35c",
                                                "sense_id": "04204b58-5651-3a51-add6-a03d303a4c32",
                                                "text": "„Viele der Sennereien bieten Ihnen die Chance, live bei der Herstellung der Käseräder dabei zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
