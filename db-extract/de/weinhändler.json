                        ],
                        "form": "die Weinhändler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "29f2ddde-dead-3f35-b673-b9174c93fabf",
                        "entry_id": "1b8f73cd-9b2c-337c-a8e3-733ddfb613a0",
                        "glosses": [
                            "eine Person, die beruflich mit Wein handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3766a26-e5ef-49c8-8ec0-301ae50a4a66",
                                "sense_id": "29f2ddde-dead-3f35-b673-b9174c93fabf",
                                "text": "Der Weinhändler lud die Gäste zur Weinverkostung ein."
                            },
                            {
                                "example_id": "0ca1e896-534e-4891-98a6-cf0f26e3ffdf",
                                "sense_id": "29f2ddde-dead-3f35-b673-b9174c93fabf",
                                "text": "„Es sind Hemden-, Nähmaschinen- und Autofabrikanten, Filmproduzenten, Fernsehintendanten, Gastwirte, Schauspieler und Kellner, aber auch Polizisten, Soldaten, Politiker, Sportler, Kaufleute, Hausfrauen, Winzer und Weinhändler.“"
                            },
                            {
                                "example_id": "b12b3134-3696-4f54-9e29-bb770ab8594f",
                                "sense_id": "29f2ddde-dead-3f35-b673-b9174c93fabf",
                                "text": "„Sie heißt Dora Hatt; drei oder vier Jahre älter als er, ist sie unglücklich mit einem Weinhändler verheiratet und Mutter eines kleines Mädchens.“"
                            },
                            {
                                "example_id": "7748e2f9-6628-4b34-92de-89dc54bf6cf6",
                                "sense_id": "29f2ddde-dead-3f35-b673-b9174c93fabf",
                                "text": "„Dieser war ein reicher Weinhändler, dessen zahlreiche Familie ganz reizend war.“"
                            },
                            {
                                "example_id": "6c5a72ef-546c-4be4-9aa0-0baeae097361",
                                "sense_id": "29f2ddde-dead-3f35-b673-b9174c93fabf",
                                "text": "„Weinhändler, Fälscher, Schmuggler, Emigranten und Schieber saßen im »Brûleur de Loup«.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "35c8c52e-a780-43f2-b9ca-62146bd7e89d",
