                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "c418a152-7db0-4d3d-9fcf-bc2cbe34b947",
                        "source_entry_id": "473613ba-d461-346a-a64a-a2e5801a59eb",
                        "source_sense_id": "fe0be408-933a-3dd0-8a5a-0a7196e39c7c",
                        "target_lang_word": "colorature",
