                                "target_senses": [
                                    {
                                        "sense_id": "ffc37c9e-f0e0-345b-be08-134bb358934d",
                                        "entry_id": "6ddc2a9f-cb61-3ec0-b05c-a14e34ac3243",
                                        "glosses": [
                                            "Un personnage ayant au premier abord une personnalité distante, hautaine, voire violente et qui révèle une personnalité affectueuse et tendre par la suite."
                                        ],
                                        "tags": [
                                            "Fiction japonaise"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ddffde9-469b-4f85-a8f1-186c253157a1",
                                                "sense_id": "ffc37c9e-f0e0-345b-be08-134bb358934d",
                                                "text": "Suga est considéré par certains fans comme étant tsundere."
                                            },
                                            {
                                                "example_id": "0950b737-d20a-4eb2-8850-911d6801d564",
                                                "sense_id": "ffc37c9e-f0e0-345b-be08-134bb358934d",
                                                "text": "Ce sont les deux garçons dans la catégorie “tsundere” dont la popularité ne cesse de grandir ! Pourtant ils refusent systèmatiqueme d’être pris en photo !!"
                                            },
                                            {
                                                "example_id": "e35e7d15-8cc0-495d-95d8-e2e97b17e047",
                                                "sense_id": "ffc37c9e-f0e0-345b-be08-134bb358934d",
                                                "text": "Tu venais de me prouver que tu n'étais pas une tsundere, mais tout simplement une personne d'un caractère exécrable…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
