                "senses": [
                    {
                        "sense_id": "dc30d20b-b92d-3d29-a57d-210fb9b884a8",
                        "entry_id": "a0fe1dd5-f53a-37c3-bebc-d3c5b5638586",
                        "glosses": [
                            "Donner un caractère pachydermique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027b1db3-0381-4282-b0bd-725f70992490",
                                "sense_id": "dc30d20b-b92d-3d29-a57d-210fb9b884a8",
                                "text": "La malheureuse peine à charrier son popotin pachydermisé par la malbouffe et des grossesses à répétition."
                            },
                            {
                                "example_id": "6e9c3e38-7088-4860-908f-9880380f91a0",
                                "sense_id": "dc30d20b-b92d-3d29-a57d-210fb9b884a8",
                                "text": "Par contre elle fait un peu grosse, j'espère qu'elle va pas se pachydermiser..."
                            },
                            {
                                "example_id": "3792b324-a333-4eec-9290-f636691d00db",
                                "sense_id": "dc30d20b-b92d-3d29-a57d-210fb9b884a8",
                                "text": "Depuis un peu plus d'un an, Firefox a cependant une très fâcheuse tendance à se « pachydermiser »."
                            },
                            {
                                "example_id": "cd50cd86-7c7a-41bf-b836-6a60d7053918",
                                "sense_id": "dc30d20b-b92d-3d29-a57d-210fb9b884a8",
                                "text": "Et même étudiant, le temps passe vite pour se faire remarquer, ils n'ont pas les organisations satellites du PS pour se pachydermiser tranquillement…"
                            }
                        ]
                    }
                ],
