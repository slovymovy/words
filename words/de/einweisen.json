            "senses": [
                {
                    "sense_id": "93710091-8360-39cf-a725-ed767a9ffc2e",
                    "sense_definition": "jemanden, besonders eine kranke Person, zur stationären Behandlung in ein Krankenhaus oder eine ähnliche Einrichtung schicken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "medizinisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Hausarzt <w>wies</w> den Patienten wegen starker Schmerzen sofort ins Krankenhaus <w>ein</w>."
                        },
                        {
                            "text": "Nach dem schweren Unfall wurde sie direkt in eine Spezialklinik <w>eingewiesen</w>."
                        }
                    ],
                    "synonyms": [
                        "überweisen"
                    ],
                    "common_phrases": [
                        "ins Krankenhaus einweisen",
                        "in eine Klinik einweisen"
                    ]
                },
                {
                    "sense_id": "83cbb5c7-ef2a-38b8-b906-33d0419331d1",
                    "sense_definition": "jemanden mit einem neuen Arbeitsbereich, einer Aufgabe oder einem Gerät vertraut machen und anleiten",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anleitung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die erfahrene Kollegin <w>weist</w> den neuen Mitarbeiter gründlich in seine Aufgaben <w>ein</w>."
                        },
                        {
                            "text": "Vor der ersten Benutzung des Geräts wurden alle Angestellten sorgfältig <w>eingewiesen</w>."
                        }
                    ],
                    "synonyms": [
                        "einführen",
                        "einschulen"
                    ],
                    "common_phrases": [
                        "in die Aufgaben einweisen",
                        "in ein Gerät einweisen"
                    ]
                },
                {
                    "sense_id": "3707c644-6ef3-350a-991b-59bb951e2e2d",
                    "sense_definition": "einem Fahrer durch Handzeichen oder Zurufe helfen, ein Fahrzeug sicher an einen Platz zu steuern",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lenken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kannst du mich bitte kurz <w>einweisen</w>, da die Parklücke sehr eng ist?"
                        },
                        {
                            "text": "Der Beifahrer stieg aus und <w>wies</w> den Lastwagen vorsichtig in die Einfahrt <w>ein</w>."
                        }
                    ],
                    "common_phrases": [
                        "beim Einparken einweisen"
                    ]
                },
                {
                    "sense_id": "7783d532-c1fc-3dbe-9a02-a9a242a2ba58",
                    "sense_definition": "jemandem behördlich oder offiziell eine Stelle, ein Amt oder eine Unterkunft zuteilen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verwaltung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die zuständige Behörde <w>wies</w> die geflüchtete Familie in eine freie Wohnung <w>ein</w>."
                        },
                        {
                            "text": "Der Richter wurde nach erfolgreicher Probezeit offiziell in seine neue Planstelle <w>eingewiesen</w>."
                        }
                    ],
                    "common_phrases": [
                        "in eine Planstelle einweisen"
                    ]
                }
            ]
        }
