{
    "word_family": [
        "whatsoever",
        "whichever",
        "whoever",
        "whenever",
        "wherever",
        "however"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "1da5d0a2-a80b-35eb-a02b-ab8e3d45168d",
                    "sense_definition": "Anything that; everything that.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "relative_indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will support you and do <w>whatever</w> I can to help.",
                            "target_lang_translations": {
                                "ru": "Я поддержу тебя и сделаю <w>всё, что</w> смогу, чтобы помочь.",
                                "es": "Te apoyaré y haré <w>todo lo que</w> pueda para ayudar."
                            }
                        },
                        {
                            "text": "You are free to choose <w>whatever</w> works best for you.",
                            "target_lang_translations": {
                                "ru": "Ты волен выбирать <w>что угодно</w>, что лучше всего тебе подходит.",
                                "es": "Eres libre de elegir <w>lo que sea que</w> funcione mejor para ti."
                            }
                        }
                    ],
                    "synonyms": [
                        "anything"
                    ],
                    "common_phrases": [
                        "do whatever it takes",
                        "whatever works"
                    ],
                    "target_lang_definitions": {
                        "ru": "Всё, что; что угодно; что бы то ни было.",
                        "es": "Cualquier cosa que; todo lo que."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всё, что",
                                "target_lang_sense_clarification": "everything that"
                            },
                            {
                                "target_lang_word": "что угодно",
                                "target_lang_sense_clarification": "anything"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "lo que sea",
                                "target_lang_sense_clarification": "cualquier cosa"
                            },
                            {
                                "target_lang_word": "todo lo que",
                                "target_lang_sense_clarification": "todo aquello que"
                            },
                            {
                                "target_lang_word": "cualquier cosa que",
                                "target_lang_sense_clarification": "sin importar qué"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "abe20d2b-2aa6-3b38-893f-b4656080f939",
                    "sense_definition": "Regardless of anything that happens or is the case; no matter what.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whatever</w> happens, try to remain calm and focused.",
                            "target_lang_translations": {
                                "ru": "<w>Что бы ни</w> случилось, постарайся сохранять спокойствие и сосредоточенность.",
                                "es": "<w>Pase lo que pase</w>, intenta mantener la calma y la concentración."
                            }
                        },
                        {
                            "text": "He promised to finish the project <w>whatever</w> the difficulties.",
                            "target_lang_translations": {
                                "ru": "Он пообещал закончить проект, <w>какими бы ни</w> были трудности.",
                                "es": "Prometió terminar el proyecto <w>sin importar</w> las dificultades."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whatever happens",
                        "whatever it is"
                    ],
                    "target_lang_definitions": {
                        "ru": "Независимо от того, что происходит; что бы ни случилось.",
                        "es": "Sin importar lo que ocurra o sea el caso; pase lo que pase."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "что бы ни",
                                "target_lang_sense_clarification": "regardless of what"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "pase lo que pase",
                                "target_lang_sense_clarification": "sin importar qué ocurra"
                            },
                            {
                                "target_lang_word": "sea lo que sea",
                                "target_lang_sense_clarification": "sin importar qué sea"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "170759fe-670b-37eb-84dc-8d466bb22a78",
                    "sense_definition": "Anything of an unspecified kind; used to indicate that the speaker does not care about specific options or is referring to a vague list.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relative_indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We can watch a movie, play a game, or <w>whatever</w>.",
                            "target_lang_translations": {
                                "ru": "Мы можем посмотреть фильм, поиграть в игру <w>или типа того</w>.",
                                "es": "Podemos ver una película, jugar a un juego, o <w>lo que sea</w>."
                            }
                        },
                        {
                            "text": "Just wear jeans or <w>whatever</w> you feel comfortable in.",
                            "target_lang_translations": {
                                "ru": "Просто надень джинсы или <w>что угодно</w>, в чем тебе удобно.",
                                "es": "Solo ponte vaqueros o <w>lo que sea</w> con lo que te sientas cómodo."
                            }
                        }
                    ],
                    "common_phrases": [
                        "or whatever"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used at the end of a list"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то неопределенное; используется для указания на то, что говорящему не важны конкретные варианты, или список является приблизительным.",
                        "es": "Cualquier cosa de un tipo no especificado; usado para indicar que no importan las opciones exactas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "или типа того",
                                "target_lang_sense_clarification": "colloquial"
                            },
                            {
                                "target_lang_word": "и всё такое",
                                "target_lang_sense_clarification": "and things like that"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "o lo que sea",
                                "target_lang_sense_clarification": "o algo similar"
                            },
                            {
                                "target_lang_word": "o cosas así",
                                "target_lang_sense_clarification": "o por el estilo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fbe70aa-5092-3b7f-891d-d1e25d4b21c4",
                    "sense_definition": "An emphatic form of 'what', used to ask questions expressing surprise, confusion, or frustration.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emphatic_interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whatever</w> do you mean by that strange remark?",
                            "target_lang_translations": {
                                "ru": "<w>Что же</w> ты имеешь в виду под этим странным замечанием?",
                                "es": "¿<w>Qué demonios</w> quieres decir con ese comentario tan extraño?"
                            }
                        },
                        {
                            "text": "<w>Whatever</w> gave you the idea that I was leaving?",
                            "target_lang_translations": {
                                "ru": "<w>Что вообще</w> навело тебя на мысль, что я ухожу?",
                                "es": "¿<w>Qué en el mundo</w> te dio la idea de que me iba?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "whatever for"
                    ],
                    "target_lang_definitions": {
                        "ru": "Усилительная форма 'что', выражающая удивление, замешательство или разочарование.",
                        "es": "Forma enfática de 'qué', usada para expresar sorpresa, confusión o frustración en preguntas."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "что же",
                                "target_lang_sense_clarification": "emphatic"
                            },
                            {
                                "target_lang_word": "что вообще",
                                "target_lang_sense_clarification": "emphatic colloquial"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "qué demonios",
                                "target_lang_sense_clarification": "enfático coloquial"
                            },
                            {
                                "target_lang_word": "qué en el mundo",
                                "target_lang_sense_clarification": "enfático"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "determiner",
            "senses": [
                {
                    "sense_id": "4e647158-8ffa-383f-8365-78991ee210f2",
                    "sense_definition": "Any ... that; of no matter what type or kind.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relative_indefinite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Take <w>whatever</w> books you need for your research.",
                            "target_lang_translations": {
                                "ru": "Бери <w>любые</w> книги, которые нужны тебе для исследования.",
                                "es": "Lleva <w>cualquier</w> libro que necesites para tu investigación."
                            }
                        },
                        {
                            "text": "Write down <w>whatever</w> thoughts come into your mind.",
                            "target_lang_translations": {
                                "ru": "Записывай <w>любые</w> мысли, которые приходят тебе в голову.",
                                "es": "Anota <w>cualquier</w> pensamiento que te venga a la mente."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whatever reason"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой; какого угодно типа или вида.",
                        "es": "Cualquier... que; de cualquier tipo o clase."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "любой",
                                "target_lang_sense_clarification": "any"
                            },
                            {
                                "target_lang_word": "какой угодно",
                                "target_lang_sense_clarification": "of any kind"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cualquier",
                                "target_lang_sense_clarification": "un elemento indeterminado"
                            },
                            {
                                "target_lang_word": "cualquiera",
                                "target_lang_sense_clarification": "sin importar cuál"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "52650365-b5b9-32ba-96d9-a16fe88497eb",
                    "sense_definition": "Regardless of the specific ... that; for any ... that.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "concessive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whatever</w> choice you make, there will be consequences.",
                            "target_lang_translations": {
                                "ru": "<w>Какой бы</w> выбор ты ни сделал, последствия будут.",
                                "es": "<w>Sea cual sea</w> la elección que tomes, habrá consecuencias."
                            }
                        },
                        {
                            "text": "We must complete the mission, <w>whatever</w> the cost.",
                            "target_lang_translations": {
                                "ru": "Мы должны выполнить миссию <w>любой</w> ценой.",
                                "es": "Debemos completar la misión, <w>cueste lo que cueste</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "whatever the cost",
                        "whatever the reason"
                    ],
                    "target_lang_definitions": {
                        "ru": "Независимо от того, какой именно.",
                        "es": "Sin importar el o la... específico que; para cualquier... que."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "какой бы ни",
                                "target_lang_sense_clarification": "regardless of which"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cualquiera que sea",
                                "target_lang_sense_clarification": "sin importar cuál"
                            },
                            {
                                "target_lang_word": "sea cual sea",
                                "target_lang_sense_clarification": "independientemente de"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bb99270-1727-3e70-be02-144b4a35c44d",
                    "sense_definition": "An emphatic form of 'what' used as a determiner to express surprise or ask for specification.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "emphatic_interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whatever</w> time is it, that you are calling so late?",
                            "target_lang_translations": {
                                "ru": "<w>Сколько же</w> времени, что ты звонишь так поздно?",
                                "es": "¿<w>Qué</w> hora es para que llames tan tarde?"
                            }
                        },
                        {
                            "text": "<w>Whatever</w> reason could he possibly have for doing that?",
                            "target_lang_translations": {
                                "ru": "<w>Какая же</w> у него могла быть причина делать это?",
                                "es": "¿<w>Qué clase de</w> razón podría tener para hacer eso?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Усилительная форма 'какой', используемая как определитель для выражения удивления или уточнения.",
                        "es": "Forma enfática de 'qué' usada como determinante para expresar sorpresa o pedir especificación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "какой же",
                                "target_lang_sense_clarification": "emphatic"
                            },
                            {
                                "target_lang_word": "какой вообще",
                                "target_lang_sense_clarification": "emphatic colloquial"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "qué clase de",
                                "target_lang_sense_clarification": "enfático"
                            },
                            {
                                "target_lang_word": "qué",
                                "target_lang_sense_clarification": "con tono de sorpresa"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "fe888778-a3e1-38fa-8f76-1f9cff9455e6",
                    "sense_definition": "Used to dismiss something as unimportant, or to indicate indifference or a desire to end a conversation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dismissive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you don't want to believe me, fine, <w>whatever</w>.",
                            "target_lang_translations": {
                                "ru": "Если не хочешь мне верить, ладно, <w>проехали</w>.",
                                "es": "Si no quieres creerme, bien, <w>como sea</w>."
                            }
                        },
                        {
                            "text": "He started making excuses again, so I just said \"<w>whatever</w>\" and walked away.",
                            "target_lang_translations": {
                                "ru": "Он снова начал оправдываться, поэтому я просто сказал «<w>мне всё равно</w>» и ушел.",
                                "es": "Empezó a poner excusas otra vez, así que solo dije \"<w>da igual</w>\" y me fui."
                            }
                        }
                    ],
                    "synonyms": [
                        "whatever you say",
                        "if you say so"
                    ],
                    "common_phrases": [
                        "yeah whatever"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для выражения безразличия, пренебрежения или желания прекратить разговор.",
                        "es": "Usado para descartar algo como poco importante, o para indicar indiferencia o deseo de terminar una conversación."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "всё равно",
                                "target_lang_sense_clarification": "indifference"
                            },
                            {
                                "target_lang_word": "ну и ладно",
                                "target_lang_sense_clarification": "dismissive"
                            },
                            {
                                "target_lang_word": "проехали",
                                "target_lang_sense_clarification": "let it go"
                            },
                            {
                                "target_lang_word": "какая разница",
                                "target_lang_sense_clarification": "what difference does it make"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "da igual",
                                "target_lang_sense_clarification": "indiferencia"
                            },
                            {
                                "target_lang_word": "como sea",
                                "target_lang_sense_clarification": "de cualquier forma"
                            },
                            {
                                "target_lang_word": "lo que tú digas",
                                "target_lang_sense_clarification": "para dar la razón sin importar"
                            },
                            {
                                "target_lang_word": "no importa",
                                "target_lang_sense_clarification": "sin importancia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "cb83097f-e650-3a5e-9411-8b9f43f9b972",
                    "sense_definition": "At all; whatsoever (used after a negative to add emphasis).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intensifier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no point <w>whatever</w> in continuing this argument.",
                            "target_lang_translations": {
                                "ru": "Нет <w>абсолютно</w> никакого смысла продолжать этот спор.",
                                "es": "No tiene sentido <w>en absoluto</w> continuar con esta discusión."
                            }
                        },
                        {
                            "text": "She showed no fear <w>whatever</w> when facing the danger.",
                            "target_lang_translations": {
                                "ru": "Она не выказала <w>вообще</w> никакого страха перед лицом опасности.",
                                "es": "No mostró temor <w>alguno</w> al enfrentarse al peligro."
                            }
                        }
                    ],
                    "synonyms": [
                        "what the fuck ever",
                        "whatev",
                        "whevs"
                    ],
                    "common_phrases": [
                        "none whatever",
                        "nothing whatever"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вообще; совсем (используется после отрицания для усиления).",
                        "es": "En absoluto; para nada (usado después de una negación para dar énfasis)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вообще",
                                "target_lang_sense_clarification": "at all"
                            },
                            {
                                "target_lang_word": "абсолютно",
                                "target_lang_sense_clarification": "absolutely"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "en absoluto",
                                "target_lang_sense_clarification": "para nada"
                            },
                            {
                                "target_lang_word": "ninguno en absoluto",
                                "target_lang_sense_clarification": "absolutamente nada"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ca91003-1630-3c96-9605-a0d4fdcdec1e",
                    "sense_definition": "In what way; to what extent (emphatic usage).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emphatic_interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whatever</w> does it matter now that it is all over?",
                            "target_lang_translations": {
                                "ru": "<w>Какое же</w> это имеет значение сейчас, когда всё кончено?",
                                "es": "¿<w>Qué</w> importa ahora que todo ha terminado?"
                            }
                        },
                        {
                            "text": "<w>Whatever</w> can we do to fix this mess?",
                            "target_lang_translations": {
                                "ru": "<w>Что же</w> мы можем сделать, чтобы исправить этот бардак?",
                                "es": "¿<w>Cómo</w> podemos solucionar este desastre?"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Каким образом; в какой степени (усилительное значение).",
                        "es": "De qué manera; hasta qué punto (uso enfático)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "как же",
                                "target_lang_sense_clarification": "how emphatic"
                            },
                            {
                                "target_lang_word": "каким образом",
                                "target_lang_sense_clarification": "in what way"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "cómo",
                                "target_lang_sense_clarification": "de qué manera enfática"
                            },
                            {
                                "target_lang_word": "qué",
                                "target_lang_sense_clarification": "en qué medida"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "28b88073-fc6b-38a1-a9b9-d5f7b2ec0a70",
                    "sense_definition": "Unexceptional, unimportant, or mediocre.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "unimportant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The movie was okay, but the ending was totally <w>whatever</w>.",
                            "target_lang_translations": {
                                "ru": "Фильм был нормальный, но концовка была совершенно <w>никакая</w>.",
                                "es": "La película estuvo bien, pero el final fue totalmente <w>del montón</w>."
                            }
                        },
                        {
                            "text": "I guess I shouldn't complain, but the whole event felt very <w>whatever</w>.",
                            "target_lang_translations": {
                                "ru": "Наверное, мне не стоит жаловаться, но всё мероприятие было каким-то <w>никаким</w>.",
                                "es": "Supongo que no debería quejarme, pero todo el evento se sintió muy <w>sin más</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Посредственный, неважный, ничем не примечательный.",
                        "es": "Común, sin importancia o mediocre."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "так себе",
                                "target_lang_sense_clarification": "mediocre"
                            },
                            {
