                        "sense_id": "34baa2d3-e6c6-39a3-abf0-94bfdeb2ecfd",
                        "entry_id": "136e05c6-159a-3d5d-8de6-d4f2e2039fad",
                        "glosses": [
                            "Action de rencogner ou de se rencogner ; résultat de cette action."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "5ec10ee7-555f-425c-ba9b-7cd35190823e",
                                "sense_id": "34baa2d3-e6c6-39a3-abf0-94bfdeb2ecfd",
                                "text": "Avec mes habitudes d'isolement et de rencognement, je ne tenais aucun compte des autres. Je croyais qu’il me suffisait d’aller de l’avant, de me développer en suivant ma ligne et en essayant de bien faire […]."
                            },
                            {
                                "example_id": "56f47077-19e0-45fd-ad17-72e7c228f00f",
                                "sense_id": "34baa2d3-e6c6-39a3-abf0-94bfdeb2ecfd",
                                "text": "Le départ précoce des hirondelles et le rencognement des petits animaux en leurs terriers annonçaient un hiver rude."
                            }
                        ]
                    },
                    {
                        "sense_id": "36370749-68ca-3638-96d9-35ce559e5d21",
                        "entry_id": "136e05c6-159a-3d5d-8de6-d4f2e2039fad",
                        "glosses": [
                            "Endroit où l'on peut se rencogner."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "990a42b2-cfbd-4deb-a6d7-7ff3402e6d61",
                                "sense_id": "36370749-68ca-3638-96d9-35ce559e5d21",
                                "text": "En cette position actuelle, il occupe un petit rencognement d'environ deux pieds et demi, qui est entre la saillie du pilier aux degrés du « maître-autel et la porte par laquelle les chanoines réguliers de cette maison entrent au chœur."
                            },
                            {
                                "example_id": "9e22a370-97db-4492-b417-eda3e029e400",
                                "sense_id": "36370749-68ca-3638-96d9-35ce559e5d21",
                                "text": "Les deux femmes installèrent les paillasses pour la nuit dans un rencognement de la galerie."
                            }
                        ]
                    }
