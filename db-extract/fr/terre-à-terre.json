                                        "sense_id": "2712000e-d25a-3e09-aa79-c34506bbca37",
                                        "entry_id": "22f9a6ca-f0c2-3076-a59e-01df2c3e69d3",
                                        "glosses": [
                                            "Practical; realistic; pragmatic."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cbeb272-0c37-450b-be50-fc1930006e55",
                                                "sense_id": "2712000e-d25a-3e09-aa79-c34506bbca37",
                                                "text": "He had a down-to-earth attitude that translated into a straightforward, but effective strategy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6131aa6-891f-350d-887c-2db1686a6e03",
                                        "entry_id": "22f9a6ca-f0c2-3076-a59e-01df2c3e69d3",
                                        "glosses": [
                                            "Ordinary; normal; run-of-the-mill."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae20f5eb-8c7e-4906-aae2-6c11f0fc352f",
                                                "sense_id": "a6131aa6-891f-350d-887c-2db1686a6e03",
                                                "text": "\"I'm sorry, but I'm not going to devote any of tonight's news to evil monkey shenanigans unless you can find something more down to earth to focus your report on.\""
                                            },
                                            {
                                                "example_id": "2867d854-4097-46db-8d01-aff2b5ead43f",
                                                "sense_id": "a6131aa6-891f-350d-887c-2db1686a6e03",
                                                "text": "Relatable is to TikTok what aspirational was to Instagram—its most salient, sought-after quality. It signals a down-to-earth, democratic appeal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
