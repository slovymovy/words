                "senses": [
                    {
                        "sense_id": "714fbe2d-90c3-3beb-9c24-d5244914ec3a",
                        "entry_id": "3b56cd73-54e6-3493-a3ea-d0d81bf4651a",
                        "glosses": [
                            "Fluss im südlichen Afrika"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "171017cf-7958-4d57-9fb3-9e73b38e7f26",
                                "sense_id": "714fbe2d-90c3-3beb-9c24-d5244914ec3a",
                                "text": "„Die Ursache für mehrere Invasionen waren politische Zentralisierungsprozesse südlich des Limpopo, die durch die Expansion der Kapkolonie und den Zugang zu Waffen und Waren ausgelöst wurden.“"
                            },
                            {
                                "example_id": "acfe3cf7-2acd-4d65-afc2-be0d0d3d6584",
                                "sense_id": "714fbe2d-90c3-3beb-9c24-d5244914ec3a",
                                "text": "„Als Mzilikazi dann noch vom Zulukönigreich aus in der Flanke angegriffen wurde, zog er mit all seinen Matabele-Getreuen nach Norden bis ins Gebiet jenseits des Limpopo oder Krokodilflusses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b16cac0-d5b7-4828-a887-381675e751de",
                        "source_entry_id": "3b56cd73-54e6-3493-a3ea-d0d81bf4651a",
                        "source_sense_id": "714fbe2d-90c3-3beb-9c24-d5244914ec3a",
