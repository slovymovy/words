            },
            {
                "entry_id": "b6ebebd2-1588-3a95-8a86-32ccf2c40498",
                "word": "obojnak",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "7ae3e868-1610-3a71-89bd-c227c6998f6c",
                        "entry_id": "b6ebebd2-1588-3a95-8a86-32ccf2c40498",
                        "glosses": [
                            "człowiek mający narządy płciowe męskie i żeńskie jednocześnie"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4d797717-66b8-4b98-9d86-e5e0d9d16e2e",
                        "source_entry_id": "b6ebebd2-1588-3a95-8a86-32ccf2c40498",
                        "source_sense_id": "7ae3e868-1610-3a71-89bd-c227c6998f6c",
                        "target_lang_word": "Zwitter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zwitter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1672074d-78b1-3286-99ef-0d4f8829f6c1",
                                        "entry_id": "ed1ee819-7994-35b7-ac11-ada4ba2a5ed9",
                                        "glosses": [
                                            "Lebewesen, das sowohl männliche als auch weibliche Geschlechtsmerkmale aufweist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd605fa6-24b9-4c0d-854f-18034b9b2dd1",
                                                "sense_id": "1672074d-78b1-3286-99ef-0d4f8829f6c1",
                                                "text": "Im Mai 2000 beantragte Michel die Streichung der Randvermerke im Geburtenbuch sowie die Eintragung der Geschlechtsbezeichnung „Zwitter\", behelfsweise „Hermaphrodit\", „intersexuell\" oder „intrasexuell\"."
                                            },
                                            {
                                                "example_id": "ea896a82-9815-45c1-940e-4a3e33b54c81",
                                                "sense_id": "1672074d-78b1-3286-99ef-0d4f8829f6c1",
                                                "text": "„Die Entscheidung, ob ein Wurm zum Männchen oder zum Zwitter wird, hängt von der Anzahl der X-Chromosomen ab.“"
                                            },
                                            {
                                                "example_id": "c5b54547-b180-4463-8653-5feba1d36534",
                                                "sense_id": "1672074d-78b1-3286-99ef-0d4f8829f6c1",
                                                "text": "„Lange glaubte man, Tüpfelhyänen seien Zwitter“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "15e90ec8-5a03-3102-ae4b-938b9bad0fb7",
                                        "entry_id": "ed1ee819-7994-35b7-ac11-ada4ba2a5ed9",
                                        "glosses": [
                                            "Gebilde aus widersprüchlichen Teilen bestehend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "494c88bc-ff04-4877-94ca-867b7e635358",
                                                "sense_id": "15e90ec8-5a03-3102-ae4b-938b9bad0fb7",
                                                "text": "„Deshalb ist im Jahrzehnt vor den Olympischen Spielen von Peking ein seltsamer staatlicher Zwitter gewachsen, eine Diktatur, die vom Wohlwollen der Untertanen abhängig ist, ein Einparteienregime, das nur durch harte Arbeit am Gemeinwohl überleben kann, ein Land des unausgesprochenen politischen Deals.“"
                                            },
                                            {
                                                "example_id": "c5154eea-f314-4b3c-8666-a216702d6a34",
                                                "sense_id": "15e90ec8-5a03-3102-ae4b-938b9bad0fb7",
                                                "text": "Die EU ist aber ein Zwitter zwischen einem – zugegebenermaßen sehr engen – Bund souveräner Staaten und einer supranationalen Organisation."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
