        "nl-extract.jsonl": [
            {
                "entry_id": "de2874c2-8ed1-388d-aaed-6c3d70119bcf",
                "word": "ratificeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0b33c94c-e8bc-3018-8bb9-c2c71ae428c8",
                        "entry_id": "de2874c2-8ed1-388d-aaed-6c3d70119bcf",
                        "glosses": [
                            "bekrachtigen van een internationaal verdrag door het nationale parlement of regering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c366329-7ffa-4422-93cd-7c096dc20cc2",
                                "sense_id": "0b33c94c-e8bc-3018-8bb9-c2c71ae428c8",
                                "text": "De ‘International Campaign to Abolish Nuclear Weapons’ (ICAN) wint dit jaar de Nobelprijs voor de vrede. De ICAN - een coalitie van ngo’s uit zo’n honderd landen, waaronder in ons land de vzw Vrede en Pax Christi - was de drijvende kracht achter het internationale Verdrag over het Verbod op Nucleaire Wapens, dat in de schoot van de Verenigde Naties tot stand kwam. Op 7 juli werd het goedgekeurd door 122 van de 193 VN-lidstaten. Zodra vijftig staten het geratificeerd hebben, wordt het verbod op nucleaire wapens van kracht en is het bindend voor alle landen die het getekend hebben."
                            },
                            {
                                "example_id": "5a6dd454-525c-4490-bd9e-738476ccdb7a",
                                "sense_id": "0b33c94c-e8bc-3018-8bb9-c2c71ae428c8",
                                "text": "Als burgers tegen een internationaal verdrag stemmen, kan de Kamer daar niet zoveel mee, betoogde D66-Kamerlid Rob Jetten. Een verdrag niet-ratificeren is vanwege de internationale samenwerking ingewikkeld. Dat is de reden dat D66 nu tegen de grondwetswijziging stemt, die de partij zelf in 2013 heeft ingediend met GroenLinks en PvdA."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d70795c9-f2f5-469a-a5ad-34d7d2ccbe67",
                        "source_entry_id": "de2874c2-8ed1-388d-aaed-6c3d70119bcf",
                        "source_sense_id": "0b33c94c-e8bc-3018-8bb9-c2c71ae428c8",
                        "source_sense_description": "bekrachtigen van een internationaal verdrag door het nationale parlement of regering",
                        "target_lang_word": "ratify",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratify",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63ed7737-f5cd-378b-a890-57ccb4a9fbce",
                                        "entry_id": "ba04f406-a857-3479-a002-b1a8d7d1ee2b",
                                        "glosses": [
                                            "To give formal consent to; make officially valid, sign off on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0d80b79-d805-4bc5-89a1-b70437d58769",
                                                "sense_id": "63ed7737-f5cd-378b-a890-57ccb4a9fbce",
                                                "text": "They ratified the treaty."
                                            },
                                            {
                                                "example_id": "e29af982-6b77-46fe-8804-44975617b9e1",
                                                "sense_id": "63ed7737-f5cd-378b-a890-57ccb4a9fbce",
                                                "text": "Thus the workmen decide the principle, the Executive carry it out. The agent provides information and negotiates. The Conference finally ratifies or disapproves."
                                            },
                                            {
                                                "example_id": "85c8644b-48cc-48c7-9b3c-d7598255edff",
                                                "sense_id": "63ed7737-f5cd-378b-a890-57ccb4a9fbce",
                                                "text": "If the Senate ratifies the covenant on human rights and the Supreme Court upholds it under the established principles outlined above, freedom of speech, freedom of the press, and freedom of peaceful assembly may be destroyed by our own Government at any time by an official proclamation of a state of emergency."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2d93f76-3517-4ff8-94e6-9c9bdeb45a29",
                        "source_entry_id": "de2874c2-8ed1-388d-aaed-6c3d70119bcf",
                        "source_sense_id": "0b33c94c-e8bc-3018-8bb9-c2c71ae428c8",
                        "source_sense_description": "bekrachtigen van een internationaal verdrag door het nationale parlement of regering",
                        "target_lang_word": "ratifier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ratifier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "be375829-6194-3e16-b761-3984c5cd0c08",
                                        "entry_id": "740cdaf5-0016-3f80-80be-d4cb52d9771c",
                                        "glosses": [
                                            "Approuver, confirmer dans la forme requise ce qui a été fait ou promis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef3e360d-1974-4cf0-a42c-f8c79ad8e783",
                                                "sense_id": "be375829-6194-3e16-b761-3984c5cd0c08",
                                                "text": "Moi, Henri II de Bourbon, prince de Condé, bien que je sois de la famille royale, bien que mon écu porte les trois fleurs de lys, je ratifie le choix qui vient d'être fait, et salue M. le duc d'Angoulême pour notre roi légitime."
                                            },
                                            {
                                                "example_id": "f0b8914d-766a-4e8d-8aed-0b3317f91225",
                                                "sense_id": "be375829-6194-3e16-b761-3984c5cd0c08",
                                                "text": "Je suis persuadée que M. le Grand Doyen approuvera ma décision... Vous ne dites rien !... Est-ce que, par hasard, vous ne la ratifieriez point ?"
                                            },
                                            {
                                                "example_id": "639983b3-dd5c-4613-b94c-6f4ca69a9262",
                                                "sense_id": "be375829-6194-3e16-b761-3984c5cd0c08",
                                                "text": "Je gagerais que la postérité ne ratifiera ni l'une ni l'autre de ces appréciations véhémentes."
                                            },
                                            {
                                                "example_id": "14adf7ea-434e-4ac7-9b31-ac9f9c879a4c",
                                                "sense_id": "be375829-6194-3e16-b761-3984c5cd0c08",
                                                "text": "Ratifier par écrit. - Ratifier verbalement. - Ratifier un contrat, un acte. - Le traité est signé mais pas encore ratifié."
                                            },
                                            {
                                                "example_id": "9b3c82de-7acc-4ffd-a17a-efef4272ddb9",
                                                "sense_id": "be375829-6194-3e16-b761-3984c5cd0c08",
                                                "text": "Les obligations faites par un mineur demeurent nulles s’il ne les ratifie à sa majorité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
