        "fr-extract.jsonl": [
            {
                "entry_id": "8d37346f-18f9-3f26-9c33-ca6033abab97",
                "word": "boudoir",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "945c8eef-6b19-42d4-a810-6fa9651d789e",
                        "entry_id": "8d37346f-18f9-3f26-9c33-ca6033abab97",
                        "tags": [
                            "plural"
                        ],
                        "form": "boudoirs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "28861421-c412-3b38-8cf5-17e440503d52",
                        "entry_id": "8d37346f-18f9-3f26-9c33-ca6033abab97",
                        "glosses": [
                            "Petit salon, cabinet orné avec élégance, à l’usage particulier des dames, et dans lequel elles se retirent lorsqu’elles veulent être seules ou s’entretenir avec des personnes intimes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40c05edb-526d-47a4-b369-9e61508ad4d6",
                                "sense_id": "28861421-c412-3b38-8cf5-17e440503d52",
                                "text": "Hélène, revenue avec son père du boudoir dans le salon, écoutait attentivement le notaire, […]."
                            },
                            {
                                "example_id": "21909c30-a858-4c41-bef6-47cf9ab50528",
                                "sense_id": "28861421-c412-3b38-8cf5-17e440503d52",
                                "text": "Le Cardinal.. – Ce boudoir dont j’aperçois la porte entr’ouverte là-bas, c’est un petit paradis. Irai-je vous y attendre ?"
                            },
                            {
                                "example_id": "293732de-25e0-43ba-8e79-1e69b99f0ed1",
                                "sense_id": "28861421-c412-3b38-8cf5-17e440503d52",
                                "text": "Je suis un vieux boudoir plein de roses fanées,\nou gît tout un fouillis de modes surannées"
                            },
                            {
                                "example_id": "70482361-ca35-4455-a35c-c296f13a4eec",
                                "sense_id": "28861421-c412-3b38-8cf5-17e440503d52",
                                "text": "Ce boyard n'avait pas dû y mener une vie édifiante, car le domestique introduisit et laissa Mˡˡᵉ de Bernage dans un boudoir garni de divans circulaires et tapissé de glaces, qui aurait pu convenir à une horizontale de grande marque."
                            },
                            {
                                "example_id": "2d104658-9a9e-40f2-b5c8-7297f34b3dfb",
                                "sense_id": "28861421-c412-3b38-8cf5-17e440503d52",
                                "text": "C’était une grande femme intelligente et attentive, à qui je transmettais mon savoir à raison de trois leçons par semaine, vraie « philosophie dans le boudoir » puisque son boudoir était ma salle de classe."
                            },
                            {
                                "example_id": "54da3a9f-73ec-4939-bdcb-e0de452b0d74",
                                "sense_id": "28861421-c412-3b38-8cf5-17e440503d52",
                                "text": "C’était une grande femme intelligente et attentive, à qui je transmettais mon savoir à raison de trois leçons par semaine, vraie « philosophie dans le boudoir » puisque son boudoir était ma salle de classe."
                            }
                        ]
                    },
                    {
                        "sense_id": "0864e5bd-e167-3d71-8833-76b448dbc856",
                        "entry_id": "8d37346f-18f9-3f26-9c33-ca6033abab97",
                        "glosses": [
                            "Biscuit sec long, saupoudré de sucre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eab19b57-fccf-45d7-81fc-a7214732c1ea",
                                "sense_id": "0864e5bd-e167-3d71-8833-76b448dbc856",
                                "text": "Il y avait les vieilles, qu’on allait voir le dimanche après-midi avec les boudoirs et le flacon de goutte pour arroser le café."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "57faf12a-7ac8-474c-a314-0345713cb554",
                        "source_entry_id": "8d37346f-18f9-3f26-9c33-ca6033abab97",
                        "source_sense_description": "Petit salon de dame",
                        "target_lang_word": "boudoir",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boudoir",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                        "entry_id": "717bb79b-eff8-3783-8110-0780264a5a2d",
                                        "glosses": [
                                            "A woman's private sitting room, dressing room, or bedroom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6aa4864-6384-44c6-97c6-6a7e55abca6a",
                                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                                "text": "The Duchesse's boudoir was fitted up in a style of luxury utterly different from anything before familiar to the Carraras."
                                            },
                                            {
                                                "example_id": "3c441425-878f-4a60-8239-3118cea6129a",
                                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                                "text": "Dorcas, faithful to her “young gentlemen,” denied strenuously that it could have been John’s voice she heard, and resolutely declared, in the teeth of everything, that it was Mr. Inglethorp who had been in the boudoir with her mistress."
                                            },
                                            {
                                                "example_id": "3ace259c-de67-4f17-8a3b-aaf04785986d",
                                                "sense_id": "936e0365-47bb-3970-b61b-b531971e9527",
                                                "text": "I found her in her boudoir getting outside a dish of tea and a crumpet."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
