                        "glosses": [
                            "Habitant de la Papimanie, pays imaginaire habité par la cour du pape."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f81f42c-3696-443f-ac81-9cbf8f16275d",
                                "sense_id": "6b39bcf7-534e-3399-8805-decc8f422e24",
                                "text": "À nostre veue s’offrit la benoiste isle des Papimanes."
                            },
                            {
                                "example_id": "77db8086-9265-49f2-a60c-c055aefd6090",
                                "sense_id": "6b39bcf7-534e-3399-8805-decc8f422e24",
                                "text": "Rabelais disciple ou compère de Marot, de Villon et de la bonne vieille école facétieuse, ne paraît pas s’être consumé en regrets mélancoliques dans le pays des papimanes."
                            }
                        ]
                    },
                    {
                        "sense_id": "f210ab49-d4a5-368b-adc1-849b8086b269",
                        "entry_id": "174186ca-e662-3e72-8229-29a771308d54",
                        "glosses": [
                            "Papiste, partisan du pape, de son gouvernement spirituel et temporel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b7f1bb6-57b6-4120-bae4-49037f08afa6",
                                "sense_id": "f210ab49-d4a5-368b-adc1-849b8086b269",
                                "text": "Cet autre (Genoude) mentionne Polignac et Mirabeau. Un autre placé plus haut (Guizot), anglomane et papimane (au fond, le plâtre et l’argent)."
                            }
                        ]
                    }
