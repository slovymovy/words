                    "synonyms": [
                        "advantageous",
                        "helpful",
                        "useful",
                        "propitious"
                    ],
                    "antonyms": [
                        "unhelpful",
                        "unfavourable"
                    ],
                    "common_phrases": [
                        "favourable conditions",
                        "favourable terms",
                        "favourable outcome"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дающий преимущество или способствующий успеху.",
                        "zh": "提供优势或有助于某事成功。"
