            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9dc2f0e3-b897-3a9b-877c-b0b0851427c5",
                    "sense_definition": "deel uitmaken van een bepaalde groep, categorie of verzameling",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "lidmaatschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>behoort</w> tot de beste studenten van haar klas.",
                            "target_lang_translations": {
                                "en": "She <w>is among</w> the best students in her class.",
                                "ru": "Она <w>принадлежит</w> к числу лучших студентов своего класса."
                            }
                        },
                        {
                            "text": "Deze tradities <w>behoren</w> tot de oudste van het land.",
                            "target_lang_translations": {
                                "en": "These traditions <w>are among</w> the oldest in the country.",
                                "ru": "Эти традиции <w>относятся</w> к числу старейших в стране."
                            }
                        }
                    ],
                    "synonyms": [
                        "deel uitmaken van",
                        "vallen onder",
                        "horen bij",
                        "thuishoren"
                    ],
                    "common_phrases": [
                        "behoren tot de groep",
                        "behoren tot de mogelijkheden"
                    ],
                    "target_lang_definitions": {
                        "en": "To be part of a specific group, category, or collection.",
                        "ru": "Быть частью определенной группы, категории или коллекции."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "belong to",
                                "target_lang_sense_clarification": "to be a member of a group or category"
                            },
                            {
                                "target_lang_word": "be among",
                                "target_lang_sense_clarification": "to be included in a specific set of people or things"
                            },
                            {
                                "target_lang_word": "rank among",
                                "target_lang_sense_clarification": "to be classified as one of a certain quality"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "принадлежать к",
                                "target_lang_sense_clarification": "быть членом группы или категории"
                            },
                            {
                                "target_lang_word": "относиться к",
                                "target_lang_sense_clarification": "входить в состав определенного множества"
                            },
                            {
                                "target_lang_word": "входить в число",
                                "target_lang_sense_clarification": "быть одним из списка или группы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "742e2d2e-cd4b-348a-9baa-eaa74b69d3b6",
                    "sense_definition": "nodig of verplicht zijn volgens de regels van fatsoen of gebruik",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "verplichting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>behoort</w> je excuses aan te bieden als je een fout maakt.",
                            "target_lang_translations": {
                                "en": "You <w>ought to</w> apologize if you make a mistake.",
                                "ru": "Тебе <w>следует</w> извиниться, если ты совершаешь ошибку."
                            }
                        },
                        {
                            "text": "Dit <w>behoort</w> met een stemming gepaard te gaan volgens de statuten.",
                            "target_lang_translations": {
                                "en": "This <w>should</w> be accompanied by a vote according to the statutes.",
                                "ru": "Согласно уставу, это <w>должно</w> сопровождаться голосованием."
                            }
                        }
                    ],
                    "synonyms": [
                        "horen",
                        "dienen",
                        "moeten"
                    ],
                    "common_phrases": [
                        "zoals het behoort",
                        "behoren te doen"
                    ],
                    "traits": [
