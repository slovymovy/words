                "senses": [
                    {
                        "sense_id": "40e3dc8b-b854-34c2-a33e-d71d5881a55d",
                        "entry_id": "fa9c325a-00ff-3b3f-9bd9-ddd22e3e5a70",
                        "glosses": [
                            "de mate waarin men zichzelf belangrijk en waardevol vindt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d61d497d-f294-435b-9a7d-343d12d9ab01",
                                "sense_id": "40e3dc8b-b854-34c2-a33e-d71d5881a55d",
                                "text": "De vierde tenslotte is dat het fantaseren over, het plannen en het uitvoeren van de seksuele activiteiten ‘werken als een verdoving voor negatieve gevoelens zoals angst, stress, schaamte, eenzaamheid, boosheid of een lage zelfwaardering. Seks wordt een toevluchtsoord.’"
                            },
                            {
                                "example_id": "84c4c341-71db-4dc5-9d71-fb887c657768",
                                "sense_id": "40e3dc8b-b854-34c2-a33e-d71d5881a55d",
                                "text": "Tevens leren de patiënten nog zo veel mogelijk uit het leven zelf te halen en bijvoorbeeld niet onnodig in hun schulp te kruipen. Ze krijgen er meer positieve en minder negatieve emoties en meer zelfwaardering door, zegt initiatiefneemster Rose-Marie Dröes, hoogleraar psychosociale hulpverlening bij dementie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "252ddeb7-9e65-422b-8a10-447e1a27a69d",
                        "source_entry_id": "fa9c325a-00ff-3b3f-9bd9-ddd22e3e5a70",
                        "source_sense_id": "40e3dc8b-b854-34c2-a33e-d71d5881a55d",
                        "source_sense_description": "de mate waarin men zichzelf belangrijk en waardevol vindt",
                        "target_lang_word": "self-respect",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-respect",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                        "entry_id": "cc0eef96-8995-3716-8d12-a6f74a6ada3e",
                                        "glosses": [
                                            "The knowledge of one's own worth."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e99e21b8-c9ab-4d03-82ff-29321351e943",
                                                "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                                "text": "[…] he wished he had been a William Price, distinguishing himself and working his way to fortune and consequence with so much self-respect and happy ardour, instead of what he was!"
                                            },
                                            {
                                                "example_id": "66f750c9-14d7-441b-ab2b-7e3a1aed3788",
                                                "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                                "text": "In the little chaos of Pearl's character there might be seen emerging[…]an uncontrollable will—sturdy pride, which might be disciplined into self-respect—and a bitter scorn of many things which, when examined, might be found to have the taint of falsehood in them."
                                            },
                                            {
                                                "example_id": "ce5e24ad-a960-46b4-a042-86d56eb2bd15",
                                                "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                                "text": "Would any woman have behaved like that—if a man had said he didn’t want her? We’ve too much self-respect; we’re infinitely finer than they are."
                                            },
                                            {
                                                "example_id": "3b4e95d1-0628-4e41-8d30-da7ef8bc46b9",
                                                "sense_id": "45bb6b73-f497-3189-8ed3-d37dd1048fe6",
                                                "text": "“To hold Arrakis,” the Duke said, “one is faced with decisions that may cost one his self-respect.” He pointed out the window to the Atreides green and black banner hanging limply from a staff at the edge of the landing field. \"That honorable banner could come to mean many evil things.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8363168-f604-40d1-b66d-0f78f7e6be30",
                        "source_entry_id": "fa9c325a-00ff-3b3f-9bd9-ddd22e3e5a70",
                        "source_sense_id": "40e3dc8b-b854-34c2-a33e-d71d5881a55d",
                        "source_sense_description": "de mate waarin men zichzelf belangrijk en waardevol vindt",
                        "target_lang_word": "self-esteem",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "self-esteem",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9a8e6e16-b273-388c-a92a-31280dcb7c2a",
                                        "entry_id": "45ca33c5-bc37-37b2-994c-0e012f4a31b1",
                                        "glosses": [
                                            "Confidence in one's own worth; self-respect."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0daaea60-d618-45cb-82e8-5f6e56645e69",
                                                "sense_id": "9a8e6e16-b273-388c-a92a-31280dcb7c2a",
                                                "text": "American companies now put a great deal of effort into boosting their employees' self-esteem by handing out inflated job titles. Most likely, they think it also helps compensate for the longer hours, unpaid overtime and stagnant wages that have become standard. It doesn't."
                                            },
                                            {
                                                "example_id": "5295220a-f285-4c49-ac49-23368a82becd",
                                                "sense_id": "9a8e6e16-b273-388c-a92a-31280dcb7c2a",
                                                "text": "People with high self-esteem think they're more popular, charming, and socially skilled than other people, but objective studies find no difference."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
