                        "entry_id": "b71567d6-7450-3e83-ab32-7e25ba957e98",
                        "glosses": [
                            "породообразующий минерал, магнезиально-железистый силикат"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35d0e1b7-2bdf-42e5-a66d-9fb2232ec42c",
                                "sense_id": "499bdf68-6a4d-3d14-8772-598903f78740",
                                "text": "Материал этот исключительно свежий, даже оливин и сидеромелан обычно лишены признаков вторичных изменений."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11756b87-1b5e-4cf5-96df-417d442dcff4",
                        "source_entry_id": "b71567d6-7450-3e83-ab32-7e25ba957e98",
                        "source_sense_id": "499bdf68-6a4d-3d14-8772-598903f78740",
