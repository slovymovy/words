                    "sense_definition": "De temps en temps, à certains moments et pas à d'autres ; parfois.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "frequence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il m'arrive <w>quelquefois</w> de me promener au bord du fleuve en fin de journée.",
                            "target_lang_translations": {
                                "en": "I <w>sometimes</w> go for a walk by the river at the end of the day.",
                                "ru": "Мне <w>иногда</w> случается гулять на берегу реки в конце дня.",
                                "nl": "Ik ga <w>soms</w> aan het eind van de dag wandelen aan de oever van de rivier.",
                                "de": "<w>Manchmal</w> gehe ich am Ende des Tages am Flussufer spazieren.",
                                "pl": "Zdarza mi się <w>czasami</w> spacerować nad brzegiem rzeki pod koniec dnia.",
                                "it": "Mi capita <w>a volte</w> di passeggiare lungo il fiume alla fine della giornata.",
                                "cs": "<w>Občas</w> se mi stává, že se ke konci dne procházím po břehu řeky.",
                                "tr": "<w>Bazen</w> günün sonunda nehir kıyısında yürüyüşe çıktığım oluyor.",
                                "es": "<w>A veces</w> salgo a pasear por la orilla del río al final del día.",
                                "zh": "我<w>有时</w>会在傍晚去河边散步。"
                            }
                        },
                        {
                            "text": "Nous allons <w>quelquefois</w> au cinéma le mardi soir car les billets sont moins chers.",
                            "target_lang_translations": {
                                "en": "We <w>sometimes</w> go to the cinema on Tuesday evenings because tickets are cheaper.",
                                "ru": "Мы <w>иногда</w> ходим в кино по вторникам вечером, потому что билеты дешевле.",
                                "nl": "We gaan <w>soms</w> naar de bioscoop op dinsdagavond, want de kaartjes zijn goedkoper.",
                                "de": "Wir gehen dienstagabends <w>manchmal</w> ins Kino, weil die Karten günstiger sind.",
                                "pl": "<w>Czasami</w> chodzimy do kina we wtorki wieczorem, bo bilety są tańsze.",
                                "it": "Andiamo <w>qualche volta</w> al cinema il martedì sera, perché i biglietti costano meno.",
                                "cs": "<w>Občas</w> chodíme do kina v úterý večer, protože lístky jsou levnější.",
                                "tr": "Biletler daha ucuz olduğu için salı akşamları <w>bazen</w> sinemaya gidiyoruz.",
                                "es": "Vamos <w>a veces</w> al cine los martes por la noche, porque las entradas son más baratas.",
                                "zh": "我们周二晚上<w>有时</w>去看电影，因为票价比较便宜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "de temps à autre",
                        "de temps en temps",
                        "occasionnellement",
                        "parfois"
                    ],
                    "antonyms": [
                        "jamais"
                    ],
                    "target_lang_definitions": {
                        "en": "From time to time, at some moments but not others; sometimes.",
                        "ru": "Время от времени, в определённые моменты, но не всегда.",
                        "nl": "Van tijd tot tijd, op bepaalde momenten maar niet op andere.",
                        "de": "Von Zeit zu Zeit, zu bestimmten Zeitpunkten, aber nicht immer.",
                        "pl": "Od czasu do czasu, w niektórych chwilach, a w innych nie; czasami.",
                        "it": "Di tanto in tanto, in alcuni momenti e non in altri.",
                        "cs": "Občas, v některých chvílích, ale ne v jiných; někdy.",
                        "tr": "Zaman zaman, bazı anlarda ama başka anlarda değil; ara sıra.",
                        "es": "De vez en cuando, en algunos momentos y en otros no.",
                        "zh": "表示某件事在某些时候发生，而在另一些时候不发生，相当于有时候。"
