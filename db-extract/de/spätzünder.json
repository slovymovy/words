                "senses": [
                    {
                        "sense_id": "4ac5ea03-eab1-3a24-97f6-71df873249a2",
                        "entry_id": "8c65a5bf-ff09-3401-ad4a-1a5b2bacbad1",
                        "glosses": [
                            "Person mit verzögerter Entwicklung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e7754e85-6cb8-4e01-b6b6-4e8e30d987ca",
                                "sense_id": "4ac5ea03-eab1-3a24-97f6-71df873249a2",
                                "text": "„Im Laufsport sind Spätzünder keine Seltenheit: ‚Unsere Marathonanalysen zeigen, dass über 25 Prozent der befragten Läufer zwischen 50 bis 69 Jahren erst in den letzten fünf Jahren mit regelmäßigem Sport begonnen haben‘, sagt Dieter Leyk, Professor an der Deutschen Sporthochschule Köln.“"
                            },
                            {
                                "example_id": "abc21371-80d4-449f-8ae7-3236b9488340",
                                "sense_id": "4ac5ea03-eab1-3a24-97f6-71df873249a2",
                                "text": "„Man lebt vor sich hin, bis einem eines Tages auffällt, dass man ein totaler Spätzünder ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "88cada2c-2fb2-3548-b6e3-51a18707abbd",
                        "entry_id": "8c65a5bf-ff09-3401-ad4a-1a5b2bacbad1",
                        "glosses": [
                            "Person mit langsamer Auffassung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ed6f96e-68eb-4133-b418-127f5fac74e8",
                                "sense_id": "88cada2c-2fb2-3548-b6e3-51a18707abbd",
                                "text": "„Du meinst, ich bin ein Spätzünder. Ich hätte deine Witze eher verstehen oder unverschämter über sie lachen sollen?“"
                            },
                            {
                                "example_id": "b1caffe6-44c0-4ae8-838d-c229164f26a2",
                                "sense_id": "88cada2c-2fb2-3548-b6e3-51a18707abbd",
                                "text": "„Ottl und ein paar andere Spätzünder fingen zu murren an, weil sie beim Schreiben nicht mitkamen, doch die Vertretungslehrerin bemerkte nur kühl: […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
