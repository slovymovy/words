                        ],
                        "examples": [
                            {
                                "example_id": "2f9ef28c-eaaf-443e-bfe2-c53e3e4b54b8",
                                "sense_id": "1787a8e8-9794-3294-9fcc-986a199b0c5c",
                                "text": "Il n’a pas réchauffé ce cadavre hébété / Où coule au lieu de sang l’eau verte du Léthé.",
                                "translation": "The Flowers of Evil",
                                "english": "The Flowers of Evil"
                            },
                            {
                                "example_id": "a76e6afa-3f57-4be4-b86a-56dfe845ae65",
                                "sense_id": "1787a8e8-9794-3294-9fcc-986a199b0c5c",
                                "text": "Ananké plante l'image dans l'âme comme une graine en terre. Puis l'âme est plongée dans le Léthé, le fleuve de l'oubli."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
