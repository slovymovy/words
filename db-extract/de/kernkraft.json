                        "sense_id": "707bf4cb-1e8c-3346-ba35-b18bed744571",
                        "entry_id": "c67a5417-81de-3414-b166-5af6045848f3",
                        "glosses": [
                            "die Erzeugung von Energie durch die Freisetzung der im Atomkern befindlichen Energie"
                        ],
                        "tags": [
                            "nur Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "a2c602f4-bef9-41c9-84e2-d46944f10930",
                                "sense_id": "707bf4cb-1e8c-3346-ba35-b18bed744571",
                                "text": "Ein Teil des Stroms wird aus Kernkraft gewonnen."
                            },
                            {
                                "example_id": "2bccea88-19fe-4f13-bfe1-1308443e0bf7",
                                "sense_id": "707bf4cb-1e8c-3346-ba35-b18bed744571",
                                "text": "„Für den Münchner Soziologen Ulrich Beck, der mir Fukushima den »Sicherheitsmythos« der Kernkraft zerbröseln sieht, hat Töpfer sich besonders eingesetzt.“"
                            },
                            {
                                "example_id": "a4363010-7761-4225-b70d-e0e416d10d3b",
                                "sense_id": "707bf4cb-1e8c-3346-ba35-b18bed744571",
                                "text": "„Die deutsche Einstellung zur Kernkraft zum Beispiel begann in den 80ern und wurde von Generation zu Generation weitergegeben, an den Stammtischen, in den Kantinen, Mensen, Wohnzimmern, Schulen, in den Medien und auf der Straße, wie eine unerklärliche Mode oder der merkwürdige Brauch, am Heiligen Abend Bockwürstchen zu essen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
