                                    {
                                        "sense_id": "66b2d7a1-9739-3237-8776-c5cf6382f490",
                                        "entry_id": "12241780-2f9c-3862-8c63-90adffe717ff",
                                        "glosses": [
                                            "Purée à base d’avocats, d’oignons, de piment, de coriandre, de tomates et de citron vert ; il sert d’accompagnement pour tout genre de plat mexicain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e782c829-c429-4ae8-a9d4-54898979b31b",
                                                "sense_id": "66b2d7a1-9739-3237-8776-c5cf6382f490",
                                                "text": "Les fonds devaient être bas, le couscous avait cédé devant le guacamole et les chips piquantes, l’arak s’était commué en sangria ponceau où nageaient, flapies comme des papillons morts, des rondelles d’orange."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
