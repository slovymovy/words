                        "entry_id": "74f5376f-c1f3-3c2f-95da-24e2c9febf4c",
                        "glosses": [
                            "Prendre en compte ; prêter attention à."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "81661d76-63a7-48f9-9135-ef6a97d7eb05",
                                "sense_id": "fc684187-3714-385c-914f-f6ca664b1734",
                                "text": "Pourquoi tu cala pas ceux qui veulent ton bien ? Pourquoi tu t’attaches à tous ceux qui t’ignorent ?"
                            },
                            {
                                "example_id": "c3a4de6c-1e12-4c12-9438-7fcafccbb2bc",
                                "sense_id": "fc684187-3714-385c-914f-f6ca664b1734",
                                "text": "Dans la rue personne me cala / Les yeux rouges et le teint blafard / J'ai foutu le bordel dans Paname"
                            }
                        ]
                    }
                ],
