                                            {
                                                "example_id": "28956bff-0f07-41d5-a8b2-451088a48718",
                                                "sense_id": "ea6f2097-831f-35c6-aaf3-eb3302e3ca63",
                                                "text": "嫗又曰：“汝姊在吾懷，呱呱而泣，娘以指扣門扉曰：‘兒寒乎？欲食乎？’吾從板外相爲應答。”",
                                                "translation": "“"
                                            },
                                            {
                                                "example_id": "b178ef4c-b7b9-40a2-9c15-fb1931e8c5b7",
                                                "sense_id": "ea6f2097-831f-35c6-aaf3-eb3302e3ca63",
                                                "text": "妪又曰：“汝姊在吾怀，呱呱而泣，娘以指扣门扉曰：‘儿寒乎？欲食乎？’吾从板外相为应答。”",
                                                "translation": "“"
                                            },
                                            {
                                                "example_id": "eaf107c3-c8bf-4805-9ab9-2dcb839a548f",
                                                "sense_id": "ea6f2097-831f-35c6-aaf3-eb3302e3ca63",
                                                "text": "嬰兒墮地，其泣也呱呱；及其老死，家人環繞，其哭也號啕。"
                                            },
                                            {
                                                "example_id": "2dc3278e-fcf9-4ef9-b7bd-13d1e8955e92",
                                                "sense_id": "ea6f2097-831f-35c6-aaf3-eb3302e3ca63",
                                                "text": "婴儿堕地，其泣也呱呱；及其老死，家人环绕，其哭也号啕。"
                                            }
                                        ]
                                    }
                                ]
