                ],
                "senses": [
                    {
                        "sense_id": "098be956-ae88-32ff-81a2-ba9245f5f49e",
                        "entry_id": "649e425d-f6a5-3320-aad9-a75161ca7a2f",
                        "glosses": [
                            "In a grim manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798a7a6f-8b65-4ca6-80ca-44792b90cf56",
                                "sense_id": "098be956-ae88-32ff-81a2-ba9245f5f49e",
                                "text": "He looked round and shouted grimly, \"As soon as the gate is opened, you go out there - running.\""
                            },
                            {
                                "example_id": "67f1addd-a7b9-4de1-809d-e0032077472c",
                                "sense_id": "098be956-ae88-32ff-81a2-ba9245f5f49e",
                                "text": "I looked out my window / The cloud was grimly forming / Waiting for the rain I saw / The one dark cloud forming"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a3948c6-399a-4f00-b8c5-55f755a24f34",
                        "source_entry_id": "649e425d-f6a5-3320-aad9-a75161ca7a2f",
                        "source_sense_id": "098be956-ae88-32ff-81a2-ba9245f5f49e",
                        "source_sense_description": "in a grim manner",
                        "target_lang_word": "sinistrement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinistrement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                        "entry_id": "dd0d1698-7535-332b-8ebb-94be0ae13af6",
                                        "glosses": [
                                            "D’une manière sinistre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1359152-9ee3-4a1b-8969-d97c0fa14687",
                                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                                "text": "Leurs yeux sinistrement étincellent dans l’ombre,"
                                            },
                                            {
                                                "example_id": "ddf7cc9d-c6e7-4017-b7cd-4e50d8cba8b7",
                                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                                "text": "La chaloupe démarrée, on hissa les voiles dont les drisses crièrent sinistrement au long des mâts, […]."
                                            },
                                            {
                                                "example_id": "063e9ba6-2e11-4e12-b0f6-54476c3b79fe",
                                                "sense_id": "5f7dca27-1482-363b-a5d4-47f171ca0574",
                                                "text": "Le chantier, cette nuit-là, ne se creusait pas sinistrement comme par les nuits pluvieuses ; éclairé de larges nappes de lumière blanche, il s’étendait, dans le silence et l’immobilité du froid, avec une mélancolie douce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6acbbb1b-fcbd-3455-ba24-1fa296bacce4",
                                        "entry_id": "dd0d1698-7535-332b-8ebb-94be0ae13af6",
                                        "glosses": [
                                            "D'une manière pessimiste."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80bd2024-1b02-4405-8bb3-de3c140c7e36",
                                                "sense_id": "6acbbb1b-fcbd-3455-ba24-1fa296bacce4",
                                                "text": "En interprétant sinistrement de certaines actions…."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
