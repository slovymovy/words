                    {
                        "form_id": "75bac603-0b3d-4505-bfcf-7091373ce458",
                        "entry_id": "94cc78e4-f916-3589-b5cb-9632af684d7e",
                        "tags": [
                            "singular"
                        ],
                        "form": "ве́рмуту"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "accf4f60-6dfa-31c2-b4b3-de68bfdf801a",
                        "entry_id": "94cc78e4-f916-3589-b5cb-9632af684d7e",
                        "glosses": [
                            "гастрон. виноградное вино с настоями из трав"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1c0c178-0aee-42a2-a5e8-011c8152c3fc",
                                "sense_id": "accf4f60-6dfa-31c2-b4b3-de68bfdf801a",
                                "text": "Говорили о погоде, о Марсели, о кораблях. Я заказал себе вермут с касиссом. Дама спросила тот же аперитив."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0e75e5a0-6507-499a-93a0-ad47cacb4baa",
                        "source_entry_id": "94cc78e4-f916-3589-b5cb-9632af684d7e",
                        "source_sense_id": "accf4f60-6dfa-31c2-b4b3-de68bfdf801a",
                        "target_lang_word": "vermouth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermouth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3193ae0-b453-3ee8-a060-ba8328571a13",
                                        "entry_id": "bd6cf3ed-8e1c-3e5d-99bf-40b8d758acc3",
                                        "glosses": [
                                            "A dry, or sweet apéritif wine flavored with aromatic herbs, and often used in mixed drinks."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae975d19-78ea-4990-8873-bea67b5244ef",
                                                "sense_id": "b3193ae0-b453-3ee8-a060-ba8328571a13",
                                                "text": "He gazed around until on the lid of a spinet he spotted a promising collection of bottles, gin, whiskey, vermouth and sherry, mixed with violin bows, a flute, a toppling pile of books, six volumes of Grove's Dictionary mingled with paperback thrillers, a guitar without any strings, a pair of binoculars, a meerschaum pipe and a jar half-full of wasps and apricot jam."
                                            },
                                            {
                                                "example_id": "470b9690-68a5-4428-838e-09822f9641c4",
                                                "sense_id": "b3193ae0-b453-3ee8-a060-ba8328571a13",
                                                "text": "Vermouth originated in the 18th century, when wine growers in the foothills of the French and Italian Alps developed a method of enhancing the taste of sour or uncompromising wines with the infusion of a variety of sweeteners, spices, herbs, roots, seeds, flowers, and peel."
                                            },
                                            {
                                                "example_id": "a029dcdb-0a69-43eb-8cc8-4e67449acfd5",
                                                "sense_id": "b3193ae0-b453-3ee8-a060-ba8328571a13",
                                                "text": "Earlier this year while in Madrid, I fell prey to what the Spanish call la hora del vermut, the vermouth hour, a break in the day for a glass, generally before eating."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "560b140c-d562-3738-bbd7-72767912f258",
                                        "entry_id": "bd6cf3ed-8e1c-3e5d-99bf-40b8d758acc3",
                                        "glosses": [
                                            "A serving of vermouth."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1974df4f-248b-4081-ba83-13519dcbc31b",
                                                "sense_id": "560b140c-d562-3738-bbd7-72767912f258",
                                                "text": "As we sat over our vermuths he glorified the Company’s business, and by-and-by I expressed casually my surprise at him not going out there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "654b5a9d-6c98-473d-81a1-c47b9ec6a723",
                        "source_entry_id": "94cc78e4-f916-3589-b5cb-9632af684d7e",
                        "source_sense_id": "accf4f60-6dfa-31c2-b4b3-de68bfdf801a",
                        "target_lang_word": "Wermutwein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wermutwein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3c1f588d-f47f-305b-b1af-9310f79ba89f",
                                        "entry_id": "d781217c-80bc-3f16-8c01-2497dbc5ac9f",
                                        "glosses": [
                                            "Wein mit Wermut und anderen Ingredienzien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "590dc95a-d8ee-4c72-ada7-aa9a5651ee48",
                                                "sense_id": "3c1f588d-f47f-305b-b1af-9310f79ba89f",
                                                "text": "„Die Alte reichte ihr als Arznei zwei große schwarze Pillen, die Frau Mondtraut mit Wermutwein nehmen sollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "437ea03c-223f-4f49-a420-9e39a95f7347",
                        "source_entry_id": "94cc78e4-f916-3589-b5cb-9632af684d7e",
                        "source_sense_id": "accf4f60-6dfa-31c2-b4b3-de68bfdf801a",
                        "target_lang_word": "wermut",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wermut",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "b710ee93-3c57-3099-935f-7e97bf6afbec",
                                        "entry_id": "b4b4891d-7cc6-3a96-9fde-2a876c6da083",
                                        "glosses": [
                                            "wino wzmacniane aromatyzowane ziołami i korzeniami"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d4a4608-3298-46f9-bca9-e26169a36498",
                        "source_entry_id": "94cc78e4-f916-3589-b5cb-9632af684d7e",
                        "source_sense_id": "accf4f60-6dfa-31c2-b4b3-de68bfdf801a",
                        "target_lang_word": "vermouth",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vermouth",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                                        "entry_id": "c47b4390-82e4-302b-ab33-a067dc2ccf2b",
                                        "glosses": [
                                            "Vin blanc dans lequel on a fait infuser des plantes amères, toniques et aromatiques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be24610f-257c-47bb-af80-e1a654907e4f",
                                                "sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                                                "text": "Je leur dis : « Vous ne passerez pas devant chez nous sans prendre un joyeux vermouth. Il est rustique, mais pas trop mauvais.\n— Il ferait beau voir, — répliqua Vivier, — qu’on refusât un vermouth par un temps pareil ! »"
                                            },
                                            {
                                                "example_id": "98b9c8a8-ebba-466b-bf8c-63c06b052259",
                                                "sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                                                "text": "– Elle n’a qu’à ne pas se marier ! Pour ce qu’elle épouse !… Un type qui sent le vermouth ! D’abord, elle a toujours vécu sans nous, elle n’a pas davantage besoin de nous pour se marier !"
                                            },
                                            {
                                                "example_id": "d4919930-e85c-4da6-8a0a-f2668d4ff1ae",
                                                "sense_id": "94b2d5d4-465b-3163-8bd6-f71bf091cb1a",
                                                "text": "« Et qu’est-ce que je lui sers, au jeune homme ? » Papa dit : « Un petit turin ». Je bois mon dé à coudre de vermouth, à petites gorgées, les yeux fermés pour bien sentir le goût."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
