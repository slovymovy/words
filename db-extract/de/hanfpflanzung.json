                "senses": [
                    {
                        "sense_id": "1ca57905-d436-33a8-ac6c-c0c1e18d13a3",
                        "entry_id": "33a6903e-8741-3a70-bd47-1b37edac8b4d",
                        "glosses": [
                            "Fläche, auf der Hanf angepflanzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94462167-38c6-405b-9f54-f5734c8ca7e1",
                                "sense_id": "1ca57905-d436-33a8-ac6c-c0c1e18d13a3",
                                "text": "„Mehrere kleine Hanfpflanzungen hat die Polizei bei einem Hubschrauberrundflug in der Region Emmendingen aufgespürt.“"
                            },
                            {
                                "example_id": "330c69e4-f759-4c38-8ce1-10aeaeb7c6e9",
                                "sense_id": "1ca57905-d436-33a8-ac6c-c0c1e18d13a3",
                                "text": "„Es ging um eine Hanfpflanzung im Garten und auf dem Balkon eines Einfamilienhauses in Friedrichshafen.“"
                            },
                            {
                                "example_id": "cbfc3f1e-19c8-4227-a4cb-c53264835072",
                                "sense_id": "1ca57905-d436-33a8-ac6c-c0c1e18d13a3",
                                "text": "„Die Beamten stießen in dem Gebäude auf die Hanfpflanzung.“"
                            },
                            {
                                "example_id": "7615a6b3-a4ac-4b99-b205-8f21b969e926",
                                "sense_id": "1ca57905-d436-33a8-ac6c-c0c1e18d13a3",
                                "text": "„Laut Gebietsstatistik wurden 1987 auf 2500 Hektar illegale Hanfpflanzungen festgestellt und vernichtet, 1988 waren es bis September 2000 Hektar.“"
                            },
                            {
                                "example_id": "0b0c20d0-35eb-4cef-99a6-cacc4b33ef9e",
                                "sense_id": "1ca57905-d436-33a8-ac6c-c0c1e18d13a3",
                                "text": "„Outdoor-Growing dient ebenso wie das Indoor-Growing der Tarnung einer illegalen Hanfpflanzung und verringert das Risiko, dass der Nutzer mit entdeckten Pflanzen in Verbindung gebracht wird. Es ist weniger kostenintensiv als Indoor-Growing.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
