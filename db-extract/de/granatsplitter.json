                ],
                "senses": [
                    {
                        "sense_id": "c99a8ea7-eb37-338f-b19d-804b4c52b47a",
                        "entry_id": "152fe656-a387-372f-9c27-9cc87fa5117d",
                        "glosses": [
                            "Bruchstück einer Granate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f67a6441-44c3-451f-82ae-34580a5b243d",
                                "sense_id": "c99a8ea7-eb37-338f-b19d-804b4c52b47a",
                                "text": "„Aus seinem Soldbuch geht hervor, dass er in den kommenden zwei Jahren an drei Gefechten teilnimmt und in der rechten Brust durch einen Granatsplitter verwundet wird…“"
                            },
                            {
                                "example_id": "2427726b-3437-4fd7-be2d-1726ca2a40ae",
                                "sense_id": "c99a8ea7-eb37-338f-b19d-804b4c52b47a",
                                "text": "„Ein Regen von Granatsplittern prasselt auf unser Dach.“"
                            },
                            {
                                "example_id": "e0acbf5b-e010-480e-a384-97d9a9c941e7",
                                "sense_id": "c99a8ea7-eb37-338f-b19d-804b4c52b47a",
                                "text": "„Manfred schrieb auch an unbekannte Soldaten, der kriegte Granatsplitter geschickt und einen Beutel Buchweizen.“"
                            },
                            {
                                "example_id": "dad97acb-499e-41cd-b9e8-2d55fd59d3b7",
                                "sense_id": "c99a8ea7-eb37-338f-b19d-804b4c52b47a",
                                "text": "„Die Granatsplitter waren das Schönste, was man sich ausdenken konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
