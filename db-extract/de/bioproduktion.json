                ],
                "senses": [
                    {
                        "sense_id": "140ea589-9599-37cd-85b8-5c3862807067",
                        "entry_id": "7299318e-e4e9-3fc6-b3af-413c7580e9cb",
                        "glosses": [
                            "ökologische, umweltfreundliche Herstellung von Nahrungsmitteln und anderen Produkten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2495d885-757d-479b-9669-2abaa6ebfaea",
                                "sense_id": "140ea589-9599-37cd-85b8-5c3862807067",
                                "text": "„Am besten eignen sich ätherische Öle aus Bioproduktion, doch die haben natürlich auch ihren Preis.“"
                            },
                            {
                                "example_id": "02522277-2a3a-43b5-a661-7c80690304f0",
                                "sense_id": "140ea589-9599-37cd-85b8-5c3862807067",
                                "text": "„Ferner strebt das benachbarte Königreich Bhutan im Himalaya ebenfalls hundert Prozent Bioproduktion an.“"
                            },
                            {
                                "example_id": "2b133bc7-4a18-4476-a0d6-ef864e8a21a4",
                                "sense_id": "140ea589-9599-37cd-85b8-5c3862807067",
                                "text": "„Durch die Vereisung brach die Bioproduktion weitgehend zusammen, und die Verwitterungsrate wurde reduziert.“"
                            },
                            {
                                "example_id": "015a410c-0344-43db-b76b-64d0c65ca810",
                                "sense_id": "140ea589-9599-37cd-85b8-5c3862807067",
                                "text": "„Mit zunehmender Erwärmung steigt die Bioproduktion, was den pH-Pegel dort senkt.“"
                            },
                            {
                                "example_id": "1db00a27-869d-4ec0-9b9c-b3b6647414c2",
                                "sense_id": "140ea589-9599-37cd-85b8-5c3862807067",
                                "text": "„In Umeå, einer großen Universitätsstadt im Norden Schwedens, liegt der Schwerpunkt auf der Bioproduktion für die industrielle Nutzung.“"
                            },
                            {
                                "example_id": "891b1d6b-aef1-43b3-b2af-decd4fc56cf7",
                                "sense_id": "140ea589-9599-37cd-85b8-5c3862807067",
                                "text": "„Auf der Terrasse mit Blick ins Mölltal tischt Hüttenwirt Wolfgang frischen Joghurt und Apfelsaft aus Bioproduktion, Suppen und Kuchen auf.“"
                            },
                            {
                                "example_id": "51ff064c-441e-4860-b697-ed3c9619e216",
                                "sense_id": "140ea589-9599-37cd-85b8-5c3862807067",
                                "text": "„Mit dem Aufschwung der Bioproduktion von Nahrungsmitteln beginnt deutschlandweit eine Besinnung auf den Schlesier Robert Oettel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
