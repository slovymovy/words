                "senses": [
                    {
                        "sense_id": "04a65044-a245-3d76-961f-7396a089b52d",
                        "entry_id": "7700be77-40ee-37f8-b508-57cbadf7d913",
                        "glosses": [
                            "Initiatorin, Anstifterin"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af6d7380-e4d3-4f42-bff5-e89855dc792d",
                                "sense_id": "04a65044-a245-3d76-961f-7396a089b52d",
                                "text": "„Die neu angestellte Stationsleiterin erwies sich dabei als engagierte Proponentin der Professionalisierung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a5635fd4-e820-37f3-9616-2a72e35716ee",
                        "entry_id": "7700be77-40ee-37f8-b508-57cbadf7d913",
                        "glosses": [
                            "Wortführerin (wird bei Disputationen beziehungsweise in der dialogischen Logik im Kontext von Dialogen und Dialogverläufen verwendet, der Proponent bezeichnet denjenigen Partner eines Dialogs, der das Spiel eröffnet und eine Behauptung aufstellt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2991d673-5fd0-43c5-8513-8b438a34b23f",
                                "sense_id": "a5635fd4-e820-37f3-9616-2a72e35716ee",
                                "text": "„Die Proponentin wählt ihre Argumentationsstrategie als erste, ohne in jedem Fall zu wissen, welche Strategie der Opponent als Antwort auf ihr Argument verfolgen wird.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "32c2f8a6-1baf-3b08-a260-8ef3524a4bab",
                        "entry_id": "7700be77-40ee-37f8-b508-57cbadf7d913",
                        "glosses": [
                            "veraltet beziehungsweise Antragstellerin"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "81bf511b-36fe-4c40-8329-24fd5ca13510",
                                "sense_id": "32c2f8a6-1baf-3b08-a260-8ef3524a4bab",
                                "text": "Die Proponentin zog noch am selben Tag ihren Antrag wieder zurück."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
