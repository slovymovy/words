                {
                    "sense_id": "4a5e2f7f-ca44-365b-b840-2518eb591730",
                    "sense_definition": "Een behendige of vermakelijke handeling, vaak uitgevoerd om anderen te amuseren of te verbazen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "truc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De goochelaar liet een fantastisch <w>kunstje</w> met kaarten zien.",
                            "target_lang_translations": {
                                "en": "The magician showed a fantastic card <w>trick</w>."
                            }
                        },
                        {
                            "text": "Onze hond kan een leuk <w>kunstje</w> doen zoals pootjes geven.",
                            "target_lang_translations": {
                                "en": "Our dog can do a nice <w>trick</w> like giving a paw."
                            }
                        }
                    ],
                    "synonyms": [
                        "truc",
                        "foefje",
                        "toer"
                    ],
                    "common_phrases": [
                        "een kunstje vertonen",
                        "een nieuw kunstje"
                    ],
                    "target_lang_definitions": {
                        "en": "A clever or entertaining act, often performed to amuse or amaze others."
                    },
                    "translations": {
