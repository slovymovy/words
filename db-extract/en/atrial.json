                        "entry_id": "67920a16-82aa-35d4-bdec-faed4a6f6cc2",
                        "glosses": [
                            "Of or pertaining to an atrium, especially the atrium of the heart."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0bcc5e9e-754b-49ef-b59f-5c960f075087",
                                "sense_id": "64bc56b0-8f40-3002-855d-8540d5496986",
                                "text": "The most common type of irregular heartbeat is atrial fibrillation or AFib. It is estimated that between three and six million people in the United States have AFib."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5f0db799-2b3e-47d6-9aa6-1311a6f6b562",
