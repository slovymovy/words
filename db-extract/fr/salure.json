        "fr-extract.jsonl": [
            {
                "entry_id": "cf0eaf10-f96a-3e20-813b-3e55701a9fbc",
                "word": "salure",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6cbe7a2e-2db7-4372-917b-0f6bdccf0b95",
                        "entry_id": "cf0eaf10-f96a-3e20-813b-3e55701a9fbc",
                        "tags": [
                            "plural"
                        ],
                        "form": "salures"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                        "entry_id": "cf0eaf10-f96a-3e20-813b-3e55701a9fbc",
                        "glosses": [
                            "Caractère de ce qui est salé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc32ebf3-07b7-474f-ac53-eb1f75d1c41b",
                                "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                "text": "La salure en est beaucoup plus forte que celle de la mer, et elle produit sur les lèvres l’effet d’une forte solution d’alun."
                            },
                            {
                                "example_id": "a44c0d1d-b56b-4ab5-8245-f80ab23d74f8",
                                "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                "text": "En 1601, 1620, 1627, 1677 le parlement de Paris la renouvelait par des arrêts successifs et fixait le prix du langueyage et la responsabilité des langueyeurs ; mais il autorisait, dans le premier de ces arrêts, la vente de la viande ladre après une salure de quarante jours."
                            },
                            {
                                "example_id": "d54b0b0a-e15d-4884-9c5f-03b9f7ca24c1",
                                "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                "text": "Des femmes aux pieds blancs, un râteau à la main, ramassent les algues sèches ; le vent, avec la salure de la mer, leur arrive au visage, apportant une roulante harmonie de bruissements et une poussière d’écume."
                            },
                            {
                                "example_id": "7ef9b03b-055f-44aa-8c77-9df111f16568",
                                "sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                                "text": "La poussière du Vieux-Port, chargée de salures, éparpille un relent lointain de choses épicées."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd29be78-b794-4c0e-933f-117fd3d01225",
                        "source_entry_id": "cf0eaf10-f96a-3e20-813b-3e55701a9fbc",
                        "source_sense_id": "10594436-4961-3046-af1b-ce64d6a50bcd",
                        "target_lang_word": "zoutheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zoutheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "35d2f0e9-9788-3cfd-81c8-35724c430aee",
                                        "entry_id": "94ef1d75-78f4-3973-bfc7-78e40c7dc185",
                                        "glosses": [
                                            "het zilt zijn van iets; hoe zout iets is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fabcea6f-3bae-4ab6-b41c-c79e48f61e74",
                                                "sense_id": "35d2f0e9-9788-3cfd-81c8-35724c430aee",
                                                "text": "Slauerhoff, die Portugees kon lezen, had echter ook belangstelling voor andere Portugese auteurs. Zoals voor de zwaarmoedige dichter António Nobre. Die stelde dat de zoutheid van de zee het niet haalde bij de ziltheid van zijn tranenplas. Hij noemde de doodgraver de beste van alle bouwmeesters."
                                            },
                                            {
                                                "example_id": "f4acd803-2283-4c27-b753-90167179a99b",
                                                "sense_id": "35d2f0e9-9788-3cfd-81c8-35724c430aee",
                                                "text": "De Bleu d'Auvergne kan ook vervangen worden door bijvoorbeeld Roquefort, Fourme d'Ambert, Bleu de Sassenage of de vrij scherpe Italiaanse Gorgonzola piccante (tegenwoordig regelmatig gesignaleerd in Nederland). Pas wel de toe te voegen hoeveelheid boter aan de `zoutheid' van de kaas aan want die verschilt per soort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
