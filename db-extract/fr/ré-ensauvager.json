                "senses": [
                    {
                        "sense_id": "eb7242ac-31d4-3200-b40e-9ac434f6fa6c",
                        "entry_id": "c520d379-d0f6-31dd-9628-abd20dbe61bd",
                        "glosses": [
                            "Redonner un caractère sauvage à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f62e403-ce7d-4b94-85ec-6ceac49fb992",
                                "sense_id": "eb7242ac-31d4-3200-b40e-9ac434f6fa6c",
                                "text": "Une des propositions du parti animaliste consiste à intégrer des territoires ré-ensauvagés à la Trame verte et bleue, notamment parmi les territoires qui ne sont pas habités."
                            },
                            {
                                "example_id": "f9ef2f95-cac9-49e1-9752-c2ad9dba9437",
                                "sense_id": "eb7242ac-31d4-3200-b40e-9ac434f6fa6c",
                                "text": "La planète serait-elle en train de se \"ré-ensauvager\"?"
                            },
                            {
                                "example_id": "0599f978-4fb2-4579-a6ec-d682663fb144",
                                "sense_id": "eb7242ac-31d4-3200-b40e-9ac434f6fa6c",
                                "text": "Masson soutient que ce pourrait être le cas des chevaux, qui possèdent manifestement les traits physiologiques et psychologiques requis pour vivre à l’écart des êtres humains et pour se « ré-ensauvager » avec succès."
                            }
                        ]
                    }
