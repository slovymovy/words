                    {
                        "translation_id": "4f361e18-ddbc-48c9-acaf-282c342ea695",
                        "source_entry_id": "cb038cea-6ae1-3b77-96c7-69d247f7049f",
                        "source_sense_id": "1cce6204-c9bb-3872-9b5b-0a07da1b3178",
                        "source_sense_description": "een stad in Noordwest-Italië",
                        "target_lang_word": "Gênes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gênes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e7911e04-404b-337c-a2e7-313462cdaa10",
                                        "entry_id": "86d16e8c-e95c-352c-b5de-2af24f09151b",
                                        "glosses": [
                                            "Commune et ville d’Italie de la région de Ligurie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf830ae6-3bc3-496b-8486-28acbd60b93f",
                                                "sense_id": "e7911e04-404b-337c-a2e7-313462cdaa10",
                                                "text": "Le parlement de Paris, les parlements de province étaient chargés de cette immense perruque à laquelle le président Diderot ne pouvait s’accoutumer ; et M. de Brosses lui-même qui se riait si bien dans sa correspondance des vastissimes perruques carrées sous lesquelles étaient cachés le doge de Gênes et ses sénateurs, s’était vu forcé de s’en affubler comme les autres, quand il fut devenu président au parlement de Dijon."
                                            },
                                            {
                                                "example_id": "4425964f-60d4-4cd4-ac1b-92e033db49f6",
                                                "sense_id": "e7911e04-404b-337c-a2e7-313462cdaa10",
                                                "text": "En fait, Gênes est jalouse de notre prospérité croissante, et de la puissance que nous sommes en train d'acquérir sur les mers."
                                            },
                                            {
                                                "example_id": "5f5c155d-8207-4bda-865c-fbb38a84a685",
                                                "sense_id": "e7911e04-404b-337c-a2e7-313462cdaa10",
                                                "text": "On avait loué une petite maison dans un village de Ligurie, San Rocco, entre Portofino et Gênes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9dd21dd3-fb81-3286-adf5-2da399fabd8e",
                                        "entry_id": "86d16e8c-e95c-352c-b5de-2af24f09151b",
                                        "glosses": [
                                            "Ancien département français d’Italie ayant existé de 1805 à 1814 et dont le chef-lieu était Gênes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
