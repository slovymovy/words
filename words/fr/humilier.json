    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9879e13a-9b9f-334d-8f99-367f60f83b59",
                    "sense_definition": "Blesser profondément une personne dans sa fierté, son amour-propre ou sa dignité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "blessure_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur ne doit jamais <w>humilier</w> un élève devant toute la classe."
                        },
                        {
                            "text": "Cette défaite cuisante a profondément <w>humilié</w> l'équipe locale lors de la finale."
                        }
                    ],
                    "synonyms": [
                        "rabaisser",
                        "mortifier"
                    ],
                    "antonyms": [
                        "valoriser",
                        "flatter"
                    ],
                    "common_phrases": [
                        "humilier publiquement",
                        "humilier son adversaire"
                    ]
                },
                {
                    "sense_id": "e5612ff6-bb99-33d8-a29b-dfeb17f44247",
                    "sense_definition": "Rendre humble ou soumettre, en particulier devant une autorité morale ou divine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "humilite_soumission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le moine choisit de s'<w>humilier</w> par la prière et le jeûne quotidien."
                        },
                        {
                            "text": "Ce souverain puissant refuse d'<w>humilier</w> son orgueil devant les exigences du roi voisin."
                        }
                    ],
                    "synonyms": [
                        "abaisser",
                        "soumettre"
                    ],
                    "antonyms": [
                        "exalter",
                        "élever"
                    ],
                    "common_phrases": [
                        "humilier son orgueil"
                    ]
                },
                {
                    "sense_id": "fdc80d69-b31a-350a-8e9f-ec8115df2318",
                    "sense_definition": "Faire paraître quelque chose comme médiocre ou inférieur en le surpassant nettement.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "depassement_comparaison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'éclat luxueux de ce palais semblait <w>humilier</w> les humbles demeures du village environnant."
                        },
                        {
                            "text": "Sa robe éblouissante semblait <w>humilier</w> les toilettes plus modestes des autres invitées."
                        }
                    ],
                    "synonyms": [
                        "éclipser",
                        "ternir"
                    ],
                    "antonyms": [
                        "rehausser"
                    ]
                }
            ]
        }
    ]
}