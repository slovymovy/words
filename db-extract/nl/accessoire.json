                                "target_senses": [
                                    {
                                        "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                        "entry_id": "daaee4b8-a05c-30be-bd48-405d55f3eedf",
                                        "glosses": [
                                            "modisches Zubehör, besonders zur Kleidung (Schmuck, Gürtel und so weiter)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e24216-6616-4b73-932e-946f0cda781e",
                                                "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                                "text": "Dabei handelt es sich beim Seidentuch um ein enorm anspruchsvolles Accessoire."
                                            },
                                            {
                                                "example_id": "18143bff-eab7-4c7e-bcc5-83dbb5dd7e70",
                                                "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                                "text": "Alles, was Frauen so mit sich herumtragen, ist ja in erster Linie Accessoire und wird nicht an seiner Funktionalität gemessen, sondern nach modischen Kriterien beurteilt."
                                            },
                                            {
                                                "example_id": "12ffcde3-992d-4146-a48d-ae1e115e6c3d",
                                                "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                                "text": "„Denn für Frauen ist das Kraftfahrzeug eines von sehr vielen Accessoires und wird teilweise genau so gehandhabt wie beispielsweise die Handtasche:…“"
                                            },
                                            {
                                                "example_id": "a3564406-fdcb-4115-bbae-2336a5800319",
                                                "sense_id": "b011bac7-5bfe-3218-a578-cdcaf644511b",
                                                "text": "„Der Garten – er ist nicht bloßes Accessoire bürgerlich etablierter Existenz.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "145945a8-fe1e-4798-9f45-6ef49e255996",
                        "source_entry_id": "7cb60ac6-6479-36c1-8546-0ee5d3793a72",
