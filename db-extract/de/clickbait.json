                "senses": [
                    {
                        "sense_id": "dd8673fa-834b-3b7c-b730-e0f1a0093076",
                        "entry_id": "a0e801d7-baa5-37a3-ab4e-c752ecb65560",
                        "glosses": [
                            "reißerischer oder provokanter kurzer Text (häufig in Form einer Überschrift), der Besucher anlocken soll"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7434d164-2dd6-3917-afad-21c288e165ab",
                        "entry_id": "a0e801d7-baa5-37a3-ab4e-c752ecb65560",
                        "glosses": [
                            "das Anlocken von Besuchern durch eine häufig reißerische oder provokante Überschrift"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc6cb362-df1a-4c4e-b9b7-ad94899c7ce2",
                        "source_entry_id": "a0e801d7-baa5-37a3-ab4e-c752ecb65560",
                        "source_sense_id": "dd8673fa-834b-3b7c-b730-e0f1a0093076",
                        "source_sense_description": "reißerischer oder provokanter kurzer Text, der Besucher anlocken soll",
                        "target_lang_word": "clickbait",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clickbait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                        "entry_id": "776b4f7b-b238-3f33-8b3b-ccdfff5a5c07",
                                        "glosses": [
                                            "Website content that is aimed at generating advertising revenue, especially at the expense of quality or accuracy, relying on sensationalist headlines to attract click-throughs; such headlines."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26bc1b96-d3d6-4715-8220-fad68ee1de9f",
                                                "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                                "text": "Fairfax's sites are renowned for what is sometimes called ‘clickbait’: headlines written to beguile passing eyeballs but which obscure nondescript or irrelevant stories."
                                            },
                                            {
                                                "example_id": "95f5b113-f297-43bf-821b-aa643d369310",
                                                "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                                "text": "\"His careful lawyerly writing would be out of fashion now\", wrote one commenter after Kettle's piece. \"It wasn't clickbait\"."
                                            },
                                            {
                                                "example_id": "1213d4d1-67b7-4d2f-87d7-f17c02656f31",
                                                "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                                "text": "In August 2016, leaders at Facebook announced a plan to identify and limit clickbait, because the Facebook newsfeed goal is to “show people the stories most relevant to them.”"
                                            },
                                            {
                                                "example_id": "9c3fbd32-11e2-4922-ade7-c0eae24cf488",
                                                "sense_id": "0b2e0635-cea8-3de3-8b64-83bc3f2dcf5c",
                                                "text": "In comparison with algorithms used in the past, this SI based technique provided a better accuracy and a human interpretable set of rules to classify clickbaits"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "clickbait",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9f841bf6-a018-35ce-b7d7-dd70e433f732",
                                        "entry_id": "d4e4f9e4-7c25-3a96-8357-c4b89b7e4cac",
                                        "glosses": [
                                            "To add clickbait to a web page; to direct clickbait at someone."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35194cdc-883e-406e-8ad0-a8e5b4a6e346",
                                                "sense_id": "9f841bf6-a018-35ce-b7d7-dd70e433f732",
                                                "text": "Whether they're acts of clickbaiting or dumbness, internet headlines routinely mischaracterize quotes, inaccurately paraphrase statements, and misuse specific terms, all to make readers click."
                                            },
                                            {
                                                "example_id": "9a298f52-6907-4990-82c3-f9032ec9405f",
                                                "sense_id": "9f841bf6-a018-35ce-b7d7-dd70e433f732",
                                                "text": "But he'd clickbaited her."
                                            },
                                            {
                                                "example_id": "c1a55f5e-03b9-42d0-8a7e-306a57c20948",
                                                "sense_id": "9f841bf6-a018-35ce-b7d7-dd70e433f732",
                                                "text": "I have never clickbaited anyone with overexaggerated titles, but also never downplayed the severity of the content within."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73b62a89-8785-4d15-b4ff-a034a527426d",
                        "source_entry_id": "a0e801d7-baa5-37a3-ab4e-c752ecb65560",
                        "source_sense_id": "dd8673fa-834b-3b7c-b730-e0f1a0093076",
                        "source_sense_description": "reißerischer oder provokanter kurzer Text, der Besucher anlocken soll",
                        "target_lang_word": "piège à clics",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "piège à clics",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d9e50ab-ea07-36f9-8aa8-a80f70972534",
                                        "entry_id": "3a8d89ec-c551-3b48-9ae5-02c271d1bbab",
                                        "glosses": [
                                            "Qualifie un article ou une vidéo dont le titre ou le résumé est exagéré délibérément afin d'attirer davantage de lecteurs ou de spectateurs. Titre aguicheur, racoleur destiné à provoquer un clic."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64744444-7259-491b-8c97-97d317958498",
                                                "sense_id": "3d9e50ab-ea07-36f9-8aa8-a80f70972534",
                                                "text": "Parmi les dix pages qui étaient les plus suivies, on trouve essentiellement des communautés qui diffusaient des contenus sensationnalistes ou « piège à clics », comme Le Petit Buzz, qui réunissait près de 5 millions d’abonnés avant d’être supprimée."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "piège à clics",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aad4c2ed-18e1-3d16-bfa8-e23d3878ce3a",
                                        "entry_id": "40cf73fe-358e-3210-9a90-5adbab91855a",
                                        "glosses": [
                                            "Cet article ou cette vidéo même."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7d211fa1-0cd1-4bd9-84d3-72efecfe896c",
                                                "sense_id": "aad4c2ed-18e1-3d16-bfa8-e23d3878ce3a",
                                                "text": "Que fait donc ce jeune écrivain irlandais récompensé, dont le premier recueil de nouvelles a été un succès critique à défaut de se vendre, à ce poste ingrat qui l'oblige à améliorer le chiffre de fréquentation du site en rédigeant des pièges à clics sur Miley Cyrus ?"
                                            },
                                            {
                                                "example_id": "aae661c1-3ea0-4e32-9c24-74011b468d29",
                                                "sense_id": "aad4c2ed-18e1-3d16-bfa8-e23d3878ce3a",
                                                "text": "Pourquoi ne pouvons-nous pas partager davantage d'histoires de femmes et de leurs obsessions qui ne paraissent pas ringardes et qui servent de piège à clics ? Je sais qu'il y a quantité de pièges à clics."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
