                        "examples": [
                            {
                                "example_id": "512deeb8-9454-4273-a7dd-c651bff6b84f",
                                "sense_id": "d3da28c5-a4de-3ecc-8618-510be07d4aad",
                                "text": "Persée, après le retour d’Eumène, se voyant déchu de ses espérances, fit partir pour Ténédos Anténor et Callippe, commandants de la flotte, avec quarante vaisseaux légers."
                            },
                            {
                                "example_id": "0411c5a0-45a1-495b-846f-b7613b12301a",
                                "sense_id": "d3da28c5-a4de-3ecc-8618-510be07d4aad",
                                "text": "Il traverse l’Apocalypse ;\nPâle, il a la mort sur son dos.\nSa grande aile brumeuse éclipse\nLa lune devant Ténédos."
                            }
                        ]
                    }
