                                "target_senses": [
                                    {
                                        "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
                                        "entry_id": "bf62ab7d-2989-355f-a2c8-d4ffa8ad04d8",
                                        "glosses": [
                                            "handgreifliche Auseinandersetzung mehrerer Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "278c5fce-b056-4bc3-a50e-c61745d461ee",
                                                "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
                                                "text": "„Von der anderen Seite der Tür hörte man die Geräusche eines heftigen Handgemenges - Rufe, Flüche und Faustschläge.“"
                                            },
                                            {
                                                "example_id": "3f1bd585-0cf3-4e55-aca1-0a2da8fbc865",
                                                "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
                                                "text": "„Du liebe Zeit, Passagiere und Waren werden da unter Geschrei, Lamento und Handgemenge auf einen wahrhaftigen Seelenverkäufer bugsiert.“"
                                            },
                                            {
                                                "example_id": "9cdc0ade-82d4-4781-a85e-5064b1694888",
                                                "sense_id": "122405c6-5189-31af-82bc-4817b92b9c0a",
                                                "text": "„Württemberger Dragoner trieben die Angreifer zurück, bevor es zu einem Handgemenge kommen konnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c0a46034-e17e-4082-adb7-6e0a99c16827",
