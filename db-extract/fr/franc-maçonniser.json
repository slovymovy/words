                "senses": [
                    {
                        "sense_id": "b48177c0-66ed-358b-8a95-37a3300bd16a",
                        "entry_id": "8031f658-fdc8-37c1-8820-ac15fb4de2f9",
                        "glosses": [
                            "Donner un caractère franc-maçon à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "391f00ae-4819-466b-be40-22dfcf940655",
                                "sense_id": "b48177c0-66ed-358b-8a95-37a3300bd16a",
                                "text": "L'objectif est clairement de rendre compatible l'Islam avec les Droits de l'Homme, autrement dit de franc-maçonniser l'Islam, comme l'a été depuis Vatican II et continue de l'être le catholicisme."
                            },
                            {
                                "example_id": "d056dd24-db8d-4c49-a8df-1622bbe40885",
                                "sense_id": "b48177c0-66ed-358b-8a95-37a3300bd16a",
                                "text": "Fatigué de ces \"idoles qui chient du marbre\" (dixit Forman), on s'amuse à chinoiser, à persaniser, à franc-maçonniser, avant de retourner au culte froid de la déesse Raison."
                            },
                            {
                                "example_id": "48a1c6e2-6b99-4876-868f-307511c32479",
                                "sense_id": "b48177c0-66ed-358b-8a95-37a3300bd16a",
                                "text": "Le front national ne serait-il pas en train de se franc-maçonniser"
                            }
                        ]
                    }
