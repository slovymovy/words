                "senses": [
                    {
                        "sense_id": "71a33f28-0112-3036-8b3b-7c3f47d08676",
                        "entry_id": "4c1ef4a4-10d0-35d6-88ed-bcb04605dc27",
                        "glosses": [
                            "(w tenisie ziemnym, tenisie stołowym, badmintonie i speed-ballu) odbicie z prawej strony rakietą trzymaną w prawej ręce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1896d0e4-6a2e-4b53-aa66-9a9c040e80f9",
                                "sense_id": "71a33f28-0112-3036-8b3b-7c3f47d08676",
                                "text": "Dzięki doskonałemu forhendowi, w którym łączy potworną siłę z doskonałą techniką, przełamał zasadę, że Hiszpanie wygrywają tylko na kortach ziemnych"
                            },
                            {
                                "example_id": "cb19fd40-3291-40f1-98e8-4f93f59c2dd0",
                                "sense_id": "71a33f28-0112-3036-8b3b-7c3f47d08676",
                                "text": "Rok temu porażkę na Wimbledonie Andriej tłumaczył względami natury osobistej, ale wróble na trawie Wimbledonu już ćwierkały, że romans z Anke jest dla niego ważniejszy niż forhendy lub bekhendy"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
