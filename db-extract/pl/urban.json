                                "target_senses": [
                                    {
                                        "sense_id": "fa32837b-60be-37c5-bcc6-6c54ce3bdb86",
                                        "entry_id": "662948fe-561d-3f56-901f-135604db3480",
                                        "glosses": [
                                            "мужское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f151c80-2b53-4f6c-9742-089a0f8ff28f",
                                                "sense_id": "fa32837b-60be-37c5-bcc6-6c54ce3bdb86",
                                                "text": "По следствию оказалось, что Урбан Грандье имел самые близкие сношения и даже переписку с бесами: Астаротом, Асмодеем, Уриелем, Левиафаном, Валаамом и многими другими, по его повелению вселявшимися в тела урсулинок."
                                            },
                                            {
                                                "example_id": "dfc24a67-6579-4260-a351-bee0d0090b14",
                                                "sense_id": "fa32837b-60be-37c5-bcc6-6c54ce3bdb86",
                                                "text": "Так, папа Урбан VI в 1385 году повелел схватить шестерых кардиналов, организовавших против него заговор."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Урбан",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "625a6816-fe89-3ed8-be0e-4696edc53fd2",
                                        "entry_id": "ff6ef61a-722c-3686-9797-c75299eb2f10",
                                        "glosses": [
                                            "фамилия"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2add1fb2-b879-426f-ab8d-55037da12c2e",
                                                "sense_id": "625a6816-fe89-3ed8-be0e-4696edc53fd2",
                                                "text": "Официальный представитель польского правительства Ежи Урбан заявил иностранным журналистам, что власти готовы освободить арестованных, если те согласятся выехать за границу."
                                            },
                                            {
                                                "example_id": "8c1c8400-53fa-4422-97d2-171599b325f1",
                                                "sense_id": "625a6816-fe89-3ed8-be0e-4696edc53fd2",
                                                "text": "Актриса Николь Кидман и её муж музыкант Кит Урбан стали родителями девочки, которую назвали Фейт Маргарет."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
