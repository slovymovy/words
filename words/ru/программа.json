            "senses": [
                {
                    "sense_id": "eb255e6d-ecb6-379a-b7a9-50a2709fb2b1",
                    "sense_definition": "Компьютерная программа или приложение; набор инструкций, выполняемых компьютером.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "tech_software",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я установил новую антивирусную <w>программу</w> на свой ноутбук.",
                            "target_lang_translations": {
                                "en": "I installed a new antivirus <w>program</w> on my laptop.",
                                "zh": "我在笔记本电脑上安装了一个新的杀毒<w>程序</w>。"
                            }
                        },
                        {
                            "text": "Эта компьютерная <w>программа</w> помогает монтировать видео.",
                            "target_lang_translations": {
                                "en": "This computer <w>program</w> helps to edit videos.",
                                "zh": "这个电脑<w>程序</w>可以帮助剪辑视频。"
                            }
                        }
                    ],
                    "synonyms": [
                        "приложение",
                        "софт"
                    ],
                    "common_phrases": [
                        "компьютерная программа",
                        "скачать программу",
                        "установить программу",
                        "запустить программу"
                    ],
                    "target_lang_definitions": {
                        "en": "A computer program or application; a set of instructions executed by a computer.",
                        "zh": "计算机程序或应用程序；由计算机执行的一组指令。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "program",
                                "target_lang_sense_clarification": "computing"
                            },
                            {
                                "target_lang_word": "application",
                                "target_lang_sense_clarification": "software"
                            },
                            {
                                "target_lang_word": "software",
                                "target_lang_sense_clarification": "general term"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "程序",
                                "target_lang_sense_clarification": "计算机指令集"
                            },
                            {
                                "target_lang_word": "软件",
                                "target_lang_sense_clarification": "通用术语"
                            },
                            {
                                "target_lang_word": "应用程序",
                                "target_lang_sense_clarification": "应用软件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14f1b5cf-2ee7-3af1-b776-b02ac709d9d6",
                    "sense_definition": "Передача по телевидению или радио, а также расписание таких передач.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "media_broadcast",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вечером мы всей семьей смотрели развлекательную <w>программу</w>.",
                            "target_lang_translations": {
                                "en": "In the evening, our whole family watched an entertainment <w>program</w>.",
                                "zh": "晚上我们全家一起看了娱乐<w>节目</w>。"
                            }
                        },
                        {
                            "text": "Где лежит <w>программа</w> телепередач на следующую неделю?",
                            "target_lang_translations": {
                                "en": "Where is the TV <w>schedule</w> for next week?",
                                "zh": "下周的电视<w>节目单</w>在哪儿？"
                            }
