                                        "entry_id": "fdcc2684-6e2d-3477-91fa-607d97430542",
                                        "glosses": [
                                            "A device which records data that would be of use in investigating the cause of an aircraft accident; usually in pairs, consisting of a flight data recorder and a cockpit voice recorder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8254b4a6-8ad6-46f3-9089-403594eb14cd",
                        "source_entry_id": "0e66b584-516c-3a7b-8339-62808d1b2d21",
                        "source_sense_id": "ee7ef420-d107-3436-a415-12e781fefa35",
