                        "glosses": [
                            "Person, die mit Heroin handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e890ecff-04ff-4f55-9829-12395df6068a",
                                "sense_id": "373c116b-98f1-3b4e-91c5-a58868e3f114",
                                "text": "„Pablo verwahrte eine vollständige Abschrift der amerikanischen Anklage gegen Iván Urdonola, einen Heroinhändler aus der Gegend von Cauca, und er führte Dossiers über seine Konkurrenten vom Cali-Kartell, komplett mit Foto, Adresse, Fahrzeugbeschreibung und amtlichem Kennzeichen.“"
                            },
                            {
                                "example_id": "84eb809a-c5a8-4113-8882-a766f26dfdef",
                                "sense_id": "373c116b-98f1-3b4e-91c5-a58868e3f114",
                                "text": "„In Rom führt er offiziell ein Bekleidungsgeschäft. Und Roberto hat Sinn für Ironie: Das Geschäft nennt er ›Il Papavero‹, Mohn, eine Anspielung auf seine Zusammenarbeit mit großen türkischen Heroinhändlern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
