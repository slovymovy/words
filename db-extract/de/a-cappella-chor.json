                ],
                "senses": [
                    {
                        "sense_id": "d63f0d9b-66f4-3fbe-a129-fa6efff5043a",
                        "entry_id": "68cff50f-2639-3e6b-94d2-606de49bd473",
                        "glosses": [
                            "Chor, der ohne instrumentale Begleitung (a cappella) singt"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "0a13ecd5-b6ec-4867-8a67-20fb1b5dfbb5",
                                "sense_id": "d63f0d9b-66f4-3fbe-a129-fa6efff5043a",
                                "text": "Seit Jahren singt sie in einem A-cappella-Chor."
                            },
                            {
                                "example_id": "3b7e37a5-ed33-4bdf-9cf7-b258b65d1d09",
                                "sense_id": "d63f0d9b-66f4-3fbe-a129-fa6efff5043a",
                                "text": "„Sie hatten mich im A-cappella-Chor gehört und sprachen mich nach dem Konzert an, weil sie eine Sängerin suchten.“"
                            },
                            {
                                "example_id": "07c29363-7ed3-4013-a996-08405dd9ee01",
                                "sense_id": "d63f0d9b-66f4-3fbe-a129-fa6efff5043a",
                                "text": "„Unterstützt wurde der A-cappella-Chor in bewährter Form von Chorleiterin Marina Solowjewa am Klavier und von vier Streichern, die während des Konzertes zudem auch solistisch tätig wurden und die Zuhörer mit ihrem virtuosen Spiel beeindruckten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
