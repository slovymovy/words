                "senses": [
                    {
                        "sense_id": "ffe4e389-aaa4-337b-9355-2825626b5d2b",
                        "entry_id": "ace8f689-8a03-3174-96e6-01d8ac6a4947",
                        "glosses": [
                            "ein gewählter militärischer Führer und Vorstehender einer oder mehrerer Siedlungen bei den Kosaken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c2f98e-311f-4794-b41e-599398a3aae9",
                                "sense_id": "ffe4e389-aaa4-337b-9355-2825626b5d2b",
                                "text": "„Den höchsten Ataman der Kubanj-Kosaken hat Kondratenko zu seinem Vizegouverneur ernannt.“"
                            },
                            {
                                "example_id": "b153c798-0db3-47b2-8f61-76eedbd5968f",
                                "sense_id": "ffe4e389-aaa4-337b-9355-2825626b5d2b",
                                "text": "„Wenn Rußland in tödlicher Gefahr schwebt, dann tagt der Rat der Atamane.“"
                            },
                            {
                                "example_id": "44099282-9e23-49ef-9664-d99bab1323b5",
                                "sense_id": "ffe4e389-aaa4-337b-9355-2825626b5d2b",
                                "text": "„Die Räuber taten mir im Übrigen nicht das geringste Leid an und verhielten sich überhaupt sehr herzlich zu mir, beinahe wie zu ihresgleichen. Noch in derselben Nacht wählten sie mich zu ihrem Ataman.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9be41178-1a6d-405d-9f82-653546ac642a",
                        "source_entry_id": "ace8f689-8a03-3174-96e6-01d8ac6a4947",
