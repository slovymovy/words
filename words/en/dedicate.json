{
    "word_family": [
        "dedication",
        "dedicator",
        "dedicatory"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d009915-687d-3575-96b8-2baa955dc824",
                    "sense_definition": "To set apart for a deity or for religious purposes; to make holy.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_consecration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community gathered to <w>dedicate</w> the new chapel to their patron saint.",
                            "target_lang_translations": {
                                "ru": "Община собралась, чтобы <w>посвятить</w> новую часовню своему святому покровителю."
                            }
                        },
                        {
                            "text": "Ancient cultures would often <w>dedicate</w> temples to their gods.",
                            "target_lang_translations": {
                                "ru": "Древние культуры часто <w>посвящали</w> храмы своим богам."
                            }
                        }
                    ],
                    "synonyms": [
                        "hallow",
                        "consecrate"
                    ],
                    "common_phrases": [
                        "dedicate to deity"
                    ],
                    "target_lang_definitions": {
                        "ru": "Освящать, предназначать для религиозных целей или божества."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвяща́ть",
                                "target_lang_sense_clarification": "предназначать для религиозных целей"
                            },
                            {
                                "target_lang_word": "освяща́ть",
                                "target_lang_sense_clarification": "делать священным, совершать обряд освящения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d34ce255-517b-323f-a8be-c10a1eddc1b5",
                    "sense_definition": "To set apart or reserve something for a specific purpose or use.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "allocation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>dedicate</w> more funds to public education.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>выделить</w> больше средств на государственное образование."
                            }
                        },
                        {
                            "text": "They <w>dedicate</w> a portion of their income to charity every month.",
                            "target_lang_translations": {
                                "ru": "Они каждый месяц <w>отчисляют</w> часть своего дохода на благотворительность."
                            }
                        }
                    ],
                    "synonyms": [
                        "allocate",
                        "earmark",
                        "set apart"
                    ],
                    "common_phrases": [
                        "dedicate funds",
                        "dedicate resources"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выделять или отводить что-либо для конкретной цели или использования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предназнача́ть",
                                "target_lang_sense_clarification": "определять цель или назначение чего-либо"
                            },
                            {
                                "target_lang_word": "выделя́ть",
                                "target_lang_sense_clarification": "отводить ресурсы или средства для нужд"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b92d8ff-8eb3-353f-abc0-c51ad3291bad",
                    "sense_definition": "To commit oneself fully to a particular task, goal, or way of life.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "commitment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided to <w>dedicate</w> herself to helping those in need.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>посвятить себя</w> помощи нуждающимся."
                            }
                        },
                        {
                            "text": "The athletes <w>dedicate</w> their lives to achieving excellence in their sport.",
                            "target_lang_translations": {
                                "ru": "Спортсмены <w>посвящают</w> свою жизнь достижению совершенства в спорте."
                            }
                        }
                    ],
                    "synonyms": [
                        "devote"
                    ],
                    "common_phrases": [
                        "dedicate oneself"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью отдавать себя какому-либо делу, цели или образу жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвяща́ть себя́",
                                "target_lang_sense_clarification": "полностью отдаваться какому-либо делу"
                            },
                            {
                                "target_lang_word": "предава́ться",
                                "target_lang_sense_clarification": "полностью погружаться в какое-либо занятие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f43cc98a-088f-3ba0-9786-54abf231e685",
                    "sense_definition": "To address or inscribe a creative work to someone as a sign of respect or love.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tribute",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author chose to <w>dedicate</w> her first novel to her parents.",
                            "target_lang_translations": {
                                "ru": "Автор решила <w>посвятить</w> свой первый роман родителям."
                            }
                        },
                        {
                            "text": "He will <w>dedicate</w> the poem to his wife on their anniversary.",
                            "target_lang_translations": {
                                "ru": "Он <w>посвятит</w> это стихотворение своей жене в день их годовщины."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dedicate a book"
                    ],
                    "target_lang_definitions": {
                        "ru": "Адресовать или надписывать творческую работу кому-либо в знак уважения или любви."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "посвяща́ть",
                                "target_lang_sense_clarification": "адресовать произведение кому-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2adc85db-f3d0-3165-9924-33be73de7312",
                    "sense_definition": "To officially open a building or monument for public use.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mayor will <w>dedicate</w> the new library during the ceremony tomorrow.",
                            "target_lang_translations": {
                                "ru": "Мэр <w>торжественно откроет</w> новую библиотеку во время завтрашней церемонии."
                            }
                        },
                        {
                            "text": "They plan to <w>dedicate</w> the monument to the soldiers who served.",
                            "target_lang_translations": {
                                "ru": "Они планируют <w>посвятить</w> этот памятник солдатам, которые несли службу."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dedicate a building"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально открывать здание или памятник для общественного пользования."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "открыва́ть",
                                "target_lang_sense_clarification": "торжественно вводить в эксплуатацию"
                            },
                            {
                                "target_lang_word": "торжественно открыва́ть",
                                "target_lang_sense_clarification": "открывать с проведением церемонии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}