                    "frequency": "High",
                    "semantic_group_id": "warning_signal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fire <w>alarm</w> rang loudly during the exam.",
                            "target_lang_translations": {
                                "ru": "Пожарная <w>сигнализация</w> громко зазвенела во время экзамена.",
                                "nl": "Het brand<w>alarm</w> ging luid af tijdens het examen.",
                                "pl": "Podczas egzaminu głośno zadzwonił <w>alarm</w> przeciwpożarowy.",
                                "de": "Der Feuer<w>alarm</w> schrillte laut während der Prüfung.",
                                "fr": "L'<w>alarme</w> incendie a retenti bruyamment pendant l'examen.",
                                "it": "L'<w>allarme</w> antincendio ha suonato forte durante l'esame.",
                                "cs": "Během zkoušky hlasitě zazněl požární <w>alarm</w>.",
                                "tr": "Sınav sırasında yangın <w>alarmı</w> yüksek sesle çaldı.",
                                "es": "La <w>alarma</w> de incendios sonó fuerte durante el examen."
                            }
                        },
                        {
                            "text": "They installed a burglar <w>alarm</w> to protect the house.",
                            "target_lang_translations": {
                                "ru": "Они установили охранную <w>сигнализацию</w>, чтобы защитить дом.",
                                "nl": "Ze hebben een inbraak<w>alarm</w> geïnstalleerd om het huis te beveiligen.",
                                "pl": "Zainstalowali <w>alarm</w> antywłamaniowy, aby chronić dom.",
                                "de": "Sie haben eine Einbruch<w>alarmanlage</w> installiert, um das Haus zu schützen.",
                                "fr": "Ils ont installé une <w>alarme</w> anti-intrusion pour protéger la maison.",
                                "it": "Hanno installato un <w>antifurto</w> per proteggere la casa.",
                                "cs": "Nainstalovali domovní <w>alarm</w>, aby ochránili dům.",
                                "tr": "Evi korumak için hırsız <w>alarmı</w> taktırdılar.",
                                "es": "Instalaron una <w>alarma</w> contra robos para proteger la casa."
                            }
                        }
