                    {
                        "sense_id": "2ac24227-028b-343b-992d-d0751e727f11",
                        "entry_id": "1e4e0057-61e8-3e3f-8e2c-e2af30dfc505",
                        "glosses": [
                            "Dyschromatopsie de Dalton."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "bf78fea5-8775-3a41-ab4e-24ed30527fa7",
                        "entry_id": "1e4e0057-61e8-3e3f-8e2c-e2af30dfc505",
                        "glosses": [
                            "Toutes dyschromatopsies."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "ed3bd8ce-14d2-43d1-a8c1-da1ebee65fa3",
                                "sense_id": "bf78fea5-8775-3a41-ab4e-24ed30527fa7",
                                "text": "Le daltonisme (ou dyschromatopsie) est une anomalie de la vision des couleurs qui est héréditaire et congénitale, ce qui signifie qu’elle se transmet aux générations suivantes, et qu’elle n’évolue pas au cours de la vie."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75813612-b354-4cfa-a754-3d90e746e5eb",
                        "source_entry_id": "1e4e0057-61e8-3e3f-8e2c-e2af30dfc505",
                        "target_lang_word": "Achromatopsie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achromatopsie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                        "entry_id": "167b86cf-5d2e-3b81-8bc3-6777313f84d0",
                                        "glosses": [
                                            "angeborener oder erworbener gänzlicher Ausfall des Farbensehens durch Fehlen der Zapfenfunktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76bb7aa7-c35c-40fb-80e0-d5f541306952",
                                                "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                                "text": "Achromatopsie (Farbenblindheit) ist nicht Farbenfehlsichtigkeit."
                                            },
                                            {
                                                "example_id": "adaa863a-01f1-4730-a77d-ca3bd6143e49",
                                                "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                                "text": "„Die Tests und die allgemeine neurologische Untersuchung hatten die Diagnose bestätigt: totale Farbenblindheit, Achromatopsie.“"
                                            },
                                            {
                                                "example_id": "b8d0b905-c491-4525-8390-c5286e35d7b4",
                                                "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                                "text": "„Das Unvermögen, die Farben richtig zu unterscheiden, die Achromatopsie, ist manchen Menschen angeboren und in diesem Falle kein amaurotisches Symptom.“"
                                            },
                                            {
                                                "example_id": "6b275447-30e2-4d68-bffd-15e72266882b",
                                                "sense_id": "9c752fb5-3d01-3cda-adeb-7112eb49fbfd",
                                                "text": "„Die Farbenblindheit oder Achromatopsie ist eine relativ seltene vererbte Netzhauterkrankung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "04a1bc31-eff8-4e67-9b28-e6153f352584",
                        "source_entry_id": "1e4e0057-61e8-3e3f-8e2c-e2af30dfc505",
                        "target_lang_word": "Achromasie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Achromasie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "412c617e-4ae6-39ab-ae36-38081c2db339",
                                        "entry_id": "9d54b31f-bc42-36dc-a401-28d1344877de",
                                        "glosses": [
                                            "angeborenes oder erworbenes Fehlen von Pigmenten in der Haut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "034877d4-20b2-4748-ac38-ba806c49101d",
                                                "sense_id": "412c617e-4ae6-39ab-ae36-38081c2db339",
                                                "text": "Ein Beispiel für eine weit verbreitete Achromasie ist der Albinismus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b960a22-8a51-3300-ba41-9d8b5c06e35d",
                                        "entry_id": "9d54b31f-bc42-36dc-a401-28d1344877de",
                                        "glosses": [
                                            "angeborener oder erworbener gänzlicher Ausfall des Farbensehens durch Fehlen der Zapfenfunktion"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8abb071f-16e2-450b-8995-0ed55fc39fb7",
                                                "sense_id": "8b960a22-8a51-3300-ba41-9d8b5c06e35d",
                                                "text": "Achromasie (Farbenblindheit) ist nicht mit Farbenfehlsichtigkeit (Daltonismus) zu verwechseln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7ab9ffaf-ab26-3458-b0b5-528da69b76e8",
                                        "entry_id": "9d54b31f-bc42-36dc-a401-28d1344877de",
                                        "glosses": [
                                            "Brechung der Lichtstrahlen ohne Zerlegung in Farben, die durch eine achromatische Konstruktion erreicht wird"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b32eb39b-9c4a-4737-bbd9-025ac6c25161",
                                                "sense_id": "7ab9ffaf-ab26-3458-b0b5-528da69b76e8",
                                                "text": "Durch die Anwendung von speziellen Linsen kann die Achromasie von gewöhnlichen Linsen vermieden werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aebf4cc5-6f12-496e-8d42-313b98148bdd",
                        "source_entry_id": "1e4e0057-61e8-3e3f-8e2c-e2af30dfc505",
                        "target_lang_word": "Farbenblindheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Farbenblindheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "735044b3-38aa-39ed-b2e4-d47cc56b4d66",
                                        "entry_id": "32ab0a13-5df8-39b9-8833-21ddb9bd45ca",
                                        "glosses": [
                                            "Unfähigkeit, Farben zu erkennen oder zu unterscheiden"
