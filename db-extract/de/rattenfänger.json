                    {
                        "form_id": "49a41513-79cc-463a-9aac-86c9d65dc857",
                        "entry_id": "805a682e-3c2a-35d7-95ca-5add741a83f2",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Rattenfänger"
                    },
                    {
                        "form_id": "852b12d6-1e31-4221-8e54-1eb06f0604e2",
                        "entry_id": "805a682e-3c2a-35d7-95ca-5add741a83f2",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rattenfänger"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fa2cbbd-271d-3f2a-a8fe-2fe12778c751",
                        "entry_id": "805a682e-3c2a-35d7-95ca-5add741a83f2",
                        "glosses": [
                            "Sagengestalt, die die Stadt Hameln zuerst von Ratten befreit hat und die undankbaren Bürger dann bestrafte, indem sie die Kinder der Stadt entführte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddc63fdc-9f31-4026-a4b4-7037b924f32d",
                                "sense_id": "7fa2cbbd-271d-3f2a-a8fe-2fe12778c751",
                                "text": "Der Rattenfänger konnte die Ratten durch sein Flötenspiel aus der Stadt locken."
                            },
                            {
                                "example_id": "4f860190-6eed-47c2-9ef2-998e663d7ae2",
                                "sense_id": "7fa2cbbd-271d-3f2a-a8fe-2fe12778c751",
                                "text": "„Der erregende Besuch im Archiv mit dem Walten Perkings und der anderen Gehilfen, der sonderbare Zug der Kinder, die wie hinter einem unsichtbaren Rattenfänger durch die Stadt gezogen waren, die Begegnung mit Anna und der Gang mit der Geliebten, das steinerne Auge der Domfassade und das lebende Panoptikum der Heiligenfiguren – hatte sich das wirklich in einem meßbaren Zeitraum weniger Stunden abgespielt, vom Morgen bis zum Frühnachmittag?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "621caa32-58b7-327a-ba9e-548946e9a4e6",
                        "entry_id": "805a682e-3c2a-35d7-95ca-5add741a83f2",
                        "glosses": [
                            "Person, die Menschen durch rhetorisches Geschick zu verlocken vermag"
                        ],
                        "tags": [
                            "derogatory",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "090c1d17-4149-47a9-b029-4c0bcbabbdc8",
                                "sense_id": "621caa32-58b7-327a-ba9e-548946e9a4e6",
                                "text": "Es besteht die Gefahr, dass sich verdrossene Bürger von den rechtspopulistischen Rattenfängern verführen lassen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "37701843-80ba-3c85-8a40-1e17808e1d0d",
                        "entry_id": "805a682e-3c2a-35d7-95ca-5add741a83f2",
                        "glosses": [
                            "Hunderasse, die zur Bekämpfung von Ratten und Mäusen geeignet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "48b07fe3-1a21-47f3-bd92-f384e7f39bf2",
                                "sense_id": "37701843-80ba-3c85-8a40-1e17808e1d0d",
                                "text": "Kleine Pinscher und Terrier wurden gerne als Rattenfänger gehalten."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "e8db3996-4349-3687-8387-740db92f0704",
                        "entry_id": "805a682e-3c2a-35d7-95ca-5add741a83f2",
                        "glosses": [
                            "Person, die berufsmäßig wild lebende Ratten fängt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "2af4439a-f906-4316-ad8b-e98673006bd9",
                                "sense_id": "e8db3996-4349-3687-8387-740db92f0704",
                                "text": "„Den Reportagen des englischen Journalisten und Sozialreformers Henry Mayhew über Arbeit und Armut des Londoner Straßenvolks […] waren Illustrationen von Straßenverkäuferinnen oder Rattenfängern beigegeben.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
