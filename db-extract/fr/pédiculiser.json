                "senses": [
                    {
                        "sense_id": "00473264-dd17-39d1-a2a8-8dbb667f3bc8",
                        "entry_id": "4fcab70e-0f2d-3cb7-9ddd-3e4fa5a427fe",
                        "glosses": [
                            "Transformer en pédicule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2eae897a-4984-41f8-ad96-29f88a50c35c",
                                "sense_id": "00473264-dd17-39d1-a2a8-8dbb667f3bc8",
                                "text": "Il ne paraît convenir tout au plus que lorsqu’il n’existe qu'une ou deux tumeurs, que l’on peut aisément pédiculiser et étrangler."
                            },
                            {
                                "example_id": "99009fba-bba7-4558-9f34-b1f220b03871",
                                "sense_id": "00473264-dd17-39d1-a2a8-8dbb667f3bc8",
                                "text": "Mais, comment pédiculiser une tumeur qui a 12 à 15 centimètres de diamètre, qui est évasée et repose sur un plan osseux ?"
                            }
                        ]
                    }
