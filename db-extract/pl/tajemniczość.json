                "senses": [
                    {
                        "sense_id": "1f464a50-916b-3b4a-9d07-71dee1b7e62d",
                        "entry_id": "2094ccc8-ae26-37c2-968a-97d03824127e",
                        "glosses": [
                            "cecha tego, co jest tajemnicze, zagadkowe, niejasne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "772221fa-d4d5-4375-a0eb-59bf83428052",
                                "sense_id": "1f464a50-916b-3b4a-9d07-71dee1b7e62d",
                                "text": "Kategorie cudowności, fantazji, tajemniczości, grozy i czarnego humoru, charakterystyczne dla surrealizmu, cechują także groteskę, szerszą kategorię artystyczną, obejmującą również ten styl."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38af44b1-ca1a-4a36-8081-68b347400c96",
                        "source_entry_id": "2094ccc8-ae26-37c2-968a-97d03824127e",
                        "source_sense_id": "1f464a50-916b-3b4a-9d07-71dee1b7e62d",
                        "target_lang_word": "mystery",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mystery",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "Something secret or unexplainable; an unknown."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "406f3c89-607f-42f8-a097-732163be5df4",
                                                "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                                                "text": "The truth behind the events remains a mystery."
                                            },
                                            {
                                                "example_id": "9fe22593-18c5-4ccd-afc0-59f188312db5",
                                                "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                                                "text": "The case was that of a murder. It had an element of mystery about it, however, which was puzzling the authorities. A turban and loincloth soaked in blood had been found; also a staff."
                                            },
                                            {
                                                "example_id": "3c2b2354-9ced-4e48-880d-192ba31c2fb6",
                                                "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                                                "text": "The fate of the railway from Ballater to Braemar has been invested with an air of mystery, which has never been completely dispelled. It has been suggested that Queen Victoria was opposed to a railway in the vicinity of Balmoral Castle, and intervened personally to secure the abandonment of the line beyond Ballater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "afdb1d30-3449-3333-a8c1-b9417b41ced1",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "Someone or something with an obscure or puzzling nature."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc0ebd51-94bf-4cb8-b0fd-c27ab8caa751",
                                                "sense_id": "afdb1d30-3449-3333-a8c1-b9417b41ced1",
                                                "text": "That man is a mystery."
                                            },
                                            {
                                                "example_id": "3a838141-1cb2-4878-a0d0-54dbf08a038c",
                                                "sense_id": "afdb1d30-3449-3333-a8c1-b9417b41ced1",
                                                "text": "Then I had a good think on the subject of the hocussing of Cigarette, and I was reluctantly bound to admit that once again the man in the corner had found the only possible solution to the mystery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a334e0d-84ba-3cb7-a910-39d590f00106",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "An account, story, book, film, or play, often with the theme of crime or murder, with a surprise ending that explains all the strange events that have occurred."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9de9278f-e3c9-3a73-b106-4ee31e367499",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A mystery play."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce4a44b4-23ce-40a9-a568-0043237353c4",
                                                "sense_id": "9de9278f-e3c9-3a73-b106-4ee31e367499",
                                                "text": "The Moralities displayed something more of art and invention than the Mysteries; in them virtues, vices and qualities were personified, and something like a plot was frequently to be discovered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29af858-1f84-3c68-9264-9ae7ed69c805",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A secret or mystical meaning."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2b889160-239c-494f-8c6f-08f6544c8575",
                                                "sense_id": "a29af858-1f84-3c68-9264-9ae7ed69c805",
                                                "text": "[…] and, not knowing the meaning or misterie of her pollicie, forgat no termes of reproche or rigorous rebuke against his chast doughter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a996965f-46c5-3b84-9df3-ecd68652a1eb",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A religious truth not understandable by the application of human reason alone (without divine aid)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e15f69f-355a-48ea-a50f-291b32eaad0c",
                                                "sense_id": "a996965f-46c5-3b84-9df3-ecd68652a1eb",
                                                "text": "1744 (first printed), Jonathan Swift, A Sermon on the Trinity\nIf God should please to reveal unto us this great mystery of the Trinity, or some other mysteries in our holy religion, we should not be able to understand them, unless he would bestow on us some new faculties of the mind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d9453c6-ddc9-3cc0-a2fc-e797db3ae2d2",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A sacrament."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcceb77c-6ac8-471e-b5de-2e9dc1df0bf1",
                                                "sense_id": "0d9453c6-ddc9-3cc0-a2fc-e797db3ae2d2",
                                                "text": "There are seven mysteries, or sacraments, in the Greek church, viz. baptism, the chrism (a rite peculiar to this church), the eucharist, confession, ordination, marriage, and the holy oil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A secret religious celebration, admission to which was usually through initiation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a83738e-b464-403e-b1fa-a4bd99257552",
                                                "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                                "text": "the Eleusinian mysteries"
                                            },
                                            {
                                                "example_id": "65351919-0c10-4427-9915-e1b880cd128e",
                                                "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                                "text": "the Mysteries of Mithras"
                                            },
                                            {
                                                "example_id": "1ba7ccea-bccd-4843-897f-16c85e08f353",
                                                "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                                "text": "There’s no initiation either into such mysteries."
                                            },
                                            {
                                                "example_id": "00848fee-5f58-4f7a-8a4b-e85fe13f70eb",
                                                "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                                                "text": "It is, indeed, part of the ritual of the candidate for adeptship into the British mysteries, resembling that for the neophyte into the Osirian, Cabiric or Orphean mysteries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dfc7a04-d363-3b2b-84ff-6923346be989",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A particular event or series of events in the life of Christ."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e77f4d25-8ecc-4ad9-9ce5-12583120c7b8",
                                                "sense_id": "3dfc7a04-d363-3b2b-84ff-6923346be989",
                                                "text": "The second decade of the Rosary concerns the Sorrowful mysteries, such as the crucifixion and the crowning with thorns."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e775720b-470c-395e-add0-568a801f6425",
                                        "entry_id": "680f1120-13b0-394f-a776-58077876c687",
                                        "glosses": [
                                            "A craft, art or trade; specifically a guild of craftsmen."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41773170-c170-45e4-874d-08c11fcd7151",
                                                "sense_id": "e775720b-470c-395e-add0-568a801f6425",
                                                "text": "The trades, the crafts, the mysteries, would all be losers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed40c2f3-6141-41b1-9254-6821590fcdc6",
                        "source_entry_id": "2094ccc8-ae26-37c2-968a-97d03824127e",
                        "source_sense_id": "1f464a50-916b-3b4a-9d07-71dee1b7e62d",
                        "target_lang_word": "mystère",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mystère",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca42097d-e001-3c50-81c3-44d0374598d4",
                                        "entry_id": "6867fe41-904f-3985-8f6e-7f2bd24d25d2",
                                        "glosses": [
                                            "Ce qu’une religion a de plus caché, ce qui n’est connu que des initiés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cea65ee-bf0a-4b72-8b49-4e13ac04554c",
                                                "sense_id": "ca42097d-e001-3c50-81c3-44d0374598d4",
                                                "text": "Alliette est l’homme le plus heureux de la terre ; il ne parle que tarots, cartes, sortilèges, sciences égyptiennes de Thot, mystères isiaques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9eb52869-fba8-31ea-b661-a44fbc74af86",
                                        "entry_id": "6867fe41-904f-3985-8f6e-7f2bd24d25d2",
                                        "glosses": [
                                            "Vérité de foi contenue dans la révélation et qui, sans contredire la raison, la dépasse."
                                        ],
                                        "tags": [
                                            "Biblical",
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b1d210f-dbb3-4bf6-b1cd-f1d8141f57d3",
                                                "sense_id": "9eb52869-fba8-31ea-b661-a44fbc74af86",
                                                "text": "On peut considérer que la raison, incapable d’établir la possibilité intrinsèque des mystères révélés, telles que la Trinité, l’Incarnation, l’Eucharistie, la création ex nihilo, peut néanmoins établir qu’ils ne sont pas contradictoires […] Les mystères, étant supra-rationnels, ne sauraient être démontrés ; mais, comme ils ne sont pas pour cela anti-rationnels, les arguments qui tendent à établir qu’ils sont absurdes n’ont aucune valeur probante […]"
                                            },
                                            {
                                                "example_id": "d3b5a02d-0860-4738-b2f0-1ff29c8140ff",
                                                "sense_id": "9eb52869-fba8-31ea-b661-a44fbc74af86",
                                                "text": "Il est certain qu’ésotéristes et amateurs de mystère préféreront toujours continuer à considérer la question comme insoluble de façon technique. Car le mystère est une forme indéniable de plaisir, et qui s'autoexcite indéfiniment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d53ab51-d269-3475-8e14-abe0205955ec",
                                        "entry_id": "6867fe41-904f-3985-8f6e-7f2bd24d25d2",
                                        "glosses": [
                                            "Ce qu’il y a de caché, de secret, d'inconnaissable dans les phénomènes de la nature ; ce qui est inexplicable par la raison humaine."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4277f027-eab4-49e1-95bc-df97de48118e",
                                                "sense_id": "8d53ab51-d269-3475-8e14-abe0205955ec",
                                                "text": "Le mystère des perturbations de l’orbite de Mercure n'a finalement été élucidé qu'avec la théorie de la relativité générale proposée par Albert Einstein au début du XX^(ème) siècle."
                                            },
                                            {
                                                "example_id": "b2097778-a601-4798-b244-9cdd15a73d31",
                                                "sense_id": "8d53ab51-d269-3475-8e14-abe0205955ec",
                                                "text": "La grande forêt des Ardennes est une des plus chargée de mystères. […]. l'hiver, lorsque la neige a cessé de tomber depuis quelques jours, lorsque l'armée des sapins noirs immobiles se détache sur le sol blanc, le voyageur solitaire doit se défendre contre un sentiment de crainte, presque d'angoisse."
                                            },
                                            {
                                                "example_id": "3569705e-c075-4c28-b637-b92050a6eaaf",
                                                "sense_id": "8d53ab51-d269-3475-8e14-abe0205955ec",
                                                "text": "L’aporie est une espèce d’énigme, mais considérée d’un point de vue logique plutôt que magique ou spirituel. C’est un problème qu’on renonce à résoudre, au moins provisoirement, ou un mystère qu’on refuse d’adorer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a597985b-602c-3904-9925-3bed117de582",
                                        "entry_id": "6867fe41-904f-3985-8f6e-7f2bd24d25d2",
                                        "glosses": [
                                            "Ce qu’il y a de caché, de secret dans les affaires humaines."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03c7983-8ea7-42c9-97da-8141aac4a179",
                                                "sense_id": "a597985b-602c-3904-9925-3bed117de582",
                                                "text": "Jusqu’à cette nuit, aucune lumière accusatrice ne s’était échappée de ces deux âmes ; mais entre elles et Dieu certainement il s’élevait quelque sinistre mystère."
                                            },
                                            {
                                                "example_id": "2240cf32-9747-4dcf-a253-1a00eb116686",
                                                "sense_id": "a597985b-602c-3904-9925-3bed117de582",
                                                "text": "C’est comme cela. Moi aussi j’ai mes mystères, tout maire que je suis ; mais venez, je vais vous montrer autre chose."
                                            },
                                            {
                                                "example_id": "ded7e6e0-6434-42c6-b73e-76fb4c21a35c",
                                                "sense_id": "a597985b-602c-3904-9925-3bed117de582",
                                                "text": "Ce coin perdu de Jan-Mayen n’est pas à l’abri des cancans, des mystères, des intrigues et même des complications diplomatiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ff7a3d9-d8fc-3608-afbf-743be54a5b7e",
                                        "entry_id": "6867fe41-904f-3985-8f6e-7f2bd24d25d2",
                                        "glosses": [
                                            "Les soins, les précautions que l’on prend pour n’être pas entendu, pour n’être pas observé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a0e5443-8795-4187-a2c9-bcb7517892f6",
                                                "sense_id": "5ff7a3d9-d8fc-3608-afbf-743be54a5b7e",
                                                "text": "Je donnai même à ce mutisme un air d’imbécillité pour laisser Mauricette expliquer elle-même son mystère."
                                            },
                                            {
                                                "example_id": "402f8dfb-b060-477f-b57e-a41f3c6c080e",
                                                "sense_id": "5ff7a3d9-d8fc-3608-afbf-743be54a5b7e",
                                                "text": "Il m’a entretenu, avec beaucoup de mystère, de tous ses chagrins. - Ils sont sortis tous deux en grand mystère."
                                            },
                                            {
                                                "example_id": "754cab50-5985-42af-bbfc-026c9b934940",
                                                "sense_id": "5ff7a3d9-d8fc-3608-afbf-743be54a5b7e",
                                                "text": "Pourquoi faire tant de mystère pour nous dire ce que tout le monde sait ? - Faut-il faire tant de mystère pour si peu de chose ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d0649ea-74b1-3236-81a4-da7ebb226f8b",
                                        "entry_id": "6867fe41-904f-3985-8f6e-7f2bd24d25d2",
                                        "glosses": [
                                            "Composante du rosaire."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "29d9b756-bbd5-3ef8-b2fc-f1dd03893d57",
                                        "entry_id": "6867fe41-904f-3985-8f6e-7f2bd24d25d2",
                                        "glosses": [
                                            "Nom que l’on donnait, au Moyen Âge, à certaines pièces de théâtre, d’inspiration religieuse, dont le sujet était tiré des Écritures ou de la vie des saints."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a275adf-a594-4426-b62f-0b1a9cd31b5d",
                                                "sense_id": "29d9b756-bbd5-3ef8-b2fc-f1dd03893d57",
                                                "text": "Tour à tour commencent à défiler les pages, les rois, les anges, les saintes, qui paraissent jouer un de nos vieux mystères avec, comme décor, la cathédrale."
                                            },
                                            {
                                                "example_id": "e65892ab-5cd3-4705-b5fe-c2318c529765",
                                                "sense_id": "29d9b756-bbd5-3ef8-b2fc-f1dd03893d57",
                                                "text": "Ce jour-là, il devait y avoir feu de joie à la Grève, plantation de mai à la chapelle de Braque et mystère au Palais de Justice."
                                            },
                                            {
                                                "example_id": "33b94bdb-1e85-426a-8da8-914a064deb68",
                                                "sense_id": "29d9b756-bbd5-3ef8-b2fc-f1dd03893d57",
                                                "text": "Pour la poésie dramatique en langue vulgaire, sa partie religieuse, le mystère et le miracle, se rattachait aux mystères latins antérieurs, qui eux-mêmes étaient une partie du culte, et tenaient à cet ensemble de représentations théâtrales que l’église avait empruntées originairement au paganisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
