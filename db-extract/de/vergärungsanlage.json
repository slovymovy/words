                "senses": [
                    {
                        "sense_id": "1e3a620f-311d-367f-a8e0-3a1995ce7c89",
                        "entry_id": "d5e13a93-7a5b-330d-967b-496463fffe5a",
                        "glosses": [
                            "Anlage für die Vergärung von organischem Abfall oder biologischen Rohstoffen; ohne Sauerstoffverbrauch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31049626-6f15-4c87-98ff-474849116e90",
                                "sense_id": "1e3a620f-311d-367f-a8e0-3a1995ce7c89",
                                "text": "„Mit der Vergärungsanlage werden rund 11 Millionen Kilowattstunden Strom im Jahr erzeugt.“"
                            },
                            {
                                "example_id": "e0b3f2b0-9b64-4262-bec3-ce6f1a32ef41",
                                "sense_id": "1e3a620f-311d-367f-a8e0-3a1995ce7c89",
                                "text": "„Erfahrungen mit der Konzeption und dem Betrieb einer Grüngut-Vergärungsanlage im Verbund mit der Kompostierung und der energetischen Nutzung von Holz“"
                            },
                            {
                                "example_id": "717d63d1-4352-45a3-8091-40745b2e4316",
                                "sense_id": "1e3a620f-311d-367f-a8e0-3a1995ce7c89",
                                "text": "„Der Abfallwirtschaftsbetrieb des Landkreises Böblingen betreibt seit Anfang 2005 in Leonberg eine hochmoderne Vergärungsanlage.“"
                            },
                            {
                                "example_id": "1df6fd97-6f61-45dd-a946-a115842f2983",
                                "sense_id": "1e3a620f-311d-367f-a8e0-3a1995ce7c89",
                                "text": "„Große Mengen dieser Abfälle können in Vergärungsanlagen unter Erzeugung von regenerativer Energie wirtschaftlich verwertet werden.“"
                            },
                            {
                                "example_id": "33e8ef97-8408-477d-a85e-ac16ba3983a5",
                                "sense_id": "1e3a620f-311d-367f-a8e0-3a1995ce7c89",
                                "text": "„Darüber hinaus wird von einem BHKW am Standort der Biokompostierungsanlage die Vergärungsanlage mit Prozesswärme versorgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
