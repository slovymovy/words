{
    "word_family": [
        "lively",
        "liveliness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1a146866-d921-3408-a678-9df77935081d",
                    "sense_definition": "A means of securing the necessities of life, such as a job, trade, or source of income.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "income_means",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many fishermen along the coast depend on tourism for their primary <w>livelihood</w>.",
                            "target_lang_translations": {
                                "es": "Muchos pescadores a lo largo de la costa dependen del turismo como su principal <w>sustento</w>."
                            }
                        },
                        {
                            "text": "The factory closure threatened to destroy the <w>livelihoods</w> of hundreds of local workers.",
                            "target_lang_translations": {
                                "es": "El cierre de la fábrica amenazaba con destruir los <w>medios de subsistencia</w> de cientos de trabajadores locales."
                            }
                        }
                    ],
                    "synonyms": [
                        "living",
                        "subsistence",
                        "sustenance"
                    ],
                    "common_phrases": [
                        "earn a livelihood",
                        "source of livelihood",
                        "threaten someone's livelihood",
                        "lose one's livelihood"
                    ],
                    "target_lang_definitions": {
                        "es": "Medio de conseguir lo necesario para vivir, como un trabajo, oficio o fuente de ingresos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "sustento",
                                "target_lang_sense_clarification": "alimento o medios para mantenerse"
                            },
                            {
                                "target_lang_word": "medios de subsistencia",
                                "target_lang_sense_clarification": "recursos económicos para vivir"
                            },
                            {
                                "target_lang_word": "modo de vida",
                                "target_lang_sense_clarification": "fuente de ingresos u ocupación"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "501b1193-a6e4-3125-8c8b-61ba664a67e4",
                    "sense_definition": "An estate or piece of landed property that provides an income.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "income_means",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He inherited a modest <w>livelihood</w> from his uncle that sustained him through his studies.",
                            "target_lang_translations": {
                                "es": "Heredó una modesta <w>propiedad</w> de su tío que lo sostuvo durante sus estudios."
                            }
                        },
                        {
                            "text": "The family lost their ancestral <w>livelihood</w> during the prolonged political upheaval.",
                            "target_lang_translations": {
                                "es": "La familia perdió su <w>patrimonio</w> ancestral durante la prolongada agitación política."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in standard modern use"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Finca o propiedad de tierras que produce rentas o ingresos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "propiedad",
                                "target_lang_sense_clarification": "finca o patrimonio rentable"
                            },
                            {
                                "target_lang_word": "renta",
                                "target_lang_sense_clarification": "beneficio o patrimonio que produce ingresos"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "723a86b6-1300-3d58-b414-29fe6fa46077",
                    "sense_definition": "Liveliness, animation, or the visible appearance of life or vigor.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Prolonged illness had drained all the <w>livelihood</w> from her once radiant face.",
                            "target_lang_translations": {
                                "es": "La prolongada enfermedad había drenado toda la <w>vitalidad</w> de su rostro antaño radiante."
                            }
                        },
                        {
                            "text": "The cold weather seemed to take the <w>livelihood</w> out of the tired travelers.",
                            "target_lang_translations": {
                                "es": "El clima frío parecía quitarles la <w>vivacidad</w> a los cansados viajeros."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "superseded by liveliness"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Vivacidad, animación o apariencia visible de vida o vigor."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vivacidad",
                                "target_lang_sense_clarification": "vitalidad o energía visible"
                            },
                            {
                                "target_lang_word": "vitalidad",
                                "target_lang_sense_clarification": "fuerza o animación de vida"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5636f904-e113-3959-8516-445297eaa5a0",
                    "sense_definition": "The course of a person's life, a lifetime, or personal conduct and manner of living.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Old tales described the honorable <w>livelihood</w> of the knight throughout his earthly years.",
                            "target_lang_translations": {
                                "es": "Viejos relatos describían la conducta <w>intachable</w> del caballero a lo largo de sus años terrenales."
                            }
                        },
                        {
                            "text": "His entire <w>livelihood</w> was characterized by devout service to his community.",
                            "target_lang_translations": {
                                "es": "Todo su <w>modo de vivir</w> se caracterizó por un devoto servicio a su comunidad."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "no longer in modern use"
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "El curso de la vida de una persona, duración de vida o conducta y modo de vivir."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "modo de vivir",
                                "target_lang_sense_clarification": "conducta o forma de vida"
                            },
                            {
                                "target_lang_word": "conducta",
                                "target_lang_sense_clarification": "comportamiento a lo largo de la vida"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}