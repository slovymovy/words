                "translations": [
                    {
                        "translation_id": "42b99921-c6f8-4788-b553-184419d62569",
                        "source_entry_id": "76b64176-f519-353d-921a-24b2c7fd8518",
                        "source_sense_id": "727d74c1-35ad-3867-ac10-0d2bfadbc549",
                        "source_sense_description": "veraltet: wachsen, an Menge/ Größe/ Anzahl zunehmen",
                        "target_lang_word": "wachsen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wachsen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a50edb50-a742-3f0f-aba1-a4c74a5ea2b9",
                                        "entry_id": "8b656243-5f8c-3096-b4a5-ca970f4eded6",
                                        "glosses": [
                                            "allmählich größer werden; von der Größe, vom Umfang her zunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f3ab63-ab4c-4dc8-bacd-a24aa2ba80ac",
                                                "sense_id": "a50edb50-a742-3f0f-aba1-a4c74a5ea2b9",
                                                "text": "Kleine Kinder wachsen schnell."
                                            },
                                            {
                                                "example_id": "dd0d3ea1-b9e8-409b-bff8-ca5efcce89cb",
                                                "sense_id": "a50edb50-a742-3f0f-aba1-a4c74a5ea2b9",
                                                "text": "„Er wurde in dieser Zeit noch einsamer, und er wurde immer aggressiver, denn seine Angst wuchs.“"
                                            },
                                            {
                                                "example_id": "ae0840d1-00cb-483d-9c22-9838a72dd344",
                                                "sense_id": "a50edb50-a742-3f0f-aba1-a4c74a5ea2b9",
                                                "text": "Seine beiden Hunde sind in letzter Zeit ziemlich gewachsen."
                                            },
                                            {
                                                "example_id": "d2a24ade-30dc-4225-96e1-6e8b8782dc5b",
                                                "sense_id": "a50edb50-a742-3f0f-aba1-a4c74a5ea2b9",
                                                "text": "Das rasant wachsende Unkraut muss gejätet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7856a2dc-a178-3a02-994d-41872114f8c2",
                                        "entry_id": "8b656243-5f8c-3096-b4a5-ca970f4eded6",
                                        "glosses": [
                                            "sich im Laufe des Wachsens^([1]) entwickeln; an einer bestimmten Stelle vorkommen und gedeihen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2e4d60e-39bf-48fb-9aa2-f947e278be11",
                                                "sense_id": "7856a2dc-a178-3a02-994d-41872114f8c2",
                                                "text": "Maiglöckchen wachsen im Wald."
                                            },
                                            {
                                                "example_id": "17b2992d-e54a-4ca1-b0ad-efc792589f50",
                                                "sense_id": "7856a2dc-a178-3a02-994d-41872114f8c2",
                                                "text": "Diese Baumart wächst auf feuchtem Boden am besten."
                                            },
                                            {
                                                "example_id": "50185c9c-6814-4deb-885e-82d0bc55fa47",
                                                "sense_id": "7856a2dc-a178-3a02-994d-41872114f8c2",
                                                "text": "Im Wald wachsen viele Beeren."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "5b7e6c32-b56f-30cf-8cfe-6146e43aeb53",
                                        "entry_id": "8b656243-5f8c-3096-b4a5-ca970f4eded6",
                                        "glosses": [
                                            "im Laufe der Zeit länger werden; an Länge gewinnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57593da1-c923-4608-ba2b-388ff8a790e6",
                                                "sense_id": "5b7e6c32-b56f-30cf-8cfe-6146e43aeb53",
                                                "text": "Seine Fingernägel wachsen schnell."
                                            },
                                            {
                                                "example_id": "7729d723-9191-4caa-8a09-17bb91c01524",
                                                "sense_id": "5b7e6c32-b56f-30cf-8cfe-6146e43aeb53",
                                                "text": "An Karls Hinterhaupt wachsen noch einige Haare, ansonsten ist er kahl."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "e86dcf08-5ef1-3fa3-8a61-534e68cc56cc",
                                        "entry_id": "8b656243-5f8c-3096-b4a5-ca970f4eded6",
                                        "glosses": [
                                            "sich in gewisser Weise im Wachstum entwickeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f68be6a3-2c1c-4b4a-9899-d71a35693171",
                                                "sense_id": "e86dcf08-5ef1-3fa3-8a61-534e68cc56cc",
                                                "text": "Der Baum muss beschnitten werden, denn er wächst bereits in den Garten meines Nachbarn."
                                            },
                                            {
                                                "example_id": "1d108d69-5e63-4a4d-a88b-7b41f75f1997",
                                                "sense_id": "e86dcf08-5ef1-3fa3-8a61-534e68cc56cc",
                                                "text": "Meine Pflanze ist fast bis an die Decke gewachsen."
                                            },
                                            {
                                                "example_id": "8d51e02d-b980-4ea2-a757-2d638570595d",
                                                "sense_id": "e86dcf08-5ef1-3fa3-8a61-534e68cc56cc",
                                                "text": "Die Tanne ist schief gewachsen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "50830b4a-7fe3-3116-8d49-6167be3e797c",
                                        "entry_id": "8b656243-5f8c-3096-b4a5-ca970f4eded6",
                                        "glosses": [
                                            "in der Größe, in der Menge, im Ausmaß steigen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7651cc30-a9ba-4380-96b1-23f121bedcb0",
                                                "sense_id": "50830b4a-7fe3-3116-8d49-6167be3e797c",
                                                "text": "Das Vermögen des Milliardärs wächst stetig."
                                            },
                                            {
                                                "example_id": "74cd3346-f8c8-4dea-97c0-68b5ddee6f38",
                                                "sense_id": "50830b4a-7fe3-3116-8d49-6167be3e797c",
                                                "text": "Die Stadt ist in den letzten Jahren stark gewachsen."
                                            },
                                            {
                                                "example_id": "6cca5da2-7866-4ee1-a846-871d4d02aea9",
                                                "sense_id": "50830b4a-7fe3-3116-8d49-6167be3e797c",
                                                "text": "Ziel ist es, die wachsende Arbeitslosenquote zu bekämpfen."
                                            },
                                            {
                                                "example_id": "bae1cfb8-17d4-4f64-9deb-d2271c54c461",
                                                "sense_id": "50830b4a-7fe3-3116-8d49-6167be3e797c",
                                                "text": "Die wachsende Zahl an Infektionen deutet auf eine Durchseuchung hin."
                                            },
                                            {
                                                "example_id": "8023d99a-1eaf-409b-aa45-a6397e95b071",
                                                "sense_id": "50830b4a-7fe3-3116-8d49-6167be3e797c",
                                                "text": "„So wuchs das Feld der Starter zwar Jahr um Jahr, aber zunächst sehr langsam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "d25e4310-6c5f-3c1f-89b1-cb0a3c585977",
                                        "entry_id": "8b656243-5f8c-3096-b4a5-ca970f4eded6",
                                        "glosses": [
                                            "von der Stärke, von der Bedeutung her zunehmen"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df6745cc-e3c5-4d78-9826-6fcb62413559",
                                                "sense_id": "d25e4310-6c5f-3c1f-89b1-cb0a3c585977",
                                                "text": "„Am schnellsten wächst der Einfluss des Islam. Das heißt, in globaler Perspektive kann man überhaupt nicht vom Verschwinden der Religion reden.“"
                                            },
                                            {
                                                "example_id": "46fd8d70-d27c-4192-b1a9-10fd11d81e78",
                                                "sense_id": "d25e4310-6c5f-3c1f-89b1-cb0a3c585977",
                                                "text": "„Aber der immer wachsende Lärm wurde bald so grell und furchtbar, daß er glaubte, die ganze Hölle sei los.“"
                                            },
                                            {
                                                "example_id": "98225f09-bc34-47c9-8bb8-bc795f1d05f1",
                                                "sense_id": "d25e4310-6c5f-3c1f-89b1-cb0a3c585977",
                                                "text": "„Sie sind motivierter, beschäftigen sich immer intensiver damit und Ihre Begeisterung wächst.“"
                                            },
                                            {
                                                "example_id": "6d168026-356c-480a-a73d-31e5ce6bc470",
                                                "sense_id": "d25e4310-6c5f-3c1f-89b1-cb0a3c585977",
                                                "text": "„Der Frieden wächst, wie Rosen blühn, so bunt, so schön, so still.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
                                "target_word": "wachsen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29c8c10d-2984-3a3e-a8f2-15cd620085d7",
                                        "entry_id": "e18260f6-bbd1-3799-a59c-8d0394bf0581",
                                        "glosses": [
                                            "mit Wachs behandeln"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "757bf1d4-e04c-4c5f-aa30-b6e2a9ab69dc",
                                                "sense_id": "29c8c10d-2984-3a3e-a8f2-15cd620085d7",
                                                "text": "Die Möbel wurden nicht lackiert, sondern gewachst."
                                            },
                                            {
                                                "example_id": "abc39cb3-8653-4605-85a1-6b04b40513ea",
                                                "sense_id": "29c8c10d-2984-3a3e-a8f2-15cd620085d7",
                                                "text": "„Er knabberte nämlich gern an einer rohen Möhre, nachdem er das Auto gewachst und poliert hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
