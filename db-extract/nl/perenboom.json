                                        "sense_id": "1ce5c93e-e2c0-3746-85b4-b79427c7370b",
                                        "entry_id": "ea860050-395a-309d-b7c8-4b12d50d80e7",
                                        "glosses": [
                                            "wczasy pod gruszą"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6981d02d-6e8e-4de4-9b29-edfe9cd0dd06",
                                                "sense_id": "1ce5c93e-e2c0-3746-85b4-b79427c7370b",
                                                "text": "Pieniążki za gruszę przeznaczyliśmy na wypożyczenie kajaków."
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
                                    {
                                        "sense_id": "ee5d6a5b-f0a0-3b1a-b209-bb813b6a63c4",
                                        "entry_id": "ea860050-395a-309d-b7c8-4b12d50d80e7",
                                        "glosses": [
                                            "pieniądze wypłacane przez pracodawcę za wczasy pod gruszą"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e1d75385-84b2-4007-8f77-e93e93500272",
                                                "sense_id": "ee5d6a5b-f0a0-3b1a-b209-bb813b6a63c4",
                                                "text": "Dostałyśmy gruszę i wreszcie mogłam zamówić pokoje w Murzasichlu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b6ace26-5fb7-4b16-86f9-98b04b2c6d3b",
                        "source_entry_id": "6bc28b20-ab27-3685-aa1b-128c9c8a84b6",
                        "source_sense_id": "a8f1e22c-d486-312e-aa5f-f832b2d594fc",
                        "source_sense_description": "een boom met peren als vrucht",
                        "target_lang_word": "груша",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "груша",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0bbfc5a4-4166-3726-91a7-2a757fffc177",
                                        "entry_id": "d02f6c57-de11-3ec0-b101-b08ec30d886f",
                                        "glosses": [
                                            "ботан. плодовое дерево или кустарник семейства розоцветных"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54330cd-fd24-41fa-b69d-3c9eb4ad3bc7",
                                                "sense_id": "0bbfc5a4-4166-3726-91a7-2a757fffc177",
                                                "text": "Высокая груша с пирамидальною верхушкою и трепещущими листьями зеленела перед домом."
                                            },
                                            {
                                                "example_id": "53e9a6a2-91b3-495e-82bb-bee670b5d9dd",
                                                "sense_id": "0bbfc5a4-4166-3726-91a7-2a757fffc177",
                                                "text": "У входа в садик Поповых стояла старая-старая груша, ещё более старая, чем книга, и Анатолий очень любил эту грушу и эту книгу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52a8c515-2700-32ca-a487-5e4b65f3bef4",
                                        "entry_id": "d02f6c57-de11-3ec0-b101-b08ec30d886f",
                                        "glosses": [
                                            "плод груши [1], сладкий или терпкий фрукт, в т. ч. собир."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1e1a8e7-1bc1-476e-a2e2-340498419dfe",
                                                "sense_id": "52a8c515-2700-32ca-a487-5e4b65f3bef4",
                                                "text": "На первой машине лежало большое краснобокое яблоко, на второй — спелая груша, на третьей машине помещалось с полдесятка слив."
                                            },
                                            {
                                                "example_id": "b1131268-899e-4231-800c-3c9a199064f4",
                                                "sense_id": "52a8c515-2700-32ca-a487-5e4b65f3bef4",
                                                "text": "Компот ассорти готовят, добавляя к персикам сливы, абрикосы, груши и яблоки в произвольных пропорциях."
                                            },
                                            {
                                                "example_id": "1dd079e9-32bc-4916-a855-1ead3605c33a",
                                                "sense_id": "52a8c515-2700-32ca-a487-5e4b65f3bef4",
                                                "text": "Картошку, морковь, даже лук привозили сюда в сушёном виде. Яблоки, груша, вишня тоже сушёные. О свежих овощах и фруктах и не мечтали."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44abce07-1c5d-3678-ba6b-2830ed030599",
                                        "entry_id": "d02f6c57-de11-3ec0-b101-b08ec30d886f",
                                        "glosses": [
                                            "древесина груши [1]"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52733519-b27c-4ed2-b8b2-2d2bcb19eef0",
                                                "sense_id": "44abce07-1c5d-3678-ba6b-2830ed030599",
                                                "text": "Ты знаешь, что из груши делают деки аматиевских скрипок."
                                            },
                                            {
                                                "example_id": "e4be583e-97f8-4729-8de0-f7d9835a7292",
                                                "sense_id": "44abce07-1c5d-3678-ba6b-2830ed030599",
                                                "text": "Груша. Цвет розовато-бурый. Древесина плотная, прочная и твёрдая, сильно усыхает, но не коробится и не растрескивается."
                                            },
                                            {
                                                "example_id": "100dbb6b-f44c-4b25-94b2-431a0c45b5b4",
                                                "sense_id": "44abce07-1c5d-3678-ba6b-2830ed030599",
                                                "text": "Столы, комоды, кресла из груши, отделанные кожей .."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd2f6748-75d2-301d-9b3e-75b461b9a29e",
                                        "entry_id": "d02f6c57-de11-3ec0-b101-b08ec30d886f",
                                        "glosses": [
                                            "спорт. спортивный снаряд, используемый для тренировки боксёров и прочих единоборцев, представляет собой подвешенную либо другим образом закреплённую оболочку, наполненную песком или другим подобным материалом, по которой наносят удары"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52cdb4d0-22f9-4499-9745-b307ab7456f6",
                                                "sense_id": "dd2f6748-75d2-301d-9b3e-75b461b9a29e",
                                                "text": "Традиционная тренировочная программа боксёров включает работу с мешком, грушей, лапами, спарринг и т. д."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52e54996-20fa-3625-92f1-83f3ec2aaa4c",
                                        "entry_id": "d02f6c57-de11-3ec0-b101-b08ec30d886f",
                                        "glosses": [
                                            "перен. любой предмет, по форме напоминающий плод груши [2], то есть округлый, продолговатый, сужающийся с одного конца и образующий массивное круглое утолщение с другого; иначе говоря, грушевидный"
                                        ],
                                        "tags": [
                                            "чего., какая."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3449dae1-d395-481c-8bd9-f569a527dd67",
                                                "sense_id": "52e54996-20fa-3625-92f1-83f3ec2aaa4c",
                                                "text": "Интересно отметить, что до самой революции в доме Тарасовых для вызова дворников звонки были не электрические, а воздушные ― за розеткой кнопки находилась большая резиновая груша, от неё шла тонкая свинцовая трубка к звонку, при нажатии кнопки воздух нажимал язычок звонка и колебал его."
                                            },
                                            {
                                                "example_id": "8658047d-c1ef-4873-9643-7185da35b006",
                                                "sense_id": "52e54996-20fa-3625-92f1-83f3ec2aaa4c",
                                                "text": "В щёголевской спальне валялась бумажная рвань, один из чемоданов был раскрыт, и в нём сверху лежала на вафельном полотенце резиновая груша."
                                            },
                                            {
                                                "example_id": "20bfbe8a-7613-45fd-a5a3-97adbc6144fe",
                                                "sense_id": "52e54996-20fa-3625-92f1-83f3ec2aaa4c",
                                                "text": "Для предотвращения разрыва груши в гидроаккумуляторе необходимо регулярно проверять состояние мембраны бака и правильность давления воздуха в системе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6dd5b49c-fe0e-3dea-abb9-f762ba1c5356",
                                        "entry_id": "d02f6c57-de11-3ec0-b101-b08ec30d886f",
                                        "glosses": [
                                            "крим. жарг. большой навесной замок"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
