                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "катетер",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "e5fb8ead-8efd-3363-96bf-cefed81f10e8",
                                        "entry_id": "3f26af57-b55c-3b89-9e1d-e288da5bdabf",
                                        "glosses": [
                                            "мед. медицинский инструмент в виде трубки, предназначенный для сообщения естественных каналов, полостей тела, сосудов с внешней средой с целью их опорожнения, введения в них жидкостей, промывания, либо проведения через них хирургических инструментов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1695edeb-1a05-42bb-baf4-86d69ebb86d7",
                                                "sense_id": "e5fb8ead-8efd-3363-96bf-cefed81f10e8",
                                                "text": "Чтобы не делать детям 18 уколов в день — три раза по шесть внутривенных инъекций — такова технология лечения, — им были введены специальные подключичные катетеры."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
