                                            {
                                                "example_id": "e8684fd7-71fc-4123-8a77-8c66f39b9cc5",
                                                "sense_id": "7f436bc5-72d6-3504-b7b6-8745b3740a05",
                                                "text": "He is a tempter of married women."
                                            }
