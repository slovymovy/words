                        "translation_id": "7a837aaf-f19d-4a4d-9710-39600c5d3cff",
                        "source_entry_id": "b9d91da6-9a70-3657-95bc-a8b38fc589f0",
                        "source_sense_id": "1e3e5563-c843-38df-a076-7637f093c5d8",
                        "target_lang_word": "abuse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "832f87fc-45bb-391c-b803-a2aa1371308e",
                                        "entry_id": "59d50fac-daf1-3653-9588-3560fb6b57f2",
                                        "glosses": [
                                            "Improper treatment or usage; application to a wrong or bad purpose; an unjust, corrupt or wrongful practice or custom."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48459933-1a81-4c6f-8ba8-c65980527890",
                                                "sense_id": "832f87fc-45bb-391c-b803-a2aa1371308e",
                                                "text": "human rights abuses"
                                            },
                                            {
                                                "example_id": "f59c1526-951c-40c2-8bd3-e776651584dc",
                                                "sense_id": "832f87fc-45bb-391c-b803-a2aa1371308e",
                                                "text": "All abuse, whether physical, verbal, psychological or sexual, is bad."
                                            },
                                            {
                                                "example_id": "2f2cd287-03cd-4e8f-877b-f5763bc0db51",
                                                "sense_id": "832f87fc-45bb-391c-b803-a2aa1371308e",
                                                "text": "Dickens was careful to castigate abuses which were being reformed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "174a88c2-99dc-3ceb-bfaf-35f0b35b376d",
                                        "entry_id": "59d50fac-daf1-3653-9588-3560fb6b57f2",
                                        "glosses": [
                                            "Misuse; improper use; perversion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0dc71500-a1b8-4eb3-b4d3-7d26854565a8",
                                                "sense_id": "174a88c2-99dc-3ceb-bfaf-35f0b35b376d",
                                                "text": "Liberty may be endangered by the abuses of liberty, as well as by the abuses of power."
                                            },
                                            {
                                                "example_id": "93f0371f-f1cc-44cc-9007-b67ff9a8ea28",
                                                "sense_id": "174a88c2-99dc-3ceb-bfaf-35f0b35b376d",
                                                "text": "Few concepts are as emotionally charged as that of race. The word conjures up a mixture of associations—culture, ethnicity, genetics, subjugation, exclusion and persecution. But is the tragic history of efforts to define groups of people by race really a matter of the misuse of science, the abuse of a valid biological concept?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d1fcf60-7475-37f1-88c2-e768e00b05e2",
                                        "entry_id": "59d50fac-daf1-3653-9588-3560fb6b57f2",
                                        "glosses": [
                                            "A delusion; an imposture; misrepresentation; deception."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8728bb9-ef10-4707-b379-139f8e0e6896",
                                                "sense_id": "8d1fcf60-7475-37f1-88c2-e768e00b05e2",
                                                "text": "Or is it some abuse, and no such thing?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ceb2c0ff-62b7-3a84-9f1e-d4df8ac952a8",
                                        "entry_id": "59d50fac-daf1-3653-9588-3560fb6b57f2",
                                        "glosses": [
                                            "Coarse, insulting speech; abusive language; language that unjustly or angrily vilifies."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cfb9820-ac99-4029-a182-8532ac0abaff",
                                                "sense_id": "ceb2c0ff-62b7-3a84-9f1e-d4df8ac952a8",
                                                "text": "The two parties, after exchanging a good deal of abuse, came to blows."
                                            },
                                            {
                                                "example_id": "afb62d05-6d04-4691-b0d8-b080ea05a0e6",
                                                "sense_id": "ceb2c0ff-62b7-3a84-9f1e-d4df8ac952a8",
                                                "text": "But he and all the southerners who indulge in this abuse in the newspapers should realize that this will not enable us to find a solution to our problem but will merely aggravate it."
                                            },
                                            {
                                                "example_id": "58444c9a-4b3a-42b0-b828-7c68b2182f71",
                                                "sense_id": "ceb2c0ff-62b7-3a84-9f1e-d4df8ac952a8",
                                                "text": "The pair – aged 14 and 15 years old – have been accused of assaulting and shouting abuse at four people in central Southampton, police have said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f776a47-cfd8-3398-9c2b-c41e597b1cb3",
                                        "entry_id": "59d50fac-daf1-3653-9588-3560fb6b57f2",
                                        "glosses": [
                                            "Catachresis."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a4b3b45b-8051-3703-9c6e-bfeaa544e091",
                                        "entry_id": "59d50fac-daf1-3653-9588-3560fb6b57f2",
                                        "glosses": [
                                            "Physical maltreatment; injury; cruel treatment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ffe4057-a484-3a29-95b4-0387df7d86e7",
                                        "entry_id": "59d50fac-daf1-3653-9588-3560fb6b57f2",
                                        "glosses": [
                                            "Violation; defilement; rape; forcing of undesired sexual activity by one person on another, often on a repeated basis."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "abuse",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47d9cbe4-0e2c-368f-89cb-ae5284fa71d1",
                                        "entry_id": "d39b0016-80b1-309d-af10-af49f46f7bab",
                                        "glosses": [
                                            "To put to a wrong use; to misapply; to use improperly; to use for a wrong purpose or end; to pervert"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ceb6ec22-049c-4d39-a1a2-8bbbc4fd33bb",
                                                "sense_id": "47d9cbe4-0e2c-368f-89cb-ae5284fa71d1",
                                                "text": "He abused his authority."
                                            },
                                            {
                                                "example_id": "691ef316-35c8-4d2c-8c73-223703c80c5a",
                                                "sense_id": "47d9cbe4-0e2c-368f-89cb-ae5284fa71d1",
                                                "text": "This principle (if we may so abuse the word) shot rapidly into popularity"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a6181ba-bec2-32dd-b5ad-f15dc5bb29eb",
                                        "entry_id": "d39b0016-80b1-309d-af10-af49f46f7bab",
                                        "glosses": [
                                            "To injure; to maltreat; to hurt; to treat with cruelty, especially repeatedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "899755d2-4635-4279-b574-fc925bb82120",
                                                "sense_id": "4a6181ba-bec2-32dd-b5ad-f15dc5bb29eb",
                                                "text": "And I would have things to say to this God at the judgement, storming at him, as Job stormed with the eloquence of the abused heart."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4a930ab-b5ae-30b0-abd2-4e6b89cfdff9",
                                        "entry_id": "d39b0016-80b1-309d-af10-af49f46f7bab",
                                        "glosses": [
                                            "To attack with coarse language; to insult; to revile; malign; to speak in an offensive manner to or about someone; to disparage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74f42a8b-a574-4197-a6cf-79144f90dd19",
                                                "sense_id": "f4a930ab-b5ae-30b0-abd2-4e6b89cfdff9",
                                                "text": "The […] tellers of news abused the general."
                                            },
                                            {
                                                "example_id": "d746e5e7-421a-44a9-94fe-88b7225d0bc7",
                                                "sense_id": "f4a930ab-b5ae-30b0-abd2-4e6b89cfdff9",
                                                "text": "But ever and always curse him and abuse him."
                                            },
                                            {
                                                "example_id": "914c7ed0-228d-417f-8265-ef90bd7e63d7",
                                                "sense_id": "f4a930ab-b5ae-30b0-abd2-4e6b89cfdff9",
                                                "text": "So we were angered by this and we could not tolerate this one because prophet Mohammed has been abused so many times in this country. Awolowo abused him sometimes ago saying that he was more successful and popular that Mohammed and Jesus."
                                            },
                                            {
                                                "example_id": "b95780e1-b0dc-4dca-9992-57b57e49380c",
                                                "sense_id": "f4a930ab-b5ae-30b0-abd2-4e6b89cfdff9",
                                                "text": "However, shortages have seen customers yelling at employees, and abusing staff members as they work frantically to keep up with demand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da240316-a636-34b0-8d47-d3ba26097a22",
                                        "entry_id": "d39b0016-80b1-309d-af10-af49f46f7bab",
                                        "glosses": [
                                            "To imbibe a drug for a purpose other than it was intended; to intentionally take more of a drug than was prescribed for recreational reasons; to take illegal drugs habitually."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "32ce62f6-fb8c-393f-baae-6a88c3fc64b0",
                                        "entry_id": "d39b0016-80b1-309d-af10-af49f46f7bab",
                                        "glosses": [
                                            "To violate; defile; to rape; (reflexive) to masturbate."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3f57de2d-6ef1-43d7-a949-60c3337c252f",
                                                "sense_id": "32ce62f6-fb8c-393f-baae-6a88c3fc64b0",
                                                "text": "Like Angels life was then mens happy cace;\nBut later ages pride, like corn-fed ſteed,\nAbuſd her plenty, and fat ſwolne encreace\nTo all licentious luſt, and gan exceed"
                                            },
                                            {
                                                "example_id": "81699cb1-1823-4c4a-bdd6-03762660a294",
                                                "sense_id": "32ce62f6-fb8c-393f-baae-6a88c3fc64b0",
                                                "text": "This the Holy Scripture teaches, as expreſly as may be; Neither Fornicators, ſays St. Paul, nor Adulterers, nor the Abominable, ſhall inherit the Kingdom of God; cautioning alſo at the ſame time, that we don’t abuſe our ſelves, nor flatter our ſelves in this Reſpect."
                                            },
                                            {
                                                "example_id": "88c8e4d1-8adb-4291-937b-2ef7dcdcba9e",
                                                "sense_id": "32ce62f6-fb8c-393f-baae-6a88c3fc64b0",
                                                "text": "Through “wantonness,” or just by being “idle and alone,” or by the instruction of intimates, the young learn to abuse themselves without learning how wrong and dangerous it is."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2aeaf3c8-f222-3a88-934a-7df2e7e848e4",
                                        "entry_id": "d39b0016-80b1-309d-af10-af49f46f7bab",
                                        "glosses": [
                                            "Misrepresent; adulterate."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "54e7f2c6-6abe-4ca8-9f48-01a1462a5250",
                                                "sense_id": "2aeaf3c8-f222-3a88-934a-7df2e7e848e4",
                                                "text": "Believe me, sir, he hath been abused, grossly abused to you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "298372d2-67cf-3735-9e32-ea29d557e754",
                                        "entry_id": "d39b0016-80b1-309d-af10-af49f46f7bab",
                                        "glosses": [
                                            "To deceive; to trick; to impose on; misuse the confidence of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "297ec05f-7f1c-44ea-9ad6-a581df01a4dd",
                                                "sense_id": "298372d2-67cf-3735-9e32-ea29d557e754",
                                                "text": "1651-2, Jeremy Taylor, \"Sermon VI, The House of Feasting; or, The Epicures Measures\", in The works of Jeremy Taylor, Volume 1, page 283 (1831), edited by Thomas Smart Hughes\nWhen Cyrus had espied Astyages and his fellows coming drunk from a banquet loaden with variety of follies and filthiness, their legs failing them, their eyes red and staring, cozened with a moist cloud and abused by a double object"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aefcd217-d6a9-3f29-8448-642b4a113043",
                                        "entry_id": "d39b0016-80b1-309d-af10-af49f46f7bab",
                                        "glosses": [
                                            "Disuse."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
