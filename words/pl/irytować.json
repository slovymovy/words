                            },
                            {
                                "target_lang_word": "нервничать",
                                "target_lang_sense_clarification": "испытывать беспокойство или раздражение"
                            },
                            {
                                "target_lang_word": "злиться",
                                "target_lang_sense_clarification": "испытывать злость"
                            }
                        ]
