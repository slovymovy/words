                        "examples": [
                            {
                                "example_id": "234c7075-5df7-4253-a98e-3562ee42da68",
                                "sense_id": "9d26bdbe-c597-310b-934e-1602bcb1ea7b",
                                "text": "Il lui incombait d’allumer la calbombe, ou la camoufle, c’est-à-dire la lampe à pétrole."
                            },
                            {
                                "example_id": "75d8cd8a-2f8e-4a94-8c3d-14e1d2a61d35",
                                "sense_id": "9d26bdbe-c597-310b-934e-1602bcb1ea7b",
                                "text": "Baissez votre calbombe, mon vieux, je rétorque, vous allez me causer un décollement de la rétine."
                            },
                            {
                                "example_id": "5765c864-181d-4787-81f2-9fbf10ea73a1",
                                "sense_id": "9d26bdbe-c597-310b-934e-1602bcb1ea7b",
                                "text": "Armand éteint rapidos la calbombe des gogs, retient son souffle."
                            }
                        ]
                    },
                    {
                        "sense_id": "90993732-243e-3489-b8a6-72322a68fa2a",
                        "entry_id": "2759be19-0b23-3a79-9b8e-936d735f019a",
