                    },
                    {
                        "translation_id": "31b6e1d1-8ba7-43a3-ae79-e4f59b2e6570",
                        "source_entry_id": "2e7e39ab-e6a4-305c-a3f6-25d10708242b",
                        "source_sense_id": "575e0f9a-7531-32d8-84f5-02ccf81aaae9",
                        "target_lang_word": "demeanor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demeanor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ab51f17-692d-3f09-95f3-ca737a08bd54",
                                        "entry_id": "c306ae12-b756-3de3-ae19-fc9ee6b505ce",
                                        "glosses": [
                                            "The social, non-verbal behaviours (such as body language and facial expressions) that are characteristic of a person."
                                        ],
                                        "tags": [
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b56b14bb-b922-4745-a9c3-3d4a3c02db12",
                                                "sense_id": "6ab51f17-692d-3f09-95f3-ca737a08bd54",
                                                "text": "The man's demeanor made others suspicious of his intentions."
                                            },
                                            {
                                                "example_id": "7644a054-7ba7-488f-8bd1-44c9772cb43b",
                                                "sense_id": "6ab51f17-692d-3f09-95f3-ca737a08bd54",
                                                "text": "A confident demeanor is crucial for persuading others."
                                            },
                                            {
                                                "example_id": "1f0feb78-4414-42bf-9f88-4ffca3001230",
                                                "sense_id": "6ab51f17-692d-3f09-95f3-ca737a08bd54",
                                                "text": "At this present (saith he) certeine princes of Britaine, procuring by ambassadors and dutifull demeanors the amitie of the emperour Augustus, haue offered in the capitoll vnto the gods presents or gifts, and haue ordeined the whole Ile in a manner to be appertinent, proper, and familiar to the Romans."
                                            },
                                            {
                                                "example_id": "e6245f38-1a7e-4c24-b57a-d32268df53dd",
                                                "sense_id": "6ab51f17-692d-3f09-95f3-ca737a08bd54",
                                                "text": "Demeanors that are apologetic and overly polite are inherently contradictory to demeanors that exhibit fear and anger."
                                            },
                                            {
                                                "example_id": "3f0c858b-a00a-476f-9ada-da596233eb36",
                                                "sense_id": "6ab51f17-692d-3f09-95f3-ca737a08bd54",
                                                "text": "He kept up his cheerful demeanor. It wouldn't do for any of the holocams to see him looking irritable, for any recordings of such a response would appear on the news broadcasts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
