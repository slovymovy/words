                        "source_sense_id": "be08e7e8-cd54-360d-aef2-66378bf44b17",
                        "source_sense_description": "Tor, das zum Verschließen einer Garage dient",
                        "target_lang_word": "garagedeur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garagedeur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "c6c65304-60d8-35da-ac6f-da7e117b4268",
                                        "entry_id": "9c12cc6c-8e63-304d-a128-24d378e144e5",
                                        "glosses": [
                                            "een deur die toegang geeft tot de garage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5583b858-287b-44a1-bd95-ea6aa107ada3",
                                                "sense_id": "c6c65304-60d8-35da-ac6f-da7e117b4268",
                                                "text": "De auto was te hoog en kon niet door de garagedeur naar binnen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "983aca1e-e02f-4ba7-812e-a0a7a1abe770",
                        "source_entry_id": "e7b5deb9-39da-3abc-b678-c4fc8881c12a",
                        "source_sense_id": "be08e7e8-cd54-360d-aef2-66378bf44b17",
                        "source_sense_description": "Tor, das zum Verschließen einer Garage dient",
                        "target_lang_word": "garagepoort",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "garagepoort",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "723e86d7-56ef-3db7-8607-f50341e000ea",
                                        "entry_id": "2a2ead3e-5dff-3867-8961-31c9b13628f0",
                                        "glosses": [
                                            "de grote deur van een garage die geschikt is om een auto doorheen te laten rijden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d01c56ba-4bc2-45f4-99ab-7b3b3c4630f3",
                                                "sense_id": "723e86d7-56ef-3db7-8607-f50341e000ea",
                                                "text": "De daders schoten op de garagepoort van de woning, maar daarachter bevond zich een leefruimte, volgens de burgemeester een geïmproviseerde keuken. Daar zaten op het moment van de beschieting familieleden, onder wie kinderen."
                                            },
                                            {
                                                "example_id": "fd4ea0d5-8acf-4625-8e9b-e1830a153f65",
                                                "sense_id": "723e86d7-56ef-3db7-8607-f50341e000ea",
                                                "text": "Je huis automatiseren is 'the next big thing'. Van slimme thermostaten, intelligente lampen tot zelfrijdende stofzuigers: alle tech-giganten zijn er druk mee bezig. Maar je kunt je afvragen waarom het nodig is om op afstand je garagepoort, deur, lichten, televisie en auto te kunnen bedienen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
