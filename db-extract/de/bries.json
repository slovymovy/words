                ],
                "senses": [
                    {
                        "sense_id": "37728ae3-9fc4-3ef4-8277-66258dc451a4",
                        "entry_id": "b0718bce-0eea-3837-acab-249301f793ac",
                        "glosses": [
                            "lymphatisches Organ, hinter dem oberen Brustbein gelegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b778e923-cd6f-4fff-a0c5-0dedc40dc9f8",
                                "sense_id": "37728ae3-9fc4-3ef4-8277-66258dc451a4",
                                "text": "Briese findet man nur noch selten auf den Speisekarten."
                            },
                            {
                                "example_id": "53d3193c-7340-40ce-bc72-9073770d8f9f",
                                "sense_id": "37728ae3-9fc4-3ef4-8277-66258dc451a4",
                                "text": "Als Bries, Kalbsbries oder Kalbsmilch wird die das Wachstum steuernde Thymusdrüse aus dem Brustkorb des Kalbs bezeichnet."
                            },
                            {
                                "example_id": "3637fed0-6abb-4c38-8bc9-ed2eca90981a",
                                "sense_id": "37728ae3-9fc4-3ef4-8277-66258dc451a4",
                                "text": "„Die schmackhafte Thymusdrüse des Kalbes, die in einigen Landschaften überhaupt nicht als Speise betrachtet wird, heißt in Bayern Bries, im Bremischen Midder, im Nordwestdeutschen Schweser, Milcher und Milch und anderswo wieder Bröschen.“"
                            },
                            {
                                "example_id": "a2f15b9b-da1c-4e6c-bd43-856fb2661c5c",
                                "sense_id": "37728ae3-9fc4-3ef4-8277-66258dc451a4",
                                "text": "„Es gab Hasensuppe und gesottenen Steinbutt und gedämpftes Bries und schwarzgeräucherten Schinken mit Madeirasauce und gebratenen Fasan und eine Rumomelette und Käse und Obst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb1f5625-365c-4d7c-ad0f-dd08d0dcd416",
                        "source_entry_id": "b0718bce-0eea-3837-acab-249301f793ac",
                        "source_sense_id": "37728ae3-9fc4-3ef4-8277-66258dc451a4",
                        "source_sense_description": "lymphatisches Organ, hinter dem oberen Brustbein gelegen",
                        "target_lang_word": "thymus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thymus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f98ae36-0311-3bdb-b79a-7c9025c1ad53",
                                        "entry_id": "6eacfe0f-667f-343a-bbc5-0299d4302a23",
                                        "glosses": [
                                            "Ellipsis of thymus gland (“A ductless gland, consisting mainly of lymphatic tissue, located behind the top of the breastbone. It is most active during puberty, after which it shrinks in size. It plays an important role in the development of the immune system and produces lymphocytes.”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75ef47ba-5dd9-4a91-be7b-e4703f14fd1a",
                                                "sense_id": "0f98ae36-0311-3bdb-b79a-7c9025c1ad53",
                                                "text": "For a very long time the role of the thymus in the body was a complete mystery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9d29724-6028-44c8-94cb-1ec378ac7413",
                        "source_entry_id": "b0718bce-0eea-3837-acab-249301f793ac",
                        "source_sense_id": "37728ae3-9fc4-3ef4-8277-66258dc451a4",
                        "source_sense_description": "lymphatisches Organ, hinter dem oberen Brustbein gelegen",
                        "target_lang_word": "thymus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thymus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61bbfaa5-ae69-35ec-a8bd-2448d79c1e69",
                                        "entry_id": "b778188b-fe3e-370c-baa9-12a69d4ad68b",
                                        "glosses": [
                                            "Organe lymphoïde situé dans le médiastin, entre le sternum et la trachée, qui sert de lieu de maturation aux lymphocytes T et joue un rôle dans la protection contre l’auto-immunité. Très développé pendant l’enfance, son volume décroît après la deuxième année de la vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "602fd4f0-f347-4035-883e-28810cab9941",
                                                "sense_id": "61bbfaa5-ae69-35ec-a8bd-2448d79c1e69",
                                                "text": "On a rencontré […] des thymus anormaux par leur persistance et leur volume chez des tuberculeux et des syphilitiques […]"
                                            },
                                            {
                                                "example_id": "261c3dec-fd55-4702-b0a3-d177f6aa2a3e",
                                                "sense_id": "61bbfaa5-ae69-35ec-a8bd-2448d79c1e69",
                                                "text": "Le thymus, qui est formé chez le nouveau-né et le jeune enfant de deux lobes aplatis débordant en haut du sternum, s’atrophie avec la progression de l’âge […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39b2c981-6638-3b91-8989-6785e17e73f9",
                                        "entry_id": "b778188b-fe3e-370c-baa9-12a69d4ad68b",
                                        "glosses": [
                                            "Ris de veau ou d’agneau."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "51403e4d-a825-4eb0-a1ca-3fae8914c47d",
