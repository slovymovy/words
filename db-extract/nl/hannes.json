        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "511f9132-7805-3d7e-a1e7-da64aefcf0c4",
                "word": "hannes",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "0bf2a431-cafd-4894-9aea-f77b75d20a70",
                        "entry_id": "511f9132-7805-3d7e-a1e7-da64aefcf0c4",
                        "tags": [
                            "plural"
                        ],
                        "form": "hannessen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "12e3e84f-8921-36fc-becc-e7ce153fafb3",
                        "entry_id": "511f9132-7805-3d7e-a1e7-da64aefcf0c4",
                        "glosses": [
                            "dummy, idiot, twerp"
                        ],
                        "tags": [
                            "Netherlands",
                            "masculine",
                            "no-diminutive"
                        ],
                        "examples": [
                            {
                                "example_id": "77892dd0-68cb-4e4b-94bf-bc04f1481c05",
                                "sense_id": "12e3e84f-8921-36fc-becc-e7ce153fafb3",
                                "text": "Stomme hannes! grommelde Verhoef, de kooi latend om voor ’t raam te gaan, waar hij bleef uitzien naar wat er sedert de morgen veranderd was."
                            },
                            {
                                "example_id": "2b3ab8ce-ec7c-49d3-8f58-99e070f04396",
                                "sense_id": "12e3e84f-8921-36fc-becc-e7ce153fafb3",
                                "text": "Men wuifde hem vrolijk weg en achterna en uit de kreten als ‘sullige jongen’ en ‘goeie hannes’, die achter de deur die hij behoedzaam sloot opklonken, begreep hij dat zijn optreden instemming had gewekt."
                            },
                            {
                                "example_id": "24bce7b8-22f0-46ba-9114-1e37045fe27a",
                                "sense_id": "12e3e84f-8921-36fc-becc-e7ce153fafb3",
                                "text": "Als iemand jou uitscheldt voor hannes, hufter of nog erger, dan knik je de man of vrouw die jou dat toeroept, vriendelijk en begripvol toe en beaamt dat hij of zij gelijk heeft."
                            },
                            {
                                "example_id": "2f16fe38-1d44-421d-a5d8-2c484f061f7e",
                                "sense_id": "12e3e84f-8921-36fc-becc-e7ce153fafb3",
                                "text": "Dat ben je nou precies, een wandelende vogelverschrikker, een uitgerekte pier, een hannes, een lummel!"
                            }
                        ]
                    }
                ],
