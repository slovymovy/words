                        "source_entry_id": "fcbdee35-bfec-364b-bf75-7786ccb211a6",
                        "source_sense_id": "f898cf38-b6bd-370a-acc3-9b7a7c89a4e3",
                        "source_sense_description": "zetmeel verkregen uit de wortelknol van Manihot esculenta",
                        "target_lang_word": "tapioca",
