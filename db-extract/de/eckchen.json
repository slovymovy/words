                "senses": [
                    {
                        "sense_id": "c53e9639-a06a-35ec-832c-573e901df63f",
                        "entry_id": "be594a50-4b01-3dbf-89b6-ea92d233cd36",
                        "glosses": [
                            "kleine Ecke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4feb663a-dbc6-4b85-966a-5a3a3bdc40e4",
                                "sense_id": "c53e9639-a06a-35ec-832c-573e901df63f",
                                "text": "„Gegen zwei Uhr nachmittags war sie jedesmal in das Vorzimmer des Schatzmeisters zurückgekehrt, wo sie sich in ihrem Eckchen einem tiefen Schlaf überließ.“"
                            },
                            {
                                "example_id": "396bf6ce-5fa3-44c2-a226-b242b8658081",
                                "sense_id": "c53e9639-a06a-35ec-832c-573e901df63f",
                                "text": "„Rostow und Iljin sahen sich schleunigst nach einem Eckchen um, in welchem sie ihr nasses Zeug wechseln könnten, ohne Marja Genrichownas Schamgefühl zu nahe zu treten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
