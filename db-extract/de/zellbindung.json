                "senses": [
                    {
                        "sense_id": "4bbe2ca1-d6d6-3ab8-93bc-0678c1b8aa6f",
                        "entry_id": "964009c9-1ceb-3982-b449-3794a2f6d095",
                        "glosses": [
                            "Kopplung/Kontakt zwischen einer Zelle und einem Stoff/Protein/Antigen über einen Zellrezeptor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65b8c2a8-0dd1-4ec9-9884-df9abfdac3de",
                                "sense_id": "4bbe2ca1-d6d6-3ab8-93bc-0678c1b8aa6f",
                                "text": "„Die Zellbindungen sind physiologischen starken Kräften ausgesetzt, zum Beispiel der Hydrodynamik, wenn Zellen die Blutbahn verlassen müssen. Immunzellen entwickeln deshalb besonders hohe Adhäsionskraft.“"
                            },
                            {
                                "example_id": "bd4d236a-c78b-414e-b7ed-8de7aafd999e",
                                "sense_id": "4bbe2ca1-d6d6-3ab8-93bc-0678c1b8aa6f",
                                "text": "„Eine starke Rolle bei der Zellanhaftung konnte für die Matriline nicht nachgewiesen werden. Verglichen mit einem klassischen Zellanhaftungsprotein (Fibronectin) sind für Zellbindungen auf Matrilinen wesentlich höhere Beschichtungskonzentrationen nötig und die beobachteten Bindungen laufen ohne die klassischen Merkmale der Zellanhaftung, wie fokale Kontakte und Umorganisation des Zytoskeletts ab.“"
                            },
                            {
                                "example_id": "f234df3a-3631-40a9-9ebc-8841c7a6bd1a",
                                "sense_id": "4bbe2ca1-d6d6-3ab8-93bc-0678c1b8aa6f",
                                "text": "„In vitro Methoden (Zellbindung, Internalisierung) sind für die Beurteilung von Tumoraffinität und Nebenwirkungen radioaktiv markierten Substanzen nicht ausreichend.“"
                            },
                            {
                                "example_id": "caba4d59-09b4-41fa-849e-26f9489c84ef",
                                "sense_id": "4bbe2ca1-d6d6-3ab8-93bc-0678c1b8aa6f",
                                "text": "„Die für die Zellbindung maßgebliche Struktur ist in den Domänen C3 bzw. C4 lokalisiert.“"
                            },
                            {
                                "example_id": "c9f6b952-d4cb-402e-91e3-e15fa6a57ca1",
                                "sense_id": "4bbe2ca1-d6d6-3ab8-93bc-0678c1b8aa6f",
                                "text": "„Diese drei Bilder zeigen die Virus-Zellbindung als ersten Schritt einer viralen Infektion […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
