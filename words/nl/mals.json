{
    "word_family": [
        "malsem",
        "malseheid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "4035b5a5-e758-3a7a-9193-a5e82204f90d",
                    "sense_definition": "Zacht en sappig, vooral gezegd van eten zoals vlees of groenten.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het biefstukje dat we gisteren aten was ontzettend <w>mals</w>.",
                            "target_lang_translations": {
                                "fr": "L'steak que nous avons mangé hier était extrêmement <w>tendre</w>.",
                                "en": "The steak we ate yesterday was incredibly <w>tender</w>."
                            }
                        },
                        {
                            "text": "Voor een <w>mals</w> stukje vlees moet je het vlees op lage temperatuur garen.",
                            "target_lang_translations": {
                                "fr": "Pour un morceau de viande <w>tendre</w>, il faut le cuire à basse température.",
                                "en": "For a <w>tender</w> cut of meat, you should cook the meat at a low temperature."
                            }
                        }
                    ],
                    "synonyms": [
                        "zacht",
                        "sappig"
                    ],
                    "antonyms": [
                        "taai",
                        "droog"
                    ],
                    "common_phrases": [
                        "mals stukje vlees",
                        "een malse biefstuk"
                    ],
                    "target_lang_definitions": {
                        "fr": "Tendre et juteux, surtout en parlant de la nourriture comme la viande ou les légumes.",
                        "en": "Soft and juicy, especially said of food such as meat or vegetables."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "tendre",
                                "target_lang_sense_clarification": "pour la viande ou les aliments"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "tender",
                                "target_lang_sense_clarification": "soft and easy to chew, of food"
                            },
                            {
                                "target_lang_word": "juicy",
                                "target_lang_sense_clarification": "succulent and tender"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d9ea071-463f-3f08-8dce-a06889c790e7",
                    "sense_definition": "Heftig, streng of niet gering (vrijwel altijd gebruikt in de ontkennende vorm 'niet mals').",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De vragen op het examen waren niet <w>mals</w>.",
                            "target_lang_translations": {
                                "fr": "Les questions de l'examen étaient plutôt <w>corsées</w>.",
                                "en": "The questions on the exam were <w>no joke</w>."
                            }
                        },
                        {
                            "text": "Hij kreeg een niet <w>malse</w> boete voor het te hard rijden.",
                            "target_lang_translations": {
                                "fr": "Il a reçu une amende <w>salée</w> pour excès de vitesse.",
                                "en": "He got a <w>hefty</w> fine for speeding."
                            }
                        }
                    ],
                    "synonyms": [
                        "gepeperd",
                        "streng",
                        "pittig"
                    ],
                    "antonyms": [
                        "mild",
                        "zacht"
                    ],
                    "common_phrases": [
                        "niet mals",
                        "geen malse straf"
                    ],
                    "target_lang_definitions": {
                        "fr": "Intense, sévère ou pas mince (presque toujours utilisé sous la forme négative 'niet mals').",
                        "en": "Severe, harsh, or substantial (almost exclusively used in the negative 'niet mals')."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "corsé",
                                "target_lang_sense_clarification": "sévere ou intense"
                            },
                            {
                                "target_lang_word": "salé",
                                "target_lang_sense_clarification": "élevé, en parlant d'une amende ou facture"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "hefty",
                                "target_lang_sense_clarification": "of a fine or punishment"
                            },
                            {
                                "target_lang_word": "steep",
                                "target_lang_sense_clarification": "of prices, fines, or demands"
                            },
                            {
                                "target_lang_word": "severe",
                                "target_lang_sense_clarification": "of criticism, questions, or punishment"
                            },
                            {
                                "target_lang_word": "no joke",
                                "target_lang_sense_clarification": "not mild or easy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac91bda7-fa28-3be6-a78d-d4c598dbe6c0",
                    "sense_definition": "Partitief van de stellende trap van <w>mal</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er is iets <w>mals</w> aan zijn vreemde gedrag.",
                            "target_lang_translations": {
                                "fr": "Il y a quelque chose <w>de bizarre</w> dans son comportement étrange.",
                                "en": "There is something <w>strange</w> about his odd behavior."
                            }
                        },
                        {
                            "text": "Ze vertelde iets <w>mals</w> over haar maffe buurman.",
                            "target_lang_translations": {
                                "fr": "Elle a raconté quelque chose <w>de gratiné</w> sur son voisin fou.",
                                "en": "She told something <w>wild</w> about her eccentric neighbor."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "partitief"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Forme partitive de l'adjectif 'mal' (bizarre, fou).",
                        "en": "Partitive form of the adjective 'mal' (strange, foolish, silly)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "de bizarre",
                                "target_lang_sense_clarification": "chose étrange ou folle"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "strange",
                                "target_lang_sense_clarification": "odd or peculiar"
                            },
                            {
                                "target_lang_word": "weird",
                                "target_lang_sense_clarification": "unusual or bizarre"
                            },
                            {
                                "target_lang_word": "foolish",
                                "target_lang_sense_clarification": "silly or nonsensical"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}