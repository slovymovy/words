                ],
                "senses": [
                    {
                        "sense_id": "f98ce908-87ca-3624-b89f-4c12b12bd395",
                        "entry_id": "741d0ecf-2b83-3f3f-b135-9dc08123e162",
                        "glosses": [
                            "See in Norddeutschland, genauer: in Mecklenburg-Vorpommern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b1c329a-05ec-4494-b4c4-30beb83a43e1",
                                "sense_id": "f98ce908-87ca-3624-b89f-4c12b12bd395",
                                "text": "„Die Nikolaikirche der Neustadt hat einen 70 Meter hohen Turm, der einen fantastischen Blick über den See und die Landschaft rund um die Müritz eröffnet.“"
                            },
                            {
                                "example_id": "1b464d71-9fde-41e0-9ae0-eeec3f462ccd",
                                "sense_id": "f98ce908-87ca-3624-b89f-4c12b12bd395",
                                "text": "„Der größte vollständig zum deutschen Staatsgebiet gehörende See ist die Müritz, die Teil der mecklenburgischen Seenplatte ist.“"
                            },
                            {
                                "example_id": "fc5c5a1f-3426-43ff-8ec3-f3196edd9ff3",
                                "sense_id": "f98ce908-87ca-3624-b89f-4c12b12bd395",
                                "text": "„Mit mehr als 110 Quadratkilometern Fläche ist die Müritz der größte deutsche Binnensee und lockt zahlreiche Wassersportler an.“"
                            },
                            {
                                "example_id": "70944543-5af4-47b2-8670-10ad2dd1818e",
                                "sense_id": "f98ce908-87ca-3624-b89f-4c12b12bd395",
                                "text": "„Als Teil der Mecklenburgischen Seenplatte gehört die Müritz zu einem weit verzweigten Netz von Wasserstraßen.“"
                            },
                            {
                                "example_id": "d0cf4624-5037-4998-b1f5-591af3c3695c",
                                "sense_id": "f98ce908-87ca-3624-b89f-4c12b12bd395",
                                "text": "„Die etwa 30 Kilometer lange und 13 Kilometer breite Wasserfläche der Müritz entstand während der jüngsten Eiszeit.“"
                            },
                            {
                                "example_id": "e18c7ab1-d864-48d9-95d2-31560f632890",
                                "sense_id": "f98ce908-87ca-3624-b89f-4c12b12bd395",
                                "text": "„Touristisches Zentrum an der Müritz ist Waren.“"
                            },
                            {
                                "example_id": "a1e01829-9631-4b63-8788-33361af067c8",
                                "sense_id": "f98ce908-87ca-3624-b89f-4c12b12bd395",
                                "text": "„Die Müritz und ihre Wasserstraßen lassen sich am besten vom Wasser aus erkunden - beispielsweise mit einem gemieteten Boot.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
