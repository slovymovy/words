                                                "sense_id": "d71b1910-a2ca-3682-8d90-a2050c94c7a7",
                                                "text": "the Bucephalus which he bestrode"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d055e38f-25a3-320a-ad7c-7f8b8108652b",
                                        "entry_id": "27d9a1d1-b9cc-307a-8def-007f1bcef1ae",
                                        "glosses": [
                                            "That which is the greatest of its kind."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e8e98a5-5d8c-46b5-bc0e-838383c1f58f",
                                                "sense_id": "d055e38f-25a3-320a-ad7c-7f8b8108652b",
                                                "text": "It will suffice to say that when I started on my journey into the realms of lexicography, I regarded Kʻang Hsi as a Bucephalus on whose tail — 蠅附龭尾 — a foreign fly might safely get an advantageous lift."
                                            }
