                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9c0845e-2084-42a5-8004-05e2d56e3538",
                                "sense_id": "cc5ab5f2-453a-3ac4-b921-66585bbf790d",
                                "text": "По но́вым пра́вилам боеву́ю кровь на́до бы́ло заверя́ть у нота́риуса, собра́в свиде́тельства трёх однополча́н.",
                                "translation": "Under the new rules you had to have the blood of battle certified by a notary, after collecting corroborating testimony from three of your regimental comrades.",
                                "english": "Under the new rules you had to have the blood of battle certified by a notary, after collecting corroborating testimony from three of your regimental comrades."
                            }
                        ]
                    }
