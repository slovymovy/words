                        "target_lang_word": "Kuhfladen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kuhfladen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f2b48477-99a0-3d5f-8d99-6f64321055f3",
                                        "entry_id": "72f65728-4f49-3304-b432-4e1107db877e",
                                        "glosses": [
                                            "eine einzelne Darmausscheidung einer Kuh"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb5c246a-bb21-4153-87be-46dd653092e6",
                                                "sense_id": "f2b48477-99a0-3d5f-8d99-6f64321055f3",
                                                "text": "„Ein typischer Kuhfladen hat einen Durchmesser von etwa 30 cm und wiegt nass bis zu zwei Kilogramm.“"
                                            },
                                            {
                                                "example_id": "6bf8ca22-6959-4e19-b48a-9be742fda1a1",
                                                "sense_id": "f2b48477-99a0-3d5f-8d99-6f64321055f3",
                                                "text": "„Dort waren ausgetretene, verschlungene Pfade, die nach frischen Kuhfladen rochen.“"
                                            },
                                            {
                                                "example_id": "6c74fac2-02e1-4c3e-b5d9-e7564d698cf2",
                                                "sense_id": "f2b48477-99a0-3d5f-8d99-6f64321055f3",
                                                "text": "„Wegen des Regens waren die Kuhfladen nicht getrocknet und ein penetranter Geruch nach Kuhmist lag in der Luft.“"
                                            },
                                            {
                                                "example_id": "2ee3cbf5-d92a-45a6-abd3-4fba238d4af2",
                                                "sense_id": "f2b48477-99a0-3d5f-8d99-6f64321055f3",
                                                "text": "„Ein Kuhfladen hat eine Ameise unter sich begraben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67c32e99-2468-437f-80b3-24de802c810d",
                        "source_entry_id": "8d0fe596-d6fb-3525-a255-c0b8a6c7575a",
