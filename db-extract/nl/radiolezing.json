                            {
                                "example_id": "da19759b-aed3-40e8-8902-247d4f062af1",
                                "sense_id": "91125db8-357c-38e0-ab58-4acd35859fd3",
                                "text": "1 0 Ondanks de gloedvolle woorden over arbeidsvreugde, dienst aan de gemeenschap en een menselijke samenleving was het duidelijk wat Herweijer in zijn radiolezing bedoelde met zijn 'heroriëntering op technisch terrein', namelijk een zo groot mogelijke gelijkschakeling van de Nederlandse technische wereld aan die van nazi-Duitsland."
                            },
                            {
                                "example_id": "446bfc6a-e817-495d-847a-1fba920a2422",
                                "sense_id": "91125db8-357c-38e0-ab58-4acd35859fd3",
                                "text": "Daarom had hij bij zijn radiolezing van 11 januari 1941 de besturen van de verschillende technische verenigingen ernstig gewaarschuwd dat zij niet moesten meedoen aan acties om de nieuwe volksorde op technisch gebied te saboteren."
                            }
                        ]
