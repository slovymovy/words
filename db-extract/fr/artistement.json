        "fr-extract.jsonl": [
            {
                "entry_id": "7c8c5eb4-b799-3b9e-b654-8854c62cb2cd",
                "word": "artistement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                        "entry_id": "7c8c5eb4-b799-3b9e-b654-8854c62cb2cd",
                        "glosses": [
                            "Avec art ; avec habileté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d96baf3-d46e-4c3f-b9be-da081d1fd261",
                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                "text": "Les crins sont artistement faits, car il faut ou élargir le membre trop grêle ou déguiser l’arqure acquise ou innée ; […]."
                            },
                            {
                                "example_id": "60df4816-a5c8-4db1-b022-d59595e1d3d8",
                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                "text": "Il est a voir comment à Paris le pilori des grandes halles est artistement disposé pour contraindre le pilorié à montrer sa face à la foule, accourue pour le huer, l'injurier, remplir le vœu de la loi."
                            },
                            {
                                "example_id": "c7027f54-c84f-48c9-808b-c5281e3d2bef",
                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                "text": "D'autres plus badins comparent l’évidence à une lanterne magique, qui, au moyen de quelques rayons de lumière artistement dirigés dans les ténébres, donne un air de dignité à des tableaux, qui, remis au grand jour, ne présentent plus que le barbouillage d'un mauvais peintre."
                            },
                            {
                                "example_id": "dcdadab5-4189-4fc5-8e74-e5e6c0b4338f",
                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                "text": "Par la fenêtre de la salle de bains artistement aménagée, il jette un regard sur le jardin…"
                            },
                            {
                                "example_id": "8dcfa0a0-3646-48ab-a8ac-6958ddfa9d34",
                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                "text": "Regardons le latin comme un superbe édifice détruit par le temps, mais dont les pierres artistement retaillées ont servi à construire un nouvel édifice."
                            },
                            {
                                "example_id": "ec668172-ff59-473b-a0fe-ca241c649544",
                                "sense_id": "b13881a0-ff12-3d08-9411-8d6c94717cd4",
                                "text": "Il vous mène à l’arbre, cueille artistement cette prune exquise, il l’ouvre…"
                            }
                        ]
                    }
                ],
                "translations": [
