{
    "word_family": [
        "теневой",
        "тенёк",
        "затенять",
        "оттенять"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "225f1413-5def-33a7-8a91-24dd5beae4e8",
                    "sense_definition": "участок поверхности или область пространства, скрытые от прямых лучей света",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "light_and_dark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сейчас очень жарко, поэтому нам лучше уйти в <w>тень</w>.",
                            "target_lang_translations": {
                                "nl": "Het is nu erg heet, dus we kunnen beter in de <w>schaduw</w> gaan staan."
                            }
                        },
                        {
                            "text": "Лунные затмения происходят, когда Луна входит в <w>тень</w> Земли.",
                            "target_lang_translations": {
                                "nl": "Maanverduisteringen vinden plaats wanneer de maan in de <w>schaduw</w> van de aarde komt."
                            }
                        }
                    ],
                    "common_phrases": [
                        "уйти в тень",
                        "сидеть в тени"
                    ],
                    "target_lang_definitions": {
                        "nl": "plek of ruimte die beschut is tegen direct zonlicht"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schaduw",
                                "target_lang_sense_clarification": "beschutting tegen de zon"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7203b605-61e4-3da6-92b7-ada12581864d",
                    "sense_definition": "тёмный силуэт, формируемый на освещённой поверхности объектом",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "light_and_dark",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В полдень <w>тени</w> становятся очень короткими.",
                            "target_lang_translations": {
                                "nl": "Tegen de middag worden de <w>schaduwen</w> heel kort."
                            }
                        },
                        {
                            "text": "Я увидел длинную <w>тень</w> на стене старого дома.",
                            "target_lang_translations": {
                                "nl": "Ik zag een lange <w>schaduw</w> op de muur van het oude huis."
                            }
                        }
                    ],
                    "common_phrases": [
                        "отбрасывать тень",
                        "длинная тень"
                    ],
                    "target_lang_definitions": {
                        "nl": "donker silhouet dat door een belicht voorwerp op een oppervlak wordt geworpen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schaduw",
                                "target_lang_sense_clarification": "donker silhouet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdcc6472-0d5a-3a36-a70a-ac4962e9cd70",
                    "sense_definition": "косметическое средство для век",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "cosmetics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она наложила на веки <w>тени</w> в тон своему платью.",
                            "target_lang_translations": {
                                "nl": "Ze bracht <w>oogschaduw</w> aan die paste bij haar jurk."
                            }
                        },
                        {
                            "text": "Эти <w>тени</w> очень хорошо подходят к её глазам.",
                            "target_lang_translations": {
                                "nl": "Deze <w>oogschaduw</w> past heel goed bij haar ogen."
                            }
                        }
                    ],
                    "common_phrases": [
                        "наложить тени",
                        "тени для век"
                    ],
                    "target_lang_definitions": {
                        "nl": "cosmetisch product om op de oogleden aan te brengen"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "oogschaduw",
                                "target_lang_sense_clarification": "make-up voor de oogleden"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "796738e6-16ec-3586-b90c-90a6c2117956",
                    "sense_definition": "слабый признак или намёк на что-либо",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы подавали заявку без <w>тени</w> надежды на успех.",
                            "target_lang_translations": {
                                "nl": "We dienden de aanvraag in zonder een <w>spoor</w> van hoop op succes."
                            }
                        },
                        {
                            "text": "В его словах не было ни <w>тени</w> сомнения.",
                            "target_lang_translations": {
                                "nl": "In zijn woorden was geen enkel <w>spoor</w> van twijfel te bekennen."
                            }
                        }
                    ],
                    "synonyms": [
                        "намёк"
                    ],
                    "common_phrases": [
                        "без тени сомнения"
                    ],
                    "target_lang_definitions": {
                        "nl": "zeer klein spoor of vage aanduiding van iets"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spoor",
                                "target_lang_sense_clarification": "vleugje, zweem"
                            },
                            {
                                "target_lang_word": "zweem",
                                "target_lang_sense_clarification": "zeer lichte aanduiding"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7dcc7593-4b37-3a02-9108-61f95bb23e87",
                    "sense_definition": "призрак или душа умершего человека",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "supernatural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старом замке часто видели <w>тень</w> давно умершего графа.",
                            "target_lang_translations": {
                                "nl": "In het oude kasteel werd vaak de <w>schim</w> van de lang geleden overleden graaf gezien."
                            }
                        },
                        {
                            "text": "Древние греки верили, что <w>тени</w> умерших обитают в подземном царстве Аида.",
                            "target_lang_translations": {
                                "nl": "De oude Grieken geloofden dat de <w>schimmen</w> van de doden in het onderaardse rijk van Hades verbleven."
                            }
                        }
                    ],
                    "synonyms": [
                        "призрак",
                        "дух",
                        "привидение",
                        "фантом"
                    ],
                    "target_lang_definitions": {
                        "nl": "geestverschijning of schim van een overledene"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schim",
                                "target_lang_sense_clarification": "geest van een dode"
                            },
                            {
                                "target_lang_word": "geest",
                                "target_lang_sense_clarification": "spook, verschijning"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "505fd1e3-c1e0-30e9-861e-9272941994f0",
                    "sense_definition": "подозрение в чём-либо дурном",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта история бросает <w>тень</w> на его безупречную репутацию.",
                            "target_lang_translations": {
                                "nl": "Dit verhaal werpt een <w>schaduw</w> op zijn vlekkeloze reputatie."
                            }
                        },
                        {
                            "text": "Никакая <w>тень</w> не должна падать на честное имя компании.",
                            "target_lang_translations": {
                                "nl": "Er mag geen enkele <w>smet</w> vallen op de goede naam van het bedrijf."
                            }
                        }
                    ],
                    "common_phrases": [
                        "бросать тень",
                        "тень подозрения"
                    ],
                    "target_lang_definitions": {
                        "nl": "argwaan of blaam die iemands reputatie aantast"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "smet",
                                "target_lang_sense_clarification": "blaam op reputatie"
                            },
                            {
                                "target_lang_word": "schaduw",
                                "target_lang_sense_clarification": "figuurlijk, van verdenking"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76ad69c3-5f79-3dc1-8c9a-351aaaf43195",
                    "sense_definition": "экономическая деятельность, скрываемая от государства",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "economy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Многие компании стремятся выйти из <w>тени</w> и платить налоги.",
                            "target_lang_translations": {
                                "nl": "Veel bedrijven streven ernaar om uit de <w>illegaliteit</w> te stappen en belasting te betalen."
                            }
                        },
                        {
                            "text": "Значительная часть малого бизнеса в регионе по-прежнему работает в <w>тени</w>.",
                            "target_lang_translations": {
                                "nl": "Een aanzienlijk deel van het midden- en kleinbedrijf in de regio opereert nog steeds in de <w>schaduweconomie</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "подполье"
                    ],
                    "common_phrases": [
                        "выйти из тени"
                    ],
                    "target_lang_definitions": {
                        "nl": "economische activiteit die voor de autoriteiten verborgen wordt gehouden"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "illegaliteit",
                                "target_lang_sense_clarification": "buiten het zicht van de wet"
                            },
                            {
                                "target_lang_word": "schaduweconomie",
                                "target_lang_sense_clarification": "het zwarte circuit"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}