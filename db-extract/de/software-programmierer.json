                                "example_id": "9dadbb5d-fce2-4ea7-a521-f6a98c5dc42e",
                                "sense_id": "b04ba67b-a90c-3ff9-8951-1129df86f719",
                                "text": "„Der Software-Programmierer versucht, mit so wenigen Dingen wie möglich auszukommen.“"
                            },
                            {
                                "example_id": "7803e53c-81be-4357-bf37-86c1725f4f9e",
                                "sense_id": "b04ba67b-a90c-3ff9-8951-1129df86f719",
                                "text": "„Tatsächlich investiert Daimler wie andere Konzerne viel Geld in Weiterbildungsprogramme - aber dass aus einem Experten für den Verbrennungsmotor mal eben ein Software-Programmierer wird, dürfte eine Ausnahme bleiben.“"
                            }
