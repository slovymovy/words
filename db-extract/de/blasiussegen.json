                ],
                "senses": [
                    {
                        "sense_id": "55ba2108-1413-3549-b927-a22a6868a955",
                        "entry_id": "622e5211-a268-39aa-b173-1b12f367bf96",
                        "glosses": [
                            "ein auch in deutschsprachigen, katholischen Diözesen gespendeter Segen gegen Halskrankheiten"
                        ],
                        "tags": [
                            "religiöse Volkskunde"
                        ],
                        "examples": [
                            {
                                "example_id": "53652b9c-bc28-4597-ae6d-4fcac8be2f32",
                                "sense_id": "55ba2108-1413-3549-b927-a22a6868a955",
                                "text": "Der Blasiussegen wird über zwei gekreuzten, brennenden Kerzen am Fest des Heiligen Blasius (03. Februar) oder am darauf folgenden Sonntag gespendet."
                            },
                            {
                                "example_id": "db863a8d-19d8-426d-b02e-58b0e2df6356",
                                "sense_id": "55ba2108-1413-3549-b927-a22a6868a955",
                                "text": "Der Blasiussegen lautet nach dem Benediktionale: \"Auf die Fürsprache des heiligen Blasius bewahre dich der Herr vor Halskrankheit und allem Bösen. Es segne dich Gott, der Vater und der Sohn und der Heilige Geist.\""
                            },
                            {
                                "example_id": "7ce39994-29ab-451c-bd17-a82f620983b7",
                                "sense_id": "55ba2108-1413-3549-b927-a22a6868a955",
                                "text": "\"Vermutlich erst im 16. Jah[r]hundert … entstand, veranlaßt durch die Legende, der Blasiussegen in Form des Andreaskreuzes vor den Hals gehaltener Kerzen und eigener Benediktionsformel, in Rom durch Bestreichen des Halses mit einem in Öl getauchten Kerzchen.\""
                            },
                            {
                                "example_id": "18aa3feb-f423-4196-91f1-5f4be490b515",
                                "sense_id": "55ba2108-1413-3549-b927-a22a6868a955",
                                "text": "„Die Eltern führten ihre Kinder zum Blasiussegen in die Kirche, damit sie keine Gräten verschluckten und kein Halsweh bekamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
