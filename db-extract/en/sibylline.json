                    {
                        "translation_id": "3423c12f-7d66-4621-ac4c-fa2905a92477",
                        "source_entry_id": "55145361-959b-3aaf-9f0d-c4095906c636",
                        "source_sense_id": "4556422b-1a94-3aa5-8807-a3629c303a70",
                        "source_sense_description": "mysterious",
                        "target_lang_word": "sibyllinisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sibyllinisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "61763591-c48b-308d-be0c-bb761510ab95",
                                        "entry_id": "5d7a090a-4dc9-3e98-bcb3-727bd56111d0",
                                        "glosses": [
                                            "in einer geheimnisvollen, rätselhaften Art und Weise"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65d88d3b-b5f1-4b88-8aa8-ca04b70eed4e",
                                                "sense_id": "61763591-c48b-308d-be0c-bb761510ab95",
                                                "text": "Und in der Frage der EU-Mitgliedschaft der Türkei schreibt er sibyllinisch: „Das wird sich zeigen.”"
                                            },
                                            {
                                                "example_id": "1cf36f0a-efa3-4be9-893f-6779fb10c9b0",
                                                "sense_id": "61763591-c48b-308d-be0c-bb761510ab95",
                                                "text": "Veronica Lario hüllte sich lange in Schweigen, erst vor einigen Monaten berichtete sie, ihre Tochter habe sich bei Cacciari eingeschrieben, der in Mailand Philosophie lehrt: „Das ist doch eine ideale Situation“, meinte sie sibyllinisch zu einem Interviewer."
                                            },
                                            {
                                                "example_id": "38e0c38c-e406-4880-94f9-6f0a2f11b94a",
                                                "sense_id": "61763591-c48b-308d-be0c-bb761510ab95",
                                                "text": "„»Haben die selbst getan«, antwortet Gareis sibyllinisch und hört einen lachen, höhnisch, frech, meckernd.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
