                "senses": [
                    {
                        "sense_id": "1ed485b5-d157-34fd-ac40-07fcb7f4c80c",
                        "entry_id": "1097be4a-a2d0-3390-b0e0-8b935c5fcb97",
                        "glosses": [
                            "schip dat gebruikt wordt voor onderwijs (aan zeevarenden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c907b1ad-a53a-49eb-9755-592220895a2e",
                                "sense_id": "1ed485b5-d157-34fd-ac40-07fcb7f4c80c",
                                "text": "Het leek op Sail, wanneer alles wat varen en drijven kon een aankomend Russisch opleidingsschip op het IJ verwelkomde."
                            },
                            {
                                "example_id": "ec842224-7611-4bfe-bd54-dc50218ac8ca",
                                "sense_id": "1ed485b5-d157-34fd-ac40-07fcb7f4c80c",
                                "text": "Er mogen geen schepen in de buurt van de werkzaamheden komen en de zeekadetten zullen overzicht op het scheepsverkeer houden. Waarschijnlijk liggen in het wrak nog bommen en stoffelijke resten van de bemanning. Het opleidingsschip met de zeekadetten blijft vier weken naast de bouwput in het IJsselmeer liggen. Aan boord zijn minimaal 12 mensen."
                            }
                        ]
                    }
                ],
