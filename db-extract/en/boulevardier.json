    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "1788451a-ccf6-3e49-9b69-d14c176f7502",
                "word": "boulevardier",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "5c22d625-c539-48f4-93f1-474b42cbedbd",
                        "entry_id": "1788451a-ccf6-3e49-9b69-d14c176f7502",
                        "tags": [
                            "plural"
                        ],
                        "form": "boulevardiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57b9d0d8-c600-3591-9265-e635caca11af",
                        "entry_id": "1788451a-ccf6-3e49-9b69-d14c176f7502",
                        "glosses": [
                            "A man who frequents the boulevards; thus, a man about town or bon vivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f95a16dd-3d70-4413-8e82-76c19155f73f",
                                "sense_id": "57b9d0d8-c600-3591-9265-e635caca11af",
                                "text": "Sitting alone at his window-seat, he was like an old boulevardier fallen on hard times, waspish, inward, slothful."
                            },
                            {
                                "example_id": "d0cdfb35-75f7-46ac-931b-66bb60b9e724",
                                "sense_id": "57b9d0d8-c600-3591-9265-e635caca11af",
                                "text": "The 19th century was the age of the flaneur and the boulevardier, figures who made strolling down Fifth Avenue or Broadway, often vividly attired, a fashionable activity worthy of their counterparts in Paris or London."
                            }
                        ]
                    },
                    {
                        "sense_id": "489947db-8692-3f68-a59e-b6f22172206c",
                        "entry_id": "1788451a-ccf6-3e49-9b69-d14c176f7502",
                        "glosses": [
                            "An alcoholic drink similar to a negroni but made with bourbon instead of gin."
                        ],
                        "tags": [
                            "capitalized",
                            "often"
                        ],
                        "examples": [
                            {
                                "example_id": "6ead85c6-25c7-4cf4-ba91-805e4f2b0614",
                                "sense_id": "489947db-8692-3f68-a59e-b6f22172206c",
                                "text": "The boulevardier is a fun drink. Similar to the negroni, the boulevardier features bourbon as the spirit instead of gin for the negroni. To be clear, they are different drinks but at the same time similar.[…]"
                            },
                            {
                                "example_id": "13ca37f5-6180-4f79-8e8f-d0779e4a45c5",
                                "sense_id": "489947db-8692-3f68-a59e-b6f22172206c",
                                "text": "Make no bones about it, if you were drinking a Boulevardier at Harry's in 1920, you were also drinking in a few hundred litres of smoke-filled air alongside it.[…]"
                            },
                            {
                                "example_id": "afe9e964-89c6-4349-8aa9-8482e1e84391",
                                "sense_id": "489947db-8692-3f68-a59e-b6f22172206c",
                                "text": "On the revival menu: boulevardiers, martinis, Manhattans, negronis, old fashioneds and more."
                            },
                            {
                                "example_id": "07e1e888-4207-48a7-9bfa-b8f36b9aad71",
                                "sense_id": "489947db-8692-3f68-a59e-b6f22172206c",
                                "text": "\"We're drinking Boulevardiers.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46638d89-ef7e-4b07-b97b-6f629e9d12fd",
                        "source_entry_id": "1788451a-ccf6-3e49-9b69-d14c176f7502",
                        "source_sense_description": "a man who frequents the boulevards",
                        "target_lang_word": "boulevardier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boulevardier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ffc78c4-2946-390e-b550-54e7a165a441",
                                        "entry_id": "20148777-48d8-3c0b-b210-e49c93faea67",
                                        "glosses": [
                                            "Qualifie un état d’esprit de légèreté dans le divertissement théâtral par opposition à l’académisme des théâtres officiels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1040a4a7-f0b1-427c-8666-071599ebc4b0",
                                                "sense_id": "3ffc78c4-2946-390e-b550-54e7a165a441",
                                                "text": "Dialoguiste, écrivain prolixe et populaire, Jacques Chabannes a été le premier adaptateur du répertoire boulevardier à la télévision."
                                            },
                                            {
                                                "example_id": "94b483f8-e232-427c-9c9f-8409a9cee436",
                                                "sense_id": "3ffc78c4-2946-390e-b550-54e7a165a441",
                                                "text": "Ce qui est vraiment admirable, vraiment unique, c’est le cachet boulevardier de ce théâtre."
                                            },
                                            {
                                                "example_id": "17d316ad-5f5c-4652-8701-9980a2731df6",
                                                "sense_id": "3ffc78c4-2946-390e-b550-54e7a165a441",
                                                "text": "Tous en sont encore restés à l’après guerre immédiate. À ce moment, le café semblait encore réservé, du moins à Montmartre, à une élite de la population artistique et boulevardière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45b3de4e-4e72-3940-94c3-869e1c44f26a",
                                        "entry_id": "20148777-48d8-3c0b-b210-e49c93faea67",
                                        "glosses": [
                                            "Vaudevillesque."
                                        ],
                                        "tags": [
                                            "En mauvaise part"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23b3b18e-cb80-4f8b-be47-99c2c698da6f",
                                                "sense_id": "45b3de4e-4e72-3940-94c3-869e1c44f26a",
                                                "text": "Cette grossière comédie présente des personnages caricaturaux et des situations boulevardières noyées dans un sentimentalisme escroc."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "boulevardier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8527fd2a-c74a-3d90-a765-96238b179d6d",
                                        "entry_id": "b7e7c479-43d9-312b-8e75-e64972286312",
                                        "glosses": [
                                            "Auteur qui écrit du théâtre de boulevard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "758082d1-abe7-4a5e-994d-cd9584d30f54",
                                                "sense_id": "8527fd2a-c74a-3d90-a765-96238b179d6d",
                                                "text": "M'entendre traiter de pornographe, de boulevardier, de vaudevilliste ; accuser d'imiter Maeterlinck ! ou Donnay dont je n'ai jamais rien lu ! Vraiment, les coups portent à faux."
                                            },
                                            {
                                                "example_id": "feee9683-fb54-45fe-89d1-178d4a8302c3",
                                                "sense_id": "8527fd2a-c74a-3d90-a765-96238b179d6d",
                                                "text": "Néanmoins, le public reste avide de spectacles. Rostand et les boulevardiers profiteront de cette affection et de ce besoin éternels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e16782-9b73-359b-abcf-daef3f7b7d30",
                                        "entry_id": "b7e7c479-43d9-312b-8e75-e64972286312",
                                        "glosses": [
                                            "Personne habituée des boulevards, citadin ne connaissant que le milieu urbain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b83442e-c4f3-4a13-a08a-47fad8010738",
                                                "sense_id": "f3e16782-9b73-359b-abcf-daef3f7b7d30",
                                                "text": "Car la châtelaine de Tansonville savait qu'avril, même glacé, n'est pas dépourvu de fleurs, que l'hiver, le printemps, l'été, ne sont pas séparés par des cloisons aussi hermétiques que tend à le croire le boulevardier qui jusqu'aux premières chaleurs s'imagine le monde comme renfermant seulement des maisons nues sous la pluie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
