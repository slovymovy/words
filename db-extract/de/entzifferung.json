                ],
                "senses": [
                    {
                        "sense_id": "48bf2f9f-96f6-3abf-9336-91089d76c215",
                        "entry_id": "ab1c078c-75f6-3a0d-bae0-0132d0767900",
                        "glosses": [
                            "Erschließung eines schlecht lesbaren (unleserlichen) Textes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4cb71adc-95fe-4031-9d21-82b6b03b4bc5",
                                "sense_id": "48bf2f9f-96f6-3abf-9336-91089d76c215",
                                "text": "„Man werde, so sagte Bergmann, die Bilder filtern und kontrastverstärken, um den Forschern die Entzifferung zu erleichtern.“"
                            },
                            {
                                "example_id": "4a713816-3b0c-445e-af22-1a49af632e45",
                                "sense_id": "48bf2f9f-96f6-3abf-9336-91089d76c215",
                                "text": "Die Entzifferung von Handschriften/Manuskripten kann sehr viel Mühe machen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fbd77b50-5e1c-399b-90ac-bd2ee706dc1c",
                        "entry_id": "ab1c078c-75f6-3a0d-bae0-0132d0767900",
                        "glosses": [
                            "Entschlüsselung eines verschlüsselten Textes"
                        ],
                        "tags": [
                            "Kryptologie"
                        ],
                        "examples": [
                            {
                                "example_id": "82501d84-adde-4f57-a328-d7d26f647c93",
                                "sense_id": "fbd77b50-5e1c-399b-90ac-bd2ee706dc1c",
                                "text": "„Gelingt aber eine unberufene Entzifferung - den Engländern gelang dies 1940 für die ENIGMA-Chiffrierung -, so ist es wichtig, diesen Sachverhalt vor dem Gegner zu verbergen…“"
                            },
                            {
                                "example_id": "c14a6fe4-5bbe-422a-9bdf-0ca2071f5f4a",
                                "sense_id": "fbd77b50-5e1c-399b-90ac-bd2ee706dc1c",
                                "text": "„Von besonderer Bedeutung war die sichere Verschlüsselung der Nachrichten, denn ein Heer von Abhörspezialisten in allen wichtigen imperialistischen Staaten war - zu Lande und auf Schiffen - mit nichts anderem beschäftigt, als Tag und Nacht auf allen Wellenlängen geheime Funksprüche abzufangen, zu registrieren, den Sendeort durch Funkpeilung festzustellen und aufgefangene Funksprüche an andere Spezialisten weiterzugeben, die in der Entzifferung von verschlüsselten Nachrichten geübt waren."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "77c593b6-fce5-3e4b-b32e-4db007f960dc",
                        "entry_id": "ab1c078c-75f6-3a0d-bae0-0132d0767900",
                        "glosses": [
                            "Entschlüsselung von Texten, die in einer unbekannten Sprache verfasst sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf5f682-010e-4233-81a3-ff3e35d2c834",
                                "sense_id": "77c593b6-fce5-3e4b-b32e-4db007f960dc",
                                "text": "„An die Entzifferung dieser Sprache machten sich natürlich zuerst Kenner des Babylonischen und der Keilschrift.“"
                            },
                            {
                                "example_id": "13810064-4051-4651-ba32-bf9d1e5b21a3",
                                "sense_id": "77c593b6-fce5-3e4b-b32e-4db007f960dc",
                                "text": "„Hierin besteht eine Verwandtschaft mit dem Gebiet der Entzifferung verschollener Schriften und Sprachen, einem reizvollen Grenzgebiet der Archäologie und der Sprachwissenschaft.“"
                            },
                            {
                                "example_id": "cda80b2a-ecf3-4684-9c4a-ba86f05965ff",
                                "sense_id": "77c593b6-fce5-3e4b-b32e-4db007f960dc",
                                "text": "„Nach zahlreichen vergeblichen Versuchen gelang erst in den fünfziger Jahren dieses Jahrhunderts dem deutschen Forscher T. S. Barthel der entscheidende Durchbruch in Richtung auf eine Entzifferung des Rongorongo-Schriftsystems.“"
                            },
                            {
                                "example_id": "14eaf594-a4db-4694-9e8d-944e65313271",
                                "sense_id": "77c593b6-fce5-3e4b-b32e-4db007f960dc",
                                "text": "„Auch der Entzifferungen müssen wir hier gedenken.“"
                            },
                            {
                                "example_id": "8960b78d-2b52-40f2-951d-1be2ba2c2ec0",
                                "sense_id": "77c593b6-fce5-3e4b-b32e-4db007f960dc",
                                "text": "„Danach überprüft er seine Theorie auch praktisch, indem er sie bei der Entzifferung des Steins von Rosette anwendet.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
