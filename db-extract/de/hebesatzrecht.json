                "senses": [
                    {
                        "sense_id": "c232a7cc-4646-3007-b9a0-b8efcfe3aee7",
                        "entry_id": "a5d1ec35-c192-3a07-8477-ebdf2ea4f660",
                        "glosses": [
                            "Berechtigung (Recht), einen Hebesatz festzulegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8ffc2db-845b-4b75-aa53-9328456c152f",
                                "sense_id": "c232a7cc-4646-3007-b9a0-b8efcfe3aee7",
                                "text": "„Die Gewährleistung der Selbstverwaltung umfaßt auch die Grundlagen der finanziellen Eigenverantwortung; zu diesen Grundlagen gehört eine den Gemeinden mit Hebesatzrecht zustehende wirtschaftskraftbezogene Steuerquelle.“"
                            },
                            {
                                "example_id": "a85a80fb-cd67-4866-a4d9-3a93b83b2e3f",
                                "sense_id": "c232a7cc-4646-3007-b9a0-b8efcfe3aee7",
                                "text": "„Ende August hatte schon Finanzminister Wolfgang Schäuble (CDU) die Gewerbesteuer infrage gestellt und vorgeschlagen, den Kommunen durch ein begrenztes Hebesatzrecht bei der Einkommensteuer mehr Eigenverantwortung zu gewähren.“"
                            },
                            {
                                "example_id": "052afadf-9b13-49a5-8fc1-7147ddc080be",
                                "sense_id": "c232a7cc-4646-3007-b9a0-b8efcfe3aee7",
                                "text": "„Bei einer solchen Lösung dürfte sich ein Hebesatzrecht bei dieser Steuer selbst nicht möglich machen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
