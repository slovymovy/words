                        "source_sense_id": "2ddfb12c-da76-3704-9b7c-bcfc19c30487",
                        "source_sense_description": "A 1. schotschrift of smaadschrift waarin men iets of iemand belachelijk maakt",
                        "target_lang_word": "Schmähschrift",
                        "target_lang_code": "de",
