                                        "sense_id": "2fcf607f-4b46-3a16-a13b-25821744bf0b",
                                        "entry_id": "cee712db-6f89-3683-ba05-316318377e56",
                                        "glosses": [
                                            "Staat in Vorderasien"
                                        ],
                                        "tags": [],
