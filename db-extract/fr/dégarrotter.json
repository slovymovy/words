                "senses": [
                    {
                        "sense_id": "e7af4405-4f91-352b-bf50-5a5016ed79d4",
                        "entry_id": "4f89b78e-9e4c-3c94-9c5d-fc654b479d39",
                        "glosses": [
                            "Enlever le garrot à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51d4163e-3317-48d4-b5f5-b8d3553a07b3",
                                "sense_id": "e7af4405-4f91-352b-bf50-5a5016ed79d4",
                                "text": "Ils le crurent victime d'une gageure ou d'un pari malveillant ; ils se mirent aussitôt en devoir de le dégarrotter."
                            },
                            {
                                "example_id": "e1082e4e-4608-4ea9-8ca5-fa8f22eaa709",
                                "sense_id": "e7af4405-4f91-352b-bf50-5a5016ed79d4",
                                "text": "Le 11me jour cependant, on m'apprend que le cheval va beaucoup plus mal et je suis prié de dégarrotter le membre: une odeur de gangrène est répandue dans l'écurie;"
                            }
                        ]
                    }
