                "senses": [
                    {
                        "sense_id": "e06b3b12-d184-3ca2-95d8-c52a5957d74f",
                        "entry_id": "68562b5e-87b5-3b4e-8afd-7772605d2f4f",
                        "glosses": [
                            "vom König oder Kaiser verhängte Strafe, die dem Schuldigen die Rechtsfähigkeit entzog und die für das ganze Heilige Römische Reich Deutscher Nation galt"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a75b26d4-4c4c-4a72-a359-9c336f953b0e",
                                "sense_id": "e06b3b12-d184-3ca2-95d8-c52a5957d74f",
                                "text": "Wegen Ketzerei verhängte der Kaiser die Reichsacht über Martin Luther."
                            },
                            {
                                "example_id": "45062399-efdc-433f-bd72-aa27fea4c835",
                                "sense_id": "e06b3b12-d184-3ca2-95d8-c52a5957d74f",
                                "text": "„Der Welfe wurde vor den Reichstag zitiert, unter Reichsacht gestellt und verlor die Herzogtümer Sachsen und Bayern.“"
                            },
                            {
                                "example_id": "505f1a43-c6c8-4451-8f43-0fa5c8285bbe",
                                "sense_id": "e06b3b12-d184-3ca2-95d8-c52a5957d74f",
                                "text": "„1520 wurde die Reichsacht über ihn verhängt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
