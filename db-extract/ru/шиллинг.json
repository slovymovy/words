                "senses": [
                    {
                        "sense_id": "8d4d8542-c434-39a8-8ba8-e05d711ff87b",
                        "entry_id": "7338a8c0-176b-3ef3-8e77-31da7ffecd68",
                        "glosses": [
                            "британская монета достоинством в 12 пенсов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68f30359-3d06-4fdf-80b2-713f6dcf8a0c",
                                "sense_id": "8d4d8542-c434-39a8-8ba8-e05d711ff87b",
                                "text": "Казённые земли [в Капской колонии] приобретаются частными лицами, с платою по два шиллинга за акр .."
                            },
                            {
                                "example_id": "413fffa1-9881-40f5-9859-fd9ccf9c9e25",
                                "sense_id": "8d4d8542-c434-39a8-8ba8-e05d711ff87b",
                                "text": "Здесь была валюта многих стран света — американские доллары и английские шиллинги, франки французские и бельгийские, кроны австрийские, чешские, норвежские, румынские леи, итальянские лиры."
                            }
                        ]
                    }
