                                        "glosses": [
                                            "To join together into one stream."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "989d0d4f-7e29-4eb2-8b3f-a751d47a8215",
                                                "sense_id": "0dda89cc-674d-30e6-9f02-b0c67bf0bf70",
                                                "text": "CHN 082 flows for approximately 304.8 meters (1,000 feet) before confluencing with the North Bald Eagle Creek."
                                            },
                                            {
                                                "example_id": "1d49baaf-278d-4d83-a040-fadb9bce970d",
                                                "sense_id": "0dda89cc-674d-30e6-9f02-b0c67bf0bf70",
                                                "text": "I added a third manhole to my model so you can see how a junction might look. It just provides a nice way to confluence two streams into one pipe, which is an important job in a sewer system since a sewershed all has to flow to one place."
