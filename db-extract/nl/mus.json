                        "entry_id": "670ca65d-38fa-3140-8d9c-6a47c358a0d0",
                        "glosses": [
                            "benaming voor vogels uit de familie Passeridae, behorend tot de wevervogels die zelden ver van de mensen nestelen"
                        ],
                        "tags": [
                            "zangvogels"
                        ],
                        "examples": [
