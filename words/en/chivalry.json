{
    "word_family": [
        "chivalric",
        "chivalrous",
        "chivalrously"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "eb2f7e6b-c087-36a2-a1ef-f266c6141da0",
                    "sense_definition": "Polite, considerate, and helpful behavior, especially that shown by men toward women.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "courtesy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He proved that <w>chivalry</w> is not dead by opening the door and carrying her heavy bags."
                        },
                        {
                            "text": "Some critics argue that modern <w>chivalry</w> is outdated, while others still value traditional politeness."
                        }
                    ],
                    "synonyms": [
                        "courtesy",
                        "gallantry",
                        "politeness"
                    ],
                    "antonyms": [
                        "rudeness"
                    ],
                    "common_phrases": [
                        "chivalry is not dead",
                        "chivalry is dead"
                    ]
                },
                {
                    "sense_id": "e7705a96-78dd-3c41-a44c-86867e494f68",
                    "sense_definition": "The medieval system and moral code of knighthood, emphasizing honor, courage, piety, and protection of the weak.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "knighthood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The legendary stories of King Arthur celebrate the noble ideals of medieval <w>chivalry</w>."
                        },
                        {
                            "text": "Under the code of <w>chivalry</w>, a knight swore to defend the Church and protect those in need."
                        }
                    ],
                    "synonyms": [
                        "knighthood"
                    ],
                    "common_phrases": [
                        "code of chivalry",
                        "age of chivalry"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Refers primarily to medieval historical and literary contexts"
                        }
                    ]
                },
                {
                    "sense_id": "169fe30b-8857-38f5-8fb5-7c3f40fb930e",
                    "sense_definition": "Courteous, honorable, and fair conduct, especially between opponents or rivals.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "courtesy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Even during the fiercest fighting, both sides showed mutual <w>chivalry</w> by allowing medics to tend to the wounded."
                        },
                        {
                            "text": "The veteran commander was admired for treating defeated enemies with remarkable <w>chivalry</w>."
                        }
                    ],
                    "synonyms": [
                        "sportsmanship",
                        "fairness"
                    ]
                },
                {
                    "sense_id": "0db70c7a-0a96-3955-8a04-7dc47eb60915",
                    "sense_definition": "The condition or status of being a knight, including knightly skill or prowess.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "knighthood",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young noble earned the highest honors of <w>chivalry</w> after demonstrating great bravery on the battlefield."
                        },
                        {
                            "text": "He was praised across the realm for his exceptional skill and dedication to <w>chivalry</w>."
                        }
                    ],
                    "synonyms": [
                        "knighthood"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used historically regarding knightly status and skill"
                        }
                    ]
                },
                {
                    "sense_id": "aba53f69-2729-3958-a2e8-730d5c59c0b2",
                    "sense_definition": "A body of armed horsemen or knights; cavalry.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The king led the flower of his kingdom's <w>chivalry</w> into the decisive battle."
                        },
                        {
                            "text": "Thousands of foot soldiers fled as the enemy's heavy <w>chivalry</w> charged across the open field."
                        }
                    ],
                    "synonyms": [
                        "cavalry",
                        "horsemen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical military term"
                        }
                    ]
                },
                {
                    "sense_id": "180fae77-a4bc-3c87-a5ef-1d8db585c9c3",
                    "sense_definition": "The tenure of land granted in exchange for knightly or military service.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "feudal_law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Under feudal law, estates held by <w>chivalry</w> required the tenant to supply mounted soldiers to the monarch."
                        },
                        {
                            "text": "The legal dispute concerned whether the ancestral manor had originally been granted in <w>chivalry</w>."
                        }
                    ],
                    "common_phrases": [
                        "tenure by chivalry"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Historical legal tenure term"
                        }
                    ]
                }
            ]
        }
    ]
}