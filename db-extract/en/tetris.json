                "forms": [
                    {
                        "form_id": "746fd4a6-0464-4218-a8c4-e717c6bdda86",
                        "entry_id": "7833e345-14cc-317b-bd54-8ec48d163406",
                        "tags": [
                            "plural"
                        ],
                        "form": "Tetrises"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "67547233-0724-3075-87ee-022cad37dbd3",
                        "entry_id": "7833e345-14cc-317b-bd54-8ec48d163406",
                        "glosses": [
                            "The act of clearing four lines at once (the maximum possible) in Tetris."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "da8a3b6b-2286-4a68-ba7b-7467a3f6baa8",
                                "sense_id": "67547233-0724-3075-87ee-022cad37dbd3",
                                "text": "For some it's staying low on the play field, steadily advancing through the levels, for others its ^([sic]) trying to clear the board entirely or scoring an unprecedented number of tetrises."
                            },
                            {
                                "example_id": "49d09d9c-ed02-492d-bb70-7c743bf88288",
                                "sense_id": "67547233-0724-3075-87ee-022cad37dbd3",
                                "text": "See figure 3 for an example of a logical decision tree that indicates whether there is a possibility to score a tetris."
                            },
                            {
                                "example_id": "403bdb7c-9922-40fc-af1a-5c16cc325c7c",
                                "sense_id": "67547233-0724-3075-87ee-022cad37dbd3",
                                "text": "Maximizing the number of tetrises (the number of times that four rows are cleared in a Tetris game) is NP-complete."
                            },
                            {
                                "example_id": "8990bc77-8dcd-4472-b3b5-9571c9904cd8",
                                "sense_id": "67547233-0724-3075-87ee-022cad37dbd3",
                                "text": "Score two Tetrises in two drops playing Marathon."
                            }
                        ]
                    }
                ],
