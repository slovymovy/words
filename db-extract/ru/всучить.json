                "translations": [
                    {
                        "translation_id": "88ffc339-959d-4b67-802f-f056dc0fa7f5",
                        "source_entry_id": "e566ef63-e714-3d79-b46d-75690b5a0399",
                        "source_sense_description": "заставить взять, купить обманом или хитростью",
                        "target_lang_word": "refiler",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "refiler",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8e3fd325-4c4c-3484-be8d-7a10dbad8cd5",
                                        "entry_id": "2d59894a-30ca-318e-b365-6f8a36626f95",
                                        "glosses": [
                                            "Donner ou passer quelque chose à quelqu’un."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d925d44a-5d1b-4d20-a453-6a57d2ad02c8",
                                                "sense_id": "8e3fd325-4c4c-3484-be8d-7a10dbad8cd5",
                                                "text": "Tout ce qu’il entendait autour de lui, les tuyaux refilés d’une oreille à l’autre, les vaines discussions d’intérêts sordides, les propositions abracadabrantes, lui occasionnaient parfois des nausées."
                                            },
                                            {
                                                "example_id": "15240068-4fba-464e-837a-b7a113a261c3",
                                                "sense_id": "8e3fd325-4c4c-3484-be8d-7a10dbad8cd5",
                                                "text": "Un des informateurs du patron […] nous a refilé un tuyau d’importance. Deux malfrats aguerris et une petite frappe en devenir ont eu vent de la prochaine opération « sac à dos ». — (François-Xavier Dillard, Un vrai jeu d’enfant, chap. 6, Fleuve Noir, 2012)"
                                            },
                                            {
                                                "example_id": "95bdc3d6-7c65-4c2c-8dee-44a23fae757e",
                                                "sense_id": "8e3fd325-4c4c-3484-be8d-7a10dbad8cd5",
                                                "text": "Une putain d’idée ! Il paraît que vous êtes le crack des cracks, que vous avez démerdé des situations indémerdables pour la Company. Les DG successifs se refilent votre nom comme le Saint-Sacrement."
                                            },
                                            {
                                                "example_id": "5ed77014-c1d8-40d8-931f-b3b65bfffdfa",
                                                "sense_id": "8e3fd325-4c4c-3484-be8d-7a10dbad8cd5",
                                                "text": "T’as perdu la boule ou quoi ? Tu me l’as refilé hier en me demandant de t’appeler ce soir. La picole te réussit pas, p’tit gars."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
