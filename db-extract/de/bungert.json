                    {
                        "form_id": "41329d28-83bc-46f3-b3a5-e3970f4888de",
                        "entry_id": "7592549c-9bc5-35b4-bb08-98a48bf6668b",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Bungerte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "05241012-9b72-3133-b54e-76a35732ded7",
                        "entry_id": "7592549c-9bc5-35b4-bb08-98a48bf6668b",
                        "glosses": [
                            "altdeutscher Name für Baumgarten, Baumwiese, Obstgarten"
                        ],
                        "tags": [
                            "mundartlich",
                            "dialektal in West- und Südwestdeutschland sowie der Schweiz"
                        ],
                        "examples": [
                            {
                                "example_id": "175bace3-ac0b-483e-8c12-ed0c39f854aa",
                                "sense_id": "05241012-9b72-3133-b54e-76a35732ded7",
                                "text": "Ich muss auf dem Bungert wieder das Gras mähen."
                            },
                            {
                                "example_id": "a8afccd9-2042-451c-a964-5340569440cd",
                                "sense_id": "05241012-9b72-3133-b54e-76a35732ded7",
                                "text": "„Im Jahr 1192 schenkt Konrad, des Liebfrauenstiftes zu Aachen Dechant und Probst des dasigen Stiftes zu St. Adalbert, das von ihm zu Tonnesdorf […] erkaufte Gut, nämlich Haus, Hof, Garten und Bungert […] den beiden Stiften Liebfrauen und St. Adalbert und dem Kloster Burscheid.“"
                            },
                            {
                                "example_id": "10195d05-9abf-40cd-b1b9-5a8daa66918b",
                                "sense_id": "05241012-9b72-3133-b54e-76a35732ded7",
                                "text": "„Die Grundstücke einer Gemarkung bilden je nach Lage, Besitz- und Anbauverhältnissen getrennte Gruppen, Gewanne mit besonderen Namen. Viele beziehen sich auf Bodenbeschaffenheit, wie »Ried«, »Sand«, »Letten«, auf Benutzungsart, wie »Bungert« (Baumgarten), »Kohlgarten«, »Neumatten«, auf Besitzverhältnisse, wie »Allmend«, »Klosterhof«, »Rittersgrund«, auf die Lage, wie »Eck«, »Sommerberg«, »Sattel« oder endlich auf historische Erinnerungen, wie »Heidengrab«, »Franzosenweg«, »Judenbuch« u.a.m. […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7c12de40-fb59-3f86-8ede-8fc5ac92711a",
                        "entry_id": "7592549c-9bc5-35b4-bb08-98a48bf6668b",
                        "glosses": [
                            "häufig vorkommende Flurbezeichnung mit der unter [1] genannten Bedeutung nach der Nutzung des Gebietes"
                        ],
                        "tags": [
                            "Toponym"
                        ],
                        "examples": [
                            {
                                "example_id": "9e12527c-9009-4109-99fe-ea00d90862e4",
                                "sense_id": "7c12de40-fb59-3f86-8ede-8fc5ac92711a",
                                "text": "Sie wohnte \"Im Bungert\" 3."
                            },
                            {
                                "example_id": "b499afb7-0d7c-442e-8868-46efdef2a105",
                                "sense_id": "7c12de40-fb59-3f86-8ede-8fc5ac92711a",
                                "text": "„Die Grundstücke einer Gemarkung bilden je nach Lage, Besitz- und Anbauverhältnissen getrennte Gruppen, Gewanne mit besonderen Namen. Viele beziehen sich auf Bodenbeschaffenheit, wie »Ried«, »Sand«, »Letten«, auf Benutzungsart, wie »Bungert« (Baumgarten), »Kohlgarten«, »Neumatten«, auf Besitzverhältnisse, wie »Allmend«, »Klosterhof«, »Rittersgrund«, auf die Lage, wie »Eck«, »Sommerberg«, »Sattel« oder endlich auf historische Erinnerungen, wie »Heidengrab«, »Franzosenweg«, »Judenbuch« u.a.m. […]“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "133939f6-022e-4818-9a08-456723ecd37b",
                        "source_entry_id": "7592549c-9bc5-35b4-bb08-98a48bf6668b",
                        "source_sense_id": "05241012-9b72-3133-b54e-76a35732ded7",
                        "source_sense_description": "altdeutscher Name für Baumgarten, Baumwiese, Obstgarten",
                        "target_lang_word": "verger",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verger",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61523724-c904-31b5-b576-ccd9a139eb23",
                                        "entry_id": "9ac6691a-54b5-39a7-8c9e-ef8536995b79",
                                        "glosses": [
                                            "Lieu planté d’arbres fruitiers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53483b12-9212-4668-b8f9-57d05402bfe1",
                                                "sense_id": "61523724-c904-31b5-b576-ccd9a139eb23",
                                                "text": "La plupart des montagnes de Walachie sont garnies de bois composés de poiriers, de cerisiers, d’abricotiers et autres arbres fruitiers qui donnent aux forêts l’aspect d’immenses vergers."
                                            },
                                            {
                                                "example_id": "1e0075ad-2379-4b0a-96c8-6360b479a210",
                                                "sense_id": "61523724-c904-31b5-b576-ccd9a139eb23",
                                                "text": "Catherine et moi nous allions derrière, dans le verger ; nous mordions dans les mêmes pommes et dans les mêmes poires ; nous étions les plus heureux du monde."
                                            },
                                            {
                                                "example_id": "5ca5bd47-bbfb-48ef-b90d-9832a0cb755f",
                                                "sense_id": "61523724-c904-31b5-b576-ccd9a139eb23",
                                                "text": "Dans les vergers ou les terrains vagues, où l’on ne compte pas sur la récolte du sol, on plante en général 200 pommiers ou poiriers par hectare."
                                            },
                                            {
                                                "example_id": "a1555d6b-43f6-4297-a0e5-6ae2b8a1f5ed",
                                                "sense_id": "61523724-c904-31b5-b576-ccd9a139eb23",
                                                "text": "[…]; puis, ayant longé un champ d’avoine, étoilé de bluets et de coquelicots, nous arrivâmes en un verger où des vaches, à la robe bringelée, dormaient couchées à l’ombre des pommiers."
                                            },
                                            {
                                                "example_id": "76095c1c-33c1-4d34-ac11-cca820642f8c",
                                                "sense_id": "61523724-c904-31b5-b576-ccd9a139eb23",
                                                "text": "Le bar-restaurant «La coupe pleine» se tenait non loin de la rigole du village qui alimente en eau les vergers, à juste quelques encablures d’une prestigieuse auberge."
                                            },
                                            {
                                                "example_id": "e0f23a37-0837-498e-8f10-bf8a14cfa031",
                                                "sense_id": "61523724-c904-31b5-b576-ccd9a139eb23",
                                                "text": "Les formes de dégradation du phylum du Chêne-vert sont très nombreuses et constituent l’essentiel du paysage méditerranéen français là où l’homme n’a pas placé ses vignes, ses olivettes, ses vergers d’Amandiers, ses jardins ou ses cultures labourées."
                                            },
                                            {
                                                "example_id": "7d54f371-8e6f-4291-a816-2fe7a6f509af",
                                                "sense_id": "61523724-c904-31b5-b576-ccd9a139eb23",
                                                "text": "Je demandai à ma mère d’aller aux vergers cueillir la cerise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6886e4a4-131c-3082-a175-4c4e59ed21ab",
                                        "entry_id": "9ac6691a-54b5-39a7-8c9e-ef8536995b79",
                                        "glosses": [
                                            "Pommeraie."
                                        ],
                                        "tags": [
                                            "Québec"
                                        ],
                                        "examples": []
                                    }
                                ]
