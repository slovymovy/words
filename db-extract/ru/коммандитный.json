                    {
                        "translation_id": "3cc45d75-1d67-456a-ad17-e0722421ec84",
                        "source_entry_id": "751f6253-66f2-3cb1-a681-dbefc737b107",
                        "source_sense_id": "95951d26-c8d7-3291-ac6a-63a865469649",
                        "target_lang_word": "commandite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commandite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ca577fce-40d8-3f70-8bd0-462fb0e813ab",
                                        "entry_id": "d2a87800-6d58-3b6f-a9c3-ba1e32e63b14",
                                        "glosses": [
                                            "Mise de fonds d’un commanditaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "485a0a8e-a25b-407e-8b50-057261edce0b",
                                                "sense_id": "ca577fce-40d8-3f70-8bd0-462fb0e813ab",
                                                "text": "Il a versé sa commandite."
                                            },
                                            {
                                                "example_id": "244e1021-5ace-47cc-bf9b-be03ed1ff925",
                                                "sense_id": "ca577fce-40d8-3f70-8bd0-462fb0e813ab",
                                                "text": "L’idée de famille était remplacée chez eux par celle d’une sorte de commandite où les bénéfices sont partagés à parts égales."
                                            },
                                            {
                                                "example_id": "85cc8ac2-d735-4582-b404-c1de44e03f74",
                                                "sense_id": "ca577fce-40d8-3f70-8bd0-462fb0e813ab",
                                                "text": "Ils veulent nous soutirer beaucoup d’argent. Une commandite ou un mariage. Nos deux petites avec tous leurs millions sont une proie tellement tentante."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a740080-d147-31f3-8140-c3d1bd2fc1d3",
                                        "entry_id": "d2a87800-6d58-3b6f-a9c3-ba1e32e63b14",
                                        "glosses": [
                                            "Société en commandite."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7921ede2-c302-4f0d-9607-74d0e0307444",
                                                "sense_id": "9a740080-d147-31f3-8140-c3d1bd2fc1d3",
                                                "text": "— Le duc a mis là tous les bénéfices d’une affaire en commandite dont les actions ont été vendues en hausse."
                                            },
                                            {
                                                "example_id": "6a2a3a18-2377-4bfe-a27c-a023e398dc6a",
                                                "sense_id": "9a740080-d147-31f3-8140-c3d1bd2fc1d3",
                                                "text": "Gargaret, à Albert.– Ah ! avant de porter l’acte chez mon notaire… tu le reverras au point de vue de l’orthographe… J’étais pressé… Ainsi, à commandite, faut-il deux t ?…\nAlbert.– Mon Dieu… ça dépend… quand on est pressé… on en met deux…\nGargaret.- Très bien… J’étais pressé… À bientôt !"
                                            }
                                        ]
                                    }
                                ]
