                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "54c02315-577e-3732-a685-dbd5084c4dda",
                                        "entry_id": "56e73b8f-9557-3e28-85ed-fef67275d238",
                                        "glosses": [
                                            "coś cenione, cenne lub drogie dla kogoś"
                                        ],
                                        "tags": [
                                            "metaphoric",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf5585b3-b012-4cd8-8b31-d5f9a2ab7a26",
                                                "sense_id": "54c02315-577e-3732-a685-dbd5084c4dda",
                                                "text": "Mów takim do rozumu, to ziewają, ale praw im duby smalone o świętej źrenicy wolności szlacheckiej, ekscytuj bajędą o równości z królami (…) a wydzieraj się przy tym ze wszystkiej mocy, machaj rękoma jak wiatrak, to się w końcu z czułości popłaczą i gotowi cię nawet porwać na ręce a ogłosić zbawcą ojczyzny"
                                            }
                                        ],
                                        "sense_index_json": "\"1.3\""
                                    },
