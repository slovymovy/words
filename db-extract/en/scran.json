            {
                "entry_id": "6a4f4313-1b74-3fe9-a980-0e5af3801cd7",
                "word": "scran",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "e0d755c5-cb96-3005-9424-6f8ac4fbee73",
                        "entry_id": "6a4f4313-1b74-3fe9-a980-0e5af3801cd7",
                        "glosses": [
                            "Food, especially that of an inferior quality; grub."
                        ],
                        "tags": [
                            "Ireland",
                            "UK",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "e8f43f6f-7d53-4dc3-8bf5-62d1e18d2f7f",
                                "sense_id": "e0d755c5-cb96-3005-9424-6f8ac4fbee73",
                                "text": "Let we gan and get some scran. Aw’m starvin man!"
                            },
                            {
                                "example_id": "7dc4c055-f57d-42d3-a347-af6a1f3e9e8f",
                                "sense_id": "e0d755c5-cb96-3005-9424-6f8ac4fbee73",
                                "text": "I know there are many persons — some who are themselves poor — who 'never turn a beggar from their door,' but always give them a few browns (halfpence) or some scran (broken victuals)."
                            }
                        ]
                    },
                    {
                        "sense_id": "bbf86eb1-da24-37e7-9a19-07a0512eb114",
                        "entry_id": "6a4f4313-1b74-3fe9-a980-0e5af3801cd7",
                        "glosses": [
                            "Refuse; rubbish."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
