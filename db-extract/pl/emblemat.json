                        ]
                    },
                    {
                        "translation_id": "4384b521-8023-44fd-89fe-a8ee59615c49",
                        "source_entry_id": "48f53bea-4aef-37ab-a3f4-fcc72fda889f",
                        "source_sense_id": "27d64efc-a43a-3fa4-8ebc-4f8f35344917",
