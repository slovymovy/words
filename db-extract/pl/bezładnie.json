                                        "sense_id": "aafe1569-9bbc-3f8a-8c1c-7c422ef8f8ff",
                                        "entry_id": "e8a0356c-e230-3cbf-949a-238167f9e265",
                                        "glosses": [
                                            "разг. не соблюдая порядка (в работе, быту и т.п.)"
