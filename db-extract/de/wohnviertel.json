                "senses": [
                    {
                        "sense_id": "22d2d251-e3f7-35a3-ae5d-396a9e31f2a7",
                        "entry_id": "ce8e2b3f-4611-32f3-827c-b1de1d6d54c5",
                        "glosses": [
                            "abgegrenzter oder in bestimmter Weise zusammengehörender Bereich einer Ortschaft/Stadt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db0f597b-f1ac-46ef-8d76-879fc3adae65",
                                "sense_id": "22d2d251-e3f7-35a3-ae5d-396a9e31f2a7",
                                "text": "„Die Straße erinnerte ihn ein bißchen an das jüdische Wohnviertel in der Calle Corrientes in Buenos Aires.“"
                            },
                            {
                                "example_id": "8768a108-d537-4962-8bba-d684a7dd8f0a",
                                "sense_id": "22d2d251-e3f7-35a3-ae5d-396a9e31f2a7",
                                "text": "„Durch so ein Wohnviertel der Vergessenen schlenderten Elisabeth und Stefan jetzt.“"
                            },
                            {
                                "example_id": "412ed482-9a89-43fa-9600-b23a79e8f83f",
                                "sense_id": "22d2d251-e3f7-35a3-ae5d-396a9e31f2a7",
                                "text": "„Kriegswichtige Industrien auszuschalten und Verkehrsknotenpunkte lahm zu legen, ist eines, Wohnviertel in Trümmergräber zu verwandeln, etwas anderes: reiner Terror.“"
                            },
                            {
                                "example_id": "a89838c0-5d2b-4e9f-8472-851a04ad3852",
                                "sense_id": "22d2d251-e3f7-35a3-ae5d-396a9e31f2a7",
                                "text": "„Über Deutschland herrscht Grabesstille, über dem Schutt der Städte, in den verlassenen Wohnvierteln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0a2e7d77-7e1a-4ac4-994c-2d37314e6795",
                        "source_entry_id": "ce8e2b3f-4611-32f3-827c-b1de1d6d54c5",
                        "source_sense_id": "22d2d251-e3f7-35a3-ae5d-396a9e31f2a7",
                        "source_sense_description": "abgegrenzter oder in bestimmter Weise zusammengehörender Bereich einer Ortschaft/Stadt",
                        "target_lang_word": "neighbourhood",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neighbourhood",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                                        "entry_id": "e2357106-d76c-35f3-b6dd-55d898a80e72",
                                        "glosses": [
                                            "British standard spelling of neighborhood."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1283b55a-5964-4bbb-8cfc-6f259d22f2ca",
                                                "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                                                "text": "These developments, most of which have taken place during the past 30 years, are remarkable in view of the low traffic density, except in the neighbourhood of Oslo, and the very extensive undeveloped areas of mountain and virgin forest."
                                            },
                                            {
                                                "example_id": "afad74d3-f7f2-4dec-b649-f8783b8dc689",
                                                "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                                                "text": "Camden motive power depot has been much criticised for its emission of smoke in a residential neighbourhood and its complete dieselisation is rapidly taking place."
                                            },
                                            {
                                                "example_id": "35ad8f00-b812-4955-b812-a61db5d0bf8b",
                                                "sense_id": "acb5668c-1d1d-3b1b-9284-332537f9454b",
                                                "text": "Another key event was the spontaneous mobilization of the Tiantongyuan neighbourhood in greater Beijing in 2008, which was an effort to modify the route plan of line no.5 of the Beijing subway system so that the neighbourhood could be more conveniently connected."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
