                    {
                        "form_id": "9ac397ea-6d88-4d69-81bd-76cc394d47bc",
                        "entry_id": "e73840cc-ae09-30ea-9cfe-bd6c25b1398f",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Pyrrhussiege"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                        "entry_id": "e73840cc-ae09-30ea-9cfe-bd6c25b1398f",
                        "glosses": [
                            "ein unter (äußerst) hohem Einsatz und unter (zu großen) Opfern errungener Erfolg, der aufgrund dessen keinen Vorteil mehr darstellt und (mittelfristig) eher einem Fehlschlag/einer Niederlage gleichkommt"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "1e925fa1-36b4-4f04-bcf6-0779dd7d2972",
                                "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                                "text": "Dieser Erfolg könnte sich als Pyrrhussieg erweisen."
                            },
                            {
                                "example_id": "0a2a4625-e3f4-464b-917e-6935ede1deb0",
                                "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                                "text": "Dieser Wahlsieg war ein Pyrrhussieg für die SPD."
                            },
                            {
                                "example_id": "ef95334d-dbaf-4141-9d07-51c74e178a95",
                                "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                                "text": "„Nach ihren ersten Pyrrhussiegen in den nun besetzten Gebieten fanden immer mehr Anhänger der Fedayeen im jordanischen al-Ġaur Zuflucht und unternahmen mit Unterstützung des radikalen Flügels der Muslimbruderschaft, dem sich vermutlich viele enttäuschte und geflüchtete Muslimbrüder aus der Westbank angeschlossen hatten, Angriffe auf israelisches Territorium.“"
                            },
                            {
                                "example_id": "044ee1d4-7e83-417b-903d-9f867772276a",
                                "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                                "text": "„Heute wissen wir, dass der Sieg von 1967 ein Pyrrhussieg war.“"
                            },
                            {
                                "example_id": "c550b1c8-592f-45d2-b8c3-27775dae5e10",
                                "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                                "text": "„Auf die Vernichtung der Janitscharen folgte der Ruin ihrer jüdischen Partner, womit die Armenier freie Bahn hatten - im Endeffekt freilich ein Pyrrhussieg.“"
                            },
                            {
                                "example_id": "e5512980-3e53-40d2-8333-5d0e6a51b728",
                                "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                                "text": "„Bislang sind die meisten Umwelterfolge in China nur Pyrrhussiege.“"
                            },
                            {
                                "example_id": "c1a7270d-18c5-4b65-afdc-2d43f791abe5",
                                "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                                "text": "„Vier Jahrzehnte später findet man in den israelischen Medien kaum einen Jubiläumskommentar, der nicht von einem Pyrrhussieg spricht.“"
                            },
                            {
                                "example_id": "fd3df695-e8ba-4fe6-aa4b-bfb156b0ec6d",
                                "sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
                                "text": "„Sarkissjan hatte die Präsidentschaftswahlen vom 19. Februar mit 52,9 Prozent der Stimmen knapp für sich entschieden - doch danach büßte er so sehr an Glaubwürdigkeit ein, dass sein Wahlerfolg nachträglich zum Pyrrhussieg geriet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11fe8d0c-34b6-40b4-b211-c88c3302103e",
                        "source_entry_id": "e73840cc-ae09-30ea-9cfe-bd6c25b1398f",
                        "source_sense_id": "6ec07057-31b9-32d3-940e-fa07418e46c7",
