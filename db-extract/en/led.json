                                        "glosses": [
                                            "elektronische lichtbron in de vorm van een diode die licht uitstraalt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fa56aed-e036-45da-9ce6-ca5fc506ba2e",
                                                "sense_id": "7771e1ff-1efe-3b5a-a641-76e83d299b62",
                                                "text": "Blauwe ledjes zijn een latere uitvinding dan rode of groene."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "08e6193f-91c4-430b-8c0a-d24650b4aedd",
                        "source_entry_id": "5ecebd0f-e97a-3ac2-8a9a-a8212920cb87",
                        "source_sense_id": "d3b8f47c-abf4-3c4c-88a5-432f75ff045f",
                        "source_sense_description": "LED — see also light-emitting diode",
                        "target_lang_word": "DEL",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "DEL",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9eab422a-457d-3833-94de-a7106a715acf",
                                        "entry_id": "84f9e0c5-0387-30b3-b21a-cea7b5def94b",
                                        "glosses": [
                                            "Diode semiconductrice à jonction qui émet une lumière colorée lorsqu’elle est traversée par un courant électrique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5debcf7-d747-47c6-b8bf-c92fc8d46250",
                                                "sense_id": "9eab422a-457d-3833-94de-a7106a715acf",
                                                "text": "Rares sont les modèles de voitures qui ne sortent pas de concession munis de phares à diodes électroluminescentes (DEL). S’ils améliorent la visibilité pour leurs conducteurs, ils nuisent à celle des automobilistes qu’ils croisent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2c0f99e5-394c-43eb-9a12-ef958090da1a",
                        "source_entry_id": "5ecebd0f-e97a-3ac2-8a9a-a8212920cb87",
                        "source_sense_id": "d3b8f47c-abf4-3c4c-88a5-432f75ff045f",
                        "source_sense_description": "LED — see also light-emitting diode",
                        "target_lang_word": "LED",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "LED",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe8da0d4-eb9a-3a59-8203-9b768c22efe6",
                                        "entry_id": "58be7f72-7f39-39f7-b6c5-26ddd37d2091",
                                        "glosses": [
                                            "Diode semiconductrice à jonction qui émet une lumière colorée ou blanche lorsqu’elle est traversée par un courant électrique."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd04e1f3-6715-436f-9871-e0e6056063e9",
                                                "sense_id": "fe8da0d4-eb9a-3a59-8203-9b768c22efe6",
                                                "text": "Bien qu’il ne soit que LCD LED, ce téléviseur a tout pour plaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e661ba8-fa0e-3416-8de1-b59a42ec388f",
                                        "entry_id": "58be7f72-7f39-39f7-b6c5-26ddd37d2091",
                                        "glosses": [
                                            "Un éclairage utilisant plusieurs diodes électroluminescentes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abcb6d67-fcb8-4c90-84df-254ad8d74052",
                                                "sense_id": "5e661ba8-fa0e-3416-8de1-b59a42ec388f",
                                                "text": "Les nouveaux feux LED des véhicules récents ont tendance à agresser un peu plus les yeux que les anciens phares hallogènes."
                                            },
                                            {
                                                "example_id": "16b03e5c-f9c3-4c72-9c82-6b0bed754deb",
                                                "sense_id": "5e661ba8-fa0e-3416-8de1-b59a42ec388f",
                                                "text": "L'on sait aujourd'hui que les LED à lumière visible provoquent deux usures bien distinctes de l'oeil : un endommagement photochimique de la rétine par \"exposition prolongée très intense\" et un autre par la fameuse lumière bleue. Les études montrent que les lésions de l'oeil interviennent très vite, après des durées d'exposition d'à peine 10 secondes."
                                            },
                                            {
                                                "example_id": "193f0779-c46f-4e0d-867b-ab43d3ddec72",
                                                "sense_id": "5e661ba8-fa0e-3416-8de1-b59a42ec388f",
                                                "text": "Les feux à LED, qui offrent une performance améliorée pour l’éclairage nocturne, sont devenus l’objet d’une grosse polémique en Grande-Bretagne. Leur luminosité intense provoque des éblouissements et inquiète du côté de la sécurité sur la route. Une pétition lancée par Gemma Mooney demande leur interdiction en pointant du doigt les risques potentiels (c’est un appel qui touche directement la sécurité routière). '...) Les phares à LED sont souvent jugés « dangereusement lumineux » et contraires aux règles de conduite qui conseillent d’éviter d’éblouir les autres."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "LED",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94091df1-ed5b-39e9-9763-61a90f0c712e",
                                        "entry_id": "254c2cb7-5877-30c9-bc83-a4ee024ff43b",
                                        "glosses": [
                                            "Lupus érythémateux disséminé."
                                        ],
                                        "tags": [
                                            "Nosologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "746e2449-1a90-4519-b758-e3e182c401ed",
                                                "sense_id": "94091df1-ed5b-39e9-9763-61a90f0c712e",
                                                "text": "Le LED est une maladie auto-immune caractérisée par la production d’Ac anti-nucléaires et la formation de complexes immuns responsables des lésions tissulaires"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "714393da-3843-4da3-98b8-6c68316909cb",
                        "source_entry_id": "5ecebd0f-e97a-3ac2-8a9a-a8212920cb87",
                        "source_sense_id": "d3b8f47c-abf4-3c4c-88a5-432f75ff045f",
                        "source_sense_description": "LED — see also light-emitting diode",
                        "target_lang_word": "LED",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "LED",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                        "entry_id": "9decacc4-bd71-3337-ac77-19f3679fef42",
                                        "glosses": [
                                            "Light Emitting Diode oder deutsch: Licht emittierende Diode"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "333b639a-4ed9-4cbe-96d1-272ec0c709f2",
                                                "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                                "text": "„Die Abkürzung LED steht für Licht emittierende Diode und bezeichnet ein elektronisches Halbleiter-Bauteil, das leuchtet, sobald Strom hindurchfließt.“"
                                            },
                                            {
                                                "example_id": "c9957a3e-dc52-453c-99b4-f531cf50439b",
                                                "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                                "text": "„LEDs wird eine strahlende Zukunft vorausgesagt, denn die winzigen Leuchten sind extrem energiesparend und spenden über Jahre hinweg zuverlässig Licht.“"
                                            },
                                            {
                                                "example_id": "77c468e0-a5d3-475b-b6ec-67720a43f1da",
                                                "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                                "text": "„Elektrisch wäre noch einiges zu sparen, aber als bekennender Warmduscher und Gegner der Kaltlichtenergiesparlampen rüste ich jetzt langsam auf LED um.“"
                                            },
                                            {
                                                "example_id": "c2db7879-76f2-49f9-a85b-6f8103cfce66",
                                                "sense_id": "48df2ad9-362e-3fa6-996d-fa90b4393834",
                                                "text": "„Tom zog seine Karte durch den kleinen Kartenleser neben dem Türrahmen, die grüne LED blinkte kurz, und die Tür sprang auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
