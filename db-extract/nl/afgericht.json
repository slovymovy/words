                "forms": [],
                "senses": [
                    {
                        "sense_id": "06af32f7-fd55-35bc-b417-6b179a849d9e",
                        "entry_id": "f7fc1616-f011-3c5d-bef0-008833b56800",
                        "glosses": [
                            "voltooid deelwoord van africhten"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "72b33905-d3b6-47a2-ba52-d1346c198c76",
                                "sense_id": "06af32f7-fd55-35bc-b417-6b179a849d9e",
                                "text": "Hij heeft de grote witte wolfshond afgericht om zijn kudde schapen te bewaken."
                            },
                            {
                                "example_id": "ad66ba2b-9517-4459-b2a7-ccbeaa46159b",
                                "sense_id": "06af32f7-fd55-35bc-b417-6b179a849d9e",
                                "text": "Hulphonden worden inmiddels ook afgericht om autistische kinderen en kinderen met andere ontwikkelingsstoornissen te helpen."
                            },
                            {
                                "example_id": "2b097137-3a30-4ead-9219-b01fa8591070",
                                "sense_id": "06af32f7-fd55-35bc-b417-6b179a849d9e",
                                "text": "Met speciaal afgerichte honden en varkens wordt gezocht naar bosvruchten."
                            },
                            {
                                "example_id": "a6d11342-b651-40a3-b6b9-868f6e069adc",
                                "sense_id": "06af32f7-fd55-35bc-b417-6b179a849d9e",
                                "text": "De honden zijn afgericht voor het zoeken naar truffels."
                            }
                        ]
                    }
