                "senses": [
                    {
                        "sense_id": "0e2e1959-9981-34d8-9761-a1c3e36e4555",
                        "entry_id": "a4f51a71-5e68-36cd-b618-58cfd4684cca",
                        "glosses": [
                            "光辉，耀眼的成就"
