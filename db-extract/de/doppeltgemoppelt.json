                "senses": [
                    {
                        "sense_id": "8b269166-f899-3074-ba0f-4fe7234302e3",
                        "entry_id": "818e188b-b1d0-30fc-b908-abf484a6a556",
                        "glosses": [
                            "zweimal, wo einmal gereicht hätte; überflüssig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16e06c02-74d1-448f-9f87-7f449795cf4d",
                                "sense_id": "8b269166-f899-3074-ba0f-4fe7234302e3",
                                "text": "Der »weiße Schimmel« ist ein Pleonasmus, oder auf gut Deutsch doppeltgemoppelt."
                            },
                            {
                                "example_id": "7eca5728-df61-4f49-83f8-1390eb424bbe",
                                "sense_id": "8b269166-f899-3074-ba0f-4fe7234302e3",
                                "text": "„Abgesehen davon, dachte Achim, daß es der Autor mit seinem Text nicht allzugut gemeint hatte und manches doppeltgemoppelt war, denn wo sonst als auf einer bewaldeten Ebene sollte der See wohl liegen, wenn ihn Wälder umgaben“"
                            }
                        ],
