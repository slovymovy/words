                    },
                    {
                        "translation_id": "335bb408-9339-498a-bbd3-3ebcc64b2215",
                        "source_entry_id": "fcb28cb2-600b-3656-90a0-175c62f3e460",
                        "source_sense_id": "b3284e6c-2d9f-3e75-ba46-0384e3a546c5",
                        "source_sense_description": "jemand, der professionell Gemüse kauft und verkauft",
                        "target_lang_word": "primeur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "primeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1be4e9be-0153-369e-b1d4-30fcbb963974",
                                        "entry_id": "f1bca7d2-29fc-38ac-b814-daacfd2cdafb",
                                        "glosses": [
                                            "Caractère de ce qui est nouveau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "940dd14c-9943-4b01-8205-651da812f758",
                                                "sense_id": "1be4e9be-0153-369e-b1d4-30fcbb963974",
                                                "text": "Vous avez eu la primeur de cette nouvelle."
                                            },
                                            {
                                                "example_id": "f4e3aab3-d47e-4c85-ad02-6e2f1c4b7556",
                                                "sense_id": "1be4e9be-0153-369e-b1d4-30fcbb963974",
                                                "text": "Nous avons obtenu de M. Isidore Beautrelet qu’il nous réservât la primeur de ses révélations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8152eff8-bddd-34d4-9475-807f26ab2463",
                                        "entry_id": "f1bca7d2-29fc-38ac-b814-daacfd2cdafb",
                                        "glosses": [
                                            "Première saison des fruits et des légumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb60bcd4-1681-473c-b858-62bdb6eef3ae",
                                                "sense_id": "8152eff8-bddd-34d4-9475-807f26ab2463",
                                                "text": "Le vieux bordeaux luisait comme un sang vermeil dans le fin cristal des verres, un filet de chevreuil aux truffes venait de mêler son fumet un peu âpre au parfum mourant des roses, lorsque des asperges apparurent, une primeur, si rare autrefois, et qui n’étonnait même plus."
                                            },
                                            {
                                                "example_id": "5747f095-c736-47e8-a05f-1b0876a2ba30",
                                                "sense_id": "8152eff8-bddd-34d4-9475-807f26ab2463",
                                                "text": "Des petits pois, ainsi préparés, peuvent se conserver plusieurs années sans perdre le goût qu'ils ont dans la primeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de54458f-5131-37c9-b28d-97fface00638",
                                        "entry_id": "f1bca7d2-29fc-38ac-b814-daacfd2cdafb",
                                        "glosses": [
                                            "Période qui suit la vendange, en parlant du vin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "031f39b2-5beb-4b37-9956-6f5bf6c31493",
                                                "sense_id": "de54458f-5131-37c9-b28d-97fface00638",
                                                "text": "Certains vins sont bons dans la primeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2510893-e26a-35b5-86c1-ad790b495a4d",
                                        "entry_id": "f1bca7d2-29fc-38ac-b814-daacfd2cdafb",
                                        "glosses": [
                                            "Fruits et légumes précoces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58224f9a-bab7-4bd1-bd6e-1f52e1b69d87",
                                                "sense_id": "d2510893-e26a-35b5-86c1-ad790b495a4d",
                                                "text": "On a servi des primeurs."
                                            },
                                            {
                                                "example_id": "615dc3ed-d1a7-4a3c-8243-411da3af6a54",
                                                "sense_id": "d2510893-e26a-35b5-86c1-ad790b495a4d",
                                                "text": "Elle se retint, elle n’osa commander des fraises, une primeur encore chère, de crainte de trop augmenter l’addition."
                                            },
                                            {
                                                "example_id": "55fe7d39-501c-4cec-bd8c-8ef868d25dd1",
                                                "sense_id": "d2510893-e26a-35b5-86c1-ad790b495a4d",
                                                "text": "Elle demanda des cerises de primeur, cueillies très loin de Paris, déjà flétries au bout de leurs queues sèches."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "primeur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b5724ef2-1d4a-37cf-80a0-4b45369407c0",
                                        "entry_id": "646c1a24-2e7b-3e17-a286-2c102c3d69fd",
                                        "glosses": [
                                            "Magasin spécialisé dans la vente de ces fruits et légumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b30ff61a-394d-4892-ac4a-a4591de7d332",
                                                "sense_id": "b5724ef2-1d4a-37cf-80a0-4b45369407c0",
                                                "text": "Il y a un primeur à côté de chez moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea483ff9-7f13-3068-86c5-59a857b98f95",
                                        "entry_id": "646c1a24-2e7b-3e17-a286-2c102c3d69fd",
                                        "glosses": [
                                            "Marchand de fruits et légumes de saison."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24371b17-0031-4a2a-aa85-adde0cd26837",
                                                "sense_id": "ea483ff9-7f13-3068-86c5-59a857b98f95",
                                                "text": "Un ancien employé de Belqacem, qui travaillait alors chez un primeur, achetait à l’occasion des légumes dans une vente à la criée qu’il destinait aux deux familles."
                                            }
                                        ]
                                    }
                                ]
                            },
