                "translations": [
                    {
                        "translation_id": "044d09f1-d2c5-4723-834d-37a84bc6c009",
                        "source_entry_id": "9d2b9eae-b315-3d85-b9d0-b0d73967ab9c",
                        "source_sense_id": "ec744d29-c2a7-366b-9c1e-5a464ef35799",
                        "target_lang_word": "sparkle",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sparkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84f2a6a7-c14f-3958-81f0-8a768dc9e332",
                                        "entry_id": "c45910d7-d65b-3d4e-86bd-bc355a42b7db",
                                        "glosses": [
                                            "A little spark; a scintillation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7a941ba-acf1-4a69-a606-0a330652868d",
                                                "sense_id": "84f2a6a7-c14f-3958-81f0-8a768dc9e332",
                                                "text": "As sparckles from the Anduile vse to fly, / When heauie hammers on the wedge are swaid"
                                            },
                                            {
                                                "example_id": "d103d0f6-bef4-4f5d-8b3b-ee550eded273",
                                                "sense_id": "84f2a6a7-c14f-3958-81f0-8a768dc9e332",
                                                "text": "The lamp was shaded, and the fire was dim, when suddenly the log, which had burnt through, gave way; a shower of sparkles rose from the hearth, and a bright blaze illuminated the room, falling full on Francesca's face, as she bent over the patient."
                                            },
                                            {
                                                "example_id": "4c8730e2-0983-4947-ba22-54d159abb91a",
                                                "sense_id": "84f2a6a7-c14f-3958-81f0-8a768dc9e332",
                                                "text": "The shock was sufficiently strong to strike out some sparkles of his fiery temper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a431f60-a66a-3ce9-81fd-b3d9114a291b",
                                        "entry_id": "c45910d7-d65b-3d4e-86bd-bc355a42b7db",
                                        "glosses": [
                                            "Brilliance; luster."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79c7a251-9168-443a-9cce-c882016b2876",
                                                "sense_id": "8a431f60-a66a-3ce9-81fd-b3d9114a291b",
                                                "text": "the sparkle of a diamond"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ea9a487-b1f4-3421-ae62-6c6e2e6da51c",
                                        "entry_id": "c45910d7-d65b-3d4e-86bd-bc355a42b7db",
                                        "glosses": [
                                            "Liveliness; vivacity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09041ddb-eecc-4442-89e3-aaf85889f0d2",
                                                "sense_id": "2ea9a487-b1f4-3421-ae62-6c6e2e6da51c",
                                                "text": "the sparkle of his conversation over dinner"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03862417-f991-38a6-8ed5-06a934dc1110",
                                        "entry_id": "c45910d7-d65b-3d4e-86bd-bc355a42b7db",
                                        "glosses": [
                                            "The quality of being sparkling or fizzy; effervescence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sparkle",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e5ec135-fd83-3f9f-a0a2-c4edafc34128",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To emit sparks; to throw off ignited or incandescent particles"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59b541e2-5db8-4e14-8b2b-38486d6777be",
                                                "sense_id": "9e5ec135-fd83-3f9f-a0a2-c4edafc34128",
                                                "text": "The wood was sparkling in the bonfire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3be891e-9775-3740-9545-c43359d219f3",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To shine as if throwing off sparks; to emit flashes of light; to scintillate; to twinkle"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d19f782f-ebf1-4f2a-8191-f48e46425ca3",
                                                "sense_id": "c3be891e-9775-3740-9545-c43359d219f3",
                                                "text": "The stars sparkle in the sky."
                                            },
                                            {
                                                "example_id": "3c635fa1-0bb0-4900-be7a-8d109ea180f3",
                                                "sense_id": "c3be891e-9775-3740-9545-c43359d219f3",
                                                "text": "Here, in the transept and choir, where the service was being held, one was conscious every moment of an increasing brightness; colours glowing vividly beneath the circular chandeliers, and the rows of small lights on the choristers' desks flashed and sparkled in front of the boys' faces, deep linen collars, and red neckbands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db3ac934-5cab-3f4a-81bc-13d1120390a7",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To manifest itself by, or as if by, emitting sparks; to glisten; to flash."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68e46024-2196-46a1-abab-7a5737cf4e22",
                                                "sense_id": "db3ac934-5cab-3f4a-81bc-13d1120390a7",
                                                "text": "I see bright honour sparkle through your eyes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14cde975-132d-39b8-b483-23e5da1d3512",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To emit little bubbles, as certain kinds of liquors; to effervesce"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "81e7fb1e-2eee-4a56-8dc7-1074cdcc5617",
                                                "sense_id": "14cde975-132d-39b8-b483-23e5da1d3512",
                                                "text": "sparkling wine"
                                            },
                                            {
                                                "example_id": "88a3b494-d4dd-4ded-aa0e-a614730f963e",
                                                "sense_id": "14cde975-132d-39b8-b483-23e5da1d3512",
                                                "text": "sparkling water"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccdf886f-6555-3fb9-acba-4343c2594b3c",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To emit in the form or likeness of sparks."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86a3d3a4-3c10-467b-98ee-b6ab3485b36c",
                                                "sense_id": "ccdf886f-6555-3fb9-acba-4343c2594b3c",
                                                "text": "That the bright glister of their beames cleare / Did sparckle forth great light, and glorious did appeare."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f25205f-b78d-3a7d-9db2-c2f4ca7e67e3",
                                        "entry_id": "2b0184a7-e9e5-32aa-b4d2-35b5917cf3c3",
                                        "glosses": [
                                            "To disperse."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
