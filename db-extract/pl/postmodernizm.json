                        "glosses": [
                            "XX-wieczny ruch artystyczny, kulturowy i filozoficzny odrzucający modernistyczny sposób myślenia"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65da5e8a-76ef-4fdf-b4b5-148384f27661",
                                "sense_id": "8d78c6d8-6788-3bde-966f-dd9f8bcf3dfc",
                                "text": "Postmodernizm to kierunek artystyczny, który stawia pod znakiem zapytania podstawowe zasady i idee modernizmu."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
