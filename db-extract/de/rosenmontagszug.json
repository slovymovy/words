                ],
                "senses": [
                    {
                        "sense_id": "8d719c22-b92f-3b08-a1af-abd1ddfd6290",
                        "entry_id": "75084687-1c50-37e4-af46-ab43f90b08a8",
                        "glosses": [
                            "Festumzug am Rosenmontag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e6ca1d8-2aa6-46f5-b66a-d2d0f4339880",
                                "sense_id": "8d719c22-b92f-3b08-a1af-abd1ddfd6290",
                                "text": "Im Jahr 2006 gehen beim Kölner Rosenmontagszug 44 Gruppen mit."
                            },
                            {
                                "example_id": "167ecdb4-cbe8-412c-b7d3-cb1b71abc46b",
                                "sense_id": "8d719c22-b92f-3b08-a1af-abd1ddfd6290",
                                "text": "Wir sehen uns die Übertragung des Rosenmontagszuges im Fernsehen an."
                            },
                            {
                                "example_id": "714e04a2-c365-4b18-851b-7e9b0e71ce74",
                                "sense_id": "8d719c22-b92f-3b08-a1af-abd1ddfd6290",
                                "text": "„Der Rosenmontagszug wurde eingeführt, welcher am Abend in einen großen Ball überging.“"
                            },
                            {
                                "example_id": "369573a1-a9f0-4da7-ac03-b3648f66e55b",
                                "sense_id": "8d719c22-b92f-3b08-a1af-abd1ddfd6290",
                                "text": "„Der Rosenmontagszug soll so stark wie nötig, aber so diskret wie möglich geschützt werden.“"
                            },
                            {
                                "example_id": "49cda548-04ee-486a-9e42-06e46cbeeef3",
                                "sense_id": "8d719c22-b92f-3b08-a1af-abd1ddfd6290",
                                "text": "„Je näher ich dem Schillerplatz kam, auf dem sich das Gouvernement der Garnison befand, desto dichter wurde das Gedränge: so ging es sonst nur zu, wenn an Fastnacht der Rosenmontagszug erwartet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
