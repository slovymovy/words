        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c465efd3-9a0a-3ddc-a074-46a15b22d332",
                    "sense_definition": "Released from an obligation, debt, or penalty; free or rid of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "free_from",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He paid the fine and was finally <w>quit</w> of his legal troubles.",
                            "target_lang_translations": {
                                "ru": "Он заплатил штраф и наконец <w>избавился</w> от проблем с законом."
                            }
