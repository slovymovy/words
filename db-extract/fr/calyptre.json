                        "sense_id": "5d5cb519-80f5-3fae-a2a2-3d60a7088d20",
                        "entry_id": "94302c86-cb89-3944-8cde-e78312f0652b",
                        "glosses": [
                            "Coiffe qui couvre l'urne des mousses."
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "94ee72d8-49b4-4240-80a8-eaa7990ca296",
                                "sense_id": "5d5cb519-80f5-3fae-a2a2-3d60a7088d20",
                                "text": "La coiffe ou calyptre qui provient du développement de l'archégone est constituée d’une fine membrane entourant complètement la capsule."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "845f61ed-3bde-4e4a-b363-96421744d541",
                        "source_entry_id": "94302c86-cb89-3944-8cde-e78312f0652b",
                        "source_sense_id": "5d5cb519-80f5-3fae-a2a2-3d60a7088d20",
                        "target_lang_word": "калиптра",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "калиптра",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a96b5bc1-28f4-38c7-aeab-122ba75471da",
                                        "entry_id": "279ec045-9c20-32bf-a0ff-281fbfe6ed9e",
                                        "glosses": [
                                            "истор. (у греков) женская верхняя одежда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0309214e-5ea2-479d-8677-d1515a6a1a80",
                                                "sense_id": "a96b5bc1-28f4-38c7-aeab-122ba75471da",
                                                "text": "Когда женщины хотели одеться попараднее и выйти из дома, они накидывали сверху гиматий, называвшийся иногда пеплос, иногда калиптра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fd69dd5-fd67-38b8-8050-dd4b4a481672",
                                        "entry_id": "279ec045-9c20-32bf-a0ff-281fbfe6ed9e",
                                        "glosses": [
                                            "ботан. (у моховидных) временный колпачок над развивающимся в архегонии спорофитом"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f5218f6-e016-41e2-80d5-10a8f5e14688",
                                                "sense_id": "3fd69dd5-fd67-38b8-8050-dd4b4a481672",
                                                "text": "Характерно наличие калиптры, состоящей из 2 сросшихся брактеолей и прикрывающей нераскрывшийся цветок, и многочисленных пельтатных волосков на нижней поверхности листьев и на веточках."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
            {
                "entry_id": "ed2d18b5-7a7b-323e-a60e-4cb8e8117522",
