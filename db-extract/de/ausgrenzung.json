                ],
                "senses": [
                    {
                        "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                        "entry_id": "ca1b52f9-61e2-3151-9753-ab1458cb2857",
                        "glosses": [
                            "Ausschluss von etwas oder jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c7179fa-8ea4-48e9-8935-a940bf55f54c",
                                "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                "text": "Der Mensch neigt zur Ausgrenzung des Fremden und der Fremden."
                            },
                            {
                                "example_id": "5daff690-0a58-4e58-b559-11f1c6e2c544",
                                "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                "text": "Eine so frühzeitige Ausgrenzung der Finanzierungsaspekte halte ich für riskant."
                            },
                            {
                                "example_id": "b99c16c1-42a3-489b-86e7-777f3a341481",
                                "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                "text": "„Es liegt nicht nur am Geld: Wer zur Unterschicht gehört, trägt in den Augen anderer oft die falsche Kleidung, spricht falsch und benimmt sich falsch. Klassismus wird diese kulturelle Ausgrenzung genannt, die sozialen Aufstieg fast unmöglich macht.“"
                            },
                            {
                                "example_id": "4e3d8a1a-cf2b-45de-9860-a9d1c94b6eae",
                                "sense_id": "b54bc99d-242f-3d09-97d5-0d683fb9250f",
                                "text": "„Obgleich es im Laufe der Geschichte immer wieder zu Spannungen zwischen Schiiten und Sunniten kam, die auch in Gewalt mündeten, führte die Zugehörigkeit zur Schia lange nicht zu einer politischen Ausgrenzung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
