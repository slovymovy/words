{
    "word_family": [
        "ownership",
        "own",
        "disown",
        "co-owner",
        "landowner",
        "homeowner",
        "shipowner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c409852-c7dd-36d4-81e2-3e46cdd3554e",
                    "sense_definition": "A person who has the legal right to something or possesses it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The police recovered the stolen car and returned it to its <w>owner</w>.",
                            "target_lang_translations": {
                                "ru": "Полиция нашла угнанный автомобиль и вернула его <w>владельцу</w>."
                            }
                        },
                        {
                            "text": "The <w>business</w> <w>owner</w> decided to expand the shop to a second location next year.",
                            "target_lang_translations": {
                                "ru": "<w>Владелец</w> бизнеса решил расширить магазин, открыв вторую точку в следующем году."
                            }
                        }
                    ],
                    "synonyms": [
                        "possessor",
                        "proprietor"
                    ],
                    "common_phrases": [
                        "business owner",
                        "home owner",
                        "rightful owner",
                        "property owner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Лицо, обладающее законным правом на что-либо или владеющее чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "владелец",
                                "target_lang_sense_clarification": "общий термин для обладателя чего-либо"
                            },
                            {
                                "target_lang_word": "собственник",
                                "target_lang_sense_clarification": "юридический владелец имущества"
                            },
                            {
                                "target_lang_word": "хозяин",
                                "target_lang_sense_clarification": "владелец вещи, дома или животного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3829d1f5-32fa-3aba-909b-02ed3b3b7cc2",
                    "sense_definition": "The captain or master of a ship.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maritime_roles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some maritime traditions, the crew would refer to the captain simply as the <w>owner</w>.",
                            "target_lang_translations": {
                                "ru": "В некоторых морских традициях экипаж называл капитана просто «<w>хозяин</w>»."
                            }
                        },
                        {
                            "text": "The <w>owner</w> of the vessel was responsible for the safety of everyone on board during the storm.",
                            "target_lang_translations": {
                                "ru": "<w>Капитан</w> судна нес ответственность за безопасность всех находившихся на борту во время шторма."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "maritime usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Капитан или мастер судна."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "капитан",
                                "target_lang_sense_clarification": "командир судна"
                            },
                            {
                                "target_lang_word": "хозяин",
                                "target_lang_sense_clarification": "разговорное обращение к капитану в морской среде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "871f07dc-ef79-3d0e-956c-d897f7954721",
                    "sense_definition": "A shortened term for an owner-type jeepney, a popular vehicle in the Philippines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "vehicles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He drove his <w>owner</w> through the narrow streets of the village.",
                            "target_lang_translations": {
                                "ru": "Он ехал на своем <w>оунере</w> по узким улочкам деревни."
                            }
                        },
                        {
                            "text": "The <w>owner</w> jeepney is a common sight in many rural areas of the country.",
                            "target_lang_translations": {
                                "ru": "Джипни типа <w>оунер</w> — обычное явление во многих сельских районах страны."
                            }
                        }
                    ],
                    "common_phrases": [
                        "owner jeepney"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Philippines"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сокращенное название джипни типа «owner», популярного автомобиля на Филиппинах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оунер-джипни",
                                "target_lang_sense_clarification": "тип транспортного средства на Филиппинах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}