                "senses": [
                    {
                        "sense_id": "78df19a9-3a5f-30d9-aa33-6bf9a17e7f24",
                        "entry_id": "901ed516-4ae4-3987-b8b6-4878b24495c4",
                        "glosses": [
                            "Donner un caractère acrobatique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fb2ce464-1f6f-42d5-b647-e46ecdc27e3d",
                                "sense_id": "78df19a9-3a5f-30d9-aa33-6bf9a17e7f24",
                                "text": "Il s’est prodigieusement diverti à l’acrobatiser, elle, cette ankylose totale, à la désarticuler, à la caoutchouquifier, corps et esprit, (...)"
                            },
                            {
                                "example_id": "238d1c8f-a62a-4643-a27c-67862045c198",
                                "sense_id": "78df19a9-3a5f-30d9-aa33-6bf9a17e7f24",
                                "text": "les poètes cherchent à faire acrobatiser les rimes, les prosateurs essayent d’obscurcir la langue et tous ces encriers, toutes ces plumes qui pourraient servir à de grandes œuvres, ne servent qu’à une chose : à faire de la réclame !"
                            }
                        ]
                    }
