                                        "glosses": [
                                            "Hunderasse, ursprünglich gezüchtet, um sie im „Bullenbeißen“ – Bullbiting war eine Form des Tierkampfes – auf Bullen zu hetzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a40874-bb1f-464c-9cc5-d5dd27637e06",
                                                "sense_id": "644ba815-1bb8-3ada-b7f5-d8e90793cddd",
                                                "text": "Er führte seine Bulldogge im Hundepark Gassi."
