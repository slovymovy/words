                            {
                                "target_word": "mushroom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5a5e3b5a-6b6f-3873-abe7-bb13b7f15df9",
                                        "entry_id": "8d4a44b0-8211-3150-835f-f55eca081f43",
                                        "glosses": [
                                            "Having characteristics like those of a mushroom, for example in shape or appearance, speed of growth, or texture."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "not-comparable"
                                        ],
                                        "examples": [
