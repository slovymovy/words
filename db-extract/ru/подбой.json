                "senses": [
                    {
                        "sense_id": "23584a66-2cf3-33ce-bed9-dd6eb47bda7a",
                        "entry_id": "6ec17a93-c5d3-3e0e-ba5a-b933855c8323",
                        "glosses": [
                            "lining, backing"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7189cd5d-835b-4e0c-90dd-5de7b4af90a3",
                                "sense_id": "23584a66-2cf3-33ce-bed9-dd6eb47bda7a",
                                "text": "В бе́лом плаще́ с крова́вым подбо́ем, ша́ркающей кавалери́йской похо́дкой, ра́нним у́тром четы́рнадцатого числа́ весе́ннего ме́сяца ниса́на в кры́тую колонна́ду ме́жду двумя́ кры́льями дворца́ И́рода вели́кого вы́шел прокура́тор Иуде́и По́нтий Пила́т. «Мастер и Маргари́та» - М.А.Булга́ков",
                                "translation": "Early in the morning on the fourteenth day of the spring month of Nisan, wearing a white cloak with a blood-red lining, and shuffling with his cavalryman’s gait into the roofed colonnade that connected the two wings of the palace of Herod the Great, walked the procurator of Judea, Pontius Pilate. \"The Master and Margarita\" - M. A. Bulgakov.",
                                "english": "Early in the morning on the fourteenth day of the spring month of Nisan, wearing a white cloak with a blood-red lining, and shuffling with his cavalryman’s gait into the roofed colonnade that connected the two wings of the palace of Herod the Great, walked the procurator of Judea, Pontius Pilate. \"The Master and Margarita\" - M. A. Bulgakov."
                            }
                        ]
                    }
