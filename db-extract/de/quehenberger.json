                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f1ea18a-8d6d-47bd-9812-e9cd0c710f2d",
                                "sense_id": "9dd02fbe-f1e3-3a9c-bd48-adf3296203c2",
                                "text": "Der Innsbrucker Keyboarder Philipp Quehenberger gilt spätestens seit seinem Umzug nach Wien Ende der 90er-Jahre nicht nur wegen seines gewagten, von der burgenländischen Gendarmerie selig abgeschauten Oberlippenbartes wie auch seiner früheren Eskapaden als lederbejackter Chaot zwischen Free Jazz, Techno und Rock 'n' Roll mit der Betonung auf dessen freizügigen Lebensstil als buntester (wie auch spieltechnisch begabtester) Vogel der Wiener Elektronikszene."
                            }
                        ],
                        "sense_index_json": "\"1\""
