                    "sense_definition": "Qui manque de probité, de loyauté ou qui cherche à tromper autrui.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "probité",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce commerçant a trompé ses clients en adoptant une pratique <w>malhonnête</w>.",
                            "target_lang_translations": {
                                "en": "This trader deceived his customers by adopting a <w>dishonest</w> practice.",
                                "ru": "Этот торговец обманул клиентов, прибегнув к <w>нечестной</w> практике.",
                                "nl": "Deze handelaar heeft zijn klanten bedrogen door een <w>oneerlijke</w> praktijk toe te passen.",
                                "de": "Dieser Händler hat seine Kunden getäuscht, indem er zu einer <w>unlauteren</w> Methode griff.",
                                "pl": "Ten handlowiec oszukał swoich klientów, stosując <w>nieuczciwą</w> praktykę.",
                                "it": "Questo commerciante ha ingannato i suoi clienti adottando una pratica <w>disonesta</w>.",
                                "cs": "Tento obchodník oklamal své zákazníky tím, že používal <w>nepoctivou</w> praktiku.",
                                "tr": "Bu tüccar, <w>dürüst olmayan</w> bir uygulama benimseyerek müşterilerini aldattı.",
                                "es": "Este comerciante engañó a sus clientes al adoptar una práctica <w>deshonesta</w>.",
                                "zh": "这位商人采用了<w>不诚实</w>的做法，欺骗了自己的顾客。"
                            }
                        },
                        {
                            "text": "Il a perdu l'estime de ses associés à cause de son comportement <w>malhonnête</w>.",
                            "target_lang_translations": {
                                "en": "He lost the respect of his associates because of his <w>dishonest</w> behaviour.",
                                "ru": "Он потерял уважение своих партнёров из-за своего <w>нечестного</w> поведения.",
                                "nl": "Hij heeft het respect van zijn zakenpartners verloren vanwege zijn <w>oneerlijk</w> gedrag.",
                                "de": "Wegen seines <w>unehrlichen</w> Verhaltens hat er das Ansehen seiner Geschäftspartner verloren.",
                                "pl": "Stracił szacunek swoich wspólników z powodu swojego <w>nieuczciwego</w> zachowania.",
                                "it": "Ha perso la stima dei suoi soci a causa del suo comportamento <w>disonesto</w>.",
                                "cs": "Kvůli svému <w>nepoctivému</w> chování ztratil úctu svých společníků.",
                                "tr": "<w>Dürüst olmayan</w> davranışları yüzünden ortaklarının saygısını yitirdi.",
                                "es": "Perdió la estima de sus socios a causa de su comportamiento <w>deshonesto</w>.",
                                "zh": "他因<w>不诚实</w>的行为而失去了合伙人的敬重。"
                            }
                        }
