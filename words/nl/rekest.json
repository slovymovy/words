{
    "word_family": [
        "rekestreren",
        "rekestrant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cd6be468-d06f-3c04-85dd-2d8e9ec9edf2",
                    "sense_definition": "Een formeel schriftelijk verzoek (verzoekschrift) gericht aan een rechter of een bestuursorgaan.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verzoekschrift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De advocaat diende gisteren een officieel <w>rekest</w> in bij de rechtbank.",
                            "target_lang_translations": {
                                "en": "The lawyer submitted an official <w>petition</w> to the court yesterday."
                            }
                        },
                        {
                            "text": "Hij stuurde direct een <w>rekest</w> op om bezwaar te maken tegen het besluit.",
                            "target_lang_translations": {
                                "en": "He immediately sent a <w>petition</w> to object to the decision."
                            }
                        }
                    ],
                    "synonyms": [
                        "rekwest"
                    ],
                    "common_phrases": [
                        "een rekest indienen",
                        "officieel rekest"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "juridische en bestuurlijke term"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A formal written request (petition) addressed to a judge or an administrative body."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "petition",
                                "target_lang_sense_clarification": "formal written request to a court or authority"
                            },
                            {
                                "target_lang_word": "written request",
                                "target_lang_sense_clarification": "formal application"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "40201693-60c7-3854-8ee9-9d748199c399",
                    "sense_definition": "Een formeel verzoek in het algemeen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verzoekschrift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn dringende <w>rekest</w> om hulp werd door de directie helaas afgewezen.",
                            "target_lang_translations": {
                                "en": "His urgent <w>request</w> for help was unfortunately rejected by the management."
                            }
                        },
                        {
                            "text": "Zij richtte een schriftelijk <w>rekest</w> tot de koning.",
                            "target_lang_translations": {
                                "en": "She addressed a written <w>petition</w> to the king."
                            }
                        }
                    ],
                    "synonyms": [
                        "rekwest"
                    ],
                    "common_phrases": [
                        "schriftelijk rekest"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "in de algemene betekenis van verzoek"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A formal request in general."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "petition",
                                "target_lang_sense_clarification": "formal request or appeal"
                            },
                            {
                                "target_lang_word": "request",
                                "target_lang_sense_clarification": "formal or polite demand"
                            }
                        ]
                    }
                }
            ]
        }
    ]
