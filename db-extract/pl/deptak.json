                    {
                        "translation_id": "3a5df306-479c-414d-8a4b-17952142b4c7",
                        "source_entry_id": "2590e943-a001-32b5-b26f-6a2d343167ee",
                        "source_sense_id": "49935179-14cb-3b55-8347-94b7b5120b97",
                        "target_lang_word": "rue piétonne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rue piétonne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c99e7aa3-49d0-3024-99a2-bb23a4c8913e",
                                        "entry_id": "405c38d8-59a7-3ab1-8375-f96feb957471",
                                        "glosses": [
                                            "Rue réservée aux piétons et aménagée en conséquence."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e431fe3d-74de-422f-8455-2c7d5d345dbd",
                        "source_entry_id": "2590e943-a001-32b5-b26f-6a2d343167ee",
                        "source_sense_id": "49935179-14cb-3b55-8347-94b7b5120b97",
                        "target_lang_word": "Fußgängerzone",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fußgängerzone",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "486ebe16-00bb-3798-a8ca-a355aa87c3d7",
                                        "entry_id": "3afd29d2-2272-305b-9369-3a3a95483bc5",
                                        "glosses": [
                                            "Bereich in einer Stadt, der nur für Fußgänger (und nicht für Fahrzeuge) bestimmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b3d27e8-c8c7-4830-9b0d-5014390898f2",
                                                "sense_id": "486ebe16-00bb-3798-a8ca-a355aa87c3d7",
                                                "text": "In einer Fußgängerzone lässt es sich herrlich flanieren, einkaufen und bei seinem Lieblingsgetränk entspannen."
                                            },
                                            {
                                                "example_id": "fc573b6b-fcef-450e-aa3c-5e37b53fc89d",
                                                "sense_id": "486ebe16-00bb-3798-a8ca-a355aa87c3d7",
                                                "text": "Als besonders ordentlich und sicher galt vor allem die Fußgängerzone, die vor gut 50 Jahren erfunden wurde."
                                            },
                                            {
                                                "example_id": "789034c4-7119-4ec6-9a9c-f91f30e13087",
                                                "sense_id": "486ebe16-00bb-3798-a8ca-a355aa87c3d7",
                                                "text": "Da mochten in den Fußgängerzonen noch so viele Anden-Indianer ihre Panflöten malträtieren, um die falsche Ruhe zu vertreiben: Die Trostlosigkeit dieser pseudourbanen Douglas-Schlecker-Burger-King-Areale war nicht zu überbieten."
                                            },
                                            {
                                                "example_id": "ea25c1e2-31ab-47e0-8056-62df3af6ba1d",
                                                "sense_id": "486ebe16-00bb-3798-a8ca-a355aa87c3d7",
                                                "text": "Gepflastert mit kaugummiverklebten Granitplatten, zugestellt mit Blumenkübeln aus Waschbeton, aufgehübscht mit Bronzeschweinchen, Bronzekühen oder auch einem Künstlerbrunnen, waren die Fußgängerzonen spätestens nach Geschäftsschluss menschenleer."
                                            },
                                            {
                                                "example_id": "73749cc7-25ec-439a-b930-e6d6b3d44a9e",
                                                "sense_id": "486ebe16-00bb-3798-a8ca-a355aa87c3d7",
                                                "text": "An einzelnen Orten wie der Fußgängerzone in der Calle Regina ging das Konzept auf. Seit neuestem sind die Mezcalerien und Taquerien in dieser Straße gut besucht."
                                            },
                                            {
                                                "example_id": "32145f2f-4771-4c5c-b514-6f3e577506de",
                                                "sense_id": "486ebe16-00bb-3798-a8ca-a355aa87c3d7",
                                                "text": "„Die Lage des Hauptbahnhofs stellt sich klassischerweise in nächster Nähe zur Innenstadt und Fußgängerzone dar (…) .“"
                                            },
                                            {
                                                "example_id": "51b829d3-59b6-497b-a5c2-09c495f3bb5f",
                                                "sense_id": "486ebe16-00bb-3798-a8ca-a355aa87c3d7",
                                                "text": "„Dafür spielen diese zur Strafe bis zum heutigen Tag Panflöte in der Fußgängerzone.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
