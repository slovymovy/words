                "senses": [
                    {
                        "sense_id": "873e32d4-2014-3e9e-a404-d1ae2f6cf2ee",
                        "entry_id": "ec085569-5432-307d-ad59-fe887f019320",
                        "glosses": [
                            "Exercer un pouvoir de seigneur sur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03ff286c-3b63-457d-ac66-71c8555ec375",
                                "sense_id": "873e32d4-2014-3e9e-a404-d1ae2f6cf2ee",
                                "text": "Dans la vallée du Tibre, Jean-Paul Baglioni seigneurise (Signerigga) la République de Perouse; Vitellozzo, Vittelli exercent le même pouvoir sur Citta di Castello."
                            },
                            {
                                "example_id": "471c23e7-a245-40b5-8c04-09a3029fab32",
                                "sense_id": "873e32d4-2014-3e9e-a404-d1ae2f6cf2ee",
                                "text": "elle n'a plaisir que de lui désobéir, car c’est elle qui « seigneurise »."
                            },
                            {
                                "example_id": "91ea67ae-5c98-4e8e-bf62-64b9df38f5f3",
                                "sense_id": "873e32d4-2014-3e9e-a404-d1ae2f6cf2ee",
                                "text": "Évidemment cette maison avait été bâtie sur les ruines de quelque petit castel perché là comme un anneau qui rattachait Le Croisic et le bourg de Batz à Guérande, et qui seigneurisait les marais."
                            }
                        ]
                    }
