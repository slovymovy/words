                        "entry_id": "c9179ee0-fdfd-39b4-bdbe-962792613b03",
                        "glosses": [
                            "Person, die verschuldeten oder überschuldeten Personen dabei behilflich ist, Lösungen für ihr Schuldenproblem zu finden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c20207e0-39b3-4e91-84be-5c65e9d877f6",
                                "sense_id": "fa322519-ec35-393c-98c5-04a22a0ef009",
                                "text": "„Die Schuldnerberater fordern, dass sich Private auch nach 2026 innerhalb von drei Jahren entschulden können.“"
                            },
                            {
                                "example_id": "6fb27b0f-fc65-444f-9e13-200bc2792f19",
                                "sense_id": "fa322519-ec35-393c-98c5-04a22a0ef009",
                                "text": "„Und wer nur noch Schulden zu seinen Besitztümern zählt, auch dem Manne kann geholfen werden: Schwupps, kommt Peter Zwegat, der Schuldnerberater und kümmert sich rührend darum […].“"
                            }
                        ],
