                        "sense_id": "97150e99-67b8-3013-9ef2-8bacfcb162d6",
                        "entry_id": "ebc38875-19ef-35fa-8ef5-139ddb0c846f",
                        "glosses": [
                            "forma organizacji pracy polegająca na świadczeniu pracy poza jednostką organizacyjną pracodawcy za pomocą środków komunikacji elektronicznej"
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "1260953a-1450-4363-a4a9-5c601e3beac7",
                                "sense_id": "97150e99-67b8-3013-9ef2-8bacfcb162d6",
                                "text": "Telepraca jest wreszcie sposobem na tworzenie rozproszonych zespołów pracowników, którzy są zlokalizowani w różnych miejscach, ale faktycznie przebywają i pracują w tej samej przestrzeni wirtualnej […]"
                            },
                            {
                                "example_id": "728b0477-7dbb-4a27-a751-9aa7d1bb06c1",
                                "sense_id": "97150e99-67b8-3013-9ef2-8bacfcb162d6",
                                "text": "W Stanach Zjednoczonych najczęściej używa się terminu „praca zdalna\" (telecommuting), podczas gdy w Europie powszechnie posługujemy się terminem „telepraca\""
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
