                    {
                        "sense_id": "c32fb7aa-dc4d-3ddf-8356-852fc6be356e",
                        "entry_id": "a4c95cdd-30d5-37cd-86fc-1b8ba14ba2d0",
                        "glosses": [
                            "iemand die postkaarten en brieven bezorgt bij de geadresseerden"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "c2baa6d1-c6cd-4a95-a430-448b5bba981d",
                                "sense_id": "c32fb7aa-dc4d-3ddf-8356-852fc6be356e",
                                "text": "Niet de gebruikelijke postbesteller, nee, diens oudere broer bracht verslag uit."
                            },
                            {
                                "example_id": "4ac489ff-b95a-47f4-a059-faedf106d3a9",
                                "sense_id": "c32fb7aa-dc4d-3ddf-8356-852fc6be356e",
                                "text": "Op die manier heeft de 29-jarige Sheka C. volgens het OM zo'n 200.000 euro buitgemaakt. Hij is in april gearresteerd en moet op 24 oktober voorkomen. Sheka C. werkte voor postbesteller Sandd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f4b6c349-dbe6-4b6e-92a5-de340c006026",
                        "source_entry_id": "a4c95cdd-30d5-37cd-86fc-1b8ba14ba2d0",
                        "source_sense_id": "c32fb7aa-dc4d-3ddf-8356-852fc6be356e",
                        "source_sense_description": "iemand die postkaarten en brieven bezorgt bij de geadresseerden",
                        "target_lang_word": "postman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                        "entry_id": "805a16e7-f3d6-3ef7-8b6b-1d37cf434926",
                                        "glosses": [
                                            "Someone who delivers the post (mail) to, and/or collects the post from, residential or commercial addresses, or from public mailboxes."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8a34950-5ffd-4a12-a236-5afb01ed97cd",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "The total of their members amounts to 342,723 for 1875. Among these number … 6,968 male and sixty-three female postmen, imperial railway, telegraph, and post officials, railway workmen, dependent boatmen, waiters, &c.; …"
                                            },
                                            {
                                                "example_id": "f98ffdbf-5275-4153-9fbe-b21c1e32242d",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "A single narrow iron-clamped door formed the only means of entrance. On this our guide knocked with a peculiar postman-like rat-tat."
                                            },
                                            {
                                                "example_id": "4a3da9dc-1c66-4e45-a759-de689c6e549f",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "Please, Mr. Postman, look and see / Is there a letter in your bag for me? / Please, please, Mr. Po-o-ostman"
                                            },
                                            {
                                                "example_id": "dacf7bd5-b854-41f0-81b4-ad8a20107b86",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "The headmistress entered and told the girls \"I want you to do everything you can to help the war effort—you are old enough to do it now.\" The girls changed into women postmen, head waiters, soldiers, landgirls, butchers and carpenters."
                                            },
                                            {
                                                "example_id": "0543c322-f292-439a-80ee-d9afe2d3d659",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "Postmen, binmen, dock workers, even barristers are now on strike. Where will all this end?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf5011e-7293-3ea6-9743-1774571cd720",
                                        "entry_id": "805a16e7-f3d6-3ef7-8b6b-1d37cf434926",
                                        "glosses": [
                                            "One of the two most experienced barristers in the Court of Exchequer, who have precedence in motions, so called from the place where he sits, the other of the two being the tubman."
                                        ],
                                        "tags": [
                                            "England",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62483e68-5cd2-4ed3-9881-88c730d3bc6a",
                                                "sense_id": "fcf5011e-7293-3ea6-9743-1774571cd720",
                                                "text": "Postman of the Court of Exchequer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
