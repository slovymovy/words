                                            "Bildende Kunst"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "089e81df-7a5a-4080-bf22-d8b3376f1a45",
                                                "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                                                "text": "„Er trat während der ersten Strophe neben das Bild des amtierenden Staatspräsidenten, das in jedem Klassenzimmer neben dem Kruzifix hängen musste, und salutierte bei der letzten Strophe.“"
                                            },
                                            {
                                                "example_id": "f90d5a7a-63ec-44ac-9681-fce4a50e601a",
                                                "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                                                "text": "„Unter dem Kruzifix neben dem ausgebrannten Öllämpchen nahm sich die Rose wahrhaft königlich aus.“"
                                            },
                                            {
                                                "example_id": "84c55c56-3baa-4893-bbd8-35e224719791",
                                                "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                                                "text": "„Kerzen brennen zu beiden Seiten des Kruzifixes.“"
                                            },
                                            {
                                                "example_id": "33a9219d-ac8c-41bc-9ae9-8a2eeb6ed6cd",
                                                "sense_id": "e36e9021-e824-3ae2-b2ad-0ae3ff98f024",
                                                "text": "„An der Wand hing ein Kruzifix.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "60dd1f81-f3e5-315f-b548-ef97dabf9814",
                                        "entry_id": "4be2b582-0eef-3df9-a82f-84394ad7ae8e",
                                        "glosses": [
                                            "Fluchwort"
                                        ],
                                        "tags": [
