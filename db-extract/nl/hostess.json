                        "examples": [
                            {
                                "example_id": "f1b240e0-5504-42e1-a4fb-3c20c9924bec",
                                "sense_id": "ec3bc486-3450-318e-a013-32e63c14f4fc",
                                "text": "Een hostess is een vrouw die in een vliegtuig de reizigers bedient of degene die een radio- of televisieprogramma presenteert."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db0738ac-a0f6-4fdd-984b-28ecfa284285",
                        "source_entry_id": "d53c5d1b-9b5d-33ce-b653-18485de2a138",
                        "source_sense_id": "ec3bc486-3450-318e-a013-32e63c14f4fc",
                        "target_lang_word": "hostess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e06374c-b3b2-3659-aae7-c280c8ae848c",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "A female host."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5e5102f-755b-49ab-bfe8-b6b9d2d3361a",
                                                "sense_id": "6e06374c-b3b2-3659-aae7-c280c8ae848c",
                                                "text": "The host and hostess greeted their guests at the door."
                                            },
                                            {
                                                "example_id": "fef5e017-910a-47b4-b083-8ca1359bb0d8",
                                                "sense_id": "6e06374c-b3b2-3659-aae7-c280c8ae848c",
                                                "text": "The [Washington] Post's proprietor through those turbulent [Watergate] days, Katharine Graham, held a double place in Washington’s hierarchy: at once regal Georgetown hostess and scrappy newshound, ready to hold the establishment to account."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6587cd55-8b72-34be-b78c-96ef7cd35586",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "A female innkeeper."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58e6db8c-1daa-34f4-bc7d-3c70efa1445b",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "Stewardess: a woman steward on an airplane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6c4abd70-1fe6-302f-bdd7-c0283a5c2ff7",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "A bar hostess or bargirl; a paid female companion offering conversation and in some cases sex."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83348956-3ea3-379d-a50f-c887bcc86cca",
                                        "entry_id": "eb7f1b3f-d0a9-39e2-b2f6-1132c7906f43",
                                        "glosses": [
                                            "A female prostitute."
                                        ],
                                        "tags": [
                                            "Philippines"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "hostess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8803db3f-2e46-3122-b18b-6ab76372cac0",
                                        "entry_id": "afa93739-fb09-3a25-9707-b1d30a3f40e2",
                                        "glosses": [
                                            "To host, as a woman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "037bfe1c-738e-49f3-92b2-dec5ca76f84b",
                                                "sense_id": "8803db3f-2e46-3122-b18b-6ab76372cac0",
                                                "text": "Later in January, the alum club hostessed the initiation brunch at the Pi Beta Phi chapter house. It was thrilling to see so many girls with such enthusiasm!"
                                            },
                                            {
                                                "example_id": "b66db123-b373-4a77-8fb5-3a3a4a0914b7",
                                                "sense_id": "8803db3f-2e46-3122-b18b-6ab76372cac0",
                                                "text": "Over the years she has maintained a close relationship with several former students. Currently, she alternates between visiting and hostessing two in Roanoke and Greenville, N.C., respectively, and is a proud godgrandmother to one’s new baby."
                                            },
                                            {
                                                "example_id": "89aeec64-884e-42c9-8eb1-da5141c9d2fd",
                                                "sense_id": "8803db3f-2e46-3122-b18b-6ab76372cac0",
                                                "text": "Dad and I had left early to make sure to get a booth in the back. But when I got there, Teddy Selander’s older sister was hostessing and she said, ‘You’re meeting Dean West? He’s sitting right over here,’ loud enough for everyone to hear."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3e1c426b-1a7b-4bbd-b61b-82e17591dae9",
                        "source_entry_id": "d53c5d1b-9b5d-33ce-b653-18485de2a138",
                        "source_sense_id": "ec3bc486-3450-318e-a013-32e63c14f4fc",
                        "target_lang_word": "stewardess",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stewardess",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f152c035-eca1-390f-bf36-ea11b95f0acf",
                                        "entry_id": "2340a23e-b1bc-3429-8323-133f0d2a4e30",
                                        "glosses": [
                                            "A female flight attendant (a member of the crew of an airplane who is responsible for the comfort and safety of its passengers)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "20c54c0a-b991-30e9-93df-974b36ffda81",
                                        "entry_id": "2340a23e-b1bc-3429-8323-133f0d2a4e30",
                                        "glosses": [
                                            "A woman who works at housekeeping and passenger service aboard a ship, yacht, or other type of boat that carries passengers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9481762-57e2-4f58-b2ec-abf907094ec3",
                                                "sense_id": "20c54c0a-b991-30e9-93df-974b36ffda81",
                                                "text": "She usually rang for the stewardess early, but this morning of course there had been no ring. The stewardess had gone in all the same about eight o'clock and found the cabin empty."
                                            },
                                            {
                                                "example_id": "46816762-5b38-4ffc-b7bf-f2617debefd4",
                                                "sense_id": "20c54c0a-b991-30e9-93df-974b36ffda81",
                                                "text": "Certainly a stewardess who may have fifty or even a hundred passengers to look after cannot give much attention to nursing, even if she knows how."
                                            },
                                            {
                                                "example_id": "a616e23b-548e-4fd4-9a3d-61035f1dd606",
                                                "sense_id": "20c54c0a-b991-30e9-93df-974b36ffda81",
                                                "text": "He regarded the tray with apprehension, then with dismay as the stewardess said: \"She's just rung for breakfast in bed, going to stay there all day as she feels a cold coming.\""
                                            },
                                            {
                                                "example_id": "90f515ec-8e34-4877-bc83-8e57cc53f546",
                                                "sense_id": "20c54c0a-b991-30e9-93df-974b36ffda81",
                                                "text": "I came into the industry as a chef with restaurant and catering experience but no real understanding of what the whole role of \"stewardess\" entailed on board."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46b81770-356c-367e-94bf-9175ddc722b0",
                                        "entry_id": "2340a23e-b1bc-3429-8323-133f0d2a4e30",
                                        "glosses": [
                                            "A female steward (any sense)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8325c0d6-2dea-4d63-acf5-574ffe12c566",
                                                "sense_id": "46b81770-356c-367e-94bf-9175ddc722b0",
                                                "text": "The stewardess, principal inspector of the cow stable and the butter establishment, was indeed with the young lady, who had just entered the yard."
                                            },
                                            {
                                                "example_id": "86f5f16e-fc9a-42c1-9beb-056739705464",
                                                "sense_id": "46b81770-356c-367e-94bf-9175ddc722b0",
                                                "text": "The occasion – the very first trip of a stewardess on Capitol, eastbound B & O […]"
                                            },
                                            {
                                                "example_id": "c504e7ee-de23-45a4-95a9-a0253bb9455d",
                                                "sense_id": "46b81770-356c-367e-94bf-9175ddc722b0",
                                                "text": "Arbitrator John Day Larkin upholds the discharge of a female employee who had a fight with a union stewardess on a company parking lot."
                                            },
                                            {
                                                "example_id": "17035e04-34e7-4ae7-96f2-c4351d5abbee",
                                                "sense_id": "46b81770-356c-367e-94bf-9175ddc722b0",
                                                "text": "On the transfer of any hostess or stewardess from one permanent base to another, the employer shall pay the expenses properly incurred by the hostess or stewardess for the removal of her dependants, her furniture, and personal effects, such expenses to be mutually agreed upon."
                                            },
                                            {
                                                "example_id": "63f96ec4-3640-43b1-b401-6f42c1beb523",
                                                "sense_id": "46b81770-356c-367e-94bf-9175ddc722b0",
                                                "text": "The kitchen stewardess says madam sits there glaring at the paper on the wall."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
