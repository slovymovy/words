            {
                "entry_id": "e2db3ff2-f70e-3fbc-ae90-0f23fbdcb46f",
                "word": "mimi",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fd1a07a0-b943-33ba-8df1-ac2e68144c9c",
                        "entry_id": "e2db3ff2-f70e-3fbc-ae90-0f23fbdcb46f",
                        "glosses": [
                            "rondtrekkende artiesten die hun publiek vermaakten met pantomime, imitaties, jongleren, goochelen en komische of spannende voordrachten"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "3da01cdf-702d-4307-818f-32601edd7f65",
                                "sense_id": "fd1a07a0-b943-33ba-8df1-ac2e68144c9c",
                                "text": "⧖ Een paar verzen der Alexandreïs waarin over mimi gesproken wordt, geeft hij aldus weer:\nDie menestrele quamer mede\nVor dien coninc in die stede\nEnde loofdene met haren sanghe.\nDaer was menich trompe langhe,\nVedelen, haerpen ende sijmphonien,\nCystolen die wel leren vrien,\nSalterien, orghelen ende sciven.\n Wanneer hij dan echter op den laatsten regel laat volgen:\nMen speelder met sweerden ende met kniven\n dan zien wij hoe rekbaar het begrip speelman was en dat het in de middeleeuwen ook allerlei kunstenmakers omvatte."
                            }
                        ]
                    }
                ],
