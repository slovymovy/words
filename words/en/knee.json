                    "target_lang_definitions": {
                        "ru": "Место рядом с родителем или старшим, где сидит и учится маленький ребенок.",
                        "zh": "小孩坐在父母或长辈身边接受教导的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "колени",
                                "target_lang_sense_clarification": "в идиомах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "膝前",
                                "target_lang_sense_clarification": "多用于习语，指长辈身边受教之处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "793d2493-60c3-3c5b-8568-563b334258f0",
                    "sense_definition": "A piece of wood or metal bent at an angle used to support parts of a ship or building.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shipbuilder installed a strong timber <w>knee</w> to support the deck beams.",
                            "target_lang_translations": {
                                "ru": "Кораблестроитель установил прочную деревянную <w>кницу</w> для поддержки палубных балок.",
                                "zh": "造船工安装了一块结实的木<w>肘板</w>来支撑甲板横梁。"
                            }
                        },
                        {
                            "text": "A metal <w>knee</w> was used to brace the corner of the wooden frame.",
                            "target_lang_translations": {
                                "ru": "Металлический <w>угольник</w> использовался для укрепления угла деревянной рамы.",
                                "zh": "木框的角部用了一个金属<w>角撑</w>来加固。"
                            }
