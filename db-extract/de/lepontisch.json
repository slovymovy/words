                "senses": [
                    {
                        "sense_id": "629e767f-f80e-3aa4-96a8-92eedc89eb6e",
                        "entry_id": "cb3cd05f-be97-38c8-bef7-430f32fcd727",
                        "glosses": [
                            "untergegangene festlandkeltische Sprache in Oberitalien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "811b1b72-fe9f-4b3c-ae92-4b58d280e546",
                                "sense_id": "629e767f-f80e-3aa4-96a8-92eedc89eb6e",
                                "text": "„Bereits aus dem 6. und 5. Jahrhundert vor Christus stammen Inschriften in der keltischen Sprache Lepontisch, die in der Nähe von Como entdeckt wurden.“"
                            },
                            {
                                "example_id": "473cd6db-8803-4be9-a0cb-23c75d0ac051",
                                "sense_id": "629e767f-f80e-3aa4-96a8-92eedc89eb6e",
                                "text": "„In vorrömischer Zeit wurden Varianten des Festlandkeltischen in Spanien (Keltiberisch), Frankreich (Gallisch), Norditalien (Lepontisch), in Mitteleuropa bis nach Rumänien und Bulgarien gesprochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
