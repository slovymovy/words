                "translations": [
                    {
                        "translation_id": "690de645-c593-4347-9fa7-7a10324bff42",
                        "source_entry_id": "19dba765-705a-33ae-ba93-e96a26a0ce2f",
                        "source_sense_id": "cb3159bc-89a1-31bd-be77-0a21e8b28bcf",
