                        "tags": [],
                        "examples": [
                            {
                                "example_id": "672b6515-fd34-4b20-9c7e-edc79a5e7d18",
                                "sense_id": "5c41b752-596f-3bca-a039-71fe292c5280",
                                "text": "Ich bin in Fehmarn geboren."
                            },
                            {
                                "example_id": "427ef6a9-e4d6-4e55-8711-04fe138922e7",
                                "sense_id": "5c41b752-596f-3bca-a039-71fe292c5280",
                                "text": "Wir haben in Fehmarn unseren Urlaub verbracht."
                            },
                            {
                                "example_id": "8fdf9b4d-279f-466f-ba23-773b422b8113",
                                "sense_id": "5c41b752-596f-3bca-a039-71fe292c5280",
                                "text": "Fehmarn liegt auf der Nordhalbkugel."
                            },
                            {
                                "example_id": "afc294f1-35ae-4fd3-906f-1331631b28a5",
                                "sense_id": "5c41b752-596f-3bca-a039-71fe292c5280",
                                "text": "Fehmarn ist ein beliebtes Urlaubsziel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a1eb616a-4742-3c13-8f33-efe29bfec94a",
                        "entry_id": "93ff5ee7-b429-37c8-b30b-c0bb60c25097",
                        "glosses": [
