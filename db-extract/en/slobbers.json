        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "86302caa-5656-3070-b24a-e0efaa7e6492",
                "word": "slobbers",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3c82560d-07fe-3ff1-8a5e-0ce615179f6c",
                        "entry_id": "86302caa-5656-3070-b24a-e0efaa7e6492",
                        "glosses": [
                            "Any of various conditions in which an animal drools excessively (for example due to mycotoxicosis or problems with its teeth)."
                        ],
                        "tags": [
                            "plural",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "6f4cf2b1-9c00-4c8b-a042-5b4bb3be9d78",
                                "sense_id": "3c82560d-07fe-3ff1-8a5e-0ce615179f6c",
                                "text": "The slobbers are caused by this second growth, whether green or dry."
                            },
                            {
                                "example_id": "baef3e81-78c8-4b5b-a396-e5cb9a11443b",
                                "sense_id": "3c82560d-07fe-3ff1-8a5e-0ce615179f6c",
                                "text": "Slobbers are also caused by irregular teeth, the lodgement of corncobs or other foreign substances between the teeth. SYMPTOMS: -Persistent excessive discharge of saliva, or frothy mass exuding from the mouth. Great desire[…]"
                            },
                            {
                                "example_id": "ea4b493b-e919-4256-a62c-ade05d051c31",
                                "sense_id": "3c82560d-07fe-3ff1-8a5e-0ce615179f6c",
                                "text": "\"Slobbers\" is caused by an oversupply of gastric juice in the stomach. Be sure the rabbit has plenty of salt."
                            },
                            {
                                "example_id": "340e3ccc-1a1d-47e2-9220-91fb9ef0b678",
                                "sense_id": "3c82560d-07fe-3ff1-8a5e-0ce615179f6c",
                                "text": "[…] swainsonine might be a contributory mycotoxin accounting for some of the symptoms in naturally occurring outbreaks of slobbers. This is a particularly important observation because it has often been noticed that pure slaframine does[…]"
                            },
                            {
                                "example_id": "a51b4281-0919-4fad-ba03-e9e8260c89ca",
                                "sense_id": "3c82560d-07fe-3ff1-8a5e-0ce615179f6c",
                                "text": "Some outbreaks of slobbers have been associated with forage grasses; however, no causal fungus has as yet been isolated[…] The connection between R. leguminicola and slobbers was made when the Wisconsin group (Smalley et al., 1962) isolated R. leguminicola from slobber hay. The slobber factor was soon isolated from two different strains of the fungus[…]"
                            },
                            {
                                "example_id": "ae170ee9-2c60-4401-86de-fea55bb03001",
                                "sense_id": "3c82560d-07fe-3ff1-8a5e-0ce615179f6c",
                                "text": "Slobbers is a symptom of another problem, such as an abscessed tooth or contaminated hay."
                            },
                            {
                                "example_id": "a01206fe-3124-4901-9d3b-b8fdf412a99b",
                                "sense_id": "3c82560d-07fe-3ff1-8a5e-0ce615179f6c",
                                "text": "Slobbers is the layman's term for moist dermatitis around the face or dewlap, usually caused by ptyalism and dental disease."
                            }
                        ]
                    }
                ],
