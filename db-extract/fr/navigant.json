                        "glosses": [
                            "Aéronaute."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d780adb1-72ff-40b6-ba46-3f90f30aee1a",
                                "sense_id": "3954bfee-b7f8-3a5f-a3ae-43707ce4aca9",
                                "text": "Un navigant peut aller consulter n’importe quel médecin pour la validation de son dossier médical, à la seule condition que ce dernier en soit agréé."
                            },
                            {
                                "example_id": "2002e95b-1af2-43ec-b72d-420365d3144a",
                                "sense_id": "3954bfee-b7f8-3a5f-a3ae-43707ce4aca9",
                                "text": "Par ailleurs, la compagnie aérienne britannique est aussi condamnée à verser 40 000 euros au Syndicat national du personnel naviguant [(sic !)] commercial (SNPNC), 40 000 euros à l'Union des navigants de l'aviation civile et 20 000 euros à un commandant de bord, tous partie civile dans ce procès."
                            }
                        ]
                    }
