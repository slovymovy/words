                        ]
                    },
                    {
                        "translation_id": "7c3e4708-1b87-4cb7-bc3d-94513a61a212",
                        "source_entry_id": "12f5512d-586d-3b27-9507-82903c0c7b5e",
                        "source_sense_id": "9af14e6d-88b2-3a04-9c17-9dcc6a2760b0",
                        "target_lang_word": "launenhaft",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "launenhaft",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28e185d7-c0e6-3648-801d-e3fb980d45e3",
                                        "entry_id": "af9c4bec-f4e8-3f6f-ba7b-cf922931e80f",
                                        "glosses": [
                                            "voll wechselnder Stimmungen, unberechenbar, voller Launen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1910ba0-5042-48b7-be3c-2c1180b82b86",
                                                "sense_id": "28e185d7-c0e6-3648-801d-e3fb980d45e3",
                                                "text": "… Herzog Karl IV., ein tapferer Soldat, aber einer der sonderbarsten und launenhaftesten Charaktere, war eher geeignet, der Intrigue in die Hände zu arbeiten, als sie unschädlich zu machen."
                                            },
                                            {
                                                "example_id": "0e1aacb4-532c-4e51-9a0d-a98967b4f08a",
                                                "sense_id": "28e185d7-c0e6-3648-801d-e3fb980d45e3",
                                                "text": "Oliver Glasner sieht Europa-League-Sieger Eintracht Frankfurt von seinem Image als launenhafter und exzentrischer Altmeister befreit."
                                            },
                                            {
                                                "example_id": "92dc7c67-1bc0-4844-b878-541b3d239b68",
                                                "sense_id": "28e185d7-c0e6-3648-801d-e3fb980d45e3",
                                                "text": "Ja, das Glück ist launenhaft: es hilft nicht, nur den rechten Augenblick zu begreifen, man muß ihn auch auf die richtige Art ergreifen."
                                            },
                                            {
                                                "example_id": "de5ffb00-f2b6-4cee-a902-27e684f646b9",
                                                "sense_id": "28e185d7-c0e6-3648-801d-e3fb980d45e3",
                                                "text": "Denn die Natur, eine launenhafte Diva, scheint ihren eigenen Willen zu entwickeln und zeigt sich nicht immer von ihrer Sonnenseite …"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "92ade142-5f09-49c8-ae59-2374e6c8e2f4",
                        "source_entry_id": "12f5512d-586d-3b27-9507-82903c0c7b5e",
                        "source_sense_id": "9af14e6d-88b2-3a04-9c17-9dcc6a2760b0",
