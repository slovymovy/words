{
    "word_family": [
        "smart",
        "smartly",
        "smarten"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bdc5a1ef-634c-3d2b-8e23-076d375c078e",
                    "sense_definition": "The quality of being intelligent, clever, or mentally quick.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her academic success was due to sheer <w>smartness</w> and hard work.",
                            "target_lang_translations": {
                                "es": "Su éxito académico se debió a pura <w>inteligencia</w> y trabajo duro."
                            }
                        },
                        {
                            "text": "The manager admired the employee for his tactical <w>smartness</w> in negotiations.",
                            "target_lang_translations": {
                                "es": "El gerente admiraba al empleado por su <w>astucia</w> táctica en las negociaciones."
                            }
                        }
                    ],
                    "synonyms": [
                        "intelligence",
                        "cleverness",
                        "shrewdness"
                    ],
                    "antonyms": [
                        "stupidity",
                        "foolishness"
                    ],
                    "target_lang_definitions": {
                        "es": "Cualidad de ser inteligente, despierto o rápido mentalmente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "inteligencia",
                                "target_lang_sense_clarification": "capacidad mental general"
                            },
                            {
                                "target_lang_word": "astucia",
                                "target_lang_sense_clarification": "habilidad para desenvolverse o negociar con ingenio"
                            },
                            {
                                "target_lang_word": "agudeza",
                                "target_lang_sense_clarification": "rapidez o perspicacia mental"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e5d21470-770d-36a8-a2fd-68b0edf37658",
                    "sense_definition": "The quality of being stylish, neat, or elegant in appearance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The staff were praised for the neatness and <w>smartness</w> of their uniforms.",
                            "target_lang_translations": {
                                "es": "El personal fue elogiado por la pulcritud y <w>elegancia</w> de sus uniformes."
                            }
                        },
                        {
                            "text": "A general air of <w>smartness</w> returned to the old station after it was repainted.",
                            "target_lang_translations": {
                                "es": "Un aire general de <w>pulcritud</w> regresó a la antigua estación después de que la pintaran."
                            }
                        }
                    ],
                    "synonyms": [
                        "neatness",
                        "elegance",
                        "tidiness"
                    ],
                    "antonyms": [
                        "untidiness",
                        "shabbiness"
                    ],
                    "common_phrases": [
                        "air of smartness"
                    ],
                    "target_lang_definitions": {
                        "es": "Cualidad de ser elegante, pulcro o bien presentado en apariencia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "elegancia",
                                "target_lang_sense_clarification": "buena apariencia o porte"
                            },
                            {
                                "target_lang_word": "pulcritud",
                                "target_lang_sense_clarification": "aspecto limpio, aseado y ordenado"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab2e4ec2-ea8a-34e4-97fa-498a871818db",
                    "sense_definition": "A clever or witty remark or act.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher had little patience for such sudden bursts of <w>smartness</w> during class.",
                            "target_lang_translations": {
                                "es": "El profesor tenía poca paciencia para tales muestras repentinas de <w>insolencia</w> durante la clase."
                            }
                        },
                        {
                            "text": "His clever retort was regarded as mere <w>smartness</w> rather than genuine wit.",
                            "target_lang_translations": {
                                "es": "Su ingeniosa réplica fue considerada una mera <w>impertinencia</w> más que un verdadero ingenio."
                            }
                        }
                    ],
                    "synonyms": [
                        "cleverness",
                        "witticism"
                    ],
                    "target_lang_definitions": {
                        "es": "Comentario o acto ingenioso, a menudo percibido como impertinente o listillo."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "insolencia",
                                "target_lang_sense_clarification": "comportamiento de creerse muy listo o responder con descaro"
                            },
                            {
                                "target_lang_word": "agudeza",
                                "target_lang_sense_clarification": "comentario mordaz o ingenioso"
                            },
                            {
                                "target_lang_word": "impertinencia",
                                "target_lang_sense_clarification": "salida de tono o contestación lista"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}