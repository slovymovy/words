                "senses": [
                    {
                        "sense_id": "255c0d17-3327-34bd-be0f-049f82393d93",
                        "entry_id": "1732e35c-837b-3a17-85ea-b13bb3383854",
                        "glosses": [
                            "Celles et ceux."
                        ],
                        "tags": [
                            "Peu usité",
                            "Langage épicène"
                        ],
                        "examples": [
                            {
                                "example_id": "a11b1ee2-e0c6-445c-a086-5a871fa59478",
                                "sense_id": "255c0d17-3327-34bd-be0f-049f82393d93",
                                "text": "De plus le processus de discussion va empêcher celleux qui parlent bien ou fort de monopoliser la parole."
                            },
                            {
                                "example_id": "2363672d-2722-4078-8010-ab2f3d46cc71",
                                "sense_id": "255c0d17-3327-34bd-be0f-049f82393d93",
                                "text": "Il y avait les artistes, celleux qui pensent le monde et créent des nouveaux imaginaires, et nous, les non-artistes, qui gérons le monde plus rationnellement."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad3fcac6-28e2-389e-8fab-b33f6b9e8bca",
                        "entry_id": "1732e35c-837b-3a17-85ea-b13bb3383854",
                        "glosses": [
                            "Personnes non binaires dont on parle."
                        ],
                        "tags": [
                            "Peu usité",
                            "Langage épicène",
                            "Variations diaéthiques"
                        ],
                        "examples": [
                            {
                                "example_id": "9c1b2057-6740-47c2-a65e-afef63c6f228",
                                "sense_id": "ad3fcac6-28e2-389e-8fab-b33f6b9e8bca",
                                "text": "À ceux, celles et celleux qui m’ont précédée, qui se sont révolté-e-s, se sont battu-e-s, ont survécu aux épidémies, ont pleuré […] et grâce à qui j’ai tant de libertés."
                            }
                        ]
                    }
