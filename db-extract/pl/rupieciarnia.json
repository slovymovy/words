                    },
                    {
                        "translation_id": "3d756364-a867-49f1-91f1-03cf2783094b",
                        "source_entry_id": "faaf7139-e9b8-3919-b015-37bcfa1206aa",
                        "source_sense_id": "c7bff2a7-606b-33e6-84e6-df92e9eeb46a",
                        "target_lang_word": "Rumpelkammer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rumpelkammer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "35945cfd-4a28-358f-a8dd-9aad760268a1",
                                        "entry_id": "68db94cd-0a4c-3fbd-b96f-2d28bc0f2ff3",
                                        "glosses": [
                                            "Raum, in dem selten oder gar nicht mehr benutzte Gegenstände aufbewahrt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5e3a157-3a39-497b-a558-911cdcb59ff9",
                                                "sense_id": "35945cfd-4a28-358f-a8dd-9aad760268a1",
                                                "text": "Wir sollten unsere Rumpelkammer endlich mal aufräumen."
                                            },
                                            {
                                                "example_id": "9f9beb96-27fc-4f72-bde0-b1e43f116a06",
                                                "sense_id": "35945cfd-4a28-358f-a8dd-9aad760268a1",
                                                "text": "„Der gespreizte Mensch zwang sie vielmehr häufig in die Rumpelkammer, wo sie prustend und schluckend ihrer stürmischen Heiterkeit Herr zu werden suchten.“"
                                            },
                                            {
                                                "example_id": "861b7d94-2b52-4ec1-9dbc-518703461aa7",
                                                "sense_id": "35945cfd-4a28-358f-a8dd-9aad760268a1",
                                                "text": "„All dieser und anderer Trödelkram aus der Rumpelkammer vieler Zeiten bot sich dar wie eine Antiquitätensammlung in einem Museum.“"
                                            },
                                            {
                                                "example_id": "72b809e2-f520-4e9c-8024-87bb9cf3ad53",
                                                "sense_id": "35945cfd-4a28-358f-a8dd-9aad760268a1",
                                                "text": "„Sie standen vor dem übervollen Kleiderschrank in ihrem alten Zimmer, der in den letzten Jahren zu einer Rumpelkammer geworden war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
