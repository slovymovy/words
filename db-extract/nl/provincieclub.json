                        "glosses": [
                            "een sportclub uit de provincie; een sportclub die niet op het hoogste niveau uitkomt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d51d74e8-9310-4c88-a520-6167641b913d",
                                "sense_id": "6e38c52b-795b-311a-b159-eb690386b1b1",
                                "text": "De vaste werknemers loeren op fouten van de freelancers als voetballers van een provincieclubje die blij zijn als er in de eredivisie ook een keer een bal wordt gemist."
                            },
                            {
                                "example_id": "10d90dd6-36b1-49a8-8c9f-e8bc760fb916",
                                "sense_id": "6e38c52b-795b-311a-b159-eb690386b1b1",
                                "text": "Net als bij Milan vond Berlusconi met Monza, de club die hij in 2018 overnam, samen met zijn trouwe rechterhand Adriano Galliani de weg omhoog. De kleine provincieclub keerde in 2020 terug naar de Serie B. Vorig jaar kwam de club ook al dichtbij promotie naar het hoogste niveau, maar toen strandde Monza in de play-offs."
                            }
                        ]
                    }
