                        "source_sense_id": "f2c98a62-af03-332b-83ef-e2adb6af465b",
                        "source_sense_description": "Besteck zum Verzehr von Eiern",
                        "target_lang_word": "egg spoon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "egg spoon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33b19979-a465-371e-9566-306601403e41",
                                        "entry_id": "75cdb2ca-0e59-3c3b-a956-af42aaac54cb",
                                        "glosses": [
                                            "A spoon, usually smaller than a teaspoon, which is used for eating a boiled egg from a hole made in the shell; the bowl of the spoon is shaped to make it easier to scoop out the contents of the eggshell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e30c7153-816a-4d35-921e-bd41ee062407",
                                                "sense_id": "33b19979-a465-371e-9566-306601403e41",
                                                "text": "[T]he egg spoon must also be untarnishable—stainless steel, or horn. I've never seen a gold egg spoon, but I'm sure it would do. Whatever the material, the spoon has to have a small bowl with a fine edge on it: a thick edge can't coax all the egg white off the inside of the shell. The handle is short, for good balance and easy handling. An egg spoon is a tiny implement that, like the Viennese breakfast, cannot be improved."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
