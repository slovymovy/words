{
    "word_family": [
        "запрашивать",
        "запросить",
        "запросный"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f4f1c089-850d-3973-a035-d2b60c5bebc7",
                    "sense_definition": "Официальное обращение с просьбой или требованием предоставить какие-либо сведения или объяснения.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "request_info",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы направили официальный <w>запрос</w> в министерство для получения документов.",
                            "target_lang_translations": {
                                "en": "We sent an official <w>request</w> to the ministry to obtain the documents.",
                                "pl": "Wysłaliśmy oficjalny <w>wniosek</w> do ministerstwa w celu uzyskania dokumentów."
                            }
                        },
                        {
                            "text": "На ваш <w>запрос</w> о наличии товара мы ответим в течение суток.",
                            "target_lang_translations": {
                                "en": "We will reply to your <w>inquiry</w> regarding product availability within 24 hours.",
                                "pl": "Na Państwa <w>zapytanie</w> o dostępność towaru odpowiemy w ciągu doby."
                            }
                        }
                    ],
                    "synonyms": [
                        "просьба",
                        "требование"
                    ],
                    "common_phrases": [
                        "официальный запрос",
                        "отправить запрос",
                        "письменный запрос",
                        "депутатский запрос"
                    ],
                    "target_lang_definitions": {
                        "en": "An official appeal asking for information or explanations.",
                        "pl": "Oficjalne zwrócenie się z prośbą lub żądaniem o udzielenie informacji lub wyjaśnień."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "request",
                                "target_lang_sense_clarification": "formal act of asking"
                            },
                            {
                                "target_lang_word": "inquiry",
                                "target_lang_sense_clarification": "request for information"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wniosek",
                                "target_lang_sense_clarification": "formalny dokument lub prośba"
                            },
                            {
                                "target_lang_word": "zapytanie",
                                "target_lang_sense_clarification": "prośba o udzielenie informacji"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43dfb78d-1a83-3ebd-b2b6-c30a849f2a79",
                    "sense_definition": "Команда или инструкция для поиска и извлечения информации из базы данных или поисковой системы.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "it_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Сервер не смог обработать этот сложный <w>запрос</w> из-за ошибки.",
                            "target_lang_translations": {
                                "en": "The server failed to process this complex <w>query</w> due to an error.",
                                "pl": "Serwer nie mógł przetworzyć tego złożonego <w>zapytania</w> z powodu błędu."
                            }
                        },
                        {
                            "text": "Я ввёл поисковый <w>запрос</w> и нашёл нужную статью.",
                            "target_lang_translations": {
                                "en": "I entered a search <w>query</w> and found the necessary article.",
                                "pl": "Wpisałem <w>zapytanie</w> w wyszukiwarkę i znalazłem potrzebny artykuł."
                            }
                        }
                    ],
                    "common_phrases": [
                        "поисковый запрос",
                        "запрос к базе данных",
                        "обработать запрос",
                        "сетевой запрос"
                    ],
                    "target_lang_definitions": {
                        "en": "A command or instruction used to retrieve information from a database or search engine.",
                        "pl": "Polecenie lub instrukcja służąca do wyszukiwania i pobierania informacji z bazy danych lub wyszukiwarki."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "query",
                                "target_lang_sense_clarification": "database or search instruction"
                            },
                            {
                                "target_lang_word": "request",
                                "target_lang_sense_clarification": "network or server call"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zapytanie",
                                "target_lang_sense_clarification": "instrukcja w bazie danych"
                            },
                            {
                                "target_lang_word": "kwerenda",
                                "target_lang_sense_clarification": "techniczne określenie wyszukiwania"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e34264bc-0878-398c-935e-3460bd0ff918",
                    "sense_definition": "(обычно во мн. ч.) Внутренние потребности, интересы и уровень притязаний человека к качеству жизни.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "needs",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У него слишком высокие <w>запросы</w>, поэтому ему трудно угодить.",
                            "target_lang_translations": {
                                "en": "He has such high <w>demands</w>, so it is difficult to please him.",
                                "pl": "Ma zbyt wysokie <w>wymagania</w>, dlatego trudno go zadowolić."
                            }
                        },
                        {
                            "text": "Книги помогают формировать духовные <w>запросы</w> молодого поколения.",
                            "target_lang_translations": {
                                "en": "Books help shape the spiritual <w>needs</w> of the younger generation.",
                                "pl": "Książki pomagają kształtować duchowe <w>potrzeby</w> młodego pokolenia."
                            }
                        }
                    ],
                    "synonyms": [
                        "потребность",
                        "стремление"
                    ],
                    "common_phrases": [
                        "высокие запросы",
                        "духовные запросы",
                        "скромные запросы"
                    ],
                    "target_lang_definitions": {
                        "en": "(usually plural) A person's internal needs, interests, and standards regarding quality of life.",
                        "pl": "Wewnętrzne potrzeby, zainteresowania i oczekiwania człowieka dotyczące jakości życia."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "needs",
                                "target_lang_sense_clarification": "internal requirements"
                            },
                            {
                                "target_lang_word": "demands",
                                "target_lang_sense_clarification": "expectations or claims"
                            },
                            {
                                "target_lang_word": "expectations",
                                "target_lang_sense_clarification": "standards for satisfaction"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wymagania",
                                "target_lang_sense_clarification": "wysokie standardy lub oczekiwania"
                            },
                            {
                                "target_lang_word": "potrzeby",
                                "target_lang_sense_clarification": "wewnętrzne dążenia"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6a1364ad-aae2-313a-a382-1e4df77e69e3",
                    "sense_definition": "Общественная или рыночная потребность в чём-либо; спрос.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "market_demand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В обществе сформировался чёткий <w>запрос</w> на перемены и реформы.",
                            "target_lang_translations": {
                                "en": "A clear <w>demand</w> for change and reform has formed in society.",
                                "pl": "W społeczeństwie ukształtowało się wyraźne <w>zapotrzebowanie</w> na zmiany i reformy."
                            }
                        },
                        {
                            "text": "Компания старается удовлетворить растущий потребительский <w>запрос</w>.",
                            "target_lang_translations": {
                                "en": "The company tries to satisfy the growing consumer <w>demand</w>.",
                                "pl": "Firma stara się zaspokoić rosnący <w>popyt</w> konsumencki."
                            }
                        }
                    ],
                    "synonyms": [
                        "требование",
                        "потребность"
                    ],
                    "antonyms": [
                        "предложение"
                    ],
                    "common_phrases": [
                        "запрос на справедливость",
                        "общественный запрос",
                        "потребительский запрос"
                    ],
                    "target_lang_definitions": {
                        "en": "A public or market need for something.",
                        "pl": "Społeczne lub rynkowe zapotrzebowanie na coś."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "demand",
                                "target_lang_sense_clarification": "market or social need"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "zapotrzebowanie",
                                "target_lang_sense_clarification": "rynkowe lub społeczne oczekiwanie"
                            },
                            {
                                "target_lang_word": "popyt",
                                "target_lang_sense_clarification": "ekonomiczne określenie rynku"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e20442f5-0c03-3fdb-bd3b-76a696fcdbdb",
                    "sense_definition": "Назначение цены, превышающей реальную стоимость товара; запрашивание лишнего.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "trade_archaic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Продавец честно назвал цену без всякого <w>запроса</w>.",
                            "target_lang_translations": {
                                "en": "The seller honestly stated the price without any <w>overcharge</w>.",
                                "pl": "Sprzedawca uczciwie podał cenę bez żadnej <w>wygórowanej marży</w>."
                            }
                        },
                        {
                            "text": "Покупатели торговались, пытаясь сбить большой <w>запрос</w> купца.",
                            "target_lang_translations": {
                                "en": "The buyers bargained, trying to drive down the merchant's high <w>asking price</w>.",
                                "pl": "Kupujący targowali się, próbując zbić wysoką <w>cenę wywoławczą</w> kupca."
                            }
                        }
                    ],
                    "synonyms": [
                        "запрашивание"
                    ],
                    "antonyms": [
                        "скидка"
                    ],
                    "common_phrases": [
                        "цена без запроса",
                        "продавать с запросом"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The act of setting a price higher than the real value; asking too much.",
                        "pl": "Ustalenie ceny wyższej niż rzeczywista wartość towaru; żądanie zbyt wysokiej kwoty."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "overcharge",
                                "target_lang_sense_clarification": "excessive price"
                            },
                            {
                                "target_lang_word": "asking price",
                                "target_lang_sense_clarification": "initial price set by seller"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "wygórowana cena",
                                "target_lang_sense_clarification": "zbyt wysoka cena"
                            },
                            {
                                "target_lang_word": "marża",
                                "target_lang_sense_clarification": "dodatkowa opłata"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}