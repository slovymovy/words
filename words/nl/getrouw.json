                                "es": "Siempre cumplía sus tareas de manera <w>fiel</w>."
                            }
                        },
                        {
                            "text": "De soldaat bleef <w>getrouw</w> aan zijn plicht tijdens de crisis.",
                            "target_lang_translations": {
                                "en": "The soldier remained <w>true</w> to his duty during the crisis.",
                                "es": "El soldado permaneció <w>fiel</w> a su deber durante la crisis."
                            }
