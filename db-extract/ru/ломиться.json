                "senses": [
                    {
                        "sense_id": "93b5a4b1-8f7e-3f04-98c3-bcce5a205185",
                        "entry_id": "661131b9-7061-36bf-b378-1a03943ee979",
                        "glosses": [
                            "to be (near to) breaking (with), to burst (with)"
                        ],
                        "tags": [
                            "third-person"
                        ],
                        "examples": [
                            {
                                "example_id": "45c75537-5120-45b7-b716-803886728026",
                                "sense_id": "93b5a4b1-8f7e-3f04-98c3-bcce5a205185",
                                "text": "по́лки ло́мятся от книг",
                                "translation": "the shelves are crammed with books",
                                "english": "the shelves are crammed with books"
                            },
                            {
                                "example_id": "c3160301-e89b-423c-8db3-ccea95c0aaa8",
                                "sense_id": "93b5a4b1-8f7e-3f04-98c3-bcce5a205185",
                                "text": "по́лки магази́нов ло́мятся от това́ров",
                                "translation": "shop shelves are overladen with goods",
                                "english": "shop shelves are overladen with goods"
                            },
                            {
                                "example_id": "278daddb-9bc5-4ed7-a89f-8d7dd2b1614c",
                                "sense_id": "93b5a4b1-8f7e-3f04-98c3-bcce5a205185",
                                "text": "ве́тви ло́мятся от плодо́в",
                                "translation": "the boughs are groaning with fruit",
                                "english": "the boughs are groaning with fruit"
                            }
                        ]
                    },
                    {
                        "sense_id": "7d8b1bcb-319b-3e4e-a3f7-d33e1c365cd0",
                        "entry_id": "661131b9-7061-36bf-b378-1a03943ee979",
                        "glosses": [
                            "to force one's way (to, into), to come in crowds (to), to flock (to)"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "f4cfe63c-4d9e-426c-916e-de38543378fd",
                                "sense_id": "7d8b1bcb-319b-3e4e-a3f7-d33e1c365cd0",
                                "text": "наро́д ло́мится на конце́рт",
                                "translation": "people are flocking to the show; the show is packing them in",
                                "english": "people are flocking to the show; the show is packing them in"
                            },
                            {
                                "example_id": "b81a5cd3-e430-4c67-97a6-f87d60724f75",
                                "sense_id": "7d8b1bcb-319b-3e4e-a3f7-d33e1c365cd0",
                                "text": "ломи́ться в откры́тую дверь",
                                "translation": "(try to) force an open door; try to prove the obvious; ≈ preach to the choir",
                                "english": "(try to) force an open door; try to prove the obvious; ≈ preach to the choir"
                            }
