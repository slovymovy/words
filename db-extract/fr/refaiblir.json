                "senses": [
                    {
                        "sense_id": "089f0637-d87d-32ee-ab80-6dbd3d345518",
                        "entry_id": "b34a8877-77a9-3689-8f4d-16d674d04692",
                        "glosses": [
                            "Faiblir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edd52dfa-9101-4717-9731-84a1d3153c23",
                                "sense_id": "089f0637-d87d-32ee-ab80-6dbd3d345518",
                                "text": "La neige continue de tomber et la c'est fort voire même abondant mais elle devrait refaiblir dans quelques instants malheureusement. ( malheuresementmalheuresement corrigé en malheureusement)"
                            },
                            {
                                "example_id": "bcb1af1c-5924-46c9-a841-499042009d1b",
                                "sense_id": "089f0637-d87d-32ee-ab80-6dbd3d345518",
                                "text": "J'en ai assez de faire des efforts et de refaiblir à chaque fois... à chaque fois me faire piétiner... et être obligée de montrer les dents pour survivre."
                            },
                            {
                                "example_id": "9340d5ac-9840-4acf-adf2-33304040ecb6",
                                "sense_id": "089f0637-d87d-32ee-ab80-6dbd3d345518",
                                "text": "Tu peux revoir une personne que t'as aimé et ne plus rien ressentir, comme tu peux refaiblir pour lui."
                            }
                        ]
                    }
                ],
