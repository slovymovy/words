                            {
                                "target_lang_word": "přiléhavý",
                                "target_lang_sense_clarification": "velmi přesný, např. o popisu či poznámce"
                            },
                            {
                                "target_lang_word": "trefný",
                                "target_lang_sense_clarification": "výstižný, přesně mířený"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3618fe13-698a-3c0e-afdf-799e81b60111",
                    "sense_definition": "Having a natural tendency to do something; likely.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "tendency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Without a warm coat, you are <w>apt</w> to catch a cold in this weather.",
                            "target_lang_translations": {
                                "ru": "Без теплого пальто вы <w>рискуете</w> простудиться в такую погоду.",
                                "de": "Ohne einen warmen Mantel sind Sie bei diesem Wetter <w>anfällig</w> dafür, sich zu erkälten.",
                                "cs": "Bez teplého kabátu jste v tomto počasí <w>náchylní</w> k nachlazení."
                            }
                        },
                        {
                            "text": "He is <w>apt</w> to forget his keys when he leaves the house in a hurry.",
                            "target_lang_translations": {
                                "ru": "Он <w>склонен</w> забывать ключи, когда в спешке выходит из дома.",
                                "de": "Er ist <w>geneigt</w>, seine Schlüssel zu vergessen, wenn er das Haus in Eile verlässt.",
                                "cs": "Má <w>sklon</w> zapomínat klíče, když odchází z domu ve spěchu."
                            }
                        }
                    ],
                    "synonyms": [
                        "inclined",
                        "prone",
                        "liable",
                        "disposed"
                    ],
                    "antonyms": [
                        "unlikely"
                    ],
                    "common_phrases": [
                        "apt to be",
                        "apt to forget",
                        "apt to happen"
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий естественную склонность к чему-либо; вероятный.",
                        "de": "Eine natürliche Neigung zu etwas habend; wahrscheinlich.",
                        "cs": "Mající přirozený sklon k něčemu; pravděpodobný."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "склонный",
                                "target_lang_sense_clarification": "имеющий предрасположенность"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "geneigt",
                                "target_lang_sense_clarification": "eine Tendenz zu einem bestimmten Verhalten habend"
                            },
                            {
                                "target_lang_word": "anfällig",
                                "target_lang_sense_clarification": "leicht dazu neigend, etwas Negatives zu erfahren"
                            }
                        ],
                        "cs": [
                            {
                                "target_lang_word": "náchylný",
                                "target_lang_sense_clarification": "mající tendenci k něčemu negativnímu"
                            },
                            {
                                "target_lang_word": "mající sklon",
                                "target_lang_sense_clarification": "pravděpodobně něco udělá"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "762fb0a0-bbcc-3ba8-8dbc-0164a192f9b1",
                    "sense_definition": "Quick to learn or understand.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "intelligence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was an <w>apt</w> student who mastered the difficult subject very quickly.",
                            "target_lang_translations": {
                                "ru": "Она была <w>способной</w> ученицей, которая очень быстро освоила этот трудный предмет.",
                                "de": "Sie war eine <w>begabte</w> Schülerin, die das schwierige Fach sehr schnell meisterte.",
                                "cs": "Byla to <w>bystrá</w> studentka, která zvládla obtížný předmět velmi rychle."
                            }
                        },
                        {
                            "text": "The boy proved to be an <w>apt</w> learner during his apprenticeship.",
                            "target_lang_translations": {
                                "ru": "Мальчик оказался <w>понятливым</w> учеником во время стажировки.",
                                "de": "Der Junge erwies sich während seiner Ausbildung als <w>aufnahmefähiger</w> Lerner.",
                                "cs": "Chlapec se během učení projevil jako <w>schopný</w> žák."
                            }
                        }
                    ],
                    "synonyms": [
                        "quick",
                        "clever",
                        "sharp",
                        "bright"
                    ],
                    "antonyms": [
                        "slow",
                        "dull"
