                ],
                "senses": [
                    {
                        "sense_id": "bd753c6c-1666-30f8-a16f-86357b12b2b1",
                        "entry_id": "982e50a2-ac11-32e1-9fc2-dc320eb74018",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41b98809-5269-460c-8e27-e7480415bbcc",
                                "sense_id": "bd753c6c-1666-30f8-a16f-86357b12b2b1",
                                "text": "Frau Trefz ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "efd521b3-02f7-4aac-ae72-60a589ec34ba",
                                "sense_id": "bd753c6c-1666-30f8-a16f-86357b12b2b1",
                                "text": "Herr Trefz wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "d3aeee5d-7982-40d6-ae32-60f72744e051",
                                "sense_id": "bd753c6c-1666-30f8-a16f-86357b12b2b1",
                                "text": "Die Trefzens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "f5eb08fe-c754-4918-bff8-1b3b64fd51c4",
                                "sense_id": "bd753c6c-1666-30f8-a16f-86357b12b2b1",
                                "text": "Der Trefz trägt nie die Schals, die die Trefz ihm strickt."
                            },
                            {
                                "example_id": "82e26b57-096f-4f23-afe1-ac0d5ed4ee34",
                                "sense_id": "bd753c6c-1666-30f8-a16f-86357b12b2b1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Trefz kommt, geht der Herr Trefz.“"
                            },
                            {
                                "example_id": "99aa648e-d065-4fae-894c-1d57b797da0b",
                                "sense_id": "bd753c6c-1666-30f8-a16f-86357b12b2b1",
                                "text": "Trefz kommt und geht."
                            },
                            {
                                "example_id": "e3737121-a76a-4b96-a821-59d7fa03e770",
                                "sense_id": "bd753c6c-1666-30f8-a16f-86357b12b2b1",
                                "text": "Trefz kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
