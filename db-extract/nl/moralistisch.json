                "senses": [
                    {
                        "sense_id": "9ce9ae32-803d-33ff-a1cf-6f162ea7cf15",
                        "entry_id": "ef8f9f18-a921-3e25-bd5a-65e996e62ccc",
                        "glosses": [
                            "betrekking hebbend op de moraal, betrekking hebbend op de ethiek"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a283ee3c-3f33-42ea-96c4-0f003aad9a33",
                                "sense_id": "9ce9ae32-803d-33ff-a1cf-6f162ea7cf15",
                                "text": "Samen met Wonder Woman ging ook het feminisme vanaf de moralistische jaren 50 underground, tot een opflakkering in de jaren 70. De invloedrijke feministe Gloria Steinem plaatste Wonder Woman in 1971 op de cover van het feministische blad"
                            }
                        ]
                    },
                    {
                        "sense_id": "2e1e93be-5849-38e4-bab1-3529aa21aafd",
                        "entry_id": "ef8f9f18-a921-3e25-bd5a-65e996e62ccc",
                        "glosses": [
                            "prekerig, vermanend, moraliserend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "47dc2877-cd5f-4eaf-bdb6-9f1f26cd36bf",
                                "sense_id": "2e1e93be-5849-38e4-bab1-3529aa21aafd",
                                "text": "Anthony Mathijsen is voorzitter van stichting Platform Keelbos, een organisatie die sinds 2003 opkomt voor de bezoekers van de zogenoemde HOP's. Hij ziet dat op steeds meer plekken in Nederland homo's worden verjaagd. ,,Ze willen ervan af omdat ze het moralistische idee hebben dat zoiets als een homo-ontmoetingsplek niet mag en niet kan, maar wij zijn niemand tot last, benadrukt Mathijsen. ,,Het is een vorm van discriminatie. Homo's kunnen niet vrij zijn in de openbare ruimte, omdat dat niet in heteronormatief gedrag past."
                            }
                        ]
                    }
                ],
