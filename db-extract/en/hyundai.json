                                                "example_id": "fdbdb7e6-35ad-463c-8af1-141e5350e102",
                                                "sense_id": "924006ba-78c8-3646-a148-63b62d9056d9",
                                                "text": "„Als das Taxi den geschäftigen Hafte-Tir-Platz erreichte, wo neben handgemalten Bannern zu Ehren der Märtyrer Neonreklamen für Nokia und Hyundai blinkten, stieg der Mann aus und suchte sich einen Laden, der westliche Elektronikprodukte verkaufte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
