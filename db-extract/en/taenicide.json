                        "examples": [
                            {
                                "example_id": "9ae9da26-b7c1-4a7f-a476-d8747bf6bd4b",
                                "sense_id": "83084d28-6c59-32b8-96ac-7625bb38d577",
                                "text": "The practice in Ethiopia of eating raw meat...has given rise...to a high incidence of taenia, or tapeworm. ... The commonest traditional taenicide was the blood-red flower of the kosso tree..."
                            },
                            {
                                "example_id": "7c3e878c-27b8-4bbb-884a-50c540962004",
                                "sense_id": "83084d28-6c59-32b8-96ac-7625bb38d577",
                                "text": "If we are not mistaken, this is one of the popular Russian remedies...It is not necessary to take cathartics, simply eating a whole cocoanut being sufficient."
                            },
                            {
                                "example_id": "0f44adf3-edec-473c-8e81-ae0f2290802d",
                                "sense_id": "83084d28-6c59-32b8-96ac-7625bb38d577",
                                "text": "Results obtained with known taenicides and taenifuges are tabled, analysed and compared with their action against the tapeworms of larger animals including man."
                            }
