                ],
                "senses": [
                    {
                        "sense_id": "18f483bb-1f51-3471-bff6-91e1502272b0",
                        "entry_id": "55f4eb8f-6e6f-3409-8d83-f3b063607a23",
                        "glosses": [
                            "mit Sonnenenergie betriebenes Kraftwerk oder Heizungssystem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fca5ac5-37b9-48c5-bce6-149c06a5c6e3",
                                "sense_id": "18f483bb-1f51-3471-bff6-91e1502272b0",
                                "text": "„In Deutschland ging Ende 1988 bei Kobern-Gondorf an der Mosel die damals größte europäische Solaranlage zur photovoltaischen Stromerzeugung in Betrieb.“"
                            },
                            {
                                "example_id": "8e7c0e0e-5166-4821-b231-66bba762504a",
                                "sense_id": "18f483bb-1f51-3471-bff6-91e1502272b0",
                                "text": "„Mit dem Know-how und der Technologie zweier österreichischer Unternehmen ist in der saudi-arabischen Hauptstadt Riad die größte Solaranlage der Welt in Betrieb gegangen.“"
                            },
                            {
                                "example_id": "25aea69a-b11b-4168-99e1-f9618f0cfa8c",
                                "sense_id": "18f483bb-1f51-3471-bff6-91e1502272b0",
                                "text": "„Solaranlagen waren erst Öko-Schnickschnack, dann Statussymbol.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
