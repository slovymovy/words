                    "sense_id": "7e217a6b-c772-31cd-9438-87d45459098d",
                    "sense_definition": "A clock or device that makes a noise at a specific time to wake someone up.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "device_clock",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I set my <w>alarm</w> for six o'clock in the morning.",
                            "target_lang_translations": {
                                "ru": "Я поставил <w>будильник</w> на шесть часов утра.",
                                "nl": "Ik zet mijn <w>wekker</w> om zes uur 's ochtends.",
                                "pl": "Nastawiłem <w>budzik</w> na szóstą rano.",
                                "de": "Ich habe meinen <w>Wecker</w> auf sechs Uhr morgens gestellt.",
                                "fr": "J'ai réglé mon <w>réveil</w> pour six heures du matin.",
                                "it": "Ho impostato la mia <w>sveglia</w> per le sei del mattino.",
                                "cs": "Nařídil jsem si <w>budík</w> na šestou hodinu ranní.",
                                "tr": "Sabah saat altı için <w>alarmımı</w> kurdum.",
                                "es": "Puse mi <w>despertador</w> para las seis de la mañana."
                            }
                        },
                        {
                            "text": "He slept through his <w>alarm</w> and was late for school.",
                            "target_lang_translations": {
                                "ru": "Он проспал свой <w>будильник</w> и опоздал в школу.",
                                "nl": "Hij sliep door zijn <w>wekker</w> heen en was te laat voor school.",
                                "pl": "Przespał swój <w>budzik</w> i spóźnił się do szkoły.",
                                "de": "Er hat seinen <w>Wecker</w> überhört und kam zu spät zur Schule.",
                                "fr": "Il n'a pas entendu son <w>réveil</w> et est arrivé en retard à l'école.",
                                "it": "Ha dormito nonostante la <w>sveglia</w> ed è arrivato in ritardo a scuola.",
                                "cs": "Zaspal svůj <w>budík</w> a přišel pozdě do školy.",
                                "tr": "<w>Alarmını</w> duymayıp uyuyakaldı ve okula geç kaldı.",
                                "es": "Se quedó dormido a pesar de su <w>alarma</w> y llegó tarde a la escuela."
                            }
                        }
                    ],
                    "synonyms": [
                        "alarm clock"
                    ],
                    "common_phrases": [
                        "set the alarm",
                        "alarm goes off",
                        "wake up to an alarm"
                    ],
                    "target_lang_definitions": {
                        "ru": "Часы или устройство, которое издает звук в определенное время, чтобы разбудить кого-то.",
                        "nl": "Een klok of apparaat dat op een bepaalde tijd een geluid maakt om iemand wakker te maken.",
                        "pl": "Zegar lub urządzenie, które wydaje dźwięk o określonej godzinie, aby kogoś obudzić.",
                        "de": "Eine Uhr oder ein Gerät, das zu einer bestimmten Zeit ein Geräusch macht, um jemanden zu wecken.",
                        "fr": "Une horloge ou un appareil qui émet un son à une heure précise pour réveiller quelqu'un.",
                        "it": "Un orologio o dispositivo che emette un suono a un'ora specifica per svegliare qualcuno.",
                        "cs": "Hodiny nebo zařízení, které v určitý čas vydá zvuk, aby někoho vzbudilo.",
                        "tr": "Birini uyandırmak için belirli bir saatte ses çıkaran saat veya cihaz.",
                        "es": "Un reloj o dispositivo que emite un sonido a una hora determinada para despertar a alguien."
