                    }
                ],
                "senses": [
                    {
                        "sense_id": "97795ae3-cce2-3996-9c25-4e4aeaea0344",
                        "entry_id": "1682af45-93df-337e-941b-9b359e28088e",
                        "glosses": [
                            "aus vielen kleinen, meist bunten Stoffstücken gefertigter Teppich"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a09771b-5b03-469d-9dfa-3d93716dc56c",
                                "sense_id": "97795ae3-cce2-3996-9c25-4e4aeaea0344",
                                "text": "Der alte Flickenteppich im Wohnzimmer kommt bald auf dem Sperrmüll."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1ee71e55-207a-33a1-819c-f6a676c0a02c",
                        "entry_id": "1682af45-93df-337e-941b-9b359e28088e",
                        "glosses": [
                            "etwas stark Fragmentiertes"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "09778d39-ee71-446a-b48f-7d1722f9b92f",
                                "sense_id": "1ee71e55-207a-33a1-819c-f6a676c0a02c",
                                "text": "Seit dem Sturz Gaddafis ist Libyen ein Flickenteppich aus unterschiedlichsten Territorien."
                            },
                            {
                                "example_id": "69cef020-29e2-4324-9419-0ca68ed64055",
                                "sense_id": "1ee71e55-207a-33a1-819c-f6a676c0a02c",
                                "text": "„Die Karte der ersten Jahre des Eisenbahnbaus weist darauf hin, daß von regionalen Zentren ausgehend ein Flickenteppich aneinander anschließender Verbindungen entstand, in dem erst 1846 eine Ost-West-Verbindung von Berlin an den Rhein und 1858 die Nord-Süd-Verbindung entlang des Rheins geknüpft wurde.“"
                            },
                            {
                                "example_id": "44cdd5d9-1a56-4057-93d3-f8b749aec2a2",
                                "sense_id": "1ee71e55-207a-33a1-819c-f6a676c0a02c",
                                "text": "Martin Häusling, agrarpolitischer Sprecher der Grünen im Europaparlament befürchtet einen \"europäischen Flickenteppich\" aus Ländern mit oder ohne Genpflanzen."
                            },
                            {
                                "example_id": "c63ef7af-5576-4cd0-8e69-53ebc3feda45",
                                "sense_id": "1ee71e55-207a-33a1-819c-f6a676c0a02c",
                                "text": "„Auf der Oberfläche der Meere glitzert die Sonne und ein Flickenteppich aus Grün und Braun weist auf einige der Lebensräume an Land hin.“"
                            },
                            {
                                "example_id": "21022e76-5adb-4550-8b4a-385f479f73e4",
                                "sense_id": "1ee71e55-207a-33a1-819c-f6a676c0a02c",
                                "text": "Im Irak sind Übergriffe, Entführungen und Attentate auf religiöse Minderheiten an der Tagesordnung. Der einstmals bunte Flickenteppich religiöser und ethnischer Gruppen im Zweistromland löst sich immer weiter auf."
                            },
                            {
                                "example_id": "70ac79a4-71e3-43ab-8ee7-bb28c96664b6",
                                "sense_id": "1ee71e55-207a-33a1-819c-f6a676c0a02c",
                                "text": "[…] mit der bundesweiten \"Blauen Plakette\" [für Diesel-PKW könnte] ein Flickenteppich vieler unterschiedlicher Regeln [zu Fahrverboten in Städten] verhindert werden."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
