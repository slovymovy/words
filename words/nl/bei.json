    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "547f29ad-4356-3c83-a4dd-3b03feec8703",
                    "sense_definition": "Een kleine, sappige en eetbare vrucht zonder pit of met kleine pitjes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vrucht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het bos zochten de kinderen naar een eetbare <w>bei</w> om te proeven.",
                            "target_lang_translations": {
                                "it": "Nel bosco i bambini cercavano una <w>bacca</w> commestibile da assaggiare."
                            }
                        },
                        {
                            "text": "Zij plukte een rijpe <w>bei</w> van de struik in de achtertuin.",
                            "target_lang_translations": {
                                "it": "Ha colto una <w>bacca</w> matura dal cespuglio nel giardino sul retro."
                            }
                        }
                    ],
                    "synonyms": [
                        "bes",
                        "bezie"
                    ],
                    "common_phrases": [
                        "rijpe bei",
                        "zure bei"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Voornamelijk in bepaalde dialecten gebruikt in plaats van 'bes'."
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Un piccolo frutto succoso e commestibile, senza nocciolo o con piccoli semi."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bacca",
                                "target_lang_sense_clarification": "frutto piccolo e succoso"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b26e4282-a50a-3eab-89e2-b6f84cae54c5",
                    "sense_definition": "Een adellijke titel of gouverneur in het voormalige Ottomaanse Rijk.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "titel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De lokale <w>bei</w> regeerde over de provincie namens de sultan.",
                            "target_lang_translations": {
                                "it": "Il <w>bei</w> locale governava la provincia per conto del sultano."
                            }
                        },
                        {
                            "text": "In historische boeken leest men vaak over de invloed van een Turkse <w>bei</w>.",
                            "target_lang_translations": {
                                "it": "Nei libri di storia si legge spesso dell'influenza di un <w>bei</w> turco."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Turkse bei"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Historische titel"
                        }
                    ],
                    "target_lang_definitions": {
                        "it": "Un titolo nobiliare o governatore nell'ex Impero Ottomano."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "bei",
                                "target_lang_sense_clarification": "titolo ottomano"
                            },
                            {
                                "target_lang_word": "bey",
                                "target_lang_sense_clarification": "titolo ottomano, grafia alternativa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}