                        "entry_id": "6fb01249-f6ed-37d7-9982-ddd7a855e084",
                        "glosses": [
                            "rosyjski i ukraiński ludowy instrument strunowy z trójkątnym pudłem rezonansowym"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74b9536-3a7e-40f5-9b61-ffa7ddece763",
                                "sense_id": "d86a260e-9401-3f50-8d89-427bd0744b24",
                                "text": "Graj bałałajko, będzie dobrze!"
                            }
                        ],
