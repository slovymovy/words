                ],
                "senses": [
                    {
                        "sense_id": "d8b8e954-adc1-3385-842c-2b2ab9474a2a",
                        "entry_id": "cf80d348-b5cd-3e66-aeba-3b4a836e128d",
                        "glosses": [
                            "мед. связанный, соотносящийся по значению с существительным кариоз; поражённый кариозом, кариесом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e924fca2-831b-47d1-ac88-0873edb0832e",
                                "sense_id": "d8b8e954-adc1-3385-842c-2b2ab9474a2a",
                                "text": "Применение парапульпарных штифтов показано при реставрации фронтальных зубов с обширными кариозными полостями или фрактурами коронок в области режущего края."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e67b3c97-f046-4b79-91a1-0aa507bb679d",
                        "source_entry_id": "cf80d348-b5cd-3e66-aeba-3b4a836e128d",
                        "source_sense_id": "d8b8e954-adc1-3385-842c-2b2ab9474a2a",
                        "target_lang_word": "kariös",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kariös",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "41317057-9423-331d-984c-98e84c7efcaa",
                                        "entry_id": "b6243b36-9f61-3707-b0a3-c523a6262d5a",
                                        "glosses": [
                                            "von Karies befallen, angefault"
                                        ],
                                        "tags": [
                                            "Zahnmedizin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d613db3d-68b2-4b66-9d38-b7d85e96908a",
                                                "sense_id": "41317057-9423-331d-984c-98e84c7efcaa",
                                                "text": "„Die 6 unten rechts ist kariös und den Zahnstein sollten wir auch mal wieder entfernen.“"
                                            },
                                            {
                                                "example_id": "606f1915-53b2-40ae-98f7-4800a0853e5f",
                                                "sense_id": "41317057-9423-331d-984c-98e84c7efcaa",
                                                "text": "Sagt der Arzt also zum Beispiel „Zwei vier ist kariös“, meint er damit, dass er am ersten Backenzahn im Oberkiefer links Karies festgestellt hat."
                                            },
                                            {
                                                "example_id": "445bc400-dfc7-46ae-adc2-96578a48985a",
                                                "sense_id": "41317057-9423-331d-984c-98e84c7efcaa",
                                                "text": "Weisheitszähne scheinen nur Ärger zu bringen, werden aufgrund ihrer Lage leichter kariös und sorgen für Platznot im Kiefer - überflüssig sind sie trotzdem nicht."
                                            },
                                            {
                                                "example_id": "e17f8caa-00bc-4e43-a08b-99812f91a4c4",
                                                "sense_id": "41317057-9423-331d-984c-98e84c7efcaa",
                                                "text": "Mit vierzehn war bei mir jeder dritte Backenzahn plombiert, mit siebzehn der erste gezogen. Dennoch war ich kein besonders schwerer Fall: Noch Ende der achtziger Jahre waren bei Gleichaltrigen im Schnitt 6,2 Zähne entweder kariös, gefüllt oder bereits extrahiert. Das hat sich deutlich verbessert: Heute besitzen Zwölfjährige statistisch gesehen weniger als einen geschädigten Zahn."
                                            },
                                            {
                                                "example_id": "c8aa705b-d249-4da8-955f-4ee34c4f5750",
                                                "sense_id": "41317057-9423-331d-984c-98e84c7efcaa",
                                                "text": "Ziemlich sicher falsch sind die Behauptungen, das Kind nehme keinen Schnuller mehr oder trinke ausschließlich Wasser aus seinem Fläschchen, wenn ein Blick in den Mund genügt: Sind die Milchzähne bräunlich und kariös, trinkt es also viel Saft und Limonade; und ein Schnuller verändert Zahnstellung und Kieferform."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
