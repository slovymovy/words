                        "sense_id": "cca71ea1-7764-32b2-a782-163f9c4cc9ff",
                        "entry_id": "0f38ce37-2c17-37c6-8c88-62940dd5fa3d",
                        "glosses": [
                            "Ordnung von Objekten nach steigender oder fallender Häufigkeit in einer Reihe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "829eb9bf-8e0f-4308-9dd2-aa78dffcdbe6",
                                "sense_id": "cca71ea1-7764-32b2-a782-163f9c4cc9ff",
                                "text": "„Gegenüber dem Vorjahr haben sich nur wenige Veränderungen in der Häufigkeitsrangfolge der Jungennamen ergeben.“"
                            },
                            {
                                "example_id": "ae033244-bff4-44bc-878d-5719a2583068",
                                "sense_id": "cca71ea1-7764-32b2-a782-163f9c4cc9ff",
                                "text": "„Heute nimmt Zimmermann die 20. Position in der Häufigkeitsrangfolge der Familiennamen in Deutschland ein.“"
                            },
                            {
                                "example_id": "35b43a61-a6ab-4d2e-ad93-7d85235c6930",
                                "sense_id": "cca71ea1-7764-32b2-a782-163f9c4cc9ff",
                                "text": "„Die relativen Häufigkeiten der Schriftzeichen schwanken, ebenso ihre Abfolge in der Häufigkeitsrangfolge.“"
                            },
                            {
                                "example_id": "e598e655-9bf1-47f7-ab4e-b7dd21ade768",
                                "sense_id": "cca71ea1-7764-32b2-a782-163f9c4cc9ff",
                                "text": "„Um das Heilige Jahr 2000 nimmt Schneider die dritte Stelle in der Häufigkeitsrangfolge der deutschen Familiennamen ein.“"
                            },
                            {
                                "example_id": "466bdc45-5225-45a6-93e3-e4476743444f",
                                "sense_id": "cca71ea1-7764-32b2-a782-163f9c4cc9ff",
                                "text": "„Ein weiteres Indiz dafür ist die hohe Korrelation zwischen den Häufigkeitsrangfolgen der Männer und der Frauen der Bundesländer.“"
                            }
                        ],
