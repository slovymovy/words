                                        "entry_id": "43c31df2-df42-32d0-ab25-05dc7927f56e",
                                        "glosses": [
                                            "The rule of an alien; rule from without; government by an extraterritorial power."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d3eb215-5973-4141-811e-38fc71590664",
                                                "sense_id": "24cfeb2f-10bc-34a9-8779-e1f1025e2d87",
                                                "text": "Despite installing puppet governments in the marches, the subjects of the empire’s conquered territories were still very conscious of living under heterarchy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5f94393-b61a-3dc5-aad8-4bb09c0fbc6c",
                                        "entry_id": "43c31df2-df42-32d0-ab25-05dc7927f56e",
                                        "glosses": [
                                            "An example of this government."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8064b2d-8329-406e-aba2-0df030eade8c",
                                                "sense_id": "e5f94393-b61a-3dc5-aad8-4bb09c0fbc6c",
                                                "text": "The proposed liberation of our largely undeveloped economy goes too far — the resulting foreign dominance of our markets would make us a heterarchy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f62098ae-48f2-35e9-be37-71c8a61647cc",
                                        "entry_id": "43c31df2-df42-32d0-ab25-05dc7927f56e",
                                        "glosses": [
                                            "A system of organization where the elements of the organization are unranked (non-hierarchical) or where they possess the potential to be ranked a number of different ways."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a0e61e7-825e-4f26-a354-55f7b0937806",
                                                "sense_id": "f62098ae-48f2-35e9-be37-71c8a61647cc",
                                                "text": "When a group operates as a heterarchy, everyone is a leader in their own domain."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
