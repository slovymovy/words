                "senses": [
                    {
                        "sense_id": "622e0d47-4bd9-39e5-9a88-0894f39b989c",
                        "entry_id": "b55fd2a4-e0d2-3e9f-9c89-99322e407dfa",
                        "glosses": [
                            "Soldat mit Fronterfahrung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b0efe103-db62-4834-8229-f3d4e80acce7",
                                "sense_id": "622e0d47-4bd9-39e5-9a88-0894f39b989c",
                                "text": "„Kat läßt sich nicht von seiner Meinung abbringen, die er als altes Frontschwein wieder in Reimen von sich gibt:…“"
                            },
                            {
                                "example_id": "a0cd70a8-2e1f-4ff9-a932-d08d82f7d51b",
                                "sense_id": "622e0d47-4bd9-39e5-9a88-0894f39b989c",
                                "text": "„Frontschweine haben da nichts zu suchen, sagen die Soldaten.“"
                            },
                            {
                                "example_id": "8bf4d0ca-048f-4f75-a801-c966048a28e4",
                                "sense_id": "622e0d47-4bd9-39e5-9a88-0894f39b989c",
                                "text": "„Lokalredakteure sind die Frontschweine des Journalismus, und man kommt von keinem Krieg unbefleckt zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
