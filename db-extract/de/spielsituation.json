                ],
                "senses": [
                    {
                        "sense_id": "46796f8a-ff27-32d4-af03-f74ae3a7d5fe",
                        "entry_id": "7ee43d46-1c17-32a3-9cf0-4f9e7e1c5278",
                        "glosses": [
                            "momentane Umstände während eines Spiels, Konstellation in einem Spielverlauf"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08c86f3a-58a0-4524-bb22-9c48ab8da664",
                                "sense_id": "46796f8a-ff27-32d4-af03-f74ae3a7d5fe",
                                "text": "„In vielen Spielsituationen zeigen die Spieler der unterschiedlichsten Gruppentypen häufig ein sehr konkurrenzorientiertes Verhalten.“"
                            },
                            {
                                "example_id": "0b794ba0-51dc-4eca-94be-2cfa0956b0c7",
                                "sense_id": "46796f8a-ff27-32d4-af03-f74ae3a7d5fe",
                                "text": "„Die Beißhemmung des spielenden Hundes, die eingezogenen Krallen beim Prankenschlag des jungen Löwen oder das Zurückblicken und Warten auf den abgehängten Verfolger, damit die Jagd weitergehen kann, unterscheiden deutlich die Spielsituation vom entsprechenden Ernstverhalten.“"
                            },
                            {
                                "example_id": "fcddad90-c6e6-46c8-8f62-18c8ca4a08d4",
                                "sense_id": "46796f8a-ff27-32d4-af03-f74ae3a7d5fe",
                                "text": "„Selbst wenn eine Spielbegegnung (wie bei einander fremden Erwachsenen häufig) mit Befangenheit und Zurückhaltung beginnt, bauen sich in der entspannten Unverbindlichkeit der Spielsituation Kontaktängste bald ab.“"
                            },
                            {
                                "example_id": "5f205ccb-fc54-47f4-8fd0-96996dd38998",
                                "sense_id": "46796f8a-ff27-32d4-af03-f74ae3a7d5fe",
                                "text": "„Aber ein Spieler kann ein begnadeter Techniker sein oder unglaublich schnell im Antritt – wenn er nicht kapiert, wie’s läuft, wie er in einzelnen Spielsituationen Lösungen findet, ist er raus und kann sich das alles von der Bank aus anschauen.“"
                            },
                            {
                                "example_id": "53c4d79d-5ef8-4de5-af28-c5403baf1fa9",
                                "sense_id": "46796f8a-ff27-32d4-af03-f74ae3a7d5fe",
                                "text": "„Die internationale Regelkommission IFAB testet den Videobeweis zur Klärung strittiger Spielsituationen seit Juli unter anderem in der dritten US-amerikanischen Liga.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
