                                        "sense_id": "c6571727-02d1-327d-80f2-047308f49f99",
                                        "entry_id": "9813773c-4a58-3e8f-a4b5-455ee4b072e0",
                                        "glosses": [
                                            "Immense espace de l’Atlantique entre les Açores et les îles du Cap-Vert, où se trouve une agglomération de sargasses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa1b4e98-3301-426d-a52a-6b6ad2c8472a",
                                                "sense_id": "c6571727-02d1-327d-80f2-047308f49f99",
                                                "text": "Les sargasses sont très nombreuses, ce qui ne m’étonne pas, car l’hiver la mer des Sargasses se déplace vers l’Ouest."
                                            },
                                            {
                                                "example_id": "17f901d9-07d6-4f8a-8cb7-c44068deaae5",
                                                "sense_id": "c6571727-02d1-327d-80f2-047308f49f99",
                                                "text": "La mer des Sargasses est formée d’Algues brunes, appelées Sargasses, arrachées aux côtes du Golfe du Mexique et qui sont portées par les courants jusqu’au milieu de l’Atlantique. Là, elles peuvent vivre et même se reproduire à l’état flottant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
