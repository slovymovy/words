    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "4c05361d-cf79-3d4f-bd39-ae3b8baae7f6",
                "word": "versatility",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7df02a6b-3fe3-4211-9434-987aef8553b9",
                        "entry_id": "4c05361d-cf79-3d4f-bd39-ae3b8baae7f6",
                        "tags": [
                            "plural"
                        ],
                        "form": "versatilities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                        "entry_id": "4c05361d-cf79-3d4f-bd39-ae3b8baae7f6",
                        "glosses": [
                            "The property of being versatile or having many different abilities."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "6b601a28-5efa-4745-bed5-ff711a90764a",
                                "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                                "text": "Those are the sort of women who polish a young man the most, and who give him that habit of complaisance, and that flexibility and versatility of manners which prove of great use to him with men, and in the course of business."
                            },
                            {
                                "example_id": "9d7bff12-d9ae-46fc-960a-760c216872b2",
                                "sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                                "text": "We broke up our tests into three categories — performance, durability and versatility — so we could compare the different features of each jacket against the others directly."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "39a5e959-8604-4858-819f-c0dc38795d33",
                        "source_entry_id": "4c05361d-cf79-3d4f-bd39-ae3b8baae7f6",
                        "source_sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                        "source_sense_description": "the property of being versatile or having many different abilities",
                        "target_lang_word": "veelzijdigheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "veelzijdigheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "855196e4-76cf-3d0c-95a4-6b13433817c2",
                                        "entry_id": "8000eb5c-568e-35ea-98cf-098c1c05eb99",
                                        "glosses": [
                                            "het veel mogelijkheden of kwaliteiten hebben; het geschikt zijn voor veel taken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94d0ce11-e5d7-46ca-8aee-38a03403118a",
                                                "sense_id": "855196e4-76cf-3d0c-95a4-6b13433817c2",
                                                "text": "Bekijk onze winkel online en laat je verrassen door de veelzijdigheid! Of bezoek de winkel in Tilligte met ruim 3.200 m2 mode voor het hele gezin!"
                                            },
                                            {
                                                "example_id": "d713783b-f3d3-4966-bc39-88bb31958914",
                                                "sense_id": "855196e4-76cf-3d0c-95a4-6b13433817c2",
                                                "text": "Hij doet het wel goed voor zijn prijsklasse, maar op het gebied van veelzijdigheid moet hij Huaweis eigen Mate 20 voor zich dulden, omdat die camera’s met drie verschillende beeldhoeken heeft."
                                            },
                                            {
                                                "example_id": "1cb998e8-d4f9-4c43-bf1d-256d52d0192c",
                                                "sense_id": "855196e4-76cf-3d0c-95a4-6b13433817c2",
                                                "text": "Behalve meer ruimte en de toegenomen bodemvrijheid, biedt elke T-Cross ook een verschuifbare achterbank. Dat creëert extra veelzijdigheid. Staat de bank in de achterste stand, dan blijft er 385 liter bagageruimte over. Met de bank zo ver mogelijk naar voren neemt de inhoud toe tot 455 liter. Maar plek voor een volwassene is er dan nog nauwelijks op de tweede zitrij."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d45aad65-d20a-4b2b-be56-d808aaf45ac9",
                        "source_entry_id": "4c05361d-cf79-3d4f-bd39-ae3b8baae7f6",
                        "source_sense_id": "2edcdb8e-0a1c-36bd-b576-f4e1a1d28527",
                        "source_sense_description": "the property of being versatile or having many different abilities",
                        "target_lang_word": "polyvalence",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polyvalence",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "95c7fe14-9f52-3e3c-9da7-fbbd51423aff",
                                        "entry_id": "29344da4-fcad-3f00-ab6d-1efe5c7d7a9e",
                                        "glosses": [
                                            "Caractère de ce qui est polyvalent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5913720-a597-4a4a-8d60-61f3047afffd",
                                                "sense_id": "95c7fe14-9f52-3e3c-9da7-fbbd51423aff",
                                                "text": "Le CNRS, par le fait qu'il embrasse à la fois toutes les formes de l'activité scientifique et qu'il se préoccupe également des deux aspects, fondamental et appliqué, de la recherche, reste l'organisme de création scientifique présentant au maximum, en France, le caractère de polyvalence"
                                            },
                                            {
                                                "example_id": "6a163de7-e281-4be0-85ad-22654ec8ec94",
                                                "sense_id": "95c7fe14-9f52-3e3c-9da7-fbbd51423aff",
                                                "text": "Galtier devrait donner du temps de jeu à la dernière recrue, Nordi Mukiele (ex-Leipzig), qui pourrait rentrer comme piston droit ou défenseur central puisqu’il a été choisi pour sa polyvalence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
