                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7572b143-e253-42f3-8211-cf2b4ff37529",
                                "sense_id": "a2f9bba4-7cf4-3134-b539-ee1b81d61751",
                                "text": "„Zur Bestimmung der Lüftungsöffnung muss zwischen Apparaten mit Belastung im Dauerbetrieb und jenen mit Intervallbetrieb unterschieden werden.“"
                            },
                            {
                                "example_id": "5cc2868d-c363-46c6-8417-3a9f6dd25150",
                                "sense_id": "a2f9bba4-7cf4-3134-b539-ee1b81d61751",
                                "text": "„Zum Rauminhalt des Aufstellraumes nach Satz 1 Nr. 1 darf bei Wohnungen und anderen Nutzungseinheiten entsprechender Größe der Rauminhalt der mit dem Aufstellraum unmittelbar oder mittelbar verbundenen Räume gerechnet werden, wenn der Aufstellraum mit mindestens einem angrenzenden Raum durch eine ausreichend große Lüftungsöffnung von mindestens 150 cm2 verbunden ist.“"
                            }
                        ],
