                "senses": [
                    {
                        "sense_id": "297fd2b2-7342-3d29-9a2a-ddd0b6f3be0e",
                        "entry_id": "110cfd89-f131-3f2c-8782-4ea23bcd1932",
                        "glosses": [
                            "Gottesdienst mit Eucharistiefeier am Sonntag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de420c03-9f3b-489f-af03-f7b8158e51ff",
                                "sense_id": "297fd2b2-7342-3d29-9a2a-ddd0b6f3be0e",
                                "text": "„Es hatte sich so eingespielt, dass sie nach der Sonntagsmesse die Abrechnung mitbrachte.“"
                            },
                            {
                                "example_id": "e814d296-b401-46dd-92ce-307dcc148d50",
                                "sense_id": "297fd2b2-7342-3d29-9a2a-ddd0b6f3be0e",
                                "text": "„Sie liegt still und sonntäglich da, Vögel zwitschern in den Bäumen, und ich gehe hin, um in der kleinen Kirche der Anstalt für die Sonntagsmesse die Orgel zu spielen.“"
                            },
                            {
                                "example_id": "f950ce76-ba57-4f5f-8ee0-d41b9c47d436",
                                "sense_id": "297fd2b2-7342-3d29-9a2a-ddd0b6f3be0e",
                                "text": "„Zur üblichen Alltagsbetriebsamkeit an den Seitenaltären großer Kirchen kamen die feierlichen Sonntagsmessen und die feierlichen Hochämter an den Prunktagen des Kirchenjahrs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
