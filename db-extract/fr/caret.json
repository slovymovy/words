                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "4d74e255-98c7-49fd-bedf-95ee91b9f2a0",
                                "sense_id": "469f6554-0a2d-32e7-8316-9d8ffb05d899",
                                "text": "Les carets paroissent former le passage des graminées avec la famille des scirpes, des souchets et des joncs, à laquelle ils tiennent par plusiers rapports.",
                                "translation": "The sedges appear to form the evolution of the grasses with the rushes, the chufas and the bulrushes, to which they are linked by several similarities.",
                                "english": "The sedges appear to form the evolution of the grasses with the rushes, the chufas and the bulrushes, to which they are linked by several similarities."
                            },
                            {
                                "example_id": "2cfc2f09-f859-4c69-9391-7f204d733b69",
                                "sense_id": "469f6554-0a2d-32e7-8316-9d8ffb05d899",
                                "text": "Plusiers espèces de Carets portent les noms vulgaires de ciseau, des feuilles à bords coupants, et de rouche, rouchette, et forment un fourrage grossier.",
                                "translation": "Several species of sedges bear the common names of ciseau, their leaves having sharp edges, and rouche, rouchette, and they form a coarse forage.",
                                "english": "Several species of sedges bear the common names of ciseau, their leaves having sharp edges, and rouche, rouchette, and they form a coarse forage."
                            },
                            {
                                "example_id": "02c5e27c-5896-4522-bda3-fb92264b8ef7",
                                "sense_id": "469f6554-0a2d-32e7-8316-9d8ffb05d899",
                                "text": "Les carets vivent dans les eaux très médiocres.",
                                "translation": "Sedges live in very poor waters.",
                                "english": "Sedges live in very poor waters."
                            }
                        ]
                    }
