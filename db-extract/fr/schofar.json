                                            {
                                                "example_id": "13e3394c-cc56-4e42-8fb0-7f0b9978cca9",
                                                "sense_id": "238ecdb8-f0d4-3a97-bc56-45c91d2f4db2",
                                                "text": "Reb Binjomin zatroubil na šofar a místností se rozlila vlna tajemného pronikavého zvuku."
                                            },
                                            {
                                                "example_id": "160346a0-7583-4bfc-8d6c-da409ea7c2b6",
                                                "sense_id": "238ecdb8-f0d4-3a97-bc56-45c91d2f4db2",
                                                "text": "Po vynesení rozsudku přistoupil k soudci obžalovaný, žalobce i znalec. A všichni řekli jednohlasně: „Abyste věděl, pane rado, šofar není žádná trumpeta. Šofar je šofar.“"
                                            }
