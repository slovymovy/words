                    },
                    {
                        "translation_id": "33f12138-ef1a-4087-9f38-a162600c0bb6",
                        "source_entry_id": "272943d9-83d4-31ab-b19b-a69d8028e240",
                        "source_sense_description": "скакать на лошади галопом",
                        "target_lang_word": "galoper",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "galoper",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "349abfd8-bb6e-3bdc-ad94-9efc2133552a",
                                        "entry_id": "81b18292-cc38-305d-ba4f-8f11346f0e35",
                                        "glosses": [
                                            "Aller le galop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ceb64b4-8007-4030-a893-b25d5d44e78f",
                                                "sense_id": "349abfd8-bb6e-3bdc-ad94-9efc2133552a",
                                                "text": "Un cheval qui galope bien, qui galope sur le bon pied."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2224dac0-cc7d-3dea-ac44-f06a3cd244c1",
                                        "entry_id": "81b18292-cc38-305d-ba4f-8f11346f0e35",
                                        "glosses": [
                                            "Être sur une monture, dans un attelage qui va le galop."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13750b47-bd18-4b40-adfc-fcbb2f7c198c",
                                                "sense_id": "2224dac0-cc7d-3dea-ac44-f06a3cd244c1",
                                                "text": "Nous admirions des choses nouvelles […] Des cavaliers à burnous flottant galopaient sur des chevaux merveilleux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7ccb5d8b-aecf-36ca-89b1-9fdd06022f0e",
                                        "entry_id": "81b18292-cc38-305d-ba4f-8f11346f0e35",
                                        "glosses": [
                                            "Avoir un rythme intense et rapide."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01664166-e4bb-47dd-be8b-930acee93cb2",
                                                "sense_id": "7ccb5d8b-aecf-36ca-89b1-9fdd06022f0e",
                                                "text": "Je mettrai des rêves doux dans ton cœur qui se tait, ton cœur qui galopait tantôt, aussi fougueux qu’un coursier de bataille, fonçant dans la charge, aveugle de sang, et qui va maintenant plus lent que l’horloge, marquant ses pas menus sur la route du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24b7fe10-c329-3bc3-a310-c4d09454892e",
                                        "entry_id": "81b18292-cc38-305d-ba4f-8f11346f0e35",
                                        "glosses": [
                                            "Faire beaucoup de démarches, courir beaucoup pour quelque affaire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e673eaf9-9f1d-4a83-87a4-9eb0ec7aef3a",
                                                "sense_id": "24b7fe10-c329-3bc3-a310-c4d09454892e",
                                                "text": "Il a galopé par tout Paris pour cette affaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60a4fbf8-db7f-3717-bcd0-1d21a5cf5dba",
                                        "entry_id": "81b18292-cc38-305d-ba4f-8f11346f0e35",
                                        "glosses": [
                                            "Marcher, parler ou lire avec précipitation."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "249d95bb-e4e1-45e0-8a4c-d69d6fbe722a",
                                                "sense_id": "60a4fbf8-db7f-3717-bcd0-1d21a5cf5dba",
                                                "text": "Pourquoi galoper ainsi ? Lisez plus posément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99117b68-16c4-330e-98b5-1f6942fc6489",
                                        "entry_id": "81b18292-cc38-305d-ba4f-8f11346f0e35",
                                        "glosses": [
                                            "Faire courir au galop, en parlant du cheval."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f00fdc2a-af6b-4103-ba52-e87e2cb96763",
                                                "sense_id": "99117b68-16c4-330e-98b5-1f6942fc6489",
                                                "text": "On le citait partout et en toutes occasions, soit qu’il galopât son cob irlandais, le matin au Bois ; soit qu’il menât son attelage russe, l’après-midi […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bff41d5b-efff-3d6d-8707-b31290a6fa2d",
                                        "entry_id": "81b18292-cc38-305d-ba4f-8f11346f0e35",
                                        "glosses": [
                                            "Poursuivre agressivement ; Tourmenter violemment."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b83a8a2-149b-4d8f-a63f-d6397044b56b",
                                                "sense_id": "bff41d5b-efff-3d6d-8707-b31290a6fa2d",
                                                "text": "Les deux mâtins le galopèrent, tandis que Friquette, attachée à son camarade, lui faisait sentir sa dent aiguë."
                                            },
                                            {
                                                "example_id": "28889353-d4dc-400b-b560-eeb15e47532c",
                                                "sense_id": "bff41d5b-efff-3d6d-8707-b31290a6fa2d",
                                                "text": "C'était bel et bien mon père qui me galopait dans le dos, et je n'en allais que plus vite de l'entendre crier de sa voix de stentor : “Arrête-toi !… Je te dis de t'arrêter !… Arrête … Arrête !…”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
