                        "entry_id": "b81c37f3-e1d6-31c2-b26f-1c0b6e6886a0",
                        "glosses": [
                            "großer, ringförmiger Ohrschmuck, in den ein kleiner Schmuckstein eingehängt werden kann"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "cb1f315a-fb2f-4f87-8dea-98350e82e3de",
                                "sense_id": "f71259cc-2e55-32a4-9a0f-9ef71868c34a",
                                "text": "Sie trug 20 mm großen Kreolen aus Silber."
                            },
                            {
                                "example_id": "60290982-ffea-49fb-8e2a-a04ff89e0165",
                                "sense_id": "f71259cc-2e55-32a4-9a0f-9ef71868c34a",
                                "text": "„Bevor wir ihren Anweisungen folgen konnten, kam eine junge Frau in bunter Kleidung in den Flur, ihre Haare ein stolzer Afro, in ihren Ohrläppchen klimperten Kreolen.“"
                            }
