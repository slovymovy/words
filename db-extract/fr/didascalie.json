                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4375f38c-30e4-47c7-9ff6-500e69cd8a3c",
                        "source_entry_id": "82fe2947-a09e-3c0d-a7d6-fcf683701008",
                        "source_sense_description": "Indication écrite par l’auteur",
                        "target_lang_word": "regieaanwijzing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "regieaanwijzing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "8505f678-7e1f-3981-9c2f-a4014bdf7835",
                                        "entry_id": "3a0c6bc5-e74c-399a-8faa-8527c4be65c2",
                                        "glosses": [
                                            "tekst in een toneelstuk of filmscenario die niet wordt uitgesproken door de spelers, maar beschrijft wat het publiek te zien krijgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8cc4b9ed-654d-4848-a037-6f8c8135abdc",
                                                "sense_id": "8505f678-7e1f-3981-9c2f-a4014bdf7835",
                                                "text": "In de regieaanwijzing bij sommige stukjes staat dat er een grote neus moet worden opgeplakt en dat er druk moet worden gegesticuleerd."
                                            },
                                            {
                                                "example_id": "51b4fd51-55d8-4f51-9980-9d4b2c5ad1b6",
                                                "sense_id": "8505f678-7e1f-3981-9c2f-a4014bdf7835",
                                                "text": "Exit als bijwoord is van oorsprong een theaterterm, ontleend aan het Latijn. Het is een regieaanwijzing voor een acteur of actrice dat hij of zij ‘af’ moet gaan, van het toneel moet verdwijnen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba0401b8-d1bd-3a60-95a8-2910233e9105",
                                        "entry_id": "3a0c6bc5-e74c-399a-8faa-8527c4be65c2",
                                        "glosses": [
                                            "instructies die een regisseur aan spelers geeft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6275d517-656d-4b87-ab8c-6a4f7054439b",
                                                "sense_id": "ba0401b8-d1bd-3a60-95a8-2910233e9105",
                                                "text": "Hij vroeg haar als een dief in de nacht door het appartement te sluipen van de vrouw van wie ze al haar hele leven houdt. Dat vertelt actrice Barbara Sukowa aan de telefoon uit New York over de regieaanwijzingen die ze kreeg van debuterend regisseur Filippo Meneghetti."
                                            },
                                            {
                                                "example_id": "ee790598-43ed-4578-9109-24c121efaf40",
                                                "sense_id": "ba0401b8-d1bd-3a60-95a8-2910233e9105",
                                                "text": "Regisseur Rijxman geeft als regieaanwijzing: „Laat zien dat je scherpe keuzes maakt. Al zijn het grote begrippen, maak het persoonlijk.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb70ed7e-7de7-3679-bfef-a7e19d7be234",
                                        "entry_id": "3a0c6bc5-e74c-399a-8faa-8527c4be65c2",
                                        "glosses": [
                                            "instructie die tijdens een proces wordt gegeven om het goed te laten verlopen"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80bddf77-36c9-45e1-b77f-539d751dd24f",
                                                "sense_id": "cb70ed7e-7de7-3679-bfef-a7e19d7be234",
                                                "text": "Wil het Sinterklaasfeest overleven, dan moet daarbij de tegenovergestelde strategie worden gevolgd. Weg met de dwingende regieaanwijzingen, de polarisatie, de clichés, weg ook van de politieke discussie. Het gaat hier niet om een blank feest maar een blanco feest – in te vullen door alle Nederlanders."
                                            },
                                            {
                                                "example_id": "a7da34c0-0b86-4058-83e8-d0e5c26e61af",
                                                "sense_id": "cb70ed7e-7de7-3679-bfef-a7e19d7be234",
                                                "text": "Eén regieaanwijzing van mij: doe als je overgrootmoeder Wilhelmina: veins, Alexander, veins oprecht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
