                        "glosses": [
                            "Membre d’un courant religieux du judaïsme médiéval, adepte de la doctrine développée par Maïmonide."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f601e422-328f-4d0a-84e9-0704aae9cc9b",
                                "sense_id": "730e8cb0-5399-3452-bd12-570db12c2ae0",
                                "text": "Quelques divergences qu’on relève chez Gersonide, il reste qu’il est un maïmoniste fervent autant qu’un admirateur d’Aristote."
                            },
                            {
                                "example_id": "e438c9a5-826b-4d94-a512-8ca6964c3994",
                                "sense_id": "730e8cb0-5399-3452-bd12-570db12c2ae0",
                                "text": "Ainsi donc, à côté des admirateurs passionnés de Maïmonide, […], se forma un parti qui attaqua ses œuvres avec vivacité, […]. Dès cet instant, les rabbins et les chefs des communautés juives d’Europe et d’Asie se divisèrent en maïmonistes et antimaïmonistes."
                            }
                        ]
                    }
