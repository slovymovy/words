                                        "entry_id": "2abe74ba-b2c4-3b1a-b2b1-819baffe34d0",
                                        "glosses": [
                                            "także przenośnie ten, przeciwko któremu się walczy lub rozgrywa grę"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d940e0a-87a1-4985-886a-0082950345eb",
                                                "sense_id": "200a6ab0-328f-33e8-a066-2b7640a6a89d",
                                                "text": "W tym meczu przeciwnicy strzelili nam pięć goli."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "7fc8fc24-e18e-3d6f-8d38-871ce7d01b98",
