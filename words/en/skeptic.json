                    "frequency": "Middle",
                    "semantic_group_id": "doubter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many <w>skeptics</w> questioned the validity of the new scientific study."
                        },
                        {
                            "text": "The <w>skeptics</w> were eventually convinced by the overwhelming evidence presented."
                        }
                    ],
                    "synonyms": [
                        "doubter",
                        "cynic",
                        "disbeliever"
                    ],
                    "antonyms": [
                        "believer"
                    ],
                    "common_phrases": [
