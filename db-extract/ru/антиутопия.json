                                        "sense_id": "be6e5fae-77ea-3a94-9fde-b4891d8c47cd",
                                        "entry_id": "d7e9c8ad-052a-37ff-82c9-44190430207b",
                                        "glosses": [
                                            "Geschichte, die in einer fiktiven Gesellschaft spielt, die sich zum Negativen entwickelt hat, (literarische) Endzeit"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c4adc91-9712-42ae-9492-19637bc0a786",
                                                "sense_id": "be6e5fae-77ea-3a94-9fde-b4891d8c47cd",
                                                "text": "„In dieser Dystopie verwenden die Behörden interessanterweise anfangs nicht die von Google erfassten, intimen Suchanfragen eines potenziell Verdächtigen, sondern arbeiten mit Kombinationsdaten.“"
                                            },
                                            {
                                                "example_id": "3302498f-91d2-490e-a5dc-471bf3e6aad8",
                                                "sense_id": "be6e5fae-77ea-3a94-9fde-b4891d8c47cd",
                                                "text": "„Trumps Twitter hat das ! zum Knecht des Zwiespalts, des Stress und einer postfaktischen Dystopie gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9391f5bd-16cf-4b85-815b-42a0b4048174",
                        "source_entry_id": "7a11ede7-1cef-31eb-b49a-0aaf3a0ab16f",
                        "target_lang_word": "Anti-Utopie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Anti-Utopie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8acff845-36d1-3a4d-821e-595d1973266f",
                                        "entry_id": "e21994f0-6901-3f7d-a1a9-236473175c6e",
                                        "glosses": [
                                            "Geschichte, die in einer fiktiven Gesellschaft spielt, die sich zum Negativen entwickelt hat, (literarische) Endzeit"
                                        ],
                                        "tags": [
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd3f57b9-051e-477a-bfcf-6688aeb66151",
                                                "sense_id": "8acff845-36d1-3a4d-821e-595d1973266f",
                                                "text": "„Das Szenario erinnert an Orwells Anti-Utopie ‚1984‘.“"
                                            },
                                            {
                                                "example_id": "7f3dd2cb-1818-4c82-ae92-c0e16da0e802",
                                                "sense_id": "8acff845-36d1-3a4d-821e-595d1973266f",
                                                "text": "„Darum geht es in der Anti-Utopie, die 1992 erschienen ist, in Deutschland erst Skandal war, dann Bestseller und weltweit fünf Millionen Mal verkauft wurde.“"
                                            },
                                            {
                                                "example_id": "bb0ff1dc-e29d-4bb9-b8b5-8f21e7076800",
                                                "sense_id": "8acff845-36d1-3a4d-821e-595d1973266f",
                                                "text": "„10 000 lebende Giesinger auf dem 30 Hektar großen, wunderbar grünen Ostfriedhof unterzubringen, ist so eine Anti-Utopie.“"
                                            },
                                            {
                                                "example_id": "47c01c3f-da01-4fec-a9b5-afddee7ec13e",
                                                "sense_id": "8acff845-36d1-3a4d-821e-595d1973266f",
                                                "text": "„Von diesen Gags, von eben jenen Einfällen, die Déry im zitierten Brief erwähnt hat, gibt es nicht wenige in seinem Roman, der in mehr als einer Hinsicht als eine Anti-Utopie, als Anti-Science-fiction aufgefaßt werden könnte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
