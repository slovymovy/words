                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6981046-8ead-448f-9b59-64f8d3078a34",
                                "sense_id": "501a11fb-ca6c-3c4c-8ca1-61c0d29fc3d0",
                                "text": "In totaal botsten zeventien voertuigen op elkaar. Bij de afslag Veghel-Noord was een kop-staartbotsing. Daarbij raakte een automobilist gewond."
                            },
                            {
                                "example_id": "d2c0421b-f9b2-4819-8d5b-bce93cb7d859",
                                "sense_id": "501a11fb-ca6c-3c4c-8ca1-61c0d29fc3d0",
                                "text": "Het eerste slachtoffer viel bij een kop-staartbotsing van twee vrachtwagens bij Ochten. De man zat in de achterste vrachtwagen. Het ongeluk gebeurde in de file die was ontstaan na een eerder ongeluk met vijf auto's, waarbij geen gewonden vielen."
                            }
                        ]
