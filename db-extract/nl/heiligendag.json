                            {
                                "example_id": "c39da02b-3c8d-4e1a-ab59-bf7a80064f75",
                                "sense_id": "0f7226e7-5122-3f4e-9a77-7c10b393e97e",
                                "text": "Heiligendag op 7 (20) april, genoemd naar de kind-heilige Aquilina, die onder keizer Diocletianus in het jaar 293 de marteldood stierf."
                            },
                            {
                                "example_id": "4bd1c630-8351-4549-92f5-7e7897b316ba",
                                "sense_id": "0f7226e7-5122-3f4e-9a77-7c10b393e97e",
                                "text": "In de Rooms-Katholieke Kerk heet 1 januari ook de heiligendag van Maria Moeder van God. Het lichaam van de vrouw baarde onze redder, aldus Franciscus die ook een lans brak voor migrantenmoeders: \"Veel moeders maken wanhopig met hun kinderen erg gevaarlijke reizen om ze zicht op een betere toekomst te bieden. Maar als ze aankomen worden ze meestal beoordeeld door mensen met een volle maag, met een heleboel eigendommen en een leeg hart.”"
                            }
                        ]
                    }
