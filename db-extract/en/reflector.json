                    },
                    {
                        "translation_id": "b9b21b19-b864-46ca-9670-82ab79564856",
                        "source_entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                        "source_sense_description": "small reflecting disk on a vehicle",
                        "target_lang_word": "réflecteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réflecteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a82088ac-7247-3d97-9fcd-46b89a75da1d",
                                        "entry_id": "e3a93424-0325-38be-b4f2-b035dc9cf4eb",
                                        "glosses": [
                                            "Se dit de certains corps particulièrement destinés à réfléchir la lumière."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3222a1c-397a-4b86-9fac-9e469f3d223f",
                                                "sense_id": "a82088ac-7247-3d97-9fcd-46b89a75da1d",
                                                "text": "…, éloignons un peu notre lampe, de manière à recevoir ses rayons sur le miroir réflecteur de notre microscope, et examinons quelques poils pris sur les animaux que nous venons de voir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "réflecteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff2e4cad-25d7-31ff-af04-c03b7b3bca65",
                                        "entry_id": "12080d69-60bc-39a6-ae3c-7844f1d4e308",
                                        "glosses": [
                                            "Appareil servant à réfléchir les rayons lumineux."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d52657d2-ddd9-4c7c-80a6-ea6b9a02aa43",
                                                "sense_id": "ff2e4cad-25d7-31ff-af04-c03b7b3bca65",
                                                "text": "Augmenter l’éclat d’une lampe par le moyen d’un réflecteur."
                                            },
                                            {
                                                "example_id": "e8ee23e5-f498-4069-9f03-9f0da120f0c8",
                                                "sense_id": "ff2e4cad-25d7-31ff-af04-c03b7b3bca65",
                                                "text": "Alors à ces moments-là, pendant qu’elle leur faisait de l’orangeade, tout d’un coup, comme quand un réflecteur mal réglé d’abord promène autour d’un objet, sur la muraille, de grandes ombres fantastiques, qui viennent ensuite se replier et s’anéantir en lui, toutes les idées terribles et mouvantes qu’il se faisait d’Odette s’évanouissaient, rejoignaient le corps charmant que Swann avait devant lui."
                                            },
                                            {
                                                "example_id": "e04988d6-6299-4cd3-9759-a0bd0187d4f3",
                                                "sense_id": "ff2e4cad-25d7-31ff-af04-c03b7b3bca65",
                                                "text": "Caroline alluma une lampe à réflecteur."
                                            },
                                            {
                                                "example_id": "514ea7c5-9a5f-4880-818d-4f5bfbc8a457",
                                                "sense_id": "ff2e4cad-25d7-31ff-af04-c03b7b3bca65",
                                                "text": "Un hideux réflecteur de métal renvoyait blafard le jour étroit d’une courette."
                                            },
                                            {
                                                "example_id": "cb76a3cf-f2ec-41c8-9ac7-0a62e851c711",
                                                "sense_id": "ff2e4cad-25d7-31ff-af04-c03b7b3bca65",
                                                "text": "Je ne voyais pas William. Je ne pouvais le voir, toute la salle, hors la table violemment éclairée par la lampe à réflecteur, se trouvant dans l’ombre."
                                            },
                                            {
                                                "example_id": "a4fdc886-6c22-4aca-bdd4-d034e32c29d5",
                                                "sense_id": "ff2e4cad-25d7-31ff-af04-c03b7b3bca65",
                                                "text": "Si nous produisons des réflecteurs aussi solides et durables, c’est pour qu’ils puissent servir pendant des dizaines d’années. Ils n’ont pas besoin de piles et sont recyclables."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db44dce-26bd-304e-8950-76f23afdb32d",
                                        "entry_id": "12080d69-60bc-39a6-ae3c-7844f1d4e308",
                                        "glosses": [
                                            "Élément réfléchissant les ondes électromagnétiques."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc64ffd5-5a64-47cb-a877-ebf3bf38aec0",
                                                "sense_id": "0db44dce-26bd-304e-8950-76f23afdb32d",
                                                "text": "En hyperfréquences, les antennes peuvent utiliser des montages similaires à l'optique, avec des réflecteurs plans ou paraboliques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "abe97df4-1632-3f93-9004-0851416050b0",
                                        "entry_id": "12080d69-60bc-39a6-ae3c-7844f1d4e308",
                                        "glosses": [
                                            "Réflecteur de neutrons."
                                        ],
                                        "tags": [
                                            "Nucléaire"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e97ff21d-342d-4214-a00a-d625d439d8cb",
                        "source_entry_id": "be74eb40-7657-35d5-8e6d-d006c92ace4c",
                        "source_sense_description": "small reflecting disk on a vehicle",
                        "target_lang_word": "Reflektor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Reflektor",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a98b6427-de7c-39cc-9452-748d2c58bdfd",
                                        "entry_id": "f29f9b81-e937-3c6e-a156-c3d100d14279",
                                        "glosses": [
                                            "Gerät / Material, das Strahlen zurückwirft oder bündelt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3793ac04-bc60-3d0f-937e-18274def6ae4",
                                        "entry_id": "f29f9b81-e937-3c6e-a156-c3d100d14279",
                                        "glosses": [
                                            "Gerät / Material, das Strahlen zurückwirft oder bündelt",
                                            "Hohlspiegel, beispielsweise von einem Scheinwerfer"
                                        ],
                                        "tags": [
                                            "Optik",
                                            "Lichtstrahlen (nah)"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "886f4154-68a8-37bc-adc1-4300135a1a39",
                                        "entry_id": "f29f9b81-e937-3c6e-a156-c3d100d14279",
                                        "glosses": [
                                            "Gerät / Material, das Strahlen zurückwirft oder bündelt",
                                            "Katzenauge, Rückstrahler"
                                        ],
                                        "tags": [
                                            "Lichtstrahlen (fern)"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ac665cdf-43df-427a-978a-258bda495a99",
                                                "sense_id": "886f4154-68a8-37bc-adc1-4300135a1a39",
                                                "text": "Jäger versuchen, das Wild davon abzuhalten auf die Straße zu laufen, indem Sie bewegliche Reflektoren, häufig CDs, am Straßenrand aufhängen."
                                            },
                                            {
                                                "example_id": "ee314523-42fa-4af9-afc6-1a91a3f6b24d",
                                                "sense_id": "886f4154-68a8-37bc-adc1-4300135a1a39",
                                                "text": "Links und rechts [der Straßen] sind Reflektoren befestigt, die auch bei Nacht optimale Sicht auf die Fahrbahn gewährleisten."
                                            },
                                            {
                                                "example_id": "6b010376-fe5e-4b87-b7db-dec035d2949b",
                                                "sense_id": "886f4154-68a8-37bc-adc1-4300135a1a39",
                                                "text": "Polizisten stoppten Autos, bemängelten unwichtige Kleinigkeiten, etwa die Form der Reflektoren am Heck –, verhängten willkürliche Strafen und steckten sich den größten Teil selbst ein."
                                            },
                                            {
                                                "example_id": "7dfe05db-b65e-4e3d-88b4-0bdd10602e98",
                                                "sense_id": "886f4154-68a8-37bc-adc1-4300135a1a39",
                                                "text": "Ich photographiere Portraits am liebsten draußen. Dafür brauche ich eine Assistentin, die den Reflektor hält."
                                            }
                                        ],
                                        "sense_index_json": "\"1b\""
                                    },
                                    {
                                        "sense_id": "44321216-3dfb-31fa-b665-9d9bf546dcfa",
                                        "entry_id": "f29f9b81-e937-3c6e-a156-c3d100d14279",
                                        "glosses": [
                                            "Gerät / Material, das Strahlen zurückwirft oder bündelt",
                                            "Parabolspiegel, Spiegelteleskop, Teleskop"
                                        ],
                                        "tags": [
                                            "Licht / elektromagnetische Wellen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c49b21c2-66ec-42b7-ad40-e772d4a87216",
                                                "sense_id": "44321216-3dfb-31fa-b665-9d9bf546dcfa",
                                                "text": "Trotzdem gelang es Herschel nach langer und mühsamer Arbeit, einen fünf Fuß langen Reflektor herzustellen, durch welchen er zu seiner Freude den Ring und die Monde des Saturn beobachten konnte."
                                            },
                                            {
                                                "example_id": "ec2eed23-a78f-4f2a-b448-0a7e8f1150cf",
                                                "sense_id": "44321216-3dfb-31fa-b665-9d9bf546dcfa",
                                                "text": "Mit einem Schüssel-Durchmesser von 500 Metern wird die auch \"FAST\" (Five-hundred-meter Aperture Spherical Telescope) genannte Anlage das bisher größte Radioteleskop in Arecibo in Puerto Rico - dieses hat einen Durchmesser von 305 Metern - ablösen. Der Reflektor besteht aus 4600 Metallpaneelen, die sich per Motorsteuerung entweder zu einer Kugelfläche oder zu einem Paraboloid zusammenschalten lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"1c\""
                                    },
                                    {
                                        "sense_id": "a7f1cae3-bf02-35c5-a80f-53d5f1acafe4",
                                        "entry_id": "f29f9b81-e937-3c6e-a156-c3d100d14279",
                                        "glosses": [
                                            "Gerät / Material, das Strahlen zurückwirft oder bündelt",
                                            "Richtantenne"
                                        ],
                                        "tags": [
                                            "Rundfunk",
                                            "elektromagnetische Wellen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e74a4624-b67d-4d53-9b94-3635d1145a28",
                                                "sense_id": "a7f1cae3-bf02-35c5-a80f-53d5f1acafe4",
                                                "text": "Mit Reflektor erreicht die Doppelquad-Antenne eine Verstärkungsleistung von etwa 12 dB."
                                            },
                                            {
                                                "example_id": "5a9be573-6da6-4478-9072-5b4d0dd9db89",
                                                "sense_id": "a7f1cae3-bf02-35c5-a80f-53d5f1acafe4",
                                                "text": "[Die Yagi-Uda-Antenne] besteht aus einem gespeisten Dipol, einer Reihe von Direktoren vor und meist einem Reflektor hinter dem Dipol."
                                            },
                                            {
                                                "example_id": "50875421-ccaf-41f9-af47-c6361a7f3283",
                                                "sense_id": "a7f1cae3-bf02-35c5-a80f-53d5f1acafe4",
                                                "text": "Die […] 197-Satellitenschüssel ist eine Offset Antenne mit einem Reflektor aus pulverbeschichtetem Aluminium."
                                            }
                                        ],
                                        "sense_index_json": "\"1d\""
                                    },
                                    {
                                        "sense_id": "a3931c83-5088-32d7-b33b-03f5da15c478",
                                        "entry_id": "f29f9b81-e937-3c6e-a156-c3d100d14279",
                                        "glosses": [
                                            "Gerät / Material, das Strahlen zurückwirft oder bündelt",
                                            "Umhüllung des spaltbaren Materials in Atomkraftwerken / Atombomben"
                                        ],
                                        "tags": [
                                            "Kerntechnik",
                                            "Neutronen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e121269-b9f4-4e6d-8f58-f9e4fae5229c",
                                                "sense_id": "a3931c83-5088-32d7-b33b-03f5da15c478",
                                                "text": "Eine weitere Schicht aus Aluminium zwischen Sprengstoff und Reflektor dient der besseren Stoßübertragung des konventionellen Sprengstoffs auf das Schwermetall."
                                            },
                                            {
                                                "example_id": "9e25f5ed-cb1c-46f7-b31c-6d4867d712a6",
                                                "sense_id": "a3931c83-5088-32d7-b33b-03f5da15c478",
                                                "text": "Ein Reflektor aus einem leichten Material wie Graphit oder Beryllium dient gleichzeitig dazu, die Bewegungsenergie der Neutronen zu reduzieren […]."
                                            }
                                        ],
                                        "sense_index_json": "\"1e\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
