                "word": "Marcionism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9eed1879-bd87-372a-8fa0-c7b0160ef29b",
                        "entry_id": "d845c386-f72f-3b7d-a827-a0531cadf966",
                        "glosses": [
                            "An early Christian following akin to but distinct from gnosticism which rejected the validity of the Old Testament and essentially denied the Trinity, regarding God the Father as an inferior demiurge, and that Jesus had nothing to do with the First Person of the Trinity."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6e0c1be7-af4e-47ff-8341-ec0b920d96e9",
                                "sense_id": "9eed1879-bd87-372a-8fa0-c7b0160ef29b",
                                "text": "Gnosticism and Marcionism offered two possible futures for the Jesus cult."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c576327d-7914-448e-8154-be94e15fd29d",
