                                        "sense_id": "9e6a9656-650c-3b58-a98b-a7aeb4df5370",
                                        "entry_id": "96af5afa-d054-356f-9461-c66ca56f5ac0",
                                        "glosses": [
                                            "Fabricated or deliberately manipulated content; intentionally created conspiracy theories or rumors."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aed5d3b-7037-4a8c-b63d-3f9c956c71ae",
                                                "sense_id": "9e6a9656-650c-3b58-a98b-a7aeb4df5370",
                                                "text": "Moreover, Trump’s use of obvious disinformation — the amateurish video he showed Ramaphosa, and his accompanying statements about the “over a thousand” killings of white farmers — to try and make his case has uprooted whatever U.S. credibility had survived over the last several months."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "disinformation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6851d015-998a-3e93-8685-cc6fdabaac01",
                                        "entry_id": "e1a116b1-2fe8-375a-8626-9da28dd3fa81",
                                        "glosses": [
                                            "To use disinformation."
                                        ],
