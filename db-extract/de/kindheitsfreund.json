                            {
                                "example_id": "3c48a479-797b-4335-a4b2-6e6082fd415d",
                                "sense_id": "0946e281-edd2-3d38-b474-f621d5d3db6d",
                                "text": "„2009 las ihre Tochter einen Zeitungsartikel über Roth, in dem dessen Wunsch erwähnt wurde, seine Kindheitsfreunde wiederzusehen.“"
                            },
                            {
                                "example_id": "1b878164-ffd2-4efc-af50-c1690baac050",
                                "sense_id": "0946e281-edd2-3d38-b474-f621d5d3db6d",
                                "text": "„Gylfi, Bjarnis Kindheitsfreund, und seine Frau Drífa wollten zum Essen kommen.“"
                            }
                        ],
