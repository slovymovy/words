                "senses": [
                    {
                        "sense_id": "b9dafb4f-84c6-33fe-898f-1b6dc5de16ce",
                        "entry_id": "acae544d-84ba-3b1c-9dd3-5a3c9100b0ee",
                        "glosses": [
                            "Faire perdre son caractère de catastrophe à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c355faa-86b6-4e9a-b18f-cfddac56d350",
                                "sense_id": "b9dafb4f-84c6-33fe-898f-1b6dc5de16ce",
                                "text": "Décatastropher l’aléa passe par la réduction d’une altérité sur laquelle l’homme n’a pas de prise."
                            },
                            {
                                "example_id": "74b21597-e180-4411-9997-dd10bcf6b841",
                                "sense_id": "b9dafb4f-84c6-33fe-898f-1b6dc5de16ce",
                                "text": "Comme certains psychologues positifs le disent, l’essentiel est de « contester » et de « décatastropher » les explications négatives."
                            }
                        ]
                    }
