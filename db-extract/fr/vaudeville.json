                                    {
                                        "sense_id": "536d9de1-9ff1-38e0-b2ec-5dc5932130b7",
                                        "entry_id": "64bab0a8-47b0-3510-83c2-fddc289e8266",
                                        "glosses": [
                                            "A style of multi-act theatrical entertainment which originated from France and flourished in Europe and North America from the 1880s through the 1920s."
                                        ],
                                        "tags": [
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0ea93b9-568f-4cef-8b65-177e96be3d0f",
                                                "sense_id": "536d9de1-9ff1-38e0-b2ec-5dc5932130b7",
                                                "text": "Mr. Sterling was born in Baltimore on June 24, 1915, to Jack Sexton and Edna Cable, veteran performers in vaudeville, showboats and stock companies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88a03214-e5cb-398d-8167-1e4f1c6c36f6",
                                        "entry_id": "64bab0a8-47b0-3510-83c2-fddc289e8266",
                                        "glosses": [
                                            "An entertainment in this style."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4a07306-e6a1-4161-b97d-0ac3fa4e9be9",
                                                "sense_id": "88a03214-e5cb-398d-8167-1e4f1c6c36f6",
                                                "text": "“Me, Myself and I,” directed by Emily Mann and engagingly acted by a cast that includes the invaluable Albee veteran Brian Murray, is in the tradition of Mr. Albee’s mid- and late-career works like “The Marriage Play” and “The Play About the Baby”: fragmented philosophical vaudevilles that turn the most fundamental questions of identity into verbal soft-shoes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
