{
    "word_family": [
        "shirt",
        "tail"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f61bd2c4-b9f3-3c5e-8b3b-a6c62ebfeb85",
                    "sense_definition": "The bottom part of a shirt that hangs below the waist.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "clothing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tucked his <w>shirttail</w> into his trousers before the meeting.",
                            "target_lang_translations": {
                                "zh": "开会前，他把<w>衬衫下摆</w>塞进了裤子里。"
                            }
                        },
                        {
                            "text": "She wore an old shirt with the <w>shirttail</w> hanging out.",
                            "target_lang_translations": {
                                "zh": "她穿着一件旧衬衫，<w>衬衫下摆</w>露在外面。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tuck in shirttail"
                    ],
                    "target_lang_definitions": {
                        "zh": "衬衫下摆，指衬衫腰部以下的部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "衬衫下摆",
                                "target_lang_sense_clarification": "指衬衫下部垂下的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b33744a3-7280-3eab-8347-feb82b0235b2",
                    "sense_definition": "A small or insignificant portion of something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quantity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He only managed to get a small <w>shirttail</w> of the total harvest.",
                            "target_lang_translations": {
                                "zh": "他只分到了总收成中<w>一小部分</w>。"
                            }
                        },
                        {
                            "text": "The candidate received only a <w>shirttail</w> of the votes in the district.",
                            "target_lang_translations": {
                                "zh": "该候选人只在该选区获得了<w>一小部分</w>选票。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fraction",
                        "sliver"
                    ],
                    "target_lang_definitions": {
                        "zh": "指某事物中极小或微不足道的一部分。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "一小部分",
                                "target_lang_sense_clarification": "指数量极少"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fd1bb96-d501-3ee9-b4da-f0bbacbb17dd",
                    "sense_definition": "Something or someone that is small, young, or unimportant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was just a <w>shirttail</w> of a boy when he started working on the farm.",
                            "target_lang_translations": {
                                "zh": "他开始在农场干活时，还是个<w>小家伙</w>。"
                            }
                        },
                        {
                            "text": "They expected him to manage that little <w>shirttail</w> of a garden alone.",
                            "target_lang_translations": {
                                "zh": "他们指望他独自打理那片<w>小小的</w>花园。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Southern US"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指年幼、弱小或不重要的人或事物。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "小家伙",
                                "target_lang_sense_clarification": "指年幼的孩子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0fd52d1-14f9-30ed-a689-25a5826815ee",
                    "sense_definition": "The outer edge or periphery of an area or concept.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "periphery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They lived on the <w>shirttail</w> of the city, far from the center.",
                            "target_lang_translations": {
                                "zh": "他们住在城市的<w>边缘</w>，离市中心很远。"
                            }
                        },
                        {
                            "text": "She felt like she was barely hanging on to the <w>shirttail</w> of her youth.",
                            "target_lang_translations": {
                                "zh": "她感觉自己几乎抓不住青春的<w>尾巴</w>了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "outskirts",
                        "fringe"
                    ],
                    "target_lang_definitions": {
                        "zh": "指区域或概念的边缘地带。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "指地带或范围的末端"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ad51e89-00b6-326d-a5de-e1d730062437",
                    "sense_definition": "A weak or indirect connection to something more powerful.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "connection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The group gained influence by riding the <w>shirttail</w> of the larger political movement.",
                            "target_lang_translations": {
                                "zh": "该团体通过<w>借光</w>更大的政治运动获得了影响力。"
                            }
                        },
                        {
                            "text": "Their success was tied to the <w>shirttail</w> of the main organization.",
                            "target_lang_translations": {
                                "zh": "他们的成功与主要组织有着<w>间接的</w>联系。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "riding the shirttail"
                    ],
                    "target_lang_definitions": {
                        "zh": "指与更有权势的事物之间微弱或间接的联系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "借光",
                                "target_lang_sense_clarification": "指依靠他人的势力或名声获益"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77f8c3d4-64f5-3a87-b231-4e0af3a4cd6b",
                    "sense_definition": "A very distant or vague family relationship.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "kinship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is just a <w>shirttail</w> cousin, not a close relative.",
                            "target_lang_translations": {
                                "zh": "他只是个<w>远亲</w>，不是近亲。"
                            }
                        },
                        {
                            "text": "We are related in a <w>shirttail</w> sort of way through my mother's side.",
                            "target_lang_translations": {
                                "zh": "我们通过我母亲那边有着某种<w>疏远的</w>亲戚关系。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "指非常疏远或模糊的亲属关系。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "远亲",
                                "target_lang_sense_clarification": "指关系疏远的亲戚"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}