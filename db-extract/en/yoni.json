                                            {
                                                "example_id": "1d863d7e-8647-4354-a580-530f66e8c4bc",
                                                "sense_id": "5d0c7dee-f582-342c-8efb-b75dfdc3d5d1",
                                                "text": "„Die Verbindung von Lingam und Yoni, dem Zeichen des weiblichen Geschlechts, symbolisiert die Vereinigung des Götterpaares Shiva und Kali, die Synthese von männlicher Kraft und kreativer, weiblicher Energie, die mystische ‚Einheit in der Zweiheit‘.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7d256857-d944-35e0-a581-a11261e2b899",
                                        "entry_id": "44f8f726-eba2-34de-beea-fbe11cd2da6a",
                                        "glosses": [
                                            "weibliches Geschlechtsteil"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2186ffbe-8409-4797-aebb-42b6ade9bf60",
                                                "sense_id": "7d256857-d944-35e0-a581-a11261e2b899",
                                                "text": "„Er legt seine warme Hand auf Ihre Yoni und die andere auf Ihren Herzbereich, um dann mit dieser Hand langsam in Richtung Yoni zu massieren.“"
                                            },
                                            {
                                                "example_id": "6d03910a-6de4-4f18-95c2-4f11db8a4574",
                                                "sense_id": "7d256857-d944-35e0-a581-a11261e2b899",
                                                "text": "„Mit den Fingerkuppen strich ich, die inneren Schamlippen durch die Spalte zwischen meinen Fingern gleiten lassend, ihre Yoni hinunter, […]“"
                                            },
                                            {
                                                "example_id": "77fa3856-d6a0-4676-9990-9cb7f3c69af6",
                                                "sense_id": "7d256857-d944-35e0-a581-a11261e2b899",
                                                "text": "„Sie trug keine Unterwäsche. Ihre Yoni leuchtete wie ein pinkfarbenes Bananenblatt.“"
                                            },
                                            {
                                                "example_id": "bf9ae0f7-1e95-4d7c-a3bf-bddb0bb6abd9",
                                                "sense_id": "7d256857-d944-35e0-a581-a11261e2b899",
                                                "text": "„Und welche Frau guckt denn in ihre Yoni? Auch dafür braucht sie ’nen Spiegel. Doch sie weiß meist gar nicht, wie ihre Yoni aussieht.“"
                                            },
                                            {
                                                "example_id": "ef419d88-6211-4322-9e49-0c1e0f930417",
                                                "sense_id": "7d256857-d944-35e0-a581-a11261e2b899",
                                                "text": "„Nun reckt sie ihm genüsslich ihren Po entgegen und er kann mit einer Hand ihre Po-Ritze und ihre Yoni streicheln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
