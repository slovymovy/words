                        "examples": [
                            {
                                "example_id": "7c52f4b9-9b82-434b-a9a7-7b9e20a9016c",
                                "sense_id": "4feb2cca-b458-3db7-8d8f-29d6b7b2dad3",
                                "text": "His uncle […] diverted him from that pursuit, and gave him a cornetcy in his own regiment."
                            },
                            {
                                "example_id": "8b674082-89ca-4f08-9253-f72a0b0292db",
                                "sense_id": "4feb2cca-b458-3db7-8d8f-29d6b7b2dad3",
                                "text": "I shall recommend your friend for an Ensigncy. Should you prefer a Cornetcy for him, I may be able to give him one."
                            },
                            {
                                "example_id": "bd14af43-dbe5-4695-b6a7-2f209d6e5345",
                                "sense_id": "4feb2cca-b458-3db7-8d8f-29d6b7b2dad3",
                                "text": "He was afterwards gazetted to a Cornetcy in the First Regiment of Life Guards."
                            }
