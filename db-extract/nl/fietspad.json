                                    {
                                        "sense_id": "1decdc07-422d-3439-bdd9-7f1b9f01ae55",
                                        "entry_id": "96aa6139-c11b-39d9-a0ca-dee4a7d0f33f",
                                        "glosses": [
                                            "Voie de circulation réservée aux cyclistes, distincte de la chaussée."
                                        ],
                                        "tags": [
                                            "Urbanisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59175093-7fd0-4bfe-8d2a-2cae687804bb",
                                                "sense_id": "1decdc07-422d-3439-bdd9-7f1b9f01ae55",
                                                "text": "La trottinette classique trouve naturellement sa place sur les trottoirs, où son utilisation est acceptée à l’allure de la marche (6 km/h). Elle ne peut en revanche ni emprunter les pistes cyclables, ni la chaussée."
                                            },
                                            {
                                                "example_id": "eb833d6a-5e57-423c-92c0-e1144399ec93",
                                                "sense_id": "1decdc07-422d-3439-bdd9-7f1b9f01ae55",
                                                "text": "La promenade fut aménagée pour le bonheur des promeneurs : piste cyclable, crottoirs pour toutous à sa mémère, bancs nombreux et propres permettant de s'extasier devant l’ire des marées."
                                            },
                                            {
                                                "example_id": "ccb97335-82b8-4092-a426-be9eb1a76c0d",
                                                "sense_id": "1decdc07-422d-3439-bdd9-7f1b9f01ae55",
                                                "text": "La piste cyclable ne fait pas partie de la chaussée ; les automobilistes ne peuvent pas l'emprunter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
