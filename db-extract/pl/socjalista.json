                ],
                "senses": [
                    {
                        "sense_id": "183aa54a-c9b1-3ac7-bda3-c713b48b6632",
                        "entry_id": "6d995918-6bb2-314a-99c4-96d71b8b7a15",
                        "glosses": [
                            "zwolennik socjalizmu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a0fd8de5-fe87-473e-8ddf-ff98d838847f",
                                "sense_id": "183aa54a-c9b1-3ac7-bda3-c713b48b6632",
                                "text": "Skończyła prestiżowe warszawskie gimnazjum, do którego chodziła inteligencka młodzież o lewicowych skłonnościach, spotykała się z socjalistami"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dd2c0c22-dc3e-4f38-8054-88873ea27670",
                        "source_entry_id": "6d995918-6bb2-314a-99c4-96d71b8b7a15",
                        "source_sense_id": "183aa54a-c9b1-3ac7-bda3-c713b48b6632",
                        "target_lang_word": "socialist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "socialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8160d0db-77d3-3b9d-bb02-11c39d553dd2",
                                        "entry_id": "c4db628a-69af-3d72-9452-edad4f24c8fc",
                                        "glosses": [
                                            "Of, relating to, supporting, or advocating socialism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b6762b4-206a-4241-a0b0-33dd135cf571",
                                                "sense_id": "8160d0db-77d3-3b9d-bb02-11c39d553dd2",
                                                "text": "...it must be remembered that in a Socialist farm or manufactory, each labourer would be under the eye not of one master, but of the whole community."
                                            },
                                            {
                                                "example_id": "36783a00-85c4-455d-bc75-1d668f1417c1",
                                                "sense_id": "8160d0db-77d3-3b9d-bb02-11c39d553dd2",
                                                "text": "I am convinced there is only one way to eliminate these grave evils, namely through the establishment of a socialist economy, accompanied by an educational system which would be oriented toward social goals."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "socialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e1a5d77d-748c-36bc-a1ac-8eaa0c469ae9",
                                        "entry_id": "f8bedd4c-21fe-3f7e-a971-05f3ae6dda35",
                                        "glosses": [
                                            "One who supports or advocates socialism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f664e3a7-dd87-4470-b002-c72d6a8ad613",
                                                "sense_id": "e1a5d77d-748c-36bc-a1ac-8eaa0c469ae9",
                                                "text": "A contest, who can do most for the common good, is not the kind of competition which Socialists repudiate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "279fe15f-a166-4541-b6e4-e5cae5cd2761",
                        "source_entry_id": "6d995918-6bb2-314a-99c4-96d71b8b7a15",
                        "source_sense_id": "183aa54a-c9b1-3ac7-bda3-c713b48b6632",
                        "target_lang_word": "socialista",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a2c8ad01-2cdb-4ee1-a461-4b624cdb5c3a",
                        "source_entry_id": "6d995918-6bb2-314a-99c4-96d71b8b7a15",
                        "source_sense_id": "183aa54a-c9b1-3ac7-bda3-c713b48b6632",
                        "target_lang_word": "socialiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "socialiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c8230e56-93eb-30c3-99ce-748f9b137707",
                                        "entry_id": "0063aff4-8a95-3c12-8e47-a5b39d856bf4",
                                        "glosses": [
                                            "Qui a rapport à un parti socialiste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32175478-f0dd-49ef-bb80-f4bea974a900",
                                                "sense_id": "c8230e56-93eb-30c3-99ce-748f9b137707",
                                                "text": "Il faut toujours gouverner contre quelque chose. Il n’y a plus aujourd’hui que les socialistes pour nous donner l’appui que la Droite nous a prêté quinze ans, avec une si constante générosité. Mais ils sont trop faibles. Il faudrait les renforcer, les grandir, en faire un parti politique. C’est, à l’heure qu’il est, le premier devoir d’un ministre de l’Intérieur."
                                            },
                                            {
                                                "example_id": "1a0b9b8e-0165-4a41-9c80-3155b3afe2bd",
                                                "sense_id": "c8230e56-93eb-30c3-99ce-748f9b137707",
                                                "text": "Quel étrange spectacle de voir un ministre socialiste, en compagnie du maire socialiste de la ville inaugurer le siège de la société privée qui va gérer les parkings lavallois suite à leur privatisation par la municipalité… à majorité socialiste !"
                                            },
                                            {
                                                "example_id": "0a46478e-1a97-4a02-a93a-96a4093425c0",
                                                "sense_id": "c8230e56-93eb-30c3-99ce-748f9b137707",
                                                "text": "Les primaires socialistes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "813b5867-0beb-347d-a21a-c90fb5ea57f7",
                                        "entry_id": "0063aff4-8a95-3c12-8e47-a5b39d856bf4",
                                        "glosses": [
                                            "Relatif au socialisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89e0e407-ecbb-4c70-8b36-1e0011f04bf2",
                                                "sense_id": "813b5867-0beb-347d-a21a-c90fb5ea57f7",
                                                "text": "En même temps, les idées socialistes se propageaient grâce à Louis Blanc et à Proudhon, et il allait falloir tenir compte des revendications de ces différentes écoles."
                                            },
                                            {
                                                "example_id": "af0381c5-9905-4f7a-9d67-5cf7ff2cb49d",
                                                "sense_id": "813b5867-0beb-347d-a21a-c90fb5ea57f7",
                                                "text": "En matière de gouvernement, il s’en tenait aux vues courtes et nettes. Fortement attaché au présent et peu soucieux de l’avenir, les socialistes ne le troublaient guère. Sans s’inquiéter si le soleil et le capital s’éteindraient un jour, il en jouissait. Selon lui, il fallait se laisser porter. Il n’y avait que les imbéciles qui résistaient au courant, et que les fous qui le devançaient."
                                            },
                                            {
                                                "example_id": "9d71bc58-ab57-4720-b8ee-af1ecb4c116f",
                                                "sense_id": "813b5867-0beb-347d-a21a-c90fb5ea57f7",
                                                "text": "Le Quatorze Juillet arriva. Bienheureux jour où les boutiques des marchands de vin sont pleines de drapeaux, où les pétards partent en pleine rue, où les comités socialistes-révolutionnaires célèbrent leurs victoires."
                                            },
                                            {
                                                "example_id": "bfbc8ab9-1d64-46d9-9166-2ecb9fb61fe3",
                                                "sense_id": "813b5867-0beb-347d-a21a-c90fb5ea57f7",
                                                "text": "Cette interprétation s'appuie sur des éléments de réalité : des soixante-huitards ont adhéré au parti socialiste et ce dernier a repris à son compte des thèmes de la « révolution culturelle » de Mai."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "socialiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e97ee5-85d6-3922-91ca-c3f3f175187e",
                                        "entry_id": "2f718bf6-ff6d-3c3b-a5d5-22703b4bf1ec",
                                        "glosses": [
                                            "Celui, celle qui est partisan d’un parti socialiste."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "68e99db9-33f0-3a28-adc6-ea310766037c",
                                        "entry_id": "2f718bf6-ff6d-3c3b-a5d5-22703b4bf1ec",
                                        "glosses": [
                                            "Celui, celle qui est partisan du socialisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79cd867a-bedc-48f2-8fc3-cdc40699329f",
                                                "sense_id": "68e99db9-33f0-3a28-adc6-ea310766037c",
                                                "text": "La droite et les modérés, coagulés par le ministère Méline, s’étaient violemment heurtés aux radicaux et aux socialistes faisant front commun."
                                            },
                                            {
                                                "example_id": "ebb9ab32-22c3-41c1-aa4a-6483098f433a",
                                                "sense_id": "68e99db9-33f0-3a28-adc6-ea310766037c",
                                                "text": "L’internationalisme sentimental d’avant 1914 n’a pas résisté au choc des nations. Dans tous les pays en guerre, socialistes et syndicalistes, dans leur grande majorité, ont participé à la défense nationale."
                                            },
                                            {
                                                "example_id": "f031808b-b2e7-49a7-a0aa-dbcef38cf49c",
                                                "sense_id": "68e99db9-33f0-3a28-adc6-ea310766037c",
                                                "text": "les radsocs de l’époque, véritables précurseurs de la social-démocratie, situés à la droite de socialistes sur le demi-camembert électoral, passeraient aujourd’hui pour des gauchistes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
