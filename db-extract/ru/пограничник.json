                                        "entry_id": "b7c9c1ba-1caa-39fa-b7da-59b6235d8f81",
                                        "glosses": [
                                            "Soldat, der an der Grenze/im Grenzdienst eingesetzt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b736aa-6042-4ad9-b980-b4399c68cba1",
                                                "sense_id": "e57c028e-7f28-39da-b8bd-8817b6765808",
                                                "text": "„Wenig später wurde wahrhaftig auch unsere Abteiltür geöffnet, und ein Grenzsoldat wollte unsere Ausweise sehen.“"
                                            },
                                            {
                                                "example_id": "7a025a50-e945-4150-9c45-9c581ccfcdca",
                                                "sense_id": "e57c028e-7f28-39da-b8bd-8817b6765808",
                                                "text": "„Das war zwar nicht bei jedem Grenzsoldaten angekommen, aber an gutem Willen hatte es nicht gemangelt.“"
                                            },
                                            {
                                                "example_id": "9837695c-97ec-4036-a0ed-860bcd14dfed",
                                                "sense_id": "e57c028e-7f28-39da-b8bd-8817b6765808",
                                                "text": "„Parallel dazu nahmen Scharmützel zwischen Grenzsoldaten der beiden Staaten zu.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
