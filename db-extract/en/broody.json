                        "target_lang_word": "Henne",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Henne",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "777740c3-e981-3dca-b238-2231152c1522",
                                        "entry_id": "aacb38c6-16ce-3751-bb94-28a77f7a358a",
                                        "glosses": [
                                            "weiblicher Vogel (insbesondere bei Hühnern)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "366bcd62-6dc9-4704-80c3-bb5bb4052fe4",
                                                "sense_id": "777740c3-e981-3dca-b238-2231152c1522",
                                                "text": "Die Henne legt jeden Tag ein Ei."
                                            },
                                            {
                                                "example_id": "cdbd8ffe-f909-4909-ab54-32549c1f74c2",
                                                "sense_id": "777740c3-e981-3dca-b238-2231152c1522",
                                                "text": "Die Henne ist das klügste Geschöpf im Tierreich. Sie gackert erst, nachdem das Ei gelegt ist."
                                            },
                                            {
                                                "example_id": "ebd98de1-81cf-4c6e-bd7a-86e56dfb3f2f",
                                                "sense_id": "777740c3-e981-3dca-b238-2231152c1522",
                                                "text": "Was war zuerst auf der Welt, die Henne oder das Ei?"
                                            },
                                            {
                                                "example_id": "f70c8024-697b-4a00-94ec-5c381309cabb",
                                                "sense_id": "777740c3-e981-3dca-b238-2231152c1522",
                                                "text": "„Denn noch nie war ich einer Henne über den Weg gelaufen, die mit mir schmusen wollte.“"
                                            },
                                            {
                                                "example_id": "b9975089-8e66-4bfe-8a13-b75f62f8b57a",
                                                "sense_id": "777740c3-e981-3dca-b238-2231152c1522",
                                                "text": "„Zwei gereizte Hennen hatten ihm ein Auge ausgepickt, als er noch ein Kätzchen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
