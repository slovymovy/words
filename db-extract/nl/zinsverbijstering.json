                                    },
                                    {
                                        "sense_id": "1e54be26-2567-35df-b703-671634244a9a",
                                        "entry_id": "1cf457c2-d2af-318b-9f05-db368693e789",
                                        "glosses": [
                                            "The state of being mad, insanity",
                                            "Insanity implying legal irresponsibility."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                                        "entry_id": "1cf457c2-d2af-318b-9f05-db368693e789",
                                        "glosses": [
                                            "Something deeply misguided."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a8d19b8b-9523-4d1c-9059-14b0a3840af4",
                                                "sense_id": "db58e9d1-449d-353b-a0d3-b609753f5de4",
                                                "text": "Two days have passed since that day of lunacy. What a noise and a fuss and a chattering and an uproar there was! And what a welter of unseemliness and disorder and stupidity and bad manners! And I the cause of it all! Yet part of the scene was also ridiculous—at all events to myself it was so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "389e1573-c0bc-4a88-bfc7-fda68f15a7f1",
                        "source_entry_id": "bc3dcf99-35f0-373a-9545-4025f9fa49eb",
                        "source_sense_id": "054d9bd8-eb18-39ab-8364-de3efb5b8ac9",
                        "target_lang_word": "insanity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insanity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8eec70a4-e095-3884-a3ec-c04de038575a",
                                        "entry_id": "f71bf44b-01f7-3605-a6bc-deb57582936a",
                                        "glosses": [
                                            "The state of being insane; madness."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "64b947b7-8ea9-4924-aaaf-6d4646a42d22",
                                                "sense_id": "8eec70a4-e095-3884-a3ec-c04de038575a",
                                                "text": "The defendant pleaded insanity in the hope of getting a reduced sentence."
                                            },
                                            {
                                                "example_id": "ffddcfba-80d6-47c3-b219-69c4148dee33",
                                                "sense_id": "8eec70a4-e095-3884-a3ec-c04de038575a",
                                                "text": "But the bed-side of Lady Marchmont had a darker lesson than the grave, the ravings of insanity revealed the fiery world of that beating and passionate heart. Ethel could only feel too fearful, too humbled, for judgment; but she wept, even while she prayed, beside her early friend."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
