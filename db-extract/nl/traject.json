                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77cc2a89-4746-4f97-bdd2-245b1dbc094f",
                                                "sense_id": "131def63-de1a-3fda-8b9a-72c64f6374d6",
                                                "text": "Bahn und Stabilisator sind nicht unabhängig voneinander."
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "f400137a-a534-3977-b3cb-9f8c1b9d39e5",
                                        "entry_id": "3bb52b5c-1b3c-385c-b10e-69a36888fc53",
