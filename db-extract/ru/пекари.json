                                        "entry_id": "4eacedbf-6981-3075-8cb7-7b361c438f12",
                                        "glosses": [
                                            "A peccary (Tayassuidae spp.), especially a collared peccary (Dicotyles tajacu)."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b012cf40-c6a6-4efe-a0aa-77f4a7fe4c70",
                                                "sense_id": "90596706-dc45-3036-a8b9-58a1ee542e69",
                                                "text": "The Javelina (Peccari) is an animal peculiar so far as I know to Spanish America."
                                            },
                                            {
                                                "example_id": "3151370b-a07e-4eea-83b9-1ffc3478ba64",
                                                "sense_id": "90596706-dc45-3036-a8b9-58a1ee542e69",
                                                "text": "Some well-mounted heads of deer and one of an enormous black javeli projected from the walls."
                                            },
                                            {
                                                "example_id": "55393f9b-cb6d-4851-b784-ef39affd7f62",
                                                "sense_id": "90596706-dc45-3036-a8b9-58a1ee542e69",
                                                "text": "We […] were ready to send some prickly pears to the next world when the most unfortunate group of javelina on earth walked into view."
                                            }
