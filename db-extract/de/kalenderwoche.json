                "senses": [
                    {
                        "sense_id": "48a0702d-f3f5-3511-a807-045e12774106",
                        "entry_id": "a48f5590-b7b0-310c-89f8-57452eb528a1",
                        "glosses": [
                            "eine Woche, beginnend mit Montag. Die Kalenderwochen werden dabei jedes Jahr durchnummeriert, Kalenderwoche 1 ist Anfang Januar."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5be6539a-123c-476a-ae49-83785a4846e0",
                                "sense_id": "48a0702d-f3f5-3511-a807-045e12774106",
                                "text": "Die nächste Lieferung trifft in Kalenderwoche 16 ein."
                            },
                            {
                                "example_id": "6441ccdf-a9b4-4bd1-b615-6c6dfc2eba2a",
                                "sense_id": "48a0702d-f3f5-3511-a807-045e12774106",
                                "text": "Die erste Kalenderwoche ist jene Woche, in der der erste Donnerstag des Jahres liegt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
