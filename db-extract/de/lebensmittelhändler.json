                        "glosses": [
                            "Person, die professionell Lebensmittel vertreibt, mit Lebensmitteln handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91478861-7c8d-4b80-ae7d-370b739d5bc7",
                                "sense_id": "5097451d-4bec-38f8-b0c1-d9d4d36a70dc",
                                "text": "„Ihre Hand umklammerte einen Zettel, eine Quittung des Lebensmittelhändlers, mit einer Adresse auf der Rückseite.“"
