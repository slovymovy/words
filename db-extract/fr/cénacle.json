                                        "examples": [
                                            {
                                                "example_id": "d68b4df1-d67c-42de-b313-71b93a48616a",
                                                "sense_id": "6dfa7865-9836-39ac-ad80-55ac4796b580",
                                                "text": "I circled with that group for three years."
