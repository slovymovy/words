                        ],
                        "form": "die Rechtschaffenheit"
                    },
                    {
                        "form_id": "6b9ad9cb-5fa3-4c45-8a6c-b30a4a176c26",
                        "entry_id": "1403ff06-85c8-310b-a10c-b9549427e4de",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Rechtschaffenheiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                        "entry_id": "1403ff06-85c8-310b-a10c-b9549427e4de",
                        "glosses": [
                            "Zustand, in dem jemand oder etwas rechtschaffen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1cba4fc-f1e9-4b35-a1dc-03bf065090d2",
                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                "text": "Die Rechtschaffenheit des Kandidaten beeindruckte die Wählerschaft."
                            },
                            {
                                "example_id": "74cd9495-a9f8-4a1a-b7d4-d86f2bb7e20e",
                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                "text": "„Das hatte er vor allem seiner sittlichen Rechtschaffenheit zu verdanken und seiner Gottesfurcht, die sein steifer weißer Kragen ausstrahlte.“"
                            },
                            {
                                "example_id": "e55f956b-f5d1-4f06-87a9-313191fb30aa",
                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                "text": "„Als wir den Raum verließen, in dem wir gespeist hatten, fragte ich Graf Bonneval, wer der Gast sei; er antwortete mir, daß der Türke ein reicher und weiser Philosoph von anerkannter Rechtschaffenheit sei, dessen Sittenreinheit ebenso groß sei wie seine Religiosität.“"
                            },
                            {
                                "example_id": "53cd4bb9-e4e1-4fdf-9897-2bd03ffea00c",
                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                "text": "„Unabhängigkeit von jedermann war das Fundament, auf dem sein inneres Glücksgefühl erwuchs, ein Gefühl der Freiheit und Rechtschaffenheit, das allein möglich wurde durch Sparsamkeit und Regelmäßigkeit, mit denen er seine ökonomischen Verhältnisse in Ordnung hielt.“"
                            },
                            {
                                "example_id": "8a5cb0fc-5859-4fe9-926e-480ae1e29938",
                                "sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                                "text": "„Die Ursache dazu war, daß die Tochter des dahingegangenen Richters Eydalin entschlossen war, Jón Hreggvidssons Sache zum Prüfstein für die Rechtschaffenheit ihres seligen Vaters als Richter zu machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e14e813-fc9f-405a-bd1d-8805b432d139",
                        "source_entry_id": "1403ff06-85c8-310b-a10c-b9549427e4de",
                        "source_sense_id": "157e2c6b-f40f-38f6-a2ba-1c31608f0b3e",
                        "source_sense_description": "Zustand, in dem jemand oder etwas rechtschaffen ist",
                        "target_lang_word": "righteousness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "righteousness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b855114-5a36-36c5-95b0-8f931a36130b",
                                        "entry_id": "3d97f13d-7c0b-3599-b8fe-33eeb1144304",
                                        "glosses": [
                                            "The quality or state of being righteous."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5590e76-4a51-42ac-ab52-2b1d0dd85a73",
                                                "sense_id": "4b855114-5a36-36c5-95b0-8f931a36130b",
                                                "text": "But in these days of fanaticism, that harsh and violent spirit is abroad, when men clothe their own angry passions in the garb of righteousness, and call persecution vindicating the honour of God."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f58236a-40b4-3c31-8f2d-bd7e38cc8e7a",
                                        "entry_id": "3d97f13d-7c0b-3599-b8fe-33eeb1144304",
                                        "glosses": [
                                            "Holiness; conformity of life to the divine law."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b0b49f-2829-479c-8eeb-09ecd637f5a3",
                                                "sense_id": "7f58236a-40b4-3c31-8f2d-bd7e38cc8e7a",
                                                "text": "21 ¶ I hate, I despise your feast dayes, and I will not smell in your solemne assemblies.\n22 Though ye offer me burnt offerings, and your meat offerings, I will not accept them: neither will I regard the peace offerings of your fat beasts.\n23 Take thou away from mee the noise of thy songs: for I will not heare the melodie of thy violes.\n24 But let iudgement run downe as waters, and righteousnesse as a mightie streame."
                                            },
                                            {
                                                "example_id": "c10b9af8-9a41-4e9c-90eb-78850763f930",
                                                "sense_id": "7f58236a-40b4-3c31-8f2d-bd7e38cc8e7a",
                                                "text": "By some paradoxical evolution rancour and intolerance have been established in the vanguard of primitive Christianity. Mrs. Spoker, in common with many of the stricter disciples of righteousness, was as inclement in demeanour as she was cadaverous in aspect."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67db558b-d090-35b6-9c06-6a439787b428",
                                        "entry_id": "3d97f13d-7c0b-3599-b8fe-33eeb1144304",
                                        "glosses": [
                                            "A righteous act or quality."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c60fc555-70de-48c2-999d-4073cb8332d6",
                                                "sense_id": "67db558b-d090-35b6-9c06-6a439787b428",
                                                "text": "All our righteousnesses are as filthy rags."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "84b30a8d-6fd9-3878-8f09-a3ae284ce4fc",
                                        "entry_id": "3d97f13d-7c0b-3599-b8fe-33eeb1144304",
                                        "glosses": [
                                            "The behaviour of someone who is righteous."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3ad0ace-0c06-46d3-bef4-dcced66ca625",
                                                "sense_id": "84b30a8d-6fd9-3878-8f09-a3ae284ce4fc",
                                                "text": "Blessed are they that keep judgment, and he that doeth rightness at all times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8adde359-35bf-351a-b369-b57ca59bacd3",
                                        "entry_id": "3d97f13d-7c0b-3599-b8fe-33eeb1144304",
                                        "glosses": [
                                            "The state of being right with God; justification; the work of Christ, which is the ground justification."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9baeb3b8-4d01-4b4b-ad23-4df756d55550",
                                                "sense_id": "8adde359-35bf-351a-b369-b57ca59bacd3",
                                                "text": "There are two kinds of Christian righteousness: the one without us, which we have by imputation; the other in us, which consisteth of faith, hope, and charity, and other Christian virtues."
                                            },
                                            {
                                                "example_id": "d5cca32a-82b4-4189-8e04-aa924f0bf4d6",
                                                "sense_id": "8adde359-35bf-351a-b369-b57ca59bacd3",
                                                "text": "Only for the righteousness of Christ imputed to us, and received by faith alone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
