                        "glosses": [
                            "собир. устар. и прост. деревья или кусты вишни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84bf8fa1-1b72-40fe-92bd-2420ddc44a2e",
                                "sense_id": "d3311ebf-74cb-3e5e-bb37-0b7cde02ebac",
                                "text": "Устроенная ею женская богадельня стояла в самом отдалённом углу сада и была обсажена кругом густым вишеньем."
                            }
                        ]
                    },
                    {
                        "sense_id": "a83eac11-d02e-3c21-a9a0-372c3e5e3f70",
                        "entry_id": "4c24ea69-cfd0-3e81-803f-01b6b397096b",
                        "glosses": [
                            "собир. устар. и прост. ягоды вишни"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e06ed99c-418c-49fc-9bf9-1c9ed85dc5fa",
                                "sense_id": "a83eac11-d02e-3c21-a9a0-372c3e5e3f70",
                                "text": "Ребятишки залезали в барский сад, как в свою собственную загородь, объедались вишеньем и хозяйничали в садовых беседках…"
                            }
                        ]
                    }
