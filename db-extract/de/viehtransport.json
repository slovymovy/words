                "senses": [
                    {
                        "sense_id": "71578cc5-1164-3026-9a65-945278ade55d",
                        "entry_id": "18df281d-34e2-3f3a-9545-6bab060ea550",
                        "glosses": [
                            "der Transport von Vieh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01f8e7c5-a9f1-4598-9d3e-e9fcba2d9394",
                                "sense_id": "71578cc5-1164-3026-9a65-945278ade55d",
                                "text": "„Bei einer Routinekontrolle stoppte die Polizei am Maschener Kreuz einen Viehtransport, in dem sich 55 toten Ferkel befanden.“"
                            },
                            {
                                "example_id": "95994017-ede5-4463-a559-4d063ba2c847",
                                "sense_id": "71578cc5-1164-3026-9a65-945278ade55d",
                                "text": "„Früher diente dieser Bootstyp zum Viehtransport über große Entfernungen.“"
                            },
                            {
                                "example_id": "dadebb92-46d1-48c7-97e5-648af1420047",
                                "sense_id": "71578cc5-1164-3026-9a65-945278ade55d",
                                "text": "„Ich werde wie auf einem Viehtransport zwischen all den grauenhaft lauten Menschen hin und her geworfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
