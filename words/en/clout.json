                        {
                            "text": "The shattered vase left many sharp <w>clouts</w> across the stone floor.",
                            "target_lang_translations": {
                                "zh": "打碎的花瓶在石地板上留下了许多尖锐的<w>碎片</w>。"
                            }
                        }
                    ],
                    "synonyms": [
