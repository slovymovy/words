                        "sense_id": "37cdfaa1-5315-326f-bf51-a65d3bd25581",
                        "entry_id": "18684ab8-7153-3921-9f5e-08b6c6065cb1",
                        "glosses": [
                            "A South American shrub (Aristotelia chilensis) native to the Valdivian temperate rainforest ecoregion of Chile and southern Argentina."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef74975a-eeb2-42c2-97a8-a5dadd23f416",
                                "sense_id": "37cdfaa1-5315-326f-bf51-a65d3bd25581",
                                "text": "But based on independent laboratory tests, maqui berry is not nearly as strong an antioxidant as açai."
                            },
                            {
                                "example_id": "69f15923-956e-4844-9eb8-566ff4c71844",
                                "sense_id": "37cdfaa1-5315-326f-bf51-a65d3bd25581",
                                "text": "Maqui berry (Aristotelia chilensis), also known as Chilean blackberry, is an edible berry that grows wild in central and southern Chile. A standardized anthocyanin rich formulation from Maqui berry (Aristotelia chilensis) administered at a dose of 500 mg/kg decreased fasting blood glucose and improved glucose tolerance in hyperglycemic C57/Bl6J mice fed a HF diet (Rojo et al. 2012)."
                            },
                            {
                                "example_id": "35de4ad2-130b-4fe7-ba03-a1d698454b08",
                                "sense_id": "37cdfaa1-5315-326f-bf51-a65d3bd25581",
                                "text": "Maqui is another strong antioxidant, this time coming from southern Chile."
                            }
                        ]
                    },
