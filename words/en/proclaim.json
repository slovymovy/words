{
    "word_family": [
        "proclamation",
        "proclaimer",
        "unproclaimed"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "57bafd4b-4272-30ee-88b8-3cb3ff75f084",
                    "sense_definition": "To announce or declare something publicly, officially, or clearly.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "declare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president will <w>proclaim</w> a national holiday to celebrate the historic victory.",
                            "target_lang_translations": {
                                "ru": "Президент <w>провозгласит</w> национальный праздник в честь исторической победы."
                            }
                        },
                        {
                            "text": "His expensive jewelry and designer clothes <w>proclaim</w> his tastes to everyone he meets.",
                            "target_lang_translations": {
                                "ru": "Его дорогие украшения и дизайнерская одежда <w>свидетельствуют</w> о его вкусах каждому встречному."
                            }
                        }
                    ],
                    "synonyms": [
                        "disclose",
                        "make known"
                    ],
                    "antonyms": [
                        "conceal",
                        "hide"
                    ],
                    "common_phrases": [
                        "proclaim his tastes",
                        "proclaim a holiday",
                        "publicly proclaim"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объявлять или заявлять о чем-либо публично, официально или четко."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "провозглашать",
                                "target_lang_sense_clarification": "официально и торжественно объявлять"
                            },
                            {
                                "target_lang_word": "объявлять",
                                "target_lang_sense_clarification": "сообщать во всеуслышание"
                            },
                            {
                                "target_lang_word": "свидетельствовать",
                                "target_lang_sense_clarification": "явно показывать или подтверждать что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54d7ed93-274e-3ea2-ad07-a93761df6343",
                    "sense_definition": "To officially place an area or organization under the scope of emergency powers or legal restrictions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to <w>proclaim</w> the district after the violent riots broke out.",
                            "target_lang_translations": {
                                "ru": "Правительство решило <w>объявить</w> в районе чрезвычайное положение после начала жестоких беспорядков."
                            }
                        },
                        {
                            "text": "In due course the organization was <w>proclaimed</w> and all its activities were suppressed.",
                            "target_lang_translations": {
                                "ru": "В свое время организация была <w>объявлена</w> вне закона, и вся ее деятельность была пресечена."
                            }
                        }
                    ],
                    "common_phrases": [
                        "proclaim the baronies",
                        "officially proclaim"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Used in legal or administrative contexts regarding emergency powers"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально вводить на определенной территории или в организации режим чрезвычайного положения или правовые ограничения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объявлять",
                                "target_lang_sense_clarification": "вводить официальный статус или положение"
                            },
                            {
                                "target_lang_word": "провозглашать",
                                "target_lang_sense_clarification": "официально устанавливать особый правовой режим"
                            },
                            {
                                "target_lang_word": "объявлять вне закона",
                                "target_lang_sense_clarification": "запрещать деятельность организации"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}