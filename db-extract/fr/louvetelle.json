                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "2390909d-966a-3d63-b949-fd33179041fe",
                        "entry_id": "e86ecd61-8e2f-3e61-8f86-63737f528d6a",
                        "glosses": [
                            "Scoutesse âgée de 8 à 12 ans."
                        ],
                        "tags": [
                            "Scoutisme"
                        ],
                        "examples": [
                            {
                                "example_id": "2c45b327-23f7-4adf-a59d-7af08aa4de7a",
                                "sense_id": "2390909d-966a-3d63-b949-fd33179041fe",
                                "text": "Je fus d’emblée une formidable louvetelle, je savais faire tous les nœuds, j’étais couverte de badges, et je devins amoureuse de ma chèfe de patrouille."
                            }
                        ]
