                "senses": [
                    {
                        "sense_id": "3814d0c4-2879-3af3-a12e-fcfc0196442a",
                        "entry_id": "382a8800-a7c3-3d47-9083-65460d48743c",
                        "glosses": [
                            "Meile pro Stunde"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "17e13f2c-15c8-4adb-8acc-18315705e1ea",
                                "sense_id": "3814d0c4-2879-3af3-a12e-fcfc0196442a",
                                "text": "„Sie stiegen in das Fahrzeug ihres Beschützers und fuhren binnen weniger Minuten mit über hundert Stundenmeilen durch den Staub von Südtexas.“"
                            },
                            {
                                "example_id": "8a629a9e-ff70-422c-8006-9aa9266ff280",
                                "sense_id": "3814d0c4-2879-3af3-a12e-fcfc0196442a",
                                "text": "„Die Tester meinten aber, dass der Van bei 70 Stundenmeilen an seinem absoluten Limit sei und empfahlen den Lesern, höchstens 65 mph (105 km/h) zu fahren.“"
                            },
                            {
                                "example_id": "f49bdba8-17ef-4e5a-b889-c00532e0da48",
                                "sense_id": "3814d0c4-2879-3af3-a12e-fcfc0196442a",
                                "text": "„Daß der Zug gerade unterhalb der gedrosselten Höchstgeschwindigkeit (25 Stundenmeilen = 40 km/h) gehalten wird, bewirkt ein elektronischer Regler, der den Motor einschaltet, wenn die Geschwindigkeit zu weit absinkt […].“"
                            },
                            {
                                "example_id": "1b4f0778-9be2-4135-9de1-441721e88c67",
                                "sense_id": "3814d0c4-2879-3af3-a12e-fcfc0196442a",
                                "text": "„Wenn man das Video anschaut, dann wird einem klar, dass der Wind im Kern des Vortex mit einer Geschwindigkeit von rund 150 Stundenmeilen über die Bay raste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
