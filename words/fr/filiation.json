                    "frequency": "Low",
                    "semantic_group_id": "parente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les généalogistes ont pu retracer la <w>filiation</w> de cette noble famille jusqu'au seizième siècle."
