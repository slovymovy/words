{
    "word_family": [
        "perceive",
        "perceptual",
        "perceptive",
        "perceptibly",
        "imperceptible"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bf8d0dd5-6485-3e27-bfae-2aa0952a4ca9",
                    "sense_definition": "The way in which something is regarded, understood, or interpreted by the mind.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "understanding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The public <w>perception</w> of the new law has changed significantly over the last few months.",
                            "target_lang_translations": {
                                "ru": "Общественное <w>восприятие</w> нового закона значительно изменилось за последние несколько месяцев."
                            }
                        },
                        {
                            "text": "It is difficult to have a clear <w>perception</w> of time when you are working in a room without windows.",
                            "target_lang_translations": {
                                "ru": "Трудно иметь четкое <w>восприятие</w> времени, когда работаешь в комнате без окон."
                            }
                        }
                    ],
                    "synonyms": [
                        "ken"
                    ],
                    "common_phrases": [
                        "public perception",
                        "perception of time",
                        "general perception"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, как что-либо рассматривается, понимается или интерпретируется разумом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восприятие",
                                "target_lang_sense_clarification": "понимание или интерпретация"
                            },
                            {
                                "target_lang_word": "представление",
                                "target_lang_sense_clarification": "образ или мнение о чем-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dac6a3bd-342d-3400-946b-369019a8c849",
                    "sense_definition": "The process of using the senses to become aware of or identify objects and surroundings.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "sensory_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Our sensory <w>perception</w> allows us to distinguish between different colors and shapes in our environment.",
                            "target_lang_translations": {
                                "ru": "Наше сенсорное <w>восприятие</w> позволяет нам различать цвета и формы в окружающей среде."
                            }
                        },
                        {
                            "text": "The scientist studied how depth <w>perception</w> helps animals navigate through dense forests.",
                            "target_lang_translations": {
                                "ru": "Ученый изучал, как <w>восприятие</w> глубины помогает животным ориентироваться в густых лесах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "sensory perception",
                        "depth perception",
                        "visual perception"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс использования органов чувств для осознания или идентификации объектов и окружения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восприятие",
                                "target_lang_sense_clarification": "сенсорный процесс"
                            },
                            {
                                "target_lang_word": "перцепция",
                                "target_lang_sense_clarification": "психологический термин для чувственного отражения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0654bfb5-df34-39e4-b799-4d5621d15917",
                    "sense_definition": "The ability to see, hear, or become aware of something through the senses with great accuracy or sharpness.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "acuity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her keen <w>perception</w> enabled her to notice the small details that others usually missed.",
                            "target_lang_translations": {
                                "ru": "Ее острое <w>восприятие</w> позволило ей замечать мелкие детали, которые другие обычно упускали."
                            }
                        },
                        {
                            "text": "The detective was famous for his extraordinary <w>perception</w> during complex criminal investigations.",
                            "target_lang_translations": {
                                "ru": "Детектив был знаменит своей необычайной <w>проницательностью</w> во время сложных уголовных расследований."
                            }
                        }
                    ],
                    "common_phrases": [
                        "keen perception",
                        "extraordinary perception"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность видеть, слышать или осознавать что-либо через органы чувств с большой точностью или остротой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "восприятие",
                                "target_lang_sense_clarification": "способность замечать детали"
                            },
                            {
                                "target_lang_word": "проницательность",
                                "target_lang_sense_clarification": "острота ума и наблюдательность"
                            },
                            {
                                "target_lang_word": "чутьё",
                                "target_lang_sense_clarification": "интуитивное или острое восприятие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}