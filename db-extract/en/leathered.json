                        "sense_id": "cc676d0c-573b-3c88-9ac4-b324bddfe491",
                        "entry_id": "47755b40-1351-3ac3-9bf4-4347ee16c6ce",
                        "glosses": [
                            "Very drunk; intoxicated."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "5b9fd26c-f2ad-4dcb-9703-f3d323894656",
                                "sense_id": "cc676d0c-573b-3c88-9ac4-b324bddfe491",
                                "text": "He'd been out with some of his work colleagues and naturally, got leathered. He remembers leaving the group to go to an ATM to get some much needed 'funds for more alcohol'."
                            },
                            {
                                "example_id": "ecd6e995-068e-41ab-8038-97ea646379d0",
                                "sense_id": "cc676d0c-573b-3c88-9ac4-b324bddfe491",
                                "text": "When Seini was born, we had a bash in a pub near my house called the Delph. All the St Helens lads came down as well as my schoolmates and we got leathered."
                            },
                            {
                                "example_id": "84fafd6b-dc7f-4ad3-9d0a-cf5af32623b6",
                                "sense_id": "cc676d0c-573b-3c88-9ac4-b324bddfe491",
                                "text": "Before we get totally leathered on national pride,' he said, 'maybe we should first work out how to be proud of being in the human race. I would like that. I would like that first.'."
                            }
                        ]
                    }
                ],
