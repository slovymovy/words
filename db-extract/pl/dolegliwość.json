                "translations": [
                    {
                        "translation_id": "7a3e00c7-81dc-41ea-ae0f-1a5ba290b75d",
                        "source_entry_id": "6d3a4a4e-ac35-3b55-b27e-679e71570f08",
                        "source_sense_id": "6148a201-b008-3c45-969f-9af2664a4f7a",
                        "target_lang_word": "ailment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ailment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d998ce08-7c5c-3f7b-8779-897c4fabe9ed",
                                        "entry_id": "379c14ac-62e5-38cb-b364-8dbfe72450ac",
                                        "glosses": [
                                            "Something which ails one; a disease; sickness."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d6a417d-635c-40d9-aed9-650db550a449",
                                                "sense_id": "d998ce08-7c5c-3f7b-8779-897c4fabe9ed",
                                                "text": "He had always been remarkably immune from such little ailments, and had only once in his life been ill, of a vicious pneumonia long ago at school. He hadn't the faintest idea what to with a cold in the head, he just took quinine and continued to blow his nose."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee4fea86-0f86-4e8c-83df-230c081e3e57",
                        "source_entry_id": "6d3a4a4e-ac35-3b55-b27e-679e71570f08",
                        "source_sense_id": "6148a201-b008-3c45-969f-9af2664a4f7a",
                        "target_lang_word": "Beschwerde",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Beschwerde",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73875c5f-77ff-39b6-a1ef-f4311cd74c46",
                                        "entry_id": "5e637b8f-f1a6-321a-8a34-6e44aeccd8d4",
                                        "glosses": [
                                            "Äußerung oder Mitteilung über eine unerwünschte Situation oder ein Fehlverhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d351f5b-6fed-4ec0-8b68-58d7323ca13e",
                                                "sense_id": "73875c5f-77ff-39b6-a1ef-f4311cd74c46",
                                                "text": "Wir haben bei der Hausverwaltung Beschwerde eingereicht."
                                            },
                                            {
                                                "example_id": "dce5dc5a-d12f-4165-84cb-9784048a64ac",
                                                "sense_id": "73875c5f-77ff-39b6-a1ef-f4311cd74c46",
                                                "text": "Rechtswesen: Gegen den Beschluss des Gerichts können Sie Beschwerde einlegen."
                                            },
                                            {
                                                "example_id": "7666444b-eb48-4e33-aca6-83fd34ecaeb5",
                                                "sense_id": "73875c5f-77ff-39b6-a1ef-f4311cd74c46",
                                                "text": "„Während sich die anderen Bewohner an den Hund gewöhnt hatten, sann Alf auf Widerstand und legte, gegen Leas Einspruch, Beschwerde bei der Hauswirtin ein, einer spindeldürren, präzise an jedem Monatsersten zum Miete-Inkasso erscheinenden Person.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "047f7a38-d16b-3fdc-bc5f-2fcb14c65920",
                                        "entry_id": "5e637b8f-f1a6-321a-8a34-6e44aeccd8d4",
                                        "glosses": [
                                            "meist Plural: körperliches Unwohlsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81dc65c0-dafe-4f08-9e9b-a84ba75bb642",
                                                "sense_id": "047f7a38-d16b-3fdc-bc5f-2fcb14c65920",
                                                "text": "„Doch dann kamen die Schlafstörungen, die Alpträume und andere erschreckende Beschwerden.“"
                                            },
                                            {
                                                "example_id": "6df9e890-2a95-4378-89a4-ced1d676641a",
                                                "sense_id": "047f7a38-d16b-3fdc-bc5f-2fcb14c65920",
                                                "text": "„Sollten die Beschwerden anhalten, ist eine Operation zu erwägen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2be7ae6e-f0e9-4e87-a981-86f9fed95ad8",
                        "source_entry_id": "6d3a4a4e-ac35-3b55-b27e-679e71570f08",
                        "source_sense_id": "6148a201-b008-3c45-969f-9af2664a4f7a",
                        "target_lang_word": "болячка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "болячка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "12653d66-b21c-319f-bb6c-073bd5ca9f1c",
                                        "entry_id": "1d1d5024-57ea-3556-9faa-c38bfc8cafc7",
                                        "glosses": [
                                            "разг. болезненное образование на теле"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5389f282-777f-4c51-a29d-2c6b1f2ac420",
                                                "sense_id": "12653d66-b21c-319f-bb6c-073bd5ca9f1c",
                                                "text": "На другое утро зеленый костюм оказался платьем, сильно измятым на животе, а на верхней губе Катерины Ивановны бугрилась болячка, закрашенная помадой."
                                            },
                                            {
                                                "example_id": "a25db0ca-331e-4337-a4a0-58663d5a7b10",
                                                "sense_id": "12653d66-b21c-319f-bb6c-073bd5ca9f1c",
                                                "text": "На сгибе левого стегна явилась болячка с булавочную головку, без верха и гноя, но мучительная."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "293932d7-4b20-3e59-b3ac-f2088e3d9700",
                                        "entry_id": "1d1d5024-57ea-3556-9faa-c38bfc8cafc7",
                                        "glosses": [
                                            "разг., шутл. то же, что болезнь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2bda268-cba8-494b-9229-68a9b77f2411",
                                                "sense_id": "293932d7-4b20-3e59-b3ac-f2088e3d9700",
                                                "text": "У меня глотка болела, так я не отделялся, и, слава богу, моя болячка на других не перекинулась."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3778fe1-0cec-3364-8b47-277621b0aa3f",
                                        "entry_id": "1d1d5024-57ea-3556-9faa-c38bfc8cafc7",
                                        "glosses": [
                                            "техн. жарг. перен. слабое место в чём-либо, часто ломающееся, плохо работающее и т.д."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37d3b23f-d3e7-4a21-b7b6-45f923dbd54a",
                                                "sense_id": "c3778fe1-0cec-3364-8b47-277621b0aa3f",
                                                "text": "Общая болячка «четвёрок» M43TU и «шестёрок» M52TU ― поломка цапфы, удерживающей термостат."
                                            },
                                            {
                                                "example_id": "3fa10415-4ec7-4017-8ec6-e268863b77ae",
                                                "sense_id": "c3778fe1-0cec-3364-8b47-277621b0aa3f",
                                                "text": "С другой стороны, те же неплатежи, а они в середине 90-х были одной из самых противных болячек российской экономики, Никита объяснял не столько банальным денежным сжатием, сколько преступной ошибкой назначать процент штрафов за просроченные платежи ниже стоимости кредита."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6be5a622-4b33-4f82-a72e-c2b0157c42e5",
                        "source_entry_id": "6d3a4a4e-ac35-3b55-b27e-679e71570f08",
                        "source_sense_id": "6148a201-b008-3c45-969f-9af2664a4f7a",
                        "target_lang_word": "недуг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "недуг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "998bb78a-1b38-3c5e-9ddd-2d224e1c2170",
                                        "entry_id": "7a0d9028-6eb0-3c9f-b712-c7b9b6b6e13c",
                                        "glosses": [
                                            "сильное недомогание; болезнь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "42731ec6-6d08-4786-b12f-2f011a755df2",
                                                "sense_id": "998bb78a-1b38-3c5e-9ddd-2d224e1c2170",
                                                "text": "Какое богатство на долю человека ни выпади, какое ни будь у него изобилие, а нагрянет недуг да приведет с собой калечество, так и несметное богатство выйдет хуже нищеты и всякой нужды."
                                            },
                                            {
                                                "example_id": "95ed4c5a-7820-4f70-b003-1e61bd751512",
                                                "sense_id": "998bb78a-1b38-3c5e-9ddd-2d224e1c2170",
                                                "text": "При такой бедности достаточно было серьезного недуга, страха смерти, влияния обстоятельств и людей, чтобы всё то, что я прежде считал своим мировоззрением и в чём видел смысл и радость своей жизни, перевернулось вверх дном и разлетелось в клочья."
                                            },
                                            {
                                                "example_id": "9a17396d-5b06-424b-99b1-345293d16944",
                                                "sense_id": "998bb78a-1b38-3c5e-9ddd-2d224e1c2170",
                                                "text": "Несмотря на врачебную помощь, изможденное тело не может ничего противопоставить недугу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
