{
    "word_family": [
        "quotation",
        "quote",
        "quotient"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d64cf303-fc42-36ec-9692-7b11dfccf9d4",
                    "sense_definition": "A fixed number or percentage that serves as a target, limit, or requirement.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sales team worked late every night to ensure they would hit their monthly <w>quota</w>.",
                            "target_lang_translations": {
                                "ru": "Отдел продаж работал допоздна каждую ночь, чтобы гарантированно выполнить свой месячный <w>план</w>."
                            }
                        },
                        {
                            "text": "Each officer has a specific <w>quota</w> of tickets they are expected to issue during their shift.",
                            "target_lang_translations": {
                                "ru": "У каждого офицера есть определенная <w>норма</w> штрафов, которые он должен выписать за смену."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit a quota",
                        "monthly sales quota",
                        "meet the quota"
                    ],
                    "target_lang_definitions": {
                        "ru": "Фиксированное количество или процент, служащие целью, пределом или обязательным требованием."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "план",
                                "target_lang_sense_clarification": "целевой показатель"
                            },
                            {
                                "target_lang_word": "норма",
                                "target_lang_sense_clarification": "установленное количество"
                            },
                            {
                                "target_lang_word": "квота",
                                "target_lang_sense_clarification": "количественный лимит"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9784c960-060e-3286-8d3b-0df1d2aca52b",
                    "sense_definition": "A proportional part or share assigned to a person or group.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "share",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The committee decided on the <w>quota</w> of funds that each department would receive this year.",
                            "target_lang_translations": {
                                "ru": "Комитет определил <w>долю</w> средств, которую каждый отдел получит в этом году."
                            }
                        },
                        {
                            "text": "After the harvest, each family received their fair <w>quota</w> of the communal grain.",
                            "target_lang_translations": {
                                "ru": "После сбора урожая каждая семья получила свою справедливую <w>часть</w> общинного зерна."
                            }
                        }
                    ],
                    "synonyms": [
                        "allocation",
                        "allotment",
                        "apportionment",
                        "quotum"
                    ],
                    "common_phrases": [
                        "fair quota",
                        "assigned quota"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пропорциональная часть или доля, выделенная человеку или группе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "доля",
                                "target_lang_sense_clarification": "часть при распределении"
                            },
                            {
                                "target_lang_word": "квота",
                                "target_lang_sense_clarification": "пай или часть в общем деле"
                            },
                            {
                                "target_lang_word": "норма",
                                "target_lang_sense_clarification": "положенное количество"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fa789ad2-812d-3e6d-8c45-374b881dc1d6",
                    "sense_definition": "A government-imposed trade restriction that limits the number or monetary value of goods that can be imported.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government introduced a strict import <w>quota</w> on foreign steel to protect local manufacturers.",
                            "target_lang_translations": {
                                "ru": "Правительство ввело строгую импортную <w>квоту</w> на иностранную сталь для защиты местных производителей."
                            }
                        },
                        {
                            "text": "Exceeding the annual <w>quota</w> for textile imports resulted in heavy fines for the trading company.",
                            "target_lang_translations": {
                                "ru": "Превышение годовой <w>квоты</w> на импорт текстиля привело к крупным штрафам для торговой компании."
                            }
                        }
                    ],
                    "common_phrases": [
                        "import quota",
                        "trade quota",
                        "strict quota"
                    ],
                    "target_lang_definitions": {
                        "ru": "Введенное государством торговое ограничение на количество или стоимость импортируемых товаров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "квота",
                                "target_lang_sense_clarification": "импортное ограничение"
                            },
                            {
                                "target_lang_word": "ограничение",
                                "target_lang_sense_clarification": "торговый лимит"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}