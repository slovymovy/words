                        "entry_id": "11861bc8-20f0-318c-9ea2-d829d126aefd",
                        "glosses": [
                            "Nombre complexe formé à partir de la même partie réelle qu'un autre, mais de partie imaginaire opposée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1e7017b6-79c9-3cd4-a1f5-33c17af19718",
                        "entry_id": "11861bc8-20f0-318c-9ea2-d829d126aefd",
                        "glosses": [
                            "Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8d422e0-184a-400c-94c7-027d33411484",
                                "sense_id": "1e7017b6-79c9-3cd4-a1f5-33c17af19718",
                                "text": "Les enzymes utilisées dans le conjugué sont principalement la HRP (horse radish peroxidase) pour une révélation chimioluminescente ou la PAL (phosphatase alcaline) pour une révélation colorimétrique."
                            }
                        ]
                    }
