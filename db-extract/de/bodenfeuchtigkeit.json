                "senses": [
                    {
                        "sense_id": "3eac2561-9bb4-3a23-a38d-a7e9dd28891e",
                        "entry_id": "055bd157-ceb7-3c7f-8a31-87592fc5c5d0",
                        "glosses": [
                            "Vorhandensein von Wasser im Erdboden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3343a89e-3f4f-4ba7-837f-ed11fe2edc34",
                                "sense_id": "3eac2561-9bb4-3a23-a38d-a7e9dd28891e",
                                "text": "„Von der Beanspruchung der Kellerwände und der Bodenplatte durch Bodenfeuchtigkeit ist zumindest auszugehen.“"
                            },
                            {
                                "example_id": "8efc4273-376e-4df1-894f-3179c1c0cebe",
                                "sense_id": "3eac2561-9bb4-3a23-a38d-a7e9dd28891e",
                                "text": "„Mit zunehmender Bodenfeuchtigkeit erhöht sich die Wärmeleitfähigkeit des Bodens deutlich.“"
                            },
                            {
                                "example_id": "da5029e5-006c-4b4f-a25f-c8007e3784fb",
                                "sense_id": "3eac2561-9bb4-3a23-a38d-a7e9dd28891e",
                                "text": "„Für die Apfelbäume wählen wir möglichst tiefgründige Parzellen, in denen das Grundwasser nicht hoch stehen darf und in denen auch bei langandauernden Regenperioden keine stagnierende Bodenfeuchtigkeit entsteht.“"
                            }
                        ],
