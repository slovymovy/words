                    ]
                },
                {
                    "sense_id": "aa232f47-8cde-31f9-ba1d-14801d6407bb",
                    "sense_definition": "Gewehr mit gezogenem Lauf, das vor allem für die Jagd verwendet wird.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "waffe",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Jäger reinigte seine <w>Büchse</w> sorgfältig nach der Rückkehr aus dem Wald."
                        },
                        {
                            "text": "Auf der Pirsch trug er eine schwere <w>Büchse</w> über der rechten Schulter."
                        }
                    ],
                    "antonyms": [
