                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c46a917-97f6-3f2a-a4a7-05722f5243f2",
                        "entry_id": "05c0b51e-fe15-3d61-96f4-556fd60b413f",
                        "glosses": [
                            "приспособление на борту лодки, куда вкладывается весло для упора при гребле"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c70f4c81-f54d-4bf1-b69b-bfe30eee4fc6",
                                "sense_id": "5c46a917-97f6-3f2a-a4a7-05722f5243f2",
                                "text": "Через час, позвав меня, она вскочила в лодчонку под мостом, я вставил страшно лязгнувшие вёсла в уключины и двинулся к расфуфыренному кораблю."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b28cdc1-f50f-4ed4-9f3c-05f8416ca864",
                        "source_entry_id": "05c0b51e-fe15-3d61-96f4-556fd60b413f",
                        "source_sense_id": "5c46a917-97f6-3f2a-a4a7-05722f5243f2",
                        "target_lang_word": "crutch",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crutch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4a96b038-942d-312c-9482-520c537acef4",
                                        "entry_id": "d3c58306-37ba-335e-8e6f-e326320ceacd",
                                        "glosses": [
                                            "A device to assist in motion as a cane, especially one that provides support under the arm to reduce weight on a leg."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81de671c-56c1-4e54-b2eb-9a7167a43f91",
                                                "sense_id": "4a96b038-942d-312c-9482-520c537acef4",
                                                "text": "He walked on crutches for a month until the cast was removed from his leg."
                                            },
                                            {
                                                "example_id": "ff4cf2fe-ed45-4396-a5c9-dee7dd7b7f89",
                                                "sense_id": "4a96b038-942d-312c-9482-520c537acef4",
                                                "text": "I'll lean upon one crutch, and fight with the other."
                                            },
                                            {
                                                "example_id": "ac30714d-e7a3-4dfb-a7ca-ca9da9653cc3",
                                                "sense_id": "4a96b038-942d-312c-9482-520c537acef4",
                                                "text": "Sullen now, with stultified spleen, Mrs Dibble grappled her crutches and levered herself upright after an ungainly struggle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "24a16a4b-3f5b-3ace-896c-fc38a01eba6f",
                                        "entry_id": "d3c58306-37ba-335e-8e6f-e326320ceacd",
                                        "glosses": [
                                            "Something or someone that supports, often used negatively to indicate that it is not needed and causes an unhealthful dependency; a prop"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fbd6798-a31e-4aba-ac64-898d3d5b2670",
                                                "sense_id": "24a16a4b-3f5b-3ace-896c-fc38a01eba6f",
                                                "text": "Alcohol became a crutch to help him through the long nights; eventually it killed him."
                                            },
                                            {
                                                "example_id": "b82488fd-30d0-4e00-a69e-eb80d06b8fbb",
                                                "sense_id": "24a16a4b-3f5b-3ace-896c-fc38a01eba6f",
                                                "text": "Rhyme[…]is […] at best a crutch that lifts the weak alone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b0d53e7-5f57-3d02-bb4a-8c2f889eeb16",
                                        "entry_id": "d3c58306-37ba-335e-8e6f-e326320ceacd",
                                        "glosses": [
                                            "A crotch; the area of body where the legs fork from the trunk."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e51a1156-1ecf-316a-9693-ae4343114d94",
                                        "entry_id": "d3c58306-37ba-335e-8e6f-e326320ceacd",
                                        "glosses": [
                                            "A form of pommel for a woman's saddle, consisting of a forked rest to hold the leg of the rider."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f8d51f5-f81c-3f05-8094-c60e14c88e07",
                                        "entry_id": "d3c58306-37ba-335e-8e6f-e326320ceacd",
                                        "glosses": [
                                            "A knee, or piece of knee timber."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "09568e30-3453-38c3-aaf6-1423a6dfb042",
                                        "entry_id": "d3c58306-37ba-335e-8e6f-e326320ceacd",
                                        "glosses": [
                                            "A forked stanchion or post; a crotch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ff27b03-9cce-341d-9248-6235f3893218",
                                        "entry_id": "d3c58306-37ba-335e-8e6f-e326320ceacd",
                                        "glosses": [
                                            "An improvised device, usually made from a piece of cardboard, to hold the last end of a joint."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "crutch",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2bcfd5a-8dc6-3652-8f0c-d0aa8e3b28d4",
                                        "entry_id": "ce994f18-49d5-32de-8b3b-43bc0fcc31db",
                                        "glosses": [
                                            "To support on crutches; to prop up."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21c19fa3-d06b-49e6-a3f9-31a8911b978c",
                                                "sense_id": "b2bcfd5a-8dc6-3652-8f0c-d0aa8e3b28d4",
                                                "text": "[I'll] haſten Og and Doeg to rehearſe, / Two Fools that Crutch their Feeble Senſe on Verſe; / Who by my Muſe to all ſucceeding times, / Shall live in ſpight of their own Dogrell Rhimes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a75efd50-a785-3c56-9fe7-dc7b68ba9c88",
                                        "entry_id": "ce994f18-49d5-32de-8b3b-43bc0fcc31db",
                                        "glosses": [
                                            "To move on crutches."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5ba31377-1202-33da-aae2-e98cc2423d3d",
                                        "entry_id": "ce994f18-49d5-32de-8b3b-43bc0fcc31db",
                                        "glosses": [
                                            "To shear the hindquarters of a sheep; to dag."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f945f1c0-a495-4883-bc56-edcb2092fcf7",
                                                "sense_id": "5ba31377-1202-33da-aae2-e98cc2423d3d",
                                                "text": "After learning how to crutch at 13, he could dag 400 sheep in a day by the spring of 1965 and earned himself more than just a bit of pocket money."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cac45ab2-f0f0-32b0-b5ac-b9852e8a9419",
                                        "entry_id": "ce994f18-49d5-32de-8b3b-43bc0fcc31db",
                                        "glosses": [
                                            "to stir with a crutch."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4bacea0-bbd3-4094-8f0a-9508c6004a12",
                        "source_entry_id": "05c0b51e-fe15-3d61-96f4-556fd60b413f",
                        "source_sense_id": "5c46a917-97f6-3f2a-a4a7-05722f5243f2",
                        "target_lang_word": "tolet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tolet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25c7a479-1ad5-3dcf-819e-fe29cf01d923",
                                        "entry_id": "329bc240-c00f-37be-a556-6b563376b772",
                                        "glosses": [
                                            "Fiche de bois ou de fer fixée dans le plat-bord d’une embarcation pour servir de point d’appui à l’aviron."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3d66f38-fa7c-41f4-a61c-5c9099c4df3e",
                                                "sense_id": "25c7a479-1ad5-3dcf-819e-fe29cf01d923",
                                                "text": "Je revins au bout de six mois, plus maigre qu’un tolet, mais plus amoureux qu’avant."
                                            },
                                            {
                                                "example_id": "d0402c4c-8027-4c5d-93a3-323fa1b47a9f",
                                                "sense_id": "25c7a479-1ad5-3dcf-819e-fe29cf01d923",
                                                "text": "Il reprit ses avirons ; et le claquement des tolets coupait la clameur de la tempête."
                                            },
                                            {
                                                "example_id": "1c5423bc-cc56-464e-a494-9fba42900163",
                                                "sense_id": "25c7a479-1ad5-3dcf-819e-fe29cf01d923",
                                                "text": "Travaillé par son atavisme riverain, maître Ténor ne quittait sa toge que pour chausser ses bottes de caoutchouc et passer des méandres de la procédures à ceux de la rivière. Sa barque à cul coupé, couleur grenouille, on la voyait partout, enfoncée jusqu’aux tolets par cent kilos d’homme de loi et pourtant maniée à merveille, bouchonnant ci, bouchonnant là et franchissant les pires chenaux en quatre coups de godille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
