                        "sense_id": "bfb9b043-5bd9-3db2-9c3b-b28657bc3426",
                        "entry_id": "c0dcd9ab-8ddd-3797-9fd4-f5f1ee97aa6a",
                        "glosses": [
                            "plural of Webelo"
                        ],
                        "tags": [
                            "form-of",
