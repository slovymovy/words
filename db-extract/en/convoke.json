                                        "entry_id": "56ca6e4a-f67d-3230-ad9e-4148f0ee105a",
                                        "glosses": [
                                            "срывать растения или грибы, снимать с растений плоды или другие полезные в хозяйстве части"
                                        ],
                                        "tags": [],
