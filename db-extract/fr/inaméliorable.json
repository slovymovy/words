                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f81b019-2347-492f-a9fe-16f9d66fa6a5",
                                "sense_id": "144229ea-d0c9-3f45-81eb-7bc30448b977",
                                "text": "Quoique le manque de munitions de guerre & de bouche parût rendre cette entreprise impossible, on envisageoit à Petersbourg ce plan comme excellent & inaméliorable."
                            },
                            {
                                "example_id": "1dba0c54-382c-46ea-ae8a-9914143e722a",
                                "sense_id": "144229ea-d0c9-3f45-81eb-7bc30448b977",
                                "text": "Elle a révélé que sur dix maisons construites avant la première guerre mondiale, une pouvait être considérée comme habitation inaméliorable."
                            },
                            {
                                "example_id": "272f63c5-c00d-49be-9223-647e4bba86c1",
                                "sense_id": "144229ea-d0c9-3f45-81eb-7bc30448b977",
                                "text": "Des débats ont été lancés, en cette occasion, sur différents sujets relatifs à la prévention de la malvoyance chez l’enfant et à la prise en charge des enfants amblyopes dont la vision reste inaméliorable par la correction optique."
                            }
                        ]
                    }
