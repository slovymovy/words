                                        "examples": [
                                            {
                                                "example_id": "9ddc2aa6-763f-4c58-a5cb-3d70db6df203",
                                                "sense_id": "d6f0152c-d93a-3586-9e83-b45b2c51f16c",
                                                "text": "He stood six feet tall, with muscular arms bulging out of his black T-shirt."
                                            },
                                            {
                                                "example_id": "6150eff4-e6b1-45ba-ad49-d3f0bad15742",
                                                "sense_id": "d6f0152c-d93a-3586-9e83-b45b2c51f16c",
                                                "text": "The wind actually stirred the cloth on the chest of drawers, and let in a little light, so that the sharp edge of the chest of drawers was visible, running straight up, until a white shape bulged out; and a silver streak showed in the looking-glass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8b7a7a1-fe88-3c93-bdd9-f99530a484c3",
                                        "entry_id": "8c472568-90c3-3e4c-b937-158e40470e28",
                                        "glosses": [
                                            "(of a container, etc.) To have the surface stretched by something pushing out; to swell; to belly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f743813d-e575-4c27-8b24-bd8921c606c7",
                                                "sense_id": "c8b7a7a1-fe88-3c93-bdd9-f99530a484c3",
                                                "text": "The submarine bulged because of the enormous air pressure inside."
                                            },
                                            {
                                                "example_id": "aa6b37f6-033e-4f04-9331-98cd46b32622",
                                                "sense_id": "c8b7a7a1-fe88-3c93-bdd9-f99530a484c3",
                                                "text": "You will return from work one day to an empty, echoing apartment, and the neighbors will tell you that B was last seen driving away in a bulging moving van."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51038f38-8112-3371-a84a-1011cdd24327",
                                        "entry_id": "8c472568-90c3-3e4c-b937-158e40470e28",
                                        "glosses": [
                                            "To bilge, as a ship; to founder."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb7657b0-ed7e-4700-aa7a-ceffc8030302",
                                                "sense_id": "51038f38-8112-3371-a84a-1011cdd24327",
                                                "text": "Fatal to Man! at once all Ocean roars,\nAnd scattered navies bulge on distant shores."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
