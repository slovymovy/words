                        "examples": [
                            {
                                "example_id": "c2883e7f-58b8-4460-b463-319e457a8a6e",
                                "sense_id": "e42390f6-5d28-3b19-bf29-69c507718189",
                                "text": "Wczoraj schwytano na gorącym uczynku rabusia, który plądrował okoliczne sklepy."
