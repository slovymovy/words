                    {
                        "sense_id": "d063ebaf-3b30-3c99-9047-6a66b66f7a69",
                        "entry_id": "cfc302ae-ad2e-3904-add7-3505095a68d1",
                        "glosses": [
                            "człowiek, który opowiada bajki, bajarz"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8b078af5-bf67-4745-aeb1-b25cf72383c1",
                                "sense_id": "d063ebaf-3b30-3c99-9047-6a66b66f7a69",
                                "text": "Z drugiej strony słowa o wyraźnie ujemnej konotacji, nazywające osobę o cesze nachalnego, natrętnego gadulstwa (babrok, żwok, czasem też bajdura), są stosowane przede wszystkim na określenie mężczyzn […]"
                            }
                        ],
                        "sense_index_json": "\"2.1\""
                    },
