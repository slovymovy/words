                    {
                        "sense_id": "92cfdafa-6581-3368-b187-60149a0dda03",
                        "entry_id": "c78e1f08-5b7f-316f-a9e9-eb506191dd1a",
                        "glosses": [
                            "A type of puppet created by Jim Henson or his studio, typically operated with one hand of the puppeteer inside the head and a rod or glove to move one arm of the puppet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "daec8724-9fd3-34c0-900f-9aee2cee6f69",
                        "entry_id": "c78e1f08-5b7f-316f-a9e9-eb506191dd1a",
                        "glosses": [
                            "One of a group of established puppet characters acting as a sort of repertory company on The Muppet Show, and/or appearing on Sesame Street."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2dd31da5-2f22-3aaa-933c-f8e109bea14d",
                        "entry_id": "c78e1f08-5b7f-316f-a9e9-eb506191dd1a",
                        "glosses": [
                            "Alternative form of muppet (fool)."
                        ],
                        "tags": [
                            "Australia",
                            "Canada",
                            "Eastern",
                            "Ireland",
                            "New-Zealand",
                            "South-Africa",
                            "UK",
                            "US",
                            "alt-of",
                            "alternative",
                            "derogatory",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "e45f611c-5539-401b-b50a-41e76fe10707",
                                "sense_id": "2dd31da5-2f22-3aaa-933c-f8e109bea14d",
                                "text": "'I'll come, if you like,' Paul says. 'I'm not asking you, Muppet,' Kit snaps."
                            },
                            {
                                "example_id": "22bfb83a-73a0-477c-b67a-2302fc5e8587",
                                "sense_id": "2dd31da5-2f22-3aaa-933c-f8e109bea14d",
                                "text": "English version: I'm A Cockney Geezer, You Muppet. No, you are an upper middle class, public school educated wanker (it takes one to know one) and I feel I must apologize to everyone on behalf of the land of my birth for the many crimes to cinema committed in the wake of Lock, Stock and Two Smoking Barrels (1998)."
                            },
                            {
                                "example_id": "27a01ba8-2dd3-4531-bc18-f44c55a2d7ac",
                                "sense_id": "2dd31da5-2f22-3aaa-933c-f8e109bea14d",
                                "text": "She tilts her head towards him, and whispers in his ear, “Of course I do, you Muppet. I keep telling you to trust The Source and our guides; don't I?\""
                            },
                            {
                                "example_id": "0f7b5276-2714-4e5d-81da-fcc3d5177468",
                                "sense_id": "2dd31da5-2f22-3aaa-933c-f8e109bea14d",
                                "text": "What's your fucking name you Muppet? I won't ask you again."
                            },
                            {
                                "example_id": "937da428-5d2a-4e1c-944a-de977ef97016",
                                "sense_id": "2dd31da5-2f22-3aaa-933c-f8e109bea14d",
                                "text": "Not that kind of atmosphere, you Muppet. A cut it with a knife atmosphere."
                            }
                        ]
                    }
