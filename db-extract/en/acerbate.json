                "senses": [
                    {
                        "sense_id": "409efb0f-8971-398e-bda2-f9e98f2cc657",
                        "entry_id": "13ae3ef4-7ea1-3f8e-90cc-1406cea605bd",
                        "glosses": [
                            "verschärfen, verstärken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7191d459-a6f1-49ee-a84b-a4581ad06ad1",
                                "sense_id": "409efb0f-8971-398e-bda2-f9e98f2cc657",
                                "text": "\"Ethnic variations in family structure, parenting styles, and life course expectations all acerbate miscommunication, and many U.S. teachers from middle-class backgrounds perceive themselves and their schools as being under siege.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
