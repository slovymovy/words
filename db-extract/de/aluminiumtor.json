                "senses": [
                    {
                        "sense_id": "318ddb71-dd01-3c8c-969e-5a6f3d09f9ee",
                        "entry_id": "c4e2e19a-10a2-3681-a85a-cecb3e2566b9",
                        "glosses": [
                            "Tor, das aus dem Metall Aluminium hergestellt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93c341b8-cc00-4264-bc6d-a923dd749975",
                                "sense_id": "318ddb71-dd01-3c8c-969e-5a6f3d09f9ee",
                                "text": "„Im Zeitraum 05.08. bis 11.08.2011 wurden aus einem offenen Schuppen am Sportgelände der Spielvereinigung Minderlittgen-Hupperath zwei Aluminiumtore, sowie aus einer Garage 20 Liter Diesel in einem Kanister entwendet.“"
                            },
                            {
                                "example_id": "5f4662ba-3b3f-4555-85d4-6c9a1ec5fccd",
                                "sense_id": "318ddb71-dd01-3c8c-969e-5a6f3d09f9ee",
                                "text": "„Dank Unterstützung vieler Sponsoren gelang es dem Förderverein, zwei neue Aluminiumtore für den Sportplatz anzuschaffen und einen attraktiven Preis für den Torschützenkönig zu stiften […].“"
                            },
                            {
                                "example_id": "132860e8-7fc5-4c50-95ea-65b7c259c408",
                                "sense_id": "318ddb71-dd01-3c8c-969e-5a6f3d09f9ee",
                                "text": "„\"Ich werde in naher Zukunft alle Vereine anschreiben und ihnen nahe legen, dass sie die Torhöhen ermitteln und gegebenenfalls korrigieren sollen.\" Das dürfte bei den heutigen Aluminiumtoren kein allzu großes Problem geben. […]\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
