                        "sense_id": "38ff10e9-e066-3a31-8d6c-be197688da55",
                        "entry_id": "f9116ad4-c1ea-346d-aab8-42562461ac7a",
                        "glosses": [
                            "Poisson du genre Micropterus (famille des Centrarchidae). On distingue l’achigan à petite bouche et l’achigan à grande bouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cc4a975-7377-4b36-bb41-e0cfab9cf9b1",
                                "sense_id": "38ff10e9-e066-3a31-8d6c-be197688da55",
                                "text": "Le passage de l'achigan en amont des barrages peut cependant très bien s'expliquer."
                            },
                            {
                                "example_id": "6c1f0662-509c-4de3-ba9b-cb5faeae8d2d",
                                "sense_id": "38ff10e9-e066-3a31-8d6c-be197688da55",
                                "text": "L’achigan est présent, pour sa part, dans le sud de ce territoire structuré, au grand plaisir des amateurs de sensations fortes."
                            }
                        ]
                    }
                ],
                "translations": [
