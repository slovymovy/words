    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "7e545701-5e58-30b8-86ef-e0179067ba7c",
                "word": "blowback",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "83e7a639-2bd4-42ae-bc50-710b25536151",
                        "entry_id": "7e545701-5e58-30b8-86ef-e0179067ba7c",
                        "tags": [
                            "plural"
                        ],
                        "form": "blowbacks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "056f534c-e0a6-32e4-b50b-354575f2d439",
                        "entry_id": "7e545701-5e58-30b8-86ef-e0179067ba7c",
                        "glosses": [
                            "A type of action where the pressure from the fired cartridge blows a sliding mechanism backward to extract the fired cartridge, chamber another cartridge, and cock the hammer."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "52a343ee-ecdc-47a5-867c-aa8e3214254a",
                                "sense_id": "056f534c-e0a6-32e4-b50b-354575f2d439",
                                "text": "The Israeli UZI submachine gun, one the most easily recognized examples of a blowback firearm, is well known for its simplicity, ease of manufacture, low maintenance, and utter reliability."
                            }
                        ]
                    },
                    {
                        "sense_id": "d70c8cd9-5844-3163-971b-1ff91aa3dd04",
                        "entry_id": "7e545701-5e58-30b8-86ef-e0179067ba7c",
                        "glosses": [
                            "An unintended adverse result, especially of covert political action."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "17ffdbb2-a9f3-437d-9062-503396e6a151",
                                "sense_id": "d70c8cd9-5844-3163-971b-1ff91aa3dd04",
                                "text": "All of the other retired C.I.A. officers who appeared before the subcommittee today acknowledged that the problem of the “domestic blowback” of agency propaganda had been a genuine problem, out most of them dismissed the mounting concern over C.I.A.'s past employment of American journalists as misguided."
                            },
                            {
                                "example_id": "b378a5dc-cf73-44dd-8e09-faff39a516b4",
                                "sense_id": "d70c8cd9-5844-3163-971b-1ff91aa3dd04",
                                "text": "During Congressional hearings on the agency in the mid-1970's, it was revealed that some of the agency's programs to plant false information in the foreign press had resulted in items being published by American news organizations. This phenomenon, known as blowback, was sharply criticized by the committees at the time, and the C.I.A. has since been required to take precautions so that such false information does not affect political debate in this country."
                            },
                            {
                                "example_id": "14087a4f-0be5-44aa-856b-8d18d10434b8",
                                "sense_id": "d70c8cd9-5844-3163-971b-1ff91aa3dd04",
                                "text": "It is a story about blowback from Sunni Islamist extremists who went to Syria from various Arab countries and were allowed to assemble there in the aftermath of the U.S.-led invasion of Iraq in 2003."
                            }
                        ]
                    },
                    {
                        "sense_id": "11b5ef0f-ec45-3f64-9451-6bac940a16ca",
                        "entry_id": "7e545701-5e58-30b8-86ef-e0179067ba7c",
                        "glosses": [
                            "The act of shotgunning (inhaling from a pipe etc. and exhaling into another smoker's mouth)."
                        ],
                        "tags": [
                            "countable",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "5a64f4d7-4e64-40b6-a3bc-f30db7c3cbd4",
                                "sense_id": "11b5ef0f-ec45-3f64-9451-6bac940a16ca",
                                "text": "Paranoid I was being ripped off, I 'tested' the potency of the skunk on a wasp by trapping it under a glass, and giving it a blowback."
                            }
                        ]
                    },
                    {
                        "sense_id": "796be768-f9d9-3b55-b3a1-f9d057c8c28f",
                        "entry_id": "7e545701-5e58-30b8-86ef-e0179067ba7c",
                        "glosses": [
                            "On a steam locomotive, the reversal of exhaust gases when the regulator is closed without using the blower."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "74120035-e00f-48b3-92d7-95c0781a48d3",
                                "sense_id": "796be768-f9d9-3b55-b3a1-f9d057c8c28f",
                                "text": "The Boulogne stop lasted a few minutes, during which I was surprised to see no use was made of the blower. In this country, if you shut the regulator without the blower on, the odds are there will be a blowback."
                            }
                        ]
                    },
                    {
                        "sense_id": "9936f567-e928-3f2e-9bd3-ae05ee3abd3c",
                        "entry_id": "7e545701-5e58-30b8-86ef-e0179067ba7c",
                        "glosses": [
                            "Synonym of backscatter."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
