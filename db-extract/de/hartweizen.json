                "senses": [
                    {
                        "sense_id": "26d27b24-f3ed-36cb-b1ad-d876d60bf8f7",
                        "entry_id": "9e5e0749-b6af-3e11-867b-56e23ef7e7f6",
                        "glosses": [
                            "die weltweit wirtschaftlich zweitbedeutendste Weizenart"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2face12-384e-49e6-b15b-ff451760cf95",
                                "sense_id": "26d27b24-f3ed-36cb-b1ad-d876d60bf8f7",
                                "text": "„Ein Ort, an dem der Wandel spürbar wird, ist North Dakota. Hier ist einer der wichtigsten Anbauorte für die Nudelindustrie. Der Bundesstaat grenzt im Norden an Kanada, ein menschenleerer Bundesstaat, die Kornkammer Amerikas. Es wird vor allem Hartweizen angebaut, einer der besten der Welt, glaubt man den Vertretern des Bundesstaats: hoher Proteingehalt, golden schimmernd.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21b4213c-4e7f-483b-a44b-41e1de07851c",
                        "source_entry_id": "9e5e0749-b6af-3e11-867b-56e23ef7e7f6",
                        "source_sense_id": "26d27b24-f3ed-36cb-b1ad-d876d60bf8f7",
                        "source_sense_description": "die weltweit wirtschaftlich zweitbedeutendste Weizenart",
                        "target_lang_word": "durum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "durum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05d02ea1-d41b-37c0-b4a2-f905811c440c",
                                        "entry_id": "67179aab-2042-3c14-91ad-3e0e016185be",
                                        "glosses": [
                                            "Ellipsis of durum wheat."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "attributive",
                                            "ellipsis",
                                            "often",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bcdb4b0-a524-4416-a4d3-74db232d1292",
                                                "sense_id": "05d02ea1-d41b-37c0-b4a2-f905811c440c",
                                                "text": "durum pasta"
                                            },
                                            {
                                                "example_id": "06b27b67-2007-42d7-9e43-7c584be12d00",
                                                "sense_id": "05d02ea1-d41b-37c0-b4a2-f905811c440c",
                                                "text": "durum bread"
                                            },
                                            {
                                                "example_id": "2155eef5-4a49-453c-8d93-aa5c7444fe5c",
                                                "sense_id": "05d02ea1-d41b-37c0-b4a2-f905811c440c",
                                                "text": "Much has been done in crossing Triticum durum Desf. and T. vulgare Vill.² in an attempt to produce common wheats that are as resistant to stem rust as are the durums."
                                            },
                                            {
                                                "example_id": "dc73b776-e0be-44e7-b323-88f178ab4897",
                                                "sense_id": "05d02ea1-d41b-37c0-b4a2-f905811c440c",
                                                "text": "2003 October, Commission staff, Durum and Hard Red Spring Wheat From Canada, U.S. International Trade Commission, Publication 3639, page V-5,\nThe Minneapolis Grain Exchange stated that durum is a small volume commodity with very specific uses. The durum futures contract traded sporadically for several years, and the Exchange declared the durum futures market dormant after there were no trades and no open interest in any futures contracts."
                                            },
                                            {
                                                "example_id": "e56cecae-8d63-4c28-8011-08ee87203093",
                                                "sense_id": "05d02ea1-d41b-37c0-b4a2-f905811c440c",
                                                "text": "2012, Ruby Parker Puckett, Foodservice Manual for Health Care Institutions, Wiley (Jossey-Bass), 4th Edition, page 397,\nWater is added to a mixture of durum meal or flour, semolina, and farina to make dough that is forced through dies to make tubular macaroni products and cord-like spaghetti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fc0f0faa-24c8-4e9d-9037-67aa62d107ce",
                        "source_entry_id": "9e5e0749-b6af-3e11-867b-56e23ef7e7f6",
                        "source_sense_id": "26d27b24-f3ed-36cb-b1ad-d876d60bf8f7",
