        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "e4d75265-49e2-30ed-9236-e7b0102a37be",
                "word": "Moneyball",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "272bec48-56c8-3412-a9e6-75001512364f",
                        "entry_id": "e4d75265-49e2-30ed-9236-e7b0102a37be",
                        "glosses": [
                            "Baseball management relying on sabermetrics."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "8b35beef-baeb-4b80-8256-0ce2b96246c3",
                                "sense_id": "272bec48-56c8-3412-a9e6-75001512364f",
                                "text": "Sure, the Florida Marlins and some others have a shot, but the “Moneyball” approach — using spreadsheets and unconventional thinking to fell baseball’s rich Goliaths — seems to have been co-opted by the big guys themselves."
                            },
                            {
                                "example_id": "09828611-544a-44a0-a3a8-7de850806a7e",
                                "sense_id": "272bec48-56c8-3412-a9e6-75001512364f",
                                "text": "Sure, statistical analysis has changed baseball's front offices for the better. A little. But most things haven't changed. The Red Sox version of Moneyball, after all, includes lots and lots of money, and there's nothing new there."
                            },
                            {
                                "example_id": "ba0d7e2a-8e0d-4799-bab2-e952ee99e395",
                                "sense_id": "272bec48-56c8-3412-a9e6-75001512364f",
                                "text": "The moneyball formula in baseball—replacing scouts’ traditional beliefs and biases about players with data-intensive studies of what skills actually contribute most to winning—is just as applicable to the battle against out-of-control health-care costs."
                            }
                        ]
                    },
                    {
                        "sense_id": "bf1125a3-9e02-34b3-a09c-7758978b9f1e",
                        "entry_id": "e4d75265-49e2-30ed-9236-e7b0102a37be",
                        "glosses": [
                            "The application of advanced analytics to any domain in order to improve outcomes."
                        ],
                        "tags": [
                            "broadly",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f42eef5d-6e91-4fee-b1b4-e898446e46e6",
                                "sense_id": "bf1125a3-9e02-34b3-a09c-7758978b9f1e",
                                "text": "Campaigns are spending a lot of money, but they are not playing Moneyball."
                            },
                            {
                                "example_id": "cdbb5268-d6c2-478b-80f7-d8cee8688846",
                                "sense_id": "bf1125a3-9e02-34b3-a09c-7758978b9f1e",
                                "text": "The technical savvy on display was enough to show any guest that there’s more—a lot more—to the hotel business than the front desk and housekeeping. As host Wapner said, “It’s moneyball for hotels.”"
                            },
                            {
                                "example_id": "46026266-0b07-43a3-8c8d-22c446ce4110",
                                "sense_id": "bf1125a3-9e02-34b3-a09c-7758978b9f1e",
                                "text": "Now people everywhere can bring “Moneyball” to medicine. A few months after releasing their global numbers in The Lancet, the same scientists supplied the underlying figures for 187 nations."
                            },
                            {
                                "example_id": "aad56645-b7ce-4788-907e-d76e988e973c",
                                "sense_id": "bf1125a3-9e02-34b3-a09c-7758978b9f1e",
                                "text": "For years, Amazon seemed to employ a Moneyball approach to media, spreading its bets across less-than-stellar intellectual properties."
                            }
                        ]
                    }
                ],
