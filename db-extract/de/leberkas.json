                        "examples": [
                            {
                                "example_id": "b29ef5d8-e13b-4879-b89c-c8c40d401427",
                                "sense_id": "94f1b4fe-1fad-30f9-9532-a3698d2d26aa",
                                "text": "„Und davon bekommen auch die Südafrikaner ein kleines Stück ab: Seit Franz Loibl da ist, gibt es jede Woche frische Weißwürste und der Leberkas hat die obligatorische Kruste.“"
                            },
                            {
                                "example_id": "fde0e252-a7f0-4982-83f4-94aa219a310c",
                                "sense_id": "94f1b4fe-1fad-30f9-9532-a3698d2d26aa",
                                "text": "„Und in der Tat ist bereits in so manchem Leberkas eine ordentliche Portion Pferd nachgewiesen worden. Besonders in Österreich. Aber bevor sich nun der Magen verrenkt: Das mit dem Pferd ist voll und ganz erlaubt […].“"
                            }
                        ],
