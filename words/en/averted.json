                    "sense_id": "c29eaaec-c9c7-3fcc-8b68-7154ce32b698",
                    "sense_definition": "Turned away, especially to avoid looking at someone or something out of shame, discomfort, or emotion.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke in a low voice with <w>averted</w> eyes, unable to look directly at her.",
                            "target_lang_translations": {
                                "nl": "Hij sprak met zachte stem en met <w>neergeslagen</w> ogen, niet in staat om haar recht aan te kijken."
                            }
                        },
                        {
                            "text": "Her <w>averted</w> gaze suggested that she was deeply embarrassed by the question.",
                            "target_lang_translations": {
                                "nl": "Haar <w>afgewende</w> blik wekte de indruk dat ze zich enorm schaamde voor de vraag."
                            }
                        }
                    ],
                    "common_phrases": [
                        "averted eyes",
                        "averted gaze",
                        "averted glance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Weggedraaid of neergeslagen, vooral om te vermijden iemand of iets aan te kijken uit schaamte, ongemak of emotie."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "afgewend",
                                "target_lang_sense_clarification": "blik of gezicht opzij gericht"
                            },
                            {
                                "target_lang_word": "neergeslagen",
                                "target_lang_sense_clarification": "ogen naar beneden gericht uit verlegenheid of schaamte"
                            }
                        ]
                    }
                },
