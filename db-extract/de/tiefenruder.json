                    {
                        "sense_id": "d0275292-1c61-3c1a-9c63-a67944965c59",
                        "entry_id": "c8bd3727-715f-3b07-9a93-a2967f0d85ff",
                        "glosses": [
                            "Steuerruder, das bei der Einstellung der Tauchtiefe eines U-Bootes eingesetzt wird"
                        ],
                        "tags": [
                            "U-Boot-Bau"
                        ],
                        "examples": [
                            {
                                "example_id": "d78e75ea-cc02-42ba-b746-149303495499",
                                "sense_id": "d0275292-1c61-3c1a-9c63-a67944965c59",
                                "text": "„Hervorstechend sind auch die vorderen Tiefenruder seitlich des Turmaufbaus und die hinteren Tiefen- und Seitenruder, die als X-Ruder ausgeführt sind.“"
                            },
                            {
                                "example_id": "1cb8a0f6-694e-4b4e-9f79-d21ae253b735",
                                "sense_id": "d0275292-1c61-3c1a-9c63-a67944965c59",
                                "text": "„Die wichtigen Tiefenruder waren ausgefallen, sie konnten jetzt nur noch von Hand bedient werden.“"
                            },
                            {
                                "example_id": "72e5ac78-48fd-4e1e-83ae-039f9c495871",
                                "sense_id": "d0275292-1c61-3c1a-9c63-a67944965c59",
                                "text": "„Ich schaltete die E-Maschine ein, legte das Tiefenruder nach oben, das Boot schurrte noch etwas über Grund, dann hoben wir uns langsam ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
