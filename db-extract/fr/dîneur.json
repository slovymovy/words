                        "glosses": [
                            "Celui qui participe à un dîner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c50ae07-5a3d-4a41-b14e-4218a3fc9dfe",
                                "sense_id": "a0280726-9bbc-3cd6-a62b-d7478ac29b08",
                                "text": "[…] puis, comme la demie sonnait à la pendule, les dîneurs attardés finirent par réclamer l’addition."
                            },
                            {
                                "example_id": "acf9a473-5b34-4f6d-b66f-13f9fa47aaed",
                                "sense_id": "a0280726-9bbc-3cd6-a62b-d7478ac29b08",
                                "text": "Fandor déposa son pardessus au vestiaire et, du pas d’un dîneur tranquille, gagna une petite table."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62263c86-13a1-4a3b-9a6e-003088cc0deb",
                        "source_entry_id": "abfdfbe5-256d-33ac-ab1b-7bc3981abd73",
                        "source_sense_id": "a0280726-9bbc-3cd6-a62b-d7478ac29b08",
