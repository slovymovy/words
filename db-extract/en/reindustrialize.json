                            {
                                "target_word": "réindustrialiser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe0881d8-641c-3d43-a9a9-05e284c2a56b",
                                        "entry_id": "576a60c6-7d18-39cc-87b8-0afa5d69bc75",
                                        "glosses": [
                                            "Redévelopper l’industrie, industrialiser de nouveau (une ville, une région, un pays)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80d00be2-b315-4fe9-9692-9309ac1d9441",
                                                "sense_id": "fe0881d8-641c-3d43-a9a9-05e284c2a56b",
                                                "text": "Le modèle de développement des services au détriment de l’industrie a atteint ses limites: il va falloir réindustrialiser, réinvestir dans des technologies nouvelles telles que les économies d’énergie et des matières premières, le respect de l’environnement, les nanotechnologies, les sciences de la vie, les neurosciences, les communications…"
                                            },
                                            {
                                                "example_id": "a8ac2c18-7b46-4b63-b29c-99d1ae1ed302",
                                                "sense_id": "fe0881d8-641c-3d43-a9a9-05e284c2a56b",
                                                "text": "Il dit des choses particulièrement intéressantes que je partage sur la nécessité de réindustrialiser le pays."
                                            },
                                            {
                                                "example_id": "a4d75e9d-13ff-400c-8acd-d09fb864a572",
                                                "sense_id": "fe0881d8-641c-3d43-a9a9-05e284c2a56b",
                                                "text": "[…] pour recréer un milieu dans lequel nos idées puissent retrouver un potentiel et valoir encore, non pas comme passé, mais comme avenir pour les autres pays, nous devons nous rééquiper et nous réindustrialiser."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
