                        "glosses": [
                            "S’encourager mutuellement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33c91036-a06a-4695-a1c0-5c5ef346d260",
                                "sense_id": "712d83c7-5217-3248-bc98-8f17f069fb0b",
                                "text": "Car ces meschans garçons commençoient a s’esmouuoir, s’entr’encourager & armer pour venger la mort de leurs peres."
                            },
                            {
                                "example_id": "9ccd4cdf-1b20-45e1-8667-7a44e2a351b7",
                                "sense_id": "712d83c7-5217-3248-bc98-8f17f069fb0b",
                                "text": "C'est autour d'hommes comme Froger que se réunissent et s’entr’encouragent les voleurs et les assassins du peuple algérien."
                            },
                            {
                                "example_id": "11e3de68-5a25-43c8-94f3-200862fc96b1",
                                "sense_id": "712d83c7-5217-3248-bc98-8f17f069fb0b",
                                "text": "Deux petits garçons, écrit l'auteur de cette lettre, voyant venir la Bête à eux d'un pas lent, s’entr’encouragèrent et, ne découvrant pas de voie pour éviter leur rencontre, ils montèrent tous deux sur un arbre."
                            }
                        ]
                    }
