                "forms": [
                    {
                        "form_id": "4f534ca1-0cf4-4692-a5f4-7447f2a8ef98",
                        "entry_id": "99b8b9e0-b463-3da3-9640-2b435832ef33",
                        "tags": [
                            "plural"
                        ],
                        "form": "frigidaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8fa3bd17-909b-31fd-a0c0-98359e41a1b7",
                        "entry_id": "99b8b9e0-b463-3da3-9640-2b435832ef33",
                        "glosses": [
                            "(Par antonomase) Réfrigérateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7c4ff77-7dcc-44ac-b39e-c1014730940b",
                                "sense_id": "8fa3bd17-909b-31fd-a0c0-98359e41a1b7",
                                "text": "Aujourd’hui, si l’on voit encore des feux de bagasse, des sébis au pétrole, il y a néanmoins l’électricité, et le frigidaire a vaincu le soleil."
                            },
                            {
                                "example_id": "8dd5c6d3-23f6-4fd0-be94-5a7a736bfa22",
                                "sense_id": "8fa3bd17-909b-31fd-a0c0-98359e41a1b7",
                                "text": "[…] il revenait vite aux drames du frigidaire détraqué et de l’ascenseur en panne."
                            },
                            {
                                "example_id": "1b776d26-bcf4-457a-8e3a-a0486f897c7a",
                                "sense_id": "8fa3bd17-909b-31fd-a0c0-98359e41a1b7",
                                "text": "Tant qu'y m'restera quequ'chose dans l'frigidaire\n J'prendrai l'métro, j'fermerai ma gueule pis j'laisserai faire\n Mais ya quequ'chose qui m'dit qu'un beau matin\n Ma Rosalie, on mettra du beurre sur notre pain."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6407b44d-f85f-4d13-87a0-de359f46b814",
                        "source_entry_id": "99b8b9e0-b463-3da3-9640-2b435832ef33",
                        "source_sense_id": "8fa3bd17-909b-31fd-a0c0-98359e41a1b7",
                        "target_lang_word": "lednice",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lednice",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "19dd73a2-420e-3a58-92ad-5e09af502585",
                                        "entry_id": "e35b5f3c-7d75-30e5-a41e-f2efbe14556c",
                                        "glosses": [
                                            "zařízení na uchovávání potravin při nízké teplotě (obvykle kolem 4 °C)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c679c1b-149c-4541-8c83-327a8dca0cc5",
                                                "sense_id": "19dd73a2-420e-3a58-92ad-5e09af502585",
                                                "text": "Když se vrátil z nákupu, uložil čerstvé potraviny hned do lednice."
                                            },
                                            {
                                                "example_id": "569d1062-3b41-46e4-bf07-d1d1d3a282a6",
                                                "sense_id": "19dd73a2-420e-3a58-92ad-5e09af502585",
                                                "text": "Co naopak nechybí, je lístek připevněný na lednici magnetem malého zeleného žabátka."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
