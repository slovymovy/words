                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c0d331b-1fb6-4273-a74e-76d60dd19b8e",
                                                "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                                "text": "Er lebt in guten/schlechten pekuniären Verhältnissen."
                                            },
                                            {
                                                "example_id": "0db6f64a-3239-44e8-bd1f-178a2e8980df",
                                                "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                                "text": "Seine pekuniäre Lage ist gut."
                                            },
                                            {
                                                "example_id": "8df13cb7-8e0d-4321-b871-09dbf6facce2",
                                                "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                                "text": "„Was die beiden Jungunternehmer zu körperlicher Eigeninitiative zwang, denn eine professionelle Beseitigung der verkeimten Hinterlassenschaft hätte zu solch immensen zusätzlichen pekuniären Belastungen geführt, dass sich ihr Finanzierungsplan über Nacht in ein Horoskop verwandelt hätte.“"
                                            },
                                            {
                                                "example_id": "d3a484db-3c87-4b7f-8132-4a4464b9171a",
                                                "sense_id": "9afdc36d-31e5-3f68-8a64-84c748645e68",
                                                "text": "„So kam es, daß Grete Erber sich bald nach der Hochzeit regelmäßig bei Recha einfand, um mit ihrer Hilfe der pekuniären Nöte Herr zu werden, die sie peinigten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
