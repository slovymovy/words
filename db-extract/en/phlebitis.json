                                            {
                                                "example_id": "179387c8-baa3-410f-aa2a-a1a1119cdfe2",
                                                "sense_id": "32a1d877-4ef2-352f-9b00-7c9f0e70b1da",
                                                "text": "„Wohl stehe ich auch heute noch auf dem Standpunkt, mit der Massage bei verdächtigen Venen, fraglichen Phlebitiden, nahen Entzündungsherden usw. recht vorsichtig zu sein, d. h. die Massage zu vermeiden.“"
                                            }
