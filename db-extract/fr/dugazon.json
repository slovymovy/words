                        "glosses": [
                            "Rôle d’amoureuse dans l'opéra-comique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94a140fe-190d-417f-b534-d6f444fc41ba",
                                "sense_id": "87f7088c-2846-3a3b-96ce-4fe978c6a4b7",
                                "text": "Je causerai théâtre, racontars de coulisses, potins de province, et, comme dit Popof, la connaissance sera bientôt faite avec le joyeux trial et la charmante dugazon."
                            },
                            {
                                "example_id": "960f5b62-5c9d-4a26-9630-e9ab05996be1",
                                "sense_id": "87f7088c-2846-3a3b-96ce-4fe978c6a4b7",
                                "text": "Mlle Parent aurait plus d’ampleur dans la voix si elle laissait plus de liberté à sa mâchoire inférieure ; les sons seraient aussi, par ce moyen, beaucoup plus doux. Ce qui n’empêche pas notre dugazon d’être excellente comédienne."
                            }
                        ]
                    }
