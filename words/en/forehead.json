                },
                {
                    "sense_id": "5c09ecd1-1cfa-3e0b-803b-a8f23b655996",
                    "sense_definition": "Confidence, audacity, or impudence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had the <w>forehead</w> to argue with the judge despite being clearly in the wrong.",
                            "target_lang_translations": {
                                "ru": "У него хватило <w>наглости</w> спорить с судьей, несмотря на то, что он был явно неправ.",
                                "zh": "尽管明显理亏，他竟然有<w>胆量</w>与法官争辩。"
                            }
                        },
                        {
                            "text": "It takes a certain amount of <w>forehead</w> to make such a bold claim without evidence.",
                            "target_lang_translations": {
