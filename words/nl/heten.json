{
    "word_family": [
        "heet",
        "hitte",
        "verhitten",
        "zogeheten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "da690140-fe0c-39e0-b502-33da00263fe1",
                    "sense_definition": "De naam dragen; als naam hebben.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>heet</w> Thomas en ik kom uit België.",
                            "target_lang_translations": {
                                "ru": "Меня <w>зовут</w> Томас, и я из Бельгии.",
                                "en": "My name <w>is</w> Thomas and I am from Belgium."
                            }
                        },
                        {
                            "text": "Hoe <w>heet</w> jouw broer?",
                            "target_lang_translations": {
                                "ru": "Как <w>зовут</w> твоего брата?",
                                "en": "What <w>is</w> your brother <w>called</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "heten naar"
                    ],
                    "target_lang_definitions": {
                        "ru": "Носить имя; зваться.",
                        "en": "To have a specific name; to be called."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зваться",
                                "target_lang_sense_clarification": "иметь имя"
                            },
                            {
                                "target_lang_word": "называться",
                                "target_lang_sense_clarification": "носить имя"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "be called",
                                "target_lang_sense_clarification": "to have a specific name"
                            },
                            {
                                "target_lang_word": "be named",
                                "target_lang_sense_clarification": "to have a name"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d2abcae-79ee-3d42-a29f-25f89aca1a76",
                    "sense_definition": "Aangeduid worden met een bepaalde term (vaak in een andere taal).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "naming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hoe <w>heet</w> dit gerecht in het Italiaans?",
                            "target_lang_translations": {
                                "ru": "Как <w>называется</w> это блюдо по-итальянски?",
                                "en": "What <w>is</w> this dish <w>called</w> in Italian?"
                            }
                        },
                        {
                            "text": "Dat kleine diertje <w>heet</w> een lieveheersbeestje.",
                            "target_lang_translations": {
                                "ru": "Этот маленький жучок <w>называется</w> божьей коровкой.",
                                "en": "That little creature <w>is called</w> a ladybug."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Называться; обозначаться определенным термином.",
                        "en": "To be referred to by a certain term or name, often in a different language."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "называться",
                                "target_lang_sense_clarification": "иметь название (о предметах)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "be called",
                                "target_lang_sense_clarification": "to be known as"
                            },
                            {
                                "target_lang_word": "be named",
                                "target_lang_sense_clarification": "to have a specific designation"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d01aa65e-1f09-30ec-96d5-3ab1cd6a71a3",
                    "sense_definition": "Betekenen; neerkomen op.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dat <w>heet</w> geluk hebben, want het had veel slechter kunnen aflopen.",
                            "target_lang_translations": {
                                "ru": "Это <w>называется</w> повезло, так как всё могло закончиться гораздо хуже.",
                                "en": "That <w>is called</w> being lucky, because it could have ended much worse."
                            }
                        },
                        {
                            "text": "Zonder te betalen weglopen <w>heet</w> diefstal.",
                            "target_lang_translations": {
                                "ru": "Уйти не заплатив <w>называется</w> кражей.",
                                "en": "Walking away without paying <w>is considered</w> theft."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Означать; являться по сути.",
                        "en": "To mean or amount to; to be considered as."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "называться",
                                "target_lang_sense_clarification": "считаться чем-либо"
                            },
                            {
                                "target_lang_word": "считаться",
                                "target_lang_sense_clarification": "расцениваться как"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "be called",
                                "target_lang_sense_clarification": "to be considered or labeled as"
                            },
                            {
                                "target_lang_word": "be known as",
                                "target_lang_sense_clarification": "to be equivalent to"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7efb2cff-f888-3da0-a21b-95e16c87c4a8",
                    "sense_definition": "Iemand of iets noemen; een naam geven.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "naming_transitive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wij <w>heten</w> u van harte welkom in ons restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы сердечно <w>приветствуем</w> вас в нашем ресторане.",
                                "en": "We <w>bid</w> you a warm welcome to our restaurant."
                            }
                        },
                        {
                            "text": "De directeur <w>heette</w> de nieuwe collega's welkom.",
                            "target_lang_translations": {
                                "ru": "Директор <w>поприветствовал</w> новых коллег.",
                                "en": "The director <w>welcomed</w> the new colleagues."
                            }
                        }
                    ],
                    "synonyms": [
                        "noemen"
                    ],
                    "common_phrases": [
                        "welkom heten"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "buiten de uitdrukking 'welkom heten'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Приветствовать (в выражении 'welkom heten').",
                        "en": "To call someone or something; to give a name (primarily used in the phrase 'welkom heten')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приветствовать",
                                "target_lang_sense_clarification": "выражать приветствие"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "bid",
                                "target_lang_sense_clarification": "to express (e.g., bid welcome)"
                            },
                            {
                                "target_lang_word": "welcome",
                                "target_lang_sense_clarification": "to greet someone"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12715c2d-2adc-3ca4-95d3-b98fec78ef25",
                    "sense_definition": "Beweerd worden; naar men zegt zijn.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reputation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>heet</w> dat de regering binnenkort nieuwe maatregelen aankondigt.",
                            "target_lang_translations": {
                                "ru": "<w>Говорят</w>, что правительство скоро объявит о новых мерах.",
                                "en": "It <w>is said</w> that the government will announce new measures soon."
                            }
                        },
                        {
                            "text": "Hij <w>heet</w> een van de rijkste mensen van het dorp te zijn.",
                            "target_lang_translations": {
                                "ru": "Он <w>слывет</w> одним из самых богатых людей в деревне.",
                                "en": "He <w>is reputed</w> to be one of the richest people in the village."
                            }
                        }
                    ],
                    "common_phrases": [
                        "het heet dat"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formeel"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Считаться; иметь репутацию (по слухам).",
                        "en": "To be said to be; to have the reputation of being."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "слыть",
                                "target_lang_sense_clarification": "иметь репутацию"
                            },
                            {
                                "target_lang_word": "говориться",
                                "target_lang_sense_clarification": "утверждаться (безличн.)"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "be said to",
                                "target_lang_sense_clarification": "to be rumored to be"
                            },
                            {
                                "target_lang_word": "be reputed to",
                                "target_lang_sense_clarification": "to have the reputation of"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "99df1e5e-2882-3165-8db7-679c18953e90",
                    "sense_definition": "Heet maken; verwarmen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De smid <w>heette</w> het ijzer in het gloeiende vuur.",
                            "target_lang_translations": {
                                "ru": "Кузнец <w>раскалял</w> железо в пылающем огне.",
                                "en": "The blacksmith <w>heated</w> the iron in the glowing fire."
                            }
                        },
                        {
                            "text": "Men <w>heette</w> vroeger de stenen om het bed te verwarmen.",
                            "target_lang_translations": {
                                "ru": "Раньше <w>нагревали</w> камни, чтобы согреть постель.",
                                "en": "In the past, people <w>heated</w> stones to warm the bed."
                            }
                        }
                    ],
                    "synonyms": [
                        "verhitten",
                        "verwarmen",
                        "opwarmen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "gebruik 'verhitten' of 'verwarmen'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нагревать; раскалять (устаревшее).",
                        "en": "To make hot; to heat up (archaic)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раскалять",
                                "target_lang_sense_clarification": "делать горячим"
                            },
                            {
                                "target_lang_word": "нагревать",
                                "target_lang_sense_clarification": "повышать температуру"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "heat",
                                "target_lang_sense_clarification": "to make something hot"
                            },
                            {
                                "target_lang_word": "heat up",
                                "target_lang_sense_clarification": "to increase temperature"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}