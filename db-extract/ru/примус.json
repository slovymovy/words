                "senses": [
                    {
                        "sense_id": "1b1ea6fd-e75e-37cf-8ef5-10e06e4c5fcc",
                        "entry_id": "3630bc7b-0f9a-303f-9de3-822a74a955df",
                        "glosses": [
                            "Primus stove, Primus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c66c241-f44b-4734-a7b5-cbd22dcc1cce",
                                "sense_id": "1b1ea6fd-e75e-37cf-8ef5-10e06e4c5fcc",
                                "text": "Но кова́рный Бегемо́т, как из ша́йки в ба́не ока́тывают ла́вку, окати́л из при́муса конди́терский прила́вок бензи́ном, и он вспы́хнул сам собо́й.",
                                "translation": "But the perfidious Behemoth doused the confectionery counter with benzene from his primus, as one douses a bench in a bathhouse with a tub of water, and it blazed up of itself.",
                                "english": "But the perfidious Behemoth doused the confectionery counter with benzene from his primus, as one douses a bench in a bathhouse with a tub of water, and it blazed up of itself."
                            }
                        ]
                    }
                ],
