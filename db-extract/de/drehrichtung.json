                "senses": [
                    {
                        "sense_id": "43914594-1e9a-3f5f-b3c3-6b23eadb5eb8",
                        "entry_id": "8a648123-7d07-3037-8624-1296c52ac8b2",
                        "glosses": [
                            "Richtung, in die sich etwas dreht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "643765ee-9337-48f5-a044-fbd30bea81ed",
                                "sense_id": "43914594-1e9a-3f5f-b3c3-6b23eadb5eb8",
                                "text": "„Verschiedene Drehrichtungen scheinen Menschen jedenfalls mit unterschiedlichen Assoziationen zu verbinden, wie Würzburger Forscher in einer Reihe von Experimenten zeigen konnten.“"
                            },
                            {
                                "example_id": "1ac49e9e-e0ae-44a3-92d3-472107293176",
                                "sense_id": "43914594-1e9a-3f5f-b3c3-6b23eadb5eb8",
                                "text": "„Das Resultat unterscheidet sich je nach Drehrichtung und Temperatur der Wirbel: Sogenannte anti-zyklonische Wirbel, die auf der Südhemisphäre gegen den Uhrzeigersinn drehen und wärmeres Wasser haben, steigern die Windgeschwindigkeit an der Meeresoberfläche und die Wolkenbedeckung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
