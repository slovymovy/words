        "fr-extract.jsonl": [
            {
                "entry_id": "be28ee01-f921-3019-9127-f3e3db6cf1de",
                "word": "gratitude",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8a990063-ba0a-460c-8665-245fbfaa7f58",
                        "entry_id": "be28ee01-f921-3019-9127-f3e3db6cf1de",
                        "tags": [
                            "plural"
                        ],
                        "form": "gratitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ecbc610f-fd72-333d-9b90-101f20f8fc60",
                        "entry_id": "be28ee01-f921-3019-9127-f3e3db6cf1de",
                        "glosses": [
                            "Reconnaissance d’un bienfait, d’un service reçu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bbdcd095-cdc9-49ed-934b-94c934afd067",
                                "sense_id": "ecbc610f-fd72-333d-9b90-101f20f8fc60",
                                "text": "Ah ! Quel cri de reconnaissance, quelles exclamations de gratitude s’élevèrent de la poitrine du digne savant !"
                            },
                            {
                                "example_id": "4523ce86-8496-4e62-b2d9-070d11a22377",
                                "sense_id": "ecbc610f-fd72-333d-9b90-101f20f8fc60",
                                "text": "La Fédération Française à qui revient l'initiative de ce travail, les SS∴ Steen et Félix qui en ont rassemblé les éléments, ont fait œuvre pie et méritent à ce titre notre profonde gratitude."
                            },
                            {
                                "example_id": "5e7790e5-4417-4102-8997-23eef25e5c37",
                                "sense_id": "ecbc610f-fd72-333d-9b90-101f20f8fc60",
                                "text": "C'est en prenant conscience de l'enfant ingrat que j'ai été et que je suis encore parfois que je suis rempli de gratitude pour l'amour indéfectible de mes parents."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb8ce9a8-6ad0-47c0-805e-22d6b92d64fb",
                        "source_entry_id": "be28ee01-f921-3019-9127-f3e3db6cf1de",
                        "source_sense_id": "ecbc610f-fd72-333d-9b90-101f20f8fc60",
                        "target_lang_word": "Dankbarkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dankbarkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0c696d97-dd32-3692-b72a-0c4835d8dc7c",
                                        "entry_id": "6dea716d-04ba-3baf-8f08-d519dde79889",
                                        "glosses": [
                                            "Anerkennung für Wohlwollen, Hilfe, Unterstützung, die man erfahren hat."
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0406ea50-8176-4407-8675-7f0d00d37f76",
                                                "sense_id": "0c696d97-dd32-3692-b72a-0c4835d8dc7c",
                                                "text": "Mit diesem Blumenstrauß möchte ich meiner Dankbarkeit Ausdruck verleihen."
                                            },
                                            {
                                                "example_id": "961d7471-ddc0-46e7-93e2-97c7d2059bcd",
                                                "sense_id": "0c696d97-dd32-3692-b72a-0c4835d8dc7c",
                                                "text": "Es gab noch einen wortreichen Abschied mit viel Ermahnungen an Brita und Neckereien und Dankbarkeiten an Hendrik"
                                            },
                                            {
                                                "example_id": "5d1b517c-cbb3-41dc-8ab5-0a6e57e6ac49",
                                                "sense_id": "0c696d97-dd32-3692-b72a-0c4835d8dc7c",
                                                "text": "„An dieser Stelle überschwemmt mich in der Regel große Dankbarkeit der Welt gegenüber, die mich mit solch tollen Menschen zusammengeführt hat, und ich fange an, sie alle zu mir nach Brandenburg einzuladen.“"
                                            },
                                            {
                                                "example_id": "a5f43900-ee3f-4bc4-889a-0a68c27a27c1",
                                                "sense_id": "0c696d97-dd32-3692-b72a-0c4835d8dc7c",
                                                "text": "„Aber sie empfand nicht einmal Dankbarkeit für seine zarte Art.“"
                                            },
                                            {
                                                "example_id": "62bbb987-91f7-4a3d-94fe-5514bd3e311e",
                                                "sense_id": "0c696d97-dd32-3692-b72a-0c4835d8dc7c",
                                                "text": "„Ich gab ihm rasch zehn und hinderte ihn daran, mir unterwürfig seine Dankbarkeit zu beteuern; aber ich konnte ihn nicht daran hindern, Tränen zu vergießen.“"
                                            },
                                            {
                                                "example_id": "f47229fa-dfab-4846-af70-686151f3ce89",
                                                "sense_id": "0c696d97-dd32-3692-b72a-0c4835d8dc7c",
                                                "text": "„In jedem kraftvollen Pinselstrich war seine Dankbarkeit für ihre Unterstützung zu erkennen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "28e4e46f-e966-3377-ace4-0a7a235f818f",
                                        "entry_id": "6dea716d-04ba-3baf-8f08-d519dde79889",
                                        "glosses": [
                                            "Nützlichkeit, Vorteilhaftigkeit, Aussicht auf Lohn"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5e9252cf-1f5f-453a-9ef3-2d95f235fac9",
                                                "sense_id": "28e4e46f-e966-3377-ace4-0a7a235f818f",
                                                "text": "Nicht bei allen Berufen kann man sich der Dankbarkeit der damit verbundenen Aufgaben sicher sein."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7397f3cc-ffc5-3986-a129-c47d3561c8bd",
                                        "entry_id": "6dea716d-04ba-3baf-8f08-d519dde79889",
                                        "glosses": [
                                            "Haltbarkeit, Anspruchslosigkeit, Nützlichkeit auf lange Sicht"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d9c987b-00f3-4212-b718-ab42280294c6",
                                                "sense_id": "7397f3cc-ffc5-3986-a129-c47d3561c8bd",
                                                "text": "Die Dankbarkeit mancher Materialien erweist sich eben erst auf lange Sicht."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0d5273fd-a403-4e6c-9179-46f3091a0ef2",
                        "source_entry_id": "be28ee01-f921-3019-9127-f3e3db6cf1de",
