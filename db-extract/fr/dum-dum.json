                        "sense_id": "71a708bb-1826-361a-96f6-f063ebda50d1",
                        "entry_id": "614c9cb4-cf53-3353-a1a7-68cfc2b2fd43",
                        "glosses": [
                            "Ville de l’Inde, connue entre autres pour l’aéroport situé à proximité et desservant Calcutta."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "830ebe28-888b-4dd4-b425-65a1f727c419",
                                "sense_id": "71a708bb-1826-361a-96f6-f063ebda50d1",
                                "text": "C’est à huit heures du matin, le surlendemain, que Dave Robbins, William Stanley, Jack Miller et Muriel débarquèrent à l’aéroport de Dum-Dum."
                            },
                            {
                                "example_id": "1ee9de26-7ec7-4d68-ac1f-88d1ffca9ed0",
                                "sense_id": "71a708bb-1826-361a-96f6-f063ebda50d1",
                                "text": "Des délégués de l’Office de Tourisme sont à la disposition des voyageurs 24 heures sur 24 à l’Aéroport Dum-Dum, pour aider les touristes à passer la douane ou pour toutes autres formalités."
                            }
                        ]
                    }
                ],
