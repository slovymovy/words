                                        "entry_id": "bb25c156-be15-3578-87fa-79bd3b7cef50",
                                        "glosses": [
                                            "Dreary, cheerless."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
