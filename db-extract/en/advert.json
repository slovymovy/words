                                                "sense_id": "22c8c6a5-2780-3791-b7f4-275135df7286",
                                                "text": "De dokter verwees hem naar een longarts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0496fe64-cb23-35af-b235-9820835b76c8",
                                        "entry_id": "b4e784e5-70f3-3051-9529-8094a66b6610",
                                        "glosses": [
                                            "refereren aan iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a33cdc85-9efd-4923-ae0f-7272a61b08bf",
                                                "sense_id": "0496fe64-cb23-35af-b235-9820835b76c8",
                                                "text": "Mijn ochtendritueel begon al om 6 uur en ik probeerde voor 10 uur ’s ochtends al 16 kilometer te hebben gelopen (10 by 10, zoals ze dat in Amerika zeggen, verwijzend naar 10 miles voor 10 uur)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
