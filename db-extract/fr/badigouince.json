                        "glosses": [
                            "Variante orthographique de badigoince : lèvre, babine."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "0cce1ab4-dda7-43b3-9e67-068ad2bfb924",
                                "sense_id": "7a22c217-6aae-3349-b6b8-0c0fc49ec6ce",
                                "text": "Une bonne odeur de bisque se répand. Les narines se dilatent, on se lèche les badigouinces."
                            },
                            {
                                "example_id": "24a3e6d5-fc0c-4ecd-9a0e-9f196d7049ac",
                                "sense_id": "7a22c217-6aae-3349-b6b8-0c0fc49ec6ce",
                                "text": "Comme les députés, les toubibs et les taxis, il se pourléchait les badigouinces, espérant que le tarif serait double de nuit."
                            },
                            {
                                "example_id": "bf5a7daa-f88f-40ea-b9df-be8bca0019c1",
                                "sense_id": "7a22c217-6aae-3349-b6b8-0c0fc49ec6ce",
                                "text": "Pour l’instant, à la salle à manger du tripot, il se rambine la tension au contre-filet froid mayonnaise, et lui trouve, marié à une laitue tendre, finement assaisonnée, une saveur incomparable, vraie bénédiction pour les badigouinces."
                            }
                        ]
                    }
