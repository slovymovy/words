{
    "word_family": [
        "moper",
        "mopish",
        "mopishness",
        "mopy"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "681af23b-2a20-3eb2-8a3b-1cd65ec41e45",
                    "sense_definition": "To wander around or spend time in a gloomy, depressed, or listless manner.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mope_sulking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Instead of trying to fix the problem, he chose to <w>mope</w> around his bedroom all afternoon.",
                            "target_lang_translations": {
                                "pl": "Zamiast spróbować rozwiązać problem, wolał przez całe popołudnie <w>snuć się smętnie</w> po sypialni."
                            }
                        },
                        {
                            "text": "She warned her brother not to sit and <w>mope</w> over losing the competition.",
                            "target_lang_translations": {
                                "pl": "Ostrzegła brata, żeby nie siedział i nie <w>użalał się nad sobą</w> z powodu przegranej w zawodach."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mope around",
                        "mope about",
                        "sit and mope"
                    ],
                    "target_lang_definitions": {
                        "pl": "Włóczyć się bez celu lub spędzać czas w przygnębieniu, apatii i ponurym nastroju; snuć się smętnie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "snuć się",
                                "target_lang_sense_clarification": "chodzić bez celu w przygnębieniu"
                            },
                            {
                                "target_lang_word": "dumać",
                                "target_lang_sense_clarification": "pogróżać się w ponurych myślach"
                            },
                            {
                                "target_lang_word": "rozczulać się nad sobą",
                                "target_lang_sense_clarification": "uciekać w użalanie się nad sobą"
                            },
                            {
                                "target_lang_word": "boczyć się",
                                "target_lang_sense_clarification": "dąsać się lub smucić"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5e6d108d-5d64-39a3-bf6b-5085435fcd22",
                    "sense_definition": "To make someone dull, spiritless, or dazed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The long weeks of solitary isolation began to <w>mope</w> his active mind.",
                            "target_lang_translations": {
                                "pl": "Długie tygodnie samotnej izolacji zaczęły <w>otępiać</w> jego bystry umysł."
                            }
                        },
                        {
                            "text": "Fever and fatigue seemed to <w>mope</w> the patient into prolonged silence.",
                            "target_lang_translations": {
                                "pl": "Gorączka i zmęczenie zdawały się <w>wpędzać</w> pacjenta w stan otępienia i przedłużającego się milczenia."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wprowadzać kogoś w stan otępienia, apatii lub przygnębienia (znaczenie archaiczne)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "otępiać",
                                "target_lang_sense_clarification": "pozbawiać energii lub bystrości"
                            },
                            {
                                "target_lang_word": "przygnębiać",
                                "target_lang_sense_clarification": "wprowadzać w stan apatii"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2d03ba78-4db0-3777-89ee-5db35a5c07c6",
                    "sense_definition": "A period or act of brooding or sulking.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mope_sulking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Whenever he feels overwhelmed, he has a quiet <w>mope</w> before returning to work.",
                            "target_lang_translations": {
                                "pl": "Ilekroć czuje się przytłoczony, pozwala sobie na chwilę <w>chandry</w> w ciszy, zanim wróci do pracy."
                            }
                        },
                        {
                            "text": "After a brief <w>mope</w> in the garden, she cheered up and rejoined her guests.",
                            "target_lang_translations": {
                                "pl": "Po krótkiej chwili <w>dąsania się</w> w ogrodzie rozchmurzyła się i wróciła do gości."
                            }
                        }
                    ],
                    "common_phrases": [
                        "have a mope",
                        "little mope"
                    ],
                    "target_lang_definitions": {
                        "pl": "Chwila lub stan dąsania się, ponurego nastroju lub użalania się nad sobą."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "chandra",
                                "target_lang_sense_clarification": "krótki stan przygnębienia"
                            },
                            {
                                "target_lang_word": "dąsy",
                                "target_lang_sense_clarification": "okres boczenia się lub dąsania"
                            },
                            {
                                "target_lang_word": "atak chandry",
                                "target_lang_sense_clarification": "chwilowy spadek nastroju"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b81a4b1a-61dd-393d-828a-24e0056a73e7",
                    "sense_definition": "A gloomy, listless, or dull person.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mope_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "No one wanted to invite such a dreary <w>mope</w> to the weekend party.",
                            "target_lang_translations": {
                                "pl": "Nikt nie chciał zapraszać takiego ponurego <w>smutasa</w> na weekendową imprezę."
                            }
                        },
                        {
                            "text": "He acted like a miserable <w>mope</w> during the entire family vacation.",
                            "target_lang_translations": {
                                "pl": "Podczas całych rodzinnych wakacji zachowywał się jak nieznośny <w>ponurak</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "mopus"
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba ponura, marudna, bez energii życiowej."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "ponurak",
                                "target_lang_sense_clarification": "człowiek ponury i posępny"
                            },
                            {
                                "target_lang_word": "maruda",
                                "target_lang_sense_clarification": "osoba wiecznie niezadowolona"
                            },
                            {
                                "target_lang_word": "smutas",
                                "target_lang_sense_clarification": "osoba wiecznie smutna"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e188859-8e00-3d8f-b069-9b5849a231ed",
                    "sense_definition": "A low-level hanger-on in the adult film industry who works minor roles for nominal pay.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mope_person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He began his career as an unpaid <w>mope</w> working long shifts around the studio.",
                            "target_lang_translations": {
                                "pl": "Rozpoczął karierę jako darmowe <w>popychadło</w>, pracując na długich zmianach w studiu."
                            }
                        },
                        {
                            "text": "The article described the difficult realities facing every studio <w>mope</w> in town.",
                            "target_lang_translations": {
                                "pl": "Artykuł opisywał trudne realia, z którymi mierzy się każdy podrzędny <w>statysta za grosze</w> w tym mieście."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba z dołów hierarchii branży filmów dla dorosłych, wykonująca drobne prace lub role za symboliczne wynagrodzenie."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "popychadło",
                                "target_lang_sense_clarification": "podrzędny pracownik na posyłki"
                            },
                            {
                                "target_lang_word": "statysta za grosze",
                                "target_lang_sense_clarification": "podrzędna rola za minimalną stawkę"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}