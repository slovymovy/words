                                    },
                                    {
                                        "sense_id": "4540df1f-d6a2-3483-83f8-96745105dc3f",
                                        "entry_id": "d3b43a89-7307-3f06-a920-85eb5ad32d28",
                                        "glosses": [
                                            "A misspelled word."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99e9b632-2b21-4234-b9df-69319521ba8a",
                                                "sense_id": "4540df1f-d6a2-3483-83f8-96745105dc3f",
                                                "text": "Accomodation is a common misspelling of accommodation."
                                            },
                                            {
                                                "example_id": "9df0a019-d5e6-428b-967a-e7ae07f63152",
                                                "sense_id": "4540df1f-d6a2-3483-83f8-96745105dc3f",
                                                "text": "My own Chinese name might conceivably be written in no fewer than four different ways in Unicode: 井作恆, 井作恒, 丼作恆, and 丼作恒. I would personally consider all but the first misspellings, just as I would the spelling of my English name as Jon Jenkins or John Jenkyns."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "misspelling",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6403b446-007a-3023-a804-6cd6f4b7c4a2",
                                        "entry_id": "467f16e5-cb15-354a-a69d-8bcb75d99dfe",
                                        "glosses": [
                                            "present participle and gerund of misspell"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
