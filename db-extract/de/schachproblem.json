                        "source_sense_id": "56aaf358-9843-32de-afc4-f0780cdfcc25",
                        "source_sense_description": "ausgedachte Aufgabe, die das Herbeiführen des Matts in einer vorgeschriebenen Anzahl von Zügen fordert",
                        "target_lang_word": "schaakprobleem",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schaakprobleem",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2747cbf9-9a8c-39f0-b93c-7c8222db4687",
                                        "entry_id": "1ba64599-ad85-3891-8420-006f7c0ecc07",
                                        "glosses": [
                                            "een (gecomponeerd) schaakvraagstuk"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed499792-9477-41a0-a389-5d7573598818",
                                                "sense_id": "2747cbf9-9a8c-39f0-b93c-7c8222db4687",
                                                "text": "Rond 1920 raakte Duchamp zo gefascineerd door het spel dat hij zijn artistieke carrière verwaarloosde om zich geheel aan de schaakstudie te wijden. Het verhaal gaat dat hij tijdens de wittebroodsweken van zijn huwelijk met de schrijfster Lydie Sarazin-Lavassor in 1927 dagelijks de schaakclub in Nice bezocht en na thuiskomst meer belangstelling had voor schaakproblemen dan voor zijn echtgenote. Het huwelijk strandde na enkele maanden."
                                            },
                                            {
                                                "example_id": "de16643e-0f01-426b-ae34-63e2717f55d0",
                                                "sense_id": "2747cbf9-9a8c-39f0-b93c-7c8222db4687",
                                                "text": "En het aardige is dat het thuis ook gewoon werkt. Wat weer niet geldt, althans nog niet bij mij, voor het recente plaatwerk van Autechre. Het duo is met de jaren steeds abstractere muziek gaan maken. De kluwen beats die zij als een schaakprobleem in hun muziek stoppen zijn nauwelijks te ontwarren, en een melodielijn is er al helemaal niet meer bij hen te bespeuren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
