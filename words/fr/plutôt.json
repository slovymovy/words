    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "a700881a-e4e9-3368-b565-87ca309f9e12",
                    "sense_definition": "Indique la préférence d'une option par rapport à une autre ; de préférence.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "preference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je préfère marcher <w>plutôt</w> que de prendre le bus ce matin."
                        },
                        {
                            "text": "Nous avons décidé de commander une pizza <w>plutôt</w> que de cuisiner ce soir."
                        }
                    ],
                    "common_phrases": [
                        "plutôt que"
                    ]
                },
                {
                    "sense_id": "a662f7e8-2df9-3416-981e-54d834b07be9",
                    "sense_definition": "Indique un degré modéré ou une approximation ; assez, relativement.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "degre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce nouvel appartement est <w>plutôt</w> agréable et lumineux malgré son prix abordable."
                        },
                        {
                            "text": "Le film d'hier soir était <w>plutôt</w> intéressant, même si la fin était prévisible."
                        }
                    ],
                    "common_phrases": [
                        "plutôt bien",
                        "plutôt bon",
                        "plutôt sympa"
                    ]
                },
                {
                    "sense_id": "3a716817-7afe-3407-aa74-4cd43ae37ef5",
                    "sense_definition": "Sert à rectifier une affirmation ou à apporter une formulation plus exacte ; plus précisément.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "rectification",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il arrivera vers dix-huit heures, ou <w>plutôt</w> dix-neuf heures selon la circulation."
                        },
                        {
                            "text": "C'est un collègue de bureau, ou <w>plutôt</w> un ami d'enfance maintenant."
                        }
                    ],
                    "common_phrases": [
                        "ou plutôt"
                    ]
                },
                {
                    "sense_id": "7ae2404e-05c6-339e-a14e-ec2c75b7ce67",
                    "sense_definition": "Exprime une approbation enthousiaste ou une vive confirmation ; tout à fait, assurément.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "affirmation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "— Tu viens à la fête avec nous ? — <w>Plutôt</w> ! Je ne raterais ça pour rien au monde."
                        },
                        {
                            "text": "Si tu me demandes si j'ai faim, <w>plutôt</w> deux fois qu'une après cette longue journée."
                        }
                    ],
                    "common_phrases": [
                        "plutôt deux fois qu'une"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier en réponse exclamative"
                        }
                    ]
                },
                {
                    "sense_id": "799a4421-f07d-3f47-afcd-1dc195055e8e",
                    "sense_definition": "À un moment antérieur dans le temps ; plus tôt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "temps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il espérait partir au <w>plutôt</w> afin d'éviter la nuit tombante sur la route."
                        },
                        {
                            "text": "Le voyageur souhaitait arriver le <w>plutôt</w> possible pour trouver une chambre libre."
                        }
                    ],
                    "synonyms": [
                        "plus tôt"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "orthographe vieillie pour plus tôt"
                        }
                    ]
                }
            ]
        }
    ]
