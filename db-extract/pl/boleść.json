                "translations": [
                    {
                        "translation_id": "7928442c-5d8a-45a4-8c37-4a592e2b3761",
                        "source_entry_id": "17915fde-65bd-327f-956a-e30a9cc00464",
                        "source_sense_id": "7cb8e58d-ff4b-3e67-ac3c-17f22ab3fd99",
                        "target_lang_word": "dolor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dolor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23ed8adc-d3b2-3d76-8c65-5d7d393de1f8",
                                        "entry_id": "151ab537-4df2-35fa-b9e4-4ce3d3633dcc",
                                        "glosses": [
                                            "Alternative spelling of dolour."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of",
                                            "alternative",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e91cd0-a2a5-4fee-b1a6-5f2a6e090c53",
                                                "sense_id": "23ed8adc-d3b2-3d76-8c65-5d7d393de1f8",
                                                "text": "Who dyes the vtmoſt dolor doth abye, / But who that liues, is lefte to waile his loſſe: / So life is loſſe, and death felicity."
                                            },
                                            {
                                                "example_id": "441b9776-94fb-4e91-a5be-7dff3945815f",
                                                "sense_id": "23ed8adc-d3b2-3d76-8c65-5d7d393de1f8",
                                                "text": "But for all this thou ſhalt haue as many Dolors for thy Daughters, as thou canſt tell in a yeare."
                                            },
                                            {
                                                "example_id": "f6740649-b4ce-4e70-9dde-9b13b8555b00",
                                                "sense_id": "23ed8adc-d3b2-3d76-8c65-5d7d393de1f8",
                                                "text": "Supposedly, utilitarians are able to add and subtract hedons (units of pleasure) and dolors (units of pain) without any signs of cognitive or affective distress […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc349fb1-190e-4a6a-ac36-7bfa9b2651ff",
                        "source_entry_id": "17915fde-65bd-327f-956a-e30a9cc00464",
                        "source_sense_id": "7cb8e58d-ff4b-3e67-ac3c-17f22ab3fd99",
                        "target_lang_word": "dolor",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dolor",
