                        "glosses": [
                            "een ruimte waarvan de temperatuur verhoogd wordt, zodat het lichaam begint te zweten (een zweetbad)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea8cd54f-a161-4803-b339-b4352301f4c8",
                                "sense_id": "68e8c08b-4fe3-3b58-88f4-a74f424b6c8d",
                                "text": "Zorg ervoor genoeg water te drinken als je een sauna neemt."
