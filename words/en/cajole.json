{
    "word_family": [
        "cajolement",
        "cajoler",
        "cajolery"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "10edc3ea-8605-3c7f-82c9-967d7686c8d8",
                    "sense_definition": "To persuade someone to do something which they are reluctant to do, especially by flattery or promises.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed to <w>cajole</w> his friend into lending him the car for the weekend.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>уломать</w> друга одолжить машину на выходные."
                            }
                        },
                        {
                            "text": "The manager tried to <w>cajole</w> the committee into approving the controversial budget.",
                            "target_lang_translations": {
                                "ru": "Менеджер попытался <w>улестить</w> комитет, чтобы тот одобрил спорный бюджет."
                            }
                        }
                    ],
                    "synonyms": [
                        "butter up",
                        "coax",
                        "inveigle",
                        "sweet-talk",
                        "wheedle"
                    ],
                    "common_phrases": [
                        "cajole into",
                        "try to cajole"
                    ],
                    "target_lang_definitions": {
                        "ru": "Уговаривать или склонять кого-либо к действию с помощью лести, ласки или обещаний."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улещивать",
                                "target_lang_sense_clarification": "склонять лестью или уговорами"
                            },
                            {
                                "target_lang_word": "умасливать",
                                "target_lang_sense_clarification": "задабривать, льстить ради выгоды"
                            },
                            {
                                "target_lang_word": "заговаривать зубы",
                                "target_lang_sense_clarification": "убалтывать, уговаривать уловками"
                            },
                            {
                                "target_lang_word": "улещать",
                                "target_lang_sense_clarification": "устаревшая форма от «улещивать»"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e27d99d-fa05-3ffa-b345-dd47379cd115",
                    "sense_definition": "An act of flattery or coaxing intended to persuade someone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "No amount of gentle <w>cajole</w> could change his stubborn refusal to cooperate.",
                            "target_lang_translations": {
                                "ru": "Никакие мягкие <w>уговоры</w> не могли сломить его упрямый отказ сотрудничать."
                            }
                        },
                        {
                            "text": "Her charming <w>cajoles</w> were completely ineffective against the strict guard.",
                            "target_lang_translations": {
                                "ru": "Её очаровательные <w>заискивания</w> оказались совершенно бессильны против строгого охранника."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Проявление лести, заискивания или уговоров с целью убедить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лесть",
                                "target_lang_sense_clarification": "угодливое восхваление ради убеждения"
                            },
                            {
                                "target_lang_word": "улещивание",
                                "target_lang_sense_clarification": "попытка уговорить лестью"
                            },
                            {
                                "target_lang_word": "заискивание",
                                "target_lang_sense_clarification": "попытка подольститься"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}