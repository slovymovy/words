                    {
                        "sense_id": "7145b2d3-3fd2-3c6e-83c7-26f4adebbd73",
                        "entry_id": "5322fb4d-2956-3082-a0b1-7eb47109349a",
                        "glosses": [
                            "Variante de DRAC, direction régionale des Affaires culturelles."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "286eb6d4-2ee5-4ef0-82de-e68ed4b954d7",
                                "sense_id": "7145b2d3-3fd2-3c6e-83c7-26f4adebbd73",
                                "text": "« La fouille a été autorisée et financée par le service régional de l’archéologie de la Drac de Poitiers », précise Frédéric Surmely, conservateur du patrimoine en Auvergne - Rhône-Alpes… mais originaire de Saintes."
                            },
                            {
                                "example_id": "50ad5def-0d9d-442c-a96f-1cb41c5b0bfd",
                                "sense_id": "7145b2d3-3fd2-3c6e-83c7-26f4adebbd73",
                                "text": "Le film qui dure 30 mn offre un panorama des principales missions de la Drac."
                            },
                            {
                                "example_id": "e7cad46d-cc48-424b-aa72-f7209f483ada",
                                "sense_id": "7145b2d3-3fd2-3c6e-83c7-26f4adebbd73",
                                "text": "La Drac et la municipalité assurent que la procédure a été suivie dans les règles mais font face à de vives critiques."
                            }
                        ]
                    }
                ],
