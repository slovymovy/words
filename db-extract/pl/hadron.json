                "senses": [
                    {
                        "sense_id": "d2134acc-3422-36ff-a6fa-59cbea73975a",
                        "entry_id": "047666d9-dd33-31e3-a6cc-b00c37937706",
                        "glosses": [
                            "silnie oddziałująca cząstka złożona z kwarków"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e453c255-7c91-454d-a970-8939e5c64d46",
                                "sense_id": "d2134acc-3422-36ff-a6fa-59cbea73975a",
                                "text": "Przykładem hadronu jest proton i neutron"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "325f945e-c99e-4f56-b34f-920e9dca2955",
                        "source_entry_id": "047666d9-dd33-31e3-a6cc-b00c37937706",
                        "source_sense_id": "d2134acc-3422-36ff-a6fa-59cbea73975a",
                        "target_lang_word": "hadron",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hadron",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8dc8d811-dddc-326d-b771-8d757bc6d63d",
                                        "entry_id": "148bb643-d7dd-3062-bf14-124e15e35301",
                                        "glosses": [
                                            "A composite particle that comprises two or more quarks held together by the strong force and (consequently) can interact with other particles via said force; a meson or a baryon."
                                        ],
                                        "tags": [
                                            "particle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6f8488-b7e6-42f1-985f-551596ef27b9",
                                                "sense_id": "8dc8d811-dddc-326d-b771-8d757bc6d63d",
                                                "text": "The weak decays of b hadrons are dominated by the spectator model process whereby the b quark decays to a c quark (or occasionally a u quark) with the emission of an external W, while the non-b antiquark or diquark acts simply as a passive spectator to the decay."
                                            },
                                            {
                                                "example_id": "3e278d13-660b-4c6a-a40e-7caf13de051c",
                                                "sense_id": "8dc8d811-dddc-326d-b771-8d757bc6d63d",
                                                "text": "One can use the lattice simulations, which do represent the rigorous consequences of non-perturbative QCD, as guidance for models of hadron structure."
                                            },
                                            {
                                                "example_id": "d5a7769d-826f-44ed-9435-cb55eda075d3",
                                                "sense_id": "8dc8d811-dddc-326d-b771-8d757bc6d63d",
                                                "text": "And hence colour, which was initially an ad hoc concept, later turned out to be an empirically confirmed reality of hadrons."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "528ffbb0-883e-4fa0-81a3-ba92dd163202",
                        "source_entry_id": "047666d9-dd33-31e3-a6cc-b00c37937706",
                        "source_sense_id": "d2134acc-3422-36ff-a6fa-59cbea73975a",
                        "target_lang_word": "hadron",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hadron",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "729af313-2397-3528-a035-9cfe9f33562d",
                                        "entry_id": "fe350523-0d00-358a-8c7a-985919b86f7e",
                                        "glosses": [
                                            "subatomární částice, která reaguje na silnou interakci"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6d145da-28c1-4304-8b4d-39c880ddb33d",
                                                "sense_id": "729af313-2397-3528-a035-9cfe9f33562d",
                                                "text": "Vědci z experimentu LHCb v CERNu představili objev nové částice Tcc+. Jedná se o tetrakvark – exotický hadron obsahující dva kvarky a dva antikvarky."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4475d56b-2d12-4d94-b30c-59fee0cb2595",
                        "source_entry_id": "047666d9-dd33-31e3-a6cc-b00c37937706",
                        "source_sense_id": "d2134acc-3422-36ff-a6fa-59cbea73975a",
                        "target_lang_word": "hadrón",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hadrón",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "776a438f-529e-3d0c-ad6d-6c4808c450f9",
                                        "entry_id": "01546518-c640-3b24-bfc1-5db71ffb04e1",
                                        "glosses": [
                                            "Familia de partículas subatómicas que son afectadas por la interacción fuerte. Están compuestas por quarks unidos con gluones. Ejemplos de hadrones: neutrón y protón."
                                        ],
                                        "tags": [
                                            "Física"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c7cacd5-38cf-4073-aa4a-941b2fd369ac",
                        "source_entry_id": "047666d9-dd33-31e3-a6cc-b00c37937706",
                        "source_sense_id": "d2134acc-3422-36ff-a6fa-59cbea73975a",
                        "target_lang_word": "Hadron",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hadron",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                                        "entry_id": "93da8eb0-8a27-32b1-a403-a90cdd9de831",
                                        "glosses": [
                                            "Bezeichnung für alle Teilchen, die aus Quarks bestehen"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62fd6c7e-2524-4ab2-bdca-172e6bd8e7d8",
                                                "sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                                                "text": "Hadronen unterliegen der starken Wechselwirkung."
                                            },
                                            {
                                                "example_id": "c54868da-7819-480f-9d20-bcc576a5b284",
                                                "sense_id": "08795211-aac5-3340-a8b2-0779258ab5a3",
                                                "text": "„Der künftige Teilchenbeschleuniger ist als Nachfolger des LHC gedacht und soll es ermöglichen, Hadronen (etwa Protonen) mit einer Energie von bis zu 100 TeV (Tera-Elektronenvolt) kollidieren zu lassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44ee855e-fb2e-4633-a29c-d75d28b3ac97",
