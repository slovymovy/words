                    {
                        "translation_id": "84b78f73-5a5b-4914-bbe3-639cfec42f57",
                        "source_entry_id": "8af0c9f8-82a3-3de7-8f23-415291401686",
                        "source_sense_id": "9c113907-d9e3-3c57-93b0-ba840c3a2eaf",
