                "senses": [
                    {
                        "sense_id": "51067446-d851-3443-b9f8-64646f346dfc",
                        "entry_id": "377efcd3-a88a-3117-9e74-4277140da73c",
                        "glosses": [
                            "Teil der Messe, der sich um die Verkündigung des Wortes Gottes dreht und der der Eucharistiefeier vorausgeht"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "82ce2fe2-a44c-44f4-b56a-24170d5cf26c",
                                "sense_id": "51067446-d851-3443-b9f8-64646f346dfc",
                                "text": "„Der Wortgottesdienst im Rahmen der Messfeier ist Feier der Gegenwart des Herrn in seinem Wort.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "941f3ba8-a729-37b5-ad4e-8b476c4fd80a",
                        "entry_id": "377efcd3-a88a-3117-9e74-4277140da73c",
                        "glosses": [
                            "eigenständiger Gottesdienst zur Verkündigung des Wortes Gottes ohne Eucharistiefeier"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "9ea978d2-1464-4fe3-8a33-3fc754475984",
                                "sense_id": "941f3ba8-a729-37b5-ad4e-8b476c4fd80a",
                                "text": "„Der Kongress wurde mit einem Wortgottesdienst in der Kirche St. Michael eröffnet, dem der neue Bischof von Hildesheim, Bischof Dr. Heiner Wilmer, vorstand.“"
                            },
                            {
                                "example_id": "d6ce5c9c-d386-4bd0-aaa9-23dd137470c3",
                                "sense_id": "941f3ba8-a729-37b5-ad4e-8b476c4fd80a",
                                "text": "„Wortgottesdienste mit Kommunionfeiern, die von Pastoralreferentinnen gehalten wurden, kannte ich bereits, ebenso hatte ich selbst organisierte Gottesdienste in Familien mit und ohne Priester kennengelernt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
