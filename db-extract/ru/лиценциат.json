                                        "sense_id": "5709164a-c864-3b74-9ec9-50f5db6452fc",
                                        "entry_id": "b8aa43f5-fd27-3026-982b-d0e73778ad8f",
                                        "glosses": [
                                            "Personne qui, dans les facultés de lettres, de sciences, de droit, a obtenu son diplôme de licence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4601a8f3-d6f8-4f19-8fc4-d8ac91a8775c",
                                                "sense_id": "5709164a-c864-3b74-9ec9-50f5db6452fc",
                                                "text": "Un licencié ès lettres."
                                            },
                                            {
                                                "example_id": "548026df-2858-4288-9391-6c0818ff38de",
                                                "sense_id": "5709164a-c864-3b74-9ec9-50f5db6452fc",
                                                "text": "C’est cela qu’on m’a donné à faire comme entrée de jeu, et malgré mon titre de licencié ès lettres dont je crois bien que je me vantai pour la première fois."
                                            },
                                            {
                                                "example_id": "ce546b9e-c9d9-4434-9db2-865c7bd4ee7a",
                                                "sense_id": "5709164a-c864-3b74-9ec9-50f5db6452fc",
                                                "text": "Un licencié en droit."
                                            },
                                            {
                                                "example_id": "12317e45-a667-4b5b-b414-2d539a96e613",
                                                "sense_id": "5709164a-c864-3b74-9ec9-50f5db6452fc",
                                                "text": "Par exemple, l’emploi de rédacteur dans une préfecture est très souvent tenu par un licencié en droit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b156681a-bca6-32f8-b490-d167a4fe2a40",
                                        "entry_id": "b8aa43f5-fd27-3026-982b-d0e73778ad8f",
                                        "glosses": [
                                            "Personne détentrice d’une permission spéciale (licence) pour exercer un métier, un droit, ou un sport dans un cadre officiel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9ce262c-5ebd-45ef-8a76-2a869db0d7d4",
                                                "sense_id": "b156681a-bca6-32f8-b490-d167a4fe2a40",
                                                "text": "Un licencié du port d’armes."
                                            },
                                            {
                                                "example_id": "4ecb6cfb-487b-47a9-869d-6bb98453628c",
                                                "sense_id": "b156681a-bca6-32f8-b490-d167a4fe2a40",
                                                "text": "Un licencié de la fédération de tennis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6deaca9e-e69f-3d0a-a73c-e76009e35db8",
                                        "entry_id": "b8aa43f5-fd27-3026-982b-d0e73778ad8f",
                                        "glosses": [
                                            "Détenteur d’une permission de vendre des boissons alcoolisées."
                                        ],
