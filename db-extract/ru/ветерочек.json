                        "examples": [
                            {
                                "example_id": "6ce2194e-129e-493c-bc50-8f3e53271d45",
                                "sense_id": "7b6f9495-0e56-344d-8261-c5ed4b9f9463",
                                "text": "Как вешний ветерочек, / Летит она в лесочек; / Он гонится за ней."
                            },
                            {
                                "example_id": "5732886b-a200-452f-9836-531926da9e06",
                                "sense_id": "7b6f9495-0e56-344d-8261-c5ed4b9f9463",
                                "text": "Жара не унималась, последние соки полей струйками утекали вверх, и хоть бы ветерком дохнуло навстречу, но нет, не оставалось ветерочка во всей русской земле!"
                            }
                        ]
                    }
