                "senses": [
                    {
                        "sense_id": "d19a402e-73f5-339c-83e3-ade16c6b9c49",
                        "entry_id": "8a5ba333-78fd-3015-b469-6f3e4efe510b",
                        "glosses": [
                            "to sit down (comfortably), to take a seat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d3b5a7d-a945-41ab-84b7-8dbaa7d2cfd4",
                                "sense_id": "d19a402e-73f5-339c-83e3-ade16c6b9c49",
                                "text": "Она́ сама́ разлива́ла чай из прекра́сного сере́бряного самова́ра, о́коло кото́рого мы и усе́лись: я, князь и ещё како́й-то о́чень великосве́тский господи́н пожилы́х лет и со звездо́й, не́сколько накрахма́ленный, с дипломати́ческими приёмами.",
                                "translation": "She made tea herself from a handsome silver samovar, round which we all sat, the prince, and I and another gentleman, elderly and extremely aristocratic wearing a star on his breast, somewhat starchy and diplomatic in his manners.",
                                "english": "She made tea herself from a handsome silver samovar, round which we all sat, the prince, and I and another gentleman, elderly and extremely aristocratic wearing a star on his breast, somewhat starchy and diplomatic in his manners."
                            }
                        ]
                    }
                ],
