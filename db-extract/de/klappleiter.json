                "senses": [
                    {
                        "sense_id": "0a1fd786-b7d3-3e53-8186-184f14996622",
                        "entry_id": "50e4a451-4430-336a-b2f2-ed4a6b8473d4",
                        "glosses": [
                            "Leiter, die für den einfacheren Transport zusammengeklappt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8dde606-f09f-4e6a-bb4c-063b5660d21d",
                                "sense_id": "0a1fd786-b7d3-3e53-8186-184f14996622",
                                "text": "„Zum Vorschein kommt ein einladendes Zuhause mit weicher Matratze, moskitogeschütztem Fenster, Gepäcknetz und Lampe. Auch eine kleine Klappleiter ist vorhanden.“"
                            },
                            {
                                "example_id": "db66357a-515d-483a-9085-13a2023fa112",
                                "sense_id": "0a1fd786-b7d3-3e53-8186-184f14996622",
                                "text": "„Die Erkletterungen der Klappleiter, um durch eines der beiden Fensterlöcher hinaus in die fremde Ferne zu starren: Sie gleichen riskanten Besteigungen des Kilimanjaro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
