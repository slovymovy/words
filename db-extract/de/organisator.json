                "senses": [
                    {
                        "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                        "entry_id": "f77a91f1-57ca-39a7-a289-abab6d6a6b01",
                        "glosses": [
                            "Person, die Aktionen oder Abläufe vorbereitet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ed72bc2-fa47-4450-a07c-7f88ef0c7448",
                                "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                "text": "Die Organisatoren der Festspiele bekamen auch viel Applaus."
                            },
                            {
                                "example_id": "e19c65ee-9c59-4e6f-afcb-16feb47467d9",
                                "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                "text": "„Sie wurden die Organisatoren eines militanten tschechischen Nationalismus.“"
                            },
                            {
                                "example_id": "a305f471-1393-43b0-9da5-06f9a671c40b",
                                "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                "text": "Die Organisatoren des Etappenortes der DDR-Rundfahrt im Radsport haben Nordhausen weit über die Bezirksgrenzen bekannt gemacht."
                            },
                            {
                                "example_id": "0501ba7c-7e82-46fc-8eba-7be23ef3d754",
                                "sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
                                "text": "„Fallada ist ein penibler Organisator, aber selbst Hand anlegen kann er seines Herzfehlers wegen nicht; eine Lebensversicherungsgesellschaft hat einen Vertrag mit ihm kürzlich abgelehnt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47c9644e-3be6-450c-965a-a54e40bad8b9",
                        "source_entry_id": "f77a91f1-57ca-39a7-a289-abab6d6a6b01",
                        "source_sense_id": "7457748a-a500-367d-9498-f5b2f6f6a97c",
