                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6174c37-182d-457e-91a5-4af167061ee4",
                                "sense_id": "e696a689-4677-3910-90ea-f119f64ddbac",
                                "text": "„Die Behandlung des Peniskarzinoms erfolgt chirurgisch durch teilweise oder vollständige Penisamputation, Bestrahlung, Lasertherapie oder Zytostatika.“"
                            },
                            {
                                "example_id": "5f34b304-13a1-4547-9c1e-7d693b603905",
                                "sense_id": "e696a689-4677-3910-90ea-f119f64ddbac",
                                "text": "„Die Penisamputation stellt oft eine schwerwiegende psychische Belastung für den Patienten dar.“"
                            },
                            {
                                "example_id": "0331a01f-bece-403e-b746-2496656c7271",
                                "sense_id": "e696a689-4677-3910-90ea-f119f64ddbac",
                                "text": "„Auch wenn bei Penisamputationen versucht wird, den Penis wieder anzunähen, ist mit Funktionseinschränkungen zu rechnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
