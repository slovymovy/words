                "senses": [
                    {
                        "sense_id": "000ccd9e-2393-3325-8097-9d51fb6b02d7",
                        "entry_id": "7503ba89-b95b-3d68-837d-40f0fb8c89d7",
                        "glosses": [
                            "von fließenden Gewässern oder Wind transportierter Sand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07bebe7e-a4be-4bbd-916f-0f9c7a1961b8",
                                "sense_id": "000ccd9e-2393-3325-8097-9d51fb6b02d7",
                                "text": "Der Treibsand lagert sich an den langsam fließenden Flussstellen ab."
                            },
                            {
                                "example_id": "de8e6a3d-ab97-489b-afef-4c670c08b41c",
                                "sense_id": "000ccd9e-2393-3325-8097-9d51fb6b02d7",
                                "text": "„Vor dem Versicherungsbüro hatte sich so viel Treibsand angestaut, dass wir uns nur einer nach dem anderen und mit angehaltenem Atem durch die Tür zwängen konnten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "943eb140-9aa9-463f-a9d0-db30ae0319d5",
                        "source_entry_id": "7503ba89-b95b-3d68-837d-40f0fb8c89d7",
                        "source_sense_id": "000ccd9e-2393-3325-8097-9d51fb6b02d7",
                        "source_sense_description": "von fließenden Gewässern oder Wind transportierter Sand",
                        "target_lang_word": "quicksand",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quicksand",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b31d1854-198c-3abe-8d59-5c86a8760b05",
                                        "entry_id": "19ec6f9e-2cce-37f0-a83b-53a22f4c9fd1",
                                        "glosses": [
                                            "Wet sand that appears firm but in which things readily sink, often found near rivers or coasts."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b721cca9-ad74-4c5e-9cee-8a9e9e0b91db",
                                                "sense_id": "b31d1854-198c-3abe-8d59-5c86a8760b05",
                                                "text": "My feet were firmly lodged in the quicksand, and the more I struggled the more I sank into it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c65470cf-7404-32cc-8857-8387a50e8c6b",
                                        "entry_id": "19ec6f9e-2cce-37f0-a83b-53a22f4c9fd1",
                                        "glosses": [
                                            "Anything that metaphorically pulls one down or buries one; a treacherous, risky danger"
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b745828-db79-4a95-8983-b8dbe4f01516",
                                                "sense_id": "c65470cf-7404-32cc-8857-8387a50e8c6b",
                                                "text": "the quicksands of youth"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dfdf370-35ee-4ea0-8084-63ecd53934f1",
                        "source_entry_id": "7503ba89-b95b-3d68-837d-40f0fb8c89d7",
                        "source_sense_id": "000ccd9e-2393-3325-8097-9d51fb6b02d7",
                        "source_sense_description": "von fließenden Gewässern oder Wind transportierter Sand",
                        "target_lang_word": "sables mouvants",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sables mouvants",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ccf5ebef-d06a-33d8-9ae9-d71974fe7264",
                                        "entry_id": "c4c4d6c2-8752-3eea-b190-625fb6f4f7bf",
                                        "glosses": [
                                            "Zones de sol en apparence ferme mais dans lesquelles on s’enlise, parfois dangereusement, lorsqu’on s’y engage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03e5d9a7-cee6-4c19-8b72-5aa0e95b96c3",
                                                "sense_id": "ccf5ebef-d06a-33d8-9ae9-d71974fe7264",
                                                "text": "J’ai failli moi-même être englouti avec mon cheval par les sables mouvants du Tahaddart, entre Tanger et Azila, et j’ai manqué me noyer dans l’embouchure du Tensift."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c02484f9-fd80-36f3-9e77-2c04cc4bcaa3",
                                        "entry_id": "c4c4d6c2-8752-3eea-b190-625fb6f4f7bf",
                                        "glosses": [
                                            "Situation périlleuse où une action mal à propos peut envenimer les choses."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a15486e1-fb21-4ea0-8edc-2a1ee0bcdf05",
                                                "sense_id": "c02484f9-fd80-36f3-9e77-2c04cc4bcaa3",
                                                "text": "C’est ainsi que le gouvernement Legault, comme tous les autres d’ailleurs, se voit forcé d’affronter la tempête sur des sables mouvants."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
