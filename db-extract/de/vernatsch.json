                        "sense_id": "355d99f8-7d63-326f-a181-100fbf70d8fd",
                        "entry_id": "dd8473fc-0b70-3981-9b07-676e1abf341f",
                        "glosses": [
                            "a light red wine from South Tyrol"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "42c06883-6fe7-43cb-b9d6-eb67101863ec",
                                "sense_id": "355d99f8-7d63-326f-a181-100fbf70d8fd",
                                "text": "Heute gehören die Genossenschaften Südtirols zu den Zugpferden des dortigen Weinbaus, und der Vernatsch ist wieder das, was er sein soll: ein Wein, den man leicht gekühlt im Sommer trinkt und der hervorragend zu jeder Art von Jause passt."
                            }
                        ]
                    }
