                                "target_senses": [
                                    {
                                        "sense_id": "6b996e7a-a149-3805-8d4e-212d00b550ee",
                                        "entry_id": "7135dbe3-8240-3b10-a548-5dbc0631e77b",
                                        "glosses": [
                                            "The position of a person or team in a tournament or competition who draws no opponent in a particular round so advances to the next round unopposed, or is awarded points for a win in a league table; also the phantom opponent of such a person or team."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b8608968-d227-475c-b21a-136b94bf8baa",
                                                "sense_id": "6b996e7a-a149-3805-8d4e-212d00b550ee",
                                                "text": "Craig's Crew plays the bye next week."
                                            },
                                            {
                                                "example_id": "5d6b8f62-b73b-4928-a46c-b2cf42de470f",
                                                "sense_id": "6b996e7a-a149-3805-8d4e-212d00b550ee",
                                                "text": "The Patriots were in the unique situation of having to play 16 straight games, then have their bye in week 17, whether they needed it or not."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a53bb62-e546-3062-8868-77caea1e6ca3",
                                        "entry_id": "7135dbe3-8240-3b10-a548-5dbc0631e77b",
                                        "glosses": [
                                            "An extra scored when the batsmen take runs after the ball has passed the striker without hitting either the bat or the batsman."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "963b1ab3-e235-38a6-90fd-3777e1101b67",
                                        "entry_id": "7135dbe3-8240-3b10-a548-5dbc0631e77b",
                                        "glosses": [
                                            "A thing not directly aimed at; a secondary or subsidiary object, course, path, undertaking, issue, etc."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "15db02bd-9cdb-4128-abfc-d9d029af072c",
                                                "sense_id": "963b1ab3-e235-38a6-90fd-3777e1101b67",
                                                "text": "The Synod of Dort in some points condemneth, upon the by, even the discipline of the Church of England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81ec8941-2792-3c06-ad8c-d021c69acc87",
                                        "entry_id": "7135dbe3-8240-3b10-a548-5dbc0631e77b",
                                        "glosses": [
                                            "An unspecified way or place."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "53564472-06c8-43fe-b752-7d8fa37ab50a",
                                                "sense_id": "81ec8941-2792-3c06-ad8c-d021c69acc87",
                                                "text": "Frank Kennedy will shew you the penalties in the act, and ye ken yoursell they used to put their run goods into the auld Place of Ellangowan up bye there."
                                            },
                                            {
                                                "example_id": "7d29e4d5-d8b3-4d5e-a3b3-7fc2a0716681",
                                                "sense_id": "81ec8941-2792-3c06-ad8c-d021c69acc87",
                                                "text": "This was lattin at me, ye ken, for inveetin the coachman an' the gamekeeper up bye."
                                            },
                                            {
                                                "example_id": "64c3efa0-6d87-4a05-8db2-52824b452e4b",
                                                "sense_id": "81ec8941-2792-3c06-ad8c-d021c69acc87",
                                                "text": "No word of a new house-keeper down bye, Wull?"
                                            },
                                            {
                                                "example_id": "c6d67571-4410-46c8-9878-9cc780d0e48c",
                                                "sense_id": "81ec8941-2792-3c06-ad8c-d021c69acc87",
                                                "text": "There's a friend of yours up bye that would be blithe to see you—up the rig from the auld aik on the road to the Greenshiel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f14fb7a-d650-3f94-a56a-a9ccd14eeb2c",
                                        "entry_id": "7135dbe3-8240-3b10-a548-5dbc0631e77b",
                                        "glosses": [
                                            "A pass."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bye",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3992b689-f645-360c-ac3b-3aa58a3e6bd4",
                                        "entry_id": "6f899ed4-ec59-37a9-bb2b-17c9a48f9b3f",
                                        "glosses": [
                                            "Out of the way; remote."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fb2badc-4518-46b0-8d2d-f0bf133915d5",
                                                "sense_id": "3992b689-f645-360c-ac3b-3aa58a3e6bd4",
                                                "text": "At length having gained a very bye Alley, where he thought he might enter into a Conference unnoticed by any who knew him."
                                            },
                                            {
                                                "example_id": "ce723782-b2c6-4385-8909-6196d304af30",
                                                "sense_id": "3992b689-f645-360c-ac3b-3aa58a3e6bd4",
                                                "text": "I left Colchester at one o'clock, and had a very agreeable ride from thence to my Uncle's– It is a very bye road , I did not meet a carriage or horse all the way, which is I believe eleven or twelve miles, but however I turned this to good advantage, and availed myself of the rural ride and variegated prospects, which assisted me to meditate."
                                            },
                                            {
                                                "example_id": "6c8c2fce-e731-46b6-ac74-352fe74c9e56",
                                                "sense_id": "3992b689-f645-360c-ac3b-3aa58a3e6bd4",
                                                "text": "So riding towards Cheshunt in the same county, he put into a bye sort of a house, a little out of the road, in which, finding only a poor old woman bitterly weeping, and asking the reason of shedding those tears, she told him, that she was a poor widow and being somewhat indebted for rent to her landlord whe expected him every minute to come and seize what few goods she had, which would be her utter ruin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6aff50eb-321d-381a-bb86-c14bd62f312a",
                                        "entry_id": "6f899ed4-ec59-37a9-bb2b-17c9a48f9b3f",
                                        "glosses": [
                                            "Secondary; supplementary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97f30539-9da9-4cc9-b0a2-6990cef6300d",
                                                "sense_id": "6aff50eb-321d-381a-bb86-c14bd62f312a",
                                                "text": "But the two labourers of whom I am speaking had their allowances, lived on their fixed wages with the profits of their bye labour, one being pig-killer to the village, and, therefore, always busy from Michaelmas to Lady-day, at a shilling a pig, and the offal, on which his family subsisted, wit h the produce of their small curtilage, for half the year."
                                            },
                                            {
                                                "example_id": "6a1af433-7db9-45d6-808b-72ef92683203",
                                                "sense_id": "6aff50eb-321d-381a-bb86-c14bd62f312a",
                                                "text": "As we shall see presently the wife of a craftsman almost always worked as her husband's assistant in his trade, or if not, she often eked out the family income by some such bye industry as brewing and spinning; sometimes she even practised a separate trade as a femme sole."
                                            },
                                            {
                                                "example_id": "087960b1-bad8-41a3-95ab-8ff8b24fd433",
                                                "sense_id": "6aff50eb-321d-381a-bb86-c14bd62f312a",
                                                "text": "It is the custom in some provinces to pay only according to the basic crops produced, but in others the share is calculated out of the total produce of the farm, both bye and main products."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "bye",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce7d368-e61c-333b-a950-182ff23c505d",
                                        "entry_id": "aa995945-4345-35ac-a28a-67deeeedad88",
                                        "glosses": [
                                            "Goodbye."
                                        ],
