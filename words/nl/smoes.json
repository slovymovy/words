{
    "word_family": [
        "smoezen",
        "gesmoes"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "075df04b-c2a0-3a2b-a222-fcbb42e8beb6",
                    "sense_definition": "een onwaar of verzonnen verhaal om een fout te verbergen of ergens onderuit te komen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitvlucht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij verzon een flauwe <w>smoes</w> omdat hij zijn huiswerk niet op tijd af had.",
                            "target_lang_translations": {
                                "en": "He made up a weak <w>excuse</w> because he hadn't finished his homework on time."
                            }
                        },
                        {
                            "text": "Geloof hem niet, dat is gewoon een <w>smoes</w> om niet te hoeven helpen.",
                            "target_lang_translations": {
                                "en": "Don't believe him, that's just a <w>pretext</w> to avoid having to help."
                            }
                        }
                    ],
                    "synonyms": [
                        "excuus",
                        "uitvlucht",
                        "dekmantel",
                        "voorwendsel",
                        "verhaaltje"
                    ],
                    "common_phrases": [
                        "een flauwe smoes",
                        "een smoesje verzinnen"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak gebruikt in informele situaties"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A false or invented story used to hide a mistake or to get out of doing something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "excuse",
                                "target_lang_sense_clarification": "a reason given to justify a fault or offense"
                            },
                            {
                                "target_lang_word": "pretext",
                                "target_lang_sense_clarification": "a false reason given to conceal the real one"
                            },
                            {
                                "target_lang_word": "sob story",
                                "target_lang_sense_clarification": "a sentimental story used to get sympathy or an excuse"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2cb885f-c708-3162-a29f-d455c537ba82",
                    "sense_definition": "een kluit of stuk gedroogde turf",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "brandstof",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de oude kachel brandde nog een laatste <w>smoes</w> van de wintervoorraad.",
                            "target_lang_translations": {
                                "en": "In the old stove, one last <w>peat sod</w> from the winter supply was still burning."
                            }
                        },
                        {
                            "text": "De arbeider verzamelde de gedroogde <w>smoezen</w> op het veld.",
                            "target_lang_translations": {
                                "en": "The worker collected the dried <w>clods</w> of peat in the field."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in specifieke dialecten of historische context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A lump or piece of dried peat used as fuel."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "peat sod",
                                "target_lang_sense_clarification": "a piece of dried turf used for burning"
                            },
                            {
                                "target_lang_word": "clod",
                                "target_lang_sense_clarification": "a lump of earth or turf"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f2e7db7-f1b9-3ed7-bb47-98c36e4b769f",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>smoezen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>smoes</w> soms met mijn collega over de plannen voor het weekend.",
                            "target_lang_translations": {
                                "en": "I sometimes <w>whisper</w> with my colleague about the plans for the weekend."
                            }
                        },
                        {
                            "text": "Als ik zachtjes <w>smoes</w> in de klas, krijgt de leraar het niet door.",
                            "target_lang_translations": {
                                "en": "If I <w>whisper</w> quietly in class, the teacher doesn't notice."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoegde vorm van het werkwoord"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First person singular present tense of 'smoezen' (to whisper or chat secretly)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whisper",
                                "target_lang_sense_clarification": "to speak very softly"
                            },
                            {
                                "target_lang_word": "gossip",
                                "target_lang_sense_clarification": "to chat about others or secrets"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7b5fe7ee-a452-374e-b4a9-ccbce0fded4f",
                    "sense_definition": "gebiedende wijs van <w>smoezen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "werkwoordsvorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Smoes</w> niet zo hard, want iedereen kan horen wat je zegt!",
                            "target_lang_translations": {
                                "en": "Don't <w>whisper</w> so loudly, because everyone can hear what you're saying!"
                            }
                        },
                        {
                            "text": "Hé jij daar, <w>smoes</w> onmiddellijk over iets anders!",
                            "target_lang_translations": {
                                "en": "Hey you there, <w>mutter</w> about something else immediately!"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "gebiedende wijs"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative mood of 'smoezen' (to whisper or chat secretly)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "whisper",
                                "target_lang_sense_clarification": "command to speak softly"
                            },
                            {
                                "target_lang_word": "mutter",
                                "target_lang_sense_clarification": "command to speak in a low voice"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}