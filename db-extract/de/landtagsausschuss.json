                ],
                "senses": [
                    {
                        "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                        "entry_id": "d9fb5893-7df5-3e8a-bff8-2a81e81e19e6",
                        "glosses": [
                            "Gruppe von Personen aus einem Parlament der Länder (= den Parlamentariern eines Landtages), die Gesetze und Beschlüsse dieses Landesparlaments vorbereiten und Untersuchungen durchführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8519ef2b-a62c-46a2-a291-026cd37c06b8",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "[Schlagzeile:] „Landtagsausschuss will WestLB-Chef befragen“"
                            },
                            {
                                "example_id": "78bda6ac-6dfd-4216-b528-f5e771ef327c",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "„Alles läuft gut, befand der hessische Landtagsausschuss für Wissenschaft und Kunst bei seiner Reise zum documenta-14-Standort Athen.“"
                            },
                            {
                                "example_id": "06494c60-4b68-40ac-8a59-91ba672c01d8",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "„Der Grünen-Kinderarzt Fred Konrad leitet den rheinland-pfälzischen Landtagsausschuss für Kinder, Jugend und Familie.“"
                            },
                            {
                                "example_id": "aced8313-3b1b-4721-b098-8d143440fc1c",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "AfD-Abgeordnete Frauke Petry ist eh mit anderen Dingen beschäftigt. Gerade wird gegen sie wegen Falschaussagen vor einem Landtagsausschuss ermittelt."
                            },
                            {
                                "example_id": "f52388df-5dd7-43df-b061-6ae83182e89d",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "„»Es ist ja schon bezeichnend, dass noch im November 2001 die CDU gegen einen entsprechenden Antrag der FDP bei uns im Landtagsausschuss gestimmt hat.«“"
                            },
                            {
                                "example_id": "40e37155-ee01-4076-8924-feff73fd195b",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "„»Die Recherchen haben sich zu sehr zugespitzt auf Hanau. Mir liegt daran, zu betonen, dass unter anderem auch der hessische Innenminister unter anderem vor dem zuständigen Landtagsausschuss dargestellt hat, dass wir hier Teil eines losen Zusammenhanges von Salafisten im ganzen östlichen Rhein-Main-Gebiet sind.«“ […]."
                            },
                            {
                                "example_id": "337c28ff-8996-47c0-ada1-2ced61870b68",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "„Die CDU-Fraktion im Thüringer Landtag hält bis heute an Krause fest, auch wenn er sein Amt nicht antrat. Sie machte ihn später zum Chef des Landtagsausschusses für Wissenschaft, Kunst und Medien.“"
                            },
                            {
                                "example_id": "19d3ddc7-5ec0-40c8-b25b-c191cd488d74",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "„300 Meter Abstand müsse reichen, so die Linke. Im zuständigen Landtagsausschuss konnte sie sich mit dieser Forderung nicht durchsetzen.“"
                            },
                            {
                                "example_id": "837b3c5b-dcd7-4b0e-b4cf-b9d8be9f44d7",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "[…] „Ist der Landtagsausschuss Anfang Februar über diese Vorgänge bislang korrekt und vollständig informiert worden?“"
                            },
                            {
                                "example_id": "091112f8-4daa-454b-a8f0-6218a742753a",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "„Der niedersächsische Landtagsausschuss besichtigt den Hafen Brake an der Unterweser.“"
                            },
                            {
                                "example_id": "7b58093e-aba1-410b-8266-37fc95ace20f",
                                "sense_id": "86a60ab7-b608-3a85-9c05-163ea92c225a",
                                "text": "„Derzeit würden die Möglichkeiten von Synergien und Einsparungen ausgelotet, ohne die Qualität infrage zu stellen, hieß es am Mittwoch im Bericht des Kunstministeriums, der im Landtagsausschuss für Wissenschaft und Kunst vorgestellt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
