                ],
                "senses": [
                    {
                        "sense_id": "e4bd58d8-cd05-33b7-b661-b8d8428d4a2b",
                        "entry_id": "6b85883d-f98c-30ef-859a-52da9504a278",
                        "glosses": [
                            "10-Pfennig-Münze"
                        ],
                        "tags": [
                            "Bavarian",
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "41800e65-b813-4123-a23d-1b51542d390f",
                                "sense_id": "e4bd58d8-cd05-33b7-b661-b8d8428d4a2b",
                                "text": "„Wenn meine Leute unter der Woch nicht daheim waren, habens mir ein Zehnerl geben, daß ich mir was zum Essen kauf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0f4a46a2-5f1a-3c90-a85e-e4bd2d8e55ba",
                        "entry_id": "6b85883d-f98c-30ef-859a-52da9504a278",
                        "glosses": [
                            "10-Cent-Münze"
                        ],
                        "tags": [
                            "Bavarian"
                        ],
                        "examples": [
                            {
                                "example_id": "ee927bfc-bfbb-4b95-b3ce-8edd05057c75",
                                "sense_id": "0f4a46a2-5f1a-3c90-a85e-e4bd2d8e55ba",
                                "text": "„Mitunter kann man sie erst dann richtig ansehen, wenn man ein \"Zehnerl\" für die Beleuchtung einwirft.“"
                            },
                            {
                                "example_id": "6ea68112-a192-4446-ac1a-db529dd07401",
                                "sense_id": "0f4a46a2-5f1a-3c90-a85e-e4bd2d8e55ba",
                                "text": "„Die Marktkaufleute fänden die Auszeichnung gut, weil sie dann noch ein Zehnerl mehr draufschlagen könnten.“"
                            },
                            {
                                "example_id": "65b98d58-cb62-44dd-b0ee-59d1c827b23b",
                                "sense_id": "0f4a46a2-5f1a-3c90-a85e-e4bd2d8e55ba",
                                "text": "„Gesagt getan, die Pfarrerin lud ein und an fünf Terminen kamen Gottesdienstbesucher und legten Zehnerl an Zehnerl."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
