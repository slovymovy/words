                {
                    "sense_id": "33fcbbbc-d30a-3b98-a693-bf7b5e132737",
                    "sense_definition": "A town located in Carter County, Oklahoma.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "places",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The community of <w>Springer</w> in Oklahoma is known for its quiet rural atmosphere.",
                            "target_lang_translations": {
                                "ru": "Община <w>Спрингер</w> в Оклахоме известна своей тихой сельской атмосферой."
