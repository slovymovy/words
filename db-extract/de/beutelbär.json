                        "glosses": [
                            "andere Bezeichnung für den Koala (und seine ausgestorbenen Verwandten, Familie Phascolarctidae)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142109f5-de42-4487-8912-7c315ef79e25",
                                "sense_id": "1788dc2d-ef6e-36db-af08-25430369f563",
                                "text": "„Neusüdwales, und zwar die südwestlich von Port Jackson gelegenen Wälder, sind die Heimat des Beutelbären.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
