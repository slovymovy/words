                ],
                "senses": [
                    {
                        "sense_id": "c8118981-69d4-34ab-90a6-e8fbccb6ac89",
                        "entry_id": "be8e3ca4-7e62-3953-893d-0fa673c88a9d",
                        "glosses": [
                            "The area immediately above the eyebrow and below the forehead."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83c90964-5d07-4573-89e3-33fa358dfa53",
                                "sense_id": "c8118981-69d4-34ab-90a6-e8fbccb6ac89",
                                "text": "If the man thall have a Mole on the overbrow, then let fuch a perfon refrayne from marriage altogether , or all his life time; for that such a person (if he marry) shall have five wives in his lifetime."
                            },
                            {
                                "example_id": "cbc6d2e5-8c46-4748-a0f5-88e17bba6d4b",
                                "sense_id": "c8118981-69d4-34ab-90a6-e8fbccb6ac89",
                                "text": "I could not say that he didn't give the matter consideration, but while I noticed once in a while, by the lifting of an eyebrow or a slight corrugation of the overbrow, that the gubernatorial mind seemed to have some slight premonitory symptom of the induction of a thought, it passed off without apparent fruition."
                            },
                            {
                                "example_id": "f31c60bc-f037-4614-8eec-a1629171d2ab",
                                "sense_id": "c8118981-69d4-34ab-90a6-e8fbccb6ac89",
                                "text": "As I translated, however, Valeo's face contorted, his overbrow furrowing as he picked at his food."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8508478-8be5-369c-90d7-60e6948f8015",
                        "entry_id": "be8e3ca4-7e62-3953-893d-0fa673c88a9d",
                        "glosses": [
                            "A projecting shelf of rock on the face of a cliff."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30352fe5-0493-44eb-b38a-d41cb3fe64c8",
                                "sense_id": "a8508478-8be5-369c-90d7-60e6948f8015",
                                "text": "For reasons of safety it was decided to drill off the overbrow and to blast it at one time to break 30,000 tons."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
