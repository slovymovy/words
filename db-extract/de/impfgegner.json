                        "cross_references": [
                            {
                                "target_word": "antivaxer",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3ac453cb-f56c-371c-9b22-9767e1b6722f",
                                        "entry_id": "a600f7ee-4d85-3e51-8110-e7b00c853138",
                                        "glosses": [
                                            "člověk, který (důrazně) odmítá očkování"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c034ae8-1bfd-437d-9233-93e3bfc49b23",
                                                "sense_id": "3ac453cb-f56c-371c-9b22-9767e1b6722f",
                                                "text": "Žádný malý virus mě nezastaví! prohlásil mistr světa a zarytý antivaxer. Krátce poté covidu podlehl"
                                            },
                                            {
                                                "example_id": "5372f446-177a-4772-acf5-fe1b3485ffb7",
                                                "sense_id": "3ac453cb-f56c-371c-9b22-9767e1b6722f",
                                                "text": "Antivaxeři oponují, že v očkování typu RNA dostanou do těla genetické látky, genetické kódy."
                                            },
                                            {
                                                "example_id": "ce841552-280d-41e6-b812-32fb1947f640",
                                                "sense_id": "3ac453cb-f56c-371c-9b22-9767e1b6722f",
                                                "text": "Zdravotníci v Rakousku dostávají od antivaxerů dopisové bomby"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
