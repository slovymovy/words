            {
                "entry_id": "3d4a943c-0623-3c24-b54c-1c93b38585a1",
                "word": "américomanie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a6d0027-f0a0-318c-a7b1-5d2de008ff48",
                        "entry_id": "3d4a943c-0623-3c24-b54c-1c93b38585a1",
                        "glosses": [
                            "Mode qui consiste à admirer ou imiter avec excès tout ce qui appartient à l’Amérique, particulièrement aux États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "816bac5c-e7fe-4306-8b43-55fd6e4e33d4",
                                "sense_id": "0a6d0027-f0a0-318c-a7b1-5d2de008ff48",
                                "text": "M. le baron d’Eckstein, l’un des plus braves condottieri de plume de notre temps, a écrit une dissertation sur Lafayette et l’américomanie."
                            },
                            {
                                "example_id": "e5c95dee-d275-4f22-a896-58d05bedd2ae",
                                "sense_id": "0a6d0027-f0a0-318c-a7b1-5d2de008ff48",
                                "text": "Déjà l’américomanie, qui devait marquer plusieurs générations de Franchouillards, était en germe."
                            },
                            {
                                "example_id": "bc72868e-d383-410f-bb7b-93acc5eed23c",
                                "sense_id": "0a6d0027-f0a0-318c-a7b1-5d2de008ff48",
                                "text": "Les Français imaginent un pays peuplé de « bons sauvages » ; la reine elle-même n’échappe pas à l’américomanie et porte des coiffures et des chapeaux inspirés d’épisodes de la guerre."
                            }
                        ]
                    }
                ],
