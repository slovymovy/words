                "senses": [
                    {
                        "sense_id": "637d8597-eafe-3a24-8149-df4bcde8db24",
                        "entry_id": "eaaf6624-5afc-34a6-a367-4694e94e3fca",
                        "glosses": [
                            "Vocaliser."
                        ],
                        "tags": [
                            "Vendée"
                        ],
                        "examples": [
                            {
                                "example_id": "ab8c3e68-3c97-4100-b19b-2a80cf7bc199",
                                "sense_id": "637d8597-eafe-3a24-8149-df4bcde8db24",
                                "text": "Seul Dochâgne, de temps en temps, berluettait pour énerver les bœufs."
                            },
                            {
                                "example_id": "069c95c1-dd9b-4a1f-8ce8-1e9005b00bbf",
                                "sense_id": "637d8597-eafe-3a24-8149-df4bcde8db24",
                                "text": "Et il se mit à « berluetter » en tourbillonnant pour nous prouver sans doute qu’il avait « la goule bé lisse ». On berluette, c’est-à-dire qu’on vocalise, pour la danse quand on n’a pas de violons."
                            }
                        ]
                    }
