                "translations": [
                    {
                        "translation_id": "e7da4c7d-86ad-4d29-bb60-fd66b2f81778",
                        "source_entry_id": "6d59f982-952c-3481-8470-4aa61972134f",
                        "target_lang_word": "Schläfer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schläfer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "499afda8-a389-39ed-a03e-c5e0b69fac8c",
                                        "entry_id": "42788f40-c4a3-3d5e-89fd-050e3b9209d4",
                                        "glosses": [
                                            "Person, die schläft, die sich im Schlafzustand befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e0fac5d-a52a-437d-878a-d694da7d3479",
                                                "sense_id": "499afda8-a389-39ed-a03e-c5e0b69fac8c",
                                                "text": "Ein lauter Knall weckte die Schläfer unsanft."
                                            },
                                            {
                                                "example_id": "585c58e0-0378-49c8-bfbb-9cd90ba7def5",
                                                "sense_id": "499afda8-a389-39ed-a03e-c5e0b69fac8c",
                                                "text": "„Hélène hatte also den Schläfer mit seinem Schlaf allein gelassen, und nun stand sie in ihrem Zimmer.“"
                                            },
                                            {
                                                "example_id": "81398b5b-7e2c-49f0-8835-72c384dfc3b9",
                                                "sense_id": "499afda8-a389-39ed-a03e-c5e0b69fac8c",
                                                "text": "„Die Schläfer werden aufgerüttelt, dann treten die Hitler-Jungen und Flakhelfer an.“"
                                            },
                                            {
                                                "example_id": "99f5a87e-1ba3-4e1d-85b6-8e29c53b5601",
                                                "sense_id": "499afda8-a389-39ed-a03e-c5e0b69fac8c",
                                                "text": "„Es wurde still, und man hörte einige Schläfer schnarchen; die übrigen wälzten sich von der einen Seite auf die andere, um sich gleichmässig zu wärmen, und ab und zu machte noch einer eine Bemerkung.“"
                                            },
                                            {
                                                "example_id": "5bcee357-40d0-4fe2-8a12-07c9f43eff48",
                                                "sense_id": "499afda8-a389-39ed-a03e-c5e0b69fac8c",
                                                "text": "„Die Schläfer schnarchten ohne Pause.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fb869fe-60db-35c1-b5b6-b2c709163ed3",
                                        "entry_id": "42788f40-c4a3-3d5e-89fd-050e3b9209d4",
                                        "glosses": [
                                            "in eine Organisation oder in ein Land eingeschleuster Spion, der zunächst unauffällig bleibt und erst nach einiger Zeit aktiviert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d07c89f1-b04c-4cf7-8a80-fd0e63a89290",
                                                "sense_id": "9fb869fe-60db-35c1-b5b6-b2c709163ed3",
                                                "text": "„Sie sollen auf unbestimmte Zeit als Schläfer im Land bleiben und dort jederzeit aktiviert werden können, um die ‚Stabilität der Region‘ zu erhalten, wie es im Gesprächsprotokoll beschönigend heißt.“"
                                            },
                                            {
                                                "example_id": "4bc3bddb-ec73-425c-ba76-f61ade3e3291",
                                                "sense_id": "9fb869fe-60db-35c1-b5b6-b2c709163ed3",
                                                "text": "„Er ist ein Schläfer, den sie sich entweder für irgendwelche speziellen Aufgaben aufsparen oder ganz einfach vergessen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "47a888f2-ced9-3e03-8150-032ee11c5801",
                                        "entry_id": "42788f40-c4a3-3d5e-89fd-050e3b9209d4",
                                        "glosses": [
                                            "kleines, mausähnliches, nachtaktives Nagetier, das einen langen Winterschlaf hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ba29f9-8f25-4d1b-bed7-36e38502dae9",
                                                "sense_id": "47a888f2-ced9-3e03-8150-032ee11c5801",
                                                "text": "Schläfer haben einen auffällig buschigen Schwanz."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd531d32-2787-4046-8538-a35ac53c7b44",
                        "source_entry_id": "6d59f982-952c-3481-8470-4aa61972134f",
                        "target_lang_word": "sleeper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sleeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89b1b18a-3bc9-3e86-bede-f7630bfd992b",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "Someone who sleeps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf29d154-c9be-4c08-87ce-4b2717a4ac10",
                                                "sense_id": "89b1b18a-3bc9-3e86-bede-f7630bfd992b",
                                                "text": "I'm a light sleeper: I get woken up by the smallest of sounds."
                                            },
                                            {
                                                "example_id": "2fbd1fe0-7ba3-4a7c-b291-dccb0c3d51e7",
                                                "sense_id": "89b1b18a-3bc9-3e86-bede-f7630bfd992b",
                                                "text": "She's a heavy sleeper: it takes a lot to wake her up."
                                            },
                                            {
                                                "example_id": "1499b413-e788-490e-9c85-b5d76a211a8b",
                                                "sense_id": "89b1b18a-3bc9-3e86-bede-f7630bfd992b",
                                                "text": "Waveless mattresses are for those who prefer a more stationary [night's sleep]; semiwaveless for those who want a slight rocking motion, and free-flow for sleepers who want the feel of a boat. All beds come with temperature controls, and king- and queen-size models offer dual controls."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "378d76e9-273a-334a-ae66-6f25397faa88",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "That which lies dormant, as a law."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de80dcf2-3e23-4040-8c70-5f5f1cd1f517",
                                                "sense_id": "378d76e9-273a-334a-ae66-6f25397faa88",
                                                "text": "Therefore let penal laws, if they have been sleepers of long, or if they be grown unfit for the present time, be by wise judged confined in the execution […]"
                                            },
                                            {
                                                "example_id": "1d122eee-fbaf-48a2-b062-94119b9eb110",
                                                "sense_id": "378d76e9-273a-334a-ae66-6f25397faa88",
                                                "text": "The object of these provisions is to prevent insertion of \"jokers\" or \"sleepers\" in bills and securing passage under the false color of the title."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6955efb2-5449-3cfa-af59-016c76b958f7",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A spy, saboteur, or terrorist who lives unobtrusively in a community until activated by a prearranged signal; may be part of a sleeper cell."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef80c3df-ef33-43a7-bca7-f4c8839aafb1",
                                                "sense_id": "6955efb2-5449-3cfa-af59-016c76b958f7",
                                                "text": "We are up against the pros; and pros who have been involved in this kind of activity for many years. […] The public apathy today is disturbing — few realize, Mr. Chairman, that there are sleepers in this country and we know that they are able to manipulate at will behind the scenes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efd42a56-eeb4-31df-af30-0b4fb1734858",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A small starter earring, worn to prevent a piercing from closing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a397df49-1dca-4e67-a723-30b6b4072eb9",
                                                "sense_id": "efd42a56-eeb4-31df-af30-0b4fb1734858",
                                                "text": "His skull earring had been replaced by a small gold sleeper. He was quite as surprised to see them as they were to see him. “There! And I made sure you’d forget!” he said. After that, they all stared at one another awkwardly, until Fiona, who also had pierced ears, remarked on his sleeper. “Doesn’t Wilton allow pierced ears?” she asked. “No way!” said Leslie. “Rules about everything. But I wanted to keep my options open, as you might say. No one’s made me take it out yet. Where is there to go in this town?”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93b33c70-0d06-32a8-9285-ad2f4376372a",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A railway sleeping car."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a648fbb-b4ef-4750-854c-eec325fb3bd5",
                                                "sense_id": "93b33c70-0d06-32a8-9285-ad2f4376372a",
                                                "text": "We spent a night on an uncomfortable sleeper between Athens and Vienna."
                                            },
                                            {
                                                "example_id": "116494f5-96a1-4ade-963f-e7eac172d581",
                                                "sense_id": "93b33c70-0d06-32a8-9285-ad2f4376372a",
                                                "text": "It is realised that the old Pullman standard sleeper, with its convertible \"sections\", each containing upper and lower berths, and with no greater privacy at night than the curtains drawn along both sides of a middle aisle, has had its day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0dab4f53-65ac-35d1-8562-9e8a4b844e19",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A sleeper hold."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "febaa231-1984-3850-bc6a-3bbfcafa6dce",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "Something that achieves unexpected success after an interval of time."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1d9420e-2a5d-4838-ac09-03ad4fba4382",
                                                "sense_id": "febaa231-1984-3850-bc6a-3bbfcafa6dce",
                                                "text": "A box-office bomb when it first came out, the film was a sleeper, becoming much more popular decades after being released."
                                            },
                                            {
                                                "example_id": "f608bd59-36e1-4792-9b82-a962eb6ef79b",
                                                "sense_id": "febaa231-1984-3850-bc6a-3bbfcafa6dce",
                                                "text": "For example, the [racehorse] trainer may have tipped a betting syndicate that he is about to unleash a sleeper […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e137f649-3ac5-32c5-9861-a028d478fb41",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "Any of family Odontobutidae of goby-like bottom-feeding freshwater fish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "70d2bd7d-99f6-35db-b73e-e44d4cc36db2",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A nurse shark (family Ginglymostomatidae)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "82f328de-51a9-3858-9c39-5093ece64d6a",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A type of pajama for a person, especially a child, that covers the whole body, including the feet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ff15a9-d8dc-4d5b-bcf4-ec93093b241c",
                                                "sense_id": "82f328de-51a9-3858-9c39-5093ece64d6a",
                                                "text": "Aaron, Devin, and Laura looked so comfy in their sleepers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcdb530f-066c-3abf-9691-1235284a3394",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "An automobile which has been internally modified to excess, while retaining a mostly stock appearance in order to fool opponents in a drag race, or to avoid the attention of the police."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b1b0def-8b4b-3078-9fa6-ce6d103c06c9",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A sedative."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c734076-0362-4e55-8c17-88f3cdc9be33",
                                                "sense_id": "8b1b0def-8b4b-3078-9fa6-ce6d103c06c9",
                                                "text": "At least a couple of weeks since I last slept, / Kept takin' sleepers, but now I keep myself pepped."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91477721-dd9c-34be-a99f-0ac8d2a5251c",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A bet placed on the gambling table and then forgotten about by the gambler."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "176c5ac0-2e75-3c36-b609-51bc2e380608",
                                        "entry_id": "bbb7910c-3b0f-349d-94af-2f75eefda5a7",
                                        "glosses": [
                                            "A pod or similar device containing a person in cryosleep."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sleeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "891abbf1-8284-39fb-ae37-ae3ba11fce36",
                                        "entry_id": "1a38c616-7c73-3099-84a7-f2579be78861",
                                        "glosses": [
                                            "To mark a calf by cutting its ear."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a39323c-f02f-4e46-9b35-458bd231c52e",
                                                "sense_id": "891abbf1-8284-39fb-ae37-ae3ba11fce36",
                                                "text": "I expect there ain't a trick to maverickin' and sleeperin' and changin' a brand he don't know."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sleeper",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6c979c0-68aa-3d72-982e-a165c9d35088",
                                        "entry_id": "0520d8ff-2517-3f10-86b0-16678aa0d89d",
                                        "glosses": [
                                            "A railroad tie."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d5668848-176b-47d3-984b-d2edce400b5c",
                                                "sense_id": "a6c979c0-68aa-3d72-982e-a165c9d35088",
                                                "text": "The train, minus the three abandoned trucks, again proceeded at a slow pace, with a pump trolley doing pilot ahead ; this was very necessary as a great many sleepers were found to have been burnt underneath the fishplates."
                                            },
                                            {
                                                "example_id": "67776e62-05d1-46cc-8d37-40c92e0c1def",
                                                "sense_id": "a6c979c0-68aa-3d72-982e-a165c9d35088",
                                                "text": "I should imagine that the smooth riding and the quietness of the diesel or electric cab, coupled with the effect on the eyes of endless successions of sleepers disappearing from sight immediately under the driver's eyes, might in time have a soporific effect, so that the company of a second man, who can assist in signal observations when he is not at work in the engine cab, seems highly desirable in such conditions."
                                            },
                                            {
                                                "example_id": "66f75049-8046-4d38-8e80-49f3ffc3e5c5",
                                                "sense_id": "a6c979c0-68aa-3d72-982e-a165c9d35088",
                                                "text": "Government surveyors set to work, importing hundreds of Indian coolies, thousands of donkeys and camels, and the millions of sleepers required for this monstrous engineering project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "169ee875-f841-3cb0-8563-eee71c599139",
                                        "entry_id": "0520d8ff-2517-3f10-86b0-16678aa0d89d",
                                        "glosses": [
                                            "A structural beam in a floor running perpendicular to both the joists beneath and floorboards above."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
