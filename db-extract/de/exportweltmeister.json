                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d19bfda4-fbae-4cc5-892d-4fab3d60f0a0",
                                "sense_id": "a9be3b64-03a4-3072-a555-7059f3934c8a",
                                "text": "„Die Schiffseigner stellten die drittgrößte Handelsflotte der Welt und flankierten Deutschlands Aufstieg zum Exportweltmeister.“"
                            },
                            {
                                "example_id": "2cb6374f-1a16-4404-98f9-ec9b588c94ae",
                                "sense_id": "a9be3b64-03a4-3072-a555-7059f3934c8a",
                                "text": "„Im Jahr 1913 gingen 60 Prozent aller Waren von Continental ins Ausland. Ein \"Exportweltmeister\", lange bevor das Wort erfunden werden sollte.“"
                            }
