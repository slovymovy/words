                                "example_id": "653be5f2-6381-4e67-ad33-0e8082b4d7fa",
                                "sense_id": "a4b05c15-b630-313d-bcc8-6bc9bb90d11e",
                                "text": "The wolves yelled on the caverned hill\nWhere echo tolled in thunder still;"
