                        ],
                        "form": "den Therapeutinnen"
                    },
                    {
                        "form_id": "e078a51e-2062-4f70-be60-25719c2899d5",
                        "entry_id": "faa6e939-dc32-3ae6-9d97-9957b35864a6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Therapeutin"
                    },
                    {
                        "form_id": "f04bf95d-d6f0-4d1d-b43d-1f39cdd43ad2",
                        "entry_id": "faa6e939-dc32-3ae6-9d97-9957b35864a6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Therapeutinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "15c23e3b-80ce-3d97-9bba-3232cff80d4d",
                        "entry_id": "faa6e939-dc32-3ae6-9d97-9957b35864a6",
                        "glosses": [
                            "Frau, die es als ihre Aufgabe betrachtet, gegen Krankheiten bestimmte Therapien anzuwenden; das kann, muss aber keine Ärztin sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aa3649ff-d959-4d34-a1f9-553149123c93",
                                "sense_id": "15c23e3b-80ce-3d97-9bba-3232cff80d4d",
                                "text": "„Sie verschrieb sich dieser Wissenschaft mit Haut und Haar, als Therapeutin wie als Künstlerin.“"
                            },
                            {
                                "example_id": "f05f5d1c-8f48-442a-8ead-d1838bcb3456",
                                "sense_id": "15c23e3b-80ce-3d97-9bba-3232cff80d4d",
                                "text": "„Dort hörte sie zum ersten Mal den Begriff \"Zwänge\" und erfuhr, dass es viele Menschen gibt, die sie haben. Rund zwei Prozent der Bevölkerung leidet unter Zwangserkrankungen, aber nur jeder zehnte Patient wird adäquat behandelt\", sagt Eva Kischkel, Therapeutin in der Hochschulambulanz für Psychotherapie und Psychodiagnostik des Instituts für Psychologie der Humboldt Universität in Adlershof. Kischkel forscht über Zwangsstörungen und behandelt Patienten.“"
                            },
                            {
                                "example_id": "cebbb8a7-558b-4f77-99ae-3d69d39acbad",
                                "sense_id": "15c23e3b-80ce-3d97-9bba-3232cff80d4d",
                                "text": "„Tatsächlich aber hatte er eine Therapeutin.“"
                            },
                            {
                                "example_id": "69dfa696-c972-466e-9258-dc64ed698b6b",
                                "sense_id": "15c23e3b-80ce-3d97-9bba-3232cff80d4d",
                                "text": "„Er spricht mit seiner Therapeutin, befragt Frauen und Männer und Eltern, hinterfragt sich selbst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4786f8f7-aa14-4a70-95c8-915659329d79",
                        "source_entry_id": "faa6e939-dc32-3ae6-9d97-9957b35864a6",
                        "source_sense_id": "15c23e3b-80ce-3d97-9bba-3232cff80d4d",
                        "target_lang_word": "therapist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "therapist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5371a70d-94b2-3567-a6f9-a52fca94fb6d",
                                        "entry_id": "ce4eafd2-1706-3c43-a835-7e4e4ff49d95",
                                        "glosses": [
                                            "Someone who provides therapy, usually professionally."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ae2f8b-30d7-4c88-b1ce-040f649ca09b",
                                                "sense_id": "5371a70d-94b2-3567-a6f9-a52fca94fb6d",
                                                "text": "Get the whole in-network provider list and then ask friends and family if they know any of the names, or check online ratings to see which therapists get high rankings. One note of warning: Friends may have their favorites, but experts say don’t assume their therapist is going to be a good fit for you as each person’s needs are different."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2854cde-edf3-3f56-b76d-60aeb15693b7",
                                        "entry_id": "ce4eafd2-1706-3c43-a835-7e4e4ff49d95",
                                        "glosses": [
                                            "A psychotherapist specifically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c3824b8-3ee2-4161-bb13-948cd3f66d13",
                                                "sense_id": "c2854cde-edf3-3f56-b76d-60aeb15693b7",
                                                "text": "Seeing the British establishment struggle with the financial sector is like watching an alcoholic […]. Until 2008 there was denial over what finance had become. […] But the scandals kept coming, and so we entered stage three – what therapists call \"bargaining\". A broad section of the political class now recognises the need for change but remains unable to see the necessity of a fundamental overhaul. Instead it offers fixes and patches."
                                            },
                                            {
                                                "example_id": "55d2e475-5278-4e20-815b-f665ff855a2b",
                                                "sense_id": "c2854cde-edf3-3f56-b76d-60aeb15693b7",
                                                "text": "We're Midwesterners. Our therapists are bartenders."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7f9f03e-2d6d-4f2f-9299-53c29662d2de",
                        "source_entry_id": "faa6e939-dc32-3ae6-9d97-9957b35864a6",
                        "source_sense_id": "15c23e3b-80ce-3d97-9bba-3232cff80d4d",
                        "target_lang_word": "терапевт",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "терапевт",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "618d0587-95bd-359e-aac5-5238cd2b281d",
                                        "entry_id": "e034ee74-1dde-36e6-84d1-5c9bfee9f047",
                                        "glosses": [
                                            "мед. врач, специалист по внутренним болезням"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea8a2d91-c60b-4eb0-b730-ae63ed97a9de",
                                                "sense_id": "618d0587-95bd-359e-aac5-5238cd2b281d",
                                                "text": "Как здоровье Софьи Петровны? По-моему, ей необходимо побывать в Москве и показаться Щуровскому или другому какому-нибудь терапевту, имеющему большую практику."
                                            },
                                            {
                                                "example_id": "255016a2-4410-455e-b60e-076ba5ba9874",
                                                "sense_id": "618d0587-95bd-359e-aac5-5238cd2b281d",
                                                "text": ".. Сашу уже смотрел терапевт. — И что же? — Грипп, осложнившийся воспалением лёгких."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e34483d-5bfd-3912-885a-4c439f68ee36",
                                        "entry_id": "e034ee74-1dde-36e6-84d1-5c9bfee9f047",
                                        "glosses": [
                                            "эвф. то же, что психотерапевт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66e76d05-7f65-41b6-b82e-231bb9bf8f5f",
                                                "sense_id": "3e34483d-5bfd-3912-885a-4c439f68ee36",
                                                "text": "Терапевт, несомненно, является носителем разочаровывающей реальности, особенно если он недостаточно нарциссичен для того, чтобы поддерживать идеализации жертвы. При поддержке и принятии терапевта жертва знакомится с тем, каким образом и почему она отвергает его человеческие черты и проявления — усталость, например, или равнодушие, или неготовность брать за нее ответственность и давать пошаговые рекомендации."
                                            },
                                            {
                                                "example_id": "30aa3a83-65ea-4ff6-814a-5da0b86b6e63",
                                                "sense_id": "3e34483d-5bfd-3912-885a-4c439f68ee36",
                                                "text": "Если даже в рамках терапевтической сессии клиент будет удерживать взрослую позицию, сотрудничать с терапевтом, понимать, что мы делаем и зачем, то между сессиями он будет «сползать в детскую позицию», идентифицируясь с травмированной или выживающей частью личности. А, значит, будет меняться его отношение к себе, своим изменениям, терапевту и терапии."
                                            }
                                        ]
                                    },
