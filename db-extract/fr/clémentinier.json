                        "entry_id": "b66654ca-7fee-3c1d-bb65-0e0103b5ca56",
                        "glosses": [
                            "Petit arbre fruitier de la famille des Rutaceae (Rutacées), qui est un hybride d’un mandarinier (Citrus reticulata) et d’un oranger (Citrus sinensis) et qui produit la clémentine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe73d9cb-c370-42d3-881b-f806f6e34ed8",
                                "sense_id": "d56a2431-d08d-36d8-a4bb-d84249aa4eaf",
                                "text": "Le clémentinier ressemble au mandarinier. Plus petit que ceux du mandarinier, ses nombreux fruits rouge orangé n’ont pas de pépins. Leur écorce se détache facilement de la pulpe."
                            }
                        ]
                    }
