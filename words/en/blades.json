                    "sense_definition": "Plural of <w>blade</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He needed to buy new razor <w>blades</w> for his morning shave.",
                            "target_lang_translations": {
                                "ru": "Ему нужно было купить новые <w>лезвия</w> для бритвы, чтобы побриться утром.",
                                "fr": "Il avait besoin d'acheter de nouvelles <w>lames</w> de rasoir pour son rasage du matin."
                            }
                        },
                        {
                            "text": "The helicopter rotor <w>blades</w> started to spin rapidly before takeoff.",
                            "target_lang_translations": {
                                "ru": "<w>Лопасти</w> несущего винта вертолета начали быстро вращаться перед взлетом.",
                                "fr": "Les <w>pales</w> du rotor de l'hélicoptère ont commencé à tourner rapidement avant le décollage."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shoulder blades",
                        "razor blades",
                        "grass blades",
                        "wiper blades"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Множественное число от слова 'blade' (лезвие, лопасть, клинок).",
                        "fr": "Pluriel du mot 'blade' (lame, pale, épée)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лезвия",
                                "target_lang_sense_clarification": "режущая часть инструмента, ножа или бритвы"
                            },
                            {
                                "target_lang_word": "лопасти",
                                "target_lang_sense_clarification": "плоские части пропеллера, винта или турбины"
                            },
                            {
                                "target_lang_word": "клинки",
                                "target_lang_sense_clarification": "холодное оружие"
                            },
                            {
                                "target_lang_word": "лопатки",
                                "target_lang_sense_clarification": "анатомический термин (shoulder blades)"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "lames",
                                "target_lang_sense_clarification": "partie tranchante d'un outil, d'un couteau ou d'un rasoir"
                            },
                            {
                                "target_lang_word": "pales",
                                "target_lang_sense_clarification": "parties plates d'une hélice, d'un rotor ou d'une turbine"
                            },
                            {
                                "target_lang_word": "omoplates",
                                "target_lang_sense_clarification": "terme anatomique pour 'shoulder blades'"
                            }
                        ]
                    }
                }
            ]
        },
