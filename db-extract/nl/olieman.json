                ],
                "senses": [
                    {
                        "sense_id": "d7939bbe-231f-328b-b423-2c51a2c01314",
                        "entry_id": "494650a9-f45a-3578-a4f4-f9a7129f471e",
                        "glosses": [
                            "iemand die werk in de olieindustrie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03fb5143-69c4-4712-9367-f26ddc7ffd09",
                                "sense_id": "d7939bbe-231f-328b-b423-2c51a2c01314",
                                "text": "Voormalig olieman Justin Welby leider anglicanen: Bisschop Justin Welby van Durham wordt de 105e aartsbisschop van Canterbury en geestelijk leider van de circa 80 miljoen anglicanen in de wereld. Dat heeft de Britse premier David Cameron vrijdag bekend laten maken."
                            },
                            {
                                "example_id": "3813cade-1db3-4b2c-8c8e-22337f40ddab",
                                "sense_id": "d7939bbe-231f-328b-b423-2c51a2c01314",
                                "text": "Rex Tillerson: olieman wordt topdiplomaat VS: De man die wat Donald Trump betreft zijn minister van Buitenlandse Zaken wordt, heeft net als Trump geen enkele politieke ervaring."
                            }
                        ]
                    },
                    {
                        "sense_id": "e74fcf9f-5a45-3b23-826e-9f4d9c3fbf7a",
                        "entry_id": "494650a9-f45a-3578-a4f4-f9a7129f471e",
                        "glosses": [
                            "machinist op een schip"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83b62de8-e335-3ce9-bca6-4164472c2072",
                        "entry_id": "494650a9-f45a-3578-a4f4-f9a7129f471e",
                        "glosses": [
                            "iemand die zorgt voor betere relaties tussen mensen en groepen die elkaar niet bij voorbaat vertrouwen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63ffeb74-b21c-400d-8478-13f7eec2745f",
                                "sense_id": "83b62de8-e335-3ce9-bca6-4164472c2072",
                                "text": "De Nationaal Coördinator Groningen werd aangesteld als nieuwe verbindende factor, het oliemannetje tussen lijdend Groningen en het door noordelingen als onnavolgbaar geziene Den Haag."
                            },
                            {
                                "example_id": "a14cf392-15e4-4b7d-a967-17a8060d050e",
                                "sense_id": "83b62de8-e335-3ce9-bca6-4164472c2072",
                                "text": "Rutte neemt de rol van oliemannetje op zich. „Ik zal proberen te zorgen dat sfeer goed blijft en dat een aantal irritaties tussen mensen worden uitgesproken”, zei hij. „Ik hoef het zelf gelukkig met niemand bij te leggen.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ed097c57-9ec7-438d-85be-05b2429f5017",
                        "source_entry_id": "494650a9-f45a-3578-a4f4-f9a7129f471e",
                        "source_sense_id": "e74fcf9f-5a45-3b23-826e-9f4d9c3fbf7a",
                        "source_sense_description": "machinesmeerder",
                        "target_lang_word": "greaser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "greaser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "da88eef7-79ae-33b0-9904-20057099481f",
                                        "entry_id": "0ea0a4a4-5650-35f8-979a-a4dc8c1f90fe",
                                        "glosses": [
                                            "Someone or something that greases (applies grease)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d297299-433c-4d23-928c-1055c5cedabe",
                                                "sense_id": "da88eef7-79ae-33b0-9904-20057099481f",
                                                "text": "The pole was greased and men tried to walk out to the end of it and dislodge the crate. The pole was supple, the crate swayed as each man crept out clinging desperately and finally fell off into the sea. […] People roared with laughter and greasers applied fresh grease for the next person's try."
                                            },
                                            {
                                                "example_id": "c822e679-4906-481e-b01d-130f8e2f458a",
                                                "sense_id": "da88eef7-79ae-33b0-9904-20057099481f",
                                                "text": "... incidentally, our correspondent tells of a West Indian who applied for a job at Kings Cross as motion greaser - but with no idea of what he would have to grease and why. Invited to find out and return within a month, he did, and nowadays the Kings Cross engines are as efficiently greased as any on B.R."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7aca451-c4a2-3f31-bca7-8bea6aa2b56a",
                                        "entry_id": "0ea0a4a4-5650-35f8-979a-a4dc8c1f90fe",
                                        "glosses": [
                                            "A mechanic."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f87b404c-8137-321c-a012-84774af7c3e3",
                                        "entry_id": "0ea0a4a4-5650-35f8-979a-a4dc8c1f90fe",
                                        "glosses": [
                                            "A biker, a tough."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "933b4635-4bf1-3e03-b996-be2a38c85bd0",
                                        "entry_id": "0ea0a4a4-5650-35f8-979a-a4dc8c1f90fe",
                                        "glosses": [
                                            "A rocker or metalhead, especially one who listens to 1950s rock and roll or 1980s thrash metal."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a0dd9a0-8f0a-41f0-9cda-bc42e5b0d051",
                                                "sense_id": "933b4635-4bf1-3e03-b996-be2a38c85bd0",
                                                "text": "By such standards, the Greasers are pretty minor stuff. Basically, they're just the 1970 version of that time-honored English figure, the Leather Boy. During the fifties, he was known as the Teddy Boy; in the early sixties, he became the Rocker; and now, after a couple of earlier attempts at revival, he's back yet again, the Greaser."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "240d96f1-b10a-39a7-93a7-8dea89d34de9",
                                        "entry_id": "0ea0a4a4-5650-35f8-979a-a4dc8c1f90fe",
                                        "glosses": [
                                            "A very soft landing."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fe8e92fb-dd45-32fb-85c6-47413287adc8",
                                        "entry_id": "0ea0a4a4-5650-35f8-979a-a4dc8c1f90fe",
                                        "glosses": [
                                            "A Latin American, especially a Mexican."
                                        ],
                                        "tags": [
                                            "US",
                                            "ethnic",
                                            "offensive",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "700a5674-7bcf-4223-bd98-d1e9e53261de",
                                                "sense_id": "fe8e92fb-dd45-32fb-85c6-47413287adc8",
                                                "text": "A pair of Greasers were ahead of me, but I could see only their outlines, and they didn't seem to interfere any with the scenery."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86700036-7d63-339a-a7f1-aba0a85c739d",
                                        "entry_id": "0ea0a4a4-5650-35f8-979a-a4dc8c1f90fe",
                                        "glosses": [
                                            "An Italian."
                                        ],
