                        "sense_id": "c72596f2-4a1b-3231-80e4-0ba27afde1e5",
                        "entry_id": "dfb764f1-a2d8-3a7f-92db-6bd4c460617a",
                        "glosses": [
                            "heel hoge snelheid"
