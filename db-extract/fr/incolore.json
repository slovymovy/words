                                "target_senses": [
                                    {
                                        "sense_id": "48ee108c-76d3-3fea-88a0-419ff78df492",
                                        "entry_id": "ba200120-c99e-3bf0-8453-745d6dc563f2",
                                        "glosses": [
                                            "Having little or no colour."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c69cc614-851b-4947-8e9d-35e438cdfc9c",
                                                "sense_id": "48ee108c-76d3-3fea-88a0-419ff78df492",
                                                "text": "The servant to whom he put this question was a young fellow with chubby cheeks, small, dull eyes, and a round chin, covered with a colorless down."
                                            },
                                            {
                                                "example_id": "2a2566cd-72ee-4f23-abc5-0f6a5a2f1394",
                                                "sense_id": "48ee108c-76d3-3fea-88a0-419ff78df492",
                                                "text": "Behind him the hills are open, the sun blazes down upon fields so large as to give an unenclosed character to the landscape, the lanes are white, the hedges low and plashed, the atmosphere colourless."
                                            },
                                            {
                                                "example_id": "0da75f6c-919d-4696-9869-a3fb7070ae35",
                                                "sense_id": "48ee108c-76d3-3fea-88a0-419ff78df492",
                                                "text": "The wide prospect up stream was grey and lowering, the long still-distant waterfront of Dundee, and the Fife shore were alike colourless, and there was ample evidence of rough weather not far ahead."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4dc7cc1e-3444-39de-b0f5-4f9a3f52937e",
                                        "entry_id": "ba200120-c99e-3bf0-8453-745d6dc563f2",
                                        "glosses": [
                                            "Water white."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fd1cb6a-9414-342c-8ce1-29ebde335e21",
                                        "entry_id": "ba200120-c99e-3bf0-8453-745d6dc563f2",
                                        "glosses": [
                                            "Lacking in interest or variety."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6beb6e04-68ef-3a82-8ed2-960e4d83ca80",
                                        "entry_id": "ba200120-c99e-3bf0-8453-745d6dc563f2",
                                        "glosses": [
                                            "Neutral in opinion or allegiance; centrist"
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "13df8600-fcb1-4935-b154-e55c1fe75728",
                                                "sense_id": "6beb6e04-68ef-3a82-8ed2-960e4d83ca80",
                                                "text": "They cannot, of course, assume a colourless position because they cater to the radical rank and file and would be branded renegades."
