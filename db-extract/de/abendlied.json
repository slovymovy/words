                                "example_id": "0cb23647-fde9-4ede-ace7-21358467d7b7",
                                "sense_id": "7e57f8f3-d50c-3974-951c-a24b5423caf0",
                                "text": "Die Vögel zwitscherten ihr Abendlied.",
                                "translation": "The birds twittered their evening song.",
                                "english": "The birds twittered their evening song."
                            },
                            {
                                "example_id": "f3c9f1e7-5ab6-4662-bd94-c1b5543793ed",
                                "sense_id": "7e57f8f3-d50c-3974-951c-a24b5423caf0",
                                "text": "Er spielte Schumanns Abendlied auf dem Klavier.",
                                "translation": "He played Schumann's Abendlied on the piano.",
                                "english": "He played Schumann's Abendlied on the piano."
                            }
                        ]
