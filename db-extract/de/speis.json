                "senses": [
                    {
                        "sense_id": "83544cbc-cc02-30e0-bc26-aade753fa43f",
                        "entry_id": "8d4381db-9e66-37fa-9355-14282e13dcca",
                        "glosses": [
                            "ein kleiner und kühler Raum, in dem Lebensmittel aufbewahrt werden"
                        ],
                        "tags": [
                            "Austrian German",
                            "South German"
                        ],
                        "examples": [
                            {
                                "example_id": "c11c119a-fd17-4638-89f7-7c6e70d35801",
                                "sense_id": "83544cbc-cc02-30e0-bc26-aade753fa43f",
                                "text": "„Was früher die Speis war, ist heute der Supermarkt, und kühle Lagerkeller finden sich in mordernen Häusern nicht mehr.“"
                            },
                            {
                                "example_id": "0ddb4883-9cb9-4311-ab78-bd0b080e4ae2",
                                "sense_id": "83544cbc-cc02-30e0-bc26-aade753fa43f",
                                "text": "„Die Mama musste mit dem Mädchen im Haushaltsraum sein oder mit der Köchin in der Speis.“"
                            }
                        ],
