                                        "glosses": [
                                            "A deciduous tree, of species Robinia pseudoacacia, native to the United States; the black locust."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "206fc0f6-216a-4bf7-a42c-4adb5a2380ab",
                                                "sense_id": "7391ba77-8744-3ce0-aad3-f62a02ee0ee2",
                                                "text": "The taproots of trees like the false acacia, growing between Park Royal and Alperton, thrust deeply into the ground, while the spreading roots of the silver birch stitch the soil."
                                            }
                                        ]
                                    }
