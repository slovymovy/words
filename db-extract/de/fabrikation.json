                                        "sense_id": "937ed755-6821-3eaf-8657-6169d21db11d",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
                                        "glosses": [
                                            "The act of bringing something forward, out, etc., for use or consideration."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04924a1c-71d2-419e-9915-35a8a38ac5e7",
                                                "sense_id": "937ed755-6821-3eaf-8657-6169d21db11d",
                                                "text": "I tramped to a neighbouring market-town, and, late as the hour was, the production of a few shillings procured me supper and a night's lodging in a cheap coffee-house."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30d8bf70-84dd-3d09-9257-8ea4f29900d7",
                                        "entry_id": "7faf0549-b7fb-3522-9a91-39c94f06b4b6",
