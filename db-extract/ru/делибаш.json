                        "tags": [],
                        "examples": [
                            {
                                "example_id": "93134e94-3cd8-4069-993f-eabe8c1e56fb",
                                "sense_id": "926a780f-c8ad-365c-b697-9269d64cd8b3",
                                "text": "Делибаш на всем скаку / Срежет саблею кривою / С плеч удалую башку."
                            }
                        ]
                    },
                    {
                        "sense_id": "c08b5020-5b2c-3a19-967d-5deabe109530",
