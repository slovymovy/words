                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7294368-13b8-48cf-86d7-22179484fb45",
                                "sense_id": "ad882cc6-24e9-367f-a6fe-95280bd03fd5",
                                "text": "Les noms des individus échangés par le courrier sont une autre mine de renseignements, permettant de reconstituer les liens qui les unissent, par exemple pour repérer dans un laboratoire qui est susceptible à la fois de détenir le savoir et d’être débauchable ou manipulable..."
                            },
                            {
                                "example_id": "ff656210-2fd8-45d9-94ca-4a6cd318ab16",
                                "sense_id": "ad882cc6-24e9-367f-a6fe-95280bd03fd5",
                                "text": "Si le gouvernement persiste donc à croire qu’il pourra faire voter cette loi, il faut en déduire qu’il compte débaucher des rangs de l’opposition. Qui est «débauchable» ?"
                            },
                            {
                                "example_id": "b80d126c-7470-4e04-b2f2-5669550a08de",
                                "sense_id": "ad882cc6-24e9-367f-a6fe-95280bd03fd5",
                                "text": "En début de game, Emil joue du côté de Rosenborg, dans son pays natal, mais il est clairement débauchable pour une petite poignée de millions d’euros (moins de 5 normalement)."
                            }
                        ]
                    }
