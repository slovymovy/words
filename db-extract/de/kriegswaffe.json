                "senses": [
                    {
                        "sense_id": "7d44b1e4-2480-35c3-82da-d53591d70ddd",
                        "entry_id": "01fe32f7-d70f-32e6-bdf0-a5ff9a926311",
                        "glosses": [
                            "Waffe, die im Krieg eingesetzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "949deed4-0024-4dd6-b80b-97b99be37b20",
                                "sense_id": "7d44b1e4-2480-35c3-82da-d53591d70ddd",
                                "text": "„Der Flammenwerfer ist eine Kriegswaffe aus der Gruppe der Brandwaffen, die dazu dient, einen langen Strahl einer brennenden Flüssigkeit unter hohem Druck auf ein Ziel zu sprühen.“"
                            },
                            {
                                "example_id": "a6fc2f8c-9263-4bd4-9768-ff9019cd9118",
                                "sense_id": "7d44b1e4-2480-35c3-82da-d53591d70ddd",
                                "text": "„Dieser wird nicht als Kriegswaffe gedient haben, sondern wird sicher ebenso wie der Hut und der Torques ein Statussymbol gewesen sein, das in der jenseitigen Welt nicht fehlen durfte.“"
                            },
                            {
                                "example_id": "689e3d9b-3281-4c46-9a55-b2ec7d8938e4",
                                "sense_id": "7d44b1e4-2480-35c3-82da-d53591d70ddd",
                                "text": "„Ein Pilzsammler hat in einem Waldstück in Dortmund am Freitag einen Rucksack mit Handgranaten und Munition für Kriegswaffen gefunden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2a00f4eb-d811-4e62-b39a-9771ad5b2555",
