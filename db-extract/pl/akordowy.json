                                                "sense_id": "7436286e-4459-391b-a93c-3960e7c8908d",
                                                "text": "Die Manufaktur schloss einen Akkord mit ihren Gläubigern ab."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
