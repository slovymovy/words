                ],
                "senses": [
                    {
                        "sense_id": "0ea59fde-4eb5-3eda-87e7-60e13b89bfd6",
                        "entry_id": "b2c507dc-2745-32a0-8063-195168461372",
                        "glosses": [
                            "Irradier, rendre radioactif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "474c1c30-a00d-438f-b663-2f70f7dfea38",
                                "sense_id": "0ea59fde-4eb5-3eda-87e7-60e13b89bfd6",
                                "text": "En avril 1951, alerte à la guerre nucléaire : le général Mac Arthur, qui est destitué in extremis se propose de pulvériser les centres industriels de la Mandchourie avec une trentaine de bombes atomiques et de radio-activer toute la Corée du Nord."
                            },
                            {
                                "example_id": "0525ebd8-5dd4-4971-a929-55b79222efdb",
                                "sense_id": "0ea59fde-4eb5-3eda-87e7-60e13b89bfd6",
                                "text": "On peut, de façon très simple, radio-activer diverses substances, de l’eau par exemple."
                            },
                            {
                                "example_id": "607f5466-732e-46bf-b7d2-8829bb20792f",
                                "sense_id": "0ea59fde-4eb5-3eda-87e7-60e13b89bfd6",
                                "text": "La seconde méthode qui doit être employée seule en Pharmacologie consiste à radio-activer les produits par addition ou incorporation de sels de radium."
                            }
                        ]
                    }
                ],
