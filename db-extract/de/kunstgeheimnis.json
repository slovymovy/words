                        "entry_id": "fff72093-afd4-33a8-ab53-16b1581b9d2f",
                        "glosses": [
                            "besonderes Wissen oder Können auf dem Gebiet eines Berufes, das sich ein Einzelner dieses Berufes oder der gesamte Berufsstand vorbehält, um ein Monopol auf dieses Wissen oder Können zu wahren und daraus allein den Nutzen ziehen zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2bb181c-68e8-4ab4-8108-016b01bdbee9",
                                "sense_id": "34dc97d2-f9e6-39aa-bc72-c3c50314c617",
                                "text": "Er offenbarte uns das Kunstgeheimnis aus dem Elbsande Gold zu waschen."
                            },
                            {
                                "example_id": "3549b78f-5422-492e-b0c4-6adafa50500f",
                                "sense_id": "34dc97d2-f9e6-39aa-bc72-c3c50314c617",
                                "text": "Die Lehrzeit dauerte fünf bis sieben Jahre, und bei der feierlichen Lossprechung musste der Geselle unter anderem eidlich geloben, das Kunstgeheimnis zu bewahren."
                            }
                        ],
