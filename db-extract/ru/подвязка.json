                "senses": [
                    {
                        "sense_id": "50866ea1-aec1-3416-a416-492abf711e97",
                        "entry_id": "b85369e0-ddfe-304f-aab1-93d1e14b7d89",
                        "glosses": [
                            "резинка или тесёмка для фиксации чулка на ноге"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f30fe26-9e32-4ca4-95c2-f9dcf4ce85d9",
                                "sense_id": "50866ea1-aec1-3416-a416-492abf711e97",
                                "text": "Я стосковался по девушке на низких каблуках, с обыкновенными резиновыми подвязками, придерживающими чулки, с большим зонтиком, который защищал бы нас обоих от дождя и солнца."
                            }
                        ]
                    }
                ],
