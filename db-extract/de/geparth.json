                ],
                "senses": [
                    {
                        "sense_id": "24a4ec19-5ad5-3bc3-ad82-f27114b88207",
                        "entry_id": "b5f894aa-434a-337b-8c86-8005fe9db39d",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60f58d11-8580-4950-991f-dd32caef72f2",
                                "sense_id": "24a4ec19-5ad5-3bc3-ad82-f27114b88207",
                                "text": "Frau Geparth ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "875398c9-ad69-4765-bc72-8489c10a4592",
                                "sense_id": "24a4ec19-5ad5-3bc3-ad82-f27114b88207",
                                "text": "Herr Geparth wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a97467ff-e608-4974-96d8-f1c45d3524ba",
                                "sense_id": "24a4ec19-5ad5-3bc3-ad82-f27114b88207",
                                "text": "Die Geparths fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "7adf9623-ec12-48db-9041-60d985e1a6c8",
                                "sense_id": "24a4ec19-5ad5-3bc3-ad82-f27114b88207",
                                "text": "Der Geparth trägt nie die Schals, die die Geparth ihm strickt."
                            },
                            {
                                "example_id": "3c23801e-c1a6-4e95-962e-00500ecf5536",
                                "sense_id": "24a4ec19-5ad5-3bc3-ad82-f27114b88207",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Geparth kommt, geht der Herr Geparth.“"
                            },
                            {
                                "example_id": "62c9af9c-05bb-41a9-ab6b-442b5e233816",
                                "sense_id": "24a4ec19-5ad5-3bc3-ad82-f27114b88207",
                                "text": "Geparth kommt und geht."
                            },
                            {
                                "example_id": "6a6acb8f-4fa7-4229-9c21-385c6f47ab97",
                                "sense_id": "24a4ec19-5ad5-3bc3-ad82-f27114b88207",
                                "text": "Geparths kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
