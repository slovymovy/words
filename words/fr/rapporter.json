{
    "word_family": [
        "rapport",
        "rapporteur",
        "rapporteuse",
        "rapportage"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a99da84f-9639-3db9-a50b-ab76fa452482",
                    "sense_definition": "Remettre un objet à l'endroit où il était ou à la personne à qui il appartient.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "restitution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>rapporter</w> ce livre à la bibliothèque avant la fin de la semaine."
                        },
                        {
                            "text": "Elle a promis de me <w>rapporter</w> les clés demain matin."
                        }
                    ],
                    "synonyms": [
                        "rendre",
                        "restituer"
                    ],
                    "antonyms": [
                        "garder",
                        "emprunter"
                    ],
                    "common_phrases": [
                        "rapporter un livre",
                        "rapporter les clés"
                    ]
                },
                {
                    "sense_id": "2d4df51e-e2e1-3ec9-b445-de8e346f40aa",
                    "sense_definition": "Apporter un objet ou un souvenir d'un endroit d'où l'on revient.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "retour",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes parents vont me <w>rapporter</w> un cadeau typique de leurs vacances."
                        },
                        {
                            "text": "Ils ont <w>rapporté</w> de magnifiques souvenirs de leur séjour à la montagne."
                        }
                    ],
                    "common_phrases": [
                        "rapporter des souvenirs",
                        "rapporter un cadeau"
                    ]
                },
                {
                    "sense_id": "1fd5bb56-1f61-34d4-aebb-4d2e9a02b452",
                    "sense_definition": "Prendre et ramener un objet lancé, en parlant d'un chien dressé.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune chien adore courir dans le parc et <w>rapporter</w> la balle."
                        },
                        {
                            "text": "Je lui lance une branche de bois pour qu'il la <w>rapporte</w> aussitôt."
                        }
                    ],
                    "common_phrases": [
                        "rapporter la balle",
                        "rapporter le bâton"
                    ]
                },
                {
                    "sense_id": "dbdb0043-c3d3-38dd-9e64-47d45e9e763a",
                    "sense_definition": "Faire le récit de ce qu'on a vu, entendu ou appris.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "recit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le journaliste a fidèlement <w>rapporté</w> les faits lors de son émission du soir."
                        },
                        {
                            "text": "Elle nous a <w>rapporté</w> en détail toute la conversation qu'elle avait entendue."
                        }
                    ],
                    "synonyms": [
                        "relater",
                        "raconter"
                    ],
                    "antonyms": [
                        "taire",
                        "dissimuler"
                    ],
                    "common_phrases": [
                        "rapporter les faits",
                        "rapporter des propos"
                    ]
                },
                {
                    "sense_id": "0bcd3c7e-0c7b-30a8-b078-2323135b7660",
                    "sense_definition": "Produire un revenu, un gain financier ou un profit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette nouvelle activité commerciale peut <w>rapporter</w> gros à court terme."
                        },
                        {
                            "text": "Son placement bancaire lui <w>rapporte</w> chaque année un petit bénéfice régulier."
                        }
                    ],
                    "synonyms": [
                        "produire",
                        "générer"
                    ],
                    "antonyms": [
                        "coûter"
                    ],
                    "common_phrases": [
                        "rapporter gros",
                        "rapporter un bénéfice"
                    ]
                },
                {
                    "sense_id": "91cee607-3631-3115-a6f5-9c4c92c4d1e5",
                    "sense_definition": "Dénoncer ou répéter par indiscrétion les fautes ou actions de quelqu'un.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "denonciation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les enfants détestent cet élève qui va toujours tout <w>rapporter</w> aux parents."
                        },
                        {
                            "text": "Mon petit frère passe ses journées à <w>rapporter</w> mes bêtises à notre mère."
                        }
                    ],
                    "synonyms": [
                        "cafter",
                        "moucharder"
                    ],
                    "common_phrases": [
                        "rapporter les bêtises",
                        "tout rapporter aux parents"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé dans le milieu scolaire ou familial"
                        }
                    ]
                },
                {
                    "sense_id": "b4f6f1dd-8aea-3155-8641-05b08a7c7a00",
                    "sense_definition": "Avoir un lien direct ou faire référence à quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette remarque importante vient se <w>rapporter</w> au sujet principal du document."
                        },
                        {
                            "text": "Toutes ces observations scientifiques se <w>rapportent</w> à une même théorie bien connue."
                        }
                    ],
                    "synonyms": [
                        "concerner",
                        "correspondre"
                    ],
                    "common_phrases": [
                        "se rapporter au sujet",
                        "se rapporter au texte"
                    ]
                },
                {
                    "sense_id": "6e00430f-1d79-3d17-b6f9-3714e90942ae",
                    "sense_definition": "Annuler ou abroger un acte juridique, une décision ou un décret officiel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le gouvernement a finalement décidé de <w>rapporter</w> un décret face à l'opposition populaire."
                        },
                        {
                            "text": "Le préfet a été contraint de <w>rapporter</w> un arrêté municipal jugé non conforme."
                        }
                    ],
                    "synonyms": [
                        "abroger",
                        "annuler",
                        "révoquer"
                    ],
                    "antonyms": [
                        "promulguer",
                        "maintenir"
                    ],
                    "common_phrases": [
                        "rapporter un décret",
                        "rapporter un arrêté"
                    ]
                }
            ]
        }
    ]
}