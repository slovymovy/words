                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "571bf0a5-27db-3b78-adc8-029b632fd927",
                                        "entry_id": "b2466391-b082-3913-8c45-c6f338dac966",
                                        "glosses": [
                                            "In a frugal manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae685dd2-3f96-4409-8bc9-9e61e54428ba",
                                                "sense_id": "571bf0a5-27db-3b78-adc8-029b632fd927",
                                                "text": "When they are at work they live most frugally, denying themselves every comfort and luxury till they have made a \"pile.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4a7750a-bd5c-4441-a7de-2c7cc6458e8a",
                        "source_entry_id": "63efbe11-0474-3cca-a10d-98ec70b199c7",
                        "source_sense_id": "cb4636b7-b0c7-3c48-bf04-0e213e351916",
                        "target_lang_word": "economically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "economically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5fad61de-ce2f-3ec0-a14a-a494b3ce0a08",
                                        "entry_id": "7763e3c6-3870-3465-ae6f-70e63b847a98",
                                        "glosses": [
                                            "In an economical manner; not wastefully; not extravagantly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a092a5bf-ffd6-3ab0-a08a-20c8d3e4a8f0",
                                        "entry_id": "7763e3c6-3870-3465-ae6f-70e63b847a98",
                                        "glosses": [
                                            "From the perspective of economics or an economy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "312ca667-52d5-4f34-a6ef-24ecfbc95f6d",
                                                "sense_id": "a092a5bf-ffd6-3ab0-a08a-20c8d3e4a8f0",
                                                "text": "Kim Jong-il, who has died aged 69, was the general secretary of the Workers party of Korea, and head of the military in the Democratic People's Republic of Korea (DPRK). He was one of the most reclusive and widely condemned national leaders of the late 20th and early 21st century, leaving his country diplomatically isolated, economically broken and divided from South Korea."
                                            },
                                            {
                                                "example_id": "e13a950a-a5ff-46b7-9cb7-e0111efe5078",
                                                "sense_id": "a092a5bf-ffd6-3ab0-a08a-20c8d3e4a8f0",
                                                "text": "More than 40% of Dominicans are economically vulnerable and are at risk of falling into poverty due to climate-related impacts and economic crises, according to the World Bank."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73805b68-77f5-363f-a0f8-bee2d3dcafee",
                                        "entry_id": "7763e3c6-3870-3465-ae6f-70e63b847a98",
                                        "glosses": [
                                            "According to divine economy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd5f7e58-658f-49ef-9a57-784474e03193",
                        "source_entry_id": "63efbe11-0474-3cca-a10d-98ec70b199c7",
                        "source_sense_id": "cb4636b7-b0c7-3c48-bf04-0e213e351916",
                        "target_lang_word": "économiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "économiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d374424-d105-3b0a-911e-30061a528fe1",
                                        "entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                                        "glosses": [
                                            "Avec économie, à peu de frais."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94337bb3-3ee2-482a-aeeb-17b6cd1b5a51",
                                                "sense_id": "7d374424-d105-3b0a-911e-30061a528fe1",
                                                "text": "Certaines personnes essaient de vivre économiquement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b073c32-5b60-3879-b9fa-306c78aa4189",
                                        "entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                                        "glosses": [
                                            "Selon les principes de l'économie politique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1c05a67e-cda8-4a88-a8d2-6e770fcbadf6",
                                                "sense_id": "9b073c32-5b60-3879-b9fa-306c78aa4189",
                                                "text": "La fissiparité qui accompagne les crises économiques sera d'autant plus grande que l'entité considérée sera elle-même hétérogène économiquement et politiquement : or, l'Union européenne n'est justement pas un État-nation aux aux compétences fortes, stables et incontestées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5fd8a05f-12b6-3210-8399-c48a717e885f",
                                        "entry_id": "bb3e40fd-ab55-38fc-8b55-dc41ba164767",
                                        "glosses": [
                                            "Du point de vue économique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c09ad70b-baa9-4e01-a028-df1769487077",
                                                "sense_id": "5fd8a05f-12b6-3210-8399-c48a717e885f",
                                                "text": "Dans une société économiquement complexe et culturellement diversifiée comme la nôtre, plusieurs sont en position d'autorité pour parler d'un sujet précis en raison de leur profession ou de leur expérience personnelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d2025f33-e077-480f-969b-cf7d60078584",
                        "source_entry_id": "63efbe11-0474-3cca-a10d-98ec70b199c7",
                        "source_sense_id": "cb4636b7-b0c7-3c48-bf04-0e213e351916",
                        "target_lang_word": "petitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "petitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                        "entry_id": "b0426c4a-d205-329a-82bf-eecbbb5ce91f",
                                        "glosses": [
                                            "En petite quantité, peu, pas beaucoup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1081c796-462b-459c-ba67-d2d9d0b61e66",
                                                "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                                "text": "Xanthippe… ne pouvait supporter l’économie de son père, qui ne fournissait que bien petitement à ses plaisirs,"
                                            },
                                            {
                                                "example_id": "f4a802b7-2807-430b-8b23-c8e50186e6c3",
                                                "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                                "text": "Le marquis : êtes-vous un peu de nos amis ? — Lépine : Petitement,"
                                            },
                                            {
                                                "example_id": "999729bb-454f-4202-990a-ddf1a394fd3e",
                                                "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                                "text": "Le sac à vent était d’une belle peau, chaussée d’une taie d’indienne rayée bleu et blanc ; et tout le travail était agencé d’une mode si savante, qu’il ne fallait que bouffer bien petitement pour enfler le tout et envoyer un son pareil à un tonnerre. — (George Sand, Les Maîtres sonneurs, George Bell and sons, 1908, page 58)"
                                            },
                                            {
                                                "example_id": "ab9bc43a-f441-4d36-aefc-a89436f53be4",
                                                "sense_id": "7df067c6-5db6-321b-9a59-1ad3291c92bf",
                                                "text": "On l’avait employé petitement, ici ou là, au hasard du besoin. Il prenait les taupes dans les prés ; on le demandait pour conduire les bêtes aux foires ; on lui faisait ramasser des pierres ou tailler à la faucille les haies de broussailles : toutes besognes menues qu’on lui proposait par charité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8980e51e-ccd6-3e66-9d62-1920268c576f",
                                        "entry_id": "b0426c4a-d205-329a-82bf-eecbbb5ce91f",
                                        "glosses": [
                                            "Mesquinement, chétivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0be98f53-c322-4364-b40a-21ff30cbabd8",
                                                "sense_id": "8980e51e-ccd6-3e66-9d62-1920268c576f",
                                                "text": "Il vit petitement."
                                            },
                                            {
                                                "example_id": "df8c4583-bc49-4e02-aca9-9231b30d0045",
                                                "sense_id": "8980e51e-ccd6-3e66-9d62-1920268c576f",
                                                "text": "Notre docteur régalait sa moitié\nPetitement ; enfin c’était pitié. (cité par Littré)"
                                            },
                                            {
                                                "example_id": "77845089-9594-4069-b82c-27198412515e",
                                                "sense_id": "8980e51e-ccd6-3e66-9d62-1920268c576f",
                                                "text": "Le salaire de Sylvie leur permettait de vivre petitement : c’était, à Sfax, le mode de vie le plus répandu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50e4f820-17a0-3e5f-96c9-1e1307eb1dc2",
                                        "entry_id": "b0426c4a-d205-329a-82bf-eecbbb5ce91f",
                                        "glosses": [
                                            "À l'étroit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d3b167e-cf21-4ddd-bd0f-56a45afda942",
                                                "sense_id": "50e4f820-17a0-3e5f-96c9-1e1307eb1dc2",
                                                "text": "Être logé petitement."
                                            },
                                            {
                                                "example_id": "23b5bd68-2817-4537-8d98-e26385c80599",
                                                "sense_id": "50e4f820-17a0-3e5f-96c9-1e1307eb1dc2",
                                                "text": "– Il nous invite au restaurant. Il aura jugé qu’il était trop petitement installé pour vous recevoir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "607199fc-a0e2-3bf7-8aa4-af30c0c825c3",
                                        "entry_id": "b0426c4a-d205-329a-82bf-eecbbb5ce91f",
                                        "glosses": [
                                            "Avec petitesse, sans grandeur, sans élévation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff626d4f-c625-4a4a-8913-370f66abfd13",
                                                "sense_id": "607199fc-a0e2-3bf7-8aa4-af30c0c825c3",
                                                "text": "C’est penser petitement. Il s’est vengé petitement."
                                            },
                                            {
                                                "example_id": "31d712e1-8234-427b-a928-ee351ba03ea1",
                                                "sense_id": "607199fc-a0e2-3bf7-8aa4-af30c0c825c3",
                                                "text": "Cela est petitement fait, mal agencé,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
