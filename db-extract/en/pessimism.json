                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8b0ddc1d-1b91-37a0-b257-46768deeee0e",
                                        "entry_id": "0949d906-5bdb-30ea-8887-dee215a025d0",
                                        "glosses": [
                                            "eine verneinende Lebensauffassung, die mit Hoffnungslosigkeit, Schwarzseherei und gedrückter Stimmung einhergeht"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f89e611a-b120-4130-9ea0-72c58b964f41",
                                                "sense_id": "8b0ddc1d-1b91-37a0-b257-46768deeee0e",
                                                "text": "Deinen permanenten Pessimismus kann ich nicht mehr ertragen!"
                                            },
                                            {
                                                "example_id": "95f4d264-1ade-464e-a438-0f63c46c7024",
                                                "sense_id": "8b0ddc1d-1b91-37a0-b257-46768deeee0e",
                                                "text": "„Der Pessimismus ihrer Mutter ließ Sylvia nicht unberührt, aber er schreckte sie nicht ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
