                        "glosses": [
                            "oliwkowy o ciemnym odcieniu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "209551ce-8190-4b9b-8464-0aa6da07069e",
                                "sense_id": "b872f220-bd75-3f76-b12a-b091c4bde11e",
                                "text": "W dniu, kiedy nastąpił zgon, denat ubrany był w kurtkę ciemnooliwkową, zapinaną na zatrzaski"
                            },
                            {
                                "example_id": "5892d3b5-218e-433b-b5bc-c28b4eb8e7ea",
                                "sense_id": "b872f220-bd75-3f76-b12a-b091c4bde11e",
                                "text": "Kolor samochodów jest ciemnooliwkowy, powszechnie stosowany w europejskiej strefie klimatycznej, ale nie pasuje do pustynnego terenu"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
