                "senses": [
                    {
                        "sense_id": "ac34df99-0909-36a9-b3fe-88e50d7981f6",
                        "entry_id": "64d367f1-8b43-39da-8bc3-1c78cb57d362",
                        "glosses": [
                            "Person, die sich im Sport um Ausrüstung, Geräte, Kleidung oder Verpflegung von Spielern und Trainern kümmert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11ce11f3-35ca-4246-9ad4-aace5c52c894",
                                "sense_id": "ac34df99-0909-36a9-b3fe-88e50d7981f6",
                                "text": "„Bei guten Zeugwarten gibt es auf Wunsch auch mal ein Stück Schokolade oder ein paar Gummibärchen als Sonderwunsch – ohne Wissen des Trainers.“"
                            },
                            {
                                "example_id": "d5318f38-f1ed-4f3c-96c0-cbb5c73e518a",
                                "sense_id": "ac34df99-0909-36a9-b3fe-88e50d7981f6",
                                "text": "„Zeugwarte gehören zum Team und sorgen hinter den Kulissen für ein reibungsloses Fußballspiel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "dcfdad77-1bac-3b07-aff1-9e91ba9f6003",
                        "entry_id": "64d367f1-8b43-39da-8bc3-1c78cb57d362",
                        "glosses": [
                            "Person, die in der Armee für Material und Ausrüstung verantwortlich war"
                        ],
                        "tags": [
                            "outdated"
                        ],
                        "examples": [
                            {
                                "example_id": "6ef25887-704c-47e2-8a96-b2c5db71332b",
                                "sense_id": "dcfdad77-1bac-3b07-aff1-9e91ba9f6003",
                                "text": "„Eigentlicher Aufseher über das Zeughaus war der Zeugwart, der neben der Sicherung und Verwahrung von Geschützen und Munition auch die Oberleitung über die vielen verschiedenen Handwerker hatte, die für das Amt arbeiteten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
