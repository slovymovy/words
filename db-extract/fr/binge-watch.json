                        "sense_id": "11c93bd8-98d2-3104-90d8-7eb26445a267",
                        "entry_id": "e6024b16-09c4-30a5-a112-4ee908718cfc",
                        "glosses": [
                            "Variante de binge-watcher (regarder en un temps court de grosses quantités de films ou épisodes de séries)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ff9bc7f-3764-4d62-985a-e1e737932a43",
                                "sense_id": "11c93bd8-98d2-3104-90d8-7eb26445a267",
                                "text": "Qu’on binge-watch frôlant l’indigestion ou qu’on picore un épisode ponctuellement, nous sommes 69% à suivre au moins une série par mois."
                            },
                            {
                                "example_id": "ab0b9ca6-b46e-4008-a518-d757dae3ef0a",
                                "sense_id": "11c93bd8-98d2-3104-90d8-7eb26445a267",
                                "text": "Pour m’occuper l’esprit, je binge-watch tout ce qui me passe sous les yeux, jusqu’à la série documentaire Netflix sur Ted Bundy, qui d’ailleurs est mon conseil du mois."
                            },
                            {
                                "example_id": "8a9a7646-a7c3-4c16-8a80-3f585c868dcf",
                                "sense_id": "11c93bd8-98d2-3104-90d8-7eb26445a267",
                                "text": "Pas assez nombreuses pour que je binge-watch cette série."
                            },
                            {
                                "example_id": "1a08d0aa-deb6-4963-839b-92fab6f833be",
                                "sense_id": "11c93bd8-98d2-3104-90d8-7eb26445a267",
                                "text": "On fait quoi quand on est malade ? On binge-watch !"
                            }
                        ]
                    }
                ],
                "translations": [
