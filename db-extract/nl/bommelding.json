                "senses": [
                    {
                        "sense_id": "2f873829-aa81-3854-9952-143e16a9c8d4",
                        "entry_id": "d946c9f8-1f69-3134-91f3-bbf29487aa27",
                        "glosses": [
                            "een mededeling dat er een bom gaat ontploffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a58a90b2-61da-4d5f-945e-507a03cb2716",
                                "sense_id": "2f873829-aa81-3854-9952-143e16a9c8d4",
                                "text": "Bommeldingen blijken in de meeste gevallen vals te zijn."
                            },
                            {
                                "example_id": "db64432e-04e1-489f-a2aa-2613f09441f6",
                                "sense_id": "2f873829-aa81-3854-9952-143e16a9c8d4",
                                "text": "Hij kreeg hierdoor te maken met onder meer doodsbedreigingen en bommeldingen op de faculteit. In 2009 blikte de criminoloog in gesprek met het Leids Universitair Weekblad Mare terug op die periode. \"Ik schermde zo goed mogelijk mijn gezin af, maar dat lukte natuurlijk slecht.\" Zo kreeg hij ook telefonisch bedreigingen en werd er poep door de brievenbus gegooid."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "929b9662-6b2f-4c62-9a9d-eac4f6523225",
                        "source_entry_id": "d946c9f8-1f69-3134-91f3-bbf29487aa27",
                        "source_sense_id": "2f873829-aa81-3854-9952-143e16a9c8d4",
                        "source_sense_description": "een mededeling dat er een bom gaat ontploffen",
                        "target_lang_word": "Bombenalarm",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bombenalarm",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "234b03d9-d166-36cc-98fb-190352b509bc",
                                        "entry_id": "7eb64f29-06a3-373d-b55c-92a2ae176fea",
                                        "glosses": [
                                            "Warnung der Öffentlichkeit vor einer Bombe oder einem bevorstehenden Bombardement"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f14815e-b576-43f0-b46b-5ec30cdbdde9",
                                                "sense_id": "234b03d9-d166-36cc-98fb-190352b509bc",
                                                "text": "Wegen eines herrenlosen Koffers in der Abflughalle wurde Bombenalarm ausgelöst."
                                            },
                                            {
                                                "example_id": "8f3e4861-0f12-4ea4-8861-80eae5796fbf",
                                                "sense_id": "234b03d9-d166-36cc-98fb-190352b509bc",
                                                "text": "In den letzten Kriegsjahren verging fast keine Nacht ohne Bombenalarm."
                                            },
                                            {
                                                "example_id": "804d0912-3f81-42a7-b137-a248a912cc2d",
                                                "sense_id": "234b03d9-d166-36cc-98fb-190352b509bc",
                                                "text": "„Zum nächstgelegenen, öffentlichen Bunker brauchte man zehn bis fünfzehn Minuten. Zu weit und zu gefährlich, um bei Bombenalarm hinzulaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c105295-bb9d-4567-a8e2-4b313c8bb53c",
                        "source_entry_id": "d946c9f8-1f69-3134-91f3-bbf29487aa27",
                        "source_sense_id": "2f873829-aa81-3854-9952-143e16a9c8d4",
                        "source_sense_description": "een mededeling dat er een bom gaat ontploffen",
                        "target_lang_word": "Bombendrohung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bombendrohung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04959632-8c72-3ed0-9583-1b957efda672",
                                        "entry_id": "b818cc2c-2b70-3e08-8c60-1c4c968ee47c",
                                        "glosses": [
                                            "eine Drohung, dass an einer bestimmten Stelle eine Bombe platziert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78d0d28-c869-4a13-8237-d410ed64ca36",
                                                "sense_id": "04959632-8c72-3ed0-9583-1b957efda672",
                                                "text": "Die Bombendrohung versetzte das gesamte Flughafensicherheitspersonal in helle Aufregung."
                                            },
                                            {
                                                "example_id": "c8a528e2-e0f7-4a07-b9e2-8f74cb310e7a",
                                                "sense_id": "04959632-8c72-3ed0-9583-1b957efda672",
                                                "text": "„Die New Yorker Freiheitsstatue ist nach einer Bombendrohung vorübergehend evakuiert worden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
