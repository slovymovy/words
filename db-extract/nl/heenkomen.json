                        "examples": [
                            {
                                "example_id": "77c41226-8765-4a32-b5b7-eeba1314cab9",
                                "sense_id": "cca7db5a-ac56-3fc9-b917-ea79945b0c90",
                                "text": "Iedereen vertrok, zocht ergens een heenkomen. We hadden vrienden in Amerika, in San Francisco. Ze vroegen of we kwamen."
                            }
                        ]
                    },
                    {
                        "sense_id": "74a1113e-27ab-35ba-804d-6e63f368a204",
