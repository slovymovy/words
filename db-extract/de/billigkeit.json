                ],
                "senses": [
                    {
                        "sense_id": "bdbf7424-8e97-3c5e-b905-1ed8a6bffd90",
                        "entry_id": "5a9249de-62f8-3401-998f-61883b271e1a",
                        "glosses": [
                            "Eigenschaft, preisgünstig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0d6e789-c78f-44b3-ab45-3921c0568e09",
                                "sense_id": "bdbf7424-8e97-3c5e-b905-1ed8a6bffd90",
                                "text": "„Die größere Billigkeit der Produktion führt also zur Produktion im großen, diese führt im allgemeinen wieder größere Billigkeit herbei, diese ruft wieder eine noch massenhaftere Produktion hervor, die wiederum eine noch größere Billigkeit erzeugt usf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7724b4dc-771e-34e8-a25b-973f7ae53f1f",
                        "entry_id": "5a9249de-62f8-3401-998f-61883b271e1a",
                        "glosses": [
                            "Eigenschaft, qualitativ minderwertig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2c65637-aa87-497d-8634-cd8581e20809",
                                "sense_id": "7724b4dc-771e-34e8-a25b-973f7ae53f1f",
                                "text": "Die Billigkeit der Waren an diesem Verkaufsstand ist ihnen anzusehen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "3cef5266-4bc4-320e-bf40-e5404573e34d",
                        "entry_id": "5a9249de-62f8-3401-998f-61883b271e1a",
                        "glosses": [
                            "Eigenschaft, als angemessen/gerecht empfunden zu werden"
                        ],
                        "tags": [
                            "gehoben",
                            "outdated",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "ed456d9a-2b8d-4415-a801-ff52eca76817",
                                "sense_id": "3cef5266-4bc4-320e-bf40-e5404573e34d",
                                "text": "„Daß diese Frauen befleckt und erniedrigt waren, weckte in mir, fernab von der Billigkeit humanitären Mitleids, das tragische Melos der Erschütterung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dee99428-ff06-4cbe-9241-cccb16df0272",
                        "source_entry_id": "5a9249de-62f8-3401-998f-61883b271e1a",
                        "source_sense_id": "bdbf7424-8e97-3c5e-b905-1ed8a6bffd90",
                        "source_sense_description": "Preisgünstigkeit",
                        "target_lang_word": "cheapness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheapness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "047308da-e505-3564-ad78-467365506793",
                                        "entry_id": "882468e5-4b88-335c-8f0d-5776a22ff761",
                                        "glosses": [
                                            "The state or character trait of being cheap (stingy)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2757f04c-a198-4925-a6c8-2d9b1df4c298",
                                                "sense_id": "047308da-e505-3564-ad78-467365506793",
                                                "text": "His cheapness was legendary; he refused to use candles or lamps, not to reduce the risk of fire but rather to save a penny."
                                            },
                                            {
                                                "example_id": "b0ceb683-1ae9-4b12-8fe2-be29f19ee7f1",
                                                "sense_id": "047308da-e505-3564-ad78-467365506793",
                                                "text": "Her mother, in 1684, retiring with'her daughter, for cheapness, to some place in Surrey, (she does not tell us where,) became acquainted with Dr. Glisson […]"
                                            },
                                            {
                                                "example_id": "bba3d071-5261-4cd1-b187-e6d1d0af5955",
                                                "sense_id": "047308da-e505-3564-ad78-467365506793",
                                                "text": "Mrs. Jallatt didn't study cheapness, but somehow she generally attained it."
                                            },
                                            {
                                                "example_id": "c7fbb6df-b073-4f96-a2da-5435e4053cf1",
                                                "sense_id": "047308da-e505-3564-ad78-467365506793",
                                                "text": "He was also interested in the cost of book production, as can be seen in his article on the cheapness of papyrus as a writing material."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcb1427d-ef7f-36e6-b7bb-0cf736abe144",
                                        "entry_id": "882468e5-4b88-335c-8f0d-5776a22ff761",
                                        "glosses": [
                                            "The state or characteristic of being cheap (whether inexpensive, poorly made, or both)."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "09bac6eb-f57d-420e-b001-f9de58bb3243",
                                                "sense_id": "dcb1427d-ef7f-36e6-b7bb-0cf736abe144",
                                                "text": "It seems to me that whoever at the Department of Transport or the train operating companies, or both, is specifying the standard of seats these days has taken leave of their senses and opted for cheapness over comfort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44092b4-6993-3174-b0ce-4bb9647a5b3b",
                                        "entry_id": "882468e5-4b88-335c-8f0d-5776a22ff761",
                                        "glosses": [
                                            "The state or characteristic of being cheap (whether inexpensive, poorly made, or both).",
                                            "Synonym of shoddiness."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbb2b85a-5962-4f3f-b697-2b3e73185323",
                                                "sense_id": "d44092b4-6993-3174-b0ce-4bb9647a5b3b",
                                                "text": "The cheapness of the manufacturing is insulting. [the product is poorly made]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70a3027c-3759-3e18-bb10-e01296fdf4a3",
                                        "entry_id": "882468e5-4b88-335c-8f0d-5776a22ff761",
                                        "glosses": [
                                            "The state or characteristic of being cheap (whether inexpensive, poorly made, or both).",
                                            "Synonym of inexpensiveness; affordability."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "495f097a-15b0-4c33-aa9d-384d8a2c0d54",
                                                "sense_id": "70a3027c-3759-3e18-bb10-e01296fdf4a3",
                                                "text": "The cheapness of the offerings is amazing. [the prices are surprisingly good]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
