                                        "sense_id": "d4f70f87-1061-3ddf-8c6c-8eedd07e5e4b",
                                        "entry_id": "9c217d71-5912-3115-b6b2-211a17808bd3",
                                        "glosses": [
                                            "eine meist aus Latex bestehende Hülle, die vor dem Geschlechtsverkehr über das männliche Glied gestreift wird, um vor Schwangerschaften und sexuell übertragbaren Krankheiten zu schützen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1ac3a98-9623-4e64-976a-f6d6d7b15bcb",
                                                "sense_id": "d4f70f87-1061-3ddf-8c6c-8eedd07e5e4b",
                                                "text": "Tina, was kosten die Präservative?"
                                            },
                                            {
                                                "example_id": "cb1fef40-6924-4253-9f5e-45f20b05fc1c",
                                                "sense_id": "d4f70f87-1061-3ddf-8c6c-8eedd07e5e4b",
                                                "text": "„Was das Präservativ anbetrifft, so schien seine Zeit auch wegen des Penizillins, das die Syphilis besiegt hatte, abgelaufen.“"
                                            },
                                            {
                                                "example_id": "d39c44b9-cd4c-48a6-b44d-aadf3cabf168",
                                                "sense_id": "d4f70f87-1061-3ddf-8c6c-8eedd07e5e4b",
                                                "text": "„Der Syndikus zog sogleich ein Paket feiner englischer Präservative aus der Tasche und pries diese wunderbaren Schutzmittel gegen ein Unglück, daß eine schreckliche Reue zur Folge haben könne.“"
                                            },
                                            {
                                                "example_id": "90674852-b915-4105-bd1f-7e732aa1f336",
                                                "sense_id": "d4f70f87-1061-3ddf-8c6c-8eedd07e5e4b",
                                                "text": "„Wenig später werden in der Zentrale Präservative aus einem großen Karton verteilt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c69382f-a22c-4ff6-9dd2-900ae2cfcd52",
                        "source_entry_id": "eb94e6dd-4e8d-3e50-a3be-f6cffb5caadb",
