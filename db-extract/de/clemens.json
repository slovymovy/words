                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8616bfa-273a-315e-8f61-24df65526896",
                                        "entry_id": "6f465aba-33b5-37a6-80c3-d08226beb49f",
                                        "glosses": [
                                            "Nom de famille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2b50592-6c13-4123-8e76-552f84376a42",
                                                "sense_id": "d8616bfa-273a-315e-8f61-24df65526896",
                                                "text": "C’est une deuxième défaite d’affilée pour les hommes de Peter Bosz, qui stagnent à la 5ᵉ place du classement de Ligue I, et voient revenir ceux de Philippe Clément à seulement deux petits points, à la 7ᵉ place."
                                            },
                                            {
                                                "example_id": "972ab4d6-4581-4877-8222-e97da7cedab8",
                                                "sense_id": "d8616bfa-273a-315e-8f61-24df65526896",
                                                "text": "Léa Salamé, coanimatrice aux côtés de Hugo Clément, se définit, elle, comme « une convertie de la dernière heure »."
                                            },
                                            {
                                                "example_id": "2602d008-370f-483c-984a-1faca1fcd9f5",
                                                "sense_id": "d8616bfa-273a-315e-8f61-24df65526896",
                                                "text": "« Si cela peut permettre de faire en sorte que les gens roulent moins vite, cela fera plus de sécurité et moins de nuisance sonore pour tout le monde », constate le maire de la commune, Jean-Philippe Dugoin-Clément."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Clément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "03403125-2891-3986-9496-06028b5cf765",
                                        "entry_id": "cbd6f21f-d2ab-306d-ae3a-f777c4a6e9cd",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70aa0ae9-8f09-43f0-b937-41752767c92d",
                                                "sense_id": "03403125-2891-3986-9496-06028b5cf765",
                                                "text": "Ce brassage ne plaît pas au slalomeur Clément Noël, qui a dénoncé le « manque de cohérence » de la bulle mise en place sur la Coupe du monde."
                                            },
                                            {
                                                "example_id": "94e5b2b6-5254-4693-8b5c-319478fce230",
                                                "sense_id": "03403125-2891-3986-9496-06028b5cf765",
                                                "text": "À partir de l’extrait d’un livre de Gaston Deschamps, le photographe Clément Chapillon joue avec le lecteur grâce à des feuilles transparentes."
                                            },
                                            {
                                                "example_id": "9901c3e1-7499-452c-8d3e-6c21b930162a",
                                                "sense_id": "03403125-2891-3986-9496-06028b5cf765",
                                                "text": "Clément Nourisson, un Costarmoricain de 31 ans, a été tué par balles, le 17 juillet, à Abidjan, en Côte-d’Ivoire, où il travaillait pour le compte de Bouygues Construction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49bdef63-2d73-3399-afe7-f56c2b8feb38",
                                        "entry_id": "cbd6f21f-d2ab-306d-ae3a-f777c4a6e9cd",
                                        "glosses": [
                                            "Clément d'Alexandrie, théologien et philosophe chrétien du début du IIIᵉ siècle."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
