{
    "word_family": [
        "travel",
        "traveler",
        "travelogue"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5522c309-e9b5-3326-ae3d-4fcdb7ad5481",
                    "sense_definition": "Present participle and gerund of <w>travel</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>traveling</w> to Japan next week for a holiday.",
                            "target_lang_translations": {
                                "ru": "На следующей неделе она <w>едет</w> в Японию в отпуск.",
                                "zh": "她下周要<w>去</w>日本度假。"
                            }
                        },
                        {
                            "text": "We have been <w>traveling</w> by car for six hours.",
                            "target_lang_translations": {
                                "ru": "Мы <w>едем</w> на машине уже шесть часов.",
                                "zh": "我们已经开车<w>旅行</w>了六个小时。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола travel (путешествовать).",
                        "zh": "动词 travel 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествующий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "путешествуя",
                                "target_lang_sense_clarification": "деепричастие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旅行",
                                "target_lang_sense_clarification": "指去往某地或进行长途移动"
                            },
                            {
                                "target_lang_word": "出差",
                                "target_lang_sense_clarification": "指因公出差"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1c77797-be12-36e0-84be-caf6a679bc03",
                    "sense_definition": "The activity of going from one place to another, typically over a long distance.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Traveling</w> is one of my favorite hobbies.",
                            "target_lang_translations": {
                                "ru": "<w>Путешествия</w> — одно из моих любимых хобби.",
                                "zh": "<w>旅行</w>是我最喜欢的爱好之一。"
                            }
                        },
                        {
                            "text": "Her job requires a lot of <w>traveling</w> throughout the year.",
                            "target_lang_translations": {
                                "ru": "Её работа требует частых <w>разъездов</w> в течение года.",
                                "zh": "她的工作需要全年频繁地<w>出差</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "touring",
                        "journeying",
                        "travel"
                    ],
                    "common_phrases": [
                        "love of traveling",
                        "safe traveling",
                        "traveling expenses"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность по перемещению из одного места в другое, обычно на большие расстояния.",
                        "zh": "从一地前往另一地的活动，通常指长距离的移动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "путешествие",
                                "target_lang_sense_clarification": "процесс или факт поездки"
                            },
                            {
                                "target_lang_word": "поездки",
                                "target_lang_sense_clarification": "множественное число, часто используется для описания деятельности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "旅行",
                                "target_lang_sense_clarification": "指远距离的游历或出行"
                            },
                            {
                                "target_lang_word": "出差",
                                "target_lang_sense_clarification": "指因工作需要而进行的频繁往返"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7df5b3ae-3fee-3d34-bfcd-558a32e3c9b5",
                    "sense_definition": "A violation in basketball where a player takes too many steps without dribbling the ball.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The referee blew the whistle to call a <w>traveling</w> violation.",
                            "target_lang_translations": {
                                "ru": "Судья дал свисток, чтобы зафиксировать <w>пробежку</w>.",
                                "zh": "裁判吹哨判罚了一次<w>走步</w>违例。"
                            }
                        },
                        {
                            "text": "He lost possession of the ball because of <w>traveling</w>.",
                            "target_lang_translations": {
                                "ru": "Он потерял мяч из-за <w>пробежки</w>.",
                                "zh": "他因为<w>走步</w>而丢掉了球权。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "called for traveling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нарушение правил в баскетболе, когда игрок делает слишком много шагов без ведения мяча.",
                        "zh": "篮球运动中的违例，指球员在未运球的情况下移动过多步数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пробежка",
                                "target_lang_sense_clarification": "термин в баскетболе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "走步",
                                "target_lang_sense_clarification": "篮球术语，指违例动作"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8a958824-6798-3e98-8be5-f65a3cc2bfc6",
                    "sense_definition": "Relating to or used by someone who moves from place to place, often for work.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He works as a <w>traveling</w> salesman for a large company.",
                            "target_lang_translations": {
                                "ru": "Он работает <w>разъездным</w> торговым представителем в крупной компании.",
                                "zh": "他在一家大公司担任<w>外勤</w>销售员。"
                            }
                        },
                        {
                            "text": "I need a good <w>traveling</w> bag for my upcoming trip.",
                            "target_lang_translations": {
                                "ru": "Мне нужна хорошая <w>дорожная</w> сумка для предстоящей поездки.",
                                "zh": "我需要一个好的<w>旅行</w>包来应对即将到来的行程。"
                            }
                        }
                    ],
                    "synonyms": [
                        "itinerant",
                        "touring",
                        "mobile",
                        "wandering",
                        "roving",
                        "nomadic"
                    ],
                    "common_phrases": [
                        "traveling companion",
                        "traveling salesman",
                        "traveling exhibition"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к кому-то или используемый кем-то, кто переезжает с места на место.",
                        "zh": "与经常因工作或生活需要而四处奔波的人有关，或供其使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дорожный",
                                "target_lang_sense_clarification": "предназначенный для путешествий (о вещах)"
                            },
                            {
                                "target_lang_word": "странствующий",
                                "target_lang_sense_clarification": "о людях, артистах"
                            },
                            {
                                "target_lang_word": "передвижной",
                                "target_lang_sense_clarification": "о выставках, цирках"
                            },
                            {
                                "target_lang_word": "разъездной",
                                "target_lang_sense_clarification": "связанный с частыми поездками по работе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "巡回",
                                "target_lang_sense_clarification": "指在不同地点进行表演或工作"
                            },
                            {
                                "target_lang_word": "旅行",
                                "target_lang_sense_clarification": "指用于旅行的物品"
                            },
                            {
                                "target_lang_word": "外勤",
                                "target_lang_sense_clarification": "指需要经常在外奔波的工作性质"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}