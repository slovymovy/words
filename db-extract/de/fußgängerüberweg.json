                    {
                        "translation_id": "a022d373-0a22-497f-8e60-6a6e4dfd7208",
                        "source_entry_id": "2414de7e-ec6a-34a8-9789-3226c36985e7",
                        "source_sense_id": "aaa9d4cf-934d-3d42-855d-9a6302d5280a",
                        "source_sense_description": "Querungsanlage auf Straßen für Fußgänger",
                        "target_lang_word": "zebra",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zebra",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56be487b-f721-3f63-b539-ef6bffa1b325",
                                        "entry_id": "b17bf0aa-33fd-3ec8-ab37-bea117b5a8db",
                                        "glosses": [
                                            "Any of three species of subgenus Hippotigris: Equus grevyi, E. quagga, or E. zebra, all with black and white stripes and native to Africa."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95d35059-b80c-4273-aeef-c759d390214d",
                                                "sense_id": "56be487b-f721-3f63-b539-ef6bffa1b325",
                                                "text": "A group of zebras can be called a dazzle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d67d76a-fefc-3a20-8fdf-9a5d6009f05a",
                                        "entry_id": "b17bf0aa-33fd-3ec8-ab37-bea117b5a8db",
                                        "glosses": [
                                            "A referee."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ace99b85-18d0-3d8e-94ca-a5b8eea2e5ff",
                                        "entry_id": "b17bf0aa-33fd-3ec8-ab37-bea117b5a8db",
                                        "glosses": [
                                            "An unlikely diagnosis, especially for symptoms probably caused by a common ailment."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0242571-096a-4a4f-8dc7-c963a8044556",
                                                "sense_id": "ace99b85-18d0-3d8e-94ca-a5b8eea2e5ff",
                                                "text": "\"It's a zebra! George. OK, I should explain. A zebra is...\"\n\"Medical slang for coming to an exotic diagnosis when a more simple explanation is more likely.\"\n\"That's right. I was convinced that George, given his age and symptoms, had some kind of cardiac issue. It fit, it made sense. Because I was looking for the obvious when I should have been looking for the zebra! George is just having an allergic reaction to a combination of chemicals from all the stains and paints he's been using in the garage.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9334cfd0-a4e1-3e26-aaac-f4e618a66276",
                                        "entry_id": "b17bf0aa-33fd-3ec8-ab37-bea117b5a8db",
                                        "glosses": [
                                            "Someone who has Ehlers-Danlos syndrome or hypermobility spectrum disorder"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "df094429-5b15-40f0-80cc-8365e3a88d18",
                                                "sense_id": "9334cfd0-a4e1-3e26-aaac-f4e618a66276",
                                                "text": "EDS charities around the world use a zebra logo to promote the idea that sometimes it really is that ‘rare’ condition."
                                            },
                                            {
                                                "example_id": "40e17bba-f0be-4ef4-93ea-6a5ed1abb401",
                                                "sense_id": "9334cfd0-a4e1-3e26-aaac-f4e618a66276",
                                                "text": "“I was told in medical school, ‘when you hear hoofbeats think horses, not zebras,’” she says. Many trainee doctors receive the same advice – when a patient presents with symptoms, “look for the common thing.” That’s why EDS patients commonly refer to themselves as zebras – and also use the fabulous collective noun “dazzle.” The name represents rarity and evokes the stripy stretch marks that are a common feature on EDS skin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0bcbfdf-41bd-3ad3-9e5f-123f4b6ac662",
                                        "entry_id": "b17bf0aa-33fd-3ec8-ab37-bea117b5a8db",
                                        "glosses": [
                                            "A biracial person, specifically one born to a Sub-Saharan African person and a white person."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "slang",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c9fe3d4-85b0-4446-afa7-bc5f553d2086",
                                                "sense_id": "e0bcbfdf-41bd-3ad3-9e5f-123f4b6ac662",
                                                "text": "“People change countries for all kinds of reasons,” Ross tells me. “But at least one of them was that she had this light-skinned, mixed-race child who had already been called a zebra at school.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67026646-ccd4-32a5-934f-c77903353753",
                                        "entry_id": "b17bf0aa-33fd-3ec8-ab37-bea117b5a8db",
                                        "glosses": [
                                            "A zebra cichlid (Amatitlania nigrofasciata)."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5d5ae7e-79ae-33f2-91e0-c9c8ff5e3838",
                                        "entry_id": "b17bf0aa-33fd-3ec8-ab37-bea117b5a8db",
                                        "glosses": [
                                            "Any of various papilionid butterflies of the subgenus Paranticopsis of the genus Graphium, having black and white markings."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7f892546-9774-3702-849b-738a1e8103c4",
                                        "entry_id": "b17bf0aa-33fd-3ec8-ab37-bea117b5a8db",
                                        "glosses": [
                                            "A zebra crossing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09493bde-0c6c-4be0-beba-554719840641",
                                                "sense_id": "7f892546-9774-3702-849b-738a1e8103c4",
                                                "text": "On his way home he'd picked up two economy-sized bags of tortilla chips, and had dropped both when a twat in a Lexus honked him on a zebra . . ."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
