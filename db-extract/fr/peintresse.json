                                        "sense_id": "97a65527-af7f-347a-b75b-ef70e350f9dc",
                                        "entry_id": "9e56efb9-61cd-3208-bfb6-7ff1ba91f6a0",
                                        "glosses": [
                                            "A chain or rope used to attach the shank of an anchor to the side of a ship when not in use."
                                        ],
