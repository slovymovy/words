                                "target_senses": [
                                    {
                                        "sense_id": "09a7cd4c-efdc-340c-8643-2553ca7cad11",
                                        "entry_id": "a4d2e74c-3a63-3a7c-a25a-265c99f44b8e",
                                        "glosses": [
                                            "het dakloos rondzwerven, het zwerversbestaan"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ecf03210-59b5-4b57-bb95-2669357cd17f",
                                                "sense_id": "09a7cd4c-efdc-340c-8643-2553ca7cad11",
                                                "text": "In verschillende tijdvakken en landen is landloperij een strafbaar feit geweest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae9f55fb-81a4-4402-b36f-1aeeefe1b49c",
                        "source_entry_id": "00aeef24-5540-312d-a8e1-73dcb999dae5",
                        "source_sense_id": "fc43abfb-975c-3eeb-9481-96f8f917f67a",
                        "source_sense_description": "being a vagrant",
                        "target_lang_word": "vagabondage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vagabondage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76fa1faa-759d-3e0b-9e15-b90cca57b64a",
                                        "entry_id": "e7cb9f0a-3f8c-38f8-903f-e2faec17ee4e",
                                        "glosses": [
                                            "État social du vagabond."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d80ad3a-5d18-4719-b6fd-74728ed2d45d",
                                                "sense_id": "76fa1faa-759d-3e0b-9e15-b90cca57b64a",
                                                "text": "Faites exécuter vos lois contre le vagabondage; complétez-les, si elles sont imparfaites; créez-en , si vous n’en avez pas."
                                            },
                                            {
                                                "example_id": "7711b393-0ec4-4752-859c-ee1cb1609204",
                                                "sense_id": "76fa1faa-759d-3e0b-9e15-b90cca57b64a",
                                                "text": "Le vagabondage , que l'auteur appelle ailleurs un moyen de rendre la mendicité plus fructueuse , et qu'il signale comme une conséquence de la perversité autant que de l'indigence, le vagabondage est à son tour l'objet de ses prévisions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "234a9d82-c022-3710-9e6b-7f5afc5ff4c0",
                                        "entry_id": "e7cb9f0a-3f8c-38f8-903f-e2faec17ee4e",
                                        "glosses": [
                                            "Fait de vagabonder, promenade au hasard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc94d56c-010a-47bf-acda-c3d3de066b1d",
                                                "sense_id": "234a9d82-c022-3710-9e6b-7f5afc5ff4c0",
                                                "text": "On commençait à me regarder de travers dans le groupe. Je repris mes vagabondages de juif-errant."
                                            },
                                            {
                                                "example_id": "cc04dd19-2eee-4ac5-9e32-ab057bc641cd",
                                                "sense_id": "234a9d82-c022-3710-9e6b-7f5afc5ff4c0",
                                                "text": "Son allure de gentleman de club ou des hautes terres faisait le plus curieux contraste avec ce vagabondage de l’esprit, analogue à celui d’un Gérard de Nerval, quelque peu retouché par Paracelse.."
                                            },
                                            {
                                                "example_id": "1c9caa1d-e44f-4a6d-9ead-9b692a97d4e1",
                                                "sense_id": "234a9d82-c022-3710-9e6b-7f5afc5ff4c0",
                                                "text": "Ces vagabondages dans les hauts lieux littéraires de Moscou avaient un caractère délicieusement chaotique. Dans l'ancienne ruelle Hendrikov, ils pénétraient à l'intérieur de la cour de l'immeuble où, croyaient-ils à tort, Maïakovski s'était suicidé, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0ca3f2a2-25d0-3dfc-bac3-2f566e3e50a3",
                                        "entry_id": "e7cb9f0a-3f8c-38f8-903f-e2faec17ee4e",
                                        "glosses": [
                                            "Délit de toute personne qui n’a ni domicile certain ni moyens de subsistance et qui n’exerce habituellement ni métier ni profession."
                                        ],
                                        "tags": [
                                            "Droit pénal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
