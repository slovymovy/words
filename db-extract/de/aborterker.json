                                        "sense_id": "cd0f2064-040e-38f7-a118-3b987ab5d16f",
                                        "entry_id": "79c02a13-b068-3ddf-a2aa-9ce39af9613d",
                                        "glosses": [
                                            "Synonyme de lavande vraie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
