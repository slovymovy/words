                "senses": [
                    {
                        "sense_id": "8df5ea12-b576-3923-82e9-a2fa53295639",
                        "entry_id": "b956f10c-7fbf-3a4e-bed0-e21040864119",
                        "glosses": [
                            "Schriftsteller, der einen Bestseller verfasst hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7cce1155-1606-439c-b7c2-3b5152dd2999",
                                "sense_id": "8df5ea12-b576-3923-82e9-a2fa53295639",
                                "text": "Der Bestsellerautor kam verspätet zur Autogrammstunde."
                            },
                            {
                                "example_id": "44a96ac1-2d32-4294-b7ad-fff7ee16e851",
                                "sense_id": "8df5ea12-b576-3923-82e9-a2fa53295639",
                                "text": "„Der schwedische Bestsellerautor Johan Norberg ist ein leidenschaftlicher Optimist.“"
                            },
                            {
                                "example_id": "6aad0678-0ad6-4ca4-a074-f83bf56524ee",
                                "sense_id": "8df5ea12-b576-3923-82e9-a2fa53295639",
                                "text": "„Erst als er seine Biographien schrieb, über Goethe, Napoleon oder Wilhelm II., da wurde er ein Bestsellerautor und reich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
