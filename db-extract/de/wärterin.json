                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adecebe8-f362-4be3-a402-bfefd410adbe",
                                                "sense_id": "aae07ed8-5c68-3f3f-b278-95fb08935225",
                                                "text": "La République est gardienne de nos droits, de nos libertés."
                                            }
                                        ]
