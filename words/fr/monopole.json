                {
                    "sense_id": "623500c5-e304-3676-8dd2-96395aae0748",
                    "sense_definition": "Privilège ou situation de marché permettant à un seul acteur d'exploiter ou de vendre un bien ou un service sans concurrence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette entreprise ferroviaire a conservé le <w>monopole</w> des transports dans toute la région."
                        },
                        {
                            "text": "Le gouvernement a décidé d'ouvrir le marché de l'énergie et de mettre fin au <w>monopole</w> historique."
                        }
                    ],
                    "synonyms": [
                        "exclusivité"
                    ],
                    "common_phrases": [
                        "situation de monopole",
                        "monopole d'État"
                    ]
                },
                {
                    "sense_id": "f9923c9e-36ba-33d1-9d84-d70c6c197680",
                    "sense_definition": "Exclusivité morale ou intellectuelle sur un domaine, une idée ou un sentiment.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuré",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Personne ne peut prétendre détenir le <w>monopole</w> de la vérité sur ce sujet complexe."
                        },
                        {
                            "text": "Certains critiques pensent avoir le <w>monopole</w> du bon goût en matière d'art contemporain."
