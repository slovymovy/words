                "senses": [
                    {
                        "sense_id": "cbcfadb6-47cd-3026-b1e2-b2172179ca57",
                        "entry_id": "e0b5df6e-e77b-3e4a-bd15-9b04b409e6e0",
                        "glosses": [
                            "met hoge weerstand tegen deuken of krassen, zo hard als staal"
                        ],
                        "tags": [
                            "materiaalkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "ca9cebda-1917-4923-8fca-d0a6fd044d3a",
                                "sense_id": "cbcfadb6-47cd-3026-b1e2-b2172179ca57",
                                "text": "De staalharde en messcherpe glasdeeltjes smelten als ze de vliegtuigmotor binnenkomen, bij een temperatuur van 1.400 graden."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ad18746-b49d-33da-8041-8571e96c928d",
                        "entry_id": "e0b5df6e-e77b-3e4a-bd15-9b04b409e6e0",
                        "glosses": [
                            "buitengewoon krachtig of onwrikbaar"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "bd4b7b4f-b257-4323-8099-96ab28967bd7",
                                "sense_id": "7ad18746-b49d-33da-8041-8571e96c928d",
                                "text": "Die machine die voor mij een staalharde conclusie trekt, wat weet die nou van mij?"
                            }
                        ]
                    },
                    {
                        "sense_id": "4b5f62b3-1e9b-3cd4-96da-d5dd3fabd345",
                        "entry_id": "e0b5df6e-e77b-3e4a-bd15-9b04b409e6e0",
                        "glosses": [
                            "zonder menselijk gevoel te laten blijken"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2d93fbfa-6e71-4208-accd-307ca706aea9",
                                "sense_id": "4b5f62b3-1e9b-3cd4-96da-d5dd3fabd345",
                                "text": "Wat een ieder bijblijft die Bapak heeft ontmoet, is de combinatie van een vaderlijke glimlach en staalharde ogen, waarin geen enkele emotie te bespeuren valt."
                            }
                        ]
                    }
