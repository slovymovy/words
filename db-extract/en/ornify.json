                        "examples": [
                            {
                                "example_id": "da2d7e26-7e3a-49dc-8558-b8c7b165e674",
                                "sense_id": "ceb605a5-6966-3789-b631-3d60ab4f5c1b",
                                "text": "You marryed wiues, that are ornified with honestie, wisedome, and vertue, I doe acknowledge you to be the glory of your husbands."
                            },
                            {
                                "example_id": "fbf3a42c-5ec2-4590-9d9c-fb46dbafa9a5",
                                "sense_id": "ceb605a5-6966-3789-b631-3d60ab4f5c1b",
                                "text": "Mist' Abram, he done went an' bought dis here paycock blue ca'fsmere and dis cream lace fo' to ornify me fo' de weddin' […]"
                            }
                        ]
                    }
