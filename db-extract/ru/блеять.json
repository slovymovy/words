                "translations": [
                    {
                        "translation_id": "97c823d8-ed1c-4846-81ab-e0a3f93d11ab",
                        "source_entry_id": "11815287-f95e-326c-a7e3-9cca076fb26e",
                        "target_lang_word": "bleat",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bleat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af587554-2dc5-3832-85e4-d2b576069fae",
                                        "entry_id": "fa54f55f-d36f-3f5f-9f97-85e0fd812303",
                                        "glosses": [
                                            "The characteristic cry of a sheep or a goat."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "bleat",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "228a91e2-518a-3651-b3df-6d3d16a1bdf8",
                                        "entry_id": "938d4d8e-dbb6-377a-807b-e67ae02f8627",
                                        "glosses": [
                                            "Of a sheep or goat, to make its characteristic cry of baas; of a human, to mimic this sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bc7633f-0fae-4476-a9f2-74c97794ef6c",
                                                "sense_id": "228a91e2-518a-3651-b3df-6d3d16a1bdf8",
                                                "text": "In the year 1633, the Bridget Nuns, near Xanthus, behaved like sheep, jumping about and bleating continuously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5c316a2-4099-327c-b8ca-61c4ae1b5dca",
                                        "entry_id": "938d4d8e-dbb6-377a-807b-e67ae02f8627",
                                        "glosses": [
                                            "Of a person, to complain."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef9f56e0-cd97-489a-9b49-b475638feb80",
                                                "sense_id": "b5c316a2-4099-327c-b8ca-61c4ae1b5dca",
                                                "text": "The last thing we need is to hear them bleating to us about organizational problems."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e36c5d41-c23d-3172-9c3e-eb0cdfe45aef",
                                        "entry_id": "938d4d8e-dbb6-377a-807b-e67ae02f8627",
                                        "glosses": [
                                            "Of a person, to say things of little importance to the listener."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5de89410-1d1f-4bd9-84bb-0860c678e664",
                                                "sense_id": "e36c5d41-c23d-3172-9c3e-eb0cdfe45aef",
                                                "text": "She came skipping to me just now, clapping her little hands and bleating about how very, very happy she was, dear Mrs Travers. The silly young geezer. I nearly conked her one with my trowel."
                                            },
                                            {
                                                "example_id": "dd7cf134-7c55-4511-b5e0-2143dd8fd988",
                                                "sense_id": "e36c5d41-c23d-3172-9c3e-eb0cdfe45aef",
                                                "text": "I can't have, for instance, Heracles come bleating to me at some future date, asking please can he have his bow back, and getting all stroppy when I refuse to tell him where it is."
                                            },
                                            {
                                                "example_id": "af15af8d-2eba-44a5-8397-4d4d65853d1b",
                                                "sense_id": "e36c5d41-c23d-3172-9c3e-eb0cdfe45aef",
                                                "text": "Am I the odd one out for thinking this is quite alarming? That I should find it weird to see a 41-year-old influencer bleating about her “bleph”."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
