                    }
                ],
                "senses": [
                    {
                        "sense_id": "a5112940-eae6-3a3d-910e-360dee5b20aa",
                        "entry_id": "29165725-36bf-3033-9132-d92b92b5caff",
                        "glosses": [
                            "sich am menschlichen Körper etwa von den Zehen bis zur Wade befindend/ausbreitend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6868c1b-5a01-43bf-893a-51715dfe1d9f",
                                "sense_id": "a5112940-eae6-3a3d-910e-360dee5b20aa",
                                "text": "„Zickero: Manchmal treten trotz physikalischer Therapie sockenförmig empfundene Schmerzen, brennende Missempfindungen, unangenehme Kälte- oder Wärmeempfindungen, sowie Überempfindlichkeiten auf Berührungen auf.“"
                            },
                            {
                                "example_id": "de84489a-994d-440b-ab02-d97d445bc339",
                                "sense_id": "a5112940-eae6-3a3d-910e-360dee5b20aa",
                                "text": "„Wenn die Erkrankung fortschreitet, wird die Verteilung der Sensibilitätsstörungen gelegentlich als ‚handschuh- oder sockenförmig begrenzt‘ beschrieben.“"
                            },
                            {
                                "example_id": "8ca0aa2b-23ed-4ed2-b9f3-c18b99a3603a",
                                "sense_id": "a5112940-eae6-3a3d-910e-360dee5b20aa",
                                "text": "„Die Klägerin habe seit 1987 schmerzhafte, sockenförmige Missempfindungen der Füße, wobei es nachts zu Fuß- und Wadenkrämpfen sowie brennenden Missempfindungen komme.“"
                            },
                            {
                                "example_id": "22e9fda8-94dd-42be-a3ff-035f053e20fd",
                                "sense_id": "a5112940-eae6-3a3d-910e-360dee5b20aa",
                                "text": "„Dr. L. hat eine Reduzierung der Vibrationsempfindung im Knöchelbereich festgestellt, der Kläger hat außerdem Störungen beim Herabfahren am Unterschenkel bzw. handschuh- und sockenförmige Sensibilitätsstörungen angegeben.“"
                            }
                        ],
