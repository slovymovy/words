                        "source_sense_id": "604ecca0-0fc5-377e-8bed-a8b54ec87fae",
                        "source_sense_description": "Eigenschaft, schlicht (einfach, nicht komplex) zu sein",
                        "target_lang_word": "plainness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plainness",
