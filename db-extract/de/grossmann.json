                ],
                "senses": [
                    {
                        "sense_id": "dda4898a-e378-3a33-a627-6d349c3893ca",
                        "entry_id": "bfa7dec2-1a40-3d82-ab2b-67290a0eeba8",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cbd235a-715b-4f73-acc6-4e8fcddc3eb7",
                                "sense_id": "dda4898a-e378-3a33-a627-6d349c3893ca",
                                "text": "Frau Grossmann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c84da924-41c6-48f5-8bb3-883f778b7f76",
                                "sense_id": "dda4898a-e378-3a33-a627-6d349c3893ca",
                                "text": "Herr Grossmann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "7f49f7e9-61ef-40f4-b96e-7e170b414100",
                                "sense_id": "dda4898a-e378-3a33-a627-6d349c3893ca",
                                "text": "Die Grossmanns fliegen heute nach Liverpool."
                            },
                            {
                                "example_id": "94f5af84-aab6-4cd8-8aa8-0a9f70530751",
                                "sense_id": "dda4898a-e378-3a33-a627-6d349c3893ca",
                                "text": "Der Grossmann trägt nie die Pullover, die die Grossmann ihm strickt."
                            },
                            {
                                "example_id": "7d9cba77-dc1b-4bd7-80fe-5b58e3d6fb6f",
                                "sense_id": "dda4898a-e378-3a33-a627-6d349c3893ca",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Grossmann kommt, geht der Herr Grossmann.“"
                            },
                            {
                                "example_id": "01db5eb7-08e2-4cb5-a68c-fa80776112f2",
                                "sense_id": "dda4898a-e378-3a33-a627-6d349c3893ca",
                                "text": "Grossmann kommt und geht."
                            },
                            {
                                "example_id": "7ba90450-fdd6-4d1c-805c-5141bfced4a2",
                                "sense_id": "dda4898a-e378-3a33-a627-6d349c3893ca",
                                "text": "Grossmanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
