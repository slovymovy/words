                "translations": [
                    {
                        "translation_id": "c014e1d4-e998-483b-8b4a-4ab13bf1618c",
                        "source_entry_id": "89bc3197-b7cc-37dd-a682-1fe5db916835",
                        "source_sense_id": "2a7000cc-463c-34f2-b2aa-8d7902cf18b9",
                        "source_sense_description": "persoon die ergens veel verstand van heeft",
                        "target_lang_word": "specialist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "specialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2dcbac37-8acc-38cd-b710-2e34e167dc77",
                                        "entry_id": "711accf7-de9d-34f6-9637-3196bb4ac6d7",
                                        "glosses": [
                                            "Specialised, involving detailed knowledge of a restricted topic."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a31a503-e979-4789-a705-12568ae1e04c",
                                                "sense_id": "2dcbac37-8acc-38cd-b710-2e34e167dc77",
                                                "text": "This was a highly specialist job, and it has been very carefully carried out so that it is very hard to see that these windows are now modern replacements."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "specialist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b71ecb1e-87f9-3cbc-981b-f0c0cdfddf70",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "Someone who is an expert in, or devoted to, some specific branch of study or research."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "537ae54b-eea7-3459-8b07-5d405033cf72",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "A player on a team who primarily employs one particular skill or takes one particular role."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8bb799f7-b8fb-3206-9925-78bb072e8d0a",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "A physician whose practice is limited to a particular branch of medicine or surgery."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75d99402-bcc3-46e4-a9bc-f831078a6abe",
                                                "sense_id": "8bb799f7-b8fb-3206-9925-78bb072e8d0a",
                                                "text": "Dr. Robert Leroy Hutton, a retired specialist in internal medicine and a well‐known diagnostician, died yesterday here."
                                            },
                                            {
                                                "example_id": "b01f1924-dcec-4983-bdee-633403423333",
                                                "sense_id": "8bb799f7-b8fb-3206-9925-78bb072e8d0a",
                                                "text": "Most Americans mistakenly believe that they must see specialists for almost every medical problem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "549f3c39-6101-3f81-970b-b0c6c0666c91",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "Any of several non-commissioned ranks corresponding to that of corporal."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "51fc3c97-a242-3bcd-bd7f-7732867da9c3",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "An organism that is specialized for a particular environment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e80f08a1-b554-4c30-8e07-ab187501d61a",
                                                "sense_id": "51fc3c97-a242-3bcd-bd7f-7732867da9c3",
                                                "text": "The tree Lepidothamnus laxifolius is a high alpine specialist found in high-altitude bog communities and in scrub."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "998e8ad7-ac69-3e46-a323-2fdca990e61f",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "A stenotopic species."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2f0fd2b-5028-305b-9993-9c12f02c161f",
                                        "entry_id": "d6af6904-27c6-39ff-96f6-576759e4de33",
                                        "glosses": [
                                            "A sixth-former at Eton College."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c417aca2-054f-432e-a19b-d38cbd0c19fd",
                        "source_entry_id": "89bc3197-b7cc-37dd-a682-1fe5db916835",
                        "source_sense_id": "2a7000cc-463c-34f2-b2aa-8d7902cf18b9",
                        "source_sense_description": "persoon die ergens veel verstand van heeft",
                        "target_lang_word": "spécialiste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spécialiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aeb7c751-1ed5-35b1-904c-c40b4e0c6fa9",
                                        "entry_id": "08dd96ec-0829-37b7-8d08-302597088593",
                                        "glosses": [
                                            "Qui maitrise une spécialité, expert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8f8b2ce-5518-4223-80a1-8ae0b4e5f64a",
                                                "sense_id": "aeb7c751-1ed5-35b1-904c-c40b4e0c6fa9",
                                                "text": "Médecin spécialiste."
                                            },
                                            {
                                                "example_id": "8a435399-4898-413e-be71-e79a6e1b3e11",
                                                "sense_id": "aeb7c751-1ed5-35b1-904c-c40b4e0c6fa9",
                                                "text": "Lecteur non spécialiste."
                                            },
                                            {
                                                "example_id": "1cec053e-bd9e-4db5-ac72-0772f76274d9",
                                                "sense_id": "aeb7c751-1ed5-35b1-904c-c40b4e0c6fa9",
                                                "text": "Je vois passer des idées qui m'étonnent, oui, qui me frappent. Il n'est pas nécessaire d'être spécialiste pour piger quelque chose à une belle réfutation, par exemple, pleine de flamme et de vigueur, avec une pointe de méchanceté."
                                            },
                                            {
                                                "example_id": "def22cdf-ef2d-4de8-9943-0aeed6c5b2bd",
                                                "sense_id": "aeb7c751-1ed5-35b1-904c-c40b4e0c6fa9",
                                                "text": "Je suis spécialiste du rêve, mademoiselle. C'est à moi que s'adressent ceux des inventeurs qui ne font leurs trouvailles qu'en rêve, et j'ai réussi à retirer des songes des inventions aussi remarquables que le briquet-fourchette ou le livre qui se lit lui-même, qui n'auraient été sans moi que des épaves du sommeil."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spécialiste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dee5148-3073-3304-aad7-95463e5e7b1c",
                                        "entry_id": "77ef2a1b-baab-37c4-b1f6-ced3bb727ef4",
                                        "glosses": [
                                            "Celui, celle qui se spécialise dans une branche d’études."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59f995a5-c2fa-451d-b750-770763000e53",
                                                "sense_id": "3dee5148-3073-3304-aad7-95463e5e7b1c",
                                                "text": "Le spécialiste en artillerie, par exemple, peut mouvoir les canons et les faire partir, mais il ne peut pas dire sur quoi il faut tirer."
                                            },
                                            {
                                                "example_id": "bf8352f3-1b5b-47ca-80a6-58e794964344",
                                                "sense_id": "3dee5148-3073-3304-aad7-95463e5e7b1c",
                                                "text": "Telle assertion, émanant de certains spécialistes, paraîtra inacceptable à d’autres."
                                            },
                                            {
                                                "example_id": "6fd62bfa-4484-410f-9012-b3f581968bc9",
                                                "sense_id": "3dee5148-3073-3304-aad7-95463e5e7b1c",
                                                "text": "Ce miracle, ignoré du clergé local au XVIIᵉ s., est sûrement le produit de l’imagination de certains spécialistes en hagiographie."
                                            },
                                            {
                                                "example_id": "4a691301-0772-417e-80fe-84dc2bf14caf",
                                                "sense_id": "3dee5148-3073-3304-aad7-95463e5e7b1c",
                                                "text": "Quand il s'agit de leur spécialité, les spécialistes, on ne peut plus les retenir."
                                            },
                                            {
                                                "example_id": "ac491238-5fb7-4521-8357-572efd7edadc",
                                                "sense_id": "3dee5148-3073-3304-aad7-95463e5e7b1c",
                                                "text": "Cette nomenclature binomiale a été introduite, en botanique d'abord puis en zoologie, par le célèbre naturaliste suédois Cari von Linné (1707- 1778); elle est devenue une règle internationale non sans donner lieu à d’interminables querelles de spécialistes sur sa validité lorsqu'on l'applique aux animaux domestiques."
                                            },
                                            {
                                                "example_id": "f734c4ab-6715-4382-94b8-f3f9d2f423f5",
                                                "sense_id": "3dee5148-3073-3304-aad7-95463e5e7b1c",
                                                "text": "Il faudrait aussi une représentation interdisciplinaire avec des spécialistes du développement de l'enfant, des accidentologues, des ingénieurs, des urbanistes, des cliniciens, des sociologues et d'autres encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2153152f-a52f-3843-829a-bcb557b132bc",
                                        "entry_id": "77ef2a1b-baab-37c4-b1f6-ced3bb727ef4",
                                        "glosses": [
                                            "Médecin spécialiste."
                                        ],
                                        "tags": [
                                            "ellipsis",
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b4e496-3ab2-4e9d-90d1-2b7663afecc2",
                                                "sense_id": "2153152f-a52f-3843-829a-bcb557b132bc",
                                                "text": "Le cardiologue est un spécialiste des maladies du cœur."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
