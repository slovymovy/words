                                "target_lang_sense_clarification": "insect family"
                            },
                            {
                                "target_lang_word": "sphinx moth",
                                "target_lang_sense_clarification": "alternative name for hawk moth"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8685f541-ad28-3432-aa74-72f6f29d7dad",
                    "sense_definition": "Een type rog met een giftige stekel aan de staart",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dieren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De duiker moest voorzichtig zijn voor de <w>pijlstaart</w> op de zeebodem.",
                            "target_lang_translations": {
