{
    "word_family": [
        "China",
        "Sinology",
        "Sinologist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "62529ddc-db6e-3e43-a810-4f2ba753e31a",
                    "sense_definition": "Of, from, or related to China, its people, or its culture.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to celebrate the event by going to a <w>Chinese</w> restaurant.",
                            "target_lang_translations": {
                                "ru": "Мы решили отпраздновать это событие, сходив в <w>кита́йский</w> ресторан.",
                                "zh": "我们决定去一家<w>中国</w>餐馆庆祝这次活动。"
                            }
                        },
                        {
                            "text": "The <w>Chinese</w> economy has grown significantly over the last few decades.",
                            "target_lang_translations": {
                                "ru": "<w>Кита́йская</w> экономика значительно выросла за последние несколько десятилетий.",
                                "zh": "<w>中国</w>经济在过去几十年里显著增长。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Chinese food",
                        "Chinese New Year",
                        "Chinese culture",
                        "Chinese government",
                        "Chinese medicine"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к Китаю, его народу или культуре.",
                        "zh": "与中国、中国人民或中国文化有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кита́йский",
                                "target_lang_sense_clarification": "общий термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中国",
                                "target_lang_sense_clarification": "形容词，表示中国相关的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "532576da-30cd-3eae-9508-fbfac9d90a5e",
                    "sense_definition": "Of or related to the language spoken in China or its writing system.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "language_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a dictionary to help him understand the <w>Chinese</w> characters.",
                            "target_lang_translations": {
                                "ru": "Он купил словарь, чтобы помочь себе понять <w>кита́йские</w> иероглифы.",
                                "zh": "他买了一本词典来帮助他理解<w>中文</w>汉字。"
                            }
                        },
                        {
                            "text": "The students are practicing their <w>Chinese</w> pronunciation in class today.",
                            "target_lang_translations": {
                                "ru": "Сегодня на уроке студенты тренируют своё <w>кита́йское</w> произношение.",
                                "zh": "学生们今天在课堂上练习<w>中文</w>发音。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Chinese characters",
                        "Chinese language",
                        "Chinese grammar",
                        "Chinese translation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к китайскому языку или письменности.",
                        "zh": "与中国语言或其书写系统有关的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кита́йский",
                                "target_lang_sense_clarification": "о языке или иероглифах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中文",
                                "target_lang_sense_clarification": "指语言或文字"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ea8f319f-9ce5-3b86-b8d1-1d8f52272843",
                    "sense_definition": "Difficult to understand or completely incomprehensible.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "idiom",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technical instructions were all <w>Chinese</w> to me, so I asked for help.",
                            "target_lang_translations": {
                                "ru": "Технические инструкции были для меня <w>кита́йской гра́мотой</w>, поэтому я попросил помощи.",
                                "zh": "这些技术说明对我来说简直像<w>天书</w>一样，所以我请求了帮助。"
                            }
                        },
                        {
                            "text": "Without a proper explanation, the complex diagram looked like <w>Chinese</w>.",
                            "target_lang_translations": {
                                "ru": "Без надлежащего объяснения сложная схема выглядела как <w>кита́йская гра́мота</w>.",
                                "zh": "没有适当的解释，这张复杂的图表看起来就像<w>天书</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "Chinese to me"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used in the phrase 'it is all Chinese to me'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Непонятный, сложный для понимания (используется в идиомах).",
                        "zh": "难以理解或完全无法理解的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кита́йская гра́мота",
                                "target_lang_sense_clarification": "идиома: что-то непонятное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天书",
                                "target_lang_sense_clarification": "比喻难以理解的文字或内容"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "29ae05da-4e65-33d1-aa88-bd1caa20b0dc",
                    "sense_definition": "The standard language or language family spoken in China, including Mandarin and Cantonese.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "language_name",
                    "name_type": "language_name",
                    "examples": [
                        {
                            "text": "She is learning to speak <w>Chinese</w> so she can work in Beijing.",
                            "target_lang_translations": {
                                "ru": "Она учится говорить <w>по-кита́йски</w>, чтобы работать в Пекине.",
                                "zh": "她正在学习说<w>中文</w>，这样她就能在北京工作了。"
                            }
                        },
                        {
                            "text": "Do you know how to say hello in <w>Chinese</w>?",
                            "target_lang_translations": {
                                "ru": "Ты знаешь, как сказать \"привет\" <w>по-кита́йски</w>?",
                                "zh": "你知道怎么用<w>中文</w>说你好吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "Mandarin"
                    ],
                    "common_phrases": [
                        "speak Chinese",
                        "learn Chinese",
                        "fluent in Chinese",
                        "traditional Chinese"
                    ],
                    "target_lang_definitions": {
                        "ru": "Китайский язык.",
                        "zh": "中国使用的标准语言或语族，包括普通话和粤语等。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кита́йский язы́к",
                                "target_lang_sense_clarification": "язык"
                            },
                            {
                                "target_lang_word": "кита́йский",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中文",
                                "target_lang_sense_clarification": "指语言"
                            },
                            {
                                "target_lang_word": "汉语",
                                "target_lang_sense_clarification": "指语言"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84aa173f-133e-3646-ab71-d2680357d004",
                    "sense_definition": "The people who are citizens of China or of Chinese descent, considered as a group.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "people_group",
                    "name_type": "ethnic_group_name",
                    "examples": [
                        {
                            "text": "The <w>Chinese</w> have a very long and rich history of art and invention.",
                            "target_lang_translations": {
                                "ru": "У <w>кита́йцев</w> очень долгая и богатая история искусства и изобретений.",
                                "zh": "<w>中国人</w>在艺术和发明方面有着非常悠久而丰富的历史。"
                            }
                        },
                        {
                            "text": "Many <w>Chinese</w> celebrate the Mid-Autumn Festival with mooncakes.",
                            "target_lang_translations": {
                                "ru": "Многие <w>кита́йцы</w> отмечают Праздник середины осени лунными пряниками.",
                                "zh": "许多<w>中国人</w>会吃月饼来庆祝中秋节。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Chinese"
                    ],
                    "target_lang_definitions": {
                        "ru": "Китайский народ, граждане Китая как группа.",
                        "zh": "中国公民或华裔群体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кита́йцы",
                                "target_lang_sense_clarification": "народ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中国人",
                                "target_lang_sense_clarification": "指代群体"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8ef5806a-2538-3842-b410-b13fa44a97fc",
                    "sense_definition": "Food prepared in the style of China; Chinese cuisine.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were too tired to cook, so we ordered <w>Chinese</w> for dinner.",
                            "target_lang_translations": {
                                "ru": "Мы слишком устали, чтобы готовить, поэтому заказали <w>кита́йскую еду́</w> на ужин.",
                                "zh": "我们太累了不想做饭，所以晚餐点了<w>中餐</w>。"
                            }
                        },
                        {
                            "text": "Do you prefer to eat Italian or <w>Chinese</w> when you go out?",
                            "target_lang_translations": {
                                "ru": "Ты предпочитаешь итальянскую или <w>кита́йскую</w> кухню, когда ходишь в ресторан?",
                                "zh": "你外出就餐时更喜欢吃意大利菜还是<w>中餐</w>？"
                            }
                        }
                    ],
                    "common_phrases": [
                        "eat Chinese",
                        "order Chinese",
                        "go for a Chinese"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "short for 'Chinese food'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Еда, приготовленная в китайском стиле; китайская кухня.",
                        "zh": "以中国风格烹饪的食物；中餐。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кита́йская ку́хня",
                                "target_lang_sense_clarification": "кулинария"
                            },
                            {
                                "target_lang_word": "кита́йская еда́",
                                "target_lang_sense_clarification": "блюда"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中餐",
                                "target_lang_sense_clarification": "指中国菜肴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3d149cb-6058-34f7-ad43-641b9102a329",
                    "sense_definition": "A person from China or of Chinese descent.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university welcomed a visiting <w>Chinese</w> to the research team.",
                            "target_lang_translations": {
                                "ru": "Университет приветствовал приезжего <w>кита́йца</w> в исследовательской группе.",
                                "zh": "大学欢迎了一位访问的<w>中国人</w>加入研究团队。"
                            }
                        },
                        {
                            "text": "He is a <w>Chinese</w> who has lived in Europe for many years.",
                            "target_lang_translations": {
                                "ru": "Он <w>кита́ец</w>, который много лет прожил в Европе.",
                                "zh": "他是一位在欧洲生活多年的<w>中国人</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек из Китая или китайского происхождения.",
                        "zh": "来自中国或具有中国血统的人。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кита́ец",
                                "target_lang_sense_clarification": "мужчина"
                            },
                            {
                                "target_lang_word": "китая́нка",
                                "target_lang_sense_clarification": "женщина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "中国人",
                                "target_lang_sense_clarification": "指个人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}