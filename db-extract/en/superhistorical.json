                        "glosses": [
                            "Above or beyond history."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "279f1df0-6866-46ca-bdfe-0482420910dd",
                                "sense_id": "85260628-84fb-37ac-93a8-3e31cd4f401e",
                                "text": "In our day Roy Basler's The Lincoln Legend and Lloyd Lewis' Myths After Lincoln have demonstrated that the most popular and admired of all American heroes has long ago been made superhistorical in myth; he has become, at least north of the Potomac, a household deity."
                            },
                            {
                                "example_id": "bea9a8e8-6a53-468d-b396-7ff9d31ab612",
                                "sense_id": "85260628-84fb-37ac-93a8-3e31cd4f401e",
                                "text": "It is rather that, precisely because it is fraught with history, a work like Ulysses affirms the need to see the experience simultaneously under a superhistorical sign."
                            }
                        ]
                    }
