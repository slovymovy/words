                        "examples": [
                            {
                                "example_id": "2f885a27-abd5-4beb-8c1c-87dae6e7123e",
                                "sense_id": "a3c9d305-5216-3f98-a4a7-d29b79bd6fa5",
                                "text": "Certains « gigolos » et autres « entremetteurs » exaltés, adorateurs de l'uniforme kaki qui s'autosubliment à longueur de journée, doivent comprendre que le peuple algérien dans sa majorité écrasante sait que son salut ne réside pas dans les casernes et le bruit des bottes des caporaux."
                            },
                            {
                                "example_id": "f88c903d-e669-4a8b-b1ed-7de0f77f1779",
                                "sense_id": "a3c9d305-5216-3f98-a4a7-d29b79bd6fa5",
                                "text": "Surtout dans l'optique du positionnement dans la dispensation postélectorale, chaque groupe veut s'autosublimer."
                            }
                        ]
                    }
