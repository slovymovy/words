                            },
                            {
                                "target_lang_word": "бешеный",
                                "target_lang_sense_clarification": "чрезвычайно сильный (часто о скорости)"
                            },
                            {
                                "target_lang_word": "чудовищный",
                                "target_lang_sense_clarification": "чрезмерный, неимоверный (о давлении, силе)"
