                                    {
                                        "sense_id": "d3ef7b2f-162f-329c-9354-9931db1cb952",
                                        "entry_id": "6639ca2a-2d8d-3b39-9506-a30001d20a77",
                                        "glosses": [
                                            "Landstrich im Nahbereich einer Küste"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "012fdea6-3100-48f9-b32e-3ff4d2d07a7f",
                                                "sense_id": "d3ef7b2f-162f-329c-9354-9931db1cb952",
                                                "text": "„Bis 1570 kontrollierten die Portugiesen nur einen Küstenstreifen.“"
                                            },
                                            {
                                                "example_id": "b88cc90c-fb39-4896-856f-4c8874163aa6",
                                                "sense_id": "d3ef7b2f-162f-329c-9354-9931db1cb952",
                                                "text": "„Seit gut 3000 Jahren ist der fruchtbare Küstenstreifen nördlich der Sahara immer wieder das Ziel von fremden Eroberern.“"
                                            },
                                            {
                                                "example_id": "21f8b311-e2b0-41c3-99e7-32297f1a30f9",
                                                "sense_id": "d3ef7b2f-162f-329c-9354-9931db1cb952",
                                                "text": "„Die Zone A umfasste die Stadt Triest und einen schmalen Küstenstreifen nach Norden, während die Zone B mit ihrem beinahe doppelt so großen Areal den nördlichen Teil der Halbinsel Istrien umfasste.“"
                                            },
                                            {
                                                "example_id": "e74ef24d-389b-4964-8863-c4a498ea1bce",
                                                "sense_id": "d3ef7b2f-162f-329c-9354-9931db1cb952",
                                                "text": "„Auch wenn der Ingenieur den nächstgelegenen Küstenstreifen erreichen konnte, dann war diese Stelle auch höchstens 800 m weiter weg.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4ef30d0-34b2-495b-a247-092edb075600",
                        "source_entry_id": "82656d2d-596f-3ddc-b73c-02e3d8a0df73",
                        "source_sense_id": "a8a0813e-c08b-300a-9751-e0c96b5d47d8",
                        "source_sense_description": "kustgebied",
                        "target_lang_word": "coast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79aab327-c85c-3249-80b9-adfa7d2b2181",
                                        "entry_id": "66264a61-ea6d-3375-a8a7-99a3164bcef6",
                                        "glosses": [
                                            "The edge of the land where it meets an ocean, sea, gulf, bay, or large lake."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a03b0637-edfe-4142-8501-823ebb83ca6f",
                                                "sense_id": "79aab327-c85c-3249-80b9-adfa7d2b2181",
                                                "text": "The rocky coast of Maine has few beaches."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ab2a3f56-8a9e-3176-a7ed-6f4c6c5a7228",
                                        "entry_id": "66264a61-ea6d-3375-a8a7-99a3164bcef6",
                                        "glosses": [
                                            "The side or edge of something."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49673588-9a95-43b9-8ace-61c72102bda4",
                                                "sense_id": "ab2a3f56-8a9e-3176-a7ed-6f4c6c5a7228",
                                                "text": "And the Coaſt towards which the lines KL and VX are drawn, may be call’d the Coaſt of unuſual Refraction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81f8fe9a-a4df-33cd-9013-7fc01dc2a99b",
                                        "entry_id": "66264a61-ea6d-3375-a8a7-99a3164bcef6",
                                        "glosses": [
                                            "A region of land; a district or country."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2246ce7-30b7-4f69-b8bc-4cbffb0ba7c1",
                                                "sense_id": "81f8fe9a-a4df-33cd-9013-7fc01dc2a99b",
                                                "text": "Then Herod perceavynge that he was moocked off the wyse men, was excedynge wroth, and sent forth and slue all the chyldren that were in bethleem, and in all the costes thereof […]"
                                            },
                                            {
                                                "example_id": "10c004a5-1f2e-42fb-87dd-5b8128ee7195",
                                                "sense_id": "81f8fe9a-a4df-33cd-9013-7fc01dc2a99b",
                                                "text": "P. Crescentius, in his lib. 1 de agric. cap. 5, is very copious in this subject, how a house should be wholesomely sited, in a good coast, good air, wind, etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea91bfb1-b4e2-3242-aa86-2ed64eb9cb2c",
                                        "entry_id": "66264a61-ea6d-3375-a8a7-99a3164bcef6",
                                        "glosses": [
                                            "A region of the air or heavens."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b300aed2-6462-4bde-a87b-46f93eb944ab",
                                                "sense_id": "ea91bfb1-b4e2-3242-aa86-2ed64eb9cb2c",
                                                "text": "the learned Merlin, well could tell, / Vnder what coast of heauen the man did dwell […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "coast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4620cb92-2032-3078-b4f6-31ca71e2e240",
                                        "entry_id": "e2dc449c-85f8-32e9-9640-45e21a556c09",
                                        "glosses": [
                                            "To glide along without adding energy; to allow a vehicle to continue moving forward after disengaging the engine or ceasing to apply motive power."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb956f5-1276-4e39-9474-7a397d3fa891",
                                                "sense_id": "4620cb92-2032-3078-b4f6-31ca71e2e240",
                                                "text": "When I ran out of gas, fortunately I managed to coast into a nearby gas station."
                                            },
                                            {
                                                "example_id": "3786ea71-0656-49f5-898a-005ea0f46daa",
                                                "sense_id": "4620cb92-2032-3078-b4f6-31ca71e2e240",
                                                "text": "We steamed easily across the first part of the Tay Bridge, and then after passing over the long spans in mid-stream we coasted smoothly down the 1 in 114 gradient, and around the sweeping curve through Esplanade Station."
                                            },
                                            {
                                                "example_id": "e5c50aed-dafa-4ce5-b3c1-2c0ecbebcf43",
                                                "sense_id": "4620cb92-2032-3078-b4f6-31ca71e2e240",
                                                "text": "Avanti West Coast has introduced the use of coasting with its Pendolino fleet, in an effort to keep disruption during overhead line equipment failures to a minimum. [...] The Class 390s coasted for three miles without power between Harrow & Wealdstone and Wembley Central, running under damaged OLE."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96b427d5-9d5c-3576-8124-befe833c36f8",
                                        "entry_id": "e2dc449c-85f8-32e9-9640-45e21a556c09",
                                        "glosses": [
                                            "To sail along a coast."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6e0c461-494b-4ccc-b4c0-d98485abb6ed",
                                                "sense_id": "96b427d5-9d5c-3576-8124-befe833c36f8",
                                                "text": "The Ancients coasted only in their Navigations."
                                            },
                                            {
                                                "example_id": "5af4117b-8869-48b9-abf0-e27dafd716db",
                                                "sense_id": "96b427d5-9d5c-3576-8124-befe833c36f8",
                                                "text": "The bold little ships even broke through the Gates of Hercules to the open ocean, coasting then northward to take the gold of Ireland and the tin of Cornwall, as well as southward, around the bulge of Senegal, to remote Yorubaland and the distant marts of ivory, gold, and slaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b46f0ed-5878-346c-baec-10fd6d4243e2",
                                        "entry_id": "e2dc449c-85f8-32e9-9640-45e21a556c09",
                                        "glosses": [
                                            "To make a minimal effort; to continue to do something in a routine way, without initiative or effort."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cabb347-7b61-48ef-831e-a7f831a5f420",
                                                "sense_id": "9b46f0ed-5878-346c-baec-10fd6d4243e2",
                                                "text": "Yet the truth is that City would probably have been coasting by that point if the referee, Michael Oliver, had not turned down three separate penalties, at least two of which could be accurately described as certainties."
                                            },
                                            {
                                                "example_id": "2007b6de-a334-4e47-badc-8e1f73c37cbd",
                                                "sense_id": "9b46f0ed-5878-346c-baec-10fd6d4243e2",
                                                "text": "Rehearsal goes reasonably. Wheeler long ago swore that he would never coast through a performance, and he plays decently well. But it seems to him as if a lot of the orchestra is distracted. Some cues get missed. He makes meaningful eye contact with the conductor a couple of times, and they share a frustrated look. When they break for dinner, late in the afternoon, the conductor, whose name is Luján, privately remarks to him, \"Their eyes need fixing.\""
                                            },
                                            {
                                                "example_id": "bc3b053d-3d46-4301-a7b3-218541586756",
                                                "sense_id": "9b46f0ed-5878-346c-baec-10fd6d4243e2",
                                                "text": "There’s a similar “sure but what else?” vibe to Made for Love, HBO Max’s new high-concept half-hour comedy, gently coasting on its WTF setup for longer than it should, to the detriment of the main star Cristin Milioti, trying her very best to secure our attention as it slowly drifts elsewhere."
                                            },
                                            {
                                                "example_id": "e88da560-7d53-4ae2-a46e-a8d7514018f7",
                                                "sense_id": "9b46f0ed-5878-346c-baec-10fd6d4243e2",
                                                "text": "“I just assumed that because she’s, like, really hot and got loads of followers and is Taylor’s [Taylor Fritz's] girlfriend, she’s basically coasting,” said Ms. Barber, who used the phrase “train wreck” to describe her expectations for the project."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63be36f6-6f55-3cf2-9168-cb6401b5a960",
                                        "entry_id": "e2dc449c-85f8-32e9-9640-45e21a556c09",
                                        "glosses": [
                                            "To draw near to; to approach; to keep near, or by the side of."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7339e30b-3218-42f6-b9e8-ad86f13e966c",
                                                "sense_id": "63be36f6-6f55-3cf2-9168-cb6401b5a960",
                                                "text": "Anon she hears them chant it lustily, / And all in haste she coasteth to the cry."
                                            },
                                            {
                                                "example_id": "8b30100b-8574-4d8e-89f0-21779286b568",
                                                "sense_id": "63be36f6-6f55-3cf2-9168-cb6401b5a960",
                                                "text": "The 25. day of the same moneth we fell with the Cape Cantin , vpon the coast of Barbarie , and coasting along , the 27. day we found an Island called Mogado"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1e5109a-3a30-324e-9bf4-6a97e019fcae",
                                        "entry_id": "e2dc449c-85f8-32e9-9640-45e21a556c09",
                                        "glosses": [
                                            "To sail by or near; to follow the coastline of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef823b0d-5ece-41c6-8ec8-c3c7af38cb27",
                                                "sense_id": "a1e5109a-3a30-324e-9bf4-6a97e019fcae",
                                                "text": "Nearchus, […] not knowing the compass, was fain to coast that shore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c41901c-c77f-3393-a1bd-5e21309eac8d",
                                        "entry_id": "e2dc449c-85f8-32e9-9640-45e21a556c09",
                                        "glosses": [
                                            "To conduct along a coast or river bank."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fdcb795-7817-4c05-b544-74d5da506066",
                                                "sense_id": "9c41901c-c77f-3393-a1bd-5e21309eac8d",
                                                "text": "The Indians […] coasted me a long the river."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "54eacc60-49d5-3263-bab6-13eafcfe10e2",
                                        "entry_id": "e2dc449c-85f8-32e9-9640-45e21a556c09",
                                        "glosses": [
                                            "To slide downhill; to slide on a sled upon snow or ice."
                                        ],
                                        "tags": [
                                            "US",
                                            "dialectal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8ff089e1-2e1d-48db-94c4-d2ed57ea70c3",
                        "source_entry_id": "82656d2d-596f-3ddc-b73c-02e3d8a0df73",
                        "source_sense_id": "a8a0813e-c08b-300a-9751-e0c96b5d47d8",
                        "source_sense_description": "kustgebied",
                        "target_lang_word": "littoral",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "littoral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4590b33-ab2c-346e-ac6f-4230ee6c3973",
                                        "entry_id": "a382729f-26c4-33e0-8f65-749da41ed199",
                                        "glosses": [
                                            "Relatif aux bords de la mer ou aux côtes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13eadfcf-d153-4b8c-ae66-f15ee3da950b",
                                                "sense_id": "d4590b33-ab2c-346e-ac6f-4230ee6c3973",
                                                "text": "A contrario, mais toujours à échelle régionale, les différentiels de croissance économique génèrent de puissants mouvements centripètes vers les régions et les villes en expansion : la Chine littorale en est actuellement une bonne illustration."
                                            },
                                            {
                                                "example_id": "c831ebee-275c-48ab-8536-52d9a5f13fa1",
                                                "sense_id": "d4590b33-ab2c-346e-ac6f-4230ee6c3973",
                                                "text": "Le Canada, qui a pour devise « d’un océan à l’autre », a le plus long littoral au monde."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8fe47a0-d6ec-36b5-9f2a-026a6b28ae57",
                                        "entry_id": "a382729f-26c4-33e0-8f65-749da41ed199",
                                        "glosses": [
                                            "Qualifie les plantes qui poussent au bord de la mer."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5769a75-383e-3808-809a-4438b8c5afe1",
                                        "entry_id": "a382729f-26c4-33e0-8f65-749da41ed199",
                                        "glosses": [
                                            "Qualifie des plantes ripicoles."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "877bea93-db60-4bad-bb1c-cbd2d2e783ed",
                                                "sense_id": "c5769a75-383e-3808-809a-4438b8c5afe1",
                                                "text": "D’ailleurs la richesse de la flore littorale est aussi subordonnée à l’étendue des bancs qui dépend elle-même de l’intensité des crues et de leur fréquence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "081b57e0-71af-316e-9250-ab2b012add12",
                                        "entry_id": "a382729f-26c4-33e0-8f65-749da41ed199",
                                        "glosses": [
                                            "Qualifie une construction dont tout ou partie de l’ancrage est situé dans l'eau, mais qui, d’une certaine manière, touche à la rive."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "littoral",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d7e447-b1c0-3b60-9871-d567d9b1b9b9",
                                        "entry_id": "a55a4111-07c1-3385-89ea-11d417492ed3",
                                        "glosses": [
                                            "Étendue de pays qui est au bord de la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ff9beaa-0061-402d-8f71-ef41f136da83",
                                                "sense_id": "a4d7e447-b1c0-3b60-9871-d567d9b1b9b9",
                                                "text": "La mer qui baignait ce littoral s’étendait alors sans limites devant le regard."
                                            },
                                            {
                                                "example_id": "908d422f-820d-49ab-907c-1a0313bf8d3e",
                                                "sense_id": "a4d7e447-b1c0-3b60-9871-d567d9b1b9b9",
                                                "text": "Du fond de la baie de Saint-Malo jusqu’à l'extrémité des Côtes du Nord, c’est ce qu’on nomme la ceinture dorée de la Bretagne; tout ce littoral est fertile et bien cultivé : c’est presque la Normandie."
                                            },
                                            {
                                                "example_id": "76020603-f5c9-4382-952b-c25c3babb7d0",
                                                "sense_id": "a4d7e447-b1c0-3b60-9871-d567d9b1b9b9",
                                                "text": "Deux mots encore sur la marine marocaine, cette marine si redoutée, autrefois, quand les corsaires barbaresques infestaient les eaux européennes, étendant leurs déprédations à tout le littoral méditerranéen et jusqu'aux côtes de l’Angleterre."
                                            },
                                            {
                                                "example_id": "0ceb6641-ee89-48ce-9b05-8eb459bb84d2",
                                                "sense_id": "a4d7e447-b1c0-3b60-9871-d567d9b1b9b9",
                                                "text": "La scirpaie est répartie sur de faibles surfaces, principalement sur le littoral du Finistère, les étangs palavasiens, la Camargue ainsi que dans les régions d’étangs tels que la Dombes et la Brenne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5f48ebb-5f96-30b9-8a3a-2b0140aaa0e1",
                                        "entry_id": "a55a4111-07c1-3385-89ea-11d417492ed3",
                                        "glosses": [
                                            "Espace entre le centre d'un milieu hydrique et sa ligne des hautes eaux"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b25a7de8-c120-4635-bc0f-908b59d034fa",
                                                "sense_id": "a5f48ebb-5f96-30b9-8a3a-2b0140aaa0e1",
                                                "text": "La ligne des hautes eaux est la ligne qui, aux fins de l’application de la présente politique, sert à délimiter le littoral et la rive."
                                            },
                                            {
                                                "example_id": "c6c57f65-e1cd-4a83-b6ca-27a9945a9556",
                                                "sense_id": "a5f48ebb-5f96-30b9-8a3a-2b0140aaa0e1",
                                                "text": "Les travaux dans les bandes riveraines et dans le littoral d’un milieu hydrique sont sévèrement réglementés."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf701f06-c207-4447-b277-f6823cec624a",
