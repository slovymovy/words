                        "glosses": [
                            "Person, die auf dem Sitz neben dem Fahrer/Lenker eines Fahrzeugs mitfährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d683bcc0-d7eb-4f1d-9a49-083bd06b9fb8",
                                "sense_id": "52d2e62a-be8f-3e1d-9ceb-21a3e95ba021",
                                "text": "Der Beifahrer kam bei dem Unfall ums Leben."
                            },
                            {
                                "example_id": "670943be-7087-4ba2-8175-9bad6e80285e",
                                "sense_id": "52d2e62a-be8f-3e1d-9ceb-21a3e95ba021",
                                "text": "„Hinter einer Litfaßsäule parkte ein schwarzer Horch, dessen Beifahrer die beiden durch ein Fernglas betrachtete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "77fe3d09-029d-3616-bab4-d9906c5bb2b4",
                        "entry_id": "e18cf25b-e75a-39d0-94c3-290a3d2af915",
                        "glosses": [
                            "Person, die berufsmäßig als zweiter Fahrer (bei Bus oder LKW) mitfährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e58788db-ba13-4ca4-a49a-9aa5d600dc3d",
                                "sense_id": "77fe3d09-029d-3616-bab4-d9906c5bb2b4",
                                "text": "Der Beifahrer war erkrankt und konnte den Fahrer nicht turnusgemäß ablösen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1f5b83b4-ce99-3492-b2f6-0e867ccf1358",
