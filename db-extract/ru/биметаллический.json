                                        "glosses": [
                                            "Pertaining to the use of gold and silver to create legal currency."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0923866c-fa11-4b14-81e5-47949c654453",
                                                "sense_id": "9025b60b-05db-3c92-9273-91e9c88d21e1",
                                                "text": "We well suppose that a Minister needs information as to a point which involves the Navy, India, Canada and the bimetallic question."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71969857-b0a7-3422-91bc-1866ecc44f22",
                                        "entry_id": "ac1f9a05-f75a-36a6-8254-688ec8bacd24",
                                        "glosses": [
                                            "More generally, consisting of two metals."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e56cd5ea-e730-4e00-9b1f-c0ec16619ff3",
                                                "sense_id": "71969857-b0a7-3422-91bc-1866ecc44f22",
                                                "text": "\"We have a special coupler that joins them together to prevent the bi-metallic corrosion you'd get if the stainless steel and the galvanised steel touched each other. […]\""
                                            }
                                        ]
                                    }
                                ]
                            },
