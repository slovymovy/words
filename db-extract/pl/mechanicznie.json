                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "61d3c664-8fdd-3f5c-944f-ee233ff95698",
                                        "entry_id": "a8fb092d-42b2-32e2-bb87-3561c789f422",
                                        "glosses": [
                                            "mit einer Selbstregelung ausgestattet, keine Bedienung erfordernd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eac5df07-5d87-4ca0-8bea-706d08bbb9d9",
                                                "sense_id": "61d3c664-8fdd-3f5c-944f-ee233ff95698",
                                                "text": "Die US-amerikanische Reaper-Drohne etwa fliegt automatisch weiter, wenn in engen Tälern der Kontakt zur tausende Meilen entfernten Basis abreißt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2dca21aa-8f25-3d75-94e9-806f7275f8f0",
                                        "entry_id": "a8fb092d-42b2-32e2-bb87-3561c789f422",
                                        "glosses": [
                                            "mithilfe von Automaten erfolgend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9308287-539b-47b8-a1f2-0096dfc7d3f4",
                                                "sense_id": "2dca21aa-8f25-3d75-94e9-806f7275f8f0",
                                                "text": "Viele Fertigungsprozesse laufen in der heutigen Industrie automatisch ab."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "0b259365-e6da-37ca-8545-691694dec87a",
                                        "entry_id": "a8fb092d-42b2-32e2-bb87-3561c789f422",
                                        "glosses": [
                                            "wie ein Automat, ohne Reflexion"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "48f6b07c-0520-4702-8356-cccd0fddddb6",
                                                "sense_id": "0b259365-e6da-37ca-8545-691694dec87a",
                                                "text": "Ich habe die Schlüssel automatisch eingesteckt."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "7a9c7ed8-2e80-3c06-9c00-973453361fbe",
                                        "entry_id": "a8fb092d-42b2-32e2-bb87-3561c789f422",
                                        "glosses": [
                                            "wie von selbst, kein Dazwischentreten einer Entscheidung oder weiteres Zutun erfordernd"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58395970-1b1f-43dd-8b24-942545a9580a",
                                                "sense_id": "7a9c7ed8-2e80-3c06-9c00-973453361fbe",
                                                "text": "Beim Wechsel des Arbeitsplatzes ändert sich automatisch die Dienststelle der Krankenkasse."
                                            },
                                            {
                                                "example_id": "976fb15f-595e-49f5-aaa1-be468d961a79",
                                                "sense_id": "7a9c7ed8-2e80-3c06-9c00-973453361fbe",
                                                "text": "Das ging völlig automatisch, ich hatte gar keine Chance, das zu beeinflussen."
                                            },
                                            {
                                                "example_id": "ccab741c-c8d5-43f3-8540-cb239b8943ab",
                                                "sense_id": "7a9c7ed8-2e80-3c06-9c00-973453361fbe",
                                                "text": "Und dann bist du automatisch außen vor."
                                            },
                                            {
                                                "example_id": "b12b70f5-fa18-4628-b41b-fbfc610f2678",
                                                "sense_id": "7a9c7ed8-2e80-3c06-9c00-973453361fbe",
                                                "text": "Entschuldigung, das war eine automatische Reaktion. Ich meinte das gar nicht so."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
                    }
