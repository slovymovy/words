                "senses": [
                    {
                        "sense_id": "d48cdcf4-630d-36cb-8e4e-612923fa5fcc",
                        "entry_id": "0424e5a9-3e2f-37de-a3cd-bc438879a4a1",
                        "glosses": [
                            "Relatif à la ville de Shanghaï, originaire de cette ville."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "444cdb71-4e93-4d7b-895d-c74521695940",
                                "sense_id": "d48cdcf4-630d-36cb-8e4e-612923fa5fcc",
                                "text": "Premier cas emblématique: un fabricant shanghaïen de panneaux solaires, Chaori Solar, a annoncé la semaine dernière ne pas avoir les moyens d'honorer le paiement de 89,8 millions de yuans (10,7 millions d'euros) d'intérêts sur des obligations qu'il avait émises en 2012."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "217466f0-aeb2-4813-97be-8f58b4d0dce7",
                        "source_entry_id": "0424e5a9-3e2f-37de-a3cd-bc438879a4a1",
