                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff201434-8658-4399-9c37-0463810fbb94",
                        "source_entry_id": "f655f43c-1549-3601-96f8-2464e639248f",
                        "source_sense_id": "6bbbe09e-a8b6-3df8-9321-c0b3b04cb036",
                        "source_sense_description": "Zusammenstoß, Verkehrsunfall mit vielen beteiligten Fahrzeugen",
                        "target_lang_word": "multi-vehicle collision",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "787daa97-3523-4e12-bdbf-ca4db1d1f0d9",
                        "source_entry_id": "f655f43c-1549-3601-96f8-2464e639248f",
                        "source_sense_id": "6bbbe09e-a8b6-3df8-9321-c0b3b04cb036",
                        "source_sense_description": "Zusammenstoß, Verkehrsunfall mit vielen beteiligten Fahrzeugen",
                        "target_lang_word": "pile-up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pile-up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df0fc0c3-8f7c-3b3d-afe1-0bf36f770fd3",
                                        "entry_id": "49c4bc88-989b-3710-9f8a-a88727f60602",
                                        "glosses": [
                                            "A pile, a group of people or things which have piled up on one another, especially",
                                            "A pile of crashed vehicles due to a traffic accident."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fbdb47a3-38a7-43bd-b11d-417bd243a62c",
                                                "sense_id": "df0fc0c3-8f7c-3b3d-afe1-0bf36f770fd3",
                                                "text": "Traffic was backed up for miles due to a twelve-car pile-up on the freeway earlier today."
                                            },
                                            {
                                                "example_id": "33963352-2dd4-413c-9ad4-8a2a458c4e2f",
                                                "sense_id": "df0fc0c3-8f7c-3b3d-afe1-0bf36f770fd3",
                                                "text": "Pinot was among those involved in the huge pile-up just as the race entered the final three kilometres. Grazes were visible under his torn clothing as he pedalled, with a face like thunder, to the finish line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ac5eaaa-aa3f-3e39-9437-8b5089c4427f",
                                        "entry_id": "49c4bc88-989b-3710-9f8a-a88727f60602",
                                        "glosses": [
                                            "A pile, a group of people or things which have piled up on one another, especially",
                                            "A pile of tackling players."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                        "entry_id": "49c4bc88-989b-3710-9f8a-a88727f60602",
                                        "glosses": [
                                            "An accumulation that occurs over time, especially one which is not welcome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43073ec1-52f4-42a4-a92e-50bc74fb9c45",
                                                "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                                "text": "If the supervisor deals with daily workload in an orderly way and does not put pressure on the employee about a pile-up of work, then the employee's perception of pressure will be reduced and the employee will not suffer from work pressure stress."
                                            },
                                            {
                                                "example_id": "14db3056-bf1d-436b-9443-0a26633fe32a",
                                                "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                                "text": "Evidently, the annealing in NO ambient results in a pile-up of nitrogen at the oxide/SiC interface and this results in a reduction of interface states near the conduction band edge of 4H-SiC [16,30,31]."
                                            },
                                            {
                                                "example_id": "0c0c300f-b0ac-442b-9bdb-c1502c5c77f9",
                                                "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                                "text": "Cusp-like trapezoidal shaping functions have been shown to produce the best signal-to-noise ratio and still maintain short duration to avoid pile-up of events."
                                            },
                                            {
                                                "example_id": "9cacc770-0aa4-4a2e-afbd-87744026fd25",
                                                "sense_id": "af217aa7-2c96-3070-bdf0-2773590584b3",
                                                "text": "Because family crises evolve and are resolved over a period of time, families seldom are dealing with a single stressor, but rather, our longitudinal data suggest they experience a pile-up of stressors and strains (i.e., demands), particularly in the aftermath of a major stressor, such as a death, a major role change for one member, or a natural disaster."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4eee6e22-6195-4bf1-99ec-54ac24ee1773",
                        "source_entry_id": "f655f43c-1549-3601-96f8-2464e639248f",
                        "source_sense_id": "6bbbe09e-a8b6-3df8-9321-c0b3b04cb036",
                        "source_sense_description": "Zusammenstoß, Verkehrsunfall mit vielen beteiligten Fahrzeugen",
                        "target_lang_word": "carambolage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carambolage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3078c89c-4f74-3040-9afd-713a649ce342",
                                        "entry_id": "1fb3bd5e-7847-3dc7-bcdb-a27c7d19fe75",
                                        "glosses": [
                                            "Action de caramboler."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17581586-c55e-4855-9158-65a042dd2a46",
                                                "sense_id": "3078c89c-4f74-3040-9afd-713a649ce342",
                                                "text": "Je conseillerais donc à ceux de mes lecteurs qui se proposeraient une ascension botanique au Ventoux, de ne pas se trouver à Bédoin un dimanche au soir. Ils éviteront le bruyant va-et-vient d’un café-auberge, les interminables conversations à haute voix, l’écho des carambolages de la salle de billard, le tintement des verres, la chansonnette après boire, les couplets nocturnes des passants, le beuglement des cuivres du bal voisin, et autres tribulations inévitables en ce saint jour de désœuvrement et de liesse."
                                            },
                                            {
                                                "example_id": "0736b65f-7f49-42da-8759-7aaeb5af1d43",
                                                "sense_id": "3078c89c-4f74-3040-9afd-713a649ce342",
                                                "text": "Quant à l’action de queuter ou de billarder, ce n’est pas trop, comme il est d’usage en France, de tenir pour nul le carambolage qu’on a pu faire ainsi ; il serait même juste que le fauteur fût puni de la perte d’un point, car c’est une espèce de filouterie."
                                            },
                                            {
                                                "example_id": "dba6d479-bb38-4820-87fb-21ec0b765104",
                                                "sense_id": "3078c89c-4f74-3040-9afd-713a649ce342",
                                                "text": "Le billard surtout le captivait et, à travers les vitres de l’unique café du bourg, il avait suivi d’un œil d’envie les interminables parties des amateurs de carambolages."
                                            },
                                            {
                                                "example_id": "f543fe9f-c704-4062-908e-894b3682f22a",
                                                "sense_id": "3078c89c-4f74-3040-9afd-713a649ce342",
                                                "text": "Robert est penché sur le billard, et sourit de plaisir tandis qu’il regarde avec attention, et calcule un carambolage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a1e1741-7f0e-3ed4-9df7-970b4742e34a",
                                        "entry_id": "1fb3bd5e-7847-3dc7-bcdb-a27c7d19fe75",
                                        "glosses": [
                                            "Action de percuter."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5343d70c-cd35-4d5f-a8ee-644877b1d984",
                                                "sense_id": "8a1e1741-7f0e-3ed4-9df7-970b4742e34a",
                                                "text": "[…], mais les glaces s’étant rapprochées, il fallut user des grands moyens pour nous dégager, intervention d’espars, carambolages, chocs violents ; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "429632f9-f7a6-3e2f-8c75-6bedad430fa1",
                                        "entry_id": "1fb3bd5e-7847-3dc7-bcdb-a27c7d19fe75",
                                        "glosses": [
                                            "Accident en série dans lequel plusieurs véhicules se percutent l’un l’autre."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "common"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfc0a71b-72dd-4825-9421-5d92608677fa",
                                                "sense_id": "429632f9-f7a6-3e2f-8c75-6bedad430fa1",
                                                "text": "Je n’ai aucune difficulté à croire que Zazz peut représenter un danger public derrière un volant. Je l’imagine rire tout en roulant, la fenêtre ouverte. Il y a de quoi provoquer un carambolage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
