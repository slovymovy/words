                                "target_lang_word": "разбил",
                                "target_lang_sense_clarification": "повредил что-то хрупкое (стекло, посуду)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打破",
                                "target_lang_sense_clarification": "弄碎或损坏物体"
                            },
                            {
                                "target_lang_word": "弄坏",
                                "target_lang_sense_clarification": "使机器或设备停止工作"
                            }
                        ]
