                        "examples": [
                            {
                                "example_id": "6a68512a-1aff-46ca-9e07-121ece155200",
                                "sense_id": "2fce78b2-4c6d-367e-8cae-daa74e8eeb4e",
                                "text": "For this reason it is most excellent practice to mow the weeds of Lambsquarter, Ragweed, Hog Ragweed, Bullweed, Artichoke, and in fact all other weeds large enough to sustain such borers – mowing them about the middle of the summer and again the latter part of August."
                            },
                            {
                                "example_id": "13270518-545f-4499-94ef-7439e5c9890f",
                                "sense_id": "2fce78b2-4c6d-367e-8cae-daa74e8eeb4e",
                                "text": "Along the narrow creekstone roads, the winter landscape is etched in myriad shades of brown — sedge grass and bullweed stalks, barren trees on a carpet of fallen leaves, decaying shells of unpainted houses staring blankly through vacant windows."
                            },
                            {
                                "example_id": "a12f55ef-8f63-4e48-a74c-e280dab20568",
                                "sense_id": "2fce78b2-4c6d-367e-8cae-daa74e8eeb4e",
                                "text": "Around the tower, the Citadel lay spread out like a peasant's counterpane of blackish grays and maroons and a dozen faded hues of homespun buff, stitched here and there with the dull green of dusty bullweed and cactus."
                            }
                        ]
                    }
