                    }
                ],
                "senses": [
                    {
                        "sense_id": "2726fa23-e8dd-3802-8eff-9a11093f5c39",
                        "entry_id": "4cc0388b-4c52-3151-a136-f33be0b41f3e",
                        "glosses": [
                            "Any change in a word made by altering its letters or sounds."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cda956f2-74b9-3535-bea8-067adc063d5c",
                        "entry_id": "4cc0388b-4c52-3151-a136-f33be0b41f3e",
                        "glosses": [
                            "A small particle (often nutrient) within a cell."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37ed5d97-49c9-4d91-be58-33bdfc9410ee",
                        "source_entry_id": "4cc0388b-4c52-3151-a136-f33be0b41f3e",
                        "source_sense_description": "linguistics: alteration of a word’s letters or sounds",
                        "target_lang_word": "métaplasme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "métaplasme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cb90abbf-ca14-3157-bfe9-48463125e01e",
                                        "entry_id": "69d72e42-1fa0-3e8a-b965-7e7dec929426",
                                        "glosses": [
                                            "Altération dans un mot autorisée par l’usage, au point de vue morphologique ou phonologique, ou alphabétique lorsqu’écrit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f39c6a9b-fef9-45c3-96d1-bf4c67ecf144",
                                                "sense_id": "cb90abbf-ca14-3157-bfe9-48463125e01e",
                                                "text": "Pour parler scientifiquement, l’épenthèse est un métaplasme qui se caractérise par l’insertion d’un phonème vocalique ou consonantique entre des consonnes."
                                            },
                                            {
                                                "example_id": "04b4eeff-555b-4a78-a2f5-3791f650d623",
                                                "sense_id": "cb90abbf-ca14-3157-bfe9-48463125e01e",
                                                "text": "Comme l’écrit François Charpin, « la norme se définit comme une culture » ; un barbarisme cautionné par un auteur classique devient un métaplasme : « Le barbarisme est employé dans le présent, sans référence à l’autorité d’un ouvrage, tandis que le métaplasme repose sur l’autorité des anciens auteurs »."
                                            },
                                            {
                                                "example_id": "d407ce1a-8f4b-4e16-b480-aca71b20c665",
                                                "sense_id": "cb90abbf-ca14-3157-bfe9-48463125e01e",
                                                "text": "C’est un cas intéressant, car il constitue, comme le fameux « Je n’ai personne vu », une sorte de métaplasme sur lequel sans doute des troupeaux de thèses de grammairiens broutent la poussière sur les étagères de bibliothèques universitaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3fd9f18b-4ec3-3d96-af30-9eb19ae802d5",
                                        "entry_id": "69d72e42-1fa0-3e8a-b965-7e7dec929426",
                                        "glosses": [
                                            "Ensemble des produits de l’activité du métabolisme cellulaire qui, une fois formés, demeurent dans la cellule ou à son contact (éléments de soutien, squelette interne, pigment)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c4ec2f9-1db0-4f72-876d-639652096f09",
                                                "sense_id": "3fd9f18b-4ec3-3d96-af30-9eb19ae802d5",
                                                "text": "Cette constatation clôt la discussion qui, depuis l’avènement de la doctrine cellulaire, opposait les partisans de la sécrétion du métaplasme à ceux qui soutenaient son édification exoplasmique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d99fe4b-8823-4ab6-b2f3-c61ccc29f133",
                        "source_entry_id": "4cc0388b-4c52-3151-a136-f33be0b41f3e",
                        "source_sense_description": "linguistics: alteration of a word’s letters or sounds",
                        "target_lang_word": "Metaplasmus",
