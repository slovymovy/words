                                                "text": "the lag end of my life"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76ac550b-daa1-3cba-a681-46fd0933332b",
                                        "entry_id": "e089020b-082f-37c3-ac30-f3aee1b679ac",
                                        "glosses": [
                                            "Last made; hence, made of refuse; inferior."
                                        ],
                                        "tags": [],
                                        "examples": [
