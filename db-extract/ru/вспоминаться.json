                "senses": [
                    {
                        "sense_id": "ed6cdcb7-4bfb-3521-8824-e8560cbcce3a",
                        "entry_id": "cd8e575f-eb1f-3758-be67-aae3c6b3ffc1",
                        "glosses": [
                            "страд. от вспоминать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c57b75b5-d254-4670-ad11-a3449414d78e",
                                "sense_id": "ed6cdcb7-4bfb-3521-8824-e8560cbcce3a",
                                "text": "Те, которые творили добро, и по смерти славятся, а те, которые дурно правили своим царством, и теперь вспомина́ются недобрым словом."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f64cd1b-17b7-3e2c-bd42-ea6dc540d5d9",
                        "entry_id": "cd8e575f-eb1f-3758-be67-aae3c6b3ffc1",
                        "glosses": [
                            "приходить на память, воспроизводи́ться в памяти"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97b9e18b-da02-4a21-8e51-8b058d7596e0",
                                "sense_id": "8f64cd1b-17b7-3e2c-bd42-ea6dc540d5d9",
                                "text": "Мне часто вспоминается детство."
                            },
                            {
                                "example_id": "e0fafe52-8136-4df4-8fea-d9ba5945fc73",
                                "sense_id": "8f64cd1b-17b7-3e2c-bd42-ea6dc540d5d9",
                                "text": "Мне вспоминается, что два года тому назад вы иначе думали об этом."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7139fb8d-5f76-4327-a40e-527d522c41a4",
