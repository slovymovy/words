                        "cross_references": [
                            {
                                "target_word": "zwaarwaterreactor",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "1b4d3499-e9f4-316b-81d1-ab86f6463da7",
                                        "entry_id": "43284e47-b769-3bab-8736-aedb9694ce46",
                                        "glosses": [
                                            "een kernreactor die zwaar water onder hoge druk (155 bar) gebruikt als koeling en als moderator"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dce4fefa-dd3d-44aa-a38c-20a5b0588e27",
                                                "sense_id": "1b4d3499-e9f4-316b-81d1-ab86f6463da7",
                                                "text": "De speciale ventielen zijn geleverd aan een zogeheten zwaarwaterreactor. De enige centrale van Iran daarvoor is nu in aanbouw in de stad Arak. Volgens westerse experts kan deze reactor plutonium maken voor twee nieuwe kernwapens per jaar. Westerse landen boycotten Iran om te verhinderen dat Iran een atoombom bouwt en daarmee Israël, Europa en de VS kan bedreigen."
                                            },
                                            {
                                                "example_id": "11cd295b-5110-4dc1-b72a-8daaf12be04c",
                                                "sense_id": "1b4d3499-e9f4-316b-81d1-ab86f6463da7",
                                                "text": "De Nationale Verzetsraad onthulde in 2002 het bestaan van een faciliteit waar uranium wordt verrijkt in Natanz en een zwaarwaterreactor in Arak. Volgens critici heeft de oppositiegroep echter wel eens de plank misgeslagen en opereert de raad met een politieke agenda, die is gericht op een omwenteling in het land."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
