                    {
                        "form_id": "c3b9bfbe-1d98-492c-9737-84f17e238e59",
                        "entry_id": "4076cf0a-eac8-3490-9567-f05ba1f158d0",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Todesanzeige"
                    },
                    {
                        "form_id": "b113b0cd-7c51-4144-be3b-a2196608ce9c",
                        "entry_id": "4076cf0a-eac8-3490-9567-f05ba1f158d0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Todesanzeigen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1da77e3e-751e-3a0d-a172-77f06c934172",
                        "entry_id": "4076cf0a-eac8-3490-9567-f05ba1f158d0",
                        "glosses": [
                            "Anzeige, mit der der Tod einer Person öffentlich mitgeteilt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ceff97c8-e3dc-429f-8dde-bb168f9f5ecc",
                                "sense_id": "1da77e3e-751e-3a0d-a172-77f06c934172",
                                "text": "„Bei den Todesanzeigen ist bei mir der Groschen gefallen.“"
                            },
                            {
                                "example_id": "d64a184e-e307-4326-afef-a34139e800ca",
                                "sense_id": "1da77e3e-751e-3a0d-a172-77f06c934172",
                                "text": "„Die unfreiwillige Komik bei Todesanzeigen und Grabinschriften beruht darauf, daß Tod und Sterben ohnehin Grenzsitutionen, Extremfälle sind, zu denen daher besonders leicht auch komische Kontraste hergestellt werden können.“"
                            },
                            {
                                "example_id": "e4ebf36b-29b8-476d-a300-2de65e1f7e8d",
                                "sense_id": "1da77e3e-751e-3a0d-a172-77f06c934172",
                                "text": "„Ich lese die Familiennachrichten der Zeitungen und schneide die Todesanzeigen aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6dfefc14-76d0-313d-a650-71085a488f89",
                        "entry_id": "4076cf0a-eac8-3490-9567-f05ba1f158d0",
                        "glosses": [
                            "gedruckte briefliche Mitteilung über den Tod einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "caa9159a-e75e-48e6-9d04-2c831240f73f",
                                "sense_id": "6dfefc14-76d0-313d-a650-71085a488f89",
                                "text": "„Ich hatte bei Mutters Sachen Onkel Jochens Briefe gefunden, damals, als ich nach ihrem Tod ihr altes Adressbuch suchte, weil wir doch die Todesanzeigen verschicken wollten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "88d71d1f-955a-4c3b-81d5-b2b7f156bf24",
                        "source_entry_id": "4076cf0a-eac8-3490-9567-f05ba1f158d0",
                        "source_sense_id": "1da77e3e-751e-3a0d-a172-77f06c934172",
                        "source_sense_description": "Anzeige, mit der der Tod einer Person öffentlich mitgeteilt wird",
                        "target_lang_word": "obituary",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obituary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d093a536-df1c-3090-80bb-9e1be5f34d64",
                                        "entry_id": "c7987a81-e2bb-343b-8a25-37541410d7b7",
                                        "glosses": [
                                            "A brief notice of a person's death, especially one published in a newspaper or other publication; also (obsolete), the section of a newspaper where notices of deaths are published."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9931b14-7195-46d7-bbfe-8a6e41630a01",
                                                "sense_id": "d093a536-df1c-3090-80bb-9e1be5f34d64",
                                                "text": "[N]ot one in fifty of the actual disasters and deaths by casualties in the fishery, ever finds a public record at home, however transient and immediately forgotten that record. Do you suppose that that poor fellow there, who this moment perhaps caught by the whale-line off the coast of New Guinea, is being carried down to the bottom of the sea by the sounding leviathan—do you suppose that that poor fellow's name will appear in the newspaper obituary you will read to-morrow at your breakfast?"
                                            },
                                            {
                                                "example_id": "e1fc691b-724f-4de7-9561-9e5121ae94e3",
                                                "sense_id": "d093a536-df1c-3090-80bb-9e1be5f34d64",
                                                "text": "The newspaper came in, as usual, after breakfast. I looked it over, and discovered this memorable entry, among the obituary announcements of the day:— \"On the 29th inst., at Brighton, Michael Vanstone, Esq., formerly of Zurich, aged 77.\""
                                            },
                                            {
                                                "example_id": "38ec6936-cf3d-4e7a-adea-fa3747cf3483",
                                                "sense_id": "d093a536-df1c-3090-80bb-9e1be5f34d64",
                                                "text": "“You want to know the ironic thing? I wrote my son’s obituary using ChatGPT,” Mr. Taylor said."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd66d775-d24f-3cb7-aac8-48eac44322db",
                                        "entry_id": "c7987a81-e2bb-343b-8a25-37541410d7b7",
                                        "glosses": [
                                            "A brief biography of a person (especially one who is well-known) who has recently died, usually describing their life and achievements, particularly in the form of an article in a news publication or an item in a news broadcast."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2f25b2c8-0217-403e-ac2e-4461be88e007",
                                                "sense_id": "bd66d775-d24f-3cb7-aac8-48eac44322db",
                                                "text": "You know the Greeks didn't write obituaries. They only asked one question after a man died: \"Did he have passion?\""
                                            },
                                            {
                                                "example_id": "86303b4a-ccea-4cbb-8665-da8d561fe5dd",
                                                "sense_id": "bd66d775-d24f-3cb7-aac8-48eac44322db",
                                                "text": "Obituary editors are confronted daily with the need to make delicate hermeneutic interpretations of the social meaning of individuals' deaths and to express these powerfully to their readership. […] [I draw] attention to a discrepancy that appears to exist between, on the one hand, the editors' subjective avowals about the openness of the obituary columns and, on the other hand, the objectively highly restricted origins and trajectories of the obituary subjects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3d911ba-5a64-379e-ad80-b5cfb6f951be",
                                        "entry_id": "c7987a81-e2bb-343b-8a25-37541410d7b7",
                                        "glosses": [
                                            "An announcement or description of the end of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfff7a67-ac09-42d1-a99e-0aafe8d5bd7b",
                                                "sense_id": "c3d911ba-5a64-379e-ad80-b5cfb6f951be",
                                                "text": "Mouths were agape on the announcement of England's starting lineup, the return of Keira Walsh appearing miraculous 10 days after she left the pitch on a stretcher in agony. Walsh’s World Cup obituaries were written; she was England's most valuable player, irreplaceable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3af4833-f4c8-308d-9468-94525a33ef39",
                                        "entry_id": "c7987a81-e2bb-343b-8a25-37541410d7b7",
                                        "glosses": [
                                            "A register of deaths, especially one maintained by a religious institution; a necrology."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "obituary",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "130fe8dd-e873-34c0-b0f9-b9383654dac4",
                                        "entry_id": "70bf5d5a-fa6d-3fad-b1b8-c2a2a3bcd05c",
                                        "glosses": [
                                            "Relating to obituaries."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44341151-0c6c-437f-a57b-a0d5c3730aba",
                                                "sense_id": "130fe8dd-e873-34c0-b0f9-b9383654dac4",
                                                "text": "He is the paper's obituary editor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0a25f4e-1214-4210-a0de-732dad698b07",
                        "source_entry_id": "4076cf0a-eac8-3490-9567-f05ba1f158d0",
                        "source_sense_id": "1da77e3e-751e-3a0d-a172-77f06c934172",
                        "source_sense_description": "Anzeige, mit der der Tod einer Person öffentlich mitgeteilt wird",
                        "target_lang_word": "avis de décès",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avis de décès",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d2307b5-bc6b-3df3-80e8-875f2dad033d",
                                        "entry_id": "24e372a3-a8cd-3b35-863c-34017ec79097",
                                        "glosses": [
                                            "Publication dans la presse, émanant généralement de la famille d’une personne décédée, informant les lecteurs de ce décès et souvent des dispositions prises pour une éventuelle cérémonie funéraire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e403eb39-91c7-46ec-b77e-4866cc5a7307",
                                                "sense_id": "3d2307b5-bc6b-3df3-80e8-875f2dad033d",
                                                "text": "L’une des rubriques les plus lues, dans nos journaux, est celle des avis de décès, qui ne constitue pas un apport journalistique à proprement parler, puisque son insertion est justiciable de tarifs commerciaux."
                                            },
                                            {
                                                "example_id": "7f51918b-32f0-4120-acf7-d8ab7f089993",
                                                "sense_id": "3d2307b5-bc6b-3df3-80e8-875f2dad033d",
                                                "text": "Grâce aux rubriques nécrologiques des journaux français, il est possible de publier une annonce, sous la forme d’un avis de décès, qui retrace les événements et les modalités d’organisation pour les funérailles."
                                            },
                                            {
                                                "example_id": "81a870c8-9f07-47ad-b7e8-55febd0208d7",
                                                "sense_id": "3d2307b5-bc6b-3df3-80e8-875f2dad033d",
                                                "text": "Dernier hommage important pour chacun, cette annonce permet d’organiser la cérémonie funéraire et les obsèques, en regroupant chaque personne qui aimait le défunt. Durant ces circonstances difficiles, il peut être parfois tentant d’ignorer cette étape. Pourtant, la rédaction et la publication d’un avis de décès restent une formalité assez simple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75483519-fb1d-320e-bf91-cf8e36bc6295",
                                        "entry_id": "24e372a3-a8cd-3b35-863c-34017ec79097",
                                        "glosses": [
                                            "Information par laquelle une autorité civile ou militaire avise une autre autorité, ou une famille, du décès d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6dfb446-e594-494d-b7af-e01f2b92be76",
                                                "sense_id": "75483519-fb1d-320e-bf91-cf8e36bc6295",
                                                "text": "Afin de permettre aux parents qui désireraient assister aux obsèques de leurs enfants qui viennent à mourir sous les drapeaux, de se déplacer en temps opportun, M. le ministre de la guerre a arrêté les mesures suivantes :\n« Les avis de décès seront envoyés, par le télégraphe, aux maires des communes où sont domiciliés les parents des militaires décédés. »"
                                            },
                                            {
                                                "example_id": "3f6dcd80-d8ae-4417-9316-30080832b5ed",
                                                "sense_id": "75483519-fb1d-320e-bf91-cf8e36bc6295",
                                                "text": "Les maires doivent fournir à l’autorité militaire l’avis de décès de tous les individus âgés de 20 à 45 ans, résidant dans leur commune et soumis aux obligations militaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
