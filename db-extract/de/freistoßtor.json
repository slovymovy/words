                "senses": [
                    {
                        "sense_id": "03c6a5b9-27af-3cd9-b00d-ac586a38b9b1",
                        "entry_id": "de84cc9f-e7cf-3a7d-9966-695ae84e5e57",
                        "glosses": [
                            "Tor, das durch einen Freistoß oder unmittelbar nach der Ausführung eines Freistoßes erzielt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9981e5e-03b3-423d-8877-b7a7ef15be75",
                                "sense_id": "03c6a5b9-27af-3cd9-b00d-ac586a38b9b1",
                                "text": "„Andrea Pirlo hat mit seinem Treffer zum 1:0 beim 1:1 (1:0) der Squadra Azzurra gegen Kroatien für das erste direkt verwandelte Freistoßtor seit 23 EM-Spielen gesorgt.“"
                            },
                            {
                                "example_id": "f1bd6863-57b2-411e-9db1-a3887cfef2fe",
                                "sense_id": "03c6a5b9-27af-3cd9-b00d-ac586a38b9b1",
                                "text": "„Dank eines Freistoßtores von Stephan Rahn bezwang Victoria den damaligen Zweitligaklub Rot-Weiß Oberhausen in der ersten Runde mit 1:0.“"
                            },
                            {
                                "example_id": "89b57e95-0d5f-4a44-8554-79444cb96eec",
                                "sense_id": "03c6a5b9-27af-3cd9-b00d-ac586a38b9b1",
                                "text": "„Abgeschirmt von seiner Umgebung schaute sich der Bulgare seine Freistoßtore an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
