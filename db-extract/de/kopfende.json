                "senses": [
                    {
                        "sense_id": "f638a1e5-4385-3102-9bbf-07eedcc843ac",
                        "entry_id": "50a44910-3ca5-36c7-bab0-864e27635d58",
                        "glosses": [
                            "der Teil einer Liegestatt, an dem der Kopf liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f4b87d4-8e47-436d-89a7-0f611c7464a8",
                                "sense_id": "f638a1e5-4385-3102-9bbf-07eedcc843ac",
                                "text": "„Josey stand am Kopfende des Bettes, rechter Hand von Doktor Smoaks.“"
                            },
                            {
                                "example_id": "146f238e-ef46-41d7-af85-5ada976c4985",
                                "sense_id": "f638a1e5-4385-3102-9bbf-07eedcc843ac",
                                "text": "„Die Gräfin verbrachte zwei Wochen lang ihre Nächte unausgekleidet in einem Lehnstuhl am Kopfende seines Bettes.“"
                            },
                            {
                                "example_id": "ea9ec3b4-d669-445b-8c5c-9742069fdc50",
                                "sense_id": "f638a1e5-4385-3102-9bbf-07eedcc843ac",
                                "text": "„Am Kopfende jedes Bettes stand ein Betschemel, ein Stuhl und der Koffer des Seminaristen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
