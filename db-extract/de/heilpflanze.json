                    {
                        "translation_id": "4a8e45eb-d1d8-4804-becd-70f0cbc66ce9",
                        "source_entry_id": "f927325b-77df-3b5c-a3ba-1a2ec672c87e",
                        "source_sense_id": "b1d908f2-a0b8-3b34-9ea1-3fc7693373ac",
                        "source_sense_description": "eine Pflanze, die zu Heilzwecken verwendet wird",
                        "target_lang_word": "herb",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herb",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4898df84-a22d-3180-ac23-09fde0bd656a",
                                        "entry_id": "542c047b-bf96-3bc7-9057-a9376b9284a0",
                                        "glosses": [
                                            "Any green, leafy plant, or parts thereof, used to flavour or season food."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "828b9b67-f37f-3c4d-80d3-8ad32589cd4b",
                                        "entry_id": "542c047b-bf96-3bc7-9057-a9376b9284a0",
                                        "glosses": [
                                            "A plant whose roots, leaves or seeds, etc. are used in medicine."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6f1123e-6d8f-4e11-9f7f-c5ab88e82f51",
                                                "sense_id": "828b9b67-f37f-3c4d-80d3-8ad32589cd4b",
                                                "text": "If any medicinal herbs used by witches were supposedly evil, then how come people from at least the past benefited from the healing properties of such herbs?"
                                            },
                                            {
                                                "example_id": "03f7c597-0ad8-411d-a3ac-51a956ec0912",
                                                "sense_id": "828b9b67-f37f-3c4d-80d3-8ad32589cd4b",
                                                "text": "For twenty-five years he has done all sorts of odd jobs: digging ginseng (a herb) in the Long White Mountains, fishing in the Black River, and washing gold dust at Hailanpao. Without this education, he would never have become an undaunted revolutionary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8fa2df3c-e46e-3452-8714-ea2185b7a74c",
                                        "entry_id": "542c047b-bf96-3bc7-9057-a9376b9284a0",
                                        "glosses": [
                                            "Cannabis."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f768078f-09b7-4c78-a1a9-98269b93c8b9",
                                                "sense_id": "8fa2df3c-e46e-3452-8714-ea2185b7a74c",
                                                "text": "The room was thick and sour with the smell of herb."
                                            },
                                            {
                                                "example_id": "ee327b65-bc83-4ab6-b837-37649e52c6a9",
                                                "sense_id": "8fa2df3c-e46e-3452-8714-ea2185b7a74c",
                                                "text": "You think he's got any herb?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c2065b3-9ff8-33d5-83a5-8f37142524eb",
                                        "entry_id": "542c047b-bf96-3bc7-9057-a9376b9284a0",
                                        "glosses": [
                                            "A plant whose stem is not woody and does not persist beyond each growing season"
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65ae5fd2-8340-39df-9624-066909bd0d42",
                                        "entry_id": "542c047b-bf96-3bc7-9057-a9376b9284a0",
                                        "glosses": [
                                            "Grass; herbage."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7e6a9c9-69d4-4b46-98c2-bfddac9a4bfb",
