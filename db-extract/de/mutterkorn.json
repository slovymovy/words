                        "entry_id": "a9321840-7c35-30e8-a355-9ad88d3d3f6a",
                        "glosses": [
                            "Sklerotium des Mutterkorn-Pilzes, der auf den Ähren von Roggen und einigen anderen Getreidearten wächst und giftig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "281e3e04-6345-424e-8b25-8f065db55f41",
                                "sense_id": "81dcbfc1-6094-3609-9bd9-4a0e4ab4500e",
                                "text": "Eine Vergiftung durch Mutterkorn kann das Antoniusfeuer hervorrufen."
                            }
