                "senses": [
                    {
                        "sense_id": "97b49f56-8426-3295-8585-5b4bcb9ab3e1",
                        "entry_id": "c13eb1b8-0031-367b-bbec-7e768ea7587d",
                        "glosses": [
                            "Donner un caractère tutsi à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a047466-aac1-4622-b535-186f502c7d87",
                                "sense_id": "97b49f56-8426-3295-8585-5b4bcb9ab3e1",
                                "text": "Le lignage auquel il appartenait, une fois doté d’un bétail, se voyait « dé-hutuisé », c’est-à-dire « tutsifié »."
                            },
                            {
                                "example_id": "91932808-b4d3-4742-84e6-f03b0b69a692",
                                "sense_id": "97b49f56-8426-3295-8585-5b4bcb9ab3e1",
                                "text": "De plus, un Hutu ou même un Twa peut être « tutsifié » en récompense de bons et loyaux services tandis qu’un Tutsi peut être « hutufié », ainsi l’éleveur qui perd toutes ses bêtes."
                            }
                        ]
                    }
