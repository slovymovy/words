                "senses": [
                    {
                        "sense_id": "9c925fed-bc6e-36a5-9139-2ce07191a594",
                        "entry_id": "d1a78e83-05b4-32d5-bf02-42f8fa9ac6bb",
                        "glosses": [
                            "Spécifier au préalable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "145fd247-abe9-414f-9f9a-f0d454baa056",
                                "sense_id": "9c925fed-bc6e-36a5-9139-2ce07191a594",
                                "text": "Toujours à propos d’une analyse de tâches (complexes), Bainbridge évoque la difficulté de pré-spécifier complètement le comportement des opérateurs, notamment lorsque ceux-ci doivent faire face à des situations imprévues."
                            },
                            {
                                "example_id": "50d5599a-03c8-4195-a3eb-0815866d9559",
                                "sense_id": "9c925fed-bc6e-36a5-9139-2ce07191a594",
                                "text": "Dans la réduplication totale, ayant le baoulé pour archétype, aucun trait du V (du réduplicatif) n’est pré-spécifié alors que dans la réduplication partielle, ayant l’agni comme archétype, la matrice V du réduplicatif est pourvue en trait [+HAUT]."
                            }
                        ]
                    }
