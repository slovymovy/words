                ],
                "senses": [
                    {
                        "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                        "entry_id": "f3f775cd-ce41-3695-a65b-3ac51002ab25",
                        "glosses": [
                            "die Söhne des Zebedäus, Johannes und Jakobus der Ältere, beides Jünger Jesu"
                        ],
                        "tags": [
                            "neutestamentliche Theologie; meist Plural für beide",
                            "auch Singular für einen der beiden"
                        ],
                        "examples": [
                            {
                                "example_id": "790f3fd7-a198-4fe4-aae6-1678ee189f4b",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Erst als während der Verfolgung durch König Herodes Agrippa I. im Jahr 42 n. Chr. der Zebedaide Jakobus getötet wurde und Petrus aus Jerusalem floh, übernahm offenbar Jakobus die Leitung der Gemeinde.“"
                            },
                            {
                                "example_id": "b5debae3-c0b8-44b6-86b1-c9cbf68d8240",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Nach altkirchlicher Tradition (Irenäus) ist der Zebedaide Johannes der Autor des [Johannesevangeliums].“"
                            },
                            {
                                "example_id": "dbe1d245-f662-4225-ae62-030500d6bb2e",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Ihre Reaktion gegenüber den Zebedaiden zeigt, dass sie befürchten, selbst zu kurz zu kommen.“"
                            },
                            {
                                "example_id": "2d94df91-d875-4d0b-8704-d80229f9cfae",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Dennoch ist Zebedäus zu gewisser Berühmtheit gelangt, weil seine beiden Söhne, die recht häufig vorkommende Namen trugen, zur Unterscheidung von anderen Namensträgern häufig als die „Zebedäussöhne“ (dies war im damaligen Sprachgebrauch üblich) oder „Zebedaiden“ bezeichnet wurden.“"
                            },
                            {
                                "example_id": "e90287e8-b855-4c24-83c7-a85c29d28a81",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Um 44 ließ Herodes Agrippa I. den Zebedaiden Jakobus hinrichten (Apg 12,2 EU).“"
                            },
                            {
                                "example_id": "dffe372a-09c4-4e37-92eb-b273437b7c08",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Dieser wäre nach einem Zeugnis des Bischofs Papias von Hierapolis (ca. 130; gem. Eusebius von Cäsarea, hist. eccl. 3,39,4) als „Jünger des Herrn“ deutlich von dem Apostel Johannes, dem Zebedaiden, unterschieden […].“"
                            },
                            {
                                "example_id": "e3ac9291-7634-4319-992f-336d2c1b6051",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "Die „2. Apokalypse […] [w]ird um 150 von Justin dem Märtyrer als identisch mit Johannes dem Zebedaiden erklärt.“"
                            },
                            {
                                "example_id": "d45c782e-995a-452d-9fa0-3ae4dca45e94",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Die Alte Kirche meint freilich seit Ende des 2. Jahrhunderts, der Lieblingsjünger sei der Zebedaide Johannes gewesen.“"
                            },
                            {
                                "example_id": "e8fc16c8-d5f8-4857-a412-acd70f20efdd",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Die erste Stelle nehmen die beiden Brüderpaare ein, Petrus und Andreas und die Zebedaiden Jakobus und Johannes.“"
                            },
                            {
                                "example_id": "c2276c79-1e1b-48d3-a589-29a7803f974e",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Aphraat (Demonstr. 417,10) nennt beide Zebedaiden ausdrücklich unter den apostolischen Märtyrern.“"
                            },
                            {
                                "example_id": "25fc951b-6663-42de-80d1-43680a1fa375",
                                "sense_id": "b75358b1-39cc-3406-b447-2261f109647f",
                                "text": "„Doch der Tod der Zebedaiden muss nicht gleichzeitig erfolgt sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
