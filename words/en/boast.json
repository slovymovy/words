{
    "word_family": [
        "boaster",
        "boastful",
        "boastfully",
        "boastfulness",
        "boasting"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5da4897a-1773-3740-a75a-251c7930ede1",
                    "sense_definition": "To speak with excessive pride and self-satisfaction about one's achievements, possessions, or abilities.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "bragging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He likes to <w>boast</w> about how much money he earns every month.",
                            "target_lang_translations": {
                                "ru": "Ему нравится <w>хвастаться</w> тем, сколько денег он зарабатывает каждый месяц."
                            }
                        },
                        {
                            "text": "It is not polite to <w>boast</w> about your success when others are struggling.",
                            "target_lang_translations": {
                                "ru": "Невежливо <w>хвастаться</w> своим успехом, когда другие испытывают трудности."
                            }
                        }
                    ],
                    "synonyms": [
                        "brag",
                        "crow",
                        "vaunt"
                    ],
                    "antonyms": [
                        "depreciate"
                    ],
                    "common_phrases": [
                        "boast about success",
                        "nothing to boast of"
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить с чрезмерной гордостью и самодовольством о своих достижениях, имуществе или способностях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвастаться",
                                "target_lang_sense_clarification": "говорить о себе с излишней похвальбой"
                            },
                            {
                                "target_lang_word": "хвастать",
                                "target_lang_sense_clarification": "неумеренно хвалить себя или свои вещи"
                            },
                            {
                                "target_lang_word": "бахвалиться",
                                "target_lang_sense_clarification": "разг. кичиться, выставлять напоказ"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dae672a8-3d3f-3d41-8d8f-6cd7557a8229",
                    "sense_definition": "To possess or have something that is a source of pride or a desirable feature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The luxury hotel <w>boasts</w> a private beach and three swimming pools.",
                            "target_lang_translations": {
                                "ru": "Роскошный отель <w>славится</w> собственным пляжем и тремя бассейнами."
                            }
                        },
                        {
                            "text": "The city <w>boasts</w> a rich history dating back to the Roman Empire.",
                            "target_lang_translations": {
                                "ru": "Город <w>гордится</w> богатой историей, восходящей к временам Римской империи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boasts a view",
                        "boasts a collection"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладать чем-либо, что является предметом гордости или желательной особенностью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "славиться",
                                "target_lang_sense_clarification": "иметь в наличии что-то выдающееся"
                            },
                            {
                                "target_lang_word": "гордиться",
                                "target_lang_sense_clarification": "иметь повод для гордости"
                            },
                            {
                                "target_lang_word": "располагать",
                                "target_lang_sense_clarification": "иметь в своем распоряжении"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "244aba9f-d8f9-3753-9d3f-fba0e7b04b29",
                    "sense_definition": "To speak with great pride or joy about someone else or a higher power.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bragging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scriptures say that we should <w>boast</w> in the Lord's mercy.",
                            "target_lang_translations": {
                                "ru": "В Писании сказано, что мы должны <w>хвалиться</w> милостью Господней."
                            }
                        },
                        {
                            "text": "The proud father would <w>boast</w> of his daughter's academic achievements to anyone who would listen.",
                            "target_lang_translations": {
                                "ru": "Гордый отец <w>хвалился</w> успехами дочери в учебе каждому, кто был готов слушать."
                            }
                        }
                    ],
                    "common_phrases": [
                        "boast in the Lord"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in religious or literary contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Говорить с большой гордостью или радостью о ком-то другом или о высшей силе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвалиться",
                                "target_lang_sense_clarification": "высказываться о ком-то с гордостью"
                            },
                            {
                                "target_lang_word": "превозносить",
                                "target_lang_sense_clarification": "высоко оценивать, прославлять"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "84bd1e38-3727-3de4-b12c-b3aa0b68ddc4",
                    "sense_definition": "To shape a stone or piece of wood roughly with a broad chisel before finer work.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "masonry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mason began to <w>boast</w> the block of marble into its general shape.",
                            "target_lang_translations": {
                                "ru": "Каменщик начал <w>обтесывать</w> мраморный блок, придавая ему общую форму."
                            }
                        },
                        {
                            "text": "Before the fine carving starts, you must <w>boast</w> the stone correctly.",
                            "target_lang_translations": {
                                "ru": "Прежде чем начнется тонкая резьба, необходимо правильно <w>обработать</w> камень."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term in masonry and sculpture"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Грубо обрабатывать камень или дерево широким долотом перед чистовой отделкой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обтесывать",
                                "target_lang_sense_clarification": "грубо придавать форму"
                            },
                            {
                                "target_lang_word": "оболванивать",
                                "target_lang_sense_clarification": "технический термин: придавать общую форму"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3757ce1e-caae-3aaf-a7f7-6883488e6b3e",
                    "sense_definition": "A statement or a specific thing that someone expresses pride in, often excessively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bragging_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was his regular <w>boast</w> that he could eat two full English breakfasts in one sitting.",
                            "target_lang_translations": {
                                "ru": "Его обычным <w>хвастовством</w> было утверждение, что он может съесть два полных английских завтрака за один присест."
                            }
                        },
                        {
                            "text": "Her biggest <w>boast</w> was that she had never missed a day of work in twenty years.",
                            "target_lang_translations": {
                                "ru": "Ее главным <w>предметом гордости</w> было то, что она ни разу не пропустила рабочий день за двадцать лет."
                            }
                        }
                    ],
                    "synonyms": [
                        "brag"
                    ],
                    "common_phrases": [
                        "empty boast",
                        "regular boast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заявление или конкретная вещь, которой кто-то выражает гордость, часто чрезмерную."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хвастовство",
                                "target_lang_sense_clarification": "неумеренное восхваление своих достоинств"
                            },
                            {
                                "target_lang_word": "бахвальство",
                                "target_lang_sense_clarification": "поведение бахвала"
                            },
                            {
                                "target_lang_word": "предмет гордости",
                                "target_lang_sense_clarification": "то, чем гордятся"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1d0eb274-7651-3104-a195-d9477a1e5773",
                    "sense_definition": "In squash, a shot where the ball is hit against a side wall before hitting the front wall.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He won the point with a clever <w>boast</w> that caught his opponent off guard.",
                            "target_lang_translations": {
                                "ru": "Он выиграл очко благодаря ловкому <w>боусту</w>, который застал соперника врасплох."
                            }
                        },
                        {
                            "text": "Learning how to hit a consistent <w>boast</w> is essential for advanced squash players.",
                            "target_lang_translations": {
                                "ru": "Умение стабильно выполнять <w>боуст</w> необходимо для продвинутых игроков в сквош."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit a boast",
                        "three-wall boast"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "used in the context of racket sports like squash"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В сквоше: удар, при котором мяч ударяется о боковую стенку перед тем, как попасть в переднюю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "боуст",
                                "target_lang_sense_clarification": "технический термин в сквоше"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}