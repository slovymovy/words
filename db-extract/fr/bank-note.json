                        "examples": [
                            {
                                "example_id": "d0e857ed-27bb-4e0b-b691-dd31140d1128",
                                "sense_id": "e34831d1-dc3d-38c9-8d8a-bf5594d747d1",
                                "text": "Un sieur Harlington, pourvu d’un sac de voyage et d’un carnet amplement pourvu de bank-notes, était descendu au Grand-Hôtel, voilà tout ce qu’il était possible d’affirmer."
                            },
                            {
                                "example_id": "f34e10d5-3948-4c57-8973-1e56ae83e88d",
                                "sense_id": "e34831d1-dc3d-38c9-8d8a-bf5594d747d1",
                                "text": "« Donnez-moi vos bank-notes que je les cache sous ma chemise et demain je me mets à l’œuvre. »"
                            },
                            {
                                "example_id": "806f25bc-c830-4ade-a891-d04edc31d9d3",
                                "sense_id": "e34831d1-dc3d-38c9-8d8a-bf5594d747d1",
                                "text": "Ils étaient sortis de la mer avec des caisses couvertes d’inscriptions, des side-cars, des seaux de confiture, et des bank-notes en vrac dans leurs poches de pantalons ; c’étaient les délégués d’un continent lointain, les messagers de l’horizon."
                            }
                        ]
                    }
