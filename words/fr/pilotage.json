                },
                {
                    "sense_id": "21b04a30-002e-3d2d-a355-00404bf5e3fa",
                    "sense_definition": "Ensemble des opérations de contrôle et de régulation de la puissance d'un réacteur nucléaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ingénieurs surveillent en permanence le <w>pilotage</w> du réacteur depuis la salle des commandes."
                        },
                        {
                            "text": "Ce système automatisé assure le <w>pilotage</w> des barres de contrôle en cas d'anomalie."
