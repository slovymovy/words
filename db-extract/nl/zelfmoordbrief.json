                        "glosses": [
                            "brief die als verklaring of afscheid achtergelaten wordt door iemand die zelfmoord pleegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb232ff9-45ca-45b6-a084-20e7d9512e4e",
                                "sense_id": "f55e2163-6ace-3ff1-95da-9a3388bba87b",
                                "text": "Kurt Cobain liet een zelfmoordbrief achter met de door Neil Young bedachte liedtekst \"it's better to burn out than to fade away\"."
