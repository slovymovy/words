                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "geographical_feature",
                    "examples": [
                        {
                            "text": "The old stone bridge crosses the River <w>Went</w> near the village.",
                            "target_lang_translations": {
                                "ru": "Старый каменный мост пересекает реку <w>Уэнт</w> рядом с деревней.",
                                "zh": "那座古老的石桥跨越了村庄附近的<w>温特河</w>。"
                            }
