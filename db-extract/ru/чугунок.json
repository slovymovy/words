                "senses": [
                    {
                        "sense_id": "89b66146-e637-3eb9-8b17-33d1d1483de1",
                        "entry_id": "bd597d6d-9a27-3cd8-bc71-35c62e902a8d",
                        "glosses": [
                            "разг., редк. уменьш.-ласк. к чугун"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "28721b44-6ea8-3ea6-8d66-ccefc2e1a5fe",
                        "entry_id": "bd597d6d-9a27-3cd8-bc71-35c62e902a8d",
                        "glosses": [
                            "разг. уменьш. к чугун; маленький чугунный горшок"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90de7504-10c2-4420-853d-4715c3fc9066",
                                "sense_id": "28721b44-6ea8-3ea6-8d66-ccefc2e1a5fe",
                                "text": "Настя во время рассказа вспомнила: у неё от вчерашнего дня остался целый, нетронутый чугунок варёной картошки."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b364b10f-3040-45bd-a9f2-145092fbb580",
                        "source_entry_id": "bd597d6d-9a27-3cd8-bc71-35c62e902a8d",
                        "source_sense_description": "котелок",
                        "target_lang_word": "cooking pot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cooking pot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3cf1dff-5b62-339e-941f-7119f549eddf",
                                        "entry_id": "b91254df-e401-32c0-807a-59bbcc4c8640",
                                        "glosses": [
                                            "any vessel (such as a saucepan), with or without a lid, used to cook food"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a62fa0df-c0a2-4bbf-8d99-d5000a208b9e",
                        "source_entry_id": "bd597d6d-9a27-3cd8-bc71-35c62e902a8d",
                        "source_sense_description": "котелок",
                        "target_lang_word": "Kochtopf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kochtopf",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                        "entry_id": "be572973-ddf2-312c-8788-f14df0c7fabb",
                                        "glosses": [
                                            "Behälter, in dem Lebensmittel erwärmt, erhitzt oder gekocht werden"
                                        ],
                                        "tags": [
                                            "Haushalt",
                                            "Küchensprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "266bb73e-ce9a-4db3-8bd0-a1d7e46fd944",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "Der Kochtopf steht auf der Herdplatte."
                                            },
                                            {
                                                "example_id": "2700f811-a2db-4b3c-bbb7-4fcfd499d34f",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "„Wir unterhielten uns neben vielen anderen Dingen auch über die Einrichtung der Speisekammer und über die beiden Hühnchen, die dort auf den Kochtopf warteten.“"
                                            },
                                            {
                                                "example_id": "e2269ffa-d537-4fe8-9fb2-fb5dfd71b8af",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "„Ich finde zwei Kochtöpfe, Bratpfanne und Schöpfkelle, das eiserne Drehgestell zum Rösten der Kaffeebohnen.“"
                                            },
                                            {
                                                "example_id": "42f99640-d56e-4584-a364-5b1618966afc",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "„An guten Tagen schleppten die Soldaten ihre riesigen Kochtöpfe aus der Mannschaftsküche zum Schrubben an.“"
                                            },
                                            {
                                                "example_id": "b07e6a42-9d7e-4e0a-9f07-0da4d85187f1",
                                                "sense_id": "ac0e49f2-f5b2-3832-8d6c-58b3d8058217",
                                                "text": "„Ransome füllte aus den Kochtöpfen auf und ging mit zimperlichen Schritten zwischen Tisch und Herd hin und her.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
