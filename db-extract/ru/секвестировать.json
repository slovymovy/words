                        "cross_references": [
                            {
                                "target_word": "sequester",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad192deb-2602-302b-86c3-b27e3fc415d5",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To separate from all external influence; to seclude; to withdraw."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "001f04ac-61b2-4a4e-ae63-b850283c1895",
                                                "sense_id": "ad192deb-2602-302b-86c3-b27e3fc415d5",
                                                "text": "The jury was sequestered from the press by the judge's order."
                                            },
                                            {
                                                "example_id": "fdee3582-0181-4d83-89b6-a5015cbedd8d",
                                                "sense_id": "ad192deb-2602-302b-86c3-b27e3fc415d5",
                                                "text": "when men most sequester themselves from action"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c76ad2a3-51b3-3b7d-ab99-05d031a2de4a",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To separate in order to store."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0341595-7cb1-4c3c-82d3-9ce3824f8d9c",
                                                "sense_id": "c76ad2a3-51b3-3b7d-ab99-05d031a2de4a",
                                                "text": "The coal burning plant was ordered to sequester its CO₂ emissions."
                                            },
                                            {
                                                "example_id": "1a37b70e-b01c-41f0-aca7-89007128b898",
                                                "sense_id": "c76ad2a3-51b3-3b7d-ab99-05d031a2de4a",
                                                "text": "There has been some investigation into the potential of seaweeds as a carbon store, and although more is needed, one study says that seaweed habitats are believed to be the most productive of all coastal vegetated ecosystems, and suggested that the world’s seaweed sequesters as much carbon as all the planet’s seagrass meadows, saltmarshes and mangroves combined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe59efb8-ad1a-386f-bced-8767e9b341de",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To set apart; to put aside; to remove; to separate from other things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f193c433-e0fd-4bdf-902f-be1ef0c6c2be",
                                                "sense_id": "fe59efb8-ad1a-386f-bced-8767e9b341de",
                                                "text": "I had wholly sequestered my thoughts from civil affairs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bae320a2-d3ca-35c7-9905-cf79f4b710c8",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To prevent an ion in solution from behaving normally by forming a coordination compound."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "825ea98b-133b-34a3-b89b-a9f6888971e2",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To temporarily remove (property) from the possession of its owner and hold it as security against legal claims."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "38a4f275-d35d-398b-9382-12d2873c2075",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To cause (one) to submit to the process of sequestration; to deprive (one) of one's estate, property, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9266b24-08fb-49a1-880f-91ee35522118",
                                                "sense_id": "38a4f275-d35d-398b-9382-12d2873c2075",
                                                "text": "c. 1694, Robert South, sermon XXIV\nIt was his tailor and his cook, his fine fashions and his French ragouts, which sequestered him."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9edc0ba5-8f52-3048-ae40-4f38438ce28f",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To remove (certain funds) automatically from a budget."
                                        ],
                                        "tags": [
                                            "US",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "41206e26-94ac-4f8e-a91e-045d4a27aa4e",
                                                "sense_id": "9edc0ba5-8f52-3048-ae40-4f38438ce28f",
                                                "text": "The Budget Control Act of 2011 sequestered 1.2 trillion dollars over 10 years on January 2, 2013."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f22069-9534-3d2b-be16-e7e999fc47e0",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To seize and hold enemy property."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c089c478-ddf6-3896-8c43-96dfe2b08709",
                                        "entry_id": "7114a59d-8b12-3a6d-a509-c9524990cb29",
                                        "glosses": [
                                            "To withdraw; to retire."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
