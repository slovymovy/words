                    }
                ],
                "translations": [
                    {
                        "translation_id": "85668f9a-33ac-44bd-9715-c4ee02c391d0",
                        "source_entry_id": "2e64c4bb-ab1c-30c6-b576-98c2cffa436a",
                        "source_sense_id": "c65fdede-a939-3e08-8cc5-1a21710674db",
                        "target_lang_word": "gzip",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gzip",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "148e8bfa-805d-3a33-8177-3a44a93d600e",
                                        "entry_id": "11abafa4-7bb6-349d-bef5-fd7a278a68b7",
                                        "glosses": [
                                            "To compress using the gzip program."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b02c4cf7-8f4a-4b10-9453-d8a6ce130d3f",
                                                "sense_id": "148e8bfa-805d-3a33-8177-3a44a93d600e",
                                                "text": "One way to deal with this issue is to add the compress command, which gzips the old logs as they are rotated."
                                            },
                                            {
                                                "example_id": "4928b913-cfe2-4a1f-b268-6af85356bcd1",
                                                "sense_id": "148e8bfa-805d-3a33-8177-3a44a93d600e",
                                                "text": "Image and PDF files should not be gzipped because they are already compressed. Trying to gzip them not only wastes CPU resources, it can also potentially increase file sizes."
                                            },
                                            {
                                                "example_id": "ba1310b0-4d32-4768-b638-aef0c94a36ef",
                                                "sense_id": "148e8bfa-805d-3a33-8177-3a44a93d600e",
                                                "text": "Therefore, using the YUI Compressor in combination with gzipping always gives the best results."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
