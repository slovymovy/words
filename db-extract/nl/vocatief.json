                        "source_sense_id": "0041ca21-c579-3fc4-9555-b4894a30f259",
                        "source_sense_description": "de vijfde naamval waarin een naamwoord staat dat aanduidt tot wie het woord wordt gericht",
                        "target_lang_word": "vocatif",
