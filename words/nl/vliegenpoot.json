    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a6882099-1a42-3596-8520-21aec33326d0",
                    "sense_definition": "Een moeilijk leesbaar handschrift of slordig geschreven letters.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "handschrift",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar kon de <w>vliegenpoten</w> op het proefwerk nauwelijks ontcijferen.",
                            "target_lang_translations": {
                                "en": "The teacher could barely decipher the <w>scrawl</w> on the test."
                            }
                        },
                        {
                            "text": "Zijn handschrift is een verzameling van onleesbare <w>vliegenpoten</w> geworden.",
                            "target_lang_translations": {
                                "en": "His handwriting has become a collection of illegible <w>chicken scratch</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "hanenpoot"
                    ],
                    "common_phrases": [
                        "onleesbare vliegenpoten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Vaak in het meervoud gebruikt om slordig schrift aan te duiden."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Hard-to-read handwriting or sloppily written letters."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scrawl",
                                "target_lang_sense_clarification": "messy, illegible handwriting"
                            },
                            {
                                "target_lang_word": "chicken scratch",
                                "target_lang_sense_clarification": "informal term for very poor handwriting"
                            },
                            {
                                "target_lang_word": "scribble",
                                "target_lang_sense_clarification": "careless or hasty writing"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22178f11-eca1-35ea-845a-223fd96a5050",
                    "sense_definition": "Een van de zes ledematen van een vlieg.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insectenlichaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Onder de microscoop konden we de details van een <w>vliegenpoot</w> heel duidelijk zien.",
                            "target_lang_translations": {
                                "en": "Under the microscope, we could see the details of a <w>fly's leg</w> very clearly."
                            }
                        },
                        {
                            "text": "Er zat een kleine <w>vliegenpoot</w> vastgeplakt op de rand van het glas.",
                            "target_lang_translations": {
                                "en": "There was a small <w>fly leg</w> stuck to the rim of the glass."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "One of the six limbs of a fly."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fly's leg",
                                "target_lang_sense_clarification": "literal leg of a fly"
                            },
                            {
                                "target_lang_word": "fly leg",
                                "target_lang_sense_clarification": "the leg of a fly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
