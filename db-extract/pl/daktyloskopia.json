                                        "entry_id": "16a94ae6-7658-324b-88ba-bdfef3ce03cb",
                                        "glosses": [
                                            "метод идентификации человека по отпечаткам пальцев, основанный на уникальности рисунка кожи"
                                        ],
                                        "tags": [],
