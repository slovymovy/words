{
    "word_family": [
        "приятный",
        "приятность"
    ],
    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "8afa47ed-f49b-3884-a024-29526fd95ee6",
                    "sense_definition": "О чувстве удовольствия, радости или удовлетворения (используется как сказуемое).",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мне очень <w>приятно</w> с вами познакомиться.",
                            "target_lang_translations": {
                                "en": "It is very <w>nice</w> to meet you.",
                                "zh": "认识您我感到<w>很高兴</w>。"
                            }
                        },
                        {
                            "text": "Нам было <w>приятно</w> получить ваше письмо.",
                            "target_lang_translations": {
                                "en": "We were <w>pleased</w> to receive your letter.",
                                "zh": "收到您的来信我们感到很<w>愉快</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "неприятно"
                    ],
                    "common_phrases": [
                        "очень приятно",
                        "мне приятно",
                        "приятно слышать",
                        "приятно познакомиться"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to express a feeling of pleasure, joy, or satisfaction (often used as a predicate).",
                        "zh": "用于表达愉悦、高兴或满足的感觉（常作谓语）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nice",
                                "target_lang_sense_clarification": "common in greetings and expressions of satisfaction"
                            },
                            {
                                "target_lang_word": "pleased",
                                "target_lang_sense_clarification": "feeling or showing pleasure and satisfaction"
                            },
                            {
                                "target_lang_word": "pleasant",
                                "target_lang_sense_clarification": "giving a sense of happy satisfaction or enjoyment"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "很高兴",
                                "target_lang_sense_clarification": "用于社交场合表达愉悦"
                            },
                            {
                                "target_lang_word": "感到愉快",
                                "target_lang_sense_clarification": "表达内心满足或高兴"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9797b248-7c3b-3f78-837b-e6d21c206925",
                    "sense_definition": "Доставляя удовольствие, вызывая положительные эмоции.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В саду <w>приятно</w> пахло цветами и травой.",
                            "target_lang_translations": {
                                "en": "The garden smelled <w>pleasantly</w> of flowers and grass.",
                                "zh": "花园里<w>令人愉快地</w>散发着花草的清香。"
                            }
                        },
                        {
                            "text": "Учитель был <w>приятно</w> удивлён нашими знаниями.",
                            "target_lang_translations": {
                                "en": "The teacher was <w>pleasantly</w> surprised by our knowledge.",
                                "zh": "老师对我们的知识水平感到<w>欣然</w>惊讶。"
                            }
                        }
                    ],
                    "antonyms": [
                        "неприятно",
                        "отталкивающе",
                        "противно"
                    ],
                    "common_phrases": [
                        "приятно пахнет",
                        "приятно удивлён",
                        "приятно проводить время"
                    ],
                    "target_lang_definitions": {
                        "en": "In a manner that gives pleasure or causes positive emotions.",
                        "zh": "以一种令人愉悦或引起积极情绪的方式。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pleasantly",
                                "target_lang_sense_clarification": "in a pleasing or agreeable manner"
                            },
                            {
                                "target_lang_word": "agreeably",
                                "target_lang_sense_clarification": "in a pleasant or enjoyable way"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "令人愉快地",
                                "target_lang_sense_clarification": "以令人舒适的方式"
                            },
                            {
                                "target_lang_word": "欣然",
                                "target_lang_sense_clarification": "愉快地、高兴地"
                            }
                        ]
                    }
                }
            ]
        },
