                    {
                        "translation_id": "ffebb20f-5d6b-4f56-a1f7-7e9a4a0f745e",
                        "source_entry_id": "9b1bfe93-09e1-3d73-8fde-d07d9def2f97",
                        "source_sense_id": "abd32ee2-00cd-3275-b533-d07e04187e0a",
                        "target_lang_word": "chihuahua",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chihuahua",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9898e81f-55d3-3ebc-ac0d-6b029576af71",
                                        "entry_id": "34a0c999-de61-363d-a90e-57042a75852a",
                                        "glosses": [
                                            "Race de très petit chien de compagnie, originaire du Mexique, le chien le plus petit du monde, à poil court ou à poil long."
                                        ],
                                        "tags": [
                                            "Cynologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b3da0f8-28a7-47a2-96b0-04119df78da6",
                                                "sense_id": "9898e81f-55d3-3ebc-ac0d-6b029576af71",
                                                "text": "As-tu vu ça, kid ? Comme un p’tit chien ! T’arais dû voir ça, y’a vingt ans. Moé, j’étais Xavier Cugat, pis lui c’tait mon chihuahua."
                                            },
                                            {
                                                "example_id": "b80b9970-aca1-47ba-bf69-a933cf25c838",
                                                "sense_id": "9898e81f-55d3-3ebc-ac0d-6b029576af71",
                                                "text": "À Coconut Grove, un type promène six chihuahuas en laisse et ramasse leur merde avec un gant en plastique."
                                            },
                                            {
                                                "example_id": "8dbf32ec-c0c6-4360-8b28-e633eb0a258c",
                                                "sense_id": "9898e81f-55d3-3ebc-ac0d-6b029576af71",
                                                "text": "Selon son vétérinaire, Pearl le chihuahua mesure 9,4 cm de haut et 12,7 cm de long, loin d’atteindre par exemple les dimensions d’un billet de 1 $ US."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aeb651c2-3118-377a-bcc5-64ef33b1b20f",
                                        "entry_id": "34a0c999-de61-363d-a90e-57042a75852a",
                                        "glosses": [
                                            "Personne qui crie et s'énerve pour un rien."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "pejorative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ae0f2a8-cdbf-4658-b32b-11558009f202",
                                                "sense_id": "aeb651c2-3118-377a-bcc5-64ef33b1b20f",
                                                "text": "Je sais, je sais, peu importe ce que fait le gouvernemaman, il ne faut pas critiquer. Ça réveille les chihuahuas du lazy-boy.\nLa moindre pointe vaut à son auteur des insultes."
                                            },
                                            {
                                                "example_id": "3c28005b-eb67-42a6-81c0-c2a6373e775d",
                                                "sense_id": "aeb651c2-3118-377a-bcc5-64ef33b1b20f",
                                                "text": "— Il est hors de question de rapporter ce nain avec nous !\n— Quoi ?!? Vous oubliez que c’est moi qui commande, ici !\n— Ouais, mais c’est moi qui conduis… Et ton chihuahua m’a mordue…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
