                        "entry_id": "72f83f86-f305-3cdf-a68e-ac1c93b621d7",
                        "glosses": [
                            "Handlungsweise oder Ergebnis einer solchen Handlung, die in deutlichem Maße unprofessionelle, mangelhafte (gepfuschte) Arbeitsweise aufzeigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ca83df-874d-4def-8003-8690cdf79145",
                                "sense_id": "fe4a4871-d449-3b31-8999-e853ac63f356",
                                "text": "Damals ging man entschieden gegen die Pfuscherei vor, die unter dem medizinischen Personal verbreitet war."
                            },
                            {
                                "example_id": "29ce3340-aa33-4203-9be4-725035e2c87c",
                                "sense_id": "fe4a4871-d449-3b31-8999-e853ac63f356",
                                "text": "Schau mal, was für eine Pfuscherei! Hier löst sich die Farbe von der Wand!"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
