                "senses": [
                    {
                        "sense_id": "697c642b-d8bc-39a6-838f-bd8f076d7911",
                        "entry_id": "6c58407c-5287-3034-8626-dcbb196698d7",
                        "glosses": [
                            "teuflische (diabolische), gemeine, verletzende, destruktive Grundeinstellung, die sich in fiesen Handlungen äußert"
                        ],
                        "tags": [
                            "bildungsspr."
                        ],
                        "examples": [
                            {
                                "example_id": "7ea31286-20d4-4ad5-8d5b-f43711da7961",
                                "sense_id": "697c642b-d8bc-39a6-838f-bd8f076d7911",
                                "text": "„Da, wo etwa der Teufel, Dämonen, Häretiker, Ketzer, Fremde, Verräter, Aufrührer, Klassenfeinde, Konterrevolutionäre, Volksfeinde, Verbrecher usw. als wirkende Kräfte gegen das erscheinen, was die politische Realität ‚wesentlich‘ fundiert und ordnet, will ich von einer politischen Diabolik sprechen.“"
                            },
                            {
                                "example_id": "ede96931-8791-4ce3-be55-38b1aa36b665",
                                "sense_id": "697c642b-d8bc-39a6-838f-bd8f076d7911",
                                "text": "„Es ist dies der Ausfluß der Diabolik, der Tücke, die menschliches Geschick regieren, daß der im Gedanken vorausgegriffene Erfolg diesen quasi im Mutterleib abtötet.“"
                            }
                        ],
