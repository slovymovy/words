                        "glosses": [
                            "alle maatregelen die worden genomen om de begroeide leefomgeving aantrekkelijk te houden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2e56a56-8db5-43e0-8565-2a33d6ef001a",
                                "sense_id": "45989a3e-90ad-328c-bdc2-5d54c16be0bd",
                                "text": "Vrijwilligers en herintreders werken er aan een betere wijk. Ze knappen oude fietsen op, plegen groenonderhoud en doen allerlei klussen in de buurt. Ook de geveltuintjes staan er weer netjes bij."
                            },
                            {
                                "example_id": "07631752-e1ad-4b61-b7de-14ba60b455ed",
                                "sense_id": "45989a3e-90ad-328c-bdc2-5d54c16be0bd",
                                "text": "P. werd in de kliniek in Den Dolder voorbereid op terugkeer in de maatschappij. De Gooi- en Eemlander schrijft dat hij in de kliniek werkte op de afdeling groenonderhoud."
                            },
                            {
                                "example_id": "d5aa5841-fce5-49d6-ad63-ef052a91b1a0",
                                "sense_id": "45989a3e-90ad-328c-bdc2-5d54c16be0bd",
                                "text": "Een kudde heideschapen helpt sinds vandaag bij het groenonderhoud van Paleis Soestdijk. De schapen gaan het landgoed bij het paleis meerdere keren per jaar begrazen."
                            }
                        ]
                    }
