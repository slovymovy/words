                                        "glosses": [
                                            "Any of the grasshoppers, often polyphenic and usually swarming, in the family Acrididae that are very destructive to crops and other vegetation, especially migratory locusts (Locusta migratoria)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
