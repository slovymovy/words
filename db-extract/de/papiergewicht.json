                "senses": [
                    {
                        "sense_id": "75b30315-7093-3617-9705-cda4cf907162",
                        "entry_id": "098151ab-b123-3cf2-8c2f-1b6485495c2a",
                        "glosses": [
                            "leichteste Gewichtsklasse für Boxer (bis zu 46 kg)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d9aa945-4c1e-4ef0-a7d5-64cf10900c44",
                                "sense_id": "75b30315-7093-3617-9705-cda4cf907162",
                                "text": "Für die Altersklassen und für jedes Geschlecht kommt auch noch eine eigene Einteilung der Gewichtsklassen zur Anwendung, so kämpft Markus z. B. in der Gruppe derjenigen, die das 8. Lebensjahr überschritten, aber das 10. noch nicht vollendet haben und zur Körpergewichtsklasse »Papiergewicht bis 40 kg« gehören."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4781b3df-bfd7-36b6-b4e4-f77805743de5",
                        "entry_id": "098151ab-b123-3cf2-8c2f-1b6485495c2a",
                        "glosses": [
                            "Person der Gewichtsklasse Papiergewicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde3418e-c18b-4385-b2da-5e04521bd06a",
                                "sense_id": "4781b3df-bfd7-36b6-b4e4-f77805743de5",
                                "text": "Das Papiergewicht Markus geht als Nächster in den Ring."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "2aac382b-3afc-3b0b-826c-b3b189fdf011",
                        "entry_id": "098151ab-b123-3cf2-8c2f-1b6485495c2a",
                        "glosses": [
                            "Masse von Papier pro Fläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0318b49-806f-4a97-806c-53da1e3d59aa",
                                "sense_id": "2aac382b-3afc-3b0b-826c-b3b189fdf011",
                                "text": "„Dass das Papier von der Druckerei beigestellt wurde, ergibt sich mit hinreichender Deutlichkeit aus der vom Erstgericht festgestellten Kalkulation der Druckerei, wonach sich der Preis unter anderem nach dem gewünschten Papiergewicht richtete (AS 95).“"
                            },
                            {
                                "example_id": "136dadc0-39a3-44a3-af95-abf572024a59",
                                "sense_id": "2aac382b-3afc-3b0b-826c-b3b189fdf011",
                                "text": "„Postkarte […] Papiergewicht 150 bis 500 g/m²“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
