                "senses": [
                    {
                        "sense_id": "6d043bf4-e895-35e7-bd29-6966b7f8b3aa",
                        "entry_id": "923930fc-5e98-36d6-88a8-3e11e058fe41",
                        "glosses": [
                            "kleine, lustige Geschichte über das Klischee, Schotten seien übertrieben sparsam und geizig"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51de3ded-60b3-4819-ba22-605a3bbf290d",
                                "sense_id": "6d043bf4-e895-35e7-bd29-6966b7f8b3aa",
                                "text": "Kommt ein Schotte in die Redaktion einer Zeitung und sagt: \"Wenn sie weiterhin in ihrer Zeitung Schottenwitze drucken, dann ist es die längste Zeit gewesen, daß ich mir ihre Zeitung ausleihe!\""
                            },
                            {
                                "example_id": "d2801127-39c0-44e7-873c-c8472d7c25ad",
                                "sense_id": "6d043bf4-e895-35e7-bd29-6966b7f8b3aa",
                                "text": "„Nebenbei: Der Witz hat einen ihm verwandten Schottenwitz, wo es nicht um gelebte Gier, sondern erlebten Geiz geht.“"
                            },
                            {
                                "example_id": "e2cef14b-8156-4ca3-a24b-65fe1a4cbf93",
                                "sense_id": "6d043bf4-e895-35e7-bd29-6966b7f8b3aa",
                                "text": "„Und so gehören Schottenwitze und ihre Parallelerzählungen fast immer auch noch zu anderen Gruppen.“"
                            },
                            {
                                "example_id": "099e0fdf-bb57-4425-a7b6-22605deeab4c",
                                "sense_id": "6d043bf4-e895-35e7-bd29-6966b7f8b3aa",
                                "text": "„Unter den übrigen Deutschen, die wissend mitschmunzeln, sind solche Schwabenwitze so weit verbreitet wie Schottenwitze in aller Welt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
