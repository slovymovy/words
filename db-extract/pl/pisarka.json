                    },
                    {
                        "translation_id": "2b14b080-c37d-4058-9c6c-5a9f5776091f",
                        "source_entry_id": "4b5c7835-deb3-33d0-923d-11d50daf598e",
                        "source_sense_id": "ef23a1a0-b6fa-3bc3-a1f6-14ebabab5a8f",
                        "target_lang_word": "Schriftstellerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schriftstellerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                        "entry_id": "efb78149-62bc-369e-904d-1f7961cbf1d2",
                                        "glosses": [
                                            "weibliche Person, die schriftliche Werke verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8235201-8e4c-4222-9df7-fcd2c22a4b2b",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "Agatha Christie war eine sehr bekannte Schriftstellerin."
                                            },
                                            {
                                                "example_id": "2ec63e46-2d67-49f6-9b31-5eee1bee7e14",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Die Schriftstellerin Germaine de Staël, die den gesellschaftlichen Rückschritt in ihrem Roman »Delphine« kritisierte, wird des Landes verwiesen und muss ihren literarischen Salon aufgeben.“"
                                            },
                                            {
                                                "example_id": "0c77b3de-771f-4be1-a398-336e56fa8348",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Konsequent hat die Schriftstellerin bei der Publikation des Textes an seiner authentischen Struktur festgehalten, auch bei den Namen.“"
                                            },
                                            {
                                                "example_id": "8fbd00ce-b5a8-4c09-aea8-b702a6febf03",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Nach einer Weile sagt Efe, dass sie immer Schriftstellerin werden wollte.“"
                                            },
                                            {
                                                "example_id": "2f7207e2-cf06-40fc-a5c1-492a94fd5641",
                                                "sense_id": "2bba25d9-a183-3fc9-b39b-1dee2d6e150a",
                                                "text": "„Hella Wuolijoki war eine linke Schriftstellerin und Geschäftsfrau im Holzhandel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "971f3a0b-82e4-4f9d-9f24-dae727772235",
                        "source_entry_id": "4b5c7835-deb3-33d0-923d-11d50daf598e",
                        "source_sense_id": "ef23a1a0-b6fa-3bc3-a1f6-14ebabab5a8f",
                        "target_lang_word": "писательница",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "писательница",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ef1a902d-a078-30bd-a6de-2cf344ce1614",
                                        "entry_id": "ee84054a-9072-3b16-9675-2002015cc599",
                                        "glosses": [
                                            "женск. к писатель; женщина-писатель"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dbf813e-2306-4181-99d1-c4f8e70b4d23",
                                                "sense_id": "ef1a902d-a078-30bd-a6de-2cf344ce1614",
                                                "text": "Хозяйством не занимается, а только письма пишет ― писательница!"
                                            },
                                            {
                                                "example_id": "d72f8025-621d-4963-ab3e-22049ff9c11d",
                                                "sense_id": "ef1a902d-a078-30bd-a6de-2cf344ce1614",
                                                "text": "Теперь все барышни играют на рояле, и я тоже играла, как все, и ничего во мне не было особенного; я такая же пианистка, как мама писательница."
                                            },
                                            {
                                                "example_id": "bba6bf57-055c-4b90-be46-fbbac5d71be4",
                                                "sense_id": "ef1a902d-a078-30bd-a6de-2cf344ce1614",
                                                "text": "— Простите, вы немка? ― Русская, и притом писательница. Вы можете говорить со мной свободно. Я не боюсь жизни и правды. ― Писательница, ― он почтительно приподымает шляпу. ― Я уважаю женщин, которые имеют профессию."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
