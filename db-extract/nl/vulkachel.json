                        ],
                        "examples": [
                            {
                                "example_id": "3506e347-96f8-47fc-aec2-2099f9d60611",
                                "sense_id": "0781263f-d51d-32c8-ad66-52baa285e80e",
                                "text": "Op de tweede verdieping waren de klassen. Voor in elk klaslokaal stond een grote lessenaar, voor de leerlingen waren er houten banken en in de hoek stond een grote vulkachel op een vierkante metalen plaat."
                            }
                        ]
                    }
