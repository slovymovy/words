                    }
                ],
                "translations": [
                    {
                        "translation_id": "d6fd6a66-aee0-4f0b-8462-46cdd5aaec8b",
                        "source_entry_id": "8f4f8e07-fd59-319b-931f-b59bfbe85733",
                        "source_sense_id": "c2f462c6-2884-3ec0-b4df-27f14c2c7e72",
                        "target_lang_word": "chick",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "63bbec65-1ea7-3ce2-b923-007700fd9e65",
                                        "entry_id": "bec085c4-7052-374d-a172-5e45c7242336",
                                        "glosses": [
                                            "A young bird."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f24348ec-ae13-4641-bcc4-109ffcc2e01d",
                                                "sense_id": "63bbec65-1ea7-3ce2-b923-007700fd9e65",
                                                "text": "Published in the Communications Earth & Environment journal, scientists conclude that due to sea ice loss last year, it is highly probable that no chicks had survived from four of the five known emperor penguin colonies in the central and eastern Bellingshausen Sea in Antarctica."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "09fba01e-3c66-315f-b3af-1f4211f9520f",
                                        "entry_id": "bec085c4-7052-374d-a172-5e45c7242336",
                                        "glosses": [
                                            "A young chicken."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97749179-9133-4d47-9072-2854a21276b2",
                                                "sense_id": "09fba01e-3c66-315f-b3af-1f4211f9520f",
                                                "text": "Neither chick nor child was left living the length of the seacoast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                        "entry_id": "bec085c4-7052-374d-a172-5e45c7242336",
                                        "glosses": [
                                            "An attractive, young woman."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44694608-8de1-487b-a9a2-da1dccc12a60",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "This chick's a machine but her friend is way more fun."
                                            },
                                            {
                                                "example_id": "db2dfd0d-ff71-4c8c-8e4a-ad6cb2065086",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "They're going to have a chick weekend. No guys allowed."
                                            },
                                            {
                                                "example_id": "8ee5e86a-fd9f-4c62-a3d4-8e66f7e5089d",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "He'll fall for any chick with a nice smile."
                                            },
                                            {
                                                "example_id": "b28d518d-3671-478f-9dd9-f434b7363860",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "\"I thought you had some common sense, Frank,\" said Uncle John; \"but I see you are as great a fool as all the rest. Marry, indeed! A pretty chick to marry!\""
                                            },
                                            {
                                                "example_id": "ee31fb47-fbe9-49d2-9f56-087b0f969185",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "He had determined that marriage now would cramp his advancement in the church and that, anyway, he didn't want to marry this brainless little fluffy chick, who would be of no help in impressing rich parishioners."
                                            },
                                            {
                                                "example_id": "80b85437-22eb-497e-b3dc-4d11aeae36f4",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "Three cool chicks / Are walking down the street / Swinging their hips"
                                            },
                                            {
                                                "example_id": "21c0a9d1-a3ad-495a-8fa4-f80826fb296f",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "Good. It's nice to have a chick occasionally."
                                            },
                                            {
                                                "example_id": "615a7b8a-f1f5-4ed6-b720-4377871bc8b9",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "That ain't workin', that's the way you do it / Money for nothin', and chicks for free"
                                            },
                                            {
                                                "example_id": "ecd532ab-6884-47e2-97b0-37613ae75287",
                                                "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                                                "text": "I can't believe you've got a hot chick in that ratty apartment with you."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd115497-3d40-351a-8674-046062659728",
                                        "entry_id": "bec085c4-7052-374d-a172-5e45c7242336",
                                        "glosses": [
                                            "A friendly fighter aircraft."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9795e265-88bd-4fc7-bb75-7e9cbad7b4f1",
                                                "sense_id": "bd115497-3d40-351a-8674-046062659728",
                                                "text": "The Aldis lamp flashes at the underside of each aircraft. It shows that the gear is down. Diegal is relaxing. This is such low responsibility, easy night duty. All the “chicks” (fighter aircraft) are home to roost except one."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c4434da-d3ee-3fdb-b188-349482d5455a",
                                        "entry_id": "bec085c4-7052-374d-a172-5e45c7242336",
                                        "glosses": [
                                            "A young child."
                                        ],
                                        "tags": [
                                            "dated",
                                            "endearing"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "chick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eae9fbf8-19c0-30fb-beab-6321d07952a1",
                                        "entry_id": "7ecea55e-0519-3143-9e81-aa8aa683469e",
                                        "glosses": [
                                            "To sprout, as seed does in the ground; to vegetate."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc419707-b1fb-48a1-8c1c-602755ee09d2",
                                                "sense_id": "eae9fbf8-19c0-30fb-beab-6321d07952a1",
                                                "text": "plowing in his oats with a very feet furrow; and, after they have “chicked” but before they appear aboveground"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2151b046-3324-3201-a205-d181cbee2d62",
                                        "entry_id": "7ecea55e-0519-3143-9e81-aa8aa683469e",
                                        "glosses": [
                                            "To compress the lips and then separate them quickly, resulting in a percussive noise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "393e33ac-2862-4191-8f94-ad0de7496bee",
                                                "sense_id": "2151b046-3324-3201-a205-d181cbee2d62",
                                                "text": "He chicked his lips; he cracked his whip; he winked with a knowing leer; he ran down the alley and up the stair, then down the stair and up the alley"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "chick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "897d9ea4-ff2e-3a4c-834a-c12e94fb4c23",
                                        "entry_id": "7709ffa1-c80f-304c-9884-5f5f96ebece1",
                                        "glosses": [
                                            "A screen or blind made of finely slit bamboo and twine, hung in doorways or windows."
                                        ],
                                        "tags": [
                                            "India",
                                            "Pakistan"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1c281ed-f63a-4d80-9700-695ae18a01cc",
                                                "sense_id": "897d9ea4-ff2e-3a4c-834a-c12e94fb4c23",
                                                "text": "1890, Rudyard Kipling, Letter to William Canton, 5 April, 1890, in Sandra Kemp and Lisa Lewis (eds.) Writings on writing by Rudyard Kipling, Cambridge University Press, 1996, p. 34, https://books.google.ca/books?id=-AQStA5QMjwC&printsec=frontcover#v=onepage&q&f=false\nThen, through a cautiously lifted chick, the old scene stands revealed […]"
                                            },
                                            {
                                                "example_id": "3e9d0ca3-121d-46da-adfc-0e078974fc20",
                                                "sense_id": "897d9ea4-ff2e-3a4c-834a-c12e94fb4c23",
                                                "text": "It is not uncommon at meal-time to see the table servants chasing the sparrows about the room, endeavouring to drive them out while some one holds up the \"chick\" or bamboo net which covers the doorway."
                                            },
                                            {
                                                "example_id": "4f33e627-d8f8-4707-ba2a-e276a22e7dd1",
                                                "sense_id": "897d9ea4-ff2e-3a4c-834a-c12e94fb4c23",
                                                "text": "[…] at this time of day all the verandas were curtained with green bamboo chicks."
                                            },
                                            {
                                                "example_id": "0b69dee8-5dbe-4551-a4f4-f37e5e0c6156",
                                                "sense_id": "897d9ea4-ff2e-3a4c-834a-c12e94fb4c23",
                                                "text": "Outside I could hear the bamboo chick tapping on the door like a blind man's stick on a kerbstone."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
