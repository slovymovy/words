                                        "sense_id": "52419bed-af61-3207-a1c4-5e67a3d0ff9c",
                                        "entry_id": "363420ab-4203-3acb-a114-365b7abb7414",
                                        "glosses": [
                                            "voller Selbstwertgefühl, ohne am eigenen Tun und Wirken zu zweifeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c72445be-78a8-43f2-bb80-4ae45736fce1",
                                                "sense_id": "52419bed-af61-3207-a1c4-5e67a3d0ff9c",
                                                "text": "Selbstbewusstes Auftreten ist das A und O in der Geschäftswelt."
                                            },
                                            {
                                                "example_id": "4ed3166d-fa92-43b7-b08f-33fcaf9e09a8",
                                                "sense_id": "52419bed-af61-3207-a1c4-5e67a3d0ff9c",
                                                "text": "Unter dem neuen Trainer Pal Dardai treten Herthas Profis selbstbewusster auf als vorher – die Ergebnisse belegen das. Gegen Paderborn soll nun ein Befreiungsschlag her."
                                            },
                                            {
                                                "example_id": "b781e87a-094b-4293-936f-c60ac034a686",
                                                "sense_id": "52419bed-af61-3207-a1c4-5e67a3d0ff9c",
                                                "text": "Kaum war der erste Tag des Workshops in Kairo vorbei, war klar: Über diese Themen hatten die meisten Teilnehmerinnen noch nie gesprochen. Wie erkenne ich meine Stärken und kann sie selbstbewusst präsentieren?"
                                            },
                                            {
                                                "example_id": "ca78e383-0838-4aa1-857d-6d16148c7d6a",
                                                "sense_id": "52419bed-af61-3207-a1c4-5e67a3d0ff9c",
                                                "text": "Von wegen \"lame duck\". Mit seiner Rede zur Lage der Nation hat Barack Obama den Republikanern selbstbewusst die Stirn geboten."
                                            },
                                            {
                                                "example_id": "83f73b89-905d-4641-a17c-5e7f124f349b",
                                                "sense_id": "52419bed-af61-3207-a1c4-5e67a3d0ff9c",
                                                "text": "[Tennis:] „Überhaupt wirkte Alcaraz von Ballwechsel zu Ballwechsel selbstbewusster, sein Hamburger Gegner dagegen skeptischer.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
