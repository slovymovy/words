                                        "examples": [
                                            {
                                                "example_id": "66d39600-8b71-4b7f-8d25-2ed817bf95fa",
                                                "sense_id": "575967b4-ab3f-338e-a12b-78947325ca20",
                                                "text": "„Auf der griechischen Insel Korfu ist eine 22-jährige Belgierin, die per europäischem Haftbefehl gesucht wurde, festgenommen worden.“"
                                            },
                                            {
                                                "example_id": "e6390774-9954-452c-a821-72601d7379f8",
                                                "sense_id": "575967b4-ab3f-338e-a12b-78947325ca20",
                                                "text": "„Ich aber fand die Schwatzhaftigkeit von Signora F. unglaublich, die doch nicht ganz Korfu verraten mußte, welcher Art die Geschichten waren, die ich ihr unter vier Augen erzählte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
