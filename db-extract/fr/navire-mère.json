                "senses": [
                    {
                        "sense_id": "45b1bc2c-b894-30ec-918d-538851103ebd",
                        "entry_id": "e8e85a00-4a3e-3748-ae5b-31a8fa8c910b",
                        "glosses": [
                            "Navire qui assure le transport de marchandises sur de longues distances avec très peu d’escale, le déchargement étant effectué par des navires collecteurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c4560d6-4166-4c2e-8249-891689aad0a0",
                                "sense_id": "45b1bc2c-b894-30ec-918d-538851103ebd",
                                "text": "Ils déchargent une partie de leurs marchandises sur un caboteur qui les répartit ensuite sur la côte, permettant au navire-mère d’assurer des rotations plus rapides."
                            }
                        ]
                    },
                    {
                        "sense_id": "e01c6d4a-2868-370a-ba02-20591bf728d6",
                        "entry_id": "e8e85a00-4a3e-3748-ae5b-31a8fa8c910b",
                        "glosses": [
                            "Navire de conditionnement du poisson desservant des navires de capture du poisson."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1123431a-17ca-4da1-8af5-7674a7accbf7",
                                "sense_id": "e01c6d4a-2868-370a-ba02-20591bf728d6",
                                "text": "La pêche japonaise avec navire-mère a été restreinte à un navire-mère en 1988 (avec 43 unités de capture) contre 16 navires-mères et 460 unités de capture des années 50."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97162963-d0a3-4d91-b8ff-02eab54119fb",
                        "source_entry_id": "e8e85a00-4a3e-3748-ae5b-31a8fa8c910b",
                        "target_lang_word": "Mutterschiff",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mutterschiff",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "29178cbb-447e-3132-bab5-de7ddb62c9ba",
                                        "entry_id": "80ae7b0d-4c21-31e4-b1ac-9cc6796d4f1e",
                                        "glosses": [
                                            "See-, Raum- oder Luftschiff, das kleinere Fortbewegungsmittel mit sich führen sowie diese reparieren und versorgen kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aca3c04d-f7f9-4afc-b895-a10f6468a7a0",
                                                "sense_id": "29178cbb-447e-3132-bab5-de7ddb62c9ba",
                                                "text": "„Es war mir eine besondere Ehre, als Admiral Carfax mich mit dem Kommando über unseren Spähgleiter betraute, dessen Einzelteile aus dem Bauch des riesigen Mutterschiffs entladen und für den Vor-Ort-Einsatz zusammengefügt wurden.“"
                                            },
                                            {
                                                "example_id": "c9bd8e1d-25f9-47ac-b545-f25f69b16d44",
                                                "sense_id": "29178cbb-447e-3132-bab5-de7ddb62c9ba",
                                                "text": "„Nicht, dass sie die dicksten Freunde gewesen wären. Sie waren eher wie zwei Raumfahrer, die bei einem Einsatz im All den Kontakt zum Mutterschiff verloren hatten.“"
                                            },
                                            {
                                                "example_id": "eec1e4f6-52f7-4070-8bd0-d0c5e6b64011",
                                                "sense_id": "29178cbb-447e-3132-bab5-de7ddb62c9ba",
                                                "text": "„Zu seiner Überraschung entdeckte er eines der beiden Beiboot der Tai Chin VI keine 40 Meter hinter sich; es war aufs felsige Ufer gegenüber der Triadenbar aufgelaufen, etwa 180 Meter vom Mutterschiff entfernt, und außer dem leichten Schaukeln in der Dünung bewegte sich in und an dem Boot nichts.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4fa7cfd-28ae-49af-933b-1bc2445dc947",
                        "source_entry_id": "e8e85a00-4a3e-3748-ae5b-31a8fa8c910b",
                        "target_lang_word": "mother ship",
