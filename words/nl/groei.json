                    "sense_definition": "De eerste persoon enkelvoud tegenwoordige tijd van <w>groeien</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>groei</w> elke dag een klein beetje meer.",
                            "target_lang_translations": {
                                "en": "I <w>grow</w> a little bit more every day."
                            }
                        },
                        {
                            "text": "Als ik goed eet, dan <w>groei</w> ik sneller.",
                            "target_lang_translations": {
                                "en": "If I eat well, I <w>grow</w> faster."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The first-person singular present tense of 'to grow'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "grow",
                                "target_lang_sense_clarification": "first-person singular present"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f2978c8-d49a-326b-8e7a-3901d38b59b6",
                    "sense_definition": "De gebiedende wijs van <w>groeien</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Groei</w> nu eindelijk eens op en gedraag je volwassen.",
                            "target_lang_translations": {
                                "en": "<w>Grow</w> up at last and behave like an adult."
                            }
                        },
                        {
                            "text": "Kleine boom, <w>groei</w> tot aan de hemel!",
                            "target_lang_translations": {
                                "en": "Little tree, <w>grow</w> up to the sky!"
                            }
                        }
                    ],
                    "traits": [
