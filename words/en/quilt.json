{
    "word_family": [
        "quilter",
        "quilting",
        "quilted"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f1debbbe-9f89-36e8-bc43-1dca11c203a5",
                    "sense_definition": "A warm bed covering made of two layers of fabric stitched together with padding in between, often featuring decorative patterns.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bedding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On cold winter nights, I love to sleep under a thick handmade <w>quilt</w>.",
                            "target_lang_translations": {
                                "ru": "Холодными зимними ночами я люблю спать под толстым <w>стеганым одеялом</w> ручной работы."
                            }
                        },
                        {
                            "text": "My grandmother spent months sewing a beautiful patchwork <w>quilt</w> for my new bedroom.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка потратила месяцы, шия красивое <w>лоскутное одеяло</w> для моей новой спальни."
                            }
                        }
                    ],
                    "synonyms": [
                        "bedspread",
                        "comforter",
                        "duvet"
                    ],
                    "common_phrases": [
                        "patchwork quilt",
                        "handmade quilt",
                        "quilt cover"
                    ],
                    "target_lang_definitions": {
                        "ru": "Теплое постельное покрытие, состоящее из двух слоев ткани, прошитых вместе с наполнителем между ними, часто с декоративным узором."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стеганое одеяло",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "лоскутное одеяло",
                                "target_lang_sense_clarification": "если сделано из кусочков ткани"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "158ab31b-1318-3d75-907b-faf3d4b87813",
                    "sense_definition": "Something composed of a variety of diverse parts joined together; a metaphorical patchwork.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "collection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city is a colorful <w>quilt</w> of different cultures and languages.",
                            "target_lang_translations": {
                                "ru": "Город представляет собой красочную <w>мозаику</w> различных культур и языков."
                            }
                        },
                        {
                            "text": "Her performance was a wonderful <w>quilt</w> of musical and story-telling talents.",
                            "target_lang_translations": {
                                "ru": "Ее выступление было чудесным <w>сочетанием</w> музыкального и повествовательного талантов."
                            }
                        }
                    ],
                    "synonyms": [
                        "patchwork",
                        "tapestry",
                        "mosaic"
                    ],
                    "common_phrases": [
                        "quilt of cultures"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "metaphorical use"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, состоящее из множества разнообразных частей, соединенных вместе; метафорическая мозаика."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мозаика",
                                "target_lang_sense_clarification": "переносное значение, разнообразие"
                            },
                            {
                                "target_lang_word": "смешение",
                                "target_lang_sense_clarification": "разнородный состав"
                            },
                            {
                                "target_lang_word": "лоскутное одеяло",
                                "target_lang_sense_clarification": "метафора пестроты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "070cdb70-468a-3aea-acd3-d925a2256d3e",
                    "sense_definition": "A roll of material with sound-absorbing properties used for soundproofing walls or ceilings.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The contractor installed an acoustic <w>quilt</w> inside the walls to reduce the noise from the street.",
                            "target_lang_translations": {
                                "ru": "Подрядчик установил акустический <w>мат</w> внутри стен, чтобы уменьшить шум с улицы."
                            }
                        },
                        {
                            "text": "We used a specialized mineral wool <w>quilt</w> for the soundproofing project in the recording studio.",
                            "target_lang_translations": {
                                "ru": "Мы использовали специальное <w>полотно</w> из минеральной ваты для проекта звукоизоляции в студии звукозаписи."
                            }
                        }
                    ],
                    "synonyms": [
                        "insulation",
                        "batting"
                    ],
                    "common_phrases": [
                        "acoustic quilt",
                        "insulation quilt"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Рулон материала со звукопоглощающими свойствами, используемый для звукоизоляции стен или потолков."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звукоизоляционный мат",
                                "target_lang_sense_clarification": "технический термин"
                            },
                            {
                                "target_lang_word": "прошитый мат",
                                "target_lang_sense_clarification": "в строительстве"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "281bbf5a-39ec-3a36-86ba-eb27c284063b",
                    "sense_definition": "To stitch together layers of fabric and padding to create a thick, warm cover or garment.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local craft group meets every Tuesday to <w>quilt</w> together for charity.",
                            "target_lang_translations": {
                                "ru": "Местная группа рукоделия встречается каждый вторник, чтобы вместе <w>стегать</w> одеяла для благотворительности."
                            }
                        },
                        {
                            "text": "She decided to <w>quilt</w> by hand instead of using a sewing machine for a more traditional look.",
                            "target_lang_translations": {
                                "ru": "Она решила <w>простегать</w> всё вручную, а не на швейной машинке, чтобы придать изделию более традиционный вид."
                            }
                        }
                    ],
                    "synonyms": [
                        "stitch",
                        "sew"
                    ],
                    "common_phrases": [
                        "quilt by hand"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сшивать слои ткани и наполнителя вместе, чтобы создать толстое теплое покрытие или одежду."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стегать",
                                "target_lang_sense_clarification": "прошивать слои"
                            },
                            {
                                "target_lang_word": "простегивать",
                                "target_lang_sense_clarification": "процесс шитья"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "986de458-22fe-36a5-be08-ba98cb6f5c9c",
                    "sense_definition": "To construct clothing or other items using the technique of stitching multiple layers together.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sewing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The designer chose to <w>quilt</w> the jacket to make it warmer for the winter collection.",
                            "target_lang_translations": {
                                "ru": "Дизайнер решил <w>простегать</w> куртку, чтобы сделать ее теплее для зимней коллекции."
                            }
                        },
                        {
                            "text": "They had to <w>quilt</w> together several folds of linen to make the heavy bed sheets.",
                            "target_lang_translations": {
                                "ru": "Им пришлось <w>сшить</w> вместе несколько слоев льна, чтобы сделать плотные простыни."
                            }
                        }
                    ],
                    "synonyms": [
                        "pad",
                        "line"
                    ],
                    "common_phrases": [
                        "quilt together"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изготавливать одежду или другие изделия, используя технику сшивания нескольких слоев ткани."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шить",
                                "target_lang_sense_clarification": "в технике стежки"
                            },
                            {
                                "target_lang_word": "выстегивать",
                                "target_lang_sense_clarification": "создавать узор стежкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a0d88437-a338-3f68-bf0f-e997515973d2",
                    "sense_definition": "To beat or thrash someone soundly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry man threatened to <w>quilt</w> the intruder if he didn't leave the property immediately.",
                            "target_lang_translations": {
                                "ru": "Рассерженный мужчина пригрозил <w>отлупить</w> незваного гостя, если тот немедленно не покинет территорию."
                            }
                        },
                        {
                            "text": "In the old story, the hero promised he would <w>quilt</w> his opponent for the insults he had endured.",
                            "target_lang_translations": {
                                "ru": "В старой сказке герой пообещал, что <w>всыплет</w> своему противнику за все перенесенные оскорбления."
                            }
                        }
                    ],
                    "synonyms": [
                        "thrash",
                        "beat",
                        "whip",
                        "flog"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "archaic or regional"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сильно избить или отлупить кого-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отлупить",
                                "target_lang_sense_clarification": "разговорное, устаревшее"
                            },
                            {
                                "target_lang_word": "всыпать",
                                "target_lang_sense_clarification": "наказать побоями"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}