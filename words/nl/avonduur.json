            "senses": [
                {
                    "sense_id": "c41b5bc1-ba54-32ae-9d8a-fbd7b0c8123a",
                    "sense_definition": "Een uur gedurende de avondperiode.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "tijdstip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De winkel was ook in de <w>avonduren</w> nog geopend voor klanten.",
                            "target_lang_translations": {
                                "en": "The shop was still open for customers during the <w>evening hours</w>.",
                                "ru": "Магазин был открыт для покупателей и в <w>вечерние часы</w>."
                            }
                        },
                        {
                            "text": "Veel mensen werken liever overdag dan tijdens de <w>avonduren</w>.",
                            "target_lang_translations": {
                                "en": "Many people prefer working during the day rather than during the <w>evening hours</w>.",
                                "ru": "Многие люди предпочитают работать днем, а не в <w>вечернее время</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "ochtenduren"
                    ],
                    "common_phrases": [
                        "tijdens de avonduren",
                        "late avonduren"
                    ],
                    "target_lang_definitions": {
                        "en": "An hour during the evening period.",
                        "ru": "Час в вечерний период времени."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "evening hours",
                                "target_lang_sense_clarification": "referring to the time spent during the evening"
                            },
                            {
                                "target_lang_word": "evenings",
                                "target_lang_sense_clarification": "general time of day"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вечерние часы",
                                "target_lang_sense_clarification": "время, проведенное вечером"
                            },
                            {
                                "target_lang_word": "вечернее время",
                                "target_lang_sense_clarification": "общий период времени вечером"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "617b8080-8b4b-354a-8ea2-736394abe97a",
                    "sense_definition": "De tijd van de avond; het vallen van de avond.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "tijdstip",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het <w>avonduur</w> bracht een aangename koelte na de hete zomerdag.",
                            "target_lang_translations": {
                                "en": "The <w>evening hour</w> brought a pleasant coolness after the hot summer day.",
                                "ru": "<w>Вечерний час</w> принес приятную прохладу после жаркого летнего дня."
                            }
                        },
                        {
                            "text": "In het stille <w>avonduur</w> hoorde men alleen het ritselen van de bladeren.",
                            "target_lang_translations": {
                                "en": "In the quiet <w>eventide</w>, one could only hear the rustling of the leaves.",
                                "ru": "В тихий <w>вечерний час</w> слышался только шелест листьев."
                            }
                        }
                    ],
                    "synonyms": [
                        "avondstond",
                        "eventide"
                    ],
                    "common_phrases": [
                        "het stille avonduur"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak in literair of poëtisch verband gebruikt"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The time of evening; the falling of the evening.",
                        "ru": "Время вечера; наступление вечера."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eventide",
                                "target_lang_sense_clarification": "literary or poetic term for evening"
                            },
                            {
                                "target_lang_word": "evening hour",
                                "target_lang_sense_clarification": "a specific, often atmospheric, time in the evening"
                            },
                            {
                                "target_lang_word": "dusk",
                                "target_lang_sense_clarification": "the period of partial darkness between day and night"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "вечерний час",
                                "target_lang_sense_clarification": "конкретный, часто атмосферный момент вечера"
                            },
                            {
