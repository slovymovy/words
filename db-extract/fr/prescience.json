        "fr-extract.jsonl": [
            {
                "entry_id": "370acb4f-db2d-3d58-906b-8fdd7fa9ebef",
                "word": "prescience",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "00ae92b7-0681-4cb1-bd1c-4b296aff69fd",
                        "entry_id": "370acb4f-db2d-3d58-906b-8fdd7fa9ebef",
                        "tags": [
                            "plural"
                        ],
                        "form": "presciences"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc10d78f-63db-3656-91f2-4e5a41a69a2e",
                        "entry_id": "370acb4f-db2d-3d58-906b-8fdd7fa9ebef",
                        "glosses": [
                            "Connaissance de l’avenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3366704c-9278-4fcf-8f23-713db2dc13c9",
                                "sense_id": "fc10d78f-63db-3656-91f2-4e5a41a69a2e",
                                "text": "La prescience des événements prochains."
                            },
                            {
                                "example_id": "c2761cca-7376-4385-9d7e-6150fab97c98",
                                "sense_id": "fc10d78f-63db-3656-91f2-4e5a41a69a2e",
                                "text": "La prescience divine."
                            },
                            {
                                "example_id": "2fa133f4-e830-49e9-8ce9-8053ce9d82e3",
                                "sense_id": "fc10d78f-63db-3656-91f2-4e5a41a69a2e",
                                "text": "Je voudrais deviner le sens de cette minute, sentir son urgence, jouir un peu de cette obscure prescience vitale que je prête à Musset, à Hugo. Naturellement je n’aperçois que des brumes."
                            },
                            {
                                "example_id": "0c24a848-b534-496b-b853-45cf077aa475",
                                "sense_id": "fc10d78f-63db-3656-91f2-4e5a41a69a2e",
                                "text": "Une obscure prescience semblait l’avoir avertie qu’elle pouvait perdre son trône."
                            }
                        ]
                    },
                    {
                        "sense_id": "21228ef6-5a21-3b9d-bf3f-41de5bb1dad1",
                        "entry_id": "370acb4f-db2d-3d58-906b-8fdd7fa9ebef",
                        "glosses": [
                            "Prévision de l’avenir."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "101353c9-2eb8-41e3-b6b3-a116944719a4",
                                "sense_id": "21228ef6-5a21-3b9d-bf3f-41de5bb1dad1",
                                "text": "Quant à Godefroy, qui, dans un moment de prescience, sans doute, voyait avec peine tous ces arrangements, il donna pour tout don à sa nièce ce chapelet…"
                            },
                            {
                                "example_id": "51e2a074-2458-49e2-a1a6-5ec88a96076b",
                                "sense_id": "21228ef6-5a21-3b9d-bf3f-41de5bb1dad1",
                                "text": "Il était malade, très malade : cela, maintenant, tournait à la certitude, s’imposait à elle par une véritable divination, où il entrait moins de raisonnement que de subtile prescience."
                            },
                            {
                                "example_id": "9cd4ba66-d730-4549-ba69-b58d1e98915c",
                                "sense_id": "21228ef6-5a21-3b9d-bf3f-41de5bb1dad1",
                                "text": "Alors, ses larmes coulèrent librement, son cœur se déchirait et saignait, dans sa prescience du lendemain de sa mort, ce grand enfant adoré en qui leur race et tout un monde croulaient."
                            },
                            {
                                "example_id": "4366507d-297c-460e-a76e-d509ec05171d",
                                "sense_id": "21228ef6-5a21-3b9d-bf3f-41de5bb1dad1",
                                "text": "Et alors, ce rire de gorge qui lui renversait la tête en arrière, découvrait ses dents d’une blancheur laiteuse, donnait à Jacques une sensation de désir et une prescience de voluptés grisantes."
                            },
                            {
                                "example_id": "79c777f4-dbf3-4fc3-aaff-2c55ce0b29c7",
                                "sense_id": "21228ef6-5a21-3b9d-bf3f-41de5bb1dad1",
                                "text": "Je commence à être à l’âge où l’on dit bonjour aux vieilles dames qu’on rencontre deux fois de suite, par prescience plus aiguë du temps où je serai l’une d’entre elles. À vingt ans, je ne les voyais pas, elle seraient morte avant que j’aie des rides."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "705f5101-5fc8-4a5b-b51d-fdeb2ffda5bb",
                        "source_entry_id": "370acb4f-db2d-3d58-906b-8fdd7fa9ebef",
                        "target_lang_word": "prescience",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prescience",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                        "entry_id": "7cd62e9c-e2bb-39a8-aab5-4cda454683b1",
                                        "glosses": [
                                            "Knowledge of events before they take place."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f0d1a58-8434-48d1-9bdc-b1c42d958829",
                                                "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                                "text": "Near-synonyms: foreknowledge, foresight"
                                            },
                                            {
                                                "example_id": "679bc3d4-3873-42a7-be93-3f882d517e3b",
                                                "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                                "text": "God's certain prescience of the volitions of moral agents"
                                            },
                                            {
                                                "example_id": "f506670c-f461-405d-a6c1-8835ffede5ec",
                                                "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                                "text": "O thou, who thus the eye hast veil'd,\nThe book of fate so slowly given,\nI thank thee, that thou hast conceal'd\nFrom man the prescience of heaven."
                                            },
                                            {
                                                "example_id": "c53d298a-a76e-43c7-9f1b-f4411b1faf68",
                                                "sense_id": "87c27c60-1afb-3de7-94c7-966e25670215",
                                                "text": "With prescience, the Barlows designed them to withstand a third more weight than they would be expected to bear in normal conditions - future proofing the bridge for the weight of trains we see using it today."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dd2ee885-9682-41ba-bc00-2da19bbe5988",
                        "source_entry_id": "370acb4f-db2d-3d58-906b-8fdd7fa9ebef",
                        "target_lang_word": "foreknowledge",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foreknowledge",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "76f4d3f0-e91f-3a14-a066-00d2cab37037",
                                        "entry_id": "8cf453e0-5493-36d7-9058-db70116f35e9",
                                        "glosses": [
                                            "Knowing beforehand; foresight, precognition, prescience."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0e79acd-aac9-4835-897c-a1b539cc3308",
                                                "sense_id": "76f4d3f0-e91f-3a14-a066-00d2cab37037",
                                                "text": "[H]e [Paul] laboureth to comfort Timothy vvith the remembrance of the ſtedfaſtneſs of Gods eternal decree of Election, becauſe grounded on his foreknowledge; […]"
                                            },
                                            {
                                                "example_id": "37fb29b8-a3a3-4002-bd9e-4be333d588d3",
                                                "sense_id": "76f4d3f0-e91f-3a14-a066-00d2cab37037",
                                                "text": "The mule knows the hidden pitfalls of the morass; the swallow feels the storm ere it comes upon the air, and wings to the quiet shelter of its nest—they foresee their dangers, and avoid them; while we blindly rush forward into the depths of the pit and the fury of the tempest; for we know not what evils await us. No kind foreknowledge gives us even the choice of avoidance."
                                            },
                                            {
                                                "example_id": "30d75356-dda4-4292-9367-e1280b4990d9",
                                                "sense_id": "76f4d3f0-e91f-3a14-a066-00d2cab37037",
                                                "text": "But two bottles would alarm and confuse him, would lead to a conversation, so I smashed it merrily into a skip, buzzed and lit with the comforting foreknowledge of the second one on its way."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a14ec449-759c-4a43-ab59-b02d7e755fdd",
