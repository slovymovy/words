                "senses": [
                    {
                        "sense_id": "fd6b53e7-125b-311b-862d-df40f8d30a08",
                        "entry_id": "a80a1dd0-379e-3f3b-8d5b-c68469d6cc2d",
                        "glosses": [
                            "mieszkaniec Rostowa albo Rostowa nad Donem; osoba z jednego z tych miast"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b48e45d0-c1ff-447e-9ff7-79ff2fcc6074",
                                "sense_id": "fd6b53e7-125b-311b-862d-df40f8d30a08",
                                "text": "Suzdalczycy, włodzimierzanie, rostowianie, pskowianie szli do walki jako przedstawiciele swych księstw, ale wrócili jako obywatele Rusi, tyle że mieszkający w różnych miastach"
                            },
                            {
                                "example_id": "5955c538-4b3f-4293-a058-0f1c20de7c31",
                                "sense_id": "fd6b53e7-125b-311b-862d-df40f8d30a08",
                                "text": "Michałowski przyjął młodego rostowianina do swojej klasy w Instytucie Muzycznym, a przyjaciółka matki zorganizowała mu pierwsze źródło utrzymania – lekcje muzyki"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
