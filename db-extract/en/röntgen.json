                    {
                        "translation_id": "03b572d2-43ee-48bb-916b-06ab235663d1",
                        "source_entry_id": "8da20f89-5b90-38fb-9c53-1d1d2fc9347b",
                        "source_sense_id": "6a25048d-d410-3487-8403-5ce699d22525",
