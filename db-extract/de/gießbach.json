                        "target_lang_word": "torrent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                        "entry_id": "01e657ee-2a8f-35aa-8d8e-68fff78df68a",
                                        "glosses": [
                                            "A violent flow, as of water, lava, etc.; a stream suddenly raised and running rapidly, as down a precipice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ae63836-184e-4593-acd6-b0db9ecd5294",
                                                "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                                "text": "Rain fell on the hills in torrents."
                                            },
                                            {
                                                "example_id": "32832dea-d134-491f-a494-96ee1f54af11",
                                                "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                                "text": "A torrent of green and white water broke over the hull of the sail-boat."
                                            },
                                            {
                                                "example_id": "246df152-77a0-4ae9-b8f8-00ac2464347e",
                                                "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                                "text": "\"Try not the Pass!\" the old man said; / \"Dark lowers the tempest overhead, / The roaring torrent is deep and wide!\" / And loud that clarion voice replied / Excelsior!"
                                            },
                                            {
                                                "example_id": "992afae0-ec92-43d1-859a-32d218a36300",
                                                "sense_id": "8f6943d3-7113-36a3-8658-694161279b00",
                                                "text": "Floods in northern India, mostly in the small state of Uttarakhand, have wrought disaster on an enormous scale.[…]Rock-filled torrents smashed vehicles and homes, burying victims under rubble and sludge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                        "entry_id": "01e657ee-2a8f-35aa-8d8e-68fff78df68a",
                                        "glosses": [
                                            "A large amount or stream of something."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e196229a-d0cf-491c-8c54-670d96b80bca",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "They endured a torrent of inquiries."
                                            },
                                            {
                                                "example_id": "fb150225-e8d2-43f9-bbea-0c75c658cf87",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "The wind was a torrent of darkness among the gusty trees, / The moon was a ghostly galleon tossed upon cloudy seas, / The road was a ribbon of moonlight over the purple moor, / And the highwayman came riding— / Riding—riding— / The highwayman came riding, up to the old inn-door."
                                            },
                                            {
                                                "example_id": "b7ac3658-f8a2-4bbc-b792-4012236d112b",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "On the banks of the grey torrent of life, love is the only flower."
                                            },
                                            {
                                                "example_id": "bde1b1f2-b388-4835-80dd-4c879e47caed",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "Western civilization has always taught the repression of emotion […] The emotional torrents of opera rebel against this."
                                            },
                                            {
                                                "example_id": "87f4aecd-0def-4029-afd0-b342da9d5068",
                                                "sense_id": "67fc15c9-f1c5-37b0-bfcc-4e3d93859438",
                                                "text": "A new stream of migrants is leaving the continent. It threatens to become a torrent if the debt crisis continues to worsen."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "594eb05c-2d06-374f-8745-c77c11e0ca57",
                                        "entry_id": "3632b31f-818b-37ac-b73e-7968398d3459",
                                        "glosses": [
                                            "Rolling or rushing in a rapid stream."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fd68a25a-86de-4d41-927a-6494bc9a84fc",
                                                "sense_id": "594eb05c-2d06-374f-8745-c77c11e0ca57",
                                                "text": "Waves of torrent fire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b89518b-1aa5-3776-9124-5ec0c84ca1a8",
                                        "entry_id": "1c03a6bb-cf3f-34ef-b4ed-413c7baed5c3",
                                        "glosses": [
                                            "To fall or flow in a torrent; to pour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cef968c-fa37-4788-a2dc-7332ce5a02cb",
                                                "sense_id": "4b89518b-1aa5-3776-9124-5ec0c84ca1a8",
                                                "text": "Outside[,] rain was torrenting down, lightning and thunder heralded the arrival of a summer storm."
                                            },
                                            {
                                                "example_id": "f0023f20-01e8-4f3e-9855-b9b62ad95899",
                                                "sense_id": "4b89518b-1aa5-3776-9124-5ec0c84ca1a8",
                                                "text": "... through the inflexible rain, each turn in the track revealed a new cascade, torrenting down the steep cliff of the hill. The weather was too wild for me to get to them. In good weather, they wouldn't exist."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8180e353-973a-3a59-be20-548c8c6f23fa",
                                        "entry_id": "f9da5cfe-fc29-39b8-bb83-64ff2cbd9612",
                                        "glosses": [
                                            "A set of files obtainable through a peer-to-peer network, especially BitTorrent."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b786eda0-3aa8-4c54-a4ed-5356ec4a2741",
                                                "sense_id": "8180e353-973a-3a59-be20-548c8c6f23fa",
                                                "text": "I got a torrent of the complete works of Shakespeare the other day; I'm not sure why."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "torrent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1bc18e4a-d62b-30b6-98e7-2d8ae7f41622",
                                        "entry_id": "7bedd247-ba11-309b-a5a7-094d789d8aa2",
                                        "glosses": [
                                            "To download in a torrent."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0afb7f9-3b5f-4ebc-b579-a6740e8a464a",
                                                "sense_id": "1bc18e4a-d62b-30b6-98e7-2d8ae7f41622",
                                                "text": "The video rental place didn't have the film I was after, but I managed to torrent it."
                                            },
                                            {
                                                "example_id": "68853dcc-82ac-4595-931c-bb8051e57f45",
                                                "sense_id": "1bc18e4a-d62b-30b6-98e7-2d8ae7f41622",
                                                "text": "They had two thousand CDs burned with Listnin loaded on them, including versions for every major phone OS, and they'd set up a dozen servers in seven different countries for people to torrent the file from."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
