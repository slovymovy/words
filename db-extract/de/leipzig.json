                                                "example_id": "62c01ed2-8336-4fd0-a4d3-a9c9132bf1f8",
                                                "sense_id": "05d1aa5e-089d-3bf3-a001-636b230457f4",
                                                "text": "Je profitai de la Leipziger Messe, la fameuse foire de Leipzig, où il était possible de se rendre, pour pénétrer clandestinement en RDA."
                                            },
                                            {
                                                "example_id": "646e23da-74dd-40c1-b22e-8c66f30cd7a7",
                                                "sense_id": "05d1aa5e-089d-3bf3-a001-636b230457f4",
                                                "text": "Abdou Diallo est prêté au RB Leipzig avec une option d’achat, Layvin Kurzawa, lui, rejoint Fulham sous la forme d’un prêt, alors qu’Idrissa Gueye a signé un contrat de deux ans à Everton, contre une dizaine de millions d’euros."
                                            },
                                            {
                                                "example_id": "aa2ba57b-6226-46ee-9b3e-51a622765e83",
                                                "sense_id": "05d1aa5e-089d-3bf3-a001-636b230457f4",
                                                "text": "Un autre international tricolore, Christopher Nkunku, avait réduit le score pour Leipzig."
                                            }
                                        ]
                                    }
                                ]
                            },
