                                "sense_id": "c738825a-9466-3b46-90cb-6729ab364589",
                                "text": "Ces allumeuses michetonnent les mecs du quartier.",
                                "translation": "Die uitdagende wijven pikken de kerels van de buurt op."
                            }
                        ]
                    },
                    {
                        "sense_id": "189e1b15-485e-3bfc-bac1-da509c0892c6",
