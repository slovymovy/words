    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "96e73ac6-c2ed-32ab-8c80-afeb555aa99c",
                    "sense_definition": "To provide food or drink to someone, especially at a meal or in a restaurant.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "food_service",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter <w>served</w> us quickly because we were in a hurry.",
                            "target_lang_translations": {
                                "ru": "Официант быстро <w>обслужил</w> нас, потому что мы торопились.",
                                "pl": "Kelner szybko nas <w>obsłużył</w>, ponieważ się spieszyliśmy."
                            }
                        },
                        {
                            "text": "They <w>serve</w> breakfast until ten o'clock in the morning.",
                            "target_lang_translations": {
                                "ru": "Они <w>подают</w> завтрак до десяти часов утра.",
                                "pl": "Śniadanie <w>podają</w> do dziesiątej rano."
                            }
                        }
                    ],
                    "synonyms": [
                        "wait on",
                        "attend to"
                    ],
                    "common_phrases": [
                        "serve dinner",
                        "serve drinks",
                        "serve hot",
                        "serve customers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять еду или напитки кому-либо, особенно во время еды или в ресторане.",
                        "pl": "Podawać jedzenie lub napoje komuś, szczególnie podczas posiłku lub w restauracji."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подава́ть",
                                "target_lang_sense_clarification": "еду или напитки на стол"
                            },
                            {
                                "target_lang_word": "обслу́живать",
                                "target_lang_sense_clarification": "клиентов в ресторане"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "podawać",
                                "target_lang_sense_clarification": "jedzenie lub napoje do stołu"
                            },
                            {
                                "target_lang_word": "serwować",
                                "target_lang_sense_clarification": "dania w restauracji"
                            },
                            {
                                "target_lang_word": "obsługiwać",
                                "target_lang_sense_clarification": "klientów w lokalu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c19b1e70-f3cf-3be5-be25-e8d5b761922b",
                    "sense_definition": "To perform duties for an organization, country, or person, often in an official capacity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "duty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to join the army and <w>serve</w> his country.",
                            "target_lang_translations": {
                                "ru": "Он решил пойти в армию и <w>служить</w> своей стране.",
                                "pl": "Zdecydował się wstąpić do armii i <w>służyć</w> swojemu krajowi."
                            }
                        },
                        {
                            "text": "She has <w>served</w> on the school board for over five years.",
                            "target_lang_translations": {
                                "ru": "Она <w>служила</w> в школьном совете более пяти лет.",
                                "pl": "<w>Zasiadała</w> w radzie szkoły przez ponad pięć lat."
                            }
                        }
                    ],
                    "synonyms": [
                        "work for",
                        "act for"
                    ],
                    "antonyms": [
                        "rule",
                        "govern"
                    ],
                    "common_phrases": [
                        "serve in the army",
                        "serve the community",
                        "serve as a member",
                        "serve under"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять обязанности перед организацией, страной или человеком, часто в официальном качестве.",
                        "pl": "Wykonywać obowiązki na rzecz organizacji, kraju lub osoby, często w charakterze oficjalnym."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служи́ть",
                                "target_lang_sense_clarification": "в армии или на государственной службе"
                            },
                            {
                                "target_lang_word": "рабо́тать",
                                "target_lang_sense_clarification": "выполнять обязанности"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "służyć",
                                "target_lang_sense_clarification": "w wojsku lub dla kraju"
                            },
                            {
                                "target_lang_word": "pełnić służbę",
                                "target_lang_sense_clarification": "wykonywać oficjalne obowiązki"
                            },
                            {
                                "target_lang_word": "zasiadać",
                                "target_lang_sense_clarification": "być członkiem zarządu lub rady"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ea9e0a0-4583-3780-a08b-682c75c04c9f",
                    "sense_definition": "To hit the ball to start a point in games like tennis or volleyball.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sports",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is your turn to <w>serve</w> the ball.",
                            "target_lang_translations": {
                                "ru": "Твоя очередь <w>подавать</w> мяч.",
                                "pl": "Twoja kolej, żeby <w>zaserwować</w> piłkę."
                            }
                        },
                        {
                            "text": "She learned to <w>serve</w> with great power and accuracy.",
                            "target_lang_translations": {
                                "ru": "Она научилась <w>подавать</w> с большой силой и точностью.",
                                "pl": "Nauczyła się <w>serwować</w> z dużą siłą i precyzją."
                            }
                        }
                    ],
                    "antonyms": [
                        "receive"
                    ],
                    "common_phrases": [
                        "serve the ball",
                        "serve an ace"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударять по мячу для начала розыгрыша очка в таких играх, как теннис или волейбол.",
                        "pl": "Uderzać piłkę, aby rozpocząć wymianę w grach takich jak tenis czy siatkówka."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подава́ть",
                                "target_lang_sense_clarification": "мяч в спорте"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "serwować",
                                "target_lang_sense_clarification": "rozpoczynać grę w sporcie"
                            },
                            {
                                "target_lang_word": "podawać",
                                "target_lang_sense_clarification": "wykonywać zagrywkę"
                            },
                            {
                                "target_lang_word": "zagrywać",
                                "target_lang_sense_clarification": "wprowadzać piłkę do gry"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cfe77d2a-ac0e-388c-8ec4-ba79fa6dd5af",
                    "sense_definition": "To have a particular use or purpose, or to function as something.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "function",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This old sofa can <w>serve</w> as a bed for guests.",
                            "target_lang_translations": {
                                "ru": "Этот старый диван может <w>служить</w> кроватью для гостей.",
                                "pl": "Ta stara sofa może <w>służyć</w> jako łóżko dla gości."
                            }
                        },
                        {
                            "text": "The meeting <w>served</w> to clear up the confusion among the staff.",
                            "target_lang_translations": {
                                "ru": "Эта встреча <w>послужила</w> тому, чтобы прояснить путаницу среди сотрудников.",
                                "pl": "Spotkanie <w>posłużyło</w> wyjaśnieniu zamieszania wśród personelu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "serve a purpose",
                        "serve as a reminder",
                        "serve as a warning",
                        "serve to illustrate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Иметь определенное назначение или выполнять функцию чего-либо.",
                        "pl": "Mieć określone zastosowanie lub cel, bądź funkcjonować jako coś."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служи́ть",
                                "target_lang_sense_clarification": "являться чем-то, выполнять функцию"
                            },
                            {
                                "target_lang_word": "послужи́ть",
                                "target_lang_sense_clarification": "стать причиной или примером"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "służyć",
                                "target_lang_sense_clarification": "pełnić funkcję czegoś"
                            },
                            {
                                "target_lang_word": "posłużyć",
                                "target_lang_sense_clarification": "zostać wykorzystanym do czegoś"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24d1e789-a1fd-37bb-b9e5-9e5ee91a7705",
                    "sense_definition": "To spend a specific period of time in prison as a punishment.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "prison",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge ordered him to <w>serve</w> ten years for the crime.",
                            "target_lang_translations": {
                                "ru": "Судья приговорил его <w>отбывать</w> десять лет за преступление.",
                                "pl": "Sędzia nakazał mu <w>odbyć</w> karę dziesięciu lat więzienia za to przestępstwo."
                            }
                        },
                        {
                            "text": "He has <w>served</w> his time and is now a free man.",
                            "target_lang_translations": {
                                "ru": "Он <w>отбыл</w> свой срок и теперь свободный человек.",
                                "pl": "<w>Odsiedział</w> swój wyrok i jest teraz wolnym człowiekiem."
                            }
                        }
                    ],
                    "common_phrases": [
                        "serve time",
                        "serve a sentence",
                        "serve life"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить определенный период времени в тюрьме в качестве наказания.",
                        "pl": "Spędzać określony czas w więzieniu jako karę."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отбыва́ть",
                                "target_lang_sense_clarification": "срок наказания"
                            },
                            {
                                "target_lang_word": "сиде́ть",
                                "target_lang_sense_clarification": "в тюрьме (разговорное)"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "odbywać",
                                "target_lang_sense_clarification": "karę więzienia"
                            },
                            {
                                "target_lang_word": "odsiedzieć",
                                "target_lang_sense_clarification": "wyrok"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12dd6cba-6893-352f-909b-d8d7be1ce463",
                    "sense_definition": "To officially deliver a legal notice, summons, or document to someone.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The officers went to the house to <w>serve</w> a warrant.",
                            "target_lang_translations": {
                                "ru": "Офицеры пошли в дом, чтобы <w>вручить</w> ордер.",
                                "pl": "Funkcjonariusze udali się do domu, aby <w>doręczyć</w> nakaz."
                            }
                        },
                        {
                            "text": "She was <w>served</w> with a subpoena to appear in court next week.",
                            "target_lang_translations": {
                                "ru": "Ей <w>вручили</w> повестку о явке в суд на следующей неделе.",
                                "pl": "<w>Doręczono</w> jej wezwanie do stawienia się w sądzie w przyszłym tygodniu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "serve a warrant",
                        "serve a summons",
                        "serve papers"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально вручать юридическое уведомление, повестку или документ кому-либо.",
                        "pl": "Oficjalnie dostarczać komuś zawiadomienie prawne, wezwanie lub dokument."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вруча́ть",
                                "target_lang_sense_clarification": "документ или повестку"
                            },
                            {
                                "target_lang_word": "предъявля́ть",
                                "target_lang_sense_clarification": "ордер или обвинение"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "doręczać",
                                "target_lang_sense_clarification": "oficjalne pismo lub wezwanie"
                            },
                            {
                                "target_lang_word": "wręczać",
                                "target_lang_sense_clarification": "dokumenty prawne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7170b27a-d1e1-359e-85e0-bc7da3ddfcd5",
                    "sense_definition": "To display a very stylish, attractive, or impressive appearance or attitude.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "slang_appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>serving</w> pure elegance on the red carpet last night.",
                            "target_lang_translations": {
                                "ru": "Вчера вечером на красной дорожке она <w>демонстрировала</w> чистую элегантность.",
                                "pl": "Wczoraj wieczorem na czerwonym dywanie <w>serwowała</w> czystą elegancję."
                            }
                        },
                        {
                            "text": "The model came out <w>serving</w> a fierce look that stunned the audience.",
                            "target_lang_translations": {
                                "ru": "Модель вышла, <w>показывая</w> дерзкий образ, который ошеломил публику.",
                                "pl": "Modelka wyszła, <w>prezentując</w> drapieżny wygląd, który oszołomił publiczność."
                            }
                        }
                    ],
                    "common_phrases": [
                        "serve looks",
                        "serve face",
                        "serve realness"
                    ],
                    "traits": [
