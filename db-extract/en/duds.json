                    {
                        "translation_id": "f0735991-4999-407f-8875-abc55531ef4d",
                        "source_entry_id": "91822c45-59c2-3118-ad11-b4ef4b82b8dd",
                        "source_sense_description": "clothing, especially those for work or of rough appearance",
                        "target_lang_word": "лохмо́тья",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "лохмо́тья",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "75e9354e-f549-36c5-ab4e-e677f6c20665",
                                        "entry_id": "2874e0af-0129-36a7-b39e-5fbfe57a664c",
                                        "glosses": [
                                            "ветхая, изношенная одежда"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28d0839d-d85e-4f36-a7b2-b4cdbd1900ba",
                                                "sense_id": "75e9354e-f549-36c5-ab4e-e677f6c20665",
                                                "text": "― Снимите ваши лохмотья, вам дадут приличную куртку и штанишки, ― сказала девочка."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dbc2cc3-6f4d-3160-a19f-bb47f9bb50e9",
                                        "entry_id": "2874e0af-0129-36a7-b39e-5fbfe57a664c",
                                        "glosses": [
                                            "обрывки чего-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e57b7c8b-95fc-457f-87bd-89b0c0b222d6",
                                                "sense_id": "3dbc2cc3-6f4d-3160-a19f-bb47f9bb50e9",
                                                "text": "Он полез под подушку и отыскал в напиханном под неё белье одну, совершенно развалившуюся, старую, немытую свою рубашку. Из лохмотьев её он выдрал тесьму, в вершок шириной и вершков в восемь длиной."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "лохмо́тья",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "931a846d-c0fb-3702-8c2a-0823c8f88f9e",
                                        "entry_id": "ee3172de-6c28-3f96-99b4-069cec1fa9f8",
