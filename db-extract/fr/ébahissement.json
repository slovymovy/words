        "fr-extract.jsonl": [
            {
                "entry_id": "7de111ea-d114-3044-befb-cd1c2e31d9ed",
                "word": "ébahissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "08500f64-3709-4163-9bbf-27d65a90d6e3",
                        "entry_id": "7de111ea-d114-3044-befb-cd1c2e31d9ed",
                        "tags": [
                            "plural"
                        ],
                        "form": "ébahissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b9925c90-d8d9-37e1-93f1-9d979434db63",
                        "entry_id": "7de111ea-d114-3044-befb-cd1c2e31d9ed",
                        "glosses": [
                            "État de celui qui est ébahi."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e1e1b8e-3268-4e8a-8c62-732bc8b0cf80",
                                "sense_id": "b9925c90-d8d9-37e1-93f1-9d979434db63",
                                "text": "Quand il fut auprès d’elle, l’ébahissement lui fit écarquiller les prunelles : il ne comptait guère la trouver là."
                            },
                            {
                                "example_id": "dc81b73a-0631-49ec-9f99-de876d757df0",
                                "sense_id": "b9925c90-d8d9-37e1-93f1-9d979434db63",
                                "text": "À force de vouloir tout comprendre, tout me fait rêver. Il me semble pourtant que cet ébahissement-là n’est pas de la bêtise."
                            },
                            {
                                "example_id": "eab34f39-9d28-4f2f-a0ee-8664c821082a",
                                "sense_id": "b9925c90-d8d9-37e1-93f1-9d979434db63",
                                "text": "À voir les ébahissements de M. de La Seiglière écoutant l’impartial résumé de l’histoire de ces derniers temps, on eût dit qu’après s’être endormi sur les bords du Clain, il se réveillait en Chine, au milieu d’un groupe de bonzes, et déguisé lui-même en mandarin."
                            },
                            {
                                "example_id": "800cacc4-b5b3-4387-89f3-e9689983fa4d",
                                "sense_id": "b9925c90-d8d9-37e1-93f1-9d979434db63",
                                "text": "Les troupes exténuées, qui venaient d’un combat de trois jours, ne causaient, par leurs blessures et leur délabrement, que de l’ébahissement aux domestiques titrés, dorés et repus qui mangeaient à la table du Roi."
                            },
                            {
                                "example_id": "57d47b37-d29a-4fd1-9a64-960b766880fb",
                                "sense_id": "b9925c90-d8d9-37e1-93f1-9d979434db63",
                                "text": "Au delà de l'évocation pittoresque d'un passé un peu idéalisé […], ce texte donne des informations indirectes, mais précieuses, sur le rapport qui commence à s'établir entre un public populaire et le nouveau spectacle : l’ébahissement et la fascination ( « badaient devant les images » ) n'empêchent pas le recul critique ([…])."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9929a63d-4f8e-4dff-9a12-2749b0c22b2d",
                        "source_entry_id": "7de111ea-d114-3044-befb-cd1c2e31d9ed",
                        "source_sense_id": "b9925c90-d8d9-37e1-93f1-9d979434db63",
                        "target_lang_word": "Verblüffung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verblüffung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                        "entry_id": "fe4f308a-6251-3978-8e8d-63c77bdfbda2",
                                        "glosses": [
                                            "das Verblüfftsein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0403c31-c752-48a0-b339-3d001ad4f91f",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Die Verblüffung stand ihm ins Gesicht geschrieben."
                                            },
                                            {
                                                "example_id": "6562d9b7-2fd2-477b-873e-984916cc22cd",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Sie schien die Verblüffung ihres Angestellten nicht zu verstehen."
                                            },
                                            {
                                                "example_id": "b973adfb-e8b1-40b6-b0c3-60953aa0a2e2",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Weil er von der Feier bereits wusste, musste er seine Verblüffung vorheucheln."
                                            },
                                            {
                                                "example_id": "158271fb-c364-4b4f-8d91-98b0a9a320f9",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "Zu ihrer großen Verblüffung stellte sie fest, dass zu diesem Begriff kein Eintrag im Wörterbuch existierte."
                                            },
                                            {
                                                "example_id": "d71fdd03-8cda-4ea1-86d4-0d6479d9eff9",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Es fiel mir nicht schwer, ihr Freude zu machen durch eine große Verblüffung über die völlige Auffrischung ihres Haushalts.“"
                                            },
                                            {
                                                "example_id": "ef427031-dff6-46b9-b440-55449c833fd7",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Milde Verblüffung steht in Lampes Gesicht, als er den Digestor gründlich mustert.“"
                                            },
                                            {
                                                "example_id": "41160c7a-85d5-4001-b3d8-11653d15bed2",
                                                "sense_id": "6cfc663b-4249-3f36-846e-5589bc1c5cf2",
                                                "text": "„Eine Minute verging in allgemeiner Verblüffung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
