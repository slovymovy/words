                ],
                "senses": [
                    {
                        "sense_id": "4e8cf3fe-b0fe-3d09-b34b-8c0eeefb7035",
                        "entry_id": "65e73d34-030a-3ee8-99f9-8cdf7ea72f30",
                        "glosses": [
                            "völkerrechtliche Grundsätze, die während des Krieges für die kriegführenden Staaten untereinander sowie gegenüber neutralen Staaten gelten, Normen, an die man auch im Kriegszustand gebunden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3654e23a-5989-4f10-a83b-3dd43122aadf",
                                "sense_id": "4e8cf3fe-b0fe-3d09-b34b-8c0eeefb7035",
                                "text": "Das Kriegsrecht beinhaltet die strenge Anweisung, Kriegshandlungen nur gegen militärische Objekte zu richten."
                            },
                            {
                                "example_id": "aab79909-00a3-4e5b-a4e7-7805bb7a0c6c",
                                "sense_id": "4e8cf3fe-b0fe-3d09-b34b-8c0eeefb7035",
                                "text": "„Rund 7000 Widerstandskämpfer aus ganz Europa fielen diesem Kommando bis Kriegsende gegen alle Regeln des Kriegsrechts zum Opfer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1960cc28-3252-32d0-99f8-6100773ca866",
                        "entry_id": "65e73d34-030a-3ee8-99f9-8cdf7ea72f30",
                        "glosses": [
                            "schärfste Form des Ausnahmezustandes für ein Land"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cf9477d-3b18-4f5c-aa31-3558330f0d11",
                                "sense_id": "1960cc28-3252-32d0-99f8-6100773ca866",
                                "text": "Am 13.12.1981 wurde über Polen das Kriegsrecht verhängt, um einem Einmarsch von WAPA-Truppen vorzubeugen."
                            },
                            {
                                "example_id": "9d2cb9b9-7071-4d9b-9be3-33cbcdbdb979",
                                "sense_id": "1960cc28-3252-32d0-99f8-6100773ca866",
                                "text": "„Die Regierung sucht nach Auswegen aus der Krise, verhängt das Kriegsrecht und macht Zugeständnisse.“"
                            },
                            {
                                "example_id": "21be0da3-10f3-46b9-89d3-6fd301d4869d",
                                "sense_id": "1960cc28-3252-32d0-99f8-6100773ca866",
                                "text": "„Sollte Hindenburg die innere Sicherheit gefährdet sehen, könnte er das Kriegsrecht verhängen und ihn absetzen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
