                    {
                        "sense_id": "02d90095-c138-3d51-8292-83c8c88228c8",
                        "entry_id": "250c2f91-bde0-3306-ab7b-40d4d94c13ad",
                        "glosses": [
                            "A rural barangay or neighborhood."
                        ],
                        "tags": [
                            "Philippines"
                        ],
                        "examples": [
                            {
                                "example_id": "4c8ba264-9252-4a02-a901-9793f8650600",
                                "sense_id": "02d90095-c138-3d51-8292-83c8c88228c8",
                                "text": "In the barrio, they talked excitedly about the wood-gatherer's discovery. There was so much pushing and quibbling over details that by the time the barrio had organized itself to set out for Salug to investigate, dusk had already fallen."
                            }
                        ]
                    },
                    {
                        "sense_id": "8cf17a9f-315d-3fbf-bc91-c5c5c10dd1db",
                        "entry_id": "250c2f91-bde0-3306-ab7b-40d4d94c13ad",
                        "glosses": [
                            "An area or neighborhood in a US city inhabited predominantly by Spanish-speakers or people of Hispanic origin."
                        ],
                        "tags": [
                            "US",
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "b90af61d-61ef-4a49-9aaa-42193d1e875f",
                                "sense_id": "8cf17a9f-315d-3fbf-bc91-c5c5c10dd1db",
                                "text": "After World War II, its prospering working-class white residents moved to other, more upscale suburban developments, and by the 1950s the area had become an isolated ethnic enclave with its own barrio gang."
                            },
                            {
                                "example_id": "cbf6cc7d-ecd0-489c-85be-eb34c28c904a",
                                "sense_id": "8cf17a9f-315d-3fbf-bc91-c5c5c10dd1db",
                                "text": "Mr. Jones and me, stumbling through the barrio"
                            }
                        ]
                    }
