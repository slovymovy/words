        "fr-extract.jsonl": [
            {
                "entry_id": "36c0b597-c363-399b-bfbd-803810d88e51",
                "word": "foison",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1c2affb7-2e33-49e2-a0e3-db23b36b732e",
                        "entry_id": "36c0b597-c363-399b-bfbd-803810d88e51",
                        "tags": [
                            "plural"
                        ],
                        "form": "foisons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d52c945-f6e3-3453-85ea-3a84c253398d",
                        "entry_id": "36c0b597-c363-399b-bfbd-803810d88e51",
                        "glosses": [
                            "Très grande abondance."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "6e325c02-500c-45ab-b2e0-bf8b116067f3",
                                "sense_id": "7d52c945-f6e3-3453-85ea-3a84c253398d",
                                "text": "Il y aura foison de fruits cette année."
                            },
                            {
                                "example_id": "f4c66aa8-465d-46ab-b9d2-72b9264a1d35",
                                "sense_id": "7d52c945-f6e3-3453-85ea-3a84c253398d",
                                "text": "Simon quitta les rangs, s’avança, traînant les pieds, et faillit bien, sous cette foison de regards, perdre tout son contrôle."
                            },
                            {
                                "example_id": "bede9071-0943-4d8d-bc09-f8c7b71340f6",
                                "sense_id": "7d52c945-f6e3-3453-85ea-3a84c253398d",
                                "text": "Une foison de types intermédiaires [de villages] peuplés de propriétaires exploitants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a605de00-6ab5-44ff-b383-f2e86181a5a7",
                        "source_entry_id": "36c0b597-c363-399b-bfbd-803810d88e51",
                        "source_sense_id": "7d52c945-f6e3-3453-85ea-3a84c253398d",
                        "target_lang_word": "Hülle und Fülle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "29101b3f-80fb-4fc0-8887-4e91a02b6152",
                        "source_entry_id": "36c0b597-c363-399b-bfbd-803810d88e51",
                        "source_sense_id": "7d52c945-f6e3-3453-85ea-3a84c253398d",
                        "target_lang_word": "Fülle",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fülle",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d3a15d72-8e6f-385f-85b7-eb8df4a923d1",
                                        "entry_id": "ad5a5f90-057f-3acc-883f-0bc83ee4038f",
                                        "glosses": [
                                            "große Menge"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1832d4ec-535b-4b94-b0d0-ff252039256f",
                                                "sense_id": "d3a15d72-8e6f-385f-85b7-eb8df4a923d1",
                                                "text": "Die Polizei erhielt eine Fülle an Hinweisen."
                                            },
                                            {
                                                "example_id": "8ce8901a-c085-4635-ba83-7a7708f586f9",
                                                "sense_id": "d3a15d72-8e6f-385f-85b7-eb8df4a923d1",
                                                "text": "„Zudem gibt es eine Fülle von ethnischen Minderheiten, die nur lokal verbreitet sind.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f7b86833-c9ab-3786-ad54-bc5447ca1af1",
                                        "entry_id": "ad5a5f90-057f-3acc-883f-0bc83ee4038f",
                                        "glosses": [
                                            "Überfluss, das reichliche Vorhandensein von etwas"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfb63f43-b359-42a0-a221-b9f5574d231d",
                                                "sense_id": "f7b86833-c9ab-3786-ad54-bc5447ca1af1",
                                                "text": "Nahezu jede Bank bietet mittlerweile Tagesgeldkonten an. Um sich in dieser Fülle zurechtzufinden, ist es allemal ratsam, das bevorzugte Tagesgeldkonto im Zinsvergleich zu betrachten."
                                            },
                                            {
                                                "example_id": "be9ce213-171e-4ef1-a120-f5989258e29f",
                                                "sense_id": "f7b86833-c9ab-3786-ad54-bc5447ca1af1",
                                                "text": "„Frei und ungebunden steht er der Fülle des Lebens gegenüber und hat doch keine Ahnung, wo er ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b530c51f-84b4-3479-ba00-236b7c2fac59",
                                        "entry_id": "ad5a5f90-057f-3acc-883f-0bc83ee4038f",
                                        "glosses": [
                                            "das Dicksein, das Beleibtsein"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "77baf33d-aebd-3d57-83f5-446ada39d030",
                                        "entry_id": "ad5a5f90-057f-3acc-883f-0bc83ee4038f",
                                        "glosses": [
                                            "Masse zum Füllen von Lebensmitteln (einer Gans oder Ähnlichem)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a79684c-ba12-4cb8-979f-0f8b3de7a1d5",
                                                "sense_id": "77baf33d-aebd-3d57-83f5-446ada39d030",
                                                "text": "„[Die] Gans tra[n]chieren, mit der in Scheiben geschnittenen Fülle, und dem Saftrel servieren.“"
                                            },
                                            {
                                                "example_id": "b8904eed-858e-4c99-9f07-8698c1d9fefd",
                                                "sense_id": "77baf33d-aebd-3d57-83f5-446ada39d030",
                                                "text": "„Aus dem aufgefangenen Blut wurde die Fülle für Blutwürste zubereitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e4776bb1-7d2d-49ad-be82-29e8a3c91974",
                        "source_entry_id": "36c0b597-c363-399b-bfbd-803810d88e51",
                        "source_sense_id": "7d52c945-f6e3-3453-85ea-3a84c253398d",
                        "target_lang_word": "overvloed",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "overvloed",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                        "entry_id": "91de9a6e-6fda-3449-a7c0-d17d16bc6758",
                                        "glosses": [
                                            "het voorhanden zijn van meer dan voldoende van iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7136de4-062d-42e1-99be-94b85c3246e0",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Dat had de bodem gelegd voor de welstand, om niet te zeggen overvloed, van de voltallige familie voor de nabije toekomst."
                                            },
                                            {
                                                "example_id": "d876f1c7-8c33-4ead-867f-b69e0d307e44",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Er was een overvloed van aardbeien dat jaar."
                                            },
                                            {
                                                "example_id": "e4d7f0e0-375a-4480-bebf-e6866abf8120",
                                                "sense_id": "265cba31-f777-3528-90d9-889246853c42",
                                                "text": "Menselijke aangelegenheden waren al net zo onveranderlijk als de seizoenen. Keizerrijken bloeiden op en raakten in verval. Perioden van overvloed werden afgewisseld met hongersnoden, maar in essentie bleef alles bij het oude."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b274957d-f4c8-41f6-8f03-4b4eac457856",
                        "source_entry_id": "36c0b597-c363-399b-bfbd-803810d88e51",
                        "source_sense_id": "7d52c945-f6e3-3453-85ea-3a84c253398d",
                        "target_lang_word": "obfitość",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obfitość",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                        "entry_id": "9235ea52-b148-3ae7-9ab8-99d039ad019c",
                                        "glosses": [
                                            "duża, w zupełności wystarczająca ilość czegoś"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32ccaf63-bd39-47dd-8a38-4f7d88503cd0",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Nie będą już wiedzieli o obfitości w tym kraju wskutek głodu, który potem nadejdzie, bo będzie to głód bardzo ciężki."
                                            },
                                            {
                                                "example_id": "a2bbf424-341e-4ddc-af9e-94f3cbbfc5d6",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Wiedział, gdzie najłatwiej poławiają się kiełbie i płotki, lub w największej obfitości mieszkają szczupaki, u jakich brzegów raki najgęściej obsiadają podwodne mchy i kamienie, w jakiej porze dnia i roku jakie gatunki ryb na jakie biorą się przynęty"
                                            },
                                            {
                                                "example_id": "785867f8-fbb6-4f27-a0b2-3e159a41ad9e",
                                                "sense_id": "00128a71-f92f-3287-90be-cbaad964e47a",
                                                "text": "Mamy szczęście, że żyjemy w kraju pokoju i obfitości."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
