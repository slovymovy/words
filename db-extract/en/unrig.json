                "senses": [
                    {
                        "sense_id": "6f694510-e128-3dfb-89cc-f3f610c9c47d",
                        "entry_id": "6c6999d9-cfe8-31d9-8390-57dc6059951d",
                        "glosses": [
                            "To remove the rigging from (a vessel, etc.)."
                        ],
                        "tags": [
                            "intransitive",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "ced8c62e-b5f2-4f7e-b973-fc5b0bcc14f9",
                                "sense_id": "6f694510-e128-3dfb-89cc-f3f610c9c47d",
                                "text": "No, I have brought nothing but Ballaſt back,—made a delicious Voyage, Setter; and might have rode at Anchor in the Port till this time, but the Enemy ſurpriz'd us.— I vvou'd unrig."
                            },
                            {
                                "example_id": "7d9b52f2-86b8-4027-aaa8-c26d30152f43",
                                "sense_id": "6f694510-e128-3dfb-89cc-f3f610c9c47d",
                                "text": "Some climbed the masts to unrig her, others rushed into the hold to get out the cargo, and numbers hurried to the cabin to carry off the lighter articles which it contained."
                            },
                            {
                                "example_id": "25f67141-0f88-423a-8289-02431a247304",
                                "sense_id": "6f694510-e128-3dfb-89cc-f3f610c9c47d",
                                "text": "TRIPPING-LINE. A small rope serving to unrig the lower top-gallant yard-arm of its lift and brace, when in the act of sending it down on deck."
                            },
                            {
                                "example_id": "11075fb0-3082-46d6-a416-c6298f6e88f9",
                                "sense_id": "6f694510-e128-3dfb-89cc-f3f610c9c47d",
                                "text": "[I]n bathing costumes they unrigged the boat, put away the sails, and got her up to her resting place upon the dry sand of the beach."
                            }
                        ]
                    },
