                "senses": [
                    {
                        "sense_id": "a284d67b-cdda-3af7-9600-657adef82d41",
                        "entry_id": "c6fd8f44-8c98-36b4-9b7a-57da63cc3323",
                        "glosses": [
                            "Wiese mit hochstämmigen Obstbäumen, eine traditionelle Form des Obstbaus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88e2b9f8-3330-4ca5-8ad1-e3604c66bd23",
                                "sense_id": "a284d67b-cdda-3af7-9600-657adef82d41",
                                "text": "Heute gehören Streuobstwiesen zu den am stärksten gefährdeten Biotopen Mitteleuropas."
                            },
                            {
                                "example_id": "5b82e820-c1e8-4e10-89a2-9b5ce30e186d",
                                "sense_id": "a284d67b-cdda-3af7-9600-657adef82d41",
                                "text": "„In der Region um Metzingen prägen Streuobstwiesen die Landschaft.“"
                            },
                            {
                                "example_id": "9a5144aa-34c5-4c6c-848b-28d9ad008995",
                                "sense_id": "a284d67b-cdda-3af7-9600-657adef82d41",
                                "text": "„Streuobstwiesen müssen mühsam und zeitaufwendig von Hand gepflegt werden (z.B. Baumschnitt, Baumpflege, Mähen der Wiese).“"
                            },
                            {
                                "example_id": "8bb0d417-99d7-41ed-a32d-d99afe6dcc40",
                                "sense_id": "a284d67b-cdda-3af7-9600-657adef82d41",
                                "text": "„Seit den 1950er-Jahren, als es in Deutschland noch 1,5 Millionen Hektar Streuobstwiesen gab, ging der Bestand auf unter 300000 Hektar zurück.“"
                            },
                            {
                                "example_id": "320d1dab-23ef-4835-9f0f-b54afe1752c8",
                                "sense_id": "a284d67b-cdda-3af7-9600-657adef82d41",
                                "text": "„Der Steinkauz ist eine der Vogelarten, der auf die lichten Baumbestände der Streuobstwiesen angewiesen ist.“"
                            },
                            {
                                "example_id": "dae05f52-dfb0-48bc-8bae-ab703d821c87",
                                "sense_id": "a284d67b-cdda-3af7-9600-657adef82d41",
                                "text": "„Der Absatz von regional erzeugtem Apfelsaft von Streuobstwiesen, auch als Apfelschorle, ist schwierig. Hochwertig direkt gepresste Apfelsäfte (Direktsäfte) von Streuobstwiesen machen nur etwas 10% des deutschen Verbrauchs aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
