                        "examples": [
                            {
                                "example_id": "a15f21a7-6c85-48c6-8e07-de134b134b1f",
                                "sense_id": "3bd68be3-7b83-3e93-a74e-0341c45c0009",
                                "text": "Het paar voerde gesprekken met onder anderen luitenant-gouverneur Elizabeth Dowdeswell en de Nederlands sprekende premier Kathleen Wynne in het parlementsgebouw van de volkrijkste Canadese provincie."
                            },
                            {
                                "example_id": "0e0f7b71-4b5e-44b9-bbc7-ee3482d5ed17",
                                "sense_id": "3bd68be3-7b83-3e93-a74e-0341c45c0009",
                                "text": "Oud-president A.P.J. Abdul Kalam van India (83) is maandag overleden. Hij stond van 2002 tot 2007 aan het hoofd van de volkrijkste democratie ter wereld."
                            },
                            {
                                "example_id": "75ea941f-38de-43bb-b305-42bda976098a",
                                "sense_id": "3bd68be3-7b83-3e93-a74e-0341c45c0009",
                                "text": "Op hun beurt zien de oliestaten zich graag in de rug gesteund door het volkrijke Egypte, met name met het oog op hun veiligheid."
                            }
                        ]
