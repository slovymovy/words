                    {
                        "sense_id": "e7e7497b-a349-34b8-9438-fcda8397d461",
                        "entry_id": "5edfb4bf-92e5-33bd-89bc-0427d6c6af31",
                        "glosses": [
                            "deskundige op het gebied van het afweersysteem van levende organismen"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "f60ae301-2016-4c90-a291-ae5f83bc4a90",
                                "sense_id": "e7e7497b-a349-34b8-9438-fcda8397d461",
                                "text": "Bij proeven op apen is gebleken dat het vaccin voor 90 procent werkt. Nu moet het op mensen worden getest, verklaarde de immunoloog."
                            },
                            {
                                "example_id": "a46ae39d-72cd-4bc8-8574-24dc9e8eabda",
                                "sense_id": "e7e7497b-a349-34b8-9438-fcda8397d461",
                                "text": "En of hij blij is met de Spinoza-premie, laat tumor-immunoloog en UT-hoogleraar Carl Figdor weten. ‘Dit is de ultieme erkenning voor het werk dat ik doe. Ik ben er al dertig jaar lang, bijna 24 uur per dag mee bezig.’"
                            }
                        ]
                    },
                    {
                        "sense_id": "f6fb3029-3fb9-32aa-a45f-78b457baee76",
                        "entry_id": "5edfb4bf-92e5-33bd-89bc-0427d6c6af31",
                        "glosses": [
                            "arts gespecialiseerd in ziekten van het afweersysteem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae8657b3-6ead-4595-99e2-ea20765708bd",
                                "sense_id": "f6fb3029-3fb9-32aa-a45f-78b457baee76",
                                "text": "Jasper moet om de drie maanden naar de oncoloog. Verder zit hij eens per maand bij de kinderarts. Jos gaat van kinderarts naar kno-arts naar immunoloog."
                            }
                        ]
                    }
