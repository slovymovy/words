                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f8ba2588-13ec-46b2-ba45-4b529dad6f52",
                        "entry_id": "1323f95c-e469-3a6e-a5e7-99d3ed51e302",
                        "tags": [
                            "plural"
                        ],
                        "form": "poulardes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2ca4a032-b1ef-3c75-80b5-f40badcfa865",
                        "entry_id": "1323f95c-e469-3a6e-a5e7-99d3ed51e302",
                        "glosses": [
                            "Jeune poule engraissée."
                        ],
                        "tags": [
                            "Élevage"
                        ],
                        "examples": [
                            {
                                "example_id": "377f3573-d7ed-40d8-af54-25ee00ba5c4a",
                                "sense_id": "2ca4a032-b1ef-3c75-80b5-f40badcfa865",
                                "text": "La nourriture incrassante qu’elles recevaient de la main de leur maître, en les faisant passer peu à peu à l’état de poulardes, nuisait à la régularité de leur pondaison."
                            },
                            {
                                "example_id": "4f1aaba6-9015-408d-af46-d6b9ad6447c4",
                                "sense_id": "2ca4a032-b1ef-3c75-80b5-f40badcfa865",
                                "text": "Avec peu de soins et en peu de temps vous aurez des poulardes , des poulettes et des poulets d’une saveur exquise."
                            }
                        ]
                    },
                    {
                        "sense_id": "85bebe5b-db2d-3a69-ab7f-0154870aa9db",
                        "entry_id": "1323f95c-e469-3a6e-a5e7-99d3ed51e302",
                        "glosses": [
                            "Terme affectueux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1960d49a-c51c-4458-a6b3-83fdba6001fd",
                                "sense_id": "85bebe5b-db2d-3a69-ab7f-0154870aa9db",
                                "text": "Il n’y a qu’un nuage dans cette soirée délicieuse : j’ai perdu mon couteau… J’y tiens… j’irai le chercher ce soir… je lui ai écrit un mot… badin, pour la prévenir de ma visite. (Lisant sa lettre.) \"Ma grosse poularde… as-tu trouvé sur le tapis de ta chambre un couteau avec une scie, une lime et un tire-bouchon ? \""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fa90c65-6c96-4995-bef6-0cd5eb2a21e2",
                        "source_entry_id": "1323f95c-e469-3a6e-a5e7-99d3ed51e302",
                        "target_lang_word": "capponessa",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5c026c9b-30f1-4119-8236-998cb8e9e5ce",
                        "source_entry_id": "1323f95c-e469-3a6e-a5e7-99d3ed51e302",
                        "target_lang_word": "poularde",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "poularde",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "dcdda435-7d59-37e2-9607-e5249473c6d2",
                                        "entry_id": "e3f53cfa-79a9-3dbd-957c-7766254c9005",
                                        "glosses": [
                                            "jong hoen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36f2ee30-0ea1-40ef-9dfe-e6628aeb096a",
                                                "sense_id": "dcdda435-7d59-37e2-9607-e5249473c6d2",
                                                "text": "Albert slikte zijn mondvol poularde weg, greep zijn glas bordeaux en liet een waarderend gebrom horen om tijd te winnen."
                                            },
                                            {
                                                "example_id": "378d11c1-1574-467b-a1fc-34b8eecafab8",
                                                "sense_id": "dcdda435-7d59-37e2-9607-e5249473c6d2",
                                                "text": "Bij een intiem diner, thuis, mocht je kluiven. In Des Indes kregen we vispaté, zwezerik met asperges, getruffeerde poularde, en het was ongelooflijk hoe goed het allemaal georganiseerd was. Honderdvijftig gasten en niemand die koud eten kreeg, terwijl er tussendoor ook toespraken waren."
                                            },
                                            {
                                                "example_id": "f602ff15-c9b1-42e8-acfe-d6ce5fdc4183",
                                                "sense_id": "dcdda435-7d59-37e2-9607-e5249473c6d2",
                                                "text": "Weten zij veel dat je als Amsterdamse slechts twee handdrukken verwijderd bent van het Nederlandse sterrendom. Minder leuk: je staat bij een visboer en bestelt de la poularde (kip) in plaats van de la palourde (kokkels), en opeens blijkt dat Parijzenaars heel goed kunnen lachen. Om jou."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
