        "pl-extract.jsonl": [
            {
                "entry_id": "c5d01320-fbf3-360c-a0ec-48b958f3f90c",
                "word": "afabularność",
                "pos": "noun",
                "lang_code": "pl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3277ebfa-df2d-3d30-b201-29541aacf46d",
                        "entry_id": "c5d01320-fbf3-360c-a0ec-48b958f3f90c",
                        "glosses": [
                            "cecha utworu literackiego, filmowego, teatralnego, która polega na braku tradycyjnej fabuły"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af75a2ab-a79d-48f0-8014-28f38a91295e",
                                "sense_id": "3277ebfa-df2d-3d30-b201-29541aacf46d",
                                "text": "Zauważcie afabularność właśnie w filmach Andrieja Tarkowskiego."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29512618-8f30-4f76-bfd9-0b27b9bed11c",
                        "source_entry_id": "c5d01320-fbf3-360c-a0ec-48b958f3f90c",
                        "source_sense_id": "3277ebfa-df2d-3d30-b201-29541aacf46d",
                        "target_lang_word": "plotlessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "plotlessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4f629cc-439f-3628-a3a9-2c3cb5fced73",
                                        "entry_id": "abc72c74-f9cb-3b8a-af17-202fee250bcd",
                                        "glosses": [
                                            "The state of lacking a substantial plot or scheme."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "056bac0e-971a-4e4e-b1a7-a252a6dc00a9",
                                                "sense_id": "c4f629cc-439f-3628-a3a9-2c3cb5fced73",
                                                "text": "I was disappointed by the plotlessness of the film: it was all action and explosions."
                                            },
                                            {
                                                "example_id": "6cf553e2-1117-4cff-8533-5788ce36d8d1",
                                                "sense_id": "c4f629cc-439f-3628-a3a9-2c3cb5fced73",
                                                "text": "Both books pushed realism so far that it touched on surrealism, and both freeze-framed the present moment, compensating for their plotlessness by chronicling in loving detail the minutiae of late-20th-century life — the way the light falls on the handrail of a moving escalator, the design flaws of drinking-straws that, annoyingly, float instead of standing upright."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
