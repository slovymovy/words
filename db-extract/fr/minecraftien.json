                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "016b79aa-9d35-4296-9c37-7c90a328b7a7",
                        "source_entry_id": "0bb3f68e-bb06-341c-aa74-901d71efdcaa",
