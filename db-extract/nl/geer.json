                                        "entry_id": "c6249c9c-448f-35c7-a391-6bcf6ae2cf7b",
                                        "glosses": [
                                            "A yurt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5a63cac-6a88-495f-aa18-dc29286f2d1e",
                                                "sense_id": "465ee3e1-58bc-39cd-ae88-2d2bef32e531",
                                                "text": "The new bek's great-grandfather had passed every night of his life under the sky, on the back of a pony or in the felt walls of a ger, and Buljan retained the ancestral contempt for cities and city dwellers."
                                            },
                                            {
                                                "example_id": "1bba30ab-51cd-4f68-983d-78afebb3310e",
                                                "sense_id": "465ee3e1-58bc-39cd-ae88-2d2bef32e531",
                                                "text": "In weather conditions that hit -20 degrees or lower, people in the poorer areas of the city have no access to running water, no access to bathroom facilities, often living in little “yurts” or “gers” on dirt roads."
                                            }
                                        ]
                                    }
                                ]
