                                                "example_id": "5ab9a7e7-b026-457c-bff5-0063e8bc314a",
                                                "sense_id": "10ef9dda-7176-3ffb-8a99-6d9cc9d49561",
                                                "text": "В плену у немцев он пробыл ровно год."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88b88325-8ff2-35a7-9539-c054ad5b626e",
                                        "entry_id": "3ae2a1fd-ade7-3127-a1f2-20720460388a",
                                        "glosses": [
                                            "перен. состояние зависимости от чего-либо, подчинённости чему-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c29570d7-d14c-467d-be6d-35ae44c37b4c",
                                                "sense_id": "88b88325-8ff2-35a7-9539-c054ad5b626e",
                                                "text": "В плену табачного дыма."
                                            }
                                        ]
