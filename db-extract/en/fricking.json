                "senses": [
                    {
                        "sense_id": "55aef580-2626-3930-9f96-f6a58888159b",
                        "entry_id": "2bdbcbe8-a8d0-3f92-b23a-0ace43fac5e7",
                        "glosses": [
                            "A minced oath of \\\"fucking\\\" as an intensifier."
                        ],
                        "tags": [
                            "colloquial",
                            "euphemistic",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "2596ace1-4e38-4893-95ea-9bdf19a2143a",
                                "sense_id": "55aef580-2626-3930-9f96-f6a58888159b",
                                "text": "Throw me a fricking bone here!"
                            },
                            {
                                "example_id": "f9be50e3-a44e-42a0-a491-c5c4a45e064d",
                                "sense_id": "55aef580-2626-3930-9f96-f6a58888159b",
                                "text": "Geez, how many fricking questions are in this passage?"
                            },
                            {
                                "example_id": "3e262c02-3bab-4352-a25a-a57fd976b0de",
                                "sense_id": "55aef580-2626-3930-9f96-f6a58888159b",
                                "text": "You know, I have one simple request. And that is to have sharks with frickin’ laser beams attached to their heads!"
                            }
                        ]
                    }
                ],
