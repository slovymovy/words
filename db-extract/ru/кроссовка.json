                ],
                "senses": [
                    {
                        "sense_id": "774315cf-d8f5-329b-85bb-c849b2f315a9",
                        "entry_id": "f4f8ea12-85bd-3901-8c0d-748c47190eb2",
                        "glosses": [
                            "мн. ч. спортивная обувь для бега, ходьбы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc578fe3-7c0d-450d-8ebb-0a5d561f77ad",
                                "sense_id": "774315cf-d8f5-329b-85bb-c849b2f315a9",
                                "text": "Оделся, затянул ремень. Вместо мокрых кроссовок надел старенькие сандалии. Надо было идти в школу."
                            },
                            {
                                "example_id": "1cc5dc35-5a92-479b-9a4f-f04ddd8820ff",
                                "sense_id": "774315cf-d8f5-329b-85bb-c849b2f315a9",
                                "text": "Ногами, обутыми в пёстрые, как дятлы, нарядные кроссовки, он поддавал грибы."
                            },
                            {
                                "example_id": "05324c83-5c36-4094-aaac-71dcfb8777b5",
                                "sense_id": "774315cf-d8f5-329b-85bb-c849b2f315a9",
                                "text": "Чтобы процессор мог включить в вычисления также и «фазу полёта» (когда обе ноги в воздухе), правая кроссовка вдобавок снабжена датчиком, фиксирующим отрыв, а левая ― соприкосновение с землёй."
                            },
                            {
                                "example_id": "cfecef07-4d6c-429e-bb64-22878b6d1ca8",
                                "sense_id": "774315cf-d8f5-329b-85bb-c849b2f315a9",
                                "text": "[Гондольер] перед тем, как завернуть за угол дома напротив, оттолкнулся от стены ногой в кроссовке и, выровняв гондолу, запел ещё надрывнее, ― работал на туристов."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c371ee85-ee7b-4906-baed-a534723248c2",
                        "source_entry_id": "f4f8ea12-85bd-3901-8c0d-748c47190eb2",
                        "source_sense_id": "774315cf-d8f5-329b-85bb-c849b2f315a9",
                        "target_lang_word": "sneaker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sneaker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec9b58d-f51c-374d-8c00-606d81ec5be5",
                                        "entry_id": "296206c5-a6d3-31b2-8e67-bf476a0449db",
                                        "glosses": [
                                            "One who sneaks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b4493ab-8ccf-49b8-996a-fa241391362d",
                                                "sense_id": "0ec9b58d-f51c-374d-8c00-606d81ec5be5",
                                                "text": "Beshrew the man who on such a day as this, the general festival, should affect to stand aloof. I am none of those sneakers. I am free of the corporation, and care not who knows it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c80fed6f-b17e-37db-9ac4-da14bd12e9bc",
                                        "entry_id": "296206c5-a6d3-31b2-8e67-bf476a0449db",
                                        "glosses": [
                                            "An athletic shoe with a soft, rubber sole. A trainer."
                                        ],
                                        "tags": [
                                            "Atlantic-Canada",
                                            "Australia",
                                            "New-Zealand",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "876df3c0-4825-3faa-8704-1496c8d1a9f9",
                                        "entry_id": "296206c5-a6d3-31b2-8e67-bf476a0449db",
                                        "glosses": [
                                            "A vessel of drink."
                                        ],
                                        "tags": [
                                            "UK",
                                            "archaic",
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d933cc32-c7a1-41c9-ac73-b19ae0dde0fc",
                                                "sense_id": "876df3c0-4825-3faa-8704-1496c8d1a9f9",
                                                "text": "Spectator\nI have just left the right worshipful and his myrmidons about a sneaker of five gallons!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "765ae140-6b32-358c-ba5c-7bbf33c4040a",
                                        "entry_id": "296206c5-a6d3-31b2-8e67-bf476a0449db",
                                        "glosses": [
                                            "A large cup (or small basin) with a saucer and cover."
                                        ],
                                        "tags": [
                                            "India",
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "23835d07-1278-3c5e-bdd3-79e3f161b541",
                                        "entry_id": "296206c5-a6d3-31b2-8e67-bf476a0449db",
                                        "glosses": [
                                            "A sneaker male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a21c8a4d-2cba-44a5-bebe-4cd6f8e38c0c",
                                                "sense_id": "23835d07-1278-3c5e-bdd3-79e3f161b541",
                                                "text": "These sneakers may go on this way indefinitely, or, if one of the big males somehow dies or disappears, a sneaker male's hormones will trigger a huge growth spurt and he'll metamorphose into an alpha male."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "115f52fd-dd77-4253-9b1e-b58c3d080b60",
                        "source_entry_id": "f4f8ea12-85bd-3901-8c0d-748c47190eb2",
                        "source_sense_id": "774315cf-d8f5-329b-85bb-c849b2f315a9",
                        "target_lang_word": "Sneaker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sneaker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb2fc452-13a2-3b62-b85d-3fb81dbc6748",
                                        "entry_id": "a3640cb2-600e-3662-adaa-88086e0d0808",
                                        "glosses": [
                                            "Sportschuh für den Alltag"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4eb5f22-c911-48dc-8435-57fc98efbb6f",
                                                "sense_id": "bb2fc452-13a2-3b62-b85d-3fb81dbc6748",
                                                "text": "„Der Bruder des Modedesigners Kostas Murkudis führt in Berlin eine Reihe von Geschäften, in denen er Dinge verkauft, die er \"selbst gerne hätte\". Modeartikel wie Sneakers vom belgischen Designer Raf Simons und viele Einrichtungsgegenstände: Tischdekor aus Porzellan der Manufaktur Nymphenburg, Lobmeyer-Kronleuchter aus Wien, Stehlampen aus Berliner Hinterhofschmieden. “"
                                            },
                                            {
                                                "example_id": "5071fa59-6c3e-48a7-afeb-ffc6ee957d0e",
                                                "sense_id": "bb2fc452-13a2-3b62-b85d-3fb81dbc6748",
                                                "text": "„Wanderschuhe trägt in Island niemand, sondern alle unter vierzig tragen Sneaker.“"
                                            },
                                            {
                                                "example_id": "5293a1d2-708d-43a8-b763-127b218c490b",
                                                "sense_id": "bb2fc452-13a2-3b62-b85d-3fb81dbc6748",
                                                "text": "„Zu ihrem vierzehnten Geburtstag hatte sie sich sehnlichst Sneaker einer ganz speziellen Marke gewünscht und auch bekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
