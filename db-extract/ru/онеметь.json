                        ],
                        "form": "онеме́в"
                    },
                    {
                        "form_id": "bebde829-2459-43a4-a974-f3b08c31e6cb",
                        "entry_id": "3c6c361a-1d4b-3e97-8a0f-d9c0514ddd52",
                        "tags": [
                            "adverbial",
                            "participle",
                            "past"
                        ],
                        "form": "онеме́вши"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a59e18a9-095c-37f3-bf48-89c45ad34acd",
                        "entry_id": "3c6c361a-1d4b-3e97-8a0f-d9c0514ddd52",
                        "glosses": [
                            "стать немым, утратить способность говорить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af647d53-688c-4fc0-9745-63027dc29dd0",
                                "sense_id": "a59e18a9-095c-37f3-bf48-89c45ad34acd",
                                "text": "Марта 26 сестра моя занемогла оспой, от неё пристала и ко мне с такой силою, что я оглох, ослеп и онемел."
                            },
                            {
                                "example_id": "0eb36154-7d35-41f2-93a9-8b11941f392e",
                                "sense_id": "a59e18a9-095c-37f3-bf48-89c45ad34acd",
                                "text": "Онемела; в доме стало двое немых, и дом сделался тихим-тихим: весь в снегу, низкокрыший, ненужно большой и беззвучный."
                            }
                        ]
                    },
                    {
                        "sense_id": "a2bd4da3-1ebb-3c04-b328-4ebe41c654e2",
                        "entry_id": "3c6c361a-1d4b-3e97-8a0f-d9c0514ddd52",
                        "glosses": [
                            "утратить на время дар речи (от удивления, неожиданной радости, горя и т. п.); застыть в молчании"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e4adc4-c267-4339-8ff4-41ba24d208d7",
                                "sense_id": "a2bd4da3-1ebb-3c04-b328-4ebe41c654e2",
                                "text": "Поражённые неожиданною речью Милославского, все присутствующие онемели от удивления."
                            },
                            {
                                "example_id": "4bb68b7c-94e3-4de2-8c33-c169d9071625",
                                "sense_id": "a2bd4da3-1ebb-3c04-b328-4ebe41c654e2",
                                "text": "Вера и прежде-то была немногословна, а после этой смерти совсем замолчала, онемела."
                            }
                        ]
                    },
                    {
                        "sense_id": "b5a4b751-34f1-3215-86d6-0cd1c6b2b31e",
                        "entry_id": "3c6c361a-1d4b-3e97-8a0f-d9c0514ddd52",
                        "glosses": [
                            "перен. оцепенеть, утратить чувствительность, гибкость (о членах тела)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80c90471-31c9-4063-bb4b-546153ca3d24",
                                "sense_id": "b5a4b751-34f1-3215-86d6-0cd1c6b2b31e",
                                "text": "Неловко, рука затекла, локоть онемел, но я всё так же напряженно неподвижен, всё так же не шевелюсь, удерживая дыхание."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4299e7dc-c325-4012-aaa8-6a47bdbb6571",
                        "source_entry_id": "3c6c361a-1d4b-3e97-8a0f-d9c0514ddd52",
                        "source_sense_description": "стать немым, утратить способность говорить",
                        "target_lang_word": "devenir muet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "31529b0e-fc1f-4a70-8e55-c5c472e50e5a",
                        "source_entry_id": "3c6c361a-1d4b-3e97-8a0f-d9c0514ddd52",
                        "source_sense_description": "стать немым, утратить способность говорить",
                        "target_lang_word": "perdre l'usage de la parole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2ee38f8c-f1ff-4a84-8d2d-aeed6af618fc",
                        "source_entry_id": "3c6c361a-1d4b-3e97-8a0f-d9c0514ddd52",
                        "source_sense_description": "утратить на время дар речи (от удивления, неожиданной радости и т. п.); застыть в молчании",
                        "target_lang_word": "verstummen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verstummen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9939cfe7-5afd-32cc-81b5-1b16c8d12460",
                                        "entry_id": "01850c6a-2bad-391b-bbc4-bce28c43c1d7",
                                        "glosses": [
                                            "(plötzlich) aufhören, die Stimme zu gebrauchen"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "763e5f3f-830b-47e7-8226-21f37a20f539",
                                                "sense_id": "9939cfe7-5afd-32cc-81b5-1b16c8d12460",
                                                "text": "Kinder mit selektivem Mutismus können gut sprechen und sind im familiären Umfeld oft sogar als kleine Plaudertaschen bekannt. In einer anderen Umgebung verstummen sie hingegen – manchmal auch nur in bestimmten Situationen."
                                            },
                                            {
                                                "example_id": "09d0e053-b0ae-4355-9d93-3ab53ed41bdd",
                                                "sense_id": "9939cfe7-5afd-32cc-81b5-1b16c8d12460",
                                                "text": "Doch ich verstummte schon bald und verfiel in ein schwarzes Schweigen, das wie ein Schrei in mir widerhallte."
                                            },
                                            {
                                                "example_id": "762f6369-4b21-4f05-80d8-fc23c60c3aa0",
                                                "sense_id": "9939cfe7-5afd-32cc-81b5-1b16c8d12460",
                                                "text": "Ein kurzer Aufschrei kam über ihre Lippen, dann verstummte sie für einen Moment."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a4967e48-8952-31b6-8e3a-37bf51e7edfa",
                                        "entry_id": "01850c6a-2bad-391b-bbc4-bce28c43c1d7",
                                        "glosses": [
                                            "aufhören, Hörbares zu erzeugen"
                                        ],
                                        "tags": [
                                            "gehoben",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4569ae46-fdd2-4b72-a82f-c695456f163b",
                                                "sense_id": "a4967e48-8952-31b6-8e3a-37bf51e7edfa",
                                                "text": "Der Branche hängt immer noch der Abgasskandal nach, die Debatte über „schmutzigen“ Diesel will nicht verstummen, …"
                                            },
                                            {
                                                "example_id": "088244b1-e8e4-4e76-bab0-e56bcb4f70e3",
                                                "sense_id": "a4967e48-8952-31b6-8e3a-37bf51e7edfa",
                                                "text": "Rias Berlin, die „freie Stimme der freien Welt“, verstummte nach mehr als 40 Jahren am 31. Dezember 1993 um Mitternacht."
                                            },
                                            {
                                                "example_id": "7574c31b-6ff7-42e5-be02-9e3ac3e6e463",
                                                "sense_id": "a4967e48-8952-31b6-8e3a-37bf51e7edfa",
