                "senses": [
                    {
                        "sense_id": "93c58eb0-ea70-31be-8c9b-16c62b047b2c",
                        "entry_id": "6b208041-21ad-3569-af5f-c58921e51a4f",
                        "glosses": [
                            "совершить действие, выраженное гл. грозить; провести некоторое время, совершая такое действие"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b5065cea-d715-4af8-9375-8b92b9d6e345",
                        "source_entry_id": "6b208041-21ad-3569-af5f-c58921e51a4f",
                        "source_sense_id": "93c58eb0-ea70-31be-8c9b-16c62b047b2c",
                        "target_lang_word": "threaten",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "threaten",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "64bb4f5b-c099-36b9-af0d-53a545d29d30",
                                        "entry_id": "f2cf0a34-36fe-3a92-b00a-bf6c937bcadd",
                                        "glosses": [
                                            "To make a threat against someone; to use threats."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38dd86b7-8bd7-4dfb-b6ff-834acb0eb994",
                                                "sense_id": "64bb4f5b-c099-36b9-af0d-53a545d29d30",
                                                "text": "No one, however, would have anything to do with him, as Mr. Keeson's orders in those respects were very strict ; he had often threatened any one of his employés with instant dismissal if he found him in company with one of these touts."
                                            },
                                            {
                                                "example_id": "e1ede3a0-4ed9-4b83-88b5-821676f6579c",
                                                "sense_id": "64bb4f5b-c099-36b9-af0d-53a545d29d30",
                                                "text": "\"Taiwanese are very enthusiastic and love freedom and democracy, so many good international friends have come to Taiwan to support us. This is a normal and good thing, but China threatens and intimidates Taiwan,\" she said.\n\"However, I would like to reassure everyone that both our government and the military are prepared, and I will definitely take care of Taiwan.\""
                                            },
                                            {
                                                "example_id": "d6d6b338-2089-4a18-8597-56082193fa2b",
                                                "sense_id": "64bb4f5b-c099-36b9-af0d-53a545d29d30",
                                                "text": "He threatened me with a knife."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18716a12-c771-30fb-ae5b-be9fb8bf589e",
                                        "entry_id": "f2cf0a34-36fe-3a92-b00a-bf6c937bcadd",
                                        "glosses": [
                                            "To menace, or be dangerous."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb90fcd4-33fd-4a25-9f16-90c302571915",
                                                "sense_id": "18716a12-c771-30fb-ae5b-be9fb8bf589e",
                                                "text": "The rocks threatened the ship's survival."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3de39aa1-d18e-3ccd-bdbe-863157193ae9",
                                        "entry_id": "f2cf0a34-36fe-3a92-b00a-bf6c937bcadd",
                                        "glosses": [
                                            "To portend, or give a warning of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f1cea9f-6514-45d1-b06d-b499a6d39fa9",
                                                "sense_id": "3de39aa1-d18e-3ccd-bdbe-863157193ae9",
                                                "text": "The black clouds threatened heavy rain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ce4e940-e175-3a38-b1cc-113b751c90a2",
                                        "entry_id": "f2cf0a34-36fe-3a92-b00a-bf6c937bcadd",
                                        "glosses": [
                                            "To call into question the validity of (a belief, idea, or viewpoint); to challenge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b75aed42-38c9-467a-a41e-edfb1c00a9e7",
                                                "sense_id": "3ce4e940-e175-3a38-b1cc-113b751c90a2",
                                                "text": "The new information threatened our original hypothesis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d34c4fc6-0691-3bcc-a334-a01e27978100",
                                        "entry_id": "f2cf0a34-36fe-3a92-b00a-bf6c937bcadd",
                                        "glosses": [
                                            "To be close to equaling or surpassing (a record, etc.)"
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70ee3609-697f-4bed-a4cd-a56169116119",
                                                "sense_id": "d34c4fc6-0691-3bcc-a334-a01e27978100",
                                                "text": "The player quickly surmised that things weren't kosher and the suddenly wiser ballplayer threatened the world record for the fifty-yard dash as he sought safety. As Reynolds dived into the van, Dietz and the other players rolled with laughter."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
