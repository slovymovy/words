                        "entry_id": "9caedc49-b7f1-3a25-8b53-e27eb384b221",
                        "glosses": [
                            "Gesamtheit der Dinge, die erbeutet wurden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "922f3da5-fe1e-4687-a6cd-69c4a5b4843f",
                                "sense_id": "2355682e-e3cb-30b5-b0d4-2c2a23b85c76",
                                "text": "„Vielleicht kannst du einen Wagen begleiten, der unser Beutegut nach Wilna bringt, sagte er eines Abends.“"
                            },
                            {
                                "example_id": "a96c9680-b7af-4969-b9c0-f3cb855749ac",
                                "sense_id": "2355682e-e3cb-30b5-b0d4-2c2a23b85c76",
                                "text": "„Aber Binding hatte recht; Beutegut war Beutegut, man sollte es nehmen, wo man es fand.“"
                            }
                        ],
