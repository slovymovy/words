                    "frequency": "Low",
                    "semantic_group_id": "electricite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une <w>étincelle</w> bleue a jailli entre les deux câbles électriques dénudés."
                        },
                        {
                            "text": "La bougie d'allumage ne produit plus aucune <w>étincelle</w> dans le moteur."
                        }
