                        "examples": [
                            {
                                "example_id": "1bfd1948-b886-497f-ac81-3f22fbdc663c",
                                "sense_id": "c6867a5e-dd6f-3fe8-81fd-648ac16422dc",
                                "text": "In a broad sense, the Hero may be regarded as a shamanic figure with the capacity for geomancing. This idea can be compared with the concept of using a divining rod to find an underground water source."
                            },
