                        "examples": [
                            {
                                "example_id": "874d0986-7187-46b2-8f60-a543b3669d9b",
                                "sense_id": "90ab50eb-59f0-323f-acc7-482622a54b97",
                                "text": "« Pour examiner l’isthme du gosier, on fait ouvrir largement la bouche au malade ; on déprime la langue avec le doigt indicateur ou avec le manche d’une cuiller, une spatule ou un abaisse-langue dont la surface concave s’adapte exactement à la convexité de cet organe, et l’on met à découvert le voile du palais et ses piliers, la luette, les amygdales et la partie postérieure du pharynx. »"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
