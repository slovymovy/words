                        "sense_id": "31e6991f-e5d3-3fdf-bfa0-6af918af0b4e",
                        "entry_id": "cc43b2e4-2d1b-382a-9525-2345081602e3",
                        "glosses": [
                            "een toestel waarop een pan geplaatst kan worden om via verwarming van de pan de inhoud op te warmen, te koken of te bakken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3d383c8-d95c-4592-a194-24a24b328b57",
                                "sense_id": "31e6991f-e5d3-3fdf-bfa0-6af918af0b4e",
                                "text": "In de caravan stonden een kooktoestel op flessengas, een paar pannen en een koekenpan."
                            },
                            {
                                "example_id": "b7861170-a9bb-4999-b9ef-708b79b4c8ba",
                                "sense_id": "31e6991f-e5d3-3fdf-bfa0-6af918af0b4e",
                                "text": "Het echtpaar verbleef met een motorgezelschap op de camping. De koolmonoxide kwam uit hun kooktoestel, dat ze gebruikten om de tent warm te maken."
                            }
                        ]
                    }
                ],
