                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I ordered a coffee and a cheese <w>danish</w> for breakfast.",
                            "target_lang_translations": {
                                "ru": "Я заказал кофе и <w>венскую булочку</w> с сыром на завтрак.",
                                "zh": "我早餐点了一杯咖啡和一个奶酪<w>丹麦酥</w>。"
                            }
                        },
                        {
                            "text": "He ate a cherry <w>danish</w> on his way to work.",
