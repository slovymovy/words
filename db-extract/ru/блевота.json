                                ]
                            },
                            {
                                "target_word": "sick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9502a7f8-2a45-3bd1-9720-b5c2785c41b6",
                                        "entry_id": "f20aeab2-ffa7-3d8b-bb32-3ffe57715d8e",
                                        "glosses": [
                                            "To vomit."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38d07fe6-fea5-49a2-b366-6818a3540e6e",
                                                "sense_id": "9502a7f8-2a45-3bd1-9720-b5c2785c41b6",
                                                "text": "I woke up at 4 am and sicked on the floor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38e56c3d-df74-3dc5-a3e9-722700bacb86",
                                        "entry_id": "f20aeab2-ffa7-3d8b-bb32-3ffe57715d8e",
                                        "glosses": [
                                            "To fall sick; to sicken."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "61d56410-62cc-4027-b499-8a2466b23072",
                                                "sense_id": "38e56c3d-df74-3dc5-a3e9-722700bacb86",
                                                "text": "Our great-grandsire, Edward, sick'd and died."
                                            },
                                            {
                                                "example_id": "b8edb81f-eace-4fda-9cbc-629c091d5829",
                                                "sense_id": "38e56c3d-df74-3dc5-a3e9-722700bacb86",
                                                "text": "Old man to pickney, so wave unno hand if you with me /To see the sufferation sick me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8c2f89b-311e-3420-a0fe-523bc840ec5d",
                                        "entry_id": "1325c2f0-998f-3c00-a086-5d733abf470e",
                                        "glosses": [
                                            "Alternative spelling of sic (“set upon”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd75c453-8b1b-4037-b73f-9d50bfc5466d",
                                                "sense_id": "d8c2f89b-311e-3420-a0fe-523bc840ec5d",
                                                "text": "\"Wapi,\" she almost screamed, \"go back! Sick 'em, Wapi—sick 'em—sick 'em—sick 'em!\""
                                            },
                                            {
                                                "example_id": "db9317f4-16c4-4448-8ee3-17e323eb720c",
                                                "sense_id": "d8c2f89b-311e-3420-a0fe-523bc840ec5d",
                                                "text": "When we were at work swabbing the deck, necessarily barelegged, Pelle would sick the dog on us; and it was an endless source of pleasure to him when the dog succeeded in fastening its teeth in our legs and making the blood run down our ankles."
                                            },
                                            {
                                                "example_id": "e781855b-c65f-44f5-8e61-cd2d89bb2224",
                                                "sense_id": "d8c2f89b-311e-3420-a0fe-523bc840ec5d",
                                                "text": "1957, J. D. Salinger, \"Zooey\", in, 1961, Franny and Zooey, 1991 LB Books edition, page 154,\n\"...is just something God sicks on people who have the gall to accuse Him of having created an ugly world.\""
                                            },
                                            {
                                                "example_id": "0da578d4-a8d0-4d24-ae38-69be4970b0ff",
                                                "sense_id": "d8c2f89b-311e-3420-a0fe-523bc840ec5d",
                                                "text": "2001 (publication date), Anna Heilman, Never Far Away: The Auschwitz Chronicles of Anna Heilman, University of Calgary Press, →ISBN, page 82,\nNow they find a new entertainment: they sick the dog on us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
