{
    "word_family": [
        "plod",
        "plodder"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b563e18c-1ec0-3200-b796-65235def3972",
                    "sense_definition": "Progressing slowly and laboriously.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "slow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>plodding</w> pace of the investigation frustrated the victims' families.",
                            "target_lang_translations": {
                                "zh": "调查<w>缓慢</w>的进展让受害者家属感到沮丧。"
                            }
                        },
                        {
                            "text": "He made a <w>plodding</w> effort to finish the difficult assignment before the deadline.",
                            "target_lang_translations": {
                                "zh": "他<w>费力</w>地完成了那项艰巨的任务，赶在截止日期前交了上去。"
                            }
                        }
                    ],
                    "synonyms": [
                        "laborious",
                        "slow",
                        "tedious"
                    ],
                    "antonyms": [
                        "brisk",
                        "rapid"
                    ],
                    "common_phrases": [
                        "plodding pace",
                        "plodding effort"
                    ],
                    "target_lang_definitions": {
                        "zh": "形容进展缓慢且费力的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "缓慢的",
                                "target_lang_sense_clarification": "指动作或进展速度慢。"
                            },
                            {
                                "target_lang_word": "沉重的",
                                "target_lang_sense_clarification": "指过程费力、吃力。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1be5f830-41d8-36bb-bc0c-10f1fc1854d1",
                    "sense_definition": "Slow, laborious progress.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "slow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After hours of <w>ploddings</w> through the deep snow, we finally reached the cabin.",
                            "target_lang_translations": {
                                "zh": "在深雪中<w>跋涉</w>了几个小时后，我们终于到达了小屋。"
                            }
                        },
                        {
                            "text": "The long <w>ploddings</w> across the desert left the explorers exhausted.",
                            "target_lang_translations": {
                                "zh": "穿越沙漠的漫长<w>跋涉</w>让探险家们精疲力竭。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trudge"
                    ],
                    "target_lang_definitions": {
                        "zh": "缓慢而费力的行进过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跋涉",
                                "target_lang_sense_clarification": "指在困难条件下长途行走。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bcadda7d-aa29-3d2a-b442-2a8bffef03cb",
                    "sense_definition": "Present participle and gerund of <w>plod</w>.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "slow_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was <w>plodding</w> through the mud to reach the main road.",
                            "target_lang_translations": {
                                "zh": "他正<w>跋涉</w>穿过泥地，试图到达主路。"
                            }
                        },
                        {
                            "text": "The horse was <w>plodding</w> along the path at a steady, slow speed.",
                            "target_lang_translations": {
                                "zh": "那匹马正<w>沉重地走</w>在小路上，速度平稳而缓慢。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "plodding along",
                        "plodding through"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Grammatical form of the verb plod."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "动词 plod 的现在分词或动名词形式，指沉重缓慢地行走。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "跋涉",
                                "target_lang_sense_clarification": "指艰难地行走。"
                            },
                            {
                                "target_lang_word": "沉重地走",
                                "target_lang_sense_clarification": "指步履沉重地移动。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}