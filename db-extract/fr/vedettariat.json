        "fr-extract.jsonl": [
            {
                "entry_id": "e58f6c37-a130-37e9-a199-49be180cd198",
                "word": "vedettariat",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f4401937-8a1d-4c1e-b2ae-536229e28372",
                        "entry_id": "e58f6c37-a130-37e9-a199-49be180cd198",
                        "tags": [],
                        "form": "vedétariat"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a0fad4fa-1490-34c9-8abd-3a75198546e4",
                        "entry_id": "e58f6c37-a130-37e9-a199-49be180cd198",
                        "glosses": [
                            "Condition, situation de vedette."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf919ed5-9b77-45ef-aa80-6a8de6a9ffa2",
                                "sense_id": "a0fad4fa-1490-34c9-8abd-3a75198546e4",
                                "text": "Sa célébrité récente avait provoqué un afflux de nouveaux acheteurs qui venaient à la ferme dans l'espoir de la voir. Ce vedettariat la comblait tant qu'elle n'avait pas à en subir les conséquences."
                            },
                            {
                                "example_id": "22bc3da1-adb5-4f54-9c08-13796b2d3116",
                                "sense_id": "a0fad4fa-1490-34c9-8abd-3a75198546e4",
                                "text": "Jeune comédien, Stuart suit en effet docilement, et même avec un net excès de zèle, les instructions de Godfrey, qui insiste pour le voir cabotiner : c’est donc sous le signe d’un surjeu démentiel que Stuart Smith va accéder à un très relatif vedettariat."
                            },
                            {
                                "example_id": "7ada61e4-b8dc-4927-bde9-dfd22d953cd3",
                                "sense_id": "a0fad4fa-1490-34c9-8abd-3a75198546e4",
                                "text": "Georges Brassens a toujours refusé le vedettariat."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8939a83-c19b-3918-b304-98e12fceeb0c",
                        "entry_id": "e58f6c37-a130-37e9-a199-49be180cd198",
                        "glosses": [
                            "Système reposant sur la promotion de vedettes, en particulier dans l’audiovisuel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "baeac8b3-ffed-4f11-9148-4958ab5864f9",
                                "sense_id": "d8939a83-c19b-3918-b304-98e12fceeb0c",
                                "text": "Hors du vedettariat point de salut."
                            },
                            {
                                "example_id": "c4cfe236-f0d7-4b95-940e-9e63cc651f72",
                                "sense_id": "d8939a83-c19b-3918-b304-98e12fceeb0c",
                                "text": "L’industrie cinématographique pratique majoritairement le vedettariat."
                            },
                            {
                                "example_id": "81fef559-2440-4643-920e-eaa14a800973",
                                "sense_id": "d8939a83-c19b-3918-b304-98e12fceeb0c",
                                "text": "Faire du vedettariat : chercher à se mettre en valeur auprès des médias."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2f4ea1e9-436e-4536-8df2-d1aa38bfc9ee",
                        "source_entry_id": "e58f6c37-a130-37e9-a199-49be180cd198",
                        "target_lang_word": "Berühmtheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Berühmtheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6d2fb06b-cd4b-3a39-ae15-7fb9515a9447",
                                        "entry_id": "9fefbd3c-3763-36ce-9f32-caf4794c50c3",
                                        "glosses": [
                                            "eine Person oder eine Sache, die berühmt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df0aa98c-70e5-4695-a883-1aa8122f8d6c",
                                                "sense_id": "6d2fb06b-cd4b-3a39-ae15-7fb9515a9447",
                                                "text": "Sie ist eine Berühmtheit, da wo sie herkommt."
                                            },
                                            {
                                                "example_id": "1fcf8f5e-5808-4098-a4ba-731af198d664",
                                                "sense_id": "6d2fb06b-cd4b-3a39-ae15-7fb9515a9447",
                                                "text": "„Aber auch der Berühmtheiten der Stadt wird gedacht.“"
                                            },
                                            {
                                                "example_id": "cb4be1c3-cabd-44bc-b5d6-e75790bfb256",
                                                "sense_id": "6d2fb06b-cd4b-3a39-ae15-7fb9515a9447",
                                                "text": "„Doch diese jungen Frauen fühlen sich hoffnungslos zu Berühmtheiten hingezogen, so unerheblich meine auch sein mag.“"
                                            },
                                            {
                                                "example_id": "0664182e-ef99-4dd2-be0d-eabfa1bbd7fd",
                                                "sense_id": "6d2fb06b-cd4b-3a39-ae15-7fb9515a9447",
                                                "text": "„Auf einem Schild vor der Tür waren Berühmtheiten zu sehen, die der Bar einen Besuch abgestattet hatten, die meisten Hollywood- und Fernsehstars.“"
                                            },
                                            {
                                                "example_id": "c98bc07e-247e-4ae9-806d-c305cea170c0",
                                                "sense_id": "6d2fb06b-cd4b-3a39-ae15-7fb9515a9447",
                                                "text": "„Und wenn die Menge der Geschichten, die über jemanden erzählt werden, das Maß der Berühmtheit ist, dann war er eine Berühmtheit im Viertel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "24bd8f25-9cba-376d-80f0-abe055550ee5",
                                        "entry_id": "9fefbd3c-3763-36ce-9f32-caf4794c50c3",
                                        "glosses": [
                                            "die Eigenschaft, berühmt zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "516f23b2-d33d-475b-a8f4-f2f2235f059b",
                                                "sense_id": "24bd8f25-9cba-376d-80f0-abe055550ee5",
                                                "text": "„Und wenn die Menge der Geschichten, die über jemanden erzählt werden, das Maß der Berühmtheit ist, dann war er eine Berühmtheit im Viertel.“"
                                            },
                                            {
                                                "example_id": "8cff89e9-3622-470d-aed5-b89b7d76507b",
                                                "sense_id": "24bd8f25-9cba-376d-80f0-abe055550ee5",
                                                "text": "Ihre Berühmtheit ist ihr aber nicht nur von Vorteil."
                                            },
                                            {
                                                "example_id": "671a8a39-ac44-4ca0-a1ce-25d4775d4b66",
                                                "sense_id": "24bd8f25-9cba-376d-80f0-abe055550ee5",
                                                "text": "„In der Tat existierte eine solche Kapelle, deren Berühmtheit als vielbesuchte Wallfahrtsstätte bis zurück ins 14. Jahrhundert reicht.“"
                                            },
                                            {
                                                "example_id": "0a647c4a-9455-45f9-a623-0b6e66dc0958",
                                                "sense_id": "24bd8f25-9cba-376d-80f0-abe055550ee5",
                                                "text": "„Noch dazu musste Cook den schmeichelhaften, aber zeitraubenden Verpflichtungen nachkommen, die seiner wachsenden Berühmtheit geschuldet waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
