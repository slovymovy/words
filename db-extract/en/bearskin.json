                    {
                        "translation_id": "6fe8c02b-53e6-4c6b-83f9-c7b8a017f7aa",
                        "source_entry_id": "2272fa12-0ea0-33b2-a23f-c6c5e63066a2",
                        "source_sense_description": "pelt of a bear",
                        "target_lang_word": "Bärenfell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bärenfell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "691a8fec-54f1-3c02-8501-261cc5004912",
                                        "entry_id": "f6539f83-d654-3ab9-8c4e-8c541c6cb89d",
                                        "glosses": [
                                            "(abgezogenes) Fell eines Bären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1356e64-0ea3-48b7-bd02-09ce63af3d6f",
                                                "sense_id": "691a8fec-54f1-3c02-8501-261cc5004912",
                                                "text": "Für die Herstellung von Bärenfellmützen werden viele Bärenfelle benötigt."
                                            },
                                            {
                                                "example_id": "9aa3399a-beba-42cb-8b87-596ebfc38940",
                                                "sense_id": "691a8fec-54f1-3c02-8501-261cc5004912",
                                                "text": "„Männer, Frauen und Kinder trugen ihrer Körperkraft entsprechende Bündel von Biber-, Seeotter-, Marder-, Bären- und Luchsfellen und schon bearbeitete Elchhäute.“"
                                            },
                                            {
                                                "example_id": "88a88f99-afdc-413f-badd-aa6bb06c00f5",
                                                "sense_id": "691a8fec-54f1-3c02-8501-261cc5004912",
                                                "text": "„Sie zeigte lächelnd auf das Bärenfell, das vor dem Kamin lag.“"
                                            },
                                            {
                                                "example_id": "f0453397-203e-4c12-b51c-3b543c2e5e92",
                                                "sense_id": "691a8fec-54f1-3c02-8501-261cc5004912",
                                                "text": "„In seinem grossen über und über mit persischen Teppichen, Bärenfellen und Waffen geschmückten Kabinett sass Dolochow in hohen Stiefeln und einem reisemässigen tartarischen Halbrock vor dem geöffneten Sekretär, auf dessen Klappe Banknotenpäckchen und mit Zahlenkolonnen bedeckte Papiere lagen.“"
                                            },
                                            {
                                                "example_id": "6ff8b45f-1cd3-4d0f-baa0-1446957faab0",
                                                "sense_id": "691a8fec-54f1-3c02-8501-261cc5004912",
                                                "text": "„Die alten Germanen lagen traditionell auf dem Bärenfell und tranken immer noch eins.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
