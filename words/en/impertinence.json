{
    "word_family": [
        "impertinent",
        "impertinently",
        "pertinence",
        "pertinent"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4c6007ee-1253-3ed3-8703-43d9b58d04ab",
                    "sense_definition": "Disrespectful, insolent, or impudent behavior or speech.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "disrespect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager refused to tolerate any <w>impertinence</w> from the new employees.",
                            "target_lang_translations": {
                                "zh": "经理拒绝容忍新员工的任何<w>无礼</w>行为。",
                                "nl": "De manager weigerde elke vorm van <w>brutaliteit</w> van de nieuwe werknemers te tolereren."
                            }
                        },
                        {
                            "text": "She was shocked by the sheer <w>impertinence</w> of his personal questions.",
                            "target_lang_translations": {
                                "zh": "他那些涉及隐私的问题实在太<w>放肆</w>，让她大为震惊。",
                                "nl": "Ze was geschokt door de pure <w>onbeschaamdheid</w> van zijn persoonlijke vragen."
                            }
                        }
                    ],
                    "synonyms": [
                        "insolence",
                        "impudence",
                        "audacity",
                        "cheek",
                        "rudeness"
                    ],
                    "antonyms": [
                        "politeness",
                        "respect",
                        "deference"
                    ],
                    "common_phrases": [
                        "sheer impertinence"
                    ],
                    "target_lang_definitions": {
                        "zh": "不礼貌、无礼或傲慢的言行（不可数）。",
                        "nl": "Respectloos, brutaal of onbeschaamd gedrag of taalgebruik."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无礼",
                                "target_lang_sense_clarification": "缺乏礼貌或不尊重他人"
                            },
                            {
                                "target_lang_word": "傲慢",
                                "target_lang_sense_clarification": "轻蔑且放肆的态度"
                            },
                            {
                                "target_lang_word": "放肆",
                                "target_lang_sense_clarification": "毫无顾忌、轻狂失礼"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "brutaliteit",
                                "target_lang_sense_clarification": "het zich respectloos of vrijpostig gedragen"
                            },
                            {
                                "target_lang_word": "onbeschaamdheid",
                                "target_lang_sense_clarification": "brutaal gedrag zonder schroom"
                            },
                            {
                                "target_lang_word": "vrijpostigheid",
                                "target_lang_sense_clarification": "het zich te veel vrijheden permitteren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56d26c0d-475c-361e-9a74-9d436de8a1dc",
                    "sense_definition": "An act, remark, or instance of being insolent or disrespectful.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disrespect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He apologized immediately for his <w>impertinence</w> during the heated meeting.",
                            "target_lang_translations": {
                                "zh": "他在激烈的会议中表现<w>失礼</w>，随后立即道了歉。",
                                "nl": "Hij verontschuldigde zich onmiddellijk voor zijn <w>brutaliteit</w> tijdens de verhitte vergadering."
                            }
                        },
                        {
                            "text": "Her sharp reply was seen as an unforgivable <w>impertinence</w> by the committee.",
                            "target_lang_translations": {
                                "zh": "委员会认为她尖锐的回答是不可饶恕的<w>无礼言辞</w>。",
                                "nl": "Haar scherpe antwoord werd door de commissie gezien als een onvergeeflijke <w>onbeschoftheid</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "slight",
                        "affront"
                    ],
                    "target_lang_definitions": {
                        "zh": "无礼或粗鲁的言行、举动（可数）。",
                        "nl": "Een specifieke respectloze of brutale daad of opmerking."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无礼的举动",
                                "target_lang_sense_clarification": "具体指某一次不尊重的行为"
                            },
                            {
                                "target_lang_word": "无礼言辞",
                                "target_lang_sense_clarification": "具体指某句或某番失礼的话"
                            },
                            {
                                "target_lang_word": "失礼",
                                "target_lang_sense_clarification": "缺乏教养的失当行为或言语"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "brutaliteit",
                                "target_lang_sense_clarification": "een specifieke brutale handeling of opmerking"
                            },
                            {
                                "target_lang_word": "onbeschoftheid",
                                "target_lang_sense_clarification": "een concrete onbeleefde of grove uiting"
                            },
                            {
                                "target_lang_word": "vrijpostigheid",
                                "target_lang_sense_clarification": "een brutale opmerking of actie"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cabae79e-b9ad-32d9-857c-6a52e7f9f563",
                    "sense_definition": "The state or quality of being irrelevant or lacking pertinence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "irrelevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge dismissed the evidence due to its obvious <w>impertinence</w> to the case.",
                            "target_lang_translations": {
                                "zh": "法官驳回了该证据，因为其明显与本案<w>不相干</w>。",
                                "nl": "De rechter wees het bewijsmateriaal af vanwege de overduidelijke <w>irrelevantie</w> ervan voor de zaak."
                            }
                        },
                        {
                            "text": "He argued about the <w>impertinence</w> of the data in solving the core problem.",
                            "target_lang_translations": {
                                "zh": "他争辩说这些数据在解决核心问题上根本<w>无关紧要</w>。",
                                "nl": "Hij voerde aan dat de gegevens <w>irrelevant</w> waren voor het oplossen van het kernprobleem."
                            }
                        }
                    ],
                    "synonyms": [
                        "irrelevance",
                        "inapplicability"
                    ],
                    "antonyms": [
                        "pertinence",
                        "relevance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Rarely used in modern contexts outside formal or legal writing"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "不相干、无关紧要或不切题（多见于法律或正式用语）。",
                        "nl": "Het irrelevant zijn of het ontbreken van enig verband met de zaak."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不相干",
                                "target_lang_sense_clarification": "与当前议题毫无关联"
                            },
                            {
                                "target_lang_word": "无关紧要",
                                "target_lang_sense_clarification": "对事情没有实际关联或重要性"
                            },
                            {
                                "target_lang_word": "不切题",
                                "target_lang_sense_clarification": "与主题脱节"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "irrelevantie",
                                "target_lang_sense_clarification": "het niet ter zake doen"
                            },
                            {
                                "target_lang_word": "ontoepasselijkheid",
                                "target_lang_sense_clarification": "het niet van toepassing zijn"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15643dfb-94ed-3a72-bd4d-90bd496fe180",
                    "sense_definition": "The condition of being unsuitable, inappropriate, or out of place.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "irrelevance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>impertinence</w> of such casual remarks at a solemn ceremony troubled everyone.",
                            "target_lang_translations": {
                                "zh": "在庄严的仪式上说出如此随意的言论实在太<w>不合时宜</w>，让大家都很不安。",
                                "nl": "De <w>ongepastheid</w> van dergelijke nonchalante opmerkingen tijdens een plechtige ceremonie verontrustte iedereen."
                            }
                        },
                        {
                            "text": "He noted the stylistic <w>impertinence</w> of adding modern slang into the historic poem.",
                            "target_lang_translations": {
                                "zh": "他指出了在历史古诗中加入现代俚语在文体上的<w>不当</w>之处。",
                                "nl": "Hij wees op de stilistische <w>ongepastheid</w> van het toevoegen van moderne straattaal aan het historische gedicht."
                            }
                        }
                    ],
                    "synonyms": [
                        "inappropriateness",
                        "unsuitability"
                    ],
                    "antonyms": [
                        "appropriateness",
                        "suitability"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Mainly found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "不合适、不妥当或与场合不相称（旧式用法）。",
                        "nl": "De toestand van ongepast, misplaatst of ongeschikt zijn."
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "不合时宜",
                                "target_lang_sense_clarification": "与场合或环境不相配"
                            },
                            {
                                "target_lang_word": "不当",
                                "target_lang_sense_clarification": "不合适、不妥帖"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "ongepastheid",
                                "target_lang_sense_clarification": "het misplaatst of niet passend zijn"
                            },
                            {
                                "target_lang_word": "ongeschiktheid",
                                "target_lang_sense_clarification": "het niet aansluiten bij de situatie of context"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}