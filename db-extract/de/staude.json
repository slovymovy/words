                "senses": [
                    {
                        "sense_id": "24d9d0f6-b2b4-34fa-bb90-e8c6356dca58",
                        "entry_id": "ae716dc0-28ee-33a2-9a63-0e5f6d9cd65b",
                        "glosses": [
                            "Plante vivace, arbuste."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb37a22e-c3b1-45fc-bfae-67a620e8dabf",
                                "sense_id": "24d9d0f6-b2b4-34fa-bb90-e8c6356dca58",
                                "text": "Hast du schon die Stauden geschnitten?",
                                "translation": "As-tu déjà taillé les vivaces ?"
                            },
                            {
                                "example_id": "a761c04a-f1cc-447c-9e23-232952cccc99",
                                "sense_id": "24d9d0f6-b2b4-34fa-bb90-e8c6356dca58",
                                "text": "Die Wurzeln dieser Staude sind kälteempfindlich. Wir empfehlen, sie vor Winteranbruch mit Reisig und Laub einzudecken.",
                                "translation": "Les racines de cette plante vivace sont sensibles au froid. Nous recommandons de les recouvrir de branchages et de feuilles mortes avant le début de l'hiver."
                            }
                        ]
                    }
                ],
