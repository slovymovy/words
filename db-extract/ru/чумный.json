                ],
                "senses": [
                    {
                        "sense_id": "9d7763eb-26b1-3169-95c0-b11757baac0a",
                        "entry_id": "bf8ca5eb-ef44-3ba0-a412-cc3d22716278",
                        "glosses": [
                            "устар. то же, что чумной; поражённый чумой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a9d016-754b-46ef-b653-35f7ab3356e0",
                                "sense_id": "9d7763eb-26b1-3169-95c0-b11757baac0a",
                                "text": "Был 1919 год — самый чумный, самый чёрный, самый смертный из всех тех годов Москвы."
                            },
                            {
                                "example_id": "b3016bd0-58cd-4328-a93d-f8786a839d1f",
                                "sense_id": "9d7763eb-26b1-3169-95c0-b11757baac0a",
                                "text": "Королевский дворец был тогда похож на чумный госпиталь."
                            },
                            {
                                "example_id": "a5217787-9f46-403b-9d93-5b54f72dc226",
                                "sense_id": "9d7763eb-26b1-3169-95c0-b11757baac0a",
                                "text": "И злой стал, прямо как чумный, и исхудал…"
                            }
                        ]
                    }
                ],
