                ],
                "senses": [
                    {
                        "sense_id": "bbc8ed49-2edf-38cc-9713-f407413ece1a",
                        "entry_id": "45ad00c8-d81e-3997-a2a8-c4384bedbe84",
                        "glosses": [
                            "Arme à feu comprenant deux canons situés l'un au-dessus de l'autre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e899fee-f4df-458b-94f8-4d15a802c75b",
                                "sense_id": "bbc8ed49-2edf-38cc-9713-f407413ece1a",
                                "text": "Le commissaire enleva les deux cartouches de son superposé et les mit dans la poche gauche de son gilet rouge et crème."
                            },
                            {
                                "example_id": "f9015ea3-520e-4f97-b3fe-702d977381ba",
                                "sense_id": "bbc8ed49-2edf-38cc-9713-f407413ece1a",
                                "text": "On peut dire tout d’abord qu’en principe le basculage d’un superposé, à qualité égale a des chances d’être plus robuste."
                            },
                            {
                                "example_id": "91116046-c4b1-43db-959f-62a89d737666",
                                "sense_id": "bbc8ed49-2edf-38cc-9713-f407413ece1a",
                                "text": "Bastien lui possède un superposé qui appartenait à son grand-père dont je ne connais la marque et lui non plus d’ailleurs."
                            }
                        ]
                    }
                ],
