                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Unworte"
                    },
                    {
                        "form_id": "23891bb9-b53c-4c67-bded-baad3ac3b22f",
                        "entry_id": "8911b59d-3abc-3279-b1af-5fbb4d773c71",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Unwörter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a32505b5-05f9-324a-95a8-490d0eaca1e2",
                        "entry_id": "8911b59d-3abc-3279-b1af-5fbb4d773c71",
                        "glosses": [
                            "neu gebildetes und schlimmes, unangebrachtes, verwerfliches Wort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e006f33-9280-45d2-9add-c4097d9ad0a2",
                                "sense_id": "a32505b5-05f9-324a-95a8-490d0eaca1e2",
                                "text": "Das erste, von der Gesellschaft für deutsche Sprache zum Unwort des Jahres gewählte Wort war 1991 „ausländerfrei“."
                            },
                            {
                                "example_id": "fc10be93-cd85-4734-ba2b-f8967abe1158",
                                "sense_id": "a32505b5-05f9-324a-95a8-490d0eaca1e2",
                                "text": "Analog zum Unwort wird gelegentlich auch nach einem Unsatz des Tages oder des Jahres gesucht, so z.B. in einer NDR II-Umfrage bei den Hörern im Jahr 2000."
                            },
                            {
                                "example_id": "9000696c-37d8-4850-8dff-86a1f6ebde24",
                                "sense_id": "a32505b5-05f9-324a-95a8-490d0eaca1e2",
                                "text": "„Ein Beispiel für einen solchen möglichen Einflussfaktor stellt die Wahl des Unworts dar.“"
                            },
                            {
                                "example_id": "8f59fb6e-f5f6-446a-b8e2-08e9aaab12e2",
                                "sense_id": "a32505b5-05f9-324a-95a8-490d0eaca1e2",
                                "text": "„Ein Unwort ist ein Wort, das beleidigt und diskriminiert, beschönigt oder verschleiert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "0df1982a-7cda-39a7-8e8f-24699930d01c",
                        "entry_id": "8911b59d-3abc-3279-b1af-5fbb4d773c71",
                        "glosses": [
                            "unschönes Wort, ein falsch oder unglücklich gebildetes Wort"
                        ],
                        "tags": [
                            "nur Plural 2"
                        ],
                        "examples": [
                            {
                                "example_id": "3d737625-5d32-45f6-ba22-81a61682e550",
                                "sense_id": "0df1982a-7cda-39a7-8e8f-24699930d01c",
                                "text": "Unwort ist „als allgemeines Instrument zur Wortkritik im Gebrauch sehr ausdifferenziert, semantisch variiert und damit vieldeutig.“"
                            },
                            {
                                "example_id": "6e033fae-278e-44ee-aafb-715d96fed233",
                                "sense_id": "0df1982a-7cda-39a7-8e8f-24699930d01c",
                                "text": "Wir haben es ja schon öfters erwähnt, es ist ein Unwort, die ‪#Straßenausbaubeitragssatzung‬. Und inhaltlich ist es für die Gemeinden auch immer mehr ein Ungetüm."
                            },
                            {
                                "example_id": "2de14ec2-f679-416d-aef3-c3973b727af8",
                                "sense_id": "0df1982a-7cda-39a7-8e8f-24699930d01c",
                                "text": "„Dieses Geviert von Unwörtern, das auf ihn zutraf, belastete ihn bleischwer und hatte ihn schrumpfen lassen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
