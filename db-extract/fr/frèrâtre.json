                        "entry_id": "7204df7c-4433-3d5d-a571-d8fe7a3b761e",
                        "glosses": [
                            "Quasi-frère. Fils du beau-père (second mari de la mère) ou de la belle-mère (seconde épouse du père) issu d’un précédent mariage."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "003af0f9-31d1-4e95-9f86-4229febcbfbc",
                                "sense_id": "eed3b9ca-406e-30e3-87d4-d9c87fd6fb4c",
                                "text": "Honorable homme Jean de Briandas étoit un de ces témoins ; il est dit qu'il étoit frèrâtre, c'est-à-dire beau-frère de Germanet."
                            }
                        ]
                    },
                    {
                        "sense_id": "18f6a811-12ff-38bd-8341-f0168d968de8",
                        "entry_id": "7204df7c-4433-3d5d-a571-d8fe7a3b761e",
                        "glosses": [
                            "Mauvais frère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edcf8b19-56e0-40a3-af1b-bd434e66c30f",
                                "sense_id": "18f6a811-12ff-38bd-8341-f0168d968de8",
                                "text": "Laurence réclame sa part de papier : il ne faut pas être frèrâtre et lui voler ses lignes. Adieu donc !"
                            }
                        ]
                    }
