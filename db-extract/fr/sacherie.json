                                    },
                                    {
                                        "sense_id": "73a8effb-27ac-3033-8137-4a49a3c05dba",
                                        "entry_id": "18bd51ad-7ae4-3186-8b9c-f77a1d62a82f",
                                        "glosses": [
                                            "One of the square bases anchored at first base, second base, or third base."
                                        ],
                                        "tags": [],
                                        "examples": [
