{
    "word_family": [
        "polygonal"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "35c9a3d5-192f-320b-bd02-8b182a0eaccf",
                    "sense_definition": "A flat geometric shape bounded by three or more straight lines.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geometry_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A triangle is the simplest type of <w>polygon</w> because it has three sides.",
                            "target_lang_translations": {
                                "zh": "三角形是最简单的<w>多边形</w>，因为它有三条边。"
                            }
                        },
                        {
                            "text": "The students learned how to draw a regular <w>polygon</w> during their geometry class.",
                            "target_lang_translations": {
                                "zh": "学生们在几何课上学习了如何绘制正<w>多边形</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "regular polygon",
                        "convex polygon"
                    ],
                    "target_lang_definitions": {
                        "zh": "由三条或更多条线段首尾顺次相接构成的平面几何图形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多边形",
                                "target_lang_sense_clarification": "最常见的几何平面图形称呼"
                            },
                            {
                                "target_lang_word": "多角形",
                                "target_lang_sense_clarification": "侧重角的数量的平面图形"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2f735958-3f36-3f5c-a5dd-5d8ae83bbf5c",
                    "sense_definition": "A geometric shape along with the entire area enclosed inside its boundaries.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "geometry_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The computer calculates the total area contained inside the <w>polygon</w>.",
                            "target_lang_translations": {
                                "zh": "计算机计算出包含在该<w>多边形</w>内部的总面积。"
                            }
                        },
                        {
                            "text": "Shade the interior of each <w>polygon</w> using a blue colored pencil.",
                            "target_lang_translations": {
                                "zh": "用蓝色彩色铅笔为每个<w>多边形</w>的内部涂上阴影。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "interior of the polygon"
                    ],
                    "target_lang_definitions": {
                        "zh": "包括其封闭边界及内部所包围的整个区域的几何图形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多边形",
                                "target_lang_sense_clarification": "包含其边界及内部区域的面"
                            },
                            {
                                "target_lang_word": "多边形区域",
                                "target_lang_sense_clarification": "数学与计算机图形学中指包含内部的面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a5160804-bea7-33a4-99da-8419278c397d",
                    "sense_definition": "The closed perimeter or boundary line enclosing such a figure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "geometry_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We traced the boundary of the <w>polygon</w> to measure its exact perimeter.",
                            "target_lang_translations": {
                                "zh": "我们描出了该<w>多边形</w>的轮廓，以测量其精确的周长。"
                            }
                        },
                        {
                            "text": "The software detects whether a point lies precisely on the <w>polygon</w> or outside it.",
                            "target_lang_translations": {
                                "zh": "该软件可以检测一个点究竟恰好落在<w>多边形</w>边界上还是在它外部。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "围成多边形的封闭周线或闭合折线边界。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多边形",
                                "target_lang_sense_clarification": "指封闭边界折线本身"
                            },
                            {
                                "target_lang_word": "闭合折线",
                                "target_lang_sense_clarification": "强调由线段组成的闭合边界"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cbaf57f9-f050-3d10-97b8-ee1f75f0b21b",
                    "sense_definition": "A mathematical figure formed by an alternating sequence of vertices and connecting edges, which are not necessarily straight.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "geometry_shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In non-Euclidean geometry, a <w>polygon</w> can be defined by curved geodesic segments.",
                            "target_lang_translations": {
                                "zh": "在非欧几里得几何中，<w>多边形</w>可由弯曲的测地线段定义。"
                            }
                        },
                        {
                            "text": "Graph theory describes a generalized <w>polygon</w> as an alternating sequence of vertices and edges.",
                            "target_lang_translations": {
                                "zh": "图论将广义<w>多边形</w>描述为顶点和边的交替序列。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "spherical polygon"
                    ],
                    "target_lang_definitions": {
                        "zh": "在广义几何或图论中，由顶点和边（不一定为直线段）交替连接而成的闭合图形。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "多边形",
                                "target_lang_sense_clarification": "广义数学概念（如球面多边形、广义多边形）"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}