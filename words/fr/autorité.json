            "pos": "noun",
            "senses": [
                {
                    "sense_id": "dc0007f7-ce0e-31d4-be14-5237b1b2a56e",
                    "sense_definition": "Pouvoir légitime ou droit de commander, de se faire obéir et de prendre des décisions.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "pouvoir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents doivent parfois exercer leur <w>autorité</w> pour fixer des limites claires."
                        },
                        {
                            "text": "Le professeur a une grande <w>autorité</w> naturelle sur tous ses élèves en classe."
                        }
                    ],
                    "synonyms": [
                        "commandement",
                        "pouvoir"
                    ],
                    "antonyms": [
                        "soumission"
                    ],
                    "common_phrases": [
                        "autorité parentale",
                        "avoir de l'autorité",
                        "abuser de son autorité"
                    ]
                },
                {
                    "sense_id": "ab577d04-fdd6-3090-af09-3b097b90866d",
                    "sense_definition": "Personnes ou organismes publics chargés de faire respecter les lois et d'administrer un territoire.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "institution",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la tempête, les <w>autorités</w> locales ont demandé aux habitants de rester prudents."
                        },
                        {
                            "text": "Le directeur de l'école a prévenu les <w>autorités</w> compétentes dès le début de l'incident."
                        }
                    ],
                    "synonyms": [
                        "administration",
                        "gouvernement"
                    ],
                    "common_phrases": [
