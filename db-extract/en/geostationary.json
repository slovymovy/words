                        ],
                        "examples": [
                            {
                                "example_id": "a1560a17-95d5-49ae-bdca-c8a8f9f0502e",
                                "sense_id": "e6640b80-11d5-36e0-a7ad-f2affb654dbb",
                                "text": "The measurement is accomplished by observing the Faraday rotation angle of signals from geostationary satellites on a continuous basis."
                            }
                        ]
