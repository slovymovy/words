                "senses": [
                    {
                        "sense_id": "1f7d8aaf-14fb-303b-98f0-ce694d61595e",
                        "entry_id": "0ecded29-65ad-35b6-a3db-dd6bf37ddccd",
                        "glosses": [
                            "холощёная откормленная курица"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "71a0fbdd-cd1c-328e-a0ac-ba98f6678ddb",
                        "entry_id": "0ecded29-65ad-35b6-a3db-dd6bf37ddccd",
                        "glosses": [
                            "мясо пулярки [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b079eeb-d3aa-4119-838b-8eea5fe9d497",
                                "sense_id": "71a0fbdd-cd1c-328e-a0ac-ba98f6678ddb",
                                "text": "В угольной, смежной с приемною, комнате, служившей père Вильмену для отдохновения после его теологических занятий, баронесса уже третий раз находила прекрасно зажаренную холодную пулярку и холодную бутылку доброго шампанского."
                            },
                            {
                                "example_id": "683ca9c9-0271-41e7-a3a7-82a9fc08bd43",
                                "sense_id": "71a0fbdd-cd1c-328e-a0ac-ba98f6678ddb",
                                "text": "В скромном варианте при трапезе на четыре персоны подавали обычно биск из голубей (вообще-то биск ― густой суп из морепродуктов, но, видимо, туда и крылатые залетали) и суп здоровья с пуляркой."
                            }
                        ]
                    }
