                ],
                "senses": [
                    {
                        "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                        "entry_id": "a37ec568-89d4-3dab-a96e-82d3b0ce36ef",
                        "glosses": [
                            "Textil- oder Plastikstreifen (= Pflaster) zum Kleben auf die Haut (beispielsweise auf den Bauch), der kontinuierlich Hormone zur Empfängnisverhütung abgibt"
                        ],
                        "tags": [
                            "Empfängnisverhütung"
                        ],
                        "examples": [
                            {
                                "example_id": "12b73a97-eeb6-4671-9b0a-64d57c7fec1c",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "„Das Verhütungspflaster ist eine hormonelle Methode der Schwangerschaftsverhütung.“"
                            },
                            {
                                "example_id": "d5b62e4e-c3f7-4521-a6d1-e899eb306e09",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "Das Verhütungspflaster wird für dreimal für je 7 Tage aufgeklebt, dann wird eine Woche ohne Pflaster pausiert."
                            },
                            {
                                "example_id": "03d5d57a-5862-4c7a-84ec-56757a0b35e5",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "Das Verhütungspflaster gibt die Wirkstoffe kontinuierlich über die Haut ab."
                            },
                            {
                                "example_id": "d7129feb-cb6b-4682-ac8e-cb0a2698bb12",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "„Auch das Verhütungspflaster enthält die Hormone Östrogen und Gestagen, die über die Haut aufgenommen werden.“"
                            },
                            {
                                "example_id": "f6b4b78f-0195-40d5-8de9-d84f9bb164cb",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "„Das transdermal wirkende Verhütungspflaster (EVRA®) enthält 6 mg Norelgestromin (NGMN) und 600 μg Ethinylestradiol (EE).“"
                            },
                            {
                                "example_id": "61ba5c30-b050-4ed5-bf10-b2073c298201",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "„Das Verhütungspflaster, von dem es nur ein Präparat auf dem Markt gibt, muss der Arzt verschreiben.“"
                            },
                            {
                                "example_id": "04366447-66e9-47f3-83c3-9d8f2dcd9ecd",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "„Bevor der Gynäkologe einer Frau das Verhütungspflaster verordnet, erkundigt er sich nach bestehenden oder früheren Krankheiten und nach Erkrankungen in ihrer Familie.“"
                            },
                            {
                                "example_id": "13f982df-a495-41a3-bb13-af1351afa270",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "„Die US-Gesundheitsbehörden haben grünes Licht für ein neuartiges Verhütungspflaster gegeben.“"
                            },
                            {
                                "example_id": "ac5904fc-5029-4059-ac38-8d74261a6d36",
                                "sense_id": "a22edd78-4286-39da-98e9-cf511ba356cf",
                                "text": "„Externe Gutachter der US-Arzneibehörde FDA bescheinigen dem umstrittenen Verhütungspflaster Evra“ […] „trotz eines möglicherweise erhöhten Risikos von thromboembolischen Ereignissen ein günstiges Nutzen-Risiko-Verhältnis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
