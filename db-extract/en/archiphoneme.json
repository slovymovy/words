                ],
                "senses": [
                    {
                        "sense_id": "812b1748-7cdb-366d-973f-66e436a48b07",
                        "entry_id": "2d5423ec-9507-3553-bb5a-7392bf30e0ef",
                        "glosses": [
                            "A unit representing two or more underlying phonemes, where the distinction between them has been neutralized under certain conditions."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4408d986-784a-421d-ade5-b2234870ed4c",
                        "source_entry_id": "2d5423ec-9507-3553-bb5a-7392bf30e0ef",
                        "source_sense_id": "812b1748-7cdb-366d-973f-66e436a48b07",
                        "source_sense_description": "a unit representing underlying phonemes",
                        "target_lang_word": "archiphonème",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "archiphonème",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "216cabf9-f2e6-3b23-8297-d10036e3d46d",
                                        "entry_id": "b3e30839-789a-3925-aa73-75618fcddb3b",
                                        "glosses": [
                                            "Unité phonologique regroupant les particularités distinctives de deux ou plusieurs phonèmes dont l’un au moins est exclu dans certaines positions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8bd445f-89aa-4f95-8fc1-cc29fc666b80",
                                                "sense_id": "216cabf9-f2e6-3b23-8297-d10036e3d46d",
                                                "text": "« Sot » \\so\\ et « sotte » \\sɔt\\ : la paire de phonèmes /o, ɔ/ forme un archiphonème noté /O/ ; le phonème /ɔ/ étant exclu en fin de mot."
                                            },
                                            {
                                                "example_id": "64b6bb01-e8ea-4d18-b10f-00364f26e818",
                                                "sense_id": "216cabf9-f2e6-3b23-8297-d10036e3d46d",
                                                "text": "« Soigneur » \\swaɲœr\\ et « soigneuse » \\swaɲøz\\ : le triplet /ə, œ, ø/ forme un archiphonème noté /Œ/ ; les phonèmes /ə, ø/ sont exclus devant un /r/, les phonèmes /ə, œ/ sont exclus devant un /z/."
                                            },
                                            {
                                                "example_id": "71b5bd7e-767d-4c18-8f1d-cd4b57c3efcf",
                                                "sense_id": "216cabf9-f2e6-3b23-8297-d10036e3d46d",
                                                "text": "L’archiphonème est donc l’ensemble des traits distinctifs communs à deux phonèmes dont l’opposition est neutralisable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f7b2f57-3e96-4c73-a8ad-abda6594b8a2",
                        "source_entry_id": "2d5423ec-9507-3553-bb5a-7392bf30e0ef",
                        "source_sense_id": "812b1748-7cdb-366d-973f-66e436a48b07",
                        "source_sense_description": "a unit representing underlying phonemes",
                        "target_lang_word": "Archiphonem",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Archiphonem",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e8634d07-0539-3375-a22b-3ad869117d5c",
                                        "entry_id": "cab8e68c-01b8-32c9-b85e-51fb8c46a0b1",
                                        "glosses": [
                                            "Menge der distinktiven Merkmale, in denen zwei Phoneme übereinstimmen, die zueinander in einer aufhebbaren Opposition stehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "601a87b8-11bf-4812-8f58-aefc5f8e1bd6",
                                                "sense_id": "e8634d07-0539-3375-a22b-3ad869117d5c",
                                                "text": "Im Deutschen stehen die Phoneme /s/ und /z/ in einer Opposition, z. B. in dem Wortpaar (Minimalpaar) „reißen“ [ˈʁaɪ̯sn̩] - „reisen“ [ˈʁaɪ̯zn̩]; diese Opposition ist im Wortauslaut (auch: in der Auslautgruppe) aufgehoben, da hier nur die stimmlosen Reibelaute vorkommen, z. B. „gereist“ [ɡəˈʁaɪ̯st]. Beide Phoneme haben die distinktiven Merkmale alveolar und frikativ gemeinsam. Man kann daher ein Archiphonem /S/ mit diesen Merkmalen ansetzen."
                                            },
                                            {
                                                "example_id": "ba92689d-75b6-49c2-a485-a48a4aaa6a89",
                                                "sense_id": "e8634d07-0539-3375-a22b-3ad869117d5c",
                                                "text": "„Man ist z. B. von einem früher einheitlichen Auslautphonem, dem sogenannten Archiphonem, ausgegangen (z. B. in ‚Rad‘ und in ‚Rad[e]‘ /D/), das in Opposition zu einem anderen Auslautphonem (z. B. /T/ in ‚Rat‘ und in ‚Rat[e]‘) gestanden hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
