                        ],
                        "examples": [
                            {
                                "example_id": "8fdd21fd-bd3c-4b63-81ce-6399de5c8457",
                                "sense_id": "e36f007a-fa6b-36ef-b720-f085cdcc083a",
                                "text": "Un métayer, faisant en ma présence lʼéloge de son chat, assurait quʼil rapportait chaque jour du dehors soit un liévreteau, soit un lapineau, quʼon lui entendait croquer en grondant sous le lit."
                            },
                            {
                                "example_id": "c6861663-549e-48a9-9864-7d1fce017a30",
                                "sense_id": "e36f007a-fa6b-36ef-b720-f085cdcc083a",
                                "text": "Tant qu’ils sont jeunes, liévreteaux par conséquent, ils ne s’écartent beaucoup ni les uns des autres, ni du gîte de la mère."
                            }
                        ]
                    }
