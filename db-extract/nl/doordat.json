                                            {
                                                "example_id": "495d87d6-960e-4d34-ba1a-404f26cd6de5",
                                                "sense_id": "3ec69da3-3feb-3be5-b492-b3aa5d129785",
                                                "text": "He rejected me because revenge, I guess."
                                            },
                                            {
                                                "example_id": "1675b1fe-2ee6-492e-8492-e104fc7bb48f",
                                                "sense_id": "3ec69da3-3feb-3be5-b492-b3aa5d129785",
                                                "text": "It doesn't work because reasons."
                                            },
                                            {
