                "senses": [
                    {
                        "sense_id": "34126a13-55e2-3a6e-8d3f-6aa8ea423ee9",
                        "entry_id": "ee96623d-616b-30e6-84aa-e3208e5548e0",
                        "glosses": [
                            "taki, który zawiera żywicę; pełen żywicy; pachnący żywicą"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ba3e959-c02b-42c5-b9f1-502841bcd1da",
                                "sense_id": "34126a13-55e2-3a6e-8d3f-6aa8ea423ee9",
                                "text": "Na korze jodeł koreańskich występują pęcherze żywiczne."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e1ead85-5318-4c2b-9145-62d9a9447ee3",
                        "source_entry_id": "ee96623d-616b-30e6-84aa-e3208e5548e0",
                        "source_sense_id": "34126a13-55e2-3a6e-8d3f-6aa8ea423ee9",
                        "target_lang_word": "resinous",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resinous",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23f01bf4-b9e3-32b4-b6d0-6e0d3659c3b3",
                                        "entry_id": "2fc00f8b-89fd-3cb0-97a4-e3a04899b890",
                                        "glosses": [
                                            "Of or relating to resin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "553c6af7-34d5-4198-9174-f1e38f70d9e3",
                                                "sense_id": "23f01bf4-b9e3-32b4-b6d0-6e0d3659c3b3",
                                                "text": "Resin, pitch, sealing-wax, caoutchouc, sulphur, gutta-percha, and generally all bodies commonly termed resinous, besides a great variety of others, will be found to acquire, after friction, the power of attracting light bodies, and hence will be said, according to a limitation of terms already accepted, to be in an electrized or electrified state ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42e28ee0-ef58-37b0-9134-77c77ededb4d",
                                        "entry_id": "2fc00f8b-89fd-3cb0-97a4-e3a04899b890",
                                        "glosses": [
                                            "Negative (of electric charge)."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "862bf447-01fb-43f8-a218-a83e6d54d3d4",
                        "source_entry_id": "ee96623d-616b-30e6-84aa-e3208e5548e0",
                        "source_sense_id": "34126a13-55e2-3a6e-8d3f-6aa8ea423ee9",
                        "target_lang_word": "pryskyřičný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "69b0c3d5-a6a9-413e-a62e-8e69b757ab0c",
                        "source_entry_id": "ee96623d-616b-30e6-84aa-e3208e5548e0",
                        "source_sense_id": "34126a13-55e2-3a6e-8d3f-6aa8ea423ee9",
                        "target_lang_word": "résineux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "résineux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b6835c0-4914-323d-aaf4-5cfbe74275e9",
                                        "entry_id": "4e57a967-ed7d-3da0-9d1a-7be80aa1ed52",
                                        "glosses": [
                                            "Qui produit la résine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f250b71f-bcb5-4420-948e-a408830e62b5",
                                                "sense_id": "0b6835c0-4914-323d-aaf4-5cfbe74275e9",
                                                "text": "C'étaient d'importantes agglomérations de ces essences résineuses, auxquelles on pouvait donner, en certains endroits, le nom de forêts."
                                            },
                                            {
                                                "example_id": "a9967f09-76fe-4e61-872d-7be5a66f6a25",
                                                "sense_id": "0b6835c0-4914-323d-aaf4-5cfbe74275e9",
                                                "text": "Plus précisément les écologistes accusent les essences résineuses de podzoliser les sols, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ca28b48-fd60-302f-9acf-e2c17bd7e294",
                                        "entry_id": "4e57a967-ed7d-3da0-9d1a-7be80aa1ed52",
                                        "glosses": [
                                            "Qui contient de la résine ; qui est de la nature de la résine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e7bcb58-665f-49de-9277-0a862e72fad9",
                                                "sense_id": "9ca28b48-fd60-302f-9acf-e2c17bd7e294",
                                                "text": "Les fibres textiles qui constituent la tige du lin sont agglutinées par une matière gommeuse et résineuse qu'il est essentiel de détruire afin de les séparer."
                                            },
                                            {
                                                "example_id": "053fd2c9-757e-470a-a415-88a7158fe7a6",
                                                "sense_id": "9ca28b48-fd60-302f-9acf-e2c17bd7e294",
                                                "text": "L'encens, qui était une gomme résineuse, était exclusivement réservé aux cérémonies religieuses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4a66dec-657f-35c0-8141-3245c547157c",
                                        "entry_id": "4e57a967-ed7d-3da0-9d1a-7be80aa1ed52",
                                        "glosses": [
                                            "Qui a rapport à la résine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e91490f-58f8-43bf-8c9d-315da4dc11fd",
                                                "sense_id": "f4a66dec-657f-35c0-8141-3245c547157c",
                                                "text": "Mais loin de son Plateau, Arsène André étouffait. L'air résineux lui manquait, les brouillards de la Meuse lui enflammaient la gorge."
                                            },
                                            {
                                                "example_id": "c1c55c38-a459-4b84-be01-f695505c665b",
                                                "sense_id": "f4a66dec-657f-35c0-8141-3245c547157c",
                                                "text": "[…]; une agréable odeur résineuse embaumait l’air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4769ab22-991c-3e50-8a90-5c89fa637e97",
                                        "entry_id": "4e57a967-ed7d-3da0-9d1a-7be80aa1ed52",
                                        "glosses": [
                                            "Relatif aux forêts plantées d'arbres gymnospermes à résine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94cdbdc-f4c7-44aa-8e1c-408e7ea64a23",
                                                "sense_id": "4769ab22-991c-3e50-8a90-5c89fa637e97",
                                                "text": "Le Beaujolais, qui a connu après la Seconde Guerre mondiale à la fois un enrésinement massif et une extension viticole grâce au succès du Beaujolais nouveau, offre un terrain particulièrement riche pour étudier la confrontation, voire le conflit entre la vigne et la forêt résineuse."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dc2d1a8-fdca-36b3-8308-2eabd75fbc0b",
                                        "entry_id": "4e57a967-ed7d-3da0-9d1a-7be80aa1ed52",
                                        "glosses": [
                                            "Qualifiait l'électricité statique obtenue par le frottement de la résine."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e0f51e4-65e2-4047-a78a-2fc109fe8940",
                                                "sense_id": "5dc2d1a8-fdca-36b3-8308-2eabd75fbc0b",
                                                "text": "Les corps résineux, frottés entre eux , acquièrent alternativement l’électricité vitrée et l’électricité résineuse; mais , étant frottés contre tout autre corps, ils deviennent résineusement électriques."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "résineux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "00212af3-5347-391a-b6e2-3ebf506c3a0f",
                                        "entry_id": "3d361f0c-f3ac-344d-ae19-5a946a00bc06",
                                        "glosses": [
                                            "Arbre dont les tissus contiennent de la résine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d9978b2-a536-4c37-93d9-a615f8252e19",
                                                "sense_id": "00212af3-5347-391a-b6e2-3ebf506c3a0f",
                                                "text": "À l'état naturel, les résineux comme les feuillus ont une grande puissance de conquête et une grande longévité."
                                            },
                                            {
                                                "example_id": "c0859970-ae67-45b1-bcdf-75cbed62bbe8",
                                                "sense_id": "00212af3-5347-391a-b6e2-3ebf506c3a0f",
                                                "text": "Des facteurs comme l'apport de résineux, plantés pour remplacer les feuillus d'origine ou introduits là où il n'y en avait pas comme en plaine, ajoutent à la lente transformation du paysage."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
