                                        "sense_id": "4fdaee17-7e99-3fdc-8904-14ae6d4304a1",
                                        "entry_id": "0f462e22-be0d-3516-9674-b9834172fc09",
                                        "glosses": [
                                            "The part of linguistics that studies words, their nature and meaning, words' elements, relations between words including semantic relations, words groups and the whole lexicon."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d433dbae-ec8a-481d-bc44-f41a0f6b0a6c",
                                                "sense_id": "4fdaee17-7e99-3fdc-8904-14ae6d4304a1",
                                                "text": "The fifth is devoted to doctrine; the sixth and seventh to remarks on syntax and lexicology respectively."
                                            }
                                        ]
                                    },
                                    {
