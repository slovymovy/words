                                "example_id": "0ae89b3b-086b-4eb1-9643-6db4d5eefc85",
                                "sense_id": "7a98c70d-8fc8-35c2-bc51-b0e07cf9a1a3",
                                "text": "„Die meisten der extra eingeladenen Galagäste kommen erst heute Abend oder heute Nacht an.“"
                            },
