                ],
                "senses": [
                    {
                        "sense_id": "f7885fea-211d-31a0-8fe6-dac6f1582db8",
                        "entry_id": "81919276-0e58-380b-b5f3-a4eeee4426b9",
                        "glosses": [
                            "Feindraht mit kleinsten Spitzen, an dem bei angelegter Hochspannung Ionisation stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1843cb6-ad01-48fa-ae1d-66d782b213fa",
                                "sense_id": "f7885fea-211d-31a0-8fe6-dac6f1582db8",
                                "text": "„Von der Ionenergiebigkeit der Spitzenionisatoren hängt die luftschadstoff- und keimabscheidende Wirkung der denaturierenden Elektrofiltersysteme in entscheidender Weise ab. “"
                            },
                            {
                                "example_id": "c7b7f047-b047-4f3c-bdde-fdcb208ef58f",
                                "sense_id": "f7885fea-211d-31a0-8fe6-dac6f1582db8",
                                "text": "„Im Vergleich mit Spitzenionisatoren, welche pro cm³ 6 - 9 Millionen Grossionen produzieren, liegen wir mit 20 - bis 100 - tausend Kleinionen durch Koronarentladungen sehr viel tiefer. Durch das Ladungspotential der Grossionen werden Staubteilchen geladen und werden dann durch Wände, Böden oder das Gerät selber angezogen.“"
                            },
                            {
                                "example_id": "4d825899-7efb-45c5-b428-99e350987c18",
                                "sense_id": "f7885fea-211d-31a0-8fe6-dac6f1582db8",
                                "text": "„Ionisator, Gerät zur Beseitigung elektrostatischer Aufladungen durch Erhöhung der Leitfähigkeit der Luft mittels Ionisation. Die Beseitigung unerwünschte elektrischer Ladungen kann passiv durch Anbringung von Spitzen (Spitzenionisator, Bild 1) erreicht werden (z.B. Blitzableiter) oder aktiv durch Erzeugung einer stillen Entladung zwischen geeignet geformten Elektroden (Spitzen und Kanten), an die Hochspannung (etwa 6 kV) gelegt wird (Hochspannungsionisator).“"
                            },
                            {
                                "example_id": "a7f4aebf-f46e-4547-a901-7e956132ccb0",
                                "sense_id": "f7885fea-211d-31a0-8fe6-dac6f1582db8",
                                "text": "„Die Beseitigung unerwünschte elektrischer Ladungen kann passiv durch Anbringung von Spitzen (Spitzenionisator, Bild 1) erreicht werden (z.B. Blitzableiter) oder aktiv durch Erzeugung einer stillen Entladung zwischen geeignet geformten Elektroden (Spitzen und Kanten), an die Hochspannung (etwa 6 kV) gelegt wird (Hochspannungsionisator).“"
                            },
                            {
                                "example_id": "2d634406-196e-41cb-8e34-3fe70b8aee48",
                                "sense_id": "f7885fea-211d-31a0-8fe6-dac6f1582db8",
                                "text": "„Influenz-Spitzenionisator zur Vermeidung elektrostatischer Aufladung (Funkenbildung, Entzündung des Lösungsmittels)“"
                            },
                            {
                                "example_id": "3360d155-2c30-46d3-a71f-95f129c55dec",
                                "sense_id": "f7885fea-211d-31a0-8fe6-dac6f1582db8",
                                "text": "„Es ist in der Praxis bereits versucht worden, die entstehende Aufladung der Flüssigkeit durch Spitzenionisatoren in der Rohrleitung zu verringern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
