                "senses": [
                    {
                        "sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                        "entry_id": "74db41d9-026d-3a9c-845a-87aaa3a7e1ff",
                        "glosses": [
                            "Vorderlader des 15. und 16. Jahrhunderts mit Luntenschloss"
                        ],
                        "tags": [
                            "Waffenkunde"
                        ],
                        "examples": [
                            {
                                "example_id": "df9f3959-5a4b-48f4-bc95-6f2a955e4473",
                                "sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                                "text": "„Rund 650 mit Arkebusen bewaffnete Soldaten gehören zu Barretos Leuten sowie 2000 Träger, 200 einheimische Führer, zwei Dutzend Ochsenwagen, acht Esel und fünf Kamele.“"
                            },
                            {
                                "example_id": "1488adda-f369-47d1-841f-4a348ca91418",
                                "sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                                "text": "„Die Arkebuse ist eine Hakenbüchse mit Luntenschloss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3ac6fbd-4461-46af-91a1-2cb7ed068f74",
                        "source_entry_id": "74db41d9-026d-3a9c-845a-87aaa3a7e1ff",
                        "source_sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                        "source_sense_description": "Vorderlader mit Luntenschloss",
                        "target_lang_word": "archebus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "db712d5a-1e1b-4d10-9c40-485217f5d473",
                        "source_entry_id": "74db41d9-026d-3a9c-845a-87aaa3a7e1ff",
                        "source_sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                        "source_sense_description": "Vorderlader mit Luntenschloss",
                        "target_lang_word": "harquebus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harquebus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dbb463b1-77f5-3a3d-8fb0-8fa06dd31da2",
                                        "entry_id": "b2d4e9dd-9bf1-3622-bf27-ba30be5b3583",
                                        "glosses": [
                                            "An obsolete matchlock firearm."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56b3c087-765f-4a2c-89dc-2cb4c8ee6b4e",
                                                "sense_id": "dbb463b1-77f5-3a3d-8fb0-8fa06dd31da2",
                                                "text": "All the while they had their eye and foot so quicke and readie, that as soone as ever they saw the harquebuse raised to the cheeke, so soon were they on the ground, and eftsoone to answer with their bowes, and to the their way, if by chance they perceived that we were about to take them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60988671-6aff-314f-a59e-5eed9fbb2da6",
                                        "entry_id": "b2d4e9dd-9bf1-3622-bf27-ba30be5b3583",
                                        "glosses": [
                                            "A portable gun, varying in size from a small cannon to a musket. When used in the field it was supported upon a tripod or trestle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93ae5af7-67b4-4d5e-926f-06a07c91324f",
                        "source_entry_id": "74db41d9-026d-3a9c-845a-87aaa3a7e1ff",
                        "source_sense_id": "c2d925aa-45dd-355d-8bed-4ca61f714393",
                        "source_sense_description": "Vorderlader mit Luntenschloss",
                        "target_lang_word": "arquebuse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "arquebuse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b570d16-6b4d-3c85-8cde-e4c98f7f5e6a",
                                        "entry_id": "31f96e67-d210-3523-a35f-13863a4d45ad",
                                        "glosses": [
                                            "Ancienne arme à feu qu’on faisait partir au moyen d’une mèche."
                                        ],
                                        "tags": [
                                            "Armement"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "573242b0-c888-47bb-a030-af10208af257",
                                                "sense_id": "5b570d16-6b4d-3c85-8cde-e4c98f7f5e6a",
                                                "text": "Come je les veis esbranler pour tirer sur nous, je couchay mon arquebuse en jouë, visay droit à un des trois chefs, & de ce coup il en tomba deux par terre, & un de leurs compagnons qui fut blessé, qui quelque temps apres en mourut."
                                            },
                                            {
                                                "example_id": "9dce1102-f499-4c31-96d4-3475cd12f6d5",
                                                "sense_id": "5b570d16-6b4d-3c85-8cde-e4c98f7f5e6a",
                                                "text": "Ce qu’il voit encore, ce sont des soudards qui, […], criblent de coups d’arquebuse un oiseau de bois fiché à la pointe d’un mai."
                                            },
                                            {
                                                "example_id": "b2e56d85-d7db-4e34-a16f-6f4e04df8da2",
                                                "sense_id": "5b570d16-6b4d-3c85-8cde-e4c98f7f5e6a",
                                                "text": "J’ai dix arquebuses dans cette chambre, reprit Charles IX, avec lesquelles je touche un écu d’or à cent cinquante pas. Voulez-vous en essayer une ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0ab9753-4659-3738-ad91-16c7cb689508",
                                        "entry_id": "31f96e67-d210-3523-a35f-13863a4d45ad",
                                        "glosses": [
                                            "Boisson alcoolisée préparée par macération et distillation de plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2e35518-2a09-4b0f-b0fb-ac819324608c",
                                                "sense_id": "d0ab9753-4659-3738-ad91-16c7cb689508",
                                                "text": "Marie Martin : Oh oh ! vous n’êtes pas bien mon père…\nLe moine : Non pas tellement, j’ai les jambes tout mollettes.\nMarie Martin : Attendez, vous allez boire un verre d’arquebuse.\nLe moine : Merci, ça me les rendra pour me remettre en route."
                                            },
                                            {
                                                "example_id": "c66ff01b-7bf5-44fb-b935-066d409a3db0",
                                                "sense_id": "d0ab9753-4659-3738-ad91-16c7cb689508",
                                                "text": "Selon certaines sources l’arquebuse ne serait plus commercialisée."
                                            }
                                        ]
                                    }
                                ]
                            },
