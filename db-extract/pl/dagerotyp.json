                            "fotografia wykonana za pomocą dagerotypii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be37b4af-63aa-4e6d-965f-16c996fa626f",
                                "sense_id": "b2705293-2b4a-3331-899e-ad5fe7b74e24",
                                "text": "Pierwsze dagerotypy dalekie były od wyrazistości."
                            }
                        ],
