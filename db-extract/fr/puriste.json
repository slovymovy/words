                                "target_senses": [
                                    {
                                        "sense_id": "1d820e8a-bb25-37af-b027-047f74ede061",
                                        "entry_id": "b0bf256c-b3c1-3b95-8636-1dc55542881c",
                                        "glosses": [
                                            "Of or pertaining to purism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f4b1c0f-a844-4b51-89e1-783c5975a39e",
                                                "sense_id": "1d820e8a-bb25-37af-b027-047f74ede061",
                                                "text": "He was the first to play for money, a practice which got him ousted from the purist U.S. Lawn Tennis Association."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "purist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c9f4ec3-3667-37a3-aa1c-730baf4aa343",
                                        "entry_id": "7a3a4b7a-a6ca-3889-afc0-b17e34a5ac5b",
                                        "glosses": [
                                            "An advocate of purism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "464370c8-3486-4516-bc57-983e182516d2",
                                                "sense_id": "4c9f4ec3-3667-37a3-aa1c-730baf4aa343",
                                                "text": "One of the difficulties that plague conversations about industrial music is that the genre has come to include (to the chagrin and outright denial of some purists) anything from gentle synthesized droning to metal-inspired riffage."
                                            }
                                        ]
                                    }
                                ]
                            }
