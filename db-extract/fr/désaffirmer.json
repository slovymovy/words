                "senses": [
                    {
                        "sense_id": "7839deb1-4a67-3b68-9782-4528bb6686ec",
                        "entry_id": "c52836c7-aedb-373b-b069-9382849d2c64",
                        "glosses": [
                            "Rendre moins affirmé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d50ec059-a837-49cd-b839-059066836e80",
                                "sense_id": "7839deb1-4a67-3b68-9782-4528bb6686ec",
                                "text": "Que je me résigne point à me désaffirmer transparente aqueuse et molle"
                            },
                            {
                                "example_id": "644d9513-90ce-463b-a6c5-47930641ba90",
                                "sense_id": "7839deb1-4a67-3b68-9782-4528bb6686ec",
                                "text": "Ça le tasse, l’éclate, le désaffirme presque."
                            },
                            {
                                "example_id": "3f848cf0-6587-42da-9ae2-687fd4e34245",
                                "sense_id": "7839deb1-4a67-3b68-9782-4528bb6686ec",
                                "text": "Cette problématique permet d’entrevoir la production d’un théâtre révolutionnaire, capable de remuer tripes et cœur par le moyen d’un nouveau langage théâtral qui, tout en utilisant les ressources scéniques et scénographiques du vodou, en arrive à s’affirmer politiquement, sans pour autant se désaffirmer esthétiquement."
                            }
                        ]
                    }
