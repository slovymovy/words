                ],
                "senses": [
                    {
                        "sense_id": "9028a375-7ca2-3ac4-820a-d682cea6d898",
                        "entry_id": "dc296c54-0119-3cde-bc49-e812cfce44d3",
                        "glosses": [
                            "to catch (someone) in the act, to trap/trick/set up"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0e4b54e-d0ee-4ef9-bd5e-09d69627bdea",
                                "sense_id": "9028a375-7ca2-3ac4-820a-d682cea6d898",
                                "text": "подлови́ть кого́-либо на сло́ве",
                                "translation": "to catch someone saying (something)",
                                "english": "to catch someone saying (something)"
                            },
                            {
                                "example_id": "7f93c911-ab8d-4d40-9245-f40b242b5a32",
                                "sense_id": "9028a375-7ca2-3ac4-820a-d682cea6d898",
                                "text": "подлови́ть кого́-либо на лжи",
                                "translation": "to catch someone in a lie",
                                "english": "to catch someone in a lie"
                            },
                            {
                                "example_id": "171e145a-6913-4b65-83fa-a122dafd8fc2",
                                "sense_id": "9028a375-7ca2-3ac4-820a-d682cea6d898",
                                "text": "подлови́ть кого́-либо на изме́не",
                                "translation": "to catch someone cheating",
                                "english": "to catch someone cheating"
                            },
                            {
                                "example_id": "90889248-5327-467c-a8de-6a56a34c5102",
                                "sense_id": "9028a375-7ca2-3ac4-820a-d682cea6d898",
                                "text": "подлови́ть свиде́теля",
                                "translation": "to trap a witness",
                                "english": "to trap a witness"
                            },
                            {
                                "example_id": "a3fb36bd-1bd0-4a48-9f5f-abff6f9ee13c",
                                "sense_id": "9028a375-7ca2-3ac4-820a-d682cea6d898",
                                "text": "Пыта́ешься подлови́ть меня́, что́бы я сказа́л, что де́лаю?",
                                "translation": "Are you trying to trick me into telling you what I'm doing?",
                                "english": "Are you trying to trick me into telling you what I'm doing?"
                            },
                            {
                                "example_id": "74fe7720-fd92-45d2-9a10-2aa9bfd77fac",
                                "sense_id": "9028a375-7ca2-3ac4-820a-d682cea6d898",
                                "text": "Тут ты меня́ подлови́л.",
                                "translation": "You got me there.",
                                "english": "You got me there."
                            }
                        ]
                    }
                ],
