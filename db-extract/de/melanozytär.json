                                "example_id": "ba595594-4060-468a-9127-228dcf502079",
                                "sense_id": "dd71c8f2-d02b-3b14-9163-4772219347f5",
                                "text": "„Die Differentialdiagnose umfaßte einen Tumor melanozytärer oder neuraler Histogenese.“"
                            },
