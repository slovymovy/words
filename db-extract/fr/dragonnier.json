                "senses": [
                    {
                        "sense_id": "84412e6d-ba18-3e3d-9739-3d438c0fc980",
                        "entry_id": "48180f48-8d78-3bac-92c2-521e095977b4",
                        "glosses": [
                            "Celui qui chevauche un dragon."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "4c2662c9-a0ef-40d5-abe9-0c4893ede1ff",
                                "sense_id": "84412e6d-ba18-3e3d-9739-3d438c0fc980",
                                "text": "Un dragonnier ou une dragonnière est une personne qui chevauche un dragon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f9f86cdb-3b0c-4e7a-a1dd-3b9b157d8c15",
                        "source_entry_id": "48180f48-8d78-3bac-92c2-521e095977b4",
                        "source_sense_id": "84412e6d-ba18-3e3d-9739-3d438c0fc980",
                        "target_lang_word": "dragonrider",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dragonrider",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5054f3cb-2409-3421-aa24-b86b55d8a6bb",
                                        "entry_id": "c374c54d-3639-3b3d-984c-3a796cb8c05b",
                                        "glosses": [
                                            "One who rides a dragon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70afe534-d623-44ad-96b1-8519fd846db3",
                                                "sense_id": "5054f3cb-2409-3421-aa24-b86b55d8a6bb",
                                                "text": "Those handsome dragonriders, too, so brave in their wher-hide accouterments, proud on the necks of their great beasts—they did not submit kindly to close examination without a few disappointing revelations."
                                            },
                                            {
                                                "example_id": "934af322-9df0-447d-9eb4-0d8f946988fe",
                                                "sense_id": "5054f3cb-2409-3421-aa24-b86b55d8a6bb",
                                                "text": "The dragonriders turned their beasts, two hundred beasts at least, treading once again over the crops they had already destroyed."
                                            },
                                            {
                                                "example_id": "8771eca2-707c-4759-abc5-f0752362c2c8",
                                                "sense_id": "5054f3cb-2409-3421-aa24-b86b55d8a6bb",
                                                "text": "Once asleep, a dragon is extremely difficult and even dangerous to wake,[…]. An experienced dragonrider never allows his animal to sleep unless he knows there is a competent wizard nearby."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
