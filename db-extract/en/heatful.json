                                "sense_id": "edb00a3a-4e42-3168-b286-5a92293afbe8",
                                "text": "We had survived the long and heatful summer, enjoyed the splendid fall,"
                            },
                            {
                                "example_id": "a6a92161-d815-4212-9cd3-56009059a399",
                                "sense_id": "edb00a3a-4e42-3168-b286-5a92293afbe8",
                                "text": "Winter's cold being the readiest punisher available, I took to applying snow or ice to myself in my furtive efforts to quench the heatful ardor."
                            },
                            {
                                "example_id": "de6a502c-1b49-4583-a5b0-61b333defd48",
                                "sense_id": "edb00a3a-4e42-3168-b286-5a92293afbe8",
                                "text": "Heatful-blooded animals, properly clothed, are not subject to this handicap."
                            }
                        ]
                    }
