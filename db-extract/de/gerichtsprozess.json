                                        "sense_id": "c4131fa3-eb2b-3231-9b8a-dfb9071e4f6b",
                                        "entry_id": "f949a129-6e92-37c5-af26-9e40e4429d87",
                                        "glosses": [
                                            "In civil law, a case where two or more people disagree and one or more of the parties take the case to a court for resolution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7119c180-c433-45a0-906d-917dab7957d1",
                                                "sense_id": "c4131fa3-eb2b-3231-9b8a-dfb9071e4f6b",
                                                "text": "The lawyer advised his client against filing a lawsuit as it would take a lot of time and money to resolve."
                                            },
                                            {
                                                "example_id": "5bf07f51-5c89-4ca6-8c20-66e7097a2b90",
                                                "sense_id": "c4131fa3-eb2b-3231-9b8a-dfb9071e4f6b",
                                                "text": "My ex-fiancé filed a lawsuit against me for a false restraining order and defamation."
                                            },
                                            {
                                                "example_id": "44544237-774e-4118-9e72-e3c5fcbf2003",
                                                "sense_id": "c4131fa3-eb2b-3231-9b8a-dfb9071e4f6b",
                                                "text": "It has jailed environmental activists and is planning to limit the power of judicial oversight by handing a state-approved body a monopoly over bringing environmental lawsuits."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "lawsuit",
