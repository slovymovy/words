                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07916f2a-0aa9-4e86-9837-6ad11529a688",
                                "sense_id": "a2299ff6-1372-3073-a3e4-dc4859a8d9aa",
                                "text": "„Vielleicht denken Sie, dass Sie für Ihren Traumjob bis ans Ende der Welt gehen und auch lange Anfahrtswege in Kauf nehmen würden. Lassen Sie sich die Sache gut durch den Kopf gehen.“"
                            },
                            {
                                "example_id": "1803d76b-087c-4ce7-ad92-ac450f020db4",
                                "sense_id": "a2299ff6-1372-3073-a3e4-dc4859a8d9aa",
                                "text": "„Die Profis aus dem hohen Norden müssen wie alle anderen Spieler in der Europa League im Teambus zu ihren Heimspielen reisen – auch wenn der Anfahrtsweg nur 220 Meter beträgt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
