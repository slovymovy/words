                        "glosses": [
                            "man die in vroeger tijden langs de deuren ging om scharen en/of messen te slijpen"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "176c9ffc-191d-4c01-a980-c6263e383a16",
                                "sense_id": "58ce255f-4349-3fcf-a7e2-157a7d7a87b2",
                                "text": "De scharensliep ging met zijn handkar langs de deur. Er reed nog een enkele paardekar beladen met hooi door de binnenstad."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a31a0a5a-e916-4b42-bf2a-afca52e90179",
                        "source_entry_id": "cc788158-b04f-3a2d-89a6-94a85397c12e",
                        "source_sense_id": "58ce255f-4349-3fcf-a7e2-157a7d7a87b2",
                        "target_lang_word": "Scherenschleifer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
