                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d567a7e2-eba7-40ce-b563-488f1ec3d8ee",
                                "sense_id": "5754ac6e-b253-3383-82a6-3cbc1d12a03c",
                                "text": "Alors, un coca ou un fanta ? — Je préfère un fanta. — Parce qu’un fanta, ça a le même teint que ta peau !"
                            },
                            {
                                "example_id": "38a81fd7-2a10-4f13-add9-0ef667572815",
                                "sense_id": "5754ac6e-b253-3383-82a6-3cbc1d12a03c",
                                "text": "Je me contentais généralement d’un bout de pain arrosé d’un fanta ou encore, pendant les journées fastes, d’un bout de pain tartiné de pâté, de beurre ou de chocolat, accompagné d’un fanta."
                            },
                            {
                                "example_id": "96797c37-b7ad-4544-948a-4cb067a16e8f",
                                "sense_id": "5754ac6e-b253-3383-82a6-3cbc1d12a03c",
                                "text": "Pour les demi-litres, des bouteilles de Fanta ou Coca vides feraient l'affaire, les boites de pilchard tenaient lieu de mesures pour les quarts de litre […]."
                            }
                        ]
                    }
