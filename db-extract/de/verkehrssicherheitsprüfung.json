                "senses": [
                    {
                        "sense_id": "1f145552-abb2-34a8-b69e-886e0d0f5cbd",
                        "entry_id": "34b89469-223d-3040-9c8b-0ffeff80c266",
                        "glosses": [
                            "Prüfung eines Gegenstandes bezüglich der Verkehrssicherheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "245c2af5-c291-46f9-b1d4-1b30b607557d",
                                "sense_id": "1f145552-abb2-34a8-b69e-886e0d0f5cbd",
                                "text": "„Laufende Verkehrssicherheitsprüfungen finden jedoch bislang nicht statt, das Areal bleibt wegen Gefahr im Verzug für die Öffentlichkeit geschlossen.“"
                            },
                            {
                                "example_id": "00e6a0ef-eeda-4d03-bde6-0468e36ab632",
                                "sense_id": "1f145552-abb2-34a8-b69e-886e0d0f5cbd",
                                "text": "„Danach wurden an Kraftfahrzeugen mit Fremdzündungsmotoren der CO-Gehalt im Leerlauf, die Leerlaufdrehzahl, Zündzeitpunkt und Schließwinkel bei kontaktgesteuerten Zündanlagen überprüft. Diese zusätzliche Prüfung konnte im Regelfall nicht in die übliche Verkehrssicherheitsprüfung integriert werden, so dass grundsätzlich separate Arbeitsplätze erforderlich wurden.“"
                            },
                            {
                                "example_id": "01fe9797-8988-4709-9738-43134040598d",
                                "sense_id": "1f145552-abb2-34a8-b69e-886e0d0f5cbd",
                                "text": "„Um die Tauglichkeit des Hundes im Straßenverkehr zu prüfen, erfolgt eine Verkehrssicherheitsprüfung mittels eines Stadtgangs.“"
                            },
                            {
                                "example_id": "68d53e30-a05d-4930-9b34-5bb2f10a830f",
                                "sense_id": "1f145552-abb2-34a8-b69e-886e0d0f5cbd",
                                "text": "„Bereits am Samstag mussten alle Teams eine Verkehrssicherheitsprüfung in der Lübbecker Innenstadt ablegen, wobei die Hunde kein aggressives Verhalten gegenüber Mensch oder Tier zeigen durften.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
